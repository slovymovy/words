                "translations": [
                    {
                        "translation_id": "52c5776b-42f7-4ace-bba6-5b5919299961",
                        "source_entry_id": "653af505-2ca3-3005-b3c3-f51d192d11bf",
                        "source_sense_id": "4e7c1fe6-2fee-3ee2-bca4-216ee5f07cc2",
                        "source_sense_description": "männliche Person, die als Kellner arbeitet",
                        "target_lang_word": "serveur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "serveur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "63d054e6-c0e4-3aba-a10e-0ba960c0480e",
                                        "entry_id": "f70a2e69-7db7-32ac-b833-e2e1148ed926",
                                        "glosses": [
                                            "Celui qui a pour activité professionnelle de servir à table ou au buffet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "533afed6-aaea-49f9-b243-f58d12772441",
                                                "sense_id": "63d054e6-c0e4-3aba-a10e-0ba960c0480e",
                                                "text": "Deux Bellinis ! commanda Ettore à l’un des serveurs."
                                            },
                                            {
                                                "example_id": "909bb7e0-1df8-441c-b96a-a015fc9e5571",
                                                "sense_id": "63d054e6-c0e4-3aba-a10e-0ba960c0480e",
                                                "text": "Tonton Mbagnick appelle le serveur et commande un ballon de Kir Royal et demande à Meïssa Bigué ce qu'il voulait prendre « Une limonade pour moi."
                                            },
                                            {
                                                "example_id": "0bf279d7-a725-40bf-91eb-1b602ffa0bf3",
                                                "sense_id": "63d054e6-c0e4-3aba-a10e-0ba960c0480e",
                                                "text": "En dehors de vous-même, il y a si je ne m’abuse, une infirmière major, une Surveillante Générale, un ancien jockey servant de factotum, une centraliste, un maître d’hôtel, un cuisinier et son aide, deux femmes de chambre, trois serveurs, trois filles de salle et un jardinier…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "650920f2-9611-3e13-b7d8-1278c1f97a99",
                                        "entry_id": "f70a2e69-7db7-32ac-b833-e2e1148ed926",
                                        "glosses": [
                                            "Matériel, logiciel ou système informatique destiné à fournir un service déterminé à d’autres systèmes informatiques ou à des utilisateurs connectés sur un réseau."
                                        ],
                                        "tags": [
                                            "Réseaux informatiques"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "27795128-ef60-411b-99f5-f77ccc733e1a",
                                                "sense_id": "650920f2-9611-3e13-b7d8-1278c1f97a99",
                                                "text": "J’ai spoofé ton IP pour la cacher, et j'ai rebondi sur plusieurs bécanes et serveurs avant de me connecter à l’ordi de l'autre con, là. Avec ça, il ne serait jamais remonté jusqu'à toi, mais..."
                                            },
                                            {
                                                "example_id": "365c3e27-5b7f-455a-b028-740da3e4e4f6",
                                                "sense_id": "650920f2-9611-3e13-b7d8-1278c1f97a99",
                                                "text": "Mais ils permettaient aussi de surfer anonymement sur Internet car ils s'appuyaient sur des serveurs proxy qui cryptaient les données. Peter pouvait ainsi se connecter facilement, et seul serait visible son accès au serveur VPN – et non à celui de l'AMRF."
                                            },
                                            {
                                                "example_id": "159535a6-5528-446c-92c2-87fbbdd58741",
                                                "sense_id": "650920f2-9611-3e13-b7d8-1278c1f97a99",
                                                "text": "Voici les commandes pour démarrer, arrêter et redémarrer le serveur MySQL"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a40994f-2125-3431-8a3b-4cb273398963",
                                        "entry_id": "f70a2e69-7db7-32ac-b833-e2e1148ed926",
                                        "glosses": [
                                            "Sportif qui sert, ou est spécialisé dans le service, par exemple au tennis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10bd8a17-8185-476b-8105-1d1396a51583",
                                                "sense_id": "2a40994f-2125-3431-8a3b-4cb273398963",
                                                "text": "Ce grand serveur d’1,91 m devra, en effet, se coltiner le Grec Stefanos Tsitsipas, 4ᵉ mondial, dès le premier tour, ce lundi matin à Melbourne."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
