        "fr-extract.jsonl": [
            {
                "entry_id": "41d98b5b-2580-3567-8ca9-ef7fc66a80e6",
                "word": "prophétiquement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c2a7ad16-9129-3ddd-8708-5b88f5b04c68",
                        "entry_id": "41d98b5b-2580-3567-8ca9-ef7fc66a80e6",
                        "glosses": [
                            "En prophète, comme un prophète."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb440440-f3f8-4241-97eb-03ee93101eb7",
                                "sense_id": "c2a7ad16-9129-3ddd-8708-5b88f5b04c68",
                                "text": "Il a prophétiquement parlé."
                            },
                            {
                                "example_id": "16f17bb9-4853-4570-85b8-fe08b62f0930",
                                "sense_id": "c2a7ad16-9129-3ddd-8708-5b88f5b04c68",
                                "text": "Peut-être vit-il des ombres sanglantes flotter prophétiquement entre les tentes de Richmond et de Richard III, et peut-être le lendemain entendit-il le terrible roi galoper à pied sur le champ de bataille en hurlant, promettant son royaume pour un cheval..."
                            },
                            {
                                "example_id": "e33c3163-8274-44e6-b29c-66be05161945",
                                "sense_id": "c2a7ad16-9129-3ddd-8708-5b88f5b04c68",
                                "text": "Ils annoncent prophétiquement le développement pacifique des la conscience, l’enrichissement spirituel de la personne humaine, l’accomplissement de la justice à l’intérieur de l’homme et au sein des sociétés."
                            }
                        ]
                    }
                ],
