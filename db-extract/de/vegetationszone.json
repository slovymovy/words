                "senses": [
                    {
                        "sense_id": "550d6aec-47d3-3267-8734-8e34a3869689",
                        "entry_id": "07268e21-1a96-3a4a-9f70-4882c0efa335",
                        "glosses": [
                            "nach bestimmten Kriterien der Vegetation festgelegter Bereich, Gebiet mit besonderer, typischer Vegetation"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4eb0784d-3851-4122-ac7c-fbb39d772d5e",
                                "sense_id": "550d6aec-47d3-3267-8734-8e34a3869689",
                                "text": "„In alter Geschäftigkeit arbeitete er an einer Aufrißkarte des Kontinents. Er verzeichnete die Vegetationszonen, den in zunehmender Höhe absinkenden Luftdruck, das Ineinanderfließen der Gesteine im Berginneren.“"
                            },
                            {
                                "example_id": "ddd83921-2217-45cd-9e37-69819cc32bcf",
                                "sense_id": "550d6aec-47d3-3267-8734-8e34a3869689",
                                "text": "„Durch die Alpenschilderungen Rousseaus findet eine weitere ästhetische Besonderheit der Bergwelt Eingang in die kulturelle Tradition: die Vorstellung des Gebirges als eines Panoramas unterschiedlicher, ja gegensätzlicher Siedlungsräume und Vegetationszonen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
