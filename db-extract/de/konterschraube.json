                ],
                "senses": [
                    {
                        "sense_id": "a7b6d8ea-e533-36c3-9365-3d3cca1a9e44",
                        "entry_id": "4de1c5fc-d671-32ac-9067-b48599bd51fa",
                        "glosses": [
                            "Schraube, die zur Sicherung eines Bolzens in das Innengewinde des Bolzenendes geschraubt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0c861bf-f67e-4328-a0a0-2ed5fe71d91d",
                                "sense_id": "a7b6d8ea-e533-36c3-9365-3d3cca1a9e44",
                                "text": "„Mit einer Konterschraube wird die Nadel in dieser Position axial kraftschlüssig arretiert.“"
                            },
                            {
                                "example_id": "7e2de8b1-1fb0-44bd-9f9e-e7a26555668a",
                                "sense_id": "a7b6d8ea-e533-36c3-9365-3d3cca1a9e44",
                                "text": "„Die Fixation erfolgt über eine in das Implantat integrierte, polyaxiale Gewindebuchse mit Konterschraube.“"
                            },
                            {
                                "example_id": "dbd7cf4e-616d-4b23-85cc-28d5f0fec612",
                                "sense_id": "a7b6d8ea-e533-36c3-9365-3d3cca1a9e44",
                                "text": "„Die Planparallelität ist an säulenlosen Schließeinheiten im Gegensatz zu säulengeführten mit Stellschraube und Feingewinde sowie Konterschraube einstellbar.“"
                            },
                            {
                                "example_id": "cae9e6bb-d62a-4564-b198-987e8e21d953",
                                "sense_id": "a7b6d8ea-e533-36c3-9365-3d3cca1a9e44",
                                "text": "„Beim Fixieren des Titaninserts mit Hilfe des Eindrehinstruments wird die Konterschraube (schmale Rändelung) gelöst, so daß Endposition und fester Sitz des Inserts gewährleistet sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
