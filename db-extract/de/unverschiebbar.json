                    },
                    {
                        "form_id": "55d9ee2e-a54c-4d28-9b9d-5455c26945bf",
                        "entry_id": "209f9a34-0029-32f4-b4a5-71b580abb1c1",
                        "tags": [
                            "positive",
                            "predicative",
                            "plural"
                        ],
                        "form": "sie sind unverschiebbar"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c7ccbd58-6c56-386f-b9bd-468912ac39fd",
                        "entry_id": "209f9a34-0029-32f4-b4a5-71b580abb1c1",
                        "glosses": [
                            "nicht verschiebbar"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89fbbe3d-58b3-4229-b10f-440f4110663c",
                                "sense_id": "c7ccbd58-6c56-386f-b9bd-468912ac39fd",
                                "text": "„Der Stil kristallisiert sich in Bildungen, die den Charakter des Schlechthin-Notwendigen tragen, wo jeder Teil an seiner Stelle und in seiner Gestalt als unveränderlich und unverschiebbar erscheint.“"
                            },
                            {
                                "example_id": "c0414640-09d1-4605-a677-54ef9f205d4d",
                                "sense_id": "c7ccbd58-6c56-386f-b9bd-468912ac39fd",
                                "text": "„Noch zu Goethes Studienzeit blieb Straßburg kerndeutsch, auf dem Wiener Kongreß verlangte man Rückerstattung, der Rechtsbegriff blieb so unverschiebbar, daß Bismarck vor 1866 Österreich zu gemeinsamer Rückeroberung der Reichslande einlud.“"
                            },
                            {
                                "example_id": "50abc853-e0ce-48ce-958a-ccdf183c8727",
                                "sense_id": "c7ccbd58-6c56-386f-b9bd-468912ac39fd",
                                "text": "„Nun deutet er darauf hin, daß wir uns gerade jene „Örter“ ohne Ausdehnung vorstellen, deren Kenntnis wir durch Organe erlangen, die mit der Umgebung unverschiebbar verbunden sind.“"
                            },
                            {
                                "example_id": "7f15030a-2d0e-4c17-a2ae-e4003450ad63",
                                "sense_id": "c7ccbd58-6c56-386f-b9bd-468912ac39fd",
                                "text": "„Wissenschaften, die ihre Begriffe so klar und unverschiebbar, wie die Mathematik in ihren fest begründeten Teilen, definiert haben, sind daher auch keinen Fehlschlüssen unterworfen ….“"
                            },
                            {
