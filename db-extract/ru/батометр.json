                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bathometer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "aecf8b0a-7e6c-3018-9e6b-c159c732f6ae",
                                        "entry_id": "958401a1-dd2c-3857-80e9-bdd9a5ffb43f",
                                        "glosses": [
                                            "Gerät zur Bestimmung der Meerestiefe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21add0df-edc0-4d45-93ca-6f309a462f76",
                                                "sense_id": "aecf8b0a-7e6c-3018-9e6b-c159c732f6ae",
                                                "text": "„Desaguilliers erfand einen Bathometer, der dem Barometer verwandt war, indem das Wasser durch seinen Druck Quecksilber in eine Röhre hinauftreiben soll.“"
                                            },
                                            {
                                                "example_id": "6bb7b730-3732-430a-b8dc-f5782c4d4618",
                                                "sense_id": "aecf8b0a-7e6c-3018-9e6b-c159c732f6ae",
                                                "text": "„Hierauf wird das Bathometer wieder herausgenommen, die in die obere Abtheilung eingedrungene Quecksilbermenge gewogen und alsdann beide Werthe, Druck und Quecksilbergewicht, in einer Tabelle notirt.“"
                                            },
                                            {
                                                "example_id": "37136522-efde-4686-92ab-37ab0dbe5f79",
                                                "sense_id": "aecf8b0a-7e6c-3018-9e6b-c159c732f6ae",
                                                "text": "„Der Gebrauch dieses Bathometers setzt die Kenntniß des Temperaturunterschiedes der Tiefe, in welche dasselbe versenkt wird, voraus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
