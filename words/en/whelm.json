{
    "word_family": [
        "overwhelm",
        "overwhelming"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f77fefa4-d054-36ac-ae9d-d7deaa6c5e62",
                    "sense_definition": "To bury, cover, or submerge completely.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "cover",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rising tide began to <w>whelm</w> the small boat as it drifted further from the shore.",
                            "target_lang_translations": {
                                "ru": "Поднимающийся прилив начал <w>поглощать</w> маленькую лодку, пока она дрейфовала дальше от берега."
                            }
                        },
                        {
                            "text": "Heavy snow continued to <w>whelm</w> the mountain pass, making travel impossible for several days.",
                            "target_lang_translations": {
                                "ru": "Сильный снегопад продолжал <w>засыпать</w> горный перевал, делая проезд невозможным в течение нескольких дней."
                            }
                        }
                    ],
                    "synonyms": [
                        "overwhelm"
                    ],
                    "antonyms": [
                        "unwhelm"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This word is rarely used in modern English, often replaced by overwhelm."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Полностью покрывать, затоплять или поглощать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поглощать",
                                "target_lang_sense_clarification": "в значении полного покрытия или затопления"
                            },
                            {
                                "target_lang_word": "затапливать",
                                "target_lang_sense_clarification": "в контексте воды"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "83c94345-1e79-34dc-9480-73e2c8850d30",
                    "sense_definition": "To overcome someone with intense emotion.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A sudden sense of grief seemed to <w>whelm</w> her as she read the old letter.",
                            "target_lang_translations": {
                                "ru": "Внезапное чувство скорби, казалось, <w>переполнило</w> её, когда она читала старое письмо."
                            }
                        },
                        {
                            "text": "The joy of the reunion threatened to <w>whelm</w> him, leaving him unable to speak.",
                            "target_lang_translations": {
                                "ru": "Радость от воссоединения грозила <w>одолеть</w> его, лишив дара речи."
                            }
                        }
                    ],
                    "synonyms": [
                        "overwhelm"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used primarily in literary contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Одолевать, переполнять сильными эмоциями."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "переполнять",
                                "target_lang_sense_clarification": "об эмоциях"
                            },
                            {
                                "target_lang_word": "одолевать",
                                "target_lang_sense_clarification": "о сильном чувстве"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b2cc4f85-efb7-32a3-be62-4cd3966d301d",
                    "sense_definition": "To cause the ruin or destruction of something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "destroy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The invading army sought to <w>whelm</w> the city and erase its history entirely.",
                            "target_lang_translations": {
                                "ru": "Армия захватчиков стремилась <w>уничтожить</w> город и полностью стереть его историю."
                            }
                        },
                        {
                            "text": "Time will eventually <w>whelm</w> all human monuments, turning them into dust.",
                            "target_lang_translations": {
                                "ru": "Время в конечном итоге <w>погубит</w> все человеческие памятники, превратив их в пыль."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Literary usage."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Приводить к разрушению или гибели чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "губить",
                                "target_lang_sense_clarification": "в значении разрушения"
                            },
                            {
                                "target_lang_word": "уничтожать",
                                "target_lang_sense_clarification": "в значении полного разрушения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5c222348-a2cd-3f84-a9b1-2a017186f4c3",
                    "sense_definition": "To place something over an object to hide or protect it.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "cover",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He decided to <w>whelm</w> the container with a heavy cloth to keep the contents dark.",
                            "target_lang_translations": {
                                "ru": "Он решил <w>накрыть</w> контейнер тяжелой тканью, чтобы содержимое оставалось в темноте."
                            }
                        },
                        {
                            "text": "One must <w>whelm</w> the trap with a lid to ensure the insects remain inside.",
                            "target_lang_translations": {
                                "ru": "Нужно <w>накрыть</w> ловушку крышкой, чтобы насекомые остались внутри."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Obsolete usage."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Накрывать что-либо для сокрытия или защиты."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "накрывать",
                                "target_lang_sense_clarification": "покрывать сверху"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "78294928-8032-3b2d-910c-05770178f7ef",
                    "sense_definition": "A powerful surge or wave of water.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "water",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>whelm</w> of the ocean tide crashed against the jagged cliffs.",
                            "target_lang_translations": {
                                "ru": "<w>Мощный поток</w> океанского прилива обрушился на скалистые утесы."
                            }
                        },
                        {
                            "text": "She felt the sudden <w>whelm</w> of the river as the dam gates opened.",
                            "target_lang_translations": {
                                "ru": "Она почувствовала внезапный <w>напор</w> реки, когда открылись шлюзы плотины."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Literary usage."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Мощный поток или волна воды."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поток",
                                "target_lang_sense_clarification": "сильное движение воды"
                            },
                            {
                                "target_lang_word": "хлынувшая волна",
                                "target_lang_sense_clarification": "внезапный прилив воды"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "81ca22e9-9f7a-31a0-9082-ebc064b58ce2",
                    "sense_definition": "A hollowed-out log used as a drainpipe.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "water",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old farm relied on a wooden <w>whelm</w> to direct rainwater away from the barn.",
                            "target_lang_translations": {
                                "ru": "Старая ферма полагалась на деревянный <w>водосточный желоб</w>, чтобы отводить дождевую воду от амбара."
                            }
                        },
                        {
                            "text": "Archaeologists discovered a rotted <w>whelm</w> buried beneath the ancient road.",
                            "target_lang_translations": {
                                "ru": "Археологи обнаружили сгнивший <w>водосточный желоб</w>, погребенный под древней дорогой."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Historical or technical term."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Выдолбленное бревно, используемое в качестве водосточной трубы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "водосточный желоб",
                                "target_lang_sense_clarification": "исторический или технический термин"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}