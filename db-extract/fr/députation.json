        "fr-extract.jsonl": [
            {
                "entry_id": "cb85c21e-2889-3798-903f-ec3d107c4125",
                "word": "députation",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "5738fab5-65b5-47df-9cea-87b17dd591dd",
                        "entry_id": "cb85c21e-2889-3798-903f-ec3d107c4125",
                        "tags": [
                            "plural"
                        ],
                        "form": "députations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6555fb85-b983-30fb-8a1c-4063708d9fb8",
                        "entry_id": "cb85c21e-2889-3798-903f-ec3d107c4125",
                        "glosses": [
                            "Action de députer, envoi d’une ou de plusieurs personnes chargées d’une mission."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4c5c52c-cdc3-40eb-b849-52b4bf3d8c2c",
                                "sense_id": "6555fb85-b983-30fb-8a1c-4063708d9fb8",
                                "text": "Permettez, M. de Champagnoles, dit le vidame de Fauquemont, nous sommes ici pour nous entendre sur le fait de la députation aux états-généraux, et non pour raconter notre histoire."
                            },
                            {
                                "example_id": "10e54ee0-5efb-4cf9-9eb1-2d4b14607a61",
                                "sense_id": "6555fb85-b983-30fb-8a1c-4063708d9fb8",
                                "text": "En 1582, la ville de Metz envoya une députation au roi pour se plaindre des calvinistes et des juifs."
                            }
                        ]
                    },
                    {
                        "sense_id": "5c819227-b36b-3ef1-8a19-e68bae0febaa",
                        "entry_id": "cb85c21e-2889-3798-903f-ec3d107c4125",
                        "glosses": [
                            "Ensemble des personnes ainsi députées."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c575e2a-39f6-46de-867c-0df53e288dbc",
                                "sense_id": "5c819227-b36b-3ef1-8a19-e68bae0febaa",
                                "text": "Une députation de leurs chefs s’est rendue auprès des Chérokées, des Choctaws et des Séminoles, pour leur proposer une alliance offensive et défensive."
                            },
                            {
                                "example_id": "ab93bcaf-32a7-4e18-831c-e09b4eea148b",
                                "sense_id": "5c819227-b36b-3ef1-8a19-e68bae0febaa",
                                "text": "Le 22, au point du jour, la cité entière, entassée sur les quais du port et sur les côtes voisines, guettait d’un œil avide et colère le steamer qui amenait à Copenhague la députation du meeting de Rendsbourg."
                            },
                            {
                                "example_id": "e52fc19f-149b-4489-bd1b-34e304b07680",
                                "sense_id": "5c819227-b36b-3ef1-8a19-e68bae0febaa",
                                "text": "Gardes nationaux, bourgeois, gardes mobiles criaient, s’agitaient. Des députations passaient, frémissantes, se rendant chez le maréchal."
                            },
                            {
                                "example_id": "c08be838-53b1-4c4f-adb0-345b2485347b",
                                "sense_id": "5c819227-b36b-3ef1-8a19-e68bae0febaa",
                                "text": "La suite est connue : Lord Durham propose en 1839 d’assimiler les francophones et de fusionner les deux colonies en une seule en leur donnant une part égale de la députation alors que la population du Bas-Canada dépasse largement celle du Haut-Canada."
                            }
                        ]
                    },
                    {
                        "sense_id": "316632e2-f0b0-3723-9ce0-f6c5c4ad0cf4",
                        "entry_id": "cb85c21e-2889-3798-903f-ec3d107c4125",
                        "glosses": [
                            "Charge de député, surtout en parlant de ceux qui sont désignés par le suffrage universel pour faire partie d’une assemblée délibérante."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "88d00cba-39d1-4d6f-b39e-44e6af630556",
                                "sense_id": "316632e2-f0b0-3723-9ce0-f6c5c4ad0cf4",
                                "text": "Songe que je meurs d’envie d’entendre Rubini, et que du vivant d’un beau-père avare je n’ai qu’un moyen au monde de retourner à Paris : la députation."
                            },
                            {
                                "example_id": "88bfcf3f-db34-4c34-8191-d8bee17676ad",
                                "sense_id": "316632e2-f0b0-3723-9ce0-f6c5c4ad0cf4",
                                "text": "Charles de Bernage, spéculateur enrichi et futur candidat à la députation, n'avait jamais eu le temps de s'apercevoir qu'il lui manquait quelque chose."
                            },
                            {
                                "example_id": "0b78c5d5-8e30-4f38-a60c-c76faf471222",
                                "sense_id": "316632e2-f0b0-3723-9ce0-f6c5c4ad0cf4",
                                "text": "Il faut aussi bénéficier d’une relation de confiance et celle-ci s’établit avec la population quand le candidat à la députation a su démontrer sa compétence comme élu local en étant tout à la fois l’élu de tous, mais aussi l’expression d’une fraction d’entre eux ; sa sensibilité politique est aussi un des facteurs de sa légitimité à court terme et à moyen terme."
                            },
                            {
                                "example_id": "812492cb-ec03-482d-853a-79911015d6ae",
                                "sense_id": "316632e2-f0b0-3723-9ce0-f6c5c4ad0cf4",
                                "text": "Pour le consoler, on le nomma préfet de Mabombo, une ville de Bouenza, sa région natale où, trois ans après il se présenta à la députation."
                            },
                            {
                                "example_id": "ba16cf12-81c5-4dbb-83d4-450506e8e0b8",
                                "sense_id": "316632e2-f0b0-3723-9ce0-f6c5c4ad0cf4",
                                "text": "À notre sens, plus les propositions de mesures législatives proposées par les candidats à la députation seront conformes à ces engagements internationaux et européens, plus elles seront sérieuses et intéressantes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7d76f1b5-0807-4db5-8737-3115e45e87d4",
                        "source_entry_id": "cb85c21e-2889-3798-903f-ec3d107c4125",
                        "source_sense_description": "Action de députer",
                        "target_lang_word": "Abordnung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Abordnung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8dda3e59-e0e3-3f64-b85f-40a9f983be70",
                                        "entry_id": "3d33437e-1d5a-31d1-a577-f35bc6881a90",
                                        "glosses": [
                                            "Entsendung einer Personengruppe im Interesse ihres Auftraggebers"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82d39903-7416-4fef-879f-23e26ce33c03",
                                                "sense_id": "8dda3e59-e0e3-3f64-b85f-40a9f983be70",
                                                "text": "Der Lehrerin missfiel ihre Abordnung an eine andere Schule."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ab542db0-397c-3c85-a6a0-2c72d1c9d17c",
                                        "entry_id": "3d33437e-1d5a-31d1-a577-f35bc6881a90",
                                        "glosses": [
                                            "Personengruppe, die im Interesse ihres Auftraggebers entsendet wird oder wurde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da078a8f-e182-4864-94b9-9c565f8a84f0",
                                                "sense_id": "ab542db0-397c-3c85-a6a0-2c72d1c9d17c",
                                                "text": "Die Abordnung hatte keine ausreichenden Vollmachten für die Verhandlungen."
                                            },
                                            {
                                                "example_id": "ce386dab-f114-4013-8d1c-f839ccd913cd",
                                                "sense_id": "ab542db0-397c-3c85-a6a0-2c72d1c9d17c",
                                                "text": "„Die Sache war dermaßen wichtig, dass Abordnungen von Ratsherren begleitet von protokollführenden Rechenmeistern, darunter auch Adam Ries, sich persönlich erst in die Mühlen und dann in die Backstuben begaben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dcfba267-2927-40cb-aef2-0be66b299fbc",
                        "source_entry_id": "cb85c21e-2889-3798-903f-ec3d107c4125",
                        "source_sense_description": "Action de députer",
                        "target_lang_word": "deputation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "deputation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "52395a07-f85a-3aec-991b-569155840d7c",
                                        "entry_id": "0a1f8b4d-cb8a-3a08-9809-31bc595e09ba",
                                        "glosses": [
                                            "The act of deputing, or of appointing or commissioning a deputy or representative; office of a deputy or delegate; vicegerency."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07a055a6-cb5b-4b29-aaa6-35600dc504df",
                                                "sense_id": "52395a07-f85a-3aec-991b-569155840d7c",
                                                "text": "The authority of conscience stands founded upon its vicegerency and deputation under God."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "924e7ac1-009b-3c6a-ae25-df07b4055a3f",
                                        "entry_id": "0a1f8b4d-cb8a-3a08-9809-31bc595e09ba",
                                        "glosses": [
                                            "The person or persons deputed or commissioned by another person, party, or public body to act in his or its behalf; a delegation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d315579-f831-44d0-9f54-3668e1febf2f",
                                                "sense_id": "924e7ac1-009b-3c6a-ae25-df07b4055a3f",
                                                "text": "The general sent a deputation to the enemy to propose a truce."
                                            },
                                            {
                                                "example_id": "96115a5d-4984-4db3-923c-cb5b8bacefc6",
                                                "sense_id": "924e7ac1-009b-3c6a-ae25-df07b4055a3f",
                                                "text": "A deputation came to the Hotel de Ville from the district of the Mathurins, where the people had assembled, appointed a president and other officers, and begun to make a list of the citizens who were able to bear arms."
                                            },
                                            {
                                                "example_id": "2dca21c7-31fd-4e77-9931-eb209f1c17d7",
                                                "sense_id": "924e7ac1-009b-3c6a-ae25-df07b4055a3f",
                                                "text": "From time to time deputations from the town urged the construction of a more central station, and in November, 1842, the directors announced that a temporary station at the south end of the viaduct would be erected as early as practicable, and the experiment fairly tried, but that under no circumstances would the company consent to the expense of having two passenger stations at Stockport."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fe6649af-1025-32d0-b5c4-135fda035dc4",
                                        "entry_id": "0a1f8b4d-cb8a-3a08-9809-31bc595e09ba",
                                        "glosses": [
                                            "Among Christian missionaries, the process or period of time during which they raise support in preparation for going to their mission field."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
