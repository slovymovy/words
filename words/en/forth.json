    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "5a2234b4-d93b-3341-88c4-58c7a823346e",
                    "sense_definition": "Out into view or away from a particular place or position",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young hero decided to venture <w>forth</w> into the unknown forest to find the lost treasure.",
                            "target_lang_translations": {
                                "ru": "Юный герой решил отправиться <w>вперед</w> в неизведанный лес на поиски затерянного сокровища."
                            }
                        },
                        {
                            "text": "As the warm sun began to shine, the small plants started to put <w>forth</w> new green leaves.",
                            "target_lang_translations": {
                                "ru": "Когда начало светить теплое солнце, маленькие растения стали <w>выпускать</w> новые зеленые листья."
                            }
                        }
                    ],
                    "common_phrases": [
                        "venture forth",
                        "put forth",
                        "bring forth",
                        "set forth"
                    ],
                    "target_lang_definitions": {
                        "ru": "Наружу, вперед или прочь из определенного места или положения"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вперед",
                                "target_lang_sense_clarification": "в направлении движения"
                            },
                            {
                                "target_lang_word": "наружу",
                                "target_lang_sense_clarification": "изнутри вовне"
                            },
                            {
                                "target_lang_word": "дальше",
                                "target_lang_sense_clarification": "прочь от места"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bf6e44f8-ca5c-390e-9f80-dcb36e51c6d3",
                    "sense_definition": "Forward in time, place, or degree",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "progression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "From this day <w>forth</w>, the two kingdoms agreed to live in peace and cooperation.",
                            "target_lang_translations": {
                                "ru": "С этого дня и <w>впредь</w> два королевства согласились жить в мире и сотрудничестве."
                            }
                        },
                        {
                            "text": "The speaker launched <w>forth</w> into a long explanation about the benefits of the new policy.",
                            "target_lang_translations": {
                                "ru": "Оратор <w>пустился</w> в долгие объяснения преимуществ новой политики."
                            }
                        }
                    ],
                    "antonyms": [
                        "back"
                    ],
                    "common_phrases": [
                        "from this day forth",
                        "and so forth",
                        "launch forth"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вперед во времени, пространстве или степени"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "впредь",
                                "target_lang_sense_clarification": "в будущем, в дальнейшем"
                            },
                            {
                                "target_lang_word": "вперед",
                                "target_lang_sense_clarification": "в пространстве или времени"
                            },
                            {
                                "target_lang_word": "далее",
                                "target_lang_sense_clarification": "в последовательности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4bcd65e3-8fae-3c52-9b1b-cc29805e4f15",
                    "sense_definition": "Beyond a certain boundary or away from home",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "location",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He had no intention of dining <w>forth</w> tonight and preferred to stay in his own house.",
                            "target_lang_translations": {
                                "ru": "У него не было намерения обедать <w>вне дома</w> сегодня вечером, и он предпочел остаться у себя."
                            }
                        },
                        {
                            "text": "The guards were ordered to keep the prisoners from stepping <w>forth</w> of the designated area.",
                            "target_lang_translations": {
                                "ru": "Стражникам было приказано не давать заключенным выходить <w>за пределы</w> обозначенной зоны."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in older literature to mean away from home or outside"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "За пределы определенной границы или вдали от дома (устаревшее)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вне дома",
                                "target_lang_sense_clarification": "снаружи"
                            },
                            {
                                "target_lang_word": "наружу",
                                "target_lang_sense_clarification": "за пределы"
                            }
                        ]
                    }
                }
            ]
        },
        {
