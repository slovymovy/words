                        "cross_references": [
                            {
                                "target_word": "Lyonnaise",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "786302fb-2137-3afd-a50c-cdf9d6c11a01",
                                        "entry_id": "14de2516-b8d8-3d87-b737-4d88152de296",
                                        "glosses": [
                                            "Habitante de Lyon, commune française située dans le département du Rhône."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f580169b-1d54-4d3c-a801-ec3d7b6fed83",
                                                "sense_id": "786302fb-2137-3afd-a50c-cdf9d6c11a01",
                                                "text": "Versées dans le groupe C, le plus dur, les Lyonnaises entament leur campagne de Ligue des champions par une périlleuse réception d’Arsenal, ce mercredi (21 heures), qui dans ses rangs la meilleure joueuse de l’Euro, Beth Mead."
                                            },
                                            {
                                                "example_id": "60b3bba3-5bd8-470f-a161-3cbe8a7d7930",
                                                "sense_id": "786302fb-2137-3afd-a50c-cdf9d6c11a01",
                                                "text": "De l’autre côté, le duo Eugénie Le Sommer - Kadidiatou Diani va confronter enfin sa connexion à une défense plus agressive emmenée par la Lyonnaise Ellie Carpenter, après avoir fait beaucoup de mal à celle plus faible des Marocaines."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Lyonnaise",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7cc0211b-004a-315a-96ab-ada04d37775f",
                                        "entry_id": "4b236751-22c5-3617-9756-84477e352ede",
                                        "glosses": [
                                            "Gaule lyonnaise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a51a649-8788-4fae-a1de-5e8a0803ea67",
                                                "sense_id": "7cc0211b-004a-315a-96ab-ada04d37775f",
                                                "text": "Ensuite, Septime Sévère fut envoyé comme gouverneur, avec le titre de légat impérial propréteur, en Lyonnaise où il résida de 186 à 188, et c’est à Lyon que naquit son fils aîné, connu par la suite sous le sobriquet de Caracalla, du nom d’un manteau gaulois qu’il affectionnait particulièrement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
