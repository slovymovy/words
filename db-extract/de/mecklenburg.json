                "senses": [
                    {
                        "sense_id": "91c4d031-2284-364c-bd59-a333b6e38219",
                        "entry_id": "644f22f1-e96d-3174-bb28-c72872e5b699",
                        "glosses": [
                            "eine Region im Norden Deutschlands"
                        ],
                        "tags": [
                            "geography"
                        ],
                        "examples": [
                            {
                                "example_id": "3700b3fc-d928-41aa-9795-beadb0c5a6c1",
                                "sense_id": "91c4d031-2284-364c-bd59-a333b6e38219",
                                "text": "„Die größten Städte Mecklenburgs sind Rostock, Schwerin und Neubrandenburg.“"
                            },
                            {
                                "example_id": "a956c140-f2cb-4cb5-8a5e-7c9c578df896",
                                "sense_id": "91c4d031-2284-364c-bd59-a333b6e38219",
                                "text": "„Mecklenburg war ein jahrhundertealtes reichsunmittelbares Territorium von Deutschland mit eigener Geschichte und unverwechselbarer Kultur und ist heute der westliche und größere Teil des Bundeslandes Mecklenburg-Vorpommern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9b3f0747-0cc2-419c-a2c6-b28b4cd18a65",
                        "source_entry_id": "644f22f1-e96d-3174-bb28-c72872e5b699",
                        "source_sense_id": "91c4d031-2284-364c-bd59-a333b6e38219",
                        "source_sense_description": "Geografie: eine Region im Norden Deutschlands",
                        "target_lang_word": "Mecklenburg",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mecklenburg",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d584d6ad-d27f-36d1-836d-be18eeca3af5",
                                        "entry_id": "c361676e-779e-3d23-8993-1cdeca11c8dc",
                                        "glosses": [
                                            "A historical region in Baltic northern Germany; part of the modern state of Mecklenburg-Vorpommern."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a260892-4108-48e3-a718-1a2fed5a8767",
                                                "sense_id": "d584d6ad-d27f-36d1-836d-be18eeca3af5",
                                                "text": "Since the reign of Charlemagne, this country is divided into High and Low Germany... the provinces of Lower Germany towards the north conſiſt of the Low Country of the Rhine, Triers, Cologn, Mentz, Weſtphalia, Heſſe, Brunſwic, Miſnia, Luſatia, High Saxony upon the Elbe, Low Saxony upon the Elbe, Mecklenburg, Lauenburg, Brandenburg, Magdeburg, and Pomerania."
                                            },
                                            {
                                                "example_id": "b7f5374d-5f40-487f-9af5-2072dff8049b",
                                                "sense_id": "d584d6ad-d27f-36d1-836d-be18eeca3af5",
                                                "text": "Men like Fritz Reuter (employing the Mecklenburg dialect) and Klaus Groth (employing the Holstein dialect) have tried to raise it [= New-Low-German, or Plattdeutsch] to a written language."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94fb1d49-2f2f-3897-921f-315dcb610146",
                                        "entry_id": "c361676e-779e-3d23-8993-1cdeca11c8dc",
                                        "glosses": [
                                            "A surname from German."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d8b9b723-fbc9-4c84-b895-fa9a09fec21a",
                        "source_entry_id": "644f22f1-e96d-3174-bb28-c72872e5b699",
                        "source_sense_id": "91c4d031-2284-364c-bd59-a333b6e38219",
                        "source_sense_description": "Geografie: eine Region im Norden Deutschlands",
                        "target_lang_word": "Mecklembourg",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mecklembourg",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "27bc435c-50ca-31da-bef5-0b4c69c739a1",
                                        "entry_id": "9ab3d817-780c-3c7a-8123-4b5526dff7c4",
                                        "glosses": [
                                            "Région de l’Allemagne septentrionale, comprise entre la mer Baltique, la Recknitz, la Trebel, l’Elbe, la Basse-Saxe et le Holstein."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01c0f9bc-b5af-4d20-923b-80938902cabd",
                                                "sense_id": "27bc435c-50ca-31da-bef5-0b4c69c739a1",
                                                "text": "Le Prince téméraire était forcé de se retirer en perdant beaucoup de monde, et notre armée toute vive restait entière pour faire face à l’abominable crapule de Mecklembourg, désormais facilement écrasable."
                                            },
                                            {
                                                "example_id": "59edbd2e-ea05-456b-9d99-bfe9897735c1",
                                                "sense_id": "27bc435c-50ca-31da-bef5-0b4c69c739a1",
                                                "text": "Elle allait passer le dimanche à Paris, en compagnie de l’Orstkommandant, un noble du Mecklembourg qui lui envoyait son ordonnance et sa voiture, mais à l’aube du lundi elle était là, foulard sur la tête et bottée souple."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e9a8fd77-72ad-368d-9256-49ae9b539233",
                                        "entry_id": "9ab3d817-780c-3c7a-8123-4b5526dff7c4",
                                        "glosses": [
                                            "Nom de l’ancien Land de la RDA de 1945 à 1952, dont le territoire correspondait approximativement à l’actuel Land de Mecklembourg-Poméranie-Occidentale."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
