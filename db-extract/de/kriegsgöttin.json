                        "entry_id": "c73d1afd-64e0-3014-b944-76868590c773",
                        "glosses": [
                            "Göttin, die mit kriegerischen Handlungen in Verbindung gebracht und zum Beispiel zum Erhalt der göttlichen Gunst in diesen angebetet wird"
                        ],
                        "tags": [
                            "meist polytheistische Religionen"
                        ],
                        "examples": [
                            {
                                "example_id": "3ff398a0-5e06-44c3-96f9-c83bf428ea7b",
                                "sense_id": "a3417fef-a00d-38d2-8909-9b8770f289c7",
                                "text": "„Durga ist eine Inkarnation der Begleiterin des Gottes Schiwa Parvati, eine Kriegsgöttin mit zehn Händen, die den Büffeldämon besiegte.“"
                            },
                            {
                                "example_id": "6750f4d3-6797-400a-ada9-4d2d9420ed1f",
                                "sense_id": "a3417fef-a00d-38d2-8909-9b8770f289c7",
                                "text": "Man kann die Walkyrien als Kriegsgöttinnen sehen."
                            }
                        ],
