                                                "example_id": "4a7ffb7f-0776-4b6f-a111-2ce6afc2f2d1",
                                                "sense_id": "eb591eea-7c7a-3943-9f4d-89283f9751cd",
                                                "text": "Quand on connaît la faute, on manque doublement."
