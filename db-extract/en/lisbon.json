                                            {
                                                "example_id": "7cc1d6dc-68d2-4dac-a639-55d92a51fb3b",
                                                "sense_id": "716d062d-c65c-3f9e-8db7-3ce711be3893",
                                                "text": "Lissabon is de hoofdstad en grootste stad van Portugal."
                                            },
                                            {
                                                "example_id": "8498c4d8-4bb0-4e1d-89ad-db069b6f2ecd",
                                                "sense_id": "716d062d-c65c-3f9e-8db7-3ce711be3893",
                                                "text": "De aardbeving van Lissabon verwoestte in 1755 een van de grootste steden ter wereld en gaf aanleiding tot een verbitterde twist tussen theologen en filosofen, die de Verlichting in de kaart speelde."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
