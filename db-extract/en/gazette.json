                    }
                ],
                "translations": [
                    {
                        "translation_id": "321b7e41-3db1-481c-ae15-07fc8f86bc05",
                        "source_entry_id": "f5afc68d-57cb-33d3-8be8-d86730d82648",
                        "source_sense_description": "newspaper — see also newspaper",
                        "target_lang_word": "Gazette",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
