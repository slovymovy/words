                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c64010b2-732c-474d-894b-2caaebaead86",
                                "sense_id": "0f6aed6c-64b9-33eb-b98e-b05fccbead54",
                                "text": "„Sie könnten also ein ideales Forschungsobjekt abgeben, wenn die Annahme zutrifft, dass sie eine ursprüngliche Kultur unverfälscht überliefert haben.“"
                            },
                            {
                                "example_id": "217f84b4-c15b-4a26-80f1-a8378d9b597e",
                                "sense_id": "0f6aed6c-64b9-33eb-b98e-b05fccbead54",
                                "text": "„Stattdessen beschloss sie, den Russenbesuch und ihre eigenen Eltern als Forschungsobjekte für ihre Arbeit zu nehmen.“"
                            }
                        ],
