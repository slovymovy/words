                        "target_lang_word": "biceps",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "biceps",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0c61855f-737f-3cf4-ab60-22e511949319",
                                        "entry_id": "8260830a-f948-3f07-b1b3-7185f84644a2",
                                        "glosses": [
                                            "Muscle dont la partie supérieure est divisée en deux : soit biceps brachial ou biceps fémoral."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8fad3c83-d52b-4658-a70f-3c6dcf0db0a7",
                                                "sense_id": "0c61855f-737f-3cf4-ab60-22e511949319",
                                                "text": "Le biceps du bras ou biceps brachial."
                                            },
                                            {
                                                "example_id": "f9ec572b-0f12-4d9d-b287-6a9649d17676",
                                                "sense_id": "0c61855f-737f-3cf4-ab60-22e511949319",
                                                "text": "Le biceps de la cuisse."
                                            },
                                            {
                                                "example_id": "d7144e20-aa58-4a1e-9228-be54eb05157d",
                                                "sense_id": "0c61855f-737f-3cf4-ab60-22e511949319",
                                                "text": "Du point de vue diagnostique et thérapeutique, il faut individualiser les ruptures des tendons de la coiffe des rotateurs, des tendons du biceps et du triceps, et des tendons des poignets et des doigts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8518daa3-c87f-3e9b-964e-924b6067e1de",
                                        "entry_id": "8260830a-f948-3f07-b1b3-7185f84644a2",
                                        "glosses": [
                                            "Biceps brachial, muscle du bras."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f9a58f39-ca8e-4f93-ad37-93a49e1dad3a",
                                                "sense_id": "8518daa3-c87f-3e9b-964e-924b6067e1de",
                                                "text": "Nous disons que la femme n’est pas destinée exclusivement à faire et à élever des enfants, pas plus que l’homme n’est exclusivement créé pour s’enorgueillir de ses biceps et pour travailler de ses bras."
                                            },
                                            {
                                                "example_id": "cd491b7f-e1b8-4ca7-88d2-43d4a9449b99",
                                                "sense_id": "8518daa3-c87f-3e9b-964e-924b6067e1de",
                                                "text": "Les mouvements de flexion et d’extension de l’avant-bras sont gérés par plusieurs muscles dont le biceps (muscle fléchisseur) et le triceps (muscle extenseur)."
                                            },
                                            {
                                                "example_id": "8be543ed-ab92-4693-a694-77da4fb15542",
                                                "sense_id": "8518daa3-c87f-3e9b-964e-924b6067e1de",
                                                "text": "Avoir du biceps, avoir ce muscle très développé, être très vigoureux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
