{
    "word_family": [
        "jar",
        "jarred"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "1a42ebaf-5b2f-3f30-b59a-3fa2d403adf9",
                    "sense_definition": "causing a physical shock, vibration, or a harsh, unpleasant effect on the senses or mind",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sensory_experience",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden transition from the quiet library to the loud street was a <w>jarring</w> experience for him.",
                            "target_lang_translations": {
                                "ru": "Внезапный переход из тихой библиотеки на шумную улицу стал для него <w>резким</w> испытанием.",
                                "zh": "从安静的图书馆突然走到嘈杂的街上，对他来说是一种<w>刺耳的</w>体验。",
                                "cs": "Náhlý přechod z tiché knihovny na hlučnou ulici byl pro něj <w>dráždivým</w> zážitkem."
                            }
                        },
                        {
                            "text": "The bright neon colors of the new building strike a <w>jarring</w> note against the historic architecture of the neighborhood.",
                            "target_lang_translations": {
                                "ru": "Яркие неоновые цвета нового здания вносят <w>диссонирующую</w> ноту в историческую архитектуру района.",
                                "zh": "新建筑明亮的霓虹色彩与社区的历史建筑风格显得十分<w>不协调</w>。",
                                "cs": "Jasné neonové barvy nové budovy působí v kontrastu s historickou architekturou čtvrti <w>nesourodě</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "clashing",
                        "discordant",
                        "incongruous",
                        "jolting"
                    ],
                    "antonyms": [
                        "harmonious",
                        "soothing"
                    ],
                    "common_phrases": [
                        "jarring note",
                        "jarring effect",
                        "jarring experience"
                    ],
                    "target_lang_definitions": {
                        "ru": "вызывающий физический шок, вибрацию или резкое, неприятное воздействие на чувства или разум",
                        "zh": "引起身体震动、不适感，或对感官和心理产生刺耳、不愉快的影响",
                        "cs": "způsobující fyzický otřes, vibrace nebo drsný, nepříjemný účinek na smysly či mysl"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "раздражающий",
                                "target_lang_sense_clarification": "неприятно действующий на чувства"
                            },
                            {
                                "target_lang_word": "резкий",
                                "target_lang_sense_clarification": "о звуке или переходе"
                            },
                            {
