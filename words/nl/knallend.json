                    "frequency": "Middle",
                    "semantic_group_id": "intensiteit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij draagt vandaag een jurk met een <w>knallende</w> kleurencombinatie die direct de aandacht trekt.",
                            "target_lang_translations": {
                                "en": "Today she is wearing a dress with a <w>vibrant</w> color combination that immediately attracts attention."
                            }
