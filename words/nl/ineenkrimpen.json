{
    "word_family": [
        "krimpen",
        "inkrimpen",
        "krimp"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e8e4ec53-3502-3489-862b-7cdff429072d",
                    "sense_definition": "zich angstig of pijnlijk in elkaar trekken",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fysieke_reactie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Toen de harde klap klonk, zag ik hem van schrik <w>ineenkrimpen</w>.",
                            "target_lang_translations": {
                                "en": "When the loud bang sounded, I saw him <w>cringe</w> with fright."
                            }
                        },
                        {
                            "text": "Zij moest <w>ineenkrimpen</w> van de pijn toen de arts haar zere been aanraakte.",
                            "target_lang_translations": {
                                "en": "She had to <w>wince</w> with pain when the doctor touched her sore leg."
                            }
                        }
                    ],
                    "synonyms": [
                        "ineenducken",
                        "ineenkruipen"
                    ],
                    "common_phrases": [
                        "ineenkrimpen van de pijn",
                        "ineenkrimpen van schrik"
                    ],
                    "target_lang_definitions": {
                        "en": "To contract or draw oneself together in fear or pain"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "cringe",
                                "target_lang_sense_clarification": "to shrink back in fear or pain"
                            },
                            {
                                "target_lang_word": "wince",
                                "target_lang_sense_clarification": "to shrink back involuntarily from pain or distress"
                            },
                            {
                                "target_lang_word": "cower",
                                "target_lang_sense_clarification": "to crouch down in fear"
                            },
                            {
                                "target_lang_word": "shrink",
                                "target_lang_sense_clarification": "to move back or away in fear or disgust"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4352fba9-2a4d-3307-945a-325034485308",
                    "sense_definition": "kleiner, korter of rimpelig worden door samentrekking",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "samentrekken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Door de extreme hitte begon het plastic snel <w>ineen</w> te <w>krimpen</w>.",
                            "target_lang_translations": {
                                "en": "Due to the extreme heat, the plastic quickly began to <w>shrink</w>."
                            }
                        },
                        {
                            "text": "De natte wollen trui zal flink <w>ineenkrimpen</w> als je hem in de droger stopt.",
                            "target_lang_translations": {
                                "en": "The wet woolen sweater will <w>shrink</w> considerably if you put it in the dryer."
                            }
                        }
                    ],
                    "synonyms": [
                        "samentrekken",
                        "krimpen",
                        "verschrompelen"
                    ],
                    "antonyms": [
                        "uitzetten"
                    ],
                    "common_phrases": [
                        "door hitte ineenkrimpen"
                    ],
                    "target_lang_definitions": {
                        "en": "To become smaller, shorter, or wrinkled due to contraction"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "shrink",
                                "target_lang_sense_clarification": "to become smaller or contract"
                            },
                            {
                                "target_lang_word": "shrivel",
                                "target_lang_sense_clarification": "to wrinkle and contract, especially due to heat or dryness"
                            },
                            {
                                "target_lang_word": "contract",
                                "target_lang_sense_clarification": "to become smaller or tighter"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}