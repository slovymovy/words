                                        "examples": [
                                            {
                                                "example_id": "9a88f207-879f-46f6-869d-70fa8a804c5a",
                                                "sense_id": "fa4ba8e2-3762-35de-ab8a-e29836085f5d",
                                                "text": "Der Axolotl erreicht seine Geschlechtsreife, ohne seine Larvengestalt zu verlieren."
