                    }
                ],
                "senses": [
                    {
                        "sense_id": "d9514b0c-fce8-338a-949f-60fdda07c8f1",
                        "entry_id": "6aed93ca-abf7-3364-85ca-76e30751bb29",
                        "glosses": [
                            "To throw (something), as if to break (it)."
                        ],
                        "tags": [
                            "dialectal"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "a784b7dd-9fa9-3992-aaf2-386d09bdb11d",
                        "entry_id": "6aed93ca-abf7-3364-85ca-76e30751bb29",
                        "glosses": [
                            "To smash; to crush; to bash; to break into pieces."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe103633-f8e6-4270-b561-e699633dcc7e",
                                "sense_id": "a784b7dd-9fa9-3992-aaf2-386d09bdb11d",
                                "text": "Hercules, that in his infancie\nDid paſh the iawes of Serpents venemous:"
                            },
                            {
                                "example_id": "631dd82b-6847-4c44-8c50-ab0447c1b37a",
                                "sense_id": "a784b7dd-9fa9-3992-aaf2-386d09bdb11d",
                                "text": "I'll pash him o'er the face."
                            },
                            {
                                "example_id": "ec3f1072-9305-4f88-9186-39873f6a6dcc",
                                "sense_id": "a784b7dd-9fa9-3992-aaf2-386d09bdb11d",
                                "text": "[...] 'tis a brute must walk / Pashing their life out, with a brute's intents."
                            }
                        ]
                    },
                    {
                        "sense_id": "40c2cde8-c086-3a35-b331-599d659a8e88",
                        "entry_id": "6aed93ca-abf7-3364-85ca-76e30751bb29",
                        "glosses": [
                            "To fall heavily or forcefully."
                        ],
                        "tags": [
                            "of rain"
                        ],
                        "examples": [
                            {
                                "example_id": "133ff3cb-9fe9-4ccc-a463-e2ca65656e24",
                                "sense_id": "40c2cde8-c086-3a35-b331-599d659a8e88",
                                "text": "... the rain came \"pashing\" down again and drove her indoors."
                            },
                            {
                                "example_id": "1e7f931a-ce5d-4640-bf6a-beb71ba03430",
                                "sense_id": "40c2cde8-c086-3a35-b331-599d659a8e88",
                                "text": "... sent a heavy rain-drop pashing in our faces and now woke the woods with rattling peals of thunder."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
