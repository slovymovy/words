                {
                    "sense_id": "734aa024-c682-351e-828d-53f460ffb629",
                    "sense_definition": "Der planmäßige Wechsel von Personen oder Schichten bei einer beruflichen oder dienstlichen Aufgabe.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "schichtwechsel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nach acht Stunden harter Arbeit freute sich der Wachposten auf die pünktliche <w>Ablösung</w>."
                        },
                        {
                            "text": "Die <w>Ablösung</w> der Nachtschicht erfolgt jeden Morgen um genau sechs Uhr."
                        }
                    ],
                    "synonyms": [
                        "Schichtwechsel"
                    ],
                    "common_phrases": [
                        "zur Ablösung bereitstehen",
                        "die Ablösung der Wache"
                    ]
                },
                {
                    "sense_id": "78a66142-4a6b-3b32-a242-8a15fed00614",
                    "sense_definition": "Die Person oder Gruppe, die jemanden bei einer Aufgabe oder Schicht ablöst.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "schichtwechsel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Da seine <w>Ablösung</w> noch immer nicht eingetroffen war, musste er eine weitere Stunde bleiben."
                        },
                        {
                            "text": "Meine <w>Ablösung</w> steht schon an der Tür bereit, um mich am Empfang zu vertreten."
                        }
                    ],
                    "synonyms": [],
                    "antonyms": [],
                    "common_phrases": [
                        "auf die Ablösung warten"
                    ]
                },
                {
                    "sense_id": "3a58c0b7-ef01-3739-9670-4d69b1b6fd8a",
                    "sense_definition": "Das bewusste Lösen oder vorsichtige Entfernen von etwas, das irgendwo haftet oder befestigt ist.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "trennen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Für die sorgfältige <w>Ablösung</w> der alten Tapete verwendeten die Handwerker speziellen Dampf."
                        },
                        {
                            "text": "Bei der Restaurierung des Gemäldes erfordert die <w>Ablösung</w> der Schmutzschicht viel Geduld."
                        }
                    ],
                    "synonyms": [
                        "Entfernung"
                    ],
                    "antonyms": [],
                    "common_phrases": [
                        "die Ablösung von Tapeten"
                    ]
                },
                {
                    "sense_id": "9db80b84-02e0-34cc-8469-ed4d7a7e2665",
                    "sense_definition": "Das unbeabsichtigte Lösen, Sich-Lösen oder Abfallen einer zuvor haftenden Schicht oder Struktur.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "trennen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die starke Feuchtigkeit an der Wand führte zur allmählichen <w>Ablösung</w> des Putzes."
                        },
                        {
                            "text": "Der Augenarzt stellte bei der Untersuchung eine gefährliche <w>Ablösung</w> der Netzhaut fest."
                        }
                    ],
                    "synonyms": [
                        "Abfallen"
                    ],
                    "antonyms": [],
                    "common_phrases": [
                        "Ablösung der Netzhaut"
                    ]
                }
            ]
        }
