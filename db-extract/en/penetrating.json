                                "sense_id": "15f3cfc5-5abb-358c-a707-9ee941ec15f5",
                                "text": "He had a very penetrating pair of brown eyes."
                            }
                        ]
                    },
                    {
                        "sense_id": "75ae121f-20d9-312c-b9aa-c6747bfde947",
                        "entry_id": "557bb23b-8fab-3768-bdc5-27d9b36d20b5",
                        "glosses": [
                            "Demonstrating acute or keen understanding"
