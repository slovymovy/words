            {
                "entry_id": "b0e57f1a-5670-3bbf-a2ed-4a02d3b02f87",
                "word": "Tupperware",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "ed967c2b-0d5a-4c7c-9554-29ce1e964ce2",
                        "entry_id": "b0e57f1a-5670-3bbf-a2ed-4a02d3b02f87",
