                        "sense_id": "a2a73a8c-8127-32ed-98e3-2eb913fc20c7",
                        "entry_id": "96aa67d6-2993-3c1b-a5dc-a0391c2d1555",
                        "glosses": [
                            "Wearing nothing on the feet; barefoot."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7e2ceab-2030-4516-ac93-c64acdac52b0",
                                "sense_id": "a2a73a8c-8127-32ed-98e3-2eb913fc20c7",
                                "text": "By following the sound I came upon a bare-footed old woman with a yellow dried-up countenance, who was bending down over the pigs' trough, busy filling it with food, for which the noisy little creatures were fighting, tearing, pushing, and yelling, with expectation and delight."
                            },
                            {
                                "example_id": "8a13415e-174f-49f3-8603-9cf797ff3b73",
                                "sense_id": "a2a73a8c-8127-32ed-98e3-2eb913fc20c7",
                                "text": "There were no roads, only paths through the grass worn away by barefooted boys and women."
                            }
                        ]
                    }
                ],
