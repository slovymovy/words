                "translations": [
                    {
                        "translation_id": "a02fe175-16a0-4562-adad-38d7c1c2e0b1",
                        "source_entry_id": "b9aba10b-d5a1-3712-ac53-ea9256348482",
                        "source_sense_id": "063e317f-692a-311e-aef3-b560f5689dc3",
                        "target_lang_word": "Hain",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hain",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d032bc97-1fde-3f66-a3d6-506b22b8df52",
                                        "entry_id": "5e443c85-8bf3-358b-8295-5b242d7d0516",
                                        "glosses": [
                                            "kleiner lichter Wald (der häufig wie ein Park besonders gepflegt wird oder der Verehrung einer Gottheit dient)"
                                        ],
                                        "tags": [
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "55fb04bc-4288-47f6-b692-a242af63ab15",
                                                "sense_id": "d032bc97-1fde-3f66-a3d6-506b22b8df52",
                                                "text": "„Moderne Forscher halten den Hain für ein natürliches Erosionsprodukt, Spuren menschlicher Bearbeitung konnten nirgendwo nachgewiesen werden.“"
                                            },
                                            {
                                                "example_id": "4f5563c7-df70-4e7a-9323-f134d0bfa37e",
                                                "sense_id": "d032bc97-1fde-3f66-a3d6-506b22b8df52",
                                                "text": "„Hier sträubt sich kein Pförtner,",
                                                "translation": "Sind allen gemein.“"
                                            },
                                            {
                                                "example_id": "fa986135-0b98-4f3d-8da3-3fd650a2ba08",
                                                "sense_id": "d032bc97-1fde-3f66-a3d6-506b22b8df52",
                                                "text": "„Ein heilig Dunkel füllet den ernsten Hain:",
                                                "translation": "Dass nicht die Jungfraun des Haines zürnen!“"
                                            },
                                            {
                                                "example_id": "9e4bda61-28d5-4970-9855-51c661662114",
                                                "sense_id": "d032bc97-1fde-3f66-a3d6-506b22b8df52",
                                                "text": "„Wer du, o Jüngling! auch seist, noch Fremdling im Hain Afroditens,",
                                                "translation": "Amor, im Tempel versteckt, füllt mit Verlangen den Hain.“"
                                            },
                                            {
                                                "example_id": "aa06b59d-da7d-48dc-a891-1176f01a0bee",
                                                "sense_id": "d032bc97-1fde-3f66-a3d6-506b22b8df52",
                                                "text": "„Es ist die Quelle Egeria im heiligen Hain der Diana.“"
                                            },
                                            {
                                                "example_id": "b6682baf-c89e-4858-9a4c-6a4f8f94724d",
                                                "sense_id": "d032bc97-1fde-3f66-a3d6-506b22b8df52",
                                                "text": "„Auf dunklem Irrweg in finstern Hainen",
                                                "translation": "Es dämmerte — es wurde hell!“"
                                            },
                                            {
                                                "example_id": "9a5cd850-abc6-4ee0-91fe-1b055f7a2cc3",
                                                "sense_id": "d032bc97-1fde-3f66-a3d6-506b22b8df52",
                                                "text": "„Horch, der Hain erschallt von Liedern,",
                                                "translation": "Für ein glücklich liebend Paar.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Hain",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
