                    {
                        "translation_id": "20212ed8-b98b-4122-bbe0-5b3a4c2dfd86",
                        "source_entry_id": "615f1e95-4dde-3fa5-b229-f1e300d3ad77",
                        "source_sense_id": "962c1ce3-9436-3c77-939d-c9544d1e0022",
                        "source_sense_description": "Handelsname: das Holz der Palisanderholzbäume (Gattung Dalbergia), ein Edelholz",
                        "target_lang_word": "palissandre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "palissandre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "865cae3d-7eec-3888-a3e7-9b693259b28f",
                                        "entry_id": "f1ff0b77-4db5-3261-86d6-c3aadb3d5225",
                                        "glosses": [
                                            "Nom vernaculaire de divers arbres du genre Dalbergia."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e704a742-71ca-4235-99ea-539847f6685f",
                                                "sense_id": "865cae3d-7eec-3888-a3e7-9b693259b28f",
                                                "text": "On dénomme palissandre les arbres du genre Dalbergia (famille des Fabaceae) . Ceux-ci sont présents, en ce qui concerne notre région, dans les forêts denses sèches et font l'objet d'une intense exploitation."
                                            },
                                            {
                                                "example_id": "7c8b9a4c-07d1-43f8-864a-31f933af88cf",
                                                "sense_id": "865cae3d-7eec-3888-a3e7-9b693259b28f",
                                                "text": "Un perroquet jacassant à la cime d'un palissandre, un agouti apprivoisé qui folâtre près du carbet, un singe, au besoin un prisonnier si l'on en a un sous la main."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "73ef2d45-d033-35b2-9ead-e214908984b6",
                                        "entry_id": "f1ff0b77-4db5-3261-86d6-c3aadb3d5225",
                                        "glosses": [
                                            "Bois violet, nuancé de jaune et de noir selon l’espèce de Dalbergia dont il provient.,"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7881791d-f1e5-4420-ac05-264d165a33e9",
                                                "sense_id": "73ef2d45-d033-35b2-9ead-e214908984b6",
                                                "text": "Mais la maîtresse de nos jours ne se contente plus du flan et de la galette ; quand elle accroche un fils de bourgeois, elle exige de la soie, des fourrures et du palissandre."
                                            },
                                            {
                                                "example_id": "36b3a6ca-e31a-4f94-ac3d-20c7bd26ffaa",
                                                "sense_id": "73ef2d45-d033-35b2-9ead-e214908984b6",
                                                "text": "Il fallait la voir regarder, de ses yeux bordés de rouge, les étalages des bas de soie brodés, et les chapeaux joliment chiffonnés, qui, chez les modistes, se dressent fièrement au haut des champignons de palissandre !"
                                            },
                                            {
                                                "example_id": "30fb8b27-e834-4a58-ac3b-2210347382e2",
                                                "sense_id": "73ef2d45-d033-35b2-9ead-e214908984b6",
                                                "text": "A côté des guitares classiques, avec fond et éclisses en palissandre et mécanique d’accord, Torres a construit à toutes les époques de sa carrière un autre type de guitare, avec une caisse en cyprès et des chevilles d’accord ."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
