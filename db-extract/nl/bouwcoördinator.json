                        "examples": [
                            {
                                "example_id": "a0e59c2c-c191-48c5-a2aa-f054eb8b58e9",
                                "sense_id": "29e4dfa4-68c8-3298-94e9-877def9a6f19",
                                "text": "In 1977 verliet Van Empelen het cabaretgezelschap. Hij werd daarna directeur van het maritiem museum Prins Hendrik in Rotterdam. Later was hij bouwcoördinator bij de Hermitage in Amsterdam."
                            },
                            {
                                "example_id": "f8fd4f90-1f3c-45ca-aa2f-b1184a5cac8b",
                                "sense_id": "29e4dfa4-68c8-3298-94e9-877def9a6f19",
                                "text": "De 25-jarige Kristel van Dalsum is groepsleerkracht (groep 4) en (onder)bouwcoördinator op een school in Rotterdam. Zij heeft een klas van 16 kinderen, van wie de meerderheid extra aandacht nodig heeft vanwege leerachterstanden. Voor de NOS hield zij een weekdagboek bij over de administratieve rompslomp waar zij in haar dagelijkse werk tegenaan loopt."
                            }
                        ]
