                    {
                        "sense_id": "0db73db1-0554-33ec-841f-f9b66daaa570",
                        "entry_id": "27e46bdd-45ca-34b2-ac5c-c629ed8ae580",
                        "glosses": [
                            "To sniff; to snort or snuff."
                        ],
                        "tags": [
                            "dialectal"
                        ],
                        "examples": [
                            {
                                "example_id": "8ed74004-776a-403a-b02a-be1060ca8e2b",
                                "sense_id": "0db73db1-0554-33ec-841f-f9b66daaa570",
                                "text": "[S]he, also, entered, and coming pretty close to my Father, snifted at her Flowers with a sort of extatic eagerness, and then let them fall."
                            },
                            {
                                "example_id": "6b331757-250a-4c23-988c-fe31d6e1db9b",
                                "sense_id": "0db73db1-0554-33ec-841f-f9b66daaa570",
                                "text": "SNUFF. […] Reſentment expreſſed by ſnifting; […]"
                            },
                            {
                                "example_id": "e374c843-37e5-4848-affd-ab0883f8c6ad",
                                "sense_id": "0db73db1-0554-33ec-841f-f9b66daaa570",
                                "text": "It now appears that they were still snifting narration of your lordship is for the greater part and hankering after their old"
                            }
                        ]
                    },
                    {
                        "sense_id": "16add625-75a3-3e51-976d-393484b5172c",
                        "entry_id": "27e46bdd-45ca-34b2-ac5c-c629ed8ae580",
                        "glosses": [
                            "To snivel."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "4f15e3ed-7561-3cb7-ae4f-0bf62c1525dd",
                        "entry_id": "27e46bdd-45ca-34b2-ac5c-c629ed8ae580",
                        "glosses": [
                            "To cause a snift; to release pressure and vapor, such as from a steam engine or bottling equipment."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f49379da-56fe-47ef-a234-2ef9b05801b3",
                                "sense_id": "4f15e3ed-7561-3cb7-ae4f-0bf62c1525dd",
                                "text": "A cap and pipe should be put over the snifting clack, with an inch and a half cock upon it, by the partial opening of which the snifting can be regulated; but which will not be wanted , unless the valve should snift more than enough when it is left quite open , as it will be apt to do when all the preceding articles are put in execution."
                            },
                            {
                                "example_id": "dbf55a4c-e16d-4276-9160-c690bdce15bf",
                                "sense_id": "4f15e3ed-7561-3cb7-ae4f-0bf62c1525dd",
                                "text": "Hold it for a second or two to test the bottle, then snift, and fill the bottle up to the neck."
                            },
                            {
                                "example_id": "884c9b6a-4a4b-47fb-be9b-07e1f9b2986b",
                                "sense_id": "4f15e3ed-7561-3cb7-ae4f-0bf62c1525dd",
                                "text": "Air impurity was reduced to 0.01 percent by freezing a large cylinder of liquid with dry ice and snifting the vapor liberally."
                            },
                            {
                                "example_id": "c1655069-9b71-448c-a295-0453cf529514",
                                "sense_id": "4f15e3ed-7561-3cb7-ae4f-0bf62c1525dd",
                                "text": "the pipeline, by which air or vapour is snifted from the pipeline as the liquid level falls by the approach of an air pocket, through a float-operated valve to a catch tank fitted with a flame trap vent."
                            }
                        ]
                    }
