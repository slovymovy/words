{
    "word_family": [
        "grouser"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b028d042-b704-3afc-964d-3ed6d1713050",
                    "sense_definition": "A medium-sized bird with a plump body and feathered legs, often hunted for sport or food.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "bird_food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hunter spotted a <w>grouse</w> hiding in the tall heather.",
                            "target_lang_translations": {
                                "ru": "Охотник заметил <w>тетерева</w>, прячущегося в высоком вереске.",
                                "it": "Il cacciatore ha avvistato un <w>urogallo</w> nascosto nell'erica alta."
                            }
                        },
                        {
                            "text": "We saw a red <w>grouse</w> during our walk on the moor.",
                            "target_lang_translations": {
                                "ru": "Мы видели шотландскую <w>куропатку</w> во время прогулки по пустоши.",
                                "it": "Abbiamo visto una <w>pernice</w> rossa durante la nostra passeggiata nella brughiera."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Птица среднего размера с плотным телом и оперенными ногами, на которую часто охотятся ради спорта или еды.",
                        "it": "Un uccello di medie dimensioni con corpo robusto e zampe piumate, spesso cacciato per sport o come selvaggina."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рябчик",
                                "target_lang_sense_clarification": "небольшая лесная птица"
                            },
                            {
                                "target_lang_word": "тетерев",
                                "target_lang_sense_clarification": "крупная лесная птица"
                            },
                            {
                                "target_lang_word": "куропатка",
                                "target_lang_sense_clarification": "промысловая птица"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "urogallo",
                                "target_lang_sense_clarification": "uccello della famiglia dei Tetraonidi"
                            },
                            {
                                "target_lang_word": "pernice",
                                "target_lang_sense_clarification": "uccello selvatico spesso cacciato"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2cf29b84-4769-30df-aa6f-956b5c94c5e3",
                    "sense_definition": "The meat of the grouse, used as food.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "bird_food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The restaurant serves roast <w>grouse</w> with seasonal vegetables.",
                            "target_lang_translations": {
                                "ru": "В ресторане подают жареного <w>рябчика</w> с сезонными овощами.",
                                "it": "Il ristorante serve <w>selvaggina</w> arrosto con verdure di stagione."
                            }
                        },
                        {
                            "text": "I have never tasted <w>grouse</w> before.",
                            "target_lang_translations": {
                                "ru": "Я никогда раньше не пробовал <w>тетерева</w>.",
                                "it": "Non ho mai assaggiato la <w>selvaggina</w> prima d'ora."
                            }
                        }
                    ],
                    "common_phrases": [
                        "roast grouse"
                    ],
                    "target_lang_definitions": {
                        "ru": "Мясо этой птицы, употребляемое в пищу.",
                        "it": "La carne di questo uccello, utilizzata come alimento."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рябчик",
                                "target_lang_sense_clarification": "мясо птицы"
                            },
                            {
                                "target_lang_word": "тетерев",
                                "target_lang_sense_clarification": "мясо птицы"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "selvaggina",
                                "target_lang_sense_clarification": "carne di uccelli cacciati"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "68fa3946-df2d-3e1c-822d-5b600c0839a8",
                    "sense_definition": "A complaint or a reason to complain.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "complaint",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My main <w>grouse</w> is that the service is too slow.",
                            "target_lang_translations": {
                                "ru": "Моя главная <w>претензия</w> заключается в том, что обслуживание слишком медленное.",
                                "it": "La mia <w>lamentela</w> principale è che il servizio è troppo lento."
                            }
                        },
                        {
                            "text": "She has a legitimate <w>grouse</w> against the company.",
                            "target_lang_translations": {
                                "ru": "У нее есть обоснованная <w>жалоба</w> на компанию.",
                                "it": "Ha una <w>lamentela</w> legittima contro l'azienda."
                            }
                        }
                    ],
                    "synonyms": [
                        "complaint",
                        "grievance",
                        "grumble"
                    ],
                    "common_phrases": [
                        "main grouse"
                    ],
                    "target_lang_definitions": {
                        "ru": "Жалоба, ворчание или причина для недовольства.",
                        "it": "Una lamentela, un brontolio o un motivo di insoddisfazione."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ворчание",
                                "target_lang_sense_clarification": "выражение недовольства"
                            },
                            {
                                "target_lang_word": "жалоба",
                                "target_lang_sense_clarification": "высказывание неудовольствия"
                            },
                            {
                                "target_lang_word": "претензия",
                                "target_lang_sense_clarification": "требование или жалоба"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "lamentela",
                                "target_lang_sense_clarification": "espressione di insoddisfazione"
                            },
                            {
                                "target_lang_word": "brontolio",
                                "target_lang_sense_clarification": "atto di lamentarsi in modo sommesso"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fd9341be-5a8a-306b-a56a-6567f1a81dbb",
                    "sense_definition": "To complain or grumble, often about unimportant things.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "complaint",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is always <w>grousing</w> about the rainy weather.",
                            "target_lang_translations": {
                                "ru": "Он вечно <w>ворчит</w> на дождливую погоду.",
                                "it": "Sta sempre a <w>brontolare</w> per il tempo piovoso."
                            }
                        },
                        {
                            "text": "Stop <w>grousing</w> and help me fix this problem.",
                            "target_lang_translations": {
                                "ru": "Хватит <w>брюзжать</w> и помоги мне решить эту проблему.",
                                "it": "Smettila di <w>brontolare</w> e aiutami a risolvere questo problema."
                            }
                        }
                    ],
                    "synonyms": [
                        "complain",
                        "grumble",
                        "moan"
                    ],
                    "common_phrases": [
                        "grouse about"
                    ],
                    "target_lang_definitions": {
                        "ru": "Жаловаться или выражать недовольство, часто по пустякам.",
                        "it": "Lamentarsi o brontolare, spesso per questioni di poco conto."
