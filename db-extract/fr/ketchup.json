                                    {
                                        "sense_id": "d372709f-701d-390a-8641-a9999434c918",
                                        "entry_id": "2b2fb174-da58-347b-93f3-08963263d14c",
                                        "glosses": [
                                            "Ellipsis of tomato ketchup (“a tomato-vinegar-based sauce, sometimes containing spices, onion or garlic, and (especially in the US) sweeteners”)."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "UK",
                                            "US",
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "70f6ab70-e998-46b4-a5ce-4cc0fc5a43d1",
                                                "sense_id": "d372709f-701d-390a-8641-a9999434c918",
                                                "text": "tomato ketchup"
                                            },
                                            {
                                                "example_id": "c4e151bb-8c98-43d3-82f6-38bb7be597d6",
                                                "sense_id": "d372709f-701d-390a-8641-a9999434c918",
                                                "text": "This diner serves ketchup in red bottles, and mustard in yellow ones."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af09e562-5eca-3bcf-871c-192e5c714616",
                                        "entry_id": "2b2fb174-da58-347b-93f3-08963263d14c",
                                        "glosses": [
                                            "Such a sauce more generally (not necessarily based on tomatoes, but with mushrooms, fish, etc.). This is the older meaning."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a66ec8b1-baba-4c93-9f63-eb03b5b8df00",
                                                "sense_id": "af09e562-5eca-3bcf-871c-192e5c714616",
                                                "text": "The bottles, however, were port bottles, but contained mushroom ketchup; […]"
                                            },
                                            {
                                                "example_id": "5cc8c4a8-af63-4b86-a98a-95a3d2aec62b",
                                                "sense_id": "af09e562-5eca-3bcf-871c-192e5c714616",
                                                "text": "To accompany meat, we prepare fruit ketchups and rhubarb chutney."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ketchup",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "81b0703e-69d3-33b1-9878-2c69cd4a459d",
                                        "entry_id": "0f5b85b4-feb5-38a2-9d51-8335fb790d00",
                                        "glosses": [
                                            "To cover with ketchup."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b71bc38-9160-4487-9dbe-5b54db996c50",
                                                "sense_id": "81b0703e-69d3-33b1-9878-2c69cd4a459d",
                                                "text": "It strikes me she's \"ketchupped\" the lot! I won't touch a morsel!"
                                            },
                                            {
                                                "example_id": "9f649b96-fea7-4bca-b128-b9407389f58c",
                                                "sense_id": "81b0703e-69d3-33b1-9878-2c69cd4a459d",
                                                "text": "\"Well,\" said Chuck, ketchupping his hamburger, \"I'd rather do without King Lear than put up with the human agony it sprang out of. I'd rather not have the Eroica than have the big bloody conqueror it tries to immortalize.\""
                                            },
                                            {
                                                "example_id": "7dcd7cff-3aff-47aa-a42f-a3fe24cfbe21",
                                                "sense_id": "81b0703e-69d3-33b1-9878-2c69cd4a459d",
                                                "text": "Their fellow diners, like their ketchupped grub, were appropriately dashed and splattered with paint and plaster, reading their Suns and Daily Mirror."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
