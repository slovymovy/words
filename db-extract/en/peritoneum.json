                                "target_senses": [
                                    {
                                        "sense_id": "79befd0b-b5eb-379f-83ad-4c40c221bedc",
                                        "entry_id": "5513388f-1461-399e-8e1b-da7f524887f7",
                                        "glosses": [
                                            "błona surowicza wyścielająca jamę brzuszną i jamę miednicy"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d846b3ce-5853-4b13-9e55-a30ebc75c6e3",
                                                "sense_id": "79befd0b-b5eb-379f-83ad-4c40c221bedc",
                                                "text": "Chyba właśnie rozciął otrzewną, miał krew na rękach, a z otworu brzusznego wystawały kiszki. Widziałem olbrzymią ilość krwi, wypływającej z ciała na blat stołu"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "30fdd6dd-fa84-43eb-8c4d-6c4514791dc5",
                        "source_entry_id": "68ea2035-b90d-3f58-949d-aa53bfc311fe",
                        "source_sense_description": "serous membrane in mammals",
                        "target_lang_word": "брюши́на",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "брюши́на",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "3aba7b5c-df33-3524-887e-560fc4acbc77",
                                        "entry_id": "555146d6-c468-3d91-ae1e-f9bb594309dc",
                                        "glosses": [
                                            "анат. серозная оболочка, выстилающая брюшную полость"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03ef4446-0bbb-4fbb-9797-4158b3d7de35",
                                                "sense_id": "3aba7b5c-df33-3524-887e-560fc4acbc77",
                                                "text": "Брюшина, peritoneum, является серозной оболочкой, покрывающей стенки брюшной полости и её внутренние органы."
                                            },
                                            {
                                                "example_id": "5394931c-5469-4375-8276-b1c6511109a6",
                                                "sense_id": "3aba7b5c-df33-3524-887e-560fc4acbc77",
                                                "text": "Патолог осторожно вскрыл брюшную полость и стал осматривать воспалённую брюшину и склеившиеся кишечные петли…"
                                            },
                                            {
                                                "example_id": "1c91bf9c-3c60-45b5-b79c-5ade0ee283cb",
                                                "sense_id": "3aba7b5c-df33-3524-887e-560fc4acbc77",
                                                "text": "— Да, юный мой коллега, зашить салфетку в брюшине оперируемого — это, конечно, рассеянность."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a64992b-6052-35e8-9ac1-7c88146447d9",
                                        "entry_id": "555146d6-c468-3d91-ae1e-f9bb594309dc",
                                        "glosses": [
                                            "нижняя брюшная часть туши животного"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51483024-f943-4bc5-abc9-4ac2bd44896a",
                                                "sense_id": "9a64992b-6052-35e8-9ac1-7c88146447d9",
                                                "text": "На туше уже сидели и клевали её два орла, а два других трудились над брюшиной, лежавшей в стороне."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "73718b17-33d6-3d0f-915f-702d9944647e",
                                        "entry_id": "555146d6-c468-3d91-ae1e-f9bb594309dc",
                                        "glosses": [
                                            "кулин. мясо нижней брюшной части туши животного с прослойками сала"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b067a1b-18ec-4cd1-8020-b0b35aa22561",
                                                "sense_id": "73718b17-33d6-3d0f-915f-702d9944647e",
                                                "text": "— Работа тяжёлая, а нас брюшиной кормят, — заворчит, бывало, кто-нибудь на кухне."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
