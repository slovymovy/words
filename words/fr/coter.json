                    "frequency": "Middle",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette entreprise technologique espère être bientôt <w>cotée</w> en bourse."
                        },
                        {
                            "text": "La Bourse de Paris <w>cote</w> désormais les actions de cette jeune entreprise."
                        }
                    ],
                    "common_phrases": [
