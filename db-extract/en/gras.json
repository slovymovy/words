                "forms": [],
                "senses": [
                    {
                        "sense_id": "a2052a45-09bc-36ef-b753-e90803382635",
                        "entry_id": "a249456e-234b-32c5-8528-0f61d923264f",
                        "glosses": [
                            "Acronym of generally recognized as safe, a designation by the FDA that a chemical or substance added to food is considered safe by food industry experts."
                        ],
                        "tags": [
                            "US",
                            "abbreviation",
                            "acronym",
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "703936ca-e07d-4dbe-8362-d4710dac668b",
                                "sense_id": "a2052a45-09bc-36ef-b753-e90803382635",
                                "text": "Tara flour is a recent example, but the misuse of the GRAS standard — and the delay in FDA response — has been occurring for decades, critics say."
                            },
                            {
                                "example_id": "82d06672-c2fe-428a-9255-16475c055878",
                                "sense_id": "a2052a45-09bc-36ef-b753-e90803382635",
                                "text": "Under GRAS, companies are expected, but not required, to notify the F.D.A. when they introduce a new chemical that experts they’ve hired deemed OK to use. As a result, the food industry is often vetting the safety of the ingredients in our food, not federal regulators."
                            }
                        ]
                    }
