                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f0a449e7-d2be-3790-bed4-a88ceb5780b7",
                                        "entry_id": "7ea546c0-7884-3de9-ab9b-4eccfecdbcb6",
                                        "glosses": [
                                            "A hard disk."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
