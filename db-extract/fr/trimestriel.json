                            },
                            {
                                "example_id": "e5a581ab-4f14-4dc2-8847-1fcd26702d6d",
                                "sense_id": "0f493ec5-8d4e-3515-8feb-3725bd3f457b",
                                "text": "Les loyers s’acquittent à Paris par paiements trimestriels."
