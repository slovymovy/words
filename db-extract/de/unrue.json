                ],
                "senses": [
                    {
                        "sense_id": "45b61736-385d-3ea5-98d5-f37291f0196d",
                        "entry_id": "e20d7209-36fb-3883-8553-97ec1a6129c6",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd21867c-221c-4855-8b27-14ae8f179eaa",
                                "sense_id": "45b61736-385d-3ea5-98d5-f37291f0196d",
                                "text": "Frau Unrue ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "99f0b7e8-4296-4811-9854-36f9289d5a84",
                                "sense_id": "45b61736-385d-3ea5-98d5-f37291f0196d",
                                "text": "Herr Unrue wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "485d672e-5658-4887-8c46-eea661572331",
                                "sense_id": "45b61736-385d-3ea5-98d5-f37291f0196d",
                                "text": "Die Unrues fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "7cb2f850-1ad0-453c-878e-da32afc1ee80",
                                "sense_id": "45b61736-385d-3ea5-98d5-f37291f0196d",
                                "text": "Der Unrue trägt nie die Schals, die die Unrue ihm strickt."
                            },
                            {
                                "example_id": "fab79991-4504-4594-81fe-9af9f69560af",
                                "sense_id": "45b61736-385d-3ea5-98d5-f37291f0196d",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Unrue kommt, geht der Herr Unrue.“"
                            },
                            {
                                "example_id": "413c17ba-fd34-42bd-991d-ae67aa9d06a2",
                                "sense_id": "45b61736-385d-3ea5-98d5-f37291f0196d",
                                "text": "Unrue kommt und geht."
                            },
                            {
                                "example_id": "0b1e8e66-bbb5-40c5-a745-d46871858633",
                                "sense_id": "45b61736-385d-3ea5-98d5-f37291f0196d",
                                "text": "Unrues kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
