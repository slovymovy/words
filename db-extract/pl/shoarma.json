                        "glosses": [
                            "bliskowschodnia potrawa, której podstawą są okrawki pieczonego na pionowych rusztach mięsa, serwowane na talerzu lub zawinięte w pieczywo"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1449c56f-3f1c-4e08-a15e-37309cd7fd49",
                                "sense_id": "4fc9a301-696b-3051-8742-0ca8a99fd73b",
                                "text": "Dobra shoarma nie powstanie bez idealnie skomponowanej mieszanki przypraw"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "960c030b-b0eb-3532-afdf-dd5d19524e3d",
                        "entry_id": "956a4bd4-ef9b-32f8-8e1f-21c713a8f972",
                        "glosses": [
                            "arabska mieszanka przypraw do mięsa, składająca się z kminu rzymskiego, słodkiej papryki, granulowanego czosnku, imbiru, gałki muszkatołowej, cynamonu, kurkumy, cayenne i soli"
                        ],
