                                    {
                                        "sense_id": "ed0c1889-b2e9-36c4-98cb-9b7a753bbdc3",
                                        "entry_id": "25d0f234-2f24-38ab-a89e-4fee7f176f75",
                                        "glosses": [
                                            "ein aus Italien stammender Frischkäse"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b02a96bf-4392-4e06-a36a-569d76b2ab2a",
                                                "sense_id": "ed0c1889-b2e9-36c4-98cb-9b7a753bbdc3",
                                                "text": "„Mascarpone ist ein italienischer Frischkäse aus dem Gebiet um Lodi, der aus Sahne hergestellt wird.“"
                                            },
                                            {
                                                "example_id": "93556f1a-d336-4ec8-835b-e1eb451f15fa",
                                                "sense_id": "ed0c1889-b2e9-36c4-98cb-9b7a753bbdc3",
                                                "text": "„Mascarpone ist cremig und leicht streichbar.“"
                                            },
                                            {
                                                "example_id": "c949124b-a267-46fe-948e-d8861f98615f",
                                                "sense_id": "ed0c1889-b2e9-36c4-98cb-9b7a753bbdc3",
                                                "text": "„Mascarpone enthält ca. 80% Fett i.Tr.“"
                                            },
                                            {
                                                "example_id": "e28572b1-5c8e-4899-94fd-5b7150b0e1ff",
                                                "sense_id": "ed0c1889-b2e9-36c4-98cb-9b7a753bbdc3",
                                                "text": "„Da Mascarpone sehr schnell fremde Gerüche annimmt, sollte man sie immer gut verschlossen und gekühlt aufbewahren.“"
                                            },
                                            {
                                                "example_id": "b610a7b7-5680-44b5-9820-773533caf318",
                                                "sense_id": "ed0c1889-b2e9-36c4-98cb-9b7a753bbdc3",
                                                "text": "„Mascarpone kann man mit Gewürzen als herzhaften Brotaufstrich zubereiten, sie zum Überbacken von Aufläufen verwenden, in Suppen oder Saucen rühren, aber auch für Torten und Desserts wie das klassische Tiramisu verwenden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
