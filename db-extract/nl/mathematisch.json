                "translations": [
                    {
                        "translation_id": "f89b70f9-ddcc-49aa-9e92-c3ce3f3efd6e",
                        "source_entry_id": "a31c6873-515c-3fcd-964b-53638b0815ba",
                        "source_sense_id": "2d45b636-de1a-3877-804b-b23be424be30",
                        "target_lang_word": "mathematical",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mathematical",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3b673608-aff3-3ed5-b596-4dfbad0d7680",
                                        "entry_id": "00c10cdb-b434-3005-83b7-cdb6299220d6",
                                        "glosses": [
                                            "Of, or relating to mathematics"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a945281e-b856-487e-a33d-ee3d55e7c4b5",
                                                "sense_id": "3b673608-aff3-3ed5-b596-4dfbad0d7680",
                                                "text": "a mathematical problem"
                                            },
                                            {
                                                "example_id": "bb8563c0-2d11-4f68-9c46-42b0bc01a0dd",
                                                "sense_id": "3b673608-aff3-3ed5-b596-4dfbad0d7680",
                                                "text": "[…]he looked up the uninteresting left road to the fortifications. It was new, long, white, regular, tapering to a vanishing point, like a lesson in perspective. […] Smaller and smaller she waned up the rigid mathematical road, still gazing at the soldier aloft, as Pierston gazed at her."
                                            },
                                            {
                                                "example_id": "c0fc96b3-70b9-4412-b45d-2581e71806b8",
                                                "sense_id": "3b673608-aff3-3ed5-b596-4dfbad0d7680",
                                                "text": "It has been at least an academic tradition, if no more, that mathematical studies militate against amatory inclinations."
                                            },
                                            {
                                                "example_id": "584d6034-22a8-4416-9c54-219fd4f89e8f",
                                                "sense_id": "3b673608-aff3-3ed5-b596-4dfbad0d7680",
                                                "text": "Although Galileo had designed a pendulum clock, he never actually constructed one. The first pendulum clock was constructed by the Dutch physicist Christian Huygens (1629–1695) in 1657. He also developed the mathematical theory of the pendulum. Newton also studied the motion of a pendulum and experimented with pendulums made of different materials and of different lengths."
                                            },
                                            {
                                                "example_id": "3397ca36-76bb-4920-aef5-f9eca8ad7332",
                                                "sense_id": "3b673608-aff3-3ed5-b596-4dfbad0d7680",
                                                "text": "Some poems, echoing the purpose of early poetic treatises on scientific principles, attempt to elucidate the mathematical concepts that underlie prime numbers. Others play with primes’ cultural associations. Still others derive their structure from mathematical patterns involving primes."
                                            },
                                            {
                                                "example_id": "33813866-4c66-4aea-9593-47c2f4820f4a",
                                                "sense_id": "3b673608-aff3-3ed5-b596-4dfbad0d7680",
                                                "text": "Look closely at the pretty seashell print on these blouses. They’re actually formulated from mathematical equations!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6829c4ae-6c60-30e1-b830-f36ac2fe4403",
                                        "entry_id": "00c10cdb-b434-3005-83b7-cdb6299220d6",
                                        "glosses": [
                                            "Extremely precise and accurate, as though having the exactness of a mathematical equation."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "98a3bfe7-636a-4bec-9905-1c9220fd615a",
                                                "sense_id": "6829c4ae-6c60-30e1-b830-f36ac2fe4403",
                                                "text": "Lucinda Childs got her start with the postmodern Judson Dance Theater and became known for precise, almost mathematical choreographic patterns."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "503a952e-3f8d-33bf-bf40-dd4ca417f2e7",
                                        "entry_id": "00c10cdb-b434-3005-83b7-cdb6299220d6",
                                        "glosses": [
                                            "Possible but highly improbable"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2fbd8c54-b93e-43e3-b297-9f748893c721",
                                                "sense_id": "503a952e-3f8d-33bf-bf40-dd4ca417f2e7",
                                                "text": "The team has a mathematical chance of being promoted, but they need to win the next seven matches."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
