                        "cross_references": [
                            {
                                "target_word": "vagrant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8d32e552-4109-3809-80d9-4ebddf581974",
                                        "entry_id": "f570d583-671f-3d10-9124-ffaf1ab2e2e0",
                                        "glosses": [
                                            "A person who wanders from place to place; a nomad, a wanderer."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2f975353-6a2d-30e0-be00-11be022dcf88",
                                        "entry_id": "f570d583-671f-3d10-9124-ffaf1ab2e2e0",
                                        "glosses": [
                                            "A person without settled employment or habitation who usually supports himself or herself by begging or some dishonest means; a tramp, a vagabond."
                                        ],
                                        "tags": [
                                            "specifically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "617d0f3a-5c09-4ae8-a016-7de86e2444cd",
                                                "sense_id": "2f975353-6a2d-30e0-be00-11be022dcf88",
                                                "text": "Every morning before work, I see that poor vagrant around the neighbourhood begging for food."
                                            },
                                            {
                                                "example_id": "a909486c-cf91-408a-8778-d6d2c8f79d81",
                                                "sense_id": "2f975353-6a2d-30e0-be00-11be022dcf88",
                                                "text": "If it appear to the Juſtice by the confeſſion of the Vagrant, or by the Oath of one Witneſs, that he had no lawful Settlement ſince his Birth, and that he hath committed Acts of Vagrancy, or hath been a common Beggar, or Vagrant, for two Years laſt paſt, [...] then inſtead of puniſhing him, the Juſtice, or Juſtices, may bind him Apprentice for ſeven Years to the Perſon who apprehends him, or to any other Perſon who will receive him, and employ him in Great Britain, or in any of his Majeſty's Plantations."
                                            },
                                            {
                                                "example_id": "bc76b4f7-36c7-437c-8e50-c78aa752de5b",
                                                "sense_id": "2f975353-6a2d-30e0-be00-11be022dcf88",
                                                "text": "'Tis the cruel gripe / That lean hard-handed poverty inflicts, / The hope of better things, the chance to win, / The wiſh to ſhine, the thirſt to be amuſed, / That at the found of Winter's hoary wing, / Unpeople all our counties, of ſuch herds, / Of flutt'ring, loit'ring, cringing, begging, looſe / And wanton vagrants, as make London, vaſt / And boundleſs as it is, a crowded coop."
                                            },
                                            {
                                                "example_id": "f747cbc8-90fa-4270-98a9-1f557cdd7ec6",
                                                "sense_id": "2f975353-6a2d-30e0-be00-11be022dcf88",
                                                "text": "The most prominent body of delinquents in the rural districts are vagrants, and these vagrants appear to consist of two classes: first, the habitual depradators, house-breakers, horse-stealers, and common thieves; secondly, of vagrants, properly so called, who seek alms as mendicants."
                                            },
                                            {
                                                "example_id": "769b5b8e-05c5-4294-9b70-3a4d18445bae",
                                                "sense_id": "2f975353-6a2d-30e0-be00-11be022dcf88",
                                                "text": "Among vagrants are to be found thieves of every description, as well as a numerous host of the rankest impostors. [...] A great number amongst these daring impostors have been brought up vagrants from their infancy, and such as are bred up to it are naturally the most clever in acts of thieving, or in imposing upon the public."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c35d04d-346e-312c-bc4c-925fe10e7b19",
                                        "entry_id": "f570d583-671f-3d10-9124-ffaf1ab2e2e0",
                                        "glosses": [
                                            "Vagrans egista, a widely distributed Asian butterfly of the family Nymphalidae."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dd0d74a4-7769-369f-a324-2e3f7de6e82c",
                                        "entry_id": "f570d583-671f-3d10-9124-ffaf1ab2e2e0",
                                        "glosses": [
                                            "An animal, typically a bird, found outside its species' usual range."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
