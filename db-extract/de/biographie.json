                    }
                ],
                "senses": [
                    {
                        "sense_id": "9b2ccd9a-914c-31fc-875d-08c37302d36d",
                        "entry_id": "90aa25a3-f305-33cd-9306-cbcba39a4082",
                        "glosses": [
                            "Lebensbeschreibung einer Person"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35d08ef1-48a4-4bae-a521-4e226c3e8f6c",
                                "sense_id": "9b2ccd9a-914c-31fc-875d-08c37302d36d",
                                "text": "„Denn diese ersten Jahre waren die einzige Zeit ohne Bangen und Furcht im Leben der Söhne, sozusagen der Garten Eden ihres Daseins, die elysischen Gefilde einer Biographie, die sich nur allzu bald unwiederherstellbar verändern sollte.“"
                            },
                            {
                                "example_id": "8f4abbdb-b97f-4eba-a14f-aabb0f7a9b70",
                                "sense_id": "9b2ccd9a-914c-31fc-875d-08c37302d36d",
                                "text": "„Offenbar hatte er seine Meinung über Biographien geändert.“"
                            },
                            {
                                "example_id": "53e18c7b-fad3-49ac-a08e-60ab03ec90b0",
                                "sense_id": "9b2ccd9a-914c-31fc-875d-08c37302d36d",
                                "text": "„Dies ist die Biographie des Zellenwalters und kommissarischen Ortsgruppenleiters Otto Hille aus Berlin O 112, Rigaer Straße 65.“"
                            },
                            {
                                "example_id": "1ac9c749-f980-40a1-8b3e-7dbc71441c2a",
                                "sense_id": "9b2ccd9a-914c-31fc-875d-08c37302d36d",
                                "text": "„Virginia Woolf hat die fiktive Biographie des und der Orlando in einem Glücksrausch geschrieben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
