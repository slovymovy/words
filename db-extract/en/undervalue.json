                        "source_sense_id": "6b80bd72-a1df-3092-91a3-20243f7f9ada",
                        "source_sense_description": "to underestimate",
                        "target_lang_word": "podcenit",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "podcenit",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "691169e9-bb6a-3a65-beb7-c049ae61b8d8",
                                        "entry_id": "370d2996-efad-3f3a-b8fd-05cb5db2eb86",
                                        "glosses": [
                                            "přičíst/přisoudit nižší hodnotu než odpovídá realitě nebo než by se slušelo"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8fb1ad45-ba52-4fb2-9391-0ab692db5fe4",
                                                "sense_id": "691169e9-bb6a-3a65-beb7-c049ae61b8d8",
                                                "text": "Když za těchto okolností Hillary Clintonová připustí, že „podcenila zápal plic“, je to politický průšvih. Obzvlášť americký kandidát „musí“ být zdravý, to se podceňovat nedá, „musí“ dobře vypadat a hlídat si cholesterol. Zásadní věci. Když tohle podcení, když podá důkaz, že nedostatečně pečuje sám o sebe – co podcení příště? Nezaměstnanost? Mafii? Terorismus? Tohle byla nahrávka Trumpovi na smeč."
                                            },
                                            {
                                                "example_id": "98b6e068-a847-481a-8254-42afb3c9fb8f",
                                                "sense_id": "691169e9-bb6a-3a65-beb7-c049ae61b8d8",
                                                "text": "Německá diplomacie, která se mohla opříti o soustavnou propagandu sudetoněmecké strany, již jsme rovněž poněkud podcenili, navázala takto velmi obratně na silné složky dnešního anglického a francouzského politického uvažování."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d602efe7-f501-4eaa-94b6-c0968018308b",
                        "source_entry_id": "dd867b48-3a09-32af-9109-052c0149eab5",
                        "source_sense_id": "6b80bd72-a1df-3092-91a3-20243f7f9ada",
                        "source_sense_description": "to underestimate",
                        "target_lang_word": "unterbewerten",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unterbewerten",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c1146752-a08f-34ef-bbfe-d021bd30686a",
                                        "entry_id": "c4f7083b-253d-3f41-8de6-b30c74291cf2",
                                        "glosses": [
                                            "(einem Umstand, einer Eigenschaft/Leistung/Person) weniger Bedeutung zumessen, als sie wohl verdient"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01a7e35d-6073-433e-9c40-2cfa10bab1e2",
                                                "sense_id": "c1146752-a08f-34ef-bbfe-d021bd30686a",
                                                "text": "Der Präsident unterbewertete die innenpolitischen Hindernisse, Risiken und Kosten."
                                            },
                                            {
                                                "example_id": "eba7498e-a492-40e0-8606-9006fde1d78e",
                                                "sense_id": "c1146752-a08f-34ef-bbfe-d021bd30686a",
                                                "text": "„Die Notwendigkeit von Rollen und Normen wird völlig unterbewertet, was sich besonders in der Phase des Wachstums nachteilig auf das Unternehmen auswirken könnte.“"
                                            },
                                            {
                                                "example_id": "1bc4270b-a763-42a0-96d9-31081725a32d",
                                                "sense_id": "c1146752-a08f-34ef-bbfe-d021bd30686a",
                                                "text": "„Ich neigte dazu, den Spaß an Aktivitäten, die ich nicht ausübte, überzubewerten und meine eigenen Vorlieben unterzubewerten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
