                ],
                "senses": [
                    {
                        "sense_id": "65b3aec1-9589-3ce6-852c-472e9ac66a07",
                        "entry_id": "36843094-8df5-33bc-a150-55ce684e1b5b",
                        "glosses": [
                            "kleiner Schrank"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a2a23213-b581-4945-8336-8f55cc456305",
                                "sense_id": "65b3aec1-9589-3ce6-852c-472e9ac66a07",
                                "text": "„Ransome holte das Lappenbündel herunter und machte es auf dem Brett unterhalb des Schränkchens auseinander.“"
                            },
                            {
                                "example_id": "8e90f032-f947-49eb-ab22-fbd0df395b79",
                                "sense_id": "65b3aec1-9589-3ce6-852c-472e9ac66a07",
                                "text": "„Die nächsten zwei Jahre lugten ihre kupfernen Kontakte hinter einem Schränkchen hervor.“"
                            },
                            {
                                "example_id": "507ff6d3-4290-459d-96f6-627394c0a225",
                                "sense_id": "65b3aec1-9589-3ce6-852c-472e9ac66a07",
                                "text": "„Er sah sich den Buddha an, die Schränkchen mit den Einlegearbeiten, die schweren, vielarmigen Leuchter, die Teppiche.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
