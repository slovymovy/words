                                        "sense_id": "d9775614-b5a3-3088-853a-a06e5ea91afb",
                                        "entry_id": "3b778998-e08f-3904-9796-52225d23c204",
                                        "glosses": [
                                            "Poudre blanche utilisée en cuisine (levure chimique), dans l’industrie chimique, dans l’industrie alimentaire et comme médicament (anti-acide), dont la formule chimique brute est NaHCO₃."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45a1f968-9a76-4d65-acef-83ffc0de2bdb",
                                                "sense_id": "d9775614-b5a3-3088-853a-a06e5ea91afb",
                                                "text": "Le bicarbonate de sodium est réputé pour aider les pâtisseries et les viennoiseries à monter, tout en les rendant moelleuses. Chauffé, ou en contact avec des substances acides, il libère du dioxyde de carbone (CO₂) sous forme de petites bulles gazeuses, ce sont elles qui rendent la pâte poreuse donc plus moelleuse."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
