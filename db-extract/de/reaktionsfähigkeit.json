                            {
                                "example_id": "89caed8a-0ccb-4857-a3f4-7b2523585609",
                                "sense_id": "938307d1-bcdb-327f-a217-3e2b640eeb2d",
                                "text": "Als Torwart solltest du über eine gute Reaktionsfähigkeit verfügen."
                            },
                            {
                                "example_id": "d50dea77-583e-4210-bd10-968459f26cd9",
                                "sense_id": "938307d1-bcdb-327f-a217-3e2b640eeb2d",
                                "text": "In der aktuellen Lage ist die Reaktionsfähigkeit von Ministerien und Behörden in besonderem Maße gefordert."
                            }
