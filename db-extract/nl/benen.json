            {
                "entry_id": "bcb10859-a088-3153-82a4-c20b86bbb63b",
                "word": "benen",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c871f861-1ada-360d-85f6-4377f8b7129c",
                        "entry_id": "bcb10859-a088-3153-82a4-c20b86bbb63b",
                        "glosses": [
                            "meervoud van het zelfstandig naamwoord been"
                        ],
                        "tags": [
                            "form-of",
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "37f7a723-237e-4050-9e67-b8cda0cf328c",
                                "sense_id": "c871f861-1ada-360d-85f6-4377f8b7129c",
                                "text": "' 'Wat? Wat wilde u precies zien?' Tot mijn schrik liet Quick de fles los, die langs haar benen naar beneden gleed en kapotviel op de vloer."
                            },
                            {
                                "example_id": "cb1b5cbc-7cd4-4498-a48e-06065a39442e",
                                "sense_id": "c871f861-1ada-360d-85f6-4377f8b7129c",
                                "text": "' Lawrie sloeg zijn benen over elkaar."
                            },
                            {
                                "example_id": "8147bd09-74bd-412f-b03b-2acf67819b9e",
                                "sense_id": "c871f861-1ada-360d-85f6-4377f8b7129c",
                                "text": "Nadat don Alfonso even later in zijn auto was vertrokken, stoof Olive het roestige hek door, rende over het pad naar het dorp en daarna - inmiddels buiten adem en met zere benen - de volgende heuvel op, naar het huis van Isaac en Teresa."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "7ba24618-5187-3f66-91b5-89abdb8c6dea",
                "word": "benen",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "67abcded-bfab-35a2-8689-a806e89703f1",
                        "entry_id": "7ba24618-5187-3f66-91b5-89abdb8c6dea",
                        "glosses": [
                            "met forse pas lopen"
                        ],
                        "tags": [
                            "ergative"
                        ],
                        "examples": [
                            {
                                "example_id": "7b25f2d3-8a9c-485e-99ee-ea8ab0b56a46",
                                "sense_id": "67abcded-bfab-35a2-8689-a806e89703f1",
                                "text": "Hij beende vol ergernis naar buiten."
                            },
                            {
                                "example_id": "13268af1-510d-48f4-8c00-02a9486346d1",
                                "sense_id": "67abcded-bfab-35a2-8689-a806e89703f1",
                                "text": "Als hij zelfverzekerd door de loopgraven beende en zich tot de mannen richtte, kon hij net zo veel enthousiasme als hij wilde in zijn woorden leggen als hij refereerde aan de verpletterende nederlaag van de vijand die met een laatste salvo de genadeslag zou krijgen, maar de mannen gaven hem alleen wat vaag gemopper ten antwoord en stemden voorzichtigheidshalve zwijgend toe door naar hun kistjes te kijken."
                            },
                            {
                                "example_id": "bd52eb61-b5ec-4140-9831-2299235d8a2f",
                                "sense_id": "67abcded-bfab-35a2-8689-a806e89703f1",
                                "text": "Met grote stappen beende hij naar de bank en plofte neer."
                            }
                        ]
                    }
                ],
