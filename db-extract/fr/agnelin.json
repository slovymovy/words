                ],
                "senses": [
                    {
                        "sense_id": "f8625e4a-6a84-3686-91a4-2dd3049ba3cb",
                        "entry_id": "ef23cf90-4463-35fa-8787-b50079bfc8d9",
                        "glosses": [
                            "Peau d’agneau, généralement avec sa laine."
                        ],
                        "tags": [
                            "Travail du cuir"
                        ],
                        "examples": [
                            {
                                "example_id": "2ddf0f8b-ed24-416f-acff-015431103694",
                                "sense_id": "f8625e4a-6a84-3686-91a4-2dd3049ba3cb",
                                "text": "Le jour de la Toussaint 1886, Antonia, 16 ans, rompt le lacet de sa bottine d’agnelin. Elle emprunte des demi-bottes trop grandes pour elle."
                            }
                        ]
                    },
                    {
                        "sense_id": "67f50c31-4b79-3e26-83eb-892b21553822",
                        "entry_id": "ef23cf90-4463-35fa-8787-b50079bfc8d9",
                        "glosses": [
                            "Laine d’agneaux qui n’ont pas été tondus auparavant. On dit aussi agneline."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d098a41-1af9-4cd9-84b5-4c09f94a88f6",
                                "sense_id": "67f50c31-4b79-3e26-83eb-892b21553822",
                                "text": "Avant de terminer ce paragraphe, disons quelques mots touchant la valeur de la laine d’agneau.\nL’agnelin est souvent fort recherché pour la confection de certaines étoffes, et en général sa valeur intrinsèque doit être comparativement supérieure à celle de la laine-mère."
                            },
                            {
                                "example_id": "8533ab39-381f-429c-a1cd-dd588a17a0a0",
                                "sense_id": "67f50c31-4b79-3e26-83eb-892b21553822",
                                "text": "La laine d’agnelin n’est permise que dans la fabrique des chapeaux."
                            }
                        ]
                    },
