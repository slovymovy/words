                                "target_senses": [
                                    {
                                        "sense_id": "d7951674-b4ea-366d-8957-995e9537269b",
                                        "entry_id": "dc957446-59a1-3b2d-a107-bbd82875a172",
                                        "glosses": [
                                            "From an external source; not innate or inherent, foreign."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3a679e10-9d9b-39a1-bcf8-9e6bff1ab4fc",
                                        "entry_id": "dc957446-59a1-3b2d-a107-bbd82875a172",
                                        "glosses": [
                                            "Accidental, additional, appearing casually."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b20f791-2094-441e-a23b-7ac8c57009f8",
                                                "sense_id": "3a679e10-9d9b-39a1-bcf8-9e6bff1ab4fc",
                                                "text": "The discovery of the art of making pottery was probably in all cases adventitious, the clay being first used for some other purpose."
                                            },
                                            {
                                                "example_id": "9c970db6-6cda-4bbc-93c0-c288e3fd825d",
                                                "sense_id": "3a679e10-9d9b-39a1-bcf8-9e6bff1ab4fc",
                                                "text": "The adventitious disappearance of those nearer the throne than the duke had, moreover, set tongues awagging."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c1700410-a560-38b5-90df-39dbad1bb86c",
                                        "entry_id": "dc957446-59a1-3b2d-a107-bbd82875a172",
                                        "glosses": [
                                            "Not congenital; acquired."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1368c8d1-59e8-39ae-9969-7a42a3379acf",
                                        "entry_id": "dc957446-59a1-3b2d-a107-bbd82875a172",
                                        "glosses": [
                                            "Developing in an unusual place or from an unusual source."
                                        ],
                                        "tags": [],
