                                    },
                                    {
                                        "sense_id": "c5e737fc-134a-3762-b987-5de544312ce4",
                                        "entry_id": "8560a848-6f89-3a34-844b-90f39aeeaaab",
                                        "glosses": [
                                            "σχετικά επίπεδο και λεπτό κομμάτι ζύμης"
                                        ],
                                        "tags": [
                                            "γαστρονομία"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8f2de80-553a-4174-b538-1c69c95080ee",
                                                "sense_id": "c5e737fc-134a-3762-b987-5de544312ce4",
                                                "text": "※ Η παχουλή Ασπασία –το ήξερα– δε θα κουνούσε από την κουζίνα μέχρι ν' ανοίξει φύλλο για να κάνει κοτόπιτα. Είχα χρόνο ώσπου να έρθει η ώρα να τη βάλει στον φούρνο.",
                                                "translation": "⌘ Άλκη Ζέη, Η Κωνσταντίνα και οι αράχνες της, αρχική δημοσίευση: (2002), εκδόσεις: Μεταίχμιο, Αθήνα 2011, ISBN 9786180320008, @google.gr/books"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e6f68cd-8b3e-3f50-9465-c2a668e9e646",
                                        "entry_id": "8560a848-6f89-3a34-844b-90f39aeeaaab",
                                        "glosses": [
                                            "οι εφημερίδες, αλλά και έντυπα που δεν κυκλοφορούν απαραιτήτως καθημερινά"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec9de805-4b0c-4909-8aa8-0faeb1a7cb3b",
                                                "sense_id": "9e6f68cd-8b3e-3f50-9465-c2a668e9e646",
                                                "text": "Θα δημοσιευτεί η αγγελία σας στο φύλλο του Σαββάτου."
                                            },
                                            {
                                                "example_id": "ac93b971-e684-4c05-ae07-333984c1a0f9",
                                                "sense_id": "9e6f68cd-8b3e-3f50-9465-c2a668e9e646",
                                                "text": "Θα βάλω την αγγελία μου σε ένα εβδομαδιαίο φύλλο της Πάτρας."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "287670fd-82dc-32c0-b67b-0752cc805d7d",
                                        "entry_id": "8560a848-6f89-3a34-844b-90f39aeeaaab",
                                        "glosses": [
                                            "χαρτί της τράπουλας"
                                        ],
                                        "tags": [
                                            "χαρτοπαίγνιο"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "93a907cd-f3a1-4ecb-8425-1f06d5ac32b8",
                                                "sense_id": "287670fd-82dc-32c0-b67b-0752cc805d7d",
                                                "text": "έχω καλό φύλλο/ Θα κάνεις καμιά φορά φύλλα; Κοιμηθήκαμε! (θα μοιράσεις;)"
                                            }
