{
    "word_family": [
        "raver",
        "raving",
        "ravingly"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "75389a5e-6646-3ac0-a44d-e1b0bb200d59",
                    "sense_definition": "To talk with excessive enthusiasm, passion, or excitement about something.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "enthusiasm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The food was so delicious that my friends continued to <w>rave</w> about it for days.",
                            "target_lang_translations": {
                                "ru": "Еда была настолько вкусной, что мои друзья продолжали <w>восторгаться</w> ею несколько дней.",
                                "zh": "食物太好吃了，我的朋友们连续几天都对它<w>赞不绝口</w>。",
                                "cs": "Jídlo bylo tak vynikající, že moji přátelé o něm ještě několik dní <w>pěli ódy</w>."
                            }
                        },
                        {
                            "text": "Critics often <w>rave</w> about her performance, calling it the best of the year.",
                            "target_lang_translations": {
                                "ru": "Критики часто <w>расхваливают</w> её игру, называя её лучшей в этом году.",
                                "zh": "评论家们经常<w>盛赞</w>她的表演，称其为年度最佳。",
                                "cs": "Kritici její výkon často <w>vynášejí do nebes</w> a označují ho za nejlepší v tomto roce."
                            }
                        }
                    ],
                    "common_phrases": [
                        "rave about",
                        "rave on"
                    ],
                    "target_lang_definitions": {
                        "ru": "Говорить о чем-либо с чрезмерным энтузиазмом, страстью или волнением.",
                        "zh": "指对某事表现出过度的热情、激情或兴奋。",
                        "cs": "Mluvit o něčem s nadměrným nadšením, vášní nebo vzrušením."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "быть в восторге от",
                                "target_lang_sense_clarification": "выражать крайнее восхищение"
                            },
                            {
                                "target_lang_word": "расхваливать",
                                "target_lang_sense_clarification": "сильно хвалить, расточать похвалы"
                            },
                            {
                                "target_lang_word": "восторгаться",
                                "target_lang_sense_clarification": "говорить с большим воодушевлением"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "盛赞",
                                "target_lang_sense_clarification": "极力称赞"
                            },
                            {
                                "target_lang_word": "赞不绝口",
                                "target_lang_sense_clarification": "不停地称赞"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "pět ódy",
                                "target_lang_sense_clarification": "velmi nadšeně o něčem mluvit"
                            },
                            {
                                "target_lang_word": "vynášet do nebes",
                                "target_lang_sense_clarification": "někoho nebo něco velmi chválit"
                            },
                            {
                                "target_lang_word": "rozplývat se",
                                "target_lang_sense_clarification": "mluvit s velkým nadšením"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "20e21779-40c5-3908-b518-19f95a878676",
                    "sense_definition": "To attend an all-night dance party featuring electronic music.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "rave_culture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They spent the entire weekend <w>raving</w> in an old warehouse downtown.",
                            "target_lang_translations": {
                                "ru": "Они провели все выходные, <w>отрываясь на рейвах</w> в старом складском помещении в центре города.",
                                "zh": "他们整个周末都在市中心的一个旧仓库里<w>参加狂欢派对</w>。",
                                "cs": "Celý víkend strávili <w>pařením na rave</w> ve starém skladu v centru města."
                            }
                        },
                        {
                            "text": "He used to <w>rave</w> every weekend when he lived in London.",
                            "target_lang_translations": {
                                "ru": "Раньше он <w>ходил на рейвы</w> каждые выходные, когда жил в Лондоне.",
                                "zh": "他住在伦敦时，每个周末都会去<w>参加狂欢派对</w>。",
                                "cs": "Když žil v Londýně, každý víkend <w>chodil na rave</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "dance party"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Commonly used in youth culture and music contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Посещать ночную танцевальную вечеринку с электронной музыкой.",
                        "zh": "参加通宵的电子音乐舞会。",
                        "cs": "Účastnit se celonoční taneční party s elektronickou hudbou."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отрываться на рейвах",
                                "target_lang_sense_clarification": "посещать рейв-вечеринки"
                            },
                            {
                                "target_lang_word": "тусоваться",
                                "target_lang_sense_clarification": "в контексте электронной музыки и вечеринок"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "参加狂欢派对",
                                "target_lang_sense_clarification": "参加电子音乐舞会"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "pařit na rave",
                                "target_lang_sense_clarification": "účastnit se rave party"
                            },
                            {
                                "target_lang_word": "chodit na technoparty",
                                "target_lang_sense_clarification": "navštěvovat taneční akce s elektronickou hudbou"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1a79f356-0c73-3452-9264-79133f788046",
                    "sense_definition": "To speak or write wildly, incoherently, or irrationally, often due to madness or fever.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "irrationality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient began to <w>rave</w> incoherently as the high fever took hold.",
                            "target_lang_translations": {
                                "ru": "Пациент начал бессвязно <w>бредить</w>, когда поднялась высокая температура.",
                                "zh": "随着高烧袭来，病人开始<w>胡言乱语</w>。",
                                "cs": "Pacient začal nesouvisle <w>blouznit</w>, jakmile ho přemohla vysoká horečka."
                            }
                        },
                        {
                            "text": "Stop <w>raving</w> like a madman and try to explain what happened clearly.",
                            "target_lang_translations": {
                                "ru": "Перестань <w>бредить</w> как сумасшедший и попробуй внятно объяснить, что произошло.",
                                "zh": "别像个疯子一样<w>说胡话</w>了，试着清楚地解释发生了什么。",
                                "cs": "Přestaň <w>plácat nesmysly</w> jako šílenec a zkus jasně vysvětlit, co se stalo."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Говорить или писать бессвязно, иррационально или неистово, часто из-за безумия или лихорадки.",
                        "zh": "因疯狂或发烧而胡言乱语、语无伦次。",
                        "cs": "Mluvit nebo psát zmateně, nesouvisle nebo iracionálně, často kvůli šílenství nebo horečce."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бредить",
                                "target_lang_sense_clarification": "говорить бессвязно в состоянии болезни или безумия"
                            },
                            {
                                "target_lang_word": "заговариваться",
                                "target_lang_sense_clarification": "говорить нелепости, терять нить мысли"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "胡言乱语",
                                "target_lang_sense_clarification": "说话语无伦次"
                            },
                            {
                                "target_lang_word": "说胡话",
                                "target_lang_sense_clarification": "因病或精神状态不佳而乱说话"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "blouznit",
                                "target_lang_sense_clarification": "mluvit nesouvisle v horečce"
                            },
                            {
                                "target_lang_word": "plácat nesmysly",
                                "target_lang_sense_clarification": "mluvit z cesty"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e11e8730-8023-35e4-aba7-d09f86fba851",
                    "sense_definition": "To be wild, furious, or raging; to act with extreme violence or intensity.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "intensity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The storm continued to <w>rave</w> outside, shaking the windows of the small cabin.",
                            "target_lang_translations": {
                                "ru": "Шторм продолжал <w>бушевать</w> снаружи, сотрясая окна маленькой хижины.",
                                "zh": "暴风雨在外面持续<w>咆哮</w>，震动着小屋的窗户。",
                                "cs": "Bouře venku dál <w>zuřila</w> a otřásala okny malé chaty."
                            }
                        },
                        {
                            "text": "He would <w>rave</w> and beat his breast in a fit of uncontrollable anger.",
                            "target_lang_translations": {
                                "ru": "Он <w>неистовствовал</w> и бил себя в грудь в приступе неконтролируемого гнева.",
                                "zh": "他在无法控制的愤怒中<w>咆哮</w>并捶打着自己的胸口。",
                                "cs": "V záchvatu nekontrolovaného hněvu <w>běsnil</w> a bil se do prsou."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Often used for natural elements or intense emotional states"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Быть неистовым, яростным или бушующим; действовать с крайней силой или интенсивностью.",
                        "zh": "指狂暴、愤怒或猛烈地行动。",
                        "cs": "Být divoký, zuřivý nebo bouřlivý; jednat s extrémní silou nebo intenzitou."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бушевать",
                                "target_lang_sense_clarification": "о стихии или сильном гневе"
                            },
                            {
                                "target_lang_word": "неистовствовать",
                                "target_lang_sense_clarification": "проявлять крайнюю ярость"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "咆哮",
                                "target_lang_sense_clarification": "形容风浪或愤怒的吼叫"
                            },
                            {
                                "target_lang_word": "肆虐",
                                "target_lang_sense_clarification": "指自然灾害或暴力的猛烈破坏"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "zuřit",
                                "target_lang_sense_clarification": "o bouři nebo silném hněvu"
                            },
                            {
                                "target_lang_word": "běsnit",
                                "target_lang_sense_clarification": "projevovat extrémní zuřivost"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e0aec978-588f-39ae-881b-87320264f940",
                    "sense_definition": "To rush wildly or move with great force and noise.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "intensity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The roaring billows <w>rave</w> against the rocks during the winter gales.",
                            "target_lang_translations": {
                                "ru": "Ревущие валы <w>бьются</w> о скалы во время зимних штормов.",
                                "zh": "冬日的狂风中，咆哮的巨浪<w>呼啸</w>着拍打岩石。",
                                "cs": "Burácející vlny během zimních bouří <w>hučí</w> o skály."
                            }
                        },
                        {
                            "text": "The wind began to <w>rave</w> through the narrow mountain passes.",
                            "target_lang_translations": {
                                "ru": "Ветер начал <w>завывать</w> в узких горных проходах.",
                                "zh": "风开始在狭窄的山道间<w>呼啸</w>。",
                                "cs": "Vítr začal <w>burácet</w> úzkými horskými průsmyky."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Primarily found in older literature or poetry"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "С шумом и большой силой нестись или двигаться.",
                        "zh": "指带着巨大的力量和噪音猛烈地移动。",
                        "cs": "S hlukem a velkou silou se řítit nebo pohybovat."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "реветь",
                                "target_lang_sense_clarification": "о шуме ветра или волн"
                            },
                            {
                                "target_lang_word": "бушевать",
                                "target_lang_sense_clarification": "о сильном движении стихии"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "呼啸",
                                "target_lang_sense_clarification": "形容风声或快速移动的声音"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "hučet",
                                "target_lang_sense_clarification": "o zvuku větru nebo vody"
                            },
                            {
                                "target_lang_word": "burácet",
                                "target_lang_sense_clarification": "o silném pohybu živlů"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ea051524-c4e0-37c3-b454-b5d0a624ca9c",
                    "sense_definition": "To wander or roam about aimlessly.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lost travelers continued to <w>rave</w> through the woods without a map.",
                            "target_lang_translations": {
                                "ru": "Заблудившиеся путешественники продолжали <w>блуждать</w> по лесу без карты.",
                                "zh": "迷路的旅行者没有地图，只能在树林里继续<w>徘徊</w>。",
                                "cs": "Ztracení cestovatelé bez mapy dál <w>bloumali</w> lesem."
                            }
                        },
                        {
                            "text": "He would <w>rave</w> across the countryside for hours in deep thought.",
                            "target_lang_translations": {
                                "ru": "Он часами <w>бродил</w> по сельской местности, погруженный в глубокие раздумья.",
                                "zh": "他沉思着在乡间<w>漫游</w>了几个小时。",
                                "cs": "Hodiny se <w>toulal</w> krajinou, ponořen do hlubokých myšlenek."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "This sense is no longer in common use"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Бесцельно бродить или скитаться.",
                        "zh": "漫无目的地游荡或徘徊。",
                        "cs": "Bezcílně se toulat nebo potulovat."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скитаться",
                                "target_lang_sense_clarification": "бродить без цели"
                            },
                            {
                                "target_lang_word": "блуждать",
                                "target_lang_sense_clarification": "ходить без определенного направления"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "徘徊",
                                "target_lang_sense_clarification": "在一个地方来回走动"
                            },
                            {
                                "target_lang_word": "漫游",
                                "target_lang_sense_clarification": "随意地行走"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "bloumat",
                                "target_lang_sense_clarification": "chodit bez cíle"
                            },
                            {
                                "target_lang_word": "toulat se",
                                "target_lang_sense_clarification": "pohybovat se bez určitého směru"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "da8b06aa-7803-37a0-b8b0-ae9bd2d6e175",
                    "sense_definition": "To stray from a path or to err.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is easy to <w>rave</w> from the truth when one is under pressure.",
                            "target_lang_translations": {
                                "ru": "Легко <w>отклониться</w> от истины, когда находишься под давлением.",
                                "zh": "人在压力下很容易<w>偏离</w>真相。",
                                "cs": "Je snadné <w>sejít z cesty</w> pravdy, když je člověk pod tlakem."
                            }
                        },
                        {
                            "text": "The sheep began to <w>rave</w> from the flock into the dangerous hills.",
                            "target_lang_translations": {
                                "ru": "Овцы начали <w>отбиваться</w> от стада, уходя в опасные холмы.",
                                "zh": "羊群开始<w>迷失</w>方向，从羊群中走进了危险的山丘。",
                                "cs": "Ovce začaly <w>bloudit</w> od stáda směrem do nebezpečných kopců."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "This sense is no longer in common use"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сбиться с пути или совершить ошибку.",
                        "zh": "偏离路径或犯错。",
                        "cs": "Sejít z cesty nebo udělat chybu."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заблуждаться",
                                "target_lang_sense_clarification": "отклоняться от истины"
                            },
                            {
                                "target_lang_word": "сбиться с пути",
                                "target_lang_sense_clarification": "уйти с верной дороги"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "偏离",
                                "target_lang_sense_clarification": "离开正确的方向"
                            },
                            {
                                "target_lang_word": "迷失",
                                "target_lang_sense_clarification": "失去方向"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "sejít z cesty",
                                "target_lang_sense_clarification": "ztratit správný směr"
                            },
                            {
                                "target_lang_word": "bloudit",
                                "target_lang_sense_clarification": "ztratit orientaci"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ff88527d-236c-3032-a5f0-6f5580c67a94",
                    "sense_definition": "Simple past of <w>rive</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lightning <w>rave</w> the ancient oak tree in two during the storm.",
                            "target_lang_translations": {
                                "ru": "Молния <w>расколола</w> древний дуб надвое во время грозы.",
                                "zh": "暴风雨中，闪电将那棵古老的橡树<w>劈开</w>成两半。",
                                "cs": "Blesk během bouře <w>rozštípl</w> starý dub na dvě poloviny."
                            }
                        },
                        {
                            "text": "He <w>rave</w> the document into pieces in a moment of pure frustration.",
                            "target_lang_translations": {
                                "ru": "Он <w>разорвал</w> документ в клочья в момент полного отчаяния.",
                                "zh": "在极度沮丧的瞬间，他将文件<w>撕裂</w>成碎片。",
                                "cs": "V momentě naprosté frustrace dokument <w>roztrhal</w> na kusy."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "The past tense 'rived' or 'riven' is more common today"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время глагола 'rive' (раскалывать, раздирать).",
                        "zh": "rive 的过去式（意为撕裂或劈开）。",
                        "cs": "Minulý čas slovesa 'rive' (roztrhnout, rozštípnout)."
                    },
                    "translations": {
                        "ru": [
