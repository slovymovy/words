                "word_linkages": []
            },
            {
                "entry_id": "a899c87b-be97-31a6-82d1-8fbaf0811467",
                "word": "émeraudine",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "3f8cf231-9641-42e6-811e-781fa6041ca8",
