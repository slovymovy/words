                ],
                "senses": [
                    {
                        "sense_id": "3559e1d7-2435-35c9-97af-7625b008270d",
                        "entry_id": "374637e0-d689-373c-a6fe-29abb22b45f0",
                        "glosses": [
                            "Marquer de motifs dont le dessin ressemble à une imbrication d'écailles."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "746f9f51-dab0-4f6c-b8a7-a39e2cc2b7cb",
                                "sense_id": "3559e1d7-2435-35c9-97af-7625b008270d",
                                "text": "Ces pierres, d'un gris bleuâtre, papelonnant le sol écaillé, font l'effet de verrues sur le dos d'un crocodile centenaire ; elles découpent mille déchiquetures bizarres sur la silhouette des collines, qui ressemblent à des décombres d'édifices gigantesques."
                            },
                            {
                                "example_id": "30af9a91-63ea-406b-9d2a-14856d18aa55",
                                "sense_id": "3559e1d7-2435-35c9-97af-7625b008270d",
                                "text": "Les toits de ces maisons et souvent les étages supérieurs sont couverts de petites tuiles rondes de bois imbriquées et papelonnées comme des écailles de carpes."
                            },
                            {
                                "example_id": "aeb4fdc7-5d8b-4ba6-8f8e-210957638c58",
                                "sense_id": "3559e1d7-2435-35c9-97af-7625b008270d",
                                "text": "Les hauts toits d’ardoises délicatement imbriquées et papelonnées traçaient sur le ciel clair des lignes agréablement correctes."
                            },
                            {
                                "example_id": "86edd649-e161-42a5-a34c-db58991f2d9d",
                                "sense_id": "3559e1d7-2435-35c9-97af-7625b008270d",
                                "text": "L’autre, au contraire, n’a ni un ornement, ni une guipure ; il est simplement papelonné comme un homme d’armes d’écailles."
                            }
                        ]
                    }
                ],
