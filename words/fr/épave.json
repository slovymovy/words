                    "sense_definition": "Personne affaiblie et déchue dans un état d'extrême détresse physique ou morale.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "personne",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après des années d'excès et de maladie, cet homme est devenu une véritable <w>épave</w>."
                        },
                        {
                            "text": "Le chagrin et l'épuisement risquent de transformer ce travailleur en <w>épave</w>."
                        }
                    ],
                    "synonyms": [
                        "loque"
