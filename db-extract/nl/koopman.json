                    {
                        "translation_id": "7d33d176-f523-4a34-9bd8-a621954f39bb",
                        "source_entry_id": "fe9916ef-ce09-3712-928b-671b37934bb0",
                        "source_sense_id": "07367780-8239-3b11-a71e-6ec4de925ab0",
