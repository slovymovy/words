                        "entry_id": "223775b1-acec-3679-a653-d1efc1618414",
                        "glosses": [
                            "Fachgebiet, das sich mit der äußeren und inneren Gestaltung (Design) von Kraftfahrzeugen befasst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5df0d48-6859-4dff-93ae-54d60d740672",
                                "sense_id": "28d1ef52-e559-367c-9268-72fa76e79928",
                                "text": "„Die erfolgreiche Markteinführung neuen Automobildesigns stellt hohe Anforderungen.“"
                            },
                            {
                                "example_id": "b5b44a9c-aa8e-445f-bc93-a2e96abc6eb2",
                                "sense_id": "28d1ef52-e559-367c-9268-72fa76e79928",
                                "text": "„Ausschlaggebend ist in diesem Fall die Formensprache, die sich über das Automobildesign vermittelt.“"
                            },
                            {
                                "example_id": "c0b50289-aeb9-4911-862a-f4f3c1a2fff5",
                                "sense_id": "28d1ef52-e559-367c-9268-72fa76e79928",
                                "text": "„Das Lehrfach Automobildesign wird heute in Deutschland in Hamburg und Pforzheim gelehrt.“"
                            },
                            {
                                "example_id": "dd9a80c5-862c-4bcc-9011-60e66f1e6857",
                                "sense_id": "28d1ef52-e559-367c-9268-72fa76e79928",
                                "text": "„Nach dem Abitur in Oxford studiert sie im kalifornischen Pasadena Automobildesign.“"
                            }
                        ],
