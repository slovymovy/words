                "senses": [
                    {
                        "sense_id": "7fc2fb71-57fe-3bea-8397-36c2a73b52d1",
                        "entry_id": "745c34a6-65b6-3a13-872f-fb1e3a1d29b7",
                        "glosses": [
                            "Geschichte, die in einer fiktiven Gesellschaft spielt, die sich zum Negativen entwickelt hat, (literarische) Endzeit"
                        ],
                        "tags": [
                            "auch"
                        ],
                        "examples": [
                            {
                                "example_id": "b41304ae-e7aa-456d-9667-dc8420d73314",
                                "sense_id": "7fc2fb71-57fe-3bea-8397-36c2a73b52d1",
                                "text": "„Mann bezeichnet den ‚Übermenschen‘ als eine ‚Schreckensutopie von Größe, Stärke und Schönheit‘.“"
                            },
                            {
                                "example_id": "5b4b44a9-1839-4cff-937b-172fe07ad1d2",
                                "sense_id": "7fc2fb71-57fe-3bea-8397-36c2a73b52d1",
                                "text": "„Die traditionsreiche literarische Gattung der Utopie tritt heute zumeist als Schreckensutopie auf.“"
                            },
                            {
                                "example_id": "a864bfd6-a37a-4bc6-8965-e8474b7a1968",
                                "sense_id": "7fc2fb71-57fe-3bea-8397-36c2a73b52d1",
                                "text": "„In der literarischen Schreckensutopie ‚1984‘ lässt der Schriftsteller George Orwell eine Monster-Regierung immer wieder Hass-Wochen veranstalten.“"
                            }
                        ],
