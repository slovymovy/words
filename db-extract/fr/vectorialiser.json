                        "examples": [
                            {
                                "example_id": "c60a7f63-198f-4724-94e1-d5be50da2fe2",
                                "sense_id": "b5bbc21d-f9c9-3e37-b90b-1a6d366539ee",
                                "text": "Ce n’est pas sa nature ou son contenu de sens qui font la trace, mais le geste de vectorialiser le perçu par cette fonction dynamique dans le temps."
                            },
                            {
                                "example_id": "2ca34afa-a03c-4bd3-bce6-48c5348bd307",
                                "sense_id": "b5bbc21d-f9c9-3e37-b90b-1a6d366539ee",
                                "text": "L’analyste ne fait que vectorialiser, ce qui renvoie à une certaine légèreté dans sa façon d’intervenir, laissant l’analysant tout à son travail d’analyse."
                            }
                        ]
                    }
