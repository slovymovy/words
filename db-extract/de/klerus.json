                        ],
                        "form": "dem Klerus"
                    },
                    {
                        "form_id": "5048a72a-7606-4bc2-9121-f02510e6b513",
                        "entry_id": "6fef1487-e474-36e7-afe0-739033e3fd36",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "den Klerus"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "132bb2e6-08f2-332d-9db8-08124e1472fe",
                        "entry_id": "6fef1487-e474-36e7-afe0-739033e3fd36",
                        "glosses": [
                            "die Gesamtheit der Geistlichen (Kleriker)"
                        ],
                        "tags": [
                            "Katholizismus"
                        ],
                        "examples": [
                            {
                                "example_id": "33806e0f-e1aa-432f-8947-0d9f39183d24",
                                "sense_id": "132bb2e6-08f2-332d-9db8-08124e1472fe",
                                "text": "„Dies zeigt, daß im fünfzehnten und vielerorts schon im vierzehnten Jahrhundert die Beherrschung der Schrift keineswegs mehr auf den Klerus beschränkt, sondern im Bürgertum verbreitet war.“"
                            },
                            {
                                "example_id": "c5532feb-9fca-411d-bfb6-345756e2b6d4",
                                "sense_id": "132bb2e6-08f2-332d-9db8-08124e1472fe",
                                "text": "„Am nächsten Tag mußte er ein Pontifikalamt zelebrieren, und dabei sah ich seinen gesamten Klerus und auch die Frauen und Männer, die seine Kirche füllten.“"
                            },
                            {
                                "example_id": "573fac2c-146e-4a49-b36b-7818270d054c",
                                "sense_id": "132bb2e6-08f2-332d-9db8-08124e1472fe",
                                "text": "„Sicherlich gilt er zum guten Teil vor allem der katholischen Kirche, insbesondere dem Klerus seiner Zeit, als dessen wenig würdigen Vertreter der Marquis ja schon in früher Jugend den Abbé de Sade, seinen Onkel und Erzieher, kennengelernt hatte.“"
                            },
                            {
                                "example_id": "8fe28a2c-0f08-4bba-84f3-658b9ae893b6",
                                "sense_id": "132bb2e6-08f2-332d-9db8-08124e1472fe",
                                "text": "„Der Klerus regiert nicht, hat aber Einfluss, mal mehr, mal weniger.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "05b6dbbc-2aa8-4475-8864-9b87ede1f9ee",
                        "source_entry_id": "6fef1487-e474-36e7-afe0-739033e3fd36",
                        "source_sense_id": "132bb2e6-08f2-332d-9db8-08124e1472fe",
                        "source_sense_description": "Katholizismus: die Gesamtheit der Geistlichen (Kleriker)",
                        "target_lang_word": "clergy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "clergy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "81e487eb-aaf2-3550-9989-f86cdc3f03ce",
                                        "entry_id": "cc1e08c5-076a-3234-9ae1-f1bd7030ddee",
                                        "glosses": [
                                            "Body of persons, such as priests, who are trained and ordained for religious service."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "77aaf779-7ba3-47f8-9dc3-9a00667cc8d1",
                                                "sense_id": "81e487eb-aaf2-3550-9989-f86cdc3f03ce",
                                                "text": "Today we brought together clergy from the Anglican, Catholic, Orthodox, and Reformed traditions for ecumenical dialogue."
                                            },
                                            {
                                                "example_id": "2f187d88-5e73-4bfb-b681-34cbead7535f",
                                                "sense_id": "81e487eb-aaf2-3550-9989-f86cdc3f03ce",
                                                "text": "Then everybody once more knelt, and soon the blessing was pronounced. The choir and the clergy trooped out slowly, […], down the nave to the western door. […] At a seemingly immense distance the surpliced group stopped to say the last prayer."
                                            },
                                            {
                                                "example_id": "96430d3d-328a-41f4-9071-5709c087df34",
                                                "sense_id": "81e487eb-aaf2-3550-9989-f86cdc3f03ce",
                                                "text": "After years of debate, hundreds of United Methodists from all over the world gathered in St. Louis last week to settle the denomination’s stance on LGBT clergy and same-sex weddings."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2d1173e2-44ab-4234-b69e-195d64dfcccb",
                        "source_entry_id": "6fef1487-e474-36e7-afe0-739033e3fd36",
                        "source_sense_id": "132bb2e6-08f2-332d-9db8-08124e1472fe",
                        "source_sense_description": "Katholizismus: die Gesamtheit der Geistlichen (Kleriker)",
                        "target_lang_word": "clergé",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "clergé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c54ddd9c-6ffe-3a46-9774-9817d5933c04",
                                        "entry_id": "ca3f8748-246e-3161-853c-21f97f504a87",
                                        "glosses": [
                                            "Corps des ecclésiastiques, organisé selon une hiérarchie ecclésiale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0774032-7512-476f-827a-26d7808cec9b",
                                                "sense_id": "c54ddd9c-6ffe-3a46-9774-9817d5933c04",
                                                "text": "Pour lancer contre nous ces furieux prédicateurs, il faut que les chefs du clergé se soient sentis bien atteints."
                                            },
                                            {
                                                "example_id": "fec042ec-e81e-4da5-a6b5-6da3f22a90b3",
                                                "sense_id": "c54ddd9c-6ffe-3a46-9774-9817d5933c04",
                                                "text": "Dans ce marais stagnant s’étend le filet ecclésiastique. Les vieilles dames, les pères devenus conservateurs avec l’âge, font des legs au clergé. Nulle excitation, nul renouvellement d’esprit : le culte avec ses pompes, l’habitude, le poids de la tradition, la litanie solennelle indéfiniment répétée, les ramènent à la vieille routine."
                                            },
                                            {
                                                "example_id": "b70f8463-0222-4833-85fd-5a8fd0ba642d",
                                                "sense_id": "c54ddd9c-6ffe-3a46-9774-9817d5933c04",
                                                "text": "[…] elle provoque souvent la conversion au judaïsme de membres du Clergé, tel ce Wicelinius, aumônier du duc Conrad de Metz, et qui, une fois devenu juif (vers l'an 1000), écrivit un pamphlet contre le christianisme."
                                            },
                                            {
                                                "example_id": "61cf611e-2e5c-4d2a-81d8-7b3cfdf9972b",
                                                "sense_id": "c54ddd9c-6ffe-3a46-9774-9817d5933c04",
                                                "text": "Je suis certaine qu’elle a vu clairement ce clergé stupide, incapable de véritable amour, …."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "68263012-734b-3db1-a759-f9f32977fc71",
                                        "entry_id": "ca3f8748-246e-3161-853c-21f97f504a87",
                                        "glosses": [
                                            "Corps particulier des ecclésiastiques desservant d’une église, d’un chapitre cathédral ou d’une paroisse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40f4c9cc-2703-4c80-82f9-ed67118b0c0c",
                                                "sense_id": "68263012-734b-3db1-a759-f9f32977fc71",
                                                "text": "Vous pensez bien, dit-il, que la nomination d’un chanoine étranger au diocèse n’a pas été considérée d’un œil indifférent par le clergé de Chartres."
                                            },
                                            {
                                                "example_id": "fc1ee7af-0b84-4b11-a74e-d0883b9d084e",
                                                "sense_id": "68263012-734b-3db1-a759-f9f32977fc71",
                                                "text": "Le curé y assistait avec tout son clergé."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
