                "senses": [
                    {
                        "sense_id": "c164c8d7-bc69-36a3-99f3-383c5519fd6f",
                        "entry_id": "95dd91f1-5853-3f75-97f8-2c024c2385e1",
                        "glosses": [
                            "gemeinsamer Feiertag aller Menschen am 10. Oktober jedes Jahres, der vom Weltmenschverein ausgerufen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54910a9f-af41-4336-a138-9c3de8edbe4b",
                                "sense_id": "c164c8d7-bc69-36a3-99f3-383c5519fd6f",
                                "text": "„Es gibt aber bis heute keinen Feiertag, den alle Menschen dieses Planeten gemeinsam feiern. Darum organisiert der Weltmenschverein jedes Jahr am 10. Oktober den Weltmenschtag.“"
                            },
                            {
                                "example_id": "72ddabdd-c941-4464-9a60-db4217717e54",
                                "sense_id": "c164c8d7-bc69-36a3-99f3-383c5519fd6f",
                                "text": "„Am vergangenen Samstag war es wieder soweit. Der bereits 11. Weltmenschtag ging im Gemeindezentrum Pfaffstätten über die Bühne.“"
                            },
                            {
                                "example_id": "b24e4c6c-c79a-4d78-a792-3b37ed3695f1",
                                "sense_id": "c164c8d7-bc69-36a3-99f3-383c5519fd6f",
                                "text": "„Metin, ein gebürtiger Türke, gründete den Weltmenschverein vor drei Jahren, um den direkten Dialog zwischen Kulturen und Religionen zu fördern. Eines seiner Ziele ist es, den internationalen Weltmenschtag am 1. November jedes Jahres einzuführen.“"
                            },
                            {
                                "example_id": "1956e8f6-c01f-4266-b8cd-5c733086f576",
                                "sense_id": "c164c8d7-bc69-36a3-99f3-383c5519fd6f",
                                "text": "„Am 7. Weltmenschtag wurde zum 5. Mal auch der Weltmensch-Preis verliehen.“"
                            },
                            {
                                "example_id": "435b6774-5c10-4b95-86bc-ac31c658675c",
                                "sense_id": "c164c8d7-bc69-36a3-99f3-383c5519fd6f",
                                "text": "„Jedes Jahr wird an einem anderen Ort ein großes Fest zum Weltmenschtag, jeweils am 10. Oktober, organisiert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
