                                "example_id": "332d2293-fe8c-40c0-9235-c8939dc0f0c6",
                                "sense_id": "5a00683f-806d-300d-97b5-ecead4c92414",
                                "text": "Je souhaiterais que l'on puisse checker/déchecker un item un cliquant sur le texte associé."
                            },
                            {
                                "example_id": "263c3327-fdf6-4fc8-bc7f-98028eeeaf9d",
                                "sense_id": "5a00683f-806d-300d-97b5-ecead4c92414",
                                "text": "Possibilité de checker ou déchecker tous les sous-services"
                            },
                            {
                                "example_id": "30a4076e-a70a-41d1-a8c4-0de542f45475",
                                "sense_id": "5a00683f-806d-300d-97b5-ecead4c92414",
                                "text": "Après avoir demandé à la classe de m'épargner les détails, j'ai dû déchecker des points de ma liste."
                            }
                        ]
                    }
