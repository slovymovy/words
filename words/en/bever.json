{
    "word_family": [
        "bevor"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "00ae3717-d663-3fa7-83ac-dfc0bc907f98",
                    "sense_definition": "A snack or light refreshment taken between meals.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "refreshment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farm laborers stopped their work in the late afternoon to enjoy a quick <w>bever</w> of bread and cheese.",
                            "target_lang_translations": {
                                "ru": "Сельскохозяйственные рабочие прервали работу поздно днем, чтобы насладиться быстрым <w>перекусом</w> из хлеба и сыра."
                            }
                        },
                        {
                            "text": "He carried his <w>bever</w> to the study on a tray, consisting of a simple sandwich and a cup of tea.",
                            "target_lang_translations": {
                                "ru": "Он принес свой <w>полдник</w> в кабинет на подносе, состоящий из простого сэндвича и чашки чая."
                            }
                        }
                    ],
                    "synonyms": [
                        "snack",
                        "nunchion",
                        "collation"
                    ],
                    "common_phrases": [
                        "afternoon bever",
                        "carry a bever"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "primarily used in historical or regional contexts"
                        },
                        {
                            "trait_type": "regional",
                            "comment": "traditionally used in parts of England"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Легкая закуска или перекус между основными приемами пищи."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перекус",
                                "target_lang_sense_clarification": "легкая еда"
                            },
                            {
                                "target_lang_word": "полдник",
                                "target_lang_sense_clarification": "прием пищи между обедом и ужином"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bf750f16-e3ee-3951-a6c5-c88dfd31b5fe",
                    "sense_definition": "A drink or a small portion of liquid refreshment.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "refreshment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The servant was instructed to give the guest a <w>bever</w> from the buttery to quench his thirst.",
                            "target_lang_translations": {
                                "ru": "Слуге было велено дать гостю <w>напиток</w> из кладовой, чтобы тот мог утолить жажду."
                            }
                        },
                        {
                            "text": "After the long journey, a cool <w>bever</w> was exactly what the traveler needed.",
                            "target_lang_translations": {
                                "ru": "После долгого путешествия прохладное <w>питье</w> было именно тем, что нужно путешественнику."
                            }
                        }
                    ],
                    "synonyms": [
                        "beverage",
                        "drink"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "no longer in common use"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Напиток или небольшая порция жидкого освежающего средства."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "напиток",
                                "target_lang_sense_clarification": "любое питье"
                            },
                            {
                                "target_lang_word": "питье",
                                "target_lang_sense_clarification": "устаревшее или разговорное обозначение напитка"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6ea725cf-1fe6-3125-ad98-3be13a570b59",
                    "sense_definition": "Alternative spelling of <w>bevor</w>; a piece of plate armor that protects the lower face and throat.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "armor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The knight raised his <w>bever</w> so that he could speak more clearly to his companions.",
                            "target_lang_translations": {
                                "ru": "Рыцарь поднял свое <w>забрало</w>, чтобы иметь возможность яснее говорить со своими спутниками."
                            }
                        },
                        {
                            "text": "A heavy blow from the lance pierced through his <w>bever</w> and injured his jaw.",
                            "target_lang_translations": {
                                "ru": "Сильный удар копья пробил его <w>подбородник</w> и повредил челюсть."
                            }
                        }
                    ],
                    "synonyms": [
                        "bevor"
                    ],
                    "common_phrases": [
                        "close the bever",
                        "raise the bever"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "refers to historical armor"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вариант написания слова 'bevor'; часть латного доспеха, защищающая нижнюю часть лица и горло."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "забрало",
                                "target_lang_sense_clarification": "нижняя часть шлема"
                            },
                            {
                                "target_lang_word": "подбородник",
                                "target_lang_sense_clarification": "деталь доспеха для защиты горла и подбородка"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c1b96222-0f8b-362f-949e-a14b32af7247",
                    "sense_definition": "A specific mixture of cider and water.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "refreshment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the harvest fields, the workers often drank a <w>bever</w> made of diluted cider to stay hydrated.",
                            "target_lang_translations": {
                                "ru": "На полях во время сбора урожая рабочие часто пили <w>смесь сидра с водой</w>, чтобы избежать обезвоживания."
                            }
                        },
                        {
                            "text": "The local recipe for <w>bever</w> required two parts water for every part of hard cider.",
                            "target_lang_translations": {
                                "ru": "Местный рецепт <w>напитка</w> требовал две части воды на каждую часть крепкого сидра."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "specific to certain rural dialects"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Специфическая смесь сидра и воды."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разбавленный сидр",
                                "target_lang_sense_clarification": "напиток из сидра с водой"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "63268a8f-0ef5-3c72-a8df-0d5c9c8d3442",
                    "sense_definition": "Obsolete spelling of <w>beaver</w> (the semiaquatic rodent).",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old manuscript described the <w>bever</w> as a creature that builds dams across the forest streams.",
                            "target_lang_translations": {
                                "ru": "В старой рукописи <w>бобр</w> описывался как существо, строящее плотины на лесных ручьях."
                            }
                        },
                        {
                            "text": "Hunters in the seventeenth century often sought the <w>bever</w> for its valuable thick fur.",
                            "target_lang_translations": {
                                "ru": "Охотники в семнадцатом веке часто искали <w>бобра</w> из-за его ценного густого меха."
                            }
                        }
                    ],
                    "synonyms": [
                        "beaver"
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "historical spelling"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Устаревшее написание слова 'beaver' (бобр)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бобр",
                                "target_lang_sense_clarification": "полуводное млекопитающее"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "27d58e95-352b-3565-8290-d9a4959354a9",
                    "sense_definition": "To take a light meal or refreshment between regular meal times.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The harvesters would <w>bever</w> at four o'clock before returning to the fields for the final hours of light.",
                            "target_lang_translations": {
                                "ru": "Жнецы обычно <w>перекусывали</w> в четыре часа, прежде чем вернуться в поле на последние часы светового дня."
                            }
                        },
                        {
                            "text": "It was his habit to <w>bever</w> on a small piece of cake during the long afternoon gap.",
                            "target_lang_translations": {
                                "ru": "У него была привычка <w>полдничать</w> небольшим кусочком торта во время долгого дневного перерыва."
                            }
                        }
                    ],
                    "synonyms": [
                        "snack"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "rarely used in modern English"
                        },
                        {
                            "trait_type": "regional",
                            "comment": "found in British dialectal history"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Перекусывать или принимать легкую пищу между основными приемами еды."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перекусывать",
                                "target_lang_sense_clarification": "есть понемногу между делом"
                            },
                            {
                                "target_lang_word": "полдничать",
                                "target_lang_sense_clarification": "принимать пищу во второй половине дня"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "f0468b87-ac72-356d-a125-45b6562766d7",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The local library was named after Thomas <w>Bever</w>, a prominent scholar from the eighteenth century.",
                            "target_lang_translations": {
                                "ru": "Местная библиотека была названа в честь Томаса <w>Бевера</w>, выдающегося ученого восемнадцатого века."
                            }
                        },
                        {
                            "text": "We found several families with the name <w>Bever</w> listed in the historical census records of the county.",
                            "target_lang_translations": {
                                "ru": "Мы нашли несколько семей с фамилией <w>Бевер</w> в исторических записях переписи населения округа."
                            }
