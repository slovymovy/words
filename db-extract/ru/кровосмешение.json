                                "target_senses": [
                                    {
                                        "sense_id": "b714c44c-55f2-31cc-876e-09acaafe916b",
                                        "entry_id": "fc942210-f402-38a4-ab9e-e4094ada8902",
                                        "glosses": [
                                            "stosunki płciowe z osobą blisko spokrewnioną, rodzaj parafilii"
                                        ],
                                        "tags": [],
