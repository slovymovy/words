                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "706fcb70-9328-44aa-8b12-3c4a12d3d112",
                                "sense_id": "0dbd2fbd-b927-3900-a731-dc2f4215ec3b",
                                "text": "Der Betrachter sieht zunächst nur eines der zwei abgebildeten Gesichter."
                            },
                            {
                                "example_id": "e4c34b6b-6cbc-4bb7-9a60-efd3a4c8d09f",
                                "sense_id": "0dbd2fbd-b927-3900-a731-dc2f4215ec3b",
                                "text": "„Ein Gran Eifersucht erhöht den Reiz, den der Betrachter empfindet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "31b21812-f6fe-4cb5-9518-8830f67af8cf",
                        "source_entry_id": "cbda832a-cbb9-3a68-863f-ce4fe95edc6b",
                        "source_sense_id": "0dbd2fbd-b927-3900-a731-dc2f4215ec3b",
                        "source_sense_description": "jemand, der sich etwas anschaut",
                        "target_lang_word": "observer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "observer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9f7df605-4694-32d4-bbcb-0fd6677fb52a",
                                        "entry_id": "efd2ca3e-3019-3da7-b155-b4124c1b58fe",
                                        "glosses": [
                                            "One who makes observations, monitors or takes notice"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00693bc9-63ae-4e4b-b80c-f926096d434b",
                                                "sense_id": "9f7df605-4694-32d4-bbcb-0fd6677fb52a",
                                                "text": "Most impartial observers agreed that Sampras had not served well."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1fa23ded-3207-39a2-828f-15f1899f8101",
                                        "entry_id": "efd2ca3e-3019-3da7-b155-b4124c1b58fe",
                                        "glosses": [
                                            "One who adheres or follows laws, guidelines, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b3a7906-6a3c-4a0d-91a7-e10fcc3d06d0",
                                                "sense_id": "1fa23ded-3207-39a2-828f-15f1899f8101",
                                                "text": "I shall be an observer of the local customs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f14dcf91-edbe-345f-aa35-f91b1445d462",
                                        "entry_id": "efd2ca3e-3019-3da7-b155-b4124c1b58fe",
                                        "glosses": [
                                            "A person sent as a representative, to a meeting or other function to monitor but not to participate"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "988089fa-9379-47fb-9288-fedb0f4b2776",
                                                "sense_id": "f14dcf91-edbe-345f-aa35-f91b1445d462",
                                                "text": "The UN sent many observers to the country's first elections."
                                            },
                                            {
                                                "example_id": "38d1b4d0-b319-4bc5-af6e-2c882aa496fb",
                                                "sense_id": "f14dcf91-edbe-345f-aa35-f91b1445d462",
                                                "text": "When the army reached Tsun-i, an enlarged Politburo meeting was called. Teng attended as an observer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1147702-b0b6-3305-a9ed-26d427d7e4b7",
                                        "entry_id": "efd2ca3e-3019-3da7-b155-b4124c1b58fe",
                                        "glosses": [
                                            "A country or other entity which has limited participation rights within an organization."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "962ce456-b61b-478f-959b-56a2e3ef7664",
                                                "sense_id": "e1147702-b0b6-3305-a9ed-26d427d7e4b7",
                                                "text": "The Vatican and Palestine have observer status at the UN."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a7fb6863-462d-3ea5-8ff7-34b75755a4f0",
                                        "entry_id": "efd2ca3e-3019-3da7-b155-b4124c1b58fe",
                                        "glosses": [
                                            "A crew member on an aircraft who makes observations of enemy positions or aircraft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8482bee6-9d2d-4194-bc6f-cd94ef0a1c5f",
                                                "sense_id": "a7fb6863-462d-3ea5-8ff7-34b75755a4f0",
                                                "text": "The only crew-member to survive the crash was the Canadian observer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "087957d7-3801-3f05-ae24-56486955d0f9",
                                        "entry_id": "efd2ca3e-3019-3da7-b155-b4124c1b58fe",
                                        "glosses": [
                                            "A sentry etc. manning an observation post"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87e3811e-54ec-4578-b7d0-4537e594c3b3",
                                                "sense_id": "087957d7-3801-3f05-ae24-56486955d0f9",
                                                "text": "We waited till dusk when the observers' vision was poorest."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
