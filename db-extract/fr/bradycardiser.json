                "senses": [
                    {
                        "sense_id": "4afa1acb-d5ff-3e01-ba1c-182efc62aea5",
                        "entry_id": "9e8189f5-c96a-3739-8573-a09c0c7639fa",
                        "glosses": [
                            "Subir une diminution anormale du nombre des battements du cœur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b6e4276-9f41-45c1-acb0-638455aa88bd",
                                "sense_id": "4afa1acb-d5ff-3e01-ba1c-182efc62aea5",
                                "text": "Ça s'est mis à palpiter puis à bradycardiser."
                            },
                            {
                                "example_id": "d13517c5-1b99-42da-8624-4ad86de244f2",
                                "sense_id": "4afa1acb-d5ff-3e01-ba1c-182efc62aea5",
                                "text": "Mon père avait réussi à me faire \"bradycardiser\" par ses propos alors que ma mère non, comme quoi il y'a une influence énorme de l'entourage extérieur."
                            },
                            {
                                "example_id": "88857051-8249-4c10-bc17-1ae53e9a39a7",
                                "sense_id": "4afa1acb-d5ff-3e01-ba1c-182efc62aea5",
                                "text": "mais, Messieurs, n'hésitez surtout pas à aller voir Marine Baousson sur scène, vous pourriez bien bradycardiser pour elle."
                            }
                        ]
                    }
