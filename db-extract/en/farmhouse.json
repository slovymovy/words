                        "source_sense_id": "f9db8577-76fb-351e-a6d6-02c0bd5329b0",
                        "source_sense_description": "Farmhaus, Bauernhaus, Gehöft",
                        "target_lang_word": "Gehöft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gehöft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0ee6ec21-bcee-3244-a6d9-ed7ff326cb44",
                                        "entry_id": "ebf5e951-f639-369f-a240-6424c2406227",
                                        "glosses": [
                                            "alte Bezeichnung für Bauernhof"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4dd62dcb-0126-4df0-b3de-f4e513120ddf",
                                                "sense_id": "0ee6ec21-bcee-3244-a6d9-ed7ff326cb44",
                                                "text": "Zum Gehöft gehören mehrere Häuser."
                                            },
                                            {
                                                "example_id": "8812db34-d310-46c0-bf7b-2a9b68ffa383",
                                                "sense_id": "0ee6ec21-bcee-3244-a6d9-ed7ff326cb44",
                                                "text": "„Er hatte keinen Blick mehr für die Gehöfte zu beiden Seiten der Dorfstraße, für die mit Stroh gedeckten Stallungen, die Lindenbäume, die in unregelmäßigen Abständen den Weg säumten.“"
                                            },
                                            {
                                                "example_id": "1314c80b-d3f9-4618-856b-69e08396145f",
                                                "sense_id": "0ee6ec21-bcee-3244-a6d9-ed7ff326cb44",
                                                "text": "„Sie waren Ackerbauern und Viehzüchter, die verstreut auf Gehöften oder in kleinen Dörfern wohnten.“"
                                            },
                                            {
                                                "example_id": "f53edbb7-5909-4b61-ac6b-cbd38ceb0c94",
                                                "sense_id": "0ee6ec21-bcee-3244-a6d9-ed7ff326cb44",
                                                "text": "„Vom Westen her mischen sich ins letzte Tageslicht schon die Fackeln der Nacht: Gehöfte oder ganze Dörfer, die im Feuersturm versinken.“"
                                            },
                                            {
                                                "example_id": "19ed3c3d-bbca-4220-b091-f1200f2cd45c",
                                                "sense_id": "0ee6ec21-bcee-3244-a6d9-ed7ff326cb44",
                                                "text": "„Auf diesem Gehöft gab es weder einen Fellsack noch eine Plunderkiste, nicht einmal einen Büden in der Scheune.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
