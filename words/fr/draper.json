                    "frequency": "VeryLow",
                    "semantic_group_id": "critique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans son nouveau pamphlet, l'essayiste a copieusement <w>drapé</w> les parlementaires et leurs travers."
