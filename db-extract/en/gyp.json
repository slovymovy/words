                "senses": [
                    {
                        "sense_id": "801b5ee4-aa97-34dc-a97a-3ef0bf6251c9",
                        "entry_id": "b349a680-5834-35f1-98ad-1db8653c3d92",
                        "glosses": [
                            "To cheat or swindle."
                        ],
                        "tags": [
                            "derogatory",
                            "offensive",
                            "sometimes"
                        ],
                        "examples": [
                            {
                                "example_id": "89ba7458-baf1-42ff-a5bd-ae549ce6301f",
                                "sense_id": "801b5ee4-aa97-34dc-a97a-3ef0bf6251c9",
                                "text": "The cab driver gypped me out of ten bucks by taking the longer route."
                            },
                            {
                                "example_id": "34d0ed8c-1609-4c75-a509-a3ef939e8bc4",
                                "sense_id": "801b5ee4-aa97-34dc-a97a-3ef0bf6251c9",
                                "text": "You better watch out; they'll try to gyp you if you don't know what you're doing."
                            },
                            {
                                "example_id": "54fb6541-873d-4a5d-a421-0e0859524953",
                                "sense_id": "801b5ee4-aa97-34dc-a97a-3ef0bf6251c9",
                                "text": "They're talkin' bout the night Santa went crazy\nThe night St. Nicholas flipped\nBroke his back for some milk and cookies\nSounds to me like he was tired of gettin' gypped"
                            },
                            {
                                "example_id": "b4da65ae-eea7-4edf-b05c-dacd732147e4",
                                "sense_id": "801b5ee4-aa97-34dc-a97a-3ef0bf6251c9",
                                "text": "On Wednesday, Goldberg used a derogatory term associated with Romany people while discussing former president Donald Trump, saying that his supporters are “people who still believe that he got gypped somehow in the election”."
                            }
                        ]
                    }
                ],
