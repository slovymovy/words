                ],
                "senses": [
                    {
                        "sense_id": "2eec9134-c5d1-3bb8-9f0a-c14765262c96",
                        "entry_id": "9f1e1ca1-ac19-3120-bce7-bac57f326cc8",
                        "glosses": [
                            "kleiner Dachshund (Dackel)"
                        ],
                        "tags": [
                            "Austrian German",
                            "South-German"
                        ],
                        "examples": [
                            {
                                "example_id": "e3f0d292-73ec-4568-b2ae-a2c7afaea615",
                                "sense_id": "2eec9134-c5d1-3bb8-9f0a-c14765262c96",
                                "text": "„Für das Dackerl vom Herrn Anton hat der Herr Rudi aber immer noch ein Knackerl dabei, denn das liebe Hundl ist des Menschen bester Freund, wie der Herr Rudi sagt.“"
                            },
                            {
                                "example_id": "de6536e8-353b-42c7-b277-1497e17ded22",
                                "sense_id": "2eec9134-c5d1-3bb8-9f0a-c14765262c96",
                                "text": "„»Dackerl, wo ist dein Herr?« fragte sie entsetzt.“"
                            },
                            {
                                "example_id": "96094d81-167c-4318-8bb4-73587c6e6e4c",
                                "sense_id": "2eec9134-c5d1-3bb8-9f0a-c14765262c96",
                                "text": "„Ich war nicht wenig neugierig, wie ich zu einem Maulkorb für das Dackerl kommen sollte, […]“"
                            },
                            {
                                "example_id": "a0292f12-7b9e-413b-bf8b-8ed9281aa981",
                                "sense_id": "2eec9134-c5d1-3bb8-9f0a-c14765262c96",
                                "text": "„Aber ich habe mir halt so absolut ein Dackerl gewünscht und nun ists wieder nichts.“"
                            },
                            {
                                "example_id": "133f1863-292c-44c0-8577-3e6276967ba3",
                                "sense_id": "2eec9134-c5d1-3bb8-9f0a-c14765262c96",
                                "text": "„Dös Hunderl war koa Pinscherl, war koa Schnauzerl, war koa Dackerl, es war von jedem a bisserl was.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
