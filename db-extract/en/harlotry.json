                                "target_senses": [
                                    {
                                        "sense_id": "b1ebdef7-ec9e-3c68-a5eb-ec9005a57923",
                                        "entry_id": "8a5330a4-85b1-37a9-97aa-cedd3920a460",
                                        "glosses": [
                                            "valse goden aanbidden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d27839ba-2ff4-4c66-9e06-a16efa396899",
                                                "sense_id": "b1ebdef7-ec9e-3c68-a5eb-ec9005a57923",
                                                "text": "Victor bekeerde zich in 2010. Voor die tijd luisterde hij naar metal, hij ging naar het vmbo en bracht de post rond. In 2012 verscheen hij voor het eerst met baard, tulband en Islamitisch gewaad op You Tube in zelfgemaakte filmpjes waarin hij zijn walging uitspreekt over de ongelovige Nederlanders en hun levenswijze. „Deze maatschappij loopt op alcohol en hoererij”, zegt hij in het laatste filmpje voor zijn vertrek naar Syrië eind maart 2013."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "15f03b24-67b1-39cb-a6f8-969e189037bd",
                                        "entry_id": "8a5330a4-85b1-37a9-97aa-cedd3920a460",
                                        "glosses": [
                                            "zich beschikbaar stellen voor betaalde seks en het losbandige leven dat daarbij zou horen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2bae51ce-df72-45ff-8008-9bb281406841",
                                                "sense_id": "15f03b24-67b1-39cb-a6f8-969e189037bd",
                                                "text": "Er werd geflirt met hoererij, met de romantiek van Vivian in Pretty Woman, van Holly Golightly in Breakfast at Tiffany's. HP de Tijd 17/11"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "24ad9d96-ef39-495e-9413-716e8c898265",
                        "source_entry_id": "79898059-4bc2-3fcd-9b9d-08c85a8292b9",
                        "source_sense_id": "61517521-4a62-348c-9d64-1063ffe767fe",
                        "source_sense_description": "trade of a harlot; prostitution.",
                        "target_lang_word": "prostitutie",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prostitutie",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "b311a136-afe0-3d0f-bbdd-3ec168396c4b",
                                        "entry_id": "253e5ffa-b850-36d7-8d4d-0b3efb574a93",
                                        "glosses": [
                                            "het tegen betaling ter beschikking stellen van het lichaam voor het seksuele genot van een ander"
                                        ],
                                        "tags": [],
