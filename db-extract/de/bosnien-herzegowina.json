                "senses": [
                    {
                        "sense_id": "39adda1b-a288-3a57-9cdc-ad40d295f2da",
                        "entry_id": "8eb576f8-7f65-3b0c-92f3-0c41ae1ac28d",
                        "glosses": [
                            "Staat in Südosteuropa"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1d4f3b0-862a-4444-9fe8-4b283758c4a8",
                                "sense_id": "39adda1b-a288-3a57-9cdc-ad40d295f2da",
                                "text": "Sarajevo ist die Hauptstadt der Bosnien-Herzegowina."
                            },
                            {
                                "example_id": "fe15be6d-cc6a-4ca6-bb27-7ccb5c477762",
                                "sense_id": "39adda1b-a288-3a57-9cdc-ad40d295f2da",
                                "text": "„Vor 20 Jahren erklärte Bosnien-Herzegowina seine Unabhängigkeit von Jugoslawien.“"
                            },
                            {
                                "example_id": "12516def-709d-4c9a-90b0-f9b5d69d5093",
                                "sense_id": "39adda1b-a288-3a57-9cdc-ad40d295f2da",
                                "text": "„Keine ernst zu nehmende politische Kraft in Zagreb und Belgrad befürwortet den Anschluss der mehrheitlich kroatisch oder serbisch besiedelten Regionen Bosnien-Herzegowinas an Kroatien oder Serbien.“"
                            },
                            {
                                "example_id": "d475275b-f73b-418f-8290-618221d0b6cb",
                                "sense_id": "39adda1b-a288-3a57-9cdc-ad40d295f2da",
                                "text": "„Die Menschen in Bosnien-Herzegowina selbst müssen darauf pochen.“"
                            },
                            {
                                "example_id": "33ff5a3f-67d1-43c2-9400-91a19b8fd374",
                                "sense_id": "39adda1b-a288-3a57-9cdc-ad40d295f2da",
                                "text": "„Bosnien-Herzegowina kann ohne eine Klammer von außen kaum funktionieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
