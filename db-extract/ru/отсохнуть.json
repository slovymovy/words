                "translations": [
                    {
                        "translation_id": "958f69e2-a708-4d94-9163-adedcb8a4c76",
                        "source_entry_id": "ddf3cc15-584e-398d-8ab6-f74058efb4db",
                        "target_lang_word": "dry off",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dry off",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3c484f17-b7b8-344d-a4d4-e51e2247f7ad",
                                        "entry_id": "ba08fb9d-85c7-3307-8c66-2678b9ad6711",
                                        "glosses": [
                                            "To make dry."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ad08676b-17e3-3e65-a186-812d0caab857",
                                        "entry_id": "ba08fb9d-85c7-3307-8c66-2678b9ad6711",
                                        "glosses": [
                                            "To become dry."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b7b9de3-9909-47b0-9bfb-b9bbdf32f18a",
                                                "sense_id": "ad08676b-17e3-3e65-a186-812d0caab857",
                                                "text": "Drying off after the day of surfing in the afternoon summer sun of New Zealand, they remarked to each other how ironic their trip had been so far."
                                            },
                                            {
                                                "example_id": "105439a9-b727-427a-87ed-bca8735cacec",
                                                "sense_id": "ad08676b-17e3-3e65-a186-812d0caab857",
                                                "text": "The weather was atrocious (driving rain, strong wind, bone-chilling cold), but that didn't prevent us from getting out of our car, and walking over to the lighthouse there.[…]\nAfter taking some time to dry off while having a seafood lunch at the nearby Fuchi (Fuji) Fishing Harbor 富基漁港, we continued down the coast to the Temple of the Eighteen Lords 十八王公廟."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5bdc396e-1a2e-379d-9e97-c9bd411a6141",
                                        "entry_id": "ba08fb9d-85c7-3307-8c66-2678b9ad6711",
                                        "glosses": [
                                            "To cease milking a cow in preparation for calving."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "405dd241-285a-4c9d-b913-292723e1a877",
                                                "sense_id": "5bdc396e-1a2e-379d-9e97-c9bd411a6141",
                                                "text": "In an early study with cows producing very little milk at drying off, new infection rates were about equal whether cows were dried off abruptly or after a period of intermittent milking."
                                            },
                                            {
                                                "example_id": "4dac2bc7-7dcd-4a2b-8c9b-675d8c8c487b",
                                                "sense_id": "5bdc396e-1a2e-379d-9e97-c9bd411a6141",
                                                "text": "Thus, revenue from milk yield before dry-off is higher for cows that are abruptly dried off."
                                            },
                                            {
                                                "example_id": "2afb3668-2d5a-48a0-8d56-7d8bafa28607",
                                                "sense_id": "5bdc396e-1a2e-379d-9e97-c9bd411a6141",
                                                "text": "If you are drying off more cows than normal you are likely to need to increase the area in which you normally keep dry cows."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "33fa3e72-63d6-407c-99a5-6cc55eadfd0f",
                        "source_entry_id": "ddf3cc15-584e-398d-8ab6-f74058efb4db",
                        "target_lang_word": "wither",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wither",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0820c591-8314-3459-906e-c6b986e400f5",
                                        "entry_id": "2c9ce448-d9b8-326e-9c49-6d28ff1d61b3",
                                        "glosses": [
                                            "To shrivel, droop or dry up, especially from lack of water."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9bf80912-ed58-49e3-8e5e-99929b05fe42",
                                                "sense_id": "0820c591-8314-3459-906e-c6b986e400f5",
                                                "text": "The flowers began to wither in the hot sun without enough water."
                                            },
                                            {
                                                "example_id": "a551e0ba-f74c-4628-b856-1312a19d9fa0",
                                                "sense_id": "0820c591-8314-3459-906e-c6b986e400f5",
                                                "text": "She watched as the old tree slowly withered with time."
                                            },
                                            {
                                                "example_id": "c7103117-abae-4ae0-b183-eeda7c488b4a",
                                                "sense_id": "0820c591-8314-3459-906e-c6b986e400f5",
                                                "text": "Without care, the crops will wither and fail to grow."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c14c4ae2-48c6-358c-b45e-3b496b311cb1",
                                        "entry_id": "2c9ce448-d9b8-326e-9c49-6d28ff1d61b3",
                                        "glosses": [
                                            "To cause to shrivel or dry up."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "52f9f5de-cc59-4e79-bc5a-51a2e76301c0",
                                                "sense_id": "c14c4ae2-48c6-358c-b45e-3b496b311cb1",
                                                "text": "There was a man which had his hand withered."
                                            },
                                            {
                                                "example_id": "4d7a726d-00dc-4ed4-a9b2-c37ab20adffd",
                                                "sense_id": "c14c4ae2-48c6-358c-b45e-3b496b311cb1",
                                                "text": "This is man, old, wrinkled, faded, withered."
                                            },
                                            {
                                                "example_id": "c6be6491-63eb-448f-86d5-c15dda36eaa0",
                                                "sense_id": "c14c4ae2-48c6-358c-b45e-3b496b311cb1",
                                                "text": "now warm in love, now with'ring in the grave"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "628ca72f-b868-324e-a349-69228b01f8f1",
                                        "entry_id": "2c9ce448-d9b8-326e-9c49-6d28ff1d61b3",
                                        "glosses": [
                                            "To lose vigour or power; to languish; to pass away."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b85206db-327f-425c-85b8-c02f5e632c90",
                                                "sense_id": "628ca72f-b868-324e-a349-69228b01f8f1",
                                                "text": "names that must not wither"
                                            },
                                            {
                                                "example_id": "fdb0b05a-f35a-4ae0-abe2-9aa3c97b8988",
                                                "sense_id": "628ca72f-b868-324e-a349-69228b01f8f1",
                                                "text": "States thrive or wither as moons wax and wane."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1b541c0-fe56-3d83-91b7-417edec19ee2",
                                        "entry_id": "2c9ce448-d9b8-326e-9c49-6d28ff1d61b3",
                                        "glosses": [
                                            "To become helpless due to emotion."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "145f10d7-c2d2-391c-b6a2-39ea8946bf7b",
                                        "entry_id": "2c9ce448-d9b8-326e-9c49-6d28ff1d61b3",
                                        "glosses": [
                                            "To make helpless due to emotion."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "wither",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "722de2c6-c114-370e-943d-b6fae7b705d5",
                                        "entry_id": "63671ca8-8505-39e0-8193-9e6475745778",
                                        "glosses": [
                                            "singular of withers (“part of the back of a four-legged animal that is between the shoulder blades”)"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e425a911-44b3-49de-980e-880f2abd36be",
                                                "sense_id": "722de2c6-c114-370e-943d-b6fae7b705d5",
                                                "text": "Timozel had slid his feet quickly from the stirrups and swung his leg over the horse's wither as it slumped to the ground, standing himself in one graceful movement."
                                            },
                                            {
                                                "example_id": "9d461310-c0e4-4db9-b33f-ea4f9c7a7156",
                                                "sense_id": "722de2c6-c114-370e-943d-b6fae7b705d5",
                                                "text": "If a saddle tips too far forward it may rest on the horse's wither and cause pain. There should always be a gap of roughly 5 cm between the horse's wither and the pommel when you are sitting on the saddle."
                                            }
                                        ]
                                    }
                                ]
                            },
