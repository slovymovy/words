                ],
                "senses": [
                    {
                        "sense_id": "efaccc78-2baf-3a45-8ef7-4993eb4077ff",
                        "entry_id": "75f6c689-31ff-38e4-9903-7377bf4b9bdb",
                        "glosses": [
                            "Gerät zur Bestimmung des vertikalen Abstandes (Höhe) eines Objekts zu einer definierten Ebene (meist Erdoberfläche)"
                        ],
                        "tags": [
                            "Geodäsie"
                        ],
                        "examples": [
                            {
                                "example_id": "90e15e35-57ad-416a-bc60-f71681f4d292",
                                "sense_id": "efaccc78-2baf-3a45-8ef7-4993eb4077ff",
                                "text": "„Neu sind auch ein Altimeter, welcher eine Messung von Höhenmetern in Echtzeit ermöglicht und ein Always-On-Display für besseren Überblick während des Trainings.“"
                            },
                            {
                                "example_id": "c578e4d6-77c2-43f8-aff8-5001e4aa09ad",
                                "sense_id": "efaccc78-2baf-3a45-8ef7-4993eb4077ff",
                                "text": "„Das führte zu einer Formel, die der Konstruktion des Altimeters zugrunde liegt, mit dem Piloten und Bergsteiger ihre Höhe über dem Meeresspiegel messen.“"
                            },
                            {
                                "example_id": "8c0a42b0-8585-4415-ad54-2e2b971b411f",
                                "sense_id": "efaccc78-2baf-3a45-8ef7-4993eb4077ff",
                                "text": "„Oliver musste hilflos mit ansehen, wie ihre Höhe auf dem Altimeter bedenklich heruntertickte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3e55a083-f996-46c7-bad3-0eeb1b012f9b",
                        "source_entry_id": "75f6c689-31ff-38e4-9903-7377bf4b9bdb",
                        "source_sense_id": "efaccc78-2baf-3a45-8ef7-4993eb4077ff",
                        "source_sense_description": "Gerät zur Bestimmung des vertikalen Abstandes (Höhe) eines Objekts zu einer definierten Ebene",
                        "target_lang_word": "altimeter",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "altimeter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "29055d43-31fc-3956-bbae-7f4896b490eb",
                                        "entry_id": "815a07f4-b986-33fa-9526-ca75eb0363b2",
                                        "glosses": [
                                            "An apparatus for measuring altitude."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d88e9ed9-294b-43cf-a55e-d49613bbe009",
                                                "sense_id": "29055d43-31fc-3956-bbae-7f4896b490eb",
                                                "text": "For that reason, if you do any mountain climbing, allow a generous margin of error of extra altitude—not only for possible altimeter error, but also for downdrafts that are particularly prevalent if high winds are encountered."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "83193d41-1a68-4890-91bb-abb1b036bf93",
                        "source_entry_id": "75f6c689-31ff-38e4-9903-7377bf4b9bdb",
                        "source_sense_id": "efaccc78-2baf-3a45-8ef7-4993eb4077ff",
                        "source_sense_description": "Gerät zur Bestimmung des vertikalen Abstandes (Höhe) eines Objekts zu einer definierten Ebene",
                        "target_lang_word": "altimètre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "altimètre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4540693e-9e96-30bc-94e7-dc66939dd5d9",
                                        "entry_id": "6c9d18e1-ddc2-3208-a5bc-3170e3be9395",
                                        "glosses": [
                                            "Dispositif servant à mesurer l’altitude."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b228ae6d-e339-45ef-97c5-c8e08462aef1",
                                                "sense_id": "4540693e-9e96-30bc-94e7-dc66939dd5d9",
                                                "text": "Mon altimètre s’est détraqué, je suis tantôt ludion, tantôt scaphandrier, souvent les deux ensemble comme il convient dans notre partie : j’habite en l’air par habitude et je fouine en bas sans trop d’espoir."
                                            },
                                            {
                                                "example_id": "cc565618-580a-41b7-bf10-8e91d0481002",
                                                "sense_id": "4540693e-9e96-30bc-94e7-dc66939dd5d9",
                                                "text": "Celui de gauche est un altimètre barométrique du même type que ceux que nous venons dʼévoquer."
                                            },
                                            {
                                                "example_id": "23393052-866f-4fc4-8bbe-69e25d844316",
                                                "sense_id": "4540693e-9e96-30bc-94e7-dc66939dd5d9",
                                                "text": "\"Les données de l'altimètre confirment qu'Ingenuity a effectué son premier vol, le premier vol d'un engin motorisé sur une autre planète\", a dit son pilote en chef, Havard Grip, la voix étranglée par l'émotion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "acdcb428-dc35-303b-8b5b-d774ecd7d030",
                                        "entry_id": "6c9d18e1-ddc2-3208-a5bc-3170e3be9395",
                                        "glosses": [
                                            "Appareil de mesure de la hauteur d’un objet distant."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
