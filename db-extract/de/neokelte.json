                "senses": [
                    {
                        "sense_id": "1523abcc-bd17-36ea-a578-0651477f124d",
                        "entry_id": "c6f85dc9-1d48-38da-b817-671df9aa8859",
                        "glosses": [
                            "Anhänger einer Weltanschauung, der sich auf keltische Traditionen, besonders auf die keltische Religion beruft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa21d6e3-dcf7-4f82-a0bd-9c783b695a58",
                                "sense_id": "1523abcc-bd17-36ea-a578-0651477f124d",
                                "text": "„Heutzutage sind es vor allem die Neukelten (oder Neokelten), die eine Wiederbelebung der keltischen Religion erreichen möchten.“"
                            },
                            {
                                "example_id": "e0caf57f-d5da-43d8-87ec-1bbe8cb413ea",
                                "sense_id": "1523abcc-bd17-36ea-a578-0651477f124d",
                                "text": "„Zu nennen sind hier die feministischen Hexenströmungen (Wicca-Gruppen), die Druiden oder Schamanen, Neokelten und die Neogermanen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
