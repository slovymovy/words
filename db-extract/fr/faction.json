                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b89a515-f31e-4d27-b9e2-08b47104e43d",
                                                "sense_id": "cdfb4838-396c-32d8-a3a0-7e6cad4288d9",
                                                "text": "Hij hield vanaf middernacht de wacht en werd om drie uur afgelost."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c2118da-b3d2-39c6-b199-6b3940a75593",
