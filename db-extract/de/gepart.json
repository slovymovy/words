                ],
                "senses": [
                    {
                        "sense_id": "cddbd227-6774-32d3-b3da-eb56ea21f392",
                        "entry_id": "093df26b-43af-385e-b413-82f907d192d4",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ea52f18-e2d9-4cc1-bbb9-08a90a477cd3",
                                "sense_id": "cddbd227-6774-32d3-b3da-eb56ea21f392",
                                "text": "Der Gepart trägt nie die Schals, die die Gepart ihm strickt."
                            },
                            {
                                "example_id": "c18ad8ec-2912-4723-9784-ccd858eced39",
                                "sense_id": "cddbd227-6774-32d3-b3da-eb56ea21f392",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Gepart kommt, geht der Herr Gepart.“"
                            },
                            {
                                "example_id": "098c731d-432c-4f2c-8106-99d67f0afd75",
                                "sense_id": "cddbd227-6774-32d3-b3da-eb56ea21f392",
                                "text": "Gepart kommt und geht."
                            },
                            {
                                "example_id": "8b3fb916-1c57-44a3-b8b5-ad6cce806c46",
                                "sense_id": "cddbd227-6774-32d3-b3da-eb56ea21f392",
                                "text": "Geparts kamen, sahen und siegten."
                            },
                            {
                                "example_id": "b589f14b-2e16-4521-ae86-4f8855169d8f",
                                "sense_id": "cddbd227-6774-32d3-b3da-eb56ea21f392",
                                "text": "Frau Gepart ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "77d66bf7-90c2-4f1a-8cf0-396ad22582d3",
                                "sense_id": "cddbd227-6774-32d3-b3da-eb56ea21f392",
                                "text": "Herr Gepart wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "ed249dfb-c8fd-475e-bfc4-6a24c823ee2d",
                                "sense_id": "cddbd227-6774-32d3-b3da-eb56ea21f392",
                                "text": "Die Geparts fliegen heute nach La Paz."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
