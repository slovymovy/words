                                                "sense_id": "179b5431-a40c-3493-a5e9-69efb8a018a8",
                                                "text": "He has insane aura."
                                            },
                                            {
                                                "example_id": "a3ebcf80-136f-463f-b56c-a76271d5d84c",
                                                "sense_id": "179b5431-a40c-3493-a5e9-69efb8a018a8",
                                                "text": "Tht Nigga [Adolf Hitler] has no aura He dress like a medieval Queer"
                                            },
