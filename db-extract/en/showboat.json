                ],
                "senses": [
                    {
                        "sense_id": "046a894f-309b-30b4-a9bb-14383ed28baa",
                        "entry_id": "095a4d4a-f40b-3bb5-9ee3-5cf5c631be56",
                        "glosses": [
                            "A river steamboat having a resident theatre."
                        ],
                        "tags": [
                            "US"
                        ],
                        "examples": [
                            {
                                "example_id": "60e1b035-d7ea-495c-983f-d396e2d35807",
                                "sense_id": "046a894f-309b-30b4-a9bb-14383ed28baa",
                                "text": "And Agnes Moorehead henpecks with stern persistence as Parthy, the captain's loving wife. The sets, which include a full-sized showboat with belching double stacks and sternwheel, are in the best Metro tradition, which means as sumptuous as sumptuous can be."
                            },
                            {
                                "example_id": "4c215fc9-1b45-4992-b6f2-9f2c18ad5ab3",
                                "sense_id": "046a894f-309b-30b4-a9bb-14383ed28baa",
                                "text": "Mr. Sterling was born in Baltimore on June 24, 1915, to Jack Sexton and Edna Cable, veteran performers in vaudeville, showboats and stock companies."
                            },
                            {
                                "example_id": "d47f3ee6-7c5b-4d9c-8e6d-3183d7c7fd98",
                                "sense_id": "046a894f-309b-30b4-a9bb-14383ed28baa",
                                "text": "Lowriding emerged in the 1950's in California, as Mexican-American youths -- in what may have been a reaction to the hot-rod culture dominated by whites -- transformed their cars into fantastical, ground-hugging showboats."
                            }
                        ]
                    },
                    {
                        "sense_id": "67e6dd8d-fc1d-373e-aa47-a86d58ff5677",
                        "entry_id": "095a4d4a-f40b-3bb5-9ee3-5cf5c631be56",
                        "glosses": [
                            "A showoff."
                        ],
                        "tags": [
                            "US",
                            "broadly",
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "1a62858b-52cb-4c01-b3ee-ea9f888d5cf2",
                                "sense_id": "67e6dd8d-fc1d-373e-aa47-a86d58ff5677",
                                "text": "Well, I was a little upset at first. I mean, obviously people are going to think I'm a showboat, and a little bit of a prick."
                            },
                            {
                                "example_id": "a1938816-6431-4590-b08e-48ba0ce3f514",
                                "sense_id": "67e6dd8d-fc1d-373e-aa47-a86d58ff5677",
                                "text": "After the President fired his FBI director in early May, he dismissed Comey as “a showboat,” “a grandstander” and a “nut job.”"
                            }
                        ]
                    }
                ],
