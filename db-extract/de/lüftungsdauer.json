                        "sense_id": "52db0f72-bae2-3732-8fe8-5addadcbfd30",
                        "entry_id": "838cbf9e-f522-33bb-8def-b25c880fcac9",
                        "glosses": [
                            "zeitliche Erstreckung der Lüftung von einem Raum oder Gebäude"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e669da6-7dea-4f63-b7b4-16b063ba863c",
                                "sense_id": "52db0f72-bae2-3732-8fe8-5addadcbfd30",
                                "text": "„Aus dem so ermittelten Lüftungspotential sowie dem Lüftungsbedarf wird die erforderliche Lüftungsdauer berechnet.“"
                            },
                            {
                                "example_id": "20381276-8bad-4fca-a041-b6becf2b18a3",
                                "sense_id": "52db0f72-bae2-3732-8fe8-5addadcbfd30",
                                "text": "„Die Lüftungsdauer richtet sich im Wesentlichen nach der Feuchteproduktion in den Räumen und nach der Außentemperatur; ca. zwei Minuten bei 0°C, ca. fünf Minuten bei 5 °C, zehn Minuten bei 10°C, ca. zehn Minuten bei 15°C. “"
                            },
                            {
                                "example_id": "ac5e99e1-ea48-4cf7-a5c7-b9c99dd37568",
                                "sense_id": "52db0f72-bae2-3732-8fe8-5addadcbfd30",
                                "text": "„Heizkörper während der Lüftungsdauer abdrehen!“"
                            },
                            {
                                "example_id": "2f1437d6-adde-48bb-afe6-69c4bc1b29d3",
                                "sense_id": "52db0f72-bae2-3732-8fe8-5addadcbfd30",
                                "text": "„In der einfachsten Form, der Stufe 0, wird nur die Lüftungsdauer überwacht.“"
                            },
                            {
                                "example_id": "9764f0b2-830f-4430-b6d5-91c993c07d95",
                                "sense_id": "52db0f72-bae2-3732-8fe8-5addadcbfd30",
                                "text": "„Aus dem so ermittelten Lüftungspotential sowie dem Lüftungsbedarf wird die erforderliche Lüftungsdauer berechnet.“"
                            }
