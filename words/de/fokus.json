                    "sense_definition": "Einstellung oder Ebene der optimalen Schärfe bei optischen Geräten wie Kameras",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "optik",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der Fotograf stellte den <w>Fokus</w> manuell auf das Gesicht der Schauspielerin ein."
                        },
                        {
                            "text": "Der Vordergrund ist unscharf, weil der <w>Fokus</w> ganz auf dem Hintergrund liegt."
                        }
                    ],
                    "common_phrases": [
                        "den Fokus einstellen",
                        "im Fokus liegen"
                    ]
                },
                {
