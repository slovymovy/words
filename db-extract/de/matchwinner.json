                "senses": [
                    {
                        "sense_id": "0d142c6b-b0d5-3445-9219-673d43b240cf",
                        "entry_id": "0f94d922-5d86-3eb0-9243-198cd6e66ffe",
                        "glosses": [
                            "Person in einer Mannschaftssportart, die in einem Spiel die spielentscheidende Aktion hat (beispielsweise ein Tor geschossen/einen Korb geworfen/einen Elfmeter gehalten hat) oder die über die gesamte Spielzeit oder sogar über ein Turnier herausragend für den Erfolg der Mannschaft war"
                        ],
                        "tags": [
                            "Plural selten"
                        ],
                        "examples": [
                            {
                                "example_id": "ba3f6394-3d04-4512-acd1-89a9bb3678ef",
                                "sense_id": "0d142c6b-b0d5-3445-9219-673d43b240cf",
                                "text": "[Fußball:] „Neymar polarisiert die Fußballwelt: Mal ist er Matchwinner, mal nach vermeintlichen oder wirklichen Fouls theatralischer Simulant.“"
                            },
                            {
                                "example_id": "a0604c04-b2c9-4bfe-96b3-fe4c62ed0ae6",
                                "sense_id": "0d142c6b-b0d5-3445-9219-673d43b240cf",
                                "text": "[Fußball:] „Auch im Duell mit dem niederländischen Erzrivalen avancierte Gómez als Doppeltorschütze zum Matchwinner.“"
                            },
                            {
                                "example_id": "3d661b0f-b2b4-45cb-a937-926479319bf6",
                                "sense_id": "0d142c6b-b0d5-3445-9219-673d43b240cf",
                                "text": "[Fußball:] „Matchwinner war Petr Čech, der die Elfmeter von Ryan Giggs und Patrice Evra halten konnte.“"
                            },
                            {
                                "example_id": "ce401410-96f7-4ae6-9c73-29eb4e36acd4",
                                "sense_id": "0d142c6b-b0d5-3445-9219-673d43b240cf",
                                "text": "[Schlagzeile:] „Matchwinner im Elfmeterschießen – Fortuna-Keeper Kastenmeier - \"Wenige emotionalere Momente im Leben\"“"
                            },
                            {
                                "example_id": "bf990965-374a-43a6-bf31-c1444001e9db",
                                "sense_id": "0d142c6b-b0d5-3445-9219-673d43b240cf",
                                "text": "[Handball:] „Nach dem Sieg gegen Spanien lagen sich Bundestrainer Alfred Gislason und Keeper Andreas Wolff, der sich mit 22 Paraden zum Matchwinner kürte, in den Armen.“"
                            },
                            {
                                "example_id": "62c83e8b-3c10-4955-9312-26f7bbc446ba",
                                "sense_id": "0d142c6b-b0d5-3445-9219-673d43b240cf",
                                "text": "[Schlagzeile:] „Basketball-WM – Matchwinner Schröder - \"Bin müde, aber sehr glücklich\"“"
                            },
                            {
                                "example_id": "abfbe56a-af25-4fa6-bb0b-e0df19cd9b08",
                                "sense_id": "0d142c6b-b0d5-3445-9219-673d43b240cf",
                                "text": "[Basketball:] „Gegen den VfL erzielte „Matchwinner“ Eddy Johnson in beiden Spielen insgesamt 54 Punkte.“"
                            },
                            {
                                "example_id": "00450d7e-1926-4ef9-b47b-f991cc750dc4",
                                "sense_id": "0d142c6b-b0d5-3445-9219-673d43b240cf",
                                "text": "[Basketball:] „Erst fünf Sekunden vor Spielende konnte Ernest „Ernie“ Butler, der US-amerikanische Spielmacher des MTV (später FC Bayern München) und mit acht Punkten „Matchwinner“, das spannende Spiel um die Meisterschaft mit einem „Jahrhundertwurf“ aus sehr großer Distanz entscheiden.“"
                            },
                            {
                                "example_id": "e362602e-d0f9-4608-96e4-124dd13aeb30",
                                "sense_id": "0d142c6b-b0d5-3445-9219-673d43b240cf",
                                "text": "[American Football:] „Matchwinner und MVP der siegreichen Mannschaft war jedoch nicht mehr Brett Favre, sondern Aaron Rodgers, der drei Touchdown-Pässe warf, sich keine Interception leistete und 24 Pässe auf nicht weniger als acht verschiedene Receiver verteilte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
