                "senses": [
                    {
                        "sense_id": "0990ce9d-7c8d-32b5-8312-e6804c49529a",
                        "entry_id": "7d381e0d-0a09-3af3-98ea-c61ec6042ff4",
                        "glosses": [
                            "Strategie, hauptsächlich auf Sparen zu setzen, um finanzielle Probleme in den Griff zu bekommen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10f69ab8-e6de-4a1c-8319-f4f79c0e792c",
                                "sense_id": "0990ce9d-7c8d-32b5-8312-e6804c49529a",
                                "text": "„Dass ein starrer Sparkurs nicht funktioniere, sagen auch Experten in Deutschland.“"
                            },
                            {
                                "example_id": "428ff8c4-9ac5-468c-840b-032f42522a8d",
                                "sense_id": "0990ce9d-7c8d-32b5-8312-e6804c49529a",
                                "text": "Im Jahr 2008 wurden Bremens kommunale Krankenhäuser auf Sparkurs gesetzt. Bis 2015 müssen die vier Kliniken Bremen Mitte, Nord, Ost und Links der Weser etwa 1000 Stellen einsparen […]."
                            },
                            {
                                "example_id": "d21ee3f0-79a4-4d50-ac85-1add5a95e070",
                                "sense_id": "0990ce9d-7c8d-32b5-8312-e6804c49529a",
                                "text": "Ihre Kinder [der US-amerikanischen Mittelschicht] finden wesentlich seltener den Weg zu Universitäten wie etwa Harvard. Die Ursache dieser Entwicklung liegt im Sparkurs des öffentlichen Bildungssystems."
                            },
                            {
                                "example_id": "1e16c701-ca34-412a-8dd4-1b7eed6a6c4a",
                                "sense_id": "0990ce9d-7c8d-32b5-8312-e6804c49529a",
                                "text": "Der konzertierte Sparkurs der europäischen Regierungen ist kollektiver wirtschaftlicher Selbstmord. Das sagt mit dem Nobelpreisträger Joseph Stiglitz nicht nur einer, der seine Worte stets mit Bedacht wählt; – dass diese Prognose tatsächlich eintritt, ist heute in Griechenland schmerzhaft zu beobachten …"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
