                    {
                        "sense_id": "22b44dc0-a4bb-35a5-8090-22af63117c9a",
                        "entry_id": "c480c2ad-9fab-3867-8c10-022aa14188df",
                        "glosses": [
                            "Obligated, especially financially."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "650b1629-7b81-4317-b5af-5bd2ef1872e5",
                                "sense_id": "22b44dc0-a4bb-35a5-8090-22af63117c9a",
                                "text": "One of China’s poorest and most indebted provinces has admitted defeat in trying to sort out its finances and is appealing to Beijing for help to avert default."
                            }
                        ]
                    },
                    {
                        "sense_id": "e9ff3c48-0558-34e4-9551-8accc35b2a4e",
                        "entry_id": "c480c2ad-9fab-3867-8c10-022aa14188df",
                        "glosses": [
                            "Owing gratitude for a service or favour."
                        ],
                        "tags": [
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "dc8c390a-26f6-4c45-9b28-e6b3f4b9c2ed",
                                "sense_id": "e9ff3c48-0558-34e4-9551-8accc35b2a4e",
                                "text": "We are indebted to an officer serving with the B.L.A. for sending us a copy of a fine coloured lithographed poster, reproduced above, which he found in the German Control Headquarters of the Belgian Railways in Brussels."
                            },
                            {
                                "example_id": "7f8d8d81-b4da-41c4-bb6d-62cf87529ac3",
                                "sense_id": "e9ff3c48-0558-34e4-9551-8accc35b2a4e",
                                "text": "And Ferguson was largely indebted to young keeper David de Gea, who has had his critics this season but made crucial saves to keep United in contention as they came under concerted pressure in the closing stages."
                            },
                            {
                                "example_id": "49d7c1aa-d682-46ba-945c-8e5f2b10f209",
                                "sense_id": "e9ff3c48-0558-34e4-9551-8accc35b2a4e",
                                "text": "[Chappell] Roan draws from the mega-pop of the 2010s, from Lady Gaga to Taylor Swift – then laces it with sexually frank asides and lavish doses of camp, and performs it with a maximalist, absurd aesthetic indebted to drag, John Waters and Freddie Mercury."
                            }
                        ]
                    }
