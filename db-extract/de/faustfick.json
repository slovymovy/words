                    {
                        "sense_id": "d674f5bd-4d5e-3cb9-9976-dd117c43d438",
                        "entry_id": "f70a7e81-5501-3d84-b91c-737eeaa2f608",
                        "glosses": [
                            "sexuelle Spielart, bei der zur Stimulation die Faust in Vagina oder Anus eingeführt wird"
                        ],
                        "tags": [
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "6c58c963-1229-4b3e-b39b-7db9a0495193",
                                "sense_id": "d674f5bd-4d5e-3cb9-9976-dd117c43d438",
                                "text": "„Und ein rotes Taschentuch in der hinteren Jeanstasche ist ein Stilmittel, das man nicht achtlos enseitzen sollte - es signalisiert, dass man schwul ist und auf Faustfick steht.“"
                            },
                            {
                                "example_id": "efbe0257-2e89-40b5-941a-74189c241848",
                                "sense_id": "d674f5bd-4d5e-3cb9-9976-dd117c43d438",
                                "text": "„Ficken und Arschlecken, Faustfick und Schwanzlutschen, alle Praktiken also, die ich für hypermaskulin hielt, weil …“"
                            },
                            {
                                "example_id": "6d642061-3ac6-4ee2-906b-ab7f21679532",
                                "sense_id": "d674f5bd-4d5e-3cb9-9976-dd117c43d438",
                                "text": "„Knutsch sich durch die Küsse und dem Faustfick von Angela zum Orgasmus.“"
                            },
                            {
                                "example_id": "7e86269f-9830-4af3-b068-340e07b9d838",
                                "sense_id": "d674f5bd-4d5e-3cb9-9976-dd117c43d438",
                                "text": "„Ein tödlicher Faustfick.“"
                            },
                            {
                                "example_id": "61b8f8cb-b57f-4c6f-9d8a-ee7798cbc07c",
                                "sense_id": "d674f5bd-4d5e-3cb9-9976-dd117c43d438",
                                "text": "„\"Tja, das ist ein Faustfick und ein Bad in brennendem Öl\" kommentierte Carlo.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
