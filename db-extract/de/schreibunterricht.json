                ],
                "senses": [
                    {
                        "sense_id": "35acd43e-a017-3ba7-bdb8-91e9a6be6e70",
                        "entry_id": "bd7fa315-eff9-3706-9117-bc5fbc1e7cf4",
                        "glosses": [
                            "Unterweisung mit dem Ziel, dass Schreibschüler das Schreiben erlernen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06ae972e-8416-44bd-9ef2-ed85e57ad2ad",
                                "sense_id": "35acd43e-a017-3ba7-bdb8-91e9a6be6e70",
                                "text": "„Denn jeder Unterricht ist zunächst und vor allem Schreibunterricht.“"
                            },
                            {
                                "example_id": "01f2a33d-ab6a-4e56-9e53-45125d9c9c91",
                                "sense_id": "35acd43e-a017-3ba7-bdb8-91e9a6be6e70",
                                "text": "„So konnte sich auch in Nordrhein-Westfalen der Schreibunterricht auf der Basis von »Lesen durch Schreiben« weithin durchsetzen.“"
                            },
                            {
                                "example_id": "2b762010-e251-48bd-a106-34828d2ab6e2",
                                "sense_id": "35acd43e-a017-3ba7-bdb8-91e9a6be6e70",
                                "text": "„Ein kleiner Ausstellungsbereich zum Thema Schreibunterricht ließ ahnen, wie bescheiden das Leben der Kinder an der Wohlfahrtsschule gewesen war.“"
                            },
                            {
                                "example_id": "f44d8fa9-4a3e-454b-9adb-71a2a5d576de",
                                "sense_id": "35acd43e-a017-3ba7-bdb8-91e9a6be6e70",
                                "text": "„Der Schreibunterricht verhalf vielen Frauen und Männern zu einem Ausdrucksvermögen in Wort und Schrift, das über das mechanische Ausfüllen vorgegebener Muster hinausging, insbesondere wenn sie selbst viel lasen und ihr Beruf mit viel Schreibarbeit verbunden war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
