{
    "word_family": [
        "hog"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ebfead56-9b96-39b9-aa01-effbb4217022",
                    "sense_definition": "The act of taking up too much of something so that others cannot use it.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "taking_too_much",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Stop <w>hogging</w> the remote control and let someone else choose a channel.",
                            "target_lang_translations": {
                                "cs": "Přestaň <w>zabírat</w> ovladač a nech vybrat kanál někoho jiného."
                            }
                        },
                        {
                            "text": "He is always <w>hogging</w> the bathroom every morning before school.",
                            "target_lang_translations": {
                                "cs": "Každé ráno před školou pořád <w>blokuje</w> koupelnu."
                            }
                        }
                    ],
                    "synonyms": [
                        "monopolizing"
                    ],
                    "common_phrases": [
                        "hogging the road",
                        "hogging the spotlight"
                    ],
                    "target_lang_definitions": {
                        "cs": "Jednání, při kterém si někdo přivlastňuje příliš mnoho něčeho na úkor ostatních."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "zabírání",
                                "target_lang_sense_clarification": "obecné přivlastňování si prostoru nebo věcí"
                            },
                            {
                                "target_lang_word": "blokování",
                                "target_lang_sense_clarification": "bránění ostatním v přístupu k něčemu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3f2ae7f8-d9ab-37af-91ef-a90afdbcd13c",
                    "sense_definition": "The act of making a rough cut to quickly remove material.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "cutting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The machinist started by <w>hogging</w> the metal to get it close to the final shape.",
                            "target_lang_translations": {
                                "cs": "Strojník začal <w>hrubováním</w> kovu, aby ho přiblížil konečnému tvaru."
                            }
                        },
                        {
                            "text": "This tool is designed for <w>hogging</w> away large amounts of wood in a short time.",
                            "target_lang_translations": {
                                "cs": "Tento nástroj je navržen pro <w>hrubování</w> velkého množství dřeva v krátkém čase."
