            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0266f0c2-e533-3ba3-850b-37ea6441c3cb",
                    "sense_definition": "Eerste persoon enkelvoud tegenwoordige tijd van <w>durven</w>",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>durf</w> niet alleen naar de kelder te gaan.",
                            "target_lang_translations": {
                                "ru": "Я не <w>осмеливаюсь</w> идти в подвал один.",
                                "en": "I do not <w>dare</w> to go to the basement alone.",
                                "de": "Ich <w>traue mich</w> nicht, alleine in den Keller zu gehen."
                            }
                        },
                        {
                            "text": "Eerlijk gezegd <w>durf</w> ik niet te vragen hoeveel dit kost.",
                            "target_lang_translations": {
                                "ru": "Честно говоря, я не <w>решаюсь</w> спросить, сколько это стоит.",
                                "en": "Honestly, I do not <w>dare</w> to ask how much this costs.",
                                "de": "Ehrlich gesagt <w>wage</w> ich es nicht zu fragen, wie viel das kostet."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ik durf te wedden",
                        "ik durf niet"
                    ],
                    "target_lang_definitions": {
                        "ru": "Первое лицо единственного числа настоящего времени глагола <w>durven</w> (сметь, отваживаться)",
                        "en": "First person singular present tense of <w>durven</w> (to dare)",
                        "de": "Erste Person Singular Präsens des Verbs <w>durven</w> (wagen, sich trauen)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "осмеливаюсь",
                                "target_lang_sense_clarification": "1-е лицо ед. ч."
