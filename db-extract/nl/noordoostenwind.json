                "senses": [
                    {
                        "sense_id": "035b70df-f7b2-32a2-9e0a-c5ce1348e302",
                        "entry_id": "b43d88a0-f418-3f20-9b58-9e01ae379f3e",
                        "glosses": [
                            "een wind die uit het noordoosten komt en naar het zuidwesten waait"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "efe3346b-fd52-4392-a7c4-a1498b747193",
                                "sense_id": "035b70df-f7b2-32a2-9e0a-c5ce1348e302",
                                "text": "In de eerste maanden van het nieuwe jaar woei onafgebroken een felle noordoostenwind, die pal op het raam van Quispels werkkamer stond."
                            },
                            {
                                "example_id": "fceeb7ea-d65f-43d9-ba41-da6660d648aa",
                                "sense_id": "035b70df-f7b2-32a2-9e0a-c5ce1348e302",
                                "text": "Overigens waren de temperaturen de laatste anderhalve week in grote delen van Europa nog veel extremer dan in Nederland. In Nederland maakte een noordoostenwind woensdag tijdelijk een eind aan de hitte, maar in bijvoorbeeld Duitsland, Frankrijk en de Alpenregio bleef de zuidenwind hete droge lucht uit de Sahara aanvoeren."
                            }
                        ]
                    }
