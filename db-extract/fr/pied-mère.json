                "senses": [
                    {
                        "sense_id": "4139b4fe-031e-3f94-984a-107af3fad852",
                        "entry_id": "a76be8ca-fcb0-380b-b8e7-21779508d082",
                        "glosses": [
                            "Plante adulte considérée par rapport à sa descendance."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5270a63b-7e98-4ad8-bef8-721d4e24b3b2",
                                "sense_id": "4139b4fe-031e-3f94-984a-107af3fad852",
                                "text": "Si la nature a été ingénieuse pour faciliter l’éloignement des graines de leur pied-mère, elle ne l’a pas été moins pour les placer dans les circonstances les plus favorables à leur germination."
                            }
                        ]
                    },
                    {
                        "sense_id": "cd19d7ea-0b24-336b-b43d-1b4804761e09",
                        "entry_id": "a76be8ca-fcb0-380b-b8e7-21779508d082",
                        "glosses": [
                            "Plante adulte dont on prélève des boutures ou rejets, pour en assurer la multiplication."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "defba611-5308-4e94-a319-1bd313a03b81",
                                "sense_id": "cd19d7ea-0b24-336b-b43d-1b4804761e09",
                                "text": "Elle a encore pour but de faire émettre plus aisément au pied-mère de nouveaux jets, que l’on marcotte l’année suivante de la même manière."
                            },
                            {
                                "example_id": "7b143490-c8f0-45b6-88d5-af95bbb6e810",
                                "sense_id": "cd19d7ea-0b24-336b-b43d-1b4804761e09",
                                "text": "Sur chaque pied-mère, on laisse deux ou trois œilletons pour la production des pommes d’Artichauts ; les autres sont détachés avec un talon ou portion de pied-mère, portant quelques radicelles."
                            },
                            {
                                "example_id": "b42c396d-21b8-4314-9593-21aadd0ee84a",
                                "sense_id": "cd19d7ea-0b24-336b-b43d-1b4804761e09",
                                "text": "Le framboisier est une plante particulièrement généreuse en rejets, également appelés drageons. Ces petites pousses émergent des racines du pied-mère et peuvent facilement devenir de nouveaux plants robustes, si elles sont manipulées avec soin."
                            }
                        ]
                    }
