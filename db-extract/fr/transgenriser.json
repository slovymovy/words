                "senses": [
                    {
                        "sense_id": "5451692f-46b4-3f8c-b9f6-b95d09004b61",
                        "entry_id": "e3504f67-fd30-3eb7-9636-164658331c15",
                        "glosses": [
                            "Donner un caractère transgenre à."
                        ],
                        "tags": [
                            "Transitude"
                        ],
                        "examples": [
                            {
                                "example_id": "0b5f62a6-6fb9-4dc5-a527-2cbdfc1c4cc8",
                                "sense_id": "5451692f-46b4-3f8c-b9f6-b95d09004b61",
                                "text": "On ne constate aujourd’hui aucune protestation du mouvement queer face à la pratique de transgenriser des enfants sur la base de normes de genre si brutales qu’elles arrivent à légitimer une intervention chimique sur des organismes prépubères."
                            },
                            {
                                "example_id": "25a196d9-9987-4ff6-9d0a-22c7dc142383",
                                "sense_id": "5451692f-46b4-3f8c-b9f6-b95d09004b61",
                                "text": "Publication de la vidéo avec les chants \"Yaahaalala yalalaaa alahamiralackbar\" et drapeau noir en fond, où tu expliques qu'Allah a puni les koufars mécréants en transgenrisant leurs enfants."
                            },
                            {
                                "example_id": "3bf165df-e74d-4930-807e-fbbb90a5ac6c",
                                "sense_id": "5451692f-46b4-3f8c-b9f6-b95d09004b61",
                                "text": "Par facilité, les marques ont transgenrisé leurs montres, collant un coup de rimmel et de nacre rose sur des modèles historiquement masculins."
                            }
                        ]
                    }
                ],
