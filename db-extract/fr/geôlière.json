                                        "entry_id": "3d2b3262-fde4-3f2f-8f18-990c41cf29f1",
                                        "glosses": [
                                            "Dated spelling of jaileress."
                                        ],
                                        "tags": [
                                            "Commonwealth"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8cbcd560-b031-4d95-bea7-93fb0f0d368d",
                                                "sense_id": "3a3ab4db-8d7c-329f-b684-632d68cd5e0d",
                                                "text": "[Y]esterday my saucy gaoleress assured me, that all my oppositions would not signify that pinch of snuff, holding out her genteel finger and thumb […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "90ffc4c4-1366-4797-973a-9249255e6bfe",
                        "source_entry_id": "7738845c-f86a-37ac-9854-f18af86efea6",
                        "target_lang_word": "jaileress",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jaileress",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cf2d31a8-be7a-37ac-b1e0-a10936b8d96f",
                                        "entry_id": "09cc9e65-e446-3046-b86c-d00c2e2f678d",
                                        "glosses": [
                                            "A female jailer."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8792439f-c417-4021-a7a3-8584d6f0fb56",
                                                "sense_id": "cf2d31a8-be7a-37ac-b1e0-a10936b8d96f",
                                                "text": "Sit down here, and let me cover you with my cloak, and we will eat the supper our good jaileresses have provided; we have had nothing since daybreak."
                                            },
                                            {
                                                "example_id": "fb73b4ab-563f-4c68-ad09-b3d51bc9604e",
                                                "sense_id": "cf2d31a8-be7a-37ac-b1e0-a10936b8d96f",
                                                "text": "As I got near to the avenue gate, instead of the school on my left there was a prison ; and at the door a little thick -set jailer, three feet high and much deformed, and a little deformed jaileress no bigger than himself, were cunningly watching me out of the corners of their eyes, and toothlessly smiling."
                                            },
                                            {
                                                "example_id": "c7cb4dc4-004f-458b-a0ac-88a5fd1735e9",
                                                "sense_id": "cf2d31a8-be7a-37ac-b1e0-a10936b8d96f",
                                                "text": "As she finished these words, Simon, who was then coming up, heard them, and saw the jaileress place in her pocket the money Maurice had given her."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
