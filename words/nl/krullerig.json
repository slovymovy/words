            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "7d583144-e358-3e2a-8585-d665a6eb4004",
                    "sense_definition": "met natuurlijke krullen of bochten, vaak gebruikt om haar te beschrijven",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "uiterlijk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het kleine meisje heeft prachtig <w>krullerig</w> haar dat altijd in de war zit.",
                            "target_lang_translations": {
                                "en": "The little girl has beautiful <w>curly</w> hair that is always tangled."
                            }
                        },
                        {
                            "text": "Zij heeft van zichzelf een <w>krullerig</w> kapsel dat weinig verzorging nodig heeft.",
                            "target_lang_translations": {
                                "en": "She naturally has a <w>curly</w> hairstyle that requires little maintenance."
                            }
                        }
                    ],
                    "synonyms": [
                        "krullig",
                        "gekruld"
                    ],
                    "antonyms": [
                        "steil"
                    ],
                    "common_phrases": [
                        "krullerig haar",
                        "krullerig kapsel"
                    ],
                    "target_lang_definitions": {
                        "en": "having natural curls or curves, often used to describe hair"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "curly",
                                "target_lang_sense_clarification": "referring to hair or fibers"
                            },
                            {
                                "target_lang_word": "curled",
                                "target_lang_sense_clarification": "having a curled shape"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9118e127-4561-3c00-a586-bd434e584735",
                    "sense_definition": "voorzien van veel bochten, krullen en sierlijke gebogen vormen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vormgeving",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De rococo wordt gekenmerkt door de vele <w>krullerige</w> versiersels op de muren.",
                            "target_lang_translations": {
                                "en": "Rococo is characterized by the many <w>curly</w> decorations on the walls."
                            }
                        },
                        {
                            "text": "Hij schreef zijn naam met een <w>krullerig</w> handschrift dat moeilijk te lezen was.",
                            "target_lang_translations": {
                                "en": "He wrote his name in a <w>curly</w> handwriting that was difficult to read."
                            }
                        }
                    ],
