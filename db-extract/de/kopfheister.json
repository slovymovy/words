                "senses": [
                    {
                        "sense_id": "7d01c25c-74e5-39b2-84ce-cc8f1012505f",
                        "entry_id": "13df0bcd-6dba-3325-9fcd-93161e7341a4",
                        "glosses": [
                            "mit dem Kopf nach unten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c101a95-e97f-42a1-a9ed-635f167c5661",
                                "sense_id": "7d01c25c-74e5-39b2-84ce-cc8f1012505f",
                                "text": "„Wie zum Beispiel in den ‚Lebens-Ansichten des Katers Murr‘, wo er das berühmte, vom Fürsten gegebene Fest beschreibt, der »Les Fêtes de Versailles« gelesen hat und daraus Anregung schöpft, indem er sie wegen der beschränkten Mittel ein wenig abändert: die Puppe, die einen Genius darstellt und eine Fackel trägt, erweist sich als zu schwer, kippt um und gleitet kopfheister an dem Seil entlang, während das brennende Wachs in schmerzhaften Tropfen auf die verblüfften Zuschauer herabträuft, die sich nicht zu beklagen wagen, außer einem dickleibigen General, der einen Satz macht und mit dem Ausruf »Alle Teufel!« in das Seilwerk des Genius stürzt, der inmitten eines unglaublichen Durcheinanders am Boden zerschellt.“"
                            },
                            {
                                "example_id": "4ac77f74-472f-4801-bc1b-f86fed4b2134",
                                "sense_id": "7d01c25c-74e5-39b2-84ce-cc8f1012505f",
                                "text": "„Weil sich Schwester Helena (Jasmin Tabatabai), angeblich beim Ballett in Berlin, nicht rührt, reist Maria nach Deutschland, um kopfheister im Laster zu landen.“"
                            },
                            {
                                "example_id": "4b97100e-6cde-42f6-93de-714f6eab2193",
                                "sense_id": "7d01c25c-74e5-39b2-84ce-cc8f1012505f",
                                "text": "„Das große Kinozelt wäre ebenfalls kopfheister gegangen, wenn nicht 17 Leute mit Hilfe von Stangen sich stundenlang abgemüht hätten, es zu stützen.“"
                            },
                            {
                                "example_id": "ce0b44d4-49b7-4b35-97b9-ff3e905001a8",
                                "sense_id": "7d01c25c-74e5-39b2-84ce-cc8f1012505f",
                                "text": "„Erst springt er ihn an, wie der Löwe ein Schaf, als wolle er ihn gleich beim ersten Anlauf kopfheister werfen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
