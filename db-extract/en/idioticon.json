                                            {
                                                "example_id": "bda9ff8d-56c1-408f-880f-a05ca119a0f1",
                                                "sense_id": "302e948e-91a2-3bcf-b32a-d46edd42f3d0",
                                                "text": "Im Dialektwörterbuch kann man den regionalen Wortschatz nachschlagen."
                                            },
                                            {
                                                "example_id": "204e061a-e9b2-47ea-999f-fafd6ba83d92",
                                                "sense_id": "302e948e-91a2-3bcf-b32a-d46edd42f3d0",
                                                "text": "„Eine besondere Stellung unter den modernen neuniederdeutschen Dialektwörterbüchern kommt dem stark geschichtlich ausgerichteten Hamburgischen Wörterbuch zu;…“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "28bdc8e5-a9f1-4562-8ffd-915b8e72dd3f",
                        "source_entry_id": "fc0eea17-5bed-37b1-9c26-e1d1ba6d3bee",
                        "source_sense_id": "88fea120-4783-3212-a364-345130b007b2",
