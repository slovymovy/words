                                "example_id": "52b3b978-0d73-4558-ab75-f4985e978808",
                                "sense_id": "166a91e3-8902-3948-b027-a31408de51f8",
                                "text": "Le saint-estèphe se distingue par sa couleur intense, presque sombre, avec une dominante rubis et une frange pourpre, signes de jeunesse."
                            },
                            {
                                "example_id": "1a2dac8e-890d-45ed-8ba7-cfc27f7a7f86",
                                "sense_id": "166a91e3-8902-3948-b027-a31408de51f8",
                                "text": "— Ne m’avez-vous pas dit, continua Sainte-Austreberthe désignant la bouteille, que le Saint-Estèphe était le meilleur de vos vins comme tonique et réconfortant ?"
                            }
                        ]
