                "senses": [
                    {
                        "sense_id": "b0dbb2d8-c645-3614-a321-b2de3c984008",
                        "entry_id": "8971edc3-9409-3f9d-8b03-d97aa97fc98c",
                        "glosses": [
                            "Maladie fongique des céréales, causée par des champignons du genre Fusarium provoquant des lésions à la base des tiges, et des moisissures des épis."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12559aee-33bc-4048-adaf-4b0debba2e84",
                                "sense_id": "b0dbb2d8-c645-3614-a321-b2de3c984008",
                                "text": "La fusariose de l’épi est une maladie des céréales qui touche surtout le maïs et le blé."
                            },
                            {
                                "example_id": "ffc544a2-18ea-4706-ad17-29caac422815",
                                "sense_id": "b0dbb2d8-c645-3614-a321-b2de3c984008",
                                "text": "L'infection par Gibberella, appelée fusariose de la tige, se manifeste par les tissus de la mœlle de la tige qui deviennent filamenteux et prennent une coloration allant du rose au rouge."
                            }
                        ]
                    },
                    {
                        "sense_id": "cbed1ef0-5cb4-36e7-b6af-1d0fa1a48df3",
                        "entry_id": "8971edc3-9409-3f9d-8b03-d97aa97fc98c",
                        "glosses": [
                            "Maladie fongique de la pomme de terre, causée par des champignons du genre Fusarium provoquant la pourriture sèche des tubercules."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd854f48-606f-4de1-ae91-987ef227230c",
                                "sense_id": "cbed1ef0-5cb4-36e7-b6af-1d0fa1a48df3",
                                "text": "Fusariose : pourriture sèche, le tubercule se couvre d’un mycélium blanc."
                            }
                        ]
                    }
                ],
