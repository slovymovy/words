                "senses": [
                    {
                        "sense_id": "b2029066-4d05-3121-9f5c-6e8d50fd2850",
                        "entry_id": "41d82334-0a99-3f2e-a9f7-b91018507cba",
                        "glosses": [
                            "干擾素"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f094b98-5418-4c4b-a868-9c74fa561b1c",
                                "sense_id": "b2029066-4d05-3121-9f5c-6e8d50fd2850",
                                "text": "interferon alfa",
                                "translation": "干擾素-α"
                            },
                            {
                                "example_id": "e7052380-18f9-4f4f-8e36-7d94c7ef81c0",
                                "sense_id": "b2029066-4d05-3121-9f5c-6e8d50fd2850",
                                "text": "Działanie immunosupresyjne glikokortykosteroidów wiąże się m.in. z hamowaniem uwalniania interleukin IL-1, IL-2, IL-3, IL-4, IL-6, czynnika nekrozy nowotworu (TNF-a), interferonu g.",
                                "translation": "糖皮质激素的免疫抑制作用与抑制白细胞介素 IL-1、IL-2、IL-3、IL-4、IL-6、肿瘤坏死因子 (TNF-α) 和干扰素γ的释放有关。"
                            },
                            {
                                "example_id": "88d70eef-de59-4452-bc7f-8efd344ee2c5",
                                "sense_id": "b2029066-4d05-3121-9f5c-6e8d50fd2850",
                                "text": "Do walki wkraczają przeciwciała, limfocyty, i interferony, mające zdolność hamowania replikacji (namnażania) wirusów.",
                                "translation": "能够抑制病毒的复制（繁殖）的抗体、淋巴细胞干扰素，也加入了这场战斗。"
                            },
                            {
                                "example_id": "31419f3a-5e51-46e5-b5e2-9dfa36098220",
                                "sense_id": "b2029066-4d05-3121-9f5c-6e8d50fd2850",
                                "text": "Stymulowane interferonem makrofagi nie tylko skuteczniej fagocytują mikroorganizmy, ale przede wszystkim stają się cytotoksyczne wobec, na przykład, komórek nowotworowych.",
                                "translation": "干扰素刺激的巨噬细胞不仅能更有效地吞噬微生物，而且最重要的是，它们会对癌细胞等产生细胞毒性。"
                            }
                        ]
                    }
                ],
