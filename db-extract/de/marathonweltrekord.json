                "senses": [
                    {
                        "sense_id": "cdbc328c-741d-34c9-b0ba-de35de55a9c6",
                        "entry_id": "7cc4fd05-945c-3a91-ad7b-b0f1abc2c49f",
                        "glosses": [
                            "die schnellste offiziell anerkannte Zeit auf der Marathondistanz weltweit"
                        ],
                        "tags": [
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "d9c17b5b-421e-4c2b-a423-8c5148ab54fb",
                                "sense_id": "cdbc328c-741d-34c9-b0ba-de35de55a9c6",
                                "text": "„Die Britin brachte den Marathonweltrekord der Frauen mit 2:15:25 Stunden in eine neue Dimension.“"
                            },
                            {
                                "example_id": "bb9c8e14-c806-400d-a9da-1311a14fa448",
                                "sense_id": "cdbc328c-741d-34c9-b0ba-de35de55a9c6",
                                "text": "„So lief 6 Monate nach seinem 35. Geburtstag Haile Gebrselassie (ETH) einen Marathonweltrekord in 2:03:59 h in Berlin.“"
                            },
                            {
                                "example_id": "75528cf8-724b-4b42-a76c-004328f47b85",
                                "sense_id": "cdbc328c-741d-34c9-b0ba-de35de55a9c6",
                                "text": "„Immerhin kann ich stolz darauf hinweisen, dass die letzten sieben Marathonweltrekorde alle nur dank meiner \"Verfolgungsarbeit\" in Berlin zustande gekommen sind.“"
                            },
                            {
                                "example_id": "cc8d963f-34c4-44e1-97e4-c0e1bc5cf1f6",
                                "sense_id": "cdbc328c-741d-34c9-b0ba-de35de55a9c6",
                                "text": "„Kurzum war es kein offizieller Marathonweltrekord, aber Eilud Kipchoge ist der erste Mensch der die Distanz von 42.195 KM in unter 2 Stunden absolviert hat.“"
                            },
                            {
                                "example_id": "05904d28-0fc3-48a4-a57b-b2e5dfad5007",
                                "sense_id": "cdbc328c-741d-34c9-b0ba-de35de55a9c6",
                                "text": "„Dass an diesem Tag der Marathonweltrekord um über eine Minute eingestellt wurde, war bei den idealen Wetterbedingungen (fast) zu erwarten gewesen.“"
                            },
                            {
                                "example_id": "95db44d6-bdde-46be-a059-7ffeb3b5a5ce",
                                "sense_id": "cdbc328c-741d-34c9-b0ba-de35de55a9c6",
                                "text": "„Was passiert, wenn Durchschnittsbürger versuchen, das Tempo des Marathonweltrekords auf einem Laufband zu halten?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
