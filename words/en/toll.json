{
    "word_family": [
        "tollbooth",
        "tollgate",
        "tollbar",
        "tollway",
        "tollkeeper",
        "tollhouse"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "afffbcaa-3d91-3938-b84b-79f8c2a6aae8",
                    "sense_definition": "A fee paid for the use of a road, bridge, or other infrastructure, or for a specific privilege.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "fee_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Drivers must pay a <w>toll</w> to cross the new bridge.",
                            "target_lang_translations": {
                                "ru": "Водители должны заплатить <w>пошлину</w> за проезд по новому мосту.",
                                "tr": "Sürücüler yeni köprüden geçmek için bir <w>geçiş ücreti</w> ödemelidir.",
                                "zh": "司机过新桥必须支付<w>通行费</w>。"
                            }
                        },
                        {
                            "text": "We avoided the highway to save money on the <w>toll</w>.",
                            "target_lang_translations": {
                                "ru": "Мы объехали шоссе, чтобы сэкономить на <w>дорожном сборе</w>.",
                                "tr": "Otoyoldaki <w>geçiş ücretinden</w> tasarruf etmek için otoyoldan kaçındık.",
                                "zh": "我们避开了高速公路，以节省<w>过路费</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "pay a toll",
                        "toll road",
                        "toll bridge",
                        "toll booth"
                    ],
                    "target_lang_definitions": {
                        "ru": "Плата за проезд по дороге, мосту или за использование другой инфраструктуры.",
                        "tr": "Bir yol, köprü veya diğer altyapıların kullanımı veya belirli bir ayrıcalık için ödenen ücret.",
                        "zh": "指使用道路、桥梁或其他基础设施，或为了获得某种特权而支付的费用。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пошлина",
                                "target_lang_sense_clarification": "государственный денежный сбор"
                            },
                            {
                                "target_lang_word": "сбор",
                                "target_lang_sense_clarification": "платеж за право пользования чем-либо"
                            },
                            {
                                "target_lang_word": "плата",
                                "target_lang_sense_clarification": "денежное возмещение за услугу"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "geçiş ücreti",
                                "target_lang_sense_clarification": "yol veya köprü kullanımı için ödenen bedel"
                            },
                            {
                                "target_lang_word": "harç",
                                "target_lang_sense_clarification": "bir hizmet karşılığında ödenen resmi bedel"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "通行费",
                                "target_lang_sense_clarification": "通过道路或桥梁时支付的费用"
                            },
                            {
                                "target_lang_word": "过路费",
                                "target_lang_sense_clarification": "车辆通过收费公路或桥梁的费用"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1c7f8411-2528-3a15-8b67-a0fcadce787d",
                    "sense_definition": "The extent of loss, damage, suffering, or number of deaths resulting from a disaster or conflict.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The war has taken a heavy <w>toll</w> on the civilian population.",
                            "target_lang_translations": {
                                "ru": "Война нанесла тяжелый <w>ущерб</w> гражданскому населению.",
                                "tr": "Savaş, sivil halk üzerinde ağır bir <w>yıkıma</w> yol açtı.",
                                "zh": "战争给平民百姓造成了沉重的<w>代价</w>。"
                            }
                        },
                        {
                            "text": "Officials are trying to determine the death <w>toll</w> from the earthquake.",
                            "target_lang_translations": {
                                "ru": "Чиновники пытаются установить число <w>жертв</w> землетрясения.",
                                "tr": "Yetkililer depremdeki <w>can kaybı</w> sayısını belirlemeye çalışıyor.",
                                "zh": "官员们正试图确定地震造成的<w>死亡人数</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "take a toll",
                        "death toll",
                        "heavy toll"
                    ],
                    "target_lang_definitions": {
                        "ru": "Количество жертв, степень ущерба или потерь в результате бедствия или конфликта.",
                        "tr": "Bir felaket veya çatışma sonucunda meydana gelen kayıp, hasar, acı veya ölüm sayısı.",
                        "zh": "指灾难或冲突造成的损失、伤害程度或死亡人数。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "потери",
                                "target_lang_sense_clarification": "утрата людей или ресурсов"
                            },
                            {
                                "target_lang_word": "жертвы",
                                "target_lang_sense_clarification": "погибшие или пострадавшие люди"
                            },
                            {
                                "target_lang_word": "ущерб",
                                "target_lang_sense_clarification": "вред, нанесенный чему-либо"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "kayıp",
                                "target_lang_sense_clarification": "bir olay sonucu verilen zayiat"
                            },
                            {
                                "target_lang_word": "hasar",
                                "target_lang_sense_clarification": "bir felaketin yol açtığı yıkım"
                            },
                            {
                                "target_lang_word": "can kaybı",
                                "target_lang_sense_clarification": "ölüm sayısı bağlamında"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "伤亡人数",
                                "target_lang_sense_clarification": "指灾难或战争中死亡或受伤的人数"
                            },
                            {
                                "target_lang_word": "代价",
                                "target_lang_sense_clarification": "指某种行为或事件造成的严重后果或损失"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0007c8ac-d88c-3b9f-a24b-89bdea038ed2",
                    "sense_definition": "The sound of a bell ringing slowly and regularly.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "bell_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We heard the mournful <w>toll</w> of the church bell in the distance.",
                            "target_lang_translations": {
                                "ru": "Мы слышали скорбный <w>звон</w> церковного колокола вдалеке.",
                                "tr": "Uzaktan gelen kederli kilise çanı <w>sesini</w> duyduk.",
                                "zh": "我们听到了远处教堂传来的悲伤的<w>钟声</w>。"
                            }
                        },
                        {
                            "text": "The single <w>toll</w> marked the beginning of the silence.",
                            "target_lang_translations": {
                                "ru": "Одиночный <w>удар</w> колокола ознаменовал начало минуты молчания.",
                                "tr": "Tek bir çan <w>vuruşu</w> sessizliğin başlangıcını işaret etti.",
                                "zh": "那一声<w>钟响</w>标志着默哀的开始。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Медленный и размеренный звук колокола.",
                        "tr": "Bir çanın yavaş ve düzenli bir şekilde çalma sesi.",
                        "zh": "指钟声缓慢而有规律的敲击声。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "звон",
                                "target_lang_sense_clarification": "звучание колокола"
                            },
                            {
                                "target_lang_word": "благовест",
                                "target_lang_sense_clarification": "церковный звон перед службой"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "çan sesi",
                                "target_lang_sense_clarification": "çanın çıkardığı genel ses"
                            },
                            {
                                "target_lang_word": "çan çalma",
                                "target_lang_sense_clarification": "çanın ritmik vuruşu"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "钟声",
                                "target_lang_sense_clarification": "钟敲击发出的声音"
                            },
                            {
                                "target_lang_word": "丧钟",
                                "target_lang_sense_clarification": "为哀悼死者而敲响的钟声"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "938fa58b-09b2-3231-9497-a8eed4150124",
                    "sense_definition": "To ring a bell slowly and repeatedly, often to announce a death or funeral.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "bell_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The church bells <w>tolled</w> throughout the valley to mark the hour.",
                            "target_lang_translations": {
                                "ru": "Церковные колокола <w>звонили</w> по всей долине, отмечая час.",
                                "tr": "Kilise çanları saati belirtmek için vadi boyunca <w>çaldı</w>.",
                                "zh": "教堂的钟声在山谷中回荡，以报时。"
                            }
                        },
                        {
                            "text": "They <w>tolled</w> the bell solemnly as the procession passed by.",
                            "target_lang_translations": {
                                "ru": "Они торжественно <w>били</w> в колокол, когда процессия проходила мимо.",
                                "tr": "Alay geçerken çanı ciddiyetle <w>çaldılar</w>.",
                                "zh": "当送葬队伍经过时，他们庄重地<w>敲响</w>了钟。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "toll the bell",
                        "for whom the bell tolls"
                    ],
                    "target_lang_definitions": {
                        "ru": "Звонить в колокол медленно и многократно, часто возвещая о смерти или похоронах.",
                        "tr": "Genellikle bir ölümü veya cenazeyi duyurmak için bir çanı yavaş ve tekrarlı bir şekilde çalmak.",
                        "zh": "指缓慢且反复地敲钟，通常用于宣告死亡或举行葬礼。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "звонить",
                                "target_lang_sense_clarification": "издавать звуки с помощью колокола"
                            },
                            {
                                "target_lang_word": "бить",
                                "target_lang_sense_clarification": "ударять в колокол"
                            },
                            {
                                "target_lang_word": "благовестить",
                                "target_lang_sense_clarification": "звонить к церковной службе"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "çan çalmak",
                                "target_lang_sense_clarification": "ritmik olarak çan sesi çıkarmak"
                            },
                            {
                                "target_lang_word": "çan vurmak",
                                "target_lang_sense_clarification": "çana tokmakla vurarak ses çıkarmak"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "敲钟",
                                "target_lang_sense_clarification": "敲击钟发出声音"
                            },
                            {
                                "target_lang_word": "鸣钟",
                                "target_lang_sense_clarification": "正式地敲响钟声"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8ac2a33f-3010-3aca-b7ce-bd358329bb53",
                    "sense_definition": "To charge a fee for the use of a bridge, road, or service.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "fee_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The city council plans to <w>toll</w> the new highway to recover construction costs.",
                            "target_lang_translations": {
                                "ru": "Городской совет планирует <w>обложить сбором</w> новое шоссе, чтобы окупить затраты на строительство.",
                                "tr": "Belediye meclisi, inşaat maliyetlerini karşılamak için yeni otoyolu <w>ücretli yapmayı</w> planlıyor.",
                                "zh": "市议会计划对新高速公路<w>收费</w>，以收回建设成本。"
                            }
                        },
                        {
                            "text": "Commuters are unhappy that the bridge will be <w>tolled</w> starting next month.",
                            "target_lang_translations": {
                                "ru": "Пассажиры недовольны тем, что мост станет <w>платным</w> со следующего месяца.",
                                "tr": "İşe gidip gelenler, köprünün gelecek aydan itibaren <w>ücretli olmasından</w> mutsuz.",
                                "zh": "通勤者们对下个月起该桥将开始<w>收费</w>感到不满。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Взимать плату за пользование мостом, дорогой или услугой.",
                        "tr": "Bir köprü, yol veya hizmetin kullanımı için ücret talep etmek.",
                        "zh": "指对使用桥梁、道路或服务收取费用。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "взимать плату",
                                "target_lang_sense_clarification": "брать деньги за услугу"
                            },
                            {
                                "target_lang_word": "облагать сбором",
                                "target_lang_sense_clarification": "назначать обязательный платеж"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "ücretli yapmak",
                                "target_lang_sense_clarification": "bir yolu veya köprüyü geçiş ücretine tabi tutmak"
                            },
                            {
                                "target_lang_word": "geçiş ücreti almak",
                                "target_lang_sense_clarification": "kullanım karşılığı para talep etmek"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "收费",
                                "target_lang_sense_clarification": "对某项服务或设施的使用收取费用"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "809d4e80-c2b7-3556-a7ea-cb531528d5e6",
                    "sense_definition": "To suspend or pause the running of a time period, particularly a statute of limitations in law.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The statute of limitations was <w>tolled</w> while the defendant was out of the country.",
                            "target_lang_translations": {
                                "ru": "Срок исковой давности был <w>приостановлен</w>, пока ответчик находился за границей.",
                                "tr": "Sanık yurt dışındayken zamanaşımı süresi <w>durduruldu</w>.",
                                "zh": "当被告在国外时，诉讼时效被<w>中止</w>了。"
                            }
                        },
                        {
                            "text": "Filing the lawsuit effectively <w>tolled</w> the deadline for the claim.",
                            "target_lang_translations": {
                                "ru": "Подача иска фактически <w>приостановила</w> истечение срока для предъявления претензии.",
                                "tr": "Dava açmak, talep için son başvuru tarihini fiilen <w>askıya aldı</w>.",
                                "zh": "提起诉讼有效地<w>中止</w>了索赔的最后期限。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "toll the statute"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "technical (legal)"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Приостанавливать течение юридического срока, в частности срока исковой давности.",
                        "tr": "Hukukta, özellikle zamanaşımı süresi gibi bir zaman diliminin işleyişini askıya almak veya durdurmak.",
                        "zh": "指暂停或中止某段时间的计算，特别是在法律中指诉讼时效。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приостанавливать",
                                "target_lang_sense_clarification": "временно прекращать течение срока"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "durdurmak",
                                "target_lang_sense_clarification": "hukuki sürenin akışını kesmek"
                            },
                            {
                                "target_lang_word": "askıya almak",
                                "target_lang_sense_clarification": "yasal bir süreyi geçici olarak durdurmak"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "中止",
                                "target_lang_sense_clarification": "法律上指暂时停止时效的计算"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8e649704-37e5-32d4-8351-0e104fb575a7",
                    "sense_definition": "To lure or entice animals or fish, often by using bait.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hunter tried to <w>toll</w> the deer into the open clearing.",
                            "target_lang_translations": {
                                "ru": "Охотник пытался <w>выманить</w> оленя на открытую поляну.",
                                "tr": "Avcı, geyiği açık alana <w>cezbetmeye</w> çalıştı.",
                                "zh": "猎人试图将鹿<w>引诱</w>到开阔的空地上。"
                            }
                        },
                        {
                            "text": "They used scattered food to <w>toll</w> the birds closer to the net.",
                            "target_lang_translations": {
                                "ru": "Они использовали разбросанный корм, чтобы <w>приманить</w> птиц поближе к сети.",
                                "tr": "Kuşları ağa yaklaştırmak için etrafa saçılmış yemlerle <w>yemlediler</w>.",
                                "zh": "他们用散落的食物将鸟儿<w>引诱</w>到靠近网的地方。"
                            }
                        }
                    ],
                    "synonyms": [
                        "bait",
                        "lure"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Приманивать животных или рыбу, часто используя приманку.",
                        "tr": "Hayvanları veya balıkları, genellikle yem kullanarak cezbetmek veya kandırmak.",
                        "zh": "指引诱或诱惑动物或鱼类，通常使用诱饵。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приманивать",
                                "target_lang_sense_clarification": "подзывать, используя приманку"
                            },
                            {
                                "target_lang_word": "заманивать",
                                "target_lang_sense_clarification": "вовлекать хитростью"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "cezbetmek",
                                "target_lang_sense_clarification": "yemle kendine çekmek"
                            },
                            {
                                "target_lang_word": "yemlemek",
                                "target_lang_sense_clarification": "yem kullanarak hayvanı yönlendirmek"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "引诱",
                                "target_lang_sense_clarification": "使用诱饵将动物吸引过来"
                            },
                            {
                                "target_lang_word": "诱捕",
                                "target_lang_sense_clarification": "通过诱饵将其引诱并捕捉"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "71c0ed5e-a8f4-38e1-809b-cf442fb76184",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Toll</w> has been appointed as the new director of the board.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Толл</w> был назначен новым директором совета.",
                                "tr": "Bay <w>Toll</w> yönetim kuruluna yeni direktör olarak atandı.",
                                "zh": "<w>托尔</w>先生已被任命为董事会新任董事。"
                            }
                        },
                        {
                            "text": "I went to school with a girl named Sarah <w>Toll</w>.",
                            "target_lang_translations": {
                                "ru": "Я учился в школе с девочкой по имени Сара <w>Толл</w>.",
                                "tr": "Sarah <w>Toll</w> adında bir kızla aynı okula gittim.",
                                "zh": "我和一个叫莎拉·<w>托尔</w>的女孩上过同一所学校。"
                            }
                        }
