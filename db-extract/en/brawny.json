                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c86a190-aece-4683-a4e1-b4eecb67c7bd",
                                                "sense_id": "105a0ed9-3757-3eec-a830-22ca7cba1f09",
                                                "text": "Ta part de viande, elle est carrément plus balèze que la mienne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ee2e73ea-01c7-3818-a515-14c676b6ea5a",
                                        "entry_id": "efc1c38e-c5f0-3e75-ace2-4ff55c5da6a7",
                                        "glosses": [
                                            "Difficile."
