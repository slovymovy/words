{
    "word_family": [
        "spiritual",
        "spirited",
        "spiritless",
        "spirituality",
        "spiritualism",
        "spiritualize",
        "spirituous",
        "inspirit",
        "dispirit"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "02745435-8643-3d5b-b666-caee3831df90",
                    "sense_definition": "The non-physical part of a person which is the seat of emotions and character; the soul.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "soul_and_being",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The long walk through the quiet forest brought a sense of peace to her <w>spirit</w>.",
                            "target_lang_translations": {
                                "ru": "Долгая прогулка по тихому лесу принесла покой её <w>душе</w>.",
                                "tr": "Sessiz ormandaki uzun yürüyüş <w>ruhuna</w> bir huzur duygusu getirdi."
                            }
                        },
                        {
                            "text": "Many believe that the <w>spirit</w> lives on even after the physical body has passed away.",
                            "target_lang_translations": {
                                "ru": "Многие верят, что <w>дух</w> продолжает жить даже после смерти физического тела.",
                                "tr": "Birçok insan, fiziksel beden öldükten sonra bile <w>ruhun</w> yaşamaya devam ettiğine inanır."
                            }
                        }
                    ],
                    "common_phrases": [
                        "human spirit",
                        "freedom of spirit"
                    ],
                    "target_lang_definitions": {
                        "ru": "Нематериальная часть человека, являющаяся средоточием эмоций и характера; душа.",
                        "tr": "Bir insanın duygularının ve karakterinin kaynağı olan somut olmayan parçası; ruh."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "душа",
                                "target_lang_sense_clarification": "внутренний мир человека"
                            },
                            {
                                "target_lang_word": "дух",
                                "target_lang_sense_clarification": "внутренняя сила и сознание"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "ruh",
                                "target_lang_sense_clarification": "insanın manevi varlığı"
                            },
                            {
                                "target_lang_word": "can",
                                "target_lang_sense_clarification": "yaşam enerjisi, iç dünya"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1b2b06b2-94fb-3742-ba0c-4c18a51f5b0f",
                    "sense_definition": "A supernatural being, such as a ghost, fairy, or angel, often without a physical body.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "supernatural",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old legends say an evil <w>spirit</w> haunts the ruins of the castle.",
                            "target_lang_translations": {
                                "ru": "Старые легенды гласят, что злой <w>дух</w> обитает в руинах замка.",
                                "tr": "Eski efsaneler, kötü bir <w>ruhun</w> kalenin kalıntılarında dolaştığını söyler."
                            }
                        },
                        {
                            "text": "They performed a traditional dance to scare off an <w>evil</w> <w>spirit</w> from the village.",
                            "target_lang_translations": {
                                "ru": "Они исполнили традиционный танец, чтобы прогнать злого <w>духа</w> из деревни.",
                                "tr": "Köyden kötü bir <w>ruhu</w> korkutup kaçırmak için geleneksel bir dans yaptılar."
                            }
                        }
                    ],
                    "synonyms": [
                        "apparition",
                        "specter",
                        "vision"
                    ],
                    "common_phrases": [
                        "evil spirit",
                        "guardian spirit"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сверхъестественное существо, такое как призрак, фея или ангел, часто не имеющее физического тела.",
                        "tr": "Hayalet, peri veya melek gibi genellikle fiziksel bir bedeni olmayan doğaüstü varlık."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дух",
                                "target_lang_sense_clarification": "сверхъестественное существо"
                            },
                            {
                                "target_lang_word": "привидение",
                                "target_lang_sense_clarification": "призрак умершего"
                            },
                            {
                                "target_lang_word": "призрак",
                                "target_lang_sense_clarification": "бесплотное видение"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "ruh",
                                "target_lang_sense_clarification": "doğaüstü varlık"
                            },
                            {
                                "target_lang_word": "hayalet",
                                "target_lang_sense_clarification": "görünmez veya bedensiz varlık"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3c5954b9-53d2-3fe9-9de9-265c8b44edd7",
                    "sense_definition": "The quality of being courageous, energetic, or enthusiastic.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "attitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team showed great <w>team</w> <w>spirit</w> even though they were losing the game.",
                            "target_lang_translations": {
                                "ru": "Команда проявила отличный командный <w>дух</w>, хотя и проигрывала матч.",
                                "tr": "Takım, maçı kaybetmesine rağmen harika bir takım <w>ruhu</w> gösterdi."
                            }
                        },
                        {
                            "text": "She has a very independent <w>spirit</w> and likes to do things her own way.",
                            "target_lang_translations": {
                                "ru": "У неё очень независимый <w>нрав</w>, и она любит всё делать по-своему.",
                                "tr": "Çok bağımsız bir <w>yapısı</w> var ve şeyleri kendi bildiği gibi yapmayı seviyor."
                            }
                        }
                    ],
                    "common_phrases": [
                        "team spirit",
                        "school spirit",
                        "fighting spirit"
                    ],
                    "target_lang_definitions": {
                        "ru": "Качество смелости, энергичности или энтузиазма.",
                        "tr": "Cesur, enerjik veya hevesli olma niteliği."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дух",
                                "target_lang_sense_clarification": "моральная сила или настрой"
                            },
                            {
                                "target_lang_word": "энергия",
                                "target_lang_sense_clarification": "жизненная сила"
                            },
                            {
                                "target_lang_word": "боевой настрой",
                                "target_lang_sense_clarification": "готовность к борьбе"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "ruh",
                                "target_lang_sense_clarification": "moral, motivasyon veya takım bağlılığı"
                            },
                            {
                                "target_lang_word": "coşku",
                                "target_lang_sense_clarification": "heyecan ve istek"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0442465c-6e0e-3c8c-ba12-2f85aed3e3a0",
                    "sense_definition": "A person's mood or mental state, often used in the plural.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "mood",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The good news really lifted her <w>spirits</w> after a very difficult week.",
                            "target_lang_translations": {
                                "ru": "Хорошие новости действительно подняли ей <w>настроение</w> после очень тяжелой недели.",
                                "tr": "Çok zor bir haftadan sonra iyi haberler gerçekten <w>moralini</w> düzeltti."
                            }
                        },
                        {
                            "text": "He has been in <w>high</w> <w>spirits</w> ever since he received the promotion.",
                            "target_lang_translations": {
                                "ru": "Он пребывает в приподнятом <w>настроении</w> с тех пор, как получил повышение.",
                                "tr": "Terfi aldığından beri <w>keyfi</w> çok yerinde."
                            }
                        }
                    ],
                    "common_phrases": [
                        "high spirits",
                        "low spirits",
                        "lift someone's spirits"
                    ],
                    "target_lang_definitions": {
                        "ru": "Настроение или психическое состояние человека, часто используется во множественном числе.",
                        "tr": "Bir insanın ruh hali veya zihinsel durumu (çoğunlukla çoğul kullanılır)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "настроение",
                                "target_lang_sense_clarification": "душевное состояние"
                            },
                            {
                                "target_lang_word": "дух",
                                "target_lang_sense_clarification": "внутреннее состояние"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "moral",
                                "target_lang_sense_clarification": "ruh hali veya keyif"
                            },
                            {
                                "target_lang_word": "neşe",
                                "target_lang_sense_clarification": "yüksek ruh hali"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9fcf8884-455e-3451-9861-db7edfa05a6a",
                    "sense_definition": "The prevailing mood, attitude, or quality of a particular group, time, or action.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "attitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the <w>spirit</w> of cooperation, both companies agreed to share their research.",
                            "target_lang_translations": {
                                "ru": "В <w>духе</w> сотрудничества обе компании согласились поделиться своими исследованиями.",
                                "tr": "İş birliği <w>ruhuyla</w>, her iki şirket de araştırmalarını paylaşmayı kabul etti."
                            }
                        },
                        {
                            "text": "The festival was organized in the <w>spirit</w> of fun and community celebration.",
                            "target_lang_translations": {
                                "ru": "Фестиваль был организован в <w>атмосфере</w> веселья и всеобщего праздника.",
                                "tr": "Festival, eğlence ve topluluk kutlaması <w>havasında</w> düzenlendi."
                            }
                        }
                    ],
                    "common_phrases": [
                        "in the spirit of",
                        "community spirit"
                    ],
                    "target_lang_definitions": {
                        "ru": "Преобладающее настроение, отношение или качество определенной группы, времени или действия.",
                        "tr": "Belirli bir grubun, dönemin veya eylemin hakim olan ruh hali, tutumu veya niteliği."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дух",
                                "target_lang_sense_clarification": "атмосфера или характер чего-либо"
                            },
                            {
                                "target_lang_word": "атмосфера",
                                "target_lang_sense_clarification": "окружающая обстановка"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "ruh",
                                "target_lang_sense_clarification": "genel tutum veya hava"
                            },
                            {
                                "target_lang_word": "atmosfer",
                                "target_lang_sense_clarification": "ortamın hissettirdiği durum"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3baf0718-8394-3cce-93e6-9b1424035c98",
                    "sense_definition": "Strong distilled alcoholic drink.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "alcohol",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bar serves a wide variety of <w>spirits</w> including vodka, gin, and whiskey.",
                            "target_lang_translations": {
                                "ru": "В баре подают широкий ассортимент крепких <w>напитков</w>, включая водку, джин и виски.",
                                "tr": "Bar; viski, cin ve votka dahil çok çeşitli <w>sert alkollü içkiler</w> sunmaktadır."
                            }
                        },
                        {
                            "text": "He prefers drinking wine or beer rather than strong <w>spirits</w>.",
                            "target_lang_translations": {
                                "ru": "Он предпочитает пить вино или пиво, а не крепкое <w>спиртное</w>.",
                                "tr": "Sert <w>alkollü içkiler</w> yerine şarap veya bira içmeyi tercih ediyor."
                            }
                        }
                    ],
                    "synonyms": [
                        "liquor"
                    ],
                    "common_phrases": [
                        "distilled spirits"
                    ],
                    "target_lang_definitions": {
                        "ru": "Крепкий дистиллированный алкогольный напиток.",
                        "tr": "Yüksek alkollü distile içki."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "крепкие напитки",
                                "target_lang_sense_clarification": "алкоголь высокой крепости"
                            },
                            {
                                "target_lang_word": "спиртное",
                                "target_lang_sense_clarification": "алкогольные изделия"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "yüksek alkollü içki",
                                "target_lang_sense_clarification": "sert alkollü içecekler"
                            },
                            {
                                "target_lang_word": "ispirto",
                                "target_lang_sense_clarification": "alkol çözeltisi veya içki"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "632331d4-cd82-3792-a467-37240a2e6580",
                    "sense_definition": "The real meaning or the intention of something as opposed to its strict legal interpretation.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "intent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The judge ruled that the company had violated the <w>spirit</w> of the law.",
                            "target_lang_translations": {
                                "ru": "Судья постановил, что компания нарушила <w>дух</w> закона.",
                                "tr": "Yargıç, şirketin yasanın <w>ruhunu</w> ihlal ettiğine karar verdi."
                            }
                        },
                        {
                            "text": "While they followed the rules, they completely ignored the <w>spirit</w> of the agreement.",
                            "target_lang_translations": {
                                "ru": "Хотя они соблюдали правила, они полностью игнорировали <w>смысл</w> соглашения.",
                                "tr": "Kurallara uymalarına rağmen, anlaşmanın <w>özünü</w> tamamen görmezden geldiler."
                            }
                        }
                    ],
                    "common_phrases": [
                        "spirit of the law",
                        "letter and spirit"
                    ],
                    "target_lang_definitions": {
                        "ru": "Истинный смысл или намерение чего-либо в противовес его строгому юридическому толкованию.",
                        "tr": "Bir şeyin katı hukuki yorumunun aksine gerçek anlamı veya amacı."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дух",
                                "target_lang_sense_clarification": "суть или смысл закона/соглашения"
                            },
                            {
                                "target_lang_word": "смысл",
                                "target_lang_sense_clarification": "основная идея"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "ruh",
                                "target_lang_sense_clarification": "kanun veya kuralın asıl amacı"
                            },
                            {
                                "target_lang_word": "öz",
                                "target_lang_sense_clarification": "temel anlam"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6f17feeb-8b28-3f4b-bdec-ea402adca8dd",
                    "sense_definition": "A person characterized by a specific type of mind or character.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "soul_and_being",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was a <w>kindred</w> <w>spirit</w> who shared my passion for ancient history.",
                            "target_lang_translations": {
                                "ru": "Она была родственной <w>душой</w>, разделявшей мою страсть к древней истории.",
                                "tr": "O, antik tarih tutkumu paylaşan yakın bir <w>ruhtu</w>."
                            }
                        },
                        {
                            "text": "The revolution was led by a few brave <w>spirits</w> who refused to stay silent.",
                            "target_lang_translations": {
                                "ru": "Революцию возглавили несколько храбрых <w>людей</w>, которые отказались молчать.",
                                "tr": "Devrim, sessiz kalmayı reddeden birkaç cesur <w>insan</w> tarafından yönetildi."
                            }
                        }
                    ],
                    "common_phrases": [
                        "kindred spirit",
                        "free spirit",
                        "leading spirit"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, характеризующийся определенным типом ума или характера.",
                        "tr": "Belirli bir zihniyet veya karakter tipiyle tanımlanan kişi."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "душа",
                                "target_lang_sense_clarification": "человек с определенными качествами"
                            },
                            {
                                "target_lang_word": "натура",
                                "target_lang_sense_clarification": "характер человека"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "insan",
                                "target_lang_sense_clarification": "belirli bir karaktere sahip kişi"
                            },
                            {
                                "target_lang_word": "ruh",
                                "target_lang_sense_clarification": "belirli nitelikteki kimse"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bdade47a-91b9-3a06-a930-2992d96e16a4",
                    "sense_definition": "To carry someone or something away rapidly and secretly.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The witness was <w>spirited</w> <w>away</w> to a safe house before the trial began.",
                            "target_lang_translations": {
                                "ru": "Свидетеля тайно <w>увезли</w> в безопасное место до начала судебного процесса.",
                                "tr": "Tanık, duruşma başlamadan önce güvenli bir eve <w>gizlice kaçırıldı</w>."
                            }
                        },
                        {
                            "text": "The secret documents were <w>spirited</w> out of the building under the cover of darkness.",
                            "target_lang_translations": {
                                "ru": "Секретные документы были тайно <w>вынесены</w> из здания под покровом темноты.",
                                "tr": "Gizli belgeler karanlıktan yararlanılarak binadan <w>gizlice çıkarıldı</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "spirit away"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быстро и тайно увозить кого-либо или что-либо.",
                        "tr": "Birini veya bir şeyi hızlıca ve gizlice uzaklaştırmak, kaçırmak."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тайно вывезти",
                                "target_lang_sense_clarification": "незаметно переместить"
                            },
                            {
                                "target_lang_word": "умыкнуть",
                                "target_lang_sense_clarification": "быстро и скрытно забрать"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "gizlice kaçırmak",
                                "target_lang_sense_clarification": "fark ettirmeden götürmek"
                            },
                            {
                                "target_lang_word": "sıkıştırmak",
                                "target_lang_sense_clarification": "çabucak uzaklaştırmak"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "ad324194-61ac-3eb9-a637-39f3fe7a1855",
                    "sense_definition": "A short way of referring to the Holy <w>Spirit</w> in Christian theology.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "religion",
                    "name_type": "deity_or_religious_name",
                    "examples": [
                        {
                            "text": "The priest spoke about the gifts of the <w>Spirit</w> during his Sunday morning sermon.",
                            "target_lang_translations": {
                                "ru": "Священник говорил о дарах <w>Духа</w> во время своей воскресной утренней проповеди.",
                                "tr": "Rahi̇p, Pazar sabahı vaazında <w>Ruh'un</w> armağanlarından bahsetti."
                            }
                        },
                        {
                            "text": "They prayed that the <w>Spirit</w> would guide them in their difficult decision.",
                            "target_lang_translations": {
                                "ru": "Они молились, чтобы <w>Дух</w> направил их в этом трудном решении.",
                                "tr": "Bu zor kararlarında <w>Ruh'un</w> kendilerine yol göstermesi için dua ettiler."
                            }
                        }
                    ],
                    "common_phrases": [
                        "gift of the Spirit"
                    ],
                    "target_lang_definitions": {
                        "ru": "Краткое обозначение Святого Духа в христианском богословии.",
                        "tr": "Hristiyan teolojisinde Kutsal Ruh'a atıfta bulunmanın kısa yolu."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Дух",
                                "target_lang_sense_clarification": "Святой Дух"
                            }
