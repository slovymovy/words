                "senses": [
                    {
                        "sense_id": "2f6ad077-17ef-3170-931b-abe8cd280776",
                        "entry_id": "29b5d5ec-c038-3866-b27f-c7fbcc62fca4",
                        "glosses": [
                            "Farm für Ponys"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4cf1acd2-a11e-486d-a7d1-46e3410d892f",
                                "sense_id": "2f6ad077-17ef-3170-931b-abe8cd280776",
                                "text": "„Glücklicherweise gibt es keine Ponyfarmen, auf denen die Tiere ihres Fells wegen gequält werden.“"
                            },
                            {
                                "example_id": "a4ddabc8-ad6d-4c9c-9332-9321ea3630aa",
                                "sense_id": "2f6ad077-17ef-3170-931b-abe8cd280776",
                                "text": "„»Wir fahren auf eine Ponyfarm. Zwanzig Kilometer von hier gibt es eine Ponyfarm. Da kannst du sogar reiten«, sagte mein Vater. Er schaute mich nicht an dabei. Er war verlegen.“"
                            },
                            {
                                "example_id": "8e833b11-d736-42b6-aa9e-3dd57bcff18a",
                                "sense_id": "2f6ad077-17ef-3170-931b-abe8cd280776",
                                "text": "„Das Meer ist keine Ponyfarm und keine Kuschelecke. Wir verlassen die Marina und segeln gemütlich durch den Hvarski-Kanal in Richtung östliches Ende der Insel Hvar.“"
                            },
                            {
                                "example_id": "aac78b38-6e17-444b-a1fb-096bc8ecce2b",
                                "sense_id": "2f6ad077-17ef-3170-931b-abe8cd280776",
                                "text": "„Diese Ponyfarm ist ganz auf Kinder eingestellt.“"
                            },
                            {
                                "example_id": "78ae298e-81a4-4833-8fac-eaa67926b1e5",
                                "sense_id": "2f6ad077-17ef-3170-931b-abe8cd280776",
                                "text": "Das Leben ist keine Ponyfarm."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
