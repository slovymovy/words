                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c8aa09ab-dfbb-3aa9-bb75-23368137aa6a",
                                        "entry_id": "8acf1eaa-83c5-3f4d-8b7a-cd8f04183d1d",
                                        "glosses": [
                                            "Financial ability."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
