                        "form_id": "57a5cace-e1b7-4840-8f69-d94962c0bcab",
                        "entry_id": "81094b92-c993-36bb-9446-265e89fa52b6",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more heteroclite"
                    },
                    {
                        "form_id": "a328e7ef-6072-4fdf-b7cd-783f19c814e0",
                        "entry_id": "81094b92-c993-36bb-9446-265e89fa52b6",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most heteroclite"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4cafc841-59f0-3394-8b66-3b08b335b054",
                        "entry_id": "81094b92-c993-36bb-9446-265e89fa52b6",
                        "glosses": [
                            "Irregularly declined or inflected."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "11fa6b37-d3f6-3d04-b998-f03f3cd85a52",
                        "entry_id": "81094b92-c993-36bb-9446-265e89fa52b6",
                        "glosses": [
                            "Deviating from the ordinary rule; eccentric, abnormal."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "5b3b89ea-d40c-4030-9e62-ba721c06fde5",
                                "sense_id": "11fa6b37-d3f6-3d04-b998-f03f3cd85a52",
                                "text": "he was, on the contrary, as mercurial and sublimated a composition, […] as heteroclite a creature in all his declensions; […] with as much life and whim, and gaité de cœur about him, as the kindliest climate could have engendered and put together."
                            },
                            {
                                "example_id": "8b414735-1656-4397-b257-65a952ffbd61",
                                "sense_id": "11fa6b37-d3f6-3d04-b998-f03f3cd85a52",
                                "text": "Nor could I have dreamed the heteroclite crew-men I had met aboard Tzadkiel's ship […]"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1ba69c2f-d74c-4f7d-a8bd-413c43db7a90",
                        "source_entry_id": "81094b92-c993-36bb-9446-265e89fa52b6",
                        "source_sense_description": "eccentric, abnormal",
                        "target_lang_word": "anormal",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anormal",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9cea4a93-3bac-3c02-8172-c34068fed35f",
                                        "entry_id": "a1240d0e-2ed7-3ce2-966f-263cf39a978e",
                                        "glosses": [
                                            "Qui est contraire aux règles qui paraissent régir son genre ou son espèce."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a5eac26-585f-4f72-9cba-fe15c358e7a4",
                                                "sense_id": "9cea4a93-3bac-3c02-8172-c34068fed35f",
                                                "text": "Les savants s’occupèrent de tout dans une paix profonde, depuis la végétation anormale d'un ognon de jacinthe jusqu'aux courants électriques."
                                            },
                                            {
                                                "example_id": "31a7c8fa-bf5e-4a2b-bc25-b47f785f9dc7",
                                                "sense_id": "9cea4a93-3bac-3c02-8172-c34068fed35f",
                                                "text": "L'inconscience règne parmi les autorités municipales qui ont laissé faire en fermant les yeux. Et ceux qui ont construit ou ont acheté ensuite sans s'interroger n'y ont rien vu d' anormal non plus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a888da64-0c92-324f-9ddc-1db65a2cf5f1",
                                        "entry_id": "a1240d0e-2ed7-3ce2-966f-263cf39a978e",
                                        "glosses": [
                                            "Qui dépasse la mesure commune."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "659656f6-80d6-4d69-ba0c-e9fd1772bce7",
                                                "sense_id": "a888da64-0c92-324f-9ddc-1db65a2cf5f1",
                                                "text": "Il n’est quand même pas anormal que la cellule interne qui s’occupe des violences sexuelles s’autosaisisse, quand elle est en copie, d’une lettre de suicide."
                                            },
                                            {
                                                "example_id": "e1720026-8c3c-478e-ad6e-0ffd8476feeb",
                                                "sense_id": "a888da64-0c92-324f-9ddc-1db65a2cf5f1",
                                                "text": "Ce n’est pas une simple question d’innovation technique, mais aussi une question de compréhension de l’organisation générale dans laquelle s’insère une telle définition d’un comportement anormal."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "anormal",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "15757827-8606-3317-8a7d-dd1841072048",
                                        "entry_id": "e39fe661-41e3-3723-92c4-aa606e8f8905",
                                        "glosses": [
                                            "Personne dont l’état ou le comportement n’est pas normal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "528814da-f1a9-4fbf-9d6f-b986eec3825b",
                                                "sense_id": "15757827-8606-3317-8a7d-dd1841072048",
                                                "text": "Un anormal."
                                            },
                                            {
                                                "example_id": "9f2d347d-a8d1-43c7-9511-bb6b84e78216",
                                                "sense_id": "15757827-8606-3317-8a7d-dd1841072048",
                                                "text": "Il se peut qu’un directeur qui a un anormal dans son école s’abstienne de le signaler."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "anormal",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cf965f5b-c2c4-36e6-83b5-babd4b69f04e",
                                        "entry_id": "a27cbf9e-9c04-3e85-8fab-22d42b06f238",
                                        "glosses": [
                                            "Ce qui est contraire à la norme, à la règle habituelle ou commune."
                                        ],
                                        "tags": [
                                            "singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f3409415-3baf-4ffc-a90a-abd1bad6dad6",
                                                "sense_id": "cf965f5b-c2c4-36e6-83b5-babd4b69f04e",
                                                "text": "L’habitude est devenue ici une seconde nature. L’anormal est considéré ici comme le normal."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9d74f3ab-0549-471a-9915-f209746a5176",
                        "source_entry_id": "81094b92-c993-36bb-9446-265e89fa52b6",
                        "source_sense_description": "eccentric, abnormal",
                        "target_lang_word": "hétéroclite",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hétéroclite",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2944c2aa-eb0a-3f02-8597-e837beb02ab7",
                                        "entry_id": "337ac1c5-3e6a-3b9b-baf3-36121ed2a055",
                                        "glosses": [
                                            "Qui mélange les déclinaisons."
                                        ],
                                        "tags": [
                                            "Sens étymologique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "19adf7fa-0f7f-4325-8836-5d556abdcaeb",
                                                "sense_id": "2944c2aa-eb0a-3f02-8597-e837beb02ab7",
                                                "text": "Les noms neutres proto-indo-européens sont caractérisés par une déclinaison hétéroclite dans la mesure où ils reçoivent un suffixe différent au nominatif et au cas oblique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "075aacd9-0a7e-37d5-8afc-2f8dbb1816e1",
                                        "entry_id": "337ac1c5-3e6a-3b9b-baf3-36121ed2a055",
                                        "glosses": [
                                            "Qui s’écarte des règles ordinaires, composite, mélangé, divers, panaché, hétérogène."
                                        ],
                                        "tags": [
                                            "Didactique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "33fb0227-8e97-47c8-9fea-3deb9649e776",
                                                "sense_id": "075aacd9-0a7e-37d5-8afc-2f8dbb1816e1",
                                                "text": "Bâtiment hétéroclite, mot composé hétéroclite."
                                            },
                                            {
                                                "example_id": "551a7ffd-b2b7-4d03-9520-e1c210c5ea64",
                                                "sense_id": "075aacd9-0a7e-37d5-8afc-2f8dbb1816e1",
                                                "text": "Amalgame hétéroclite, mélange de composants très différents."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "275b6a4a-5f07-31d4-bfea-27d8c0263c9a",
                                        "entry_id": "337ac1c5-3e6a-3b9b-baf3-36121ed2a055",
                                        "glosses": [
                                            "Mélangé d’éléments disparates."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83b6175f-f96f-4853-9972-7108c0b0bfa1",
                                                "sense_id": "275b6a4a-5f07-31d4-bfea-27d8c0263c9a",
                                                "text": "Elle se dirigea vers un marchand d'arlequins. Triste endroit pour souper ! On y servait, réuni sur une seule assiette, un mélange hétéroclite (d'où son nom) de reliefs plus ou moins avariés, collectés dans les restaurants voisins."
                                            },
                                            {
                                                "example_id": "19270715-0ee3-47dd-b8f2-5010970f7c18",
                                                "sense_id": "275b6a4a-5f07-31d4-bfea-27d8c0263c9a",
                                                "text": "Vers la fin du souper, comme dans un film, l'une des premières manifestations nocturnes passe devant le restaurant, long ruban hétéroclite et bruyant dans la pénombre …."
                                            },
                                            {
                                                "example_id": "8296c686-2e9e-4c29-8555-7e95b33cd3a4",
                                                "sense_id": "275b6a4a-5f07-31d4-bfea-27d8c0263c9a",
                                                "text": "Selon la vieille loi de la prédiction créatrice, ce procès fait advenir l’adversaire qu’il combat. Il transforme une nébuleuse hétéroclite de courants de pensées et de travaux disparates en complot plus ou moins organisé contre la science et contre la République."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f5a097a-86d8-3ed4-ad71-d530cb5b4ef6",
                                        "entry_id": "337ac1c5-3e6a-3b9b-baf3-36121ed2a055",
                                        "glosses": [
                                            "Se dit d’une œuvre dont les différentes parties appartiennent à des styles et des mouvements artistiques différents."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd00ac8d-a899-4461-96bf-27da85ffb179",
                                                "sense_id": "4f5a097a-86d8-3ed4-ad71-d530cb5b4ef6",
                                                "text": "Une pièce de théâtre, un roman hétéroclite."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8741044d-ea0a-39b9-bbd2-9ed0b3bfe772",
                                        "entry_id": "337ac1c5-3e6a-3b9b-baf3-36121ed2a055",
                                        "glosses": [
                                            "En parlant des personnes et des choses, qui a une apparence ridicule, étrange, bizarre, singulière."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a2084efe-648b-4126-ab29-1de67c60a436",
                                                "sense_id": "8741044d-ea0a-39b9-bbd2-9ed0b3bfe772",
                                                "text": "Manières hétéroclites."
                                            },
                                            {
                                                "example_id": "a6fc2a28-f0be-419b-a9df-b3bd5ba73c18",
                                                "sense_id": "8741044d-ea0a-39b9-bbd2-9ed0b3bfe772",
                                                "text": "Personnage hétéroclite."
                                            },
                                            {
                                                "example_id": "66cd733b-c5cd-4429-bdea-5e38dbad1605",
                                                "sense_id": "8741044d-ea0a-39b9-bbd2-9ed0b3bfe772",
                                                "text": "Il est à la Bourse des recoins ignorés où grouille tout une population héteroclite.’’ — (Émile Gaboriau, L’Argent des autres , 1874)"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
