                "senses": [
                    {
                        "sense_id": "9c615993-582c-3e14-b385-d4ed5a2ded69",
                        "entry_id": "75772c3a-8e8f-3ced-b9dd-e0ce6beb1c1f",
                        "glosses": [
                            "gedeelte van een weg of route met een welomschreven begin- en eindpunt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7926911f-da79-4315-99d8-3ca3583cdfe5",
                                "sense_id": "9c615993-582c-3e14-b385-d4ed5a2ded69",
                                "text": "De nieuwe reflectoren op dit wegvak geven het midden van de rijbaan aan en attenderen automobilisten als zij door onoplettendheid over het midden van de weg komen."
                            },
                            {
                                "example_id": "a36ec086-25e2-4362-bca3-bd76e7a20420",
                                "sense_id": "9c615993-582c-3e14-b385-d4ed5a2ded69",
                                "text": "De A1 tussen het tankstation Palmpol en de afrit naar de A30 is volgens het samenwerkingsverband van alarmcentrales een opvallende nieuwkomer in de lijst van gevaarlijkste wegvakken. Op dit stuk weg, dat vlak voor de afslag naar de A30 ligt, gebeurden vorig jaar 42 ongevallen, bijna drie keer meer dan in voorgaande jaren. Problemen met een te korte uitvoegstrook en de afsluiting van de N805 lijken hier debet aan te zijn."
                            },
                            {
                                "example_id": "9e69ecc5-1404-46bf-a386-0674f891be0d",
                                "sense_id": "9c615993-582c-3e14-b385-d4ed5a2ded69",
                                "text": "De brandweer is op dit moment druk bezig de woning te ventileren. Om de hulpdiensten voldoende werkruimte te geven is een wegvak afgesloten."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7fe0a3d8-dee1-4e5d-b3aa-051a27aec10c",
                        "source_entry_id": "75772c3a-8e8f-3ced-b9dd-e0ce6beb1c1f",
                        "source_sense_id": "9c615993-582c-3e14-b385-d4ed5a2ded69",
                        "target_lang_word": "stretch",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stretch",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6a32c8cc-d5b7-359f-a270-70c72f3e4428",
                                        "entry_id": "532397c9-dcf5-365f-93ec-634971a5f955",
                                        "glosses": [
                                            "To lengthen by pulling."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18733a50-f0d4-4524-8cbb-6c9a01ec9066",
                                                "sense_id": "6a32c8cc-d5b7-359f-a270-70c72f3e4428",
                                                "text": "I stretched the rubber band until it almost broke."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca9eb3d0-6e42-3651-88bc-ba9e66b7d443",
                                        "entry_id": "532397c9-dcf5-365f-93ec-634971a5f955",
                                        "glosses": [
                                            "To lengthen when pulled."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e0b8a61e-3c46-4983-a5b2-98230fa30bb7",
                                                "sense_id": "ca9eb3d0-6e42-3651-88bc-ba9e66b7d443",
                                                "text": "The rubber band stretched almost to the breaking point."
                                            },
                                            {
                                                "example_id": "5d7c7aca-f4d1-4188-a4e9-a6431d76473f",
                                                "sense_id": "ca9eb3d0-6e42-3651-88bc-ba9e66b7d443",
                                                "text": "The inner membrane […] because it would stretch and yield, remained unbroken."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8953301b-9d45-3486-87fc-94263bc0e002",
                                        "entry_id": "532397c9-dcf5-365f-93ec-634971a5f955",
                                        "glosses": [
                                            "To pull tight."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bc28c14c-b8bf-468a-9cb3-68340a6fac92",
                                                "sense_id": "8953301b-9d45-3486-87fc-94263bc0e002",
                                                "text": "First, stretch the skin over the frame of the drum."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "235bdc4f-83a8-3bba-8a0a-69afc92897de",
                                        "entry_id": "532397c9-dcf5-365f-93ec-634971a5f955",
                                        "glosses": [
                                            "To get more use than expected from a limited resource."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "988f5711-c207-4f3b-aa8b-a8f4ed79da5d",
                                                "sense_id": "235bdc4f-83a8-3bba-8a0a-69afc92897de",
                                                "text": "I managed to stretch my coffee supply a few more days."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "31849bc4-d762-3fbf-a4d1-c62038dd6dde",
                                        "entry_id": "532397c9-dcf5-365f-93ec-634971a5f955",
                                        "glosses": [
                                            "To make inaccurate by exaggeration."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f4eee84b-6a4a-42ba-b921-3731c0f647f7",
                                                "sense_id": "31849bc4-d762-3fbf-a4d1-c62038dd6dde",
                                                "text": "To say crossing the street was brave is stretching the meaning of \"brave\" considerably."
                                            },
                                            {
                                                "example_id": "3b735f66-2b4d-4cc4-bd93-194e9490f094",
                                                "sense_id": "31849bc4-d762-3fbf-a4d1-c62038dd6dde",
                                                "text": "To say he's been to this park a million times is stretching the numbers. The true number is around 30 or 40."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0cf5156e-d8de-3872-99ce-c5f6da792f6f",
                                        "entry_id": "532397c9-dcf5-365f-93ec-634971a5f955",
                                        "glosses": [
                                            "To extend physically, especially from limit point to limit point."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "950fe4de-e89d-4ad8-a9e9-8da0f00e6aac",
                                                "sense_id": "0cf5156e-d8de-3872-99ce-c5f6da792f6f",
                                                "text": "The beach stretches from Cresswell to Amble."
                                            },
                                            {
                                                "example_id": "1bd47778-1188-4d51-bd2d-96967ab7fbfa",
                                                "sense_id": "0cf5156e-d8de-3872-99ce-c5f6da792f6f",
                                                "text": "Pretty soon I struck into a sort of path[…]. It twisted and turned,[…]and opened out into a big clear space like a lawn. And, back of the lawn, was a big, old-fashioned house, with piazzas stretching in front of it, and all blazing with lights."
                                            },
                                            {
                                                "example_id": "11412668-6b6e-44aa-810d-d581ecc3fe60",
                                                "sense_id": "0cf5156e-d8de-3872-99ce-c5f6da792f6f",
                                                "text": "Behind them, stretching in a long line east and west, were the Roan and Book Cliffs, cut to their base by the river's gorge, and meandering away in long wavy lines distorted by heat haze and the smoke of forest fires."
                                            },
                                            {
                                                "example_id": "2ec6f938-c48a-4018-842c-28f6e2af1ac8",
                                                "sense_id": "0cf5156e-d8de-3872-99ce-c5f6da792f6f",
                                                "text": "Three varieties of wild rice, O. rufipogon, O. officinalis and O. meyeriana, have been found in China, in a zone stretching from Hainan to Taiwan and from Northern Kwangsi to Ching-hung¹ on the Upper Mekong in Yunnan."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8add3b8d-30c3-3e93-8176-ac7b5857e4f3",
                                        "entry_id": "532397c9-dcf5-365f-93ec-634971a5f955",
                                        "glosses": [
                                            "To extend one’s limbs or another part of the body, for example in order to improve the elasticity of one's muscles."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e88866a-ad18-4752-b747-7e1e1d4a9dff",
                                                "sense_id": "8add3b8d-30c3-3e93-8176-ac7b5857e4f3",
                                                "text": "Cats stretch with equal ease and agility beyond the point that breaks a man on the rack."
                                            },
                                            {
                                                "example_id": "a3276eb9-b5a9-4252-adc3-5257af993e21",
                                                "sense_id": "8add3b8d-30c3-3e93-8176-ac7b5857e4f3",
                                                "text": "I always stretch my muscles before exercising."
                                            },
                                            {
                                                "example_id": "ce7ce875-69e3-462e-9d35-a21a9d11757d",
                                                "sense_id": "8add3b8d-30c3-3e93-8176-ac7b5857e4f3",
                                                "text": "When the cat woke up, it yawned and stretched."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "77e43217-50b5-362b-80e0-47d57719f17e",
                                        "entry_id": "532397c9-dcf5-365f-93ec-634971a5f955",
                                        "glosses": [
                                            "To extend to a limit point"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b1e3b0a-0df3-46a5-bff3-6e0d75f74a1c",
                                                "sense_id": "77e43217-50b5-362b-80e0-47d57719f17e",
                                                "text": "His mustache stretched all the way to his sideburns."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85682347-8d2c-348a-82de-2b9bb8067caa",
                                        "entry_id": "532397c9-dcf5-365f-93ec-634971a5f955",
                                        "glosses": [
                                            "To increase."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a481f54f-7a0d-4dee-97ea-724e40793184",
                                                "sense_id": "85682347-8d2c-348a-82de-2b9bb8067caa",
                                                "text": "Yakubu took advantage of John Ruddy's error to put the visitors back in front, with Chris Samba's header stretching their advantage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c3f76ab-395b-3b39-a4f7-d10d81e76b40",
                                        "entry_id": "532397c9-dcf5-365f-93ec-634971a5f955",
                                        "glosses": [
                                            "To stretch the truth; to exaggerate."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "87d999dc-d0e3-4165-9d69-bc1490580d82",
                                                "sense_id": "7c3f76ab-395b-3b39-a4f7-d10d81e76b40",
                                                "text": "a man apt to stretch in his report of facts"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e9b0051-975a-3f5d-956c-1e436016223b",
                                        "entry_id": "532397c9-dcf5-365f-93ec-634971a5f955",
                                        "glosses": [
                                            "To sail by the wind under press of canvas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86e89201-43cb-4912-a2fa-850f516acc3b",
                                                "sense_id": "6e9b0051-975a-3f5d-956c-1e436016223b",
                                                "text": "The ship stretched to the eastward."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "892c1dfe-7852-3ae7-8c4e-077019cd2eb6",
                                        "entry_id": "532397c9-dcf5-365f-93ec-634971a5f955",
                                        "glosses": [
                                            "To execute by hanging."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b947926a-e0eb-31da-af88-a7f2d381de45",
                                        "entry_id": "532397c9-dcf5-365f-93ec-634971a5f955",
                                        "glosses": [
                                            "To make great demands on the capacity or resources of something."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6fcdb30c-c8a8-48b0-9f77-8ac25bc95b1a",
                                                "sense_id": "b947926a-e0eb-31da-af88-a7f2d381de45",
                                                "text": "Her bizarre explanation really stretches credulity."
                                            },
                                            {
                                                "example_id": "b527c7bb-ca94-475a-a764-0675af4a7f48",
                                                "sense_id": "b947926a-e0eb-31da-af88-a7f2d381de45",
                                                "text": "By the fullest exploitation of modern signalling, multiple-unit operation and flying and burrowing junctions the S.R. has greatly increased the capacity of its tracks to carry this growing load of peak-hour passengers, but that capacity is now stretched to the limit."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "stretch",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "32f90358-faa5-3f58-aac1-f0d7feb96ffe",
                                        "entry_id": "00218d42-9d1e-332d-bed0-ee6e6cfcfb2d",
                                        "glosses": [
                                            "An act of stretching."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a3bae94-4e65-405b-bd28-d4311f6d059d",
                                                "sense_id": "32f90358-faa5-3f58-aac1-f0d7feb96ffe",
                                                "text": "I was right in the middle of a stretch when the phone rang."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d61e5cb5-8e21-3b6f-beee-e9aa475a245d",
                                        "entry_id": "00218d42-9d1e-332d-bed0-ee6e6cfcfb2d",
                                        "glosses": [
                                            "The ability to lengthen when pulled."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "adad3925-7a23-4a63-96d4-4c4e65d5ba6f",
                                                "sense_id": "d61e5cb5-8e21-3b6f-beee-e9aa475a245d",
                                                "text": "That rubber band has quite a bit of stretch."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e367e19a-a466-3a5a-97e4-229527e2801c",
                                        "entry_id": "00218d42-9d1e-332d-bed0-ee6e6cfcfb2d",
                                        "glosses": [
                                            "A course of thought which diverts from straightforward logic, or requires extraordinary belief or exaggeration."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9579f89-0e0e-4ab0-a42f-d3d0a76186d8",
                                                "sense_id": "e367e19a-a466-3a5a-97e4-229527e2801c",
                                                "text": "It's a bit of a stretch to call Boris Karloff a comedian."
                                            },
                                            {
                                                "example_id": "c59b2870-bafa-48e4-ba8d-ab3c9c77c173",
                                                "sense_id": "e367e19a-a466-3a5a-97e4-229527e2801c",
                                                "text": "To say crossing the street was brave was quite a stretch."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "36d8c183-5980-32b7-abd5-2a1b46baa90f",
                                        "entry_id": "00218d42-9d1e-332d-bed0-ee6e6cfcfb2d",
                                        "glosses": [
                                            "A segment of a journey or route."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b456d7ae-a963-48b5-b2ad-6c1a23553201",
                                                "sense_id": "36d8c183-5980-32b7-abd5-2a1b46baa90f",
                                                "text": "It's a tough stretch of road in the winter, especially without chains."
                                            },
                                            {
                                                "example_id": "f5a4913b-3a43-4170-9a1d-85f9508ed5d0",
                                                "sense_id": "36d8c183-5980-32b7-abd5-2a1b46baa90f",
                                                "text": "It was an easy trip except for the last stretch, which took forever."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6974c516-0ec5-3d83-ab05-2a60ca6cdc53",
                                        "entry_id": "00218d42-9d1e-332d-bed0-ee6e6cfcfb2d",
                                        "glosses": [
                                            "A segment or length of material."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "98521889-df07-4de0-a6dd-0aee1339030c",
                                                "sense_id": "6974c516-0ec5-3d83-ab05-2a60ca6cdc53",
                                                "text": "a stretch of cloth"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c0f7b99-b228-3f36-b80e-374eb27df4a7",
                                        "entry_id": "00218d42-9d1e-332d-bed0-ee6e6cfcfb2d",
                                        "glosses": [
                                            "A walk."
                                        ],
                                        "tags": [
                                            "UK",
                                            "archaic",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ae437b7-8c3f-4762-90bd-a14deff724ed",
                                                "sense_id": "5c0f7b99-b228-3f36-b80e-374eb27df4a7",
                                                "text": "In the afternoon I went for a stretch into the country, & about 4 it cleared up pretty well, so I hurried back & we got a cart & drove to Bassano, a little town about 8 miles off, that we wanted to see."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb10662f-b504-3904-ac29-7adeae296a07",
                                        "entry_id": "00218d42-9d1e-332d-bed0-ee6e6cfcfb2d",
                                        "glosses": [
                                            "A quick pitching delivery used when runners are on base where the pitcher slides his leg instead of lifting it."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d2557cf5-c197-31cd-9975-a899f4ecc200",
                                        "entry_id": "00218d42-9d1e-332d-bed0-ee6e6cfcfb2d",
                                        "glosses": [
                                            "A long reach in the direction of the ball with a foot remaining on the base by a first baseman in order to catch the ball sooner."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fb2c2218-6c75-386e-a818-ef6d843b3780",
                                        "entry_id": "00218d42-9d1e-332d-bed0-ee6e6cfcfb2d",
                                        "glosses": [
                                            "Term of address for a tall person."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb092ba7-5cfa-4d38-95ba-25ea27db69c8",
                                                "sense_id": "fb2c2218-6c75-386e-a818-ef6d843b3780",
                                                "text": "“Hey, Stretch,” he shouted at a tall, spectacled co-worker, “turn the fucking station, will you? You know I can't stand Rush, and it's all they play on this one. If I hear those assholes whine 'Tom Sawyer' one more time, I may go on a fucking killing spree."
                                            },
                                            {
                                                "example_id": "1ee6cf2f-a7ce-45e6-8469-218c32aa4ea8",
                                                "sense_id": "fb2c2218-6c75-386e-a818-ef6d843b3780",
                                                "text": "Amelia: I mean, you're already a dwarf.\nGura: Oh, OK, Stretch."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d4188807-a870-37ee-a351-510a0f0d5796",
                                        "entry_id": "00218d42-9d1e-332d-bed0-ee6e6cfcfb2d",
                                        "glosses": [
                                            "The homestretch, the final straight section of the track leading to the finish."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "58914db4-3afe-33f4-8884-9387f11ad870",
                                        "entry_id": "00218d42-9d1e-332d-bed0-ee6e6cfcfb2d",
                                        "glosses": [
                                            "A length of time."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c83592e-fc3c-439a-b433-0b4d5bd58a2f",
                                                "sense_id": "58914db4-3afe-33f4-8884-9387f11ad870",
                                                "text": "After the harvest there was a stretch of clear dry weather, and the animals toiled harder than ever […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e217a135-653e-3e5d-9828-a8609fe5c0c6",
                                        "entry_id": "00218d42-9d1e-332d-bed0-ee6e6cfcfb2d",
                                        "glosses": [
