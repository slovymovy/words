                        "entry_id": "43c6454f-38bc-3393-a078-8f139af13a4d",
                        "tags": [
                            "singular",
                            "feminine"
                        ],
                        "form": "reptilienne"
                    },
                    {
                        "form_id": "448fd9ef-ce5a-40bd-b081-b6977e574c5b",
                        "entry_id": "43c6454f-38bc-3393-a078-8f139af13a4d",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "reptiliennes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fa45f382-2d69-3b2a-91fc-621c0a8e1fbe",
                        "entry_id": "43c6454f-38bc-3393-a078-8f139af13a4d",
                        "glosses": [
                            "Qui appartient aux reptiles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "278203ae-3a4c-41aa-8c6d-6422551ce81d",
                                "sense_id": "fa45f382-2d69-3b2a-91fc-621c0a8e1fbe",
                                "text": "Entrouvrant un œil reptilien il observa les sales gosses encourager le père de l’un d’eux à taper sur la vitre jusqu’à ce qu’ils se lassent et s’éloignent."
                            },
                            {
                                "example_id": "46a41144-c270-4d8f-a1f0-6610342b260e",
                                "sense_id": "fa45f382-2d69-3b2a-91fc-621c0a8e1fbe",
                                "text": "La peau est étique et desséchée... presque reptilienne."
                            }
                        ]
                    },
                    {
                        "sense_id": "fc991a63-aeeb-3596-b500-fd0968e171e3",
                        "entry_id": "43c6454f-38bc-3393-a078-8f139af13a4d",
                        "glosses": [
                            "Instinctif et primaire, par allusion au cerveau reptilien."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "37bb3445-62cf-426a-8df5-17f6dff889f6",
                                "sense_id": "fc991a63-aeeb-3596-b500-fd0968e171e3",
                                "text": "Et chacun de vilipender le malheureux — réflexe reptilien s’il en est."
                            },
                            {
                                "example_id": "ec1ef409-bd20-49be-b594-2e503d1b6407",
                                "sense_id": "fc991a63-aeeb-3596-b500-fd0968e171e3",
                                "text": "Si le principe de plaisir répond aux pulsions des zones les plus « reptiliennes » du cerveau humain, il n'existe qu'un antidote : l'Autre qui instaure une limite à la toute-puissance."
                            }
                        ]
                    },
                    {
                        "sense_id": "c2efd60c-7096-30a4-bdb6-276e14f49c1f",
                        "entry_id": "43c6454f-38bc-3393-a078-8f139af13a4d",
                        "glosses": [
                            "Relatif aux reptiliens (extra-terrestres)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dfe056a9-218d-485c-990c-8460977744d9",
                                "sense_id": "c2efd60c-7096-30a4-bdb6-276e14f49c1f",
                                "text": "Certaines communautés complotistes voient même dans la dénonciation d’un complot reptilien une tentative de ridiculiser par contagion leurs propres théories."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "a100fe22-4449-3fdf-86e3-53800fdd425d",
