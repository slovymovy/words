                        "entry_id": "e9969ac0-6caf-3ac0-a2f5-ee9b8de989fe",
                        "glosses": [
                            "Implantation (Einnistung) der befruchteten Eizelle in der Bauchhöhle"
                        ],
                        "tags": [
                            "Gynäkologie"
                        ],
                        "examples": [
                            {
                                "example_id": "95aec5f5-83e8-482a-bb88-1338a157b001",
                                "sense_id": "5227d2e3-1100-3d1f-9a50-c75a201e2542",
                                "text": "Eine Abdominalgravidität stellt eine ernsthafte Bedrohung für Gesundheit und Fruchtbarkeit einer Frau dar."
                            },
                            {
                                "example_id": "c0320a67-1049-4109-a23a-fd0a3c59e319",
                                "sense_id": "5227d2e3-1100-3d1f-9a50-c75a201e2542",
                                "text": "Eine Abdominalgravidität kann in seltenen Fällen ausgetragen werden, die Geburt hingegen ist nur mit einer komplizierten Bauchoperation möglich."
                            }
                        ],
