                                "target_senses": [
                                    {
                                        "sense_id": "28270e5f-19fe-3e6b-9c4a-85d568fceec8",
                                        "entry_id": "32bf9d19-6d67-379c-bfd4-b46e8dff85ab",
                                        "glosses": [
                                            "Material, made from the polished skin of a calf, sheep, goat or other animal, used like paper for writing."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab89bda9-c202-476f-9e0c-7290feaa6fc0",
                                                "sense_id": "28270e5f-19fe-3e6b-9c4a-85d568fceec8",
                                                "text": "At twilight in the summer there is never anybody to fear—man, woman, or cat—in the chambers and at that hour the mice come out. They do not eat parchment or foolscap or red tape, but they eat the luncheon crumbs."
                                            },
                                            {
                                                "example_id": "ea999a51-baa0-47fb-9f44-628ea3430f14",
                                                "sense_id": "28270e5f-19fe-3e6b-9c4a-85d568fceec8",
                                                "text": "Never found Hattie and they never found the shack\nNever made the trip back in\nThere was a parchment note they found tacked to a stump\nSaid: Don't come lookin' again."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f230a889-590a-3ed6-bcd8-a62d73b3d60c",
                                        "entry_id": "32bf9d19-6d67-379c-bfd4-b46e8dff85ab",
                                        "glosses": [
                                            "A document made on such material."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d7df82e5-f11d-37dc-97ee-9c4665f05b63",
                                        "entry_id": "32bf9d19-6d67-379c-bfd4-b46e8dff85ab",
                                        "glosses": [
                                            "A diploma (traditionally written on parchment)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
