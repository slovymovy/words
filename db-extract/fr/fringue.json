                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fc8fe66f-f0cb-3119-8540-66c867cef0d7",
                                        "entry_id": "91822c45-59c2-3118-ad11-b4ef4b82b8dd",
                                        "glosses": [
                                            "Clothing, especially for work or of rough appearance."
                                        ],
                                        "tags": [
                                            "British",
                                            "US",
                                            "dated",
                                            "informal",
                                            "plural",
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e04f8940-3048-4f4c-9be9-3b7c55f62388",
                                                "sense_id": "fc8fe66f-f0cb-3119-8540-66c867cef0d7",
                                                "text": "I looked at what I could see of my rough blue duds, which I had plenty of opportunity of contrasting with the gay attire of the citizens we had come across; […]"
                                            },
                                            {
                                                "example_id": "d8af8d26-bc1d-4af9-a24e-b7a89d44f2c4",
                                                "sense_id": "fc8fe66f-f0cb-3119-8540-66c867cef0d7",
                                                "text": "“I don't know how you and the ‘head,’ as you call him, will get on, but I do know that if you call my duds a ‘livery’ again there'll be trouble. […]”"
                                            },
                                            {
                                                "example_id": "1756d5f0-3701-4590-87d3-38da1a5c2be5",
                                                "sense_id": "fc8fe66f-f0cb-3119-8540-66c867cef0d7",
                                                "text": "They grab his duds and his picks as well. They hoy him down to the pit of hell. Down you go and fare ye well. You dirty blackleg miner."
                                            },
                                            {
                                                "example_id": "c1b75bb1-f3df-4592-902a-7d55c5fe8fcb",
                                                "sense_id": "fc8fe66f-f0cb-3119-8540-66c867cef0d7",
                                                "text": "We were hard-pressed to find anyone who actually skis in these designer duds, but someone's buying the stuff: Hilfiger's ski and boardwear line grosses around $25 million per year […]"
                                            },
                                            {
                                                "example_id": "4ba06451-e19e-4efe-91a0-710d7e7c38d9",
                                                "sense_id": "fc8fe66f-f0cb-3119-8540-66c867cef0d7",
                                                "text": "JESSE:Badger? Where you been keeping yourself? Nice duds."
                                            },
                                            {
                                                "example_id": "a3d852a1-645b-431a-b1bf-1d9ecd3a3ad7",
                                                "sense_id": "fc8fe66f-f0cb-3119-8540-66c867cef0d7",
                                                "text": "Scavenger: Nice duds. Better watch your back. There's probably already a dozen people planning to kill you for them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5649e26c-a8be-3269-874e-d04ce216186d",
                                        "entry_id": "91822c45-59c2-3118-ad11-b4ef4b82b8dd",
                                        "glosses": [
                                            "One's personal property."
                                        ],
