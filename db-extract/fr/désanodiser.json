                        "glosses": [
                            "Faire perdre son caractère anodisé (par exemple pour enlever la couleur) à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f6033c1-0d1d-451d-a95d-a162c7fc0dcd",
                                "sense_id": "9bb6d06c-ad01-34e4-bfa5-0833c9b9d9f9",
                                "text": "Par contre, que veux-tu désanodiser ? Parce qu'avec du papier de verre ou de la laine de fer + eau avec produit vaisselle, c'est possible !"
                            },
                            {
                                "example_id": "ca4547b8-f7bc-40ef-b07c-5b607fd8bf93",
                                "sense_id": "9bb6d06c-ad01-34e4-bfa5-0833c9b9d9f9",
                                "text": "J'ai désanodisé un châssis complet !"
                            },
                            {
                                "example_id": "2e78525c-d070-4ed7-a764-b4c6fbc2118b",
                                "sense_id": "9bb6d06c-ad01-34e4-bfa5-0833c9b9d9f9",
                                "text": "L'un de vous a-t-il déjà désanodisé une grosse pièce comme ça avec une technique imparable ?"
                            }
                        ]
