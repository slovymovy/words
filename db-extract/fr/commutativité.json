                        "form_id": "7b89c244-5276-48eb-af48-de162335fa97",
                        "entry_id": "c967877f-0c0a-36d4-b88b-d9e272bcc25a",
                        "tags": [
                            "plural"
                        ],
                        "form": "commutativités"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "48a51088-bb03-3a9a-b7f6-41109313640d",
                        "entry_id": "c967877f-0c0a-36d4-b88b-d9e272bcc25a",
                        "glosses": [
                            "Équivalence des prestations, du point de vue juridique."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "0820c6fb-e3a9-3d46-a217-56dc97e7e6cc",
                        "entry_id": "c967877f-0c0a-36d4-b88b-d9e272bcc25a",
                        "glosses": [
                            "Opération dont le résultat n’est pas modifié quand on change (permute) l’ordre des facteurs ou des termes, comme l’addition et la multiplication."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ae76907-ce2b-4cf8-bbaa-82e2305eba37",
                                "sense_id": "0820c6fb-e3a9-3d46-a217-56dc97e7e6cc",
                                "text": "Supposons que nous nous demandions si une certaine propriété, par exemple la commutativité de la multiplication, est prouvable à partir des axiomes des corps (en supposant cette commutativité non incluse dans la liste des axiomes)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a301e2c5-26ce-4494-b7af-7ac7fec10709",
                        "source_entry_id": "c967877f-0c0a-36d4-b88b-d9e272bcc25a",
                        "target_lang_word": "Kommutativgesetz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kommutativgesetz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "06712376-f394-3b64-ae7c-ad2404bc8ac0",
                                        "entry_id": "928eecdf-2e5f-3bba-b77a-9fde0447b021",
                                        "glosses": [
                                            "Gesetz über eine mathematische Struktur, das besagt, dass eine bestimmte Operation in dieser Struktur kommutativ ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3ce219a-c8dc-4288-ab73-a2c1556291af",
                                                "sense_id": "06712376-f394-3b64-ae7c-ad2404bc8ac0",
                                                "text": "Das Kommutativgesetz der Addition lässt sich mathematisch so beschreiben: a + b = b + a."
                                            },
                                            {
                                                "example_id": "5395ead4-15d6-4f9d-9bdc-76be44a9f5e7",
                                                "sense_id": "06712376-f394-3b64-ae7c-ad2404bc8ac0",
                                                "text": "Es gibt kein Kommutativgesetz der Potenz, denn die Potenz ist nicht kommutativ."
                                            },
                                            {
                                                "example_id": "92e307a8-73d3-4fe1-8ac0-af43c2303b8e",
                                                "sense_id": "06712376-f394-3b64-ae7c-ad2404bc8ac0",
                                                "text": "Die beiden Kommutativgesetze gelten auch für den Körper der komplexen Zahlen."
                                            },
                                            {
                                                "example_id": "aa1d868e-2f3f-4949-a652-2466ea170c3f",
                                                "sense_id": "06712376-f394-3b64-ae7c-ad2404bc8ac0",
                                                "text": "In einer Summe kann man Summanden vertauschen (Kommutativgesetz) und Klammern setzen oder weglassen (Assoziativgesetz), ohne dass sich der Wert des Terms ändert."
                                            },
                                            {
                                                "example_id": "8eb66159-bb11-43cc-9c8c-159fabb1e2ac",
                                                "sense_id": "06712376-f394-3b64-ae7c-ad2404bc8ac0",
                                                "text": "„Diese Eigenschaften heißen Kommutativgesetz und Assoziativgesetz.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5cb81188-9050-42b9-98ab-e4587d498f9e",
                        "source_entry_id": "c967877f-0c0a-36d4-b88b-d9e272bcc25a",
