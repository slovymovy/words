                    }
                ],
                "senses": [
                    {
                        "sense_id": "241d3de7-6d55-3971-ab18-19d46fbd068f",
                        "entry_id": "9a33924c-0fe1-3517-b434-e8f56a6dc94f",
                        "glosses": [
                            "Spielabschnitt beim Curling"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0fc3d044-b5c3-4944-a927-1c1662fb551f",
                                "sense_id": "241d3de7-6d55-3971-ab18-19d46fbd068f",
                                "text": "„Die beiden Mannschaften wechseln sich mit ihren Spielzügen ab. Sobald alle Steine in einem End gespielt worden sind, wird das Resultat festgehalten. Ein Spiel dauert in der Regel zehn Ends.“"
                            },
                            {
                                "example_id": "63ff4529-cf59-41f5-8fef-aa2c68900ece",
                                "sense_id": "241d3de7-6d55-3971-ab18-19d46fbd068f",
                                "text": "„Den Amerikanern, die im »Ice Cube« von Sotschi selbst Fehler machten, reichten zwei verkorkste Ends der Deutschen, in denen Jahr und Teamkollege Felix Schulze jeweils vier Steine herschenkten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
