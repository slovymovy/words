                        "examples": [
                            {
                                "example_id": "f6711764-18f2-45ad-a749-4568692bda81",
                                "sense_id": "49d3ea4c-44c1-348b-bca0-8d22b17d781f",
                                "text": "Om te voorkomen dat de plantenziekte zich verder verspreidt, raadt de NVWA reizigers aan geen plantjes of stekjes uit Zuid-Europa mee naar huis te nemen."
                            },
                            {
                                "example_id": "1f3616fa-d46c-4ef6-9b31-b9bab61c98ac",
                                "sense_id": "49d3ea4c-44c1-348b-bca0-8d22b17d781f",
                                "text": "Het gevreesde tomatenvirus is voor het eerst aangetroffen in Nederland. Minister Schouten (Landbouw) meldt in een brief aan de Tweede Kamer dat de plantenziekte is gevonden bij een tomatenproducent in het Westland. Bij een andere bedrijf is sprake van een verdenking."
                            },
                            {
                                "example_id": "9fbb5f70-7f5a-4b73-85bd-e00ef7722791",
                                "sense_id": "49d3ea4c-44c1-348b-bca0-8d22b17d781f",
                                "text": "Doordat een plantenziekte vorig jaar de papavervelden in Afghanistan trof, is de wereldwijde productie van opium, de grondstof voor heroïne, met 38 procent gedaald. Dat meldde vandaag de VN-organisatie tegen drugs en criminaliteit (Unodc)."
                            }
                        ]
                    }
