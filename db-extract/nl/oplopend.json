        "nl-extract.jsonl": [
            {
                "entry_id": "0f4f66ff-6132-3db0-88ee-ff88a186fa74",
                "word": "oplopend",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "52655077-4cb1-3a78-aa55-d6ed71756353",
                        "entry_id": "0f4f66ff-6132-3db0-88ee-ff88a186fa74",
                        "glosses": [
                            "hellend, steeds hoger wordend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96574418-e565-4309-9394-157ef6fa7a41",
                                "sense_id": "52655077-4cb1-3a78-aa55-d6ed71756353",
                                "text": "De kwartronde vergaderzaal is uitgevoerd in gewapend beton en heeft een oplopend dak met radiaal geplaatste spanten."
                            }
                        ]
                    },
                    {
                        "sense_id": "017f4eab-2013-3113-ba4c-e51e6ac87a1a",
                        "entry_id": "0f4f66ff-6132-3db0-88ee-ff88a186fa74",
                        "glosses": [
                            "een steeds hoger niveau bereikend, stijgend"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "6162f9b6-8a34-4a06-b3c5-924224f95e85",
                                "sense_id": "017f4eab-2013-3113-ba4c-e51e6ac87a1a",
                                "text": "Het is overigens voor het eerst dat er voor het feest op de UT kaartjes gekocht moeten worden. In het verleden waren Bevrijdingsfeesten altijd gratis. „Maar wij kunnen er - met alle oplopende kosten - niet meer omheen”, zegt de woordvoerder. „Bovendien krijgen wij - in tegenstelling tot bijvoorbeeld het festival in Zwolle - geen euro subsidie.”"
                            },
                            {
                                "example_id": "95c0a5a7-7adc-4721-b3cf-bd14dd4f40d9",
                                "sense_id": "017f4eab-2013-3113-ba4c-e51e6ac87a1a",
                                "text": "Ze proberen de frustrerende onmacht te bezweren van een samenleving die gevangen zit in een oplopend conflict en niet in staat is haar meest kwetsbare leden - kleine kinderen - te beschermen."
                            }
                        ]
                    },
                    {
                        "sense_id": "2f31acab-3b0c-389d-a6a9-120d29849fe3",
                        "entry_id": "0f4f66ff-6132-3db0-88ee-ff88a186fa74",
                        "glosses": [
                            "erg emotioneel wordend, opvliegend"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "7c4f55d1-1b8e-42d4-92f7-942d3317e376",
                                "sense_id": "2f31acab-3b0c-389d-a6a9-120d29849fe3",
                                "text": "Bewaar uw kalmte; langs vaderszijde zijt gij van een oplopend geslacht, ofschoon verscheidene familieleden beproefden deze hartstocht te beteugelen."
                            }
                        ]
                    }
