                "senses": [
                    {
                        "sense_id": "d95e1c60-aa36-3594-851a-a68d26d40c60",
                        "entry_id": "9ee6a38c-8a83-3248-ae12-2d47459ae0b6",
                        "glosses": [
                            "kantiges Gesteinskorn im Sortiment von 4 bis 100 Millimeter"
                        ],
                        "tags": [
                            "Bauwirtschaft"
                        ],
                        "examples": [
                            {
                                "example_id": "5870f0c1-ab42-4cd8-91e9-4ba51e4ccea9",
                                "sense_id": "d95e1c60-aa36-3594-851a-a68d26d40c60",
                                "text": "Kantkorn ist die optimale Unterlage für jede Pflasterung."
                            },
                            {
                                "example_id": "2b0d1ab6-4506-4d87-aa7b-7bd746b0e759",
                                "sense_id": "d95e1c60-aa36-3594-851a-a68d26d40c60",
                                "text": "Hinweis: Falls Sie nicht genügend Splitt für Ihr Projekt finden, können Sie ebenfalls auf Kantkorn-Mischungen setzen."
                            },
                            {
                                "example_id": "68bda074-d69c-401e-9fb1-dc5be1af4667",
                                "sense_id": "d95e1c60-aa36-3594-851a-a68d26d40c60",
                                "text": "Die Arbeit befasst sich mit der aus zentralgemischtem Kantkorn (ZGK) hergestellten oberen Tragschicht."
                            },
                            {
                                "example_id": "91e4c546-8e7f-4c23-b0a3-ad8678ef3a72",
                                "sense_id": "d95e1c60-aa36-3594-851a-a68d26d40c60",
                                "text": "Basis der neuen Methode ist die teilweise oder vollständige Substitution des bisher üblichen und laut Richtlinien auch vorgeschriebenen Kantkorns durch Rundkorn."
                            },
                            {
                                "example_id": "7ae170e7-3528-4c22-b7a2-ad104fcfb9d1",
                                "sense_id": "d95e1c60-aa36-3594-851a-a68d26d40c60",
                                "text": "Der Drainageschotter wird in Burg produziert. Für „Häuslbauer“, die manuell arbeiten, empfehlen wir das Kantkorn 20/40, für alle anderen das billigere Kantkorn 40/70."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
