                "senses": [
                    {
                        "sense_id": "5649e842-cdba-3394-a2ad-360982a3edb5",
                        "entry_id": "d3890be1-a991-3713-a7f5-8f4e86ae342d",
                        "glosses": [
                            "Aufwendungen oder Ausgaben [2], welche die Repräsentation [3, 4] betreffen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "679b5d4d-3783-4606-809f-e5a703d2e552",
                                "sense_id": "5649e842-cdba-3394-a2ad-360982a3edb5",
                                "text": "„Die Nutzung eines Sportwagens kann im Einzelfall zu nichtabzugsfähigen Repräsentationsaufwendungen im Sinne des § 4 führen.“"
                            },
                            {
                                "example_id": "5599bb83-7613-4e7a-af9b-d97b468d6a26",
                                "sense_id": "5649e842-cdba-3394-a2ad-360982a3edb5",
                                "text": "„Wir haben uns aber auch entschieden, zum Beispiel die Repräsentationsaufwendungen wieder auf das Niveau zurückzufahren, das unter Werner Faymann üblich war, und die Steigerungen, die es da im letzten Jahr gegeben hat, wieder rückgängig zu machen.“"
                            },
                            {
                                "example_id": "a6a7f6e4-c6d2-44ba-ac5f-faf0493558c4",
                                "sense_id": "5649e842-cdba-3394-a2ad-360982a3edb5",
                                "text": "„Aus den Ausgaben zu 1.1 können auch Zuwendungen aus besonderer Veranlassung für karitative Einrichtungen oder Zwecke und für die Übernahme von Schirmherrschaften bis höchstens 14000 € jährlich geleistet sowie Repräsentationsaufwendungen von Bediensteten des Deutschen Bundestages mit Protokollaufgaben nach Maßgabe von Richtlinien gedeckt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
