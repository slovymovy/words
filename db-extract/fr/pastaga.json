                        "examples": [
                            {
                                "example_id": "a78bca64-77ed-4691-84ee-6e81a4e34b75",
                                "sense_id": "bd3e00b4-223e-3a76-89de-5eff8f5cf850",
                                "text": "Moi mon bonheur, c’est la pêche et le pastaga."
                            },
                            {
                                "example_id": "e39a9417-51b3-4d8b-8e45-b1ad71e2bf57",
                                "sense_id": "bd3e00b4-223e-3a76-89de-5eff8f5cf850",
                                "text": "Le coup de la serviette au pastaga : La technique consiste à faire passer au détenu un linge qui a été trempé dans le pastis, puis séché. Il suffit ensuite de tremper à nouveau ce linge dans l’eau pour déguster tranquillement un apéritif en cachette des matons."
                            },
                            {
                                "example_id": "79f99d07-fdde-4d0a-b423-adda0a11ddd6",
                                "sense_id": "bd3e00b4-223e-3a76-89de-5eff8f5cf850",
                                "text": "Oh là là, oh là là; Sers-moi de l’amour dans un verre de pastaga; Oh là là, oh là là; On a fait le tour de Verlaine et de Kafka."
                            }
                        ]
                    }
