                        "target_lang_word": "hergebruiken",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hergebruiken",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "09402b76-8a98-359c-825d-6472dde4e8d9",
                                        "entry_id": "4b7f0214-818c-3304-b390-1424226ca6b4",
                                        "glosses": [
                                            "afval opnieuw een goede bestemming geven"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d75c6e45-cae1-4999-90ba-6b17028e8acc",
                                                "sense_id": "09402b76-8a98-359c-825d-6472dde4e8d9",
                                                "text": "We moeten van het gas af, er zouden warmtepompen moeten komen in onze huizen, elektrische auto’s moeten normaler worden, alle gebouwen geïsoleerd, afval bestaat niet meer want we hergebruiken alles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e7443a08-9b8d-314e-89b3-94976c3a8830",
                                        "entry_id": "4b7f0214-818c-3304-b390-1424226ca6b4",
                                        "glosses": [
                                            "iets wat eerder bedacht of gemaakt is opnieuw toepassen in een andere situatie"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0fb4261-8e6b-44d8-b5a6-555d4263cf1e",
                                                "sense_id": "e7443a08-9b8d-314e-89b3-94976c3a8830",
                                                "text": "In de digitale wereld is het heel gemakkelijk om een nummer geheel of gedeeltelijk te kopiëren en te hergebruiken."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5c6d3c27-c061-48b1-ae1e-e3f0ff5e4e24",
                        "source_entry_id": "5cddcf1d-ef0b-3384-a3e0-d95f876189a6",
                        "source_sense_description": "to use again",
                        "target_lang_word": "réutiliser",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "réutiliser",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ca963d85-2771-3b62-a697-e9a576e4e092",
                                        "entry_id": "954aa5f0-cb01-3baa-bc1a-492fb3d3c3cb",
                                        "glosses": [
                                            "Utiliser de nouveau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d25ed2d-2a5c-4435-be4d-bef371dc0f39",
                                                "sense_id": "ca963d85-2771-3b62-a697-e9a576e4e092",
                                                "text": "Cette interprétation n'empêche pas pour autant d'envisager que ce chemin soit datable aussi de l’époque romaine et qu'il ait été réutilisé à l’époque médiévale."
                                            },
                                            {
                                                "example_id": "3e1bf1e5-59e2-45ba-a889-b0b4f2ff2c7e",
                                                "sense_id": "ca963d85-2771-3b62-a697-e9a576e4e092",
                                                "text": "Nous n’avons toujours pas le droit de réutiliser nos eaux alors que nous avons nos stations d’épuration, nous filtrons et nous avons investi dans des systèmes très perfectionnés (osmose inverse à Lamballe par exemple)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
