{
    "word_family": [
        "lucky",
        "luckily",
        "unlucky",
        "unluckily",
        "luckless"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6818613c-5d81-3955-963b-cef3a9a4ff23",
                    "sense_definition": "A superstitious feeling or force believed to bring fortune or success, often used in wishes.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "chance_fortune",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I wish you lots of <w>luck</w> for the exam tomorrow.",
                            "target_lang_translations": {
                                "ru": "Желаю тебе большой <w>удачи</w> на завтрашнем экзамене.",
                                "zh": "祝你明天的考试<w>运气</w>好。"
                            }
                        },
                        {
                            "text": "He blew on the dice for <w>luck</w> before rolling them.",
                            "target_lang_translations": {
                                "ru": "Он подул на кости <w>на удачу</w>, прежде чем бросить их.",
                                "zh": "他在掷骰子前吹了口气，希望能带来<w>好运</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fortune"
                    ],
                    "common_phrases": [
                        "good luck",
                        "wish someone luck",
                        "for luck",
                        "best of luck"
                    ],
                    "target_lang_definitions": {
                        "ru": "Суеверное чувство или сила, которая, как считается, приносит счастье или успех; часто используется в пожеланиях.",
                        "zh": "一种被认为能带来好运或成功的迷信力量，常用于祝福。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уда́ча",
                                "target_lang_sense_clarification": "благоприятная сила"
                            },
                            {
                                "target_lang_word": "сча́стье",
                                "target_lang_sense_clarification": "в значении «на счастье»"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "运气",
                                "target_lang_sense_clarification": "指代好运的抽象概念"
                            },
                            {
                                "target_lang_word": "好运",
                                "target_lang_sense_clarification": "用于祝愿的场合"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4a5e8133-4212-31a2-8f65-3d11023c742b",
                    "sense_definition": "A favourable event or situation that happens by chance.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "chance_fortune",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I couldn't believe my <w>luck</w> when I found a fifty dollar bill on the street.",
                            "target_lang_translations": {
                                "ru": "Я не мог поверить своему <w>везению</w>, когда нашел на улице пятидесятидолларовую купюру.",
                                "zh": "我在街上捡到一张五十美元的钞票时，简直不敢相信自己的<w>运气</w>。"
                            }
                        },
                        {
                            "text": "Sometimes it takes a bit of <w>luck</w> to achieve great success.",
                            "target_lang_translations": {
                                "ru": "Иногда требуется немного <w>удачи</w>, чтобы добиться большого успеха.",
                                "zh": "有时候取得巨大的成功需要一点<w>运气</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "good fortune",
                        "good luck",
                        "serendipity",
                        "fluke",
                        "godsend"
                    ],
                    "antonyms": [
                        "bad luck",
                        "misfortune"
                    ],
                    "common_phrases": [
                        "bit of luck",
                        "stroke of luck",
                        "believe one's luck",
                        "pure luck"
                    ],
                    "target_lang_definitions": {
                        "ru": "Благоприятное событие или ситуация, происходящие случайно.",
                        "zh": "偶然发生的有利事件或情况。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "везе́ние",
                                "target_lang_sense_clarification": "стечение обстоятельств"
                            },
                            {
                                "target_lang_word": "уда́ча",
                                "target_lang_sense_clarification": "счастливый случай"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "运气",
                                "target_lang_sense_clarification": "指代偶然的机遇"
                            },
                            {
                                "target_lang_word": "走运",
                                "target_lang_sense_clarification": "指代幸运的境遇"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f3f316e8-bccb-37fa-a9e2-a4eeff6f2696",
                    "sense_definition": "Something that happens to someone by chance, whether good or bad.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "chance_fortune",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Winning the raffle is just a matter of <w>luck</w>.",
                            "target_lang_translations": {
                                "ru": "Выигрыш в лотерею — это просто вопрос <w>везения</w>.",
                                "zh": "抽奖能否中奖纯粹是<w>运气</w>问题。"
                            }
                        },
                        {
                            "text": "Gilbert had some bad <w>luck</w> yesterday when he lost his wallet.",
                            "target_lang_translations": {
                                "ru": "Гилберта вчера постигла <w>неудача</w>, когда он потерял свой кошелек.",
                                "zh": "吉尔伯特昨天丢了钱包，真是<w>倒霉</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "chance",
                        "accident",
                        "fortune",
                        "fate",
                        "destiny"
                    ],
                    "common_phrases": [
                        "bad luck",
                        "matter of luck",
                        "hard luck"
                    ],
                    "target_lang_definitions": {
                        "ru": "То, что происходит с кем-то случайно, будь то хорошее или плохое.",
                        "zh": "某人偶然遇到的事情，无论好坏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "везе́ние",
                                "target_lang_sense_clarification": "случайность"
                            },
                            {
                                "target_lang_word": "слу́чай",
                                "target_lang_sense_clarification": "обстоятельство"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "运气",
                                "target_lang_sense_clarification": "指代随机的遭遇"
                            },
                            {
                                "target_lang_word": "造化",
                                "target_lang_sense_clarification": "指代命运的安排"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "44c7fd54-657d-398e-9e05-a3d344b8d84c",
                    "sense_definition": "Success in finding or achieving something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "success_result",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I tried for ages to find a pair of blue suede shoes, but didn't have any <w>luck</w>.",
                            "target_lang_translations": {
                                "ru": "Я целую вечность пытался найти пару синих замшевых туфель, но без <w>успеха</w>.",
                                "zh": "我找了半天想买一双蓝色麂皮鞋，但一直没<w>运气</w>找到。"
                            }
                        },
                        {
                            "text": "He has a lot of <w>luck</w> with gardening, so his plants always grow well.",
                            "target_lang_translations": {
                                "ru": "Ему сопутствует <w>удача</w> в садоводстве, поэтому его растения всегда хорошо растут.",
                                "zh": "他在园艺方面很有<w>运气</w>，所以他种的植物总是长得很好。"
                            }
                        }
                    ],
                    "synonyms": [
                        "hap",
                        "fortune"
                    ],
                    "common_phrases": [
                        "have luck",
                        "any luck",
                        "no luck",
                        "luck with"
                    ],
                    "target_lang_definitions": {
                        "ru": "Успех в поиске или достижении чего-либо.",
                        "zh": "在寻找或实现某事方面的成功。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "успе́х",
                                "target_lang_sense_clarification": "достижение цели"
                            },
                            {
                                "target_lang_word": "уда́ча",
                                "target_lang_sense_clarification": "результат"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "运气",
                                "target_lang_sense_clarification": "指代达成目标的成功率"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0f6fc835-eff2-3b52-aeb5-e3cf51f2d54e",
                    "sense_definition": "The results of a random number generator in a game.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "technical_rng",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The creators of tool-assisted speedruns often manipulate <w>luck</w> to get the most favorable results.",
                            "target_lang_translations": {
                                "ru": "Создатели спидранов с инструментальной поддержкой часто манипулируют <w>удачей</w>, чтобы получить наиболее благоприятные результаты.",
                                "zh": "工具辅助速通的创作者经常操纵<w>随机性</w>以获得最有利的结果。"
                            }
                        },
                        {
                            "text": "In this strategy game, winning depends more on skill than on <w>luck</w>.",
                            "target_lang_translations": {
                                "ru": "В этой стратегической игре победа зависит больше от мастерства, чем от <w>везения</w>.",
                                "zh": "在这款策略游戏中，获胜更多取决于技巧而非<w>运气</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "gaming"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Результаты генератора случайных чисел в игре.",
                        "zh": "游戏中随机数生成器的结果。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уда́ча",
                                "target_lang_sense_clarification": "игровой шанс"
                            },
                            {
                                "target_lang_word": "везе́ние",
                                "target_lang_sense_clarification": "рандом"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "随机性",
                                "target_lang_sense_clarification": "指代游戏中的随机因素"
                            },
                            {
                                "target_lang_word": "运气",
                                "target_lang_sense_clarification": "指代游戏中的随机成分"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9aab7e0c-b723-3c7a-9b74-fb95f9c4847e",
                    "sense_definition": "To find or get something good by chance.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I <w>lucked</w> upon a seat on the crowded train just as the doors closed.",
                            "target_lang_translations": {
                                "ru": "Мне <w>посчастливилось</w> найти место в переполненном поезде как раз в тот момент, когда двери закрылись.",
                                "zh": "就在车门关闭时，我<w>碰巧</w>在拥挤的火车上找到了一个座位。"
                            }
                        },
                        {
                            "text": "She <w>lucked</w> into a fantastic job offer without even applying for it.",
                            "target_lang_translations": {
                                "ru": "Ей <w>повезло</w> получить фантастическое предложение о работе, даже не подавая заявления.",
                                "zh": "她甚至没投简历就<w>走运</w>地得到了一份极好的工作邀请。"
                            }
                        }
                    ],
                    "synonyms": [
                        "chance"
                    ],
                    "common_phrases": [
                        "luck into",
                        "luck upon",
                        "luck on"
                    ],
                    "target_lang_definitions": {
                        "ru": "Найти или получить что-то хорошее случайно.",
                        "zh": "偶然发现或得到好东西。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "повезти́",
                                "target_lang_sense_clarification": "случиться удаче"
                            },
                            {
                                "target_lang_word": "посчастли́виться",
                                "target_lang_sense_clarification": "выпасть счастью"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "碰巧",
                                "target_lang_sense_clarification": "偶然获得"
                            },
                            {
                                "target_lang_word": "走运",
                                "target_lang_sense_clarification": "幸运地获得"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "7e514353-ad70-38f0-94b1-3fc1e369c7bb",
                    "sense_definition": "A surname transferred from the given name.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Luck</w> signed the documents yesterday.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Лак</w> подписал документы вчера.",
                                "zh": "<w>拉克</w>先生昨天签署了文件。"
                            }
                        },
                        {
                            "text": "I wonder if the <w>Luck</w> family is related to the famous author.",
                            "target_lang_translations": {
                                "ru": "Интересно, состоит ли семья <w>Лак</w> в родстве с известным писателем.",
                                "zh": "我不知道<w>拉克</w>一家是否与那位著名作家有亲戚关系。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия, перешедшая от личного имени.",
                        "zh": "由名字演变而来的姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Лак",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "拉克",
                                "target_lang_sense_clarification": "姓氏音译"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}