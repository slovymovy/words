                                "target_lang_word": "но́мер социа́льного страхова́ния",
                                "target_lang_sense_clarification": "документ (США)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "社会安全号码",
                                "target_lang_sense_clarification": "美国身份识别号码"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a9003732-ac1c-3776-ae8c-d1394baa5fcd",
