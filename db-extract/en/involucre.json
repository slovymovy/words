                    },
                    {
                        "translation_id": "7ebe04c1-71b1-408a-b498-7eff1e040283",
                        "source_entry_id": "06c5771f-3821-384d-8e83-010dda36dc05",
                        "source_sense_id": "fc078169-452f-3318-bc83-3704e54ffdc7",
                        "source_sense_description": "conspicuous bract",
                        "target_lang_word": "involucre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "involucre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0bde780b-6483-3753-a5c6-f087441aa3c1",
                                        "entry_id": "674736f2-dcbb-390e-893c-d21124956bea",
                                        "glosses": [
                                            "Ensemble de bractées formant une collerette à la base d’une ombelle ou d’un capitule."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8da1b88a-a481-42d9-aab5-6b77193e6cdd",
                                                "sense_id": "0bde780b-6483-3753-a5c6-f087441aa3c1",
                                                "text": "Prendre soin d’enlever l’involucre qui risque de moisir, puis stocker les noisettes au frais dans un local aéré à l’abri des rongeurs qui en sont friands."
                                            },
                                            {
                                                "example_id": "290f2fcd-352a-4648-8c56-f15b830dad19",
                                                "sense_id": "0bde780b-6483-3753-a5c6-f087441aa3c1",
                                                "text": "L’involucre, cette collerette de bractées finement découpées qui entourent l’inflorescence chez certaines espèces, chez les ombellifères en particulier, ne constitue jamais, comme chez la nigelle de Damas, l’attrait principal de la plante."
                                            },
                                            {
                                                "example_id": "b39396fe-5052-4816-80ce-95333fd177be",
                                                "sense_id": "0bde780b-6483-3753-a5c6-f087441aa3c1",
                                                "text": "Tous les vendredis de fin d’été, l’entrepreneur, assisté par ses proches, fait sa cueillette à la main et part à l’aube, direction les marchés de la périphérie parisienne, pour vendre ses noisettes fraîches, encore lovées dans leur involucre (la gangue verte qui les protège durant leur développement)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7f93ed7-5517-3f1e-89b8-9987913b8e92",
                                        "entry_id": "674736f2-dcbb-390e-893c-d21124956bea",
                                        "glosses": [
                                            "Ensemble de bractées formant une collerette à la base de certaines fleurs isolées comme les anémones et simulant un calice."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9084bafe-0496-4001-adc7-9f4ee743c8ab",
                                                "sense_id": "f7f93ed7-5517-3f1e-89b8-9987913b8e92",
                                                "text": "L’Œillet des Chartreux (Dianthus Carthusianorum L.), à racine presque ligneuse; le calicule, formé de nombreuses écailles brunâtres ou rougeâtres, est entouré d’un involucre constitué par deux bractées longuement aristées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f4cc8b51-5e9f-3af1-8a41-3618a8dedce3",
                                        "entry_id": "674736f2-dcbb-390e-893c-d21124956bea",
                                        "glosses": [
                                            "Contenu de la vésicule acrosomienne."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
