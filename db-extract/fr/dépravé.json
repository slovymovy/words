                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verdorven",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "bf2620ed-fa13-341e-b6bc-d4589ec62578",
                                        "entry_id": "9bb7126b-38f5-3aa8-ae5a-098198b4659d",
                                        "glosses": [
                                            "voltooid deelwoord van verderven"
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "905185c1-cb2c-4949-b874-b7f6f7a29db4",
                                                "sense_id": "bf2620ed-fa13-341e-b6bc-d4589ec62578",
                                                "text": "En hebben hun goden in het vuur geworpen; want zij waren geen goden, maar het werk van mensenhanden, hout en steen; daarom hebben zij die verdorven."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "verdorven",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "b3708dba-04da-3b04-b2ee-9410393b2c96",
                                        "entry_id": "f4973b0e-30d3-36f8-86e8-80835c0d7c82",
                                        "glosses": [
                                            "helemaal rot, door en door slecht (in morele zin)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32d074f8-b384-4e52-a02a-645035d98741",
                                                "sense_id": "b3708dba-04da-3b04-b2ee-9410393b2c96",
                                                "text": "Waar we niets mee opschieten om het geweld te begrijpen zijn filosofische en theologische beschouwingen over zoiets als ‘de menselijke natuur’. Die zou verdorven en slecht zijn, ‘de mens’ zou een kwaadaardig en zondig wezen zijn."
                                            },
                                            {
                                                "example_id": "37df466c-249f-4302-b67f-3fd89ef410f7",
                                                "sense_id": "b3708dba-04da-3b04-b2ee-9410393b2c96",
                                                "text": "Over Snapchat heeft Merel geen goed woord over. “Het is gewoon een verdorven medium. Dat je daar anonieme accounts kunt aanmaken, zorgt ervoor dat kinderen elkaar de vreselijkste dingen kunnen aandoen terwijl ze hun werkelijke identiteit schuilhouden.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "676c41e7-9067-4ef7-b454-3b00779a2861",
                        "source_entry_id": "b86f6d0d-9200-3b78-bc1b-7c4d84872640",
                        "source_sense_id": "3fc55716-cabc-3def-aad7-abd2fd9ccc69",
                        "target_lang_word": "порочный",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "порочный",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "7039c715-a77a-3dc9-9996-67d9e580d414",
                                        "entry_id": "3b9b5cc1-a273-3c85-a15b-8032bb75bd15",
                                        "glosses": [
                                            "подверженный порокам, безнравственный"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00e6ea53-443c-4455-9077-a58de2c229ae",
                                                "sense_id": "7039c715-a77a-3dc9-9996-67d9e580d414",
                                                "text": "Он порывисто и крепко обнял ее, осыпал поцелуями ее колени и руки, потом, когда она что-то бормотала ему и вздрагивала от воспоминаний, он пригладил ее волосы и, всматриваясь ей в лицо, понял, что эта несчастная, порочная женщина для него единственный близкий, родной и незаменимый человек."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d91f192a-dcd5-3170-8a8e-141a74547efa",
                                        "entry_id": "3b9b5cc1-a273-3c85-a15b-8032bb75bd15",
                                        "glosses": [
                                            "противоречащий требованиям морали, нравственности"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73372985-9c0c-4111-8384-33024e57d3e2",
                                                "sense_id": "d91f192a-dcd5-3170-8a8e-141a74547efa",
                                                "text": "Ещё непорочная своими поступками, она уже в пламенных письмах Волынского умела напитать свое воображение и сердце всеми обольщениями порочной страсти."
                                            },
                                            {
                                                "example_id": "b80d3599-1e27-4df2-a4b8-5af6416d9426",
                                                "sense_id": "d91f192a-dcd5-3170-8a8e-141a74547efa",
                                                "text": "Ровно через неделю, а именно в среду после третьего урока, когда Ахинеев стоял среди учительской и толковал о порочных наклонностях ученика Высекина, к нему подошёл директор и отозвал его в сторону."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fd1114f0-6899-32a2-9bd9-7a1b76253619",
                                        "entry_id": "3b9b5cc1-a273-3c85-a15b-8032bb75bd15",
                                        "glosses": [
                                            "свидетельствующий о склонности к пороку, безнравственности"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c563cacd-2877-4655-bd27-6cf3dfc74769",
                                                "sense_id": "fd1114f0-6899-32a2-9bd9-7a1b76253619",
                                                "text": "Но когда она опять обернулась к своим друзьям, то глаза уже были сухи и на загадочных, порочных и властных губах блестела непринужденная улыбка."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21c17f42-af2a-30cd-a7b1-ee9751edc6a6",
                                        "entry_id": "3b9b5cc1-a273-3c85-a15b-8032bb75bd15",
                                        "glosses": [
                                            "неправильный, заключающий в себе ошибку"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35bbc71a-b363-40db-b2b5-ac64609547bb",
                                                "sense_id": "21c17f42-af2a-30cd-a7b1-ee9751edc6a6",
                                                "text": "Куда более порочна была сама идея раздельного преподавания всех дисциплин."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
