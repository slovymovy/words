        "fr-extract.jsonl": [
            {
                "entry_id": "740b4266-da5f-3fae-8df2-2592009c06d9",
                "word": "foudroyé",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b482af49-8533-44b3-bfe7-81f449cf9e00",
                        "entry_id": "740b4266-da5f-3fae-8df2-2592009c06d9",
                        "tags": [
                            "plural"
                        ],
                        "form": "foudroyés"
                    },
                    {
                        "form_id": "4dea1eaa-9a65-40d0-8671-e14612ee5cea",
                        "entry_id": "740b4266-da5f-3fae-8df2-2592009c06d9",
                        "tags": [
                            "une fille, une femme"
                        ],
                        "form": "foudroyée"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "eb3b8c14-cb81-3a3f-a61d-0a75b5384234",
                        "entry_id": "740b4266-da5f-3fae-8df2-2592009c06d9",
                        "glosses": [
                            "Celui qui a été frappé par la foudre (de façon létale ou non)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11d5907d-272a-42e2-9002-c9cd30897868",
                                "sense_id": "eb3b8c14-cb81-3a3f-a61d-0a75b5384234",
                                "text": "Il faut déshabiller promptement le foudroyé, le coucher en long dans un fossé de terre molle, le couvrir de trois à quatre pouces de terre, et de temps en temps rafraichir la figure par de légères injections d’eau. L’expérience a prouvé que ce moyen était infaillible, et que trois heures suffisent pour rendre à la lumiere les malheureux que la foudre a seulement asphyxiés."
                            },
                            {
                                "example_id": "fba8b631-c30c-4d4a-a870-50cacac6de72",
                                "sense_id": "eb3b8c14-cb81-3a3f-a61d-0a75b5384234",
                                "text": "Un individu est frappé par la foudre, il est sans connaissance, insensible, sans mouvement, ni pouls, ni respiration ; il est froid, même roide,… auscultez le cœur immédiatement, car si vous entendez quelques battements, vous serez certain que le foudroyé n’est pas mort."
                            },
                            {
                                "example_id": "cfb0f48e-7d0a-4a18-b8c1-01ccbe0cb0ff",
                                "sense_id": "eb3b8c14-cb81-3a3f-a61d-0a75b5384234",
                                "text": "Le foudroyé avait les cheveux et les vêtements roussis par la foudre."
                            },
                            {
                                "example_id": "d3701041-7b1c-47f0-b2b8-ce4d7e3a102d",
                                "sense_id": "eb3b8c14-cb81-3a3f-a61d-0a75b5384234",
                                "text": "Il avait l’air d’un foudroyé et elle ne pouvait que redire son nom avec un mélange de pitié et de terreur, comme si elle eût craint qu’il ne lui répondit de sa voix de cauchemar."
                            },
                            {
                                "example_id": "3e304007-7620-49ed-97cf-84b42ec637af",
                                "sense_id": "eb3b8c14-cb81-3a3f-a61d-0a75b5384234",
                                "text": "Tant fait qu’on a bien un foudroyé par lustre. Y en a que ça tue sec, qu’on retrouve noircis comme de suie. En est d’autres qui s’en sortent."
                            }
                        ]
                    },
                    {
                        "sense_id": "f6f114e5-8492-30f2-a4ad-ca7111f77087",
                        "entry_id": "740b4266-da5f-3fae-8df2-2592009c06d9",
                        "glosses": [
                            "Celui qui a été tué par la foudre."
                        ],
                        "tags": [
                            "rare",
                            "specifically"
                        ],
                        "note": "Dans ce cas souvent cité en opposition à fulguré",
                        "examples": []
                    },
                    {
                        "sense_id": "c5a15c7c-6be6-36d5-a430-8dade6b96298",
                        "entry_id": "740b4266-da5f-3fae-8df2-2592009c06d9",
                        "glosses": [
                            "Celui qui a subit une électrisation."
                        ],
                        "tags": [
                            "analogy",
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "3d6a165d-9c5e-45f6-aab5-2c5e36702061",
                                "sense_id": "c5a15c7c-6be6-36d5-a430-8dade6b96298",
                                "text": "Ce médecin offrit au gouvernement de ressusciter le premier condamné qui serait exécuté. Hier, à New-York, l’expérience a eu lieu, et, quoique ayant subi une décharge évaluée à 4,000 volts, le patient a été ramené à la vie au bout de sept à huit minutes. […] les expérimentateurs ont obtenu la résurrection en imprimant aux bras un balancement régulier seize fois par minute. Au bout de quelques instants, le foudroyé a pu remuer les paupières, la vision est revenue, puis la mémoire avec la lucidité."
                            }
                        ]
                    }
                ],
