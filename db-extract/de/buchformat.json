                            {
                                "example_id": "474bd89e-3b5a-449f-b585-d4e368baa81a",
                                "sense_id": "ce838e9c-c2e0-3a85-9379-60f599f7f609",
                                "text": "„Achten Sie aber darauf, dass das gewünschte Buchformat (Breite und Länge) bei Ihrem Dienstleister verfügbar ist.“"
                            },
                            {
                                "example_id": "9e7a6e05-2aa9-4d73-80f3-b9a0d531c86c",
                                "sense_id": "ce838e9c-c2e0-3a85-9379-60f599f7f609",
                                "text": "„Die Verwaltung wird in Kenntniß gesetzt, daß die Drucklegung dieser Verordnung als … Nachtrag zu dem im Buchformate erschienenen Betriebsreglement vom Jahre 1874 in deutscher, czechischer, polnischer und italienischer Sprache gleichzeitig durch die hiesige Hof- und Staatsdruckerei veranlaßt wird.“"
                            }
                        ],
