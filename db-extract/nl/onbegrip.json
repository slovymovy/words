                "senses": [
                    {
                        "sense_id": "7fe7381a-6a55-33da-a186-2ed9d1e8a8dd",
                        "entry_id": "b2b79c64-c469-37e3-8526-8ad06b256926",
                        "glosses": [
                            "het onvermogen om iets of iemand te begrijpen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6df8bdab-f424-4c3f-a715-c521b8d2a320",
                                "sense_id": "7fe7381a-6a55-33da-a186-2ed9d1e8a8dd",
                                "text": "We vonden het erg naar dat hij zoveel onbegrip toonde."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7c17c2c2-8639-44db-a8d1-2ba6c2e27274",
                        "source_entry_id": "b2b79c64-c469-37e3-8526-8ad06b256926",
                        "source_sense_id": "7fe7381a-6a55-33da-a186-2ed9d1e8a8dd",
                        "target_lang_word": "Unverständnis",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Unverständnis",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6ae475b9-dad2-3f7b-93bf-93e32ce77d04",
                                        "entry_id": "5393f869-47b9-3b5d-aa42-9c85935bfe49",
                                        "glosses": [
                                            "Unfähigkeit, jemanden oder etwas zu verstehen, nachzuvollziehen; Eigenschaft/Zustand, kein Verständnis zu haben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2017a93a-cfe5-4608-88a2-74e46adbf3a8",
                                                "sense_id": "6ae475b9-dad2-3f7b-93bf-93e32ce77d04",
                                                "text": "„Doch Unverständnis ist niemals eine akzeptable Entschuldigung dafür, etwas nicht zu tun, was Gott uns aufträgt.“"
                                            },
                                            {
                                                "example_id": "2e5398ad-3396-4e7d-a6a9-34cd7bf6ff1e",
                                                "sense_id": "6ae475b9-dad2-3f7b-93bf-93e32ce77d04",
                                                "text": "„Der Vorschlag der Europäischen Kommission, Gas- und Kernkraftwerke in die sogenannte EU-Taxonomie aufzunehmen, stößt bei vielen auf Unverständnis.“"
                                            },
                                            {
                                                "example_id": "41859ae6-bfe1-45d4-a7e2-b928cef1410d",
                                                "sense_id": "6ae475b9-dad2-3f7b-93bf-93e32ce77d04",
                                                "text": "„Gott weiß um das Verlangen der Menschen, auf dieser Erde in Frieden zu leben und ihr Unverständnis gegenüber seiner Vorgehensweise und Entscheidungen.“"
                                            },
                                            {
                                                "example_id": "89900e24-7096-4844-b76f-b6eb7dbec42c",
                                                "sense_id": "6ae475b9-dad2-3f7b-93bf-93e32ce77d04",
                                                "text": "„Gegenseitiges Unverständnis tritt auf, wenn Menschen unterschiedliche Ansichten, Vorerfahrungen oder Bedürfnisse zu demselben Thema haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a0cc3549-a889-4bb6-aa85-03917a94d0b7",
                        "source_entry_id": "b2b79c64-c469-37e3-8526-8ad06b256926",
                        "source_sense_id": "7fe7381a-6a55-33da-a186-2ed9d1e8a8dd",
                        "target_lang_word": "Unverständlichkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Unverständlichkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "52e58574-cd2a-3dde-afa7-7d3c92981a14",
                                        "entry_id": "b03bfcb4-76e9-3cb9-b198-2b305a57162c",
                                        "glosses": [
                                            "Eigenschaft eines sprachlichen Textes, eines musikalischen oder künstlerischen Werkes, durch Rezipienten nicht angemessen aufgefasst werden zu können"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0befb3e-70da-443d-9785-73a5d52c21bd",
                                                "sense_id": "52e58574-cd2a-3dde-afa7-7d3c92981a14",
                                                "text": "„Außerdem wurden die Buchstaben unmöglich, sie glichen in ihrer Unverständlichkeit den Zeichen in den Büchern der Schreibkundigen in Tiflis.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0459b05d-d350-4ca1-86af-3daac1181c78",
                        "source_entry_id": "b2b79c64-c469-37e3-8526-8ad06b256926",
                        "source_sense_id": "7fe7381a-6a55-33da-a186-2ed9d1e8a8dd",
                        "target_lang_word": "incomprehension",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "incomprehension",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "14a59547-c71e-30fb-a97f-ffa49b90303b",
                                        "entry_id": "4b365d61-2789-31d6-8b59-6f950720c771",
                                        "glosses": [
                                            "Lack of comprehension or understanding; inability to understand."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b781e977-c71e-4b5c-b30c-d1d466c8891d",
                                                "sense_id": "14a59547-c71e-30fb-a97f-ffa49b90303b",
                                                "text": "The aide gave the old men in Ward Two their medicine, and they joked with her. Shevek watched with dull incomprehension."
                                            },
                                            {
                                                "example_id": "a4111952-6580-48d6-b437-fc94004edb17",
                                                "sense_id": "14a59547-c71e-30fb-a97f-ffa49b90303b",
                                                "text": "Stephen blushed; and his father looked from one to the other in a state of utter incomprehension."
                                            },
                                            {
                                                "example_id": "16675328-264f-4206-877c-88b0982d2661",
                                                "sense_id": "14a59547-c71e-30fb-a97f-ffa49b90303b",
                                                "text": "(...) and the wearied worker, borne at evening through crowded undergrounds, might read his name with a listless incomprehension."
                                            },
                                            {
                                                "example_id": "8763da53-7281-475d-b6de-aef8a3a18073",
                                                "sense_id": "14a59547-c71e-30fb-a97f-ffa49b90303b",
                                                "text": "Simon broke off and turned to Piggy who was looking at him with an expression of derisive incomprehension."
                                            },
                                            {
                                                "example_id": "6e4429fd-15a7-4548-8e47-cb2cbf6cd57a",
                                                "sense_id": "14a59547-c71e-30fb-a97f-ffa49b90303b",
                                                "text": "1995, Gary Wolf, \"The Curse of Xanadu\", Wired Magazine\nAs a guest lecturer in Nelson's class, Miller ran through his ideas for a Xanadu-like software system. Afterward, he was approached by one of the students, Stuart Greene. Miller asked Greene what the reaction to his ideas had been. Not so good, Greene informed him. As always, the class had listened in dumb incomprehension. They seldom understood what Nelson was talking about […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "95d753dd-706d-4408-8f71-d62d681decf4",
                        "source_entry_id": "b2b79c64-c469-37e3-8526-8ad06b256926",
                        "source_sense_id": "7fe7381a-6a55-33da-a186-2ed9d1e8a8dd",
                        "target_lang_word": "incompréhension",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "incompréhension",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3f49c9cb-8154-3264-9c5d-a686f6b4af6b",
                                        "entry_id": "56e79dfe-41e0-31de-a780-c3525f3b461c",
                                        "glosses": [
                                            "État de ce qui est incompris."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9addd466-86f7-411d-bbea-cbf0e24d9380",
                                                "sense_id": "3f49c9cb-8154-3264-9c5d-a686f6b4af6b",
                                                "text": "Devant cette morne incompréhension, Jacques se sentit pris de rage et de désespoir."
                                            },
                                            {
                                                "example_id": "9cd0e4e6-6004-4a1d-a781-e6497fc44021",
                                                "sense_id": "3f49c9cb-8154-3264-9c5d-a686f6b4af6b",
                                                "text": "[…], car les Anglais se distinguent par une extraordinaire incompréhension de la lutte de classe ; leur pensée est restée très dominée par des influences médiévales : la corporation, […], leur apparaît toujours comme l’idéal de l’organisation ouvrière ; […]."
                                            },
                                            {
                                                "example_id": "db411093-ee32-4038-9d9c-f01e1be52024",
                                                "sense_id": "3f49c9cb-8154-3264-9c5d-a686f6b4af6b",
                                                "text": "Mais, en réalité, cette conception est née de l’incompréhension par l’Occident de l’essence des autres mondes, qui se trouvent abusivement mesurés à l’aune occidentale."
                                            },
                                            {
                                                "example_id": "f93d297c-c86c-4166-a188-30264b381508",
                                                "sense_id": "3f49c9cb-8154-3264-9c5d-a686f6b4af6b",
                                                "text": "La distance créée par le vieillissement du texte est certes goûtée et entre dans le jeu de l’esthétique littéraire. Mais, s’il faut répéter cette évidence, elle est aussi et d’abord subie. Elle est source d’incompréhension."
                                            },
                                            {
                                                "example_id": "6bd4362b-1f1f-4b54-813b-8305e98bf6fc",
                                                "sense_id": "3f49c9cb-8154-3264-9c5d-a686f6b4af6b",
                                                "text": "Notre incompréhension devant l’inconnu a dressé aux quatre coins du monde un atlas mythologique. Des centaines d'endroits où la virginité et le merveilleux se sont mués en eldorados, en paradis perdus, en enfers verts, en mirages et en abîmes."
                                            },
                                            {
                                                "example_id": "d0e7a4d1-646d-4df9-b07d-99da3f68284c",
                                                "sense_id": "3f49c9cb-8154-3264-9c5d-a686f6b4af6b",
                                                "text": "L'histoire, n'en déplaise aux élitistes et aux complotistes, faces complémentaires d'une même incompréhension, est faite par les masses, aisées, pauvres ou médiocres."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
