                ],
                "senses": [
                    {
                        "sense_id": "5d6e6e02-e086-3844-be12-a24821c11b02",
                        "entry_id": "44e2fb0d-8cf2-3b5d-951b-1db3f10f7a84",
                        "glosses": [
                            "Oberbegriff physikalischer Theorien, die sich mit Quantisierung oder Quantelung beschäftigen, dass also verschiedene physikalische Größen (zum Beispiel Energie, Drehimpuls, Ladung) nicht jeden beliebigen Wert annehmen können, sondern nur festgelegte diskrete Werte"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "f22b1618-3583-4751-9d2a-3fb240467bc6",
                                "sense_id": "5d6e6e02-e086-3844-be12-a24821c11b02",
                                "text": "„Nach der Quantentheorie können der Zeitraum, an dem ein Quantenteilchen einen bestimmten Raum verlässt, und die Energie dieses Quantenteilchens nicht beide beliebig genau bestimmt werden.“"
                            },
                            {
                                "example_id": "27cc2be5-b565-41d0-94bf-9083f5fa454d",
                                "sense_id": "5d6e6e02-e086-3844-be12-a24821c11b02",
                                "text": "„Trotz dieses Unterschieds erweist sich der Anti-de-Sitter-Raum als sehr nützlich bei der Suche nach Quantentheorien für Raumzeit und Gravitation.“"
                            },
                            {
                                "example_id": "64f85a81-0a4a-4250-b448-a61ddd035b5f",
                                "sense_id": "5d6e6e02-e086-3844-be12-a24821c11b02",
                                "text": "„Bei der Quantentheorie handelt es sich für Einstein lediglich um ein Problem, das mit dem heutigen Stand der Wissenschaft zusammenhängt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
