                                                "text": "La réunion des lèvres d’une plaie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54ad6a92-8f20-376d-b410-2ff743a0ed03",
                                        "entry_id": "479b55e4-890a-3a03-aa6c-4eb813a39658",
                                        "glosses": [
                                            "Réconciliation."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cbc43385-b246-40f0-82e5-7f1e8ab33c48",
                                                "sense_id": "54ad6a92-8f20-376d-b410-2ff743a0ed03",
                                                "text": "La réunion des deux partis."
                                            },
                                            {
                                                "example_id": "abfbe418-4468-4ce0-9ce1-72c7852177ff",
                                                "sense_id": "54ad6a92-8f20-376d-b410-2ff743a0ed03",
                                                "text": "Il voulut opérer la réunion de l’église grecque à l’église romaine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ac92b0d-b1f2-35e6-9e61-9838d3e9dff8",
                                        "entry_id": "479b55e4-890a-3a03-aa6c-4eb813a39658",
                                        "glosses": [
                                            "En parlant de fiefs, de domaines, etc., action de rejoindre une chose démembrée au tout dont elle faisait partie ; ou action de joindre pour la première fois une chose à une autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9a23a64-1de8-4296-a0dc-264006515bd6",
                                                "sense_id": "6ac92b0d-b1f2-35e6-9e61-9838d3e9dff8",
                                                "text": "Le conseil persiste dans l'avis qu'il a déjà émis l'année dernière, pour la réunion à la ville de Réthel d'une portion de la commune de Sault-lès-Réthel."
                                            },
                                            {
                                                "example_id": "a181c0bf-4e42-43c5-8799-669754eb39d2",
                                                "sense_id": "6ac92b0d-b1f2-35e6-9e61-9838d3e9dff8",
                                                "text": "La réunion de la Bourgogne, de la Normandie au domaine royal."
                                            },
                                            {
                                                "example_id": "d00bfac8-18fe-4778-9ec2-3abcc112874c",
                                                "sense_id": "6ac92b0d-b1f2-35e6-9e61-9838d3e9dff8",
                                                "text": "La réunion de la Lorraine à la France."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d8fbb8e6-2117-31e9-a0ad-18ba60e976a6",
                                        "entry_id": "479b55e4-890a-3a03-aa6c-4eb813a39658",
                                        "glosses": [
                                            "Action de rassembler ce qui est épars ou le résultat de cette action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f1ebfc3-4ad7-45ba-a705-60431fa12680",
                                                "sense_id": "d8fbb8e6-2117-31e9-a0ad-18ba60e976a6",
                                                "text": "En effet, il n'y a pas si longtemps que la réunion des deux éléments de ce titre — préhistoire et Amérique — aurait suscité beaucoup de réticence chez plus d'un américaniste."
                                            },
                                            {
                                                "example_id": "c24a104a-a6f3-44ee-abc7-537700b5b6e8",
                                                "sense_id": "d8fbb8e6-2117-31e9-a0ad-18ba60e976a6",
                                                "text": "La réunion de tous ces petits ruisseaux forme une rivière."
                                            },
                                            {
                                                "example_id": "05002863-22a1-4c73-b643-b4e3dc104e0e",
                                                "sense_id": "d8fbb8e6-2117-31e9-a0ad-18ba60e976a6",
                                                "text": "La réunion de ces preuves, de ces faits établit son droit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8492c6c7-b7bc-3c4b-8d38-26f098198870",
                                        "entry_id": "479b55e4-890a-3a03-aa6c-4eb813a39658",
                                        "glosses": [
                                            "Assemblée de personnes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7197fee6-7d91-4641-9855-f854408cf1b8",
                                                "sense_id": "8492c6c7-b7bc-3c4b-8d38-26f098198870",
                                                "text": "Un lieu de réunion. Une salle de réunion."
                                            },
                                            {
                                                "example_id": "a3ef1772-1dc0-4237-b74a-8d8203467402",
                                                "sense_id": "8492c6c7-b7bc-3c4b-8d38-26f098198870",
                                                "text": "Il vient souvent à nos réunions."
                                            },
                                            {
                                                "example_id": "74468ce7-6a54-4b6c-b643-9df71b27e4f7",
                                                "sense_id": "8492c6c7-b7bc-3c4b-8d38-26f098198870",
                                                "text": "Une réunion de savants, de gens de lettres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f626d63-eae5-32fe-bbbe-594d482e565f",
                                        "entry_id": "479b55e4-890a-3a03-aa6c-4eb813a39658",
                                        "glosses": [
                                            "Assemblée de personnes dans l'objectif d'une prise de décision, directe (délibération) ou indirecte (consultation)."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "295af2a7-8580-4f64-9ec4-c617258aa7f6",
                                                "sense_id": "5f626d63-eae5-32fe-bbbe-594d482e565f",
                                                "text": "Réunion du comité de pilotage."
                                            },
                                            {
                                                "example_id": "89cf491a-98c4-4aa7-9c2e-a762f02ef59e",
                                                "sense_id": "5f626d63-eae5-32fe-bbbe-594d482e565f",
                                                "text": "Aujourd'hui c'est le jour de la réunion consultative mensuelle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a5595f4-8058-3ed5-a3f7-c4b58fa1274a",
                                        "entry_id": "479b55e4-890a-3a03-aa6c-4eb813a39658",
                                        "glosses": [
                                            "Réunion ensembliste, ensemble contenant les éléments des ensembles considérés, synonyme de union."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cbb32e65-593c-4bf2-81f1-5f67a26ee110",
                                                "sense_id": "6a5595f4-8058-3ed5-a3f7-c4b58fa1274a",
                                                "text": "L’ensemble des nombres réels est la réunion de l’ensemble des réels négatifs et de l’ensemble des réels positifs."
                                            }
