                    "frequency": "High",
                    "semantic_group_id": "option",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wir haben zwei <w>Möglichkeiten</w>, um das Problem rechtzeitig zu lösen."
                        },
                        {
                            "text": "Du musst dich jetzt für eine der beiden <w>Möglichkeiten</w> entscheiden."
                        }
                    ],
                    "synonyms": [
