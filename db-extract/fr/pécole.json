                ],
                "senses": [
                    {
                        "sense_id": "8a2528de-d31e-3f0b-b66d-bd70a8227810",
                        "entry_id": "cd93e33c-c436-3d43-9f9d-58d9b27d4491",
                        "glosses": [
                            "Crotte de bique."
                        ],
                        "tags": [
                            "Cévennes"
                        ],
                        "examples": [
                            {
                                "example_id": "124a83f5-64ca-4f87-8bb0-1ffefe0e3d06",
                                "sense_id": "8a2528de-d31e-3f0b-b66d-bd70a8227810",
                                "text": "Des matins frisquets où la rosée perle dans les bruyères, des toiles d'araignées lourdes comme de filets de pêche, des bouts de laine bleue ou rouge accrochés aux buissons, des pécoles noires semées sur la drailhe comme des bonbons à la réglisse, des chaussures qui chantent, légères, dans le lit de cet oued desséché et les odeurs de la vie."
                            },
                            {
                                "example_id": "0613bbdb-e6cf-4431-a9c0-b08ee3391535",
                                "sense_id": "8a2528de-d31e-3f0b-b66d-bd70a8227810",
                                "text": "Il savait reconnaître leur passage au détail infime : un brin d'herbe écarté, une minuscule trace de griffes, un poil accroché à un buisson, une « pécole »."
                            },
                            {
                                "example_id": "0f32f77b-7923-458e-9bfc-eeeb9ed2887f",
                                "sense_id": "8a2528de-d31e-3f0b-b66d-bd70a8227810",
                                "text": "Elle appuyait toujours la tête sous la queue des chèvres pendant la traite. « J'aime pas qu'elles égrènent leur chapelet dans la mousse, disait-elle ; après vous vous plaindrez que le lait a goût « à pécole ». »"
                            }
                        ]
                    }
                ],
