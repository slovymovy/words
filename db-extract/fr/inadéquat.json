                                        "sense_id": "01b51046-6675-372a-8f7c-df36547efb43",
                                        "entry_id": "3a5a2a55-d4d7-3311-8712-66d3e270d146",
                                        "glosses": [
                                            "Not adequate; lacking in quality or quantity required; insufficient for a purpose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c761ec15-37af-45c8-b47e-7479dafabf97",
                                                "sense_id": "01b51046-6675-372a-8f7c-df36547efb43",
                                                "text": "inadequate resources"
                                            },
                                            {
                                                "example_id": "6e33d876-59b1-49ae-9f42-30adc64342ef",
                                                "sense_id": "01b51046-6675-372a-8f7c-df36547efb43",
                                                "text": "inadequate representation"
                                            },
                                            {
                                                "example_id": "2f89d0a5-da60-4628-9dc8-3261b27aea1d",
                                                "sense_id": "01b51046-6675-372a-8f7c-df36547efb43",
                                                "text": "I had not yet seen Mrs. Kennedy. I wondered with what inadequate words I could try to console her."
                                            },
                                            {
                                                "example_id": "9715dfe0-96f7-4196-96f8-746c27ba1fc7",
                                                "sense_id": "01b51046-6675-372a-8f7c-df36547efb43",
                                                "text": "In a convulsion that has caught many in Brazil and beyond by surprise, waves of protesters denounced their leaders for dedicating so many resources to cultivating Brazil’s global image by building stadiums for international events, when basic services like education and health care remain woefully inadequate."
                                            },
                                            {
                                                "example_id": "7becd9ad-c29d-4add-a951-e138fc9240e7",
                                                "sense_id": "01b51046-6675-372a-8f7c-df36547efb43",
                                                "text": "By the 21st century, the clearly inadequate facilities needed to be replaced, so the area was rebuilt and modernised between 2009-13 as part of regeneration efforts focused upon the wider area."
                                            },
                                            {
                                                "example_id": "cdad34a6-5cb4-4977-a71e-4da2db3559b0",
                                                "sense_id": "01b51046-6675-372a-8f7c-df36547efb43",
                                                "text": "“Russia is a terrorist country whose leader is an inadequate person”. Putin's failings are evident to the “entire world”, he said."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "inadequate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "30b6cbb4-a8f0-3ff2-9382-a5c3c818e0d6",
                                        "entry_id": "58260bd8-afa9-32ac-bd0f-47b183153a75",
                                        "glosses": [
                                            "A person who is inadequate."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dceda84b-11c3-477a-b53b-215db70f90ad",
                                                "sense_id": "30b6cbb4-a8f0-3ff2-9382-a5c3c818e0d6",
                                                "text": "Thus, at some critical level of unemployment, “the unemployed” becomes a negative reference group of inadequates, the hardcore unemployed […]"
