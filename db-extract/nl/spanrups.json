                        "sense_id": "d04e7763-5a64-3399-8e3d-6bb86fc68e6d",
                        "entry_id": "a94123bf-25b5-36fb-8f7d-4727b0edc664",
                        "glosses": [
                            "een vlinderlarve, inzonderheid van een van de spanners van Geometridae, die zich voortbeweegt door zich in een lus te buigen en het achterlijf vlak achter het voorlijf te plaatsen"
                        ],
                        "tags": [
                            "vlinders"
                        ],
                        "examples": [
                            {
                                "example_id": "c1edb33b-9fd5-4a07-8fb0-67c312e083a8",
                                "sense_id": "d04e7763-5a64-3399-8e3d-6bb86fc68e6d",
                                "text": "⧖ De Afbeelding en beschryving , welke de Heer Röfel ons geeft, van eene roodbruine Spanrups, mitsgaders van den daaruit voortkomenden Manlyken Vlinder en deszelfs vleugellooze Wyfje, D. III. T. XIV. en XL., Fig. 6., heeft zoveel overeenkomst met het bygebragte door den Heer Sepp, dat we niet wel kunnen twyfeien , of ze hebben beide dezelfde soort waargenoomen."
                            }
                        ]
                    }
                ],
                "translations": [
