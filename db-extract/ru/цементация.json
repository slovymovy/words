                        "cross_references": [
                            {
                                "target_word": "cimentation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6f8b6197-c728-311b-9295-962a3b592733",
                                        "entry_id": "0c0cea50-b07a-31d6-a265-9f67a6555ceb",
                                        "glosses": [
                                            "Action de cimenter ; ou résultat de cette action."
                                        ],
                                        "tags": [
                                            "Didactique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2adb3e92-32ff-457d-b2aa-259c7a535836",
                                                "sense_id": "6f8b6197-c728-311b-9295-962a3b592733",
                                                "text": "Le terme « carreleur » désigne toute personne qui […] polit à la main ou à la machine, à sec ou par voie humide, toute surface de granit, marbre ou tout autre matériau de même nature, et fait la cimentation et le masticage des interstices."
                                            },
                                            {
                                                "example_id": "029e139c-2f5c-486f-8fb9-123807d3adcf",
                                                "sense_id": "6f8b6197-c728-311b-9295-962a3b592733",
                                                "text": "D'autres opérations de cimentation pourraient être nécessaires."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "16fbd47b-57f8-3fda-b657-3f68b6ad92a9",
                                        "entry_id": "0c0cea50-b07a-31d6-a265-9f67a6555ceb",
                                        "glosses": [
                                            "Enrobage de déchets radioactifs à l’aide d’une matrice de conditionnement en mortier de ciment."
                                        ],
                                        "tags": [
                                            "Cycle du combustible nucléaire"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a20e07d0-48e1-3d31-9391-7e9fd3b4a3a7",
                                        "entry_id": "0c0cea50-b07a-31d6-a265-9f67a6555ceb",
                                        "glosses": [
                                            "Action par laquelle des éléments détritiques forment une roche compacte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b89401e8-30cd-4b08-9ab3-038a162ba230",
                                                "sense_id": "a20e07d0-48e1-3d31-9391-7e9fd3b4a3a7",
                                                "text": "Les sédiments marins qui se trouvent en milieu continental sont presque toujours affectés par une cimentation plus ou moins développée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "945a05d1-0626-3959-a251-8ab232745073",
                                        "entry_id": "0c0cea50-b07a-31d6-a265-9f67a6555ceb",
                                        "glosses": [
                                            "Affermissement, en parlant des liens humains ou sociaux."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b701420-e175-48ab-8918-9507c4b88245",
                                                "sense_id": "945a05d1-0626-3959-a251-8ab232745073",
                                                "text": "Il y a là un véritable partage, et une sorte de cimentation des liens, aussi : sœur, frère, sœur, beau-frère, assis ensemble à la table pour prendre un repas."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f44f5e97-09d0-4439-917a-b25f82b52725",
                        "source_entry_id": "c35a15fb-4896-314f-b3ec-de70317dd70f",
                        "source_sense_id": "8e681097-e4e9-309e-8d96-d85bb0f364e4",
                        "target_lang_word": "cémentation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cémentation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2064ba01-882b-3f61-8628-427a3fe8c32c",
                                        "entry_id": "ca4aa8db-62d0-34da-854e-5680d4610109",
                                        "glosses": [
                                            "Sorte de stratification qui consiste à entourer d’une poudre ou d'une pâte, appelée cément, un objet qu’on expose ensuite à une très forte chaleur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3fbd541-6a12-4b77-b243-55067c13e4dc",
                                                "sense_id": "2064ba01-882b-3f61-8628-427a3fe8c32c",
                                                "text": "Enfin, […], on a chauffé plusieurs heures le fer dans sa gaine de platine vers 1000° ou 1100°. […]; examinant le fer après les mesures, on l'a trouvé blanc et brillant à la surface et imprégné de platine intérieurement par cémentation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "043b76a6-6296-3f31-86cc-1732a422f825",
                                        "entry_id": "ca4aa8db-62d0-34da-854e-5680d4610109",
                                        "glosses": [
                                            "Méthode consistant à enrichir un acier en carbone, que ce soit de manière superficielle ou dans la masse. Initialement, cela se faisait en entourant l'acier de charbon et en chauffant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09f55c19-786a-4c3d-9916-862550e106b0",
                                                "sense_id": "043b76a6-6296-3f31-86cc-1732a422f825",
                                                "text": "L'acier fondu a sur l'acier de cémentation l’avantage de l'homogénéité, que ce dernier ne peut avoir. La cémentation s'y portant de la surface au centre, toutes les parties ne peuvent être cémentées au même degré."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b1c5bbc-79eb-3c76-8b57-319abd49df05",
                                        "entry_id": "ca4aa8db-62d0-34da-854e-5680d4610109",
                                        "glosses": [
                                            "Méthode d'extraction d'un métal présent sous forme de solution saline, à l'aide d'un autre métal, présent sous forme de poudre. La cémentation est une réaction d'oxydoréduction."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5b8efff4-7a16-3403-8dcf-4813b5cd7b5f",
                                        "entry_id": "ca4aa8db-62d0-34da-854e-5680d4610109",
                                        "glosses": [
                                            "Précipitation de sels à la surface d'une nappe phréatique."
                                        ],
                                        "tags": [],
