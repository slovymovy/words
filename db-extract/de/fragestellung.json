                ],
                "senses": [
                    {
                        "sense_id": "e52bba66-952b-3c19-a5b6-98066c939f10",
                        "entry_id": "89139ed3-9794-3f73-bb64-04ff82ed8ecb",
                        "glosses": [
                            "Tätigkeit des Formulierens einer Frage"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10f9ce10-a9ac-462e-aa2c-7e332dfd0e0a",
                                "sense_id": "e52bba66-952b-3c19-a5b6-98066c939f10",
                                "text": "Ich habe Deine konkrete Frage, die in Deiner Fragestellung steckt, nicht ganz verstanden!"
                            },
                            {
                                "example_id": "69994a59-7293-478f-a46d-f00b5c531d41",
                                "sense_id": "e52bba66-952b-3c19-a5b6-98066c939f10",
                                "text": "Kannst du deine Fragestellung noch präzisieren?"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3a1ad9a2-e352-362d-b626-6aa588de3a09",
                        "entry_id": "89139ed3-9794-3f73-bb64-04ff82ed8ecb",
                        "glosses": [
                            "thematisiertes oder zu erörterndes Problem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cfe09dc4-8cb8-4e30-994d-c1d0b7e11860",
                                "sense_id": "3a1ad9a2-e352-362d-b626-6aa588de3a09",
                                "text": "„So wird man für feine Strukturdetails in der Lunge eine dünnere Schichtdicke wählen als bei der Fragestellung nach einem entzündlichen Prozess im Mediastinum oder Abdomen.“"
                            },
                            {
                                "example_id": "4eea3d4b-4c38-434d-a4fb-e2a7c6f38352",
                                "sense_id": "3a1ad9a2-e352-362d-b626-6aa588de3a09",
                                "text": "Die Fragestellung: Wird die Menschheit jemals die Erde verlassen? kann nicht mit Bestimmtheit beantwortet werden, denn dazu fehlt es an ausreichendem technischen Fortschritt."
                            },
                            {
                                "example_id": "8eba0167-33b2-4a39-b0e3-c10c82092798",
                                "sense_id": "3a1ad9a2-e352-362d-b626-6aa588de3a09",
                                "text": "„Überblickt man von hier aus die Fragestellungen der pragmatischen Dialektologie, so fällt auf, daß an keiner einzigen Stelle speziell vom dialektalen Wortschatz, sondern immer nur generell vom Dialekt als einer Varietät eines Diasystems die Rede war.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "58af38b3-eaa0-454f-8b0b-65959b7d8dc8",
                        "source_entry_id": "89139ed3-9794-3f73-bb64-04ff82ed8ecb",
                        "source_sense_id": "e52bba66-952b-3c19-a5b6-98066c939f10",
                        "source_sense_description": "Tätigkeit des Formulierens einer Frage",
                        "target_lang_word": "questionnement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "questionnement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e7638d9b-32c9-35de-9bc5-e2b0e85a9c88",
                                        "entry_id": "2a803bae-b2d5-30ba-9629-6db872ba5ce4",
                                        "glosses": [
                                            "Fait de poser un ensemble de questions ; ensemble de questions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83dfb4cd-00f7-4cce-aed3-0a50dfefc6d4",
                                                "sense_id": "e7638d9b-32c9-35de-9bc5-e2b0e85a9c88",
                                                "text": "Un questionnement efficace permet de recueillir un maximum d’informations en un minimum de temps."
                                            },
                                            {
                                                "example_id": "26e2cc40-0ba1-4b07-8877-e6de123bb473",
                                                "sense_id": "e7638d9b-32c9-35de-9bc5-e2b0e85a9c88",
                                                "text": "Curieux de toutes choses, il harcelait le vieil homme de ses questions. Sur le veld qui changeait sans cesse de couleur au gré des saisons ; sur les tisserands qui bâtissaient leurs minuscules huttes d’herbe sèche au sommet des grands arbres – des nids, l’avait corrigé Thabo – ; sur les nuées de cardinaux à la robe écarlate en été et qui s’envolaient par vagues à leur approche – on aurait dit le mouvement ample et ondulant d’un drap qu’on agite au vent ; sur la façon de dire « c’est beau » dans la langue des Zoulous. Mais plus encore que tout le reste, le garçonnet s’interrogeait sur sa mère. C’était devenu une véritable obsession au fil des ans. Et ses grands-parents ne pouvaient pas répondre à tous ses questionnements."
                                            },
                                            {
                                                "example_id": "21a98b50-6457-42c3-98ba-29b4709b3fab",
                                                "sense_id": "e7638d9b-32c9-35de-9bc5-e2b0e85a9c88",
                                                "text": "Avec Ceci est mon corps, Agathe Charnet explore la question des violences sexistes et sexuelles, mais aussi les questionnements d’une trentenaire, ses désirs et ses joies, avec humour et espièglerie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e2a217c5-5395-4b4a-892a-dd45819452ea",
                        "source_entry_id": "89139ed3-9794-3f73-bb64-04ff82ed8ecb",
                        "source_sense_id": "3a1ad9a2-e352-362d-b626-6aa588de3a09",
                        "source_sense_description": "thematisiertes oder zu erörterndes Problem",
                        "target_lang_word": "problématique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "problématique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "89907cbc-ad80-35d9-80aa-84fd8a42dd7a",
                                        "entry_id": "d16f238d-6de3-3188-b9eb-907bdbc39cd9",
                                        "glosses": [
                                            "Dont on peut douter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "874dd1db-52be-4425-b886-7ba72726e266",
                                                "sense_id": "89907cbc-ad80-35d9-80aa-84fd8a42dd7a",
                                                "text": "L’influence de l’électricité atmosphérique sur les congestions cérébrales est encore problématique."
                                            },
                                            {
                                                "example_id": "6d9b3fa2-e5c1-40a7-bd56-01dda1929658",
                                                "sense_id": "89907cbc-ad80-35d9-80aa-84fd8a42dd7a",
                                                "text": "C’était une grande chambre dont les murs, revêtus par l’humidité d’une teinte noirâtre, laissaient à peine deviner çà et là quelques restes problématiques d’une ancienne peinture à l’huile."
                                            },
                                            {
                                                "example_id": "9e6da3a3-ca6a-41e5-abc4-6afba196d82a",
                                                "sense_id": "89907cbc-ad80-35d9-80aa-84fd8a42dd7a",
                                                "text": "Le curé de Melotte […] n’était plus craint. Ses foudres de carton, ses tonnerres lointains, l’évocation des bûchers infernaux, la promesse des félicités paradisiaques dans un éden, somme toute, passablement morne et fort problématique, ne faisaient plus guère frémir que quelques vieilles dévotes et les gosses de neuf à onze ans."
                                            },
                                            {
                                                "example_id": "5e777e1e-f786-4b63-9096-b31263d84fdb",
                                                "sense_id": "89907cbc-ad80-35d9-80aa-84fd8a42dd7a",
                                                "text": "En ce qui a trait à l’approvisionnement en vaccins, devenu problématique en raison des retards de livraison au Canada annoncés récemment par Pfizer, François Legault a assuré que ce sujet est en tête de l’ordre du jour d’une rencontre cet après-midi avec ses homologues des provinces et d’une autre en soirée avec Justin Trudeau."
                                            },
                                            {
                                                "example_id": "5f2d6648-d8be-4567-8950-60fc32039f82",
                                                "sense_id": "89907cbc-ad80-35d9-80aa-84fd8a42dd7a",
                                                "text": "Les opérateurs sont donc appelés à accélérer les installations tout en soignant la qualité de ces dernières ; de quoi éviter de ne voir se multiplier les malfaçons, et autres installations problématiques rapportées par les internautes français encore aujourd’hui."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9fc33fb3-5329-3a2c-a16d-a58f7f25abde",
                                        "entry_id": "d16f238d-6de3-3188-b9eb-907bdbc39cd9",
                                        "glosses": [
                                            "Qui est difficile à interpréter, à comprendre par son caractère peu clair ou ambigu."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "problématique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0e33f989-2478-335e-b82b-6bdce22cbac6",
                                        "entry_id": "823ec38b-a456-350d-a48e-dc386b08f401",
                                        "glosses": [
                                            "Problème considéré du point de vue des différents aspects à traiter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32502a5f-16eb-4278-bbb4-707b1cc751ff",
                                                "sense_id": "0e33f989-2478-335e-b82b-6bdce22cbac6",
                                                "text": "Le 27 juin 2000, au nom de l’Office, l’intimé Samson adresse à Mᵐᵉ Claire V. de la Durantaye, rectrice à l’U.Q.T.R., une lettre (pièce R-1) posant en ces termes la problématique liée aux expertises biomédicales prescrites par des chiropraticiens : […]."
                                            },
                                            {
                                                "example_id": "c852e6cb-53fa-4ded-992c-69a27951e81c",
                                                "sense_id": "0e33f989-2478-335e-b82b-6bdce22cbac6",
                                                "text": "La problématique de l’intégrité des dirigeants renvoie à la question centrale du développement et du sous développement car elle soulève des préoccupations liées à la bonne ou mauvaise gestion, en un mot à la corruption."
                                            },
                                            {
                                                "example_id": "6aec0914-5c2e-4e62-b48b-828f562259f9",
                                                "sense_id": "0e33f989-2478-335e-b82b-6bdce22cbac6",
                                                "text": "Et malgré son visa, les mêmes problématiques auraient été soulevées lors de son arrivée à Montréal et lors de son départ de Toronto, a-t-il précisé, en ajoutant qu’il aurait finalement pu prendre ses vols après que le consul général s’en soit mêlé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c1bfe5b-436f-3861-bebe-82f55d9f2f06",
                                        "entry_id": "823ec38b-a456-350d-a48e-dc386b08f401",
                                        "glosses": [
                                            "Grille de lecture, d’interprétation d’un problème, ou de ce qu’on considère comme un problème."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a110035e-9226-4595-b1f3-10dcbaa0437f",
                                                "sense_id": "5c1bfe5b-436f-3861-bebe-82f55d9f2f06",
                                                "text": "Ce faisant, et en guise d’introduction aux chapitres suivants, j’essaie de cerner davantage la problématique du masque, telle qu’elle se présente dans les premières comédies de Molière."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
