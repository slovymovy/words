                                        "entry_id": "665b958c-6655-3af6-9808-7cbf8230f4d8",
                                        "glosses": [
                                            "Signe de ponctuation ‹ ; › de la forme d’une virgule avec un point suscrit."
                                        ],
                                        "tags": [],
