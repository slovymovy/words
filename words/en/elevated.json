    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "728fc774-5e80-3fa1-8bef-37571fcc950f",
                    "sense_definition": "Raised, usually above ground level.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "physical_height",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The train travels on an <w>elevated</w> track through the city center.",
                            "target_lang_translations": {
                                "ru": "Поезд идет по <w>надземному</w> пути через центр города.",
                                "de": "Der Zug fährt auf einer <w>erhöhten</w> Trasse durch das Stadtzentrum."
                            }
                        },
                        {
                            "text": "We stood on an <w>elevated</w> platform to get a better view of the stage.",
                            "target_lang_translations": {
                                "ru": "Мы стояли на <w>приподнятой</w> платформе, чтобы лучше видеть сцену.",
                                "de": "Wir standen auf einer <w>erhöhten</w> Plattform, um eine bessere Sicht auf die Bühne zu haben."
                            }
                        }
                    ],
                    "synonyms": [
                        "raised",
                        "high",
                        "lifted"
                    ],
                    "antonyms": [
                        "lowered",
                        "sunken",
                        "ground-level"
                    ],
                    "common_phrases": [
                        "elevated highway",
                        "elevated position",
                        "elevated platform"
                    ],
                    "target_lang_definitions": {
