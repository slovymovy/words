                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ccf1e28-a59a-4357-8496-c276b5a88ded",
                                "sense_id": "0f8a178f-329e-3254-8fe8-9899e5d1a5c6",
                                "text": "Het meisje heeft amandelvormige ogen."
                            },
                            {
                                "example_id": "47e4710e-d7a2-4267-8448-6a1b855dad8f",
                                "sense_id": "0f8a178f-329e-3254-8fe8-9899e5d1a5c6",
                                "text": "Haar lange benen, de niet-aflatende honger naar kennis, amandelvormige lichtbruine ogen die recht mijn ziel in kijken en onvermoeid lijken te peilen hoe ik eraan toe ben."
                            },
                            {
                                "example_id": "b62013d6-0e96-41fe-a37b-b7b9c1b8adb7",
                                "sense_id": "0f8a178f-329e-3254-8fe8-9899e5d1a5c6",
                                "text": "Ze droeg op de speciale dag een Fries oorijzer: twee ijzeren ronde versieringen klemden op haar slapen, naast haar amandelvormige donkere ogen."
                            }
                        ]
                    }
