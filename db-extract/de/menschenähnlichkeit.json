                        "sense_id": "3bcf7973-fa05-3b86-bf16-63ef5c037aeb",
                        "entry_id": "969337a0-0fe4-3226-aa82-ad4f9c87fa50",
                        "glosses": [
                            "Eigenschaft, menschenähnliche zu sein"
