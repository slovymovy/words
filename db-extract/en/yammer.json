    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "7798153a-2f73-3c61-9856-0804de5d8909",
                "word": "yammer",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "3ede66e9-1b98-3ed7-abbf-e28d5279ea92",
                        "entry_id": "7798153a-2f73-3c61-9856-0804de5d8909",
                        "glosses": [
                            "The act or noise of yammering."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "35a28b6b-73d9-4549-8a2b-1f6509dc07cc",
                                "sense_id": "3ede66e9-1b98-3ed7-abbf-e28d5279ea92",
                                "text": "The house is just as he had imagined it would be: rubbishy furniture, a clutter of ornaments (porcelain shepherdesses, cowbells, an ostrich-feather flywhisk), the yammer of the radio, the cheeping of birds in cages, cats everywhere underfoot."
                            }
                        ]
                    },
                    {
                        "sense_id": "679d2de7-8c8b-3333-bcd2-0d3d42d06a94",
                        "entry_id": "7798153a-2f73-3c61-9856-0804de5d8909",
                        "glosses": [
                            "A loud noise."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "e52d5ca3-6f42-42d8-bb22-a0e6fcf2fa23",
                                "sense_id": "679d2de7-8c8b-3333-bcd2-0d3d42d06a94",
                                "text": "The ungodly scream of Jap wings in the wind, and the blood-chilling snarl and yammer of their aerial machine gun and aerial cannon fire was enough to make the very ground shake and tremble."
                            }
                        ]
                    },
                    {
                        "sense_id": "a80d3d7d-ae42-3c56-ab0e-a04b2aaacf0e",
                        "entry_id": "7798153a-2f73-3c61-9856-0804de5d8909",
                        "glosses": [
                            "One who yammers."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "43d83314-ce0e-4d4e-8c99-0e7ccbbba6b4",
                        "source_entry_id": "7798153a-2f73-3c61-9856-0804de5d8909",
                        "source_sense_description": "The act or noise of yammering",
                        "target_lang_word": "Jammer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Jammer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f99dad9b-5e12-35cd-8e4a-55e00a0dff41",
                                        "entry_id": "168bc85f-8c00-3757-a4ac-be87d8949980",
                                        "glosses": [
                                            "Äußerung von Wehklagen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42b7d0b2-d0c3-43b0-bfba-bf8a7f8ba8ad",
                                                "sense_id": "f99dad9b-5e12-35cd-8e4a-55e00a0dff41",
                                                "text": "Ihr Jammer war beeindruckend und überzeugend."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8237f9a5-13d6-3149-9a05-4ac81796bedb",
                                        "entry_id": "168bc85f-8c00-3757-a4ac-be87d8949980",
                                        "glosses": [
                                            "Zustand von Leid, Elend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fee019eb-6bba-4d6e-8bc2-6b165e86b398",
                                                "sense_id": "8237f9a5-13d6-3149-9a05-4ac81796bedb",
                                                "text": "Es ist ein Jammer, in welchem Zustand das Haus nun ist."
                                            },
                                            {
                                                "example_id": "6924f18e-031b-4cc1-8415-4e6a47944fd5",
                                                "sense_id": "8237f9a5-13d6-3149-9a05-4ac81796bedb",
                                                "text": "„Die Mutter setzte sich in trostlosem Jammer auf das eine Bett und rang die Hände.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
