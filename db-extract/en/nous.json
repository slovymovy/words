                                "target_senses": [
                                    {
                                        "sense_id": "aea93271-2a2e-3001-b4b8-2efd29e289d7",
                                        "entry_id": "43d974d5-4830-30eb-8590-44b1c7eb1066",
                                        "glosses": [
                                            "способность мыслить"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3edb5e6-0a0e-4966-8cd5-810bc845d36c",
                                                "sense_id": "aea93271-2a2e-3001-b4b8-2efd29e289d7",
                                                "text": "Человек обладает разумом."
                                            },
                                            {
                                                "example_id": "5bf256aa-5563-4002-b6c7-316e9fd1d2fe",
                                                "sense_id": "aea93271-2a2e-3001-b4b8-2efd29e289d7",
                                                "text": "Сердце так билось, что в голове больно было, и разум мой помутился."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f36fe76c-7b3d-3370-9d3e-25fcd6eb209c",
                                        "entry_id": "43d974d5-4830-30eb-8590-44b1c7eb1066",
                                        "glosses": [
                                            "степень развития ума, сообразительность"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ceb5552a-fd4d-43a1-842c-f4b71cb03797",
                                                "sense_id": "f36fe76c-7b3d-3370-9d3e-25fcd6eb209c",
                                                "text": "Там вам школа; там только наберётесь разуму."
                                            },
                                            {
                                                "example_id": "bddf75a9-4ffb-4779-b7ba-5d90dec7db23",
                                                "sense_id": "f36fe76c-7b3d-3370-9d3e-25fcd6eb209c",
                                                "text": "Извините, ваше сиятельство, я сужу по своему слабому разуму."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
