                "senses": [
                    {
                        "sense_id": "0e7b1184-8038-392d-9806-60ab9ece16ad",
                        "entry_id": "9b2ebf8e-c0b1-3605-a82f-fdcbadb4f22a",
                        "glosses": [
                            "Position, bei der ein Fötus mit dem Kopf in Richtung Muttermund liegt"
                        ],
                        "tags": [
                            "Gynäkologie",
                            "Geburtshilfe"
                        ],
                        "examples": [
                            {
                                "example_id": "9dfebd5f-3e60-4dc0-a202-081b10040e33",
                                "sense_id": "0e7b1184-8038-392d-9806-60ab9ece16ad",
                                "text": "„In den meisten Fällen dreht sich der Fetus von selbst in die Schädellage.“"
                            },
                            {
                                "example_id": "a73ed372-55a4-4b34-a2ec-0c719916ad01",
                                "sense_id": "0e7b1184-8038-392d-9806-60ab9ece16ad",
                                "text": "„Es ist einfacher und sicherer für die Mutter, ein Kind in Schädellage zu gebären.“"
                            },
                            {
                                "example_id": "c5b88871-4636-4e5c-88d3-9a4d9bd4c0f4",
                                "sense_id": "0e7b1184-8038-392d-9806-60ab9ece16ad",
                                "text": "„Hat sich der Fetus bis zur 36. Woche noch nicht gedreht, wird manchmal versucht, von außen das Kind in die normale Schädellage zu drehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
