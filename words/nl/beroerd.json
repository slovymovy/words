                    "sense_id": "cd0388b4-9fc9-3883-84ea-853c361c2e01",
                    "sense_definition": "Bijzonder slecht, vervelend of van zeer lage kwaliteit.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>beroerde</w> omstandigheden op de arbeidsmarkt veroorzaken een hoop ellende en angst.",
                            "target_lang_translations": {
                                "en": "The <w>miserable</w> conditions on the labor market cause a lot of misery and fear.",
                                "ru": "<w>Скверные</w> условия на рынке труда вызывают много страданий и страха.",
                                "fr": "Les <w>mauvaises</w> conditions sur le marché du travail provoquent beaucoup de misère et d'angoisse."
                            }
                        },
                        {
                            "text": "Ik voel me vandaag echt <w>beroerd</w> en blijf liever de hele dag in bed liggen.",
                            "target_lang_translations": {
                                "en": "I feel really <w>miserable</w> today and would rather stay in bed all day.",
                                "ru": "Я чувствую себя сегодня просто <w>ужасно</w> и предпочел бы весь день пролежать в постели.",
                                "fr": "Je me sens vraiment <w>malade</w> aujourd'hui et je préfère rester au lit toute la journée."
                            }
                        }
                    ],
                    "synonyms": [
                        "slecht",
                        "ellendig",
                        "belabberd",
                        "waardeloos"
                    ],
                    "common_phrases": [
