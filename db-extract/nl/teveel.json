                    {
                        "translation_id": "7fd482a6-4cb1-49c8-a905-859b9cdf63c3",
                        "source_entry_id": "fc22ff79-1d3c-30f1-93a8-221068a6693f",
                        "source_sense_id": "af272c32-13fb-383c-963d-36089f55da8c",
