                "senses": [
                    {
                        "sense_id": "b1e6246b-cfec-3877-ba3d-5acb6551c9ca",
                        "entry_id": "a8ce7e64-b1d5-3f6b-ab6f-c42dbd28de54",
                        "glosses": [
                            "Relatif à Djibouti, à ses habitants ou à sa culture."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8b6ceb4-a46e-47c3-8cad-52c31cdb8ce1",
                                "sense_id": "b1e6246b-cfec-3877-ba3d-5acb6551c9ca",
                                "text": "Deux personnes, un policier et un manifestant, ont été tuées vendredi soir au cours des violences ayant éclaté à l’issue d’un grand rassemblement de l’opposition dans la capitale djiboutienne, selon un bilan officiel donné samedi par le ministère de l’Intérieur."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ee899b42-2cdb-4b1a-9e79-2db8ee305a11",
                        "source_entry_id": "a8ce7e64-b1d5-3f6b-ab6f-c42dbd28de54",
                        "source_sense_id": "b1e6246b-cfec-3877-ba3d-5acb6551c9ca",
                        "target_lang_word": "dschibutisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dschibutisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "52da1fb5-bebd-3168-884f-8a6ffd14328f",
                                        "entry_id": "29498239-1007-3ed7-a0b8-e1ec09581f4d",
                                        "glosses": [
                                            "Adjektiv zu Dschibuti, Dschibuti betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01f08fd7-f4b0-4233-8682-05c4dade503d",
                                                "sense_id": "52da1fb5-bebd-3168-884f-8a6ffd14328f",
                                                "text": "Er spielt in der dschibutischen Nationalmannschaft."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0793da32-859a-4f07-98a2-918d50277e21",
                        "source_entry_id": "a8ce7e64-b1d5-3f6b-ab6f-c42dbd28de54",
                        "source_sense_id": "b1e6246b-cfec-3877-ba3d-5acb6551c9ca",
                        "target_lang_word": "Djiboutian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Djiboutian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bb0f8c64-99fc-3de2-a184-88c8919a77cf",
                                        "entry_id": "19825435-c465-380d-9ab9-ba47af28eef7",
                                        "glosses": [
                                            "A person from Djibouti or of Djiboutian descent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40f9e19e-2a9f-4584-8e59-2dd48dd34e54",
                                                "sense_id": "bb0f8c64-99fc-3de2-a184-88c8919a77cf",
                                                "text": "“The worst-case scenario if it happened, if the Chinese did take over that port – and, again, we have assurances from the Djiboutians they won’t – but if they did, I mean, down the way that that restricts our access, that restricts the Navy’s ability to get in there and just simply offload supplies and the like,” he said."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Djiboutian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "18483c04-3f5f-3745-965d-506ee5965d3e",
                                        "entry_id": "d17333de-079d-3ec1-a889-02a52a614361",
                                        "glosses": [
                                            "Of, from, or pertaining to Djibouti or its people or culture."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9fdfa811-21b2-4a95-ba21-453a017b386a",
                                                "sense_id": "18483c04-3f5f-3745-965d-506ee5965d3e",
                                                "text": "The US officials added that that the situation has angered Djiboutian government officials, and that the US military in Djibouti has messaged back to Washington “significant concerns” over keeping the detainees there and the possible impact on military relations."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
