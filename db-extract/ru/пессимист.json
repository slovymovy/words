                                        "entry_id": "b9f9c479-726e-3be2-af13-83b252de5556",
                                        "glosses": [
                                            "Celui ou celle qui voit les choses en noir."
                                        ],
                                        "tags": [
                                            "common"
                                        ],
                                        "examples": [
