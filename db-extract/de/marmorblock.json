                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50be8d7d-3d20-411a-9449-3a4fdc8453b8",
                                "sense_id": "0a36ea3c-7e7e-3841-b7da-75a5b4601330",
                                "text": "Der Marmorblock wurde mit einer Diamantsäge zerteilt."
                            },
                            {
                                "example_id": "cc306e95-7ffa-4922-9ef7-dececbba44a4",
                                "sense_id": "0a36ea3c-7e7e-3841-b7da-75a5b4601330",
                                "text": "„Ein Raum, ein Mann, ein riesiger Stein: 19 Tage lang war Mikes Poppe mit dem Fuß an einen Marmorblock gekettet und versuchte, sich mit Hammer und Meißel zu befreien.“"
                            },
                            {
                                "example_id": "783b47d3-c59f-409f-8708-67a500fa0746",
                                "sense_id": "0a36ea3c-7e7e-3841-b7da-75a5b4601330",
                                "text": "„Für den Transport über mehrere Kilometer wurde jeder Marmorblock in der Achse einer hölzernen Trommel befestigt und gerollt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
