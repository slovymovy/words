                        ],
                        "form": "die Luftkriege"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "50c5ed0a-3b7b-338b-8c56-4218b5aa481f",
                        "entry_id": "6e82ef2b-289c-38b8-bf75-70e62cc4a4a0",
                        "glosses": [
                            "Kampfhandlung, die von Luftstreitkräften ausgeht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ca71737-950e-4fd6-95be-bad7553f3ae0",
                                "sense_id": "50c5ed0a-3b7b-338b-8c56-4218b5aa481f",
                                "text": "„Selbst wenn der Luftkrieg gegen das Gaddafi-Regime am Ende vom Erfolg gekrönt sein sollte, was nicht unwahrscheinlich ist, so entblößt er doch schon jetzt die Schwachstellen des westlichen Bündnisses.“"
                            },
                            {
                                "example_id": "1a3bd3e8-73e7-4eb2-8f25-b518a2ed4d90",
                                "sense_id": "50c5ed0a-3b7b-338b-8c56-4218b5aa481f",
                                "text": "„Heute weiß Gudrun Baumann, dass das Nichthinsehen, das ihr offenbar während des Luftkriegs antrainiert worden war, zu einem Charakterzug wurde, gegen den sie dann ihr Leben lang ankämpfte.“"
                            },
                            {
                                "example_id": "406ba48b-606e-4dda-a3b4-76c5711273c7",
                                "sense_id": "50c5ed0a-3b7b-338b-8c56-4218b5aa481f",
                                "text": "„Aus dem vorerst hauptsächlich der Feindbeobachtung dienenden Einsatz von Luftschiffen und Flugzeugen wurde eine Waffe, mit der ein „Luftkrieg“ eingeläutet wurde, der im Zweiten Weltkrieg verheerende Ausmaße annahm.“"
                            },
                            {
                                "example_id": "bb25d6dc-38d3-486b-a28f-e45a3789d9ed",
                                "sense_id": "50c5ed0a-3b7b-338b-8c56-4218b5aa481f",
                                "text": "„Jeden Morgen um halb neun holte er aus schweren Stahlschränken ganze Stöße von Ordnern und Akten hervor, die dort über Nacht wegen des Luftkrieges gesichert wurden.“"
                            },
                            {
                                "example_id": "e4f7bcbc-5765-45f8-9f9e-9d8120cac3ca",
                                "sense_id": "50c5ed0a-3b7b-338b-8c56-4218b5aa481f",
                                "text": "„Demgegenüber hatten die Deutschen im Gefolge des alliierten Luftkrieges ernsthafte Nachschubschwierigkeiten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
