                        "examples": [
                            {
                                "example_id": "2ddd5c5e-ce5f-4a64-8c98-76018da3c725",
                                "sense_id": "714524f8-8ced-36bf-a8f5-f55384290d62",
                                "text": "Drie van de 57 deelnemers zien wél hoop. Potentiële 50Plus-kiezers “zijn al vele malen vergevingsgezind gebleken”, zegt een oud-D66-Kamerlid. “De partij heeft nog steeds een unieke niche.” Een andere D66’er is dat met hem eens: “De meeste mensen stemmen op 50Plus omdat ze vinden dat ouderen worden gepakt. Een uitglijder zal hooguit wat zwevende kiezers afschrikken.”"
                            }
                        ]
                    }
