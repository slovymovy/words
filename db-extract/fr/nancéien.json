                        "glosses": [
                            "Relatif à Nancy, commune française située en Meurthe-et-Moselle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f9d9b63-801f-4201-8391-9cbebe809884",
                                "sense_id": "d2e0ba21-51a6-345e-8232-68fdcb6d1e80",
                                "text": "J’ai visité la fameuse rue Clodion qui est le cauchemar des hygiénistes nancéiens […] Mais du moins Nancy ne se trouve pas en présence d’un problème insoluble."
                            },
                            {
                                "example_id": "bac27c1d-63d2-49a4-a9ac-38d2877fa7c6",
                                "sense_id": "d2e0ba21-51a6-345e-8232-68fdcb6d1e80",
                                "text": "J’aime bien les saucisses de Strasbourg. Mais je préfère les os à moëlle nancéiens."
                            }
                        ]
                    }
                ],
