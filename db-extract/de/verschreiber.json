                "senses": [
                    {
                        "sense_id": "2709c39f-bed2-37f6-8586-286c65cc896b",
                        "entry_id": "2042aae1-acdd-3b0f-828e-b1bc93068c2e",
                        "glosses": [
                            "(unbeabsichtigte) Fehlleistung beim Schreiben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c1c0081-1866-4269-a706-144e896e9dfd",
                                "sense_id": "2709c39f-bed2-37f6-8586-286c65cc896b",
                                "text": "„Diese Laune wurde aufgegriffen und weiter befördert durch Dr. Birgit Sekulski, Warschau, die im Dialog Sprachwitze, Kalauer, Versprecher, Verschreiber, Stilblüten und anderes vorstellte und damit ein wahres »Feuerwerk der Sprachlust« zündete.“"
                            },
                            {
                                "example_id": "21fbef7e-56e5-432b-be9d-16d864b00098",
                                "sense_id": "2709c39f-bed2-37f6-8586-286c65cc896b",
                                "text": "„Einen etwas anderen Stellenwert in der Gruppe der Sprachpannen haben die Verschreiber.“"
                            },
                            {
                                "example_id": "8c853c05-bcfe-4cc3-a237-5b27368fdcad",
                                "sense_id": "2709c39f-bed2-37f6-8586-286c65cc896b",
                                "text": "„Verschreiber sind ebenso wie Verleser nicht allein auf die Eigenheiten des Schriftsystems zurückzuführen und zeigen daher oft dieselben Muster wie Versprecher, ...“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "472fee33-a2a1-41bc-bdc2-df674a26d263",
                        "source_entry_id": "2042aae1-acdd-3b0f-828e-b1bc93068c2e",
                        "source_sense_id": "2709c39f-bed2-37f6-8586-286c65cc896b",
                        "source_sense_description": "Linguistik: (unbeabsichtigte) Fehlleistung beim Schreiben",
                        "target_lang_word": "slip of the pen",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "slip of the pen",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "32ad351c-d49a-30bc-a95c-8b428cdc5242",
                                        "entry_id": "3c172664-d930-3e77-be81-38b6a3b73d61",
                                        "glosses": [
                                            "A mistake in handwriting; (loosely) any minor error by the writer that made it into print, having not been caught by editors or proofreaders."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1ae0bde-28fe-4d58-96e9-efe049cc97a0",
                                                "sense_id": "32ad351c-d49a-30bc-a95c-8b428cdc5242",
                                                "text": "Near-synonyms: writo; misprint; miswriting; typo"
                                            },
                                            {
                                                "example_id": "0afeaafa-3b9f-4870-8097-d327396a7983",
                                                "sense_id": "32ad351c-d49a-30bc-a95c-8b428cdc5242",
                                                "text": "There are one or two slips of the pen—L.S.W.R. trains did not run through Ludgate Hill, for instance—[...]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
