                        "examples": [
                            {
                                "example_id": "7fed0455-ed12-4dfb-b183-f58db416a3b6",
                                "sense_id": "27142324-fbee-35ce-b221-430f9906de27",
                                "text": "Les informations sur la répartition géographique et sectorielle de l’investissement costaricien à l’étranger sont maigres."
                            },
                            {
                                "example_id": "f121798c-d73f-4d2b-a193-f8e9f0b51dfe",
                                "sense_id": "27142324-fbee-35ce-b221-430f9906de27",
                                "text": "L’hymne national costaricien est bref : 17 vers groupés en 4 strophes."
                            },
                            {
                                "example_id": "fb9e2715-67a1-408e-b5b1-3cb4263c3513",
                                "sense_id": "27142324-fbee-35ce-b221-430f9906de27",
                                "text": "L’office costaricien sera chargé d’effectuer la conversion dans les deux sens, et au cours du jour […]"
                            },
                            {
                                "example_id": "91567957-3238-4b75-91d4-c97c65de4cbf",
                                "sense_id": "27142324-fbee-35ce-b221-430f9906de27",
                                "text": "Je crus même distinguer sur ma gauche la silhouette bleuâtre de la sierra costaricienne."
                            }
                        ]
                    }
