                "senses": [
                    {
                        "sense_id": "521e1ba8-b07f-3506-b2d6-5fb54ad085b5",
                        "entry_id": "48443ca7-e21b-34e4-b27e-e75e40466a97",
                        "glosses": [
                            "относящийся к временной эпохе, предшествующей появлению христианства"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f3b7d44-caba-49c0-a5f5-c2fb3f37c1c2",
                                "sense_id": "521e1ba8-b07f-3506-b2d6-5fb54ad085b5",
                                "text": "Опять же Рим — только не мнимохристианский, а дохристианский, то есть Древний Рим, а точнее то, что от него осталось."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "353ff84e-8976-4fd1-a934-942f389a886e",
                        "source_entry_id": "48443ca7-e21b-34e4-b27e-e75e40466a97",
                        "source_sense_id": "521e1ba8-b07f-3506-b2d6-5fb54ad085b5",
                        "target_lang_word": "vorchristlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vorchristlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "34b5ad39-87f0-3c4f-918a-6fe4c71d5404",
                                        "entry_id": "d8f18ad6-474f-3b6a-ac10-e5f7f75055a3",
                                        "glosses": [
                                            "vor der Geburt Jesu Christi"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38e11637-13f5-41ed-9a28-a6ee479210e7",
                                                "sense_id": "34b5ad39-87f0-3c4f-918a-6fe4c71d5404",
                                                "text": "„Die Kirche wurde auf einem Hügel errichtet, der schon vorchristlich als Kultplatz eine Rolle spielte.“"
                                            },
                                            {
                                                "example_id": "0ad009a6-12bc-4a94-b1dd-ac37f0bf6cfb",
                                                "sense_id": "34b5ad39-87f0-3c4f-918a-6fe4c71d5404",
                                                "text": "„Die Mohnpflanze soll bereits im 6. vorchristlichen Jahrtausend in Zentralasien bekannt gewesen sein, in Europa vom Altertum an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
