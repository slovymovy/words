                ],
                "senses": [
                    {
                        "sense_id": "31cc940c-1394-3091-a009-d1ff084bfc26",
                        "entry_id": "4a7a0107-5873-3d1a-b547-adc7b92330da",
                        "glosses": [
                            "Flugzeug zur Bekämpfung von Boden-, Luft- oder Seezielen, welches die Tarnkappentechnik nutzt, um die Ortung des Flugzeugs durch Unterdrücken der vom georteten Objekt ausgesandten oder reflektierten Emissionen zu erschweren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a817d82-6a20-48f3-a3e1-ad6c368702d0",
                                "sense_id": "31cc940c-1394-3091-a009-d1ff084bfc26",
                                "text": "„Russland plagen weiter Probleme mit seinem neuen Tarnkappenflugzeug Suchoi T-50, das ab 2016 bei der russischen Luftwaffe den Dienst aufnehmen soll.“"
                            },
                            {
                                "example_id": "99d9f294-23f7-4dcf-9b0d-7f079d54099a",
                                "sense_id": "31cc940c-1394-3091-a009-d1ff084bfc26",
                                "text": "„In Frage kommen aber auch der Gripen E des schwedischen Herstellers Saab, der Rafale von Dassault, der F/A-18 Super Hornet von Boeing und das Tarnkappenflugzeug F-35A von Lockheed Martin.“"
                            },
                            {
                                "example_id": "9fc283b4-0c23-4c49-baa6-9945e3b0087f",
                                "sense_id": "31cc940c-1394-3091-a009-d1ff084bfc26",
                                "text": "„Das die Volksrepublik bald über ein Tarnkappenflugzeug verfügen könnte, dürfte in den USA mit Sorge betrachtet werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
