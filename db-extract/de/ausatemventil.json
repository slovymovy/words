                "senses": [
                    {
                        "sense_id": "4ce97a5b-c28a-3a3e-b4f5-f43d919b60ed",
                        "entry_id": "31741209-23e2-3240-8709-ff885fbfda7f",
                        "glosses": [
                            "Ventil, das in einer Atemmaske sitzt und die verbrauchte Luft (ungehindert) nach außen passieren lässt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d321a8d-9c8e-429c-bb8b-1e812c721f77",
                                "sense_id": "4ce97a5b-c28a-3a3e-b4f5-f43d919b60ed",
                                "text": "Masken mit Ausatemventil filtern nur die eingeatmete Luft."
                            },
                            {
                                "example_id": "48f44da7-8360-4675-8d02-3a65c4f3638e",
                                "sense_id": "4ce97a5b-c28a-3a3e-b4f5-f43d919b60ed",
                                "text": "„Masken mit Ausatemventil bieten höheren Tragekomfort. Atemschutzmasken ohne Ausatemventil verhindern zusätzlich, dass der Maskenträger sein Umfeld mit ausgeatmeten Tröpfchen kontaminiert.“"
                            },
                            {
                                "example_id": "9ee604d5-2c69-4597-9722-0a1becdef0bc",
                                "sense_id": "4ce97a5b-c28a-3a3e-b4f5-f43d919b60ed",
                                "text": "„Teilweise verfügen diese FFPs über ein Ausatemventil, das für eine geringere Belastung beim Tragen sorgen soll. Und genau vor Masken mit diesem Ventil warnt Dr. Georg-Christian Zinn, Direktor Hygienezentrum Bioscientia: \"Diese Masken schützen nur den Träger, aber nicht den, der zum Beispiel im Supermarkt vor mir steht\".“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
