        "fr-extract.jsonl": [
            {
                "entry_id": "fd1ca89f-a690-32d4-8e12-b59f84811477",
                "word": "imbroglio",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "9c8ba542-ea49-4c10-94ed-79fcb14a0bd0",
                        "entry_id": "fd1ca89f-a690-32d4-8e12-b59f84811477",
                        "tags": [
                            "plural"
                        ],
                        "form": "imbroglios"
                    },
                    {
                        "form_id": "100e8167-f261-49f5-9237-0dd0236945f7",
                        "entry_id": "fd1ca89f-a690-32d4-8e12-b59f84811477",
                        "tags": [
                            "plural"
                        ],
                        "form": "imbrogli"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "350fee0c-d9b3-35ed-a183-63fb5d3fd714",
                        "entry_id": "fd1ca89f-a690-32d4-8e12-b59f84811477",
                        "glosses": [
                            "Embrouille ; confusion ; situation embrouillée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "afee4bf0-6074-4a36-9b86-0d35fbc7d200",
                                "sense_id": "350fee0c-d9b3-35ed-a183-63fb5d3fd714",
                                "text": "Quoi que tu en dises, tu aimes les romans, les imbroglios, les situations scabreuses ; tu as juste assez de force pour friser les difficultés sans avaries, assez de faiblesse pour en savourer délicatement les transes. Tu te donnes à toi-même toutes les émotions extrêmes, depuis la peur d’être un malhonnête homme jusqu’au plaisir orgueilleux de te sentir quasiment un héros."
                            },
                            {
                                "example_id": "652bbd6f-dd2f-49da-a761-bdde978559cb",
                                "sense_id": "350fee0c-d9b3-35ed-a183-63fb5d3fd714",
                                "text": "Notre esprit est toujours comme à la merci d’un téléphoniste farceur […] qui lui branche la communication avec n’importe qui, n’importe quoi, se plaisant aux pires confusions, aux imbroglios les plus fâcheux, les plus déraisonnables."
                            },
                            {
                                "example_id": "64ce92e4-24bf-4ea9-9578-0b8593aa7941",
                                "sense_id": "350fee0c-d9b3-35ed-a183-63fb5d3fd714",
                                "text": "Les changements à répétition des règles débouchent sur des imbroglios administratifs et juridiques inextricables et l’illégalité ouvre la porte à tous les trafics, mafias et répressions policières."
                            },
                            {
                                "example_id": "e6bc0bee-e607-4582-b537-12d3afc2546b",
                                "sense_id": "350fee0c-d9b3-35ed-a183-63fb5d3fd714",
                                "text": "Il est fréquent que les rebonds sur les parois et les exclamations des participants fassent monter les décibels, au point de provoquer des imbroglios entre des clubs et le voisinage."
                            }
                        ]
                    },
                    {
                        "sense_id": "e1fef60a-ed23-30b7-b45b-17bc1c06cbb7",
                        "entry_id": "fd1ca89f-a690-32d4-8e12-b59f84811477",
                        "glosses": [
                            "Pièce de théâtre dont l’intrigue est fort compliquée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63437826-2a15-42b7-8edd-7b1d7582812e",
                                "sense_id": "e1fef60a-ed23-30b7-b45b-17bc1c06cbb7",
                                "text": "Cette comédie est un imbroglio à l’espagnole, un imbroglio fort amusant."
                            },
                            {
                                "example_id": "38a09c81-6387-4b31-b237-91ee61d2155c",
                                "sense_id": "e1fef60a-ed23-30b7-b45b-17bc1c06cbb7",
                                "text": "Les imbroglios italiens."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e46aebac-4a50-4b65-a327-817ddc2fde79",
                        "source_entry_id": "fd1ca89f-a690-32d4-8e12-b59f84811477",
                        "source_sense_id": "350fee0c-d9b3-35ed-a183-63fb5d3fd714",
                        "source_sense_description": "Situation embrouillée",
                        "target_lang_word": "imbroglio",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "imbroglio",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "02f867a2-a0d9-301b-bf64-063d4cdb413d",
                                        "entry_id": "4af29ea8-218d-3ef2-b442-02847bc50cef",
                                        "glosses": [
                                            "A complicated situation; an entanglement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f47a22ec-6a0e-41ad-8a63-fb037f841c93",
                                                "sense_id": "02f867a2-a0d9-301b-bf64-063d4cdb413d",
                                                "text": "Into the drawers and china pry, / Papers and books, a huge imbroglio! / Under a tea-cup he might lie, / Or creased, like dogs-ears, in a folio."
                                            },
                                            {
                                                "example_id": "d0b9350a-2d1b-4e54-a048-818c604ad09b",
                                                "sense_id": "02f867a2-a0d9-301b-bf64-063d4cdb413d",
                                                "text": "Your trip here will never quite go as planned. […] There may be strikes, mixed-up reservations, maddening imbrogli of all sorts. But they will be charming imbrogli because the Italian people are charming, down to the whimsical tone of their language."
                                            },
                                            {
                                                "example_id": "12892056-db4b-4182-bc36-6eb282f7ce1e",
                                                "sense_id": "02f867a2-a0d9-301b-bf64-063d4cdb413d",
                                                "text": "I could have phoned you with all this, Tallulah, but knowing you as I have over the years, when you and I have both been a party to some of Duncan's little imbroglios, I thought I should talk to you in person."
                                            },
                                            {
                                                "example_id": "ef5eaefa-7b4d-4bb6-8d54-fc3f35917cc6",
                                                "sense_id": "02f867a2-a0d9-301b-bf64-063d4cdb413d",
                                                "text": "He [Edward Michael Adler] was inducted into the imbroglio of the Vietnam War, which so many of his age group and middle class Orthodox Jewish upbringing easily avoided by staying in university or going into the clergy. He didn't."
                                            },
                                            {
                                                "example_id": "da0b5483-ada0-4476-bdbe-59d456b8e469",
                                                "sense_id": "02f867a2-a0d9-301b-bf64-063d4cdb413d",
                                                "text": "[David] Cameron's decision to hold a referendum alters the chemistry of politics. The casual way he offered a simple Yes–No referendum to Scotland in 2011 has led to a quasi-insoluble imbroglio over the future of the British Constitution."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
