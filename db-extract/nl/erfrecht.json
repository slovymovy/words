                                        "examples": [
                                            {
                                                "example_id": "ae9ef9e3-4f48-43fc-8b8f-88fdae650d6d",
                                                "sense_id": "93171a2c-2fec-3fb6-aab6-ed79ef01d1a5",
                                                "text": "Weil mein Großvater auf sein Erbrecht verzichtet hatte, erlangte sein Bruder das Alleineigentum an der Fabrik ihres verstorbenen Vaters."
                                            }
