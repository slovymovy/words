                                    {
                                        "sense_id": "0b82a9aa-48c7-3f54-bb15-3f6b8cdcde4a",
                                        "entry_id": "b093b705-0f50-3bf8-8772-ffce5301b326",
                                        "glosses": [
                                            "Zylinder zum Aufwickeln von zum Beispiel Seilen oder Drähten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "939c5a24-4554-4bd8-be5a-f517ae1666b7",
                                                "sense_id": "0b82a9aa-48c7-3f54-bb15-3f6b8cdcde4a",
                                                "text": "„Allerleirauh lief nun in die Küche, kochte dem König die Brotsuppe und legte, wie der Koch fort war, den goldenen Haspel hinein. Der König, als er den Haspel auf dem Grunde fand, ließ Allerleirauh rufen.“"
                                            },
                                            {
                                                "example_id": "518d5b56-f5c4-4c6b-a5a5-59a5ab25d014",
                                                "sense_id": "0b82a9aa-48c7-3f54-bb15-3f6b8cdcde4a",
                                                "text": "Ich verwendete ein dickes Plastikrohr als Haspel."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "031cfebc-b68a-3bef-8ead-10fd177998c6",
                                        "entry_id": "b093b705-0f50-3bf8-8772-ffce5301b326",
                                        "glosses": [
                                            "Maschine zum Abwickeln und Strang-Bilden"
                                        ],
                                        "tags": [
                                            "Textilindustrie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "afc66243-29ff-4675-abf4-aa2c7c205d1d",
                                                "sense_id": "031cfebc-b68a-3bef-8ead-10fd177998c6",
                                                "text": "Haspeln sind in der Textiltechnik ein wichtiges Hilfsmittel."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "99f41aa2-f77b-3c64-b29c-e634a2bd0379",
                                        "entry_id": "b093b705-0f50-3bf8-8772-ffce5301b326",
                                        "glosses": [
                                            "Bottich mit bewegten Schaufeln"
                                        ],
                                        "tags": [
                                            "Gerberei"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea8785ed-0250-4791-ae6d-8a979ea152e4",
                                                "sense_id": "99f41aa2-f77b-3c64-b29c-e634a2bd0379",
                                                "text": "In der Haspel werden auch Farben zugesetzt."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "495e157c-f8b8-3c1b-af16-8c146f8980b5",
                                        "entry_id": "b093b705-0f50-3bf8-8772-ffce5301b326",
                                        "glosses": [
                                            "Zug- und Hubwinden zur Betätigung von Zug- und Förderseilen"
                                        ],
                                        "tags": [
                                            "Bergbau",
                                            "auch in anderen Fachbereichen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d720df4c-e160-43cc-99fb-d0627b64a9d6",
                                                "sense_id": "495e157c-f8b8-3c1b-af16-8c146f8980b5",
                                                "text": "Die Haspel war durch Einrastkerben gegen Leerlauf geschützt."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "ae40dfe1-6def-355c-b676-c3d8ad18d2ba",
                                        "entry_id": "b093b705-0f50-3bf8-8772-ffce5301b326",
                                        "glosses": [
                                            "Zug- und Hubwinden zur Betätigung von Zug- und Förderseilen",
                                            "Ankerwinde"
                                        ],
                                        "tags": [
                                            "Bergbau",
