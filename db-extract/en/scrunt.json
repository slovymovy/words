                "senses": [
                    {
                        "sense_id": "8772217b-8b50-34b8-af38-45594e719a78",
                        "entry_id": "9ad63870-b906-34af-8a7c-41efd3ff1cb6",
                        "glosses": [
                            "A beggar or destitute person."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6cad7d59-47f8-4c2d-8e75-cda0155c719c",
                                "sense_id": "8772217b-8b50-34b8-af38-45594e719a78",
                                "text": "It's a fine, ennobling thing, is poverty. It would make me a brutal scrunt, and you a whinging harridan in three years."
                            },
                            {
                                "example_id": "3d00ad81-8e42-42b1-8f7f-68732ea26a01",
                                "sense_id": "8772217b-8b50-34b8-af38-45594e719a78",
                                "text": "And without my work what am I but an unemployed scrunt on the meat market of the streets?"
                            },
                            {
                                "example_id": "595103a3-15d7-4ba9-852b-b7637bdebf92",
                                "sense_id": "8772217b-8b50-34b8-af38-45594e719a78",
                                "text": "Not slum-dweller socialist but high-class fanny socialist. [...] Socialism that drinks wine - a single bottle costs a year's pay to a fuckin scrunt like Uxbridge."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
