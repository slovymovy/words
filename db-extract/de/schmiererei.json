                                "example_id": "0678e531-09a6-4933-a908-7bcff0fa8f53",
                                "sense_id": "96297f18-27bc-36ce-831d-5a12e0ae689e",
                                "text": "„Eigil erzählte von den Schmierereien auf seinem Auto.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "859df769-9417-3b1a-9f71-82eeb52b8fc4",
                        "entry_id": "5a7360c0-36ec-3b66-b198-67a8d02ed0c3",
