                                        "entry_id": "53651b0a-f7a1-31f4-9fbd-73f6ec7ce56d",
                                        "glosses": [
                                            "The Toyota Motor Corporation, a Japanese manufacturer of cars."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d1de181-09a2-43d8-bcfb-95b41194707e",
                                                "sense_id": "8c0d2a54-3041-3ade-97c7-f46dd8074536",
                                                "text": "So vehicles, like some Toyota Corollas, have a 160-mph speedometer despite coming nowhere close to reaching such speeds."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "49b58c46-0bb2-3fee-b35e-cad991800b21",
                                        "entry_id": "53651b0a-f7a1-31f4-9fbd-73f6ec7ce56d",
                                        "glosses": [
                                            "A brand of car manufactured by Toyota."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d40d110-40e9-4bf8-8129-36cb1d7da22d",
                                                "sense_id": "49b58c46-0bb2-3fee-b35e-cad991800b21",
                                                "text": "It is the prelapsarian Polynesia of free love, noble savagery, Kon Tiki rafting and Easter Island statuary, not the Levi’s-wearing, Toyota-driving, pédalo-pushing, efflorescent-cocktails-in-a-split-coconut-serving pseudo-paradise that awaits latter-day travellers."
                                            }
                                        ]
                                    }
