                        "entry_id": "9515c095-2ad5-38b5-b177-2150a9dae4f2",
                        "glosses": [
                            "lamp aan het hoofdeinde van een bed zodat je kunt lezen in bed en licht kunt maken als je in bed ligt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4aef4ca-fa6f-4c6f-b8a1-43262d55a3fb",
                                "sense_id": "7c16eefd-f159-3d90-9156-175186e17dea",
                                "text": "Voor het slapen doe ik de hoofdlamp van de slaapkamer uit en als ik dan ik bed lig doe ik ook het bedlampje uit."
                            },
                            {
                                "example_id": "2d21e03b-96c6-49d2-8194-1c9d0bec3f05",
                                "sense_id": "7c16eefd-f159-3d90-9156-175186e17dea",
                                "text": "Toen ik zijn bedlampje uitdeed en naar de woonkamer liep en de deur achter me sloot, nam mijn hartslag enorm toe."
                            },
                            {
                                "example_id": "719aabfb-f09a-4084-a32f-c41f8f41d3ba",
                                "sense_id": "7c16eefd-f159-3d90-9156-175186e17dea",
                                "text": "Ze zeiden niets, schopten alleen hun schoenen uit, deden de bedlampjes aan en doofden de plafondverlichting."
                            }
                        ]
                    }
                ],
