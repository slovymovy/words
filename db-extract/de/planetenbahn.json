                "senses": [
                    {
                        "sense_id": "f75d2fb9-1789-32e4-9808-e818f0c24cf3",
                        "entry_id": "ce32a677-dde2-3036-8d88-95c075d4da2e",
                        "glosses": [
                            "die Bahn, die ein Planet beschreibt, der um einen Stern kreist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "abd5b491-0494-44d5-ae4a-bc7622dc2413",
                                "sense_id": "f75d2fb9-1789-32e4-9808-e818f0c24cf3",
                                "text": "„Astronomen haben nachgewiesen, dass zum Beispiel auch im System Kepler-30 die Planetenbahnen alle in einer Ebene liegen.“"
                            },
                            {
                                "example_id": "daa7bd41-6e05-4f95-91a6-ce85b5835d09",
                                "sense_id": "f75d2fb9-1789-32e4-9808-e818f0c24cf3",
                                "text": "„Tycho Brahe etwa, jener dänische Wissenschafter, dessen Beobachtungen der Planetenbahnen wohl die genauesten dieser Jahre waren, und der große Galileo Galilei, den Kepler nicht persönlich kannte, aber sehr verehrte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
