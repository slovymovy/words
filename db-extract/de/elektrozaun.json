                "senses": [
                    {
                        "sense_id": "28e3db13-1aff-3fa9-81bb-dd4a58391902",
                        "entry_id": "0715b87b-6fce-3396-9986-83cce736692b",
                        "glosses": [
                            "Zaun, mit dem Tiere (oder auch Menschen) durch Schreck-, Schock-, Verletzungs- oder Tötungswirkung einer elektrischen Spannung davon abgehalten werden, ein Grundstück zu betreten oder zu verlassen"
                        ],
                        "tags": [
                            "Tierzucht"
                        ],
                        "examples": [
                            {
                                "example_id": "7823a14d-6a3f-42f7-b83e-8ea54e944d18",
                                "sense_id": "28e3db13-1aff-3fa9-81bb-dd4a58391902",
                                "text": "„Einem Elektrozaun begegnet man häufig auf der Weide, weshalb bevorzugt der Begriff Weidezaun verwendet wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
