                                                "example_id": "a3dc4604-8e97-4f3e-aa57-2cf5c05bfdd6",
                                                "sense_id": "538e8735-6dff-3834-a070-255f0e5172c4",
                                                "text": "Sn mari, toujours souriant, répondit: « C'est vous qui l'avez voulu, madame Adelaïde. »"
                                            },
