{
    "word_family": [
        "plowman",
        "plowshare"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2ff45936-3410-35f4-930a-beeac04dcd05",
                    "sense_definition": "An agricultural implement used for cutting, lifting, and turning over soil; an alternative spelling of <w>plough</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "agricultural_tool",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer attached the heavy <w>plow</w> to his tractor to prepare the field for planting.",
                            "target_lang_translations": {
                                "cs": "Farmář připojil těžký <w>pluh</w> ke svému traktoru, aby připravil pole k setí."
                            }
                        },
                        {
                            "text": "In the museum, we saw an old wooden <w>plow</w> that was used by settlers centuries ago.",
                            "target_lang_translations": {
                                "cs": "V muzeu jsme viděli starý dřevěný <w>pluh</w>, který používali osadníci před staletími."
                            }
                        }
                    ],
                    "synonyms": [
                        "tiller"
                    ],
                    "common_phrases": [
                        "snow plow"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Common in American English"
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Zemědělský nástroj používaný k obracení a kypření půdy; americká varianta slova plough."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "pluh",
                                "target_lang_sense_clarification": "základní zemědělský nástroj pro orbu"
                            },
                            {
                                "target_lang_word": "radlice",
                                "target_lang_sense_clarification": "pracovní část pluhu"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "28e92875-aadc-316e-863a-19fa8ed589a2",
                    "sense_definition": "To break and turn over soil with a tool; an alternative spelling of <w>plough</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "agricultural_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They <w>plow</w> the fields every spring before sowing the new seeds.",
                            "target_lang_translations": {
                                "cs": "Každé jaro před setím nových semen pole <w>orají</w>."
                            }
                        },
                        {
                            "text": "It is hard work to <w>plow</w> the land by hand without modern machinery.",
                            "target_lang_translations": {
                                "cs": "Je těžká práce <w>orat</w> půdu ručně bez moderních strojů."
                            }
                        }
                    ],
                    "synonyms": [
                        "till",
                        "cultivate"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Common in American English"
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Rozrušovat a obracet půdu pomocí pluhu; americká varianta slova plough."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "orat",
                                "target_lang_sense_clarification": "činnost obracení půdy pluhem"
                            },
                            {
                                "target_lang_word": "zorat",
                                "target_lang_sense_clarification": "dokončená činnost orby"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}