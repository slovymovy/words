{
    "word_family": [
        "contention",
        "contend",
        "contentiously",
        "contentiousness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "915f6021-fb39-36c9-95b7-47358451d7b8",
                    "sense_definition": "Causing or likely to cause heated arguments or disagreement.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "argumentative",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The committee had a <w>contentious</w> debate regarding the new budget proposal.",
                            "target_lang_translations": {
                                "zh": "委员会就新的预算提案进行了一场<w>有争议的</w>辩论。"
                            }
                        },
                        {
                            "text": "They avoided discussing <w>contentious</w> issues during the family dinner.",
                            "target_lang_translations": {
                                "zh": "他们在家庭聚餐时避免讨论<w>有争议的</w>话题。"
                            }
                        }
                    ],
                    "synonyms": [
                        "controversial",
                        "debatable",
                        "disputable"
                    ],
                    "antonyms": [
                        "uncontroversial",
                        "undisputed"
                    ],
                    "common_phrases": [
                        "contentious issue",
                        "contentious debate"
                    ],
                    "target_lang_definitions": {
                        "zh": "指容易引起激烈争论或分歧的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "有争议的",
                                "target_lang_sense_clarification": "形容事物或话题容易引发不同意见。"
                            },
                            {
                                "target_lang_word": "引起争论的",
                                "target_lang_sense_clarification": "强调某事导致了争论。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f6ed546f-c138-346a-8bdb-080c51d0f9bc",
                    "sense_definition": "Having a tendency to argue or fight with others.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "argumentative",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His <w>contentious</w> nature made it difficult for him to maintain long-term friendships.",
                            "target_lang_translations": {
                                "zh": "他那<w>好争辩的</w>性格使他难以维持长久的友谊。"
                            }
                        },
                        {
                            "text": "She was a <w>contentious</w> person who always looked for a reason to disagree.",
                            "target_lang_translations": {
                                "zh": "她是一个<w>爱吵架的</w>人，总是找理由去反驳别人。"
                            }
                        }
                    ],
                    "synonyms": [
                        "argumentative",
                        "combative",
                        "quarrelsome"
                    ],
                    "antonyms": [
                        "peaceful",
                        "agreeable"
                    ],
                    "common_phrases": [
                        "contentious person",
                        "contentious nature"
                    ],
                    "target_lang_definitions": {
                        "zh": "指人好争辩、爱吵架的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "好争辩的",
                                "target_lang_sense_clarification": "形容人喜欢与人辩论。"
                            },
                            {
                                "target_lang_word": "爱吵架的",
                                "target_lang_sense_clarification": "形容人性格具有攻击性，容易发生冲突。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}