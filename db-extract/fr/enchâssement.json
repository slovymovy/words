                                        "entry_id": "d9581b7d-1a33-3a60-aacd-d677eec6280b",
                                        "glosses": [
                                            "A representation of a unit of text (such as a word or token) as a vector, which encodes the context in which it is used."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d701e307-967f-4dbc-8169-17f1c9285d86",
                                                "sense_id": "a9b35d91-4cfa-3e0e-a123-1556dd6a8ac8",
                                                "text": "word embeddings"
                                            },
                                            {
                                                "example_id": "d4720081-94d0-40e2-afeb-453339fdd2ef",
                                                "sense_id": "a9b35d91-4cfa-3e0e-a123-1556dd6a8ac8",
                                                "text": "“A major reason we chose to study word embeddings is that they have been spectacularly successful in the last few years in helping computers make sense of language,” said Arvind Narayanan, a computer scientist at Princeton University and the paper’s senior author."
                                            },
                                            {
                                                "example_id": "28d0b823-b060-40db-953d-6c06beb787ad",
                                                "sense_id": "a9b35d91-4cfa-3e0e-a123-1556dd6a8ac8",
                                                "text": "A few years ago, Dr. [Alexander] Huth noticed that particular pieces of these maps — so-called context embeddings, which capture the semantic features, or meanings, of phrases — could be used to predict how the brain lights up in response to language."
                                            }
                                        ]
