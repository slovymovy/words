                                "zh": "一旦<w>桥面板</w>在支架上固定好，重型车辆就可以通行了。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Элемент деревянного настила или платформы для временного военного моста",
                        "zh": "用于临时军用桥梁铺设的木板或平台组件。"
                    },
                    "translations": {
