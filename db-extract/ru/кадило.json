                    },
                    {
                        "form_id": "919d57ea-cb87-404a-be50-5a2a1e3cd0c0",
                        "entry_id": "653bb301-849e-3dc0-bc57-98b4acd37b03",
                        "tags": [
                            "plural",
                            "prepositional"
                        ],
                        "form": "кади́лах"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6d36ea07-3d67-3f44-ab5e-1ff135b0ef51",
                        "entry_id": "653bb301-849e-3dc0-bc57-98b4acd37b03",
                        "glosses": [
                            "религ. металлический сосуд для окуривания ладаном, употребляемый в православном и католическом богослужении"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d06f3513-ce33-479e-929e-86b42f921f60",
                                "sense_id": "6d36ea07-3d67-3f44-ab5e-1ff135b0ef51",
                                "text": "Тают зелёные свечи, // Тускло мерцает кадило, // Что-то по самые плечи // В землю сейчас уходило..."
                            }
                        ]
                    },
                    {
                        "sense_id": "0bd911a2-77da-3e10-9652-5badb7227fa0",
                        "entry_id": "653bb301-849e-3dc0-bc57-98b4acd37b03",
                        "glosses": [
                            "ботан. род многолетних травянистых растений семейства яснотковые (Melittis)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b00fb8be-8a1e-4a8b-bea1-f973dc0dcbb8",
                                "sense_id": "0bd911a2-77da-3e10-9652-5badb7227fa0",
                                "text": "В цветоводстве кадило обычно выращивают на почвах лёгкого механического состава."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a03fc604-80bd-4f55-9f1f-5691e183b636",
                        "source_entry_id": "653bb301-849e-3dc0-bc57-98b4acd37b03",
                        "source_sense_description": "сосуд для окуривания",
                        "target_lang_word": "censer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "censer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9eb5323d-4529-3b08-a8df-23f3ef379f36",
                                        "entry_id": "54d8d8f8-6a16-3981-91fc-d008455ae60f",
                                        "glosses": [
                                            "An ornamental container for burning incense, especially during religious ceremonies."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e1bf7ee-38a9-4b86-a486-0dc5b78e9b83",
                                                "sense_id": "9eb5323d-4529-3b08-a8df-23f3ef379f36",
                                                "text": "A thousand wax tapers burned in honour of the Madonna. Four beautiful children swung the silver censers before her picture, till a cloud of incense arose and floated in broken masses to the fretted roof, and the whole air was heavy with perfume."
                                            },
                                            {
                                                "example_id": "72504750-40b5-4d2a-8c53-9c53a2aba273",
                                                "sense_id": "9eb5323d-4529-3b08-a8df-23f3ef379f36",
                                                "text": "Then, methought, the air grew denser, perfumed from an unseen censer / Swung by Seraphim whose foot-falls tinkled on the tufted floor."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "697607e6-230f-3a67-9cc4-70b317ce0d5d",
                                        "entry_id": "54d8d8f8-6a16-3981-91fc-d008455ae60f",
                                        "glosses": [
                                            "A person who censes, a person who perfumes with incense."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2ebdb957-9e1c-404b-9361-f5e297440235",
                        "source_entry_id": "653bb301-849e-3dc0-bc57-98b4acd37b03",
                        "source_sense_description": "сосуд для окуривания",
                        "target_lang_word": "thurible",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "thurible",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7ee38164-55ae-34e1-a397-11c8227b7f78",
                                        "entry_id": "97e2ba06-a39c-3165-866d-cb1f15757c0d",
                                        "glosses": [
                                            "A censer, especially one hanging on a chain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8842ba75-367b-49c2-a6e7-9507c954613f",
                                                "sense_id": "7ee38164-55ae-34e1-a397-11c8227b7f78",
                                                "text": "[…] and then Father Conroy handed the thurible to Canon O’Hanlon and he put in the incense and censed the Blessed Sacrament […]."
                                            },
                                            {
                                                "example_id": "ba60f5b0-8e05-42d0-b0c8-b6332f4fc123",
                                                "sense_id": "7ee38164-55ae-34e1-a397-11c8227b7f78",
                                                "text": "1981, Dennis G. Michno, A Manual for Acolytes, Episcopal Church (Morehouse Publishing), page 55,\nThe celebrant may fill the thurible with incense before the entrance, or may instruct the thurifer to do so."
                                            },
                                            {
                                                "example_id": "2238d179-d0e7-4872-92d1-1056bc847717",
                                                "sense_id": "7ee38164-55ae-34e1-a397-11c8227b7f78",
                                                "text": "The young priest took the thurible from the altar boy and moved along the coffin. The metal of the container chinked against the chains at each flicking movement. Although the blue smoke disappeared quickly, Catherine smelled it all around her in the porch."
                                            },
                                            {
                                                "example_id": "31057bda-3265-49cd-b85f-edc4a87b5848",
                                                "sense_id": "7ee38164-55ae-34e1-a397-11c8227b7f78",
                                                "text": "1998, David Philippart, Serve God with Gladness: A Manual for Servers, Roman Catholic Archdiocese of Chicago (Liturgy Training Publications), page 41,\nIf you are carrying a bowl thurible, hold it with both hands. Hold it away from your body. Gently move it back and forth to send the smoke up.\nIf you are carrying a thurible on a chain in procession, let it swing gently at your side."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ee521cd4-31e4-499d-be6c-609f3393b857",
                        "source_entry_id": "653bb301-849e-3dc0-bc57-98b4acd37b03",
