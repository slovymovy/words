                ],
                "senses": [
                    {
                        "sense_id": "c76d15bc-fd9e-356c-aa8f-0304e8ee0e78",
                        "entry_id": "7bd35b96-e69a-3dd1-ab62-b24254f92132",
                        "glosses": [
                            "A harsh grating sound."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7177768-4a0e-4e8a-9f94-155e2422f034",
                                "sense_id": "c76d15bc-fd9e-356c-aa8f-0304e8ee0e78",
                                "text": "The tumultuous noise resolved itself now into the disorderly mingling of many voices, the gride of many wheels, the creaking of waggons, and the staccato of hoofs."
                            }
                        ]
                    }
                ],
                "translations": [],
