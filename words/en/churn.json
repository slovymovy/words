{
    "word_family": [
        "churner",
        "churning",
        "unchurned"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "18a751a1-ee86-319c-bd15-dc0a28bc7b29",
                    "sense_definition": "to move rapidly and repetitively with a rocking or tumbling motion, often due to nervousness or agitation",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "agitation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I was so nervous about the presentation that my stomach was <w>churning</w> all morning.",
                            "target_lang_translations": {
                                "ru": "Я так нервничал из-за презентации, что всё утро у меня <w>сжимало</w> желудок."
                            }
                        },
                        {
                            "text": "The dark clouds and <w>churning</w> water suggested that a massive storm was approaching the coast.",
                            "target_lang_translations": {
                                "ru": "Темные тучи и <w>бурлящая</w> вода указывали на то, что к побережью приближается мощный шторм."
                            }
                        }
                    ],
                    "synonyms": [
                        "roil",
                        "seethe",
                        "swirl",
                        "stir",
                        "turn"
                    ],
                    "antonyms": [
                        "settle",
                        "still"
                    ],
                    "common_phrases": [
                        "stomach was churning",
                        "churning water"
                    ],
                    "target_lang_definitions": {
                        "ru": "быстро и многократно двигаться с качающимся или кувыркающимся движением, часто из-за нервозности или волнения"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сжиматься",
                                "target_lang_sense_clarification": "о желудке от волнения"
                            },
                            {
                                "target_lang_word": "бурлить",
                                "target_lang_sense_clarification": "о воде или чувствах"
                            },
                            {
                                "target_lang_word": "метаться",
                                "target_lang_sense_clarification": "беспорядочно двигаться"
                            },
                            {
                                "target_lang_word": "клокотать",
                                "target_lang_sense_clarification": "о бушующей воде"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6d9bbee4-5f17-3135-8b56-23440de3cb69",
                    "sense_definition": "to agitate a liquid, especially cream, rapidly and repetitively in order to make butter",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "processing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the old days, farmers would <w>churn</w> cream by hand for hours to produce fresh butter.",
                            "target_lang_translations": {
                                "ru": "В прежние времена фермеры часами вручную <w>сбивали</w> сливки, чтобы получить свежее масло."
                            }
                        },
                        {
                            "text": "The recipe for this <w>churned</w> ice cream requires a constant stirring motion to keep it smooth.",
                            "target_lang_translations": {
                                "ru": "Рецепт этого <w>взбитого</w> мороженого требует постоянного помешивания для сохранения гладкой текстуры."
                            }
                        }
                    ],
                    "synonyms": [
                        "agitate",
                        "stir",
                        "whip"
                    ],
                    "common_phrases": [
                        "churn butter",
                        "churn cream"
                    ],
                    "target_lang_definitions": {
                        "ru": "быстро и многократно взбалтывать жидкость, особенно сливки, для приготовления масла"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сбивать",
                                "target_lang_sense_clarification": "масло или сливки"
                            },
                            {
                                "target_lang_word": "взбивать",
                                "target_lang_sense_clarification": "интенсивно перемешивать"
                            },
                            {
                                "target_lang_word": "пахтаться",
                                "target_lang_sense_clarification": "процесс изготовления масла"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d6c640ab-13e8-364d-a891-266ecd589494",
                    "sense_definition": "to stop using a company's product or service, especially a subscription",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "business_attrition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company is worried because many long-term subscribers <w>churn</w> after the initial discount period ends.",
                            "target_lang_translations": {
                                "ru": "Компания обеспокоена тем, что многие давние подписчики <w>уходят</w> после окончания периода начальных скидок."
                            }
                        },
                        {
                            "text": "If a customer <w>churns</w> within the first month, the marketing cost to acquire them is lost.",
                            "target_lang_translations": {
                                "ru": "Если клиент <w>отказывается</w> от услуг в первый же месяц, затраты на его привлечение считаются потерянными."
                            }
                        }
                    ],
                    "synonyms": [
                        "cancel",
                        "leave",
                        "quit"
                    ],
                    "antonyms": [
                        "renew",
                        "subscribe"
                    ],
                    "common_phrases": [
                        "customer churns"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used frequently in business and marketing contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "прекратить использование продукта или услуги компании, особенно подписки"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уходить",
                                "target_lang_sense_clarification": "о клиентах"
                            },
                            {
                                "target_lang_word": "отказываться от подписки",
                                "target_lang_sense_clarification": "прекращать пользоваться сервисом"
                            },
                            {
                                "target_lang_word": "прекращать сотрудничество",
                                "target_lang_sense_clarification": "в бизнес-контексте"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d8e5cbee-90cf-397b-8fb9-e0d234d802f3",
                    "sense_definition": "to continually sign up for new credit cards to earn signup bonuses and airline miles",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "finance_tactics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He managed to travel around the world for free by <w>churning</w> credit cards for their travel points.",
                            "target_lang_translations": {
                                "ru": "Ему удалось бесплатно объездить весь мир, <w>накручивая</w> бонусы по кредитным картам ради миль."
                            }
                        },
                        {
                            "text": "Banks are implementing new rules to prevent people who <w>churn</w> accounts just for the bonuses.",
                            "target_lang_translations": {
                                "ru": "Банки вводят новые правила, чтобы помешать людям, которые <w>открывают</w> счета только ради бонусов."
                            }
                        }
                    ],
                    "common_phrases": [
                        "churn credit cards"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Specific to the credit card and travel hacking community."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "постоянно регистрировать новые кредитные карты для получения бонусов и миль"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чернить",
                                "target_lang_sense_clarification": "сленг: серийное открытие карт ради бонусов"
                            },
                            {
                                "target_lang_word": "накручивать бонусы",
                                "target_lang_sense_clarification": "через смену аккаунтов или карт"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a8a6a176-0f1c-3e39-bb6e-b55398c25345",
                    "sense_definition": "a vessel or container used for agitating cream to produce butter",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "containers",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The museum displayed an antique wooden <w>churn</w> that was used on a local farm in the 1800s.",
                            "target_lang_translations": {
                                "ru": "В музее была выставлена старинная деревянная <w>маслобойка</w>, которая использовалась на местной ферме в 1800-х годах."
                            }
                        },
                        {
                            "text": "She poured the heavy cream into the butter <w>churn</w> and began the rhythmic task of making butter.",
                            "target_lang_translations": {
                                "ru": "Она налила жирные сливки в <w>маслобойку</w> и приступила к ритмичной работе по приготовлению масла."
                            }
                        }
                    ],
                    "common_phrases": [
                        "butter churn"
                    ],
                    "target_lang_definitions": {
                        "ru": "сосуд или контейнер, используемый для взбалтывания сливок с целью получения масла"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "маслобойка",
                                "target_lang_sense_clarification": "приспособление для сбивания масла"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9bf4edc2-4a84-33b9-b5bf-174026c66809",
                    "sense_definition": "the rate at which customers stop doing business with an entity; customer attrition",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "business_attrition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The software company reported a high <w>churn</w> this quarter due to increased competition in the market.",
                            "target_lang_translations": {
                                "ru": "IT-компания сообщила о высоком <w>оттоке</w> клиентов в этом квартале из-за усиления конкуренции на рынке."
                            }
                        },
                        {
                            "text": "Reducing customer <w>churn</w> is the primary goal of the new loyalty program they launched.",
                            "target_lang_translations": {
                                "ru": "Снижение <w>оттока</w> клиентов — основная цель запущенной ими новой программы лояльности."
                            }
                        }
                    ],
                    "synonyms": [
                        "attrition",
                        "turnover",
                        "loss"
                    ],
                    "antonyms": [
                        "retention"
                    ],
                    "common_phrases": [
                        "customer churn",
                        "churn rate"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Commonly used in business and tech industries."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "показатель того, как быстро клиенты перестают вести дела с организацией; отток клиентов"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отток",
                                "target_lang_sense_clarification": "потеря клиентов или абонентов"
                            },
                            {
                                "target_lang_word": "текучесть",
                                "target_lang_sense_clarification": "сменяемость клиентской базы"
                            },
                            {
                                "target_lang_word": "churn-rate",
                                "target_lang_sense_clarification": "профессиональный термин в маркетинге"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "87610df2-8c1a-3405-b1e4-6e8f1ce76bfa",
                    "sense_definition": "a large metal container used for the transportation of milk",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "containers",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer loaded the heavy milk <w>churns</w> onto the back of the truck for delivery.",
                            "target_lang_translations": {
                                "ru": "Фермер погрузил тяжелые молочные <w>бидоны</w> в кузов грузовика для доставки."
                            }
                        },
                        {
                            "text": "You could hear the clanging of the metal <w>churn</w> as it was moved across the stone floor.",
                            "target_lang_translations": {
                                "ru": "Был слышен лязг металлической <w>фляги</w>, когда её тащили по каменному полу."
                            }
                        }
                    ],
                    "synonyms": [
                        "can",
                        "container"
                    ],
                    "common_phrases": [
                        "milk churn"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "More common in British English."
                        },
                        {
                            "trait_type": "dated",
                            "comment": "Modern milk transport usually uses tanks rather than individual churns."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "большой металлический контейнер, используемый для транспортировки молока"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бидон",
                                "target_lang_sense_clarification": "металлический сосуд для молока"
                            },
                            {
                                "target_lang_word": "фляга",
                                "target_lang_sense_clarification": "большая емкость для жидкостей"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "54982e69-d6ea-32bf-8aeb-4bea011ebf21",
                    "sense_definition": "repetitive or cyclic activity that produces no useful result or progress",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "agitation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The constant <w>churn</w> of staff in the department made it impossible to finish any long-term projects.",
                            "target_lang_translations": {
                                "ru": "Постоянная <w>текучка</w> кадров в отделе сделала невозможным завершение долгосрочных проектов."
                            }
                        },
                        {
                            "text": "He felt trapped in a pointless <w>churn</w> of meetings that never led to any actual decisions.",
                            "target_lang_translations": {
                                "ru": "Он чувствовал себя в ловушке бессмысленной <w>череды</w> совещаний, которые никогда не приводили к реальным решениям."
                            }
                        }
                    ],
                    "synonyms": [
                        "turmoil",
                        "commotion"
                    ],
                    "common_phrases": [
                        "pointless churn",
                        "huge churn"
                    ],
                    "target_lang_definitions": {
                        "ru": "повторяющаяся или циклическая деятельность, которая не приносит полезного результата или прогресса"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "текучка",
                                "target_lang_sense_clarification": "бесполезная суета или смена кадров"
                            },
                            {
                                "target_lang_word": "суета",
                                "target_lang_sense_clarification": "бесплодная деятельность"
                            },
                            {
                                "target_lang_word": "перемалывание",
                                "target_lang_sense_clarification": "процесс без результата"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}