                        "sense_id": "e991b5be-594a-3770-9b47-e61b80ee4519",
                        "entry_id": "68bffcce-dc7a-3310-bb11-bcce77e9a640",
                        "glosses": [
                            "Cancer de la vessie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4c90d83-1130-4ffd-a1e2-5cd51c5bb7a6",
                                "sense_id": "e991b5be-594a-3770-9b47-e61b80ee4519",
                                "text": "Männer erkranken häufiger an Blasenkrebs als Frauen.",
                                "translation": "Le cancer de la vessie touche plus les hommes que les femmes."
                            },
                            {
                                "example_id": "71a4defe-5cee-4147-a2ed-ccb8158e5baf",
                                "sense_id": "e991b5be-594a-3770-9b47-e61b80ee4519",
                                "text": "Der Blasenkrebs war bereits ins letzte Stadium getreten, als Herd und Metastasen von Doktor Aaron entdeckt wurden.",
                                "translation": "Le cancer de la vessie avait déjà atteint son dernier stade de développement lorsque des foyers et des métastases ont été découverts par le docteur Aaron."
                            }
                        ]
                    }
