                                ]
                            },
                            {
                                "target_word": "way back",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7f144fa7-b361-39d1-a588-e4dc13e0bb13",
                                        "entry_id": "7193a8cb-6520-3f33-9cc9-f94c0fcad457",
                                        "glosses": [
                                            "The part farthest in the back, as of a passenger vehicle."
                                        ],
                                        "tags": [
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c30ce38-bfb0-4538-9e5d-87541766f094",
                                                "sense_id": "7f144fa7-b361-39d1-a588-e4dc13e0bb13",
                                                "text": "Mom swerves the church's turd-brown minivan into an open space. Departure area. The little kids are in the back seat. They ramble on about the airport. Patrick sits in the way back."
                                            }
                                        ]
                                    }
                                ]
