                ],
                "senses": [
                    {
                        "sense_id": "93daad8c-e066-3f67-81bd-fbc89bfc9113",
                        "entry_id": "67751163-afd6-3da2-bf57-5b67be72a0ca",
                        "glosses": [
                            "Changer régulièrement de lieu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b4ef98d-7f7d-4ceb-a0c7-8fea56dc0e72",
                                "sense_id": "93daad8c-e066-3f67-81bd-fbc89bfc9113",
                                "text": "Durant un an, cette exposition va itinérer dans toutes les communes du Jura qui hébergent un centre de loisirs Francas."
                            },
                            {
                                "example_id": "58ff1171-131e-4b10-bb48-c76ad1656b0a",
                                "sense_id": "93daad8c-e066-3f67-81bd-fbc89bfc9113",
                                "text": "Avant de commander les autres, lui aussi avait itinéré et plusieurs fois il s’était fait prendre."
                            },
                            {
                                "example_id": "f322757c-3af0-425a-ac27-5e1255bb229c",
                                "sense_id": "93daad8c-e066-3f67-81bd-fbc89bfc9113",
                                "text": "Dans ce métier, vaut mieux itinérer, tu sais."
                            },
                            {
                                "example_id": "0b64affc-12f4-45ea-b0f7-aa70652ec7e8",
                                "sense_id": "93daad8c-e066-3f67-81bd-fbc89bfc9113",
                                "text": "Malgré les marches incessantes et les portages, Simon était soulagé d’itinérer de maquis en maquis, admiratif de ceux qui acceptaient de vivre en camp et se soumettre à une telle discipline."
                            }
                        ]
                    }
