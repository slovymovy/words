                ],
                "senses": [
                    {
                        "sense_id": "862e95f7-e750-3685-96da-fc84e01899aa",
                        "entry_id": "97bb7985-9e48-377c-9bc0-82578b579a0d",
                        "glosses": [
                            "Linguistik, speziell jüngere Sprache, die durch die historische Entwicklung aus einer älteren hervorgegangen ist"
                        ],
                        "tags": [
                            "Historiolinguistik"
                        ],
                        "examples": [
                            {
                                "example_id": "999b94fc-539b-447c-90cb-40812a860de9",
                                "sense_id": "862e95f7-e750-3685-96da-fc84e01899aa",
                                "text": "„Nicht nur für die Linguistin, die in Italien in einem Staat viele koexistierende und einander beeinflussende Sprachen vorfindet, sondern auch für die Literaturwissenschaftlerin, welche auf italienisch, napoletanisch, venezianisch etc. verfaßte Werke untersuchen kann, ist Italien eines der interessantesten Studienobjekte innerhalb der Romanischen Philologie (Romanistik), die sich mit den Sprachen und Kulturen aller romanischen Völker, die eine Folgesprache des Lateins sprechen, befaßt.“"
                            },
                            {
                                "example_id": "206ae36e-9629-4921-bca2-136f6841cae2",
                                "sense_id": "862e95f7-e750-3685-96da-fc84e01899aa",
                                "text": "„Lateinischer Wortschatz: Erwerben des gesamten allgemeinen Grundwortschatzes, sofern relevant für Folgesprachen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "8a1682ff-bcbf-3a49-a2c4-4a231ec2e63b",
                        "entry_id": "97bb7985-9e48-377c-9bc0-82578b579a0d",
                        "glosses": [
                            "Sprache, die man nach einer anderen lernt"
                        ],
                        "tags": [
                            "Sprachdidaktik"
                        ],
                        "examples": [
                            {
                                "example_id": "2e0d6ef7-3888-4227-b349-5ca93ff762ec",
                                "sense_id": "8a1682ff-bcbf-3a49-a2c4-4a231ec2e63b",
                                "text": "„Mehr als eine Fremdsprache effizient lernen: Tertiärsprachen lehren und lernen in Europa. Beispiel: Deutsch als Folgesprache nach Englisch.“"
                            },
                            {
                                "example_id": "c69f7dc0-eb2b-4004-bbdd-8ed22e4b0141",
                                "sense_id": "8a1682ff-bcbf-3a49-a2c4-4a231ec2e63b",
                                "text": "„Viele deutsche Wissenschaftler arbeiten jetzt daran, wie man die Kenntnisse und Erfahrungen beim Lehren und Erlernen der Muttersprache und der ersten Fremdsprache (Englisch) im Unterricht vom Deutsch als Folgesprache (Tertiärsprache) so nutzbar machen kann, dass dieses effizienter gelernt wird.“"
                            },
                            {
                                "example_id": "cf2883d7-c5cd-4249-8425-4be0a62d91cb",
                                "sense_id": "8a1682ff-bcbf-3a49-a2c4-4a231ec2e63b",
                                "text": "„Insbesondere zum Einstieg ins Deutsche kann auch für italienische Deutschlernende die Sprachkonstellation Deutsch als Folgesprache des Englischen bzw. als parallel zum Englischen angebotene Sprache genutzt werden.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
