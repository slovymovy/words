                        "sense_id": "647fe693-81d4-3940-ab86-0bea4aa501c9",
                        "entry_id": "48aeaf79-755f-3aa0-8ccd-cbf706db940b",
                        "glosses": [
                            "The state or characteristic of being dormant; quiet, inactive restfulness."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "1f775b70-45cf-4d65-b621-74bc2fdb3f84",
                                "sense_id": "647fe693-81d4-3940-ab86-0bea4aa501c9",
                                "text": "[N]ow the big Thanksgiving dinner which they had eaten was beginning to work upon them a spell of dormancy."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "903c8f7b-e10c-443e-971d-c9d3c284d91d",
                        "source_entry_id": "48aeaf79-755f-3aa0-8ccd-cbf706db940b",
                        "source_sense_id": "647fe693-81d4-3940-ab86-0bea4aa501c9",
                        "source_sense_description": "state of being dormant",
                        "target_lang_word": "dormance",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dormance",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "932caacd-7b38-32a5-8006-ff639db706c2",
                                        "entry_id": "b952a733-b3c4-3aa2-973d-6754d1df1b7f",
                                        "glosses": [
                                            "Quiescence d’un organe jeune dont le développement reprendra après cette pause."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "554767f6-d9a8-4614-bcfe-a9c96d0d22b2",
                                                "sense_id": "932caacd-7b38-32a5-8006-ff639db706c2",
                                                "text": "L'endospore permet à la bactérie de survivre à ces conditions défavorables dans un état de dormance mais aussi une forme de dissémination."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c01f5920-e4d7-3329-aba9-8dc76cb19a34",
                                        "entry_id": "b952a733-b3c4-3aa2-973d-6754d1df1b7f",
                                        "glosses": [
                                            "Période de repos des plantes déclenchée par la baisse de la température et par la diminution de la photopériode."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15a839f9-8715-473d-b90d-2e45d1403b30",
                                                "sense_id": "c01f5920-e4d7-3329-aba9-8dc76cb19a34",
                                                "text": "Les graminées et les légumineuses tropicales demandent une attention particulière car leur pouvoir germinatif peut être très variable selon l'origine des semences, ou pour des raisons de dormance."
                                            },
                                            {
                                                "example_id": "d3994f48-9ad1-4916-bb65-46dbba5ee79e",
                                                "sense_id": "c01f5920-e4d7-3329-aba9-8dc76cb19a34",
                                                "text": "On malte l’orge avant de l’utiliser pour l’élaboration de la bière. On commence par la dormance : l’orge est conservée en vue d’une maturation qui rend le grain plus apte à réagir lors du trempage."
                                            },
                                            {
                                                "example_id": "b0248d65-c7ec-4c76-b347-b4c44c17f21b",
                                                "sense_id": "c01f5920-e4d7-3329-aba9-8dc76cb19a34",
                                                "text": "Si, à l’inverse, le débourrement est initié par une certaine quantité de chaleur reçue, « le manque de froid affecte le nombre de bourgeons qui sont débourrés et la dormance se lève mal »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
