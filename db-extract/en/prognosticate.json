                                        "entry_id": "296b2c6d-8ddd-3a7f-a6f1-a08f2b2cfed7",
                                        "glosses": [
                                            "eine Prognose stellen; vorhersagen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be22c181-c356-428f-8e90-631d7b6c9fad",
                                                "sense_id": "0d6e8381-8099-30f2-ae74-64863be749f7",
                                                "text": "Die Experten prognostizierten vor Jahren das Ende der Langspielplatte."
                                            },
                                            {
                                                "example_id": "84a023bd-3797-4abe-92ca-dccffa0e2616",
                                                "sense_id": "0d6e8381-8099-30f2-ae74-64863be749f7",
                                                "text": "Die von mir prognostizierte Sterblichkeitsrate hat sich als falsch herausgestellt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
