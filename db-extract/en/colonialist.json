                                    {
                                        "sense_id": "fa55de58-d6f2-31b2-a066-57396fdb54fc",
                                        "entry_id": "e6431891-fdf3-33af-ac2f-fda556cf3680",
                                        "glosses": [
                                            "weibliche Person, die den Kolonialismus befürwortet"
