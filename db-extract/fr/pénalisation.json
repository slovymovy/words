                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f17c2ab-a64d-439e-9ec9-bffa08c159c3",
                                "sense_id": "21794f77-0caf-3429-99c8-fefed6299e39",
                                "text": "Le but d’une taxe est de modifier les comportements. […]. Cette taxe est une pénalisation, non une incitation, puisque rien n’est prévu pour financer une solution de remplacement."
                            }
                        ]
                    },
                    {
                        "sense_id": "b705e35a-8ed4-39e9-86a2-12a78c0db920",
                        "entry_id": "9dd17a34-3457-32e0-99ed-0df1dc0db9fc",
                        "glosses": [
                            "Fait d’être pénalisé."
                        ],
                        "tags": [],
                        "examples": [
                            {
