                "senses": [
                    {
                        "sense_id": "0090748a-bfaf-3276-a447-6658cb7dee49",
                        "entry_id": "989a117a-2038-32b8-ad32-189a6896d794",
                        "glosses": [
                            "One who makes tautologies."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55ac70b8-d9ea-47b1-85c6-010d778f9e14",
                                "sense_id": "0090748a-bfaf-3276-a447-6658cb7dee49",
                                "text": "His is the pseudo-movement, where the doubling simply mimics the routine of a tautologist, of a monologist, and of a Hegelian dialectician."
                            },
                            {
                                "example_id": "cc6d61cd-2551-4dbd-b9be-425f1c3f1221",
                                "sense_id": "0090748a-bfaf-3276-a447-6658cb7dee49",
                                "text": "Nature isn't such a tautologist as to make another to follow him."
                            },
                            {
                                "example_id": "daf7231a-faf9-4eab-8c60-f1ab637a99fa",
                                "sense_id": "0090748a-bfaf-3276-a447-6658cb7dee49",
                                "text": "When his action is mechanically good he produces a great effect on an uncritical assembly, but he is a tiresome tautologist to the intellectual."
                            },
                            {
                                "example_id": "2996cf83-2d1d-44f0-9147-25af0e508c7c",
                                "sense_id": "0090748a-bfaf-3276-a447-6658cb7dee49",
                                "text": "Do you think that God is a tautologist? Let us have faith! Let us say something positive. Irony of itself is the beginning of baseness."
                            },
                            {
                                "example_id": "8d846fd9-d273-4d3b-a781-4f76a350191c",
                                "sense_id": "0090748a-bfaf-3276-a447-6658cb7dee49",
                                "text": "Oh, that damn'd tautologist too!"
                            }
                        ]
                    }
                ],
