        "fr-extract.jsonl": [
            {
                "entry_id": "f2091103-d321-3882-8780-c458e860e3d7",
                "word": "Semis",
                "pos": "name",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c5adf4cd-fb93-4621-bec0-5c5777cd1dca",
                        "entry_id": "f2091103-d321-3882-8780-c458e860e3d7",
                        "tags": [],
                        "form": "SEMIS"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1a6a7487-0956-3f28-bc25-19c6fcbc79f3",
                        "entry_id": "f2091103-d321-3882-8780-c458e860e3d7",
                        "glosses": [
                            "Société de logement social de Saintonge, en France."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7761463b-a7e8-4eda-9804-f33857b89954",
                                "sense_id": "1a6a7487-0956-3f28-bc25-19c6fcbc79f3",
                                "text": "La Semis va aussi construire quatre logements sociaux du côté de Corme-Royal."
                            },
                            {
                                "example_id": "24c012ed-b786-4cde-be29-a7c0edf17d6d",
                                "sense_id": "1a6a7487-0956-3f28-bc25-19c6fcbc79f3",
                                "text": "Au cours du week-end, le système informatique de la Société d’économie mixte immobilière de la Saintonge (Semis) a fait l’objet d’une cyberattaque de type « cryptolocker »."
                            },
                            {
                                "example_id": "cb95867f-9871-41a8-bd6b-062dab3f2393",
                                "sense_id": "1a6a7487-0956-3f28-bc25-19c6fcbc79f3",
                                "text": "La Ville de Saintes et la Semis, le bailleur social saintais, lancent de grands programmes de construction."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "6c61f845-d805-3e63-8d70-dda2b07246b1",
                "word": "semis",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c8641d66-4b4c-3a1f-9c6a-478fa6514954",
                        "entry_id": "6c61f845-d805-3e63-8d70-dda2b07246b1",
                        "glosses": [
                            "Mise en terre des semences ; action de semer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8622140a-94c7-49a3-9178-5fece9a4a7cf",
                                "sense_id": "c8641d66-4b4c-3a1f-9c6a-478fa6514954",
                                "text": "Le Bacchus, qui provient d'un semis de Clinton, est un cépage d'avenir pour la culture en treillages dans les sols profonds."
                            },
                            {
                                "example_id": "8b5505fd-9556-4bae-820a-b5c2f1e09a19",
                                "sense_id": "c8641d66-4b4c-3a1f-9c6a-478fa6514954",
                                "text": "La qualité des semences (le pouvoir germinatif), l’époque de semis ou de plantation et la densité sont des facteurs essentiels du rendement des cultures."
                            },
                            {
                                "example_id": "9f91ed1d-9bad-4052-9888-fac7039da204",
                                "sense_id": "c8641d66-4b4c-3a1f-9c6a-478fa6514954",
                                "text": "À Charbuy, dans l’Yonne, Anaïs Sanjuan, maraîchère, a testé un appareil génération, rapporte France Bleu Auxerre : un robot, autonome, s’est ainsi occupé, pendant un mois, des semis de carottes, puis du désherbage des rangées de légumes."
                            }
                        ]
                    },
                    {
                        "sense_id": "88939dbe-3d03-3964-b6ac-f58a870614cb",
                        "entry_id": "6c61f845-d805-3e63-8d70-dda2b07246b1",
                        "glosses": [
                            "Plant d’arbrisseaux, de plantes, de fleurs venant de graines."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d391eb3-6c9a-4694-be33-4f5378f833df",
                                "sense_id": "88939dbe-3d03-3964-b6ac-f58a870614cb",
                                "text": "J’ai un beau semis d’œillets, de renoncules."
                            },
                            {
                                "example_id": "aebda72f-f5b6-4e50-9ece-f19d005d56ad",
                                "sense_id": "88939dbe-3d03-3964-b6ac-f58a870614cb",
                                "text": "Faire un semis."
                            },
                            {
                                "example_id": "101a697a-75a7-4501-bbc0-05c66fdb0f0b",
                                "sense_id": "88939dbe-3d03-3964-b6ac-f58a870614cb",
                                "text": "Semis sur couche."
                            }
                        ]
                    },
                    {
                        "sense_id": "b52939e0-c52a-3d90-8ca5-9e6ed396c66e",
                        "entry_id": "6c61f845-d805-3e63-8d70-dda2b07246b1",
                        "glosses": [
                            "Jeunes plants issus de la germination des graines."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7255b36a-c98f-44d6-9219-ae35863582c2",
                                "sense_id": "b52939e0-c52a-3d90-8ca5-9e6ed396c66e",
                                "text": "Le semis est un des meilleurs moyens de créer de beaux bonsaï."
                            }
                        ]
                    },
                    {
                        "sense_id": "1b188660-ff19-3afd-ae5f-dba21e7484ea",
                        "entry_id": "6c61f845-d805-3e63-8d70-dda2b07246b1",
                        "glosses": [
                            "Ornement répandu, motif fréquemment répété."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bcc57ad2-5f9e-4052-96d8-3f80b6b9fcbe",
                                "sense_id": "1b188660-ff19-3afd-ae5f-dba21e7484ea",
                                "text": "Modeste montrait à la main de son père une cravache dont le bout était un semis de turquoises, une invention alors à la mode, et devenue depuis assez vulgaire."
                            },
                            {
                                "example_id": "82b0c4df-a38b-4330-ad07-cbf4f63594f5",
                                "sense_id": "1b188660-ff19-3afd-ae5f-dba21e7484ea",
                                "text": "La porte est historiée des armes de Burgos en relief, avec un semis de petites croix de gueules."
                            },
                            {
                                "example_id": "732689a3-1f48-4a2e-a9f0-14499c0fccca",
                                "sense_id": "1b188660-ff19-3afd-ae5f-dba21e7484ea",
                                "text": "Sur le faîte du monument, le soleil couchant jetait un semis d’or très ténu."
                            }
                        ]
                    },
                    {
                        "sense_id": "e2618a6c-beec-3a42-bc95-425922a63636",
                        "entry_id": "6c61f845-d805-3e63-8d70-dda2b07246b1",
                        "glosses": [
                            "Canevas constitué par un ensemble de points répartis de façon irrégulière ou quelconque sur une zone géographique donnée."
                        ],
                        "tags": [],
                        "examples": []
                    }
