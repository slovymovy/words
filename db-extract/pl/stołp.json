                "translations": [
                    {
                        "translation_id": "53547cb5-8fa9-49bc-a360-70fc4b9bbcbc",
                        "source_entry_id": "9270ad5e-b7ce-3da4-956e-d0ed0fa24238",
                        "source_sense_id": "c8df3e41-f73d-39c0-ae36-347b181688df",
                        "target_lang_word": "bergfried",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bergfried",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0373070c-1dee-3c63-9882-767bbfcc17af",
                                        "entry_id": "cd14c9c0-ff28-3dd1-b8d0-50b4b805d568",
                                        "glosses": [
                                            "A tall defensive tower typically found in medieval castles in German-influenced countries."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "188a1a1c-9fa5-4370-b527-d5108999b008",
                                                "sense_id": "0373070c-1dee-3c63-9882-767bbfcc17af",
                                                "text": "Founded in 1100, and boasting a bergfried (free-standing defensive tower), turreted ramparts, and Gothic additions, it's the only medieval castle on the Rhine never to have been destroyed."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a05ff324-207d-4e64-99b3-89e0e518bd82",
                        "source_entry_id": "9270ad5e-b7ce-3da4-956e-d0ed0fa24238",
                        "source_sense_id": "c8df3e41-f73d-39c0-ae36-347b181688df",
                        "target_lang_word": "Bergfried",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bergfried",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4f7e3f2b-02b6-38c5-9363-dfe573ee5b90",
                                        "entry_id": "7406100c-5b43-38c3-9820-80352a9eb408",
                                        "glosses": [
                                            "der für die letzte Verteidigung gedachte innere Hauptturm einer mittelalterlichen Burg"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ab6f617-7594-4e51-9274-c7aa2d8046f0",
                                                "sense_id": "4f7e3f2b-02b6-38c5-9363-dfe573ee5b90",
                                                "text": "„Der Bergfried etablierte sich als ein neuer Bautyp im Verlauf des 12. Jahrhunderts und prägte von ungefähr 1180 bis in das 14. Jahrhundert hinein das Bild der mitteleuropäischen Burgenlandschaft.“"
                                            },
                                            {
                                                "example_id": "e60534fe-7295-4c3f-9713-cdbc796df60d",
                                                "sense_id": "4f7e3f2b-02b6-38c5-9363-dfe573ee5b90",
                                                "text": "„Nur der Bergfried war gut zu erkennen, denn der Bergfried stand noch in voller Größe da, die anderen Teile der Anlage aber hatten die Franzosen vor etwa dreihundert Jahren einfach zerstört.“"
                                            },
                                            {
                                                "example_id": "ada0f16d-6374-49c7-97fc-6d4cb8dc8ede",
                                                "sense_id": "4f7e3f2b-02b6-38c5-9363-dfe573ee5b90",
                                                "text": "„Die dicke Kette im Korridor stammte aus dem Verlies des Bergfrieds von Torteval.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
