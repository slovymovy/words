                                    {
                                        "sense_id": "4ef520ea-c552-34a9-85b6-615a773f0734",
                                        "entry_id": "d9f52b3f-589c-318f-b672-32990eab0dcd",
                                        "glosses": [
                                            "An archipelago and overseas territory of the United States in the Pacific Ocean. Official name: Territory of American Samoa. It is distinct from Samoa (formerly: Western Samoa)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94f8ffaf-43dd-45f3-a5fa-77bbe81fabec",
                                                "sense_id": "4ef520ea-c552-34a9-85b6-615a773f0734",
                                                "text": "SECRETARY James G. Blaine, on April 11, 1889, instructed the American Samoa commissioners at Berlin that the plan of governing natives without their consent was \"not in harmony with the established policy of this government.\""
                                            },
                                            {
                                                "example_id": "ce24fdbc-fe4d-49eb-92dc-272368e1785a",
                                                "sense_id": "4ef520ea-c552-34a9-85b6-615a773f0734",
                                                "text": "In a decision citing American Samoa cultural traditions, those born in the U.S. territory shouldn’t have citizenship automatically forced on them, a federal appeals court ruled Wednesday.[…]\nAmerican Samoa is the only unincorporated territory of the United States where the inhabitants are not American citizens at birth.[…]\nDrawing on the views of the American Samoa people is one of the more gratifying aspects of the ruling, said Michael Williams, an attorney representing the American Samoa government, which intervened to oppose the lawsuit.\n“It is also vindication for the principle that the people of American Samoa should determine their own status in accordance with Samoan culture and traditions,” he said."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
