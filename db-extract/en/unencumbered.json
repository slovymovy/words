                    {
                        "translation_id": "a0bb7314-db65-4397-9ac6-8c7773da9f39",
                        "source_entry_id": "50abc118-b0c6-3ba4-9622-404bdd0162c4",
                        "source_sense_description": "of property, not subject to any claims",
                        "target_lang_word": "unverschuldet",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unverschuldet",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "87e6d943-9b9c-35b6-9aac-5648e2e745ff",
                                        "entry_id": "9138d686-7c7e-3a37-958c-f1ecd468d080",
                                        "glosses": [
                                            "frei von (Einflüssen der) Schuld"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d593759-509d-47d8-962f-ceb5ca0e6935",
                                                "sense_id": "87e6d943-9b9c-35b6-9aac-5648e2e745ff",
                                                "text": "„Die Bettlerlizenz wurde erteilt, wenn es sich um unverschuldet in Armut geratene Arbeitsunfähige handelte und wenn diese einen Glaubensnachweis erbringen konnten; als äußerliches Kennzeichen war ein gelbes Tuch um den Hals zu tragen.“"
                                            },
                                            {
                                                "example_id": "4cb503c7-aa0f-4273-be64-87ed2a904ecd",
                                                "sense_id": "87e6d943-9b9c-35b6-9aac-5648e2e745ff",
                                                "text": "„Die Einhaltung grundlegender Reinlichkeitsnormen wurde zur Voraussetzung des Almosenempfangs, ein reinliches Haus zum Maßstab für verschuldete und unverschuldete Armut erhoben.“"
                                            },
                                            {
                                                "example_id": "ac2603de-d487-4c93-857a-5a1d72485317",
                                                "sense_id": "87e6d943-9b9c-35b6-9aac-5648e2e745ff",
                                                "text": "„[In Schottland] wird allgemein anerkannt, dass jeder unverschuldet in Schwierigkeiten geraten kann.“"
                                            },
                                            {
                                                "example_id": "f4a21e14-9528-4def-a939-8ee3d76a6198",
                                                "sense_id": "87e6d943-9b9c-35b6-9aac-5648e2e745ff",
                                                "text": "„Wird die Notlage einer fremden Person durch eigenes Verschulden wahrgenommen, so kann dies zu Ekel und Arger führen, wobei eine unverschuldete Notlage Sympathie und Hilfeleistung hervorrufen kann.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
