                        ],
                        "examples": [
                            {
                                "example_id": "c28bdd53-df19-4fc3-affd-4b40ad6f97ba",
                                "sense_id": "6fec466e-45ed-3567-9765-19ff8c5af6d9",
                                "text": "— Как я сюда́ попа́л, убе́й меня́ бог, не по́мню. Вот стервецы́, опя́ть меня́ обокра́ли!",
                                "translation": "How I got here, may God kill me, I do not remember. Those bastards, they robbed me again!",
                                "english": "How I got here, may God kill me, I do not remember. Those bastards, they robbed me again!"
                            }
                        ]
                    }
