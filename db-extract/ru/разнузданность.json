                        "examples": [
                            {
                                "example_id": "16a1a028-d813-417a-89bc-139395bd320b",
                                "sense_id": "cb90b086-1d92-37d0-a6d9-d86d064ac2aa",
                                "text": "Лицеме́рие уде́рживает о́бщество от разну́зданности страсте́й и де́лает после́днюю привиле́гией лишь са́мого ограни́ченного меньшинства́.",
                                "translation": "Hypocrisy restrains society from profligacy and makes the latter a privilege enjoyed only by a very restricted minority.",
                                "english": "Hypocrisy restrains society from profligacy and makes the latter a privilege enjoyed only by a very restricted minority."
                            }
                        ]
                    }
