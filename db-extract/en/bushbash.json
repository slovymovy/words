                "senses": [
                    {
                        "sense_id": "a1d82775-2c55-3a9a-8ff6-678293367ac3",
                        "entry_id": "d479e6be-d079-33b2-ae86-dd1889da4841",
                        "glosses": [
                            "To travel or build a route straight across country rather than following an established track, typically involving forcing one's way through forest and/or undergrowth."
                        ],
                        "tags": [
                            "Australia",
                            "New-Zealand"
                        ],
                        "examples": [
                            {
                                "example_id": "fd328ae9-fde1-4353-9bae-959304b7ce23",
                                "sense_id": "a1d82775-2c55-3a9a-8ff6-678293367ac3",
                                "text": "Today she and husband Murray “bushbash” regularly, going camping in remote gorges and creeks."
                            },
                            {
                                "example_id": "b19bdc15-7886-41db-bda2-351db5109d49",
                                "sense_id": "a1d82775-2c55-3a9a-8ff6-678293367ac3",
                                "text": "2008, George Dunford, Matthew D. Firestone, Anthony Ham, The Big Trip: Your Ultimate Guide to Gap Years and Overseas Adventures, Lonely Planet, page 215,\nExperienced bushbashing motorcyclists prize the rough roads of Cambodia, Laos and northern Thailand."
                            },
                            {
                                "example_id": "9c790d23-8238-44ee-84f3-47b5d2fea364",
                                "sense_id": "a1d82775-2c55-3a9a-8ff6-678293367ac3",
                                "text": "2010, Stu Gibson, A queer sort of intelligence, Martin Crump (editor), The Search For The Great Kiwi Yarn, unnumbered page,\nSo rather than bushbash my way down to the road end, I decided to cut uphill to meet the round-the-mountain track and take the easy way out."
                            }
                        ]
                    }
