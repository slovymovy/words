            {
                "entry_id": "f80df2ff-8faa-32f8-a695-084c3252a1ca",
                "word": "conteur",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "924039ec-4099-47ab-8c4c-748c993e4fdd",
                        "entry_id": "f80df2ff-8faa-32f8-a695-084c3252a1ca",
                        "tags": [
                            "plural"
                        ],
                        "form": "conteurs"
                    },
                    {
                        "form_id": "4e5bf9b0-9a54-4c29-b5a2-ad78d8245e47",
                        "entry_id": "f80df2ff-8faa-32f8-a695-084c3252a1ca",
                        "tags": [
                            "feminine"
                        ],
                        "form": "conteuse"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ff07d068-9f25-3f53-b8c1-dccecd456e63",
                        "entry_id": "f80df2ff-8faa-32f8-a695-084c3252a1ca",
                        "glosses": [
                            "Celui qui écrit ou raconte des contes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47f03a0e-ebf1-4814-8cf6-a3cbb658127f",
                                "sense_id": "ff07d068-9f25-3f53-b8c1-dccecd456e63",
                                "text": "Appartenant à la grande confrérie des conteurs et chanteurs errants, ce troubadour marocain ne possède pour toute fortune qu'un âne famélique, un vieux haïk en lambeaux, une pipe et une blague à kif et un petit instrument primitif à deux cordes, un gimbri, attribut de son état."
                            },
                            {
                                "example_id": "17bf9f45-8f76-4e5f-a99e-6fce5cd38e4e",
                                "sense_id": "ff07d068-9f25-3f53-b8c1-dccecd456e63",
                                "text": "Certes, Jean-Luc en tira l’avantage essentiel en utilisant ses talents de conteur qui transformaient en acte de bravoure sa fuite devant les policiers. Mais il eut le bon goût de m’associer dans le récit de son épopée."
                            }
                        ]
                    },
                    {
                        "sense_id": "0a799bc0-1374-3486-a3ac-86be6907e946",
                        "entry_id": "f80df2ff-8faa-32f8-a695-084c3252a1ca",
                        "glosses": [
                            "Auteur de romans et de nouvelles."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "8d5a12da-cd0a-4fc4-a0e6-be5f1bdbcd90",
                                "sense_id": "0a799bc0-1374-3486-a3ac-86be6907e946",
                                "text": "Avant eux, les conteurs italiens ont sans cesse emprunté aux nôtres les sujets de leurs nouvelles, …."
                            }
                        ]
                    },
                    {
                        "sense_id": "b56464be-f88f-3355-808d-9ee38724dce7",
                        "entry_id": "f80df2ff-8faa-32f8-a695-084c3252a1ca",
                        "glosses": [
                            "Celui qui invente des histoires pour abuser autrui."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f966f539-2879-45a1-ac14-c9cf747b1e4c",
                        "source_entry_id": "f80df2ff-8faa-32f8-a695-084c3252a1ca",
                        "target_lang_word": "Erzähler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Erzähler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "01c38f53-932f-3951-9f67-7ded7dbcd518",
                                        "entry_id": "79527081-2f2d-36a0-8a42-badbfb5dd801",
                                        "glosses": [
                                            "Person, die etwas erzählt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4db6366-5138-4f6b-a03e-44c13855dd79",
                                                "sense_id": "01c38f53-932f-3951-9f67-7ded7dbcd518",
                                                "text": "„Er glänzte bei geselligen Anlässen gerne mit haarsträubenden Anekdoten und hatte schon bald den Ruf weg, ein vorzüglicher Erzähler und großartiger Spaßvogel zu sein.“"
                                            },
                                            {
                                                "example_id": "a6a80e7c-7b0e-4fbb-9ed0-d5267a658d74",
                                                "sense_id": "01c38f53-932f-3951-9f67-7ded7dbcd518",
                                                "text": "„Kein Wort wird in Benin zu dieser Zeit niedergeschrieben, alles mündlich aufbewahrt, fortgetragen von Erzähler zu Erzähler, umgeformt über Generationen.“"
                                            },
                                            {
                                                "example_id": "8aa0abd4-9453-462f-a272-714be16b0692",
                                                "sense_id": "01c38f53-932f-3951-9f67-7ded7dbcd518",
                                                "text": "„Und dann wandte er sich wieder dem Erzähler zu und lachte abermals.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "dd353a1a-01b3-31b0-92a6-5501711fafc3",
                                        "entry_id": "79527081-2f2d-36a0-8a42-badbfb5dd801",
                                        "glosses": [
                                            "Verfasser einer Erzählung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3993957c-5483-434c-8ee1-17f99e2d5496",
                                                "sense_id": "dd353a1a-01b3-31b0-92a6-5501711fafc3",
                                                "text": "„Der sprachgewandte Erzähler aus langobardischem Dienstadel wurde etwa 160 Jahre nach diesem Ereignis geboren - um 725, wahrscheinlich in Forum Iulii; jedenfalls wuchs er hier auf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c16ecb70-aa53-3581-8f5b-b234980df71d",
                                        "entry_id": "79527081-2f2d-36a0-8a42-badbfb5dd801",
                                        "glosses": [
                                            "abstrakte Instanz in einem epischen Werk, aus deren Sichtweise erzählt wird"
                                        ],
                                        "tags": [
                                            "Literaturwissenschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "92a8a2b5-15e0-4011-b488-d06c25383b14",
                                                "sense_id": "c16ecb70-aa53-3581-8f5b-b234980df71d",
                                                "text": "„Ich machte mich zum Erzähler und erzählte die Geschichte meiner Großmutter auch aus eigenem Recht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bc1d06aa-9274-400a-8166-415cbc380454",
                        "source_entry_id": "f80df2ff-8faa-32f8-a695-084c3252a1ca",
                        "target_lang_word": "storyteller",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "storyteller",
