{
    "word_family": [
        "mommy",
        "momma"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "865d2b5f-6f44-31b4-bb29-83367c3ad1b9",
                    "sense_definition": "A female parent.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "mother_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My <w>mom</w> drives me to school every morning.",
                            "target_lang_translations": {
                                "ru": "Моя <w>мама</w> отвозит меня в школу каждое утро.",
                                "zh": "我<w>妈妈</w>每天早上开车送我去学校。"
                            }
                        },
                        {
                            "text": "She is a hardworking single <w>mom</w> with two children.",
                            "target_lang_translations": {
                                "ru": "Она трудолюбивая одинокая <w>мама</w> с двумя детьми.",
                                "zh": "她是一位辛苦工作的单亲<w>妈妈</w>，带着两个孩子。"
                            }
                        }
                    ],
                    "synonyms": [
                        "Mother",
                        "Mommy",
                        "Mum",
                        "Mam",
                        "mummy"
                    ],
                    "antonyms": [
                        "Dad"
                    ],
                    "common_phrases": [
                        "single mom",
                        "soccer mom",
                        "stay-at-home mom",
                        "tiger mom"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "North America"
                        },
                        {
                            "trait_type": "colloquial",
                            "comment": "informal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Женщина-родитель; мать.",
                        "zh": "女性家长；母亲。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мама",
                                "target_lang_sense_clarification": "общеупотребительное, нейтральное или ласковое"
                            },
                            {
                                "target_lang_word": "мать",
                                "target_lang_sense_clarification": "более формальное или строгое"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "妈妈",
                                "target_lang_sense_clarification": "口语，常用"
                            },
                            {
                                "target_lang_word": "母亲",
                                "target_lang_sense_clarification": "书面语，正式"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "49be5914-d432-3d0b-884f-a41855368176",
                    "sense_definition": "A term of address for one's wife, typically used by a husband who has children with her.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "mother_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hey <w>mom</w>, have you seen the car keys anywhere?",
                            "target_lang_translations": {
                                "ru": "Эй, <w>мать</w>, ты нигде не видела ключи от машины?",
                                "zh": "嘿，<w>孩子他妈</w>，你看见车钥匙了吗？"
                            }
                        },
                        {
                            "text": "I think <w>mom</w> deserves a nice dinner out tonight.",
                            "target_lang_translations": {
                                "ru": "Я думаю, <w>мама</w> заслужила хороший ужин в ресторане сегодня вечером.",
                                "zh": "我觉得<w>妈妈</w>今晚应该出去吃顿好的。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Обращение к жене, обычно используемое мужем, у которого с ней есть общие дети.",
                        "zh": "丈夫对妻子的称呼，通常指双方有共同子女的情况。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мать",
                                "target_lang_sense_clarification": "разговорное обращение мужа к жене"
                            },
                            {
                                "target_lang_word": "мама",
                                "target_lang_sense_clarification": "в присутствии детей"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "孩子他妈",
                                "target_lang_sense_clarification": "口语，丈夫对妻子的称呼"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "92becee3-de74-3850-92f7-fb7432dd604c",
                    "sense_definition": "A female owner of a pet, often referring to herself in relation to the animal.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "mother_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The puppy ran straight to his <w>mom</w> when he got scared.",
                            "target_lang_translations": {
                                "ru": "Щенок побежал прямо к своей <w>маме</w>, когда испугался.",
                                "zh": "小狗害怕时直接跑向了它的<w>妈妈</w>。"
                            }
                        },
                        {
                            "text": "As a dedicated dog <w>mom</w>, she takes her pet everywhere.",
                            "target_lang_translations": {
                                "ru": "Будучи преданной «собачьей <w>мамой</w>», она берет питомца везде с собой.",
                                "zh": "作为一名尽职的宠物<w>妈妈</w>，她去哪儿都带着她的狗。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "dog mom",
                        "cat mom"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Владелица домашнего животного, часто называющая себя так по отношению к питомцу.",
                        "zh": "宠物的主人，常以母亲自居。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мама",
                                "target_lang_sense_clarification": "в контексте отношений с питомцем"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "铲屎官",
                                "target_lang_sense_clarification": "网络流行语，指宠物主人"
                            },
                            {
                                "target_lang_word": "妈妈",
                                "target_lang_sense_clarification": "在宠物语境下自称"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "7453bab5-1301-3942-b830-f7f41a6eaec0",
                    "sense_definition": "One's own mother, used as a proper name or title of address.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "mother_name",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "I bought a nice birthday gift for <w>Mom</w>.",
                            "target_lang_translations": {
                                "ru": "Я купил хороший подарок на день рождения для <w>Мамы</w>.",
                                "zh": "我给<w>妈妈</w>买了一份很棒的生日礼物。"
                            }
                        },
                        {
                            "text": "Hi <w>Mom</w>, are you feeling better today?",
                            "target_lang_translations": {
                                "ru": "Привет, <w>Мам</w>, тебе сегодня лучше?",
                                "zh": "嗨<w>妈妈</w>，你今天感觉好点了吗？"
                            }
                        }
                    ],
                    "synonyms": [
                        "Mother",
                        "Mommy",
                        "Mum",
                        "Mama"
                    ],
                    "antonyms": [
                        "Dad"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "North America"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Собственная мать (используется как имя собственное или обращение).",
                        "zh": "对母亲的称呼或作为专有名词使用。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Мама",
                                "target_lang_sense_clarification": "как имя собственное или обращение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "妈妈",
                                "target_lang_sense_clarification": "称呼语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "80bd7f82-3a30-3f1b-83ea-0c5d9ad0454c",
                    "sense_definition": "A surname of Khmer origin.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "surname",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Mom</w> is a well-respected member of the community.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Мом</w> — уважаемый член общества.",
                                "zh": "<w>莫姆</w>先生是社区里备受尊敬的一员。"
                            }
                        },
                        {
                            "text": "We met a family with the last name <w>Mom</w> during our trip.",
                            "target_lang_translations": {
                                "ru": "В поездке мы встретили семью с фамилией <w>Мом</w>.",
                                "zh": "我们在旅行中遇到了一户姓<w>莫姆</w>的人家。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Khmer"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия кхмерского происхождения.",
                        "zh": "高棉语姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Мом",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "莫姆",
                                "target_lang_sense_clarification": "姓氏音译"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "07de551b-0375-3ea7-a73e-c7ea17656fed",
                    "sense_definition": "To care for someone in a motherly way, often excessively or intrusively.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "verb_care",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Stop trying to <w>mom</w> me; I can handle this myself.",
                            "target_lang_translations": {
                                "ru": "Перестань меня <w>опекать</w>; я сам с этим справлюсь.",
                                "zh": "别再<w>唠叨</w>我了，我自己能处理好。"
                            }
                        },
                        {
                            "text": "She tends to <w>mom</w> her friends by constantly checking if they have eaten.",
                            "target_lang_translations": {
                                "ru": "Она склонна <w>опекать</w> своих друзей, постоянно проверяя, поели ли они.",
                                "zh": "她总是不断确认朋友们吃没吃饭，以此来<w>管束</w>他们。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Заботиться о ком-то по-матерински, часто чрезмерно или навязчиво.",
                        "zh": "像母亲一样照顾某人，常指过度或干涉性的关怀。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "опекать",
                                "target_lang_sense_clarification": "заботиться, контролировать"
                            },
                            {
                                "target_lang_word": "нянчить",
                                "target_lang_sense_clarification": "обращаться как с ребенком"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "唠叨",
                                "target_lang_sense_clarification": "指过度关心的行为"
                            },
                            {
                                "target_lang_word": "管束",
                                "target_lang_sense_clarification": "指干涉性的照顾"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "27288263-4533-38d4-84ea-de4baa4f02ed",
                    "sense_definition": "Initialism of month-over-month; used to compare financial figures to the previous month.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "business_adj",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company reported a significant <w>mom</w> increase in sales.",
                            "target_lang_translations": {
                                "ru": "Компания сообщила о значительном <w>помесячном</w> росте продаж.",
                                "zh": "公司报告称销售额实现了显著的<w>环比</w>增长。"
                            }
                        },
                        {
                            "text": "We need to analyze the <w>mom</w> growth statistics carefully.",
                            "target_lang_translations": {
                                "ru": "Нам нужно тщательно проанализировать статистику <w>помесячного</w> роста.",
                                "zh": "我们需要仔细分析<w>环比</w>增长数据。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "abbreviation"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сокращение от «month-over-month» (месяц к месяцу); используется для сравнения финансовых показателей с предыдущим месяцем.",
                        "zh": "“月对月”的缩写，用于比较财务数据与上个月的情况。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "помесячный",
                                "target_lang_sense_clarification": "относящийся к сравнению месяцев"
                            },
                            {
                                "target_lang_word": "по сравнению с предыдущим месяцем",
                                "target_lang_sense_clarification": "описательный перевод"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "环比",
                                "target_lang_sense_clarification": "财务术语，指与上期相比"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}