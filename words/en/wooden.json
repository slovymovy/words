{
    "word_family": [
        "wood",
        "woody",
        "woodiness",
        "woodwork",
        "woodland",
        "woodsman"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b3e17df2-fa9d-332d-a780-a792e24d0816",
                    "sense_definition": "Made of wood.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "material",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They sat on a <w>wooden</w> bench in the park to eat their lunch.",
                            "target_lang_translations": {
                                "ru": "Они сели на <w>деревянную</w> скамейку в парке, чтобы пообедать.",
                                "zh": "他们坐在公园的一条<w>木制</w>长椅上吃午饭。"
                            }
                        },
                        {
                            "text": "The old house has a beautiful <w>wooden</w> door that creaks when opened.",
                            "target_lang_translations": {
                                "ru": "В старом доме есть красивая <w>деревянная</w> дверь, которая скрипит при открывании.",
                                "zh": "那座老房子有一扇漂亮的<w>木</w>门，打开时会发出吱吱声。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "wooden floor",
                        "wooden spoon",
                        "wooden box",
                        "wooden leg",
                        "wooden toy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделанный из дерева.",
                        "zh": "由木头制成的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "деревянный",
                                "target_lang_sense_clarification": "материал"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "木制的",
                                "target_lang_sense_clarification": "由木头材料制成"
                            },
                            {
                                "target_lang_word": "木头",
                                "target_lang_sense_clarification": "用作定语表示材质"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b5271525-db74-39f9-ae3a-59cf6cc7cedb",
                    "sense_definition": "As if made of wood; moving awkwardly, or speaking with dull lack of emotion.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "metaphorical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The actor was criticized for his <w>wooden</w> performance in the new movie.",
                            "target_lang_translations": {
                                "ru": "Актёра раскритиковали за его <w>деревянную</w> игру в новом фильме.",
                                "zh": "这位演员因在新电影中<w>呆板</w>的表演而受到批评。"
                            }
                        },
                        {
                            "text": "She gave a <w>wooden</w> smile to the cameras, clearly uncomfortable with the attention.",
                            "target_lang_translations": {
                                "ru": "Она одарила камеры <w>натянутой</w> улыбкой, явно чувствуя себя неловко от внимания.",
                                "zh": "她对着镜头露出了<w>僵硬</w>的微笑，显然对这种关注感到不自在。"
                            }
                        }
                    ],
                    "synonyms": [
                        "stiff",
                        "awkward",
                        "rigid",
                        "emotionless",
                        "expressionless"
                    ],
                    "antonyms": [
                        "natural",
                        "lively",
                        "fluid",
                        "expressive"
                    ],
                    "common_phrases": [
                        "wooden acting",
                        "wooden performance",
                        "wooden expression",
                        "wooden smile"
                    ],
                    "target_lang_definitions": {
                        "ru": "Словно сделанный из дерева; двигающийся неловко или говорящий без эмоций.",
                        "zh": "形容人动作僵硬、表情呆板或缺乏情感。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "деревянный",
                                "target_lang_sense_clarification": "перен. скованный, безжизненный"
                            },
                            {
                                "target_lang_word": "скованный",
                                "target_lang_sense_clarification": "о движениях или поведении"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "僵硬的",
                                "target_lang_sense_clarification": "形容动作或表情不自然"
                            },
                            {
                                "target_lang_word": "呆板的",
                                "target_lang_sense_clarification": "形容表演或神情缺乏生机"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "8bf96f3e-76bb-341a-8266-312cf136cb98",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "I read a biography about the famous coach John <w>Wooden</w> yesterday.",
                            "target_lang_translations": {
                                "ru": "Вчера я прочитал биографию известного тренера Джона <w>Вудена</w>.",
                                "zh": "我昨天读了一本关于著名教练约翰·<w>伍登</w>的传记。"
                            }
                        },
                        {
                            "text": "Please tell Mr. <w>Wooden</w> that his appointment is scheduled for tomorrow.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, передайте мистеру <w>Вудену</w>, что его встреча назначена на завтра.",
                                "zh": "请告诉<w>伍登</w>先生，他的预约安排在明天。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "family name"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия.",
                        "zh": "姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Вуден",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "伍登",
                                "target_lang_sense_clarification": "姓氏音译"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}