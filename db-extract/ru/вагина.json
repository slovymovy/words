                                "target_senses": [
                                    {
                                        "sense_id": "7b25de35-88fc-399d-921d-7f832f135f19",
                                        "entry_id": "5a3710e3-a459-3fe5-a4f8-0a1ee39a7cb3",
                                        "glosses": [
                                            "A sex organ leading from the vulval vestibule/urogenital sinus to the cervix of the uterus for copulation and birth in female therian mammals."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4846593d-1e8e-4934-8ee3-c322292e6364",
                                                "sense_id": "7b25de35-88fc-399d-921d-7f832f135f19",
                                                "text": "The epithelial lining of the vagina consists of many layers of flattened cells. Changes in the condition of these cells during the menstrual cycle can be detected by swabbing the lining and looking at the cells under a microscope."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "757b6551-28bf-336b-b094-f0107c0b7645",
                                        "entry_id": "5a3710e3-a459-3fe5-a4f8-0a1ee39a7cb3",
                                        "glosses": [
                                            "A sex organ leading from the vulval vestibule/urogenital sinus to the cervix of the uterus for copulation and birth in female therian mammals.",
                                            "A similar part in some invertebrates and non-mammalian amniotes."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ec1463f8-4f21-3bbd-8bd7-fddb33a36050",
                                        "entry_id": "5a3710e3-a459-3fe5-a4f8-0a1ee39a7cb3",
                                        "glosses": [
                                            "A sheathlike structure, such as the leaf of a grass that surrounds a stem."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7a88b927-78a3-3fef-8188-c1af00a488f2",
                                        "entry_id": "5a3710e3-a459-3fe5-a4f8-0a1ee39a7cb3",
                                        "glosses": [
                                            "The vulva, or collectively, the vulva and the vaginal passage."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cbc2a917-6cc6-493d-ba90-f60f88f32601",
                                                "sense_id": "7a88b927-78a3-3fef-8188-c1af00a488f2",
                                                "text": "For quotations using this term, see Citations:vagina."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "17d0c8ce-30ef-36d0-acd0-2385f7889587",
                                        "entry_id": "5a3710e3-a459-3fe5-a4f8-0a1ee39a7cb3",
                                        "glosses": [
                                            "A coward; a weakling; a pussy."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5611c709-69cd-4343-8523-1050300985d7",
                                                "sense_id": "17d0c8ce-30ef-36d0-acd0-2385f7889587",
                                                "text": "Don't you interrupt me, you vagina! I was givin' a heart-wrenchin' soliloquy about me feelin's for Tugger!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43ea6a23-b759-34ef-aecf-1c2a820e55bb",
                                        "entry_id": "5a3710e3-a459-3fe5-a4f8-0a1ee39a7cb3",
                                        "glosses": [
                                            "The anus of a trans woman."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ae803695-ef88-4563-8404-637965ff317d",
                        "source_entry_id": "40741f94-a8c7-3009-a604-912616457770",
                        "source_sense_description": "влагалище",
                        "target_lang_word": "Vagina",
