                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7dc4cd4c-4709-4490-a196-be2b8ec642a2",
                                                "sense_id": "199165df-211e-3b07-99e2-93045a9c4177",
                                                "text": "Vyřiď mu, že dnes nepřijdu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "020caee9-92f5-3f3f-8898-16d20bb77b94",
