                                                "sense_id": "c0adc585-e91c-3fcb-9ed6-2e32114de025",
                                                "text": "Wir müssen die Böcke von den Auen trennen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
