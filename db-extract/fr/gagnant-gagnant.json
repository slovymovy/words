                "senses": [
                    {
                        "sense_id": "437e5e3d-3c01-3d4c-b791-c6b2d1b33a21",
                        "entry_id": "af546241-d554-34ca-90a8-b49138d4da01",
                        "glosses": [
                            "Se dit du résultat d’une négociation favorable à chacune des deux parties."
                        ],
                        "tags": [
                            "Économie"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "1d48257d-caf5-3a15-a619-8a38ad99f22b",
                        "entry_id": "af546241-d554-34ca-90a8-b49138d4da01",
                        "glosses": [
                            "Qui profite à chacun."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "b8182e8c-0b94-4e2c-8e0e-ec78b2e522ff",
                                "sense_id": "1d48257d-caf5-3a15-a619-8a38ad99f22b",
                                "text": "Certes, il a existé et il existe encore heureusement des jeux gagnants-gagnants, voire gagnants-gagnants-gagnants."
                            },
                            {
                                "example_id": "9ef9b46b-7ccd-4834-a58e-53be01b3e381",
                                "sense_id": "1d48257d-caf5-3a15-a619-8a38ad99f22b",
                                "text": "« On aide les abattoirs québécois à être remplis, donc c’est gagnant-gagnant. Nos cochons les aident à rester pleins », explique l’éleveur de la province."
                            },
                            {
                                "example_id": "e7b7d178-9e36-490f-ac96-f0b4fba86cb2",
                                "sense_id": "1d48257d-caf5-3a15-a619-8a38ad99f22b",
                                "text": "Pour désamorcer la crise, il faut permettre à Poutine de sauver la face, trouver une solution « gagnant-gagnant » où les deux parties pourraient se péter les bretelles."
                            },
                            {
                                "example_id": "da74ae78-f6ab-425d-93ae-af448b0945ca",
                                "sense_id": "1d48257d-caf5-3a15-a619-8a38ad99f22b",
                                "text": "Un compromis gagnant-gagnant."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1292b707-03c8-4d2e-836f-3af9a942c539",
                        "source_entry_id": "af546241-d554-34ca-90a8-b49138d4da01",
                        "target_lang_word": "win-win",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "win-win",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "99bee6d4-c576-3534-bcc8-42feb63b1ea4",
                                        "entry_id": "4dd38a2f-7b48-3274-acda-13004e3403ab",
                                        "glosses": [
                                            "That benefits both or all parties, or that has two distinct benefits."
                                        ],
                                        "tags": [
                                            "of a situation or outcome"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "44f3a776-4b8d-49bb-83ef-9269c0add8c1",
                                                "sense_id": "99bee6d4-c576-3534-bcc8-42feb63b1ea4",
                                                "text": "win-win outcome"
                                            },
                                            {
                                                "example_id": "78d1688f-b9a0-4c18-9d94-8ce940d9b314",
                                                "sense_id": "99bee6d4-c576-3534-bcc8-42feb63b1ea4",
                                                "text": "win-win situation"
                                            },
                                            {
                                                "example_id": "382b48d9-32fc-4318-b8a9-a81d5ccc6f0a",
                                                "sense_id": "99bee6d4-c576-3534-bcc8-42feb63b1ea4",
                                                "text": "In zero-sum games, every win for one side is a loss for the other ; there can be no such thing as a \"win-win\" outcome"
                                            },
                                            {
                                                "example_id": "76b17a4c-74e9-46ba-8d59-28ae997309b3",
                                                "sense_id": "99bee6d4-c576-3534-bcc8-42feb63b1ea4",
                                                "text": "Has the shifting policy of win-win to win-hold-win and back to win-win had an impact on your munitions requirements determinations?"
                                            },
                                            {
                                                "example_id": "633fe11d-c209-4022-b75c-8c36c42f0fc7",
                                                "sense_id": "99bee6d4-c576-3534-bcc8-42feb63b1ea4",
                                                "text": "2. Win-Win The best partnership"
                                            },
                                            {
                                                "example_id": "c39bae1d-d58e-42e0-bde2-56bbbc807fb6",
                                                "sense_id": "99bee6d4-c576-3534-bcc8-42feb63b1ea4",
                                                "text": "A Win/Win Approach to Conflict / An integrative approach to conflict has such obvious merit for a group that it is worth spending some time looking at how it works"
                                            },
                                            {
                                                "example_id": "47054fd1-8f45-45d3-b416-82fa973e426f",
                                                "sense_id": "99bee6d4-c576-3534-bcc8-42feb63b1ea4",
                                                "text": "At the time of writing, I have not seen the finished product, but I nevertheless think this is a win-win situation for Network Rail, operators, Fabrik and, of course, others."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "win-win",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "196c4cfb-1c49-3bde-98ee-92a569c4f320",
                                        "entry_id": "bcd86968-b79b-309b-bbb6-0b5fde300357",
                                        "glosses": [
                                            "A situation that benefits both or all parties, or that has two distinct benefits."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0978914-c07a-4e0e-815c-e2def4b5ea7e",
                                                "sense_id": "196c4cfb-1c49-3bde-98ee-92a569c4f320",
                                                "text": "They got their school project funded, and you got to look like a generous benefactor, plus some free advertising. It's a win-win."
                                            },
                                            {
                                                "example_id": "1c6b8e7a-8050-4fdf-bf08-012c6bf387ff",
                                                "sense_id": "196c4cfb-1c49-3bde-98ee-92a569c4f320",
                                                "text": "\"It's a lose-lose situation. It can be turned into a win-win. We should be encouraging and supporting expensive bi-mode freight locomotives, especially where capacity is constrained."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
