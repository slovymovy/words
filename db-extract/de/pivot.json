                ],
                "senses": [
                    {
                        "sense_id": "0bd7fb3e-8d44-3190-9975-9453631a1abf",
                        "entry_id": "c73d6de1-a1d7-3116-b8f5-0ac20758e796",
                        "glosses": [
                            "Punkt/senkrechte Achse als Zentrum einer Drehung; konkret als Zapfen (zum Beispiel [2]), abstrakt und übertragen"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "069600a6-c9d5-499a-be49-608e8f19dcf5",
                                "sense_id": "0bd7fb3e-8d44-3190-9975-9453631a1abf",
                                "text": "„Eine Ecke C, auf dem Zeichentisch befestigt, bildet den Drehpunkt (Pivot), die diagonal gegenüberliegende Ecke A trägt den Fahrstift, welcher mittels einer Handhabe auf der zu reduzierenden Zeichnung geführt wird.“"
                            },
                            {
                                "example_id": "cc392a33-77f9-45e0-ae43-ba5412c99253",
                                "sense_id": "0bd7fb3e-8d44-3190-9975-9453631a1abf",
                                "text": "„[…] daß die Natur einmal ›die Grundlage alles Lebens‹ heißt und […] daß ›außer ihr Nichts ist‹, […]. Auf diese Donnerworte folgt das Pivot des ganzen Aufsatzes: […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "271f4ad6-a97d-3291-b408-d7084af578df",
                        "entry_id": "c73d6de1-a1d7-3116-b8f5-0ac20758e796",
                        "glosses": [
                            "Drehsockel einer Lafette"
                        ],
                        "tags": [
                            "jargon"
                        ],
                        "examples": [
                            {
                                "example_id": "9719d794-5cba-435a-bddf-233a934f79ca",
                                "sense_id": "271f4ad6-a97d-3291-b408-d7084af578df",
                                "text": "„Wie bereits erwähnt, ist bei den Drehscheibenlafetten mit zentralen Aufzügen die Aufnahme des Rückstoßes auf den ringförmigen Sockel verlegt worden, der also gleichzeitig als Pivot der Lafette angesehen werden muß.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
