                                                "sense_id": "59fdb6d3-0bc8-3778-827f-ddca46d5de92",
                                                "text": "La commissaire Berudescu (Violeta pour les intimes), sa moustache, son parfum pestilentiel, son quintal et sa dizaine de sbires."
                                            },
                                            {
                                                "example_id": "8abb752f-027e-4288-9d21-48c445304816",
                                                "sense_id": "59fdb6d3-0bc8-3778-827f-ddca46d5de92",
                                                "text": "Il y a dix quintaux à la tonne."
                                            }
                                        ]
                                    },
