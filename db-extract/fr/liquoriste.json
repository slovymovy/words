                "entry_id": "cf00841b-6347-3c7d-918a-b3eb230ff2a8",
                "word": "liquoriste",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "32c35940-720a-4409-b7ed-eff4cf3dd1ef",
                        "entry_id": "cf00841b-6347-3c7d-918a-b3eb230ff2a8",
                        "tags": [
                            "plural"
