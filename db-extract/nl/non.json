                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nonne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "84f032e7-f3ba-3e3d-85c3-ce3a1d2f4a46",
                                        "entry_id": "1ec2aea0-f6fb-3458-9a1d-1c4b382bfe70",
                                        "glosses": [
                                            "Religieuse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c38e7b59-f556-4019-9fea-13c1aabc45bf",
                                                "sense_id": "84f032e7-f3ba-3e3d-85c3-ce3a1d2f4a46",
                                                "text": "Plassans, quand il s’était bien cadenassé, se disait : « Je suis chez moi », avec la satisfaction d’un bourgeois dévot, qui, sans crainte pour sa caisse, certain de n’être réveillé par aucun tapage, va réciter ses prières et se mettre voluptueusement au lit. Il n’y a pas de cité, je crois, qui se soit entêtée si tard à s’enfermer comme une nonne."
                                            },
                                            {
                                                "example_id": "e32f11d9-7efd-42d0-94ed-0856e662a334",
                                                "sense_id": "84f032e7-f3ba-3e3d-85c3-ce3a1d2f4a46",
                                                "text": "J’arrivai à deux heures, après avoir voyagé entre deux nonnes du couvent de Sainte-Nino, deux nonnes vêtues de bure sombre et coiffées d’une sorte de chapeau haut de forme noir."
                                            },
                                            {
                                                "example_id": "2e916fb8-a936-4ba0-8af3-ab4c18bc77f4",
                                                "sense_id": "84f032e7-f3ba-3e3d-85c3-ce3a1d2f4a46",
                                                "text": "Satan poussait dans les feux de la lubricité cavalcadante et dévorante ses troupeaux de nonnes charnues et de moines ityphalliques, gymnasiarques de l'amour et virtuoses des accouplements monstrueux."
                                            },
                                            {
                                                "example_id": "11f701cb-40e3-4138-9a93-78fb8f4a4a20",
                                                "sense_id": "84f032e7-f3ba-3e3d-85c3-ce3a1d2f4a46",
                                                "text": "Les nonnes fertiles lui offrent, aux périodes lunaires, une goutte symbolique de leur dégoulinure."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "nonne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7074f488-5c6e-3db4-b157-02e5d9256e0a",
                                        "entry_id": "50fc175a-9a94-3a37-84b2-fd6468216d2a",
                                        "glosses": [
                                            "Un insecte lépidoptère (papillon) de nuit de la famille des lymantridés (Lymantriidae) dont le dos des ailes est orné de motifs et lignes transversales sinueuses et de couleur foncée (en zigzag)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ae2b552-4c58-417b-99d7-80a5a0012d8f",
                                                "sense_id": "7074f488-5c6e-3db4-b157-02e5d9256e0a",
                                                "text": "La chenille de la nonne se nourrit sur des conifères et des feuillus."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
