                    },
                    {
                        "translation_id": "b3310f6b-6e57-4a4c-bf47-0760149ea383",
                        "source_entry_id": "da0d70cc-8797-3dc7-b719-0f3722b7c89c",
                        "source_sense_description": "used to express assent, especially to a superior",
                        "target_lang_word": "sissignore",
