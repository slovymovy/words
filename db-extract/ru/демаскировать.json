                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "demaskieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9e925faa-affd-3c98-b525-dad024df7b05",
                                        "entry_id": "cdb06efb-fa4b-367c-b7cb-b2d952427f81",
                                        "glosses": [
                                            "eine Gesichtsbedeckung vom Gesicht entfernen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1561e5e-7577-46b4-a4ba-aef6c0d6ca40",
                                                "sense_id": "9e925faa-affd-3c98-b525-dad024df7b05",
                                                "text": "Erst als sie in Sicherheit war, wurde sie demaskiert."
                                            },
                                            {
                                                "example_id": "ed960330-0866-469f-a4a7-d7e69322e9dd",
                                                "sense_id": "9e925faa-affd-3c98-b525-dad024df7b05",
                                                "text": "Ein maskierter Mann trat plötzlich zu uns, aber der Unbekannte demaskierte sich augenblicklich, und wir erkannten in ihm den Fürsten Nimroth."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c6f4ee67-e6a6-3b05-8c62-b6a8ff40f7a6",
                                        "entry_id": "cdb06efb-fa4b-367c-b7cb-b2d952427f81",
                                        "glosses": [
                                            "die wahren Absichten von jemandem oder etwas offenlegen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e3dae7c-84fa-4808-ac6c-9739fdde1103",
                                                "sense_id": "c6f4ee67-e6a6-3b05-8c62-b6a8ff40f7a6",
                                                "text": "So demaskierte der Betriebsrat die Geschäftsführung noch während der Betriebsversammlung."
                                            },
                                            {
                                                "example_id": "ccc98758-6637-458c-8c8e-427e76a5b8ba",
                                                "sense_id": "c6f4ee67-e6a6-3b05-8c62-b6a8ff40f7a6",
                                                "text": "Die demaskierten Unruhestifter flohen des Landes."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1ca23096-f366-4963-a56a-5e7891dec3f1",
                        "source_entry_id": "3086ba96-f09a-3dc9-a956-8d3ae0c20a24",
