                        "glosses": [
                            "Eigenschaft/Umstand, überlegen (superior) zu sein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0da56fa-eeed-41fa-a6fa-efbfd5e0ef28",
                                "sense_id": "74d8e393-88ee-3b1e-8e26-c89d49686b7f",
                                "text": "„In einem zweiten Schritt präsentiert er die Gegenargumente, die für die Superiorität des Papstes über das Generalkonzil sprechen.“"
                            },
                            {
                                "example_id": "a423d2b1-7a45-4d16-999b-a088d2341eb7",
                                "sense_id": "74d8e393-88ee-3b1e-8e26-c89d49686b7f",
                                "text": "„Die Superiorität oder Inferiorität einer Hemisphäre bedingt Funktionsunterschiede der gesamten Hirnhälften, und stets ist die superiore Hirnhälfte auch auf das Funktionieren des kontralateralen Psychomotorium von großem Einfluß.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
