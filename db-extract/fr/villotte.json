                "senses": [
                    {
                        "sense_id": "157936ba-f990-32b3-9fff-b0a80e9d3b14",
                        "entry_id": "4ed0eced-b165-3124-8dd4-9fe8a7f1a560",
                        "glosses": [
                            "Très petite ville."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac8f3892-fa4c-4412-a7c1-0dd385150a51",
                                "sense_id": "157936ba-f990-32b3-9fff-b0a80e9d3b14",
                                "text": "… ou membre, du conseil municipal d'une villotte de trois mille âmes;…."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1fd7f20c-56d1-4691-888e-dbf32f96aefb",
                        "source_entry_id": "4ed0eced-b165-3124-8dd4-9fe8a7f1a560",
                        "source_sense_id": "157936ba-f990-32b3-9fff-b0a80e9d3b14",
                        "target_lang_word": "Städtchen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Städtchen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f7504048-81ec-37a5-b72b-af6f0d4963e8",
                                        "entry_id": "6122341c-dc90-3421-a72e-b7a4cb95b654",
                                        "glosses": [
                                            "kleine Stadt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d750945-ffc7-47d3-918f-5c9f4fd6f17f",
                                                "sense_id": "f7504048-81ec-37a5-b72b-af6f0d4963e8",
                                                "text": "„Auf dem höchsten Punkt des Latium zum Beispiel, in dem Städtchen Guadagnolo, sieht in meinem Lieblingslokal zwischen den Amaro-Flaschen vom Regal hinter der Kasse eine gar nicht so kleine Figur des Duce der Wirtin über die Schulter.“"
                                            },
                                            {
                                                "example_id": "77901bc6-c972-477f-8be1-1a28f97a1502",
                                                "sense_id": "f7504048-81ec-37a5-b72b-af6f0d4963e8",
                                                "text": "„Das kleine Städtchen Ilulissat liegt 250 Kilometer nördlich des Polarkreises, hat fünftausend Einwohner und ebenso viele Schlittenhunde, einhundert angemeldete Autos, aber keine Ampel.“"
                                            },
                                            {
                                                "example_id": "e81a554d-b022-4ffe-bb0f-23d1c9b199e6",
                                                "sense_id": "f7504048-81ec-37a5-b72b-af6f0d4963e8",
                                                "text": "„Augustinus wurde im Städtchen Tagaste in Nordafrika geboren, ging aber schon mit sechzehn Jahren zum Studium nach Karthago.“"
                                            },
                                            {
                                                "example_id": "3645092c-afd5-448f-95e9-c65acf455371",
                                                "sense_id": "f7504048-81ec-37a5-b72b-af6f0d4963e8",
                                                "text": "„Ein hübsch am See gelegenes Städtchen, das sich, ruhig im Zonenrandgebiet gelegen, idyllisch gab.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3e9092cc-c380-4930-85f4-8eda9d8fb3f0",
                        "source_entry_id": "4ed0eced-b165-3124-8dd4-9fe8a7f1a560",
                        "source_sense_id": "157936ba-f990-32b3-9fff-b0a80e9d3b14",
                        "target_lang_word": "town",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "town",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8e196afe-1d67-3f82-be42-ac09102f9262",
                                        "entry_id": "8ceed1a7-e7b4-3ac3-aaad-a60f206a5826",
                                        "glosses": [
                                            "A settlement; an area with residential districts, shops and amenities, and its own local government; especially one larger than a village and smaller than a city, historically enclosed by a fence or walls, with total populations ranging from several hundred to more than a hundred thousand (as of the early 21st century)"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "27614ebc-76ef-4f98-b397-bf4587fc1363",
                                                "sense_id": "8e196afe-1d67-3f82-be42-ac09102f9262",
                                                "text": "This town is really dangerous because these youngsters have Beretta handguns."
                                            },
                                            {
                                                "example_id": "f46ee917-64bd-4266-b589-3c51e70e1bd5",
                                                "sense_id": "8e196afe-1d67-3f82-be42-ac09102f9262",
                                                "text": "Apparently the first reference to the making of the town walls of Stafford (it appears pretty clear that the town was never surrounded by one continuous wall or stockade, but partly by one and partly by the other) occurs in the Patent Rolls, from which we find that in 1225 permission was granted by the king to the \"good men of Stafford” to collect customs or tolls for a period to enable them to enclose the town."
                                            },
                                            {
                                                "example_id": "77bd823b-64f0-41f6-bf8f-3564edcdc629",
                                                "sense_id": "8e196afe-1d67-3f82-be42-ac09102f9262",
                                                "text": "Walls separated town and country through much of the early modern period. Walls not only protected towns, they also helped give them a sense of autonomy and identity."
                                            },
                                            {
                                                "example_id": "066860ce-dd34-4be5-a92a-9efa13ac242a",
                                                "sense_id": "8e196afe-1d67-3f82-be42-ac09102f9262",
                                                "text": "Fortifications and town walls clearly highlight the central military significance of towns."
                                            },
                                            {
                                                "example_id": "c9e1077f-bc04-4fc2-88f5-1c3386f72629",
                                                "sense_id": "8e196afe-1d67-3f82-be42-ac09102f9262",
                                                "text": "As towns continue to grow, replanting vegetation has become a form of urban utopia and green roofs are spreading fast. Last year 1m square metres of plant-covered roofing was built in France, as much as in the US, and 10 times more than in Germany, the pioneer in this field. In Paris 22 hectares of roof have been planted, out of a potential total of 80 hectares."
                                            },
                                            {
                                                "example_id": "6b7cc84a-c638-42d8-867e-d06351b486fa",
                                                "sense_id": "8e196afe-1d67-3f82-be42-ac09102f9262",
                                                "text": "The medieval town, at least in continental Europe, was walled, and without its defences it was no town."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e27f03f-263d-3536-9af3-390e68bc559a",
                                        "entry_id": "8ceed1a7-e7b4-3ac3-aaad-a60f206a5826",
                                        "glosses": [
                                            "Any more urbanized centre than the place of reference."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e1cb7fb9-0e86-4f30-9901-3e96d884ec3b",
                                                "sense_id": "2e27f03f-263d-3536-9af3-390e68bc559a",
                                                "text": "I'll be in Yonkers, then I'm driving into town to see the Knicks at the Garden tonight."
                                            },
                                            {
                                                "example_id": "1f8eefc9-e5a1-460b-ae14-3c2509ac2631",
                                                "sense_id": "2e27f03f-263d-3536-9af3-390e68bc559a",
                                                "text": "Judge Short had gone to town, and Farrar was off for a three days' cruise up the lake. I was bitterly regretting I had not gone with him when the distant notes of a coach horn reached my ear, and I descried a four-in-hand winding its way up the inn road from the direction of Mohair."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5ea44a4c-1b56-38f6-b29f-9df09292ceeb",
                                        "entry_id": "8ceed1a7-e7b4-3ac3-aaad-a60f206a5826",
                                        "glosses": [
                                            "A rural settlement in which a market was held at least once a week."
                                        ],
                                        "tags": [
                                            "UK",
                                            "countable",
                                            "historical",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d410b795-8fbd-36d7-95a9-ee80e8dd60aa",
                                        "entry_id": "8ceed1a7-e7b4-3ac3-aaad-a60f206a5826",
                                        "glosses": [
                                            "The residents (as opposed to gown: the students, faculty, etc.) of a community which is the site of a university."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "942f4cc3-560a-301f-95dc-7aa07ff1c575",
                                        "entry_id": "8ceed1a7-e7b4-3ac3-aaad-a60f206a5826",
                                        "glosses": [
                                            "Used to refer to a town or similar entity under discussion."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab732e5f-f3cb-43f2-88e4-d2da57568857",
                                                "sense_id": "942f4cc3-560a-301f-95dc-7aa07ff1c575",
                                                "text": "Call me when you get to town."
                                            },
                                            {
                                                "example_id": "3d708d46-7c47-4186-be76-1e0c8beda543",
                                                "sense_id": "942f4cc3-560a-301f-95dc-7aa07ff1c575",
                                                "text": "They put up \"lost dog\" posters all over town."
                                            },
                                            {
                                                "example_id": "fe145e4e-8ee1-47fa-9e66-6a0e70a3681f",
                                                "sense_id": "942f4cc3-560a-301f-95dc-7aa07ff1c575",
                                                "text": "I had occasion[…]to make a somewhat long business trip to Chicago, and on my return[…]I found Farrar awaiting me in the railway station. He smiled his wonted fraction by way of greeting[…], and finally leading me to his buggy, turned and drove out of town."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d4195e9d-9988-39aa-911b-88a2a487e3c7",
                                        "entry_id": "8ceed1a7-e7b4-3ac3-aaad-a60f206a5826",
                                        "glosses": [
                                            "A major city, especially one where the speaker is located."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51e7f893-e0a5-4e3e-9eb4-9e413d736011",
                                                "sense_id": "d4195e9d-9988-39aa-911b-88a2a487e3c7",
                                                "text": "There's always a business theme, even underlying happy hours. You're never off the clock in this town."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0eea4dcb-db5c-3792-9582-5917d7516ed4",
                                        "entry_id": "8ceed1a7-e7b4-3ac3-aaad-a60f206a5826",
                                        "glosses": [
                                            "A townhouse."
                                        ],
                                        "tags": [
                                            "countable",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79a01547-29bf-4e85-8113-e7e6a1e8d027",
                                                "sense_id": "0eea4dcb-db5c-3792-9582-5917d7516ed4",
                                                "text": "Detached houses always sell faster than towns or semis."
                                            },
                                            {
                                                "example_id": "0a244055-a9e3-4147-869b-7ff2800bf7e6",
                                                "sense_id": "0eea4dcb-db5c-3792-9582-5917d7516ed4",
                                                "text": "It's not just market forces that are bringing out the semis and towns. Municipalities are requiring developers to build a mix of homes into their new planned communities, partly out of a concession to make more efficient use of virgin land, but also to address the need for more affordable housing for families who might not be able to crack a $300,000 mortgage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ee08d20-79f1-3561-bf02-22570fed7a77",
                                        "entry_id": "8ceed1a7-e7b4-3ac3-aaad-a60f206a5826",
                                        "glosses": [
                                            "A municipal organization, such as a corporation, defined by the laws of the entity of which it is a part."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d0d2c8d9-b6f6-3a8a-b511-92bea88938f1",
                                        "entry_id": "8ceed1a7-e7b4-3ac3-aaad-a60f206a5826",
                                        "glosses": [
                                            "An enclosure which surrounded the mere homestead or dwelling of the lord of the manor; by extension, the whole of the land which constituted the domain."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8cd8345d-04f1-37a5-8fec-92a99c1828fc",
                                        "entry_id": "8ceed1a7-e7b4-3ac3-aaad-a60f206a5826",
                                        "glosses": [
                                            "A farm or farmstead; also, a court or farmyard."
                                        ],
                                        "tags": [
                                            "Scotland",
                                            "UK",
                                            "countable",
                                            "dialectal",
                                            "obsolete",
