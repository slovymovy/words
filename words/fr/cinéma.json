                            }
                        },
                        {
                            "text": "Le <w>cinéma</w> d'auteur attire un public passionné par la mise en scène.",
                            "target_lang_translations": {
                                "en": "<w>Auteur cinema</w> attracts an audience passionate about direction and staging.",
                                "ru": "<w>Авторское кино</w> привлекает зрителей, увлечённых режиссурой.",
                                "nl": "De <w>auteursfilm</w> trekt een publiek dat gepassioneerd is door de regie.",
                                "de": "Der <w>Autorenfilm</w> zieht ein Publikum an, das sich für die Inszenierung begeistert.",
                                "pl": "<w>Kino autorskie</w> przyciąga publiczność, która pasjonuje się reżyserią i inscenizacją.",
                                "it": "Il <w>cinema d'autore</w> attira un pubblico appassionato di regia e messa in scena.",
                                "cs": "<w>Autorský film</w> přitahuje publikum nadšené pro režii a inscenaci.",
                                "tr": "<w>Yönetmen sineması</w>, sahneleme ve yönetmenlik konularına tutkuyla bağlı bir izleyici kitlesini çekiyor.",
                                "es": "El <w>cine de autor</w> atrae a un público apasionado por la puesta en escena.",
                                "zh": "艺术<w>电影</w>吸引了一批热衷于导演和场面调度的观众。"
                            }
