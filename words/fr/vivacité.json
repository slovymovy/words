{
    "word_family": [
        "aviver",
        "raviver",
        "vivace",
        "vivifiant",
        "vivifier"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6f3e1a82-45bc-32b0-8603-2efb32680e1b",
                    "sense_definition": "Qualité d'une personne ou d'un être vivant qui manifeste du dynamisme, de l'énergie et de la promptitude dans ses mouvements.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "energie_dynamisme",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le jeune chiot saute partout avec une <w>vivacité</w> impressionnante dans le jardin."
                        },
                        {
                            "text": "Malgré son grand âge, la danseuse a conservé toute sa <w>vivacité</w> sur scène."
                        }
                    ],
                    "synonyms": [
                        "dynamisme",
                        "énergie",
                        "entrain",
                        "promptitude"
                    ],
                    "antonyms": [
                        "apathie",
                        "lenteur",
                        "mollesse"
                    ],
                    "common_phrases": [
                        "avec vivacité",
                        "pleine de vivacité"
                    ]
                },
                {
                    "sense_id": "a37b9181-099a-3709-a6cb-a8244f383917",
                    "sense_definition": "Promptitude, agilité et finesse de la pensée, de l'intelligence ou de la sensibilité.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "esprit_pensee",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette étudiante impressionne ses professeurs par la grande <w>vivacité</w> de son esprit critique."
                        },
                        {
                            "text": "Il répondait à toutes les questions pièges avec une remarquable <w>vivacité</w> intellectuelle."
                        }
                    ],
                    "synonyms": [
                        "acuité",
                        "agilité",
                        "perspicacité",
                        "finesse"
                    ],
                    "antonyms": [
                        "lourdeur",
                        "torpeur"
                    ],
                    "common_phrases": [
                        "vivacité d'esprit"
                    ]
                },
                {
                    "sense_id": "7c7825a2-a339-3bb8-9b4e-8549624e247b",
                    "sense_definition": "Intensité, éclat marqué ou luminosité d'une couleur, d'une lumière ou de l'expression des yeux.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "eclat_visuel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La <w>vivacité</w> des couleurs de ce tableau attire immédiatement le regard des visiteurs."
                        },
                        {
                            "text": "Une étincelle brillait dans ses yeux, révélant la <w>vivacité</w> de son regard curieux."
                        }
                    ],
                    "synonyms": [
                        "brillance",
                        "éclat",
                        "intensité"
                    ],
                    "antonyms": [
                        "fadeur",
                        "pâleur",
                        "terneur"
                    ],
                    "common_phrases": [
                        "vivacité des couleurs",
                        "vivacité du regard"
                    ]
                },
                {
                    "sense_id": "a4a0d876-cfd6-3c95-89c5-c0dcfd9ca37b",
                    "sense_definition": "Ardeur, force ou véhémence avec laquelle se produit ou s'exprime une action, un sentiment ou un échange verbal.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "ardeur_force",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La discussion s'est poursuivie avec une certaine <w>vivacité</w> entre les deux députés opposés."
                        },
                        {
                            "text": "Le vent soufflait avec une extrême <w>vivacité</w> sur les falaises exposées à la tempête."
                        }
                    ],
                    "synonyms": [
                        "ardeur",
                        "fougue",
                        "véhémence"
                    ],
                    "antonyms": [
                        "calme",
                        "modération"
                    ],
                    "common_phrases": [
                        "vivacité de la discussion",
                        "vivacité du débat"
                    ]
                },
                {
                    "sense_id": "cf2cca08-4ae3-33a1-bb4b-cf0a7d429bd8",
                    "sense_definition": "Disposition de caractère à s'irriter facilement ou emportement passager dans les paroles ou les manières.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "caractere_emportement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pardonnez mon emportement, j'ai eu un mouvement de <w>vivacité</w> que je regrette sincèrement."
                        },
                        {
                            "text": "Son père, connu pour sa <w>vivacité</w>, s'emportait à la moindre contrariété."
                        }
                    ],
                    "synonyms": [
                        "emportement",
                        "impétuosité",
                        "irascibilité"
                    ],
                    "antonyms": [
                        "flegme",
                        "patience",
                        "retenue"
                    ],
                    "common_phrases": [
                        "mouvement de vivacité"
                    ]
                },
                {
                    "sense_id": "e3a5b0fb-8a5e-3cd7-8050-4530eea1bd23",
                    "sense_definition": "Propriété d'un système informatique garantissant qu'une condition ou une action attendue finira inéluctablement par se réaliser.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "technique_systeme",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pour prouver la correction de cet algorithme distribué, les chercheurs doivent établir sa <w>vivacité</w>."
                        },
                        {
                            "text": "La propriété de <w>vivacité</w> garantit qu'aucun processus demandeur ne subira une attente infinie."
                        }
                    ],
                    "common_phrases": [
                        "propriété de vivacité"
                    ]
                },
                {
                    "sense_id": "f99b8c5a-81c1-3728-830e-67ea27a3f819",
                    "sense_definition": "Aptitude d'une poudre ou d'une matière propulsive à se consumer plus ou moins rapidement.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "pyrotechnie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La forme des grains détermine la <w>vivacité</w> de la combustion dans la cartouche."
                        },
                        {
                            "text": "Les ingénieurs ajustent la <w>vivacité</w> de la poudre pour contrôler la pression dans le canon."
                        }
                    ],
                    "synonyms": [
                        "combustibilité"
                    ],
                    "common_phrases": [
                        "vivacité de la poudre"
                    ]
                }
            ]
        }
    ]
}