    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fec58673-9f02-3649-bc3d-6011200babc5",
                    "sense_definition": "Сильный жар, высокая температура, часто в контексте свежеприготовленной еды.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "heat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Пирожки подавали прямо с <w>пылу</w> с жару.",
                            "target_lang_translations": {
                                "pl": "Pierożki podawano prosto <w>z pieca</w>."
                            }
                        },
                        {
                            "text": "Хлеб был такой горячий, что его ели с <w>пылу</w> с жару.",
                            "target_lang_translations": {
                                "pl": "Chleb był tak gorący, że jedzono go <w>prosto z pieca</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "жар"
                    ],
                    "antonyms": [
                        "холод"
                    ],
                    "common_phrases": [
                        "с пылу с жару"
                    ],
                    "target_lang_definitions": {
                        "pl": "Wysoka temperatura, gorąco, często w odniesieniu do świeżo przygotowanego jedzenia."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "gorąco",
                                "target_lang_sense_clarification": "stan wysokiej temperatury"
                            },
                            {
                                "target_lang_word": "żar",
                                "target_lang_sense_clarification": "intensywne ciepło"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f119572b-f8d7-3006-bb1d-ff4bc2fe2c5a",
                    "sense_definition": "Душевный подъём, сильное чувство, страстность или энергия в действиях.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он с большим <w>пылом</w> доказывал свою правоту в этом споре.",
                            "target_lang_translations": {
                                "pl": "Z wielkim <w>zapałem</w> dowodził swojej racji w tym sporze."
                            }
                        },
                        {
                            "text": "Юношеский <w>пыл</w> со временем сменился спокойной рассудительностью.",
                            "target_lang_translations": {
                                "pl": "Młodzieńczy <w>zapał</w> z czasem ustąpił miejsca spokojnej rozwadze."
                            }
                        }
                    ],
                    "synonyms": [
                        "горячность",
                        "пылкость",
                        "энтузиазм",
                        "рвение"
                    ],
                    "antonyms": [
                        "холодность"
                    ],
                    "common_phrases": [
                        "с пылом"
                    ],
                    "target_lang_definitions": {
                        "pl": "Zapał, entuzjazm, silne emocje lub energia w działaniu."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "zapał",
                                "target_lang_sense_clarification": "wielka chęć do działania"
                            },
                            {
                                "target_lang_word": "entuzjazm",
                                "target_lang_sense_clarification": "silne pozytywne emocje"
                            },
                            {
                                "target_lang_word": "żarliwość",
                                "target_lang_sense_clarification": "wielkie oddanie sprawie"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}