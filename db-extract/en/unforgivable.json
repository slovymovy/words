                "senses": [
                    {
                        "sense_id": "d1169f38-99f0-3a7b-a559-36a4aa2ade9a",
                        "entry_id": "2c6ba1d8-e015-3634-8e58-24e086a56405",
                        "glosses": [
                            "Not forgivable; inexcusable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d083593-104c-4f1c-b725-ffc7bf682445",
                                "sense_id": "d1169f38-99f0-3a7b-a559-36a4aa2ade9a",
                                "text": "People who smuggle artifacts, blood diamonds and ivory trinkets on the black market are unforgivable in my mind."
                            },
                            {
                                "example_id": "02caa706-cee5-4ba1-b475-0992be96da3c",
                                "sense_id": "d1169f38-99f0-3a7b-a559-36a4aa2ade9a",
                                "text": "Since unforgivable acts lie in one's positive use of freedom to undo creation—to uncreate—and to make flawed what has been deemed worthy of existence—to unredeem—then the unforgiving act is addressed to oneself and to the cosmos."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f41b110e-5718-4fdf-a130-ef8fcdd5d478",
