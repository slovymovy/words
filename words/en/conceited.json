{
    "word_family": [
        "conceit"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "1a9ca850-1429-3d84-87df-204e103543d0",
                    "sense_definition": "Having an excessively favorable opinion of one's own abilities or appearance; egotistical and vain.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "vanity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is far too <w>conceited</w> to listen to anyone else's advice.",
                            "target_lang_translations": {
                                "ru": "Он слишком <w>самодоволен</w>, чтобы прислушиваться к советам других.",
                                "pl": "Jest zbyt <w>zarozumiały</w>, by słuchać rad innych."
                            }
                        },
                        {
                            "text": "The <w>conceited</w> actor constantly checked his reflection in the mirror.",
                            "target_lang_translations": {
                                "ru": "<w>Тщеславный</w> актер постоянно проверял свое отражение в зеркале.",
                                "pl": "<w>Próżny</w> aktor ciągle sprawdzał swoje odbicie w lustrze."
                            }
                        }
                    ],
                    "synonyms": [
                        "vain",
                        "egotistical",
                        "arrogant",
                        "narcissistic"
                    ],
                    "antonyms": [
                        "humble",
                        "modest"
                    ],
                    "common_phrases": [
                        "incredibly conceited",
                        "conceited person"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обладающий чрезмерно высоким мнением о своих способностях или внешности; самовлюбленный и тщеславный.",
                        "pl": "Posiadający przesadnie wysokie mniemanie o własnych zdolnościach lub wyglądzie; egocentryczny i próżny."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "самодовольный",
                                "target_lang_sense_clarification": "чрезмерно уверенный в себе и довольный собой"
                            },
                            {
                                "target_lang_word": "тщеславный",
                                "target_lang_sense_clarification": "стремящийся к славе и высоко ценящий себя"
                            },
                            {
                                "target_lang_word": "высокомерный",
                                "target_lang_sense_clarification": "пренебрежительный по отношению к другим из-за чувства превосходства"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "zarozumiały",
                                "target_lang_sense_clarification": "mający zbyt wysokie mniemanie o sobie, nadmiernie wychwalający swoją osobę"
                            },
                            {
                                "target_lang_word": "próżny",
                                "target_lang_sense_clarification": "skupiony na własnej osobie, lubiący być podziwianym"
                            },
                            {
                                "target_lang_word": "wyniosły",
                                "target_lang_sense_clarification": "okazujący wyższość wobec innych"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a8bd08f2-3eb3-3fb4-93b2-87772571bc7c",
                    "sense_definition": "Curiously or unusually designed; fanciful.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "design",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The architect created a <w>conceited</w> chair that looked more like a sculpture than furniture.",
                            "target_lang_translations": {
                                "ru": "Архитектор создал <w>вычурный</w> стул, который больше походил на скульптуру, чем на мебель.",
                                "pl": "Architekt stworzył <w>wyчуrne</w> krzesło, które bardziej przypominało rzeźbę niż mebel."
                            }
                        },
                        {
                            "text": "They admired the <w>conceited</w> design of the garden gate.",
                            "target_lang_translations": {
                                "ru": "Они восхищались <w>причудливым</w> дизайном садовых ворот.",
                                "pl": "Podziwiali <w>fantazyjny</w> projekt bramy ogrodowej."
                            }
                        }
                    ],
                    "synonyms": [
                        "fanciful",
                        "elaborate",
                        "ornate"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "This usage is archaic or literary."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причудливо или необычно спроектированный; вычурный.",
                        "pl": "Osobliwie lub nietypowo zaprojektowany; wymyślny."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вычурный",
                                "target_lang_sense_clarification": "отличающийся излишней сложностью и причудливостью"
                            },
                            {
                                "target_lang_word": "причудливый",
                                "target_lang_sense_clarification": "необычный, странный по форме или дизайну"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "wyчуrny",
                                "target_lang_sense_clarification": "odznaczający się nadmierną, często dziwaczną ozdobnością"
                            },
                            {
                                "target_lang_word": "przedziwny",
                                "target_lang_sense_clarification": "bardzo dziwny, nietypowy w formie"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7dd01771-6623-39a6-af50-52f827eb37e6",
                    "sense_definition": "Characterized by ingenious or metaphorical expression, often used in a literary context.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "literary",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The poet used a <w>conceited</w> style to challenge the reader's intellect.",
                            "target_lang_translations": {
                                "ru": "Поэт использовал <w>изощренный</w> стиль, чтобы бросить вызов интеллекту читателя.",
                                "pl": "Poeta użył <w>wyrafinowanego</w> stylu, by rzucić wyzwanie intelektowi czytelnika."
                            }
                        },
                        {
                            "text": "Renaissance literature is often filled with <w>conceited</w> metaphors.",
                            "target_lang_translations": {
                                "ru": "Литература эпохи Возрождения часто наполнена <w>метафоричными</w> образами.",
                                "pl": "Literatura renesansu jest często pełna <w>metaforycznych</w> obrazów."
                            }
                        }
                    ],
                    "synonyms": [
                        "ingenious",
                        "witty"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used primarily in historical literary criticism."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Характеризующийся остроумным или метафорическим выражением, часто используемый в литературном контексте.",
                        "pl": "Charakteryzujący się pomysłowym lub metaforycznym wyrazem, często używany w kontekście literackim."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "метафоричный",
                                "target_lang_sense_clarification": "насыщенный метафорами и сложными образами"
                            },
                            {
                                "target_lang_word": "изощренный",
                                "target_lang_sense_clarification": "отличающийся тонкостью и сложностью построения"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "wyrafinowany",
                                "target_lang_sense_clarification": "cechujący się subtelnością i złożonością formy"
                            },
                            {
                                "target_lang_word": "metaforyczny",
                                "target_lang_sense_clarification": "oparty na przenośniach i skomplikowanych obrazach"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1c6fc18f-0cd0-3ff4-b1c5-c7a3af45fb87",
                    "sense_definition": "Endowed with fancy or imagination.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "literary",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The author was known for his <w>conceited</w> and sharp wit.",
                            "target_lang_translations": {
                                "ru": "Автор был известен своим <w>изобретательным</w> и острым умом.",
                                "pl": "Autor był znany ze swojego <w>pomysłowego</w> i ostrego dowcipu."
                            }
                        },
                        {
                            "text": "He was a <w>conceited</w> storyteller who could imagine worlds beyond our own.",
                            "target_lang_translations": {
                                "ru": "Он был <w>фантазийным</w> рассказчиком, способным вообразить миры за пределами нашего.",
                                "pl": "Był <w>fantazyjnym</w> gawędziarzem, który potrafił wyobrazić sobie światy poza naszym."
                            }
                        }
                    ],
                    "synonyms": [
                        "imaginative",
                        "fanciful"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Refers to an older sense of being imaginative."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Наделенный богатым воображением или фантазией.",
                        "pl": "Obdarzony bujną wyobraźnią lub fantazją."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фантазийный",
                                "target_lang_sense_clarification": "созданный воображением, необычный"
                            },
                            {
                                "target_lang_word": "изобретательный",
                                "target_lang_sense_clarification": "способный придумывать что-то новое и оригинальное"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "pomysłowy",
                                "target_lang_sense_clarification": "zdolny do tworzenia oryginalnych koncepcji"
                            },
                            {
                                "target_lang_word": "fantazyjny",
                                "target_lang_sense_clarification": "będący wytworem wyobraźni, nietuzinkowy"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0f36b03e-063e-356f-85b7-b790555014b3",
                    "sense_definition": "Simple past and past participle of <w>conceit</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He had <w>conceited</w> a plan that was far too complex to execute.",
                            "target_lang_translations": {
                                "ru": "Он <w>замыслил</w> план, который был слишком сложен для исполнения.",
                                "pl": "<w>Obmyślił</w> plan, który był zbyt skomplikowany do wykonania."
                            }
                        },
                        {
                            "text": "The artist <w>conceited</w> the entire project in his mind before starting.",
                            "target_lang_translations": {
                                "ru": "Художник <w>замыслил</w> весь проект в уме, прежде чем приступить к работе.",
                                "pl": "Artysta <w>zamyślił</w> cały projekt w głowie, zanim zaczął pracę."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Grammatical form of the verb conceit."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие от глагола conceit (замышлять, воображать).",
                        "pl": "Czas przeszły i imiesłów od czasownika 'conceit' (zamyślać, obmyślać)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "замыслил",
                                "target_lang_sense_clarification": "спланировал или придумал что-то в уме"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "zamyślił",
                                "target_lang_sense_clarification": "ułożył plan w głowie"
                            },
                            {
                                "target_lang_word": "obmyślił",
                                "target_lang_sense_clarification": "dokładnie zaplanował coś w myślach"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}