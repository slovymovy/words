                                "target_senses": [
                                    {
                                        "sense_id": "ff241474-6a86-3f4d-b45c-35756df4fecc",
                                        "entry_id": "51923671-ee5a-3bfc-b334-c31957a6fedf",
                                        "glosses": [
                                            "Always; constantly; for the complete duration."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f24355fb-3cf3-40ae-96ae-4114c8cc290d",
                                                "sense_id": "ff241474-6a86-3f4d-b45c-35756df4fecc",
                                                "text": "The public does not wish to be outraged in this way all the time."
                                            },
                                            {
                                                "example_id": "2568eb13-fb92-47c6-a4b4-65e4ed87c0c7",
                                                "sense_id": "ff241474-6a86-3f4d-b45c-35756df4fecc",
                                                "text": "Afore we got to the shanty Colonel Applegate stuck his head out of the door. His temper had been getting raggeder all the time, and the sousing he got when he fell overboard had just about ripped what was left of it to ravellings."
                                            },
                                            {
                                                "example_id": "cdc6bb2e-fe8f-4ee7-825e-d899cbd472ee",
                                                "sense_id": "ff241474-6a86-3f4d-b45c-35756df4fecc",
                                                "text": "I couldn't live without your love\nNow, I know you′re really mine\nI gotta have you all the time"
                                            },
                                            {
                                                "example_id": "b49dccf7-d999-4eb1-88d1-41e7807ba4f4",
                                                "sense_id": "ff241474-6a86-3f4d-b45c-35756df4fecc",
                                                "text": "The study found that there had been as many patent applications for artificial intelligence since 2013 as there were in all the time since the term AI was first used in the 1950s."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a1ab9aa5-e3a3-357c-9a75-76a5f778bc90",
                                        "entry_id": "51923671-ee5a-3bfc-b334-c31957a6fedf",
                                        "glosses": [
                                            "Very often; frequently."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f8bb41c-3044-4887-83f2-f1186636a7aa",
                                                "sense_id": "a1ab9aa5-e3a3-357c-9a75-76a5f778bc90",
                                                "text": "I have never been this excited about having an album. I play it all the time."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
