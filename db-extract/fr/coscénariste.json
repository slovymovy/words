                "senses": [
                    {
                        "sense_id": "8d373b36-9bde-33c1-af8a-c91e43299872",
                        "entry_id": "d03266bf-6829-3dde-a5a3-8cf394c114f4",
                        "glosses": [
                            "Auteur ou autrice qui contribue avec d’autres à l’écriture d’un scénario."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c34dc485-1205-47f8-81a3-aca4bba031ea",
                                "sense_id": "8d373b36-9bde-33c1-af8a-c91e43299872",
                                "text": "Marie-Noëlle Himbert a présenté le mardi 11 novembre son livre \"Marie Curie. Portrait d'une femme engagée 1914-1918\" et le film \"Marie Curie. Une femme sur le front\", dont elle est coscénariste."
                            },
                            {
                                "example_id": "3089205e-9646-4d0a-93ab-d0f1e32d86c8",
                                "sense_id": "8d373b36-9bde-33c1-af8a-c91e43299872",
                                "text": "Jeppe Gram, coscénariste de la série danoise Borgen, juge que la situation française «est vraiment une bonne série», et reconnaît au passage qu’«à côté, Borgen a presque l’air innocent ou désuet...»"
                            },
                            {
                                "example_id": "690e0412-df61-4af2-97a3-0935ca19f701",
                                "sense_id": "8d373b36-9bde-33c1-af8a-c91e43299872",
                                "text": "Tout se cristallise autour de nos deux héros, Mia et Tom, résume Agnès Hurstel, cocréatrice et coscénariste de la série."
                            }
                        ]
                    }
                ],
