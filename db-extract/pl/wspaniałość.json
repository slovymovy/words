                "translations": [
                    {
                        "translation_id": "5aaa01e2-5641-462d-b617-ec4b1eee6e50",
                        "source_entry_id": "7455e0a9-1e69-39b4-94f0-bdc01bedb53d",
                        "source_sense_id": "56b37d2e-31dc-3d64-a4ee-ca6eb258d997",
                        "target_lang_word": "grandiosity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grandiosity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "40b6b6d9-9c0b-35f0-bb0c-ca0e2d35e60e",
                                        "entry_id": "cdcdb86d-0004-38e2-ac18-a1dbcdf575d7",
                                        "glosses": [
                                            "The state of being grandiose (pompous or pretentious)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "505ccbf4-fc11-4a85-8c50-b6d57ec94af6",
                                                "sense_id": "40b6b6d9-9c0b-35f0-bb0c-ca0e2d35e60e",
                                                "text": "[…] the narcissistic leader does not use his narcissistic charisma only as a means for political success; he needs success and applause for the sake of his own mental equilibrium. The idea of his greatness and infallibility is essentially based on his narcissistic grandiosity, not on his real achievements as a human being."
                                            },
                                            {
                                                "example_id": "b369188a-43dd-409e-ab0d-ee32909ea440",
                                                "sense_id": "40b6b6d9-9c0b-35f0-bb0c-ca0e2d35e60e",
                                                "text": "U2 have never been a band noted for their love of shy understatement, but even by their standards, their arrival in Las Vegas represents a hitherto-unimagined degree of grandiosity."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "affc287b-d04f-4e55-8bfd-f5497bf363d4",
                        "source_entry_id": "7455e0a9-1e69-39b4-94f0-bdc01bedb53d",
                        "source_sense_id": "56b37d2e-31dc-3d64-a4ee-ca6eb258d997",
                        "target_lang_word": "magnificence",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "magnificence",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e8c46293-2971-37df-abec-7708ed954f0c",
                                        "entry_id": "f60cf440-e75a-314d-8fa5-dfb15c3010c8",
                                        "glosses": [
                                            "grandeur, brilliance, lavishness or splendor"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "274edc02-7310-43c8-9460-119fabb59a51",
                                                "sense_id": "e8c46293-2971-37df-abec-7708ed954f0c",
                                                "text": "all fleſh quakes at your magnificence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11e8335c-6654-37c0-82ec-f5bfaeff3081",
                                        "entry_id": "f60cf440-e75a-314d-8fa5-dfb15c3010c8",
                                        "glosses": [
                                            "The act of doing what is magnificent; the state or quality of being magnificent."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0c924d12-4c79-4564-8bc4-c822dfb728b9",
                        "source_entry_id": "7455e0a9-1e69-39b4-94f0-bdc01bedb53d",
                        "source_sense_id": "56b37d2e-31dc-3d64-a4ee-ca6eb258d997",
                        "target_lang_word": "greatness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "greatness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "987f8552-1275-31ce-9dfe-a19f173344dd",
                                        "entry_id": "0eea1d82-464e-3cde-a61d-81bd02ef9ef7",
                                        "glosses": [
                                            "The state, condition, or quality of being great"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff7fb30f-74c0-4cfe-a633-fa24090daf72",
                                                "sense_id": "987f8552-1275-31ce-9dfe-a19f173344dd",
                                                "text": "Due to the greatness of his size, he was an effective bodyguard."
                                            },
                                            {
                                                "example_id": "838618ec-d868-418c-92f1-1bc93bbcf6f6",
                                                "sense_id": "987f8552-1275-31ce-9dfe-a19f173344dd",
                                                "text": "greatness of mind"
                                            },
                                            {
                                                "example_id": "9fbc63f5-3c18-436a-bde4-7126d4fe5e5f",
                                                "sense_id": "987f8552-1275-31ce-9dfe-a19f173344dd",
                                                "text": "Mal. Some are borne great... Some atcheeue greatnesse... And some haue greatnesse thrust vpon them."
                                            },
                                            {
                                                "example_id": "7b2684f2-2629-420a-9362-592f40b7fb57",
                                                "sense_id": "987f8552-1275-31ce-9dfe-a19f173344dd",
                                                "text": "Until then I had felt that what a great writer I was had been carefully kept secret between myself and my wife and only those people we knew well enough to speak to. I was glad Scott had come to the same happy conclusion as to this possible greatness, but I was also glad he was beginning to run out of his speech."
                                            },
                                            {
                                                "example_id": "360630ac-2dd5-4aad-8e3a-a525b42397f4",
                                                "sense_id": "987f8552-1275-31ce-9dfe-a19f173344dd",
                                                "text": "He showed his greatness when it mattered, but his occasional weakness too."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "67fb525f-f308-3c66-90bb-4b6691abd20d",
                                        "entry_id": "0eea1d82-464e-3cde-a61d-81bd02ef9ef7",
                                        "glosses": [
                                            "Pride; haughtiness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "260dca7c-ce39-4367-9ad9-941d0924e5d3",
                                                "sense_id": "67fb525f-f308-3c66-90bb-4b6691abd20d",
                                                "text": "It is not of pride or greatness that he cometh not aboard your ships."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5ca9602f-b1b0-44a0-91c0-da574e51a34c",
                        "source_entry_id": "7455e0a9-1e69-39b4-94f0-bdc01bedb53d",
                        "source_sense_id": "56b37d2e-31dc-3d64-a4ee-ca6eb258d997",
                        "target_lang_word": "magnificence",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "magnificence",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4f3acfe0-81d6-3f6d-8ec2-c44ea46ff6eb",
                                        "entry_id": "a632067a-7121-3c1d-8754-35a3ac77be91",
                                        "glosses": [
                                            "Caractère magnifique de quelque chose ou de quelqu’un."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9652c061-480f-4d0b-9a8c-945a3913aba7",
                                                "sense_id": "4f3acfe0-81d6-3f6d-8ec2-c44ea46ff6eb",
                                                "text": "De cent façons, New York et sa somptueuse ploutocratie répétaient Venise : dans la magnificence de son architecture, de ses arts, de ses édifices."
                                            },
                                            {
                                                "example_id": "787c2dd0-5b65-4c13-b1ae-ef18b7e8585f",
                                                "sense_id": "4f3acfe0-81d6-3f6d-8ec2-c44ea46ff6eb",
                                                "text": "Les verrières, immenses et nombreuses (car ce chevet et ce transept semblent une véritable lanterne), sont de la plus grande magnificence comme composition et couleur."
                                            },
                                            {
                                                "example_id": "6a4979b3-18c0-4536-8ea3-6743f79f21a2",
                                                "sense_id": "4f3acfe0-81d6-3f6d-8ec2-c44ea46ff6eb",
                                                "text": "Tout cet ensemble, encadré dans l’arrière-plan des monts Gariepins, formait un site d’une incomparable magnificence."
                                            },
                                            {
                                                "example_id": "2fb8cc22-0525-4911-974c-d60548bfc4bc",
                                                "sense_id": "4f3acfe0-81d6-3f6d-8ec2-c44ea46ff6eb",
                                                "text": "Au bout d'une heure nous atteignons la cime, du haut de laquelle on domine tout l'archipel féroésien; contemplée au crépuscule de minuit, cette vue est d'une incomparable magnificence."
                                            },
                                            {
                                                "example_id": "005896de-81db-40ba-ae6b-31e98690cfc8",
                                                "sense_id": "4f3acfe0-81d6-3f6d-8ec2-c44ea46ff6eb",
                                                "text": "Mais la grâce est toujours unie à la magnificence dans les scènes de la nature."
                                            },
                                            {
                                                "example_id": "eb69e16e-11e3-43d0-9968-f94c9830a17c",
                                                "sense_id": "4f3acfe0-81d6-3f6d-8ec2-c44ea46ff6eb",
                                                "text": "L’appartement dans lequel lady Rowena avait été introduite était décoré avec magnificence, mais sans goût."
                                            },
                                            {
                                                "example_id": "799075fd-0355-4051-a0dc-320f10e3792f",
                                                "sense_id": "4f3acfe0-81d6-3f6d-8ec2-c44ea46ff6eb",
                                                "text": "À gauche, la Loire apparaît dans toute sa magnificence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26cdab36-003b-3802-85bd-ed78f203a0fb",
                                        "entry_id": "a632067a-7121-3c1d-8754-35a3ac77be91",
                                        "glosses": [
                                            "Disposition à faire de grandes libéralités."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eaa37440-457d-4098-820e-61dd59bf1943",
                                                "sense_id": "26cdab36-003b-3802-85bd-ed78f203a0fb",
                                                "text": "La magnificence et la galanterie n’ont jamais paru en France avec tant d’éclat que dans les dernières années du règne de Henri second."
                                            },
                                            {
                                                "example_id": "89d5838a-c4ff-4447-9a85-6beda7247e43",
                                                "sense_id": "26cdab36-003b-3802-85bd-ed78f203a0fb",
                                                "text": "Pendant le dîner, qui fut d’une excessive magnificence et admirablement bien servi, le duc remporta sur Canalis un grand avantage."
                                            },
                                            {
                                                "example_id": "c0822b86-7126-453d-8d59-4a6bda8a22c3",
                                                "sense_id": "26cdab36-003b-3802-85bd-ed78f203a0fb",
                                                "text": "La ville et ses plus riches bourgeois veulent surpasser en magnificence les autres cités. La réception est « de gros coutange » mais aussi « chose très admirable »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ce6ad61-0fa4-366f-bd94-13d6a872c654",
                                        "entry_id": "a632067a-7121-3c1d-8754-35a3ac77be91",
                                        "glosses": [
                                            "Objets magnifiques ou dépenses éclatantes."
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "465634a1-9edc-48ac-a953-86af834743ee",
                                                "sense_id": "9ce6ad61-0fa4-366f-bd94-13d6a872c654",
                                                "text": "Voilà bien des magnificences."
                                            },
                                            {
                                                "example_id": "41ec3faa-64ce-4a06-ac56-f11a6ecd600e",
                                                "sense_id": "9ce6ad61-0fa4-366f-bd94-13d6a872c654",
                                                "text": "Il nous a montré toutes ses magnificences."
                                            },
                                            {
                                                "example_id": "43e9f2c3-8326-4cfb-92b0-5c4d92fa3b18",
                                                "sense_id": "9ce6ad61-0fa4-366f-bd94-13d6a872c654",
                                                "text": "Il a fait des magnificences extraordinaires."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5b7453cb-b9d8-4e7f-a478-97e0a8db6934",
                        "source_entry_id": "7455e0a9-1e69-39b4-94f0-bdc01bedb53d",
