                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "smát se",
                                "target_lang_sense_clarification": "nahlas reagovat smíchem"
                            },
                            {
                                "target_lang_word": "psát lol",
                                "target_lang_sense_clarification": "v internetové komunikaci"
                            }
