            "senses": [
                {
                    "sense_id": "35a02564-402f-34c0-8142-e09472270e1c",
                    "sense_definition": "op een bittere of spottende manier glimlachend",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "spottend-glimlachend",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij keek me aan met een <w>grijnzend</w> gezicht en zei geen woord.",
                            "target_lang_translations": {
                                "en": "He looked at me with a <w>grinning</w> face and said not a word."
                            }
                        },
                        {
                            "text": "De jongen stond <w>grijnzend</w> in de deuropening terwijl iedereen op hem wachtte.",
                            "target_lang_translations": {
                                "en": "The boy stood <w>grinning</w> in the doorway while everyone was waiting for him."
                            }
                        }
                    ],
                    "synonyms": [
                        "sardonisch"
                    ],
                    "common_phrases": [
                        "grijnzend gezicht",
                        "grijnzend staan"
                    ],
                    "target_lang_definitions": {
