                                        "sense_id": "d19792a4-e48a-3694-bcb7-0b4bd2ebdff1",
                                        "entry_id": "c74b3681-2ffb-33f1-a6f8-d796b1fc0da1",
                                        "glosses": [
                                            "To grow worse; to deteriorate."
                                        ],
                                        "tags": [
                                            "dated",
                                            "intransitive"
