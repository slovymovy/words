                    {
                        "translation_id": "4d60143f-b771-433a-af3d-452bec9d889b",
                        "source_entry_id": "088b51b8-3496-37c7-ae7c-3315f48fe4e2",
                        "source_sense_id": "0cc89467-53ab-36bb-a275-42471a79ed41",
                        "target_lang_word": "Dialektologie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dialektologie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "391d4b7a-9686-3b1c-890f-f8ec005a6dd2",
                                        "entry_id": "ac3ddd42-7440-38a6-b893-373ec72c7fbd",
                                        "glosses": [
                                            "Teilgebiet der Linguistik, das sich mit der Erforschung der Dialekte (Mundarten) befasst."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54fc4418-07d1-4c9d-b1e3-36dfd2df8708",
                                                "sense_id": "391d4b7a-9686-3b1c-890f-f8ec005a6dd2",
                                                "text": "Die Dialektologie beschreibt und klassifiziert die Dialekte einer Sprache."
                                            },
                                            {
                                                "example_id": "214bb063-10f6-4658-8fbc-a702e4d94f4d",
                                                "sense_id": "391d4b7a-9686-3b1c-890f-f8ec005a6dd2",
                                                "text": "„Die Entstehung der Dialektologie, die Feststellung seiner sozialen und regionalen Differenzierung machen den Wortschatz zum bevorzugten Gegenstand.“"
                                            },
                                            {
                                                "example_id": "6edd6384-1004-42f4-a926-c21ac09a89fa",
                                                "sense_id": "391d4b7a-9686-3b1c-890f-f8ec005a6dd2",
                                                "text": "„Die traditionelle Dialektologie hat sich mit Mundarten und regionalen Sprachvarianten in erster Linie unter historisch- und soziolinguistisch-orientierten Fragestellungen beschäftigt (…).“"
                                            },
                                            {
                                                "example_id": "c736b72a-afa0-4808-9bd2-2df6d8f2c8b3",
                                                "sense_id": "391d4b7a-9686-3b1c-890f-f8ec005a6dd2",
                                                "text": "„Überblickt man von hier aus die Fragestellungen der pragmatischen Dialektologie, so fällt auf, daß an keiner einzigen Stelle speziell vom dialektalen Wortschatz, sondern immer nur generell vom Dialekt als einer Varietät eines Diasystems die Rede war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6901f377-ff94-481d-872d-8139716dc8f6",
                        "source_entry_id": "088b51b8-3496-37c7-ae7c-3315f48fe4e2",
                        "source_sense_id": "0cc89467-53ab-36bb-a275-42471a79ed41",
