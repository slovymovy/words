                        "sense_id": "8c4ee297-3a3f-33e9-9ddf-56aef95354ec",
                        "entry_id": "9595630b-5460-371f-b053-33e44259ef77",
                        "glosses": [
                            "The quality of being charitable."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "1cd5f86a-2e10-40c3-9387-9f33b0677f77",
                                "sense_id": "8c4ee297-3a3f-33e9-9ddf-56aef95354ec",
                                "text": "The reader has seen, that my mother, notwithstanding her charitableness to the poor maid-servant, was a woman of strict morals."
                            }
                        ]
                    },
                    {
                        "sense_id": "5113776c-995a-3786-928f-d34437536a39",
                        "entry_id": "9595630b-5460-371f-b053-33e44259ef77",
                        "glosses": [
                            "A particular kind or instance of this quality."
                        ],
                        "tags": [
                            "countable",
                            "rare",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "1d761b61-f865-42f9-926f-b152c9285d85",
                                "sense_id": "5113776c-995a-3786-928f-d34437536a39",
                                "text": "\"It is a tradition. We must not be too much down on people who have been denied our own advantages.\" She spoke with an air of mild remonstrance. Vague charitablenesses were in her manner, and gentle expostulations."
                            },
                            {
                                "example_id": "af35ca7d-60cf-45f4-af8c-a055496df5ad",
                                "sense_id": "5113776c-995a-3786-928f-d34437536a39",
                                "text": "[…] the conventionalities, the decencies, the moral behaviors sought in small group — as loyalties, fidelities, fair plays, courtesies, kindlinesses, truthfulnesses, cooperations, purities, generosities, tolerations, charitablenesses, honesties, and […]"
                            },
                            {
                                "example_id": "5e63075c-b36f-4e29-8918-b8fc46fcb642",
                                "sense_id": "5113776c-995a-3786-928f-d34437536a39",
                                "text": "But when the service of truth and the public good command, there are certain scruples which are immoral and certain charitablenesses which are dangerous."
                            }
                        ]
                    }
