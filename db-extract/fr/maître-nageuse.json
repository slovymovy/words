                        "entry_id": "8a41e140-649f-3e6b-bc6d-c0e46b97f659",
                        "glosses": [
                            "Femme s’occupant de la sécurité des baigneurs d’une piscine ou d’une plage."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
