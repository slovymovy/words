                                                "example_id": "7c9c9b29-55bc-4bfa-89f3-e1c44b6363c7",
                                                "sense_id": "214db5b4-88b9-3f1d-a796-9803c2f9ffae",
                                                "text": "MRS. PATERSON, a runner and semilapsed vegetarian — she eats meat once a week to fend off anemia — spends weekdays in Manhattan with her son and commutes to Albany most weekends; she and her husband rented out their house in Guilderland, an Albany suburb, and have moved into the Executive Mansion, where she is continuing Ms. Wall Spitzer’s “greening” initiative."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f6fa22d2-3bd3-3673-ac7e-8c0368b9655c",
                                        "entry_id": "b3c32ca8-b12c-305c-b1b4-e0c68ccc6361",
                                        "glosses": [
                                            "To regularly travel from one place to another using public transport."
                                        ],
                                        "tags": [
                                            "Philippines",
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b41fb3ce-d758-3955-aca9-5265debf673b",
                                        "entry_id": "b3c32ca8-b12c-305c-b1b4-e0c68ccc6361",
                                        "glosses": [
                                            "To journey, to make a journey"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "713835ad-6c54-455a-a906-c16b9fd8ad48",
                                                "sense_id": "b41fb3ce-d758-3955-aca9-5265debf673b",
                                                "text": "By one estimate, vultures either residing in or commuting into the Serengeti ecosystem during the annual migration—when 1.3 million white-bearded wildebeests shuffle between Kenya and Tanzania—historically consumed more meat than all mammalian carnivores in the Serengeti combined."
                                            }
                                        ]
                                    }
                                ]
                            }
