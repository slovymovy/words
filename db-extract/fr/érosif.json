                "senses": [
                    {
                        "sense_id": "93cf2ce0-5a3a-3242-8360-cbbe8f365f7d",
                        "entry_id": "0d0d476e-8d7a-341a-b491-0e9d6d033703",
                        "glosses": [
                            "Relatif à l’usure des sols."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "273ec397-8348-4cb2-a414-ad7167ece432",
                                "sense_id": "93cf2ce0-5a3a-3242-8360-cbbe8f365f7d",
                                "text": "Le risque érosif est important sur cette falaise côtière, et les maisons se trouvent maintenant en surplomb."
                            },
                            {
                                "example_id": "7505aa7e-dde6-4ea5-a238-eb3c4b8e25e9",
                                "sense_id": "93cf2ce0-5a3a-3242-8360-cbbe8f365f7d",
                                "text": "Le processus érosif est permanent, il n’attend pas la fin de l’orogenèse pour commencer."
                            }
                        ]
                    },
                    {
                        "sense_id": "ad564928-d162-309b-9899-29c165f700c7",
                        "entry_id": "0d0d476e-8d7a-341a-b491-0e9d6d033703",
                        "glosses": [
                            "Qui érode les sols ; qui provoque l’érosion."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f897a49-bd83-4600-9737-206091f1aaa1",
                                "sense_id": "ad564928-d162-309b-9899-29c165f700c7",
                                "text": "Le ruissellement érosif, qui dévaste les cultures en amont apporte des alluvions en aval."
                            }
                        ]
                    }
                ],
