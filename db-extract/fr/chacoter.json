                                        "sense_id": "fee395d8-55be-31fe-91db-19f426e8e735",
                                        "entry_id": "34d5f6ae-03f9-3393-a1cc-fd737dd2bb1f",
                                        "glosses": [
                                            "A knife; especially, a clasp-knife, pocket knife, or sheath knife."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33d21dd0-c636-4deb-ab6c-96768ed84f52",
                                                "sense_id": "fee395d8-55be-31fe-91db-19f426e8e735",
                                                "text": "Novv if any man can be ſo unkind to his ovvn Body, for I meddle not vvith your Souls, as to ſtand ſtill like a good Chriſtian, and offer his VVeeſon to a Butcher's VVhittle, I ſay no more but that he may be ſav'd, and that's the beſt can come on him."
                                            },
                                            {
                                                "example_id": "227d3cae-a9e6-470e-b337-06916dacfa53",
                                                "sense_id": "fee395d8-55be-31fe-91db-19f426e8e735",
                                                "text": "Rude whittles."
                                            },
                                            {
                                                "example_id": "c9aa5b2a-4ac1-45d0-88c1-8672c4804a87",
                                                "sense_id": "fee395d8-55be-31fe-91db-19f426e8e735",
                                                "text": "The Sheffield whittle was the common knife of the country, which every one carried for general purposes, who was not entitled by rank to wear a sword."
                                            }
                                        ]
                                    }
                                ]
                            },
