                        "glosses": [
                            "dania gotowe lub półgotowe dostarczane do lokali gastronomicznych"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7947d966-7b8b-4733-8173-dd46aefb33f4",
                                "sense_id": "137327e2-094f-36c6-b193-cf48d654bb60",
                                "text": "W Monopolu funkcjonowała nie tylko restauracja, ale także cukiernia i bar, w którym stołowali się zazwyczaj stoczniowcy. W ciągu dnia sprzedawano w nim nawet 400 porcji, głównie garmażu."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "1e03fbf1-417f-30ad-9f8e-13187f132970",
                        "entry_id": "579c0dd3-7a14-3253-8dce-dae57cae8a7f",
                        "glosses": [
                            "zakład produkujący, sprzedający lub dostarczający dania gotowe i półgotowe"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "ec16423b-dccd-4cb8-b1eb-d0f9d14adb13",
                                "sense_id": "1e03fbf1-417f-30ad-9f8e-13187f132970",
                                "text": "W delikatesach były kukułki, a w spożywczym nie, tym bardziej że to przecież był warzywniak, a może nawet garmaż."
                            }
                        ],
