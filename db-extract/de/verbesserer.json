                ],
                "senses": [
                    {
                        "sense_id": "15a6d4c5-787a-3f6b-ae6a-a46adc8b2de8",
                        "entry_id": "3056aec6-a143-3f18-a937-02f2d533f696",
                        "glosses": [
                            "Person, durch die etwas besser geworden ist; Person, die eine/mehrere Verbesserung(en) gemacht hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "01f7f14d-2cdc-4d96-a8f2-ea4184928583",
                                "sense_id": "15a6d4c5-787a-3f6b-ae6a-a46adc8b2de8",
                                "text": "„Im Augenblick, wo de la Haye mich verließ, kam ein junger Mailänder, Don Antonio Croce, zu mir zum Besuch. Ich hatte ihn in Reggio kennen gelernt; er war ein großer Spieler und abgefeimter Verbesserer widrigen Glücks.“"
                            },
                            {
                                "example_id": "8489e0a7-71fc-4ac4-83e0-1ecc7d7738a5",
                                "sense_id": "15a6d4c5-787a-3f6b-ae6a-a46adc8b2de8",
                                "text": "„Der Verbesserer der Menschheit muß streben, diejenigen zu erreichen, die den göttlichen Funken auch nur so schwach entwickelt in sich tragen, daß er überhaupt entfacht werden und aufflammen kann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e4ddf287-86f4-463a-a69b-bb4445c6a06b",
                        "source_entry_id": "3056aec6-a143-3f18-a937-02f2d533f696",
                        "source_sense_id": "15a6d4c5-787a-3f6b-ae6a-a46adc8b2de8",
                        "source_sense_description": "Person, durch die etwas besser geworden ist; Person, die eine/mehrere Verbesserung(en) gemacht hat",
                        "target_lang_word": "improver",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "improver",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6f735e98-7168-3add-8de9-2b24c92fd8ad",
                                        "entry_id": "cbc26687-bd62-39af-ad36-41b94ac61632",
                                        "glosses": [
                                            "Something that, or someone who, improves something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cdebcf88-cc93-4866-940b-c01bf1b8a4b4",
                                                "sense_id": "6f735e98-7168-3add-8de9-2b24c92fd8ad",
                                                "text": "He introduced and encouraged manufactures of all kinds; and no inventor or improver of any ingenious art did he suffer to go unrewarded."
                                            },
                                            {
                                                "example_id": "9ee3dcd3-a197-4f58-8fbe-26adb3675d38",
                                                "sense_id": "6f735e98-7168-3add-8de9-2b24c92fd8ad",
                                                "text": "Never did Christmas board display a more goodly and gracious assemblage of countenances: those who were not handsome were, at least, happy; and happiness is a rare improver of your hard-favoured visage."
                                            },
                                            {
                                                "example_id": "02bf0cbf-56b9-4125-9a69-fbe6581055b0",
                                                "sense_id": "6f735e98-7168-3add-8de9-2b24c92fd8ad",
                                                "text": "What a song. What an instant mood improver. It’ll make you forget all the tension you had built up […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4cad823f-7291-3796-b738-866f2851ad9f",
                                        "entry_id": "cbc26687-bd62-39af-ad36-41b94ac61632",
                                        "glosses": [
                                            "Specifically, a person who improves land or property, a landscaper."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bacd2817-d062-4179-8df9-3a1b62f0d0c5",
                                                "sense_id": "4cad823f-7291-3796-b738-866f2851ad9f",
                                                "text": "[…] may not one say Homer is in this like a skilful Improver, who places a beautiful Statue in a well-disposed Garden so as to answer several Vistas, and by that Artifice one single Figure seems multiply’d into as many Objects as there are Openings from whence it may be viewed?"
                                            },
                                            {
                                                "example_id": "f95b2718-bb00-4759-8f15-acd00d782cba",
                                                "sense_id": "4cad823f-7291-3796-b738-866f2851ad9f",
                                                "text": "He had been visiting a friend in a neighbouring county, and that friend having recently had his grounds laid out by an improver, Mr. Rushworth was returned with his head full of the subject, and very eager to be improving his own place in the same way; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db398ae6-94b0-38d3-977a-7112dbb3fa76",
                                        "entry_id": "cbc26687-bd62-39af-ad36-41b94ac61632",
                                        "glosses": [
                                            "One who improves his or her performance, one who shows improvement (of individuals or groups)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1dec0e1c-ed67-4bdb-a563-8c6ec4d86877",
                                                "sense_id": "db398ae6-94b0-38d3-977a-7112dbb3fa76",
                                                "text": "The hotel can also arrange beginner and improver angling lessons with a local instructor."
                                            },
                                            {
                                                "example_id": "b721d996-dae1-4a0c-a710-bbdf048fa5c9",
                                                "sense_id": "db398ae6-94b0-38d3-977a-7112dbb3fa76",
                                                "text": "The biggest improvers over the last year, according to the index were Côte d’Ivoire, Egypt, Saint Vincent and the Grenadines […]"
                                            },
                                            {
                                                "example_id": "980369d7-ab01-4210-92c6-1c70758aa6ac",
                                                "sense_id": "db398ae6-94b0-38d3-977a-7112dbb3fa76",
                                                "text": "The last-named player was given outings in three of the four Tests against England recently, and although plenty of rough edges remained understandably apparent, he gave the impression of being a willing learner and improver."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d6b67064-8d9f-31cc-88c1-366454f14fcb",
                                        "entry_id": "cbc26687-bd62-39af-ad36-41b94ac61632",
                                        "glosses": [
                                            "A substance added to cause improvement (especially to a foodstuff)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "762f17d4-c102-485a-971a-1f56ebe22df4",
                                                "sense_id": "d6b67064-8d9f-31cc-88c1-366454f14fcb",
                                                "text": "Soy flour is often added to bread as an improver. It helps the dough texture and can make the bread quite soft."
                                            },
                                            {
                                                "example_id": "cab2f18c-7792-4e7c-9b61-5563d9b232cd",
                                                "sense_id": "d6b67064-8d9f-31cc-88c1-366454f14fcb",
                                                "text": "When planting a new olive tree, mix organic soil improver and fertiliser into the planting hole and keep the soil moist while the olive establishes itself."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bb9f0025-56d7-30bf-a0b2-2728e43be483",
                                        "entry_id": "cbc26687-bd62-39af-ad36-41b94ac61632",
                                        "glosses": [
                                            "A pad worn by women to make the dress hang properly."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
