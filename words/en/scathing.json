                    "sense_definition": "present participle and gerund of <w>scathe</w>",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fire was <w>scathing</w> everything in its path as it moved through the forest.",
                            "target_lang_translations": {
                                "ru": "Огонь <w>уничтожал</w> всё на своём пути, продвигаясь через лес."
                            }
                        },
                        {
                            "text": "He was <w>scathing</w> his opponent with sharp words during the debate.",
                            "target_lang_translations": {
                                "ru": "Он <w>разил</w> своего оппонента острыми словами во время дебатов."
                            }
