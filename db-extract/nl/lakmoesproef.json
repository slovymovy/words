                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0be64d85-8802-44f3-8a18-d736400a46d1",
                                                "sense_id": "b493dd8c-2ebe-3b34-8c2d-bd603a6cb3d5",
                                                "text": "„Einen Termin für diesen Lackmustest gibt es schon: Es ist die Wien-Wahl 2015.“"
                                            },
                                            {
                                                "example_id": "c225f183-6f05-4c0d-b7db-9f66895231c5",
                                                "sense_id": "b493dd8c-2ebe-3b34-8c2d-bd603a6cb3d5",
                                                "text": "„Aber einem simplen Lackmustest muß sich auch die Opposition bei ihren Vorschlägen unterziehen lassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2a8d554e-c65a-4267-984d-5c7d2f125335",
                        "source_entry_id": "010761a3-bc6c-35c8-8420-49f0615be82b",
