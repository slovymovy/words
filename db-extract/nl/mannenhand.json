                        "examples": [
                            {
                                "example_id": "127842c0-fdb4-4617-81f8-dc4e250a75b9",
                                "sense_id": "c1e854b2-f7c9-3a3c-aa5f-79e4607366f7",
                                "text": "Drie paar mannenhanden grepen me vast en trokken me weg van de stalen plaat."
                            },
                            {
                                "example_id": "a387df6c-6964-483d-a1f4-e70b986625dd",
                                "sense_id": "c1e854b2-f7c9-3a3c-aa5f-79e4607366f7",
                                "text": "Net wanneer de serveerster arriveert met brood en tapenades, pakt een mannenhand de stoel naast me vast en ruik ik weer de geur van Azzaro."
                            },
                            {
                                "example_id": "ab5dee03-c6a2-4d73-8b83-5ebca8e2e388",
                                "sense_id": "c1e854b2-f7c9-3a3c-aa5f-79e4607366f7",
                                "text": "Mijn blik valt op zijn mooie mannenhanden, ze zijn zo goed verzorgd."
                            }
                        ]
                    }
