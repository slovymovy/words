                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "166004ba-772c-4826-b58d-dc19f40dce7d",
                        "source_entry_id": "17663e57-267c-30e4-b714-0b0075edb4b1",
                        "source_sense_id": "283d62ca-fecc-387a-a301-fa556cf4dd3f",
                        "target_lang_word": "teleurstellend",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "teleurstellend",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "3c1619f3-7bfe-3a74-8719-fbce82d90fb1",
                                        "entry_id": "1a8fda2f-be96-3465-805b-d509a12e84fe",
                                        "glosses": [
                                            "van iets dat het niet aan de verwachtingen beantwoordt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62dbe837-a9b2-42d0-9311-c4261e8ca230",
                                                "sense_id": "3c1619f3-7bfe-3a74-8719-fbce82d90fb1",
                                                "text": "Hij is bezig aan een sterk tweede deel van het seizoen in de belangrijkste opleidingsklasse. Hij was de beste op de Hungaroring en in Spa-Franchorchamps in de hoofdrace, na eerder in het seizoen in Frankrijk de zogenoemde sprintrace te hebben gewonnen. Daar kwam gisteren een derde plek in Rusland bij. ,,Teleurstellend”, zei De Vries, omdat hij vanaf pole position was gestart. ,,Ik verloor wat tijd bij mijn pitstop en had ook niet de snelheid van Alexander Albon en Nicholas Latifi.”"
                                            },
                                            {
                                                "example_id": "8b6e2fb2-4746-42e2-b3a2-7c473c3d95f8",
                                                "sense_id": "3c1619f3-7bfe-3a74-8719-fbce82d90fb1",
                                                "text": "‘Bijzonder teleurstellend.’ Zo bestempelt Lies ter Haar, fractievoorzitter van Burgerforum, de reactie van het college op de vragen die haar partij heeft gesteld over knelpunten in het vervoer met de regiotaxi."
                                            },
                                            {
                                                "example_id": "e799c467-c8d8-48cc-8373-7af386a1e7ae",
                                                "sense_id": "3c1619f3-7bfe-3a74-8719-fbce82d90fb1",
                                                "text": "Voor de Nederlandse regering waren de rechtszaken een belangrijke reden om de dividendbelasting af te schaffen. De juridische houdbaarheid van de dividendbelasting werd genoemd als bijkomend argument naast het verbeteren van het vestigingsklimaat. Dat argument vervalt nu op bijna hetzelfde moment dat premier Mark Rutte bekend maakte dat het kabinet het afschaffen van de dividendbelasting gaat heroverwegen. Hij deed dat afgelopen vrijdag en noemde het 'teleurstellend' dat Unilever de verhuizing van het hoofdkantoor naar Rotterdam voorlopig in de ijskast zet."
                                            }
                                        ]
                                    }
                                ]
                            },
