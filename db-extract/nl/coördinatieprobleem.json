                        "examples": [
                            {
                                "example_id": "604f82a3-d15f-400c-9601-9bbf2b70eba9",
                                "sense_id": "0467ec9a-a98f-3a39-95b0-6c845c15f9c3",
                                "text": "Na een lange zoektocht werd in januari vastgesteld dat de zenuw die mijn rechterbeen aanstuurt wordt ingeklemd door een gebroken wervel', legt Kleinsman uit. 'Hierdoor is er sprake van krachtverlies en coördinatieproblemen wat schaatsen niet meer mogelijk maakt.'"
                            }
                        ]
                    },
                    {
                        "sense_id": "d92fcccb-bf46-320b-b366-8f57aecfc607",
                        "entry_id": "c1cb49d8-ceae-37f9-8e08-21defbf2e437",
                        "glosses": [
                            "vraagstuk betreffende de samenwerking tussen verschillende mensen of organisaties om een gemeenschappelijk doel te bereiken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fdb9f80b-0738-440b-95b1-dd9f7a6b5e74",
                                "sense_id": "d92fcccb-bf46-320b-b366-8f57aecfc607",
                                "text": "Minister Lilianne Ploumen (Ontwikkelingssamenwerking) benadrukte ook het belang van directe actie, maar wees er tegelijkertijd op dat het vooralsnog lastig is gebleken om internationale acties goed te coördineren. 'Consensus is goed, maar actie is beter. Het coördinatieprobleem moet echter zo snel mogelijk worden aangepakt.'"
                            }
                        ]
                    }
