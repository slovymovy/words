                "senses": [
                    {
                        "sense_id": "8c4b12ae-85fc-36bb-a2db-c82a80bde796",
                        "entry_id": "9e9409f0-fcd3-3b27-b607-22fd1fd445f7",
                        "glosses": [
                            "To upload a video of something to TikTok."
                        ],
                        "tags": [
                            "neologism",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "0446f05d-9586-4d37-b37d-790bc08f78e0",
                                "sense_id": "8c4b12ae-85fc-36bb-a2db-c82a80bde796",
                                "text": "There’s nothing worse, after all, than male mutton dressed as lamb; or an old-style peacock dressed like a TikTok-ing Gen Z."
                            },
                            {
                                "example_id": "3cc032be-5ab7-442c-926f-a0cc0f93f009",
                                "sense_id": "8c4b12ae-85fc-36bb-a2db-c82a80bde796",
                                "text": "He got up and performed the first verse, and then walked through the door of the rotating, dioramic set — part Michel Gondry music video; part high school musical — and: It was BTS! Off they went: this black American whiz kid and these seven South Korean superstars TikTokked together."
                            },
                            {
                                "example_id": "bcaf5e0c-a725-454b-9a1a-9a59d0311a05",
                                "sense_id": "8c4b12ae-85fc-36bb-a2db-c82a80bde796",
                                "text": "It’s not often that one sees a mayor TikTok-ing and Instagramming such random activities, ranging from ice-cream making, to exercising, to a mini magic show."
                            },
                            {
                                "example_id": "225a85a4-852a-4991-9c32-04ff0f5a8ad5",
                                "sense_id": "8c4b12ae-85fc-36bb-a2db-c82a80bde796",
                                "text": "Despite some unfortunate mixed messaging so far, government officials say they are well aware that there is an information war they need to win in order to beat Covid — and like these TikTok-ing doctors, they believe that social media is the key."
                            },
                            {
                                "example_id": "47a82e96-78b1-42fb-8993-9bc32b76f442",
                                "sense_id": "8c4b12ae-85fc-36bb-a2db-c82a80bde796",
                                "text": "But thanks to pandemic-shuttered TikTok-ing teens, the anthem with an urgent pulse and message of longing for closeness reignited the Liverpool export’s profile."
                            }
                        ]
                    },
                    {
                        "sense_id": "b405c3f1-ec91-3b15-9273-43797eea617a",
                        "entry_id": "9e9409f0-fcd3-3b27-b607-22fd1fd445f7",
                        "glosses": [
                            "To search for and view on TikTok."
                        ],
                        "tags": [
                            "neologism",
                            "transitive"
                        ],
                        "examples": []
                    }
