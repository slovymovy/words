                    "sense_id": "5a6396c5-4575-31f6-a3bc-398e5e98c330",
                    "sense_definition": "Verwijst naar de personen tegen wie men spreekt (meervoud) als onderwerp van de zin.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "subject_pronoun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zijn <w>jullie</w> klaar om te vertrekken?",
                            "target_lang_translations": {
                                "en": "Are <w>you</w> ready to leave?",
                                "ru": "<w>Вы</w> готовы отправляться?",
                                "pl": "Czy <w>wy</w> jesteście gotowi do wyjścia?",
                                "de": "Seid <w>ihr</w> bereit aufzubrechen?",
                                "fr": "Êtes-<w>vous</w> prêts à partir ?",
                                "it": "Siete pronti a partire <w>voi</w>?",
                                "cs": "Jste <w>vy</w> připraveni k odjezdu?",
                                "tr": "<w>Siz</w> gitmek için hazır mısınız?",
                                "es": "¿Están <w>ustedes</w> listos para salir?"
                            }
                        },
                        {
                            "text": "<w>Jullie</w> komen precies op het juiste moment binnen.",
                            "target_lang_translations": {
                                "en": "<w>You</w> are coming in at exactly the right moment.",
                                "ru": "<w>Вы</w> заходите как раз вовремя.",
                                "pl": "Wchodzicie (<w>wy</w>) dokładnie w odpowiednim momencie.",
                                "de": "<w>Ihr</w> kommt genau im richtigen Moment herein.",
                                "fr": "<w>Vous</w> entrez exactement au bon moment.",
                                "it": "<w>Voi</w> entrate esattamente al momento giusto.",
                                "cs": "<w>Vy</w> vcházíte přesně v pravou chvíli.",
                                "tr": "<w>Siz</w> tam zamanında içeri giriyorsunuz.",
                                "es": "<w>Vosotros</w> entráis exactamente en el momento adecuado."
                            }
                        }
                    ],
                    "antonyms": [
                        "wij",
                        "zij"
                    ],
                    "common_phrases": [
                        "weten jullie",
                        "kunnen jullie",
                        "hebben jullie",
                        "zijn jullie"
                    ],
                    "target_lang_definitions": {
                        "en": "Refers to the people spoken to (plural) as the subject of the sentence.",
                        "ru": "Обозначает людей, к которым обращаются (во множественном числе), в роли подлежащего.",
                        "pl": "Odnosi się do osób, do których się mówi (w liczbie mnogiej), jako podmiot w zdaniu.",
                        "de": "Bezieht sich auf die Personen, zu denen man spricht (Plural), als Subjekt des Satzes.",
                        "fr": "Fait référence aux personnes à qui l'on s'adresse (au pluriel) en tant que sujet de la phrase.",
                        "it": "Si riferisce alle persone a cui ci si rivolge (plurale) come soggetto della frase.",
                        "cs": "Odkazuje na osoby, ke kterým se mluví (množné číslo), jako podmět věty.",
                        "tr": "Cümlenin öznesi olarak, konuşulan kişileri (çoğul) belirtir.",
                        "es": "Se refiere a las personas a las que se habla (en plural) como sujeto de la oración."
                    },
