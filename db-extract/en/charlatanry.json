                    {
                        "sense_id": "454aeaa3-b667-38a1-af20-ff1a2661cfad",
                        "entry_id": "88b194a1-ddcb-3492-b168-c1eaf0ad8e0b",
                        "glosses": [
                            "The state of being a charlatan."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "b756ae89-0dca-4e0a-b9f3-6e59dad5054b",
                                "sense_id": "454aeaa3-b667-38a1-af20-ff1a2661cfad",
                                "text": "I'd always considered astrology bullshit, right up there with the legal, real estate and banking businesses in terms of thieving ass-sucking charlatanry, but it's clear I've been doing it a misservice."
                            }
                        ]
                    },
                    {
                        "sense_id": "fb0a3bb7-163e-3fc8-8f28-95bee8561b0e",
