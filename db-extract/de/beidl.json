                        ],
                        "examples": [
                            {
                                "example_id": "e517a1f4-774a-483f-bb0f-915a409272ce",
                                "sense_id": "4d2d24d6-2eae-3f58-ac60-8c138fb11a72",
                                "text": "„Gewiß, die Männer — so fand der Herzogenburger Fotograf Norbert Siegl, 28, heraus - sind Zoten noch über die Durchschnittsmaßen zugetan: »Fut und Beidl san Geschwister und da Oasch is Kriegsminista« ist vertrautes Gedankengut, wenngleich in jüngerer Zeit bereichert um die Zeilen: »Und die Dutteln san Kanonen und die Eier san Patronen.«“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c1496ced-55bf-3dcf-bc1e-50e56d732e25",
                        "entry_id": "00fe8985-61b3-3ead-93ec-28c6ddea08f9",
                        "glosses": [
                            "unnützer Mensch"
                        ],
                        "tags": [
                            "Austrian German",
                            "colloquial",
                            "impolite"
                        ],
                        "examples": [
                            {
                                "example_id": "685014c8-5bc0-4132-8fcd-2bc019adc519",
                                "sense_id": "c1496ced-55bf-3dcf-bc1e-50e56d732e25",
                                "text": "„\"Jetzt siehst du wenigstens einmal, was das für Beidl sind\", sagte Zanger dabei in deren Richtung.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
