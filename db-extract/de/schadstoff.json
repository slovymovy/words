                        "form": "den Schadstoff"
                    },
                    {
                        "form_id": "afdf0520-f2b2-47e5-b0b1-ff49bbd7b25e",
                        "entry_id": "8412e246-1cf9-3e15-80e6-38779b98f287",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Schadstoffe"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "bfba321d-fbe8-34a3-ae6a-2bf57a7e5640",
                        "entry_id": "8412e246-1cf9-3e15-80e6-38779b98f287",
                        "glosses": [
                            "chemischer Stoff, der ab einem bestimmten Ausmaß der Natur schadet"
                        ],
                        "tags": [
                            "jargon"
                        ],
                        "examples": [
                            {
                                "example_id": "94bef9f3-58d7-4036-bb3d-c40d17e65f90",
                                "sense_id": "bfba321d-fbe8-34a3-ae6a-2bf57a7e5640",
                                "text": "Durch den Bau von sehr vielen Kläranlagen und die Abkoppelung der Industrie wurden sämtliche Flüsse in Deutschland von der weiteren Einleitung von Schadstoffen befreit."
                            },
                            {
                                "example_id": "bc5cbda3-f23e-404f-9a7f-93de643f1264",
                                "sense_id": "bfba321d-fbe8-34a3-ae6a-2bf57a7e5640",
                                "text": "Die ungebremste Abgabe der Schadstoffe an die Luft hat dazu geführt, dass wir ernsthaft über ein Ozonloch diskutieren und gar verwundert sind, wenn Wind und Wetter durcheinander geraten."
                            },
                            {
                                "example_id": "43d7dc77-4ca8-451e-98fb-a60e5432b0de",
                                "sense_id": "bfba321d-fbe8-34a3-ae6a-2bf57a7e5640",
                                "text": "„Die Forschungsanstalt für Forst- und Holzwirtschaft habe aufgrund seines Materials eine Studie über die waldschädigenden industriellen Schadstoffe erarbeitet; mit Fotos von kranken Bäumen.“"
                            },
                            {
                                "example_id": "2d8316ef-d99f-4b6c-ac36-e54bd93b4746",
                                "sense_id": "bfba321d-fbe8-34a3-ae6a-2bf57a7e5640",
                                "text": "„Die Schadstoffe gelangen unter anderem durch Industrieabfälle in Boden und Wasser.“"
                            },
                            {
                                "example_id": "37eeb519-c8aa-44f4-be6e-5a3fa82b7231",
                                "sense_id": "bfba321d-fbe8-34a3-ae6a-2bf57a7e5640",
                                "text": "„Eine neue Studie hat gezeigt, dass Schadstoffe in Boden und Wasser einen erheblichen Einfluss auf unsere Gesundheit haben können.“"
                            },
                            {
                                "example_id": "24be066c-dfc5-476f-89b8-5c26f83b356a",
                                "sense_id": "bfba321d-fbe8-34a3-ae6a-2bf57a7e5640",
                                "text": "„Nehmen wir die Schadstoffe dann mit der Nahrung auf, könnte das erhebliche Folgen für unser Herz-Kreislauf-System haben.“"
                            },
                            {
                                "example_id": "2d33b7b4-232b-4602-a612-8628929ef269",
                                "sense_id": "bfba321d-fbe8-34a3-ae6a-2bf57a7e5640",
                                "text": "[…] „Blei [ist] der bedenklichste Schadstoff, der in Boden und Wasser vorkommt.“"
                            },
                            {
                                "example_id": "57dff1da-8416-4c60-bf9c-2b489b0074a4",
                                "sense_id": "bfba321d-fbe8-34a3-ae6a-2bf57a7e5640",
                                "text": "„Wer den Anteil der Schadstoffe reduzieren will, muss deshalb auch die Landwirte überzeugen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
