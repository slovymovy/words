                "senses": [
                    {
                        "sense_id": "e371acd3-745d-3423-8755-2dcb93f4e397",
                        "entry_id": "c3ab55aa-19e4-358e-85ee-6c617dd9242c",
                        "glosses": [
                            "een van de twee dagen van het paasfeest, paaszondag of paasmaandag"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "41851dad-5f8a-4122-b6ae-e57f6cd0573b",
                                "sense_id": "e371acd3-745d-3423-8755-2dcb93f4e397",
                                "text": "De tweede paasdag is een officiële vrije dag."
                            },
                            {
                                "example_id": "a7fc0032-9ae6-4798-84c7-5688742eee2c",
                                "sense_id": "e371acd3-745d-3423-8755-2dcb93f4e397",
                                "text": "Op Eerste Paasdag had ik in Rome de eer om paus Franciscus te ontmoeten. Een heel bijzonder moment. En zojuist bereikte ons het verdrietige nieuws dat hij is overleden. Mijn gedachten zijn bij allen die geraakt zijn door zijn overlijden."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e34a9191-80e5-4853-9d29-8029e3162526",
                        "source_entry_id": "c3ab55aa-19e4-358e-85ee-6c617dd9242c",
                        "source_sense_id": "e371acd3-745d-3423-8755-2dcb93f4e397",
                        "source_sense_description": "een van de twee dagen van het paasfeest, paaszondag of paasmaandag",
                        "target_lang_word": "Ostertag",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ostertag",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "df8d0ca9-136d-3779-8cdc-a29595305c18",
                                        "entry_id": "c691578d-6ecd-3bc7-8b04-f84923c3b811",
                                        "glosses": [
                                            "der erste (Ostersonntag) oder einer der Tage des Osterfestes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "070fccec-7cea-4e73-8064-6d00071f06e9",
                                                "sense_id": "df8d0ca9-136d-3779-8cdc-a29595305c18",
                                                "text": "Wir fahren über die Ostertage nach Dänemark."
                                            },
                                            {
                                                "example_id": "f806da4e-4f72-49a3-aacb-5c08c7ac36b0",
                                                "sense_id": "df8d0ca9-136d-3779-8cdc-a29595305c18",
                                                "text": "„Am zweiten Ostertag besuchte uns Carlo mit seiner Frau, die mir in ihrer ganzen Persönlichkeit verändert vorkam.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Ostertag",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8eeeaef1-b31a-33d2-bc1e-5f7970fac9c7",
                                        "entry_id": "9f7b8f69-ffa2-3fc2-9d69-12bf872a4ea7",
                                        "glosses": [
                                            "deutscher Nachname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d733360-da09-403d-9ed1-c783b4715b3e",
                                                "sense_id": "8eeeaef1-b31a-33d2-bc1e-5f7970fac9c7",
                                                "text": "Wir sind für heute Abend bei Ostertags eingeladen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c706f2db-bee5-4d25-97bd-6e93016b68d3",
                        "source_entry_id": "c3ab55aa-19e4-358e-85ee-6c617dd9242c",
                        "source_sense_id": "e371acd3-745d-3423-8755-2dcb93f4e397",
