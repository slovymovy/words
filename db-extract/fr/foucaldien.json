                                        "examples": [
                                            {
                                                "example_id": "e306f5a4-71af-4b3a-9e9f-27ea9254d337",
                                                "sense_id": "b1148261-b3cd-3a62-8d59-90f5857818bd",
                                                "text": "It warmed his Foucaultian heart, in a way, to live in a land where property ownership and the control of public discourse were so obviously a matter of who had the guns."
