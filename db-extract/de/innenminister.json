                ],
                "senses": [
                    {
                        "sense_id": "4cf226c0-15b3-3120-a38c-024bf1f2117b",
                        "entry_id": "e06defe7-7938-3c42-bb28-4688323e0f84",
                        "glosses": [
                            "Leiter des Innenministeriums, der sich um innere Angelegenheiten (die Verwaltung eines Landes/Kantons wie zum Beispiel Innere Sicherheit, Sport) auf länder-/kantons- oder nationaler Ebene kümmert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a7a8f4c-cc3c-477a-8db4-5418401c3a18",
                                "sense_id": "4cf226c0-15b3-3120-a38c-024bf1f2117b",
                                "text": "Die Bundespolizei untersteht dem Innenminister."
                            },
                            {
                                "example_id": "227bda83-7f6d-4f9c-a1fc-7512214181ae",
                                "sense_id": "4cf226c0-15b3-3120-a38c-024bf1f2117b",
                                "text": "„Im Amt des Innenministers galt der Partei-Rechte Glogowski bald als harter Hund.“"
                            },
                            {
                                "example_id": "42bca86a-d948-43c3-b6ed-f525402827a2",
                                "sense_id": "4cf226c0-15b3-3120-a38c-024bf1f2117b",
                                "text": "„Vorsitzer und Bundeswahlleiter ist laut Nationalratswahlordnung Innenminister Wolfgang Sobotka (ÖVP).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7ae4f02f-a320-40f8-9dfb-4d665db33930",
                        "source_entry_id": "e06defe7-7938-3c42-bb28-4688323e0f84",
