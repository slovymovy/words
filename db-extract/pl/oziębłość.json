                "senses": [
                    {
                        "sense_id": "13157c89-ddac-35f3-8f76-ea676f9e5a26",
                        "entry_id": "4fc8284e-2649-3c82-8be6-95c0cdfc79e1",
                        "glosses": [
                            "zobojętnienie, oschłość, brak żywszych uczuć"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "960ed4db-03a8-4fb6-82a9-74c018c2ec28",
                                "sense_id": "13157c89-ddac-35f3-8f76-ea676f9e5a26",
                                "text": "Jedną z głównych przeszkód do osiągnięcia świętości jest oziębłość duchowa. Jak możemy określić człowieka oziębłego? Oziębły jest taki człowiek, który chciałby służyć Bogu, ale pod warunkiem, że nic go to nie będzie kosztowało"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "7a4f42e6-e173-3ce3-a8ed-75303a0ac502",
                        "entry_id": "4fc8284e-2649-3c82-8be6-95c0cdfc79e1",
                        "glosses": [
                            "osłabienie popędu płciowego, hipolibidemia"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7cf9a4b4-8686-4b11-aa17-5ec8b4a52410",
                                "sense_id": "7a4f42e6-e173-3ce3-a8ed-75303a0ac502",
                                "text": "Powodem ich rozwodu była oziębłość męża."
                            },
                            {
                                "example_id": "1dee2626-543f-4340-b19f-ae25ab37843d",
                                "sense_id": "7a4f42e6-e173-3ce3-a8ed-75303a0ac502",
                                "text": "Wśród czterech tysięcy kobiet w grupie czterdziesto-, pięćdziesięcioletnich, które zaczęły współżyć w dwudziestym ósmym — trzydziestym roku życia, stwierdziłam w sześćdziesięciu ośmiu procentach oziębłość seksualną"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
