                "senses": [
                    {
                        "sense_id": "ac1ba374-db0e-3a52-8ae7-7ee57dfdc227",
                        "entry_id": "5f1bc586-2849-3a8f-8089-850cd864ab21",
                        "glosses": [
                            "dated form of Verb (“verb”)"
                        ],
                        "tags": [
                            "alt-of",
                            "dated",
                            "neuter",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "c56699ef-45b9-42d3-af97-967b7ac4ec41",
                                "sense_id": "ac1ba374-db0e-3a52-8ae7-7ee57dfdc227",
                                "text": "βαίνω ist, wie wir schon S. 263 bemerkten, mit lat. ven-io gleicher Bildung, aber der Nasal haftet im Lateinischen, wie im Oskischen und Umbrischen (3 S. Fut. ex. ben-ust) an dem ganzen Verbalstamme, während er im griechischen Verbum nur an dieser Stelle erscheint. βαίνω ist also vom griechischen Standpunkt aus eins von denjenigen Verben, in denen die Nasal- und I-Classe sich verbinden, venio gehört ausschließlich der I-Classe an."
                            },
                            {
                                "example_id": "4f5c104b-7efb-432e-ba3c-4ca821ae2a80",
                                "sense_id": "ac1ba374-db0e-3a52-8ae7-7ee57dfdc227",
                                "text": "Mit dem Übergang von î zu ei fielen die beiden Verben zusammen, so dass bei H. S. es schwer zu sagen ist, ob eine Praeteritalform schied dem ersten oder dem zweiten Verbum angehört."
                            },
                            {
                                "example_id": "3c030a53-2068-4a8e-80f6-49d8355f3032",
                                "sense_id": "ac1ba374-db0e-3a52-8ae7-7ee57dfdc227",
                                "text": "Der Knabe dachte an den Konfirmationssonntag, der kürzlich gewesen war und an dem er sich dabei ertappt hatte, daß er mitten in der Feierlichkeit und Rührung innerlich ein griechisches Verbum memorierte.",
                                "translation": "Beneath the Wheel",
                                "english": "Beneath the Wheel"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
