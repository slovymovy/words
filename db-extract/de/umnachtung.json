                "senses": [
                    {
                        "sense_id": "e7560bdd-bbdd-3dad-8260-b968a99f1096",
                        "entry_id": "a91c9926-c4c6-3a7d-936c-a14b4c2e2fb1",
                        "glosses": [
                            "Verlust kognitiver Fähigkeiten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "126adc02-ee8e-4803-8493-3c29c2aac392",
                                "sense_id": "e7560bdd-bbdd-3dad-8260-b968a99f1096",
                                "text": "Für den einst als gerade mal 19-Jähriger, fast Verhungerter aus dem Krieg heimgekehrten Vater gäbe es nur die Gnade der völligen Umnachtung, das, was die Gläubigen mit dem Wort \"Himmelreich\" benennen."
                            },
                            {
                                "example_id": "14bd0edc-255b-4023-9593-ddbedfd1d133",
                                "sense_id": "e7560bdd-bbdd-3dad-8260-b968a99f1096",
                                "text": "„Von ihrer später ausbrechenden psychischen Erkrankung und der geistigen Umnachtung, die ihre letzten Lebensjahre bestimmen würde, ist noch nichts zu ahnen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1d5f8344-abb5-4c99-84bf-2d52cd860dc1",
