                "senses": [
                    {
                        "sense_id": "92618fbb-065a-3bbf-a5df-9888cb42865b",
                        "entry_id": "10f25c3d-32b2-3a64-877d-12f0a904dd6e",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "024395c0-e8b3-4e70-a844-c7eea375e60f",
                                "sense_id": "92618fbb-065a-3bbf-a5df-9888cb42865b",
                                "text": "Breslaus kamen, sahen und siegten."
                            },
                            {
                                "example_id": "70d9071f-5900-4133-a28a-2f7dd361d922",
                                "sense_id": "92618fbb-065a-3bbf-a5df-9888cb42865b",
                                "text": "Frau Breslau ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "c10ed8b0-2793-4fc1-9c4b-7f91f68d6793",
                                "sense_id": "92618fbb-065a-3bbf-a5df-9888cb42865b",
                                "text": "Herr Breslau wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "f2b6896f-f2df-4759-a331-c44e3683e699",
                                "sense_id": "92618fbb-065a-3bbf-a5df-9888cb42865b",
                                "text": "Die Breslaus fahren heute nach Köln."
                            },
                            {
                                "example_id": "76c7822f-fafd-41ef-93d4-dd2814b43aee",
                                "sense_id": "92618fbb-065a-3bbf-a5df-9888cb42865b",
                                "text": "Der Breslau trägt nie die Pullover, die die Breslau ihm strickt."
                            },
                            {
                                "example_id": "e49fc303-727e-424a-8d4e-a3b5094f2f00",
                                "sense_id": "92618fbb-065a-3bbf-a5df-9888cb42865b",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Breslau kommt, geht der Herr Breslau.“"
                            },
                            {
                                "example_id": "347ae26b-9cb4-4430-9632-9328e284d469",
                                "sense_id": "92618fbb-065a-3bbf-a5df-9888cb42865b",
                                "text": "Breslau kommt und geht."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
