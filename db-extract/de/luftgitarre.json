                        "source_sense_description": "imaginäre Gitarre, auf der jemand spielt, indem er entsprechende Bewegungen vorspielt",
                        "target_lang_word": "luchtgitaar",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "luchtgitaar",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "c65eb789-f99a-323b-833f-d55fc4471afe",
                                        "entry_id": "75612556-19e7-3ca5-a285-2f73fa82c836",
                                        "glosses": [
                                            "een denkbeeldige gitaar waarop de \\\"muzikant\\\" speelt, of liever de bewegingen maakt alsof hij een gitaar bespeelt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7eeeae72-b8b3-4785-a323-a94f052329e0",
                                                "sense_id": "c65eb789-f99a-323b-833f-d55fc4471afe",
                                                "text": "Op diverse andere gebieden willen mensen succesvol zijn. Zo strijden teams tegen elkaar tijdens het NK Propjesgooien of tijdens het jamworstelen. Ook staan veel deelnemers in de rij voor het Nederlands Luchtgitaar Kampioenschap. De winnaar mag zelfs meedoen aan het WK. In Hilvarenbeek vindt 22 mei Open Nederlands Kampioenschap voor Amateur Bierbrouwers plaats."
                                            },
                                            {
                                                "example_id": "d6f94757-652e-4a1e-99ec-6709885c2bfa",
                                                "sense_id": "c65eb789-f99a-323b-833f-d55fc4471afe",
                                                "text": "Als de gitaarsolo in Nothing Else Matters van Metallica langzaam aanzwelt, pakt Albert Kammenga zijn Corien op en zwiert haar met haar witte bruidsjurk in het rond. Het is de apotheose van de openingsdans die ze twee jaar geleden bij hun bruiloft tot verrassing van de gasten uitvoerden. Daarna vallen ze op de knieën om de laatste akkoorden mee te spelen op luchtgitaar."
                                            }
                                        ]
                                    }
