        "fr-extract.jsonl": [
            {
                "entry_id": "87da9689-9093-31d0-b150-4810e958f57e",
                "word": "marcheur",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "96db4eb4-97b0-462c-85ee-bc0af1ee953b",
                        "entry_id": "87da9689-9093-31d0-b150-4810e958f57e",
                        "tags": [
                            "plural"
                        ],
                        "form": "marcheurs"
                    },
                    {
                        "form_id": "67d7f07a-5959-4685-b941-c6e1678a9359",
                        "entry_id": "87da9689-9093-31d0-b150-4810e958f57e",
                        "tags": [
                            "feminine"
                        ],
                        "form": "marcheuse"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f35ea439-140e-3e7e-8d32-5fcb13ac30b9",
                        "entry_id": "87da9689-9093-31d0-b150-4810e958f57e",
                        "glosses": [
                            "Celui qui sait marcher, qui est doté de la capacité de marcher."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7143b258-86e2-4071-9ec7-40e6a8688e34",
                                "sense_id": "f35ea439-140e-3e7e-8d32-5fcb13ac30b9",
                                "text": "Les batraciens offrent, dans l’histoire évolutive, l’importance extrême d’avoir été les premiers vertébrés terrestres, les premiers marcheurs. Ils inaugurèrent la patte […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "ca662f41-a47f-3fc0-bf88-ba3695b5ca4d",
                        "entry_id": "87da9689-9093-31d0-b150-4810e958f57e",
                        "glosses": [
                            "Personne qui peut marcher beaucoup sans se fatiguer."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "2f504026-0155-4b0a-9704-8deca13bd7ea",
                                "sense_id": "ca662f41-a47f-3fc0-bf88-ba3695b5ca4d",
                                "text": "Enfin, le poumon vert de Bruxelles, la forêt de Soignes et ses majestueux hêtres vieux de deux siècles, régale les marcheurs les meilleurs, tandis que le Rouge-Cloître, juste à coté, s'impose aux bulleurs comme l'espace de détente rêvé."
                            },
                            {
                                "example_id": "2d32d06c-68d4-4e61-a95d-5f6e6777985e",
                                "sense_id": "ca662f41-a47f-3fc0-bf88-ba3695b5ca4d",
                                "text": "On l’emploie le plus souvent avec une épithète."
                            },
                            {
                                "example_id": "ea259d82-bd0a-4c7c-8cd3-e74a592b2b68",
                                "sense_id": "ca662f41-a47f-3fc0-bf88-ba3695b5ca4d",
                                "text": "Un grand, un bon, un mauvais marcheur."
                            },
                            {
                                "example_id": "c76bfb51-3f01-4070-ac9b-56bece601e20",
                                "sense_id": "ca662f41-a47f-3fc0-bf88-ba3695b5ca4d",
                                "text": "Je ne rapporte cette circonstance insignifiante que parce qu’elle est caractéristique de la légèreté des Espagnols, les premiers marcheurs du monde et les coureurs les plus agiles que l’on puisse voir."
                            },
                            {
                                "example_id": "a2edb302-ee38-473e-b572-16b5b7b513df",
                                "sense_id": "ca662f41-a47f-3fc0-bf88-ba3695b5ca4d",
                                "text": "Dès avril hélas, les estivants recommencèrent leur transhumance. Des badauds erraient devant toutes les grilles, des marcheurs dans tous les sentiers."
                            }
                        ]
                    },
                    {
                        "sense_id": "1230ff1a-a3fc-3c65-af4e-278bc2d3ccc5",
                        "entry_id": "87da9689-9093-31d0-b150-4810e958f57e",
                        "glosses": [
                            "Athlète spécialiste de la marche."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2e85277-1193-4eef-8201-c17d4162a003",
                                "sense_id": "1230ff1a-a3fc-3c65-af4e-278bc2d3ccc5",
                                "text": "Le camp français a fait appel de la décision, mais le marcheur tricolore a encore passé une journée assez incroyable."
                            }
                        ]
                    },
                    {
                        "sense_id": "c9fa2993-e1ac-3a11-88be-fdd4a52bc2a3",
                        "entry_id": "87da9689-9093-31d0-b150-4810e958f57e",
                        "glosses": [
                            "Créature ressemblant a une araignée géante."
                        ],
                        "tags": [
                            "Fantastique",
                            "Univers d’Ewilan de Pierre Bottero"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "55a7a30c-b002-3090-8a3b-d0941b696d82",
                        "entry_id": "87da9689-9093-31d0-b150-4810e958f57e",
                        "glosses": [
                            "Dispositif d’entraînement des chevaux, où ils marchent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f8e69ae-2e7c-40db-b13f-2e365d82793b",
                                "sense_id": "55a7a30c-b002-3090-8a3b-d0941b696d82",
                                "text": "Tous les chevaux sont sortis sur le marcheur (un outil pour l’échauffement et le retour au calme) et au paddock (l’enclos) chaque jour, mais tous ne sont pas entraînés de la même façon."
                            }
                        ]
                    },
                    {
                        "sense_id": "40e46f79-caba-35d7-9385-b5b4a0b19a0c",
                        "entry_id": "87da9689-9093-31d0-b150-4810e958f57e",
                        "glosses": [
                            "Partisan du mouvement politique En marche."
                        ],
                        "tags": [
                            "France"
                        ],
                        "examples": [
                            {
                                "example_id": "28d8e822-0f2f-4eba-8724-dc52832e7bcc",
                                "sense_id": "40e46f79-caba-35d7-9385-b5b4a0b19a0c",
                                "text": "Pour arriver au pouvoir, Emmanuel Macron a pu s'appuyer sur la détermination de ses 400 000 marcheurs, durant la campagne."
                            }
                        ]
                    },
                    {
                        "sense_id": "ae84a1e6-6242-3ca2-b9e7-90b119e04363",
                        "entry_id": "87da9689-9093-31d0-b150-4810e958f57e",
                        "glosses": [
                            "Viveur, qui fait la noce."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d22be4d8-4d32-48c3-810e-011f51891f9f",
                        "source_entry_id": "87da9689-9093-31d0-b150-4810e958f57e",
                        "target_lang_word": "walker",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "walker",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7dbd5128-fbc8-373d-b436-a73610ebb597",
                                        "entry_id": "0b140ea0-ee52-3062-9efa-ffd108a620af",
                                        "glosses": [
                                            "The agent noun of to walk: a person who walks or a thing which walks, especially a pedestrian or a participant in a walking race."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74adc428-b702-4521-91bf-c2af58208024",
                                                "sense_id": "7dbd5128-fbc8-373d-b436-a73610ebb597",
                                                "text": "The park was full of morning walkers enjoying the fresh air."
                                            },
                                            {
                                                "example_id": "a65de723-616b-478b-a744-0f3c1296bd43",
                                                "sense_id": "7dbd5128-fbc8-373d-b436-a73610ebb597",
                                                "text": "He decided to become a long-distance walker for charity events."
                                            },
                                            {
                                                "example_id": "35caefcc-ff27-48d8-b578-874d77ff803a",
                                                "sense_id": "7dbd5128-fbc8-373d-b436-a73610ebb597",
                                                "text": "I would ask for the pleasure of your company, Mr. Knightley, but I am a very slow walker, and my pace would be tedious to you; and, besides, you have another long walk before you, to Donwell Abbey."
                                            },
                                            {
                                                "example_id": "0c42d904-c1f9-4c84-a1d2-ef603d43f063",
                                                "sense_id": "7dbd5128-fbc8-373d-b436-a73610ebb597",
                                                "text": "We hired a walker for the dogs during the day."
                                            },
                                            {
                                                "example_id": "521cff31-937c-4fb3-9231-7468c99eb740",
                                                "sense_id": "7dbd5128-fbc8-373d-b436-a73610ebb597",
                                                "text": "A distracted walker also may be missing an opportunity to bond with their dog, says Burch of the American Kennel Club. “Interacting and having fun together forms a bond that can last a lifetime,” she says."
                                            },
                                            {
                                                "example_id": "62649a1a-4265-45f7-bb0b-6fff2c4130a0",
                                                "sense_id": "7dbd5128-fbc8-373d-b436-a73610ebb597",
                                                "text": "To better help you in your quest, we asked multiple podiatrists and seasoned long-distance walkers exactly what to look for when selecting the best walking shoes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "506608a5-5e38-37c6-93e0-ea7a942eeb6c",
                                        "entry_id": "0b140ea0-ee52-3062-9efa-ffd108a620af",
                                        "glosses": [
                                            "One who walks (takes for a walk)."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd944a77-faed-4fcc-84ec-deee2e3e06cd",
                                                "sense_id": "506608a5-5e38-37c6-93e0-ea7a942eeb6c",
                                                "text": "Accompanying her was Prinny, who was made very happy by this intimation that he was to be taken for a walk, an undertaking for which the servants generally drew lots, the dog’s mass being so considerable and energetic that the walker inevitably became the walkee."
                                            },
                                            {
                                                "example_id": "3f42d3c7-dc80-43d4-bf07-b48d8c92f22d",
                                                "sense_id": "506608a5-5e38-37c6-93e0-ea7a942eeb6c",
                                                "text": "Consequently, he had developed a new variation on an old habit. That of grabbing the leash between his teeth and pulling as hard as he could, making it look as if he were the walker, and the walker the walkee."
                                            },
                                            {
                                                "example_id": "00fb17df-bc3e-4185-9098-da356d3bb7e9",
                                                "sense_id": "506608a5-5e38-37c6-93e0-ea7a942eeb6c",
                                                "text": "I remember that walking a dog is a good way to get both the walker and the walkee in shape."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d0a4909-34f0-30b3-92b2-de249fb4061a",
                                        "entry_id": "0b140ea0-ee52-3062-9efa-ffd108a620af",
                                        "glosses": [
                                            "A walking frame or baby walker."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a65a520a-4994-412b-8558-4097023274d5",
                                                "sense_id": "1d0a4909-34f0-30b3-92b2-de249fb4061a",
                                                "text": "The elderly woman used a walker to help her move around more easily."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "115ec9f8-e37e-3c93-990b-ecfad8c8fbbe",
                                        "entry_id": "0b140ea0-ee52-3062-9efa-ffd108a620af",
                                        "glosses": [
                                            "A shoe designed for comfortable walking."
                                        ],
                                        "tags": [
                                            "in-plural",
                                            "often"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "91eec5e9-9bbc-35a9-857e-ab0b34d155b1",
                                        "entry_id": "0b140ea0-ee52-3062-9efa-ffd108a620af",
                                        "glosses": [
                                            "A zombie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fbfc22c2-7bcc-4c7c-99e1-73dfe1d1bf79",
                                                "sense_id": "91eec5e9-9bbc-35a9-857e-ab0b34d155b1",
                                                "text": "Dead people, walkers, as you call them, are somehow, and for some reason, attacking."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "773bc39d-e77c-35f5-8228-6168c2c62439",
                                        "entry_id": "0b140ea0-ee52-3062-9efa-ffd108a620af",
                                        "glosses": [
                                            "A male escort who accompanies a woman to an event."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad6bcd2d-3c1d-411c-92ef-e499e241260a",
                                                "sense_id": "773bc39d-e77c-35f5-8228-6168c2c62439",
                                                "text": "He's really just a 'walker' for old ladies!\" Walkers, now, are a special breed of pilot fish — entertaining male escorts."
                                            },
                                            {
                                                "example_id": "2a234012-0c46-46cd-92f4-fcc29ca7681e",
                                                "sense_id": "773bc39d-e77c-35f5-8228-6168c2c62439",
                                                "text": "Women at the top — Lady Di and Nancy Reagan in particular — apparently have 'walkers' — men to escort them on public and private occasions providing a respectable cover, while the male who is their sexual partner is off on more pressing business."
                                            },
                                            {
                                                "example_id": "d98ba8d8-c334-4ee7-863d-44b4a174bf17",
                                                "sense_id": "773bc39d-e77c-35f5-8228-6168c2c62439",
                                                "text": "In the vernacular of the trade, he was what is commonly known as \"a walker\" — an entertaining male escort who is usually sexually unthreatening […]"
                                            },
                                            {
                                                "example_id": "dfc6b803-192c-4a36-be2c-cdce8115dabb",
                                                "sense_id": "773bc39d-e77c-35f5-8228-6168c2c62439",
                                                "text": "– Do you think they’re sausages? said Samia, a colleague whom Jane had brought along as her walker."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "64041dcd-e228-3fbf-b585-e606bc36c170",
                                        "entry_id": "0b140ea0-ee52-3062-9efa-ffd108a620af",
                                        "glosses": [
                                            "A gressorial bird."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f9458c83-973a-3908-bf3f-663ff3508404",
                                        "entry_id": "0b140ea0-ee52-3062-9efa-ffd108a620af",
                                        "glosses": [
                                            "A forester."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f2557fb2-53f2-3e10-b55f-3899b348df0c",
                                        "entry_id": "0b140ea0-ee52-3062-9efa-ffd108a620af",
                                        "glosses": [
                                            "A kind of military robot or mecha with legs for locomotion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ae0ae37-443d-412f-a32b-b07235edfa60",
                                                "sense_id": "f2557fb2-53f2-3e10-b55f-3899b348df0c",
                                                "text": "Two of the walkers circled the pillars. Their searchlights played through the trees, then turned back to Leia and the others."
                                            },
                                            {
                                                "example_id": "6cb8f5a5-8f3f-4a02-a916-65ee58313ef0",
                                                "sense_id": "f2557fb2-53f2-3e10-b55f-3899b348df0c",
                                                "text": "It also takes a good amount of inspiration from Metal Gear Solid 4s biomechanical designs, namely the Gekko walkers' and their synthetic musculature."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f55a5a9e-a61d-3452-a693-b97cd3813ac0",
                                        "entry_id": "0b140ea0-ee52-3062-9efa-ffd108a620af",
                                        "glosses": [
                                            "A batsman or batswoman who directly walks off the field when out without waiting for the umpire's decision."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8d142511-a6f2-38e9-bb76-fcf0f9ec589c",
                                        "entry_id": "0b140ea0-ee52-3062-9efa-ffd108a620af",
                                        "glosses": [
                                            "A prostitute, streetwalker."
                                        ],
                                        "tags": [
                                            "Philippines"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6682a93e-e029-4a4c-aa4f-2546e9e3a29e",
                                                "sense_id": "8d142511-a6f2-38e9-bb76-fcf0f9ec589c",
                                                "text": "A single mother of three, Rachel is what Facebook users call as ^([sic]) “walker,” or an online sex worker. Using a dummy account, she posts her sexy photos and informs page visitors that she’s available for sex in exchange for money."
                                            }
                                        ]
                                    }
                                ]
                            },
