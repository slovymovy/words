        {
            "pos": "preposition",
            "senses": [
                {
                    "sense_id": "f1cc3552-c273-38d9-89ba-9b1055d88804",
                    "sense_definition": "Op grond van; zoals volgt uit (voornamelijk gebruikt in juridische context).",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Ex</w> artikel 6:162 van het Burgerlijk Wetboek heb ik recht op schadevergoeding.",
                            "target_lang_translations": {
                                "en": "<w>Pursuant to</w> Article 6:162 of the Civil Code, I am entitled to compensation.",
                                "pl": "<w>Na podstawie</w> artykułu 6:162 Kodeksu cywilnego mam prawo do odszkodowania.",
                                "de": "<w>Gemäß</w> Artikel 6:162 des Bürgerlichen Gesetzbuches habe ich Anspruch auf Schadensersatz.",
                                "fr": "<w>En vertu de</w> l'article 6:162 du Code civil, j'ai droit à une indemnisation.",
                                "it": "<w>Ai sensi dell'</w>articolo 6:162 del Codice Civile, ho diritto al risarcimento danni.",
                                "cs": "<w>Podle</w> článku 6:162 občanského zákoníku mám nárok na odškodnění.",
                                "tr": "Medeni Kanun'un 6:162. maddesi <w>uyarınca</w> tazminat hakkım var.",
                                "es": "<w>Conforme al</w> artículo 6:162 del Código Civil, tengo derecho a una indemnización.",
                                "zh": "<w>根据</w>民法典第6:162条，我有权获得赔偿。"
                            }
                        },
                        {
                            "text": "De vordering wordt toegewezen <w>ex</w> het contract.",
                            "target_lang_translations": {
                                "en": "The claim is awarded <w>under</w> the contract.",
                                "pl": "Roszczenie zostaje uwzględnione <w>zgodnie z</w> umową.",
                                "de": "Der Anspruch wird <w>gemäß</w> dem Vertrag zugesprochen.",
                                "fr": "La demande est accordée <w>en vertu du</w> contrat.",
                                "it": "La richiesta viene accolta <w>in base al</w> contratto.",
                                "cs": "Nárok je přiznán <w>podle</w> smlouvy.",
                                "tr": "Talep, sözleşme <w>gereğince</w> kabul edilmiştir.",
                                "es": "La demanda es admitida <w>en virtud del</w> contrato.",
                                "zh": "该项索赔<w>依照</w>合同予以支持。"
                            }
                        }
