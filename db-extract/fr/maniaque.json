                                        "glosses": [
                                            "Having characteristics of a fad."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a63b7811-f3b7-3ccd-a404-f3772dcae750",
                                        "entry_id": "65a0d47f-4eef-3282-8c76-e0c2a2a3479f",
                                        "glosses": [
                                            "fussy, having particular tastes or whims"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "437c1c60-68f3-403b-a361-74981865e54a",
                                                "sense_id": "a63b7811-f3b7-3ccd-a404-f3772dcae750",
                                                "text": "He's a faddy eater."
                                            },
                                            {
                                                "example_id": "726616ad-8063-456c-a357-e5d1d6a7e394",
                                                "sense_id": "a63b7811-f3b7-3ccd-a404-f3772dcae750",
                                                "text": "In dress now, for example! We are faddy people, you know—faddy but kind-hearted. If you were asked to wear any dress which we might give you, you would not object to our little whim. Heh?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3c2fd252-900c-4498-9ad1-b1947754bb5b",
                        "source_entry_id": "fd7360a7-80f6-39dc-a9aa-c69f2cdf64c0",
                        "target_lang_word": "finicky",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "finicky",
