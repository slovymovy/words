                "senses": [
                    {
                        "sense_id": "53d65b18-c7d7-3019-9d07-3e81eaecdb5a",
                        "entry_id": "e5ec149d-59f6-3fa0-9694-6015c38236e1",
                        "glosses": [
                            "weibliche Person mit entsprechender Ausbildung, die Kranken oder Verletzten Erste Hilfe leistet oder sie wenn nötig zur weiteren Behandlung transportiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba6f336c-d2ac-42dd-8d23-abf3ed6480dd",
                                "sense_id": "53d65b18-c7d7-3019-9d07-3e81eaecdb5a",
                                "text": "Im Katastrophenfall kommen auch freiwillige Sanitäterinnen des Roten Kreuzes zum Einsatz."
                            },
                            {
                                "example_id": "391ee909-cc82-4a95-b5ba-4288c5e8e42d",
                                "sense_id": "53d65b18-c7d7-3019-9d07-3e81eaecdb5a",
                                "text": "„So fanden uns die Sanitäterinnen, die die Haustür aufbrechen mussten, da ich trotz ihres Klingelns und der Rufe nicht aufstehen konnte, um sie reinzulassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
