    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "b4191745-d116-30cf-bea0-5209178ed437",
                "word": "deontology",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "a445c2d7-f06b-4d90-9aeb-3187e599cdaa",
                        "entry_id": "b4191745-d116-30cf-bea0-5209178ed437",
                        "tags": [
