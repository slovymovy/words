                        ]
                    },
                    {
                        "translation_id": "304f9673-2fc7-4b4c-a6a0-0b866f4873a1",
                        "source_entry_id": "26b6f34d-1365-3449-9b3b-e73de1e892dd",
                        "target_lang_word": "dowager",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dowager",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e9c1c386-c923-3917-89de-2a01f7e639f2",
                                        "entry_id": "48382d42-a330-38ba-80d5-be686f23816d",
                                        "glosses": [
                                            "A widow holding property or title derived from her late husband."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe926e17-bc7e-47fc-9c25-2b33cead7b66",
                                                "sense_id": "e9c1c386-c923-3917-89de-2a01f7e639f2",
                                                "text": "A reclusive dowager owned the pastures across the river, and her farmhands ran beef cattle on them."
                                            },
                                            {
                                                "example_id": "121c7733-9b42-490f-b9ea-61c7ec9fae16",
                                                "sense_id": "e9c1c386-c923-3917-89de-2a01f7e639f2",
                                                "text": "“I don't mean all of your friends—only a small proportion—which, however, connects your circle with that deadly, idle, brainless bunch—the insolent chatterers at the opera, the gorged dowagers, the worn-out, passionless men, the enervated matrons of the summer capital, the chlorotic squatters on huge yachts,[…]!”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f311d14a-593a-38af-af61-3f72957753a2",
                                        "entry_id": "48382d42-a330-38ba-80d5-be686f23816d",
                                        "glosses": [
                                            "The widow of the holder of a title; used in combination with the title she held during her husband's lifetime."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4de46699-bd3e-4ddc-869f-ee4d67734b0c",
                                                "sense_id": "f311d14a-593a-38af-af61-3f72957753a2",
                                                "text": "the Earl and Countess of Whiteacre, and the Earl's mother, the dowager Countess of Whiteacre"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff78e014-2120-38e6-82cf-63426e931577",
                                        "entry_id": "48382d42-a330-38ba-80d5-be686f23816d",
                                        "glosses": [
                                            "Any lady of dignified bearing, especially an older one."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2e61fb6-1a73-4a90-bbc8-a6a21121d2e4",
                                                "sense_id": "ff78e014-2120-38e6-82cf-63426e931577",
                                                "text": "A stately dowager entered the ballroom, and all eyes were upon her."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
