                ],
                "senses": [
                    {
                        "sense_id": "622ebb2b-62e3-3279-9b5c-2329fb8fbd63",
                        "entry_id": "6c7e9fe8-3d9b-3d50-973c-f7b79ee93ff8",
                        "glosses": [
                            "im Monat August wehender, kräftiger Sturm"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f36ded6c-a513-400b-8209-43a33b4c6bac",
                                "sense_id": "622ebb2b-62e3-3279-9b5c-2329fb8fbd63",
                                "text": "„Nur das Heulen der Auguststürme ist zu hören.“"
                            },
                            {
                                "example_id": "a1919a8f-2de7-4c88-ba44-b29027ecdcbc",
                                "sense_id": "622ebb2b-62e3-3279-9b5c-2329fb8fbd63",
                                "text": "„Der Vater hatte an einem frühen Vormittag den kleinen Sohn mit an den Strand genommen, um nach Strandgut auszuschauen, das oft nach einem frühen Auguststurm, wie nach jeder großen Meeresbrandung, angespült wurde.“"
                            },
                            {
                                "example_id": "4010b3f3-1fe7-445c-bcb4-c70654b195f2",
                                "sense_id": "622ebb2b-62e3-3279-9b5c-2329fb8fbd63",
                                "text": "„Der Auguststurm, das fahle Licht und dazu die Schwüle beunruhigten Mensch und Tier.“"
                            },
                            {
                                "example_id": "b5e2628f-ee30-489d-970b-216821f35707",
                                "sense_id": "622ebb2b-62e3-3279-9b5c-2329fb8fbd63",
                                "text": "„Im Auguststurm 1500, der die Flotte im Indischen Ozean überraschte, wurden die Schiffe voneinander getrennt.“"
                            },
                            {
                                "example_id": "87d2c8e1-2d52-4436-b347-0f9fa38a9d4b",
                                "sense_id": "622ebb2b-62e3-3279-9b5c-2329fb8fbd63",
                                "text": "„Eine Insel in der Zone der Auguststürme wird also mehr Wahrscheinlichkeit aufweisen, von einem Sturm betroffen zu werden, als eine gleich große in der Zone der Oktoberorkane oder Juliorkane.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
