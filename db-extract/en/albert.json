                "senses": [
                    {
                        "sense_id": "27ddc43c-0d98-32ea-b31a-f25473b21546",
                        "entry_id": "e7b30ef7-95ac-35a7-8a38-452c3d43911a",
                        "glosses": [
                            "A male given name from the Germanic languages."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "8dcd016b-bd7d-4ee6-bbd2-a2043f0036b9",
                                "sense_id": "27ddc43c-0d98-32ea-b31a-f25473b21546",
                                "text": "Thou noble Father of her Kings to be - - - / Dear to thy land and ours, a Prince indeed, / Beyond all titles, and a household name, / Hereafter, thro' all times, Albert the Good."
                            },
                            {
                                "example_id": "fc63c05c-7ab6-495d-abf3-043abd0bff58",
                                "sense_id": "27ddc43c-0d98-32ea-b31a-f25473b21546",
                                "text": "Helena was not flattered. \"Albert just doesn't appreciate music,\" she said. They all called me Albert then. I thought it was a fine name; I like elegance."
                            },
                            {
                                "example_id": "5e658fbd-7cbd-497e-93ba-bbf5564612a9",
                                "sense_id": "27ddc43c-0d98-32ea-b31a-f25473b21546",
                                "text": "Hogan, Byrne, O'Brien. She stopped at one name. Albert Delahunty — what Catholic in their right mind would call a child Albert?"
                            }
                        ]
                    },
                    {
                        "sense_id": "dc4cb6e9-247e-3cf9-97c5-c9019a313b9b",
                        "entry_id": "e7b30ef7-95ac-35a7-8a38-452c3d43911a",
                        "glosses": [
                            "A surname originating as a patronymic."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "f84fa720-63c3-4718-b9c0-5b7a24b846b2",
                                "sense_id": "dc4cb6e9-247e-3cf9-97c5-c9019a313b9b",
                                "text": "Pass the chalk. Dr. Levine was there with a friend and fellow psychiatrist (detect a pattern?), Alexa Albert, Coco’s mother, who squinted up into the sun as her daughter effortlessly sailed skyward. Dr. Albert is an acrophobe."
                            }
                        ]
                    },
