                        "examples": [
                            {
                                "example_id": "300c4d02-0d7a-466b-92a9-d347977847b5",
                                "sense_id": "8dfc0d89-3257-32d9-8962-d756efe5255b",
                                "text": "„Sie ist Spiritistin und steht mit der Welt der Geister in Verbindung.“"
                            },
                            {
                                "example_id": "52b868bf-3391-447b-be60-1547eae7da39",
                                "sense_id": "8dfc0d89-3257-32d9-8962-d756efe5255b",
                                "text": "„Eine Ausstellung in Malmö zeigt das abstrakte Pionierwerk der schwedischen Spiritistin und Malerin Hilma af Klint.“"
                            }
                        ],
