                            "target_lang_translations": {
                                "ru": "Мы пошли на концерт, чтобы увидеть живое выступление <w>Lamb of God</w>.",
                                "zh": "我们去看音乐会，是为了现场看<w>Lamb of God</w>演出。"
                            }
                        },
                        {
                            "text": "The drummer for <w>Lamb of God</w> is known for his technical skill.",
                            "target_lang_translations": {
                                "ru": "Барабанщик <w>Lamb of God</w> известен своим техническим мастерством.",
                                "zh": "<w>Lamb of God</w>的鼓手以技术高超著称。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Американская грув-метал-группа.",
                        "zh": "美国的一支 groove metal 乐队 Lamb of God。"
                    },
                    "translations": {
