                        "source_sense_id": "0244bf16-fce2-386e-affa-2059f51d0558",
                        "source_sense_description": "plötzlich eintretende, heftige Überschwemmung",
                        "target_lang_word": "flash flood",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "flash flood",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d58546f7-9a77-3e99-969f-137b7fd9692d",
                                        "entry_id": "9be462dc-ff51-329e-989d-2b652f3a7c9d",
                                        "glosses": [
                                            "A sudden, rapid flood, usually of short duration and local impact."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "319dbf3a-58b3-49c7-bd4f-247890c3a669",
                                                "sense_id": "d58546f7-9a77-3e99-969f-137b7fd9692d",
                                                "text": "One of the most heavily hit regions was Germany’s Ahrweiler district, where flash floods surged through the village of Schuld, washing away six houses and leaving several more on the verge of collapse. The police said at least 50 people had died in Ahrweiler district."
                                            },
                                            {
                                                "example_id": "aa1a32d4-f815-488f-8760-81a5587a3418",
                                                "sense_id": "d58546f7-9a77-3e99-969f-137b7fd9692d",
                                                "text": "The West Highland Line reopened for passengers on July 11, following emergency repair works after more than 1,600 tons of material was washed away by a flash flood on June 25."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ac36d949-5c65-4772-adab-270025b7be89",
                        "source_entry_id": "f6259c29-5a26-3409-9013-84fa3c1efe1c",
                        "source_sense_id": "0244bf16-fce2-386e-affa-2059f51d0558",
                        "source_sense_description": "plötzlich eintretende, heftige Überschwemmung",
                        "target_lang_word": "stortvloed",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stortvloed",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "d6a80917-0bd4-3ecf-a091-54c7227d7cb4",
                                        "entry_id": "82b1226b-5a9c-3a42-8f4a-346fc017f988",
                                        "glosses": [
                                            "een (tijdelijke) situatie waarbij laaggelegen gebieden overstromen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "284e4db4-70a7-4635-9d47-87ffc0aec22b",
                                                "sense_id": "d6a80917-0bd4-3ecf-a091-54c7227d7cb4",
                                                "text": "Er was een stortvloed van water dat in één keer door het riool moest worden verwerkt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e713550-42a1-3bdd-9b16-ba877f91df7b",
                                        "entry_id": "82b1226b-5a9c-3a42-8f4a-346fc017f988",
                                        "glosses": [
                                            "sterke toevloed van iets"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "84d5003e-b853-49af-a2f4-d61654c1fe55",
                                                "sense_id": "0e713550-42a1-3bdd-9b16-ba877f91df7b",
                                                "text": "Door de uitverkoop was er een storvloed van op koopjes beluste klanten in de winkel."
                                            },
                                            {
                                                "example_id": "8da04613-baac-43da-8bf3-1a7927b89b1b",
                                                "sense_id": "0e713550-42a1-3bdd-9b16-ba877f91df7b",
                                                "text": "Bij alle verontrustende berichten uit de Verenigde Staten keerden de afgelopen weken mijn gedachten toch vaak terug naar de nieuwjaarstweet van minister Van der Steur en vooral naar de reacties die deze in de politie losmaakte. De minister bedankte de mannen en vrouwen die de voorafgaande nacht in dienst waren geweest en kreeg per omgaande de boodschap zijn mond te houden, gevolgd door een digitale stortvloed aan verwensingen. Hij leek flink geschrokken van alle op de werkvloer levende frustratie en onvrede."
                                            },
                                            {
                                                "example_id": "8466a1b7-dd05-45ff-8e9a-b84f4a695e58",
                                                "sense_id": "0e713550-42a1-3bdd-9b16-ba877f91df7b",
                                                "text": "Directeur Curtholmen leek ook ontevreden te zijn, omdat de stortvloed van beledigingen waarmee de tegenpartij hem had overladen niet weersproken zou worden."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
