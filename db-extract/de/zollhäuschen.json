                ],
                "senses": [
                    {
                        "sense_id": "d50617d7-4e4c-3592-a506-ce88e9097a51",
                        "entry_id": "925fc1cc-5da5-35d2-b4fe-f24a9c7bee63",
                        "glosses": [
                            "kleineres Zollhaus am Wegesrand, in dem ein Zöllner seinen Dienst versieht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44333d7e-f033-40c4-a31e-e3fb500ca9e3",
                                "sense_id": "d50617d7-4e4c-3592-a506-ce88e9097a51",
                                "text": "„Voller Stolz zeigt Mandy Hoffmann aus Nordhausen die Schlüssel vom Alten Zollhäuschen in der Parkallee.“"
                            },
                            {
                                "example_id": "273e95c1-7085-478b-ba57-f153ab0d3a2a",
                                "sense_id": "d50617d7-4e4c-3592-a506-ce88e9097a51",
                                "text": "„Am linken Bildrand erkennt man das alte Zollhäuschen, das ebenso wie das Trarbacher Brückentor die Sprengung der Brückenkonstruktion im Zweiten Weltkrieg überstanden hat.“"
                            },
                            {
                                "example_id": "d2e82981-8c2d-44fd-8531-c4241be51009",
                                "sense_id": "d50617d7-4e4c-3592-a506-ce88e9097a51",
                                "text": "„Das ist ein altes Zollhäuschen, welches noch bis etwa Mitte der neunziger Jahre benutzt wurde.“"
                            },
                            {
                                "example_id": "1745a954-a3b3-4443-aa4f-aeabd5d64040",
                                "sense_id": "d50617d7-4e4c-3592-a506-ce88e9097a51",
                                "text": "„Immer wieder entdeckt man im Jestetter Zipfel alte kleine Zollübergänge, die längst nicht mehr besetzt sind. Das Zollhäuschen beim Übergang Nack-Schild wurde inzwischen zum Holzlager umfunktioniert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
