                "senses": [
                    {
                        "sense_id": "c704e6fd-1515-3dae-b224-8cba2b28037f",
                        "entry_id": "6c88e0f6-2c92-3c6b-a592-946ce92e387a",
                        "glosses": [
                            "Celui qui fabrique des verres bombés."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "124eb18a-3e46-42a1-9cea-e62a154acab2",
                                "sense_id": "c704e6fd-1515-3dae-b224-8cba2b28037f",
                                "text": "Il menait vers des échoppes qui auraient pu illustrer un livre sur les petits métiers en voie de disparition : il y avait là un cordonnier, un bombeur de verre et peut-être un rémouleur."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "cc269e45-5ce9-3831-9da4-74a692688a71",
                "word": "bombeur",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "5d0edc1b-f126-4836-afc5-5641159ae543",
                        "entry_id": "cc269e45-5ce9-3831-9da4-74a692688a71",
                        "tags": [
                            "plural"
                        ],
                        "form": "bombeurs"
                    },
                    {
                        "form_id": "2d1ea80a-8ef2-4e81-9c06-46db0ed7978e",
                        "entry_id": "cc269e45-5ce9-3831-9da4-74a692688a71",
                        "tags": [
                            "feminine"
                        ],
                        "form": "bombeuse"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b3cb65d1-d62f-3fdc-b61b-56ead6a1faf9",
                        "entry_id": "cc269e45-5ce9-3831-9da4-74a692688a71",
                        "glosses": [
                            "Homme qui peint des tags."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82d48255-7d2e-4617-8cc7-535be2d46efe",
                                "sense_id": "b3cb65d1-d62f-3fdc-b61b-56ead6a1faf9",
                                "text": "Jean-Michel Basquiat, un « bombeur » haïtien, qui se trouva propulsé par ses graffiti sur portières de métro au firmament du show-business grâce au flair de quelques nez creux, avant de tomber dans le néant auquel, déjà, le promettait la nullité, Jean-Michel Basquiat, donc, y figurait par une œuvre bouleversante, succession de graffiti hagards […]."
                            },
                            {
                                "example_id": "68fd21d3-88e1-4ff5-aea4-ae7007246091",
                                "sense_id": "b3cb65d1-d62f-3fdc-b61b-56ead6a1faf9",
                                "text": "L'échec de la diffusion de ce message en dehors des limites géographiques et chronologiques indiquées montre que l'ensemble de la population des bombeurs corses n'a pas jugé pertinente sa reproduction."
                            },
                            {
                                "example_id": "4fa140ff-39cc-4572-a1e3-930ef8a802c2",
                                "sense_id": "b3cb65d1-d62f-3fdc-b61b-56ead6a1faf9",
                                "text": "Puis, c'est au tour des « bombeurs » de Bastia - Oliva, Christofari et Léoni. Déjà en prison depuis plusieurs mois pour de simples graffitis, ils écopent de peines de deux ans de prison avec sursis."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d4964ab6-37a5-4279-9d26-0aeef2c56881",
                        "source_entry_id": "cc269e45-5ce9-3831-9da4-74a692688a71",
                        "source_sense_id": "b3cb65d1-d62f-3fdc-b61b-56ead6a1faf9",
                        "target_lang_word": "Sprayer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sprayer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "196f998e-1c84-337e-ab2a-4fd8ae4c32f2",
                                        "entry_id": "4f3e481b-0e6d-3316-9fd1-957a5883cf6d",
                                        "glosses": [
                                            "jemand, der mit Sprühfarben Graffiti erstellt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb42dc0c-2241-4ba8-8a5f-4cca4637997e",
                                                "sense_id": "196f998e-1c84-337e-ab2a-4fd8ae4c32f2",
                                                "text": "Die Polizei hat in der Nacht einige jugendliche Sprayer auf frischer Tat ertappt."
                                            },
                                            {
                                                "example_id": "2764e28a-f680-4dbb-868e-276becec8b71",
                                                "sense_id": "196f998e-1c84-337e-ab2a-4fd8ae4c32f2",
                                                "text": "„Warum hat der philosophische Sprayer seinen Satz nicht vollendet?“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5f87e0ba-c36b-48ad-90cf-9112c3dedb4e",
                        "source_entry_id": "cc269e45-5ce9-3831-9da4-74a692688a71",
                        "source_sense_id": "b3cb65d1-d62f-3fdc-b61b-56ead6a1faf9",
