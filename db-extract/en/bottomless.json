                "forms": [],
                "senses": [
                    {
                        "sense_id": "cc554de7-45a0-3292-8fec-09cb9f9b84df",
                        "entry_id": "a664c6a8-9b20-32df-ae8d-dbe8c95a897f",
                        "glosses": [
                            "Having no bottom."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "cb20ba75-9ea6-4894-adfa-bf8086b577b1",
                                "sense_id": "cc554de7-45a0-3292-8fec-09cb9f9b84df",
                                "text": "The vast swamps of Southern Ontario proved a grim nightmare to the construction gangs. Treacherous and seemingly bottomless, the swamps swallowed thousands of tons of timber and debris, yet still afforded no firm surface on which the track could be laid."
                            },
                            {
                                "example_id": "96468232-2e5e-4850-a385-3970fcfac834",
                                "sense_id": "cc554de7-45a0-3292-8fec-09cb9f9b84df",
                                "text": "And while the railway's finances will forever remain a bottomless black hole, Highways England finances are rapidly becoming a bottomless pothole!"
                            }
                        ]
                    },
                    {
                        "sense_id": "1cca415b-dfbe-3a56-a5ec-1bfbdaa29698",
                        "entry_id": "a664c6a8-9b20-32df-ae8d-dbe8c95a897f",
