                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "crumple zone",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3d8edc4e-5577-34dc-b2db-87b64b679247",
                                        "entry_id": "e1309fd0-fd08-3d66-8fff-3d884f9225b5",
                                        "glosses": [
                                            "A structural feature of a vehicle designed to compress during an accident and absorb impact energy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ee83a19-ff6b-4724-b939-49ba43246241",
                                                "sense_id": "3d8edc4e-5577-34dc-b2db-87b64b679247",
                                                "text": "When Uff investigated Southall, the concept of crumple zones in rolling stock was slowly becoming established. He wrote: \"A particular design feature which has proved controversial is the introduction of 'crumple zones', as energy-absorbing measures at the end of coaches. This was opposed by some who considered that it represented a new hazard in view of the possibility of passengers being located within these zones.\" British Rail designed and built its HSTs before crumple zones became common."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
