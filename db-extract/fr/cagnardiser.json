                "senses": [
                    {
                        "sense_id": "8d3659d4-d849-3be4-b500-a86a109ed014",
                        "entry_id": "dce7ec27-2f4e-3fef-9bbd-dce24299d686",
                        "glosses": [
                            "Donner un caractère cagnard à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "faf5d186-77fc-446f-86d8-708c0aeeae8e",
                                "sense_id": "8d3659d4-d849-3be4-b500-a86a109ed014",
                                "text": "Et les ramasseurs de pêches et autres brugnons du côté de Vallabrègues, sous des bidonvilles de tôle, cagnardisés et avec des chèques d’Excideuil sur la banque d’Angoulême, ça t’a jamais dérangé, mon doulcet ?"
                            },
                            {
                                "example_id": "70384898-670a-4c62-8508-f063b37030d5",
                                "sense_id": "8d3659d4-d849-3be4-b500-a86a109ed014",
                                "text": "Quelques-unes de ces expressions donnent naissance à des verbes : balocher, cagnardiser, clampiner. fenasser, flemmarder, flemmardiser, lambiner, lanterner, lantiponner, musarder."
                            }
                        ]
                    }
