                "senses": [
                    {
                        "sense_id": "8d557e0a-6fb9-3862-b2ae-7c3d68ad72a0",
                        "entry_id": "dd769a97-7f23-3c95-bcd3-cab4cfe4b7f2",
                        "glosses": [
                            "weibliche Person, die als Dienerin in einem Hotel arbeitet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2e9aecd-8a4a-45f3-9905-53cadf814a24",
                                "sense_id": "8d557e0a-6fb9-3862-b2ae-7c3d68ad72a0",
                                "text": "„Davon abgesehen, wer hatte jemals von einer Hotelpagin gehört? Das war wirklich kein Job, um den sich eine der Frauen, die sie kannte, gerissen hätte.“"
                            },
                            {
                                "example_id": "5996c763-ce68-469c-b200-c03dce0084d3",
                                "sense_id": "8d557e0a-6fb9-3862-b2ae-7c3d68ad72a0",
                                "text": "„Als dann noch der eifersüchtige Ehemann Ronnie Obermeier und die Gattin des Ministers Paula Wiesinger auftauchen, die misstrauische Hotelmanagerin Renate Stern und die geschäftstüchtige Hotelpagin Uschi Graf immer wieder bei der Tür hereinplatzen, der Privatdetektiv Martin Meißner herumschnüffelt und die liebeshungrige Krankenschwester Berta auf der Bildfläche erscheint, geraten die Dinge gänzlich ‚außer Kontrolle‘.“"
                            },
                            {
                                "example_id": "d7fa2456-0c8a-40a6-bfe1-9a6cff996116",
                                "sense_id": "8d557e0a-6fb9-3862-b2ae-7c3d68ad72a0",
                                "text": "„Hinter den deckenhohen Holztäfelungen des ‚Vier Jahreszeiten‘ rumpelt leise ein geheimer Versorgungsaufzug, und zugleich springt nervös und zappelig eine Hotelpagin in den Raum.“"
                            },
                            {
                                "example_id": "f82d4290-3527-484e-93bb-40dbb4f40f3c",
                                "sense_id": "8d557e0a-6fb9-3862-b2ae-7c3d68ad72a0",
                                "text": "„Sacher Hotels zum Beispiel reisten mit einer Hotelpagin an, um im Herzen New Yorks Österreichs Gastfreundschaft zu präsentieren.“"
                            },
                            {
                                "example_id": "b29765e9-a2e0-4662-8e7f-781ad41aa83c",
                                "sense_id": "8d557e0a-6fb9-3862-b2ae-7c3d68ad72a0",
                                "text": "„Vor allem Erwachsenen Vergnügen bereiten werden einige schräge Nebenfiguren, wie z.B. die Hotelpagin Joy sowie einige Verweise auf Filmklassiker (z.B. auf Robert De Niro oder Hannibal Lecter aus ‚Das Schweigen der Lämmer‘).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
