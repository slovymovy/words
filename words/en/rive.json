                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "драть",
                                "target_lang_sense_clarification": "изготовление дранки или досок"
                            },
                            {
                                "target_lang_word": "раскалывать",
                                "target_lang_sense_clarification": "вдоль волокон древесины"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d94399be-28b0-396e-bca1-87a8da8d73a6",
                    "sense_definition": "To pierce or stab through something with a sharp weapon.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "pierce",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the tragic tale, the knight <w>rove</w> himself through with his own sword.",
                            "target_lang_translations": {
                                "ru": "В этой трагической истории рыцарь <w>пронзил</w> себя собственным мечом."
                            }
                        },
                        {
                            "text": "The warrior sought to <w>rive</w> his opponent with a single thrust of the blade.",
                            "target_lang_translations": {
                                "ru": "Воин стремился <w>проткнуть</w> противника одним ударом клинка."
                            }
