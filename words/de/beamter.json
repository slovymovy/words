                    "frequency": "Low",
                    "semantic_group_id": "wirtschaft",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In früheren Zeiten wurde ein kaufmännischer Angestellter bei einer Bank oft als <w>Beamter</w> bezeichnet."
                        },
                        {
                            "text": "Als leitender <w>Beamter</w> in der Industrie war er damals für die gesamte Buchhaltung verantwortlich."
