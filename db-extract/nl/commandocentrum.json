                ],
                "senses": [
                    {
                        "sense_id": "6f5e8a77-d1f1-3687-bce2-e5034f304a1a",
                        "entry_id": "6ad58cb1-af9b-3ddb-ae05-1bc37955595f",
                        "glosses": [
                            "de centrale plaats van waaruit men militaire operaties leidt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c01a736b-e685-4665-957f-8e74bf36263c",
                                "sense_id": "6f5e8a77-d1f1-3687-bce2-e5034f304a1a",
                                "text": "Er zouden geen burgers zijn omgekomen, enkel extremisten van IS. Het aantal doden schat de coalitie tussen de 145 en 150. Doelwit was een commandocentrum van IS bij het dorp al-Shafah. Dat ligt op de linkeroever van de rivier de Eufraat, niet ver van de grens met Irak."
                            },
                            {
                                "example_id": "e5d933f1-cf5f-4f40-a30c-5f31d31cab9e",
                                "sense_id": "6f5e8a77-d1f1-3687-bce2-e5034f304a1a",
                                "text": "Noord-Koreaanse speciale eenheden oefenden vorige maand op het infiltreren van doelen met paragliders. Ze deden dat volgens bronnen van het Zuid-Koreaanse staatspersbureau Yonhap op een oefenterrein waar het gezamenlijke commandocentrum van de VS en Zuid-Korea is nagebouwd."
                            }
                        ]
                    },
                    {
                        "sense_id": "f8b2bf9c-0d9f-3f2a-bf2b-1ae8208142ac",
                        "entry_id": "6ad58cb1-af9b-3ddb-ae05-1bc37955595f",
                        "glosses": [
                            "de centrale plaats van waaruit men niet-militaire operaties leidt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d0d395e-e524-43b6-9987-9d2b5b619f1b",
                                "sense_id": "f8b2bf9c-0d9f-3f2a-bf2b-1ae8208142ac",
                                "text": "Het lijkt erop dat de Turkse inlichtingendienst MIT een commandocentrum heeft in Den Haag. Dat blijkt uit een geheime bandopname, die suggereert dat Turkse spionnen in Nederland een hoofdrol spelen bij het opstellen van dodenlijsten."
                            },
                            {
                                "example_id": "435fe229-34a5-4789-9895-6dd0d27e54c9",
                                "sense_id": "f8b2bf9c-0d9f-3f2a-bf2b-1ae8208142ac",
                                "text": "De Amerikaanse media hadden het de voorbije dagen niet alleen over Kushner, maar ook over het plan van het Witte Huis een commandocentrum (’war room’) op te richten voor de strijd tegen de almaar toenemende vragen over de banden tussen de Russen en Trumps presidentiële campagne."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "95e9599c-dee9-49cc-ac62-7745c6093155",
                        "source_entry_id": "6ad58cb1-af9b-3ddb-ae05-1bc37955595f",
                        "source_sense_id": "6f5e8a77-d1f1-3687-bce2-e5034f304a1a",
                        "target_lang_word": "war room",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "war room",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "81cbd52c-2be8-3e36-bf18-2489228d5afa",
                                        "entry_id": "ae2612fa-9fa3-37a3-a8bd-59c412f2727b",
                                        "glosses": [
                                            "A single location which serves as the point of coordination for military activities."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e27ebaa7-bc76-4af2-a6dd-a2a1ac595fa7",
                                                "sense_id": "81cbd52c-2be8-3e36-bf18-2489228d5afa",
                                                "text": "Gentlemen, you can't fight in here! This is the War Room!"
                                            },
                                            {
                                                "example_id": "9c714881-0116-4f14-baa3-c5436ffa299e",
                                                "sense_id": "81cbd52c-2be8-3e36-bf18-2489228d5afa",
                                                "text": "But even without the battle, “Stormborn” is a far more exciting establishment episode than “Dragonstone.” It spends most of its time hopping back and forth among three different war rooms with a couple diversions to Oldtown and the Riverlands. And within those war rooms, “Stormborn” isn’t just taking things for granted or skipping to the point where all the characters are neatly sorted onto two sides."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "98c2a99d-1057-365d-819c-1107275ff270",
                                        "entry_id": "ae2612fa-9fa3-37a3-a8bd-59c412f2727b",
                                        "glosses": [
                                            "A single location from which any activity is directed."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa737ce5-4e05-4450-abc9-8f5a4408ed46",
                                                "sense_id": "98c2a99d-1057-365d-819c-1107275ff270",
                                                "text": "On election night, Trump campaign staff set up a war room in Trump’s office at Mar-a-Lago, poring over incoming returns as the candidate schmoozed in the club’s ballroom with Musk and UFC chief Dana White."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
