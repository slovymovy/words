                        "sense_id": "7e5fdcc8-206d-3354-a7a2-a1761ffe4883",
                        "entry_id": "3137adb3-5d96-333c-b5bb-7b9d9c32e6b5",
                        "glosses": [
                            "zonder arbeid"
                        ],
                        "tags": [],
