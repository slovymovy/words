                        "source_sense_id": "ceadbd2f-1b50-3f28-bc7f-d287ae7119df",
                        "source_sense_description": "iemand die (sier)aardewerk maakt voor zijn beroep",
                        "target_lang_word": "ceramicist",
                        "target_lang_code": "en",
