                            {
                                "example_id": "901f83d6-df7c-4de3-8a9b-39c4ab4a31b7",
                                "sense_id": "889dcb35-3413-39d3-9b66-10fe4109593e",
                                "text": "Precies vijfentwintig jaar geleden kwam het op de markt: WP 5.1, het succesvolste tekstverwerkingssysteem van WordPerfect. Het was de laatste WP-versie onder MS DOS, vóór de introductie van Windows, dat met Word veel meer mogelijkheden ging bieden dan tekstverwerken alleen. WP probeerde bij te blijven door halfslachtige imitaties op de markt te brengen, maar kwam de klap nooit te boven."
                            },
                            {
                                "example_id": "38be0559-2514-472f-b1d3-9cc4fb6c3e5b",
                                "sense_id": "889dcb35-3413-39d3-9b66-10fe4109593e",
                                "text": "Met de zelfgebouwde computer kunnen kinderen muziek schrijven, games ontwerpen, programmeren of gewoon tekstverwerken."
                            }
                        ]
                    }
