                "senses": [
                    {
                        "sense_id": "7ed767ef-4083-3e3b-b182-1f97bb974992",
                        "entry_id": "ee83f29e-4a7f-3272-bfe9-414b050d4dfe",
                        "glosses": [
                            "Klärung, Säuberung von Abwasser"
