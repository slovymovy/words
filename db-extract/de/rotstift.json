                ],
                "senses": [
                    {
                        "sense_id": "723d199f-a503-376c-983a-e74717ccd4e9",
                        "entry_id": "707c0146-3a93-315d-bcd1-f798d624a4f1",
                        "glosses": [
                            "rot schreibender Stift"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e2c48046-a437-4d40-9c03-5341703162c4",
                                "sense_id": "723d199f-a503-376c-983a-e74717ccd4e9",
                                "text": "Wir korrigieren mit einem Rotstift."
                            },
                            {
                                "example_id": "57cd4080-c676-4000-9af5-b43ceb1f41ca",
                                "sense_id": "723d199f-a503-376c-983a-e74717ccd4e9",
                                "text": "„Der Satz ist mit Rotstift durchgestrichen, ebenso das Kalenderblatt des Monats Mai.“"
                            },
                            {
                                "example_id": "1c2d2893-bff3-4884-b477-a8b6dac167dd",
                                "sense_id": "723d199f-a503-376c-983a-e74717ccd4e9",
                                "text": "„Er schrieb den Namen des Opfers mit Rotstift auf ein glänzendes Whiteboard.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e2992b20-1bea-3937-b1ce-86c1ff571a79",
                        "entry_id": "707c0146-3a93-315d-bcd1-f798d624a4f1",
                        "glosses": [
                            "Sparmaßnahmen"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "528b5f5c-a0a8-4bdb-96ab-59ab3679745e",
                                "sense_id": "e2992b20-1bea-3937-b1ce-86c1ff571a79",
                                "text": "„Will doch mal sehen, was so interessant und wichtig ist, dass es den Rotstift auf sich gezogen hat, denkt er.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
