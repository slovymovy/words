            "senses": [
                {
                    "sense_id": "8e2a51e2-71ec-3fb5-a891-b9f8c12d6fd2",
                    "sense_definition": "Extremely tiring; causing a complete loss of strength or energy.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After an <w>exhausting</w> day at work, she fell asleep immediately on the sofa.",
                            "target_lang_translations": {
                                "ru": "После <w>изнурительного</w> рабочего дня она сразу же уснула на диване."
                            }
                        },
                        {
                            "text": "Running a full marathon is an <w>exhausting</w> physical challenge that requires months of training.",
                            "target_lang_translations": {
                                "ru": "Бег на марафонскую дистанцию — это <w>выматывающее</w> физическое испытание, требующее месяцев тренировок."
                            }
                        }
                    ],
                    "synonyms": [
                        "tiring",
                        "draining",
                        "fatiguing",
                        "wearisome"
                    ],
                    "antonyms": [
                        "energizing",
                        "refreshing",
                        "invigorating"
                    ],
                    "common_phrases": [
                        "exhausting day",
                        "exhausting work",
                        "physically exhausting"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чрезвычайно утомляющий; вызывающий полную потерю сил или энергии."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "изнурительный",
                                "target_lang_sense_clarification": "крайне утомляющий, лишающий сил"
                            },
                            {
                                "target_lang_word": "утомительный",
                                "target_lang_sense_clarification": "вызывающий сильную усталость"
                            },
                            {
                                "target_lang_word": "выматывающий",
                                "target_lang_sense_clarification": "лишающий энергии, изматывающий"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d9d2bcda-7e4f-343a-a1e7-b1c503c1e154",
                    "sense_definition": "Present participle and gerund of <w>exhaust</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The long climb was <w>exhausting</w> our supply of fresh water much faster than we expected.",
                            "target_lang_translations": {
                                "ru": "Долгий подъем <w>истощал</w> наши запасы пресной воды гораздо быстрее, чем мы ожидали."
                            }
                        },
                        {
                            "text": "By <w>exhausting</w> all other possibilities, they finally arrived at the correct solution.",
                            "target_lang_translations": {
                                "ru": "Путем <w>исчерпания</w> всех остальных возможностей они наконец пришли к правильному решению."
                            }
                        }
                    ],
                    "traits": [
