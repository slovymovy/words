                            {
                                "example_id": "b3663baa-0815-492b-a64a-0abaf36299cb",
                                "sense_id": "c1e9b176-2b81-3e12-878b-751db0842097",
                                "text": "Erst um 14:30 Uhr findet die Kaffeepause statt."
                            },
                            {
                                "example_id": "91610da0-59e9-4116-9bba-9c3b28eb7829",
                                "sense_id": "c1e9b176-2b81-3e12-878b-751db0842097",
                                "text": "Er nutzt die Kaffeepause, um schnell zum Kiosk zu gehen und Zeitungen zu kaufen."
                            },
                            {
                                "example_id": "6d98d2db-6d5b-437f-a6df-095559928d6b",
                                "sense_id": "c1e9b176-2b81-3e12-878b-751db0842097",
                                "text": "„In der Kaffeepause erhielt Hoffman eine Nachricht vom Direktor, dass er ihn dringend wegen Frankfurt anrufen solle.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
