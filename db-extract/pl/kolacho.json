                ],
                "senses": [
                    {
                        "sense_id": "f1749ea5-047d-325d-bd6c-8886a3f2302f",
                        "entry_id": "243f5d4d-0ea3-3bcd-b945-3c7a503e6635",
                        "glosses": [
                            "augmentative of kolano (“knee”) (joint in the middle of the leg)"
                        ],
                        "tags": [
                            "augmentative",
                            "form-of",
                            "neuter",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "0e97d0f2-8718-434d-a630-9c3fbd799dc7",
                                "sense_id": "f1749ea5-047d-325d-bd6c-8886a3f2302f",
                                "text": "Zaczęły się przesłuchy. Pan preceptór siad[a]ł / Na swym tronie jak bożek, kolachy rozkładał / Jak jakie[ś] krókwie i nas wołał po kolei / Ku sobie między nogi, potem jak złodziei / Uchwycił nas w te kleszcze.",
                                "translation": "The questionings began. The précèptor sat / On his throne like an idol, spreading his knees / Like some ráfters and calling us one by one / Towards himself between his legs, then like thieves / He captured us in these ticks.",
                                "english": "The questionings began. The précèptor sat / On his throne like an idol, spreading his knees / Like some ráfters and calling us one by one / Towards himself between his legs, then like thieves / He captured us in these ticks."
                            }
                        ]
                    }
