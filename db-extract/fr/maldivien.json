                    }
                ],
                "senses": [
                    {
                        "sense_id": "38ee45ba-0724-3856-a803-d34eb1b10e03",
                        "entry_id": "40d1d6d6-01cf-3848-a0d7-7494dd073525",
                        "glosses": [
                            "Habitant ou originaire des Maldives."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56d2b477-45d9-4563-8a62-c5055d9a9ba7",
                                "sense_id": "38ee45ba-0724-3856-a803-d34eb1b10e03",
                                "text": "Les Maldiviens sont actifs et industrieux. Ils ne restent presque jamais oisifs ; ils sont ordinairement occupés à filer ou à teindre de la toile, à tresser du coïr (filasse du coco), à ramasser des cauris, ou à soigner leurs affaires domestiques."
                            },
                            {
                                "example_id": "d79f2ed5-cc46-4294-bfb7-8e875308288d",
                                "sense_id": "38ee45ba-0724-3856-a803-d34eb1b10e03",
                                "text": "Les étrangers et les Maldiviens ne se côtoient donc que dans la capitale, Malé, qui a joué de longue date le rôle d’interface avec l’extérieur, et dans l’atoll de Seenu, ouvert à l’Occident en 1956 par la création d’une base militaire britannique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "949ef9a3-410a-4a6c-a75a-6d3ec00523bb",
                        "source_entry_id": "40d1d6d6-01cf-3848-a0d7-7494dd073525",
