                                "target_lang_word": "неполный",
                                "target_lang_sense_clarification": "не весь целиком"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "部分的",
                                "target_lang_sense_clarification": "不完整的"
                            },
                            {
                                "target_lang_word": "不完全的",
                                "target_lang_sense_clarification": "非整体的"
                            }
                        ]
                    }
                },
                {
