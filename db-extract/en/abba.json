                "translations": [
                    {
                        "translation_id": "3898d247-ddfb-4a76-b3c5-2abcbbd572c3",
                        "source_entry_id": "958d31ec-29f4-34ef-9d5e-0e1a2746c064",
                        "source_sense_id": "6774fd18-c7fa-3026-941c-ba4b977742a9",
                        "source_sense_description": "Indisches Englisch, meist Anrede: männlicher Elternteil",
                        "target_lang_word": "Vater",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vater",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "311e5a08-772d-3056-b6de-2f44ca94c8a3",
                                        "entry_id": "c419316c-91b0-33b3-b167-3d0408add392",
                                        "glosses": [
                                            "männlicher Elternteil"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86687888-993b-4a79-ba25-06cd1ec1318f",
                                                "sense_id": "311e5a08-772d-3056-b6de-2f44ca94c8a3",
                                                "text": "Markus ist der Vater von Jaqueline."
                                            },
                                            {
                                                "example_id": "33d2f596-62a1-4a16-bf58-ddb1a5bc0f60",
                                                "sense_id": "311e5a08-772d-3056-b6de-2f44ca94c8a3",
                                                "text": "Herr Schmidt ist ein strenger, aber nicht unbedingt ein schlechter Vater."
                                            },
                                            {
                                                "example_id": "c7c9cd07-f1f0-45e6-92a2-1cdc324e3d53",
                                                "sense_id": "311e5a08-772d-3056-b6de-2f44ca94c8a3",
                                                "text": "In Deutschland können Väter bis zu zwölf Monate in Elternzeit gehen. Aber die wenigsten tun das."
                                            },
                                            {
                                                "example_id": "393d5727-8de2-49c7-8165-22dc7a3283e5",
                                                "sense_id": "311e5a08-772d-3056-b6de-2f44ca94c8a3",
                                                "text": "„Der Vater, ein Staatsbeamter namens Kurt Böhme, steht nicht zu dem Kind.“"
                                            },
                                            {
                                                "example_id": "907d93c1-5299-486e-96a1-f02e18a7cfa9",
                                                "sense_id": "311e5a08-772d-3056-b6de-2f44ca94c8a3",
                                                "text": "„Auf den ausgedehnten Jagdzügen, wie der Vater sie zur stillen Sorge von Mutter Lisbeth jetzt mit ihm unternahm, konnte er seine Büchse freilich nicht mitführen.“"
                                            },
                                            {
                                                "example_id": "9f090a21-a43f-4ca9-9dfd-1ad43f874831",
                                                "sense_id": "311e5a08-772d-3056-b6de-2f44ca94c8a3",
                                                "text": "„Einer der Geldgeber der Stolbergs war Hans Luder, der Vater des Reformators.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "843b9c5d-525d-3a7e-a764-4242c2cb31cc",
                                        "entry_id": "c419316c-91b0-33b3-b167-3d0408add392",
                                        "glosses": [
                                            "Leitperson"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a6fb27e-1152-4cc8-a569-ab9f7e5d39ed",
                                                "sense_id": "843b9c5d-525d-3a7e-a764-4242c2cb31cc",
                                                "text": "Vater Staat wird es schon richten."
                                            },
                                            {
                                                "example_id": "39eba385-08f5-4af7-9186-0ff2e6f3c942",
                                                "sense_id": "843b9c5d-525d-3a7e-a764-4242c2cb31cc",
                                                "text": "Einer der Väter des Euros war der Belgier Luc Luycx. Er wurde als der Designer der Euro-Münzen bekannt."
                                            },
                                            {
                                                "example_id": "5cb719c1-6306-410b-b69d-4f9764d00aab",
                                                "sense_id": "843b9c5d-525d-3a7e-a764-4242c2cb31cc",
                                                "text": "„Er war der Vater der Atombombe – der Physiker Robert Oppenheimer.“"
                                            },
                                            {
                                                "example_id": "0952d4f0-2cbb-43a8-8ceb-40a8943bddb0",
                                                "sense_id": "843b9c5d-525d-3a7e-a764-4242c2cb31cc",
                                                "text": "„Als Vater der pakistanischen Atombombe wird A.Q. Khan heute nach wie vor von großen Teilen der Bevölkerung, insbesondere in den Reihen des Militärs und der Jugend, verehrt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "a0ac6641-c81a-36c2-a634-620b8fd6af1a",
                                        "entry_id": "c419316c-91b0-33b3-b167-3d0408add392",
                                        "glosses": [
                                            "Partner der Mutter bei der Zeugung von Nachwuchs"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "924defaa-dbec-4d28-9f9e-235021cbba27",
                                                "sense_id": "a0ac6641-c81a-36c2-a634-620b8fd6af1a",
                                                "text": "Dieser Hengst ist der Vater dutzender erfolgreicher Rennpferde."
                                            },
                                            {
                                                "example_id": "cd9df480-18dc-4636-9fba-999552b814d5",
                                                "sense_id": "a0ac6641-c81a-36c2-a634-620b8fd6af1a",
                                                "text": "Diese [zweite Zelle] wird dann mit den Spermien des Vaters befruchtet und in die Gebärmutter der ersten, [genetisch] kranken, Frau eingesetzt – wie bei künstlicher Befruchtung üblich."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "0ef05859-95cf-35e3-be68-e617b43dd367",
                                        "entry_id": "c419316c-91b0-33b3-b167-3d0408add392",
                                        "glosses": [
                                            "(Titel oder Anrede für) Geistliche"
                                        ],
                                        "tags": [
                                            "Ecclesiastical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "49f2a028-929a-466f-9599-e0b5d709d8ef",
                                                "sense_id": "0ef05859-95cf-35e3-be68-e617b43dd367",
                                                "text": "Der Vater Prior wartet am rechten Ausgang."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "3dc35c89-bb11-3f05-86a8-658fc873cc3a",
                                        "entry_id": "c419316c-91b0-33b3-b167-3d0408add392",
                                        "glosses": [
                                            "(Umschreibung für) Gott"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d633beb5-d567-4d5c-bc66-43af579edf34",
                                                "sense_id": "3dc35c89-bb11-3f05-86a8-658fc873cc3a",
                                                "text": "Gott Vater, höre unsere Bitte."
                                            },
                                            {
                                                "example_id": "7145c5a2-94bb-425a-95ea-c80514de8a0f",
                                                "sense_id": "3dc35c89-bb11-3f05-86a8-658fc873cc3a",
                                                "text": "Das Vaterunser (Gebet): „Vater unser im Himmel - geheiligt werde Dein Name. - Dein Reich komme - …“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "a186c87e-ccf1-3713-adcb-93765919c430",
                                        "entry_id": "c419316c-91b0-33b3-b167-3d0408add392",
                                        "glosses": [
                                            "die Ahnen"
                                        ],
                                        "tags": [
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c0b9948f-1aee-4eef-aa9d-fd18fd4bf379",
                                                "sense_id": "a186c87e-ccf1-3713-adcb-93765919c430",
                                                "text": "Das schwöre ich bei der Asche unserer Väter."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f2fc7a12-725d-407c-8ca9-70dce3ce219a",
                        "source_entry_id": "958d31ec-29f4-34ef-9d5e-0e1a2746c064",
                        "source_sense_id": "6774fd18-c7fa-3026-941c-ba4b977742a9",
                        "source_sense_description": "Indisches Englisch, meist Anrede: männlicher Elternteil",
                        "target_lang_word": "Papa",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Papa",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ede62bd5-7374-38a6-a016-25e186691a96",
                                        "entry_id": "f48fc359-ce68-35b3-a560-53dd3ef8fcda",
                                        "glosses": [
                                            "Kosewort zu Vater (als Anrede nur für den eigenen Vater)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39527a6d-9106-41ea-bf2d-2c291ca01410",
                                                "sense_id": "ede62bd5-7374-38a6-a016-25e186691a96",
                                                "text": "Mein Papa hat immer recht."
                                            },
                                            {
                                                "example_id": "27a73e47-6cfc-491f-82ca-e6fc89cb41d5",
                                                "sense_id": "ede62bd5-7374-38a6-a016-25e186691a96",
                                                "text": "„Er schaute Papa an, als müsste er erst lange begreifen, was Papa gerade gesagt hatte.“"
                                            },
                                            {
                                                "example_id": "3b6cb0e9-f092-4a32-86c8-688148fe6c2f",
                                                "sense_id": "ede62bd5-7374-38a6-a016-25e186691a96",
                                                "text": "„Mir Fünfjährigem war erzählt worden, ich dürfe eine lange Zugfahrt mit meinem Vater unternehmen, und was sollte sich ein Junge mehr wünschen, als endlich einmal mit seinem Papa, den er so selten sah, zu verreisen?“"
                                            },
                                            {
                                                "example_id": "c8169659-7f08-4bae-b392-484c7783dfc2",
                                                "sense_id": "ede62bd5-7374-38a6-a016-25e186691a96",
                                                "text": "„Papa wäre damals bei den Nazis auch mal fast dran gewesen.“"
                                            },
                                            {
                                                "example_id": "f9bb781a-ca26-4528-ac9b-7062886f7306",
