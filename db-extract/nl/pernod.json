                        "sense_id": "2cc8907e-49b8-30f4-ab71-d2b6f029c3b1",
                        "entry_id": "82a1a560-f7a5-3244-aa1a-40a830d08428",
                        "glosses": [
                            "Franse anijsdrank"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e8f8c5f-8745-495c-b433-b406fb86d4be",
                                "sense_id": "2cc8907e-49b8-30f4-ab71-d2b6f029c3b1",
                                "text": "Pak een andere steelpan, doe hier de slakken in (zonder huisje). Voeg de pernod en sojasaus toe en breng langzaam aan de kook."
                            },
                            {
                                "example_id": "5d7fd1c8-cdc0-453c-a71c-80836d645dba",
                                "sense_id": "2cc8907e-49b8-30f4-ab71-d2b6f029c3b1",
                                "text": "De getrancheerde coquilles liggen op een even mooi als smakelijk taartje van precies beetgare linzen, de langoustines zijn voorbeeldig gegaard en hebben het aangename Franse vakantiearoma van Pernod. Een feest."
                            },
                            {
                                "example_id": "4f187f78-7ba6-4978-a738-babf73f12a26",
                                "sense_id": "2cc8907e-49b8-30f4-ab71-d2b6f029c3b1",
                                "text": "Wanneer een Fransman een lang betoog houdt, kun je gerust een dienblad op zijn hand zetten en drie Pernod inschenken. Na het ‘parce-que’ volgt een soort zangerig gebrom/rommelend geluid, dat mensen die het Frans niet machtig zijn imiteren wanneer ze doen alsof ze Frans spreken."
                            }
                        ]
                    }
