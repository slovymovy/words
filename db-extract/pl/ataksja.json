                "senses": [
                    {
                        "sense_id": "dd8c275f-14f8-35fd-8ef1-4d7ec864366e",
                        "entry_id": "0f92efb7-18d4-3530-9f11-02fc1873cac6",
                        "glosses": [
                            "zaburzenie koordynacji ruchów"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73f18c6d-b6a0-4a1e-a7d6-c62b766ae25f",
                                "sense_id": "dd8c275f-14f8-35fd-8ef1-4d7ec864366e",
                                "text": "Osoba z ataksją ma problemy z precyzyjnym wykonywaniem ruchów, utrzymaniem równowagi i stabilną postawą."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "376cbcb7-3d42-47e8-a233-76d0b97f3451",
                        "source_entry_id": "0f92efb7-18d4-3530-9f11-02fc1873cac6",
                        "source_sense_id": "dd8c275f-14f8-35fd-8ef1-4d7ec864366e",
                        "target_lang_word": "ataxia",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ataxia",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e8f76f96-5895-34cf-baa1-ea20bdc90d10",
                                        "entry_id": "060732d9-2e54-3f36-a626-31f6f7d704d0",
                                        "glosses": [
                                            "Lack of coordination while performing voluntary movements, which may appear to be clumsiness, inaccuracy, or instability."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb5a2096-a206-4431-8caf-d93b70fa0cb8",
                                                "sense_id": "e8f76f96-5895-34cf-baa1-ea20bdc90d10",
                                                "text": "Cerebellar dysfunction is characterized by truncal ataxia, a broad-based stance, dysmetria in which the limbs either overstep (hypermetria) or understep (hypometria), and tremor that is most pronounced when the animal attempts a goal-orientated movement (intention tremor)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6c29f33a-4433-3465-9aa5-852fc85eba9c",
                                        "entry_id": "060732d9-2e54-3f36-a626-31f6f7d704d0",
                                        "glosses": [
                                            "The condition of a polymer in which the orientation of the subunits is random"
                                        ],
                                        "tags": [
                                            "countable",
                                            "physical",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "35341fbf-4b20-3e1d-9ee9-aed5991c3093",
                                        "entry_id": "060732d9-2e54-3f36-a626-31f6f7d704d0",
                                        "glosses": [
                                            "Disorder; irregularity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c47dfcb2-28aa-4171-8794-2035a22119a0",
                                                "sense_id": "35341fbf-4b20-3e1d-9ee9-aed5991c3093",
                                                "text": "1569, John Leslie, A Defence of the Honour of the Right Highe, Mightye and Noble Princesse Marie Quene of Scotlande, Rheims, Book 3,\nYe frame an other argumente of inconueniences, as thowghe vnder the womans regimente, Ataxia, that ys to saye disorder moste commonlye creapethe in."
                                            },
                                            {
                                                "example_id": "83271d86-f890-42d9-9281-f9902afd2670",
                                                "sense_id": "35341fbf-4b20-3e1d-9ee9-aed5991c3093",
                                                "text": "1614, Thomas Adams, The Devills Banket, London: Ralph Mab, The Second Service, Sermon 2, p. 51,\nLet not Gods eutaxie, Order, by our friuolous scruples be brought to ataxie, Confusion."
                                            },
                                            {
                                                "example_id": "c458041c-dc47-49d5-b743-141aa41f5021",
                                                "sense_id": "35341fbf-4b20-3e1d-9ee9-aed5991c3093",
                                                "text": "Neither is there any Ataxie to bee feared in bringing in this distinction, betwixt Pastors and flock; It is an Eutaxie rather:"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
