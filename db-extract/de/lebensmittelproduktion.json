                "senses": [
                    {
                        "sense_id": "80bf8b30-642b-3031-bfb7-48254a7c6adc",
                        "entry_id": "abee968a-8eaa-333d-a750-fd6a9608e601",
                        "glosses": [
                            "Produktion von Lebensmitteln"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d7d84073-f090-44de-b62e-a167dea0025e",
                                "sense_id": "80bf8b30-642b-3031-bfb7-48254a7c6adc",
                                "text": "„Der Klimawandel stellt eine große Gefahr für die Lebensmittelproduktion dar.“"
                            },
                            {
                                "example_id": "8088bb4e-a9d2-4bd4-9bac-4327c5b5f70f",
                                "sense_id": "80bf8b30-642b-3031-bfb7-48254a7c6adc",
                                "text": "„Gemeinsam mit Russland stellt die Ukraine etwa beim für die Lebensmittelproduktion besonders wichtigen Weizen knapp ein Drittel des gesamten Angebots auf dem Weltmarkt.“"
                            },
                            {
                                "example_id": "954c6fca-27fa-4577-8094-d67aa40d0ceb",
                                "sense_id": "80bf8b30-642b-3031-bfb7-48254a7c6adc",
                                "text": "„Bald brach neben dem kommerziellen Farmsektor, dem wichtigsten Devisenbringer des Landes, auch die Lebensmittelproduktion zusammen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
