                                        "entry_id": "9503f59d-5ed5-3bc7-ada1-729e00ce01d0",
                                        "glosses": [
                                            "A male given name from Latin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e367e676-4185-490c-bce3-58a82358b920",
                                                "sense_id": "edd3bde0-9ce5-3be7-b325-b569215bd56d",
                                                "text": "Of the you're-going-to-get-it-anyway faction was a young Australian on board by the name, so help me, of Vivian Nankervis. - - - And he was beautiful, even with a name like Vivian; moreover, he had never been ill a day in his life."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d7fa1cb9-dd13-302e-9deb-2414cf2ea67d",
                                        "entry_id": "9503f59d-5ed5-3bc7-ada1-729e00ce01d0",
                                        "glosses": [
                                            "A female given name from Latin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e9ec14b-944d-4015-b557-f5db40a79291",
                                                "sense_id": "d7fa1cb9-dd13-302e-9deb-2414cf2ea67d",
                                                "text": "'What's your name?' 'Vivian.' 'Isn't that one of the names that mean something?' She said, 'It means my mother used to go to the movies.'"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c2844223-bae5-3507-9722-361c2ae0fc79",
                                        "entry_id": "9503f59d-5ed5-3bc7-ada1-729e00ce01d0",
                                        "glosses": [
                                            "A surname originating as a patronymic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a42b0b4a-8a23-49ad-a33a-eb2f8e31a8a7",
                                                "sense_id": "c2844223-bae5-3507-9722-361c2ae0fc79",
                                                "text": "\"Mr. Grey,\" asked her ladyship, \"are you of Dorsetshire?\" \"My mother is a Dorsetshire woman; her family name is Vivian, which name I also bear - Sir Hargrave Vivian, of Chester Grange.\""
                                            }
                                        ]
                                    }
                                ]
