                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f3ca446-6d82-45cf-b635-ccfa132e1bb7",
                                "sense_id": "e75265da-bebc-3b47-91db-a3c817f0269b",
                                "text": "„Neben ihm befand sich eine dunkle Gestalt, die schlichtweg alles hätte sein können. Ein Fleck auf dem Negativ, ein Tintenklecks, ein Schatten.“"
                            },
                            {
                                "example_id": "a7fb73ba-e062-4123-8ae8-93094fec6620",
                                "sense_id": "e75265da-bebc-3b47-91db-a3c817f0269b",
                                "text": "„Der Brief war in großer Eile geschrieben worden; man sieht Tintenkleckse; die Schrift wirkt krakelig.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
