                                    {
                                        "sense_id": "6cd74b03-c0a0-3586-9941-2b8489fa023f",
                                        "entry_id": "c15a152c-688b-3dd1-95ed-6d3338bed9b3",
                                        "glosses": [
                                            "A curated list of games",
                                            "A list of the games mentioned in a publication"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce79e3ba-5e6f-4071-b48a-ad185d1936c3",
                                                "sense_id": "6cd74b03-c0a0-3586-9941-2b8489fa023f",
                                                "text": "Examples are drawn from a range of games, both digital and non-digital—from Bioshock and World of Warcraft to Monopoly—and the book provides a variety of exercises and sample analyses, as well as a comprehensive ludography and glossary."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eabeabc2-7f68-3d80-aaa4-aea58ad504f6",
                                        "entry_id": "c15a152c-688b-3dd1-95ed-6d3338bed9b3",
                                        "glosses": [
                                            "A curated list of games",
                                            "The oeuvre of a game designer"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7a8cc7b-3850-42d8-8dbb-18def7e5502e",
                                                "sense_id": "eabeabc2-7f68-3d80-aaa4-aea58ad504f6",
                                                "text": "Some very specific obsessions recur throughout his ludography: themes involving the subconscious, the nature of the mind, and the manipulated hero."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "40442f9e-bbe6-3ed1-9229-fbe33ea47f89",
                                        "entry_id": "c15a152c-688b-3dd1-95ed-6d3338bed9b3",
                                        "glosses": [
                                            "A curated list of games",
                                            "a list of all the board games a designer created."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce30f7ed-1d14-4d15-9e6e-430aab7a6ab1",
                                                "sense_id": "40442f9e-bbe6-3ed1-9229-fbe33ea47f89",
                                                "text": "In 2021, among other things, the revised CATAN 3D Edition was published. Other exciting titles are currently in the works and will then be included in the ludography here."
                                            }
                                        ]
                                    }
