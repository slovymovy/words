                                    },
                                    {
                                        "sense_id": "a63c0483-ce3f-36df-82eb-1097cf3f73b9",
                                        "entry_id": "2ad157e4-bdff-3adb-b97a-21d106d623f1",
                                        "glosses": [
                                            "Konstruktion auf chemischer oder physikalischer Basis, die gewisse Stoffe entfernt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e11809b-9fa6-4ac5-8107-173b1d6e1de3",
                                                "sense_id": "a63c0483-ce3f-36df-82eb-1097cf3f73b9",
                                                "text": "„Die Verbrennungsprodukte passieren eine Ekonomisergruppe und gelangen dann in die eigentliche Waschanlage, die aus zwei Teilen besteht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
