                ],
                "senses": [
                    {
                        "sense_id": "2b2f500b-e2a3-3de6-8839-5608308c80f3",
                        "entry_id": "258636bb-6f73-3731-b97e-8a885c6a2103",
                        "glosses": [
                            "das Füttern und Aufziehen von zum Schlachten vorgesehener Schweine"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f557a58-f8aa-4025-bd2c-b8fd49ab9d56",
                                "sense_id": "2b2f500b-e2a3-3de6-8839-5608308c80f3",
                                "text": "„Die in vielen Westerwälder Ortschaften gängige Praxis der Schweinemast in den Wäldern wurde auch in Dierdorf praktiziert.“"
                            },
                            {
                                "example_id": "9b03f7ca-3c97-4b39-9466-547636f907ff",
                                "sense_id": "2b2f500b-e2a3-3de6-8839-5608308c80f3",
                                "text": "„Für die Aufzucht des Jungviehes ist die Buttermilch weniger geeignet, dagegen läßt sie sich mit Erfolg als eiweißreiches Beifutter bei der Schweinemast verwenden.“"
                            },
                            {
                                "example_id": "bf028a71-f83a-45b9-ae97-94bf2578fbc9",
                                "sense_id": "2b2f500b-e2a3-3de6-8839-5608308c80f3",
                                "text": "„Neben der Schweinemast arbeitet er in einem Amt zur Kontrolle von Stallbau‐ und Flächenförderungen, was der Tätigkeit als Landwirt nahesteht.“"
                            },
                            {
                                "example_id": "42f7d6e3-82da-45a8-8e0e-def668b76baf",
                                "sense_id": "2b2f500b-e2a3-3de6-8839-5608308c80f3",
                                "text": "„Hinten in Schwabhofen hatte ein Bauer vor ein paar Jahren eine große Schweinemast aufgemacht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
