            {
                "entry_id": "651841e2-898d-3aef-a837-58eb734e0cb8",
                "word": "DRAC",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d60972df-d8b5-3039-be45-0b91482b1161",
                        "entry_id": "651841e2-898d-3aef-a837-58eb734e0cb8",
                        "glosses": [
                            "En France, Direction régionale des affaires culturelles, en charge de la culture dans la région."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cdf1fa80-9b41-49c5-afb1-7c6d6f965c1a",
                                "sense_id": "d60972df-d8b5-3039-be45-0b91482b1161",
                                "text": "C’est à présent l’accès à la collection du musée qui se voit offrir une nouvelle ambiance graphique plus lisible et plus facile d’utilisation, grâce au soutien de la DRAC Île-de-France et de la Métropole du Grand Paris."
                            },
                            {
                                "example_id": "7b03f732-d237-4daa-b80b-59b843e6f1b1",
                                "sense_id": "d60972df-d8b5-3039-be45-0b91482b1161",
                                "text": "Fort du succès recueilli, la DRAC va tenter de développer cette expérience, en mobilisant les partenaires locaux."
                            },
                            {
                                "example_id": "c886b9b7-1295-43bd-8c9b-aa7ee43017c3",
                                "sense_id": "d60972df-d8b5-3039-be45-0b91482b1161",
                                "text": "Le siège de la DRAC est au chef-lieu de région sauf en Normandie où il est à Caen et en Occitanie où il est à Montpellier."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
