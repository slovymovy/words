{
    "word_family": [
        "allegation",
        "alleged",
        "allegedly"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "696589ef-2bf9-3b67-b17a-496f9ce21524",
                    "sense_definition": "To assert that someone has done something illegal or wrong, typically without proof.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "assertion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The prosecution will <w>allege</w> that the defendant was at the scene of the crime.",
                            "target_lang_translations": {
                                "ru": "Обвинение будет <w>утверждать</w>, что подсудимый находился на месте преступления."
                            }
                        },
                        {
                            "text": "Several witnesses <w>allege</w> misconduct by the local officials during the recent election.",
                            "target_lang_translations": {
                                "ru": "Несколько свидетелей <w>заявляют</w> о нарушениях со стороны местных чиновников во время недавних выборов."
                            }
                        }
                    ],
                    "synonyms": [
                        "assert",
                        "claim",
                        "maintain"
                    ],
                    "antonyms": [
                        "deny",
                        "disprove"
                    ],
                    "common_phrases": [
                        "allege misconduct",
                        "allege fraud"
                    ],
                    "target_lang_definitions": {
                        "ru": "Утверждать, что кто-то совершил незаконное или неправильное действие, обычно без предоставления доказательств."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "утверждать",
                                "target_lang_sense_clarification": "заявлять без доказательств"
                            },
                            {
                                "target_lang_word": "голословно утверждать",
                                "target_lang_sense_clarification": "делать заявление без фактов"
                            },
                            {
                                "target_lang_word": "вменять",
                                "target_lang_sense_clarification": "приписывать вину"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6124e728-bda6-3b7f-ad50-7a8a014be9b7",
                    "sense_definition": "To state a fact or make a plea under oath in a court of law.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "legal_statement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The defense intends to <w>allege</w> that the evidence was obtained through illegal means.",
                            "target_lang_translations": {
                                "ru": "Защита намерена <w>заявить</w>, что улики были получены незаконным путем."
                            }
                        },
                        {
                            "text": "In his formal statement, he will <w>allege</w> a violation of his civil rights.",
                            "target_lang_translations": {
                                "ru": "В своем официальном заявлении он <w>укажет</w> на нарушение своих гражданских прав."
                            }
                        }
                    ],
                    "synonyms": [
                        "plead",
                        "testify"
                    ],
                    "common_phrases": [
                        "allege a violation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заявлять о факте или подавать ходатайство под присягой в суде."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заявлять под присягой",
                                "target_lang_sense_clarification": "официальное показание в суде"
                            },
                            {
                                "target_lang_word": "свидетельствовать",
                                "target_lang_sense_clarification": "давать показания"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "063226b1-28dd-3df4-b181-37cf7bb3e322",
                    "sense_definition": "To bring forward something as a reason, excuse, or support for an argument.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "assertion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lawyer will <w>allege</w> several reasons for the delay in filing the paperwork.",
                            "target_lang_translations": {
                                "ru": "Адвокат <w>приведет</w> несколько причин задержки подачи документов."
                            }
                        },
                        {
                            "text": "It is common for defendants to <w>allege</w> ignorance of the law as a primary excuse.",
                            "target_lang_translations": {
                                "ru": "Для подсудимых обычно <w>ссылаться</w> на незнание закона в качестве основного оправдания."
                            }
                        }
                    ],
                    "synonyms": [
                        "adduce",
                        "cite"
                    ],
                    "common_phrases": [
                        "allege a reason"
                    ],
                    "target_lang_definitions": {
                        "ru": "Приводить что-либо в качестве причины, оправдания или аргумента."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ссылаться",
                                "target_lang_sense_clarification": "приводить в качестве оправдания"
                            },
                            {
                                "target_lang_word": "приводить",
                                "target_lang_sense_clarification": "выдвигать аргумент или причину"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "54874c2e-10b4-33b5-a189-910cb5bf6462",
                    "sense_definition": "To cite or quote an author or their work to support or oppose an argument.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "citation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scholar chose to <w>allege</w> ancient texts to support his controversial theory.",
                            "target_lang_translations": {
                                "ru": "Ученый решил <w>процитировать</w> древние тексты в поддержку своей спорной теории."
                            }
                        },
                        {
                            "text": "In her thesis, she will <w>allege</w> the works of various philosophers to prove her point.",
                            "target_lang_translations": {
                                "ru": "В своей диссертации она будет <w>ссылаться</w> на труды различных философов, чтобы доказать свою точку зрения."
                            }
                        }
                    ],
                    "synonyms": [
                        "cite",
                        "quote"
                    ],
                    "target_lang_definitions": {
                        "ru": "Цитировать автора или его работу для поддержки или опровержения аргумента."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "цитировать",
                                "target_lang_sense_clarification": "приводить слова автора"
                            },
                            {
                                "target_lang_word": "ссылаться",
                                "target_lang_sense_clarification": "упоминать источник"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7bbd0ab9-c15b-369f-b1c8-d3b0ac49c6c6",
                    "sense_definition": "To lighten, diminish, or alleviate pain or a burden.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "alleviation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The medicine was intended to <w>allege</w> his suffering after the long surgery.",
                            "target_lang_translations": {
                                "ru": "Лекарство было предназначено для того, чтобы <w>облегчить</w> его страдания после долгой операции."
                            }
                        },
                        {
                            "text": "She hoped that the kind words would <w>allege</w> the grief felt by the family.",
                            "target_lang_translations": {
                                "ru": "Она надеялась, что добрые слова <w>смягчат</w> горе, испытываемое семьей."
                            }
                        }
                    ],
                    "synonyms": [
                        "alleviate",
                        "assuage",
                        "mitigate"
                    ],
                    "antonyms": [
                        "aggravate",
                        "exacerbate"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in older literature"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Облегчать, уменьшать или смягчать боль или бремя (устаревшее)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "облегчать",
                                "target_lang_sense_clarification": "уменьшать страдания"
                            },
                            {
                                "target_lang_word": "смягчать",
                                "target_lang_sense_clarification": "делать боль менее острой"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}