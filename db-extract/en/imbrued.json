                    {
                        "sense_id": "1de64436-1f4d-3bb0-86c7-c49d6fe4ef0b",
                        "entry_id": "437d421e-9e8f-3e62-87a8-59f327959c0e",
                        "glosses": [
                            "Stained with blood; wounded, bloody."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "260cbe21-4352-4e3e-bb58-cd347bad1831",
                                "sense_id": "1de64436-1f4d-3bb0-86c7-c49d6fe4ef0b",
                                "text": "Whereas she found the Goddesse with her crew, / After late chace of their embrewed game, / Sitting beside a fountaine in a rew [...]."
                            },
                            {
                                "example_id": "ec1dd836-3a0a-4b32-a96b-7eee8dfedadd",
                                "sense_id": "1de64436-1f4d-3bb0-86c7-c49d6fe4ef0b",
                                "text": "He had a sense of his mind, which had been made up, falling to pieces again; but that sense in turn lost itself in a shudder which was already familiar—the horror of the public reappearance, on his part, of the imbrued hands of his mother."
                            }
                        ]
                    },
                    {
                        "sense_id": "0efefad8-0ca1-3aac-8fd1-c05bcb6e2b6b",
                        "entry_id": "437d421e-9e8f-3e62-87a8-59f327959c0e",
                        "glosses": [
                            "Stained with blood."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0403ff4b-1af6-4682-a837-49123e47968e",
                                "sense_id": "0efefad8-0ca1-3aac-8fd1-c05bcb6e2b6b",
                                "text": "He bears for Arms : Argent, on a chief vert, two spear-heads erect of the field, the points imbrued gules."
                            }
                        ]
                    }
                ],
