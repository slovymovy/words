                        "entry_id": "fcf525b5-7666-3d14-9976-1b5aef93c3b6",
                        "glosses": [
                            "von mehreren Personen gehaltene, feste Plane, auf die ein Sprung zur Rettung aus einem Gebäude möglich ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5c2f739-02de-4287-9de8-a72a81409655",
                                "sense_id": "20b8f73b-c35a-3099-b4d4-3c50f649ff89",
                                "text": "Die Feuerwehr konnte die Bewohner aus dem vierten Stock des brennenden Gebäudes mithilfe eines Sprungtuches retten."
                            },
                            {
                                "example_id": "e6ef2e4d-f6c0-4884-b126-3d6839ff0670",
                                "sense_id": "20b8f73b-c35a-3099-b4d4-3c50f649ff89",
                                "text": "„Immer war ein Sprungtuch bei ihrem Sturz aufgespannt.“"
                            }
                        ],
