                "senses": [
                    {
                        "sense_id": "2233834c-c0d0-3a66-8549-ab1bf091e0d6",
                        "entry_id": "09a1b87d-8084-3d52-9564-ab675d9ee161",
                        "glosses": [
                            "Ventilation der Luft zur Beseitigung verbrauchter, verunreinigter Luft, besonders in geschlossenen Räumen"
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "0f1009e0-970f-48f0-81a6-d518e0d79902",
                                "sense_id": "2233834c-c0d0-3a66-8549-ab1bf091e0d6",
                                "text": "„Die Ventilierung der Binnentankschiffe ist nur zulässig, wenn sie während der Fahrt vorgenommen wird.“"
                            },
                            {
                                "example_id": "477ac7e5-e118-46b5-b390-028d1d631426",
                                "sense_id": "2233834c-c0d0-3a66-8549-ab1bf091e0d6",
                                "text": "„Die laterale Ventilierung wird manuell bei einer Winde aktiviert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "89a06344-cc96-3f14-b78b-79c0836be249",
                        "entry_id": "09a1b87d-8084-3d52-9564-ab675d9ee161",
                        "glosses": [
                            "Belüftung der Lungen bei der Atmung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "635a13aa-9a73-4126-b4c2-81483649934c",
                                "sense_id": "89a06344-cc96-3f14-b78b-79c0836be249",
                                "text": "Die Ventilierung der Tracheen geschieht bei manchen Insekten (Schmetterlingspuppen) nur durch Diffusion, bei der Mehrzahl aber aktiv durch Körper- öder Atembewegungen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "aea68537-39fa-378b-9d21-3df705b010dd",
                        "entry_id": "09a1b87d-8084-3d52-9564-ab675d9ee161",
                        "glosses": [
                            "Überlegung oder auch Erörterung von etwas"
                        ],
                        "tags": [
                            "literary",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "598db245-211d-40d8-b552-eda98cb4357b",
                                "sense_id": "aea68537-39fa-378b-9d21-3df705b010dd",
                                "text": "Konkrete Bedeutung hätte die Ventilierung dieser Idee dann, wenn sie beispielsweise zu Propagandazwecken im Ausland benutzt werden könnte."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
