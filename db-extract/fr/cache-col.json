                                        "sense_id": "f44cba7e-3b18-3000-a5a7-1fad10d948da",
                                        "entry_id": "75e9922c-cffe-3f35-aa76-0d7f60a407e4",
                                        "glosses": [
                                            "A long, often knitted, garment worn around the neck."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9297d6a4-91ce-4000-96bf-dbc79ccdf50f",
                                                "sense_id": "f44cba7e-3b18-3000-a5a7-1fad10d948da",
                                                "text": "Now that she had rested and had fed from the luncheon tray Mrs. Broome had just removed, she had reverted to her normal gaiety. She looked cool in a grey tailored cotton dress with a terracotta scarf and shoes and her hair a black silk helmet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d7e594c-d051-3c91-b6d8-7088a3852986",
                                        "entry_id": "75e9922c-cffe-3f35-aa76-0d7f60a407e4",
                                        "glosses": [
                                            "A headscarf."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
