                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f24b858c-f7a4-4e9d-a63f-f3631d3dade1",
                                "sense_id": "20195cea-d1af-3f62-b561-68a3888f290e",
                                "text": "Każdy okrzyk głęboko ranił serce wicehrabiny, bo każdy był prawie sztyletem, grożącym śmiercią jej kochankowi"
                            }
                        ],
