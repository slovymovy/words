                "senses": [
                    {
                        "sense_id": "a9bab687-d271-3035-93da-3918dbeffa0f",
                        "entry_id": "4db7ebb7-750e-3ae3-91fb-f834a6ff9eac",
                        "glosses": [
                            "Action de dédier un lieu au culte divin."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "a46522c6-7b88-3f26-a79d-7ef98f45d32c",
                        "entry_id": "4db7ebb7-750e-3ae3-91fb-f834a6ff9eac",
                        "glosses": [
                            "Action de placer une église, une chapelle sous l’invocation d’un saint."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "5aba1c58-2262-478f-a301-fd5b534dfdfd",
                                "sense_id": "a46522c6-7b88-3f26-a79d-7ef98f45d32c",
                                "text": "La fête de la dédicace des églises."
                            }
                        ]
                    },
                    {
                        "sense_id": "3c88f61a-5b88-3e84-be62-49165c694a62",
                        "entry_id": "4db7ebb7-750e-3ae3-91fb-f834a6ff9eac",
                        "glosses": [
                            "Consécration d’un monument à un personnage."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "3512f2d1-928c-3066-b84a-0f9d5f2da5dd",
                        "entry_id": "4db7ebb7-750e-3ae3-91fb-f834a6ff9eac",
                        "glosses": [
                            "Inscription qui rappelle cette consécration."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "e82553f8-cbc6-35a8-9b1e-c8be702717aa",
                        "entry_id": "4db7ebb7-750e-3ae3-91fb-f834a6ff9eac",
                        "glosses": [
                            "Inscription à la tête d’un ouvrage imprimé, par laquelle on le dédie à quelqu’un."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7b006f6-a5fa-4f9c-b523-7b65aab7d606",
                                "sense_id": "e82553f8-cbc6-35a8-9b1e-c8be702717aa",
                                "text": "Sa sœur ? Malgré l’hypocrite tendresse de ses dédicaces, il ne l’aimait pas, et elle non plus, au fond, ne l’aimait pas…"
                            }
                        ]
                    },
                    {
                        "sense_id": "2fad78eb-3aa3-3761-b02e-04a097f43b5c",
                        "entry_id": "4db7ebb7-750e-3ae3-91fb-f834a6ff9eac",
                        "glosses": [
                            "Quelques mots ou des quelques lignes écrites par un auteur sur la première page de son livre pour en faire hommage à quelqu’un."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "efda325e-f016-4f9b-9400-7617b52d6a32",
                                "sense_id": "2fad78eb-3aa3-3761-b02e-04a097f43b5c",
                                "text": "J’ai dans ma bibliothèque un exemplaire des Aventures de Télémaque, portant sur la première page, d'une écriture assez maladroite et empâtée : « Donné par Minerve Rossignol à Léon Férat, son neveu chéri, Calais le 10 avril 1840. » Ce que sont devenus cette femme qui avait un prénom si pompeux, et l'enfant qu'elle aimait, Dieu le sait. Il m'arrive de penser à ce neveu chéri, à cette tendresse qu'on devine, à ces vies qui n'ont laissé d'autres vestiges qu'une dédicace. J'aurai laissé la mienne."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ecc52b2f-aec6-4872-ac43-c62ad1e46a8b",
                        "source_entry_id": "4db7ebb7-750e-3ae3-91fb-f834a6ff9eac",
                        "target_lang_word": "Widmung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Widmung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "40554c84-6b5b-3983-96a7-f86410660db2",
                                        "entry_id": "170ede86-bfd4-3441-a29e-57449bddb890",
                                        "glosses": [
                                            "Worte (oft in einem Buch), die ganz persönlich für jemanden bestimmt sind"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9bfaf1ca-0877-4b57-b714-62f76b5472fb",
                                                "sense_id": "40554c84-6b5b-3983-96a7-f86410660db2",
                                                "text": "Die Widmung gilt ihrer Freundin."
                                            },
                                            {
                                                "example_id": "46d1ba3d-0305-43e1-80d7-f0f1e5b1ccc8",
                                                "sense_id": "40554c84-6b5b-3983-96a7-f86410660db2",
                                                "text": "„Ich las die Widmung oft und oft wieder, zergrübelte mit den Kopf, was ich wohl gemeint haben könnte, aber es fiel mir nach zweiundvierzig Jahren nicht mehr ein.“"
                                            },
                                            {
                                                "example_id": "88c9c823-2831-4490-87d5-5ffb7918bba6",
                                                "sense_id": "40554c84-6b5b-3983-96a7-f86410660db2",
                                                "text": "„Die Widmung des Buches wurde bei der Drucklegung formuliert, also in nachnazistischer Zeit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "028ccb41-3da3-32d4-81d8-d1dc08593019",
                                        "entry_id": "170ede86-bfd4-3441-a29e-57449bddb890",
                                        "glosses": [
                                            "am Beginn gedruckte Zueignung des Werkes eines Autors"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aea1a2b2-98bd-4356-9f51-a715b3e16a02",
                                                "sense_id": "028ccb41-3da3-32d4-81d8-d1dc08593019",
                                                "text": "Als Widmung stand zu lesen: Meinem lieben Vater in Dankbarkeit."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "078f10de-0858-3eda-8e9a-8b9d18a62764",
                                        "entry_id": "170ede86-bfd4-3441-a29e-57449bddb890",
                                        "glosses": [
                                            "Erklärung einer staatlichen Stelle, dass etwas einem bestimmten öffentlichen Zweck dienen soll"
                                        ],
                                        "tags": [
                                            "Rechtswesen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f3328435-bbd9-4405-b7e7-3411ca95ff36",
                                                "sense_id": "078f10de-0858-3eda-8e9a-8b9d18a62764",
                                                "text": "Mit Widmung bezeichnet man den juristischen Geburtsakt der öffentlichen Straße. Dadurch erhält eine Straße den Charakter eines öffentlichen Weges."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
