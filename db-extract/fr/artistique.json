                    {
                        "sense_id": "c382e231-b4cb-3ea7-9629-f21bf91ca7c5",
                        "entry_id": "86aaeb57-3403-3ff1-aea9-ebd34b024869",
                        "glosses": [
                            "Qui se rapporte à l’art."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5cd9e527-7293-4165-9692-0899320a4ff7",
                                "sense_id": "c382e231-b4cb-3ea7-9629-f21bf91ca7c5",
                                "text": "Le tatouage, en effet, est une institution dans la marine américaine et des heures de service sont spécialement réservées à ce divertissement artistique."
                            },
                            {
                                "example_id": "69067253-6de7-4b07-bf4d-eb5937ecba96",
                                "sense_id": "c382e231-b4cb-3ea7-9629-f21bf91ca7c5",
                                "text": "La question de la propriété artistique n’a jamais été complètement résolue."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c2d1f5fe-0bcb-4e25-a48a-1db23bd5a461",
                        "source_entry_id": "86aaeb57-3403-3ff1-aea9-ebd34b024869",
                        "source_sense_id": "c382e231-b4cb-3ea7-9629-f21bf91ca7c5",
                        "target_lang_word": "künstlerisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "künstlerisch",
