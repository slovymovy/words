                    {
                        "translation_id": "42b429f3-a0d8-451d-a5b9-63a8333ccfa9",
                        "source_entry_id": "8808e1f5-a21e-3d0a-ad73-33e2a2df69a1",
                        "source_sense_id": "a449355c-bb62-362d-97f0-be99e54a00a5",
