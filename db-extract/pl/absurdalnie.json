                "translations": [
                    {
                        "translation_id": "502b82ff-60df-4400-88c3-f635047a053b",
                        "source_entry_id": "c900d403-0176-35ae-baee-f3a339070673",
                        "source_sense_id": "68b817eb-d229-39db-a230-672eb1e9f123",
                        "source_sense_description": "ohne Sinn, sich selbst widersprechend; absurd, widersinnig, unsinnig, sinnlos",
                        "target_lang_word": "absurd",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "absurd",
