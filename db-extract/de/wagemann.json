                ],
                "senses": [
                    {
                        "sense_id": "aa0d4513-218f-346f-8c3f-2afb6d8c319b",
                        "entry_id": "1cebbd9b-f1d3-3ed8-affc-c7a52e86bcfb",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e099fb75-d034-4bc5-96e2-e585c23a0864",
                                "sense_id": "aa0d4513-218f-346f-8c3f-2afb6d8c319b",
                                "text": "Frau Wagemann ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "70cb0e45-87c4-4bc4-99f4-603da0250cfa",
                                "sense_id": "aa0d4513-218f-346f-8c3f-2afb6d8c319b",
                                "text": "Herr Wagemann wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "939260c4-d6f8-436d-b54e-1a12e1c4a9ef",
                                "sense_id": "aa0d4513-218f-346f-8c3f-2afb6d8c319b",
                                "text": "Die Wagemanns fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "59725861-69d5-4955-bfdb-3413e68f199e",
                                "sense_id": "aa0d4513-218f-346f-8c3f-2afb6d8c319b",
                                "text": "Der Wagemann trägt nie die Schals, die die Wagemann ihm strickt."
                            },
                            {
                                "example_id": "85b6a002-a94f-4fd5-8ddb-0cc107b24ba4",
                                "sense_id": "aa0d4513-218f-346f-8c3f-2afb6d8c319b",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Wagemann kommt, geht der Herr Wagemann.“"
                            },
                            {
                                "example_id": "ee86fcdc-15fe-4286-b13a-e0da38ff765a",
                                "sense_id": "aa0d4513-218f-346f-8c3f-2afb6d8c319b",
                                "text": "Wagemann kommt und geht."
                            },
                            {
                                "example_id": "241be256-3453-4839-93c7-e35594a6f5f3",
                                "sense_id": "aa0d4513-218f-346f-8c3f-2afb6d8c319b",
                                "text": "Wagemanns kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
