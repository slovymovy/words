                        "target_lang_word": "Kaugummi",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kaugummi",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5ba1ed6d-0327-39ec-b7aa-4599f802ca6a",
                                        "entry_id": "7ae52a8a-5373-3251-a80c-b46c57a4b078",
                                        "glosses": [
                                            "gummiartige Masse mit Geschmacksstoffen, die gekaut wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "474217d5-89a1-48f5-a21c-84827a0e6d1a",
                                                "sense_id": "5ba1ed6d-0327-39ec-b7aa-4599f802ca6a",
                                                "text": "Gelangweilt kaute er auf seinem Kaugummi herum."
                                            },
                                            {
                                                "example_id": "2f2ec1d8-9833-41be-b077-6fe4db29cf0d",
                                                "sense_id": "5ba1ed6d-0327-39ec-b7aa-4599f802ca6a",
                                                "text": "Nimm sofort den Kaugummi aus dem Mund!"
                                            },
                                            {
                                                "example_id": "ddeebb41-9d8a-4ae8-beaa-85bbbf8ff504",
                                                "sense_id": "5ba1ed6d-0327-39ec-b7aa-4599f802ca6a",
                                                "text": "„Ein Seminar kann schon mal zäh wie Kaugummi werden, wenn sich ein Laberstudent eingeschlichen hat.“ (aus: SPIEGEL ONLINE, Wie Mathe mit Wörtern, 27.03.2007)"
                                            },
                                            {
                                                "example_id": "11bd84fb-8302-4fa0-a5d1-81022b0ea3ef",
                                                "sense_id": "5ba1ed6d-0327-39ec-b7aa-4599f802ca6a",
                                                "text": "„Dabei war der sowjetische Kaugummi hart wie Stein.“"
                                            },
                                            {
                                                "example_id": "eddf9077-5e31-42ae-9eeb-570f6799bfb9",
                                                "sense_id": "5ba1ed6d-0327-39ec-b7aa-4599f802ca6a",
                                                "text": "„In Polen gab es sogar Kaugummi zu kaufen.“"
                                            },
                                            {
                                                "example_id": "c0d7c487-e329-41e6-ad1b-aa8a62a52933",
                                                "sense_id": "5ba1ed6d-0327-39ec-b7aa-4599f802ca6a",
                                                "text": "„Daher ist es vielleicht kein Zufall, dass Island auf der Weltkarte ein wenig an einen breitgetretenen Kaugummi erinnert.“"
                                            },
                                            {
                                                "example_id": "e3e84fc2-ad02-4663-b287-428d371770f7",
                                                "sense_id": "5ba1ed6d-0327-39ec-b7aa-4599f802ca6a",
                                                "text": "„Den Kaugummi kauten sie eigentlich nur, um die Zeit hinzubringen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
