                    {
                        "translation_id": "dff811de-dd2a-46ca-94a6-8042de3d7ae5",
                        "source_entry_id": "24d177a3-8d05-34e7-8cde-ce4bcd5165ac",
                        "source_sense_id": "3deba066-7cef-3c4a-947d-7c131e609186",
                        "source_sense_description": "(2R,3S)-butane-1,2,3,4-tetraol",
                        "target_lang_word": "ερυθριτόλη",
                        "target_lang_code": "el",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ερυθριτόλη",
                                "target_lang_code": "el",
                                "target_senses": [
                                    {
                                        "sense_id": "6a937d42-a151-3ee8-9952-4fc3ecb1b874",
                                        "entry_id": "2f6c90c4-a2c1-347b-8308-9ea5e4bf5ff3",
                                        "glosses": [
                                            "οργανική ένωση που χρησιμοποιείται ως πρόσθετο τροφίμων και ως υποκατάστατο ζάχαρης"
                                        ],
                                        "tags": [
                                            "χημεία"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e6620a2e-9e02-44e2-8184-8bea88bdd953",
                                                "sense_id": "6a937d42-a151-3ee8-9952-4fc3ecb1b874",
                                                "text": "※ Η κατανάλωση τροφίμων με το γνωστό γλυκαντικό ερυθριτόλη- ένα τεχνητό γλυκαντικό που χρησιμοποιείται για να προσθέσει όγκο στη στέβια και το βρίσκουμε συχνά σε προϊόντα χαμηλών υδατανθράκων- υπερδιπλασίασε τον κίνδυνο σχηματισμού θρόμβων σε 10 υγιή άτομα, σύμφωνα με μια νέα πιλοτική μελέτη. […] Η ερυθριτόλη είναι ένα τεχνητό γλυκαντικό και αλκοόλη ζάχαρης, που χρησιμοποιείται ευρέως ως υποκατάστατο της ζάχαρης σε διάφορα τρόφιμα και ποτά. Παράγεται συνήθως μέσω μιας διαδικασίας ζύμωσης γλυκόζης από καλαμπόκι ή άλλες πηγές, και έχει περίπου το 70% της γλυκύτητας της ζάχαρης, χωρίς όμως να περιέχει θερμίδες.",
                                                "translation": "Ερυθριτόλη: Το γνωστό γλυκαντικό συνδέθηκε με τον κίνδυνο σχηματισμού θρόμβων σύμφωνα με νέα έρευνα, 09-08-2024, @capital.gr, ημερομηνία ανάκτησης: 14-08-2024."
                                            },
                                            {
                                                "example_id": "ff418c6a-f36c-49ce-ad92-7b8cbe6088e7",
                                                "sense_id": "6a937d42-a151-3ee8-9952-4fc3ecb1b874",
                                                "text": "※ Η ερυθριτόλη, η οποία σε φυσική μορφή υπάρχει σε πολλά λαχανικά και φρούτα, ενώ παράγεται ακόμη και από το ανθρώπινο σώμα σε μικρή ποσότητα, προστίθεται σε μεγαλύτερες ποσότητες ως τεχνητό γλυκαντικό σε διάφορα τρόφιμα και ποτά με λίγες θερμίδες και χαμηλούς υδατάνθρακες.",
                                                "translation": "Ερυθριτόλη: Το κοινό γλυκαντικό που αυξάνει τον κίνδυνο εμφράγματος και εγκεφαλικού – Διχασμένοι οι επιστήμονες, 28-02-2023, @newsit.gr, ημερομηνία ανάκτησης: 14-08-2024."
                                            },
                                            {
                                                "example_id": "4fe0c8ca-c30c-42aa-b11a-df11c13ee842",
                                                "sense_id": "6a937d42-a151-3ee8-9952-4fc3ecb1b874",
                                                "text": "※ Η ερυθριτόλη είναι ένα δημοφιλές υποκατάστατο ζάχαρης που χρησιμοποιείται σε διάφορα τρόφιμα και ποτά και διατίθεται τόσο σε σκόνη όσο και σε υγρή μορφή. Μαζί με τη μαλτιτόλη, τη σορβιτόλη και την ξυλιτόλη, είναι γνωστή ως αλκοόλη σακχάρου -ένας τύπος υδατάνθρακα που έχει παρόμοια χημική δομή με τη ζάχαρη. Παρά το όνομά τους, οι αλκοόλες ζάχαρης δεν είναι ούτε ζάχαρη ούτε αλκοόλ.",
                                                "translation": "Ερυθριτόλη: Το υποκατάστατο ζάχαρης που δεν αυξάνει το σάκχαρο αλλά προκαλεί πεπτικά προβλήματα – Ποιοι δεν πρέπει να το επιλέγουν, 12-09-2023, @oloygeia.gr, ημερομηνία ανάκτησης: 14-08-2024."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
