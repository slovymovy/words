                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bc3bae6e-31a7-3f1d-abdc-e50c34ee0537",
                                        "entry_id": "cfcad1d5-3023-3cce-b978-d2d97c1bb31a",
                                        "glosses": [
                                            "To have sexual intercourse with (a woman)."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "11522435-251e-48cf-a04e-653344afd559",
                                                "sense_id": "bc3bae6e-31a7-3f1d-abdc-e50c34ee0537",
                                                "text": "Quhilk will, for purging of thir neirs: / Sard up the ta raw, and doun the uther."
                                            },
                                            {
                                                "example_id": "21267ae4-705a-4c7a-840e-559a0d09557b",
                                                "sense_id": "bc3bae6e-31a7-3f1d-abdc-e50c34ee0537",
                                                "text": "Foltere. To iape, to sard, to fucke, to swive, to occupye."
                                            },
                                            {
                                                "example_id": "d8da524c-941d-4bf0-8d98-bb8e7697c7f2",
                                                "sense_id": "bc3bae6e-31a7-3f1d-abdc-e50c34ee0537",
                                                "text": "[…] and thence ſprouteth that obſcene appellation of Sarding ſandes, with the draffe of the carterly Hoblobs thereabouts, concoct or diſgeaſt for a ſcripture, verity, when the right chriſtendome of it, is Cerdicke ſands, or Cerdick ſhore, […]"
                                            },
                                            {
                                                "example_id": "8e0591b7-9144-4a9e-a36c-090dc4066503",
                                                "sense_id": "bc3bae6e-31a7-3f1d-abdc-e50c34ee0537",
                                                "text": "Go, teach your grandam to sard, a Nottingham proverb."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
