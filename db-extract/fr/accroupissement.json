        "fr-extract.jsonl": [
            {
                "entry_id": "191c1f6a-5aab-3e9b-b990-febdb27c6f44",
                "word": "accroupissement",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "7bdbe54a-dcfe-4ca3-9a77-299d9c7be7a2",
                        "entry_id": "191c1f6a-5aab-3e9b-b990-febdb27c6f44",
                        "tags": [
                            "plural"
                        ],
                        "form": "accroupissements"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "be811ec5-1ab4-3750-825a-82ca375af6a2",
                        "entry_id": "191c1f6a-5aab-3e9b-b990-febdb27c6f44",
                        "glosses": [
                            "État d’une personne accroupie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d5082d6-9ea0-4b54-945d-1861595d0724",
                                "sense_id": "be811ec5-1ab4-3750-825a-82ca375af6a2",
                                "text": "Avant de passer à table, je me cherchais de la lecture. Le bouquin en cours, un livre de classe, n’importe quoi. Pour les cabinets, pareil. Le bout de journal que j’emportais pour me torcher, il fallait que je ne l’aie pas encore lu, il allait être le compagnon de mon accroupissement."
                            },
                            {
                                "example_id": "1c52f641-16d5-4bd3-a1dc-2e2caa8b895c",
                                "sense_id": "be811ec5-1ab4-3750-825a-82ca375af6a2",
                                "text": "Parmi les diverses postures adoptées par les personnages, l’une des plus fréquentes est ainsi l’accroupissement."
                            },
                            {
                                "example_id": "29b8452b-680a-42f0-828d-30e4c663bca2",
                                "sense_id": "be811ec5-1ab4-3750-825a-82ca375af6a2",
                                "text": "C’est une zone intermédiaire, dont la révélation ne devrait rien avoir en soi de bouleversant : un bout de dos, quand elles se penchent et que le tee-shirt se relève en haut du jean. Rien à voir avec l’accroupissement des hommes que la moindre tâche matérielle – changement de roue, desserrage d’un siphon – dénude naïvement, faisant apparaître la commissure des fesses avec une fossette pouponnesque. Chez elles, c’est toujours plus bas, plus loin"
                            }
                        ]
                    },
                    {
                        "sense_id": "dbce8868-907f-3b0c-b144-f3b93af92101",
                        "entry_id": "191c1f6a-5aab-3e9b-b990-febdb27c6f44",
                        "glosses": [
                            "Changement de l’assiette du navire par enfoncement de l’arrière, dû à son déplacement dans l’eau."
                        ],
                        "tags": [
                            "Transport maritime"
                        ],
                        "examples": [
                            {
                                "example_id": "d64b3163-181b-4297-a335-9e5c6baa38b8",
                                "sense_id": "dbce8868-907f-3b0c-b144-f3b93af92101",
                                "text": "La diminution d'ensemble de la profondeur d’eau sous quille à l’avant ou à l’arrière s’appelle effet d’accroupissement du navire."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "424fec3d-b1bb-40d6-9d65-704e63ad8059",
                        "source_entry_id": "191c1f6a-5aab-3e9b-b990-febdb27c6f44",
                        "target_lang_word": "Hocke",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hocke",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ef59be70-312e-3457-8ba7-ad8bd6857e82",
                                        "entry_id": "08259b58-2d80-3316-b927-c8e760b87592",
                                        "glosses": [
                                            "Heu- oder Getreidehaufen, der zum Trocknen und Nachreifen aufgestellt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40cec1c5-ff0b-431f-b43f-fd68585010d0",
                                                "sense_id": "ef59be70-312e-3457-8ba7-ad8bd6857e82",
                                                "text": "„Dann ging es hinaus, in Richtung des Bahnhofs, hin zu einem weiten Acker, der mit zu Hocken zusammengestellten Garben übersät war.“"
                                            },
                                            {
                                                "example_id": "d3cea188-e353-4fbc-b0fa-59c81fcf15f4",
                                                "sense_id": "ef59be70-312e-3457-8ba7-ad8bd6857e82",
                                                "text": "„Bald werden sie das Erntefest feiern, der Nachtwächter wird die Trompete blasen, und Mareike wird um die große Hocke tanzen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a3b024b5-fe40-3baf-807c-93c74e65f015",
                                        "entry_id": "08259b58-2d80-3316-b927-c8e760b87592",
                                        "glosses": [
                                            "eine sitzende Körperhaltung mit angewinkelten Beinen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6e27ebd-c21d-43e8-a612-170c4913ff05",
                                                "sense_id": "a3b024b5-fe40-3baf-807c-93c74e65f015",
                                                "text": "Ich mag nicht lange in der Hocke sitzen."
                                            },
                                            {
                                                "example_id": "12b8244e-e246-40cc-a244-8c3bf2bf3132",
                                                "sense_id": "a3b024b5-fe40-3baf-807c-93c74e65f015",
                                                "text": "„Der Lensmann ging vor ihr in die Hocke, sie sagte nichts, rieb nur die Hände aneinander, rieb und rieb, als wären sie Silberbesteck.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "f2a0d2c4-778e-3569-b410-a8db1b83fb75",
                                        "entry_id": "08259b58-2d80-3316-b927-c8e760b87592",
                                        "glosses": [
                                            "eine Rückentraglast"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "8b087799-bf6b-3a49-8994-3751e37a7ea3",
                                        "entry_id": "08259b58-2d80-3316-b927-c8e760b87592",
                                        "glosses": [
                                            "Sprung über ein Turngerät (Kasten, Pferd oder Ähnliches) mit angewinkelten Beinen"
                                        ],
                                        "tags": [
                                            "Turnen"
                                        ],
