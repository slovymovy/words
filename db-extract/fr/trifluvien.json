                    {
                        "sense_id": "c5858f82-0b76-3fbf-bf46-50b4beaff52e",
                        "entry_id": "937670ce-068c-3692-8e56-69fe57101e6f",
                        "glosses": [
                            "Relatif à Trois-Rivières, ville du Canada située dans la province de Québec, ou à ses habitants, les Trifluviens."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8a84e63-458a-456a-b264-13f4e4f2b404",
                                "sense_id": "c5858f82-0b76-3fbf-bf46-50b4beaff52e",
                                "text": "C’est la dernière fois [1650] que nous pourrons considérer le groupe trifluvien comme demeurant tout entier dans la ville ; à partir des années qui suivent, plusieurs colons se répandent sur les terres du Cap et ailleurs, mais toutefois sans trop s’éloigner du voisinage du fort."
                            },
                            {
                                "example_id": "6eb39f0b-9f03-4213-8b9d-b3aaeb7ab22f",
                                "sense_id": "c5858f82-0b76-3fbf-bf46-50b4beaff52e",
                                "text": "Pour sa part, la poète trifluvienne Evelyne Gagnon recevra le Prix de poésie Jean-Lafrenière-Zénob, alors qu’Audrey Simard se verra décerner le Prix national de poésie Pierre Chatillon."
                            }
                        ]
                    }
                ],
