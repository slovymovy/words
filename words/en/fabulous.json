{
    "word_family": [
        "fable",
        "fabulist",
        "fabulously",
        "fabulousness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "36798e25-f26a-3e3e-92c6-64b50dc484b0",
                    "sense_definition": "Extremely good, pleasant, or enjoyable.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "excellent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We had a <w>fabulous</w> time at the party last night.",
                            "target_lang_translations": {
                                "ru": "Мы <w>потрясающе</w> провели время на вечеринке вчера вечером."
                            }
                        },
                        {
                            "text": "The weather was <w>fabulous</w> during our entire vacation by the sea.",
                            "target_lang_translations": {
                                "ru": "Погода была <w>замечательной</w> на протяжении всего нашего отпуска у моря."
                            }
                        }
                    ],
                    "synonyms": [
                        "excellent"
                    ],
                    "antonyms": [
                        "terrible",
                        "awful"
                    ],
                    "common_phrases": [
                        "fabulous time",
                        "fabulous weather",
                        "fabulous meal"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чрезвычайно хороший, приятный или доставляющий удовольствие."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "потрясающий",
                                "target_lang_sense_clarification": "вызывающий сильное впечатление"
                            },
                            {
                                "target_lang_word": "замечательный",
                                "target_lang_sense_clarification": "очень хороший"
                            },
                            {
                                "target_lang_word": "прекрасный",
                                "target_lang_sense_clarification": "красивый и приятный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f4d66a0c-f431-36b3-846d-d76d0e33b765",
                    "sense_definition": "Very fashionable, attractive, and impressive in style.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "style",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She looked absolutely <w>fabulous</w> in her new silk dress.",
                            "target_lang_translations": {
                                "ru": "Она выглядела абсолютно <w>потрясающе</w> в своем новом шелковом платье."
                            }
                        },
                        {
                            "text": "The interior design of the hotel is <w>fabulous</w> and modern.",
                            "target_lang_translations": {
                                "ru": "Дизайн интерьера отеля <w>великолепен</w> и современен."
                            }
                        }
                    ],
                    "antonyms": [
                        "plain",
                        "shabby"
                    ],
                    "common_phrases": [
                        "look fabulous",
                        "fabulous dress",
                        "fabulous style"
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень модный, привлекательный и впечатляющий по стилю."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "потрясающий",
                                "target_lang_sense_clarification": "о внешнем виде"
                            },
                            {
                                "target_lang_word": "великолепный",
                                "target_lang_sense_clarification": "роскошный и красивый"
                            },
                            {
                                "target_lang_word": "шикарный",
                                "target_lang_sense_clarification": "изысканный и дорогой"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3af7f15b-00e5-3947-bb65-0a8aa87c319a",
                    "sense_definition": "So great or large that it is difficult to believe.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "extraordinary",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The museum houses a <w>fabulous</w> wealth of ancient artifacts.",
                            "target_lang_translations": {
                                "ru": "В музее хранится <w>баснословное</w> богатство древних артефактов."
                            }
                        },
                        {
                            "text": "He managed to accumulate a <w>fabulous</w> fortune in a very short time.",
                            "target_lang_translations": {
                                "ru": "Ему удалось сколотить <w>сказочное</w> состояние за очень короткое время."
                            }
                        }
                    ],
                    "antonyms": [
                        "modest",
                        "small"
                    ],
                    "common_phrases": [
                        "fabulous wealth",
                        "fabulous fortune",
                        "fabulous success"
                    ],
                    "target_lang_definitions": {
                        "ru": "Настолько великий или огромный, что в это трудно поверить."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "баснословный",
                                "target_lang_sense_clarification": "огромный, невероятный"
                            },
                            {
                                "target_lang_word": "невероятный",
                                "target_lang_sense_clarification": "трудновообразимый"
                            },
                            {
                                "target_lang_word": "сказочный",
                                "target_lang_sense_clarification": "исключительный по масштабу"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bd3db1fd-b709-34a6-ba15-6dcfa19ab887",
                    "sense_definition": "Relating to or found in a <w>fable</w>, myth, or legend.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mythology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The unicorn is a <w>fabulous</w> creature that appears in many legends.",
                            "target_lang_translations": {
                                "ru": "Единорог — это <w>мифическое</w> существо, которое встречается во многих легендах."
                            }
                        },
                        {
                            "text": "Ancient texts are filled with stories of <w>fabulous</w> beasts and heroes.",
                            "target_lang_translations": {
                                "ru": "Древние тексты полны историй о <w>сказочных</w> зверях и героях."
                            }
                        }
                    ],
                    "antonyms": [
                        "real",
                        "factual"
                    ],
                    "common_phrases": [
                        "fabulous creature",
                        "fabulous beast",
                        "fabulous monster"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к басням, мифам или легендам или встречающийся в них."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мифический",
                                "target_lang_sense_clarification": "из мифов"
                            },
                            {
                                "target_lang_word": "сказочный",
                                "target_lang_sense_clarification": "из сказок"
                            },
                            {
                                "target_lang_word": "легендарный",
                                "target_lang_sense_clarification": "из легенд"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0a37f994-5c28-30ad-b00b-4ad263dfcad3",
                    "sense_definition": "Invented or made up; not based on reality.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "fictional",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The witness provided a <w>fabulous</w> account of the events that no one believed.",
                            "target_lang_translations": {
                                "ru": "Свидетель изложил <w>невероятную</w> версию событий, в которую никто не поверил."
                            }
                        },
                        {
                            "text": "His claims of being a secret agent were entirely <w>fabulous</w> inventions.",
                            "target_lang_translations": {
                                "ru": "Его утверждения о том, что он секретный агент, были чистым <w>вымыслом</w>."
                            }
                        }
                    ],
                    "antonyms": [
                        "authentic",
                        "true"
                    ],
                    "common_phrases": [
                        "fabulous account",
                        "fabulous story",
                        "fabulous invention"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вымышленный или придуманный; не основанный на реальности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вымышленный",
                                "target_lang_sense_clarification": "нереальный"
                            },
                            {
                                "target_lang_word": "невероятный",
                                "target_lang_sense_clarification": "неправдоподобный"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}