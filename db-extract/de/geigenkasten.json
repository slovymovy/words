                ],
                "senses": [
                    {
                        "sense_id": "79ff3cd4-b236-3a3d-b5de-905f6729cede",
                        "entry_id": "2a8832c8-2b02-31ae-8579-5a5e8a799323",
                        "glosses": [
                            "Behälter, für die Aufbewahrung einer Geige"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25807be2-4628-42ec-9207-af577be3c75e",
                                "sense_id": "79ff3cd4-b236-3a3d-b5de-905f6729cede",
                                "text": "„Nur wenn bei Feierlichkeiten der Geigenkasten aufspringt, ruht da, anders als zur Zeit Capones, keine Maschinenpistole im grünen Samtfutter, sondern tatsächlich eine Geige.“"
                            },
                            {
                                "example_id": "11728735-80ce-4f95-b477-52c9d86e435a",
                                "sense_id": "79ff3cd4-b236-3a3d-b5de-905f6729cede",
                                "text": "„Vor der Universität steht ein kleines Mädchen mit Brille und Zopf. Sie trägt einen altmodischen Geigenkasten und schaut in die Krone eines Kastanienbaums, wo ein Vogel zwitschert.“"
                            },
                            {
                                "example_id": "641d543f-9051-44ec-ba31-e59b1735f01b",
                                "sense_id": "79ff3cd4-b236-3a3d-b5de-905f6729cede",
                                "text": "„Robert prescht an mir vorbei, den Geigenkasten geschultert wie eine Kalaschnikow.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
