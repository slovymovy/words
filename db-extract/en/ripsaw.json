                "senses": [
                    {
                        "sense_id": "35c91ad4-0950-325c-84e3-ba1785e6bf68",
                        "entry_id": "701e6a3a-ec4e-37c4-878d-fbd1d950e19e",
                        "glosses": [
                            "A saw that is designed to cut wood along its grain, i.e. to rip, to execute a rip cut."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "3e1a7df2-c5d6-4ce2-a9a7-0208acda7168",
                                "sense_id": "35c91ad4-0950-325c-84e3-ba1785e6bf68",
                                "text": "A ripsaw will slice smoothly along the grain, but chew up the wood if it goes against the grain."
                            }
                        ]
                    },
                    {
                        "sense_id": "5de47f44-f706-3fef-ac37-766514526b61",
                        "entry_id": "701e6a3a-ec4e-37c4-878d-fbd1d950e19e",
                        "glosses": [
                            "A genre of music played with a ripsaw and other instruments, originally associated mainly with Turks and Caicos Islands."
                        ],
                        "tags": [
                            "Caribbean",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
