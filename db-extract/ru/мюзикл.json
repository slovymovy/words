                                        "examples": [
                                            {
                                                "example_id": "bba493d9-407f-4a23-a7a8-beb966c9a96d",
                                                "sense_id": "4e896eea-79d3-3e23-b957-3bbe2f4b4718",
                                                "text": "Compositeur d’un catalogue de plus de 300 œuvres où se mêlent comédies musicales, jazz, l’esthétique contemporaine, valses et tarentelles, il joue du clavecin, du piano, de l’orgue, mais aussi du hautbois, et propose un jeu d’anche supplémentaire pour l'orgue de l'église Saint-Guénolé."
                                            },
                                            {
                                                "example_id": "4c30d61f-0725-4ba6-94d4-599e1dc12948",
                                                "sense_id": "4e896eea-79d3-3e23-b957-3bbe2f4b4718",
                                                "text": "Laissez-vous entraîner dans l’univers magique des comédies musicales, Mary Poppins, West Side Story, Chicago, Show Boat, Chantons sous la pluie, My Fair Lady… où brillent les noms de George et Ira Gershwin, John Kander et Fred Ebb, Michael Stewart et Jerry Herman, Leonard Bernstein et tant d’autres."
                                            }
                                        ]
