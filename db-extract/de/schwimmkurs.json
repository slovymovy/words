                "senses": [
                    {
                        "sense_id": "661cd8ee-008e-3ff0-9e65-11de8e0ae741",
                        "entry_id": "2a0d710b-d6fb-3de9-9e05-80f7c81038e6",
                        "glosses": [
                            "eine Art Training oder Unterricht, um das Schwimmen im Wasser zu erlernen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95b6a282-ba4c-4b76-987f-8b926e520ed4",
                                "sense_id": "661cd8ee-008e-3ff0-9e65-11de8e0ae741",
                                "text": "„Brustschwimmen ist eine Schwimmart. Es wird im deutschsprachigen Raum in Schwimmkursen meist als erste Technik erlernt.“"
                            },
                            {
                                "example_id": "ff360b15-a10c-46f1-a208-224339f86bed",
                                "sense_id": "661cd8ee-008e-3ff0-9e65-11de8e0ae741",
                                "text": "„Währenddessen erfährt Martin, dass Laura ohne sein Wissen einen Schwimmkurs belegte und sich im Rahmen dessen zu einer sehr guten Schwimmerin entwickelt hat.“"
                            },
                            {
                                "example_id": "95babd7c-5332-48b5-9098-85937b94506f",
                                "sense_id": "661cd8ee-008e-3ff0-9e65-11de8e0ae741",
                                "text": "„Deutsche Regelwütigkeit wurde wiederum in der Story ›Frosch-Schere-zu!‹ aufs Korn genommen, in der es um den normierten Schwimmkurs der kleinen Tochter geht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
