                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6150eb0-be59-4295-afa3-71d47298aceb",
                                "sense_id": "4acae481-a1f6-3e87-8308-a550a0f33401",
                                "text": "„Ohne jemandem den Grund zu erklären, hatte er ihn in der gleichen Farbe wie die Sandsteingebäude des Dorfs streichen lassen und ihn in 1,20 Metern Höhe auf Ziegeln aufgebockt.“"
                            },
                            {
                                "example_id": "808eaf83-286a-4eee-a5c3-d3f866d2c8ff",
                                "sense_id": "4acae481-a1f6-3e87-8308-a550a0f33401",
                                "text": "„Die Leichenhalle war ein altes Sandsteingebäude, narbig und fleckig, aber noch immer schön mit seinen hohen Bögen und den steinernen Blumenornamenten.“"
                            },
                            {
                                "example_id": "7ebb6b79-438a-4d0f-97a6-24c897d7d486",
                                "sense_id": "4acae481-a1f6-3e87-8308-a550a0f33401",
                                "text": "„Es hockte wie ein Untier zwischen den klassischen, hellen, wesentlich älteren schmucken Sandsteingebäuden an dem herrlichen, breiten Boulevard.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
