                "senses": [
                    {
                        "sense_id": "e5ce0d8d-9a6b-3cb9-af59-6c5e527b6228",
                        "entry_id": "f3d00ab6-8d64-3fc2-a7a5-280a0601b0d2",
                        "glosses": [
                            "Grafikprozessor, der in den Hauptprozessor (in die CPU) eines Computers integriert ist"
                        ],
                        "tags": [
                            "Computer"
                        ],
                        "examples": [
                            {
                                "example_id": "e79c3f61-b1bc-4fd7-8512-03f9ffe44d37",
                                "sense_id": "e5ce0d8d-9a6b-3cb9-af59-6c5e527b6228",
                                "text": "„Der \"Pineview-M\" soll bereits einen integrierten Grafikkern enthalten.“"
                            },
                            {
                                "example_id": "98548b39-76ba-4110-b49d-176b05777547",
                                "sense_id": "e5ce0d8d-9a6b-3cb9-af59-6c5e527b6228",
                                "text": "„Die offiziellen Daten bestätigen die Vorabmeldungen, vor allem schnelle SATA-Ports und der runderneuerte Grafikkern stechen heraus.“"
                            },
                            {
                                "example_id": "260a96f7-e01f-4097-ac12-b9199812de96",
                                "sense_id": "e5ce0d8d-9a6b-3cb9-af59-6c5e527b6228",
                                "text": "„Der Arbeisspeicher [sic!] ist doppelt so gross. Genauso gross ist die Platine. Der Grafikkern wurde ebenfalls nicht verändert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
