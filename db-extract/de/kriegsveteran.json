                                "target_senses": [
                                    {
                                        "sense_id": "fa98c97d-479c-3f74-95c5-1dfd99320424",
                                        "entry_id": "3dd28d81-3704-3869-922a-cb77cabf2175",
                                        "glosses": [
                                            "A person who has served in the armed forces during a war, as contrasted with one who served entirely during peacetime."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6f21f23d-f907-45b0-8cb4-fb0e1746723d",
                        "source_entry_id": "9637cda7-e8a8-3aea-8b1e-825107c1001d",
                        "source_sense_id": "615e9f89-feb9-3321-ade7-66e921c95616",
                        "source_sense_description": "Person, die ehemals aktiv an Kriegshandlungen beteiligt war",
                        "target_lang_word": "ancien combattant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ancien combattant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f141cbd5-cd49-3ebe-922e-7d9af8a9c298",
                                        "entry_id": "98fae1ce-f5d1-3987-8929-9fcf9482042f",
                                        "glosses": [
                                            "Toute personne ayant servi lors d'une guerre, et recevant à ce titre certains avantages."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "969e1230-bfaa-4850-aaa5-85774723d332",
                                                "sense_id": "f141cbd5-cd49-3ebe-922e-7d9af8a9c298",
                                                "text": "« Ancien combattant », pour personne cela ne saurait être un titre de gloire ; c’est seulement une charge, peut-être un titre à la pitié."
                                            },
                                            {
                                                "example_id": "a27dac22-8f22-4224-a94e-da23fc774ba5",
                                                "sense_id": "f141cbd5-cd49-3ebe-922e-7d9af8a9c298",
                                                "text": "Si l'essor du phénomène associatif (loto des pompiers, des musiciens à la Sainte-Cécile, du club du troisième âge, des parents d'élèves, des anciens combattants, des boulistes, de la paroisse, des chasseurs...) atteste de mutations sociales et favorise des ambiances particulières, il montre aussi la permanence des besoins de la communauté."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8fcca56d-2315-3973-81d9-a017a8878f84",
                                        "entry_id": "98fae1ce-f5d1-3987-8929-9fcf9482042f",
                                        "glosses": [
                                            "Toute personne qui évoque des souvenirs anciens, pas forcément à caractère militaire."
                                        ],
                                        "tags": [
                                            "ironic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6cf06620-c0c6-4c16-82d2-44516d37aa83",
                                                "sense_id": "8fcca56d-2315-3973-81d9-a017a8878f84",
                                                "text": "– Ça ne t'ennuie pas, chérie, ces histoires d'anciens combattants ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
