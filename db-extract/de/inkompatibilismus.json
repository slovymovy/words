                                        "entry_id": "2a35fe4e-cf6e-39d5-8184-0ac9765b9652",
                                        "glosses": [
                                            "The doctrine that free will and determinism are incompatible, that one necessarily precludes the other."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "351bf504-b3f3-40dc-aaa0-ed2e7c38ddb2",
                                                "sense_id": "5fe13dc1-8bc2-3bf7-8261-53de8b31a20a",
                                                "text": "Because pretty much the same thing goes on in us when we have become the sort of person who would pull a trigger, or run into a building to save a child, or steal an extra cookie, or advocate hard incompatibilism in a book destined to be read only by two people who will hate it."
                                            }
                                        ]
                                    }
                                ]
