                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3947160f-f704-40cd-b423-53115b8aa1e9",
                                                "sense_id": "b100cc14-266d-3824-902e-8931606d23ad",
                                                "text": "It’s a seedy time of the night and Jacky is telling me about sailors and their needs. A man called P. C. Alexander, an ex-Indian High-Commissioner in London has cleaned up Madras. There’s a very Puritan atmosphere here now, and the seamen are not happy. ‘All ship’s crew very happy with Calcutta. Can bring many girls there. Bombay too – no problem.’ Bombay is apparently the only city in India to license prostitutes."
                                            },
                                            {
                                                "example_id": "086e5cdc-bfb1-404e-bb78-6829128a6bee",
                                                "sense_id": "b100cc14-266d-3824-902e-8931606d23ad",
                                                "text": "Chardonnay is very malleable, but once we get the fruit in we actually take a very Puritan approach to it."
                                            },
                                            {
                                                "example_id": "63de4c57-2fa0-4e9e-adcd-aa6c1c90bf8d",
                                                "sense_id": "b100cc14-266d-3824-902e-8931606d23ad",
                                                "text": "I learned to work from my grandfather, who held a very Puritan kind of work ethic."
                                            }
                                        ]
                                    }
