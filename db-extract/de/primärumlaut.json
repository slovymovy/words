                "senses": [
                    {
                        "sense_id": "0c03b518-7004-390b-a865-c94d22fb1f02",
                        "entry_id": "a3c35ed7-3c80-39b9-b4ff-fe2516ed01bd",
                        "glosses": [
                            "andere Bezeichnung für den i-Umlaut, bei dem seit der zweiten Hälfte des 8. Jahrhunderts ein /a/ der Wurzelsilbe unter dem Einfluss eines /i/, /ī/ oder /j/ der Folgesilbe zu /e/ wird (regressive Assimilation), außer vor bestimmten Konsonantenverbindungen"
                        ],
                        "tags": [
                            "Historische Sprachwissenschaft"
                        ],
                        "examples": [
                            {
                                "example_id": "fcc5b865-dd15-4b48-ac28-6aa93af95b5b",
                                "sense_id": "0c03b518-7004-390b-a865-c94d22fb1f02",
                                "text": "„Der Primärumlaut erscheint in der Überlieferung deshalb so früh, weil er zuerst phonologisch relevant wurde.“"
                            },
                            {
                                "example_id": "ff77d050-e465-4b69-b282-a461d6310019",
                                "sense_id": "0c03b518-7004-390b-a865-c94d22fb1f02",
                                "text": "„Der P r i m ä r u m l a u t erfaßt nur den Kurzvokal /a/ und wandelt ihn zu /e/; …“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
