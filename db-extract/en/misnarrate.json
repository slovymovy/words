                "senses": [
                    {
                        "sense_id": "0ec28eea-3d20-3ecc-8c18-7c4044e3d1f6",
                        "entry_id": "061c4342-95bf-3f47-92de-5ef4a96f224b",
                        "glosses": [
                            "To narrate incorrectly."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "ddf0ee07-bdcf-48b1-918e-8f8b8628471c",
                                "sense_id": "0ec28eea-3d20-3ecc-8c18-7c4044e3d1f6",
                                "text": "Was it kindness to misrepresent his dying words and misnarrate the details of his funeral?"
                            },
                            {
                                "example_id": "6d500565-a779-4856-bc78-f0757b897a8f",
                                "sense_id": "0ec28eea-3d20-3ecc-8c18-7c4044e3d1f6",
                                "text": "Krapp can see only the fool he was, not the fool he is; all his versions misperceive and misnarrate themselves."
                            },
                            {
                                "example_id": "58383270-4651-4063-ab86-13aa43e3c7a0",
                                "sense_id": "0ec28eea-3d20-3ecc-8c18-7c4044e3d1f6",
                                "text": "So too churches can misnarrate their story by inappropriate comparisons or a fixation on the wrong criteria for success."
                            }
                        ]
                    }
                ],
