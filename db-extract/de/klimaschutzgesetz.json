                ],
                "senses": [
                    {
                        "sense_id": "64cd700f-0c8f-3021-b0af-9b93d7a35de2",
                        "entry_id": "d8f5d80f-1a61-37dd-ac1d-25409c9c0738",
                        "glosses": [
                            "Gesetz, das Maßnahmen für den Schutz des Klimas beschreibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a62a4f9a-befb-48c0-91c7-531d748a9355",
                                "sense_id": "64cd700f-0c8f-3021-b0af-9b93d7a35de2",
                                "text": "„Wenn in dem reformierten Klimaschutzgesetz Klimaneutralität 2045 und minus 65 Prozent für das Jahr 2030 als Ziel festgeschrieben werden - womit das 1,5-Grad-Ziel sicher nicht erreicht werden kann - dann erhält man bei analoger Rechnung wie oben, dass die CO2-Minderung jährlich \"nur\" 8,4 Prozent betragen müsste.“"
                            },
                            {
                                "example_id": "38fd0dac-f486-440c-971a-98c1a81c4dbc",
                                "sense_id": "64cd700f-0c8f-3021-b0af-9b93d7a35de2",
                                "text": "„Ende April entschied das Bundesverfassungsgericht: Das bisherige Klimaschutzgesetz von 2019 muss nachgebessert werden, da die Maßnahmen zur Emissionsreduktion ab 2031 unzureichend seien.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
