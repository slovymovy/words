                        "target_lang_word": "population générale",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "population générale",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d4a1603c-e50d-3978-adda-feff8b30ca57",
                                        "entry_id": "d97abefa-5663-3131-bd2a-ff8609233905",
                                        "glosses": [
                                            "Ensemble des individus d'un territoire ou d'une société, sans distinction particulière de caractéristiques ou de sous-groupes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0632bfb1-5de1-46a8-a687-7cc7e34407c3",
                                                "sense_id": "d4a1603c-e50d-3978-adda-feff8b30ca57",
                                                "text": "Ceci traduit peut-être la persistance, au-delà de la première période de confinement, d’une souffrance psychologique marquée dans la population générale du fait des conséquences sociales et économiques de la pandémie et des mesures mises en place pour l’endiguer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a9a518c-0e8e-392f-8afc-e8fee5228f0c",
                                        "entry_id": "d97abefa-5663-3131-bd2a-ff8609233905",
                                        "glosses": [
                                            "Population carcérale principale d'une prison, à l'exclusion des détenus placés en isolement, en détention protectrice, à l'infirmerie ou dans le couloir de la mort."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c309d03b-7ea4-4120-b81b-689ff6989d0a",
                                                "sense_id": "2a9a518c-0e8e-392f-8afc-e8fee5228f0c",
                                                "text": "GP ou \"Gen Pop\" : Population générale. Il s'agit de la population générale des personnes incarcérées qui n'ont pas été placées dans des logements spéciaux pour des raisons disciplinaires ou de protection."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
