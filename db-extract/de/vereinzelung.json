                    {
                        "sense_id": "41eaf234-2a61-32b4-925c-93d00b86d813",
                        "entry_id": "ee8bf5bf-0d07-35d6-8b4a-bc108aba7ef0",
                        "glosses": [
                            "Isolierung aus dem eigenen Umfeld"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50203cd4-bdb8-4c36-a541-15197267f45a",
                                "sense_id": "41eaf234-2a61-32b4-925c-93d00b86d813",
                                "text": "„Anders die Anachoreten und Mystiker, die sich traditionell an einsame Orte zurückzuziehen pflegten und für die dem Berggang weiterhin die Bedeutung einer religiös motivierten Entrückung und Vereinzelung zukommt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "08966dc1-d322-4ac7-8f9c-edcccd3e0e9c",
                        "source_entry_id": "ee8bf5bf-0d07-35d6-8b4a-bc108aba7ef0",
                        "source_sense_id": "41eaf234-2a61-32b4-925c-93d00b86d813",
                        "source_sense_description": "Isolierung aus dem eigenen Umfeld",
                        "target_lang_word": "isolation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "isolation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5a311704-691d-31d2-9b69-94d152943c48",
                                        "entry_id": "526bb7a6-89ef-348d-8d4c-08906688abdd",
                                        "glosses": [
                                            "The state of being isolated, detached, or separated; the state of being away from other people."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "41aac01a-4cb6-49f7-8ff7-1888161669b3",
                                                "sense_id": "5a311704-691d-31d2-9b69-94d152943c48",
                                                "text": "She lived her final year in complete isolation, not wanting to see anybody."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ddfc46de-d4f4-3290-a562-07c4951ed72d",
                                        "entry_id": "526bb7a6-89ef-348d-8d4c-08906688abdd",
                                        "glosses": [
                                            "The act of isolating."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e561377e-e28f-3986-bfcf-0c5ca0b6af5b",
                                        "entry_id": "526bb7a6-89ef-348d-8d4c-08906688abdd",
                                        "glosses": [
                                            "The state of not having diplomatic relations with other countries (either with most or all other countries, or with specified other countries)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "19b944d0-67dd-488a-9634-99708c6a3308",
                                                "sense_id": "e561377e-e28f-3986-bfcf-0c5ca0b6af5b",
                                                "text": "As of 1975, diplomatic ostracism is still imposed by the Organization of American States (OAS). The inter-American community also exercises a trade embargo against Cuba. But even within this context of hemispheric isolation, Havana’s diplomacy is strikingly contradictory."
                                            },
                                            {
                                                "example_id": "8e1746ab-1905-401f-8065-029699eae845",
                                                "sense_id": "e561377e-e28f-3986-bfcf-0c5ca0b6af5b",
                                                "text": "Israel could offer to ease North Korea’s isolation with diplomatic recognition, […] ¶ […] But Washington’s strategy of increasing North Korean isolation left no room for back-channel talks with Tel Aviv, […]"
                                            },
                                            {
                                                "example_id": "fd632939-d090-48e6-a7a6-64494369cfb6",
                                                "sense_id": "e561377e-e28f-3986-bfcf-0c5ca0b6af5b",
                                                "text": "It [Europe] now pressed Washington to begin direct talks with Tehran, but Undersecretary of State Nicholas Burns, Rice’s point man on Iran, still stressed that diplomatic isolation of Iran—and not diplomatic engagement—was the only acceptable approach for dealing with the Iranian nuclear challenge."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0812b7e1-f4a4-38b7-bc6b-5a405858f016",
                                        "entry_id": "526bb7a6-89ef-348d-8d4c-08906688abdd",
                                        "glosses": [
                                            "The obtaining of an element from one of its compounds, or of a compound from a mixture"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "87a1e08a-462e-3dbd-8fea-57d2ba5dc08d",
                                        "entry_id": "526bb7a6-89ef-348d-8d4c-08906688abdd",
                                        "glosses": [
                                            "The separation of a patient, suffering from a contagious disease, from contact with others (compare: quarantine)"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f95c81da-6f9a-49b1-8533-d1485407bb79",
                                                "sense_id": "87a1e08a-462e-3dbd-8fea-57d2ba5dc08d",
                                                "text": "Upon returning from the field, he went into isolation for a week so as not to infect anyone with potential diseases."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69968765-fd49-32d1-9be2-8c0def42e066",
                                        "entry_id": "526bb7a6-89ef-348d-8d4c-08906688abdd",
                                        "glosses": [
                                            "A database property that determines when and how changes made in one transaction are visible to other concurrent transactions."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "13b7ef9d-0488-396a-ae27-dc3e1beeccd4",
                                        "entry_id": "526bb7a6-89ef-348d-8d4c-08906688abdd",
                                        "glosses": [
                                            "A Freudian defense mechanism in which a person suppresses a harmful thought from developing into a train of thought."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "80fad8b2-082f-4a7a-8f15-e283c6659e51",
                        "source_entry_id": "ee8bf5bf-0d07-35d6-8b4a-bc108aba7ef0",
                        "source_sense_id": "41eaf234-2a61-32b4-925c-93d00b86d813",
                        "source_sense_description": "Isolierung aus dem eigenen Umfeld",
                        "target_lang_word": "separation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "separation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "31540f68-47aa-333a-b9d7-75933aef23d4",
                                        "entry_id": "72ab5178-bc32-38a2-ae0f-63f22254821c",
                                        "glosses": [
                                            "The act of disuniting two or more things, or the condition of being separated."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9781b8ef-38ab-300e-900a-98aab9cdd453",
                                        "entry_id": "72ab5178-bc32-38a2-ae0f-63f22254821c",
                                        "glosses": [
                                            "The act or condition of two or more people being separated from one another."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac03e60a-540f-41d5-9da1-8a24b88a1b2e",
                                                "sense_id": "9781b8ef-38ab-300e-900a-98aab9cdd453",
                                                "text": "We were a band of brothers, and never dearer to each other than now. The thought which gave us the most pain, was the probable separation which would now take place, in case we were sold off to the far south, as we were likely to be."
                                            },
                                            {
                                                "example_id": "b90253d7-dae2-4025-b701-afd9fde9474c",
                                                "sense_id": "9781b8ef-38ab-300e-900a-98aab9cdd453",
                                                "text": "[…] my longing for her was undiminished despite our months of near-complete separation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "394528e7-11e5-383b-8a74-9785625665b0",
                                        "entry_id": "72ab5178-bc32-38a2-ae0f-63f22254821c",
                                        "glosses": [
                                            "The act or condition of a married couple living in separate homes while remaining legally married."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "30ffcace-0f9b-479e-a1cd-70919afbfd2b",
                                                "sense_id": "394528e7-11e5-383b-8a74-9785625665b0",
                                                "text": "‘If he dares to refuse me a separation, I’ll have one in law—I can—and I hope this will be a warning to all girls who have seen this disgraceful exhibition.’"
                                            },
                                            {
                                                "example_id": "3198795d-13d9-48f6-b78d-3b43a5c300d5",
                                                "sense_id": "394528e7-11e5-383b-8a74-9785625665b0",
                                                "text": "[…] she [knows] her great-aunt’s concern over her son Warren, his two divorces, and now Alice’s bitter separation from her husband, Ben."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "beb8bd66-56e2-39c0-8bd0-f0219241da96",
                                        "entry_id": "72ab5178-bc32-38a2-ae0f-63f22254821c",
                                        "glosses": [
                                            "The act or condition of a married couple living in separate homes while remaining legally married.",
                                            "An agreement legalizing such an arrangement."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5cfbe4be-7651-48b3-97c5-7b656a121140",
                                                "sense_id": "beb8bd66-56e2-39c0-8bd0-f0219241da96",
                                                "text": "I should have gone back to her the day after the fair, if it hadn't been for you talking about the law, and rubbish about getting a separation;"
                                            },
                                            {
                                                "example_id": "e32477bc-ab34-4983-a0cd-3d45d431fd86",
                                                "sense_id": "beb8bd66-56e2-39c0-8bd0-f0219241da96",
                                                "text": "“You are deserting me?”\n“Don’t be the neglected, dramatic wife, Scarlett. The rôle isn’t becoming. I take it, then, you do not want a divorce or even a separation? Well, then, I’ll come back often enough to keep gossip down.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e62f04ba-8897-399a-977f-6ab144ebca79",
                                        "entry_id": "72ab5178-bc32-38a2-ae0f-63f22254821c",
                                        "glosses": [
                                            "The place at which a division occurs."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d6bb9889-962e-4778-8532-4528717db04c",
                                                "sense_id": "e62f04ba-8897-399a-977f-6ab144ebca79",
                                                "text": "I was now on the separation of two vast water-sheds; behind me all the streams were bound for the Garonne and the Western Ocean; before me was the basin of the Rhone."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c392145a-05ae-3c86-b877-515d7862e8ef",
                                        "entry_id": "72ab5178-bc32-38a2-ae0f-63f22254821c",
                                        "glosses": [
                                            "An interval, gap or space that separates things or people."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "50fb3e8a-cec4-4b58-9a99-46cb5bc75e9a",
                                                "sense_id": "c392145a-05ae-3c86-b877-515d7862e8ef",
                                                "text": "[…] gentle friend, for love and courtesy\nLie further off; in human modesty,\nSuch separation as may well be said\nBecomes a virtuous bachelor and a maid,\nSo far be distant;"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cd5b588e-3ba7-35fd-9063-0ea3a1965187",
                                        "entry_id": "72ab5178-bc32-38a2-ae0f-63f22254821c",
                                        "glosses": [
                                            "An object that separates two spaces."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec754414-8007-425e-829d-ea5a961cf168",
                                                "sense_id": "cd5b588e-3ba7-35fd-9063-0ea3a1965187",
                                                "text": "[The orchard] was full of trees, it bloomed with flowers: a very high wall shut it out from the court, on one side; on the other, a beech avenue screened it from the lawn. At the bottom was a sunk fence; its sole separation from lonely fields:"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f3a61a2-beb2-345a-b206-7d32898cabdb",
                                        "entry_id": "72ab5178-bc32-38a2-ae0f-63f22254821c",
                                        "glosses": [
                                            "Departure from active duty, while not necessarily leaving the service entirely."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
