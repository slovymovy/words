                {
                    "sense_id": "4c47434a-4a90-314b-bedb-007dd34ef4cb",
                    "sense_definition": "Promptness, speed, or efficiency in performing a task.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "speed_concept",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We must resolve this urgent matter with all possible <w>expedition</w>.",
                            "target_lang_translations": {
                                "ru": "Мы должны решить этот срочный вопрос со всей возможной <w>быстротой</w>.",
                                "zh": "我们必须以最快的<w>速度</w>处理这件紧急事务。",
                                "es": "Debemos resolver este asunto urgente con toda la <w>prontitud</w> posible.",
                                "tr": "Bu acil meseleyi mümkün olan en büyük <w>çabuklukla</w> çözmeliyiz.",
                                "de": "Wir müssen diese dringende Angelegenheit mit aller möglichen <w>Schnelligkeit</w> lösen."
                            }
                        },
                        {
                            "text": "The messenger delivered the package with great <w>expedition</w>.",
                            "target_lang_translations": {
                                "ru": "Курьер доставил посылку с огромной <w>скоростью</w>.",
                                "zh": "信使非常<w>迅速</w>地送达了包裹。",
                                "es": "El mensajero entregó el paquete con gran <w>celeridad</w>.",
                                "tr": "Haberci paketi büyük bir <w>ivedilikle</w> teslim etti.",
                                "de": "Der Bote lieferte das Paket mit großer <w>Eile</w> aus."
                            }
                        }
                    ],
                    "synonyms": [
                        "speed",
                        "haste",
                        "dispatch",
                        "alacrity",
                        "swiftness"
                    ],
                    "antonyms": [
