                        "sense_id": "ffcceb4c-c2c3-3601-9dbe-e7e8beedd13d",
                        "entry_id": "360b26f6-5b04-3911-a7a4-acc26d97fa6d",
                        "glosses": [
                            "Angehöriger der gleichnamigen katholischen Brüdergemeinschaft, die in der Krankenpflege tätig ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b86fee1-82ab-4daa-8852-ea0bc433b91a",
                                "sense_id": "ffcceb4c-c2c3-3601-9dbe-e7e8beedd13d",
                                "text": "Die nach dem heiligen Alexius von Edessa benannten Alexianer sind in vielen Ländern tätig."
                            },
                            {
                                "example_id": "c0c7f0ed-916d-49c8-8183-2c681312f057",
                                "sense_id": "ffcceb4c-c2c3-3601-9dbe-e7e8beedd13d",
                                "text": "„Vor 800 Jahren gründeten die Alexianer eine katholische Brüderschaft, über Jahrhunderte sah der Orden die Pflege psychisch Kranker als seine Aufgabe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
