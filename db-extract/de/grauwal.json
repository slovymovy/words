                "senses": [
                    {
                        "sense_id": "46580cd5-fc08-34b4-8e40-5a053465f87e",
                        "entry_id": "d99f7b45-5539-3655-a954-852e0e362dce",
                        "glosses": [
                            "Art aus der Ordnung der Wale mit Hautfarbe zwischen Schwarz und Weiß; einzelnes Exemplar dieser Art"
                        ],
                        "tags": [
                            "auch"
                        ],
                        "examples": [
                            {
                                "example_id": "cac9d833-2b7b-4049-a9b1-bc327b2bf941",
                                "sense_id": "46580cd5-fc08-34b4-8e40-5a053465f87e",
                                "text": "„Nur beim Grauwal, der sich weitgehend im nationalen Kontrollbereich nordamerikanischer Küstengewässer bewegt und der in den Lagunen von Baja California den Winter verbringt, ergab sich eine deutlich positive Bilanz.“"
                            },
                            {
                                "example_id": "884284f6-6dd1-4e3d-87f4-8ef0a48f7fe4",
                                "sense_id": "46580cd5-fc08-34b4-8e40-5a053465f87e",
                                "text": "Der Grauwal ist eines der größten Lebewesen unter den noch lebenden Tieren der Welt."
                            },
                            {
                                "example_id": "77c506ad-6011-4f05-8216-24f066588345",
                                "sense_id": "46580cd5-fc08-34b4-8e40-5a053465f87e",
                                "text": "Grauwale ziehen im Sommer bis zu 10000 Kilometer weit ins Eismeer."
                            },
                            {
                                "example_id": "4e04f3d2-8e7c-4e12-9624-657481a0ac94",
                                "sense_id": "46580cd5-fc08-34b4-8e40-5a053465f87e",
                                "text": "Der Grauwal ist wie kein anderer Wal von Parasiten besiedelt."
                            },
                            {
                                "example_id": "33337204-bd8a-49d2-9958-aac1de9245dc",
                                "sense_id": "46580cd5-fc08-34b4-8e40-5a053465f87e",
                                "text": "Da schwimmt ein Grauwal neben dem Boot."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
