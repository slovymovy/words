                "senses": [
                    {
                        "sense_id": "b031cc27-e537-37cc-84d0-d5761e89a3cd",
                        "entry_id": "7f6a31c8-162e-3ad4-a70b-d452a66a78d8",
                        "glosses": [
                            "Nommer chevalier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ce271e5-e691-4eab-a73b-ce75cd5f676f",
                                "sense_id": "b031cc27-e537-37cc-84d0-d5761e89a3cd",
                                "text": "Nous avons vu de nos propres yeux la plupart des riches égoïstes couronnés, ducalisés, baronisés, chevalerisés, immortalisés, ne pouvoir pas entrer chacun dans leur royaume d’ici bas pour s’être trop nourris du pain des autres, et nous devons admirer la profondeur de la doctrine céleste qui exclut du Royaume Céleste tous les chrétiens riches, mais cupides, inhumains et égoïstes."
                            },
                            {
                                "example_id": "c799aaeb-44de-4a07-97ac-426528316c16",
                                "sense_id": "b031cc27-e537-37cc-84d0-d5761e89a3cd",
                                "text": "Je te trouve pas dans le registre, tu es sûr que tu as déjà été chevalerisé ?"
                            },
                            {
                                "example_id": "9aeb917e-d52d-4dbc-8b7b-e15d278491ea",
                                "sense_id": "b031cc27-e537-37cc-84d0-d5761e89a3cd",
                                "text": "J’espère être chevalerisé ou adoubé."
                            }
                        ]
                    }
                ],
