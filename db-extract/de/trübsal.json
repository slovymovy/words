                "senses": [
                    {
                        "sense_id": "416f5629-cf41-3803-ba71-c6ea0691ef66",
                        "entry_id": "1c77697a-fd73-386c-b3c0-59ae3087e627",
                        "glosses": [
                            "a sad, troubled emotional state"
                        ],
                        "tags": [
                            "feminine",
                            "formal",
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "7f8d6f09-8380-420a-9ffb-97997dc7f1a2",
                                "sense_id": "416f5629-cf41-3803-ba71-c6ea0691ef66",
                                "text": "Mein bester Freund steht mir auch in Zeiten der Trübsal bei.",
                                "translation": "My best friend stands by me, even in times of sadness",
                                "english": "My best friend stands by me, even in times of sadness"
                            },
                            {
                                "example_id": "34571d01-adf5-4283-b674-c699682ff6a6",
                                "sense_id": "416f5629-cf41-3803-ba71-c6ea0691ef66",
                                "text": "Ihr beyden die ihr mir so oft, / In Noth und Trübsal, beygestanden, / Sagt was ihr wohl, in deutschen Landen, / Von unsrer Unternehmung hofft?",
                                "translation": "Faust, Part One",
                                "english": "Faust, Part One"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
