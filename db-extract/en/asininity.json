                                            {
                                                "example_id": "b42e94be-4485-4270-9650-7fbb6c27c416",
                                                "sense_id": "b8f78e57-ede3-3042-8389-392ee078be0c",
                                                "text": "Die Dämlichkeit des Trolls ist nicht leicht zu überbieten."
                                            },
                                            {
                                                "example_id": "852e230d-cf48-461d-b0b0-7c9fbfe1fef4",
                                                "sense_id": "b8f78e57-ede3-3042-8389-392ee078be0c",
                                                "text": "„Lass dir hier draußen, sagte er, bloß nicht aus Dämlichkeit den Arsch wegschießen..“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c9a888ba-1f81-34ee-8836-b850486acf32",
                                        "entry_id": "0c4ce7b1-43a8-3567-8489-50beb637f573",
                                        "glosses": [
                                            "eine Handlung die dumm oder albern ist"
                                        ],
                                        "tags": [],
                                        "examples": [
