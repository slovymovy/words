                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "a2a931ac-5c8d-481f-ad43-8f0d04b99e58",
                        "source_entry_id": "74eed4a5-63d8-355d-a4bf-bdbe946f3fb5",
                        "source_sense_id": "6b64da2d-83b2-3518-9c9f-799f402026d9",
                        "target_lang_word": "coenzyme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "coenzyme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7676c037-1fc2-31bd-adf9-c59460ee9c5f",
                                        "entry_id": "755dfd2b-47e6-3a62-9523-a943385f911b",
                                        "glosses": [
                                            "Structure active non protéique participant au mécanisme réactionnel catalysé par une enzyme, soit comme molécule attachée de façon covalente appelée groupement prosthétique (e.g. phosphate de pyridoxal), soit comme cofacteur lié par interactions dites faibles (de type électrostatique ou de van der Waals) et agissant comme co-catalyseur ou comme donneur d'une structure qui sera transférée au substrat au cours de la réaction (e.g. succinyl-CoA)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca8651fe-02d2-4005-ad07-e41f66b28d9e",
                                                "sense_id": "7676c037-1fc2-31bd-adf9-c59460ee9c5f",
                                                "text": "La combinaison de la coenzyme et de l’apoenzyme forme l’hétéroenzyme."
                                            },
                                            {
                                                "example_id": "63dbe539-1d58-4436-9f23-57d1c5ff3e04",
                                                "sense_id": "7676c037-1fc2-31bd-adf9-c59460ee9c5f",
                                                "text": "Le coenzyme est toujours associé à l’enzyme au cours de la réaction de catalyse."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
