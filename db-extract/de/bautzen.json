                                "sense_id": "14548f03-f67c-3d45-804c-d1ec33681174",
                                "text": "Wo liegt eigentlich Bautzen?"
                            },
                            {
                                "example_id": "c7c61de1-7b78-4d6f-975c-78471ff7c7b7",
                                "sense_id": "14548f03-f67c-3d45-804c-d1ec33681174",
                                "text": "Bautzen hat die Postleitzahl 02625."
                            },
                            {
                                "example_id": "26125692-dee0-4be2-a2d2-d066ef8dcab6",
                                "sense_id": "14548f03-f67c-3d45-804c-d1ec33681174",
                                "text": "Das mittelalterliche Bautzen hatte einen großen Bekanntheitsgrad."
                            },
                            {
                                "example_id": "86fec226-49ac-4190-ac3d-94b8c67fad62",
                                "sense_id": "14548f03-f67c-3d45-804c-d1ec33681174",
                                "text": "Ich bin in Bautzen geboren."
                            },
                            {
                                "example_id": "9774448c-19f3-4b5c-87bc-03458b97dd20",
                                "sense_id": "14548f03-f67c-3d45-804c-d1ec33681174",
                                "text": "Wir haben in Bautzen unseren Urlaub verbracht."
                            },
                            {
                                "example_id": "e8372a8c-2e03-4001-a9bb-999257a82d14",
                                "sense_id": "14548f03-f67c-3d45-804c-d1ec33681174",
                                "text": "Nach Bautzen führen viele Wege."
                            },
                            {
                                "example_id": "194af321-7a03-4a9b-ae18-a706b698e1e6",
                                "sense_id": "14548f03-f67c-3d45-804c-d1ec33681174",
                                "text": "Bautzen liegt auf der Nordhalbkugel."
                            },
                            {
                                "example_id": "b39c0fce-6923-401a-b92d-0c77f6b74731",
                                "sense_id": "14548f03-f67c-3d45-804c-d1ec33681174",
                                "text": "„Das Klarissenkloster in Bautzen wird nun aufgelöst.“"
                            }
                        ],
