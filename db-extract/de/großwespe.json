                ],
                "senses": [
                    {
                        "sense_id": "e1997bb6-f63e-3c57-9749-354ec098d911",
                        "entry_id": "1317a9af-4f11-33ab-921f-7b6a3e93e40a",
                        "glosses": [
                            "alternativer Name für Mitglieder der Gattung Vespa oder der Hornissen"
                        ],
                        "tags": [
                            "Entomologie"
                        ],
                        "examples": [
                            {
                                "example_id": "0c5e0100-68ae-4f8f-b19e-2497688f5c92",
                                "sense_id": "e1997bb6-f63e-3c57-9749-354ec098d911",
                                "text": "„Zum anderen machen wir den Lebensraum der imposanten Großwespe kaputt: Aus »Ödland« und »ungepflegten« Wäldern werden Ackerland und Parklandschaften, in denen die Hornissen kaum leben können.“"
                            },
                            {
                                "example_id": "3aabdf06-8b02-4e09-b62e-727208779a1a",
                                "sense_id": "e1997bb6-f63e-3c57-9749-354ec098d911",
                                "text": "„Heute schützen auch die Imker die Hornisse, weil diese stattliche Großwespe recht selten geworden ist.“"
                            },
                            {
                                "example_id": "f2b3d4e5-6790-4863-9843-4b9174a6236f",
                                "sense_id": "e1997bb6-f63e-3c57-9749-354ec098d911",
                                "text": "„Die Stichwirkung kommt wohl der unserer Hornisse gleich, glücklicherweise ist aber unsere einheimische Großwespe weniger angriffslustig.“"
                            },
                            {
                                "example_id": "7bf49a59-b603-4df1-b20f-b7441fa48a14",
                                "sense_id": "e1997bb6-f63e-3c57-9749-354ec098d911",
                                "text": "„So tragen manche Arten überhaupt keine Flügel, während der Hornissenglasflügler sich das Aussehen der gefährlichen Großwespe verpasst hat. Es soll ihn vor Fressfeinden schützen.“"
                            },
                            {
                                "example_id": "8f2e9f39-7fe1-4054-93e3-77befa0a0b8e",
                                "sense_id": "e1997bb6-f63e-3c57-9749-354ec098d911",
                                "text": "„Andere Kerbtiere, wie die verschiedenen Arten der Klein- und Großwespen, stürzen sich mit aller Gier auf eine etwa verschüttete Weinmenge und taumeln dann, lange Zeit flugunfähig, mit halbgelähmten Beinen herum.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
