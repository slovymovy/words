                "forms": [
                    {
                        "form_id": "610cde39-86ea-4978-8e18-8adb11341994",
                        "entry_id": "0d120719-896e-3d79-b63c-cad6ef878822",
                        "tags": [
                            "plural"
                        ],
                        "form": "décélérations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d6ad91c5-2d8b-3bf3-adba-15a6f9578d41",
                        "entry_id": "0d120719-896e-3d79-b63c-cad6ef878822",
                        "glosses": [
                            "Diminution de la vitesse (accélération négative)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aaee989d-0bb2-4482-8f74-44c14fbb788d",
                                "sense_id": "d6ad91c5-2d8b-3bf3-adba-15a6f9578d41",
                                "text": "Un homme aurait résisté dès le mois d'août dernier aux épreuves physiques de vol spatial, y compris l’impondérabilité, les accélérations et les décélérations de la mise à feu des divers étages de la fusée […]."
                            },
                            {
                                "example_id": "e9e10f91-d672-4131-8539-2869d0ece11e",
                                "sense_id": "d6ad91c5-2d8b-3bf3-adba-15a6f9578d41",
                                "text": "Le freinage sur route mouillée ne permet qu'une décélération de moitié par rapport aux conditions normales de conduite."
                            },
                            {
                                "example_id": "512ccb96-1332-4c1b-b003-fa5d5dea3b1e",
                                "sense_id": "d6ad91c5-2d8b-3bf3-adba-15a6f9578d41",
                                "text": "Le troisième projet de loi de finances rectificative pour 2009 s’inscrit dans un contexte de reprise de l’activité économique et d’une très nette décélération du rythme des destructions d’emploi."
                            }
                        ]
                    },
                    {
                        "sense_id": "f98c1630-80e0-3724-86ab-8606a1c577d4",
                        "entry_id": "0d120719-896e-3d79-b63c-cad6ef878822",
                        "glosses": [
                            "Diminution de la croissance."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "8c6fd863-f762-40d5-8811-c13ff0698773",
                                "sense_id": "f98c1630-80e0-3724-86ab-8606a1c577d4",
                                "text": "La décélération de l'économie."
                            }
                        ]
                    },
                    {
                        "sense_id": "84894c01-e0b5-3aa9-8a4a-76c132de6433",
                        "entry_id": "0d120719-896e-3d79-b63c-cad6ef878822",
                        "glosses": [
                            "Montant de la diminution de la vélocité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4e5f590-79d4-435c-8ae1-54f3ec7396bc",
                                "sense_id": "84894c01-e0b5-3aa9-8a4a-76c132de6433",
                                "text": "Une décélération de dix mètres par seconde."
                            },
                            {
                                "example_id": "1125689e-de67-4c70-986e-3ae2ea456c95",
                                "sense_id": "84894c01-e0b5-3aa9-8a4a-76c132de6433",
                                "text": "En cosmologie, le paramètre de décélération est la quantité qui décrit l'évolution de l'expansion de l'univers. Ce paramètre est positif lorsque l'évolution de la distance entre deux objets distants dans l'univers décélère au cours du temps, et est négatif dans le cas contraire."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e1596acb-225e-43d7-881d-a8a96af26b37",
                        "source_entry_id": "0d120719-896e-3d79-b63c-cad6ef878822",
                        "target_lang_word": "deceleration",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "deceleration",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e843de85-15fd-3a54-a004-f4e49b90e9c0",
                                        "entry_id": "0a74a8ef-ce76-32e1-a255-243ac225b4a8",
                                        "glosses": [
                                            "The act or process of decelerating."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29647f06-3f8a-4705-a27f-601767ee1b65",
                                                "sense_id": "e843de85-15fd-3a54-a004-f4e49b90e9c0",
                                                "text": "The rocket is now in deceleration."
                                            },
                                            {
                                                "example_id": "506aba63-c8e3-4d3e-ba72-d709c31ef00f",
                                                "sense_id": "e843de85-15fd-3a54-a004-f4e49b90e9c0",
                                                "text": "Comparing both Regions' 1959 services against those of 1939 an appreciable deceleration is evident. This was due to increased loadings, even though more trains were being run, while on the W.R. in particular the increased volume of freight traffic over the line shared the blame."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "349ce307-8bbf-3c8e-b6af-af4d2749dcf7",
                                        "entry_id": "0a74a8ef-ce76-32e1-a255-243ac225b4a8",
                                        "glosses": [
                                            "The amount by which a speed or velocity decreases (and so a scalar quantity or a vector quantity), an acceleration having a negative numerical value."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "48565163-7414-4e00-84c8-1a2e8c5ef2a9",
                                                "sense_id": "349ce307-8bbf-3c8e-b6af-af4d2749dcf7",
                                                "text": "The brakes produce a deceleration of 10 metres per second."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
