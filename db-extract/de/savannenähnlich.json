                ],
                "senses": [
                    {
                        "sense_id": "0cf9b81a-7626-3d62-a293-c1c1b70f2ca5",
                        "entry_id": "f5985a4b-24c7-32f9-a856-9ca1d569f6c2",
                        "glosses": [
                            "einer Savanne ähnelnd, an eine Savanne erinnernd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fcea2aca-c025-472a-922d-e7289c1504a4",
                                "sense_id": "0cf9b81a-7626-3d62-a293-c1c1b70f2ca5",
                                "text": "„Sie alle haben gelbe Sonnen und zeigen savannenähnliche Landschaften, städtische Strukturen oder unendliche Wüsteneien.“"
                            },
                            {
                                "example_id": "31e33aba-dd79-4279-8423-8afd69beebe0",
                                "sense_id": "0cf9b81a-7626-3d62-a293-c1c1b70f2ca5",
                                "text": "„Unter ihm, etwa zehn Kilometer südlich des Sees, breitete sich eine savannenähnliche und kaum besiedelte Gegend aus.“"
                            },
                            {
                                "example_id": "2d0e7923-98b0-4b3e-96b9-4c7a51c69588",
                                "sense_id": "0cf9b81a-7626-3d62-a293-c1c1b70f2ca5",
                                "text": "„Nicht dichte Wälder, Dschungel oder Sümpfe, sondern savannenähnliche Landschaften scheinen die Umgebung zu sein, in der wir uns am wohlsten und friedlichsten fühlen.“"
                            },
                            {
                                "example_id": "c01a3e68-9ceb-4fbd-98db-f124ea47a896",
                                "sense_id": "0cf9b81a-7626-3d62-a293-c1c1b70f2ca5",
                                "text": "„Der savannenähnliche Knuthenborg Safaripark mit seinen mehr als 800 freilebenden, exotischen Tieren gehört zu den schönsten Anlagen seiner Art in Europa.“"
                            },
                            {
                                "example_id": "5218ab32-8631-4c4a-bee8-1623ad883137",
                                "sense_id": "0cf9b81a-7626-3d62-a293-c1c1b70f2ca5",
                                "text": "„Oliven- und Mandelbäume, Vulkankegel, Canyons, Quellen, Flüsse und Wasserfälle prägen die Landschaft, aber auch savannenähnliche, karge Landstriche.“"
