                        "entry_id": "861db946-d2ec-3fa3-8570-06229d40b5dd",
                        "glosses": [
                            "Qui est situé entièrement d'un des côtés du corps."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "abc0f5c3-0c8b-408f-8df0-10be228218c5",
                                "sense_id": "ec233271-bdd8-3672-a029-3292d652a130",
                                "text": "Les cellules des cordons tautomères, c'est-à-dire des éléments nerveux dont le prolongement cylindre-axile se rend dans les cordons du même côté de la moelle."
                            }
                        ]
                    },
                    {
                        "sense_id": "63e86385-e63e-33cb-8215-1cb4835eee65",
                        "entry_id": "861db946-d2ec-3fa3-8570-06229d40b5dd",
                        "glosses": [
                            "Qualifie certains corps qui se présentent sous plusieurs formes."
                        ],
                        "tags": [
                            "Stéréochimie"
                        ],
                        "examples": [
                            {
                                "example_id": "319dfac4-bcc2-4640-952c-c45c6f7a48ff",
                                "sense_id": "63e86385-e63e-33cb-8215-1cb4835eee65",
                                "text": "Bien que deux tautomères soient des isomères en équilibre rapide d’un même composé, leurs matrices de connectivités ne sont pas identiques."
                            }
                        ]
                    }
                ],
