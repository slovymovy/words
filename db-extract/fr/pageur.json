                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d40b3c6f-4826-4417-affe-53ab09fc11dd",
                                                "sense_id": "5f714354-7402-3c43-b78a-12001a79fc02",
                                                "text": "Der guckt wieder nach seinen Piepern."
                                            },
                                            {
                                                "example_id": "01a7416f-b142-464b-9a47-89da7a22ed6e",
                                                "sense_id": "5f714354-7402-3c43-b78a-12001a79fc02",
                                                "text": "Guck mal, was für ein niedlicher Pieper!"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "d70f4c4d-1636-39ad-a91a-1f551e74dd24",
                                        "entry_id": "ae63647b-f648-3879-8c06-02cfc8dab804",
                                        "glosses": [
                                            "Funkmeldeempfänger"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "66894571-9b1c-46cb-9ffe-b10b9b725fbf",
                                                "sense_id": "d70f4c4d-1636-39ad-a91a-1f551e74dd24",
                                                "text": "Ich nehm' vorsichtshalber meinen Pieper mit."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Pieper",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1e1348e2-1457-3e40-b29b-c809f9f43d7a",
                                        "entry_id": "bbccc69d-f70f-36ef-80a7-d7343f9a2c44",
                                        "glosses": [
                                            "deutschsprachiger Familienname, Nachname, niederdeutsche, norddeutsche Form von Pfeifer"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ea6b491-98bb-4f9c-9431-0eaaafd67b73",
                                                "sense_id": "1e1348e2-1457-3e40-b29b-c809f9f43d7a",
                                                "text": "Frau Pieper ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "e5084979-6895-4014-96aa-9ec782603a40",
                                                "sense_id": "1e1348e2-1457-3e40-b29b-c809f9f43d7a",
                                                "text": "Herr Pieper wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "19d7eb87-933c-4013-a1d1-d62bf5e72a18",
                                                "sense_id": "1e1348e2-1457-3e40-b29b-c809f9f43d7a",
                                                "text": "Die Piepers kommen heute aus Neuss."
                                            },
                                            {
                                                "example_id": "a2b17670-4f41-41b7-b2f3-2d85610e8bfa",
                                                "sense_id": "1e1348e2-1457-3e40-b29b-c809f9f43d7a",
                                                "text": "Der Pieper trägt nie die Schals, die die Pieper ihm strickt."
                                            },
                                            {
                                                "example_id": "837fbef1-3713-4823-9dff-68cec996c9e9",
                                                "sense_id": "1e1348e2-1457-3e40-b29b-c809f9f43d7a",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Pieper kommt, geht der Herr Pieper.“"
                                            },
                                            {
                                                "example_id": "e7f8edd4-ecf6-4426-b4b2-92238e86be11",
                                                "sense_id": "1e1348e2-1457-3e40-b29b-c809f9f43d7a",
                                                "text": "Pieper kommt und geht."
                                            },
                                            {
                                                "example_id": "67c63b6f-57cb-4dc4-b38c-1263e13c7f50",
                                                "sense_id": "1e1348e2-1457-3e40-b29b-c809f9f43d7a",
                                                "text": "Piepers kamen, sahen und siegten."
                                            },
                                            {
                                                "example_id": "df68dc0f-1047-4cd9-948a-094a4b5ab1ec",
                                                "sense_id": "1e1348e2-1457-3e40-b29b-c809f9f43d7a",
                                                "text": "An verregneten Herbsttagen ist Familie Piepers liebste Beschäftigung das Bemalen von Hühnereiern."
                                            },
                                            {
                                                "example_id": "aaf206bb-1532-4914-96ce-b77177f82bfd",
                                                "sense_id": "1e1348e2-1457-3e40-b29b-c809f9f43d7a",
                                                "text": "An verschneiten Wintertagen ist die liebste Beschäftigung von Familie Pieper das Schmücken von Weihnachtsbäumen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e5afcdde-310d-47d0-9130-de47c5ee584d",
