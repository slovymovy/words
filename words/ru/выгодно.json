    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "1c015919-db2d-3eab-b8d8-01e87bd23b6e",
                    "sense_definition": "Полезно, приносит прибыль или преимущество; имеет смысл делать что-либо.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "predicative_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Нам <выгодно> работать вместе над этим проектом.",
                            "target_lang_translations": {
                                "en": "It is <beneficial> for us to work together on this project.",
                                "tr": "Bu proje üzerinde birlikte çalışmak bizim için <w>avantajlı</w>.",
                                "es": "Nos <w>resulta ventajoso</w> trabajar juntos en este proyecto.",
                                "fr": "Il est <w>avantageux</w> pour nous de travailler ensemble sur ce projet."
                            }
                        },
                        {
                            "text": "Экспортёрам <выгодно> снижение курса национальной валюты.",
                            "target_lang_translations": {
                                "en": "A depreciation of the national currency is <profitable> for exporters.",
                                "tr": "Ulusal para biriminin değer kaybetmesi ihracatçılar için <w>kârlıdır</w>.",
                                "es": "La caída de la moneda nacional es <w>beneficiosa</w> para los exportadores.",
                                "fr": "La baisse de la monnaie nationale est <w>profitable</w> aux exportateurs."
                            }
                        }
                    ],
                    "synonyms": [
                        "прибыльно",
                        "полезно"
                    ],
                    "antonyms": [
                        "невыгодно"
                    ],
                    "common_phrases": [
                        "экономически выгодно",
                        "мне выгодно",
                        "очень выгодно",
                        "взаимно выгодно"
                    ],
                    "target_lang_definitions": {
                        "en": "It is useful, profitable, or advantageous to do something.",
                        "tr": "Faydalı, kâr veya avantaj getiren; bir şeyi yapmanın mantıklı olması durumu.",
                        "es": "Es útil, beneficioso o ventajoso hacer algo; tiene sentido o resulta rentable.",
                        "fr": "Il est utile, profitable ou avantageux de faire quelque chose."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "profitable",
                                "target_lang_sense_clarification": "bringing financial gain"
                            },
                            {
                                "target_lang_word": "beneficial",
                                "target_lang_sense_clarification": "helpful or useful in general"
                            },
                            {
                                "target_lang_word": "advantageous",
                                "target_lang_sense_clarification": "providing a strategic advantage"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "kârlı",
                                "target_lang_sense_clarification": "maddi kazanç getiren"
                            },
                            {
                                "target_lang_word": "avantajlı",
                                "target_lang_sense_clarification": "fayda veya üstünlük sağlayan"
                            },
                            {
                                "target_lang_word": "faydalı",
                                "target_lang_sense_clarification": "yarar sağlayan"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "es ventajoso",
                                "target_lang_sense_clarification": "aporta una ventaja o beneficio"
                            },
                            {
                                "target_lang_word": "es beneficioso",
                                "target_lang_sense_clarification": "resulta útil o provechoso"
                            },
                            {
                                "target_lang_word": "es rentable",
                                "target_lang_sense_clarification": "trae beneficio económico"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "avantageux",
                                "target_lang_sense_clarification": "qui procure un bénéfice ou un avantage"
                            },
                            {
                                "target_lang_word": "profitable",
                                "target_lang_sense_clarification": "qui rapporte un gain financial ou moral"
                            },
                            {
                                "target_lang_word": "intéressant",
                                "target_lang_sense_clarification": "qui vaut la peine d'être fait"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "853ae32e-c768-3dea-af1f-9c0cc200253e",
                    "sense_definition": "Таким образом, который приносит доход, прибыль или пользу.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "manner_adverb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Вчера на базаре фермер <выгодно> продал свой товар.",
                            "target_lang_translations": {
                                "en": "Yesterday at the market, the farmer sold his goods <profitably>.",
                                "tr": "Dün pazarda çiftçi malını <w>kârlı bir şekilde</w> sattı.",
                                "es": "Ayer en el mercado, el agricultor vendió sus productos <w>con ganancias</w>.",
                                "fr": "Hier au marché, le fermier a vendu son produit <w>avantageusement</w>."
                            }
                        },
                        {
                            "text": "Это платье <выгодно> подчёркивает цвет её глаз.",
                            "target_lang_translations": {
                                "en": "This dress <advantageously> highlights the color of her eyes.",
                                "tr": "Bu elbise onun göz rengini <w>güzelce</w> ortaya çıkarıyor.",
                                "es": "Este vestido resalta <w>favorablemente</w> el color de sus ojos.",
                                "fr": "Cette robe met <w>avantageusement</w> en valeur la couleur de ses yeux."
                            }
                        }
                    ],
                    "antonyms": [
                        "невыгодно"
                    ],
                    "common_phrases": [
                        "выгодно купить",
                        "выгодно продать",
                        "выгодно отличаться",
                        "выгодно вложить"
                    ],
                    "target_lang_definitions": {
                        "en": "In a way that yields profit or presents something in a good light.",
                        "tr": "Gelir, kâr veya fayda sağlayacak şekilde; bir şeyi iyi bir ışıkta gösterecek biçimde.",
                        "es": "De una manera que aporta ingresos, ganancias, beneficio o hace resaltar algo positivamente.",
                        "fr": "D'une manière qui rapporte un revenu, un profit ou met en valeur."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "profitably",
                                "target_lang_sense_clarification": "with financial gain"
                            },
