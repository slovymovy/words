            {
                "entry_id": "04f271f2-0a40-3fab-8147-c57d8ac30ccf",
                "word": "willen",
                "pos": "postp",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "2d4278b3-d7b1-33de-98af-b13bfd662c22",
                        "entry_id": "04f271f2-0a40-3fab-8147-c57d8ac30ccf",
                        "glosses": [
                            "wegen etwas"
                        ],
                        "tags": [
                            "mit Genitiv",
                            "nur in fester Verbindung „um … willen“"
                        ],
                        "examples": [
                            {
                                "example_id": "ce6f3ba2-7dfb-4517-8118-b4e5ba8f5870",
                                "sense_id": "2d4278b3-d7b1-33de-98af-b13bfd662c22",
                                "text": "„Oft allerdings nicht als Söldner um des Geldes willen, sondern aus Überzeugung.“"
                            },
                            {
                                "example_id": "6a0ed9b1-bfd3-4d7f-a75f-05becdce7000",
                                "sense_id": "2d4278b3-d7b1-33de-98af-b13bfd662c22",
                                "text": "„Wären Sie auch bereit, in Kauf zu nehmen, wie Schröder als Regierungschef um der Reformen willen abgewählt zu werden?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "74e3642f-83b7-43c0-adbe-13e128386ba4",
                        "source_entry_id": "04f271f2-0a40-3fab-8147-c57d8ac30ccf",
                        "source_sense_id": "2d4278b3-d7b1-33de-98af-b13bfd662c22",
                        "source_sense_description": "mit Genitiv, nur in fester Verbindung „um … willen“",
                        "target_lang_word": "for the sake of",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "for the sake of",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6f0d6362-32cc-3675-b3b5-93cd44439788",
                                        "entry_id": "5b4e1a0c-8bbe-39c9-ac88-b8fa10298529",
                                        "glosses": [
                                            "Because of; out of consideration for; in the interest of."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5bfe1fe3-b2d8-45df-8bae-0c07f2e14e9b",
                                                "sense_id": "6f0d6362-32cc-3675-b3b5-93cd44439788",
                                                "text": "Release this man, for the sake of justice!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "03ca6df7-1db2-492c-b1ce-100d652aead4",
                        "source_entry_id": "04f271f2-0a40-3fab-8147-c57d8ac30ccf",
                        "source_sense_id": "2d4278b3-d7b1-33de-98af-b13bfd662c22",
                        "source_sense_description": "mit Genitiv, nur in fester Verbindung „um … willen“",
                        "target_lang_word": "on account of",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "on account of",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f6ecba6a-0886-3504-ae7e-6b79bf722d79",
                                        "entry_id": "eb4f1975-438e-3d90-a082-e691b6731ad7",
                                        "glosses": [
                                            "On behalf of the (monetary) account of; (idiomatic, originally figurative) for the sake of."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7559a031-88bf-4166-94a6-a83fb47b9fce",
                                                "sense_id": "f6ecba6a-0886-3504-ae7e-6b79bf722d79",
                                                "text": "[…] and His Imperial Majesty further agrees to pay to the British Government the sum of Three Millions of dollars, on account of debts due to British subjects by some of the said Hong merchants (or Cohong), who have become insolvent, and who owe very large sums of money to subjects of Her Britannic Majesty."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "42b0ce0f-f43f-37dd-9620-33742f2b4d76",
                                        "entry_id": "eb4f1975-438e-3d90-a082-e691b6731ad7",
                                        "glosses": [
                                            "Because of, due to, owing to."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "88c672f9-6889-4866-bace-67b400aa3437",
                                                "sense_id": "42b0ce0f-f43f-37dd-9620-33742f2b4d76",
                                                "text": "The rebuilding of damaged stations is proceeding slowly, on account of the shortage of building materials and the pressing needs of housing, but steady progress is being made."
                                            },
                                            {
                                                "example_id": "e1aafb49-9242-4f24-ad27-d0f6b7fdcaea",
                                                "sense_id": "42b0ce0f-f43f-37dd-9620-33742f2b4d76",
                                                "text": "‘My brother,[…], is at Radley, on account of my parents thinking it a bad idea to have us both at the same school.’\n‘On account of your being twins?’ said Adrian.\n‘Right, on account of my mother OD-ing on fertility drugs.[…]’"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "on account of",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "57a78a83-7010-30a4-a5a0-eaedc8432541",
                                        "entry_id": "009f998b-df91-3875-9912-3645e29814ec",
                                        "glosses": [
                                            "On account of the fact that: because, since."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9ba5c37-bfe7-4dbc-b5e9-3320664c98df",
                                                "sense_id": "57a78a83-7010-30a4-a5a0-eaedc8432541",
                                                "text": "[…] I had a pretty good notion of the weather conditions generally, on account of I was out in them."
                                            },
                                            {
                                                "example_id": "99be971b-ead9-421b-a68a-dd3689be3903",
                                                "sense_id": "57a78a83-7010-30a4-a5a0-eaedc8432541",
                                                "text": "Truth is I was the kind of fellow who people would run away from when they seen me coming on account of I was so full of facts and names and places and families I had to tell about."
                                            },
                                            {
                                                "example_id": "36d62895-6644-4ff0-80f9-b15b97d46f88",
                                                "sense_id": "57a78a83-7010-30a4-a5a0-eaedc8432541",
                                                "text": "After that, I resumed walking, on account of it involves little contact with strangers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "04407be7-c34e-4af2-9ec0-53c3ee7be093",
                        "source_entry_id": "04f271f2-0a40-3fab-8147-c57d8ac30ccf",
                        "source_sense_id": "2d4278b3-d7b1-33de-98af-b13bfd662c22",
                        "source_sense_description": "mit Genitiv, nur in fester Verbindung „um … willen“",
                        "target_lang_word": "à cause de",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "à cause de",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fa7dacf6-6528-347d-9648-a7c059486162",
                                        "entry_id": "c2dfade2-7212-3462-93f8-47a0b87102f7",
                                        "glosses": [
                                            "En conséquence de ; en considération de ; pour l’amour de. Contrairement à « grâce à », cette locution implique une connotation négative."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ad5056c-3199-42f4-965e-8c9d8ed1f13e",
                                                "sense_id": "fa7dacf6-6528-347d-9648-a7c059486162",
                                                "text": "Les arbres n’y viennent pas, il est vrai, si ce n’est dans les jardins abrités; mais c’est moins à cause du froid excessif qu’à cause des grands vents qui soufflent constamment de la mer."
                                            },
                                            {
                                                "example_id": "1b4b4fb8-279f-40df-8bf0-5da7b9846997",
                                                "sense_id": "fa7dacf6-6528-347d-9648-a7c059486162",
                                                "text": "Bakounine nous tendit les deux mains et, respirant difficilement, à cause de son asthme, se leva et se mit à s’habiller."
                                            },
                                            {
                                                "example_id": "5f4e7310-1f83-40f6-b597-330a1c35e6af",
                                                "sense_id": "fa7dacf6-6528-347d-9648-a7c059486162",
                                                "text": "Nous tenons à l’Alsace comme à une richesse, et nous ignorons cependant que ces petits bois sur la droite sont les bois de Nonnenbruch, qu’ils valent au plus juste, à cause de leur potasse, quatre-vingt milliards."
                                            },
                                            {
                                                "example_id": "ca01885d-da28-4ec9-a769-f2c68210393e",
                                                "sense_id": "fa7dacf6-6528-347d-9648-a7c059486162",
                                                "text": "Si Audrey a évité le collège public de son secteur à ses enfants, c’est en partie à cause de « sa sectorisation »."
                                            },
                                            {
                                                "example_id": "812172ec-6c11-4908-8573-5c918ce19cc7",
                                                "sense_id": "fa7dacf6-6528-347d-9648-a7c059486162",
                                                "text": "Les soldats et les gendarmes avaient l’ordre, s’il entendaient quelque bruit à l’intérieur des vagons à bestiaux, où les prisonniers étaient entassés pour les longues distances, de décharger leur révolver par les trous pratiqués à cause de l’air — (l’ordre fut exécuté)."
                                            },
                                            {
                                                "example_id": "456f7b8f-58bd-4ec8-b025-6dc810e3ec8b",
                                                "sense_id": "fa7dacf6-6528-347d-9648-a7c059486162",
                                                "text": "À cause de la diffraction, on ne peut pas diaphragmer notablement un objectif formant ses images sur un petit capteur."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
