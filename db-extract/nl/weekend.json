                        "target_lang_word": "Wochenende",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wochenende",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "102c6c05-9547-30d8-b164-de3ad5420e17",
                                        "entry_id": "bd3fd366-cd27-38af-a30a-1353855e99d0",
                                        "glosses": [
                                            "meist arbeits- und schulfreies Ende der Woche beziehungsweise die Tage Sonnabend und Sonntag"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f4973ec-608b-45c0-a180-c5bc6e7be2e7",
                                                "sense_id": "102c6c05-9547-30d8-b164-de3ad5420e17",
                                                "text": "Kommst du am Wochenende mit ins Kino?"
                                            },
                                            {
                                                "example_id": "9f283dda-b342-4dae-b2ee-e097133ba666",
                                                "sense_id": "102c6c05-9547-30d8-b164-de3ad5420e17",
                                                "text": "„Trotzdem ist es kein Wunder, dass dieses »Downgrading« am Wochenende rund um die Welt hohe Wellen geschlagen hat.“"
                                            },
                                            {
                                                "example_id": "c8186e91-122c-4d89-baba-7d563a24195f",
                                                "sense_id": "102c6c05-9547-30d8-b164-de3ad5420e17",
                                                "text": "„Während das Wochenende mit der Zeit und der schnellsten Verbindung vornehmlich rechnen muß, hat der Sommerfrischler mehr Zeit und Muße zur Auswahl und Fahrt zur Sommerfrische.“"
                                            },
                                            {
                                                "example_id": "1db29ddd-9320-4fe0-a0ab-b0cbb9cdb324",
                                                "sense_id": "102c6c05-9547-30d8-b164-de3ad5420e17",
                                                "text": "„Papa war nach Meppen versetzt worden, hatte sich da zwei Zimmer mit Bad gemietet und kam nur noch am Wochenende nachhause.“"
                                            },
                                            {
                                                "example_id": "3a8613e6-accc-4c01-8ac1-c542e2966cf4",
                                                "sense_id": "102c6c05-9547-30d8-b164-de3ad5420e17",
                                                "text": "„Am Wochenende rief meine Mutter an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6efa9555-a21a-40f7-ab0d-c2a15d242dd9",
                        "source_entry_id": "c9cc3ae7-3ad1-38e0-a996-a6ee018e7471",
                        "source_sense_id": "a115de5d-5c3b-36ec-9305-643c438f3bcc",
