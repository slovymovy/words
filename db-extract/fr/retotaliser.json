                "senses": [
                    {
                        "sense_id": "889b424a-b788-334a-b90a-32987be7d556",
                        "entry_id": "f5ed83f8-4ae4-3277-b875-3e9a4769adec",
                        "glosses": [
                            "Faire redevenir total."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c7fae00-a76b-429a-9647-dfe67ba193d6",
                                "sense_id": "889b424a-b788-334a-b90a-32987be7d556",
                                "text": "La fragmentation que le regard de François fait subir à l'image d'Arnica — avant que la paranoïa ne surgisse pour la retotaliser — est le ferment de la métaphore."
                            },
                            {
                                "example_id": "df1bed09-349c-4740-9322-5f8a88908598",
                                "sense_id": "889b424a-b788-334a-b90a-32987be7d556",
                                "text": "L'idée fondamentale demeure toujours de retotaliser l'homme en lui permettant d'élargir le champ de son expérience et, par le fait même, les horizons de sa conscience."
                            }
                        ]
                    }
