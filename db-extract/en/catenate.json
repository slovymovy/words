                    {
                        "sense_id": "d578a90f-f8c1-3d3d-af33-c6c5a368b451",
                        "entry_id": "5ae8565e-b934-3e83-b026-75575c06c868",
                        "glosses": [
                            "eine Verbindung zwischen Teilen herstellen; verketten, verknüpfen"
                        ],
                        "tags": [],
