                        "examples": [
                            {
                                "example_id": "00bc21f6-a5f1-4682-b12d-e0753ee16824",
                                "sense_id": "8a133bfe-b7b9-3f11-86b5-5fc15329b5c5",
                                "text": "Die Staatsflagge der Deutschen Demokratischen Republik besteht aus den Farben Schwarz‑Rot‑Gold und trägt auf beiden Seiten in der Mitte das Staatswappen der Deutschen Demokratischen Republik"
                            },
                            {
                                "example_id": "b229cb30-6f03-4342-b521-58a2b6357860",
                                "sense_id": "8a133bfe-b7b9-3f11-86b5-5fc15329b5c5",
                                "text": "Die beiden Staatsflaggen Bayerns sind die bayerische Rautenflagge und die bayerische Streifenflagge in den Landesfarben Weiß und Blau."
                            }
                        ]
                    }
