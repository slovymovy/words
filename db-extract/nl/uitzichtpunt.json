                                "target_senses": [
                                    {
                                        "sense_id": "19d6e8b7-05e6-3691-a40c-91203100e05f",
                                        "entry_id": "0c189496-cc84-3df2-becc-82e042a8c53a",
                                        "glosses": [
                                            "Stelle, von der aus man eine gute Aussicht hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "829ccf10-ef52-4f21-ab1c-b548545f7ba7",
                                                "sense_id": "19d6e8b7-05e6-3691-a40c-91203100e05f",
                                                "text": "„Sicher hingegen ist, dass für die Kriegskunst der Überblick von hochgelegenen Aussichtspunkten schon immer eine wichtige Rolle spielte.“"
                                            },
                                            {
                                                "example_id": "d356276b-f4bd-4545-8ac4-9b0ad2210753",
                                                "sense_id": "19d6e8b7-05e6-3691-a40c-91203100e05f",
                                                "text": "„An einem Aussichtspunkt hielten die Schlitten kurz an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b3f2521b-126b-4317-bc83-5ac8025ad92a",
                        "source_entry_id": "b7e817fc-9b16-3b1d-9da2-a1851e049e7b",
                        "source_sense_id": "30be2a43-8cc9-32ad-8194-7466f914c4cf",
                        "target_lang_word": "viewpoint",
