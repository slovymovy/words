                                    {
                                        "sense_id": "41444c46-83c8-3d2f-b056-f73ad557971a",
                                        "entry_id": "65495e80-b274-3da6-9228-d3d0e94a0bea",
                                        "glosses": [
                                            "Precaución, cautela, discreción."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b23e4c93-8141-4797-b03d-552192dd8de0",
                                                "sense_id": "41444c46-83c8-3d2f-b056-f73ad557971a",
                                                "text": "Que si a Grisóstomo mató su impaciencia y arrojado deseo, ¿por qué se ha de culpar mi honesto proceder y recato?"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d1f225ee-8f13-386f-8b8c-6db8b4eb167d",
                                        "entry_id": "65495e80-b274-3da6-9228-d3d0e94a0bea",
                                        "glosses": [
                                            "Honestidad, modestia al comportarse o al actuar."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6bb06a3-a459-42b2-b3fa-3dbc736058ee",
                                                "sense_id": "d1f225ee-8f13-386f-8b8c-6db8b4eb167d",
                                                "text": "Mi Don Javier de la Rosa,\nse lo digo sin recato,\nusté ha venío a encontrarse\ncon la horma de su zapato."
                                            }
