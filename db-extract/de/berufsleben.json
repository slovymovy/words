                "senses": [
                    {
                        "sense_id": "a696350b-18e4-3009-ba71-1843edffe4d7",
                        "entry_id": "6245e3d8-1e75-39ae-90d4-ebfcd5f67bea",
                        "glosses": [
                            "der Teil des Lebens, den eine Person mit ihrer Berufstätigkeit verbringt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9241c553-68b8-4b54-a048-2754ed6857b5",
                                "sense_id": "a696350b-18e4-3009-ba71-1843edffe4d7",
                                "text": "„Im Berufsleben ist Nörgeln nicht nur möglich, es ist unverzichtbar.“"
                            },
                            {
                                "example_id": "21ba96cc-7ea9-43cc-a5e1-abcdf1b86180",
                                "sense_id": "a696350b-18e4-3009-ba71-1843edffe4d7",
                                "text": "„Der Exkommissar hatte in seinem Berufsleben noch keinen Tag erlebt, an dem der Gerichtsmediziner vom forensischen Institut in einem Zustand war, der auch nur annähernd so beschrieben werden konnte.“"
                            },
                            {
                                "example_id": "43666194-db1b-4ea9-9604-0358b29141d2",
                                "sense_id": "a696350b-18e4-3009-ba71-1843edffe4d7",
                                "text": "„Cook hatte drei Jahrzehnte auf See verbracht, hatte ein volles und strapaziöses Berufsleben in der Schifffahrt hinter sich, wie schon aus der Tatsache zu ersehen ist, dass die Admiralität ihm anfänglich einen komfortablen Alterssitz im Hospital von Greenwich gewährt hatte.“"
                            },
                            {
                                "example_id": "891c1073-3a32-422a-8c5d-ce2a46fe10ba",
                                "sense_id": "a696350b-18e4-3009-ba71-1843edffe4d7",
                                "text": "„Eine Sinnkrise im Alltag oder Berufsleben kann für den dynamischen Menschen und Sinnsucher ein fruchtbarer Moment, ein Auslöser sein, auf Entdeckungsreise nach Alternativen zu gehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
