                "senses": [
                    {
                        "sense_id": "336dcada-8772-3445-ad27-2e135b568f0d",
                        "entry_id": "49a4958c-9611-3305-a0f7-e0d5eba699c0",
                        "glosses": [
                            "Leiterin eines Justizministeriums"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66f4d498-7cff-4589-9e31-bb2dde163a04",
                                "sense_id": "336dcada-8772-3445-ad27-2e135b568f0d",
                                "text": "„Wie schnell das gehen kann, bekam die amtierende Justizministerin Sally Yates zu spüren, nachdem sie es versäumte, sich öffentlich hinter den von Trump verkündeten Einreisestopp für Bürger aus sieben überwiegend muslimischen Ländern zu stellen.“"
                            },
                            {
                                "example_id": "d2dc256b-caa4-4ab8-bb7d-b1438fcd2159",
                                "sense_id": "336dcada-8772-3445-ad27-2e135b568f0d",
                                "text": "„Die SPD-Politikerin Christine Lambrecht ist Deutschlands neue Justizministerin. Die Amtsnachfolgerin von Katarina Barley erhielt am Donnerstag von Staatspräsident Frank-Walter Steinmeier die Ernennungskunde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
