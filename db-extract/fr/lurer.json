                "senses": [
                    {
                        "sense_id": "7868fe45-3d1d-3480-956a-9f5b25d80912",
                        "entry_id": "cf54c6c2-5f8e-38f5-ab92-e60e1237d519",
                        "glosses": [
                            "Fredonner ; répéter la même chose, rabâcher."
                        ],
                        "tags": [
                            "Normandie"
                        ],
                        "examples": [
                            {
                                "example_id": "90a02473-fc30-4aad-a3d1-f80a325dedc4",
                                "sense_id": "7868fe45-3d1d-3480-956a-9f5b25d80912",
                                "text": "Mlle Alberte sentit mon billet et le prit très bien, comme je l’avais prévu. Mais ce que je n’avais pas prévu, c’est qu’avec cet air d’Infante qui défiait tout par sa hauteur d’indifférence, elle le plongea dans le cœur de son corsage, où elle releva une dentelle repliée, d’un petit mouvement sec, et tout cela avec un naturel et une telle prestesse, que sa mère qui, les yeux baissés sur ce qu’elle faisait, servait le potage, ne s’aperçut de rien, et que son imbécile de père, qui lurait toujours quelque chose en pensant à son violon, quand il n’en jouait pas, n’y vit que du feu. »"
                            }
                        ]
                    }
