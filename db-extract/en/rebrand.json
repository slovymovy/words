        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "27b1e09a-3517-351e-8337-547e9eb35f20",
                "word": "rebrand",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "895bc359-18d4-40fd-9ee1-a886ba6448cb",
                        "entry_id": "27b1e09a-3517-351e-8337-547e9eb35f20",
                        "tags": [
                            "plural"
                        ],
                        "form": "rebrands"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "bfd29dc8-b9d3-35a1-8172-a8c2530bd26e",
                        "entry_id": "27b1e09a-3517-351e-8337-547e9eb35f20",
                        "glosses": [
                            "A change to the brand name, logo, or image of a product or company."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1fa8e583-2df1-4391-ab4f-6cc8dd52a7e5",
                                "sense_id": "bfd29dc8-b9d3-35a1-8172-a8c2530bd26e",
                                "text": "Management decided it was time for a complete rebrand."
                            },
                            {
                                "example_id": "f3753b64-5942-4b9d-aa6a-22dc568f1e90",
                                "sense_id": "bfd29dc8-b9d3-35a1-8172-a8c2530bd26e",
                                "text": "Typically, a rebrand is either a fundamental change of the core ideology of everything you are, or at a more pithy level, a change in how you visually manifest that core idea."
                            },
                            {
                                "example_id": "7075a508-b076-4020-a5c7-b25d52b3da54",
                                "sense_id": "bfd29dc8-b9d3-35a1-8172-a8c2530bd26e",
                                "text": "There are a number of issues here. First up, non-traditional working practices need a major rebrand. We need to move away from the assumption that “working flexibly” means “working less”."
                            },
                            {
                                "example_id": "940e2641-fe9f-4b1d-828f-507bcaf439aa",
                                "sense_id": "bfd29dc8-b9d3-35a1-8172-a8c2530bd26e",
                                "text": "Before engaging in a rebrand, it is important to consider how a rebrand can and will influence loyal consumers, fans, students, and alumni."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": [
                    {
                        "linkage_id": "3e51a603-b5de-4b2d-a045-a822c866c513",
                        "source_entry_id": "27b1e09a-3517-351e-8337-547e9eb35f20",
                        "source_sense_ids": [
                            "bfd29dc8-b9d3-35a1-8172-a8c2530bd26e"
                        ],
                        "linkage_type": "synonyms",
                        "word": "rebranding"
                    }
                ]
            },
