        "fr-extract.jsonl": [
            {
                "entry_id": "026ad968-0162-359a-9262-0a18009e626c",
                "word": "polype",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "04573e2a-217a-4ab6-81d0-f1c1f874ad19",
                        "entry_id": "026ad968-0162-359a-9262-0a18009e626c",
                        "tags": [
                            "plural"
                        ],
                        "form": "polypes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "424780a6-473d-36b6-acb6-6a2f34154147",
                        "entry_id": "026ad968-0162-359a-9262-0a18009e626c",
                        "glosses": [
                            "Espèce d’animal aquatique de la classe des zoophytes, dont le corps gélatineux est de forme conique, et qui a autour de la bouche plusieurs filets mobiles appelés tentacules."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d8c1f6d-7a7e-4271-879e-f581a1fb12e8",
                                "sense_id": "424780a6-473d-36b6-acb6-6a2f34154147",
                                "text": "Polype nu. Polype du corail. Le polype d’eau douce, coupé en plusieurs parties, se reproduit tout entier dans chacune. Les coraux sont des productions de polypes."
                            }
                        ]
                    },
                    {
                        "sense_id": "49883280-6cdc-3c54-b255-9a44fb6c7147",
                        "entry_id": "026ad968-0162-359a-9262-0a18009e626c",
                        "glosses": [
                            "Excroissance ou tumeur de diverse nature qui vient en certaines parties du corps et particulièrement dans les cavités recouvertes de membranes muqueuses."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6328040e-3e46-4c71-878d-bbc277dedb5b",
                                "sense_id": "49883280-6cdc-3c54-b255-9a44fb6c7147",
                                "text": "Remede contre le polype. Prenez de la poudre subtile de corne de bœuf & soufflez-en dans le nez avec une plume."
                            },
                            {
                                "example_id": "4bfd0008-faf8-47de-865e-febcda49a985",
                                "sense_id": "49883280-6cdc-3c54-b255-9a44fb6c7147",
                                "text": "J’en ai-t-y attrapé des drôles de maladies ! dans le nez, des polypes, on aurait dit du corail qui me poussait."
                            }
                        ]
                    },
                    {
                        "sense_id": "398ae994-d7de-39ff-adfd-1107289005fe",
                        "entry_id": "026ad968-0162-359a-9262-0a18009e626c",
                        "glosses": [
                            "Auteur capable d'exposer des thèses multiples à l'infini."
                        ],
                        "tags": [
                            "Par métaphore"
                        ],
                        "examples": [
                            {
                                "example_id": "f1bb2bb3-804e-458b-97d7-8d699a706284",
                                "sense_id": "398ae994-d7de-39ff-adfd-1107289005fe",
                                "text": "Quoiqu'il entasse doute sur doute, [Bayle] marche toujours avec ordre : c'est un polype vivant, qui se divise en autant de polypes qui vivent tous ; il les engendre les uns des autres."
                            }
                        ]
                    },
                    {
                        "sense_id": "c895ac11-a720-3200-ad51-f12e5e2d9519",
                        "entry_id": "026ad968-0162-359a-9262-0a18009e626c",
                        "glosses": [
                            "Construction, arborescence, enchevêtrement de liens complexes à l'infini."
                        ],
                        "tags": [
                            "analogy"
                        ],
                        "examples": [
                            {
                                "example_id": "bceffd94-7585-430f-adf2-f02b8e1f9f29",
                                "sense_id": "c895ac11-a720-3200-ad51-f12e5e2d9519",
                                "text": "Le monstrueux édifice pèse sur vous de tout son poids ; il vous entoure, il vous enlace et vous étouffe ; vous vous sentez pris comme dans les tentacules d’un gigantesque polype de granit."
                            },
                            {
                                "example_id": "58a5fb62-7b43-4cac-b0f0-a28bfc713b6e",
                                "sense_id": "c895ac11-a720-3200-ad51-f12e5e2d9519",
                                "text": "Sans doute a-t-il été, plus simplement, entraîné par une pure fascination plastique devant l’image de ces blocs de texte ramifiés, reliés, s’engendrant les uns les autres comme un gigantesque polype."
                            }
                        ]
                    }
                ],
