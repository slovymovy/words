                        ]
                    },
                    {
                        "translation_id": "4b4dcccd-439c-4a7e-bffe-18e0596238d6",
                        "source_entry_id": "a9a3504a-0c1e-30cb-820e-7b71a9ceaa26",
                        "source_sense_id": "f055ab9d-9ea4-3707-aaa1-3e05b5763768",
                        "target_lang_word": "transfert",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "transfert",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6b855136-37cc-3c9c-946f-44d083920d1d",
                                        "entry_id": "5d8972bb-333e-3b58-a217-bcfee90eab7a",
                                        "glosses": [
                                            "Action de transférer ; passage de quelque chose d’un lieu à un autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c437a6a-ebf0-4475-8e3b-1127e2306085",
                                                "sense_id": "6b855136-37cc-3c9c-946f-44d083920d1d",
                                                "text": "« Oui, j'ai bien un pouce ici », confirme la dactylo-technicienne. Elle repose poudre et pinceau pour saisir un carré de transfert transparent qu'elle vient appliquer avec soin sur l’empreinte à relever."
                                            },
                                            {
                                                "example_id": "1906c41f-e69c-4e88-b137-745cc2cfd94f",
                                                "sense_id": "6b855136-37cc-3c9c-946f-44d083920d1d",
                                                "text": "Après plusieurs transferts, il a finalement trouvé sa place. — Le transfert du corps d’un mort."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a190f071-d495-3ac4-9f26-48cfd4dce51e",
                                        "entry_id": "5d8972bb-333e-3b58-a217-bcfee90eab7a",
                                        "glosses": [
                                            "Synonyme usuel du terme juridique transfèrement."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa85d3da-a293-4f31-affe-3f08540272b5",
                                                "sense_id": "a190f071-d495-3ac4-9f26-48cfd4dce51e",
                                                "text": "En 2011, l’équipe de Claude Guéant avait ainsi proposé à Sarkozy et à Fillon de privatiser le transfert des détenus et les gardes statiques devant certains lieux menacés…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b5e9d45e-69a4-37f5-9199-5266d927d4a3",
                                        "entry_id": "5d8972bb-333e-3b58-a217-bcfee90eab7a",
                                        "glosses": [
                                            "Acte par lequel on déclare transporter à un autre la propriété d’une rente sur l’état, d’une valeur, d’une marchandise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "afaedca0-5eac-4904-9d74-a542ba7dd13a",
                                                "sense_id": "b5e9d45e-69a4-37f5-9199-5266d927d4a3",
                                                "text": "Le transfert des rentes se fait sur les registres du Trésor."
                                            },
                                            {
                                                "example_id": "b14d8206-2599-4329-a3c7-a56dfa58ac28",
                                                "sense_id": "b5e9d45e-69a4-37f5-9199-5266d927d4a3",
                                                "text": "Les formalités du transfert ont été remplies."
                                            },
                                            {
                                                "example_id": "34644787-2ba5-4f70-9d39-35955a1c1c6a",
                                                "sense_id": "b5e9d45e-69a4-37f5-9199-5266d927d4a3",
                                                "text": "Opérer un transfert."
                                            },
                                            {
                                                "example_id": "6e989662-5d6c-42d1-866c-d67e4e1166bf",
                                                "sense_id": "b5e9d45e-69a4-37f5-9199-5266d927d4a3",
                                                "text": "J’ai signé le transfert de mon inscription, elle ne m’appartient plus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c702cec9-bff4-35ae-aca7-5e8699f9e7fe",
                                        "entry_id": "5d8972bb-333e-3b58-a217-bcfee90eab7a",
                                        "glosses": [
                                            "Changement de club par un sportif."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6f3a1fe-ff98-42e3-ad8d-700cb12e8446",
                                                "sense_id": "c702cec9-bff4-35ae-aca7-5e8699f9e7fe",
                                                "text": "Annoncé depuis plusieurs jours, le transfert de Miralem Pjanic à la Juventus Turin est désormais officiel."
                                            },
                                            {
                                                "example_id": "3b61a00e-6c42-4bd8-844c-2315fcd40b82",
                                                "sense_id": "c702cec9-bff4-35ae-aca7-5e8699f9e7fe",
                                                "text": "Les « indésirables » sont aussi restés à Paris : Georginio Wijnaldum, Ander Herrera, Julian Draxler, Layvin Kurzawa, Thilo Kehrer et Rafinha, en attendant de trouver preneur sur le marché des transferts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "31f1b68f-485c-3ca0-b100-4cb610a8d5a8",
                                        "entry_id": "5d8972bb-333e-3b58-a217-bcfee90eab7a",
                                        "glosses": [
                                            "Dans un système cellulaire de radiocommunication avec les téléphones mobiles, commutation des moyens de transmission utilisés par une communication sans interruption de cette dernière."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2270944-436e-48c0-a1ad-c2dd1f0b8484",
                                                "sense_id": "31f1b68f-485c-3ca0-b100-4cb610a8d5a8",
                                                "text": "Ces progrès permettent d’offrir une série de nouveaux services comme le transfert d’appels, la messagerie vocale ou l’identification de la ligne appelante."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a3c5b01-44b0-387d-8da3-ca30f1d2025c",
                                        "entry_id": "5d8972bb-333e-3b58-a217-bcfee90eab7a",
                                        "glosses": [
                                            "Report plus ou moins direct d’un sentiment ou d’un vécu infantile par l’analysé sur le psychanalyste."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33fa7062-dfa9-40ce-bb56-55e80b02aba2",
                                                "sense_id": "4a3c5b01-44b0-387d-8da3-ca30f1d2025c",
                                                "text": "Effet facilitateur ou inhibiteur d’une activité initiale sur une activité d’acquisition subséquente : le transfert est dit positif, si l’acquisition est facilitée par l’activité préalable […] il est dit négatif, dans le cas inverse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8f9e5fa-8c3c-3138-848b-ac09e3887298",
                                        "entry_id": "5d8972bb-333e-3b58-a217-bcfee90eab7a",
                                        "glosses": [
                                            "Déplacement d’une substance d’un support sur un autre."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a39e1a8d-de5d-32cd-8279-5b6edcc8ba64",
                                        "entry_id": "5d8972bb-333e-3b58-a217-bcfee90eab7a",
                                        "glosses": [
                                            "Procédé consistant à transférer sur un support de rédaction une image imprimée sur une feuille, généralement plastique, par une forte pression exercée au dos de cette feuille à l’aide d’un brunissoir."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6065757e-0451-37d3-aaa9-b0d20cbe77c9",
                                        "entry_id": "5d8972bb-333e-3b58-a217-bcfee90eab7a",
                                        "glosses": [
                                            "Création d'un lemme par mutation de la catégorie lexicale d'un premier terme, sans modification de sa forme, également appelée transposition, translation, ou dérivation impropre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "561dae74-4116-4afe-b361-25ca4a1d8fce",
                                                "sense_id": "6065757e-0451-37d3-aaa9-b0d20cbe77c9",
                                                "text": "La conversion (également appelée transfert, transposition, translation, et même dérivation impropre) est une opération unaire qui, comme la négation en logique, n'affecte qu'un seul terme. En fait, un terme change de catégorie grammaticale (et donc de sens) sans changer de forme. Dans « le rouge de la colère », le nom rouge est obtenu par simple recatégorisation grammaticale de l'adjectif rouge, par opposition à « la rougeur des joues », où le nom rougeur est créé par la suffixation du même adjectif."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "498951e6-4548-385e-9253-c11ae0447ef0",
                                        "entry_id": "5d8972bb-333e-3b58-a217-bcfee90eab7a",
                                        "glosses": [
                                            "En langue des signes française, le transfert désigne le fait, pour le locuteur ou la locutrice, de modifier le sens des signes par le regard ou la position dans l’espace :\\n— modification de la taille et de la forme de ce qui est énoncé (transfert de taille et de forme, TTF) ;\\n— indication de la position dans l’espace de ce qui est énoncé (transfert de situation, TS), le locuteur ou la locutrice est alors dans la position d’un observateur ;\\n— indication de ce que fait ou ressent une personne ou un personnage, le locuteur ou la locutrice étant « dans la peau » du personnage (transfert de personne, TP)."
                                        ],
                                        "tags": [
                                            "Handicap"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff521415-d871-4fad-8f19-05bdd8a515e0",
                                                "sense_id": "498951e6-4548-385e-9253-c11ae0447ef0",
                                                "text": "Les spécificateurs sont des éléments minimaux […]. Ces éléments, en nombre limité, offrent la particularité de s’articuler en continuum et, par concaténatio permettent le développement de formes complexes que Cuxac a pu appeler descripteurs et qu’il intègre désormais dans une typologie de transferts sous l’appellation de transfert de taille et de forme."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
