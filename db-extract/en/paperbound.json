                        "examples": [
                            {
                                "example_id": "ee6a6e5d-9242-43c6-b5a8-65c79997e9be",
                                "sense_id": "09ecee2e-966f-3e03-9ea0-1f3b4b29fe3b",
                                "text": "Last week in collaboration with his longtime associate, Frederick Shelton, Editor Kiplinger published a paperbound booklet called Inflation Ahead!—What to do about it."
                            }
                        ]
                    },
                    {
                        "sense_id": "0e62336c-b093-3e5d-b7e0-99c80edae5e2",
                        "entry_id": "054cec40-13c5-3cb7-a346-06f883a66b97",
                        "glosses": [
                            "Involving or burdened by excessive administrative requirements, especially in the form of paperwork."
                        ],
                        "tags": [
                            "comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "beb9efbf-75d4-450d-8499-4f612ab1226b",
                                "sense_id": "0e62336c-b093-3e5d-b7e0-99c80edae5e2",
                                "text": "The company has turned to In Touch to automate what had been a paperbound process."
                            },
                            {
                                "example_id": "ce8806ec-f13d-4469-9423-37047d59edb9",
                                "sense_id": "0e62336c-b093-3e5d-b7e0-99c80edae5e2",
                                "text": "“We need to bring this paperbound system into the 21st century,” he said."
                            }
                        ]
                    }
