        "fr-extract.jsonl": [
            {
                "entry_id": "d7db1c7d-d94a-30f0-b7dd-76dd9d68d886",
                "word": "obliquement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "eecdf578-2cee-3d24-8073-3e16676644aa",
                        "entry_id": "d7db1c7d-d94a-30f0-b7dd-76dd9d68d886",
                        "glosses": [
                            "D’une manière oblique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b89f7ea-bf9a-4ba6-bc68-eb332be7b136",
                                "sense_id": "eecdf578-2cee-3d24-8073-3e16676644aa",
                                "text": "On sait qu’un rayon qui passe obliquement d’un milieu dans un autre, ne continue pas son chemin dans la même ligne droite, suivant laquelle il entre."
                            },
                            {
                                "example_id": "e71daf9e-577a-45fc-84ab-572e3f20be8d",
                                "sense_id": "eecdf578-2cee-3d24-8073-3e16676644aa",
                                "text": "Si l’obstacle n’est qu’obliquement opposé à la pesanteur, tel que serait par exemple un plan incliné."
                            },
                            {
                                "example_id": "6434e4a4-3a67-43c8-9bc4-da777613b7e3",
                                "sense_id": "eecdf578-2cee-3d24-8073-3e16676644aa",
                                "text": "Chacun d’eux faisait d’abord une coche profonde dans le bois, frappant patiemment au même endroit pendant quelques secondes, puis la hache remonta brusquement, attaquant le tronc obliquement un pied plus haut et faisant voler à chaque coup un copeau épais comme la main et taillé dans le sens de la fibre."
                            },
                            {
                                "example_id": "9b74cbed-0ef8-4767-9696-3ab4caf0c0ec",
                                "sense_id": "eecdf578-2cee-3d24-8073-3e16676644aa",
                                "text": "De l'autre côté de la chaussée, le poste de police dont le drapeau pendait obliquement, comme une loque, mal éclairé par la lanterne, avait un air peu engageant."
                            },
                            {
                                "example_id": "4544e413-60e1-4322-9c1a-27ff35a2e597",
                                "sense_id": "eecdf578-2cee-3d24-8073-3e16676644aa",
                                "text": "Seules de nouveau, Noémi et moi occupions « le banc du Seigneur » (par lequel on n’entendait jamais le Seigneur Dieu). De là, je voyais un peu obliquement l’autel."
                            }
                        ]
                    },
                    {
                        "sense_id": "77654de6-2d1e-3be8-b08b-f24abc113499",
                        "entry_id": "d7db1c7d-d94a-30f0-b7dd-76dd9d68d886",
                        "glosses": [
                            "D’une manière insidieuse, qui n’est ni droite, ni franche."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "fbc803b8-b314-4269-9427-644f5d70d9f7",
                                "sense_id": "77654de6-2d1e-3be8-b08b-f24abc113499",
                                "text": "Il agit obliquement."
                            }
                        ]
                    },
                    {
                        "sense_id": "237ffaab-078d-38e0-9767-99a39ab2911c",
                        "entry_id": "d7db1c7d-d94a-30f0-b7dd-76dd9d68d886",
                        "glosses": [
                            "Indirectement."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "06dc9a11-5c0c-4e14-a92a-3a7c719f9ada",
                                "sense_id": "237ffaab-078d-38e0-9767-99a39ab2911c",
                                "text": "Louer quelqu’un obliquement."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5ac346c8-bc8e-4174-8ade-922e50efdae1",
                        "source_entry_id": "d7db1c7d-d94a-30f0-b7dd-76dd9d68d886",
                        "target_lang_word": "obliquely",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "obliquely",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9c434510-e129-3cbf-aea0-e6d2fe82710a",
                                        "entry_id": "e3f5b4dc-08eb-3871-9cb0-c2d212069258",
                                        "glosses": [
                                            "In an oblique manner; sideways."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e0b8be5-e2c1-400b-ab6f-160a9f6d06da",
                                                "sense_id": "9c434510-e129-3cbf-aea0-e6d2fe82710a",
                                                "text": "Then, advancing obliquely towards us, came a fifth."
                                            },
                                            {
                                                "example_id": "228fd525-da6b-4217-8027-da7ecc2c2749",
                                                "sense_id": "9c434510-e129-3cbf-aea0-e6d2fe82710a",
                                                "text": "Finally I descended the hill, obliquely, towards the trees I had seen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "97bfe66d-164d-4cc8-a29a-4c5930ea5dc6",
                        "source_entry_id": "d7db1c7d-d94a-30f0-b7dd-76dd9d68d886",
                        "target_lang_word": "slantwise",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "slantwise",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d13a3dc6-da41-34fc-8574-4c69284e1a1f",
                                        "entry_id": "0666a78f-05bd-3a7c-a3ff-ac8152473488",
                                        "glosses": [
                                            "diagonal, in a direction or orientation between cardinal axes"
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6deaeb4b-fff2-4845-838b-f670d584b14c",
                                                "sense_id": "d13a3dc6-da41-34fc-8574-4c69284e1a1f",
                                                "text": "I can see it all now,—the slantwise rain / Of light through the leaves, / The sundown's blaze on her window-pane, / The bloom of her roses under the eaves."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "slantwise",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1c2e83b3-f262-3d09-975f-29d6cb85616d",
                                        "entry_id": "7a7bb574-75c4-3c9f-ace3-1a720dd76c05",
                                        "glosses": [
                                            "diagonally, in a direction or orientation between cardinal axes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc7f4204-f163-4e45-80d5-e90c25895185",
                                                "sense_id": "1c2e83b3-f262-3d09-975f-29d6cb85616d",
                                                "text": "[…] he had received a cut slantwise along one temple and cheek, leaving a long scar like a streak of dawn's light falling athwart the dark visage."
                                            },
                                            {
                                                "example_id": "a23a984e-0dc0-40d3-b75a-4b9d8ecc7220",
                                                "sense_id": "1c2e83b3-f262-3d09-975f-29d6cb85616d",
                                                "text": "Slantwise, a salamander-shaped sea came at them, growing."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a8dd1a14-db61-48c5-b57a-2c8656b6460c",
                        "source_entry_id": "d7db1c7d-d94a-30f0-b7dd-76dd9d68d886",
