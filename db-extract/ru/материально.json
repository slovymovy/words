        "ru-extract.jsonl": [
            {
                "entry_id": "a5c10d4e-c291-3385-9e2d-32627ab269c5",
                "word": "материально",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "6054ac43-a17d-329c-ba2c-5860bf7b005e",
                        "entry_id": "a5c10d4e-c291-3385-9e2d-32627ab269c5",
                        "glosses": [
                            "наречие к материальный; через осязаемую форму, вещественно"
                        ],
                        "tags": [
                            "adverb"
                        ],
                        "examples": [
                            {
                                "example_id": "50285fd1-83b5-443f-98d0-79888d5d151e",
                                "sense_id": "6054ac43-a17d-329c-ba2c-5860bf7b005e",
                                "text": "Занимаясь служебными делами, человек мог в любую минуту объемно, материально представить себе: на второй полке баночка, на треть наполненная золотистым пшеном, в соседней банке ловко улеглись серебряные кильки."
                            }
                        ]
                    },
                    {
                        "sense_id": "6b2367de-e5d8-3c19-9d90-b15db5a9df82",
                        "entry_id": "a5c10d4e-c291-3385-9e2d-32627ab269c5",
                        "glosses": [
                            "будучи связанным с заработком, с деньгами"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "183c5ef6-40d1-403b-a524-9b9c9ab876ba",
                                "sense_id": "6b2367de-e5d8-3c19-9d90-b15db5a9df82",
                                "text": "Алена предлагала продать кое-что из бабушкиного наследства, чтобы помочь подруге материально, но Ирине было жаль коллекцию. [Екатерина Романова, Николай Романов"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5ad340f4-04dd-4158-aee1-55f8bc40bb65",
                        "source_entry_id": "a5c10d4e-c291-3385-9e2d-32627ab269c5",
                        "source_sense_description": "через осязаемую форму, вещественно",
                        "target_lang_word": "materially",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "materially",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5f6f31e1-773e-364b-9961-e3cd2f4a5cbe",
                                        "entry_id": "5b7e4da0-3070-356f-8624-e4a6737c3103",
                                        "glosses": [
                                            "In a material manner; with regard to physical things or characteristics."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d2aa36a-041f-406c-8e63-79d53fe5c38b",
                                                "sense_id": "5f6f31e1-773e-364b-9961-e3cd2f4a5cbe",
                                                "text": "Tobacco, for instance, shrinks materially by frequent reshippings, and as all goods are warehoused as a convenience to importers, duties should be paid on what the importer receives."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89cb145f-b2c0-3211-b544-9c033e039a6a",
                                        "entry_id": "5b7e4da0-3070-356f-8624-e4a6737c3103",
                                        "glosses": [
                                            "To a significant degree."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b2ffed1-cbdf-4585-a283-f5a9cf7df8ee",
                                                "sense_id": "89cb145f-b2c0-3211-b544-9c033e039a6a",
                                                "text": "In cases of extreme thickening of the coats of the stomach, of a scirrhoid character, where the suffering patients are almost worn out with constant pain, such remedies, applied over the epigastrium, most materially alleviate the distress."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
