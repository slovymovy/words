                        "examples": [
                            {
                                "example_id": "f071d7c9-23f9-4b6b-9576-b697890f4fc4",
                                "sense_id": "230403ce-f30f-3422-9fd0-82341824c7d1",
                                "text": "Aut’ fois, j’avais qu’l’ soucille d’tremper et d’déflaquer en Chronopost. M’vider les sacoches à paf, c’est la seule chose dont j’étais intéressé. Au plus ça allait vite, au mieux j’m’sentais. Le panard de la copine, j’en avais stristement rien à foutre."
                            },
                            {
                                "example_id": "7fa1e8fb-9d13-42b9-858f-8cc75ef6ce65",
                                "sense_id": "230403ce-f30f-3422-9fd0-82341824c7d1",
                                "text": "Malgré son excitation, il se contrôle et ne déflaque pas devant elles."
                            },
                            {
                                "example_id": "12efcf29-c8f0-4c83-a568-e23f83e4ea0d",
                                "sense_id": "230403ce-f30f-3422-9fd0-82341824c7d1",
                                "text": "Je me sentis frissonner et sans me soucier plus amplement de sa jouissance, je déflaquai comme un goujat en solitaire."
                            }
                        ]
                    }
