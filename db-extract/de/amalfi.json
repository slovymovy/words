                    {
                        "translation_id": "7431cf95-251f-4366-a2aa-274030846f1b",
                        "source_entry_id": "f061f798-a205-30dc-898c-da10f13b420b",
                        "source_sense_id": "a14e1b21-5289-3286-a690-130fab155a05",
                        "source_sense_description": "italienische Küstenstadt in der Provinz Salerno und in der Region Kampanien",
                        "target_lang_word": "Амальфи",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Амальфи",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "050af001-426d-3029-b728-9faee6c9e4c7",
                                        "entry_id": "5d88eb20-bb40-317e-a502-77cc472cd589",
                                        "glosses": [
                                            "геогр. город в Италии"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9af2b57f-cdd2-4f91-bb6b-98ac04a10dea",
                                                "sense_id": "050af001-426d-3029-b728-9faee6c9e4c7",
                                                "text": "Весь день прошёл .. частию в осмотре окрестностей Сорренто. В числе последних замечательней всего, по своей живописности, городок Амальфи."
                                            },
                                            {
                                                "example_id": "106694d2-170b-4730-a7ea-55270b897d9d",
                                                "sense_id": "050af001-426d-3029-b728-9faee6c9e4c7",
                                                "text": "Уже две недели как Игнатий Саохин, Раиса и Ян – в Италии. Они из Неаполя переехали в небольшой городок Амальфи .. Амальфи было место неудобное, шумное, узкое, горы совсем подступали к морю, едва давая место дороге."
                                            },
                                            {
                                                "example_id": "44c55359-c829-4779-9113-f0f9687aca88",
                                                "sense_id": "050af001-426d-3029-b728-9faee6c9e4c7",
                                                "text": "— В прошлом году я был в это время далеко на юге и помню, как там было светло и тепло, — возразил Зенон. // — В Италии? — спросила Дэзи, садясь около него. // — Да, в Амальфи за Неаполем."
                                            },
                                            {
                                                "example_id": "6524fae7-beca-4221-b08d-9fd838269e8e",
                                                "sense_id": "050af001-426d-3029-b728-9faee6c9e4c7",
                                                "text": "Вчера из Неаполя ездили в Салерно. ❬…❭ Потом в Амальфи."
                                            },
                                            {
                                                "example_id": "61f2c5e9-4206-4223-ab15-e0b489f674d0",
                                                "sense_id": "050af001-426d-3029-b728-9faee6c9e4c7",
                                                "text": "Эти обстоятельства не смогли помешать итальянцам построить в Неаполе памятник жителю города Амальфи Флавио Джойя, который, по их мнению, изобрёл магнитный компас в 1302 году."
                                            },
                                            {
                                                "example_id": "8b2d1f66-7374-4665-807e-06e95971a749",
                                                "sense_id": "050af001-426d-3029-b728-9faee6c9e4c7",
                                                "text": "Вместе с Маргарет он провёл около месяца на берегу Салернского залива — в старинном городке Амальфи .."
                                            },
                                            {
                                                "example_id": "bc4ebfa3-2657-45b1-8385-5585a28a11f7",
                                                "sense_id": "050af001-426d-3029-b728-9faee6c9e4c7",
                                                "text": "Первыми крупными центрами морской торговли поочерёдно становились средиземноморские города Амальфи, Генуя и Венеция."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
