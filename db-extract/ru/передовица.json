                        "translation_id": "01379e30-b36e-4110-acf4-8718156ec71e",
                        "source_entry_id": "882b0dea-0a28-3b18-8f7d-091280735584",
                        "source_sense_id": "208fbf1e-5a54-3f7a-88f8-3ce4e9c85d1a",
                        "target_lang_word": "Leitartikel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Leitartikel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "26cc4b69-4c2f-3b92-8865-e4ec19dedabb",
                                        "entry_id": "63d1b688-2cac-35f4-aa82-d32f1130ca7b",
                                        "glosses": [
                                            "Zeitungsartikel, der an herausgestellter Position meist ausführlich die Meinung eines Autors zu einem bestimmten Thema beschreibt"
                                        ],
                                        "tags": [
                                            "Presse"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9d906464-49a9-427d-bf18-d0292e112ce3",
                                                "sense_id": "26cc4b69-4c2f-3b92-8865-e4ec19dedabb",
                                                "text": "„Am 5. Dezember 2015 erschien die New York Times erstmals seit einem knappen Jahrhundert mit einem Leitartikel auf ihrer Titelseite. In diesem nahm sie das Ereignis von San Bernardino zum Anlass, um eine Verschärfung der Gesetzgebung in Bezug auf den Erwerb von Schusswaffen zu fordern.“"
                                            },
                                            {
                                                "example_id": "14ff8a39-9144-44e2-9094-d747573156d5",
                                                "sense_id": "26cc4b69-4c2f-3b92-8865-e4ec19dedabb",
                                                "text": "„Er blätterte bis zum Leitartikel, und nachdem er ein paar Auszüge vorgelesen hatte, fragte er, was das solle.“"
                                            },
                                            {
                                                "example_id": "c10025d5-445e-4489-9ce7-e9d52ed31a60",
                                                "sense_id": "26cc4b69-4c2f-3b92-8865-e4ec19dedabb",
                                                "text": "„Die Presse spiegelte, in Leitartikeln und Leserbriefen, zugleich die Stimmung der Menschen wider.“"
                                            },
                                            {
                                                "example_id": "bd56e7b4-a511-41a3-9eaf-22b1734c0f4c",
                                                "sense_id": "26cc4b69-4c2f-3b92-8865-e4ec19dedabb",
                                                "text": "„Wieland schreibt keinen Leitartikel, in dem er ex cathedra verfügt, wie seine Leserschaft urteilen soll.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
