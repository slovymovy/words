                ],
                "senses": [
                    {
                        "sense_id": "d54d8675-81cb-39cd-a8d3-af296f9f0efb",
                        "entry_id": "feb64b39-c016-3c2d-ae1a-f6eb168c8d45",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1656b2a5-0c4c-48cd-8950-8862361260db",
                                "sense_id": "d54d8675-81cb-39cd-a8d3-af296f9f0efb",
                                "text": "Frau Rauhut ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "4e2db47f-f72b-4997-8424-bc323da1dce4",
                                "sense_id": "d54d8675-81cb-39cd-a8d3-af296f9f0efb",
                                "text": "Herr Rauhut wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "e340b797-c9a5-4cb1-b211-6c6d75eb8f1e",
                                "sense_id": "d54d8675-81cb-39cd-a8d3-af296f9f0efb",
                                "text": "Die Rauhuts fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "9c09df39-bb56-4cc1-9249-08578d4d5251",
                                "sense_id": "d54d8675-81cb-39cd-a8d3-af296f9f0efb",
                                "text": "Der Rauhut trägt nie die Schals, die die Rauhut ihm strickt."
                            },
                            {
                                "example_id": "4ebd0b40-f9c5-43ec-aa00-eeb178943a7a",
                                "sense_id": "d54d8675-81cb-39cd-a8d3-af296f9f0efb",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Rauhut kommt, geht der Herr Rauhut.“"
                            },
                            {
                                "example_id": "2c2be501-9b2d-4398-9bde-c47edb151ca9",
                                "sense_id": "d54d8675-81cb-39cd-a8d3-af296f9f0efb",
                                "text": "Rauhut kommt und geht."
                            },
                            {
                                "example_id": "3545fadb-c4a5-47d0-9c46-23a181cb6de4",
                                "sense_id": "d54d8675-81cb-39cd-a8d3-af296f9f0efb",
                                "text": "Rauhuts kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
