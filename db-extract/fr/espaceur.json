        "fr-extract.jsonl": [
            {
                "entry_id": "841742d4-7095-353b-b45c-c667c55d54e9",
                "word": "espaceur",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "9d5dfa7f-a199-4eb9-a8b9-0a155e3465cf",
                        "entry_id": "841742d4-7095-353b-b45c-c667c55d54e9",
                        "tags": [
                            "plural"
                        ],
                        "form": "espaceurs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ef59b25e-017e-3bca-bc2e-a327af6f4f81",
                        "entry_id": "841742d4-7095-353b-b45c-c667c55d54e9",
                        "glosses": [
                            "Dispositif destiné à espacer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca7f5003-78aa-45d1-a31d-1e4b71165b44",
                                "sense_id": "ef59b25e-017e-3bca-bc2e-a327af6f4f81",
                                "text": "On libère un nerf, on nettoie la plaie dorsale et les \"espaceurs\" plastifiés posés entre les vertèbres par le docteur Delajoux sont retirés - ils commençaient à pourrir."
                            }
                        ]
                    },
                    {
                        "sense_id": "a75d054a-ebb2-335f-927a-e82206cbf4d3",
                        "entry_id": "841742d4-7095-353b-b45c-c667c55d54e9",
                        "glosses": [
                            "Séquence d’ADN non transcrit, séparant les gènes à l'intérieur des unités répétées."
                        ],
                        "tags": [
                            "Génétique",
                            "Moléculaire"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "90fdd453-50c9-3256-962b-3e2ec79a001e",
                        "entry_id": "841742d4-7095-353b-b45c-c667c55d54e9",
                        "glosses": [
                            "Fragment d’ADN de phage ou de plasmide invasifs, inséré entre deux courtes répétitions palindromiques successives du chromosome de nombreuses archées et bactéries."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "304b652f-9ef1-4e15-a434-b4a66ca0a64c",
                        "source_entry_id": "841742d4-7095-353b-b45c-c667c55d54e9",
                        "source_sense_id": "ef59b25e-017e-3bca-bc2e-a327af6f4f81",
                        "target_lang_word": "spacer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spacer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7905bd7b-7b2c-3b0a-8815-1d28f2451204",
                                        "entry_id": "40e37788-6461-398b-a203-3eb1c29c98d5",
                                        "glosses": [
                                            "A person who works or lives in space."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "054dc282-417c-4521-9174-29f57f7914fc",
                                                "sense_id": "7905bd7b-7b2c-3b0a-8815-1d28f2451204",
                                                "text": "\"How do I know I can trust you?\" asked BKR.\nGrakker hesitated. \"Spacer's oath,\" he said at last."
                                            },
                                            {
                                                "example_id": "e9b82a8e-d8f4-449a-82f1-b2d11cd933d9",
                                                "sense_id": "7905bd7b-7b2c-3b0a-8815-1d28f2451204",
                                                "text": "It was the futile throwing back in the face of the Spacers their most keenly felt insult: their insistence on considering the natives of Earth as disgustingly diseased."
                                            },
                                            {
                                                "example_id": "9be49a41-c8c1-4efe-a574-73cc64cd8386",
                                                "sense_id": "7905bd7b-7b2c-3b0a-8815-1d28f2451204",
                                                "text": "Shepard: What are you running for?\nCharles Saracino: I'm seeking one of the five spacer seats in Parliament. They have certain baroque conditions for a citizen to be able to vote for them.\nCharles Saracino: You have to spend more than six months a year in space. But you can't have stayed in any one settled system for more than a month."
                                            },
                                            {
                                                "example_id": "73df6e7f-7065-49d8-9d12-af6718269880",
                                                "sense_id": "7905bd7b-7b2c-3b0a-8815-1d28f2451204",
                                                "text": "He was thankful that he still had his suit on when the ship had a catastrophic decompression, a spacer's worst nightmare."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d6ecaf6b-8a61-3ddb-8f63-15dcfd766687",
                                        "entry_id": "40e37788-6461-398b-a203-3eb1c29c98d5",
                                        "glosses": [
                                            "An object inserted to hold a space open in a row of items, e.g. beads or printed type."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8c0340da-4f1a-31e4-b391-881e743d2f37",
                                        "entry_id": "40e37788-6461-398b-a203-3eb1c29c98d5",
                                        "glosses": [
                                            "A bushing."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b18ad067-7a5d-3838-ab33-ea4849cf8ba0",
                                        "entry_id": "40e37788-6461-398b-a203-3eb1c29c98d5",
                                        "glosses": [
                                            "A forgetful person; one who spaces out."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dbb19bd9-ec01-3c0a-b46b-e588eda4a965",
                                        "entry_id": "40e37788-6461-398b-a203-3eb1c29c98d5",
                                        "glosses": [
                                            "A type of add-on device used by an asthmatic person to increase the effectiveness of a metered-dose inhaler."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "16dd230a-f167-387e-9dd0-3778e0d2af6a",
                                        "entry_id": "40e37788-6461-398b-a203-3eb1c29c98d5",
                                        "glosses": [
                                            "An instrument for reversing a telegraphic current, especially in a marine cable, to increase the speed of transmission."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
