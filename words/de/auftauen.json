    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fe4e465e-a6a7-32c6-b9ce-48cbb8c9b653",
                    "sense_definition": "etwas Gefrorenes durch Wärmezufuhr vom Eis befreien oder wieder weich machen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "schmelzen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vor der Zubereitung müssen Sie das gefrorene Fleisch langsam im Kühlschrank <w>auftauen</w>."
                        },
                        {
                            "text": "Sie <w>taut</w> die eingefrorenen Beeren vor dem Backen in einer Schale <w>auf</w>."
                        }
                    ],
                    "synonyms": [
                        "entfrosten"
                    ],
                    "antonyms": [
                        "einfrieren",
                        "tiefkühlen"
                    ],
                    "common_phrases": [
                        "Fleisch auftauen",
                        "Gemüse auftauen"
                    ]
                },
                {
                    "sense_id": "6a66f2c9-cf1d-3d18-9cf8-709742dd36da",
                    "sense_definition": "durch ansteigende Temperaturen das Eis verlieren und wieder flüssig oder weich werden",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "schmelzen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Im Frühling steigen die Temperaturen und der zugefrorene See beginnt langsam wieder <w>aufzutauen</w>."
                        },
                        {
                            "text": "Wenn der gefrorene Boden <w>auftaut</w>, verwandeln sich die unbefestigten Wege oft in tiefen Schlamm."
                        }
                    ],
                    "synonyms": [
                        "schmelzen"
                    ],
                    "antonyms": [
                        "gefrieren",
                        "zufrieren"
                    ],
                    "common_phrases": [
                        "langsam auftauen"
                    ]
                },
                {
                    "sense_id": "95ea5fc3-af43-3e4b-9743-ccbfc80d7f2c",
                    "sense_definition": "seine anfängliche Schüchternheit oder Zurückhaltung verlieren und gesprächiger werden",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "kontaktfreudig_werden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zu Beginn war der neue Kollege sehr still, aber nach einigen Stunden <w>taute</w> er merklich <w>auf</w>."
                        },
                        {
                            "text": "Auf der Feier brauchte sie etwas Zeit, bis sie in der großen Runde richtig <w>auftauen</w> konnte."
                        }
                    ],
                    "synonyms": [
                        "aufblühen",
                        "warmwerden"
                    ],
                    "antonyms": [],
                    "common_phrases": [
                        "langsam auftauen",
                        "sichtlich auftauen"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2b35963e-a97b-3630-889c-aed4aad1b131",
                    "sense_definition": "der Prozess, bei dem Gefrorenes durch Wärmeeinwirkung wieder flüssig oder weich wird",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "schmelzen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Das schonende <w>Auftauen</w> von Lebensmitteln im Kühlschrank verhindert die Bildung schädlicher Bakterien."
                        },
                        {
                            "text": "Das <w>Auftauen</w> der zugefrorenen Wasserleitungen dauerte mehrere Stunden."
                        }
                    ],
                    "synonyms": [
                        "Schmelzen"
                    ],
                    "antonyms": [
                        "Einfrieren"
                    ],
                    "common_phrases": [
                        "schonendes Auftauen",
                        "Auftauen von Lebensmitteln"
                    ]
                }
            ]
        }
    ]
