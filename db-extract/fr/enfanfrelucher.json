                "senses": [
                    {
                        "sense_id": "1e93ab64-213e-3fee-8e1e-e991d720067e",
                        "entry_id": "53692b91-2485-309e-b15c-205f0a0ae473",
                        "glosses": [
                            "Vêtir de fanfreluches."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ef7b857-24de-4e80-99ad-bf2a18f1831d",
                                "sense_id": "1e93ab64-213e-3fee-8e1e-e991d720067e",
                                "text": "Si on avait rendu à ces danses la naïveté de leur allure primitive, au lieu de les enfanfrelucher au goût du jour, on eût éprouvé un plaisir sans mélange, mais telles qu’elles étaient présentées, elles reposaient tant de la coupe habituelle des ballets et des divertissements que l’ensemble était des plus agréables."
                            },
                            {
                                "example_id": "dd842175-c04a-4f81-9843-e1ad913d3484",
                                "sense_id": "1e93ab64-213e-3fee-8e1e-e991d720067e",
                                "text": "Près de deux cents matous ont défilé sur la piste, chapeautés, enfanfreluchés, déguisés en mousquetaires ou en marquises."
                            }
                        ]
                    }
                ],
