                "senses": [
                    {
                        "sense_id": "cde25507-ee71-396b-a0a3-61008954d659",
                        "entry_id": "2e23125c-a726-307c-b679-7a973071d185",
                        "glosses": [
                            "Relatif à la pituite."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "585b9022-0986-4fe8-9d2e-026a22847e78",
                                "sense_id": "cde25507-ee71-396b-a0a3-61008954d659",
                                "text": "[…] on sait depuis peu que le siège de la morve est dans la membrane pituitaire ; que c'est par conséquent un vrai rhume, qui à la longue cause une inflammation dans cette membrane […]."
                            },
                            {
                                "example_id": "d4d6fd03-1602-4fbe-9260-0bef8dd0ee44",
                                "sense_id": "cde25507-ee71-396b-a0a3-61008954d659",
                                "text": "La glande pituitaire ou hypophyse est une glande à sécrétion interne, logée à la base du crâne, qui a d’importantes fonctions physiologiques."
                            }
                        ]
                    },
                    {
                        "sense_id": "0f024841-315b-30c5-aa66-737be358a3b1",
                        "entry_id": "2e23125c-a726-307c-b679-7a973071d185",
                        "glosses": [
                            "Qui est affecté par la pituite."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18530e1c-c016-4ed9-b8fd-64836585ffea",
                                "sense_id": "0f024841-315b-30c5-aa66-737be358a3b1",
                                "text": "Et il grogne, s’emporte, menace, la voix pituitaire, les bronches encore graillonnantes du champagne mal cuvé de la veille."
                            }
                        ]
                    },
                    {
                        "sense_id": "3e702087-7957-3d94-b347-8af16ad19ff5",
                        "entry_id": "2e23125c-a726-307c-b679-7a973071d185",
                        "glosses": [
                            "Hypophysaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e4b6d20-19e5-466c-aa09-b423a63c01cb",
                                "sense_id": "3e702087-7957-3d94-b347-8af16ad19ff5",
                                "text": "Ces substances chimiques, les gonadotropines, sont produites, accumulées et emmagasinées dans la glande pituitaire du poisson, appelée hypophyse, pendant leur passage au stade de la maturité sexuelle."
                            }
                        ]
                    }
