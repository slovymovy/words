                                "target_word": "Legalität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "de48c559-29b5-32f2-b254-981ebbffc76a",
                                        "entry_id": "2908ea0d-d64e-353b-857f-018e52cefe5d",
                                        "glosses": [
                                            "Eigenschaft, den geltenden Gesetzen zu entsprechen und damit gesetzeskonform, rechtmäßig (legal) zu sein"
                                        ],
                                        "tags": [
                                            "singular",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b6bb2f7f-0259-4966-8bc5-b240328b87ed",
                                                "sense_id": "de48c559-29b5-32f2-b254-981ebbffc76a",
                                                "text": "„Bevor auf mögliche Konflikte zwischen Legalität und (moralischer) Legitimität eingegangen wird, ist es erforderlich, das Verhältnis zwischen Recht und Moral zu klären.“"
                                            },
                                            {
                                                "example_id": "784b76c6-5e9c-421a-9e00-a865f932b17d",
                                                "sense_id": "de48c559-29b5-32f2-b254-981ebbffc76a",
                                                "text": "Es handelt sich hierbei um eine Grauzone am Rande der Legalität."
                                            },
                                            {
                                                "example_id": "531e6ca6-9fbc-484a-af94-2affb2dc4f37",
                                                "sense_id": "de48c559-29b5-32f2-b254-981ebbffc76a",
                                                "text": "Sie versuchten, dem Geschäft einen Anschein von Legalität zu geben."
                                            },
                                            {
                                                "example_id": "9e55e834-11c4-480d-b3f2-e2f9b5f4d6f3",
                                                "sense_id": "de48c559-29b5-32f2-b254-981ebbffc76a",
                                                "text": "„Er kannte sich recht gut aus, was die Gesetze in Frankreich anging und wie der Kunsthandel abseits der Legalität so funktionierte.“"
                                            },
                                            {
                                                "example_id": "95404d85-316e-4a06-ad68-4d650ab76bcb",
                                                "sense_id": "de48c559-29b5-32f2-b254-981ebbffc76a",
                                                "text": "„Hoffmann rührt sich; er protestiert im Namen der Gerechtigkeit und Legalität, weigert sich, sich korrumpieren zu lassen und reicht schließlich seine Demission als Mitglied der Untersuchungskommission ein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "57f51f29-386f-4f78-ad0a-291d173dc4d0",
                        "source_entry_id": "39164e5e-dfe7-3deb-a280-2a0380eaa3fd",
                        "source_sense_id": "15b80d53-ecae-3a19-b22f-162f61425ed2",
                        "source_sense_description": "Legalität, Gesetzmäßigkeit",
                        "target_lang_word": "Gesetzmäßigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gesetzmäßigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8fc8c27e-6d32-315d-87ad-23cdc6f59609",
                                        "entry_id": "9ffb204c-3079-31c2-8511-5bd04c51549b",
                                        "glosses": [
                                            "Verhältnis oder Zustand, der den geltenden gesetzlichen Regelungen entspricht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ce7340f-f359-452c-a180-7161e461d187",
                                                "sense_id": "8fc8c27e-6d32-315d-87ad-23cdc6f59609",
                                                "text": "Es ist eine große Aufgabe, in einem Land Gesetzmäßigkeit herzustellen und dann auch zu erhalten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ade3b7b9-d3b6-3211-afb5-3263acd5e0f6",
                                        "entry_id": "9ffb204c-3079-31c2-8511-5bd04c51549b",
                                        "glosses": [
                                            "Prozess oder Zustand, der einem bekannten, regelmäßigen, dokumentierten Ablauf entspricht und sich daraus ergibt"
                                        ],
                                        "tags": [
                                            "Wissenschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f32fd4ff-9942-41aa-ba69-87731a6caf06",
                                                "sense_id": "ade3b7b9-d3b6-3211-afb5-3263acd5e0f6",
                                                "text": "„Hierbei ist die Fokussierung auf die Verallgemeinerung von Beobachtungen zu betonen, die in einer Systematisierung und Postulierung von Gesetzmäßigkeiten in einer Sprache münden sollte.“"
                                            },
                                            {
                                                "example_id": "541b87d3-90a6-4698-81b9-ab360f2c2585",
                                                "sense_id": "ade3b7b9-d3b6-3211-afb5-3263acd5e0f6",
                                                "text": "„Es gibt in der Tat zahlreiche dialektale Lautungen, die in keiner (bislang) erkennbaren Weise allgemeinen Gesetzmäßigkeiten unterliegen, sondern vermutlich als Idiosynkrasien gewertet werden müssen.“"
                                            },
                                            {
                                                "example_id": "80d5df9c-e2b0-4eda-a03c-cb7c51c011c7",
                                                "sense_id": "ade3b7b9-d3b6-3211-afb5-3263acd5e0f6",
                                                "text": "„Es gibt aber eine lehr- und erlernbare Methode, in der Natur Gesetzmäßigkeiten zu finden.“"
                                            },
                                            {
                                                "example_id": "60cc650e-141d-47d7-aab5-de7bd7140826",
                                                "sense_id": "ade3b7b9-d3b6-3211-afb5-3263acd5e0f6",
                                                "text": "„Die Linguisten haben herausgefunden, welche Sprachen miteinander verwandt sind und nach welchen Gesetzmäßigkeiten sich Aussprache und Grammatik im Lauf der Zeit verändert haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
