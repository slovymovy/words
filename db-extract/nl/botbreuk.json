                ],
                "senses": [
                    {
                        "sense_id": "a3e20c6f-1e5a-31a8-a566-9c71a0b9bc02",
                        "entry_id": "86548cfc-f665-33c6-bb11-5394d943b8c3",
                        "glosses": [
                            "het in twee of meer delen gebroken zijn van een bot"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44fa3b0d-0582-41e8-b605-0ac41a21862a",
                                "sense_id": "a3e20c6f-1e5a-31a8-a566-9c71a0b9bc02",
                                "text": "Ik kwam England weer tegen in South Lake Tahoe. Helaas had hij nog altijd last van zijn ontstoken voet waardoor hij uiteindelijk de trail niet zou kunnen voltooien. Hij was niet de enige: meer dan 65 procent van de hikers maakt de PCT niet helemaal af, voornamelijk vanwege blessures zoals ontstoken blaren, scheenbeenvliesontsteking, botbreuken, overbelasting en oververmoeidheid."
                            },
                            {
                                "example_id": "34c2d0e2-efbf-4de0-9039-c9e8a5bf3572",
                                "sense_id": "a3e20c6f-1e5a-31a8-a566-9c71a0b9bc02",
                                "text": "Van alle fietsslachtoffers vorig jaar had ongeveer de helft (49 procent) een botbreuk. Maar een fietsongeluk kan ook leiden tot licht hersenletsel (13 procent) of ernstige schade aan de hersenen of de schedel (4 procent)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "72addd62-1100-41af-9f51-106a5c49a996",
                        "source_entry_id": "86548cfc-f665-33c6-bb11-5394d943b8c3",
                        "source_sense_id": "a3e20c6f-1e5a-31a8-a566-9c71a0b9bc02",
                        "source_sense_description": "een onderbreking van een bot",
                        "target_lang_word": "Fraktur",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fraktur",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9a52d9e1-f408-36ac-a389-6dbd7aaca3dd",
                                        "entry_id": "ecf76861-3d47-3831-bd60-b7e7d2ee6fa0",
                                        "glosses": [
                                            "Knochenbruch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0bc252a-e011-4a60-be2f-e50d4a303543",
                                                "sense_id": "9a52d9e1-f408-36ac-a389-6dbd7aaca3dd",
                                                "text": "„Mit der Fraktur und einem Nervenschock wurde er ins Lazarett gebracht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "054d3e24-a42f-351d-a9d7-92cb93c529ac",
                                        "entry_id": "ecf76861-3d47-3831-bd60-b7e7d2ee6fa0",
                                        "glosses": [
                                            "eine bestimmte Schriftart der gebrochenen Schrift"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "42072baf-d1c5-4485-ab9a-b081b4118e9c",
                                                "sense_id": "054d3e24-a42f-351d-a9d7-92cb93c529ac",
                                                "text": "Das Buch ist in Fraktur gedruckt."
                                            },
                                            {
                                                "example_id": "8c945ef8-7f91-4ac1-a2f1-df0f21189741",
                                                "sense_id": "054d3e24-a42f-351d-a9d7-92cb93c529ac",
                                                "text": "„Es ist die Zeit nach 1941. Diese ist in schriftgestalterischer Hinsicht vom Übergang von der Fraktur zur Antiqua gekennzeichnet, was sich in postalischer Hinsicht am deutlichsten an der Gestaltung der Postwertzeichen festmachen lässt.“"
                                            },
                                            {
                                                "example_id": "0ccdb592-6026-4d25-8bd5-89cb85e75bc8",
                                                "sense_id": "054d3e24-a42f-351d-a9d7-92cb93c529ac",
                                                "text": "„Literarische Autoren setzte man hierzulande vorzugsweise in Fraktur, und zwar bis weit ins 20. Jahrhundert hinein.“"
                                            },
                                            {
                                                "example_id": "38423210-9ce5-46b5-aa83-d08b22be419f",
                                                "sense_id": "054d3e24-a42f-351d-a9d7-92cb93c529ac",
                                                "text": "„Solche fremdsprachigen Wörter werden aber dann in Fraktur gesetzt, wenn sie in Schreibung, Beugung oder Lautung eingedeutscht sind oder mit einem einheimischen Wort zusammengesetzt werden.“"
                                            },
                                            {
                                                "example_id": "5c4d302f-ccc2-429f-aead-3fa60cba410d",
                                                "sense_id": "054d3e24-a42f-351d-a9d7-92cb93c529ac",
                                                "text": "„Langsam sah er von dem alten, in Fraktur gedruckten Buch auf, das er aufgeschlagen hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "74401f36-6732-3637-9a7f-ac0b2e883428",
                                        "entry_id": "ecf76861-3d47-3831-bd60-b7e7d2ee6fa0",
                                        "glosses": [
                                            "alle gebrochenen Schriften"
                                        ],
                                        "tags": [
                                            "Druckereiwesen (verallgemeinernd)"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c7753e5a-18ec-437e-8a1f-ff909bf95f9b",
                                                "sense_id": "74401f36-6732-3637-9a7f-ac0b2e883428",
                                                "text": "In Frakturschriften muss das lange s gesetzt werden."
                                            },
                                            {
                                                "example_id": "949365c0-8655-44df-94f2-3797db4436b6",
                                                "sense_id": "74401f36-6732-3637-9a7f-ac0b2e883428",
                                                "text": "In Frakturſchriften muſs das lange ſ geſetzt werden."
                                            },
                                            {
                                                "example_id": "17f70278-8520-41a9-8bc5-33722873b165",
                                                "sense_id": "74401f36-6732-3637-9a7f-ac0b2e883428",
                                                "text": "„Auch eine bestimmte Schriftart wie etwa eine Fraktur kann ihre Assoziationen nur im Kontrast zu anderen Schriftarten, zur Textsortenerwartung und zum Inhalt entfalten (…) und flächentypographische Phänomene setzen den Text geradezu voraus.“"
                                            },
                                            {
                                                "example_id": "cc3fcdd8-8010-43a0-b2f7-f6cac10db696",
                                                "sense_id": "74401f36-6732-3637-9a7f-ac0b2e883428",
                                                "text": "„Als Druckschrift (englisch German type, Gothic type) für deutsche Texte war sie bis zur Abschaffung durch die Nationalsozialisten 1941 in Gebrauch, obwohl bereits zu Beginn des 20. Jahrhunderts ein heftiger Streit zwischen Anhängern der Fraktur und der Antiqua ausgebrochen war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eeab69ec-c418-44f0-8f00-016135697058",
                        "source_entry_id": "86548cfc-f665-33c6-bb11-5394d943b8c3",
