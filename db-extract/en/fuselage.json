                        "target_lang_word": "Flugzeugrumpf",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Flugzeugrumpf",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c2a16902-d292-3e58-a35e-db3e9c738784",
                                        "entry_id": "c6adf2ec-7d1c-34cc-9c96-109f51df6c51",
                                        "glosses": [
                                            "Bauteil eines Flugzeugs, der das Cockpit und den Raum für Passagiere und Nutzlast beinhaltet"
                                        ],
                                        "tags": [
                                            "Luftfahrt"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b701d953-7975-457b-9387-b34630419fe2",
                                                "sense_id": "c2a16902-d292-3e58-a35e-db3e9c738784",
                                                "text": "„Zehn Fans, deren Portraitfotos letztendlich auf den Flugzeugrumpf aufgeklebt wurden, wurden aus 400 Einsender ausgewählt.“"
                                            },
                                            {
                                                "example_id": "1f456915-03c1-4d91-91eb-56233db7993f",
                                                "sense_id": "c2a16902-d292-3e58-a35e-db3e9c738784",
                                                "text": "„Für die Techniker in Hamburg wiederum bedeutete die Generalüberholung vor allem eine Menge Arbeit. So wurden die beiden Tragflächen vom Flugzeugrumpf gelöst und in große, eigens dafür konstruierte Gerüste gehängt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8626b6d9-b461-43ab-9f20-f720cdfac6dd",
                        "source_entry_id": "76a139c1-2002-36d8-8f0b-f70d34e63e13",
                        "source_sense_id": "776d2d3e-1588-368e-a0d0-973f593b9931",
                        "source_sense_description": "main body of aerospace vehicle",
                        "target_lang_word": "Rumpf",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rumpf",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "808f8403-abab-3bc9-8a90-03b5f4276fe9",
                                        "entry_id": "82dbf02b-4b40-33dc-a21d-d60ccd49784a",
                                        "glosses": [
                                            "die Unterseite oder der untere Teil eines Schiffes, Flugzeugs oder Ähnlichem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a52d30d-836d-4c31-a5ad-d24f9b7706cd",
                                                "sense_id": "808f8403-abab-3bc9-8a90-03b5f4276fe9",
                                                "text": "Im Rumpf des Schiffes war nicht genug Platz für die Ladung."
                                            },
                                            {
                                                "example_id": "82165f2e-08e6-4c03-9a7d-4999fc313992",
                                                "sense_id": "808f8403-abab-3bc9-8a90-03b5f4276fe9",
                                                "text": "„Manche Quellen behaupten deshalb, der hölzerne Rumpf des Schiffes sei schon rott gewesen.“"
                                            },
                                            {
                                                "example_id": "9dc89e85-889b-4b47-90bb-f0efb9818d45",
                                                "sense_id": "808f8403-abab-3bc9-8a90-03b5f4276fe9",
                                                "text": "„Beginnend am Kiel, fügen die Handwerker nun den Rumpf zusammen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ff783df3-4273-3e14-879e-80c5f335e378",
                                        "entry_id": "82dbf02b-4b40-33dc-a21d-d60ccd49784a",
                                        "glosses": [
                                            "zentraler Abschnitt des Körpers (ohne Kopf, Hals, Gliedmaßen und Schwanz)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "efefc0d1-f154-4431-8511-3dae2c690f6b",
                                                "sense_id": "ff783df3-4273-3e14-879e-80c5f335e378",
                                                "text": "Bisher wurde nur der Rumpf der Leiche gefunden; Kopf und Gliedmaßen werden noch gesucht."
                                            },
                                            {
                                                "example_id": "847df342-69ed-4156-8786-356b75b0b954",
                                                "sense_id": "ff783df3-4273-3e14-879e-80c5f335e378",
                                                "text": "„Kutusow sass auf seinem Bett, liess das eine Bein herunterhängen und das Gewicht seines mächtigen Rumpfes auf dem andern Bein ruhen, das er untergeschlagen hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c973d835-53a9-3cd4-a061-9e08592122e7",
                                        "entry_id": "82dbf02b-4b40-33dc-a21d-d60ccd49784a",
                                        "glosses": [
                                            "der grundlegende Teil von etwas"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ee56492-1b6d-4df2-9204-e62960087a8e",
                                                "sense_id": "c973d835-53a9-3cd4-a061-9e08592122e7",
                                                "text": "Der Rumpf der gemeinnützigen Roosevelt Institution stand wenig später, die Gruppen schlossen sich zusammen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
