                        "cross_references": []
                    },
                    {
                        "translation_id": "62dc5672-90fd-4653-8380-be744d43fe63",
                        "source_entry_id": "c5af4930-59b2-3e3c-9af3-c2b394e5315b",
                        "source_sense_id": "70b475d2-ec15-3f67-a80a-23dbb2f1c14d",
                        "target_lang_word": "первородство",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "первородство",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "1751ed46-6f16-311c-b6b2-ef8088e38693",
                                        "entry_id": "2aa9847a-a4bf-3fbd-9e0b-7d6c8766879c",
                                        "glosses": [
                                            "старшинство по рождению среди братьев"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79126ea4-f79c-4bf0-8fdc-ec79a10edd62",
                                                "sense_id": "1751ed46-6f16-311c-b6b2-ef8088e38693",
                                                "text": "Ни о каком насильстве тут и слова быть не может: престол московский принадлежит, по праву первородства, благоверному царевичу Ивану Алексеевичу..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89152626-3b5e-3483-8678-5465366401b6",
                                        "entry_id": "2aa9847a-a4bf-3fbd-9e0b-7d6c8766879c",
                                        "glosses": [
                                            "перен. первенство, исторический приоритет в чём-либо, среди кого-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46298764-b301-43a3-b001-fba061070de3",
                                                "sense_id": "89152626-3b5e-3483-8678-5465366401b6",
                                                "text": "Но так как тяжба за футуристическое первородство разрешалась на мой взгляд только в плане общих счетов Запада с Востоком, я счел необходимым расширить вопрос до пределов, намеченных нашим тройственным манифестом, то есть провести грань между двумя системами эстетического восприятия мира ― на протяжении целого столетия."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
