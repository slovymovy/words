                ],
                "senses": [
                    {
                        "sense_id": "f656ecd4-695e-3594-871d-b1fd5bd9c3c5",
                        "entry_id": "9ed61f3e-0e51-3117-b84f-9a3a808292ad",
                        "glosses": [
                            "boorishness (something that is boorish)"
                        ],
                        "tags": [
                            "neuter"
                        ],
                        "examples": [
                            {
                                "example_id": "21e0f4c4-3fb3-4ac7-b533-1ba3ff1f8c66",
                                "sense_id": "f656ecd4-695e-3594-871d-b1fd5bd9c3c5",
                                "text": "Near-synonyms: brutalność, chamskość, ordynarność"
                            },
                            {
                                "example_id": "1950436d-6916-4114-84ff-90c6bd7f1393",
                                "sense_id": "f656ecd4-695e-3594-871d-b1fd5bd9c3c5",
                                "text": "Gdy zdrożność w usłudze gospodarz postrzeże, nie powinien czeladź w obecności gościa znieważać, jest to albowiem dzikie grubiaństwo;",
                                "translation": "When the host notices misconduct in the service, he should not insult the servant in the presence of the guest, for this is wild boorishness;",
                                "english": "When the host notices misconduct in the service, he should not insult the servant in the presence of the guest, for this is wild boorishness;"
                            },
                            {
                                "example_id": "bf2f0530-63ec-4b2e-a444-4f89835bb518",
                                "sense_id": "f656ecd4-695e-3594-871d-b1fd5bd9c3c5",
                                "text": "Hola, kolego! nie bądź taki raptusowy.\nJest[]że to grubijaństwo albo skutek trwogi?",
                                "translation": "Hey, mate! don't be so impulsive.\nBut is it boorishness or the result of fear?",
                                "english": "Hey, mate! don't be so impulsive.\nBut is it boorishness or the result of fear?"
                            },
                            {
                                "example_id": "dda0ee75-da2d-4358-a161-733759bc1ac4",
                                "sense_id": "f656ecd4-695e-3594-871d-b1fd5bd9c3c5",
                                "text": "— Nieraz uwięzioną, której pilnujesz, własną ręką wtrącałaś w rozpacz, jakiej sama w tej chwili doznajesz, przez swoje grubjaństwo, przez swoje oskarżenia.",
                                "translation": "— More than once, you have plunged the prisoner you are guarding into the same despair you are now experiencing, through your boorishness and your accusations.",
                                "english": "— More than once, you have plunged the prisoner you are guarding into the same despair you are now experiencing, through your boorishness and your accusations."
                            },
                            {
                                "example_id": "089dc457-ae9f-44f3-9d44-aa4896c09bf3",
                                "sense_id": "f656ecd4-695e-3594-871d-b1fd5bd9c3c5",
                                "text": "— Ojciec twój — mówiła — był popędliwy, gniewał się często, a gdy rozgniewał się, mógł i grubiaństwo nawet powiedzieć…",
                                "translation": "— Your father — she said — was quick-tempered, often angry, and when he got angry, he could even say a boorishness…",
                                "english": "— Your father — she said — was quick-tempered, often angry, and when he got angry, he could even say a boorishness…"
                            },
                            {
                                "example_id": "ba9d7ecd-1c0c-49d2-997a-6bf0410ec40e",
                                "sense_id": "f656ecd4-695e-3594-871d-b1fd5bd9c3c5",
                                "text": "Bo zresztą był szczery aż do grubjaństwa wobec ludzi, których nie znosił.",
                                "translation": "Because he was honest to the point of boorishness towards people, that he disliked.",
                                "english": "Because he was honest to the point of boorishness towards people, that he disliked."
                            },
                            {
                                "example_id": "c402356c-b086-4691-a9c9-7f7acca45bf1",
                                "sense_id": "f656ecd4-695e-3594-871d-b1fd5bd9c3c5",
                                "text": "Długo cierpiałam jego grubiaństwa. Ale kiedy mi zaczął wycinać drzewa naokoło domu, powiedziałam: basta.",
                                "translation": "I endured his boorishness for a long time. But when he started cutting down trees around my house, I said: that does it.",
                                "english": "I endured his boorishness for a long time. But when he started cutting down trees around my house, I said: that does it."
                            }
                        ]
                    },
                    {
                        "sense_id": "b2ffdadd-f426-30eb-8c9f-7bcb5a5ddb96",
                        "entry_id": "9ed61f3e-0e51-3117-b84f-9a3a808292ad",
                        "glosses": [
                            "thickness (something that is thick)"
                        ],
                        "tags": [
                            "humorous",
                            "neuter"
                        ],
                        "examples": [
                            {
                                "example_id": "9dd7fe90-65c2-4cc9-a7f6-b12aee65cde2",
                                "sense_id": "b2ffdadd-f426-30eb-8c9f-7bcb5a5ddb96",
                                "text": "Im grubszy ubior… i skromniejsze pasy,\nTym więcej ją te [to] grubijaństwo stroi\nI płeć przemienia białą na atłasy,",
                                "translation": "The thicker the outfit… and the modester the belts,\nThe more this thickness adorns her,\nAnd transforms the white sex into satin,",
                                "english": "The thicker the outfit… and the modester the belts,\nThe more this thickness adorns her,\nAnd transforms the white sex into satin,"
                            }
                        ]
                    }
                ],
