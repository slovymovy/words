{
    "word_family": [
        "herb",
        "herbalist",
        "herbalism",
        "herbaceous",
        "herbicide",
        "herbivore"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "07e7a5c8-80e6-3b34-8ab3-8c95f75d3e4b",
                    "sense_definition": "Made from or containing herbs, often used for flavor or fragrance.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "herb_composition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Herbal</w> tea has a nice aroma and is good for a stuffy head.",
                            "target_lang_translations": {
                                "ru": "<w>Травяной</w> чай имеет приятный аромат и хорошо помогает при заложенности носа.",
                                "zh": "<w>草本</w>茶香气宜人，对缓解鼻塞很有帮助。"
                            }
                        },
                        {
                            "text": "The chef added a fresh <w>herbal</w> infusion to the sauce to enhance the flavor.",
                            "target_lang_translations": {
                                "ru": "Шеф-повар добавил в соус свежий <w>травяной</w> настой, чтобы усилить вкус.",
                                "zh": "厨师在酱汁中加入了新鲜的<w>草本</w>浸液以提升风味。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "herbal tea",
                        "herbal infusion",
                        "herbal scent"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделанный из трав или содержащий травы, часто используемый для придания вкуса или аромата.",
                        "zh": "由草本植物制成或含有草本成分，常用于调味或增香。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "травяной",
                                "target_lang_sense_clarification": "состоящий из трав"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "草本",
                                "target_lang_sense_clarification": "指植物成分"
                            },
                            {
                                "target_lang_word": "草本植物",
                                "target_lang_sense_clarification": "指草本类原料"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "88c56563-1e6f-3d3a-9c44-b0ea264ac821",
                    "sense_definition": "Relating to or using natural herbs for medicinal purposes, especially as an alternative to synthetic drugs.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "herb_medicine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many people prefer a <w>herbal</w> remedy for back-ache instead of taking strong pills.",
                            "target_lang_translations": {
                                "ru": "Многие люди предпочитают <w>растительное</w> средство от боли в спине вместо приема сильных таблеток.",
                                "zh": "许多人更喜欢用<w>草本</w>疗法来缓解背痛，而不是服用强效药片。"
                            }
                        },
                        {
                            "text": "Athletes' use of <w>herbal</w> supplements has skyrocketed in the past two decades.",
                            "target_lang_translations": {
                                "ru": "Использование атлетами <w>травяных</w> добавок резко возросло за последние два десятилетия.",
                                "zh": "过去二十年里，运动员对<w>草本</w>补充剂的使用量激增。"
                            }
                        }
                    ],
                    "synonyms": [
                        "botanical",
                        "natural"
                    ],
                    "antonyms": [
                        "synthetic",
                        "chemical"
                    ],
                    "common_phrases": [
                        "herbal remedy",
                        "herbal supplement",
                        "herbal medicine"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к использованию натуральных трав в лечебных целях, особенно как альтернатива синтетическим лекарствам.",
                        "zh": "指使用天然草本进行医疗，常作为合成药物的替代品。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "растительный",
                                "target_lang_sense_clarification": "на основе растений"
                            },
                            {
                                "target_lang_word": "травяной",
                                "target_lang_sense_clarification": "лечебный сбор"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "草本",
                                "target_lang_sense_clarification": "指药用草本"
                            },
                            {
                                "target_lang_word": "植物性",
                                "target_lang_sense_clarification": "指来源为植物"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3544db48-1f85-36b7-bbb5-bf29a3f1e085",
                    "sense_definition": "A pill, powder, or liquid made from herbs used as a dietary supplement.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "herb_medicine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I went to the health store and stocked up on <w>herbals</w> to boost my immune system.",
                            "target_lang_translations": {
                                "ru": "Я зашел в магазин товаров для здоровья и запасся <w>травяными препаратами</w>, чтобы укрепить иммунную систему.",
                                "zh": "我去了保健品店，囤了一些<w>草本制剂</w>来增强免疫系统。"
                            }
                        },
                        {
                            "text": "You should consult a doctor before mixing your prescription medication with various <w>herbals</w>.",
                            "target_lang_translations": {
                                "ru": "Вам следует проконсультироваться с врачом, прежде чем смешивать рецептурные лекарства с различными <w>фитопрепаратами</w>.",
                                "zh": "在将处方药与各种<w>草本制剂</w>混合使用前，你应该咨询医生。"
                            }
                        }
                    ],
                    "synonyms": [
                        "supplement"
                    ],
                    "common_phrases": [
                        "stock up on herbals"
                    ],
                    "target_lang_definitions": {
                        "ru": "Таблетка, порошок или жидкость из трав, используемые в качестве пищевой добавки.",
                        "zh": "由草本植物制成的药丸、粉末或液体，用作膳食补充剂。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "травяной препарат",
                                "target_lang_sense_clarification": "лекарственное средство"
                            },
                            {
                                "target_lang_word": "фитопрепарат",
                                "target_lang_sense_clarification": "средство на растительной основе"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "草本制剂",
                                "target_lang_sense_clarification": "指草本类药物"
                            },
                            {
                                "target_lang_word": "植物药",
                                "target_lang_sense_clarification": "指草本类补充剂"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2d47b90a-09e3-3fcf-97e4-255ac001d6fd",
                    "sense_definition": "A book or manual that describes plants and their medicinal properties.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "herb_literature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient <w>herbal</w> contains detailed illustrations of plants used for healing in the Middle Ages.",
                            "target_lang_translations": {
                                "ru": "Древний <w>травник</w> содержит подробные иллюстрации растений, использовавшихся для лечения в Средние века.",
                                "zh": "这本古老的<w>本草书</w>包含了中世纪用于治疗的植物的详细插图。"
                            }
                        },
                        {
                            "text": "It can still be found in <w>herbals</w> and such, which describe it as a sedative.",
                            "target_lang_translations": {
                                "ru": "Его все еще можно найти в <w>травниках</w> и подобных книгах, где оно описывается как успокоительное средство.",
                                "zh": "它仍然可以在<w>本草书</w>之类的文献中找到，书中将其描述为一种镇静剂。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "illustrated herbal",
                        "medieval herbal"
                    ],
                    "target_lang_definitions": {
                        "ru": "Книга или руководство с описанием растений и их лечебных свойств.",
                        "zh": "描述植物及其药用价值的书籍或手册。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "травник",
                                "target_lang_sense_clarification": "книга о лечебных травах"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "本草书",
                                "target_lang_sense_clarification": "指记载草药的书籍"
                            },
                            {
                                "target_lang_word": "草药志",
                                "target_lang_sense_clarification": "指植物药用手册"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}