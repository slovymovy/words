                    }
                ],
                "senses": [
                    {
                        "sense_id": "047cfbf0-3ccd-3ac9-8d88-251a66a659fd",
                        "entry_id": "f86110ef-e8d8-34d2-9b88-fb448f1925ba",
                        "glosses": [
                            "Im Stil von Klaus Kinski"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0411ae28-290d-4071-90ec-3a419a3baeb8",
                                "sense_id": "047cfbf0-3ccd-3ac9-8d88-251a66a659fd",
                                "text": "Zwar versuchte er ständig diesen kinskiesk anmutenden Block eines Wahnsinnigen nachzuahmen, aber wenigstens hatte er Pupillen."
                            },
                            {
                                "example_id": "6d8d0ee2-af70-4c34-8310-1ceceb0c2540",
                                "sense_id": "047cfbf0-3ccd-3ac9-8d88-251a66a659fd",
                                "text": "Dann oft kinskiesk bis zuletzt auf der Reise in's Grotesk."
                            },
                            {
                                "example_id": "c6dcecee-fe2b-420a-b1a6-f5172b3b9849",
                                "sense_id": "047cfbf0-3ccd-3ac9-8d88-251a66a659fd",
                                "text": "„Das Herzstück des Clubs befindet sich aber, entsprechend seiner kinskiesken Abgründigkeit, im Keller.“"
                            },
                            {
                                "example_id": "f8611b11-63e4-4da1-a027-163edd164f74",
                                "sense_id": "047cfbf0-3ccd-3ac9-8d88-251a66a659fd",
                                "text": "„Mühsam stehe ich auf und durchbohre das Mulch mit einem kinskiesken Frageblick.“"
                            },
                            {
                                "example_id": "4721beb8-2f45-4d7d-a2dc-0f3e6aa8095f",
                                "sense_id": "047cfbf0-3ccd-3ac9-8d88-251a66a659fd",
                                "text": "„Karl Gunther (Klaus Kinski) ist Hausverwalter, Sohn eines berüchtigten Nazi-Arztes und vermietet die Wohnung eines Wohnkomplexes gern an attraktive Frauen, deren erotisches Treiben er mit inbrünstiger, kinskiesker Leidenschaft durch die Lüftungsschlitze des Gebäudes beobachtet.“"
                            },
                            {
