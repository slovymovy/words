                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "971a6b67-3c67-49a4-a435-697aca525d00",
                        "source_entry_id": "57671fd7-dd76-336a-93bb-18df6163be3e",
                        "target_lang_word": "interactif",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "interactif",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4877cb29-5a99-37da-9816-8bb2abfcf7a6",
                                        "entry_id": "0b52ff7d-a8bc-3a51-98b5-132a358f9e63",
                                        "glosses": [
                                            "Qualifie les matériels, les programmes ou les conditions d’exploitation qui permettent des actions réciproques avec des utilisateurs, des spectateurs ou des appareils."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0300bddc-3208-4186-a92b-5013de8c9fc6",
                                                "sense_id": "4877cb29-5a99-37da-9816-8bb2abfcf7a6",
                                                "text": "Notre premier objectif final était de produire un cédérom interactif de la Bible Porta qui puisse être éventuellement commercialisé et qui de ce fait doit être multiplate-forme même si le produit de base est établi sur Macintosh."
                                            },
                                            {
                                                "example_id": "0cbcd146-39a8-42c2-9ae2-c3614bb2ef44",
                                                "sense_id": "4877cb29-5a99-37da-9816-8bb2abfcf7a6",
                                                "text": "La saison 5 de « Black Mirror » comportera un épisode interactif, où le public pourra choisir entre plusieurs versions de l’intrigue."
                                            },
                                            {
                                                "example_id": "bd5ccd63-89ca-435b-88fa-736686fec49c",
                                                "sense_id": "4877cb29-5a99-37da-9816-8bb2abfcf7a6",
                                                "text": "Au menu : des tables rondes, dont celles animées par notre journaliste Lise Abou Mansour, à qui l’on doit la rubrique Ma tête et moi (la première traite du coming-out, la seconde a pour thème Filmer la psychanalyse), des ateliers interactifs, des talks."
                                            },
                                            {
                                                "example_id": "e496a2dc-ef1c-4310-990c-5f3988440757",
                                                "sense_id": "4877cb29-5a99-37da-9816-8bb2abfcf7a6",
                                                "text": "Jouée par Katel Lejeune et Anthony Gilbert, la pièce, dynamique, interactive avec le public, intégrant plusieurs flash-back dans son intrique, a beaucoup fait rire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
