                    {
                        "translation_id": "84a3a1e2-eaa1-4f2e-a548-cff558c5c954",
                        "source_entry_id": "8f1dd4bc-43f2-3bec-b426-6690a8b5cdb4",
                        "source_sense_id": "4a52766b-728e-3e35-8cb7-88f27f5993f5",
                        "target_lang_word": "helper",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "helper",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1ba9e8c3-c2f3-3808-b6c2-e473b0da57c2",
                                        "entry_id": "0625c806-cac4-3cad-8e05-50aed2dd45a9",
                                        "glosses": [
                                            "One who helps; an aide; assistant; auxiliary."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b262ce23-981d-3f0c-ab11-29acfec95780",
                                        "entry_id": "0625c806-cac4-3cad-8e05-50aed2dd45a9",
                                        "glosses": [
                                            "That which helps; anything serving to assist."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d8eb190-27fd-41c1-bae3-199e0fc9f0d9",
                                                "sense_id": "b262ce23-981d-3f0c-ab11-29acfec95780",
                                                "text": "While Adobe's Acrobat Reader, Macromedia's Flash player, and other common plug-ins suggest themselves the moment you encounter a site that requires them, other browser helpers are harder to find."
                                            },
                                            {
                                                "example_id": "3a0904be-eba5-4219-8d0d-255daeaee35b",
                                                "sense_id": "b262ce23-981d-3f0c-ab11-29acfec95780",
                                                "text": "He no longer liked food that had “helper” in the name, such as Hamburger Helper and Tuna Helper. Patsy said he'd become uppity, and maybe, when it came to food, he had."
                                            },
                                            {
                                                "example_id": "dc54a340-14c5-4fc2-9ba9-5f66dfab2989",
                                                "sense_id": "b262ce23-981d-3f0c-ab11-29acfec95780",
                                                "text": "If a particular calculation is to be used a few times, it makes sense to put it in a helper cell so that it can be referred to by other formulas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45288fb9-0071-3208-89d4-6d34a6bd966b",
                                        "entry_id": "0625c806-cac4-3cad-8e05-50aed2dd45a9",
                                        "glosses": [
                                            "A person who does cleaning and cooking in a family home, or in a market; domestic employee."
                                        ],
                                        "tags": [
                                            "Hong-Kong",
                                            "Philippines",
                                            "Singapore"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bcb4f6de-932c-3ccc-9acf-f670190274d9",
                                        "entry_id": "0625c806-cac4-3cad-8e05-50aed2dd45a9",
                                        "glosses": [
                                            "A locomotive that assists a train, usually on steep gradients."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a20f1085-7a79-498e-819f-256cbbee121e",
                                                "sense_id": "bcb4f6de-932c-3ccc-9acf-f670190274d9",
                                                "text": "A device for the automatic control of crewless helper locomotives cut into the make-up of heavy freight trains has been perfected by the Louisville & Nashville RR in conjunction with the General Railway Signalling Co."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c76da52e-e790-3f42-b864-d8c2bcb0e80d",
                                        "entry_id": "0625c806-cac4-3cad-8e05-50aed2dd45a9",
                                        "glosses": [
                                            "A stimulating pill, especially amphetamine."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e915b262-282d-4264-8a55-071c273d33e2",
                                                "sense_id": "c76da52e-e790-3f42-b864-d8c2bcb0e80d",
                                                "text": "And I routinely took more “helpers” when I woke up in order to maintain the fast pace and, more importantly, to study for my final exams."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "25bd0d08-3ea8-4f68-955f-35c81bd22575",
                        "source_entry_id": "8f1dd4bc-43f2-3bec-b426-6690a8b5cdb4",
                        "source_sense_id": "4a52766b-728e-3e35-8cb7-88f27f5993f5",
                        "target_lang_word": "aide",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aide",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c7e89f3d-edad-380d-ba23-73c7371cb389",
                                        "entry_id": "b87aefd3-719c-3753-814c-94d1527cfca8",
                                        "glosses": [
                                            "Action d’apporter son soutien physiquement, verbalement, financièrement ou de tout autre manière."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "22b1d9fa-0c1e-44e5-994a-4331f254ed67",
                                                "sense_id": "c7e89f3d-edad-380d-ba23-73c7371cb389",
                                                "text": "Notons que le terme association a été très mal choisi. Il n'implique pas que les plantes se prêtent une aide quelconque. En général, elles sont concurrentes."
                                            },
                                            {
                                                "example_id": "ab604c7f-31aa-4fa0-bf80-a3bc9150fad7",
                                                "sense_id": "c7e89f3d-edad-380d-ba23-73c7371cb389",
                                                "text": "J’ai besoin de votre aide."
                                            },
                                            {
                                                "example_id": "379bb1b6-ed25-4487-99af-db3bcc37ca99",
                                                "sense_id": "c7e89f3d-edad-380d-ba23-73c7371cb389",
                                                "text": "Venir en aide aux malheureux."
                                            },
                                            {
                                                "example_id": "6262f170-2be6-4bba-9ada-5585a54baa36",
                                                "sense_id": "c7e89f3d-edad-380d-ba23-73c7371cb389",
                                                "text": "Une autre explosion déchira l’air un peu plus loin, suivie de cris, d’appels à l’aide."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b56d021a-ee49-3600-88ff-5b7a70ade0b1",
                                        "entry_id": "b87aefd3-719c-3753-814c-94d1527cfca8",
                                        "glosses": [
                                            "À la fois la personne dont on reçoit du secours et le soutien que l’on en tire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "964ae2d4-816b-4aa5-9fe1-1df8e4b037e9",
                                                "sense_id": "b56d021a-ee49-3600-88ff-5b7a70ade0b1",
                                                "text": "La foi seule est ma force et mon aide."
                                            },
                                            {
                                                "example_id": "51d21abe-d005-4142-b3aa-bd6c82eb374e",
                                                "sense_id": "b56d021a-ee49-3600-88ff-5b7a70ade0b1",
                                                "text": "Votre protection est sa seule aide."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a6fc03f-c253-3651-a4d1-22d0f22d3b7d",
                                        "entry_id": "b87aefd3-719c-3753-814c-94d1527cfca8",
                                        "glosses": [
                                            "Secours que procurent certaines choses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58a381c7-e1bf-4636-b30a-fecbfafbcd74",
                                                "sense_id": "5a6fc03f-c253-3651-a4d1-22d0f22d3b7d",
                                                "text": "On a fait de grandes découvertes à l’aide du télescope."
                                            },
                                            {
                                                "example_id": "cececa1c-64a4-4169-82ae-0b1790522410",
                                                "sense_id": "5a6fc03f-c253-3651-a4d1-22d0f22d3b7d",
                                                "text": "Il n’aurait pas réussi sans l’aide de telle machine."
                                            },
                                            {
                                                "example_id": "120fef4e-9938-447e-b291-9f429267b1d7",
                                                "sense_id": "5a6fc03f-c253-3651-a4d1-22d0f22d3b7d",
                                                "text": "Pour le genng"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0326aee5-cca4-385a-a581-51fcb01890e1",
                                        "entry_id": "b87aefd3-719c-3753-814c-94d1527cfca8",
                                        "glosses": [
                                            "Église ou chapelle qui sert de succursale à une église paroissiale dont les habitants sont trop éloignés."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3bf7678-9cae-40a4-a00b-4928b5791e81",
                                                "sense_id": "0326aee5-cca4-385a-a581-51fcb01890e1",
                                                "text": "Sainte-Marguerite, dans le faubourg Saint-Antoine, était une aide de la paroisse de Saint-Paul."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "aide",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6bb9d8f6-34bc-3788-a73a-f47f3b0df3ee",
                                        "entry_id": "56b035b9-7025-36d2-b38f-97d019648b32",
                                        "glosses": [
                                            "Personne qui est auprès de quelqu’un pour travailler ou servir conjointement avec lui et sous sa responsabilité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6300e567-cfc4-4ac4-b712-ff9a060d4e47",
                                                "sense_id": "6bb9d8f6-34bc-3788-a73a-f47f3b0df3ee",
                                                "text": "Le coq, ses aides et les hommes affectés au service des cuisines, porteront constamment la vareuse et le pantalon de fatigue ; […]."
                                            },
                                            {
                                                "example_id": "80b00bc0-d232-4361-b59a-dd6b7459d7a7",
                                                "sense_id": "6bb9d8f6-34bc-3788-a73a-f47f3b0df3ee",
                                                "text": "Scaër s'approcha du lit d'Alain qui était entre les mains du chirurgien et de ses aides, […]."
                                            },
                                            {
                                                "example_id": "f0ee50fc-abf8-421d-b0c0-6162296493ff",
                                                "sense_id": "6bb9d8f6-34bc-3788-a73a-f47f3b0df3ee",
                                                "text": "En dehors de vous-même, il y a si je ne m’abuse, une infirmière major, une Surveillante Générale, un ancien jockey servant de factotum, une centraliste, un maître d’hôtel, un cuisinier et son aide, deux femmes de chambre, trois serveurs, trois filles de salle et un jardinier…"
                                            },
                                            {
                                                "example_id": "b6ca6647-a882-4f82-bade-a60d2f5909ab",
                                                "sense_id": "6bb9d8f6-34bc-3788-a73a-f47f3b0df3ee",
                                                "text": "Je trouvai un aide inattendu en Throttler, en qui je reconnaissais maintenant un fils de notre vieux Skulker ; il avait passé son enfance à la Grange et c’était mon père qui l’avait donné à M. Hindley."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "aide",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f60a08b4-9d8c-34b6-8167-8ec164ddab69",
                                        "entry_id": "3bdd989f-b932-3122-9fe4-d61439978fe5",
