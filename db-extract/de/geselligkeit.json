                ],
                "senses": [
                    {
                        "sense_id": "b09dc999-ea58-3a44-8bae-198dbb183a92",
                        "entry_id": "3ab84f80-861c-3f73-9c1c-c1a5ae6545db",
                        "glosses": [
                            "umgänglicher Verkehr mit anderen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84c034d2-8cc8-47ba-bc0b-899a3de51b95",
                                "sense_id": "b09dc999-ea58-3a44-8bae-198dbb183a92",
                                "text": "„Bei Geselligkeit handelt es sich also um einen Teilbereich der direkten Kommunikation, der einerseits vom persönlich-freundschaftlichen Austausch, andererseits von fachbezogener Kommunikation abzugrenzen ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b5fb7534-cfdb-3fcc-8d19-f02b4e1ca5a4",
                        "entry_id": "3ab84f80-861c-3f73-9c1c-c1a5ae6545db",
                        "glosses": [
                            "lockeres, geselliges Beisammensein von Personen"
                        ],
                        "tags": [
                            "mit Plural"
                        ],
                        "examples": [
                            {
                                "example_id": "9af2d487-324e-48b4-ab35-2681e6bc5791",
                                "sense_id": "b5fb7534-cfdb-3fcc-8d19-f02b4e1ca5a4",
                                "text": "„Bei den sonntäglichen Geselligkeiten verwandelte sich das Haus in einen Salon: Man las einander vor, diskutierte, musizierte gemeinsam, lachte, aß und trank viel.“"
                            },
                            {
                                "example_id": "8c68bc1f-c5a9-4ce9-9cc3-a03a9a0c1401",
                                "sense_id": "b5fb7534-cfdb-3fcc-8d19-f02b4e1ca5a4",
                                "text": "„Das Witzeerzählen setzt Geselligkeit voraus; ein Witz ist kein Monolog.“"
                            },
                            {
                                "example_id": "56aa739c-1b41-4011-8b1d-f8b289b49f40",
                                "sense_id": "b5fb7534-cfdb-3fcc-8d19-f02b4e1ca5a4",
                                "text": "„Ich habe dem genialen Schöpfer meines Sprachführers viel abzubitten, denn ich bin seither unbestrittener Mittelpunkt jeder Geselligkeit.“"
                            },
                            {
                                "example_id": "f89e6609-1395-4104-b998-cc1192cf74b1",
                                "sense_id": "b5fb7534-cfdb-3fcc-8d19-f02b4e1ca5a4",
                                "text": "„Manchmal besorgte er sich ein volles Haus, wenn der Drang nach Geselligkeit überhand nahm.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
