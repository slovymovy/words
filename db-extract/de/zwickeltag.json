                "senses": [
                    {
                        "sense_id": "a5b17874-7aa5-3560-8eaf-349e72ad87e0",
                        "entry_id": "3009da84-d453-39b2-a3d6-8e25c5400a9e",
                        "glosses": [
                            "Fenstertag"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "7f4dd33c-8a39-42fe-a5ee-df89b7f3190e",
                                "sense_id": "a5b17874-7aa5-3560-8eaf-349e72ad87e0",
                                "text": "„In der längsten Urlaubsphase in diesem Jahr mit wenigen Arbeitstagen stecken wir leider gerade drin: Zwei Urlaubstage für sieben Tage frei haben, das haben der 2. und der 5. Jänner als Zwickeltage möglich gemacht.“"
                            },
                            {
                                "example_id": "76e38030-a3a2-4c1d-b7b7-b1c753686a88",
                                "sense_id": "a5b17874-7aa5-3560-8eaf-349e72ad87e0",
                                "text": "„Die Brückentage, die in manchen Regionen auch Fenster- oder Zwickeltage heißen, liegen im kommenden Jahr [2012] so günstig wie lange nicht mehr.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
