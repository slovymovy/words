                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6bb98c5b-9d5a-45c6-b8b3-f91ce6297ac4",
                        "source_entry_id": "a56ab0e5-8a5a-3abd-a3fc-26cd7e1bfb6c",
                        "source_sense_id": "6ba079ff-f0ca-3842-88af-799c34a9de58",
                        "source_sense_description": "Zoologie: lachsartiger Fisch im Baikal",
                        "target_lang_word": "omoul",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "omoul",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b83bffb0-e98c-3d8d-884a-41c33ce8eced",
                                        "entry_id": "0519058b-ea41-3aaa-9c91-184ef8741aaa",
                                        "glosses": [
                                            "Poisson de la famille des Salmonidae (Salmonidés) et du genre Corégonus (Corégone), endémique du lac Baïkal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2a6e34c-6348-4547-87d1-69244e8be656",
                                                "sense_id": "b83bffb0-e98c-3d8d-884a-41c33ce8eced",
                                                "text": "Poissons du Baïkal, Les omouls que l’on pêche près de l’embouchure de la Sélenga n’ont pas plus de deux empans de longueur, tandis que ceux que l’on prend près de la baye de Tchivirkoui sont énormes."
                                            },
                                            {
                                                "example_id": "0d1a1023-b069-42ae-8101-083f87998b0a",
                                                "sense_id": "b83bffb0-e98c-3d8d-884a-41c33ce8eced",
                                                "text": "Entrée : filets d’omoul séchés et fumés (plus discret que le hareng préparé dans le même style). Deuxième entrée (pour un dîner d’apparat c’est un minimum) : beignets d’omoul. Le tout arrosé de vodka au sorbier …."
                                            },
                                            {
                                                "example_id": "87c588af-2e5b-4ccf-ba49-8dcefdb47442",
                                                "sense_id": "b83bffb0-e98c-3d8d-884a-41c33ce8eced",
                                                "text": "Sur la petite table de la kitchenette trône une bouteille de vodka. Quelques tranches d’omoul fumé, une salade de chou aux carottes ainsi que du pain noir agrémentent le dîner."
                                            },
                                            {
                                                "example_id": "94ca72ea-ad21-4d9d-a27d-decd7198b3ef",
                                                "sense_id": "b83bffb0-e98c-3d8d-884a-41c33ce8eced",
                                                "text": "… à Slioudianka au bord du lac Baïkal j’ai travaillé quelques jours dans une usine de séchage et fumage de poissons, principalement d’omouls, mais aussi d’ombres, d’esturgeons, de lavarets, de chabots, de truites, de brochets, de perches, de carassins, occasionnellement de tanches, et parfois aussi de golomiankas, qui sont de tout petits poissons à la chaire rose et presque transparente ; …"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
