                    {
                        "sense_id": "2ca448cf-d155-39fc-925b-ecc3056c7a02",
                        "entry_id": "32ec4f71-9f68-3e30-86b8-2c772a4d535a",
                        "glosses": [
                            "vermogen uitgedrukt in de eenheid watt",
                            "stroomverbruik van elektrische apparaten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9f03d22-19d4-4d92-89f2-0426d0df97b4",
                                "sense_id": "2ca448cf-d155-39fc-925b-ecc3056c7a02",
                                "text": "Timmermans wil dat Brussel zich niet langer bezighoudt met kleine zaken, zoals - inderdaad - de maximale wattage van stofzuigers; een voorbeeld dat hij veel en graag aanhaalt."
                            },
                            {
                                "example_id": "a5937d70-b109-4ea1-9388-82b5a697007e",
                                "sense_id": "2ca448cf-d155-39fc-925b-ecc3056c7a02",
                                "text": "Die stofzuiger, beter gezegd het Brusselse voorschrift dat in alle landen van de Europese Unie het wattage ervan aan een maximum verbonden moet worden, staat bekend als weer zo’n voorbeeld van doorgeschoten Brusselse bemoeizucht."
                            }
                        ]
                    },
                    {
                        "sense_id": "82fa2889-3800-3236-a920-86788f35dc64",
                        "entry_id": "32ec4f71-9f68-3e30-86b8-2c772a4d535a",
                        "glosses": [
                            "vermogen uitgedrukt in de eenheid watt",
                            "meetbare krachtsinspanning die een sporter kan leveren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7fb3bde1-2c41-44d4-8d3e-a8b06f008fff",
                                "sense_id": "82fa2889-3800-3236-a920-86788f35dc64",
                                "text": "Ook het wattage dat een wielrenner trapt is van steeds groter gewicht."
                            },
                            {
                                "example_id": "3b2871c6-c863-4cf0-99c3-e84eaf741505",
                                "sense_id": "82fa2889-3800-3236-a920-86788f35dc64",
                                "text": "We meten zowel het pure vermogen, de wattage, als de wattage die een renner per kilometer kan trappen, een waarde die bijvoorbeeld bijzonder hoog lag bij Louis Vervaeke."
                            }
                        ]
                    }
