                "senses": [
                    {
                        "sense_id": "e20286f4-b423-3cf1-b663-3c81b5551fad",
                        "entry_id": "c5eb161e-101d-3502-a92a-a38d3826211b",
                        "glosses": [
                            "истор. связанный, соотносящийся по значению с существительными бланкист, бланкизм"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "611ef5ce-926f-4f56-a8d0-4a4485677991",
                                "sense_id": "e20286f4-b423-3cf1-b663-3c81b5551fad",
                                "text": "Как-никак переворот при таких условиях решительно не напоминал ни военного заговора, ни бланкистского эксперимента."
                            }
                        ]
