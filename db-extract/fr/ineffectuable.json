                    {
                        "sense_id": "d0cea893-edf5-352c-acde-96458afda47d",
                        "entry_id": "91cfc6e6-552c-3c6a-b397-303a876af4cb",
                        "glosses": [
                            "Que l’on ne peut pas effectuer."
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "examples": [
                            {
                                "example_id": "68791434-fea9-4e67-bfdd-b2123f45f3de",
                                "sense_id": "d0cea893-edf5-352c-acde-96458afda47d",
                                "text": "La vieille image de la sphère infinie dont le centre est partout et la circonférence nulle part est déjà éclairante : qui dit sphère dit totalisation, mais, celle-là étant infinie, celle-ci est ineffectuable."
                            },
                            {
                                "example_id": "0dbeab66-6208-4c67-928a-3166cd5304d2",
                                "sense_id": "d0cea893-edf5-352c-acde-96458afda47d",
                                "text": "L’interdit, à mon sens, parce que ineffectuable dans quelque situation que ce soit, n’est pas une catégorie politique."
                            },
                            {
                                "example_id": "e56335ea-e95c-468e-b278-f3981afbec13",
                                "sense_id": "d0cea893-edf5-352c-acde-96458afda47d",
                                "text": "À l’autre extrême, le discours mathématique, de par son caractère éminemment symbolique, s’épargne aussi l’hallucination pure et simple de résultat pour l’opération ineffectuable."
                            }
                        ]
                    }
