                "senses": [
                    {
                        "sense_id": "07819b17-706a-3b97-8827-f81dcb0b0277",
                        "entry_id": "9d977230-4383-3c21-a140-61c0bd64103f",
                        "glosses": [
                            "der intensive Anbau von Blumen, Obst und Gemüse (sofern es nicht zur Forst- oder Landwirtschaft gehört) und die dazu notwendigen Techniken und Tätigkeiten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "473d8541-c6cc-4ddd-93e9-b3325cb58b7a",
                                "sense_id": "07819b17-706a-3b97-8827-f81dcb0b0277",
                                "text": "Der Gartenbau erzielt in Deutschland auf etwa 1 % der landwirtschaftlichen Nutzfläche 10 % des Wirtschaftsvolumens der gesamten Landwirtschaft."
                            },
                            {
                                "example_id": "241d8ff4-40b8-4ad7-8937-3663564f1abf",
                                "sense_id": "07819b17-706a-3b97-8827-f81dcb0b0277",
                                "text": "„Das Insekt bedroht insbesondere den Wein- und Gartenbau und die Landwirtschaft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4d3578db-3b78-4fd5-aaa7-5cc8afee89bd",
                        "source_entry_id": "9d977230-4383-3c21-a140-61c0bd64103f",
                        "source_sense_id": "07819b17-706a-3b97-8827-f81dcb0b0277",
                        "source_sense_description": "der intensive Anbau von Blumen, Obst und Gemüse und die dazu notwendigen Techniken und Tätigkeiten",
