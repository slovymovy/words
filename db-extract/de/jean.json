                "senses": [
                    {
                        "sense_id": "836f0965-915a-30c4-b6b5-ee4e5888f35f",
                        "entry_id": "4de8a824-5137-3b01-8637-b2a54849b636",
                        "glosses": [
                            "Freizeithose aus blauem Baumwollstoff mit Nieten, saloppe Hose; Bluejean"
                        ],
                        "tags": [
                            "Austrian German",
                            "short-form"
                        ],
                        "examples": [
                            {
                                "example_id": "31823f39-6354-44ba-800f-e9b4232f6f54",
                                "sense_id": "836f0965-915a-30c4-b6b5-ee4e5888f35f",
                                "text": "„Die Krawatte drückt Respekt vor dem Amt aus, das Kurzarmhemd ist im Sommer den höheren Temperaturen geschuldet, und die Jean, die signalisiert, dass man in Wahrheit ein toller Hecht ist - zumindest am Abend, wenn man sie mit einem weißen Ruderleiberl trägt.“"
                            },
                            {
                                "example_id": "7896e02a-7632-469b-bf9a-924423c7166d",
                                "sense_id": "836f0965-915a-30c4-b6b5-ee4e5888f35f",
                                "text": "„Mittlerweile gibt es auch eine maßgeschneiderte Jean für Fahrradfahrer, die auf 300 bis 500 Euro kommt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
