                "senses": [
                    {
                        "sense_id": "ef50f715-67b2-35da-ae2d-efd5493f810a",
                        "entry_id": "fdac01c2-51e0-331b-a92a-fc687442ecfb",
                        "glosses": [
                            "Verlangen der Vorlage einer ärztlichen Bestätigung der Krankheit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48b79167-9d07-4059-a42e-f9cd20905e1d",
                                "sense_id": "ef50f715-67b2-35da-ae2d-efd5493f810a",
                                "text": "„Bleiben Zweifel an den Gründen bestehen, kann laut gymnasialer Schulordnung dem Schüler eine Attestpflicht auferlegt werden.“"
                            },
                            {
                                "example_id": "fb06382b-8dd8-42dc-812a-ae9cebbdcbb2",
                                "sense_id": "ef50f715-67b2-35da-ae2d-efd5493f810a",
                                "text": "„Auch dürfte eine generelle Attestpflicht ab dem ersten Krankheitstag kaum im Interesse der Arbeitgeber sein, denn die Bearbeitung der Bescheinigungen bereitet den Personalabteilungen eine deutliche Mehrarbeit.“"
                            },
                            {
                                "example_id": "c70c0f34-2502-464a-8c12-2640398778ca",
                                "sense_id": "ef50f715-67b2-35da-ae2d-efd5493f810a",
                                "text": "„So blieben einerseits kurzfristig oder geringfügig beschäftigte gewerbliche Arbeitnehmer von der Lohnfortzahlung ausgenommen, andererseits gab es Unterschiede in der Attestpflicht zwischen Arbeitern und Angestellten.“"
                            },
                            {
                                "example_id": "9ce6a6b1-b4ef-4dc6-801d-e1c8e48b1015",
                                "sense_id": "ef50f715-67b2-35da-ae2d-efd5493f810a",
                                "text": "„Nach einer Entscheidung des Landesarbeitsgerichts Frankfurt am Main kann einem die Attestpflicht bei Krankheit verletzenden Arbeitnehmer nicht fristlos, sondern nur fristgebunden gekündigt werden […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
