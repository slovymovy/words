                "senses": [
                    {
                        "sense_id": "f07a3149-63ab-32e7-9c15-742d84a14d09",
                        "entry_id": "5c2923be-e2bb-39d9-9001-5e4d3ca44db7",
                        "glosses": [
                            "Person, die in Haiti lebt, dort geboren wurde oder die Staatsbürgerschaft Haitis besitzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "466699af-fcb1-454c-b711-814acf3835c5",
                                "sense_id": "f07a3149-63ab-32e7-9c15-742d84a14d09",
                                "text": "„375 000 Haitianer sind als Flüchtlinge registriert (jeder zehnte), 18 000 Chilenen fanden durch Vermittlung des UN-Hochkommissars für Flüchtlinge eine neue Heimat, fast eine Million Kubaner emigrierte nach der Machtergreifung Castros in die USA.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "36dd1114-a6c4-4a0b-b534-61df714739ab",
                        "source_entry_id": "5c2923be-e2bb-39d9-9001-5e4d3ca44db7",
                        "source_sense_id": "f07a3149-63ab-32e7-9c15-742d84a14d09",
                        "source_sense_description": "Person, die in Haiti lebt, dort geboren wurde oder die Staatsbürgerschaft Haitis besitzt",
                        "target_lang_word": "Haitian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Haitian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0644395c-b96b-35f8-8822-41b7f4ba4c47",
                                        "entry_id": "763d6d2c-c310-37b9-9881-efebae6eb7ea",
                                        "glosses": [
                                            "A person from Haiti or of Haitian descent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf8cf764-bba3-48ba-972e-f33f7541863f",
                                                "sense_id": "0644395c-b96b-35f8-8822-41b7f4ba4c47",
                                                "text": "The goal was to make Haitians dependent on France, from their economy to their culture to the very words they spoke."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Haitian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1c6d5a86-a96c-37b1-b223-ad98405bd723",
                                        "entry_id": "c45e7575-1377-36bc-b8c4-ea76522b3a91",
                                        "glosses": [
                                            "Haitian Creole, one of the official languages of Haiti."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Haitian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dab1f9fc-ae0f-3012-b4b8-bb693d596e42",
                                        "entry_id": "12b01623-565e-3d3e-aa4d-3b9beff08be3",
                                        "glosses": [
                                            "Of, from, or pertaining to Haiti, its inhabitants, or their language."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd5c82cc-6b52-41e2-b3cb-d8e5aae77207",
                                                "sense_id": "dab1f9fc-ae0f-3012-b4b8-bb693d596e42",
                                                "text": "That would have given Haitian students a chance to function in both languages while prizing their national identity."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "297ed54d-5dfd-4cf6-ae98-c982e14d72fb",
                        "source_entry_id": "5c2923be-e2bb-39d9-9001-5e4d3ca44db7",
                        "source_sense_id": "f07a3149-63ab-32e7-9c15-742d84a14d09",
                        "source_sense_description": "Person, die in Haiti lebt, dort geboren wurde oder die Staatsbürgerschaft Haitis besitzt",
                        "target_lang_word": "Haïtien",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Haïtien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "199a8118-2c5b-3532-bb91-32e10a391809",
                                        "entry_id": "0e172ece-81b2-3d20-93c1-7b4d1b129342",
                                        "glosses": [
                                            "Habitant ou originaire de Haïti. Note d’usage : Le h initial est officiellement muet, mais on trouve parfois ce mot avec un h aspiré."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc353653-961b-4139-9ca6-2e5de0052c3d",
                                                "sense_id": "199a8118-2c5b-3532-bb91-32e10a391809",
                                                "text": "D’après les dernières statistiques de l’ONU, plus de 70 % des Haïtiens vivent avec moins d’un dollar américain par jour."
                                            },
                                            {
                                                "example_id": "04c4ffae-2044-4b06-a920-9df23ff7535b",
                                                "sense_id": "199a8118-2c5b-3532-bb91-32e10a391809",
                                                "text": "Ainsi, être avec l’Haïtien ou le Sainte-Lucien ^([sic : Saint-Lucien]), c’est bien plus que l’accueillir pour qu’il bénéficie des miettes de notre pseudo-prospérité."
                                            },
                                            {
                                                "example_id": "860b8d01-f36a-44fd-93c6-cf3ca205506b",
                                                "sense_id": "199a8118-2c5b-3532-bb91-32e10a391809",
                                                "text": "Dans ce travail d’assainissement moral qui ne souhaitait que dévaudouiser le vaudouisant de son vodoun (loa), pourrait-on dire, les prêtres catholiques visèrent juste, car les Haïtiens, en général, avaient et ont encore une grande peur du serment!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
