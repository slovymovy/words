                "senses": [
                    {
                        "sense_id": "969a30bb-fdf1-30b4-b336-6f1764e0c3cb",
                        "entry_id": "1d175b95-0d58-3277-8730-ea4ece0ca8a2",
                        "glosses": [
                            "Qui relève de la camaraderie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "468a1ebf-f48c-490b-8d27-3fd316f66dd7",
                                "sense_id": "969a30bb-fdf1-30b4-b336-6f1764e0c3cb",
                                "text": "Parait il que le climat n’était pas franchement camaradesque mais plutôt délétère, chaque camp ayant son QG respectif (ils ne veulent déjà plus se mélanger),vient s’ajouter la question épineuse de suspicion (réciproque) d’une fraude électorale caractérisée !"
                            },
                            {
                                "example_id": "6f0b1c44-a883-4c32-b2ac-a49efb141484",
                                "sense_id": "969a30bb-fdf1-30b4-b336-6f1764e0c3cb",
                                "text": "Alors que je vois les mèches s’évaporer progressivement j’entends Guillaume, soutien camaradesque, se marrer dans mon dos."
                            },
                            {
                                "example_id": "ca7e4878-5f47-4276-ae88-f4cef56f10fa",
                                "sense_id": "969a30bb-fdf1-30b4-b336-6f1764e0c3cb",
                                "text": "Il est non seulement de votre devoir camaradesque, mais tout simplement de votre devoir moral, de nous narrer les péripéties de ce match."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "215e1c17-c05b-4e54-a88b-bb5bec69103f",
                        "source_entry_id": "1d175b95-0d58-3277-8730-ea4ece0ca8a2",
