                "senses": [
                    {
                        "sense_id": "505b44b4-84af-315b-bf9d-ba6f7a490a03",
                        "entry_id": "d8a5f4b8-8eb6-32a7-bf42-dc75a74cb821",
                        "glosses": [
                            "Enculer."
                        ],
                        "tags": [
                            "rare",
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "8dbd374b-fea1-4c32-8cd5-26e9facba0a9",
                                "sense_id": "505b44b4-84af-315b-bf9d-ba6f7a490a03",
                                "text": "Tu dis BIFTECK, mon ieux, t’es le pote, l’élu, le tchef, t’as touché au cœur, c’est celui d’un brav’mec, tas mis dans son mille, tu peux l’enculailler tant et plus, t’es son époux légitime."
                            },
                            {
                                "example_id": "7977bcbc-dd76-4157-9233-ef01b9367e13",
                                "sense_id": "505b44b4-84af-315b-bf9d-ba6f7a490a03",
                                "text": "Tous les blases à frisottis qui passaient à portée, c’était pour nozigues… accolés les aux autres… à s’enculailler en rond… à dérouter l’onomastique… et pour conglutiner le tout, des charrettes de particules en voussure, en encorbellement, en arabesques."
                            }
                        ]
                    }
