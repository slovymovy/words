                                ]
                            },
                            {
                                "target_word": "neigh",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b14a6a87-268d-34bd-b0b5-30b743260642",
                                        "entry_id": "4b6eca77-69e4-3261-8300-bdce2bd8086f",
                                        "glosses": [
                                            "To make its cry."
                                        ],
                                        "tags": [
                                            "of a horse"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2dc9bae3-1909-4a3c-bf1d-548a56dd96c7",
                                                "sense_id": "b14a6a87-268d-34bd-b0b5-30b743260642",
                                                "text": "\"I went into the stable first to see to the horse, and found him neighing and waiting for his hay, so I went up into the hay-loft for an armful[.]\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "094b91c1-a1c9-36eb-978b-53b6a7166898",
                                        "entry_id": "4b6eca77-69e4-3261-8300-bdce2bd8086f",
                                        "glosses": [
                                            "To make a sound similar to a horse's cry."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bc5739c3-a76f-3ead-af1f-e9ad44e6a5e6",
                                        "entry_id": "4b6eca77-69e4-3261-8300-bdce2bd8086f",
                                        "glosses": [
                                            "To scoff or sneer."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d83b365-7712-49ac-8d0f-e6869875267c",
                                                "sense_id": "bc5739c3-a76f-3ead-af1f-e9ad44e6a5e6",
                                                "text": "Yes, yes, 'tis he. I will assure you Uncle, the very he, the he your Wisdom plaid withal, I thank you for't, neighed at his Nakedness, and made his Cold and Poverty your Pastime; […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
