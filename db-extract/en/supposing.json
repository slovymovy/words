                                                "sense_id": "55d7c191-06ea-35ff-ab28-1eafe4885ee5",
                                                "text": "Giả sử không có anh ấy thì việc chắc không xong."
                                            },
                                            {
                                                "example_id": "3c8cc08b-fa93-4c68-9e07-cd37d9c5c2c3",
                                                "sense_id": "55d7c191-06ea-35ff-ab28-1eafe4885ee5",
                                                "text": "Giả sử có người hỏi, anh sẽ trả lời ra sao?"
                                            }
                                        ]
                                    }
                                ]
                            }
