                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8fa5499-76b1-4ae3-85b5-efe126dde805",
                                "sense_id": "0b51b4a6-8724-3257-9c52-d9050c527879",
                                "text": "When the microprocessor decodes the JSR opcode, it stores the operand into the TEMP register and pushes the current contents of the PC ($00 0128) onto the stack."
                            },
                            {
                                "example_id": "1d956a6d-16e1-41d4-95a7-dfd1fadfc9f8",
                                "sense_id": "0b51b4a6-8724-3257-9c52-d9050c527879",
                                "text": "In the tradition of other low-level languages, many CIL opcodes tend to be cryptic and completely unpronounceable by us mere humans."
                            }
                        ]
