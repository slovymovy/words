                        "sense_id": "05cf98f9-d147-3879-9c61-3253156fc7d1",
                        "entry_id": "d9b4c835-f389-34f9-afbf-2bcff5cc7e68",
                        "glosses": [
                            "Personne qui prône le neutralisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bcb26c2f-2289-4c38-b40d-1fb2e29aceae",
                                "sense_id": "05cf98f9-d147-3879-9c61-3253156fc7d1",
                                "text": "Il n’est d'ailleurs pas un neutraliste à proprement parler, convaincu qu’il est juste d’ancrer l’Allemagne à l’Ouest et que les valeurs de l’Union soviétique ne sont pas « bonnes »."
                            },
                            {
                                "example_id": "33ec0d37-c21f-4e28-92fa-56b810fe57e2",
                                "sense_id": "05cf98f9-d147-3879-9c61-3253156fc7d1",
                                "text": "Mais alors que l'on avait défendu au général d’Aumade d'arrêter Mouley Hafid, notre ennemi, lors de son passage sur ce territoire, nos neutralistes impénitents avaient obtenu que l’on interdît au sultan légitime, notre ami, de traverser cette portion de son empire que nous occupions en son nom."
                            }
                        ]
                    }
