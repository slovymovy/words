                    }
                ],
                "senses": [
                    {
                        "sense_id": "bad04ed4-efd5-3ac9-a39c-7ed014c4d757",
                        "entry_id": "3ec23e4d-b2ad-3e9c-bd43-a2ac09a50898",
                        "glosses": [
                            "verstohlener Blick von der Seite auf etwas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27737354-0e54-40ea-84df-6c8b4425c635",
                                "sense_id": "bad04ed4-efd5-3ac9-a39c-7ed014c4d757",
                                "text": "„Zirele warf ihm einen ängstlichen Seitenblick zu.“"
                            },
                            {
                                "example_id": "f4b755dc-37c3-4222-b7f1-ccaaf7dc8c3c",
                                "sense_id": "bad04ed4-efd5-3ac9-a39c-7ed014c4d757",
                                "text": "„Jeder Seitenblick war Sünde, jede Tat eine Todsünde.“"
                            },
                            {
                                "example_id": "44d161f0-357e-4694-b5c4-b652dcb173bb",
                                "sense_id": "bad04ed4-efd5-3ac9-a39c-7ed014c4d757",
                                "text": "„Ich warf einen raschen Seitenblick auf Jutta.“"
                            },
                            {
                                "example_id": "685187c8-d768-41dc-b613-60e80a93e94f",
                                "sense_id": "bad04ed4-efd5-3ac9-a39c-7ed014c4d757",
                                "text": "„Statt einer Antwort klapperte Rostow mit dem Georgskreuz, das in der Verschnürung seiner Attila hing, warf einen lächelnden, gleichsam um Aufmerksamkeit bittenden Seitenblick auf Berg und wies auf seinen verbundenen Arm.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5bd02359-319d-4012-9c09-be25b1ac7b64",
                        "source_entry_id": "3ec23e4d-b2ad-3e9c-bd43-a2ac09a50898",
                        "source_sense_id": "bad04ed4-efd5-3ac9-a39c-7ed014c4d757",
                        "source_sense_description": "verstohlener Blick von der Seite auf etwas",
                        "target_lang_word": "side glance",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "266ec1a2-b1e7-427e-a5a9-dc5351d9cc54",
                        "source_entry_id": "3ec23e4d-b2ad-3e9c-bd43-a2ac09a50898",
                        "source_sense_id": "bad04ed4-efd5-3ac9-a39c-7ed014c4d757",
                        "source_sense_description": "verstohlener Blick von der Seite auf etwas",
                        "target_lang_word": "side-eye",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "side-eye",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a0692e39-2d78-38b2-a462-1be1bc479380",
                                        "entry_id": "ac29d9c9-a413-3b4d-8350-a44c86b65d4e",
                                        "glosses": [
                                            "A sidelong look, particularly of animosity, judgment, or suspicion."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6fa5598e-0c42-47a0-81f8-7779850b6ae5",
                                                "sense_id": "a0692e39-2d78-38b2-a462-1be1bc479380",
                                                "text": "I'm going to admit that the opening strains sound a wee bit \"demo from a home studio,\" and that the title itself – paired with any other artist – would probably result in a side eye and a quip about done-to-death, cheese-pop metaphors."
                                            },
                                            {
                                                "example_id": "7e792376-ea73-4821-80ff-7edb1fba9a5e",
                                                "sense_id": "a0692e39-2d78-38b2-a462-1be1bc479380",
                                                "text": "[Billy] Squier's band makes a valiant effort to match his camp quotient, with lots of open shirts, exposed chest hair and sexy side-eyes to the camera."
                                            },
                                            {
                                                "example_id": "cc707287-9e57-47c4-a6a7-5f79448c7414",
                                                "sense_id": "a0692e39-2d78-38b2-a462-1be1bc479380",
                                                "text": "The incredibly different ways [Bill] Clinton and [Monica] Lewinsky are treated even today makes a shockingly sad statement about how, 15 years of discussion of gender equality later – including the insertion of slut-shaming into the national dialogue as something you're not supposed to do – we can't even manage to divide our collective side-eyes evenly between men and women."
                                            },
                                            {
                                                "example_id": "3d04f308-3c53-47e3-aa7a-e501553c5f00",
                                                "sense_id": "a0692e39-2d78-38b2-a462-1be1bc479380",
                                                "text": "It was his side eye. He had the sexiest side eye she'd ever seen. He'd tip his head in that George Clooney kind of way and peer at you from beneath those thick lashes."
                                            },
                                            {
                                                "example_id": "6cde995d-7c73-4136-89ba-f90524db6541",
                                                "sense_id": "a0692e39-2d78-38b2-a462-1be1bc479380",
                                                "text": "Side-eye, that sidelong glance favored by shade queens like Mariah Carey [and] devil-may-care rebels like Rihanna, is finally being acknowledged in the canon [the Merriam–Webster Dictionary]."
                                            },
                                            {
                                                "example_id": "456f8ce4-4165-466e-bcc2-1183da060520",
                                                "sense_id": "a0692e39-2d78-38b2-a462-1be1bc479380",
                                                "text": "I saw some snarking online about Bishop Michael Curry's passionate sermon, and certainly the royal family seemed unnerved by it, with Zara Philips watching it in apparent open-mouthed shock and Kate and Camilla shooting each other some heavy side-eye."
                                            },
                                            {
                                                "example_id": "5ed5ef6a-621d-41af-844b-b717ab7b70bf",
                                                "sense_id": "a0692e39-2d78-38b2-a462-1be1bc479380",
                                                "text": "\"If you look closely at Benjamin's face in that picture, he's got amazing side-eye,” [Anderson] Cooper joked. \"He's got this side-eye look, like he's very judgy. In general, I think babies are very judgy, but he's particularly judgy.\""
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "side-eye",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ec1c255b-daf5-3f54-b2c7-46c255ebce7d",
                                        "entry_id": "f2a0eef3-6999-3251-9874-77f13523bc17",
                                        "glosses": [
                                            "To look at out of the corner of one's eye, particularly with animosity, or in a judgmental or suspicious manner."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "76714520-6a52-4983-8e89-8d4f455a0a04",
                                                "sense_id": "ec1c255b-daf5-3f54-b2c7-46c255ebce7d",
                                                "text": "When I'm working my attention isn't caught straight ahead into the blinkered page, it's side eyeing whatever's peripheral, whatever's random."
                                            },
                                            {
                                                "example_id": "2387f42f-783a-4398-bdd4-f1f0d0467c45",
                                                "sense_id": "ec1c255b-daf5-3f54-b2c7-46c255ebce7d",
                                                "text": "When we fell out in front for the trek to breakfast, we side-eyed Walter when he walked out the door. Me looking to find some something. In his eyes. In his walk. In the pores of his skin. Some sign. Any sign."
                                            },
                                            {
                                                "example_id": "a4148f95-af22-4376-9517-95e5b18a5a30",
                                                "sense_id": "ec1c255b-daf5-3f54-b2c7-46c255ebce7d",
                                                "text": "But I do have to side-eye the fact that the interviews w/ the Jacksons are being aired in between episodes that deal with men being molested as children…it seems like it was intentional and that ish ain’t cool."
                                            },
                                            {
                                                "example_id": "b5bc61fe-ff03-49cc-b40b-dbba38604883",
                                                "sense_id": "ec1c255b-daf5-3f54-b2c7-46c255ebce7d",
                                                "text": "The show went well. Not the best on the tour, not even the best in the past month, but it went off without a hitch, despite everyone on the crew side-eyeing Dan, looking for him to start acting strange again."
                                            },
                                            {
                                                "example_id": "1c2be7f1-8f58-4985-9721-60a6b4cc5bf4",
                                                "sense_id": "ec1c255b-daf5-3f54-b2c7-46c255ebce7d",
                                                "text": "Seven months after his poolside epiphany, the 26-year-old [Taylor Hall] is sitting on a couch at Newark's Prudential Center, slugging from a protein shake and side-eying NHL Network highlights on the television."
                                            },
                                            {
                                                "example_id": "b416d199-e780-452d-b879-26a1d3038e2a",
                                                "sense_id": "ec1c255b-daf5-3f54-b2c7-46c255ebce7d",
                                                "text": "\"She'll be all right\", says [Tionne] Watkins, side-eyeing [Rozonda] Thomas with a cat-like grin."
                                            },
                                            {
                                                "example_id": "1d172f9b-9233-401f-aab7-a2f4d70db909",
                                                "sense_id": "ec1c255b-daf5-3f54-b2c7-46c255ebce7d",
                                                "text": "A new study of activity and mortality in older women [...] also side-eyes the validity, utility and origin of the common 10,000-steps-a-day exercise goals built into so many of our phones and activity monitors and suggests, instead, that any moving, whether or not it counts as exercise, may help to extend people’s lives."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
