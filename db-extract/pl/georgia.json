                                        "glosses": [
                                            "A female given name from Ancient Greek."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30531fb5-9d1f-4ce0-9532-cda67a645bbc",
                                                "sense_id": "2e3fea9c-1f4b-3c4b-90a4-8f46a015141c",
                                                "text": "\"Georgia?\" his mother said. \"Why in the world would a mother want to give her daughter such an outlandish name?\" \"It's no more outlandish than Jesse Griffith.\" \"Why, Jesse G., thee's named for thy two grandfathers.\" \"Georgia's named for a whole state.\""
                                            }
                                        ]
