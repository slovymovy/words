                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "20fddeb1-5188-3fcb-b21d-0ae1f9641686",
                                        "entry_id": "f03d9894-892b-3844-b9e7-de5624184ce8",
                                        "glosses": [
                                            "A medal or award, particularly Knight Bachelor.."
                                        ],
                                        "tags": [
                                            "British",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "587c5a97-e4f2-4d55-9519-6733c918d276",
                                                "sense_id": "20fddeb1-5188-3fcb-b21d-0ae1f9641686",
                                                "text": "This grooming of the national mindset explains the retention of 92 \"hereditary peers\" in the House of Lords: individuals who are gifted a right to sit in the nation's upper chamber and facilitate laws for no other reason than that their ancestor was the illegitimate child of some prince, or willing to spaff a few quid on the title when David Lloyd Gorge was selling of gongs for bribes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "18f0d4f8-00b7-3665-bb37-f8260cdc4cc6",
                                        "entry_id": "f03d9894-892b-3844-b9e7-de5624184ce8",
                                        "glosses": [
                                            "A metal target that emits a sound when it has been hit."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "gong",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "47e80ff5-87b8-376b-97ce-97e5387e9496",
                                        "entry_id": "ec68990a-0915-3a5d-b2fe-d310ec67e50a",
                                        "glosses": [
                                            "To make the sound of a gong; to ring a gong."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "70cb78f3-9eeb-4d1c-bbea-27748130f46d",
                                                "sense_id": "47e80ff5-87b8-376b-97ce-97e5387e9496",
                                                "text": "Poor old Pyecraft! He has just gonged, no doubt to order another buttered tea-cake!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb9ad0a2-1407-355e-9a66-f510b9847156",
                                        "entry_id": "ec68990a-0915-3a5d-b2fe-d310ec67e50a",
                                        "glosses": [
                                            "To send a signal to, using a gong or similar device.",
                                            "To halt (originally, a contestant in a talent show; later, a performer, a speaker)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "84660773-955a-476a-98c8-7cecb20ce9b3",
                                                "sense_id": "cb9ad0a2-1407-355e-9a66-f510b9847156",
                                                "text": "As she was gonged, host Daryl Somers swept rapidly across and salvaged an embarrassing situation by putting his arm around her and asking her whether she had children."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4cc3dea9-9be2-3a72-bd48-8377d05b31ba",
                                        "entry_id": "ec68990a-0915-3a5d-b2fe-d310ec67e50a",
                                        "glosses": [
                                            "To send a signal to, using a gong or similar device.",
                                            "To warn."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "78f90545-6072-4884-9fe9-4fc1471a5461",
                                                "sense_id": "4cc3dea9-9be2-3a72-bd48-8377d05b31ba",
                                                "text": "The driver gonged the pedestrian crossing the tracks, but the pedestrian didn't stop."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "70ee7c22-4617-388c-a91a-b68ba127290c",
                                        "entry_id": "ec68990a-0915-3a5d-b2fe-d310ec67e50a",
                                        "glosses": [
                                            "To give an award or medal to."
                                        ],
                                        "tags": [
                                            "British",
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa7aa03b-ccfc-4881-89c7-cb9c67ab0707",
                                                "sense_id": "70ee7c22-4617-388c-a91a-b68ba127290c",
                                                "text": "In 1972 he was awarded the British Red Cross Silver Medal for his services to the Red Cross. In 1978 he was 'gonged' once again, this time with the Queen's Jubilee Medal, marking the 25th year of her reign."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "gong",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a64795ab-9143-3127-b329-5a6603016c69",
