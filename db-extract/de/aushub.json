                "translations": [
                    {
                        "translation_id": "31dd21ad-b5e7-4507-8e6e-d4cc3e64a320",
                        "source_entry_id": "3f920d63-c3c4-3c71-8244-081939a85c2b",
                        "source_sense_id": "c342575a-ca52-3860-a015-18f2825c9538",
                        "source_sense_description": "der Vorgang des Aushebens einer Grube",
                        "target_lang_word": "creusement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "creusement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "28edee12-5afa-3740-93bf-96a1964b965f",
                                        "entry_id": "27ea3bf9-97e1-36c3-a284-14ea90d9a3a9",
                                        "glosses": [
                                            "Action de creuser ; résultat de cette action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "654884e6-a77e-4461-9094-37c7b0290e47",
                                                "sense_id": "28edee12-5afa-3740-93bf-96a1964b965f",
                                                "text": "La nuit vint. Le creusement ne devait pas être suspendu."
                                            },
                                            {
                                                "example_id": "41c3b3a7-091e-40cc-885d-7a87e48c057f",
                                                "sense_id": "28edee12-5afa-3740-93bf-96a1964b965f",
                                                "text": "Habituellement les terrains mouilleux qu'on veut planter sont assainis au préalable et le creusement des fossés de drainage sert à faire des buttes ou des remblais."
                                            },
                                            {
                                                "example_id": "eec35d44-c53d-4a21-b4b2-a8c611660d3b",
                                                "sense_id": "28edee12-5afa-3740-93bf-96a1964b965f",
                                                "text": "Le moindre rictus, la moindre grimace faisait reparaître ces terribles creusements, ces terribles décharnements qui avaient commencé, un an ou deux auparavant, de sculpter un masque funéraire à même sa substance de vivant."
                                            },
                                            {
                                                "example_id": "eeb1f378-b4c3-4d20-a9f2-0f316c96bb4b",
                                                "sense_id": "28edee12-5afa-3740-93bf-96a1964b965f",
                                                "text": "Le creusement d'un escalier en descente était une opération difficile et pénible, le mineur devant creuser plus bas que ses pieds au marteau et à la cisette, sous le faible éclairage des lampes à huile et avec une aération défectueuse."
                                            },
                                            {
                                                "example_id": "2910c597-2fc5-400c-9aaf-169487c172c6",
                                                "sense_id": "28edee12-5afa-3740-93bf-96a1964b965f",
                                                "text": "— Les données font apparaître un réel creusement, mais, pour la France, il est plutôt récent et concerne essentiellement l’extrémité supérieure de l’échelle des revenus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ca1dca0-8c05-3b6a-b8d2-36cc2f22e86d",
                                        "entry_id": "27ea3bf9-97e1-36c3-a284-14ea90d9a3a9",
                                        "glosses": [
                                            "Alvéolisation caractérisée par la formation d’une seule alvéole affectant la surface de la pierre à partir de ses arêtes."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
