                ],
                "senses": [
                    {
                        "sense_id": "9b9ac44c-70ce-3ae4-9bcd-415f8b39eced",
                        "entry_id": "99370987-6f42-3982-a5d3-5680222d960d",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21d98c8b-6745-442e-a4b4-36bc4a9b8635",
                                "sense_id": "9b9ac44c-70ce-3ae4-9bcd-415f8b39eced",
                                "text": "Frau Oberhof ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "8824ad5f-1c6e-4752-b7f4-3925a2b5ad78",
                                "sense_id": "9b9ac44c-70ce-3ae4-9bcd-415f8b39eced",
                                "text": "Herr Oberhof wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "66cc06b5-b8f1-419b-ba01-c408b13a7682",
                                "sense_id": "9b9ac44c-70ce-3ae4-9bcd-415f8b39eced",
                                "text": "Die Oberhofs fahren heute nach Prag."
                            },
                            {
                                "example_id": "e801a24a-6328-42fb-bad5-5a6fba4d3d18",
                                "sense_id": "9b9ac44c-70ce-3ae4-9bcd-415f8b39eced",
                                "text": "Der Oberhof trägt nie die Pullover, die die Oberhof ihm strickt."
                            },
                            {
                                "example_id": "ea74ebc7-4e3a-4dc3-b843-0ab1fbd3a8bd",
                                "sense_id": "9b9ac44c-70ce-3ae4-9bcd-415f8b39eced",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Oberhof kommt, geht der Herr Oberhof.“"
                            },
                            {
                                "example_id": "a31983e0-121a-4a33-8f44-70654f0b28f6",
                                "sense_id": "9b9ac44c-70ce-3ae4-9bcd-415f8b39eced",
                                "text": "Oberhof kommt und geht."
                            },
                            {
                                "example_id": "4192cb0f-ab6e-4f21-96dd-4a4c097f36a5",
                                "sense_id": "9b9ac44c-70ce-3ae4-9bcd-415f8b39eced",
                                "text": "Oberhofs kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
