                                "target_senses": [
                                    {
                                        "sense_id": "f5f66257-01e1-3ea5-be57-99c1a550e955",
                                        "entry_id": "96d2cad2-afbc-3345-ac4c-8949fc8c4a84",
                                        "glosses": [
                                            "автомоб. жарг. легковой автомобиль марки «Шевроле»"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fab59e94-c934-4d8a-a004-ca706018ca90",
                                                "sense_id": "f5f66257-01e1-3ea5-be57-99c1a550e955",
                                                "text": "Сегодня катался вдоль Дона и немного повредил капот на шевике."
