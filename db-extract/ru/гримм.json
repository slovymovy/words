                ],
                "senses": [
                    {
                        "sense_id": "61cb7f15-9f58-3ec7-982a-f88fa553a64e",
                        "entry_id": "fe2d9b1d-bab0-3228-a617-d746f66d9996",
                        "glosses": [
                            "немецкая фамилия"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ec6db3d-4c13-4fe8-912c-d50d8b80110f",
                                "sense_id": "61cb7f15-9f58-3ec7-982a-f88fa553a64e",
                                "text": "Этот принцип братья Гримм положили в основу немецкого словаря, который на тот момент объединил все слова немецкого языка от Лютера до Гёте."
                            },
                            {
                                "example_id": "40560810-8843-4b41-a524-6fec56836525",
                                "sense_id": "61cb7f15-9f58-3ec7-982a-f88fa553a64e",
                                "text": "Я бы хотел говорить с господином Удо Гриммом."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6b072b86-1b7e-40ad-8ab9-5a5feee565ae",
                        "source_entry_id": "fe2d9b1d-bab0-3228-a617-d746f66d9996",
                        "source_sense_id": "61cb7f15-9f58-3ec7-982a-f88fa553a64e",
                        "target_lang_word": "Grimm",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Grimm",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "856e7404-a797-3ff6-a460-28060407409a",
                                        "entry_id": "7ade6123-03ea-3fde-9626-55f10ef2c2d2",
                                        "glosses": [
                                            "intensives Gefühl des Zornes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff8ce1c4-52db-4e42-bf4e-d1c0a565f26a",
                                                "sense_id": "856e7404-a797-3ff6-a460-28060407409a",
                                                "text": "„Der Mann war aufgesprungen und ging zu des Kommerzienrats stillem Grimme, ohne das Licht auszulöschen, mit raschen Schritten und mit festverschlungenen Armen im Zimmer auf und ab.“"
                                            },
                                            {
                                                "example_id": "93ed6ee9-7ef1-406d-88ef-5720ba83c14a",
                                                "sense_id": "856e7404-a797-3ff6-a460-28060407409a",
                                                "text": "„Vorerst wurde sein voller Grimm aber noch gemildert durch eine liebliche Begegnung hier auf dem Hamburger Konservatorium, im Sommer des Jahres 1918.“"
                                            },
                                            {
                                                "example_id": "46a742cb-9e61-4127-8ac7-3a2cf2e33ac6",
                                                "sense_id": "856e7404-a797-3ff6-a460-28060407409a",
                                                "text": "„Sie handelt davon, dass im Alter die Würde des Altwerdenen bedroht ist und stemmt sich mit sardonischem Grimm dagegen.“"
                                            },
                                            {
                                                "example_id": "b1337095-a8fd-4845-84b5-980aae2caa7d",
                                                "sense_id": "856e7404-a797-3ff6-a460-28060407409a",
                                                "text": "„Er war hier im Zentrum des gewaltigen Krieges, und dieser Krieg nahm alle seine Gedanken in Anspruch; so war er froh, für einige Zeit von der Gereiztheit und dem Grimm loszukommen, die jedes Mal in ihm aufstiegen, wenn er an Kuragin dachte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Grimm",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1a87985f-7c65-3107-a79e-79d4398403cb",
                                        "entry_id": "9f151a04-eb6d-3c39-9924-27fe72003d37",
                                        "glosses": [
                                            "deutschsprachiger Familienname, Nachname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ff22042-f2c4-4098-ae46-224bc8ee3939",
                                                "sense_id": "1a87985f-7c65-3107-a79e-79d4398403cb",
                                                "text": "Die Märchen der Gebrüder Grimm kennt jedes Kind."
                                            },
                                            {
                                                "example_id": "03c73823-652e-4070-9a0b-78a9e7d7869b",
                                                "sense_id": "1a87985f-7c65-3107-a79e-79d4398403cb",
                                                "text": "Die deutsche Sprachkultur ohne die Grimms ist schwer vorstelbar."
                                            },
                                            {
                                                "example_id": "e064f17a-d4d4-4718-887c-fc7e0b7af1f2",
                                                "sense_id": "1a87985f-7c65-3107-a79e-79d4398403cb",
                                                "text": "Manch Wort, mit langem Sprachgebrauch und kleinstaatlicher Benutzung oder Bedeutungsgebung, hätte es nicht ins 21. Jahrhundert geschafft, wären da nicht die Sprachwissen Grimm gewesen, die länderübergreifend, das deutsche Sprachtum, in Schriftform gebracht hätten."
                                            },
                                            {
                                                "example_id": "996cd011-7a79-4c1c-9755-cce199e8973d",
                                                "sense_id": "1a87985f-7c65-3107-a79e-79d4398403cb",
                                                "text": "Frau Grimm ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "f7838550-b4ba-4a9f-ac43-a2c3067a24d1",
                                                "sense_id": "1a87985f-7c65-3107-a79e-79d4398403cb",
                                                "text": "Herr Grimm wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "f2dd6d12-a09e-41f5-988a-4330dc0fb1ce",
                                                "sense_id": "1a87985f-7c65-3107-a79e-79d4398403cb",
                                                "text": "Die Grimms fahren heute nach Leipzig."
                                            },
                                            {
                                                "example_id": "21109fb7-7a35-479f-90e6-f44996adb4e9",
                                                "sense_id": "1a87985f-7c65-3107-a79e-79d4398403cb",
                                                "text": "Der Grimm trägt nie die Schals, die die Grimm ihm strickt."
                                            },
                                            {
                                                "example_id": "4fba16f0-1fa2-4d92-923f-50f97b38d9b4",
                                                "sense_id": "1a87985f-7c65-3107-a79e-79d4398403cb",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Grimm kommt, geht der Herr Grimm.“"
                                            },
                                            {
                                                "example_id": "957ea312-4c4b-428b-a68d-c0f2aa08e571",
                                                "sense_id": "1a87985f-7c65-3107-a79e-79d4398403cb",
                                                "text": "Grimm kommt und geht."
                                            },
                                            {
                                                "example_id": "560e831e-054a-4f41-8e86-0469ef1a064c",
                                                "sense_id": "1a87985f-7c65-3107-a79e-79d4398403cb",
                                                "text": "Grimms kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Grimm",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "34e8db1b-9ad8-3f3f-9b08-3f265c46447d",
                                        "entry_id": "7dbe59b3-63e1-3965-8abe-8b1c8851d381",
                                        "glosses": [
                                            "„Deutsches Wörterbuch von Jacob und Wilhelm Grimm“, bekanntes Wörterbuch der deutschen Sprache"
                                        ],
                                        "tags": [
                                            "short-form"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6529916a-f7e7-4a46-905c-40b1a8fc10eb",
                                                "sense_id": "34e8db1b-9ad8-3f3f-9b08-3f265c46447d",
                                                "text": "Reich mir bitte den Grimm, ich muss da die Schreibweise eines Wortes herausfinden."
                                            },
                                            {
                                                "example_id": "91d7b0c5-da29-4b62-adc6-791f0985b656",
                                                "sense_id": "34e8db1b-9ad8-3f3f-9b08-3f265c46447d",
                                                "text": "„Deutsches Wörterbuch von Jacob und Wilhelm Grimm.“"
                                            },
                                            {
                                                "example_id": "292978a7-208b-4107-b009-699fde601aa7",
                                                "sense_id": "34e8db1b-9ad8-3f3f-9b08-3f265c46447d",
                                                "text": "„Als die Brüder Grimm die redaktionelle Ausarbeitung des Deutschen Wörterbuchs (¹DWB) aufnahmen, veranschlagten sie dessen Umfang auf sechs bis sieben Bände, die Arbeitszeit auf zehn Jahre; tatsächlich erschienen in mehr als einhundert Jahren 16 Bände in 32 Teilbänden, auf deren insgesamt 67.744 Spalten Generationen von Lexikographen weit mehr als 300.000 Stichwörter behandeln, und ein separates, rund 4.000 Quellen umfassendes Quellenverzeichnis.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
