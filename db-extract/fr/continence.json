                "senses": [
                    {
                        "sense_id": "c0cfa621-1224-3256-af0d-55765fcb3b22",
                        "entry_id": "8d3a89fd-9bc2-3c78-8854-ca18e3e0237d",
                        "glosses": [
                            "Abstinence par rapport aux plaisirs des sens."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2296644c-5d5c-456d-8083-5aca61f73131",
                                "sense_id": "c0cfa621-1224-3256-af0d-55765fcb3b22",
                                "text": "Franchement, à l’âge qu’elle a et que je ne veux dire, il sied d’avoir quelque continence."
                            },
                            {
                                "example_id": "ba6216e6-f2ee-4ad4-8bfa-ed38f6a2e36f",
                                "sense_id": "c0cfa621-1224-3256-af0d-55765fcb3b22",
                                "text": "Or c’est justement parce que nous savons tout cela que nous considérons les recommandations et les prédications sur la continence comme nuisibles, car c’est fermer les yeux sur un mal qu’il s’agit de combattre."
                            },
                            {
                                "example_id": "cd679238-1793-4ee9-a232-f9ca0dbf9cb6",
                                "sense_id": "c0cfa621-1224-3256-af0d-55765fcb3b22",
                                "text": "Il pratiquait une certaine économie du plaisir, selon les travaux dont il était occupé. Tant qu’il menait une affaire difficile, laborieuse, il s’abstenait, ou se montrait moins assidu à l’amour. Ce n’étaient ni la fatigue, ni la tension de son esprit qui l’empêchaient d’être dispos, mais il tenait qu’en affaires la continence est un secret de réussite."
                            }
                        ]
                    }
                ],
