                                "target_senses": [
                                    {
                                        "sense_id": "c94e522b-36e5-378b-9124-5c1be71f69a1",
                                        "entry_id": "a8da898d-ce42-3a60-baa1-81717bd49c13",
                                        "glosses": [
                                            "Both exact and accurate."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "00adeaf9-c7d0-4d32-9027-a39c1e3ec2bb",
                                                "sense_id": "c94e522b-36e5-378b-9124-5c1be71f69a1",
                                                "text": "A memory is \"precise\" when the occurrences that would verify it are narrowly circumscribed: for instance, \"I met Jones\" is precise as compared to \"I met a man.\" A memory is \"accurate\" when it is both precise and true, i.e. in the above instance, if it was Jones I met."
                                            },
                                            {
                                                "example_id": "4b5c77b3-1687-4be1-8071-3cd46c0a3cb6",
                                                "sense_id": "c94e522b-36e5-378b-9124-5c1be71f69a1",
                                                "text": "Individually, some of these definitions fall into the common definitional trap of being overly precise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7eb57d31-8228-339a-98df-f950a1459ad1",
                                        "entry_id": "a8da898d-ce42-3a60-baa1-81717bd49c13",
                                        "glosses": [
                                            "Consistent, clustered close together, agreeing with each other (this does not mean that they cluster near the true, correct, or accurate value)."
                                        ],
                                        "tags": [
                                            "of data points"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fe5b0ce8-d2a3-31fd-9a6c-ce396e7db219",
                                        "entry_id": "a8da898d-ce42-3a60-baa1-81717bd49c13",
                                        "glosses": [
                                            "Adhering too much to rules; prim or punctilious."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "precise",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6de424d6-fea2-39a4-9064-5213819229fe",
                                        "entry_id": "15a845fb-6a9f-35d3-8d9e-29d00b4404d2",
                                        "glosses": [
                                            "To make or render precise; to specify."
