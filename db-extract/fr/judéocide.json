                "forms": [
                    {
                        "form_id": "f05e4125-b014-46e6-bddd-83382333e1e6",
                        "entry_id": "921c3996-7d66-320f-a7f0-bc5daaa8c4e8",
                        "tags": [
                            "plural"
                        ],
                        "form": "judéocides"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "61df0558-8b19-3a21-bc96-0ae775d9c8e1",
                        "entry_id": "921c3996-7d66-320f-a7f0-bc5daaa8c4e8",
                        "glosses": [
                            "Meurtre de Juif."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "55b7755a-62e4-32c0-9b31-2d8b8f7a999f",
                        "entry_id": "921c3996-7d66-320f-a7f0-bc5daaa8c4e8",
                        "glosses": [
                            "Celui ou celle qui a tué ou veut tuer un ou plusieurs Juifs."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "9239ed4b-5cbf-4758-8f87-a6403f74a826",
                                "sense_id": "55b7755a-62e4-32c0-9b31-2d8b8f7a999f",
                                "text": "…Lituanie où la restauration de la démocratie ne va pas sans méprise: près de 120 judéocides ont bénéficié de mesures d’amnistie."
                            },
                            {
                                "example_id": "487f47ce-8943-4136-b218-0e00362d4524",
                                "sense_id": "55b7755a-62e4-32c0-9b31-2d8b8f7a999f",
                                "text": "Sur l’étiquette de l’un de ces bidons le mot « herbicide » avait été remplacé par « judéocide », accompagné du mode d’emploi suivant : Placer quelques cristaux dans un lieu hermétiquement clos renfermant le plus grand nombre de Juifs."
                            }
                        ]
                    },
                    {
                        "sense_id": "f18db876-661b-323c-b2cc-6466b373434b",
                        "entry_id": "921c3996-7d66-320f-a7f0-bc5daaa8c4e8",
                        "glosses": [
                            "Extermination systématique des Juifs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f486f59-2ad2-45aa-b700-1030e0e403f8",
                                "sense_id": "f18db876-661b-323c-b2cc-6466b373434b",
                                "text": "Des historiens et certains déportés, emploient soit les termes de Shoah ou d’holocauste, à connotation plus religieuse, voire même de judéocide (Arno Mayer)."
                            },
                            {
                                "example_id": "afec3dad-5476-4410-951f-85159a232d1d",
                                "sense_id": "f18db876-661b-323c-b2cc-6466b373434b",
                                "text": "Pour dire la destruction des juifs européens, il existe aussi les mots de génocide des juifs ou encore de judéocide."
                            }
                        ]
                    },
                    {
                        "sense_id": "7f7eff29-e526-3ffa-9298-581d21f58c9e",
                        "entry_id": "921c3996-7d66-320f-a7f0-bc5daaa8c4e8",
                        "glosses": [
                            "Celui ou celle qui est favorable au génocide juif."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "f2c31d39-e9f0-4e05-856a-eb5e75dd8e0f",
                                "sense_id": "7f7eff29-e526-3ffa-9298-581d21f58c9e",
                                "text": "Edouard Husson analyse la logique infernale qui fit des nazis des judéocides."
                            }
                        ]
                    }
