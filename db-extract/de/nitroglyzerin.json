                                        "glosses": [
                                            "oleista, wybuchowa ciecz o wzorze sumarycznym C₃H₅N₃O₉, używana głównie w produkcji dynamitu oraz jako lek rozszerzający naczynia krwionośne"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
