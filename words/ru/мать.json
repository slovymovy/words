                    "semantic_group_id": "biological_parent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Медвежата везде следовали за своей <матерью>.",
                            "target_lang_translations": {
                                "en": "The bear cubs followed their <mother> everywhere.",
                                "nl": "De berenjongen volgden hun <moeder> overal.",
                                "zh": "小熊们总是跟在它们的<w>母</w>熊身后。",
                                "pl": "Niedźwiadki wszędzie podążały za swoją <matką>.",
                                "de": "Die Bärenjungen folgten ihrer <w>Mutter</w> überall hin.",
                                "fr": "Les oursons suivaient leur <mère> partout.",
                                "it": "Gli orsetti seguivano ovunque la loro <madre>.",
                                "cs": "Medvíďata následovala svou <matku> všude.",
                                "tr": "Yavru ayılar her yerde <w>annelerini</w> takip ediyorlardı.",
                                "es": "Los oseznos seguían a su <madre> a todas partes."
                            }
                        },
                        {
                            "text": "Котята спали в корзинке рядом с <матерью>.",
                            "target_lang_translations": {
                                "en": "The kittens slept in the basket next to their <mother>.",
                                "nl": "De kittens sliepen in de mand naast hun <moeder>.",
                                "zh": "小猫们睡在篮子里，挨着它们的<w>母</w>猫。",
                                "pl": "Kocięta spały w koszyku obok <matki>.",
                                "de": "Die Kätzchen schliefen im Körbchen neben ihrer <w>Mutter</w>.",
                                "fr": "Les chatons dormaient dans le panier à côté de leur <mère>.",
                                "it": "I gattini dormivano nel cestino accanto alla <madre>.",
                                "cs": "Koťata spala v košíku vedle <matky>.",
                                "tr": "Yavru kediler sepette <w>annelerinin</w> yanında uyuyorlardı.",
                                "es": "Los gatitos dormían en la cesta junto a su <madre>."
                            }
                        }
