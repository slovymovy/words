                        "glosses": [
                            "Variante de saboterie."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "631c4ed6-1409-4a0c-95b4-3e17cde0b4c9",
                                "sense_id": "eda8fe72-e22f-39f3-bf65-b59929bef641",
                                "text": "Dans la partie septentrionale, c’est-à-dire, dans les cantons de la Chaise-Dieu et de Crapenne, la sabotterie, les moulins à scie, et surtout les bateaux qui se construisent sur les ports de l'Allier, à Brassac et à Vézezoux, consomment encore une quantité considérable de bois."
                            },
                            {
                                "example_id": "e8f7464a-f906-477d-a02b-02bf50bf780f",
                                "sense_id": "eda8fe72-e22f-39f3-bf65-b59929bef641",
                                "text": "N'oublions pas de signaler une fabrication intéressante, la sabotterie, qui dans les cantons d’Omont, de Signy l'Abbaye et de Signy le Petit, occupe près de 140 ouvriers et met en œuvre 2,000 mètres cubes de hêtre, bouleau, aulne, etc."
                            }
                        ]
                    }
