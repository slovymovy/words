                    }
                ],
                "senses": [
                    {
                        "sense_id": "e19db995-e0bb-3485-bd28-1d9796584c09",
                        "entry_id": "959663d9-7113-37a4-8c95-72b76695cec5",
                        "glosses": [
                            "Antagoniste, concurrent, rival."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "8f80328a-0f04-4f12-80ef-7826be22013e",
                                "sense_id": "e19db995-e0bb-3485-bd28-1d9796584c09",
                                "text": "Durant l'Antiquité, Carthage était l’émule de Rome."
                            }
                        ]
                    },
                    {
                        "sense_id": "07f0a2de-786e-31af-933e-001e3caa43df",
                        "entry_id": "959663d9-7113-37a4-8c95-72b76695cec5",
                        "glosses": [
                            "Chacune des personnes qui sont regardées comme étant d'un mérite égal en quelque art, en quelque profession."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "9c81cfaa-8393-432b-a879-91b354f75621",
                                "sense_id": "07f0a2de-786e-31af-933e-001e3caa43df",
                                "text": "Cette existence, si laborieuse et si monotone, du marcaire vosgien, au début du XVIIIᵉ siècle, était cependant moins pénible que celle de ses émules de certaines régions des Alpes, […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "ff117893-b03e-3867-8b4a-c444a628fb72",
                        "entry_id": "959663d9-7113-37a4-8c95-72b76695cec5",
                        "glosses": [
                            "Personne qui cherche à imiter, voire surpasser quelqu’un."
                        ],
                        "tags": [
                            "common"
                        ],
                        "examples": [
                            {
                                "example_id": "0853adb6-7e01-47ce-8a54-d308ab1634a6",
                                "sense_id": "ff117893-b03e-3867-8b4a-c444a628fb72",
                                "text": "Chaque coup m'abrutissait davantage mais en même temps me raffermissait dans ma décision : ne pas céder à ces brutes qui se flattaient d'être les émules de la Gestapo."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a1d5bb50-e48c-4477-b172-4940dc2afe2b",
                        "source_entry_id": "959663d9-7113-37a4-8c95-72b76695cec5",
                        "target_lang_word": "emulator",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "emulator",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a2206062-54c7-3f88-afeb-72caa73babb7",
                                        "entry_id": "5c7182e3-6732-3650-9d44-81ac14fd9b74",
                                        "glosses": [
                                            "A person or thing that emulates."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "efaad74d-116c-4321-91b1-b1396aaac56e",
                                                "sense_id": "a2206062-54c7-3f88-afeb-72caa73babb7",
                                                "text": "I admire the conqueror of Tlajcala and of Culna, but I find in the life of this emulator of Caesar actions which, if necessity warranted, the heart must still refuse to approve […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1311a886-0c3b-390d-a70a-68c429f9f02f",
                                        "entry_id": "5c7182e3-6732-3650-9d44-81ac14fd9b74",
                                        "glosses": [
                                            "A piece of software or hardware that simulates another system."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e12c1c0f-f104-44fd-8d15-61f91aaf7e2e",
                        "source_entry_id": "959663d9-7113-37a4-8c95-72b76695cec5",
                        "target_lang_word": "navolger",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "navolger",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "544a1bc5-e804-3c62-acf1-3acfc8729299",
                                        "entry_id": "e6ab718e-523c-3b81-8b44-4b3d8dd125a3",
                                        "glosses": [
                                            "iemand die iemand anders nadoet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "afff8d15-4e0c-473f-9a1e-f707b1f7d3ed",
                                                "sense_id": "544a1bc5-e804-3c62-acf1-3acfc8729299",
                                                "text": "In 2015 pochte een negentienjarige uit de buurt van Moskou, Filip Bodeikin, over hoe hij via dit zelf uitgevonden spel verschillende kwetsbare tieners tot zelfdoding kon verleiden. ‘Sommige mensen zijn afval, en worden beter uit de weg geruimd.’ ­Bodeikin werd opgepakt. Een Russisch magazine gaf hem in november 2016 nog een forum om een uitgebreide, sensationele bekentenis te doen over zijn motieven en methode. Hij komt eruit als een psychopaat, verantwoordelijk voor minstens 17 zelfdodingen. En hij zou navolgers hebben die ‘zijn’ spel voortzetten."
                                            },
                                            {
                                                "example_id": "21b058d9-5a1d-4be3-97ab-4dd814170a83",
                                                "sense_id": "544a1bc5-e804-3c62-acf1-3acfc8729299",
                                                "text": "Filmmaker Pieter van Huystee volgde de aanloop naar de expositie en legde ook vast hoe een delegatie van het Bosch Research and Conservation Project ruim zestig Jeroen Bosch-werken onder de loep legde. De zeven hoofdzonden, eigendom van het Prado, werd gekwalificeerd als een werk van een navolger van Bosch, dus niet van de meester zelf."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "67529c55-6563-4412-8cc0-55da31c64bbb",
