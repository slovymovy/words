            {
                "entry_id": "72b0bb6e-a965-3fbb-a1e4-bd1a95d5c09b",
                "word": "pick-up",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "67582aba-7110-4ec3-bcbd-1cea2fdf835f",
