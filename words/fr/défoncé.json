                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après dix heures de travail sans pause, je suis complètement <w>défoncé</w>."
                        },
                        {
                            "text": "Il est rentré du marathon tellement <w>défoncé</w> qu'il s'est endormi sur le canapé."
