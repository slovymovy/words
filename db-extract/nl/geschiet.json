                                        "entry_id": "4b0e50bb-6c34-3c8a-9bcd-3bbd71d36510",
                                        "glosses": [
                                            "Moving or growing quickly"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37039f13-472d-4c09-9cf3-3f2d1a7d653d",
                                                "sense_id": "4eb5db69-53a0-374a-ae83-0d2c34fe17d1",
                                                "text": "Shooting beams of light played over the sea."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b0ff4773-b913-3292-b51b-077d7b7d5893",
                                        "entry_id": "4b0e50bb-6c34-3c8a-9bcd-3bbd71d36510",
                                        "glosses": [
                                            "Of a pain, sudden and darting"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25e91ebe-7a10-4e44-935d-a4862c080677",
                                                "sense_id": "b0ff4773-b913-3292-b51b-077d7b7d5893",
                                                "text": "I often feel a shooting pain in my arm."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "shooting",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f6e7e065-3585-3396-9db8-0c5ed676c5e4",
                                        "entry_id": "fa458721-28af-34ad-9a8d-7a69f367f582",
                                        "glosses": [
                                            "an instance of shooting with a gun or other weapon"
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "214febb5-c99e-4b85-8906-3128a08974dc",
                                                "sense_id": "f6e7e065-3585-3396-9db8-0c5ed676c5e4",
                                                "text": "Police are hunting the people who carried out the shootings last week."
                                            },
                                            {
                                                "example_id": "1b3c179e-c0af-4703-aaae-eb19fe3fa402",
                                                "sense_id": "f6e7e065-3585-3396-9db8-0c5ed676c5e4",
                                                "text": "Well, I've always been progun, you know that. It's... yeah, I think adding more guns into a situation is obviously the way to prevent shooting. I think in a way, if we take the guns away, the shootings may escalate. And I think that's why he's so firm on literally arming everyone. I think if you don't have a gun in your hands... well, let's not find out what that world would be."
                                            },
                                            {
                                                "example_id": "d7ca8fe3-5150-45dc-b639-a98f46ab418a",
                                                "sense_id": "f6e7e065-3585-3396-9db8-0c5ed676c5e4",
                                                "text": "The Gun Violence Archive[…] defines a mass shooting as one in which at least four people were killed or injured.\nAs of late March, the Gun Violence Archive has counted 130 mass shootings in the United States this year."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "013c6203-f628-3ef7-a915-f353fd6542e6",
                                        "entry_id": "fa458721-28af-34ad-9a8d-7a69f367f582",
                                        "glosses": [
                                            "the sport or activity of firing a gun or other weapon"
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fbd620fe-fa45-4ab7-8039-ca3d094a0d17",
                                                "sense_id": "013c6203-f628-3ef7-a915-f353fd6542e6",
                                                "text": "Well, I've always been progun, you know that. It's... yeah, I think adding more guns into a situation is obviously the way to prevent shooting. I think in a way, if we take the guns away, the shootings may escalate."
                                            },
                                            {
                                                "example_id": "f272a11d-7d03-48be-a782-e1b934480307",
                                                "sense_id": "013c6203-f628-3ef7-a915-f353fd6542e6",
                                                "text": "I take part in shooting at the local archery club."
                                            }
                                        ]
                                    },
