                        "examples": [
                            {
                                "example_id": "68434570-8192-4bf0-b2a1-83f103d27467",
                                "sense_id": "85969ba6-a78d-30a0-92e7-771f9fe0123b",
                                "text": "Thus, to characterize the Victorian worry about premature burial as a product of 'morbid romanticism,' or of the 'sheer mythopoeic force' of vivisepulture, is to ignore the deep confusion over human physiology that persisted into the twentieth century."
                            },
                            {
                                "example_id": "e8d1e481-a4bf-41e0-b112-951301f773de",
                                "sense_id": "85969ba6-a78d-30a0-92e7-771f9fe0123b",
                                "text": "As in most hot climates so in Egypt the dead are buried at once despite the risk of vivisepulture. This seems an instinct with the Semitic (Arabian) race teste Abraham, as with the Gypsy."
                            }
                        ]
