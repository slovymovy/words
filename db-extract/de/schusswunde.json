                "senses": [
                    {
                        "sense_id": "37f85ab3-1604-3ec0-ab78-5fb66dbcef0b",
                        "entry_id": "37720adb-ddc6-3a1a-b06a-b034ccc1b87e",
                        "glosses": [
                            "Verletzung, die durch ein abgeschossenes Projektil verursacht wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9f3f1b8-4cb9-49c3-8aac-bd19f9e20d07",
                                "sense_id": "37f85ab3-1604-3ec0-ab78-5fb66dbcef0b",
                                "text": "Aus einem fahrendem Auto wurde dem Rap-Künstler eine tödliche Schusswunde beigebracht."
                            },
                            {
                                "example_id": "36f2b3fd-2f0f-42a7-87d9-3c4959f58256",
                                "sense_id": "37f85ab3-1604-3ec0-ab78-5fb66dbcef0b",
                                "text": "In den Köpfen der Opfer wurden jeweils mehrere Schusswunden festgestellt."
                            },
                            {
                                "example_id": "8e0d0ed0-937d-4a5f-826d-164041f570a1",
                                "sense_id": "37f85ab3-1604-3ec0-ab78-5fb66dbcef0b",
                                "text": "„Es gab immer wieder Scharmützel, was zu Schuss- und Schrapnellwunden führte, die versorgt werden mussten, und alle, jung und alt, brauchten Decken, Kleidung, Schuhe, Seife und Lebensmittel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
