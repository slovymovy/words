                ],
                "senses": [
                    {
                        "sense_id": "b40f34d8-eda9-3e84-bf23-f1a495269970",
                        "entry_id": "1db5f8af-fd1b-3337-b5aa-1a4bfc1c5a72",
                        "glosses": [
                            "Aktivität, um Einfluss auf Politikerinnen/Politiker und Gesetzesvorhaben für eine oder mehrere Interessengruppen zu nehmen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a654edc-4bd0-4e10-9cc3-a4d24df573b4",
                                "sense_id": "b40f34d8-eda9-3e84-bf23-f1a495269970",
                                "text": "„Im Mittelpunkt steht Lobbyarbeit für die Wirtschaft.“"
                            },
                            {
                                "example_id": "ff63ff8a-9452-4ae8-9c5c-59012bf7ecfd",
                                "sense_id": "b40f34d8-eda9-3e84-bf23-f1a495269970",
                                "text": "„Überhaupt haben industrielle Interessen durch intensive Lobbyarbeit einen großen Einfluss auf politische Entscheidungen.“"
                            },
                            {
                                "example_id": "f4b60261-bdc0-4aff-94c4-4d3ef5c79d0d",
                                "sense_id": "b40f34d8-eda9-3e84-bf23-f1a495269970",
                                "text": "„Der größte Lobbyist in Brüssel ist Google. Das Unternehmen gibt bis zu 6 Millionen Euro im Jahr für Lobbyarbeit aus.“"
                            },
                            {
                                "example_id": "0413ae73-a109-4fa6-bcc0-752e31af619b",
                                "sense_id": "b40f34d8-eda9-3e84-bf23-f1a495269970",
                                "text": "„Die Ölindustrie gibt 100 Millionen Dollar im Jahr für Lobbyarbeit aus“"
                            },
                            {
                                "example_id": "49cdf4a9-74c4-454f-8d01-8d0c448a5310",
                                "sense_id": "b40f34d8-eda9-3e84-bf23-f1a495269970",
                                "text": "„OpenSecrets, die wichtigste überparteiliche Quelle für Wahlkampffinanzierung und Lobbyismus, weist nach, dass die Waffenindustrie während des Budgetzuwachses des Pentagons nach 9/11 etwa 300 Millionen US-Dollar für Wahlkampfspenden und 2,5 Milliarden Dollar für Lobbyarbeit aufgewendet hat.“"
                            },
                            {
                                "example_id": "c1a9b86b-3a27-4d9d-9026-ea7fef3bb242",
                                "sense_id": "b40f34d8-eda9-3e84-bf23-f1a495269970",
                                "text": "[Die EU und Deutschland haben] „bisher keine Sanktionen auf Weißfisch aus russischer Produktion verhängt. Auch, so berichten Insider, weil die Branche gute Lobbyarbeit geleistet hat.“"
                            },
                            {
                                "example_id": "c19c9b93-b7a8-415e-a7b9-4b1fe07fb100",
                                "sense_id": "b40f34d8-eda9-3e84-bf23-f1a495269970",
                                "text": "„Der CDU-Abgeordnete Philipp Amthor hat mit einem Brief an Bundeswirtschaftsminister Peter Altmaier (CDU) Lobbyarbeit für das Unternehmen Augustus Intelligence betrieben.“"
                            },
                            {
                                "example_id": "2044f20f-ebbd-4291-8bab-385da22e798b",
                                "sense_id": "b40f34d8-eda9-3e84-bf23-f1a495269970",
                                "text": "„Philipp Amthor macht für ein amerikanisches Unternehmen Lobbyarbeit beim Wirtschaftsministerium, erhält dafür Aktien als Lohn und die CDU-Spitzenkandidatur in Mecklenburg-Vorpommern.“"
                            },
                            {
                                "example_id": "513b75f1-1464-4ad3-9eb7-7372acb37f95",
                                "sense_id": "b40f34d8-eda9-3e84-bf23-f1a495269970",
                                "text": "„Im Fall Barroso hat sie den Wechsel des ehemaligen Kommissionspräsidenten zu Goldman Sachs überprüft, mit dem unterstützenswerten Ziel, die Kommission solle ihn verpflichten, eine bestimmte Anzahl von Jahren keine Lobbyarbeit zu betreiben.“"
                            },
                            {
                                "example_id": "e3505583-60ec-41ae-a640-b14537d13f13",
                                "sense_id": "b40f34d8-eda9-3e84-bf23-f1a495269970",
                                "text": "„Wegen seiner Freundschaft zu Putin und seiner Lobbyarbeit für mehrere russische Gaskonzerne wurde Schröder zuletzt immer stärker kritisiert.“"
                            },
                            {
                                "example_id": "d91586d1-4dcf-4e71-b269-8f1785044ecb",
                                "sense_id": "b40f34d8-eda9-3e84-bf23-f1a495269970",
                                "text": "„Kroes hat sich demnach bereits für Uber eingesetzt, als ihr nach dem Abschied aus der EU-Kommission solche Lobbyarbeit untersagt war.“"
                            },
                            {
                                "example_id": "b357559f-8201-4eb3-81ed-d067e7bbfe4d",
                                "sense_id": "b40f34d8-eda9-3e84-bf23-f1a495269970",
                                "text": "„Es ist für Lobbyarbeit und Public Relations hilfreich, die eigenen Positionen wissenschaftlich zu untermauern.“"
                            },
                            {
                                "example_id": "62012a08-d89b-4b70-8ff9-b00d301556c1",
                                "sense_id": "b40f34d8-eda9-3e84-bf23-f1a495269970",
                                "text": "„Allerdings gibt es“ […] „organisierten Widerstand seitens der Unternehmen, der weit über klassische Lobbyarbeit hinausgeht, es gibt ein über Jahre formuliertes und verbreitetes Framing (höhere Steuern für Reiche vernichten Arbeitsplätze oder: Unternehmen verlassen das Land, wenn sie zu viel Steuern zahlen müssen).“"
                            },
                            {
                                "example_id": "8426a706-9ba2-4b7c-93e3-635e50807eae",
                                "sense_id": "b40f34d8-eda9-3e84-bf23-f1a495269970",
                                "text": "[Über die Vergabe des Nobelpreises] „Eine Erklärung für die auffallend große Anzahl der US-amerikanischen Preisträger wird unter anderem mit dem Argument geliefert, dass die Amerikaner die beste Lobbyarbeit betreiben.“"
                            },
                            {
                                "example_id": "daab85ab-8379-4e12-96d4-ad3a528b9a07",
                                "sense_id": "b40f34d8-eda9-3e84-bf23-f1a495269970",
                                "text": "„Anne O. Krueger (1974) kritisierte, dass in Demokratien Unternehmen Ressourcen von ihrem produktiven Gebrauch in Lobbyarbeit umlenken, um politische Renten zu erhalten, beispielsweise in Form von Protektionismus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
