                        "examples": [
                            {
                                "example_id": "d0eacbc9-8611-409b-9249-987498fb0114",
                                "sense_id": "f01d5ea7-8b8f-3598-9f35-5ffa944ad843",
                                "text": "The big blow in the decisive third game came from catcher Jin-De Jhang, whose three-run triple gave Altoona all the breathing room it needed."
                            },
                            {
                                "example_id": "0213fbcb-9613-4450-a761-6424798e45cc",
                                "sense_id": "f01d5ea7-8b8f-3598-9f35-5ffa944ad843",
                                "text": "For the second straight game, the Altoona Curve beat the Akron RubberDucks, 4-3, in walk-off fashion on a game-winning single by Jin-De Jhang on Thursday at Peoples Natural Gas Field.[…]\nAfter Logan Hill was hit by a pitch, Elvis Escobar pinch ran for Craig at second base prior to Jhang’s game winner."
                            },
                            {
                                "example_id": "26024f1f-74c7-4aad-a747-0376b11559ec",
                                "sense_id": "f01d5ea7-8b8f-3598-9f35-5ffa944ad843",
                                "text": "Council official Du Jhang Mei-jhuang (杜張梅莊) last month said that 10,000 of the 260,000 hectares of land designated as Indigenous Reserved Land have been “lost” through fraudulent sales and deed transfers."
                            },
                            {
                                "example_id": "caef7bf1-98e9-47ae-a501-7a09ec80a5e0",
                                "sense_id": "f01d5ea7-8b8f-3598-9f35-5ffa944ad843",
                                "text": "Some of the places are being opened for the first time, such as the former residence of Jhang Syue-liang (張學良). Meanwhile, a car used to transport former dictator Chiang Kai-shek’s (蔣中正) is also on display for the public to sit in."
                            }
                        ]
