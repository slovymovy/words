                                        "glosses": [
                                            "To be prone on the ground."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "02909e64-2216-3ad0-9015-eceeebc5426c",
                                        "entry_id": "c8a5240f-6a67-31d3-b9fc-cbe43d1d997d",
                                        "glosses": [
                                            "To crawl."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "30b8988f-c549-44b4-a561-bef5b1a7366f",
                                                "sense_id": "02909e64-2216-3ad0-9015-eceeebc5426c",
                                                "text": "In the tube station, the old ones who were on the way out / Would dribble and vomit and grovel and shout"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7fd9b3df-0ad8-3b4a-9f1c-10643b945767",
                                        "entry_id": "c8a5240f-6a67-31d3-b9fc-cbe43d1d997d",
                                        "glosses": [
                                            "To abase oneself before another person."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf15db24-e560-4f44-952a-1864e082bd70",
                                                "sense_id": "7fd9b3df-0ad8-3b4a-9f1c-10643b945767",
                                                "text": "She refused to grovel in front of the bully, standing her ground."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2143eea1-aca4-3320-a86e-7547d9236472",
                                        "entry_id": "c8a5240f-6a67-31d3-b9fc-cbe43d1d997d",
                                        "glosses": [
                                            "To be slavishly nice to someone or apologize in the hope of securing something."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc92536f-5e52-4cf0-9a83-95b803d090ec",
                                                "sense_id": "2143eea1-aca4-3320-a86e-7547d9236472",
                                                "text": "He had to grovel before his boss after missing the important meeting."
                                            },
                                            {
                                                "example_id": "8ae36c9b-a029-45d6-acd9-3002c60d2149",
                                                "sense_id": "2143eea1-aca4-3320-a86e-7547d9236472",
                                                "text": "He hated to grovel, but he knew it was the only way to save his job."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c8a15ba3-e35d-3463-8fe7-89b551ae6099",
                                        "entry_id": "c8a5240f-6a67-31d3-b9fc-cbe43d1d997d",
                                        "glosses": [
                                            "To take pleasure in mundane activities."
                                        ],
