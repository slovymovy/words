                        "examples": [
                            {
                                "example_id": "d3560a5b-5bf8-4306-b354-6e46a7f8676c",
                                "sense_id": "0feeeb8b-8bf6-3700-9b18-c17ef169c216",
                                "text": "Meeuwis sloot af met het stompzinnigste nummer dat de Nederlandse liedkunst ooit had voortgebracht: `Kedeng, kedeng', de titel zijnde een onomatopee voor het geluid dat een trein van de Nederlandse Spoorwegen op de rails veroorzaakt."
                            },
                            {
                                "example_id": "7fc14765-a04d-41d6-997a-f270afd7b4c7",
                                "sense_id": "0feeeb8b-8bf6-3700-9b18-c17ef169c216",
                                "text": "Samen met de Vereniging Vrienden van het Lied (VVL) organiseert de Volksuniversiteit Enschede de cursus 'Maak kennis met het klassieke lied'. De lessen in voorzieningencluster Prismare aan de Roomweg zijn bestemd voor zowel de ervaren muziekliefhebber als mensen die kennis willen maken met de klassieke liedkunst."
                            }
                        ]
                    }
