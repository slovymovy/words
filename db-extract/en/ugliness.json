                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hässlichkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "aa1d4a44-4260-310a-a4f6-0292001e3752",
                                        "entry_id": "5365e2a1-7a73-36d0-a952-d7486ddc8c00",
                                        "glosses": [
                                            "unschönes Aussehen"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e3f6dec-5a66-47dc-85d7-fb4ce1f96d91",
                                                "sense_id": "aa1d4a44-4260-310a-a4f6-0292001e3752",
                                                "text": "Die Hässlichkeit der neuen Magd ist unbeschreiblich."
                                            },
                                            {
                                                "example_id": "842582b7-7c09-4f22-95a7-162f876eccd9",
                                                "sense_id": "aa1d4a44-4260-310a-a4f6-0292001e3752",
                                                "text": "Der neue Nachbar hat ein Gesicht von bemerkenswerter Hässlichkeit."
                                            },
                                            {
                                                "example_id": "3d004bb4-3445-452b-8022-d489c3f33d8d",
                                                "sense_id": "aa1d4a44-4260-310a-a4f6-0292001e3752",
                                                "text": "„Henriette war überzeugt, dass die Ursache seiner Hässlichkeit in dem Missverhältnis zwischen Augen und Mund bestand.“"
                                            },
                                            {
                                                "example_id": "122bf32f-2eb2-44f8-8416-56449e374f22",
                                                "sense_id": "aa1d4a44-4260-310a-a4f6-0292001e3752",
                                                "text": "„Aber seltsamer Weise findet er jetzt die Öde und Hässlichkeit Ostberlins weit weniger deprimierend als damals.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "03cae497-6ab3-388a-9f7f-7ccb4392159f",
                                        "entry_id": "5365e2a1-7a73-36d0-a952-d7486ddc8c00",
                                        "glosses": [
                                            "üble Gesinnung, die sich auf die Mitmenschen negativ auswirkt"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9f3f1d12-8c0b-4de2-bc5d-7b4fda34359c",
                                                "sense_id": "03cae497-6ab3-388a-9f7f-7ccb4392159f",
                                                "text": "Dass dein Kollege dich immerzu anschwärzt, zeigt seine ganze Hässlichkeit."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "541effdf-9071-3693-a11c-b653f3e6d33e",
                                        "entry_id": "5365e2a1-7a73-36d0-a952-d7486ddc8c00",
                                        "glosses": [
                                            "Handlung, die für andere ein Grund zum Unmut ist"
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "179eed73-245c-43fb-8639-dad30389aac2",
                                                "sense_id": "541effdf-9071-3693-a11c-b653f3e6d33e",
                                                "text": "Lilo hatte während der vergangenen Jahre so einige Hässlichkeiten seitens ihres Ehemannes zu ertragen."
                                            },
                                            {
                                                "example_id": "25f9de68-670a-456a-ae42-20b9905466e5",
                                                "sense_id": "541effdf-9071-3693-a11c-b653f3e6d33e",
                                                "text": "Herr Müller regt sich über jede Kleinigkeit auf und übt Rache, indem er sich allerhand Hässlichkeiten ausdenkt."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
