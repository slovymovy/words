                                        "sense_id": "a5bb64e4-7714-3687-a906-9cb7ce855fe0",
                                        "entry_id": "a18a51ad-a37c-3dcc-a78d-36e44a2a00c8",
                                        "glosses": [
                                            "To inflict a heavy defeat upon."
                                        ],
                                        "tags": [
                                            "US",
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09e7919e-1e17-4073-9d0f-3f4e82a5cbad",
                                                "sense_id": "a5bb64e4-7714-3687-a906-9cb7ce855fe0",
                                                "text": "In 1964 Goldwater ran rambunctiously, flat-out against government. He got shellacked."
                                            },
                                            {
                                                "example_id": "1bd4613a-ed57-43f6-87d3-393b81c0f51c",
                                                "sense_id": "a5bb64e4-7714-3687-a906-9cb7ce855fe0",
                                                "text": "In another the Mets were shellacked, 9-1, with a stray ninth-inning home run by Strawberry after two outs, preventing a shutout."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
