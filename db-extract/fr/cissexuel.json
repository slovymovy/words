                "senses": [
                    {
                        "sense_id": "6602ccf9-fb6a-3f0b-9b85-7ee105d7d8ac",
                        "entry_id": "2648e85f-b136-33e0-b068-35f838c3934a",
                        "glosses": [
                            "Personne qui vit avec le sexe et le genre qui lui ont été assignés à sa naissance."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "6cabe67d-c937-423f-828f-17cdb14875c7",
                                "sense_id": "6602ccf9-fb6a-3f0b-9b85-7ee105d7d8ac",
                                "text": "La plupart des cissexuel·les sont inconscient·es de la nature subjective du genrement, essentiellement car elleux-mêmes ne vivent pas l’expérience d’être régulièrement mégenrées – i.e. assigné·es par erreur à un genre qui ne leur correspond pas."
                            }
                        ]
                    }
