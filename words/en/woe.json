        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "fa371850-e0a4-3df9-ba3a-04e5b03d85d5",
                    "sense_definition": "Sorrowful; miserable; feeling or showing great distress.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He felt wondrous <w>woe</w> when he realized his companion had departed.",
                            "target_lang_translations": {
                                "pl": "Poczuł niezwykły <w>smutek</w>, kiedy zdał sobie sprawę, że jego towarzysz odszedł."
