                                        "examples": [
                                            {
                                                "example_id": "537586e2-2c97-4508-93c8-0d0e6fbc181e",
                                                "sense_id": "d1daafbc-6fbb-354d-9a53-c30e07d12dbd",
                                                "text": "Die Hauptstraße führt an der Zeile von Häusern entlang."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e2bdd469-7ed6-30b1-9acc-a5ba98b504dd",
                                        "entry_id": "fd9c5339-a5ca-357f-bb86-2d2728f7eb6a",
                                        "glosses": [
                                            "Bei einer Schrift mit horizontaler Schreibrichtung alle nebeneinander stehenden Wörter und Zeichen zusammen"
                                        ],
                                        "tags": [
                                            "Druckwesen",
                                            "Satzwesen",
                                            "Typografie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fdbe0300-b73f-4020-9888-10b24f3ea6ff",
                                                "sense_id": "e2bdd469-7ed6-30b1-9acc-a5ba98b504dd",
                                                "text": "Vielen Dank für Ihre Zeilen."
                                            },
                                            {
                                                "example_id": "0b6b3ecd-dea9-4ca9-9cb7-ddc0a4f69f25",
                                                "sense_id": "e2bdd469-7ed6-30b1-9acc-a5ba98b504dd",
                                                "text": "„Diese letzten Zeilen hatte ich damals rot unterstrichen.“"
                                            },
                                            {
                                                "example_id": "c70dfd78-6da5-4e54-b2d7-b13c46a1722e",
                                                "sense_id": "e2bdd469-7ed6-30b1-9acc-a5ba98b504dd",
                                                "text": "„Als er so sprach, überflog er noch einmal die letzten Zeilen und griff dann erst nach dem Telegramm.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "5a6fe51f-8668-3f6a-9688-354bc5134b1b",
                                        "entry_id": "fd9c5339-a5ca-357f-bb86-2d2728f7eb6a",
                                        "glosses": [
                                            "Die horizontalen Einträge einer Matrix, eines Arrays oder einer Tabelle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f0c6797-8b7e-4743-8cdf-2106a69f810e",
                                                "sense_id": "5a6fe51f-8668-3f6a-9688-354bc5134b1b",
                                                "text": "„Als Notation hat sich die Aneinanderreihung der Elemente in Zeilen und Spalten mit einer großen öffnenden und schließenden Klammer durchgesetzt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
