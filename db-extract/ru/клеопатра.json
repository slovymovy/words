                "senses": [
                    {
                        "sense_id": "9a5e1b95-02ef-3aad-b854-ccf321f9b9b7",
                        "entry_id": "0008488e-3fd7-388a-88c1-843fbfd0cdf7",
                        "glosses": [
                            "женское имя"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5adda01-240b-4e23-9c12-c89e3cfcd094",
                                "sense_id": "9a5e1b95-02ef-3aad-b854-ccf321f9b9b7",
                                "text": "Мы имели в переводах сочинения св. Амвросия, Августина, Иеронима, Григория, Историю римских императоров (вероятно, Светонову), Марка Антония и Клеопатры; но Иовий укоряет нас совершенным невежеством в науках: в философии, астрономии, физике, медицине, сказывая, что мы именуем лекарем всякого, кто знает некоторые целебные свойства растений."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7c840719-ed93-4fa7-acf8-da33b33892b3",
                        "source_entry_id": "0008488e-3fd7-388a-88c1-843fbfd0cdf7",
                        "source_sense_id": "9a5e1b95-02ef-3aad-b854-ccf321f9b9b7",
                        "target_lang_word": "Cleopatra",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Cleopatra",
