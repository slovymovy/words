                        "sense_id": "146c44b6-5ed0-3545-ab5f-6a3fab0f44b2",
                        "entry_id": "8a7f5b37-dc8b-3cec-854b-62e1440d3a90",
                        "glosses": [
                            "Action, pour des animaux, de fouiller le sol pour y chercher de la nourriture."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93de3748-19c7-409f-bec2-c352dd47b9eb",
                                "sense_id": "146c44b6-5ed0-3545-ab5f-6a3fab0f44b2",
                                "text": "D'autant plus qu'entre les arbres le sol est extrêmement sec, recouvert de pierrailles, sans humus et absolument impropre au vermillage auquel se livrent les Turdidés."
                            }
                        ]
