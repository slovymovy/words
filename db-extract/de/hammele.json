                "senses": [
                    {
                        "sense_id": "4da701f8-878b-3f2f-ab28-bf3fa569902b",
                        "entry_id": "d3f56259-b201-3a61-8cfc-240653702a3d",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2fdb3f7b-0cd8-4e7a-8db7-a00e1a02c756",
                                "sense_id": "4da701f8-878b-3f2f-ab28-bf3fa569902b",
                                "text": "Frau Hammele ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "ab457979-e8a5-426d-b56e-2feafc8d0278",
                                "sense_id": "4da701f8-878b-3f2f-ab28-bf3fa569902b",
                                "text": "Herr Hammele wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "16cf03c2-a0ac-4e98-8be4-b1b33960c718",
                                "sense_id": "4da701f8-878b-3f2f-ab28-bf3fa569902b",
                                "text": "Die Hammeles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "988c4865-d391-4e10-a073-7952909cab2a",
                                "sense_id": "4da701f8-878b-3f2f-ab28-bf3fa569902b",
                                "text": "Der Hammele trägt nie die Pullover, die die Hammele ihm strickt."
                            },
                            {
                                "example_id": "b38df626-627a-433e-815b-fb34d0377c54",
                                "sense_id": "4da701f8-878b-3f2f-ab28-bf3fa569902b",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Hammele kommt, geht der Herr Hammele.“"
                            },
                            {
                                "example_id": "2a7ad559-3d79-4783-a635-a4de986dab0e",
                                "sense_id": "4da701f8-878b-3f2f-ab28-bf3fa569902b",
                                "text": "Hammele kommt und geht."
                            },
                            {
                                "example_id": "fc21a88a-267a-44dd-a5c7-fe0b80b324d9",
                                "sense_id": "4da701f8-878b-3f2f-ab28-bf3fa569902b",
                                "text": "Hammeles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
