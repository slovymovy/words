                "senses": [
                    {
                        "sense_id": "f6272032-a202-3cb5-89ac-33b8b3dfd531",
                        "entry_id": "d21f7382-47c2-3872-a934-3e09cd17fd6c",
                        "glosses": [
                            "ребёнок подросткового возраста . . ."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fab7e894-40c5-4bd6-baff-babcc1054eec",
                                "sense_id": "f6272032-a202-3cb5-89ac-33b8b3dfd531",
                                "text": "Подлеток ещё, годов может тринадцати, много четырнадцати."
                            },
                            {
                                "example_id": "9d30710c-f7c2-4353-ad0f-84af6f451ab2",
                                "sense_id": "f6272032-a202-3cb5-89ac-33b8b3dfd531",
                                "text": "В это время прибежали из лесу две её внучки, девчонки-подлетки, и хвалятся:"
                            },
                            {
                                "example_id": "e54316dc-b2ef-42cd-a537-3cc487273b11",
                                "sense_id": "f6272032-a202-3cb5-89ac-33b8b3dfd531",
                                "text": "― Вот мы и играли в любовь с этим подлетком и в конце лета расстались:"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "433bd706-528c-4926-b6bd-d47341cd450b",
                        "source_entry_id": "d21f7382-47c2-3872-a934-3e09cd17fd6c",
                        "source_sense_id": "f6272032-a202-3cb5-89ac-33b8b3dfd531",
