                        "source_sense_id": "035c4de4-7b9b-3e05-88d1-f607bc42e122",
                        "target_lang_word": "know-all",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "know-all",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0cf95bfb-b44c-37de-a00d-16c1b3c38ce4",
                                        "entry_id": "ea0efe15-1855-3b97-b699-8c144ac7d32b",
                                        "glosses": [
                                            "Someone who obnoxiously claims to be knowledgeable on a subject."
                                        ],
                                        "tags": [
                                            "Ireland",
                                            "UK"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "740c078b-664e-4c17-8773-6f159bc8dbad",
                        "source_entry_id": "a4d952a4-71cf-3839-83e3-f07c2e83be1c",
                        "source_sense_id": "035c4de4-7b9b-3e05-88d1-f607bc42e122",
                        "target_lang_word": "know-it-all",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "know-it-all",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3534794d-36c0-3b8b-917d-7c179f75bed3",
                                        "entry_id": "48997a31-671a-33a0-90fc-cd6feed3cb03",
                                        "glosses": [
                                            "Someone who claims to be knowledgeable or an expert in something, obnoxiously dismissing the opinions, advice, suggestions, etc. of others."
                                        ],
                                        "tags": [
                                            "US",
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf016736-4c72-4391-ad4b-c22155769364",
                                                "sense_id": "3534794d-36c0-3b8b-917d-7c179f75bed3",
                                                "text": "We had it all figured out, but this know-it-all marched in with \"the correct way of solving it\", leaving our experiment in shambles."
                                            },
                                            {
                                                "example_id": "7b29b6c0-5872-4d55-a50c-a87bf476679f",
                                                "sense_id": "3534794d-36c0-3b8b-917d-7c179f75bed3",
                                                "text": "The same holds true for supporting details—they help you to learn more about a topic. Be a know it all by sharing these details and supporting details with friends."
                                            },
                                            {
                                                "example_id": "c8dff8c7-0369-47d7-a6bd-cb9119d566b4",
                                                "sense_id": "3534794d-36c0-3b8b-917d-7c179f75bed3",
                                                "text": "She's a mean, bossy know-it-all."
                                            },
                                            {
                                                "example_id": "8c805bc4-3c1b-43d9-9e7c-9df2268b71fd",
                                                "sense_id": "3534794d-36c0-3b8b-917d-7c179f75bed3",
                                                "text": "Have you ever gone shopping with a Know-It-All girlfriend and she insists, without your consent or consulting you first, to choose your outfits for you?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
