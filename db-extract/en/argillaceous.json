                        "form": "more argillaceous"
                    },
                    {
                        "form_id": "c9c5180b-8068-46e2-9a39-2ddee700cc6b",
                        "entry_id": "7b62cde7-87b6-35eb-afb8-1f0136733b4c",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most argillaceous"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b899c272-9a04-382d-88be-18f5bb71dae7",
                        "entry_id": "7b62cde7-87b6-35eb-afb8-1f0136733b4c",
                        "glosses": [
                            "Pertaining to clay; made of, containing, or resembling clay; clayey."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8fcea7f9-358b-4365-ba63-19241f813591",
                                "sense_id": "b899c272-9a04-382d-88be-18f5bb71dae7",
                                "text": "[…] natural colossi from two to five hundred feet high, done in argillaceous sandstone or a singular species of conglomerate, all of which owe their existence almost entirely to the agency of wind."
                            },
                            {
                                "example_id": "0703ddd1-2feb-4d92-85ad-b140669f1b6b",
                                "sense_id": "b899c272-9a04-382d-88be-18f5bb71dae7",
                                "text": "The gleam of the land is in its rocks, the fine-grained argillaceous rocks, here, not purple or grey, but green of living stone."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "de96b54b-23ae-433c-b8da-c1ea6338ff69",
                        "source_entry_id": "7b62cde7-87b6-35eb-afb8-1f0136733b4c",
                        "source_sense_id": "b899c272-9a04-382d-88be-18f5bb71dae7",
                        "source_sense_description": "pertaining to clay",
                        "target_lang_word": "argilacé",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "argilacé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9dc5bfe8-25cd-3512-bfc8-fef22778ce04",
                                        "entry_id": "b821b531-9cb1-37bd-99b6-ceade4d1af8b",
                                        "glosses": [
                                            "Qui ressemble, qui a l'aspect de l'argile."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1be292d9-8c34-4f07-bb7a-c5bfdfdd479e",
                                                "sense_id": "9dc5bfe8-25cd-3512-bfc8-fef22778ce04",
                                                "text": "Chair tendre, molle, crème argilacé, bistre-noir sous la cuticule, inodore, douce, sapide."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bfc17ab7-8780-4da7-ab76-3834a6c984d1",
                        "source_entry_id": "7b62cde7-87b6-35eb-afb8-1f0136733b4c",
                        "source_sense_id": "b899c272-9a04-382d-88be-18f5bb71dae7",
                        "source_sense_description": "pertaining to clay",
                        "target_lang_word": "argileux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "argileux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a62a1884-ebe8-3a98-9d3a-acf4efbd7d1f",
                                        "entry_id": "640953fa-91d7-316f-9c78-91b0c3dfda7d",
                                        "glosses": [
                                            "Qui tient de l’argile."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6fdd9e16-d355-4584-a109-a9fd822c6857",
                                                "sense_id": "a62a1884-ebe8-3a98-9d3a-acf4efbd7d1f",
                                                "text": "Ce sont des calcaires compactes, sub-lithographiques, dont quelques-uns ont un faux aspect de calcaire grossier marin, et d’autres qui sont celluleux, alternent avec des marnes plus ou moins argileuses."
                                            },
                                            {
                                                "example_id": "4f56cf3b-bc9b-48b7-bf00-87cc754688fb",
                                                "sense_id": "a62a1884-ebe8-3a98-9d3a-acf4efbd7d1f",
                                                "text": "La grande et la moyenne ont des assolements semblables; ils sont triennaux dans les coteaux argilo-calcaires et les plaines argileuses, et biennaux dans les terres d'alluvion et les boulbènes légères."
                                            },
                                            {
                                                "example_id": "56613f44-86c1-4d67-8df5-5461e12bc1d2",
                                                "sense_id": "a62a1884-ebe8-3a98-9d3a-acf4efbd7d1f",
                                                "text": "Dans les sols légers et perméables la potasse sera fournie sous forme de kaïnite. Dans les sols argileux, il faut éviter de l'employer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b6e492bb-39c9-4dea-a561-00551f7b9873",
                        "source_entry_id": "7b62cde7-87b6-35eb-afb8-1f0136733b4c",
