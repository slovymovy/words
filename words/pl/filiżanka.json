    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3825ea23-83ba-31f7-bc7a-935028439684",
                    "sense_definition": "niewielkie naczynie z uszkiem, z którego pije się gorące napoje",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "naczynie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Potłukłam moją ulubioną <w>filiżankę</w>. Został tylko spodek.",
                            "target_lang_translations": {
                                "ru": "Я разбила свою любимую <w>чашку</w>. Осталось только блюдце."
                            }
                        },
                        {
                            "text": "Na stole stoi pełna <w>filiżanka</w> aromatycznej kawy.",
                            "target_lang_translations": {
                                "ru": "На столе стоит полная <w>чашка</w> ароматного кофе."
                            }
                        }
                    ],
                    "synonyms": [
                        "czarka"
                    ],
                    "common_phrases": [
                        "filiżanka kawy",
                        "filiżanka herbaty"
                    ],
                    "target_lang_definitions": {
                        "ru": "небольшой сосуд с ручкой, из которого пьют горячие напитки"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чашка",
                                "target_lang_sense_clarification": "небольшой сосуд для питья"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0ed12bc3-8da3-3159-8cb7-4957f59e1e76",
                    "sense_definition": "miara objętości równa pojemności naczynia",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "naczynie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mam ochotę na <w>filiżankę</w> gorącej czekolady.",
                            "target_lang_translations": {
                                "ru": "Я хочу <w>чашку</w> горячего шоколада."
                            }
                        },
                        {
                            "text": "Do ciasta należy dodać jedną <w>filiżankę</w> mąki.",
                            "target_lang_translations": {
                                "ru": "В тесто нужно добавить одну <w>чашку</w> муки."
                            }
                        }
                    ],
                    "common_phrases": [
                        "filiżanka czekolady",
                        "jedna filiżanka"
                    ],
                    "target_lang_definitions": {
                        "ru": "мера объёма, равная вместимости такого сосуда"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чашка",
                                "target_lang_sense_clarification": "мера объёма, используемая в кулинарии"
                            }
                        ]
                    }
                }
            ]
        }
    ]
