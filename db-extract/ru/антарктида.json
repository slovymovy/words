                "senses": [
                    {
                        "sense_id": "b7b47636-7684-3cdd-b458-5309ecb84e1f",
                        "entry_id": "d04b1dc2-99dc-3c77-81f0-e7c5d5f13712",
                        "glosses": [
                            "геогр. самый южный континент планеты Земля"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73167291-fc5d-4a09-bd82-ab04a7cfaa20",
                                "sense_id": "b7b47636-7684-3cdd-b458-5309ecb84e1f",
                                "text": "Ведь Антарктида — самый холодный материк на Земле."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "326e0544-bdd9-4206-a33d-5d85e6748373",
                        "source_entry_id": "d04b1dc2-99dc-3c77-81f0-e7c5d5f13712",
                        "source_sense_id": "b7b47636-7684-3cdd-b458-5309ecb84e1f",
                        "target_lang_word": "Antarctica",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Antarctica",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "67d0e90d-4317-3a09-af9d-6fbfcba7b975",
                                        "entry_id": "c1dcdee9-7b85-3aba-9722-cf7ec11f7a2c",
                                        "glosses": [
                                            "The southernmost continent, south of the Southern Ocean, containing the South Pole."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "463a2e0a-12b2-4d67-ba4f-bd1e4070cbed",
                                                "sense_id": "67d0e90d-4317-3a09-af9d-6fbfcba7b975",
                                                "text": "The five largest islands or peninsulas in which the crests of the World Ridges break through the uniform covering of the hydrosphere are termed continents, and designated by the names Eurasia, Africa, North America, South America, and Australia. They are distinguished from other islands and peninsulas by size alone, Australia being ten times larger than New Guinea, and Africa ten times larger than Arabia, these being the greatest island and peninsula not called continents. The elevated region round the South Pole is crowned by the unexplored and scarcely discovered continent of Antarctica."
                                            },
                                            {
                                                "example_id": "849f3fa2-96e6-445b-8293-c562edaca63c",
                                                "sense_id": "67d0e90d-4317-3a09-af9d-6fbfcba7b975",
                                                "text": "Dr. Murray believes that Alexander I. Land is a part of the west coast of Graham's Land, and that this landmass, which Biscoe and Larsen proved to widen rapidly toward the south, is only a peninsula of the continent of Antarctica."
                                            },
                                            {
                                                "example_id": "61972939-c339-49ea-acf3-329fa6aaaff7",
                                                "sense_id": "67d0e90d-4317-3a09-af9d-6fbfcba7b975",
                                                "text": "To most people, the huge ice sheets of Antarctica and Greenland are merely water that once was snow. To glaciologists and climatologists, they are storehouses of the Earth's former atmospheres."
                                            },
                                            {
                                                "example_id": "1d562633-f521-4b92-99a3-1b4993abc3fb",
                                                "sense_id": "67d0e90d-4317-3a09-af9d-6fbfcba7b975",
                                                "text": "The project poses exceptional challenges, given that Antarctica is the coldest, windiest and driest continent on Earth, as well as the most remote and inaccessible, being almost totally covered by a vast ice sheet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ccd8f5d-600d-3b3c-bbe1-8b56fbd23536",
                                        "entry_id": "c1dcdee9-7b85-3aba-9722-cf7ec11f7a2c",
                                        "glosses": [
                                            "the Antarctic"
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f2e82df1-12d8-48ff-9e81-a723a44fb01e",
                        "source_entry_id": "d04b1dc2-99dc-3c77-81f0-e7c5d5f13712",
                        "source_sense_id": "b7b47636-7684-3cdd-b458-5309ecb84e1f",
                        "target_lang_word": "Antarctic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Antarctic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6b7b1d0b-6fd3-3d5b-8cef-1e8ac10f5adc",
                                        "entry_id": "3b7e3595-bde0-3582-a497-8aaf42400a33",
                                        "glosses": [
                                            "Of, from, or pertaining to Antarctica and the south polar regions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc429400-311a-48f7-8084-01b3b7e6a7e1",
                                                "sense_id": "6b7b1d0b-6fd3-3d5b-8cef-1e8ac10f5adc",
                                                "text": "We are likely to consider Antarctic English as an occupational variety of general English rather than a new regional variety, mainly because men go to work in the Antarctic for a period, intending to return. They are not settlers."
                                            },
                                            {
                                                "example_id": "56319c27-826b-4c5b-897e-72cd9d3e9de1",
                                                "sense_id": "6b7b1d0b-6fd3-3d5b-8cef-1e8ac10f5adc",
                                                "text": "Scientists have known for years that the Thwaites glacier is the soft underbelly of the Antarctic ice sheet, and first found that it was unstable decades ago."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "616c3ffa-f385-30f5-8a84-d42e86800d6e",
                                        "entry_id": "3b7e3595-bde0-3582-a497-8aaf42400a33",
                                        "glosses": [
                                            "Opposite, contradictory."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "72790ba4-e3bd-38a4-822d-6f5c72597b03",
                                        "entry_id": "3b7e3595-bde0-3582-a497-8aaf42400a33",
                                        "glosses": [
                                            "Southern."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Antarctic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "79e39b4e-18b1-309c-beda-2199802419eb",
                                        "entry_id": "e45d3f19-f4cb-3ccc-b3ed-aefe07c0b3ea",
                                        "glosses": [
                                            "A continental region, one of the major ecozones of the world, covering the south polar regions, especially those south of the Antarctic Convergence; or, in accordance with the Antarctic Treaty System, the 60th parallel south."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
