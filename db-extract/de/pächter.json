                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1dbdcfb7-853d-418b-839f-8c7c66ad15a9",
                        "source_entry_id": "95bd668d-2f1e-39b1-a24f-9b0235db34d9",
                        "source_sense_id": "b0d0494c-387f-3df0-9d38-991459a0f538",
