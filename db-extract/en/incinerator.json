                "forms": [],
                "senses": [
                    {
                        "sense_id": "869851a9-993f-3f37-8549-2f63f2eaeb39",
                        "entry_id": "7461ac3c-0c92-357b-ac32-22c8eeb39331",
                        "glosses": [
                            "Müllverbrennungsanlage, Verbrennungsanlage"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73f1199f-d67c-42e3-9e36-4bdb8fb3debf",
                                "sense_id": "869851a9-993f-3f37-8549-2f63f2eaeb39",
                                "text": "\"The company that hauled medical trash to the incinerator refused to take anything used on an Ebola patient unless it was sterilized first.\""
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8a1cc79d-55e9-42c6-a2a4-7d2f761bd4aa",
                        "source_entry_id": "7461ac3c-0c92-357b-ac32-22c8eeb39331",
                        "source_sense_id": "869851a9-993f-3f37-8549-2f63f2eaeb39",
                        "source_sense_description": "Müllverbrennungsanlage, Verbrennungsanlage",
                        "target_lang_word": "Müllverbrennungsanlage",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Müllverbrennungsanlage",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3870d7f2-707a-3062-953d-7c3d776d2a3a",
                                        "entry_id": "5632b2be-34cc-3b8a-abfb-9cb469e1dd9e",
                                        "glosses": [
                                            "Anlage zur Verbrennung von Abfällen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3f0a326-d45f-4d43-bcec-6e8aeff95e51",
                                                "sense_id": "3870d7f2-707a-3062-953d-7c3d776d2a3a",
                                                "text": "„Hausmüll wird in Deutschland, soweit er nicht vorher durch getrennte Sammlung der Verwertung zugeführt wurde, entweder in Müllverbrennungsanlagen unter Erzeugung von Strom oder Wärme verbrannt (rund 17 Mio. Tonnen im Jahr 2006) oder in mechanisch-biologischen Abfallbehandlungsanlagen behandelt (rund 4 Mio. Tonnen im Jahr 2006).“"
                                            },
                                            {
                                                "example_id": "b2d9aa6f-7e1d-49c9-b98e-f30c5dafbf7f",
                                                "sense_id": "3870d7f2-707a-3062-953d-7c3d776d2a3a",
                                                "text": "„Die RMVA zählt zu den effizientesten und umweltfreundlichsten Müllverbrennungsanlagen weltweit.“"
                                            },
                                            {
                                                "example_id": "6f2b0d7f-018b-409f-a55e-f1d3fb9389df",
                                                "sense_id": "3870d7f2-707a-3062-953d-7c3d776d2a3a",
                                                "text": "„Die Müllverbrennungsanlage auf Hjalli wurde ebenfalls 1987 eingeweiht und kostete ungefähr das Gleiche wie das Altersheim Lágargardur.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
