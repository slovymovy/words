                "senses": [
                    {
                        "sense_id": "9cccf827-dc2d-3ab5-9df3-28513059b6a4",
                        "entry_id": "2dc52202-5beb-33d6-8a69-0c0a690e58f5",
                        "glosses": [
                            "Sonner (pour un téléphone)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e947212-8f89-4917-b6ef-727efe50602b",
                                "sense_id": "9cccf827-dc2d-3ab5-9df3-28513059b6a4",
                                "text": "Quand le téléphone berlingue à trois plombes du mat’, c’est rarement pour annoncer une bonne nouvelle."
                            },
                            {
                                "example_id": "ee86523e-0a03-4ed1-862f-ebaff584b282",
                                "sense_id": "9cccf827-dc2d-3ab5-9df3-28513059b6a4",
                                "text": "En moins d’une minute, il a ouvert la petite porte. Qui s’ouvre directement sur la première marche d’un petit escalier de bois au sommet duquel berlingue, présentement, une sonnerie de téléphone."
                            }
                        ]
                    }
