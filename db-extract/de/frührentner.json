                                        "entry_id": "3e68a16d-6376-33ce-9bc9-3ccb82dd282e",
                                        "glosses": [
                                            "Personne en préretraite, personne ayant pris sa retraite avant l’âge usuel, soit par choix, soit pour raisons médicales."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e180002-e5f5-4019-b54a-25237af67cda",
                                                "sense_id": "9fad13c1-4fff-3041-80d3-e803be703fc2",
                                                "text": "Le préretraité se précipite sur la mallette et s’acharne sur les serrures."
                                            },
                                            {
                                                "example_id": "7359655b-8dec-444a-9001-f8338bd523ae",
                                                "sense_id": "9fad13c1-4fff-3041-80d3-e803be703fc2",
                                                "text": "Les préretraités coûtent-ils cher à la société ou les emplois qu’ils libèrent permettent-ils de combattre le chômage, vaste débat !"
                                            },
                                            {
                                                "example_id": "a44ffecb-cc5c-4d1d-a142-66db9176348b",
                                                "sense_id": "9fad13c1-4fff-3041-80d3-e803be703fc2",
                                                "text": "Les préretraités ont également cité un compte d’épargne distinct réservé à une entreprise (43 %), un prêt bancaire ou d’une autre source (34 %), un héritage (21 %), l’aide de leur famille et d’amis (14 %)."
                                            }
                                        ]
                                    }
