{
    "word_family": [
        "brow"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "afd46164-cece-3383-91ae-a7b39738b4af",
                    "sense_definition": "Relating to culture or art that is accessible and popular, but not considered highly intellectual or avant-garde.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "cultural_status",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The critic dismissed the film as <w>middlebrow</w> entertainment that lacked any real artistic depth.",
                            "target_lang_translations": {
                                "zh": "评论家认为这部电影只是缺乏真正艺术深度的<w>中产阶级趣味</w>娱乐。"
                            }
                        },
                        {
                            "text": "Many people enjoy <w>middlebrow</w> novels because they are easy to read and provide a relaxing escape.",
                            "target_lang_translations": {
                                "zh": "许多人喜欢<w>通俗</w>小说，因为它们读起来轻松，能提供一种放松的消遣。"
                            }
                        }
                    ],
                    "synonyms": [
                        "mainstream",
                        "conventional"
                    ],
                    "antonyms": [
                        "highbrow",
                        "lowbrow"
                    ],
                    "common_phrases": [
                        "middlebrow culture",
                        "middlebrow entertainment"
                    ],
                    "target_lang_definitions": {
                        "zh": "指文化或艺术作品通俗易懂、受大众欢迎，但缺乏深刻的智性或前卫性。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "中产阶级趣味的",
                                "target_lang_sense_clarification": "形容符合大众审美，既不深奥也不低俗的文化品位。"
                            },
                            {
                                "target_lang_word": "通俗的",
                                "target_lang_sense_clarification": "指大众化、易于理解的艺术风格。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "faeb3d2c-8b25-3e38-a311-ba5ba628ebfb",
                    "sense_definition": "A person who prefers culture or art that is accessible and popular rather than highly intellectual or avant-garde.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "cultural_status",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The magazine was designed to appeal to the average <w>middlebrow</w> who enjoys a mix of news and light fiction.",
                            "target_lang_translations": {
                                "zh": "这本杂志旨在吸引那些喜欢新闻与轻小说结合的普通<w>中产阶级趣味者</w>。"
                            }
                        },
                        {
                            "text": "He considers himself a <w>middlebrow</w> because he likes both classic literature and popular television shows.",
                            "target_lang_translations": {
                                "zh": "他认为自己是一个<w>中产阶级趣味者</w>，因为他既喜欢经典文学，也喜欢流行电视节目。"
                            }
                        }
                    ],
                    "antonyms": [
                        "highbrow",
                        "lowbrow"
                    ],
                    "target_lang_definitions": {
                        "zh": "指偏好通俗易懂、大众化文化艺术，而非深奥或前卫作品的人。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "中产阶级趣味者",
                                "target_lang_sense_clarification": "指具有中等文化品位，追求大众化娱乐的人。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}