                    },
                    {
                        "translation_id": "d7e89e6b-c720-411f-85ef-cc1ec90f1801",
                        "source_entry_id": "484ec42d-2d20-301d-9d72-183334784e5c",
                        "source_sense_description": "споткнуться",
                        "target_lang_word": "mis-step",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mis-step",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7f2a1326-c734-3eef-ad01-920544e1cb98",
                                        "entry_id": "9f7f6ed2-e1c1-35d1-ad2b-376960c9a2f7",
                                        "glosses": [
                                            "Alternative form of misstep."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c373110-b162-4956-9b6d-978d12161a2f",
                                                "sense_id": "7f2a1326-c734-3eef-ad01-920544e1cb98",
                                                "text": "One step may shape a character and destiny. If it be a right step, the character and destiny will be rightly shaped. If a wrong step, a mis-step, then the character and destiny will be wrongly shaped.[…]\nOnly one mis-step! What is it? “Why, I only gave way to a little ill-temper,” but see the result! The children observed it. Children are sharp-eyed. They are close watchers. They are quick to mark the mis-step, and they have tenacious memories."
                                            },
                                            {
                                                "example_id": "9f17854f-8be1-4d49-b5dd-a8305fbd397e",
                                                "sense_id": "7f2a1326-c734-3eef-ad01-920544e1cb98",
                                                "text": "Unable to see, they lost their bearings in the dark. The wind edged them to the lip of a 7,000ft drop down the Kangshung Face. “One mis-step here and it was a one-way ticket to Tibet,” Fox said."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
