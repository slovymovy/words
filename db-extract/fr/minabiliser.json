                "senses": [
                    {
                        "sense_id": "020f1bc6-e944-3de8-b8f8-a01888755323",
                        "entry_id": "3eeadac9-4207-3ac3-b20d-9797ad8ef158",
                        "glosses": [
                            "Donner un caractère minable à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3cff1a65-4af8-467a-bf00-70f09b4b4312",
                                "sense_id": "020f1bc6-e944-3de8-b8f8-a01888755323",
                                "text": "On cherche à choquer, à prendre en défaut, à \"minabiliser\" et à dénoncer comme étant étriqué tous ce qui a fait la pensée d'avant 1960."
                            },
                            {
                                "example_id": "f014a848-871d-497c-806a-1308f97ffffa",
                                "sense_id": "020f1bc6-e944-3de8-b8f8-a01888755323",
                                "text": "En plus, on ne revient pas avec une identité trollienne (copyright Moi-Même) pour minabiliser (copyright Moi-Même) les pauvres gens qui n'ont pas trouvé leur voie."
                            },
                            {
                                "example_id": "05910146-2b29-46fd-bf5f-88463898a378",
                                "sense_id": "020f1bc6-e944-3de8-b8f8-a01888755323",
                                "text": "Ce syndrome consiste en l'aveu de se croire obligé de se minabiliser dans les médias médiocres pour faire exister une pensée non médiocre."
                            }
                        ]
                    }
                ],
