                "senses": [
                    {
                        "sense_id": "c576b79a-5c8c-3ffe-87f9-b9b9bb4e6501",
                        "entry_id": "fd46b199-4991-3bae-8cba-72c325b077ce",
                        "glosses": [
                            "Gaz innervant, neurotoxique, développé par l’Union soviétique dans les années 1970 et 1980."
                        ],
                        "tags": [
                            "Armement"
                        ],
                        "examples": [
                            {
                                "example_id": "4076db07-afbb-499c-8bc5-f316d0e7e3aa",
                                "sense_id": "c576b79a-5c8c-3ffe-87f9-b9b9bb4e6501",
                                "text": "Et il se trouve qu’ils ont été contaminés par le même poison que l’ex-espion russe : le Novitchok, un neurotoxique russe particulièrement dangereux. Depuis, la femme en est morte tandis que l’homme a repris conscience."
                            },
                            {
                                "example_id": "c611c655-a19a-43a4-a57c-f741851c62c9",
                                "sense_id": "c576b79a-5c8c-3ffe-87f9-b9b9bb4e6501",
                                "text": "2020 : le principal opposant russe Alexeï Navalny est victime d’un empoisonnement par un agent neurotoxique de type Novitchok."
                            },
                            {
                                "example_id": "750bee4f-3f16-41f6-853a-3953c38593e9",
                                "sense_id": "c576b79a-5c8c-3ffe-87f9-b9b9bb4e6501",
                                "text": "Le projet de loi ajouterait les novitchoks, des agents neurotoxiques, à la liste des produits chimiques interdits."
                            }
                        ]
                    },
                    {
                        "sense_id": "56ed3789-eaee-3c2c-bab5-e7a434c8da3a",
                        "entry_id": "fd46b199-4991-3bae-8cba-72c325b077ce",
                        "glosses": [
                            "Grade de novice en sambo."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4c4547d6-7a17-496d-9c21-e49ec71c3c21",
                        "source_entry_id": "fd46b199-4991-3bae-8cba-72c325b077ce",
                        "target_lang_word": "novichok",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "novichok",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "54063fc0-ac80-33c6-8846-81ad4f2c5dcd",
                                        "entry_id": "c382c28c-7757-3f6e-aa86-5b6071357a02",
                                        "glosses": [
                                            "Any of a group of deadly organophosphate nerve agents developed by the Soviet Union in the 1970s and 1980s to evade restrictions on chemical weapons."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "295597c5-01fe-4de0-86fc-ba4ccb98943b",
                                                "sense_id": "54063fc0-ac80-33c6-8846-81ad4f2c5dcd",
                                                "text": "Theresa May has identified the nerve agent used in the attack on Sergei and Yulia Skripal in Salisbury as a novichok."
                                            },
                                            {
                                                "example_id": "b92b861e-1b53-4177-aa3f-b937e19d2b37",
                                                "sense_id": "54063fc0-ac80-33c6-8846-81ad4f2c5dcd",
                                                "text": "The poisoning also turned Novichok into something of a Russian calling card."
                                            },
                                            {
                                                "example_id": "503271b2-9e2f-428e-9cd9-b90508b6ba42",
                                                "sense_id": "54063fc0-ac80-33c6-8846-81ad4f2c5dcd",
                                                "text": "Those still fixated on the problem and not the solution will argue that the United States should take no action on the CWC until Russia “comes clean” about the novichok program under the Memorandum of Understanding."
                                            },
                                            {
                                                "example_id": "9b95b8ae-0429-4ad0-a498-602a6255a90f",
                                                "sense_id": "54063fc0-ac80-33c6-8846-81ad4f2c5dcd",
                                                "text": "Novichoks are allegedly the deadliest NAs ever produced and are potentially five to eight times more potent than VX."
                                            },
                                            {
                                                "example_id": "ff2509fe-b2ea-49ca-a708-4cbecaae1c88",
                                                "sense_id": "54063fc0-ac80-33c6-8846-81ad4f2c5dcd",
                                                "text": "In an earlier interview with the Guardian, a Kremlin insider said that “in half a year or a year, novichok will catch up with Prigozhin,” a reference to the 2020 poisoning of opposition leader Alexei Navalny."
                                            },
                                            {
                                                "example_id": "5b21b7c0-0fe0-4a6d-a1d3-a42893cd6d26",
                                                "sense_id": "54063fc0-ac80-33c6-8846-81ad4f2c5dcd",
                                                "text": "A hospital consultant who treated Sergei and Yulia Skripal after they were poisoned with the nerve agent novichok was “gobsmacked” when Yulia woke and began trying to get out of bed four days after the attack."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
