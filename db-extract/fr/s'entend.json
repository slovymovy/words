                        "entry_id": "64ebe805-c785-3bc2-b746-e698cb712705",
                        "glosses": [
                            "Cela s’entend, il faut le comprendre ainsi."
                        ],
                        "tags": [
                            "ellipsis",
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "8c525e55-87a1-4219-b02c-f5a5da717862",
                                "sense_id": "ad297e05-afc7-3a12-bad1-115a0184f483",
                                "text": "Je me ferais couper la main, la gauche s’entend, nà, devant vous, pour vous voir allant et venant, mangeant et flibustant des marchands, comme n’à votre ordinaire…"
                            },
                            {
                                "example_id": "df6cbd8c-f675-4b7c-bf0f-cae07692169c",
                                "sense_id": "ad297e05-afc7-3a12-bad1-115a0184f483",
                                "text": "Plus, j’ai une guitare chez Puget que je désirerais ravoir (la guitare, s’entend)."
                            },
                            {
                                "example_id": "767e2e21-94f4-4993-961b-8dad70b616f4",
                                "sense_id": "ad297e05-afc7-3a12-bad1-115a0184f483",
                                "text": "Monsieur Ghoul Malek est debout au milieu du hall, éléphantesque. Il ressemble à Orson Welles – sans son talent s’entend."
                            }
                        ]
                    }
