                "senses": [
                    {
                        "sense_id": "51335fd2-5194-391d-8100-703a86f435c5",
                        "entry_id": "e0a8d7ed-3717-3c00-ae74-68fa6043926d",
                        "glosses": [
                            "Schreibgehilfe"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "8ffb539f-2970-4eb8-b11d-ca207be9b475",
                                "sense_id": "51335fd2-5194-391d-8100-703a86f435c5",
                                "text": "„Der Pionieraufsatz von Steven Shapin aus dem Jahr 1989, hier erstmals in deutscher Übersetzung zugänglich, lenkte die Aufmerksamkeit auf Mechaniker, Techniker, Assistenten, Familienmitglieder, Gewerbetreibende, Illustratoren, Zeichner und anderen ‚Amanuenses‘ (Handlanger, ursprünglich: Schreiber).“"
                            },
                            {
                                "example_id": "f5eb9bec-27c1-4fee-af5b-1e24bc5181e4",
                                "sense_id": "51335fd2-5194-391d-8100-703a86f435c5",
                                "text": "„Er sucht einen Amanuensis, jemanden, dem er den Text eines Buches diktieren kann, denn bei einem Verkehrsunfall vor vier Jahren in Sri Lanka wurde ihm die linke Gesichtshälfte weggerissen und er erblindete.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "db5f7732-7b91-3cf1-8c03-724df9e10826",
                        "entry_id": "e0a8d7ed-3717-3c00-ae74-68fa6043926d",
                        "glosses": [
                            "Sekretär, Assistent"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "89bc33be-139b-40a1-985c-815a70b42865",
                                "sense_id": "db5f7732-7b91-3cf1-8c03-724df9e10826",
                                "text": "„Vor der ordentlichen Professur trat Mussafia im Jänner 1858 den Dienst in der kaiserlichen Hofbibliothek als Hilfsarbeiter an und stieg im Jahre 1863 zum dritten Amanuensis, im Oktober 1867 zum zweiten Amanuensis der Handschriftenabteilung auf.“"
                            },
                            {
                                "example_id": "7dab44eb-49d1-4d72-952c-fc2675893e65",
                                "sense_id": "db5f7732-7b91-3cf1-8c03-724df9e10826",
                                "text": "„1993 hatte die Universität 487 Professoren, 605 Amanuenses und 35.050 Studierende, darunter 501 Theologen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "66a9314b-0c26-4ecc-8934-3d10829afa68",
                        "source_entry_id": "e0a8d7ed-3717-3c00-ae74-68fa6043926d",
                        "source_sense_id": "51335fd2-5194-391d-8100-703a86f435c5",
                        "source_sense_description": "veraltet: Schreibgehilfe",
                        "target_lang_word": "amanuensis",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "amanuensis",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a5cb862f-7ce3-3a9d-8077-da1c9501a00b",
                                        "entry_id": "2a0d9ef5-3a75-3027-902f-51c931b04705",
                                        "glosses": [
                                            "One employed to take dictation, or copy manuscripts."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a17cbf4-2aa3-4b70-b621-80446a60a4f4",
                                                "sense_id": "a5cb862f-7ce3-3a9d-8077-da1c9501a00b",
                                                "text": "As pay was Lady Anne's object, and poor Georgiana was intended to be the amanuensis, should she be found capable of forming sentences out of disjointed hints, and of wrapping foul facts in clean composition."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0904e717-b68f-373f-bf79-9a5be140df7b",
                                        "entry_id": "2a0d9ef5-3a75-3027-902f-51c931b04705",
                                        "glosses": [
                                            "A clerk, secretary or stenographer, or scribe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14281c4a-4a71-4e8c-b31d-5696f52e4589",
                                                "sense_id": "0904e717-b68f-373f-bf79-9a5be140df7b",
                                                "text": "In consequence of this fashion of authors dictating their works, expedition came to be considered of the utmost importance; it was regarded as the chief accomplishment of an amanuensis; and he alone was considered as perfect in his art, whose pen could equal the rapidity of utterance: […]"
                                            },
                                            {
                                                "example_id": "1c6abc85-5a0d-4c86-90b0-149f507ede2c",
                                                "sense_id": "0904e717-b68f-373f-bf79-9a5be140df7b",
                                                "text": "“[…] We are engaged in a great work, a treatise on our river fortifications, perhaps? But since when did army officers afford the luxury of amanuenses in this simple republic?[…]”"
                                            },
                                            {
                                                "example_id": "c18a926a-3247-402f-bbcf-6b0aa5bab0c5",
                                                "sense_id": "0904e717-b68f-373f-bf79-9a5be140df7b",
                                                "text": "I, his mere amanuensis, am left to do what little I can to keep the institution functioning."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "61d11148-f743-40dc-b5c2-9a7fc497dbcf",
                        "source_entry_id": "e0a8d7ed-3717-3c00-ae74-68fa6043926d",
                        "source_sense_id": "51335fd2-5194-391d-8100-703a86f435c5",
                        "source_sense_description": "veraltet: Schreibgehilfe",
                        "target_lang_word": "secretary",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "secretary",
