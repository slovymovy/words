                "senses": [
                    {
                        "sense_id": "788d8223-7650-3c11-a540-04da3c78933a",
                        "entry_id": "919dc117-0ed6-3185-87e9-6b835fd4d35b",
                        "glosses": [
                            "En Afrique de l'Est, soldat ou policier indigène des empires coloniaux italien, allemand ou britannique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4fee79a1-846a-453f-83bc-76f4227054f3",
                                "sense_id": "788d8223-7650-3c11-a540-04da3c78933a",
                                "text": "Les Italiens recrutèrent dans la population indigène de nombreux auxiliaires, notamment des soldats, les askaris, qui participèrent activement à la guerre en Érythrée."
                            },
                            {
                                "example_id": "ccf96e48-021e-4bed-bdd5-069ac280deb9",
                                "sense_id": "788d8223-7650-3c11-a540-04da3c78933a",
                                "text": "Tandis que je regagne la modeste auberge grecque où je prends pension, un askari de la douane au tarbouche à bande verte me court après, envoyé d’urgence par le « chef », qui veut me parler."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "52302bbc-faab-46a6-90a1-de737a24595e",
                        "source_entry_id": "919dc117-0ed6-3185-87e9-6b835fd4d35b",
                        "source_sense_id": "788d8223-7650-3c11-a540-04da3c78933a",
