{
    "word_family": [
        "contentment",
        "contented",
        "discontent",
        "discontented"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8f80c8d5-d9ae-386b-8f7a-bc83466016e9",
                    "sense_definition": "The things that are held or included inside a container, room, or document.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "contained_sense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She emptied the <w>contents</w> of her bag onto the table to find her keys.",
                            "target_lang_translations": {
                                "ru": "Она высыпала <w>содержимое</w> своей сумки на стол, чтобы найти ключи.",
                                "zh": "她把包里的<w>内容物</w>倒在桌上找钥匙。"
                            }
                        },
                        {
                            "text": "You can check the table of <w>contents</w> to locate the correct chapter.",
                            "target_lang_translations": {
                                "ru": "Вы можете свериться с <w>оглавлением</w>, чтобы найти нужную главу.",
                                "zh": "你可以查看<w>目录</w>来找到正确的章节。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "table of contents",
                        "contents of"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "usually plural"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вещи, находящиеся внутри контейнера, комнаты или документа.",
                        "zh": "指容器、房间或文档内所包含的东西。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "содержи́мое",
                                "target_lang_sense_clarification": "то, что находится внутри чего-либо"
                            },
                            {
                                "target_lang_word": "содержа́ние",
                                "target_lang_sense_clarification": "суть текста или оглавление"
                            },
                            {
                                "target_lang_word": "оглавле́ние",
                                "target_lang_sense_clarification": "список глав в книге"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "内容",
                                "target_lang_sense_clarification": "指文档或书本中所包含的信息"
                            },
                            {
                                "target_lang_word": "目录",
                                "target_lang_sense_clarification": "指书本开头的章节列表"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6ecdd73c-6b37-3485-9db2-fd1d5ec568f5",
                    "sense_definition": "Information, ideas, or creative material produced for a medium, such as a website, book, or speech.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "contained_sense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The website updates its <w>content</w> every day to keep readers interested.",
                            "target_lang_translations": {
                                "ru": "Сайт обновляет свой <w>контент</w> каждый день, чтобы поддерживать интерес читателей.",
                                "zh": "该网站每天更新其<w>内容</w>以保持读者的兴趣。"
                            }
                        },
                        {
                            "text": "Parents should monitor the online <w>content</w> that their children access.",
                            "target_lang_translations": {
                                "ru": "Родители должны контролировать онлайн-<w>контент</w>, к которому получают доступ их дети.",
                                "zh": "家长应该监控孩子接触到的网络<w>内容</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "material",
                        "subject matter",
                        "information"
                    ],
                    "common_phrases": [
                        "digital content",
                        "create content",
                        "content creator",
                        "adult content"
                    ],
                    "target_lang_definitions": {
                        "ru": "Информация, идеи или материалы, созданные для веб-сайта, книги или СМИ.",
                        "zh": "为媒体（如网站、书籍或演讲）制作的信息、创意或创作素材。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "конте́нт",
                                "target_lang_sense_clarification": "информационное наполнение ресурса"
                            },
                            {
                                "target_lang_word": "содержа́ние",
                                "target_lang_sense_clarification": "суть или тема произведения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "内容",
                                "target_lang_sense_clarification": "指媒体或网站上的信息素材"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "33624dc3-f800-3e0a-9dd2-2ec804187c80",
                    "sense_definition": "The amount of a particular substance that is contained within something.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "contained_sense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dark chocolate usually has a higher cocoa <w>content</w> than milk chocolate.",
                            "target_lang_translations": {
                                "ru": "В тёмном шоколаде обычно более высокое <w>содержание</w> какао, чем в молочном.",
                                "zh": "黑巧克力的可可<w>含量</w>通常比牛奶巧克力高。"
                            }
                        },
                        {
                            "text": "The police officer measured the alcohol <w>content</w> in the driver's blood.",
                            "target_lang_translations": {
                                "ru": "Полицейский измерил <w>содержание</w> алкоголя в крови водителя.",
                                "zh": "警察测量了司机血液中的酒精<w>含量</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "proportion",
                        "level"
                    ],
                    "common_phrases": [
                        "high content",
                        "alcohol content",
                        "fat content",
                        "moisture content"
                    ],
                    "target_lang_definitions": {
                        "ru": "Количество определённого вещества, содержащегося в чём-либо.",
                        "zh": "某物中所含特定物质的量。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "содержа́ние",
                                "target_lang_sense_clarification": "доля вещества в составе"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "含量",
                                "target_lang_sense_clarification": "指物质在成分中的比例"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c2077351-1032-3b9c-b5d2-c6f477ef905c",
                    "sense_definition": "A state of peaceful happiness and satisfaction.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "satisfaction_sense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children played in the park to their hearts' <w>content</w>.",
                            "target_lang_translations": {
                                "ru": "Дети играли в парке <w>вволю</w>.",
                                "zh": "孩子们在公园里玩得<w>尽兴</w>。"
                            }
                        },
                        {
                            "text": "He sighed with <w>content</w> as he sat down in his favorite armchair.",
                            "target_lang_translations": {
                                "ru": "Он вздохнул с <w>удовлетворением</w>, садясь в своё любимое кресло.",
                                "zh": "他坐在最喜欢的扶手椅上，<w>满足</w>地叹了口气。"
                            }
                        }
                    ],
                    "synonyms": [
                        "satisfaction",
                        "contentment",
                        "happiness"
                    ],
                    "antonyms": [
                        "discontent",
                        "unhappiness"
                    ],
                    "common_phrases": [
                        "to one's heart's content"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "mostly used in the phrase 'to one's heart's content'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние спокойного счастья и удовлетворения.",
                        "zh": "一种平静的幸福感和满足感。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "удовлетворе́ние",
                                "target_lang_sense_clarification": "чувство радости от исполнения желаний"
                            },
                            {
                                "target_lang_word": "дово́льство",
                                "target_lang_sense_clarification": "состояние благополучия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "满足",
                                "target_lang_sense_clarification": "指心理上的充实感"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "391d8dc6-2ed7-3cb3-924e-380a8fc1e4d5",
                    "sense_definition": "Feeling or showing satisfaction with one's situation, possessions, or life; not desiring more.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "satisfaction_sense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was perfectly <w>content</w> with his simple life in the countryside.",
                            "target_lang_translations": {
                                "ru": "Он был совершенно <w>доволен</w> своей простой жизнью в деревне.",
                                "zh": "他对自己在乡下的简单生活感到非常<w>满足</w>。"
                            }
                        },
                        {
                            "text": "She seemed <w>content</w> to sit by the window and watch the rain fall.",
                            "target_lang_translations": {
                                "ru": "Она казалась <w>довольной</w>, сидя у окна и наблюдая за дождём.",
                                "zh": "她似乎很<w>满足</w>于坐在窗边看雨。"
                            }
                        }
                    ],
                    "synonyms": [
                        "satisfied",
                        "pleased",
                        "happy",
                        "contented"
                    ],
                    "antonyms": [
                        "dissatisfied",
                        "discontented",
                        "unhappy"
                    ],
                    "common_phrases": [
                        "content with",
                        "feel content",
                        "seem content"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувствующий удовлетворение от своей ситуации или жизни; не желающий большего.",
                        "zh": "对自己的处境、财产或生活感到满意；不渴望更多。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дово́льный",
                                "target_lang_sense_clarification": "испытывающий удовлетворение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "满足",
                                "target_lang_sense_clarification": "形容对现状感到满意"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bd0233c8-e0e2-3234-8aec-5e5717da9c7b",
                    "sense_definition": "To accept something that is sufficient even if not exactly what was desired; to satisfy oneself with a limit.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "satisfaction_sense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Since we could not afford a luxury hotel, we had to <w>content</w> ourselves with a small motel.",
                            "target_lang_translations": {
                                "ru": "Так как мы не могли позволить себе роскошный отель, нам пришлось <w>довольствоваться</w> маленьким мотелем.",
                                "zh": "因为我们住不起豪华酒店，只好<w>满足于</w>一家小汽车旅馆。"
                            }
                        },
                        {
                            "text": "He is ambitious and will not <w>content</w> himself with a minor role in the company.",
                            "target_lang_translations": {
                                "ru": "Он амбициозен и не будет <w>довольствоваться</w> второстепенной ролью в компании.",
                                "zh": "他很有野心，不会<w>满足于</w>在公司里担任一个小角色。"
                            }
                        }
                    ],
                    "synonyms": [
                        "satisfy",
                        "appease"
                    ],
                    "common_phrases": [
                        "content oneself with"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often reflexive"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Принять что-то достаточное, даже если это не совсем то, что хотелось; ограничиться.",
                        "zh": "接受虽然不完全如愿但已足够的事物；限制自己。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дово́льствоваться",
                                "target_lang_sense_clarification": "ограничиваться имеющимся"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "满足于",
                                "target_lang_sense_clarification": "指接受现状或有限的选择"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}