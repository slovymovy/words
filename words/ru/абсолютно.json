                    "sense_definition": "Краткая форма среднего рода прилагательного <w>абсолютный</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Это требование <w>абсолютно</w> и не подлежит обсуждению.",
                            "target_lang_translations": {
                                "en": "This requirement is <w>absolute</w> and not subject to discussion.",
                                "cs": "Tento požadavek je <w>absolutní</w> a nepodléhá diskuzi.",
                                "zh": "这项要求是<w>绝对</w>的，不容商量。"
                            }
                        },
                        {
                            "text": "Зло в этом романе <w>абсолютно</w> и безнаказанно.",
                            "target_lang_translations": {
                                "en": "The evil in this novel is <w>absolute</w> and unpunished.",
                                "cs": "Zlo v tomto románu je <w>absolutní</w> a nepotrestané.",
                                "zh": "这部小说里的邪恶是<w>绝对</w>的，且未受到惩罚。"
                            }
