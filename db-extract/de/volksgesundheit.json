                "senses": [
                    {
                        "sense_id": "b7f55e60-851f-3e1d-8053-7efefb1c9cb5",
                        "entry_id": "18b42ac5-dcec-3a12-a716-f6bbbe0dcadf",
                        "glosses": [
                            "physische und psychische Gesundheit bezogen auf die gesamte Bevölkerung eines Staates"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34b87f2c-8971-40d3-8d20-cd847303be87",
                                "sense_id": "b7f55e60-851f-3e1d-8053-7efefb1c9cb5",
                                "text": "„Die Epidemiologie untersucht somit jene Faktoren, die zu Gesundheit und Krankheit von Individuen und Populationen beitragen und ist deshalb die Basis aller Maßnahmen, die im Interesse der Volksgesundheit unternommen werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b58e876a-490f-46e1-a601-8d2c4231d2be",
                        "source_entry_id": "18b42ac5-dcec-3a12-a716-f6bbbe0dcadf",
                        "source_sense_id": "b7f55e60-851f-3e1d-8053-7efefb1c9cb5",
                        "source_sense_description": "physische und psychische Gesundheit bezogen auf die gesamte Bevölkerung eines Staates",
                        "target_lang_word": "public health",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "public health",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "760e3ed2-f64e-31bc-a0ff-210170a3ea24",
                                        "entry_id": "3d9451da-dd68-3cc3-98f9-55f76b2da81f",
                                        "glosses": [
                                            "The science and practice of community hygiene, which includes preventive healthcare, health education, sanitation and environmental safety."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd2b1c0b-8a03-43d0-9ed4-72cee811c582",
                                                "sense_id": "760e3ed2-f64e-31bc-a0ff-210170a3ea24",
                                                "text": "Pollution was no longer considered an isolated problem to be hashed out between individuals. Instead, it was treated as a menace to public health and the economy."
                                            },
                                            {
                                                "example_id": "1e2718e3-2b34-4535-8383-0a9508e2ee7c",
                                                "sense_id": "760e3ed2-f64e-31bc-a0ff-210170a3ea24",
                                                "text": "My parents are both in public health now. They both work at the Tucson AIDS Project. I've got a sister who's a nurse, another one who works in a hospital, […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7b84d472-c289-40da-bd4d-c15c8f82b806",
                        "source_entry_id": "18b42ac5-dcec-3a12-a716-f6bbbe0dcadf",
                        "source_sense_id": "b7f55e60-851f-3e1d-8053-7efefb1c9cb5",
                        "source_sense_description": "physische und psychische Gesundheit bezogen auf die gesamte Bevölkerung eines Staates",
                        "target_lang_word": "santé publique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "santé publique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "465de9a5-b868-3703-b7b1-7a088b5ab1eb",
                                        "entry_id": "17445ae9-4142-3ede-b477-b1463c9cf53d",
                                        "glosses": [
                                            "Niveau général de la santé d’une population."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef5fb935-abd5-4018-b3f1-5e10538f26f6",
                                                "sense_id": "465de9a5-b868-3703-b7b1-7a088b5ab1eb",
                                                "text": "Toute décision de refus d’entrée doit être proportionnée et non discriminatoire. Une mesure est considérée comme proportionnée à condition qu’elle ait été prise après consultation des autorités sanitaires et qu’elle ait été jugée appropriée et nécessaire pour atteindre l’objectif de santé publique."
                                            },
                                            {
                                                "example_id": "16186e50-ac09-45dd-a676-5161d19c88ec",
                                                "sense_id": "465de9a5-b868-3703-b7b1-7a088b5ab1eb",
                                                "text": "La catastrophe à la centrale nucléaire a mis la santé publique en danger."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a59ed193-77fc-3ee2-9ea1-a23ea63c3fc0",
                                        "entry_id": "17445ae9-4142-3ede-b477-b1463c9cf53d",
                                        "glosses": [
                                            "Activité médicale axée sur la prévention de la maladie, la prolongation de la durée de vie et la préservation de la santé par des mesures collectives."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5634649e-7c33-4579-adc6-d15ab4977945",
                                                "sense_id": "a59ed193-77fc-3ee2-9ea1-a23ea63c3fc0",
                                                "text": "En Écosse, à Édimbourg, la première chaire de santé publique fut attribuée, en 1795, à Andrew Duncan : celui-ci définissait la santé publique comme l’application des connaissances des différentes branches du savoir médical à la promotion, la préservation et la restauration de la santé en général."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
