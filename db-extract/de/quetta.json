                ],
                "senses": [
                    {
                        "sense_id": "d750e162-6d5b-31b7-be7f-533ddd0f564f",
                        "entry_id": "ad40a217-5848-3e8c-921a-4ee8c3dcaa44",
                        "glosses": [
                            "Hauptstadt der pakistanischen Provinz Belutschistan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b89a522-df83-4461-b8c9-f78f7e3fcb25",
                                "sense_id": "d750e162-6d5b-31b7-be7f-533ddd0f564f",
                                "text": "„Infolge einer anhaltenden Welle der Gewalt gegen Hazaras (v.a. Bombenattentate auf Moscheen und belebte Plätze) in Quetta in den letzten Jahren wandern diejenigen, die es sich leisten können, wieder ins Ausland ab, vor allem nach Australien.“"
                            },
                            {
                                "example_id": "57746f4c-9681-43b1-bb3b-552373140fbc",
                                "sense_id": "d750e162-6d5b-31b7-be7f-533ddd0f564f",
                                "text": "„Dieser Zug erreichte, über Quetta kommend, am 25. April 1839 Kandahar, am 21. Juli Ghazni und schließlich am 7. August Kabul, ohne dass seinem Vordringen nennenswerte Gegenwehr entgegengesetzt wurde.“"
                            },
                            {
                                "example_id": "bc603437-b9c1-4709-814f-4a62e2e6a169",
                                "sense_id": "d750e162-6d5b-31b7-be7f-533ddd0f564f",
                                "text": "„Auf Buchwalds Laptop haben wir eine Kontonummer für eine Bank in Quetta gefunden.“"
                            },
                            {
                                "example_id": "933b590f-bb82-4f25-9ce0-d42d4d314351",
                                "sense_id": "d750e162-6d5b-31b7-be7f-533ddd0f564f",
                                "text": "„Der beste Ort, um mit diesen besonderen Teufeln zu speisen, war ihre Geburtsstätte und Heimat in Quetta, der an der westlichen Landesgrenze gelegenen Hauptstadt von Belutschistan.“"
                            },
                            {
                                "example_id": "0de4cb3d-ea22-4ac9-b3f0-4688b4ef41f2",
                                "sense_id": "d750e162-6d5b-31b7-be7f-533ddd0f564f",
                                "text": "„Er brauchte einen sicheren Ort. Einen Ort, an dem das Flugzeug lange genug bleiben konnte, um sich etwas auszuruhen. ›Quetta!‹“"
                            },
                            {
                                "example_id": "91aa3075-08f7-4b22-b128-ac8b84591317",
                                "sense_id": "d750e162-6d5b-31b7-be7f-533ddd0f564f",
                                "text": "„Infolgedessen war für einen verwundeten Mudschahedin in Kandahar die nächstgelegene medizinische Anlaufstelle das pakistanische Quetta, was einen knochenharten zweitägigen Ritt auf dem Kamel bedeutete.“"
                            },
                            {
                                "example_id": "6c285ec3-ea5b-4033-9a57-bf8eff80cf18",
                                "sense_id": "d750e162-6d5b-31b7-be7f-533ddd0f564f",
                                "text": "„Er hat eine klassische Soldatenkarriere durchlaufen. Ist in Rawalpindi aufgewachsen, auf die Militärakademie gegangen, dann aufs Befehls- und Stabscollege in Quetta.“"
                            },
                            {
                                "example_id": "20495e57-e75d-44b7-8d21-6398d201c670",
                                "sense_id": "d750e162-6d5b-31b7-be7f-533ddd0f564f",
                                "text": "„›Es war 2004. In Quetta. Pakistan.‹“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
