                    ],
                    "synonyms": [
                        "jockstrap",
                        "supporter"
                    ],
                    "target_lang_definitions": {
                        "tr": "Destekleyici sargı, kayış veya koruyucu sporcu iç çamaşırı (suspenuar)."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "suspenuar",
                                "target_lang_sense_clarification": "koruyucu medikal/sporcu bağı"
                            },
                            {
                                "target_lang_word": "hayalık",
                                "target_lang_sense_clarification": "destekleyici sargı"
                            }
                        ]
                    }
                }
            ]
        }
    ]
