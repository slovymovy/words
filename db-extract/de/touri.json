                "senses": [
                    {
                        "sense_id": "967bd9e3-4b57-35f8-a567-82e54df6c571",
                        "entry_id": "b2f83ccf-e17b-3810-9f66-89893685db0c",
                        "glosses": [
                            "Person, die zu ihrem Vergnügen reist"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "cc148a4d-a6e8-4356-ba8b-7d690d25265f",
                                "sense_id": "967bd9e3-4b57-35f8-a567-82e54df6c571",
                                "text": "„Da geht die Party ab, bis spät nachts hört man die vielen Strandbars und Discos die zahllosen alkoholisierten europäischen Touris beschallen und fragt sich, wie viele am Ende des Abends mit einer kleinen, exotischen thailändischen Schönheit zurückkehren ins Hotel.“"
                            },
                            {
                                "example_id": "c9cca570-33b3-4ea7-a42b-d515c6d25c68",
                                "sense_id": "967bd9e3-4b57-35f8-a567-82e54df6c571",
                                "text": "„Im kalifornischen La Jolla reißen sich die Touris darum, mit den Tieren zu schwimmen.“"
                            },
                            {
                                "example_id": "a5b1fb9a-1a75-4fa0-8339-50e326a4b393",
                                "sense_id": "967bd9e3-4b57-35f8-a567-82e54df6c571",
                                "text": "„Der Unterschied aber: Statt Touris bestellen hier fast nur Einheimische, sagt das Paar.“"
                            },
                            {
                                "example_id": "514cd837-5a12-45eb-8044-d075bb3db872",
                                "sense_id": "967bd9e3-4b57-35f8-a567-82e54df6c571",
                                "text": "„Derweil Du als Selbstfahrer oder transportierter Touri in jede entfernte Landesecke kommst, gibt’s zum Glück noch Flecken, wo kein Flugzeug landen und keine bleddy Tjorrie rumgurken kann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
