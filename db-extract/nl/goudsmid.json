                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3508100-cd15-49b9-88b3-5784746dc9ab",
                                                "sense_id": "163449d1-5b72-3801-93e1-de9fddee0c63",
                                                "text": "Der Goldschmied Meier zeigte den Goldschläger Müller wegen Körperverletzung an."
                                            },
                                            {
                                                "example_id": "7c1ee091-2475-4845-a539-0515f8e43b0a",
                                                "sense_id": "163449d1-5b72-3801-93e1-de9fddee0c63",
                                                "text": "Der Goldschmied fertigt die Hochzeitringe."
                                            },
                                            {
                                                "example_id": "a3ef8d1b-856f-4eb5-91d2-09ad69462fdd",
                                                "sense_id": "163449d1-5b72-3801-93e1-de9fddee0c63",
                                                "text": "„Ein geschickter Goldschmied aus Venedig machte mir den Ring meisterhaft.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7388ddd6-c190-3994-85b7-ec7512174b3d",
                                        "entry_id": "d0abca91-4443-376c-9a15-163aa0354d87",
                                        "glosses": [
                                            "ein grün glänzender Laufkäfer aus der Gattung Carabus"
                                        ],
                                        "tags": [
                                            "Entomologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "552e9113-3113-4a49-aa88-f8b2c2a7be94",
                                                "sense_id": "7388ddd6-c190-3994-85b7-ec7512174b3d",
                                                "text": "Der Goldschmied jagt vor allem Schnecken und Würmer."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
