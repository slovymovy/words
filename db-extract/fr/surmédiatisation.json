                "senses": [
                    {
                        "sense_id": "db2b6060-6a4e-35a1-b41c-8a7411949054",
                        "entry_id": "f08f050d-ff6c-394d-81b7-1b8d7124fca5",
                        "glosses": [
                            "Médiatisation excessive par rapport à l'importance relative du sujet."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b13c62a6-c3ad-4238-9058-683e5e1c4d4a",
                                "sense_id": "db2b6060-6a4e-35a1-b41c-8a7411949054",
                                "text": "La surmédiatisation de la grippe porcine est une dérive des médias."
                            },
                            {
                                "example_id": "60eadbfb-98ec-4ea4-8e3d-19e3ac3fc07d",
                                "sense_id": "db2b6060-6a4e-35a1-b41c-8a7411949054",
                                "text": "La surmédiatisation d'événements graves à l'échelle du monde perturbe les consciences."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4a5830c3-8352-43bf-98ff-326221d7561c",
                        "source_entry_id": "f08f050d-ff6c-394d-81b7-1b8d7124fca5",
                        "source_sense_id": "db2b6060-6a4e-35a1-b41c-8a7411949054",
                        "target_lang_word": "Medienrummel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Medienrummel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bba6554f-db63-306f-9733-4f915d39cd16",
                                        "entry_id": "5fb7ed34-954f-3d6c-9b48-797c626d8c67",
                                        "glosses": [
                                            "großes Aufheben, das von den Medien um etwas gemacht wird"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c7f7e501-a0d0-42d6-85a2-25017f4d6f74",
                                                "sense_id": "bba6554f-db63-306f-9733-4f915d39cd16",
                                                "text": "„Der Medienrummel um die Autobombe kam gerade erst richtig in Fahrt, und Ferris befürchtete, dass Hani irgendetwas tun könnte, was das Netz, das sie so mühselig gesponnen hatten, an einer entscheidenden Stelle zum Reißen brachte.“"
                                            },
                                            {
                                                "example_id": "b6026913-8b2d-479e-9793-4d2b7284a444",
                                                "sense_id": "bba6554f-db63-306f-9733-4f915d39cd16",
                                                "text": "„Nun reiste Tim Blackman nach Japan, was einen riesigen Medienrummel zur Folge hatte.“"
                                            },
                                            {
                                                "example_id": "428e4675-7ac4-4c2b-a795-f014f9fcb791",
                                                "sense_id": "bba6554f-db63-306f-9733-4f915d39cd16",
                                                "text": "„›Auf uns wartet unerträglicher Druck und wochenlanger Medienrummel.‹“"
                                            },
                                            {
                                                "example_id": "b4cdee1f-1ba7-4113-b923-5acc2f4d9671",
                                                "sense_id": "bba6554f-db63-306f-9733-4f915d39cd16",
                                                "text": "„Er entzieht sich dem Gefängnis, der Verantwortung, entzieht sich dem Medienrummel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9b1168dd-532c-4325-849f-9030f97212ae",
                        "source_entry_id": "f08f050d-ff6c-394d-81b7-1b8d7124fca5",
                        "source_sense_id": "db2b6060-6a4e-35a1-b41c-8a7411949054",
                        "target_lang_word": "hype",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hype",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "97d416a7-ec25-33e2-8703-eb80e71a9e5d",
                                        "entry_id": "80638c0b-9fa8-30ef-93ac-ed45a6d399b9",
                                        "glosses": [
                                            "Promotion or propaganda, especially exaggerated claims."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a126c95e-7423-40a3-a797-f65bfe562c43",
                                                "sense_id": "97d416a7-ec25-33e2-8703-eb80e71a9e5d",
                                                "text": "After all the hype for the diet plan, only the results ended up slim."
                                            },
                                            {
                                                "example_id": "2d09b9e8-5980-478e-9cfe-f04bf3a12d0b",
                                                "sense_id": "97d416a7-ec25-33e2-8703-eb80e71a9e5d",
                                                "text": "Don't believe the hype, it's a sequel / As an equal can I get this through to you"
                                            },
                                            {
                                                "example_id": "8b6131da-dbee-4859-8a38-345d4af791ef",
                                                "sense_id": "97d416a7-ec25-33e2-8703-eb80e71a9e5d",
                                                "text": "I was never one to believe the hype\nSave that for the black and white"
                                            },
                                            {
                                                "example_id": "abe9841c-a262-42bc-9090-a3667c43001c",
                                                "sense_id": "97d416a7-ec25-33e2-8703-eb80e71a9e5d",
                                                "text": "The first Grand Slam showpiece between the two dominant players on the ATP Tour had been a tantalising prospect - and it surpassed the hype."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hype",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "80fc5e62-35f8-3212-b17b-67d4824a0d96",
                                        "entry_id": "290ab517-82d5-349c-a748-048a916ac270",
                                        "glosses": [
                                            "To promote heavily; to advertise or build up."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e1722602-a3c0-4db3-b560-de15de1f8e96",
                                                "sense_id": "80fc5e62-35f8-3212-b17b-67d4824a0d96",
                                                "text": "They started hyping the new magazine months before its release."
                                            },
                                            {
                                                "example_id": "b959ca4d-abcf-4748-ab09-aa7cb585a87d",
                                                "sense_id": "80fc5e62-35f8-3212-b17b-67d4824a0d96",
                                                "text": "Hydrogen fuel cells are hugely hyped but have yet to prove themselves in the real world beyond a few limited trials or small fleets on the European mainland."
                                            }
                                        ]
                                    }
                                ]
                            },
