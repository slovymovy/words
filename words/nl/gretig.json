{
    "word_family": [
        "gretigheid",
        "begeren"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "69c6950b-aaaa-32cc-bbae-b5c76f48f541",
                    "sense_definition": "met veel enthousiasme of verlangen uitziend naar iets",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "verlangen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De jonge voetballer was erg <w>gretig</w> om zijn eerste doelpunt voor de club te scoren.",
                            "target_lang_translations": {
                                "en": "The young footballer was very <w>eager</w> to score his first goal for the club."
                            }
                        },
                        {
                            "text": "Zijn <w>gretige</w> reactie op het nieuwe voorstel verbaasde veel van zijn collega's op kantoor.",
                            "target_lang_translations": {
                                "en": "His <w>keen</w> response to the new proposal surprised many of his colleagues at the office."
                            }
                        }
                    ],
                    "synonyms": [
                        "begerig",
                        "enthousiast"
                    ],
                    "antonyms": [
                        "onverschillig"
                    ],
                    "common_phrases": [
                        "gretige reactie",
                        "gretig aftrek vinden"
                    ],
                    "target_lang_definitions": {
                        "en": "looking forward to something with great enthusiasm or desire"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "eager",
                                "target_lang_sense_clarification": "showing keen interest or desire"
                            },
                            {
                                "target_lang_word": "keen",
                                "target_lang_sense_clarification": "enthusiastic and willing"
                            },
                            {
                                "target_lang_word": "greedy",
                                "target_lang_sense_clarification": "having an excessive desire for something"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "f8005f23-f3ad-3a3d-b3aa-981027ae7524",
                    "sense_definition": "op een manier die laat zien dat je erg veel honger of dorst hebt",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "consumptie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De uitgehongerde hond begon <w>gretig</w> te eten zodra de bak op de grond stond.",
                            "target_lang_translations": {
                                "en": "The starving dog began to eat <w>greedily</w> as soon as the bowl was placed on the ground."
                            }
                        },
                        {
                            "text": "Na de lange wandeling in de hitte dronk hij <w>gretig</w> van het koude water.",
                            "target_lang_translations": {
                                "en": "After the long walk in the heat, he drank <w>eagerly</w> from the cold water."
                            }
                        }
                    ],
                    "synonyms": [
                        "begerig"
                    ],
                    "common_phrases": [
                        "gretig eten",
                        "gretig drinken"
                    ],
                    "target_lang_definitions": {
                        "en": "in a way that shows you are very hungry or thirsty"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "eagerly",
                                "target_lang_sense_clarification": "with great interest or enthusiasm"
                            },
                            {
                                "target_lang_word": "greedily",
                                "target_lang_sense_clarification": "in a way that shows a strong desire for food or drink"
                            },
                            {
                                "target_lang_word": "voraciously",
                                "target_lang_sense_clarification": "with great hunger or appetite"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}
