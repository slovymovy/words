                    }
                ],
                "senses": [
                    {
                        "sense_id": "12fcb811-da18-3b99-83de-a6a689652318",
                        "entry_id": "76946cd4-90e1-336a-b3d9-38cae854c4c0",
                        "glosses": [
                            "Qui est atteint de trisomie 21."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "191f8865-694f-37da-adfe-d85ab54bb241",
                        "entry_id": "76946cd4-90e1-336a-b3d9-38cae854c4c0",
                        "glosses": [
                            "Qui est idiot."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6e90cd8a-1e81-4277-8cba-a014c6c371c5",
                        "source_entry_id": "76946cd4-90e1-336a-b3d9-38cae854c4c0",
                        "target_lang_word": "Mongolian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mongolian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d6da683b-2992-3ff3-9493-3a203c0cb80a",
                                        "entry_id": "a4e1956a-cf83-3050-a1ba-3f0cd3c27e82",
                                        "glosses": [
                                            "Of or relating to Mongolia or its peoples, languages, or cultures."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47c43d88-5483-44ca-a550-2ecf0dda9466",
                                                "sense_id": "d6da683b-2992-3ff3-9493-3a203c0cb80a",
                                                "text": "He had a Sister, which according to the Mongalian custom lived in the devoted spiritual state."
                                            },
                                            {
                                                "example_id": "19b09bcc-834e-416e-aef7-dea466d18b5e",
                                                "sense_id": "d6da683b-2992-3ff3-9493-3a203c0cb80a",
                                                "text": "The Mongolian characters...are written perpendicularly from above downward."
                                            },
                                            {
                                                "example_id": "9925d593-ceae-4cf2-9abf-793196073ed3",
                                                "sense_id": "d6da683b-2992-3ff3-9493-3a203c0cb80a",
                                                "text": "He usually had a heavy growth of dark stubble that made him look...rather like a Mongolian bandit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "71f9330e-42bd-3773-8f4a-93d6cda9b6a3",
                                        "entry_id": "a4e1956a-cf83-3050-a1ba-3f0cd3c27e82",
                                        "glosses": [
                                            "Resembling or having some of the characteristic physical features of the mongoloid racial type."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bbc53500-9670-4e5b-9705-1fecb8bf955c",
                                                "sense_id": "71f9330e-42bd-3773-8f4a-93d6cda9b6a3",
                                                "text": "The Mongolian variety inhabits eastern Asia, Finland, and Lapland in Europe, and includes the Esquimaux of North America."
                                            },
                                            {
                                                "example_id": "d204c58e-a269-4531-8600-4a56ed312ad2",
                                                "sense_id": "71f9330e-42bd-3773-8f4a-93d6cda9b6a3",
                                                "text": "The white (or Caucasian), the yellow (or Mongolian), and the black (or Ethiopian)"
                                            },
                                            {
                                                "example_id": "9dfce868-4320-40cb-99a1-04004a1ce5ea",
                                                "sense_id": "71f9330e-42bd-3773-8f4a-93d6cda9b6a3",
                                                "text": "It was not so much their Mongolian features that impressed everyone..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4c3464f8-8a5e-30cf-a72d-bddd578be608",
                                        "entry_id": "a4e1956a-cf83-3050-a1ba-3f0cd3c27e82",
                                        "glosses": [
                                            "Relating to or affected with Down syndrome."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "offensive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c21f848-5e89-425b-8e62-d82f6100be0f",
                                                "sense_id": "4c3464f8-8a5e-30cf-a72d-bddd578be608",
                                                "text": "The Mongolian type of idiocy occurs in more than ten per cent. of the cases which are presented to me."
                                            },
                                            {
                                                "example_id": "1a5fd2b7-e2e4-4638-906c-1d704fbf3b9e",
                                                "sense_id": "4c3464f8-8a5e-30cf-a72d-bddd578be608",
                                                "text": "The condition known as trisomy 21 syndrome or mongolian idiocy (sometimes referred to as Down's syndrome) had long been an enigma."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Mongolian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "66fe7c67-3e62-3371-a933-a3043942417f",
                                        "entry_id": "401df9c8-cf9d-3bdb-9764-26c580a413a0",
                                        "glosses": [
                                            "A native or inhabitant of Mongolia."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0983ff49-315b-4551-9fbf-72814aac47f1",
                                                "sense_id": "66fe7c67-3e62-3371-a933-a3043942417f",
                                                "text": "The Cossac there, The Calmuc, and Mungalian, round the bales In crowds resort."
                                            },
                                            {
                                                "example_id": "c27e52fd-8424-45ad-a902-2a58b5ba903d",
                                                "sense_id": "66fe7c67-3e62-3371-a933-a3043942417f",
                                                "text": "This day we saw some scattered tents of Mongalians, with their flocks."
                                            },
                                            {
                                                "example_id": "06e763e0-a543-445d-af07-1ca3e994e3ce",
                                                "sense_id": "66fe7c67-3e62-3371-a933-a3043942417f",
                                                "text": "The Mongolians are the most nomadic of populations."
                                            },
                                            {
                                                "example_id": "f64208b2-4f51-4cc6-8f7e-b311225942bd",
                                                "sense_id": "66fe7c67-3e62-3371-a933-a3043942417f",
                                                "text": "Mongolians now regard animal husbandry as a low-status occupation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bcb0c140-ae01-3c86-a25d-c17d796dfc19",
                                        "entry_id": "401df9c8-cf9d-3bdb-9764-26c580a413a0",
                                        "glosses": [
                                            "A group of languages from Mongolia, specifically Khalkha, the official language of Mongolia."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ba2d182-43d8-4269-a748-0c5ec0e0e340",
                                                "sense_id": "bcb0c140-ae01-3c86-a25d-c17d796dfc19",
                                                "text": "Khalka […] Mongolian possesses seven vowels and twenty consonants."
                                            },
                                            {
                                                "example_id": "a1a889be-6159-48b3-870a-d3d45a6b4cc6",
                                                "sense_id": "bcb0c140-ae01-3c86-a25d-c17d796dfc19",
                                                "text": "The Altaic family […] comprises about 40 languages, classified into three groups: Turkic, Mongolian, and Manchu-Tungus."
                                            },
                                            {
                                                "example_id": "4b09b7b6-11e0-4e15-972f-722cdc658e9e",
                                                "sense_id": "bcb0c140-ae01-3c86-a25d-c17d796dfc19",
                                                "text": "These inscriptions are in Mongolian and thus widen the appliqué's international connections."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a9c96410-b4e5-3d4d-bf3c-07570e4dae67",
                                        "entry_id": "401df9c8-cf9d-3bdb-9764-26c580a413a0",
                                        "glosses": [
                                            "A person of the mongoloid physical type."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ffac4b3-2451-4df4-baa2-1d2c2eb1023f",
                                                "sense_id": "a9c96410-b4e5-3d4d-bf3c-07570e4dae67",
                                                "text": "A particular individual which the latter considered a Mongolian and the former assures us is an Ethiopian."
                                            },
                                            {
                                                "example_id": "87a0b257-a60b-408e-9cc7-c72f4bcbce53",
                                                "sense_id": "a9c96410-b4e5-3d4d-bf3c-07570e4dae67",
                                                "text": "She was found to be one of the type of white women whose nasal organs appear never to have been developed, and who take to the loathsome Mongolian and his filthy hovel as blithely as a plague rat to a sewer."
                                            },
                                            {
                                                "example_id": "0e61a49e-a204-4ef6-be93-01aa9bd8e4de",
                                                "sense_id": "a9c96410-b4e5-3d4d-bf3c-07570e4dae67",
                                                "text": "Extreme forms like the Australians, Negroes, Mongolians, and Europeans may be described as races because each has certain characteristics which set them off from other groups, and which are strictly hereditary."
                                            },
                                            {
                                                "example_id": "9afddf43-7370-44d1-8201-163d0c868138",
                                                "sense_id": "a9c96410-b4e5-3d4d-bf3c-07570e4dae67",
                                                "text": "The thesis of this work was that native Americans were one race distinct from Eskimos and Mongolians."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
