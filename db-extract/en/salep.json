                            {
                                "example_id": "30abfb18-3298-459d-9abb-72dee7e78422",
                                "sense_id": "2c66c934-94e2-371f-ba03-3ee172640b36",
                                "text": "Salep was a popular beverage in the lands of the Ottoman Empire. Its consumption spread beyond there to England and Germany before the rise of coffee and tea and it was later offered as an alternative beverage in coffee houses."
