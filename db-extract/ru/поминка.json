                        "glosses": [
                            "устар. то же, что поминок"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cdac70c2-2b56-4a86-a349-a0dd330a74e2",
                                "sense_id": "de325499-9259-3f2d-9860-a44286ff5288",
                                "text": "Поминкой по любимой жене Марфе Тимофеевне остался беспутный Яша…"
                            },
                            {
                                "example_id": "89b9f87f-8852-4f63-9fd7-f884abc1f31c",
                                "sense_id": "de325499-9259-3f2d-9860-a44286ff5288",
                                "text": "Грустно раздается намаз, будто поминка по ясном дне, отлетевшем в вечность."
                            },
                            {
                                "example_id": "557f7529-9f7e-40a7-9e0b-5ab2c4618fec",
                                "sense_id": "de325499-9259-3f2d-9860-a44286ff5288",
                                "text": "— А легка на поминке твоя старая! — улыбаясь уже в открытую, сказал Антип Грач и довольно крякнул."
                            }
                        ]
                    }
