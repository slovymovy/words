                "translations": [
                    {
                        "translation_id": "d9b82c90-7441-4d51-b573-3e56873dbbde",
                        "source_entry_id": "61513c55-9c20-3d5a-82a0-6373409e32f7",
                        "target_lang_word": "intonation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "intonation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "76b68daf-041d-3e6e-93f1-b303c5345abb",
                                        "entry_id": "29c5dbca-dbba-33e3-afe2-736291b62318",
                                        "glosses": [
                                            "The rise and fall of the voice in speaking."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4f4a4d35-872f-3bd4-af61-07958f6ea0c0",
                                        "entry_id": "29c5dbca-dbba-33e3-afe2-736291b62318",
                                        "glosses": [
                                            "Emotive stress used to increase the power of delivery in speech."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4175458e-3778-4a11-bc23-64d38ba4b5b7",
                                                "sense_id": "4f4a4d35-872f-3bd4-af61-07958f6ea0c0",
                                                "text": "She well knew the power of intonation, and thought that, in the absence of the curled lip, the contemptuous twitch of the nose, and the supercilious toss of the head, her message might be acceptable for Louisa's sake,..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b282f5a0-6089-3345-bc1e-1a7d6e7a483c",
                                        "entry_id": "29c5dbca-dbba-33e3-afe2-736291b62318",
                                        "glosses": [
                                            "A sound made by, or resembling that made by, a musical instrument."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b18f382-ce3c-4e0e-bcb7-59d348505f6c",
                                                "sense_id": "b282f5a0-6089-3345-bc1e-1a7d6e7a483c",
                                                "text": "This additional cause of the intonation of thunder, together with the simile with which it is illustrated, is copied from our poet, both by Pliny, Nat. Hist. ii, 431, and Isidorus, Orig. xiii."
                                            },
                                            {
                                                "example_id": "3ed53133-018c-401c-b8c4-8f20f331ee44",
                                                "sense_id": "b282f5a0-6089-3345-bc1e-1a7d6e7a483c",
                                                "text": "As when sulphureous fires, within the caves\nOf earth long pent, with intonation loud\nBurst through the riven rocks, and far as eye\nCan reach their furious devastation spread,\nSo sudden, so resistless was the force\nOf this blasphemer's bold appeal to arms."
                                            },
                                            {
                                                "example_id": "91a7f1d9-20b8-4033-a06f-3c673869d3b8",
                                                "sense_id": "b282f5a0-6089-3345-bc1e-1a7d6e7a483c",
                                                "text": "In anxious expectation stood the crowd,\nWhen the shrill clarion's intonation loud\nGave notice that the challenger drew nigh."
                                            },
                                            {
                                                "example_id": "e0028046-a244-4836-a55d-2a5252bfb22c",
                                                "sense_id": "b282f5a0-6089-3345-bc1e-1a7d6e7a483c",
                                                "text": "but Sir Hugh still exclaimed, —\"Louder, old man, far louder!\" till at last the minstrel, in obedience to his best and dearest friend, struck the harp with such violence, that not only did the strings break, but even the instrument itself burst asunder with a long melancholy intonation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a2c7537e-97c9-319f-865e-688c7982468b",
                                        "entry_id": "29c5dbca-dbba-33e3-afe2-736291b62318",
                                        "glosses": [
                                            "Singing or playing in good tune or otherwise."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ebf17bba-384b-4543-8260-5e7e51166d18",
                                                "sense_id": "a2c7537e-97c9-319f-865e-688c7982468b",
                                                "text": "Her intonation was false."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "675eba1e-6bfc-3fbb-b15e-1646675ee72d",
                                        "entry_id": "29c5dbca-dbba-33e3-afe2-736291b62318",
                                        "glosses": [
                                            "Reciting in a musical prolonged tone; intonating or singing of the opening phrase of a plain-chant, psalm, or canticle by a single voice, as of a priest."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "32c9f14b-e310-45af-9c5d-4885fe722c46",
                        "source_entry_id": "61513c55-9c20-3d5a-82a0-6373409e32f7",
                        "target_lang_word": "intonation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "intonation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d577d251-3adc-33eb-9d58-d65f53d6042c",
                                        "entry_id": "1b9db33c-432c-3ad1-81e1-3236e91ff094",
                                        "glosses": [
                                            "Manière d’attaquer un son, un air."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04ea83aa-6fdd-4e86-8336-c2fc7767ef23",
                                                "sense_id": "d577d251-3adc-33eb-9d58-d65f53d6042c",
                                                "text": "Jamais ni la Malibran, ni la Pasta n'avaient fait entendre des chants si parfaits de sentiment et d'intonation ; […]."
                                            },
                                            {
                                                "example_id": "a416eccb-05c5-4837-9f26-93fb917dc3c4",
                                                "sense_id": "d577d251-3adc-33eb-9d58-d65f53d6042c",
                                                "text": "Et sa voix alors prenait une intonation dolente et uniforme, enflant les mots, appuyant indéfiniment sur les syllabes. Cela m’agaçait beaucoup."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e9600a94-e985-34fe-bdec-26f8cb42bd8a",
                                        "entry_id": "1b9db33c-432c-3ad1-81e1-3236e91ff094",
                                        "glosses": [
                                            "Action de mettre un chant sur le ton dans lequel il doit être, en parlant du plain-chant."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "91f39587-ae48-4286-8912-64788d2bc395",
                                                "sense_id": "e9600a94-e985-34fe-bdec-26f8cb42bd8a",
                                                "text": "L’intonation de ce psaume est de tel ton."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b1ef309-d7ea-3284-913f-d6dc554ae813",
                                        "entry_id": "1b9db33c-432c-3ad1-81e1-3236e91ff094",
                                        "glosses": [
                                            "Justesse d’une note chantée ou jouée."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d61eccd6-ac7e-4efc-960e-d5fb20a254ae",
                                                "sense_id": "0b1ef309-d7ea-3284-913f-d6dc554ae813",
                                                "text": "Tout d’abord, le travail d’intonation gagnera à être toujours associé au travail d’audition"
                                            },
                                            {
                                                "example_id": "e8b6ff6c-b4a1-4dd5-80dd-18f8bf998521",
                                                "sense_id": "0b1ef309-d7ea-3284-913f-d6dc554ae813",
                                                "text": "Mais face à l’évolution du répertoire vocal, nous savons l’importance que revêt la formation musicale des élèves chanteurs notamment en ce qui concerne l’acquisition des réflexes d’intonation"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d979677-3ebb-330e-a57f-370ee93d1026",
                                        "entry_id": "1b9db33c-432c-3ad1-81e1-3236e91ff094",
                                        "glosses": [
                                            "Ton que l’on prend en parlant ou en lisant."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2be7fd5-dbe5-4b56-b043-16018838b16f",
                                                "sense_id": "7d979677-3ebb-330e-a57f-370ee93d1026",
                                                "text": "[…] ; sa voix a des intonations brèves comme si, quand on l’interroge, on la contrariait dans son attente, dans ses calculs secrets ; […]."
                                            },
                                            {
                                                "example_id": "e85f7400-45f3-44e3-8dd8-329294cb0d10",
                                                "sense_id": "7d979677-3ebb-330e-a57f-370ee93d1026",
                                                "text": "— Raconte, nom de Dieu, raconte ! Hein, que je t'imite bien ?\n— C'est ça pour le texte, oui, mais pour l'intonation distinguée, tu repasseras.\n— Raconte nom de Dieu, raconte !\n— C'est mieux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c346b5b6-bde5-3b72-886e-9fa79d523d0f",
                                        "entry_id": "1b9db33c-432c-3ad1-81e1-3236e91ff094",
                                        "glosses": [
                                            "Changement de hauteur de la voix pour signaler l’état d’esprit du locuteur comme une interrogation mais pas pour distinguer des mots comme les tons. Indiqué par ↗ ou ↘."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
