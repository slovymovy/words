                "senses": [
                    {
                        "sense_id": "50dae562-1ffb-3f51-a20d-1335800ad86b",
                        "entry_id": "14b078f4-6fa2-3e90-a5fe-c8f8f516d259",
                        "glosses": [
                            "van glas dat het getint is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74a9f555-8153-4339-8bd3-e09abd6a9f32",
                                "sense_id": "50dae562-1ffb-3f51-a20d-1335800ad86b",
                                "text": "Dat warrige haar, de gefumeerde bril, de paardenkracht in die stem: Bert maakte opnieuw indruk. Alex Callier vond dat ook: ‘Ik heb de Bert gezien op wie ik verliefd werd in de eerste audities.’"
                            },
                            {
                                "example_id": "057cddba-82ab-4e15-ba5f-2c659bcb2e41",
                                "sense_id": "50dae562-1ffb-3f51-a20d-1335800ad86b",
                                "text": "De bewakers krijgen een specifieke opleiding om seksueel misbruik snel te detecteren, gevangenen worden op weerbaarheid getraind. En heb je de douches hier gezien? Aparte ruimtes, gefumeerd glas tegen het gluren... In die privégevangenissen is er geen énkele controle.’"
                            },
                            {
                                "example_id": "cd984734-a766-45c2-9baa-242a382120b7",
                                "sense_id": "50dae562-1ffb-3f51-a20d-1335800ad86b",
                                "text": "Van de monding van de Parelrivier naar de industriële centra aan de Yangtzerivier – zeg van Amsterdam naar Milaan – in minder dan een halve dag. En dan zijn de wachttijden voor de loketten in het nieuwe station van wit marmer en gefumeerd glas in Guangzhou meegerekend."
                            }
                        ]
                    }
