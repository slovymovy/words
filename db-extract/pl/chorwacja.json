                "senses": [
                    {
                        "sense_id": "0c04586e-94dd-32f7-b98a-351b372dfca1",
                        "entry_id": "d81b7025-a8ac-38e9-87ae-73509448c236",
                        "glosses": [
                            "państwo w południowej części Europy ze stolicą w Zagrzebiu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e47cc74-8dfb-4cfe-aeb1-25babc1af3bc",
                                "sense_id": "0c04586e-94dd-32f7-b98a-351b372dfca1",
                                "text": "Ona mieszka w Chorwacji od kilku lat."
                            },
                            {
                                "example_id": "ee658967-60dc-49dc-965a-04a5e32ca203",
                                "sense_id": "0c04586e-94dd-32f7-b98a-351b372dfca1",
                                "text": "Nasi sąsiedzi, państwo Szymańscy, byli w tym roku na wakacjach w Chorwacji."
                            },
                            {
                                "example_id": "480f7cb8-3296-4904-83b7-2cc49c1748e9",
                                "sense_id": "0c04586e-94dd-32f7-b98a-351b372dfca1",
                                "text": "Bośnia i Hercegowina graniczy z Chorwacją, Serbią oraz Czarnogórą."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
