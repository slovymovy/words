                "senses": [
                    {
                        "sense_id": "ebb14fef-9a7f-3cb3-9961-3ad66df14f37",
                        "entry_id": "48d9490c-8f7b-3dc2-a447-028083d35b47",
                        "glosses": [
                            "Kult um als Heilige(r) verehrte Person(en)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90ac7918-c2e7-45d4-b98a-61cad66356da",
                                "sense_id": "ebb14fef-9a7f-3cb3-9961-3ad66df14f37",
                                "text": "„Nach seinem Tod entwickelte sich ein Heiligenkult, dann wurde im 8. Jahrhundert das nach ihm benannte Kloster St. Gallen gegründet.“"
                            },
                            {
                                "example_id": "87d60c4c-68e6-4b1c-9dff-fe11d5d5e089",
                                "sense_id": "ebb14fef-9a7f-3cb3-9961-3ad66df14f37",
                                "text": "„Damit begründete er einen landeseigenen politischen Heiligenkult, der nicht nur Einheit und Identifikation stiftete, die herausgehobene Stellung Prags festigte, ja die Stadt zum Symbol der Herrschaft über Böhmen schlechthin erhob, sondern die Dynastie der Přemysliden, der Wenzel entstammte, auch einen enormen Zuwachs an Prestige und Machtlegitimation verlieh.“"
                            },
                            {
                                "example_id": "1bb2f75b-1142-43bc-b660-2f90d97066d7",
                                "sense_id": "ebb14fef-9a7f-3cb3-9961-3ad66df14f37",
                                "text": "„Häufig fanden Sufis Eingang in lokale Heiligenkulte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
