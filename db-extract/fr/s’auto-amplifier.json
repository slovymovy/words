                "senses": [
                    {
                        "sense_id": "4f8502a9-bbbd-3434-b9ea-b6c563f7e72a",
                        "entry_id": "99549d91-c93d-322e-a088-2f1391ed03c3",
                        "glosses": [
                            "S’amplifier tout seul."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1bb4fde2-9f3a-4ff1-a9af-03e4c6dfa9e3",
                                "sense_id": "4f8502a9-bbbd-3434-b9ea-b6c563f7e72a",
                                "text": "Son ambition est plutôt de signifier l’excès primordial du sens caché de l'Univers, qui s’auto-amplifie indéfiniment depuis la nuit des temps, et demeure insondable pour l’éternité."
                            },
                            {
                                "example_id": "5f89b9fc-9818-4e7c-b9e8-3d657571e629",
                                "sense_id": "4f8502a9-bbbd-3434-b9ea-b6c563f7e72a",
                                "text": "Une fois la réaction déclenchée, elle s’auto-amplifie par des mécanismes d’autocrinie et de paracrinie impliquant les cellules présentes."
                            }
                        ]
                    }
