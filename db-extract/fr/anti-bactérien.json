                    {
                        "sense_id": "5a535350-8676-3481-8607-2c7348f01f6f",
                        "entry_id": "cdc96fec-02f9-36f4-b02f-bbbf9f435b40",
                        "glosses": [
                            "Qui tue les bactéries."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c371cd2-3ec1-456e-a643-d5b68c1b4806",
                                "sense_id": "5a535350-8676-3481-8607-2c7348f01f6f",
                                "text": "La plupart des huiles essentielles sont anti-bactériennes, antifongiques, antivirales, anti-inflammatoires et antioxydantes."
                            },
                            {
                                "example_id": "e3745a26-0904-437f-83df-6d8e8f6ccd3c",
                                "sense_id": "5a535350-8676-3481-8607-2c7348f01f6f",
                                "text": "Caenorhabditis elegans engage également des réponses innées anti-fongique et anti-bactérienne avec production de peptides antimicrobiens, au niveau du tégument, dans le premier cas et au niveau de l’intestin dans le second."
                            },
                            {
                                "example_id": "a03b642f-1775-4b58-9a40-75868b6c0ed6",
                                "sense_id": "5a535350-8676-3481-8607-2c7348f01f6f",
                                "text": "Il faudra également surveiller les aubépines dans l’environnement et traiter préventivement les fleurs avec des produits anti-bactériens."
                            }
                        ]
                    }
                ],
