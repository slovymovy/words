                    "sense_id": "e5dcb4a4-dc3f-3a47-8f94-0ffb9d250497",
                    "sense_definition": "De haargroei op de kin en wangen van een man.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "gezichtshaar",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij besloot om zijn <w>baard</w> te laten staan tijdens de vakantie.",
                            "target_lang_translations": {
                                "en": "He decided to grow his <w>beard</w> during the holiday."
                            }
                        },
                        {
                            "text": "De kapper hielp hem met het trimmen van zijn <w>lange</w> <w>baard</w>.",
                            "target_lang_translations": {
                                "en": "The barber helped him trim his <w>long</w> <w>beard</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "lange baard",
                        "grijze baard",
                        "baard laten staan",
                        "baard trimmen"
                    ],
                    "target_lang_definitions": {
                        "en": "The hair growth on a man's chin and cheeks."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "beard",
                                "target_lang_sense_clarification": "facial hair"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "991d1a1f-c1d3-3756-b229-bb12532b59c4",
                    "sense_definition": "Het uitstekende deel van een sleutel dat in het slot draait.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "techniek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>baard</w> van de sleutel was afgebroken in het slot.",
                            "target_lang_translations": {
                                "en": "The <w>bit</w> of the key had broken off in the lock."
                            }
                        },
                        {
                            "text": "Zonder de juiste <w>sleutelbaard</w> krijg je deze oude deur niet open.",
                            "target_lang_translations": {
                                "en": "Without the correct <w>key bit</w>, you won't get this old door open."
                            }
                        }
                    ],
                    "synonyms": [
                        "sleutelbaard"
                    ],
                    "common_phrases": [
                        "sleutelbaard"
                    ],
                    "target_lang_definitions": {
                        "en": "The protruding part of a key that turns in the lock."
                    },
                    "translations": {
