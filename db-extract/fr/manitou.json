                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f30b682c-a1d2-43ab-a1b5-91b272bfd435",
                                "sense_id": "d2df2273-bffb-3e95-9540-fbf86419d2d6",
                                "text": "Les fabriquants français utilisent des camions équipés d’un manitou automatique pour le déchargement des palettes de fenêtres."
                            },
                            {
                                "example_id": "9e803f7f-2b11-4a30-96da-924c791285ef",
                                "sense_id": "d2df2273-bffb-3e95-9540-fbf86419d2d6",
                                "text": "Partout des tentes se montent, des stands se construisent, des camions entiers de matériel se vident, des manitous déplacent des palettes de boissons, des stocks de nourriture."
                            }
                        ]
                    }
