                ],
                "translations": [
                    {
                        "translation_id": "92ecaa89-329d-4d23-bd04-419edd483cdc",
                        "source_entry_id": "70bc6379-d6fd-3174-8a6d-5c272691a497",
                        "target_lang_word": "twig",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "twig",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f2b6233c-93c0-3830-9021-ea749588c4c7",
                                        "entry_id": "a12fcab3-f128-32e0-adf3-732911485d6b",
                                        "glosses": [
                                            "A small thin branch of a tree or bush."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f76aee70-0661-497e-87b2-d548f38b345b",
                                                "sense_id": "f2b6233c-93c0-3830-9021-ea749588c4c7",
                                                "text": "They used twigs and leaves as a base to start the fire."
                                            },
                                            {
                                                "example_id": "3e9cea95-f36b-4171-812c-a754ff1f1ee0",
                                                "sense_id": "f2b6233c-93c0-3830-9021-ea749588c4c7",
                                                "text": "A beech wood with silver firs in it rolled down the face of the hill, and the maze of leafless twigs and dusky spires cut sharp against the soft blueness of the evening sky."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7346fe0-974a-3748-b4b3-7769ec5defd0",
                                        "entry_id": "a12fcab3-f128-32e0-adf3-732911485d6b",
                                        "glosses": [
                                            "Somebody, or one of their body parts, not looking developed."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b262cac-9cec-4552-90fc-e61a210c0a27",
                                                "sense_id": "c7346fe0-974a-3748-b4b3-7769ec5defd0",
                                                "text": "You need to find a source of motivation and play off of that. Whether it be the jock in high school that always called you fat, or the guy who picked on you and called you a twig."
                                            },
                                            {
                                                "example_id": "c61c4c78-91b7-4188-b2e6-96e51043f199",
                                                "sense_id": "c7346fe0-974a-3748-b4b3-7769ec5defd0",
                                                "text": "Schwarzenegger was long past his professional bodybuilding days when he and Carrere shot the tango scene, but he wasn’t a twig."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "twig",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "793d668c-2725-3e6a-9252-92fbf6976565",
                                        "entry_id": "c41c7c7a-0d36-3e78-9af4-b5a7607f750e",
                                        "glosses": [
                                            "To beat with twigs."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "twig",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7df46b5b-8aff-3995-8059-aa7d231a357b",
                                        "entry_id": "64dd2176-bc29-340b-9498-b84b52e37328",
                                        "glosses": [
                                            "To realise something; to catch on; to recognize someone or something."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "regional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e2803153-f041-4039-8b1b-2e1ba1e19197",
                                                "sense_id": "7df46b5b-8aff-3995-8059-aa7d231a357b",
                                                "text": "He hasn't twigged that we're planning a surprise party for him."
                                            },
                                            {
                                                "example_id": "e6c26d15-13a4-4ff4-9c7f-a83bb99762e9",
                                                "sense_id": "7df46b5b-8aff-3995-8059-aa7d231a357b",
                                                "text": "I pray you now send me some dub, / A bottle or two to the needy. / I beg you won't bring it yourself, / The harman is at the Old-Bailey; / I'd rather you'd send it behalf, / For, if they twig you they'll nail you."
                                            },
                                            {
                                                "example_id": "dadc7338-b89b-450b-a2ea-707aa7f24f8a",
                                                "sense_id": "7df46b5b-8aff-3995-8059-aa7d231a357b",
                                                "text": "I twigged him at once, by the description you gave me. I never see a cove togged out as he was,—tall hat, light sit-down-upons, and a short coat—wasn't it cut short! but in really bang-up style.",
                                                "translation": "J'y ai reconnu le particulier que vous m'avez dit. Bien vêtu, ma foi! Chapeau rogné, tout plat, pantalon clair, en fourreau de parapluie, veston court, oh! mais d'un court... enfin, le dernier genre.",
                                                "english": "J'y ai reconnu le particulier que vous m'avez dit. Bien vêtu, ma foi! Chapeau rogné, tout plat, pantalon clair, en fourreau de parapluie, veston court, oh! mais d'un court... enfin, le dernier genre."
                                            },
                                            {
                                                "example_id": "511830b1-cbc3-4b04-bc41-414105455867",
                                                "sense_id": "7df46b5b-8aff-3995-8059-aa7d231a357b",
                                                "text": "Well, with fewer people doing two or three times the work, you may have already twigged to this."
                                            },
                                            {
                                                "example_id": "ec3b242a-a026-47b2-a469-0c1e5bdca823",
                                                "sense_id": "7df46b5b-8aff-3995-8059-aa7d231a357b",
                                                "text": "At this point in our story, we first meet the fleet repair ship Kamchatka, who everyone would soon become regrettably familiar with. Her entry into our account here was her signal that she was under attack by torpedo boats! When she was asked how many, she replied \"about eight, from all directions!\". Eventually, someone twigged to the fact that absolutely nobody else could see so much as a seagull, let alone any exceptionally-lost Japanese torpedo boats. And, when nothing actually happened, Kamchatka refused to say that it was a false alarm, only that it had altered course and the torpedo boats had gone away."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e3f4cee-3e27-334b-ab51-7e7a40e30777",
                                        "entry_id": "64dd2176-bc29-340b-9498-b84b52e37328",
                                        "glosses": [
                                            "To be realized and understood; to click."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cf7f77da-14c1-41dd-9c53-a5d4d5d6f511",
                                                "sense_id": "1e3f4cee-3e27-334b-ab51-7e7a40e30777",
                                                "text": "Dries had told us to bring at least twenty litres of water because there was no water in camp and very few tourists stayed there. I knew I wouldn't get a shower for three days, but I wasn't worried about that. It hadn't twigged that the reason we needed to bring our own water was that the camp itself was a warzone."
                                            },
                                            {
                                                "example_id": "49904ea6-153c-43e4-a077-635790ef9f67",
                                                "sense_id": "1e3f4cee-3e27-334b-ab51-7e7a40e30777",
                                                "text": "As the photographer took a couple of preliminary photographs of Mandy, Marcus seized the moment. He knelt behind her. When Mandy turned around, she was initially confused. Then it twigged – he was proposing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9228219e-cd39-3f7f-9cfc-2ccda6a612e2",
                                        "entry_id": "64dd2176-bc29-340b-9498-b84b52e37328",
                                        "glosses": [
                                            "To understand the meaning of (a person); to comprehend."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ee3697e-8e53-40a3-8df4-634ea0ba13d3",
                                                "sense_id": "9228219e-cd39-3f7f-9cfc-2ccda6a612e2",
                                                "text": "Do you twig me?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "16d49267-6aa3-34e5-93d3-038a57a2653e",
                                        "entry_id": "64dd2176-bc29-340b-9498-b84b52e37328",
                                        "glosses": [
                                            "To observe slyly; also, to perceive; to discover."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2dfe0c80-c14f-4659-9779-3e5de5f60609",
                                                "sense_id": "16d49267-6aa3-34e5-93d3-038a57a2653e",
                                                "text": "Now twig him; now mind him: mark how he hawls his muscles about."
                                            },
                                            {
                                                "example_id": "26baa820-8ec7-4d5a-8491-c620e4dc27df",
                                                "sense_id": "16d49267-6aa3-34e5-93d3-038a57a2653e",
                                                "text": "This excellent man appears to have sunk into himself in a sitting posture, […] while his exceedingly homely and wrinkled face, held a little on one side, twinkles at you with the shrewdest complacency, as if he were looking right into your eyes and twigged something there which you had half a mind to conceal from him."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "twig",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b197a5cd-1e8e-3e09-97ef-b61076deb3d6",
                                        "entry_id": "771bbb8d-5e80-36b9-8d63-8af2f56f4c86",
                                        "glosses": [
                                            "To pull"
                                        ],
