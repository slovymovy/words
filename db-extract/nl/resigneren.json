                        "examples": [
                            {
                                "example_id": "d2506169-0e8e-4814-aea4-0a9511c511c0",
                                "sense_id": "40a118e9-2253-3bf2-a7c3-478da2d93d1a",
                                "text": "Wil men zich in de richting van het geloof begeven, zo argumenteert hij in ”Vrees en beven”, dan dient men bereid te zijn om zijn eindige, wereldse verlangens op te geven. Dan moet men kunnen resigneren, net zoals Abraham zelfs bereid was om zijn zoon te offeren. Maar wie werkelijk het geloof bezit maakt nog een volgende beweging, met name die van het geloof „krachtens het absurde.”"
                            },
                            {
                                "example_id": "d348d161-ce36-452e-97c4-315e17acc60d",
                                "sense_id": "40a118e9-2253-3bf2-a7c3-478da2d93d1a",
                                "text": "Wanneer men alzoo resigneren, gelooven en werken leert, dan za [sic!] het blijken ‘dat volksgeest en volksgeweten elk bezwaar van staatsrechtelijken toestand overwint’."
                            }
                        ]
                    }
