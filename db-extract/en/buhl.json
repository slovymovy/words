                        "entry_id": "0d3074e6-a2e7-3642-ba04-b8ef9168fd86",
                        "glosses": [
                            "A particularly decorative piece of brass or other material, used as inlay in furniture or other works."
                        ],
                        "tags": [
                            "attributive",
                            "often",
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "28397576-03d3-461a-8ffd-0629790a0a1a",
                                "sense_id": "4abf5f66-d492-3490-811a-a9730e852b15",
                                "text": "In preparation for a client of his type, she had brought into the shop a buhl cabinet, selected from Jabez Rintle's hoard, and that piece, with its elaborate craftsmanship in brass, inlay, tortoiseshell and carving, arrested Mr Jacobson's flair for a bargain in financial values at least."
                            }
                        ]
                    },
                    {
                        "sense_id": "97f89230-05ca-3f86-b5c3-0c5c04d5bc66",
                        "entry_id": "0d3074e6-a2e7-3642-ba04-b8ef9168fd86",
                        "glosses": [
                            "Furniture having ornamentation of this kind."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "609ee829-87ac-445e-b6e5-cd49c6db801a",
                                "sense_id": "97f89230-05ca-3f86-b5c3-0c5c04d5bc66",
                                "text": "Fancy a Member of Parliament and an old English Baronet, by Gad! obliged to put a drawing-room clock and a buhl inkstand up the spout; and a gold duck’s-head paper-holder, that I dare say cost my wife five pound, for which they’d only give me fifteen-and-six!"
                            }
                        ]
                    }
