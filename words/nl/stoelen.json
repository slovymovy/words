                    "sense_definition": "Meervoud van <w>stoel</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er staan vier <w>stoelen</w> rond de eettafel.",
                            "target_lang_translations": {
                                "en": "There are four <w>chairs</w> around the dining table.",
                                "ru": "Вокруг обеденного стола стоят четыре <w>стула</w>.",
                                "fr": "Il y a quatre <w>chaises</w> autour de la table à manger."
                            }
                        },
                        {
                            "text": "Zijn deze <w>stoelen</w> nog vrij?",
                            "target_lang_translations": {
                                "en": "Are these <w>chairs</w> still free?",
                                "ru": "Эти <w>стулья</w> еще свободны?",
                                "fr": "Est-ce que ces <w>chaises</w> sont encore libres ?"
                            }
                        }
                    ],
                    "common_phrases": [
                        "houten stoelen",
                        "gemakkelijke stoelen",
                        "lege stoelen"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "plural"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Plural of <w>chair</w>; a separate seat for one person, typically with a back and four legs.",
                        "ru": "Множественное число от слова <w>стул</w>; отдельное сиденье для одного человека, обычно со спинкой и четырьмя ножками.",
                        "fr": "Pluriel de chaise ; siège individuel généralement muni d'un dossier et de quatre pieds."
                    },
                    "translations": {
