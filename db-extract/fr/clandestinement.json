        "fr-extract.jsonl": [
            {
                "entry_id": "fa95db90-b4d3-3f2a-b212-5cf082e03988",
                "word": "clandestinement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "02e54b7d-5fc6-3238-83a3-f73fe3cd58e1",
                        "entry_id": "fa95db90-b4d3-3f2a-b212-5cf082e03988",
                        "glosses": [
                            "D’une manière clandestine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00ac9a14-e640-4e77-969c-c7f9f7e64500",
                                "sense_id": "02e54b7d-5fc6-3238-83a3-f73fe3cd58e1",
                                "text": "Un kwassa-kwassa est un bateau de pêche utilisé par des passeurs pour emmener clandestinement des migrants originaires des Comores sur l’île de Mayotte."
                            },
                            {
                                "example_id": "75bac008-47e7-4dc8-8c1f-37aa6bb63d23",
                                "sense_id": "02e54b7d-5fc6-3238-83a3-f73fe3cd58e1",
                                "text": "[…]; mais le Bureau de Santé était implacable et livrait sans merci aux autorités administratives et judiciaires ceux qui débarquaient clandestinement, avec la complicité des terriens, des marchandises suspectes ; […]."
                            },
                            {
                                "example_id": "81474961-dfce-4a7f-bfe9-1c181e44309d",
                                "sense_id": "02e54b7d-5fc6-3238-83a3-f73fe3cd58e1",
                                "text": "L’année suivante en passant par l’Iran je pus, avec l’aide des services secrets du shah, (la Savak) enchantés que les Kurdes missent la pâtée aux troupes de Bagdad, franchir clandestinement la frontière et rencontrer le grand Barzani."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "872577de-cc1e-4897-af6e-28c647c01bc2",
                        "source_entry_id": "fa95db90-b4d3-3f2a-b212-5cf082e03988",
                        "source_sense_id": "02e54b7d-5fc6-3238-83a3-f73fe3cd58e1",
