                ],
                "senses": [
                    {
                        "sense_id": "68f2b6ac-41b0-34d1-9241-30cc50e753aa",
                        "entry_id": "0accffef-a613-33fb-9da6-bacb5437c2ee",
                        "glosses": [
                            "Droge, die während der Freizeit konsumiert wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "753a95df-81eb-49f8-9502-ae468be5bbb2",
                                "sense_id": "68f2b6ac-41b0-34d1-9241-30cc50e753aa",
                                "text": "„Als Freizeitdroge bevorzugte er weiterhin Marihuana.“"
                            },
                            {
                                "example_id": "48a99d25-420b-4968-89ad-bf2837d7b8d2",
                                "sense_id": "68f2b6ac-41b0-34d1-9241-30cc50e753aa",
                                "text": "„Und nun redete Katrin über Freizeitdrogen, während die junge Schottin, die keine Schotting war, unauffällig den Briten beäugte, der kein Brite war, und sich insgeheim fragte, wie lange er da schon an der Bar gesessen hatte, bevor sie ihn überhaupt bemerkt hatte, und, noch entscheidender, woher die CIA verdammt noch mal wusste, dass die Triadenjungs Fan Jiang hier vor der Insel Po Toi auf ein Frachtschiff gebracht hatten.“"
                            },
                            {
                                "example_id": "1d924d85-a299-467a-9a64-b47521e0fc2d",
                                "sense_id": "68f2b6ac-41b0-34d1-9241-30cc50e753aa",
                                "text": "„Shaw hatte Freizeitdrogen noch nie etwas abgewinnen können, empfand den aromatischen Geruch von Marihuana aber dennoch als angenehm.“"
                            },
                            {
                                "example_id": "fc8fdbb9-e5d0-4e71-a43e-240ac332d7ba",
                                "sense_id": "68f2b6ac-41b0-34d1-9241-30cc50e753aa",
                                "text": "„Während ich weitertippe, erkläre ich, meine Eltern bestehen eigentlich nur aus ihren physischen Gelüsten, ihren Freizeitdrogen und hemmungslosem Sex.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
