                                    {
                                        "sense_id": "84030ac3-246f-3055-bfb4-8828757b82e2",
                                        "entry_id": "560a2c34-7f68-31cf-b23b-97421bae614f",
                                        "glosses": [
                                            "Large in size, quantity, or value; ample; significant."
                                        ],
                                        "tags": [],
                                        "examples": [
