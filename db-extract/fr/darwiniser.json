                        "glosses": [
                            "Donner un caractère rappelant Charles Darwin, sa théorie de l´évolution."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da72f6fe-fff0-48ad-a9ba-a2362c5bd8fd",
                                "sense_id": "32f25a3c-62e8-3807-9319-3ec29ad60d11",
                                "text": "Non content de « darwiniser » les mythes grecs, Freud fait également subir une torsion à la pièce de Sophocle."
                            },
                            {
                                "example_id": "3dd925fe-e3db-4af8-adc1-68f1bbe360ed",
                                "sense_id": "32f25a3c-62e8-3807-9319-3ec29ad60d11",
                                "text": "Robert Duval me parut d’emblée antipathique, le genre maquignon du XIXème qui s’est darwinisé en l’affairiste fin XXème."
                            }
                        ]
                    }
