                            }
                        ]
                    }
                },
                {
                    "sense_id": "c400a4fc-b684-3c5c-b053-01fb66cf09db",
                    "sense_definition": "To suffer the consequences of an action; to pay for.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "consequences",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If you break the treaty, you will have to <w>abide</w> the cost of war.",
                            "target_lang_translations": {
                                "ru": "Если вы нарушите договор, вам придется <w>расплачиваться</w> ценой войны.",
                                "zh": "如果你破坏条约，就必须<w>承担</w>战争的代价。",
                                "es": "Si rompes el tratado, tendrás que <w>pagar</w> el costo de la guerra."
                            }
                        },
                        {
                            "text": "He knew he would dearly <w>abide</w> his mistake in the years to come.",
                            "target_lang_translations": {
                                "ru": "Он знал, что в ближайшие годы ему придется дорого <w>поплатиться</w> за свою ошибку.",
                                "zh": "他知道在未来的岁月里，他将为自己的错误<w>付出代价</w>。",
                                "es": "Él sabía que tendría que <w>afrontar</w> duramente su error en los años venideros."
                            }
                        }
                    ],
                    "synonyms": [
                        "atone",
                        "suffer"
                    ],
                    "common_phrases": [
                        "dearly abide"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Нести последствия какого-либо действия; расплачиваться.",
                        "zh": "承担行为的后果；付出代价。",
                        "es": "Sufrir las consecuencias de una acción; pagar por algo."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "распла́чиваться",
                                "target_lang_sense_clarification": "за ошибки или действия"
                            },
                            {
                                "target_lang_word": "поплати́ться",
                                "target_lang_sense_clarification": "понести наказание"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "承担",
                                "target_lang_sense_clarification": "指对后果负责"
                            },
                            {
                                "target_lang_word": "付出代价",
                                "target_lang_sense_clarification": "指因错误行为而遭受损失"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "pagar",
                                "target_lang_sense_clarification": "sufrir las consecuencias"
                            },
                            {
                                "target_lang_word": "afrontar",
                                "target_lang_sense_clarification": "hacer frente a las consecuencias"
                            },
                            {
                                "target_lang_word": "apechugar",
                                "target_lang_sense_clarification": "aceptar una carga o consecuencia"
                            }
                        ]
                    }
                }
