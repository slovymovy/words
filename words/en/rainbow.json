                },
                {
                    "sense_id": "b469b60f-e802-3431-8781-0ab47847dde0",
                    "sense_definition": "An illusion, fantasy, or unrealistic hope.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "illusion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spent his life chasing <w>rainbows</w> instead of focusing on achievable goals.",
                            "target_lang_translations": {
                                "ru": "Он провёл жизнь, гоняясь за <w>призрачными мечтами</w>, вместо того чтобы сосредоточиться на достижимых целях.",
                                "zh": "他一生都在追求<w>幻想</w>，而不是专注于可实现的目标。"
                            }
                        },
                        {
                            "text": "The promise of easy wealth turned out to be just another <w>rainbow</w>.",
                            "target_lang_translations": {
                                "ru": "Обещание лёгкого богатства оказалось лишь очередной <w>иллюзией</w>.",
                                "zh": "轻松致富的承诺结果不过是又一个<w>幻影</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "chasing rainbows"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "often used in literary contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Иллюзия, фантазия или несбыточная надежда.",
                        "zh": "一种幻觉、幻想或无法实现的希望。"
