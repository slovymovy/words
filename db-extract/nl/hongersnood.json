                                "target_senses": [
                                    {
                                        "sense_id": "5080d9c4-3739-3049-95cb-9d07e72c78ee",
                                        "entry_id": "4741ee8c-2107-3529-a042-13d056212369",
                                        "glosses": [
                                            "Extreme shortage of food in a region."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "592213b2-3115-4128-871c-5bda06de63c3",
                                                "sense_id": "5080d9c4-3739-3049-95cb-9d07e72c78ee",
                                                "text": "It was reserved for Christians to torture bread, the staff of life, bread for which children in whole districts wail, bread, the gift of pasture to the poor, bread, for want of which thousands of our fellow beings annually perish by famine; it was reserved for Christians to torture the material of bread by fire, to create a chemical and maddening poison, burning up the brain and brutalizing the soul, and producing evils to humanity, in comparison of which, war, pestilence, and famine, cease to be evils."
                                            },
                                            {
                                                "example_id": "c46d6bad-efaa-4ab5-b7b3-a08cb7506b50",
                                                "sense_id": "5080d9c4-3739-3049-95cb-9d07e72c78ee",
                                                "text": "Dr. Bhatia pointed out that famine had occurred in all ages and in all societies where means of communication and transport were not developed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11292b06-1043-3999-9e77-20ab73f85cf3",
                                        "entry_id": "4741ee8c-2107-3529-a042-13d056212369",
                                        "glosses": [
                                            "A period of extreme shortage of food in a region."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f288c3fe-ffc9-4019-895d-c836c5bc1556",
                                                "sense_id": "11292b06-1043-3999-9e77-20ab73f85cf3",
                                                "text": "1986, United States Congress, House Select Committee on Hunger, Committee on Foreign Affairs, Subcommittee on Africa, Famine and Recovery in Africa\nThe root causes of the current famine are known: poverty, low health standards...."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "414de0ff-bb8c-3ec3-ab29-613eb814ee8c",
                                        "entry_id": "4741ee8c-2107-3529-a042-13d056212369",
                                        "glosses": [
                                            "Starvation or malnutrition."
                                        ],
                                        "tags": [
                                            "countable",
                                            "dated",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6183648d-df4f-4d07-86dc-b119f21c5760",
                                                "sense_id": "414de0ff-bb8c-3ec3-ab29-613eb814ee8c",
                                                "text": "His own flesh, however, which he lost by famine, shall be restored to him by Him who can recover even what has evaporated."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c03ef89c-c941-3e7a-915d-0e0d9642cb58",
                                        "entry_id": "4741ee8c-2107-3529-a042-13d056212369",
                                        "glosses": [
                                            "Severe shortage or lack of something."
                                        ],
                                        "tags": [
