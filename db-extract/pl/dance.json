                                    {
                                        "sense_id": "10f1a725-454d-3b2f-9e60-cf32523e9f05",
                                        "entry_id": "34db2987-720f-392a-b35b-d90e6b68e3f1",
                                        "glosses": [
                                            "Music composed to accompany social dancing."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "76b4fb60-8ee8-478b-af7b-9b34af3e3618",
                                                "sense_id": "10f1a725-454d-3b2f-9e60-cf32523e9f05",
                                                "text": "From all sides her gift for playing the piano was insisted upon, and she had to consent. As very soon she had played the only pieces of dance music she could remember, she went on to play an air from a sonata by Mozart."
                                            },
                                            {
                                                "example_id": "134317f9-8c90-46fd-88d1-04eb2ea7215c",
                                                "sense_id": "10f1a725-454d-3b2f-9e60-cf32523e9f05",
                                                "text": "In the bar in which Strickland and Nichols sat a mechanical piano was loudly grinding out dance music."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e00a17f6-8a06-34a1-b97d-66a2ebafc207",
                                        "entry_id": "34db2987-720f-392a-b35b-d90e6b68e3f1",
                                        "glosses": [
                                            "Ellipsis of electronic dance music."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "40c7f241-cd57-45cb-a9b2-abb2d1c5ccf0",
                                                "sense_id": "e00a17f6-8a06-34a1-b97d-66a2ebafc207",
                                                "text": "Britpop had revitalised rock, and an unprecedented explosion in dance music – sparked off by a second consecutive sunny and idyllic Glastonbury – transformed how Britain thought, listened, partied and came down afterwards."
                                            }
                                        ]
                                    }
