                "senses": [
                    {
                        "sense_id": "b02cb908-f133-3d49-a2de-449f18a3272f",
                        "entry_id": "6851c17d-4aaa-3ede-85f4-1f565d3fb72e",
                        "glosses": [
                            "Nom d’un cabaretier de Paris appelé Jean Ramponneau (1724-1802)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c911798-815b-4a76-9c7d-b2f9003d0ab4",
                                "sense_id": "b02cb908-f133-3d49-a2de-449f18a3272f",
                                "text": "Une fois par hasard, du Vingtras, c’est drôle, comme une escapade chez Ramponneau, comme une dînette à la ferme où l’on trempe du pain noir dans du lait blanc, comme une visite d’élégante dans un logis de blousier où la soupe sent bon — mais quotidiennement, jamais !"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "43882e17-1074-3de7-a800-2a3ba562fa7a",
