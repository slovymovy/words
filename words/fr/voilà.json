                {
                    "sense_id": "aebb7180-9273-39b1-8aa2-dc02e0480b27",
                    "sense_definition": "Sert à montrer, présenter ou désigner quelqu'un ou quelque chose qui arrive ou se trouve à portée.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "presentation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Voilà</w> votre café et l'addition, monsieur.",
                            "target_lang_translations": {
                                "en": "<w>Here is</w> your coffee and the bill, sir.",
                                "ru": "<w>Вот</w> ваш кофе и счёт, месье.",
                                "nl": "<w>Hier is</w> uw koffie en de rekening, meneer.",
                                "de": "<w>Hier ist</w> Ihr Kaffee und die Rechnung, mein Herr.",
                                "pl": "<w>Oto</w> pańska kawa i rachunek, proszę pana.",
                                "it": "<w>Ecco</w> il suo caffè e il conto, signore.",
                                "cs": "<w>Tady máte</w> vaši kávu a účet, pane.",
                                "tr": "<w>Buyurun</w>, kahveniz ve hesabınız, efendim.",
                                "es": "<w>Aquí tiene</w> su café y la cuenta, señor.",
                                "zh": "先生，您的咖啡和账单，<w>给您</w>。"
                            }
                        },
                        {
                            "text": "Le train arrive enfin en gare, le <w>voilà</w> !",
                            "target_lang_translations": {
                                "en": "The train is finally pulling into the station, and <w>here</w> it <w>is</w>!",
                                "ru": "Поезд наконец подходит к вокзалу — <w>вот он</w>!",
                                "nl": "De trein rijdt eindelijk het station binnen, <w>daar is hij</w>!",
                                "de": "Der Zug fährt endlich in den Bahnhof ein, <w>da ist</w> er!",
                                "pl": "Pociąg wreszcie wjeżdża na stację — <w>oto</w> i on!",
                                "it": "Il treno sta finalmente entrando in stazione, <w>eccolo</w>!",
                                "cs": "Vlak konečně přijíždí do stanice, <w>tady ho máme</w>!",
                                "tr": "Tren sonunda istasyona yanaşıyor, <w>işte</w> geldi!",
                                "es": "El tren por fin entra en la estación, ¡<w>ahí está</w>!",
                                "zh": "火车终于进站了，<w>瞧</w>，它来了！"
                            }
                        }
                    ],
                    "synonyms": [
                        "voici"
                    ],
                    "common_phrases": [
                        "le voilà",
                        "en voilà",
                        "me voilà"
                    ],
                    "target_lang_definitions": {
                        "en": "Used to present, show or point out someone or something that is arriving or within reach.",
                        "ru": "Используется, чтобы показать или указать на человека или предмет, который приближается или находится рядом.",
                        "nl": "Gebruikt om iemand of iets aan te wijzen of te presenteren dat dichtbij is of nadert.",
                        "de": "Dient dazu, eine Person oder Sache vorzustellen oder zu zeigen, die kommt oder in Reichweite ist.",
                        "pl": "Służy do pokazania, przedstawienia lub wskazania osoby albo rzeczy, która nadchodzi lub znajduje się w zasięgu ręki.",
                        "it": "Serve a mostrare, presentare o indicare una persona o una cosa che arriva o si trova vicino.",
                        "cs": "Slouží k ukázání nebo představení někoho či něčeho, co přichází nebo je na dosah.",
                        "tr": "Yakında bulunan veya gelmekte olan bir kişiyi ya da şeyi göstermek, sunmak için kullanılır.",
                        "es": "Se usa para presentar, mostrar o señalar a alguien o algo que llega o está al alcance.",
                        "zh": "用于介绍、展示或指出正在靠近或就在手边的人或东西。"
                    },
