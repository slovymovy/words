                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fee4b9b9-cd67-4d00-a4f8-32958e9b3fc6",
                                "sense_id": "3d09cc5d-bcad-3921-a9c2-7aa29b6a9270",
                                "text": "Do impozycji powinno się użyć jedynie plików PDF lub postscriptowych."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
