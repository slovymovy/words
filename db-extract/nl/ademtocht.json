        "nl-extract.jsonl": [
            {
                "entry_id": "665e1843-91fc-3909-adf1-77bbeae23d54",
                "word": "ademtocht",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "48d4319a-39a3-41ba-8a86-d7f5412331da",
                        "entry_id": "665e1843-91fc-3909-adf1-77bbeae23d54",
                        "tags": [
