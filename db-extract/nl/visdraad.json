                        "entry_id": "d62d8758-3db5-3354-a275-53c1436c85c5",
                        "glosses": [
                            "dun sterk nylondraad dat men in de hengelsport gebruikt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d388b110-8008-4828-940d-57f58f23b104",
                                "sense_id": "5d07db3d-f27f-371d-a4c2-d186d11d67b5",
                                "text": "De hengelsport is ook slecht voor watervogels, schrijft de VVD-fractie. Die kunnen verstrikt raken in visdraad of een vishaak inslikken."
                            },
                            {
                                "example_id": "444d9eb8-2464-4403-8308-df5307ad8652",
                                "sense_id": "5d07db3d-f27f-371d-a4c2-d186d11d67b5",
                                "text": "Hij complimenteert de koningin met haar keuzes. „Ze durft nieuwe materialen te dragen.” Het zijn ook vooral de materialen die de komende jaren het modebeeld beïnvloeden, stelt de ontwerper. Terwijl designs van nu ook over tien jaar nog te zien zullen zijn. „Het materiaal wordt steeds innovatiever. Zo zijn er jurken van visdraad.”"
                            }
                        ]
                    }
