                    }
                ],
                "senses": [
                    {
                        "sense_id": "fc491d40-e2bc-347c-b245-656c3f293f2a",
                        "entry_id": "554feebb-d35e-3179-9a9e-b48dcaea6b7a",
                        "glosses": [
                            "мифол., : сказочный персонаж, дух леса, его хозяин, обычно враждебный человеку"
                        ],
                        "tags": [
                            "в славянской мифологии"
                        ],
                        "examples": [
                            {
                                "example_id": "b1dad3cb-30ca-49af-bb6e-b1b6cc835c68",
                                "sense_id": "fc491d40-e2bc-347c-b245-656c3f293f2a",
                                "text": "Там чудеса: там леший бродит, // Русалка на ветвях сидит."
                            }
                        ]
                    },
                    {
                        "sense_id": "89b4ccb0-197b-3868-a541-0a84c1f582df",
                        "entry_id": "554feebb-d35e-3179-9a9e-b48dcaea6b7a",
                        "glosses": [
                            "перен., прост., бран. :"
                        ],
                        "tags": [
                            "о ком-либо, вызвавшем неудовольствие, раздражение, гнев"
                        ],
                        "examples": [
                            {
                                "example_id": "974234de-2e04-4fda-8dd8-9eee06efca60",
                                "sense_id": "89b4ccb0-197b-3868-a541-0a84c1f582df",
                                "text": "И Сенька, даром что глухой, — понял: тоже руки в боки и подошёл. А он здоровый, леший. Дэр заморгал, забеспокоился, смотрит, где пятый угол."
                            },
                            {
                                "example_id": "c1eac462-f456-4e07-8c36-b30ed13ea72f",
                                "sense_id": "89b4ccb0-197b-3868-a541-0a84c1f582df",
                                "text": "Бермята плюнул и со злостью вспорол кнутом сизую дорожную слякоть. — Тьфу, ты, леший!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c67d014f-742c-487a-a21d-ed11c5a74eed",
                        "source_entry_id": "554feebb-d35e-3179-9a9e-b48dcaea6b7a",
                        "source_sense_description": "дух леса, его хозяин",
                        "target_lang_word": "leszy",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "leszy",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "aa2bd835-978e-35e6-987c-dc2f9d29937f",
                                        "entry_id": "9cdc2e94-a349-3920-838f-b8febc97528f",
                                        "glosses": [
                                            "demon lasu"
                                        ],
                                        "tags": [
                                            "Slavic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5749e09e-8aa7-490b-aab3-afa9a92e1d97",
                                                "sense_id": "aa2bd835-978e-35e6-987c-dc2f9d29937f",
                                                "text": "— Różne rzeczy w życiu widziałem, ale ani gizdrów, ani leszych jak do tej pory nigdy nie spotkałem."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
