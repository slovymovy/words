            {
                "entry_id": "4e1f5a3d-bb0f-333f-9360-4495d1960829",
                "word": "d’office",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f67e0a87-aebb-35b8-96b1-27a2ee2190ff",
                        "entry_id": "4e1f5a3d-bb0f-333f-9360-4495d1960829",
                        "glosses": [
                            "Impérativement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8c46192-63fe-4212-99e7-02ead4afdf7d",
                                "sense_id": "f67e0a87-aebb-35b8-96b1-27a2ee2190ff",
                                "text": "Le juge a informé d’office, Il a informé sans en être requis et par le seul devoir de sa charge."
                            },
                            {
                                "example_id": "b2541977-0ea5-4f68-b0a7-a2e4c8c488e1",
                                "sense_id": "f67e0a87-aebb-35b8-96b1-27a2ee2190ff",
                                "text": "Avocat, expert nommé d’office, avocat, expert nommé par le juge."
                            },
                            {
                                "example_id": "45ecb919-8ae0-4c59-b8af-684621c03968",
                                "sense_id": "f67e0a87-aebb-35b8-96b1-27a2ee2190ff",
                                "text": "Personne ne s’étant présenté pour défendre l’accusé, un avocat fut nommé d’office par le tribunal."
                            },
                            {
                                "example_id": "cdf61869-d7e7-4f74-8d53-dd4aa11bc246",
                                "sense_id": "f67e0a87-aebb-35b8-96b1-27a2ee2190ff",
                                "text": "Pourquoi Le Fox devrait-il être inclus dans le Pro League Hall of Fame? - Gert Verheyen: \"Le Fox devrait d'office y être, bien sûr. Si vous regardez sa carrière, sa qualité réside dans la simplicité.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "09815b58-f099-30b8-b39d-3186d8da2434",
                        "entry_id": "4e1f5a3d-bb0f-333f-9360-4495d1960829",
                        "glosses": [
                            "Personnellement, de son propre chef."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "73780d8f-acc0-4ef6-85ba-17e5d001b87f",
                                "sense_id": "09815b58-f099-30b8-b39d-3186d8da2434",
                                "text": "Faire quelque chose d’office, faire quelque chose de son propre mouvement, sans en être requis."
                            }
                        ]
                    },
                    {
                        "sense_id": "2095a876-49c6-3378-a6f2-f4808160ed53",
                        "entry_id": "4e1f5a3d-bb0f-333f-9360-4495d1960829",
                        "glosses": [
                            "Sans qu'il soit nécessaire de le demander, de le spécifier."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "3c9e31e2-a07a-46c7-8227-b3e97fb95b2e",
                                "sense_id": "2095a876-49c6-3378-a6f2-f4808160ed53",
                                "text": "Les femmes sont descendues dans la rue pour fustiger les dictatures, sans pour autant mettre en avant leurs droits, croyant que la revendication de la démocratie et de la liberté les incluait d'office."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3758f6b7-6ae7-442f-9abb-f376f5c66900",
                        "source_entry_id": "4e1f5a3d-bb0f-333f-9360-4495d1960829",
                        "target_lang_word": "von Amts wegen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "von Amts wegen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cc4771f2-3496-3d66-a5c7-f82606ffe893",
                                        "entry_id": "4227a08d-295f-3953-aa0e-390163e6ac49",
                                        "glosses": [
                                            "auf Anordnung oder im Auftrag einer Behörde oder eines Amtes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9ede62b-ddc6-4447-b228-50ccaaf99ed2",
                                                "sense_id": "cc4771f2-3496-3d66-a5c7-f82606ffe893",
                                                "text": "Die Höhle wurde von Amts wegen aufgrund der akuten Einsturzgefahr geschlossen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b3f139fa-ef7d-3b4d-b6df-d53be6ee106b",
                                        "entry_id": "4227a08d-295f-3953-aa0e-390163e6ac49",
                                        "glosses": [
                                            "dienstlich, beruflich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8bee0702-6dd2-455f-a375-a5d5fce20f89",
                                                "sense_id": "b3f139fa-ef7d-3b4d-b6df-d53be6ee106b",
                                                "text": "Mein Mann ist von Amts wegen derzeit in Marokko tätig."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "44465ecd-87e5-3bcf-92df-db93532c4844",
                                        "entry_id": "4227a08d-295f-3953-aa0e-390163e6ac49",
                                        "glosses": [
                                            "kraft eines Amtes Befugnisse oder Funktionen innehabend"
                                        ],
                                        "tags": [
                                            "bei",
                                            "Personen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "021e7567-88fc-422e-baaf-14068780217c",
                                                "sense_id": "44465ecd-87e5-3bcf-92df-db93532c4844",
                                                "text": "Als Bürgermeister obliegt mir von Amts wegen die Leitung der Gemeindeverwaltung."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "1b6028ce-4760-36ce-9377-a731db362582",
                                        "entry_id": "4227a08d-295f-3953-aa0e-390163e6ac49",
                                        "glosses": [
                                            "einen Vorgang eigenständig und ohne weitere Anträge einleitend"
                                        ],
                                        "tags": [
                                            "bei",
                                            "Behörden"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a9a8faf-b6e5-47b0-81f6-69df57cbf313",
                                                "sense_id": "1b6028ce-4760-36ce-9377-a731db362582",
                                                "text": "„Das Familienbuch wird von Amts wegen im Anschluss an die Eheschließung angelegt, wenn die Ehe im Inland vor einem deutschen Standesbeamten geschlossen wurde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ecea3159-1f91-473f-b798-7394720fc1aa",
                        "source_entry_id": "4e1f5a3d-bb0f-333f-9360-4495d1960829",
                        "target_lang_word": "ex officio",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ex officio",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fd788187-7fb0-3261-b3c1-7ef5b4c23586",
                                        "entry_id": "9a4be6b0-7b53-3601-88d1-311f89ad0bbf",
                                        "glosses": [
                                            "By virtue of the office that originated it, or of the title held."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ace644fa-39d2-46dd-ad12-394b837ae953",
                                                "sense_id": "fd788187-7fb0-3261-b3c1-7ef5b4c23586",
                                                "text": "The President of the Republic of France is, ex officio, also prince of the dyarchy called Andorra."
                                            },
                                            {
                                                "example_id": "4e104aff-f906-4df2-b33d-c49fd1cf9cfc",
                                                "sense_id": "fd788187-7fb0-3261-b3c1-7ef5b4c23586",
                                                "text": "That friend […] added, with a smile, that he had more than once amused himself with the thought of a verbarian Attorney-General, authorized to bring informations ex officio against the writer or editor of any work in extensive circulation, who, after due notice issued, should persevere in misusing a word."
                                            },
                                            {
                                                "example_id": "4229d0bc-34e5-4f32-9d50-ee45e5de0831",
                                                "sense_id": "fd788187-7fb0-3261-b3c1-7ef5b4c23586",
                                                "text": "In the South every negro preacher is ex officio a D.D., and is commonly addressed as Doctor. This enables white Southerners to show a decent respect for his sacred office, and yet avoid the solecism of calling him Mister."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ex officio",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f51dcc8a-e34e-3b1d-b714-ecc23b00b9fd",
                                        "entry_id": "00ff3eaf-cb64-3bc7-818d-a8f0eeea09a2",
                                        "glosses": [
                                            "By virtue of the office that originated it, or of the title held."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17a30d31-e6c4-45c1-b2cd-4d1754374795",
                                                "sense_id": "f51dcc8a-e34e-3b1d-b714-ecc23b00b9fd",
                                                "text": "Duties include […] sitting as ex-officio member of the Board of Directors and all Board committees."
                                            },
                                            {
                                                "example_id": "268d7a8b-30b7-478a-af55-f2a065c1bf5d",
                                                "sense_id": "f51dcc8a-e34e-3b1d-b714-ecc23b00b9fd",
                                                "text": "Meanwhile, to Samsonov’s annoyance, Colonel Knox had arrived in Ostrolenka. Why, nobody knew—probably just to convey the goodwill of the British, who would not themselves be landing on the Continent for another six months. Samsonov disliked those artificial, ex officio European smiles at the best of times, and this visitor would be a hindrance and a distraction just at present."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
