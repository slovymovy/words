                "senses": [
                    {
                        "sense_id": "733456b6-ee6b-3a19-aa53-3eb01fa5d991",
                        "entry_id": "74534671-56c2-327f-b191-2d62c15851a6",
                        "glosses": [
                            "groep muzikanten die ieder een strijkinstrument bespelen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8fb6812f-5661-4455-a6d5-2eff31e2f4ad",
                                "sense_id": "733456b6-ee6b-3a19-aa53-3eb01fa5d991",
                                "text": "Een van de stukken die ze speelden was het Concert voor altviool en strijkorkest van de Amsterdamse componist Leo Smit. Smit was geboren in een Sefardisch joodse familie en cum laude afgestudeerd aan het Amsterdams Conservatorium."
                            },
                            {
                                "example_id": "e1889f9e-9b4e-4f14-b145-058fcb49f0ad",
                                "sense_id": "733456b6-ee6b-3a19-aa53-3eb01fa5d991",
                                "text": "In de hoek bij de slaapgebouwen stond een podium opgesteld waarop een strijkorkest een moedige poging deed Vivaldi's Vier Jaargetijden te spelen."
                            },
                            {
                                "example_id": "56003901-f92f-4d0d-9a93-ed65b0650b0a",
                                "sense_id": "733456b6-ee6b-3a19-aa53-3eb01fa5d991",
                                "text": "Koorzangers en strijkorkesten maken geen gebruik van toetsen en kunnen daardoor élke toonhoogte produceren, en wel loepzuivere noten voortbrengen. Dit geeft een heel speciaal effect, zegt Klapwijk. Muziek kan dan hemels klinken."
                            }
                        ]
                    },
                    {
                        "sense_id": "657f21bc-9855-39de-90a5-f62563b4ceaf",
                        "entry_id": "74534671-56c2-327f-b191-2d62c15851a6",
                        "glosses": [
