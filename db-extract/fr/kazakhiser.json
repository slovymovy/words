                "senses": [
                    {
                        "sense_id": "c643c905-c217-3622-b592-e5fc12f0b46a",
                        "entry_id": "c91d5daf-3b81-3de7-9204-b4a241d64a2b",
                        "glosses": [
                            "Donner un caractère kazakh à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c6cd2f2-7bff-4e4a-a14f-d4093168f8fb",
                                "sense_id": "c643c905-c217-3622-b592-e5fc12f0b46a",
                                "text": "En changeant de capitale, c'est tout le nord du Kazakhstan, autrefois à majorité russe, que le président tente aussi de \"kazakhiser\"."
                            },
                            {
                                "example_id": "f45d7bf8-3bab-4e3b-bbdb-c0231df5a8df",
                                "sense_id": "c643c905-c217-3622-b592-e5fc12f0b46a",
                                "text": "En théorie, c'est obligatoire dans l'administration, car le président veut « kazakhiser » le Kazakhstan."
                            },
                            {
                                "example_id": "63b7987f-35dc-4bb0-bdf7-8e42e488fc01",
                                "sense_id": "c643c905-c217-3622-b592-e5fc12f0b46a",
                                "text": "Ils ont \"kazakhisé\" le nom."
                            }
                        ]
                    }
