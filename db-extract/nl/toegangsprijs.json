                                    {
                                        "sense_id": "ddc78dd9-8474-38e8-960b-bf823c166dfc",
                                        "entry_id": "2d329420-5344-3868-8a27-c41319ee9099",
                                        "glosses": [
                                            "Entgelt, das für das Betreten von Einrichtungen oder Besuchen von Veranstaltungen zu bezahlen ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c785ced-0acd-4d49-b8f4-2a1922bc5112",
                                                "sense_id": "ddc78dd9-8474-38e8-960b-bf823c166dfc",
                                                "text": "Die Eintrittspreise wurden um 5% erhöht."
                                            },
                                            {
                                                "example_id": "7a58de17-09f7-4a76-8f8a-a8d36797640b",
                                                "sense_id": "ddc78dd9-8474-38e8-960b-bf823c166dfc",
                                                "text": "Die Broschüre ist im Eintrittspreis enthalten."
                                            },
                                            {
                                                "example_id": "03cc2d47-707c-4e39-b1f6-b6214ed1d4b7",
                                                "sense_id": "ddc78dd9-8474-38e8-960b-bf823c166dfc",
                                                "text": "Kinder bezahlen einen ermäßigten Eintrittspreis."
                                            },
                                            {
                                                "example_id": "58e278a0-6d63-4d79-87a9-c05da5839ffb",
                                                "sense_id": "ddc78dd9-8474-38e8-960b-bf823c166dfc",
                                                "text": "„Doch die meisten Häuser waren Abend für Abend gut besucht bis ausverkauft; es gab genügend Berliner, die sich die Eintrittspreise leisten konnten.“"
                                            },
                                            {
                                                "example_id": "acecf83c-b576-42ec-a31f-ff8bc95d72bb",
                                                "sense_id": "ddc78dd9-8474-38e8-960b-bf823c166dfc",
                                                "text": "„Sicher will man mit den frei werdenden Mitteln notleidenden Rentnern eine Freude machen oder die Eintrittspreise ermäßigen.“"
                                            }
                                        ],
