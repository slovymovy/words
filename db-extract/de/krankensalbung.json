                        "entry_id": "f00c5c9b-73ca-3c28-a236-624423042689",
                        "glosses": [
                            "sakramentale Salbung als Stärkung und Ermutigung schwer erkrankter Gläubiger"
                        ],
                        "tags": [
                            "speziell Katholizismus"
                        ],
                        "examples": [
                            {
                                "example_id": "6ae1fbfa-8cd9-470f-b0ed-77edc7bc8c10",
                                "sense_id": "d8e41703-b2e7-300a-ac28-ae5e43e99294",
                                "text": "Drei Tage vor ihrem Tod spendete der Krankenhauspfarrer ihr die Krankensalbung."
                            },
                            {
                                "example_id": "9c3900fc-9102-447d-ab61-a2592dfb25b5",
                                "sense_id": "d8e41703-b2e7-300a-ac28-ae5e43e99294",
                                "text": "Bei der Krankensalbung wird nicht nach katholischem Ritus Krankenöl (geweihtes Olivenöl, im Notfall ein anderes Pflanzenöl) verwendet."
                            }
                        ],
