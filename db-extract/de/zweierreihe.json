                        "examples": [
                            {
                                "example_id": "82495f0d-f7ef-459f-a479-bfae111bfa80",
                                "sense_id": "3d6f852f-0310-3e6b-83f4-8b1e8c8d5a59",
                                "text": "„Von der polizeilichen Einsatzleitung wird er zeitnah informiert, wie viele Schutzsuchende in den einzelnen Zügen erwartet werden. Sobald der Zug abgefertigt ist, werden diese beinahe militärisch in Zweierreihe von Polizei und Militär eskortiert durch den Bahnhof zum Einsteigeplatz an der Lastenstraße geführt.“"
                            },
                            {
                                "example_id": "d2ce95e6-8de0-4225-99d0-95614e9e4ff9",
                                "sense_id": "3d6f852f-0310-3e6b-83f4-8b1e8c8d5a59",
                                "text": "„In Zweierreihen ziehen sie durch das Ghetto, alle in ihrer besten Kleidung, alle singend.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
