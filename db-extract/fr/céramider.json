                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b6f0babe-b72d-4d22-b601-7c203a128a4d",
                                "sense_id": "f68a6547-5aa8-342e-8377-296deccd0242",
                                "text": "Je vais proposer à ce coiffeur les termes publicitaires suivants \"venez vous faire adipocyter, céramider, glycolipidifier, phospholipidifier, lipoïder...ou, plus simplement, graisser, les cheveux\"."
                            },
                            {
                                "example_id": "d7ee5093-c0cb-493f-999d-e6431b2300e1",
                                "sense_id": "f68a6547-5aa8-342e-8377-296deccd0242",
                                "text": "Je vais \"céramider, t-shirt dryier/serviette micro-fibré\" à fond ma routine!"
                            },
                            {
                                "example_id": "1d9b0490-cde5-4082-ad75-1646037a7aee",
                                "sense_id": "f68a6547-5aa8-342e-8377-296deccd0242",
                                "text": "J’ai appliqué sur cheveux encore un peu humides mon leave-in hibiscus-orange (dernière dose du flacon de 100 ml), une huile de massage du cuir et un beurre céramidé en scellage sur les longueurs et les pointes."
                            }
                        ]
