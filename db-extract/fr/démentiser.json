                "senses": [
                    {
                        "sense_id": "7e67147e-34e8-383d-8b9b-6c045caea3d0",
                        "entry_id": "adab71e9-2b94-3fea-89fd-e2e69d74f106",
                        "glosses": [
                            "Rendre dément."
                        ],
                        "tags": [
                            "Très rare"
                        ],
                        "examples": [
                            {
                                "example_id": "ba706530-d26d-405d-83b1-17486b003f32",
                                "sense_id": "7e67147e-34e8-383d-8b9b-6c045caea3d0",
                                "text": "Ainsi l’ordonnait maître Vidocq, de rude mémoire, chef suprême de la brigade de sûreté, à l’un de ses sujets, espèce d’argousin démentisé et mutilé dans les combats nocturnes, chargé, pour sa retraite, de l’entretien des bureaux enfumés et caverneux de la rue de Jérusalem."
                            },
                            {
                                "example_id": "e42a8180-95ec-4b6f-9047-0686bf7f7767",
                                "sense_id": "7e67147e-34e8-383d-8b9b-6c045caea3d0",
                                "text": "Ou encore, a contrario, l’effet « démentisant » des attitudes d’affolement, de rejet, d’abandon et de contention (que cette dernière soit physique ou chimique)."
                            },
                            {
                                "example_id": "becfcd68-3a1d-4a3f-a5e1-220dc8f87d72",
                                "sense_id": "7e67147e-34e8-383d-8b9b-6c045caea3d0",
                                "text": "lol ça commence à se démentiser"
                            }
                        ]
                    }
