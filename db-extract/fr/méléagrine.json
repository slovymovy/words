                    {
                        "sense_id": "2206e75b-a348-3e21-ac69-5a1f6d50df4d",
                        "entry_id": "14383ac5-67ae-3ba3-86d7-fe86673edb07",
                        "glosses": [
                            "Huître perlière de la mer Rouge et de l’océan Indien."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "688cdea2-0fc7-481a-8a1b-e116d2c9df0d",
                                "sense_id": "2206e75b-a348-3e21-ac69-5a1f6d50df4d",
                                "text": "Perle naturelle et perle de culture ne présentent aucune différence, toutes deux étant produites par une méléagrine."
                            },
                            {
                                "example_id": "dcf459d4-cf73-4159-aa89-b5c623494786",
                                "sense_id": "2206e75b-a348-3e21-ac69-5a1f6d50df4d",
                                "text": "Le naissain des Méléagrines (Meleagrina Martensi Dunker) est recueilli sur des collecteurs en bambou par des plongeuses bien entraînées, appelées « âma » en japonais. Les jeunes Mollusques sont placés dans des cages treillagées pour être à l’abri de leurs dangereux ennemis pendant la période au cours de laquelle ils peuvent le moins bien se défendre."
                            }
                        ]
                    }
