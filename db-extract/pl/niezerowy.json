                        "sense_id": "a3b6f204-5b6a-3a73-b7c6-ea7013e1e511",
                        "entry_id": "73ccfe08-1fe5-3985-99fd-75c95e69fde0",
                        "glosses": [
                            "taki, który nie jest równy zeru"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67259b3c-f5b9-40cc-83f3-ed923c646e80",
                                "sense_id": "a3b6f204-5b6a-3a73-b7c6-ea7013e1e511",
                                "text": "Cząstki obdarzone niezerową masą spoczynkową, jak np. elektrony, poruszają się zawsze z prędkością mniejszą od prędkości światła w próżni, można zatem teoretycznie wyobrazić sobie obserwatora, który by poruszał się szybciej niż one."
                            }
                        ],
