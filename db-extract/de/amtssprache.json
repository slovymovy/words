                        ],
                        "form": "die Amtssprache"
                    },
                    {
                        "form_id": "2345f197-1e5c-4f98-89cc-100ce6c2d1b2",
                        "entry_id": "a781c2f0-db73-35cf-af24-edfee2d29681",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Amtssprachen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6e74975f-f73f-3e3f-adbe-64a993be7826",
                        "entry_id": "a781c2f0-db73-35cf-af24-edfee2d29681",
                        "glosses": [
                            "die offizielle Sprache der Behörden eines Landes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1a6b289-1cd0-40f9-a6b8-0dd207a66c97",
                                "sense_id": "6e74975f-f73f-3e3f-adbe-64a993be7826",
                                "text": "„Die Amtssprache ist Deutsch.“"
                            },
                            {
                                "example_id": "f0d81e9a-4a2e-417d-a2c0-84c5b23b7faa",
                                "sense_id": "6e74975f-f73f-3e3f-adbe-64a993be7826",
                                "text": "„Allein in Südafrika gibt es elf Amtssprachen.“"
                            },
                            {
                                "example_id": "75a3871c-228d-4704-992a-de5d39285431",
                                "sense_id": "6e74975f-f73f-3e3f-adbe-64a993be7826",
                                "text": "Die Landessprache ist oft zugleich die Amtssprache."
                            },
                            {
                                "example_id": "595bece6-b2c0-4450-b070-0c4fd1767d72",
                                "sense_id": "6e74975f-f73f-3e3f-adbe-64a993be7826",
                                "text": "„Die Militärverordnung Nr. 3 von 1945 erklärte Englisch zur Amtssprache auch in Deutschland.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "4390302f-888e-312a-98d0-a9f10b141aea",
                        "entry_id": "a781c2f0-db73-35cf-af24-edfee2d29681",
                        "glosses": [
                            "die offizielle Sprache einer internationalen Organisation"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a18782e2-40ba-48ac-ac05-df3424ad3763",
                                "sense_id": "4390302f-888e-312a-98d0-a9f10b141aea",
                                "text": "„Die Amtssprachen und die Arbeitssprachen der Organe der Gemeinschaft sind Deutsch, Französisch, Italienisch und Niederländisch.“"
                            },
                            {
                                "example_id": "96c44700-0127-4c91-babe-06dc63063939",
                                "sense_id": "4390302f-888e-312a-98d0-a9f10b141aea",
                                "text": "„Deutsch ist selbstverständlich eine der 23 EU-Amtssprachen, die vor allem der Kommunikation zwischen den EU-Organen und den Mitgliedsstaaten dienen. Weniger gesichert ist dagegen die Stellung von Deutsch als eine der internen Arbeitssprachen der Organe, die diese sich laut Artikel 6 der „Verordnung Nr. 1 des Rates zur Regelung der Sprachenfrage“ aus den Amtssprachen auswählen dürfen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "fa83ad5b-208a-3820-878c-97cf26879c71",
                        "entry_id": "a781c2f0-db73-35cf-af24-edfee2d29681",
                        "glosses": [
                            "andere Bezeichnung für die Sprache von Behörden, Gerichten, Verwaltung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5dd2ae92-00b1-468b-83f4-fe09eaa3ee7f",
                                "sense_id": "fa83ad5b-208a-3820-878c-97cf26879c71",
                                "text": "Mit dem Hinweis auf notwendige Fachbegriffe allein ist das inflationäre Kauderwelsch in der Amtssprache nicht zu erklären. Amtliche Schreiben strotzen vor Formulierungen wie der “Erschließungsanlage”, die “zu erschließen ist”, oder “zusatzversorgungspflichtigen Entgelten”, die “zu entrichten sind”."
                            },
                            {
                                "example_id": "4f6a7312-8974-4696-9356-9dec3d2c2a67",
                                "sense_id": "fa83ad5b-208a-3820-878c-97cf26879c71",
                                "text": "„Aber das ist eben typisch Amtssprache.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0033d0fa-1255-41c3-800a-2a19d92c0814",
                        "source_entry_id": "a781c2f0-db73-35cf-af24-edfee2d29681",
                        "source_sense_id": "6e74975f-f73f-3e3f-adbe-64a993be7826",
                        "source_sense_description": "die offizielle Sprache der Behörden eines Landes",
                        "target_lang_word": "official language",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "official language",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c1624ca9-4a57-32de-b2cd-db5cd8ca0473",
                                        "entry_id": "9f9a809f-2549-3e94-ad59-9ad001add8ea",
                                        "glosses": [
                                            "A language afforded an elevated status in a particular country, state, or other jurisdiction, typically for government use."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4106fb3-05e1-4c89-909d-3c09921c35cc",
                                                "sense_id": "c1624ca9-4a57-32de-b2cd-db5cd8ca0473",
                                                "text": "A lot of multilingual countries promote an official language, but the United States has never done so with English. In fact, the US has no official language."
                                            },
                                            {
                                                "example_id": "a083ac9a-97ad-49a8-bedf-9b551af8ad8c",
                                                "sense_id": "c1624ca9-4a57-32de-b2cd-db5cd8ca0473",
                                                "text": "President Donald Trump recently signed an executive order naming English the official language of the United States."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b3e8f026-e4b7-4f55-aecb-f75ac7d72144",
                        "source_entry_id": "a781c2f0-db73-35cf-af24-edfee2d29681",
                        "source_sense_id": "6e74975f-f73f-3e3f-adbe-64a993be7826",
                        "source_sense_description": "die offizielle Sprache der Behörden eines Landes",
                        "target_lang_word": "langue officielle",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "langue officielle",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a1748b2c-5b4a-3f14-9c6c-4d2d808a5aa1",
                                        "entry_id": "db4d72f1-1910-3224-ad4b-0605ca506e23",
                                        "glosses": [
                                            "Idiome d’un État ou d’une organisation stipulé comme tel par la constitution, la loi ou le règlement et qui est adopté pour la rédaction des textes officiels, la communication avec les administrés et, dans le cas d’États, pour l’enseignement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "012976b1-177f-4c5e-9e11-2839a8c24dbf",
                                                "sense_id": "a1748b2c-5b4a-3f14-9c6c-4d2d808a5aa1",
                                                "text": "Rappelons tout de même que les USA n’ont pas de « langue officielle » comme la plupart des autres pays), mais à quel prix ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b5eba95b-ea0e-414a-8a0e-16e99059799d",
