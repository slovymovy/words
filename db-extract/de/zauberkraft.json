                        ],
                        "form": "die Zauberkräfte"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2b3be050-f3d3-3c29-9944-47d686731b76",
                        "entry_id": "f9c8775d-e312-3860-93cc-8302a14ef2ce",
                        "glosses": [
                            "Fähigkeit, magische Handlungen auszuüben, Zauber zu wirken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74453dd1-208a-4dd0-9e38-cdb2d76d3b54",
                                "sense_id": "2b3be050-f3d3-3c29-9944-47d686731b76",
                                "text": "Manche Märchenfiguren verfügen über Zauberkräfte."
                            },
                            {
                                "example_id": "d567decd-4494-4ff8-8b45-ec0e959e4405",
                                "sense_id": "2b3be050-f3d3-3c29-9944-47d686731b76",
                                "text": "„Und dabei erzählte er Geschichten von der Zauberkraft der Katzen und daß eine dreifarbige Katze den Hof vor Feuer schützt.“"
                            },
                            {
                                "example_id": "2b7a8ff2-8c48-4074-b7eb-31b9cdf44196",
                                "sense_id": "2b3be050-f3d3-3c29-9944-47d686731b76",
                                "text": "„Entweder machten sich die Leute, die Zauberwurzeln verkauften, der Hexerei schuldig, oder die Alraune hatte gar keine Zauberkräfte, dann ging es um Betrug.“"
                            },
                            {
                                "example_id": "4f1f104b-5255-4974-9735-78dba777b826",
                                "sense_id": "2b3be050-f3d3-3c29-9944-47d686731b76",
                                "text": "„Paradoxerweise schien mein Glaube an die Magie damit mehr verbunden als mit allen Ideen von Zauberkraft und fantastischen Wesen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a1b32eeb-f668-345d-8569-71af3d1d5669",
                        "entry_id": "f9c8775d-e312-3860-93cc-8302a14ef2ce",
                        "glosses": [
                            "übernatürliche Wirkung eines Zaubers; Kraft, die einem Zauber innewohnt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d52bdc1b-cab8-447f-9f53-ddc0c0c7bb20",
                                "sense_id": "a1b32eeb-f668-345d-8569-71af3d1d5669",
                                "text": "Die Zauberkraft eines Lächelns hilft nicht nur beim Verkaufsgespräch."
                            },
                            {
                                "example_id": "d0790c14-203c-4d1f-9b58-b960f55879f6",
                                "sense_id": "a1b32eeb-f668-345d-8569-71af3d1d5669",
                                "text": "„Der Skeptiker betrachtet die kleine Gabe, wundert sich, daß das dünne Blech [Geld] eine so große Zauberkraft besitzen solle, […]“"
                            },
                            {
                                "example_id": "692ccc9a-4510-4d70-9482-6ae5bcb06b79",
                                "sense_id": "a1b32eeb-f668-345d-8569-71af3d1d5669",
                                "text": "„Wie durch Zauberkraft sank das Selbstbewußtsein der Zuhörer, machte sich Unsicherheit im Auditorium geltend.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
