                "translations": [
                    {
                        "translation_id": "960fc117-21b3-4a4e-b713-6d9cb98761ea",
                        "source_entry_id": "e8636a35-4e25-3a2b-829a-bfdb5b8568b1",
                        "source_sense_id": "bb9ecbcc-e8df-37d8-a9f3-bd6479b8849c",
                        "source_sense_description": "remove minerals",
                        "target_lang_word": "entmineralisieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "entmineralisieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c475c300-a525-3959-9c50-2afbf82c71a4",
                                        "entry_id": "48d9939f-32e3-3f54-b9c6-b673e95978b3",
                                        "glosses": [
                                            "bestimmte Stoffe (Mineralien, Ionen und Salze) aus etwas entfernen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9da9f7df-90ae-4fc0-b598-95a78850be96",
                                                "sense_id": "c475c300-a525-3959-9c50-2afbf82c71a4",
                                                "text": "„Wir entkeimen, entchloren, entstrahlen, entgiften, entsäuern, enthärten, entmineralisieren, konditionieren, klarfiltern u.a.m. richtiges Wasser.“"
                                            },
                                            {
                                                "example_id": "889dd2ec-a1fe-432d-9500-7a403585cefc",
                                                "sense_id": "c475c300-a525-3959-9c50-2afbf82c71a4",
                                                "text": "„Natürliches Wasser ist nicht rein. Es enthält gelöste Salze und kann mit Hilfe von Ionenaustauschern oder durch Destillieren in Quarzgefäßen von seinen Verunreinigungen befreit werden (Entmineralisieren).“"
                                            },
                                            {
                                                "example_id": "7a452b3d-bd92-4bb0-ae05-12bf89c5dfc2",
                                                "sense_id": "c475c300-a525-3959-9c50-2afbf82c71a4",
                                                "text": "„Grundsätzlich ist entmineralisiertes Wasser trinkbar ohne unmittelbarer Gefährdung der Gesundheit, allerdings wird von einer dauerhaften Einnahme abgeraten, da dem Körper wichtige Mineralien entzogen werden können.“"
                                            },
                                            {
                                                "example_id": "aa7846e7-c8bb-4a8f-826e-d64f344e8a89",
                                                "sense_id": "c475c300-a525-3959-9c50-2afbf82c71a4",
                                                "text": "„Als Mechanismus der Hormonwirkung nimmt man heute in erster Linie eine Mobilisation des Knochenkalkes an, da es gelingt, das Skelet durch große Hormondosen weitgehend zu entmineralisieren.“"
                                            },
                                            {
                                                "example_id": "6570ee3b-a356-475d-8b32-fbf1647cd2ed",
                                                "sense_id": "c475c300-a525-3959-9c50-2afbf82c71a4",
                                                "text": "„Dadurch werden Knochen, Gelenke oder das Gebiss entmineralisiert, und das kann auf längere Sicht zu Osteoporose, Arthrose oder einer ausgedünnten, anfälligen Zahnsubstanz führen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
