                        "glosses": [
                            "советск. руководитель партийной группы"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0307257c-8e54-4f7e-b10a-0786dcc0b956",
                                "sense_id": "b01baa06-bf11-3649-97b7-2ca13755b421",
                                "text": "Партгрупорг избирается на собрании партийной группы закрытым (тайным) голосованием сроком на один год."
                            },
                            {
                                "example_id": "437dc7ea-adce-40b2-8d2e-4b8d8c4ffedd",
                                "sense_id": "b01baa06-bf11-3649-97b7-2ca13755b421",
                                "text": "— Я лично своей работой как партгрупорга, так и деятельностью партгруппы в целом недовольна..."
                            }
                        ]
                    }
