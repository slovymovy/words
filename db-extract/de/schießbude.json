                        "entry_id": "a880f7f0-62a7-3a6b-853a-caa081e1831b",
                        "glosses": [
                            "Stand, an dem man durch geschicktes Schießen die ausgestellten Gegenstände gewinnen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c852d904-a438-4002-8bcb-8149c90680bf",
                                "sense_id": "5177360f-f5a9-379c-8d7b-2d8296f29be1",
                                "text": "Auf einem Jahrmarkt gibt es neben vielen anderen auch Schießbuden."
                            },
                            {
                                "example_id": "54c94630-6ff4-4397-b4db-28ba8b892d1a",
                                "sense_id": "5177360f-f5a9-379c-8d7b-2d8296f29be1",
                                "text": "„Hildegard war mit der Tante Wojtaszak befreundet, die auf dem Rummelplatz neben der Grube »Königin Luise« eine Schießbude besaß.“"
                            },
                            {
                                "example_id": "01afd804-689f-4097-980e-3567a1878ce4",
                                "sense_id": "5177360f-f5a9-379c-8d7b-2d8296f29be1",
                                "text": "„Lilo hatte eine bunte Decke über das Bett und einen alten Samtvorhang aus der Schießbude über Kerns Lager gebreitet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "96907ba2-732b-3413-ad7f-e33d8f12beb1",
