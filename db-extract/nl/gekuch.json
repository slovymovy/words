        "nl-extract.jsonl": [
            {
                "entry_id": "e7ea9a51-0c84-3de4-a344-4333c828f458",
                "word": "gekuch",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "693005b5-6e7f-329c-be6b-7994f21ba7e7",
                        "entry_id": "e7ea9a51-0c84-3de4-a344-4333c828f458",
                        "glosses": [
                            "aanhoudend zachtjes hoesten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "039f4846-06d1-4b75-8404-dcf37f920aae",
                                "sense_id": "693005b5-6e7f-329c-be6b-7994f21ba7e7",
                                "text": "Twee dubbeldekkers vol boze Groningers zijn naar Den Haag gekomen om het debat te volgen. De toeschouwers kunnen hun emoties soms nauwelijks bedwingen en trakteren de politici op gekuch, gejoel, maar ook applaus."
                            },
                            {
                                "example_id": "81adab57-7ce2-4419-8fec-87e35e8b2ee8",
                                "sense_id": "693005b5-6e7f-329c-be6b-7994f21ba7e7",
                                "text": "Veel Nederlanders gaan met koorts, gesnotter en gekuch het nieuwe jaar in. Ons land wordt nu al zo'n drie weken geteisterd door een griepgolf, blijkt uit cijfers van het Nederlands Instituut voor onderzoek van de gezondheidszorg (Nivel). Huisartsen zien vooral baby’s en kleine kinderen tot vier jaar langskomen met griepklachten. De kleintjes hebben opvallend vaak het verkoudheidsvirus RS opgelopen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fff39214-4a30-4c33-9404-48fd1e461191",
                        "source_entry_id": "e7ea9a51-0c84-3de4-a344-4333c828f458",
                        "source_sense_id": "693005b5-6e7f-329c-be6b-7994f21ba7e7",
                        "target_lang_word": "cough",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cough",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "de94863d-038f-30e8-9c4f-4ed76a965351",
                                        "entry_id": "70016ce8-2f2f-35c6-bac5-8a9fe059d688",
                                        "glosses": [
                                            "Sometimes followed by up: to force (something) out of the lungs or throat by pushing air from the lungs through the glottis (causing a short, explosive sound), and out through the mouth."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "727312d9-c81f-43bb-b8f5-a66320e84241",
                                                "sense_id": "de94863d-038f-30e8-9c4f-4ed76a965351",
                                                "text": "Sometimes she coughed up blood."
                                            },
                                            {
                                                "example_id": "ee9c9437-86e5-4258-a0d4-dcd2f78ba274",
                                                "sense_id": "de94863d-038f-30e8-9c4f-4ed76a965351",
                                                "text": "Jeeves coughed one soft, low, gentle cough like a sheep with a blade of grass stuck in its throat, and then stood gazing serenely at the landscape."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a7acb9d2-1031-3975-9739-b8f3537e6f3a",
                                        "entry_id": "70016ce8-2f2f-35c6-bac5-8a9fe059d688",
                                        "glosses": [
                                            "To cause (oneself or something) to be in a certain condition in the manner described in sense 1.1."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c81fab00-f20e-47ef-9510-7099d8f8113b",
                                                "sense_id": "a7acb9d2-1031-3975-9739-b8f3537e6f3a",
                                                "text": "He almost coughed himself into a fit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95f0498d-bd0a-342b-85e8-5bb46f8d45d1",
                                        "entry_id": "70016ce8-2f2f-35c6-bac5-8a9fe059d688",
                                        "glosses": [
                                            "To express (words, etc.) in the manner described in sense 1.1."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2b64971-4df7-4032-9ea7-f459427f7a1f",
                                                "sense_id": "95f0498d-bd0a-342b-85e8-5bb46f8d45d1",
                                                "text": "No ſtationary ſteeds / Cough their ovvn knell, vvhile heedleſs of the ſound / The ſilent circle fan themſelves, and quake."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e6fd4d8f-072a-3366-8d96-59e3b193bea0",
                                        "entry_id": "70016ce8-2f2f-35c6-bac5-8a9fe059d688",
                                        "glosses": [
                                            "To surrender (information); to confess."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "918415ba-c1fc-3201-b04f-23ddbd4d2901",
                                        "entry_id": "70016ce8-2f2f-35c6-bac5-8a9fe059d688",
                                        "glosses": [
                                            "Chiefly followed by up: to give up or hand over (something); especially, to pay up (money)."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee17c2a9-725d-45cd-98fc-9509ee13a122",
                                                "sense_id": "918415ba-c1fc-3201-b04f-23ddbd4d2901",
                                                "text": "By the time you get back the men will all be striking out for the fire, and we'll break for the house and collar the dollars. Everybody cough up what matches he's got."
                                            },
                                            {
                                                "example_id": "bd9cdade-b491-4a58-815c-d85a7c5c1b2a",
                                                "sense_id": "918415ba-c1fc-3201-b04f-23ddbd4d2901",
                                                "text": "Thanks to Jeeves I was not going to be called on to cough up several thousand quid."
                                            },
                                            {
                                                "example_id": "76ce4b5e-e6eb-41bd-b633-eb29a608d998",
                                                "sense_id": "918415ba-c1fc-3201-b04f-23ddbd4d2901",
                                                "text": "\"Parsloe, will you or will you not cough up that pig?\" / \"I have not got your pig.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "626db2db-94e2-32d9-8506-f0b19aab05b0",
                                        "entry_id": "70016ce8-2f2f-35c6-bac5-8a9fe059d688",
                                        "glosses": [
                                            "To push air from the lungs through the glottis (causing a short, explosive sound) and out through the mouth, usually to expel something blocking or irritating the airway."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c750b20e-1509-4ded-a12c-ba0042cc4f56",
                                                "sense_id": "626db2db-94e2-32d9-8506-f0b19aab05b0",
                                                "text": "I breathed in a lungful of smoke by mistake, and started to cough."
                                            },
                                            {
                                                "example_id": "a65fe8a6-153a-4e51-a987-d40b406b038f",
                                                "sense_id": "626db2db-94e2-32d9-8506-f0b19aab05b0",
                                                "text": "Yet notwithſtandyng all this geare, / thou cougheſt ſtill, perdy / Ye are a craftie knaue, you cough / to fare deliciouſly."
                                            },
                                            {
                                                "example_id": "e9ddef24-4609-43cc-8806-219b53f4666b",
                                                "sense_id": "626db2db-94e2-32d9-8506-f0b19aab05b0",
                                                "text": "Leave procreants alone, and ſhut the dore, / Coffe, or cry hem, if any body come, […]"
                                            },
                                            {
                                                "example_id": "f16477c4-66af-4731-ac9f-096c10527176",
                                                "sense_id": "626db2db-94e2-32d9-8506-f0b19aab05b0",
                                                "text": "\"Did your lordship's servant see Simon Glover and his daughter?\" said Henry, struggling for breath, and coughing, to conceal from the Provost the excess of his agitation."
                                            },
                                            {
                                                "example_id": "734741b4-2591-40bd-a382-aed48657a68d",
                                                "sense_id": "626db2db-94e2-32d9-8506-f0b19aab05b0",
                                                "text": "But often, when thy face [i.e., that of a horse] is turned from the stable, thou hast an unaccountable desire to place it in the position occupied by thy tail: thou stoppest, coughest, shyest, and erst, with swift detorsion, turnest round, then, with sidelong glance of my magic caduceus, ominously wagging between the horizon and thy ample sides, I incite thee on, but rarely does thy pace more than trot, from home."
                                            },
                                            {
                                                "example_id": "1e5bb010-7a06-47f7-a100-7d19f086240a",
                                                "sense_id": "626db2db-94e2-32d9-8506-f0b19aab05b0",
                                                "text": "Tossivi / Tu tossais / Thou coughedst",
                                                "translation": "The Improvised Polyglot, or The Art of Writing Languages without Learning Them. […]",
                                                "english": "The Improvised Polyglot, or The Art of Writing Languages without Learning Them. […]"
                                            },
                                            {
                                                "example_id": "ceb8ff51-bf23-4ed8-ba65-defdf3da8236",
                                                "sense_id": "626db2db-94e2-32d9-8506-f0b19aab05b0",
                                                "text": "After this he fell a-coughing violently, and Stanbury thought it better to leave him."
                                            },
                                            {
                                                "example_id": "480c4e5a-5a57-490e-8e44-9f6d9ec1740d",
                                                "sense_id": "626db2db-94e2-32d9-8506-f0b19aab05b0",
                                                "text": "\"But it is unfortunate—you find me at the moment—\" and he stopped short and coughed."
                                            },
                                            {
                                                "example_id": "9f05a4a2-3d10-412f-a2fe-c86da1c16337",
                                                "sense_id": "626db2db-94e2-32d9-8506-f0b19aab05b0",
                                                "text": "I drew a deep breath, and a moment later wished I hadn't, because I drew it while drinking the remains of my gin and tonic. “Does Kipper know of this?“ I said, when I had finished coughing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a2ba935-7517-38a3-9bab-90d9d70267f5",
                                        "entry_id": "70016ce8-2f2f-35c6-bac5-8a9fe059d688",
                                        "glosses": [
                                            "To make a noise like a cough."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f50c2065-0c13-4d7d-8913-5f05b208fef0",
                                                "sense_id": "4a2ba935-7517-38a3-9bab-90d9d70267f5",
                                                "text": "The engine coughed and sputtered."
                                            },
                                            {
                                                "example_id": "0d95f3f8-7ca1-4482-bafa-d42b55cf92e9",
                                                "sense_id": "4a2ba935-7517-38a3-9bab-90d9d70267f5",
                                                "text": "Wake up, by-and-by, and look to see what done it, and maybe see a steamboat, coughing along up stream, so far off towards the other side you couldn't tell nothing about her only whether she was stern-wheel or side-wheel; then for about an hour there wouldn't be nothing to hear nor nothing to see—just solid lonesomeness."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c5dafa02-c747-312e-abbb-ebc78f2d1f3a",
                                        "entry_id": "70016ce8-2f2f-35c6-bac5-8a9fe059d688",
                                        "glosses": [
                                            "To surrender information; to confess, to spill the beans."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "cough",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e086a060-7082-33e5-9fee-89b3a3b45c53",
                                        "entry_id": "88c7497a-5c2a-39e5-911a-d4bba6bc0a36",
                                        "glosses": [
                                            "A sudden, often involuntary expulsion of air from the lungs through the glottis (causing a short, explosive sound), and out through the mouth."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f9da522-7b42-430b-9bfa-9b00f5a5ae4a",
                                                "sense_id": "e086a060-7082-33e5-9fee-89b3a3b45c53",
                                                "text": "Behind me, I heard a distinct, dry cough."
                                            },
                                            {
                                                "example_id": "690f053e-0b9c-41cd-bfaa-62ba3fddba57",
                                                "sense_id": "e086a060-7082-33e5-9fee-89b3a3b45c53",
                                                "text": "[I]t conduceth helpe to the crudities, humidities, and vvindineſſe of the ſtomacke and belly, and to helpe the ſhortneſſe of breath and coughes: […]"
                                            },
                                            {
                                                "example_id": "d240ff79-a9a5-418c-9fd7-f017aaabc7c9",
                                                "sense_id": "e086a060-7082-33e5-9fee-89b3a3b45c53",
                                                "text": "The lumpiſh husband ſnoar'd avvay the night, / Till coughs avvak'd him near the morning light."
                                            },
                                            {
                                                "example_id": "66e7e586-c8d6-4e71-9899-6a6aa7eb185e",
                                                "sense_id": "e086a060-7082-33e5-9fee-89b3a3b45c53",
                                                "text": "Dwining ventured to give a low cough once or twice, by way of signal; […]"
                                            },
                                            {
                                                "example_id": "c9b2784b-af66-43e0-ae82-a6a309fd3441",
                                                "sense_id": "e086a060-7082-33e5-9fee-89b3a3b45c53",
                                                "text": "One saint's day in mid-term a certain newly appointed suffragan-bishop came to the school chapel, and there preached on “The Inner Life.” He at once secured attention by his informal method, and when presently the coughing of Jarvis and another boy interrupted the sermon, he altogether captivated his audience with a remark about cough lozenges being cheap and easily procurable."
                                            },
                                            {
                                                "example_id": "2b5f3867-0243-4fd4-8754-6229ea0bca93",
                                                "sense_id": "e086a060-7082-33e5-9fee-89b3a3b45c53",
                                                "text": "Jeeves coughed one soft, low, gentle cough like a sheep with a blade of grass stuck in its throat, and then stood gazing serenely at the landscape."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "feddaaae-b298-3a2b-a6c7-8325999d3c5b",
                                        "entry_id": "88c7497a-5c2a-39e5-911a-d4bba6bc0a36",
                                        "glosses": [
                                            "A bout of repeated coughing (verb sense 2.1); also, a medical condition that causes one to cough."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db4d332b-0422-4abb-aecf-1cd7c96c095d",
                                                "sense_id": "feddaaae-b298-3a2b-a6c7-8325999d3c5b",
                                                "text": "whooping cough"
                                            },
                                            {
                                                "example_id": "006ced2e-699a-4a13-b397-425a081394a8",
                                                "sense_id": "feddaaae-b298-3a2b-a6c7-8325999d3c5b",
                                                "text": "Sorry, I can’t come to work today—I’ve got a nasty cough."
                                            },
                                            {
                                                "example_id": "4e5b10f3-1afe-4886-8cfc-701dbc35aa12",
                                                "sense_id": "feddaaae-b298-3a2b-a6c7-8325999d3c5b",
                                                "text": "[John] Fal[staff]. VVhat diſeaſe haſt thou? / [Peter] Bul[lcaff]. A horſon cold ſir, a cough ſir, vvhich I cought vvith ringing in the Kings affaires vpon his coronation day ſir."
                                            },
                                            {
                                                "example_id": "33d7e4d4-97d1-4f1e-9dc2-03a73595c570",
                                                "sense_id": "feddaaae-b298-3a2b-a6c7-8325999d3c5b",
                                                "text": "Cough! you don't need to tell me about a cough. I've always been subject to a cough, all my days. […] O! Eva's cough is not anything."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "637a2255-751e-374b-a3fd-fb7193adcf9f",
                                        "entry_id": "88c7497a-5c2a-39e5-911a-d4bba6bc0a36",
                                        "glosses": [
                                            "A noise or sound like a cough (sense 1)."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7dd61026-9033-38f8-b83c-09605871cc09",
                                        "entry_id": "88c7497a-5c2a-39e5-911a-d4bba6bc0a36",
                                        "glosses": [
                                            "A vocalisation from a bird or other animal resembling a human cough."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "cough",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "48916752-0d4d-3b0c-9ca5-77d81ce7f552",
                                        "entry_id": "8031df2b-d7b4-3417-b89a-dcc9c7bf2071",
                                        "glosses": [
                                            "Used to represent the sound of a cough (noun sense 1), especially when focusing attention on a following utterance, often an attribution of blame or a euphemism: ahem."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6587c8ed-03c8-409e-b713-f4c6927cd29f",
                                                "sense_id": "48916752-0d4d-3b0c-9ca5-77d81ce7f552",
                                                "text": "He was—cough—indisposed."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
