                    {
                        "translation_id": "d3098cfc-6e58-4895-8aab-74efc88f5788",
                        "source_entry_id": "e83615da-a4f3-3365-af1b-dff7ecaa8aeb",
                        "source_sense_description": "decrease in the general price level",
                        "target_lang_word": "Deflation",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Deflation",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "665cbbb0-1f25-3074-a5c1-f87a2daa8fdf",
                                        "entry_id": "c0589b7c-665d-3a17-9d44-9b7ba5e93707",
                                        "glosses": [
                                            "Genereller und dauerhafter Rückgang der Preise für Produkte und Dienstleistungen, verbunden mit abwartender Kaufzurückhaltung der Verbraucher in der Hoffnung auf weitere Preissenkungen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6958206a-6b73-4889-a99f-86e0ae4d59d9",
                                                "sense_id": "665cbbb0-1f25-3074-a5c1-f87a2daa8fdf",
                                                "text": "„Für eine Volkswirtschaft kann eine Deflation nach Einschätzung von Ökonomen wegen dieser Eigendynamik verheerendere Auswirkungen haben als eine Inflation, die durch steigende Preise gekennzeichnet ist.“"
                                            },
                                            {
                                                "example_id": "7a05a402-c0ee-4df6-b2c5-6d8ce64dc002",
                                                "sense_id": "665cbbb0-1f25-3074-a5c1-f87a2daa8fdf",
                                                "text": "Deflation gibt Verbrauchern den Anreiz, ihr Geld zu horten, weil ihre Guthaben ja Monat für Monat mehr wert werden. Deflation ist schließlich schlecht für jeden, der einen Kredit aufgenommen hat, denn auch Schulden werden real ständig mehr wert."
                                            },
                                            {
                                                "example_id": "7b385aec-46d3-4aee-9408-45e29b0fb589",
                                                "sense_id": "665cbbb0-1f25-3074-a5c1-f87a2daa8fdf",
                                                "text": "„Die Inflation ist sofort zur Deflation geworden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8ad3082b-f002-311f-a0e8-c16451d5bc08",
                                        "entry_id": "c0589b7c-665d-3a17-9d44-9b7ba5e93707",
                                        "glosses": [
                                            "Abtragung des lockeren Gesteins durch den Wind"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "666dbf91-2489-4ab4-be98-6b20fee582f3",
                                                "sense_id": "8ad3082b-f002-311f-a0e8-c16451d5bc08",
                                                "text": "Sehr bedeutende Hohlformen sind nach den Beobachtungen von Erich Kaiser (1926) durch die vereinte Wirkung von Deflation und Korrasion in der Wannen-Namib entstanden."
                                            },
                                            {
                                                "example_id": "5c904c3e-f211-4fe1-b570-468b959ee021",
                                                "sense_id": "8ad3082b-f002-311f-a0e8-c16451d5bc08",
                                                "text": "Am Wannenboden findet durch gelegentliche Benetzung mit salzigem Wasser nach seltenem Regen eine verstärkte Gesteinsaufbereitung statt, die die Deflation dort erleichtert."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
