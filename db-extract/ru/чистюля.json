                                    {
                                        "sense_id": "9e3021f7-7899-3767-9380-c9c80261dad0",
                                        "entry_id": "98e1807d-cd8a-381c-9636-9df09e282d96",
                                        "glosses": [
                                            "A stickler for neatness or cleanliness."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ad18010-5a98-4e20-a1cb-2a28d47ddf36",
                                                "sense_id": "9e3021f7-7899-3767-9380-c9c80261dad0",
                                                "text": "His mom is such a neatnik that a dirty dish never even hits her sink."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
