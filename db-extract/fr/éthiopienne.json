                    {
                        "form_id": "d6d98ccb-d9f7-435b-af3e-f3198a711e6c",
                        "entry_id": "372e9cb9-a953-30dc-aa65-d5d2fac66334",
                        "tags": [
                            "masculine"
                        ],
                        "form": "Éthiopien"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8cbcac62-4d97-3709-9cb7-57c7c809f216",
                        "entry_id": "372e9cb9-a953-30dc-aa65-d5d2fac66334",
                        "glosses": [
                            "Habitante d’Éthiopie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e71a0032-fa48-428f-8eb8-9d74ad8e7cd7",
                                "sense_id": "8cbcac62-4d97-3709-9cb7-57c7c809f216",
                                "text": "Comme le dit Homère, pour les femmes du haut rang dans l’antiquité, les Éthiopiennes riches portent leur toge traînante à terre."
                            },
                            {
                                "example_id": "904ce0f2-d447-4f15-b5a5-64094b9aa30b",
                                "sense_id": "8cbcac62-4d97-3709-9cb7-57c7c809f216",
                                "text": "Jacqueline Boivin s'était assise à leur table, un cartable d'écolier sur ses genoux, et sa grâce d'Éthiopienne émerveillait Louis."
                            },
                            {
                                "example_id": "d371d8e7-ff59-4371-8aa5-f467abe17788",
                                "sense_id": "8cbcac62-4d97-3709-9cb7-57c7c809f216",
                                "text": "Dans « Le Traité de la vie contemplative », allégorie religieuse du XVᵉ siècle, Jésus épouse une Éthiopienne, symbole de l’âme noircie du pécheur."
                            }
                        ]
                    }
                ],
