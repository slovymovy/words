                                    {
                                        "sense_id": "212e79a4-6d12-3930-bd16-1a41616af851",
                                        "entry_id": "69a70f32-b9f2-3517-aba1-d4cd91406183",
                                        "glosses": [
                                            "D’une nuance de blond qui ressemble à de la filasse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd5e1937-979a-4a21-9134-2d342f0e4141",
                                                "sense_id": "212e79a4-6d12-3930-bd16-1a41616af851",
                                                "text": "Son visage est criblé de taches de rousseur, ses cheveux, blond filasse, rares et ternes, laissent voir des parties de crâne, au sommet duquel se hérisse drôlement, et pareil à un petit balai, un chignon."
                                            },
                                            {
                                                "example_id": "c6ebe248-f22a-4974-b3b8-6d85c9964bf3",
                                                "sense_id": "212e79a4-6d12-3930-bd16-1a41616af851",
                                                "text": "Un petit homme, au nez de pie tourné à la friandise, les cheveux blond filasse aplatis sur le front, et les yeux bleu faïence, venait de s’avancer sur la porte […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "blond filasse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2f2e7b28-3728-3f89-aaa9-c682cf61a1a6",
                                        "entry_id": "391b1c27-72ef-3301-a926-dc6565d66e39",
                                        "glosses": [
                                            "Nuance de blond qui ressemble à de la filasse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72bb01c8-1c7a-4b33-8b46-c3fbf921eff2",
                                                "sense_id": "2f2e7b28-3728-3f89-aaa9-c682cf61a1a6",
                                                "text": "C’étaient certainement des étrangers, s’il fallait accorder quelque foi à leurs costumes de voyage, à leurs cheveux d’un blond filasse."
                                            }
                                        ]
                                    }
                                ]
                            }
