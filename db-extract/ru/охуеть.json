                "senses": [
                    {
                        "sense_id": "9ff363c9-398e-3449-8d73-399481c709cb",
                        "entry_id": "b1911af6-a6b6-3951-8c4d-2febe108b2e0",
                        "glosses": [
                            "to become impudent, brazen or insolent"
                        ],
                        "tags": [
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "d2027922-19fe-46d6-833d-7949912c196f",
                                "sense_id": "9ff363c9-398e-3449-8d73-399481c709cb",
                                "text": "Твой сосе́д, по-мо́ему, совсе́м охуе́л.",
                                "translation": "I think your neighbour is being a massive ass.",
                                "english": "I think your neighbour is being a massive ass."
                            }
                        ]
                    },
                    {
                        "sense_id": "053ca6ab-6c3b-399a-89bd-1d7676558a80",
                        "entry_id": "b1911af6-a6b6-3951-8c4d-2febe108b2e0",
                        "glosses": [
                            "to be shocked, to be very surprised"
                        ],
                        "tags": [
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "60f2023c-5f49-4c4a-bcd6-94a99c040c41",
                                "sense_id": "053ca6ab-6c3b-399a-89bd-1d7676558a80",
                                "text": "Я охуе́л от тако́й на́глости!",
                                "translation": "I was shocked at such impudence.",
                                "english": "I was shocked at such impudence."
                            }
                        ]
                    },
                    {
                        "sense_id": "fb8fcfd8-4c3a-3d0f-b68d-96502c39ac7d",
                        "entry_id": "b1911af6-a6b6-3951-8c4d-2febe108b2e0",
                        "glosses": [
                            "to feel very miserable for some reason, to freeze, to (nearly) die of hunger, cold, etc."
                        ],
                        "tags": [
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "beb60aa2-9f27-4f26-a049-1eb6bbf68221",
                                "sense_id": "fb8fcfd8-4c3a-3d0f-b68d-96502c39ac7d",
                                "text": "Он охуе́л от хо́лода.",
                                "translation": "He nearly fucking died of cold.",
                                "english": "He nearly fucking died of cold."
                            }
                        ]
                    }
