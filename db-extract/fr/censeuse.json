                                                "example_id": "7a1c2e89-78ad-4cf6-84e2-caa6371015f0",
                                                "sense_id": "38600cac-bc23-3316-bc9c-0f32112f31d7",
                                                "text": "„Bei einer Gala zum chinesischen Neujahrsfest in Peking sangen die Zensorinnen und Zensoren ein Hohelied auf ihr tägliches Werk.“"
                                            }
