                "senses": [
                    {
                        "sense_id": "7bae0e09-ae0a-335c-a723-c9d525a60297",
                        "entry_id": "47d70d73-8bb6-3923-a9b8-ab3de3a1b31f",
                        "glosses": [
                            "Klassische Philologie/Linguistik/Literaturwissenschaft: in der Antike Einteilung eines fortlaufend geschriebenen Textes in Kola („Sinnzeilen“)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed346d6e-fecc-4199-ac52-d868ad941d1e",
                                "sense_id": "7bae0e09-ae0a-335c-a723-c9d525a60297",
                                "text": "Die Kolometrie ist ein Verfahren, um Texte oder Teiltexte in syntaktisch sinnvolle Bestandteile, Kola, zu zerlegen und diese in unterschiedliche Zeilen zu bringen."
                            },
                            {
                                "example_id": "d35ef7b2-df73-44ce-8c9b-53fafd6ecfb5",
                                "sense_id": "7bae0e09-ae0a-335c-a723-c9d525a60297",
                                "text": "Ein Anwendungsfeld der Kolometrie sind Gedichte, die in einer Vorlage durchlaufend (ohne Zeileneinteilung) geschrieben sind und mit diesem Verfahren in Zeilen gegliedert werden."
                            }
                        ],
