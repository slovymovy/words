                                "target_senses": [
                                    {
                                        "sense_id": "07d3d70c-5ee8-347a-9e32-8a93fbc5cb06",
                                        "entry_id": "d081c239-99d3-3ade-9a1a-c013278b82ed",
                                        "glosses": [
                                            "Qui aspire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35a67b38-1e3b-4ced-a141-b666e8a2c6b9",
                                                "sense_id": "07d3d70c-5ee8-347a-9e32-8a93fbc5cb06",
                                                "text": "Toutes sortes de firmes, par le moyen de leurs succursales, lancent vers lui, ou plutôt vers son escarcelle, leurs tentacules émoustillants, titillants et aspirants."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c1b5aec9-5ba5-3f4a-9ffc-9147ce3ecd8b",
                                        "entry_id": "d081c239-99d3-3ade-9a1a-c013278b82ed",
                                        "glosses": [
                                            "Qualifie une sorte de pompe qui élève l’eau en faisant le vide d’air."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29babfc1-d55f-40ff-81a2-b27f9684ae4c",
                                                "sense_id": "c1b5aec9-5ba5-3f4a-9ffc-9147ce3ecd8b",
                                                "text": "Pompe aspirante, par opposition à Pompe foulante."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "aspirant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6b5ac4cb-6b2a-3f03-b695-3eab0f6ac5f0",
                                        "entry_id": "1007f2b3-4046-321e-b559-f9dfc7591e8c",
                                        "glosses": [
                                            "Celui qui aspire à une chose, qui veut y parvenir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "593df7b5-074c-4408-b877-86a7f912d716",
                                                "sense_id": "6b5ac4cb-6b2a-3f03-b695-3eab0f6ac5f0",
                                                "text": "Un aspirant ministre."
                                            },
                                            {
                                                "example_id": "7930797c-9acf-40da-99f8-480eb1323b67",
                                                "sense_id": "6b5ac4cb-6b2a-3f03-b695-3eab0f6ac5f0",
                                                "text": "Un aspirant actionnaire arrive tout essoufflé au neuvième étage d’une maison."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "72e1a746-4fc1-30a7-87d9-636eedc97bbf",
                                        "entry_id": "1007f2b3-4046-321e-b559-f9dfc7591e8c",
                                        "glosses": [
                                            "Celui qui aspire à obtenir une charge, un titre, à être reçu dans un corps."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9a03621d-3718-40ca-92bd-04c9e89a65f2",
                                                "sense_id": "72e1a746-4fc1-30a7-87d9-636eedc97bbf",
                                                "text": "À Fréjus, avant les ordinations, il y avait toujours des aspirants prêtres qui déboulaient d’on ne sait trop où."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a74f0c2-ae32-32d6-97ef-db7afcc5edd6",
                                        "entry_id": "1007f2b3-4046-321e-b559-f9dfc7591e8c",
                                        "glosses": [
                                            "Grade militaire d’officier. En France, il est situé entre son supérieur hiérarchique, sous-lieutenant (armée de terre, armée de l’air et gendarmerie françaises) ou enseigne de vaisseau de deuxième classe (Marine nationale française), et son subordonné, major. Le code OTAN : OF(D)."
                                        ],
                                        "tags": [
                                            "Au masculin"
                                        ],
                                        "note": "Bien que l’aspirant ne soit pas lieutenant de jure, on s’adresse à lui en l’appelant « mon lieutenant ». L’appellation monsieur l’aspirant n’est plus employée",
                                        "examples": [
                                            {
                                                "example_id": "c4a9469b-e6a5-4b55-b450-d99fd1955065",
                                                "sense_id": "7a74f0c2-ae32-32d6-97ef-db7afcc5edd6",
                                                "text": "L’aspirant a été convoqué par le capitaine."
                                            },
                                            {
                                                "example_id": "983b56d2-e476-4bcf-9dbf-96e7b2465023",
                                                "sense_id": "7a74f0c2-ae32-32d6-97ef-db7afcc5edd6",
                                                "text": "Pendant ses arrêts, l’aspirant Pablo l’avait remplacé dans les fonctions de lieutenant de la Constanzia."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "aspirant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cdb6df02-7f18-3a6d-ba08-0c757bbfa848",
                                        "entry_id": "4ca9938a-6bcc-31b4-86bb-c3005eac3bc7",
                                        "glosses": [
                                            "Participe présent de aspirer."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "215519b1-a30f-4d39-9418-d04575d47c70",
                                                "sense_id": "cdb6df02-7f18-3a6d-ba08-0c757bbfa848",
                                                "text": "Je me joue de la matière, je peux démoléculariser n’importe qui en le touchant, en l’aspirant, et me nourrir de tout l’hydrogène que sa mort libère."
                                            }
                                        ]
                                    }
                                ]
