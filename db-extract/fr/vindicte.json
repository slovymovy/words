        "fr-extract.jsonl": [
            {
                "entry_id": "35b634ee-5ec6-3f99-b4f5-e217aacf6232",
                "word": "vindicte",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "d91cfc44-fff4-4f96-a240-d379631091d3",
                        "entry_id": "35b634ee-5ec6-3f99-b4f5-e217aacf6232",
                        "tags": [
                            "plural"
                        ],
                        "form": "vindictes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3f095fbe-f75e-3662-96b3-186a1d236262",
                        "entry_id": "35b634ee-5ec6-3f99-b4f5-e217aacf6232",
                        "glosses": [
                            "Poursuite d’un crime."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "1e3665e9-7c7e-4af9-ad74-17d9d7392827",
                                "sense_id": "3f095fbe-f75e-3662-96b3-186a1d236262",
                                "text": "En France, la vindicte publique n’appartenait qu’aux gens du roi."
                            },
                            {
                                "example_id": "c2dac6eb-3c58-4c6c-a5a6-210405e444a3",
                                "sense_id": "3f095fbe-f75e-3662-96b3-186a1d236262",
                                "text": "Une fois la vindicte publique satisfaite, comme jargonnent encore aujourd’hui les bonnes carrées, ce fut le tour des mille particulières."
                            },
                            {
                                "example_id": "77929fb9-4cb8-4cf4-ac59-483b962c1885",
                                "sense_id": "3f095fbe-f75e-3662-96b3-186a1d236262",
                                "text": "— Messieurs les jurés, la société serait ébranlée jusque dans ses fondements, si la vindicte publique n’atteignait pas les grands coupables comme celui qui, etc."
                            },
                            {
                                "example_id": "d8ff58e9-3128-4b3c-8493-4320fe5a4e5e",
                                "sense_id": "3f095fbe-f75e-3662-96b3-186a1d236262",
                                "text": "La guillotine est la concrétion de la loi ; elle se nomme vindicte ; elle n’est pas neutre, et ne vous permet pas de rester neutre."
                            }
                        ]
                    },
                    {
                        "sense_id": "ab7c2090-77e7-33a9-acaa-a312e2a1e32f",
                        "entry_id": "35b634ee-5ec6-3f99-b4f5-e217aacf6232",
                        "glosses": [
                            "Poursuite en vue de vengeance."
                        ],
                        "tags": [
                            "common"
                        ],
                        "examples": [
                            {
                                "example_id": "240aa206-585b-482e-a273-44d7bb7a86d3",
                                "sense_id": "ab7c2090-77e7-33a9-acaa-a312e2a1e32f",
                                "text": "[…] ; la férocité du sort, armée de toutes les vindictes et de toutes les méprises sociales, l’avait pris pour sujet et s’était acharnée sur lui."
                            },
                            {
                                "example_id": "73655c03-9bfe-4a97-a757-9b1af7b7aebe",
                                "sense_id": "ab7c2090-77e7-33a9-acaa-a312e2a1e32f",
                                "text": "Il m’a avertie que je ne devais pas faire bon marché de la vindicte de cette femme […]."
                            },
                            {
                                "example_id": "81021953-4673-4b1d-8f36-6985623ab246",
                                "sense_id": "ab7c2090-77e7-33a9-acaa-a312e2a1e32f",
                                "text": "Elle était possédée de vindicte à présent, elle nous faisait chanter, tout simplement."
                            },
                            {
                                "example_id": "5b3df973-4214-4bc3-a150-7a6a37a8412a",
                                "sense_id": "ab7c2090-77e7-33a9-acaa-a312e2a1e32f",
                                "text": "Une petite paranoïa venait ainsi s’ajouter à ma vanité blessée, et je marchais dans les allées du campus fleuri avec le poids du monde sur mes frêles épaules. Ce monde envers lequel je nourrissais, soudainement, une vindicte muette."
                            },
                            {
                                "example_id": "a0c31054-31c8-415c-b739-565f73c9d59e",
                                "sense_id": "ab7c2090-77e7-33a9-acaa-a312e2a1e32f",
                                "text": "La France avait crié sa colère de voir ainsi livré à la vindicte du regard mondial l’un de ses illustres compatriotes ; les journalistes américains répliquaient par la connivence \"bien connue\" qui conduit au mutisme tricolore dès que l’intimité des politiques est en cause."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fef69cf9-120a-437e-a0a7-f4190d24dd3b",
                        "source_entry_id": "35b634ee-5ec6-3f99-b4f5-e217aacf6232",
                        "source_sense_description": "Poursuite d’un crime",
                        "target_lang_word": "prosecution",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prosecution",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ff5cf299-b734-394f-ae8e-db81013d1d06",
                                        "entry_id": "3795f08a-081c-3e48-b04d-0e7f67ab74bd",
                                        "glosses": [
                                            "The act of prosecuting a scheme or endeavor."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "133585df-ef88-409a-ae2f-b05a3aff968b",
                                                "sense_id": "ff5cf299-b734-394f-ae8e-db81013d1d06",
                                                "text": "Many apartheid perpetrators escaped prosecution for their persecution of black Africans and political dissidents."
                                            },
                                            {
                                                "example_id": "a0f4a5b1-b4b8-4edc-97c5-17b31df4f6b2",
                                                "sense_id": "ff5cf299-b734-394f-ae8e-db81013d1d06",
                                                "text": "The prosecution of the war fell to Winston Churchill."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7418b36b-f2c0-3a69-8f10-1616e618d74d",
                                        "entry_id": "3795f08a-081c-3e48-b04d-0e7f67ab74bd",
                                        "glosses": [
                                            "The institution of legal proceedings (particularly criminal) against a person."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dca7a74b-c789-400e-afe0-5d2b2f91da33",
                                                "sense_id": "7418b36b-f2c0-3a69-8f10-1616e618d74d",
                                                "text": "Such a scandal as the prosecution of a brother for forgery—with a verdict of guilty—is a most truly horrible, deplorable, fatal thing. It takes the respectability out of a family perhaps at a critical moment, when the family is just assuming the robes of respectability: […] it is a black spot which all the soaps ever advertised could never wash off."
                                            },
                                            {
                                                "example_id": "26bda3b7-397e-4e34-a99d-cc22cef8d535",
                                                "sense_id": "7418b36b-f2c0-3a69-8f10-1616e618d74d",
                                                "text": "The justices declared that the statute does not establish a age of consent, and declared that in future prosecutions of persons charged with \"indecent assault and battery\" the state will have to prove that the alleged victim did not consent to the act."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e3930254-4c9f-37db-b2df-786948e0f293",
                                        "entry_id": "3795f08a-081c-3e48-b04d-0e7f67ab74bd",
                                        "glosses": [
                                            "The prosecuting party."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1635bdcd-5694-44ae-92f7-a890831a88c0",
                                                "sense_id": "e3930254-4c9f-37db-b2df-786948e0f293",
                                                "text": "The prosecution case was that the men forced the sisters to strip, threw their clothes over the bridge, then raped them and participated in forcing them to jump into the river to their deaths. As he walked off the bridge, Clemons was alleged to have said: \"We threw them off. Let's go.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b3086fe5-6b40-3158-87cc-dcdbaa9364a0",
                                        "entry_id": "3795f08a-081c-3e48-b04d-0e7f67ab74bd",
                                        "glosses": [
                                            "In many countries, a legal body and institution, usually part of the state apparatus, empowered to perform prosecution. Prosecutor's Office. See Prosecutor."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d056620-543b-4b97-92b9-83a2e0e66bbd",
                                                "sense_id": "b3086fe5-6b40-3158-87cc-dcdbaa9364a0",
                                                "text": "Backed by public outrage, the prosecution requested the death penalty to be imposed on the murderer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
