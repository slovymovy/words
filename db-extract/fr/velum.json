                ],
                "senses": [
                    {
                        "sense_id": "fec5ce2b-e49a-3934-9002-9b4de2156c6e",
                        "entry_id": "2f570435-7762-3c9c-8ad3-5a706a55f183",
                        "glosses": [
                            "Grande pièce d’étoffe servant de rideau contre la lumière, ou de couverture à un grand espace sans toiture."
                        ],
                        "tags": [
                            "Latinisme"
                        ],
                        "examples": [
                            {
                                "example_id": "b9530979-0827-4c6d-a23e-cd90d89eebbd",
                                "sense_id": "fec5ce2b-e49a-3934-9002-9b4de2156c6e",
                                "text": "[…] et tous les yeux qui étaient là attendirent, avides et dévorant d’un seul regard la fenêtre de la loggia, qu’abritait un long velum de toile, et d’où pendait un tapis de velours ciselé, brodé aux armes de Clément XI."
                            },
                            {
                                "example_id": "ab7de68c-7f89-481d-91eb-18cbc57ab792",
                                "sense_id": "fec5ce2b-e49a-3934-9002-9b4de2156c6e",
                                "text": "Les lampes clignotèrent et une partie du plafond ploya comme un velum."
                            },
                            {
                                "example_id": "340d0989-7b26-4398-800d-045065624377",
                                "sense_id": "fec5ce2b-e49a-3934-9002-9b4de2156c6e",
                                "text": "Lourdement, balayant de ses larges plis le plateau, la masse du velum rouge dégringola du cintre avant de remonter, pour retomber et se relever de nouveau."
                            }
                        ]
                    },
                    {
                        "sense_id": "421610ff-8e89-326c-a56b-810cfccf1a20",
                        "entry_id": "2f570435-7762-3c9c-8ad3-5a706a55f183",
                        "glosses": [
                            "Voile nuageux annexe à grande extension horizontale, situé légèrement au-dessus des sommets d'un ou de plusieurs nuages cumuliformes."
                        ],
