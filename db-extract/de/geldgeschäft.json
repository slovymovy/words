                ],
                "senses": [
                    {
                        "sense_id": "2329f4d5-e59f-32e3-89be-046efd3cc38d",
                        "entry_id": "83b00c39-329d-327a-845a-d0a470e6a7aa",
                        "glosses": [
                            "Gesamtheit aller Tätigkeiten, die mit der Zahlung, Übertragung, dem Handel mit Geld zusammenhängen"
                        ],
                        "tags": [
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "516d814e-985a-43ab-85ce-1c553d142c8f",
                                "sense_id": "2329f4d5-e59f-32e3-89be-046efd3cc38d",
                                "text": "„Der gesunde Menschenverstand ist und bleibt der beste Helfer bei Geldgeschäften.“"
                            },
                            {
                                "example_id": "5307e2dc-9886-47df-ab7e-b0005f6d37e5",
                                "sense_id": "2329f4d5-e59f-32e3-89be-046efd3cc38d",
                                "text": "„Zinseszins und Steuern machen Geldgeschäfte für Privatleute so kompliziert, dass sie diese nur zum Teil durchschauen können.“"
                            },
                            {
                                "example_id": "1b3f567a-a984-4e06-a34f-eedc50f71a5d",
                                "sense_id": "2329f4d5-e59f-32e3-89be-046efd3cc38d",
                                "text": "„Vor allem, wer seine Geldgeschäfte nicht online erledigt, sondern noch einen Überweisungsträger auf Papier benutzt, muss bei vielen Banken zahlen.“"
                            },
                            {
                                "example_id": "c8f25713-f8c8-43b0-a2d1-7c7b259d1aa5",
                                "sense_id": "2329f4d5-e59f-32e3-89be-046efd3cc38d",
                                "text": "„Tatsächlich hat sich der mit dem Geldgeschäft handelnde Kapitalismus unendlich blamiert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
