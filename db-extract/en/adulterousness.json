                    {
                        "sense_id": "6dc67426-b2ee-3f60-84c5-21b8ad5dfe53",
                        "entry_id": "609b6b5a-1ec9-39a9-9dc4-5badb8d46d2d",
                        "glosses": [
                            "A state of being adulterous."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "784b34ca-7a63-4968-b670-cf292f6b8392",
                                "sense_id": "6dc67426-b2ee-3f60-84c5-21b8ad5dfe53",
                                "text": "It is, however, apparent that Joyce made this adulterousness or pseudo-adulterousness a persistent and structurally significant element in his novel […]"
                            },
                            {
                                "example_id": "2d80401f-2032-470f-b17c-8945ad289b69",
                                "sense_id": "6dc67426-b2ee-3f60-84c5-21b8ad5dfe53",
                                "text": "And once she had to sit one Sunday in the stocks in Nurmo church for the entire church service, on account of her terrible adulterousness, and the whole time she winked flirtatiously at the men."
                            },
                            {
                                "example_id": "1568e95e-f2e5-4433-a802-05e730b7d3f2",
                                "sense_id": "6dc67426-b2ee-3f60-84c5-21b8ad5dfe53",
                                "text": "In the ensuing discussion he makes two extraordinary arguments, the first linking the chastity of Americans with their political freedom and the adulterousness of Europeans with their political disorders […]"
                            }
                        ]
                    }
