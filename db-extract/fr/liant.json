                                "example_id": "b85a14f8-cb20-49c1-be3d-ec27e968cd1b",
                                "sense_id": "093a8c15-fbb3-3c80-8767-f73d5ff53b20",
                                "text": "Caractère, esprit liant."
                            },
                            {
                                "example_id": "f82839c5-1616-41f6-bdd9-e40ddb43a921",
                                "sense_id": "093a8c15-fbb3-3c80-8767-f73d5ff53b20",
