    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "704eb9f5-f04e-30b0-9011-059b6bc1fd78",
                    "sense_definition": "Consacrer entièrement son temps, ses efforts ou son existence à une cause, une activité ou une personne.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "consécration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a décidé de <w>vouer</w> sa vie à la recherche médicale afin de guérir cette maladie."
                        },
                        {
                            "text": "Ce militant se <w>voue</w> corps et âme à la défense des droits humains dans sa région."
                        }
                    ],
                    "synonyms": [
                        "dédier"
                    ],
                    "common_phrases": [
                        "se vouer à",
                        "vouer sa vie"
                    ]
                },
                {
                    "sense_id": "520cbf6d-4f82-3a46-87f2-86ca55a65c14",
                    "sense_definition": "Éprouver et manifester de manière constante un sentiment, une fidélité ou une hostilité envers quelqu'un.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sentiment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il <w>voue</w> une admiration sincère et indéfectible à son ancien mentor."
                        },
                        {
                            "text": "Depuis cette querelle injuste, les deux voisins se <w>vouent</w> une haine sans merci."
                        }
                    ],
                    "common_phrases": [
                        "vouer une admiration",
                        "vouer une haine",
                        "vouer un culte"
                    ]
                },
                {
                    "sense_id": "547acae6-685d-3942-b9cc-9607a12ad90f",
                    "sense_definition": "Promettre solennellement par un vœu religieux ou consacrer au culte d'une divinité.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les citoyens avaient décidé de <w>vouer</w> un temple somptueux au dieu protecteur de la cité."
                        },
                        {
                            "text": "Après avoir échappé au naufrage, les marins reconnaissants ont <w>voué</w> une chapelle à saint Nicolas."
                        }
                    ],
                    "common_phrases": [
                        "vouer un temple"
                    ]
                },
                {
                    "sense_id": "f1074701-9683-3842-b4a9-930ff4db6aca",
                    "sense_definition": "Placer une personne sous la protection d'un saint par une promesse solennelle.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Craignant pour sa santé fragile, la mère avait <w>voué</w> son enfant à la Vierge."
                        },
                        {
                            "text": "Selon la tradition de cette paroisse, les parents <w>vouaient</w> le nouveau-né à saint Joseph."
                        }
                    ],
                    "common_phrases": [
                        "vouer à la Vierge"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "coutume religieuse ancienne"
                        }
                    ]
                }
            ]
        }
