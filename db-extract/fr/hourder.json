                ],
                "senses": [
                    {
                        "sense_id": "a1f87bb3-7caf-358f-9513-8442e15adc25",
                        "entry_id": "f2eaa11c-d24c-3ad9-a03e-cf5e35b05bb8",
                        "glosses": [
                            "Maçonner grossièrement, fortifier, faire un hourdage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "436096e4-647a-46da-973c-ff039dd2ea1a",
                                "sense_id": "a1f87bb3-7caf-358f-9513-8442e15adc25",
                                "text": "Hourder une cloison."
                            },
                            {
                                "example_id": "30414aab-fee4-4844-b7bc-668844282bff",
                                "sense_id": "a1f87bb3-7caf-358f-9513-8442e15adc25",
                                "text": "Une cloison hourdée."
                            },
                            {
                                "example_id": "748715f1-e89f-47b4-b7cb-4620fe0cf4d6",
                                "sense_id": "a1f87bb3-7caf-358f-9513-8442e15adc25",
                                "text": "À côté de la tremblante maison à pans hourdés où l’artisan a déifié son rabot, s’élève l’hôtel d’un gentilhomme."
                            },
                            {
                                "example_id": "91297757-124f-4883-86c9-eacab09acdc9",
                                "sense_id": "a1f87bb3-7caf-358f-9513-8442e15adc25",
                                "text": "Ce qu’il y avait de caractéristique dans la plupart des maisons devant lesquelles elles passaient, c’était que presque toutes si vieilles, si usées, si mal construites qu’elles fussent, en terre ou en bois hourdé d’argile, affectaient un aspect de coquetterie au moins dans la peinture des portes et des fenêtres qui tirait l’œil comme une enseigne."
                            }
                        ]
                    }
