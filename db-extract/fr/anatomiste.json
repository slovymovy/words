                                        "glosses": [
                                            "iemand die bestudeert hoe een levend wezen uit organen is opgebouwd"
                                        ],
                                        "tags": [
                                            "beroep"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eca0b405-c5be-4b28-a1c0-d5103b8eec5b",
                                                "sense_id": "d707684b-7f01-30f7-a150-7d85d3786dbf",
                                                "text": "In de korte tijd, dat het Nuck gegeven was als hoogleraar werkzaam te zijn, heeft hij zich echter niet alleen als een uitstekend docent doen kennen maar ook als een uitmuntend ontleedkundige."
                                            }
