                "senses": [
                    {
                        "sense_id": "f2d38182-5eef-380b-b511-01379e80ff9d",
                        "entry_id": "aac822a1-1158-3134-8a8a-bfaa22ad1679",
                        "glosses": [
                            "pig"
                        ],
                        "tags": [
                            "colloquial",
                            "derogatory",
                            "humorous"
                        ],
                        "examples": [
                            {
                                "example_id": "cf38919a-53f5-4e3e-92fd-8e50a412adc9",
                                "sense_id": "f2d38182-5eef-380b-b511-01379e80ff9d",
                                "text": "— Фу, како́й ты… сви́нтус! — произнё́с стра́шно сконфу́зившийся и покрасне́вший Разуми́хин и встал со сту́ла. Пульхе́рия Алекса́ндровна слегка́ улыбну́лась, а Раско́льников гро́мко расхохота́лся.",
                                "translation": "\"Foo!—what a pig you are!\" Razumihin protested, blushing in terrible confusion, and he got up from his chair. Pulcheria Alexandrovna smiled faintly, but Raskolnikov laughed aloud.",
                                "english": "\"Foo!—what a pig you are!\" Razumihin protested, blushing in terrible confusion, and he got up from his chair. Pulcheria Alexandrovna smiled faintly, but Raskolnikov laughed aloud."
                            }
                        ]
                    }
                ],
