                "senses": [
                    {
                        "sense_id": "ebed5985-4bf9-345e-8296-dbd8df116fca",
                        "entry_id": "65718166-8c92-3bb2-b362-e72841f3e5a6",
                        "glosses": [
                            "rundes Einbauteil zu einem Rohr, zur gezielten Verminderung der Schallemission aus diesem, von einer Maschine oder einer Anlage"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30d6ae9f-22ba-4594-9e55-8a23c19852e3",
                                "sense_id": "ebed5985-4bf9-345e-8296-dbd8df116fca",
                                "text": "„Rohrschalldämpfer aus verzinktem Stahlblech zur Geräuschreduzierung in runden Luftleitungen von raumlufttechnischen Anlagen.“"
                            },
                            {
                                "example_id": "31ec0564-2706-446d-9319-03cae63a3119",
                                "sense_id": "ebed5985-4bf9-345e-8296-dbd8df116fca",
                                "text": "Die einfach zu bauenden runden Rohrschalldämpfer können mit einem Kern ausgestattet werden, der verhindert, dass Schall mittig als Strahl durchtritt."
                            },
                            {
                                "example_id": "df2eb72a-9073-4f82-ad42-9f3fe0a8fc6e",
                                "sense_id": "ebed5985-4bf9-345e-8296-dbd8df116fca",
                                "text": "Als Kanaleinbauten sind schraubenförmige Leitschaufeln im Rohrschalldämpfer zu nennen, die allerdings zu einer Erhöhung des Druckverlustes führen."
                            },
                            {
                                "example_id": "9ee5e5d6-0adf-4934-8733-a8cb82ded787",
                                "sense_id": "ebed5985-4bf9-345e-8296-dbd8df116fca",
                                "text": "Gegen die ungehinderte Ausbreitung des Schalles in den Rohren und der Wassersäule gibt es Wasserschalldämpfer und Rohrschalldämpfer, letztere in Verbindung mit den Abdeckrosetten der Armaturen."
                            },
                            {
                                "example_id": "9344f0ff-eda3-44b6-9987-a1e14c4fde1d",
                                "sense_id": "ebed5985-4bf9-345e-8296-dbd8df116fca",
                                "text": "Der in der Praxis häufig verwendete biegsame Rohrschalldämpfer kann dieser Bauart zugeordnet werden (auch bekannt unter dem Begriff «Telefoniedämpfer»)."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
