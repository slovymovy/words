                "senses": [
                    {
                        "sense_id": "adbc55c9-0819-3324-9de9-4246334ece70",
                        "entry_id": "cd8e1570-f4cd-3cb0-adac-2f8608b4e3df",
                        "glosses": [
                            "Sachaufgabe, die mit dem gegebenen Kontext nicht lösbar ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f67a2b23-638a-4955-aa54-57c3d7b5deb4",
                                "sense_id": "adbc55c9-0819-3324-9de9-4246334ece70",
                                "text": "Die wohl berühmteste Kapitänsaufgabe ist: „Auf einem Schiff sind 26 Schafe und 10 Ziegen. Wie alt ist der Kapitän?“"
                            },
                            {
                                "example_id": "7eafd757-987a-4d03-bb6c-6d5c169ac57d",
                                "sense_id": "adbc55c9-0819-3324-9de9-4246334ece70",
                                "text": "„Wissenschaftler haben das Phänomen der sogenannten Kapitänsaufgaben in den vergangenen 30 Jahren unter verschiedenen Blickwinkeln untersucht - bis heute machen viele Schüler dieselben Fehler.“"
                            },
                            {
                                "example_id": "fd6df4db-9f31-466a-bbc9-02f0d3632f8c",
                                "sense_id": "adbc55c9-0819-3324-9de9-4246334ece70",
                                "text": "„Ein genauer Blick auf das, was die Kinder sich bei der Bearbeitung von Kapitänsaufgaben überlegen, scheint daher unverzichtbar.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
