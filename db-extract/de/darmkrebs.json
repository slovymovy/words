                ],
                "senses": [
                    {
                        "sense_id": "ca10f424-7687-3ae1-bd62-4c794dab826b",
                        "entry_id": "9b0eecfb-b9ac-390a-bb26-c5390bc69e05",
                        "glosses": [
                            "Cancer de l'intestin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb64f998-b273-4bf6-b0d9-ff8a96742d46",
                                "sense_id": "ca10f424-7687-3ae1-bd62-4c794dab826b",
                                "text": "Wenn Darmkrebs entdeckt wird, ist er sehr häufig in einem späten Stadium und damit unheilbar.",
                                "translation": "Lorsqu’un cancer de l'intestin est découvert, il a généralement déjà atteint un stade avancé et est donc incurable."
                            },
                            {
                                "example_id": "fae1d67b-b1f8-4249-b9a0-50c9f07f19a5",
                                "sense_id": "ca10f424-7687-3ae1-bd62-4c794dab826b",
                                "text": "Darmkrebs entwickelt sich meist schleichend über mehrere Jahre hinweg und wird daher oft erst spät erkannt.",
                                "translation": "La plupart du temps, un cancer de l’intestin se développe lentement sur plusieurs années et est donc dépisté tardivement."
                            }
                        ]
                    }
                ],
