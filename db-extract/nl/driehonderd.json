                "senses": [
                    {
                        "sense_id": "d471f644-4c19-3de5-8add-5f907cbb29f1",
                        "entry_id": "03fa6c86-e892-3b0f-a824-ec12ab261789",
                        "glosses": [
                            "\\\"300\\\", het getal tussen tweehonderdnegenennegentig en driehonderdeen, drie maal honderd"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "7723acc0-208c-35db-a28e-11eef8c61d76",
                        "entry_id": "03fa6c86-e892-3b0f-a824-ec12ab261789",
                        "glosses": [
                            "\\\"300\\\", het getal tussen tweehonderdnegenennegentig en driehonderdeen, drie maal honderd",
                            "om een hoeveelheid aan te geven"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a206bdea-b488-45b0-ab75-2d30173988c4",
                                "sense_id": "7723acc0-208c-35db-a28e-11eef8c61d76",
                                "text": "De totale kosten bedragen driehonderd euro en zevenendertig cent."
                            },
                            {
                                "example_id": "b924081a-5127-405f-b6db-5e0a97e2a402",
                                "sense_id": "7723acc0-208c-35db-a28e-11eef8c61d76",
                                "text": "Recent is besloten twee Nederlandse luchtverdedigingseenheden en driehonderd militairen te stationeren in Zuidoost-Polen, op de grens met Oekraïne."
                            }
                        ]
                    },
                    {
                        "sense_id": "29c78c91-ee41-312a-8127-8e345fb7951a",
                        "entry_id": "03fa6c86-e892-3b0f-a824-ec12ab261789",
                        "glosses": [
                            "\\\"300\\\", het getal tussen tweehonderdnegenennegentig en driehonderdeen, drie maal honderd",
                            "om een plaats in een volgorde aan te geven"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83735249-3edc-47be-a058-7740bc103dc9",
                                "sense_id": "29c78c91-ee41-312a-8127-8e345fb7951a",
                                "text": "We logeerden vlakbij het strand in kamer driehonderd van het grootste hotel."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fe641f99-f61a-4d17-a4af-0656d154721f",
                        "source_entry_id": "03fa6c86-e892-3b0f-a824-ec12ab261789",
                        "source_sense_id": "d471f644-4c19-3de5-8add-5f907cbb29f1",
                        "source_sense_description": "het getal 300",
                        "target_lang_word": "dreihundert",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dreihundert",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bbe93f82-a5b0-3928-9e57-7fe0d3381b27",
                                        "entry_id": "f9789e28-6a01-30f2-b0ff-c10e9c5c6a46",
                                        "glosses": [
                                            "Kardinalzahl, die sich durch Multiplikation der Zahl drei mit der Zahl hundert ergibt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c066a65-3e26-46a7-a6ee-79b777a7a7b2",
                                                "sense_id": "bbe93f82-a5b0-3928-9e57-7fe0d3381b27",
                                                "text": "Leonidas kämpfte mit dreihundert Spartanern an den Thermopylen gegen eine Übermacht der Perser einen heroischen, jedoch aussichtslosen Kampf."
                                            },
                                            {
                                                "example_id": "6c2bd80b-016d-46ae-9a85-f4ce0413e315",
                                                "sense_id": "bbe93f82-a5b0-3928-9e57-7fe0d3381b27",
                                                "text": "Die Galeeren waren bis zu vierzig Meter lang und wurden je nach Größe von achtzig bis zu dreihundert Ruderern angetrieben."
                                            },
                                            {
                                                "example_id": "0b10e89f-b46b-49a5-bf57-1b4e0dcb7838",
                                                "sense_id": "bbe93f82-a5b0-3928-9e57-7fe0d3381b27",
                                                "text": "„Der Eisberg an Steuerbord hat Ähnlichkeit mit dem Opernhaus von Sydney und ist bestimmt dreihundert Meter lang und einhundert Meter groß.“"
                                            },
                                            {
                                                "example_id": "95e7ddb5-b7c4-4fb0-91dc-e22dd5ce919c",
                                                "sense_id": "bbe93f82-a5b0-3928-9e57-7fe0d3381b27",
                                                "text": "„In manchen Jahren mussten die Soldaten über dreihundert Kämpfe bestehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
