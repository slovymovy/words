                                    {
                                        "sense_id": "0191d7f3-cd01-3f20-b5ac-c31e31290450",
                                        "entry_id": "b6ca4ce2-e3c6-3d14-95a0-3b310d565d5e",
                                        "glosses": [
                                            "Que l’on peut aisément porter pour le déplacer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a9f639c-2b51-4d08-b05f-8fe9c8fa597a",
                                                "sense_id": "0191d7f3-cd01-3f20-b5ac-c31e31290450",
                                                "text": "Les peuples préhistoriques ont eu des conventions monétaires, de coquillages, pierres, pépites ou lingots de métaux précieux, de valeur intrinsèque relative constante, pour acheter des objets moins portatifs dont le possesseur était titulaire. C'était des constitutions financières démocratiques de l'âge d'or."
                                            },
                                            {
                                                "example_id": "31bfc047-04d3-4091-86e5-37585cacc978",
                                                "sense_id": "0191d7f3-cd01-3f20-b5ac-c31e31290450",
                                                "text": "Pourquoi personne n’a pensé à acheter des purificateurs d’air portatifs comme le recommande Québec solidaire ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
