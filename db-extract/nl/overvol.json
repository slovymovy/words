                "senses": [
                    {
                        "sense_id": "fe84b3eb-ff10-3336-990a-2506b1b64d75",
                        "entry_id": "3faa63e3-25bf-3b60-b6b9-ee9328e0c54b",
                        "glosses": [
                            "meer dan vol, te vol"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be40af66-4d3d-47fa-8174-688637bb1512",
                                "sense_id": "fe84b3eb-ff10-3336-990a-2506b1b64d75",
                                "text": "Ik zocht een plekje in de overvolle treincoupé."
                            },
                            {
                                "example_id": "e598df6c-5ac7-471d-9e1f-9208a43f7a4e",
                                "sense_id": "fe84b3eb-ff10-3336-990a-2506b1b64d75",
                                "text": "Mijn agenda is helaas overvol."
                            },
                            {
                                "example_id": "a57dc35d-4995-48ed-a121-dd3da465bda6",
                                "sense_id": "fe84b3eb-ff10-3336-990a-2506b1b64d75",
                                "text": "Het café zag er in al zijn exotische alledaagsheid uit als een filmcoulisse, vlak boven zijn hoofd hing een opgezet hert, schilderijen met dieren in een bergomgeving aan de gelambriseerde muren, het publiek zag eruit als figuranten in een film, sterke vrouwenarmen die overvolle dienbladen droegen met halveliterglazen bier alsof ze alleen maar melk voor de koffie rondbrachten, het geroezemoes van de vreemde taal, iemand aan een naburig tafeltje vertelde heel luid een verhaal waar hij natuurlijk geen woord van begreep maar toch om lachte toen de toehoorders in lachen uitbarstten, zich op de knie sloegen en hun schuimende bierglazen ophieven."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4bb7108e-5881-4abe-8c3a-3a618a860e37",
                        "source_entry_id": "3faa63e3-25bf-3b60-b6b9-ee9328e0c54b",
                        "source_sense_id": "fe84b3eb-ff10-3336-990a-2506b1b64d75",
                        "source_sense_description": "meer dan vol, te vol",
                        "target_lang_word": "rappelvoll",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rappelvoll",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ef6ff35e-d1b4-3a2e-a3ad-420b0f270223",
                                        "entry_id": "4819eb20-d9bc-394a-94ca-6fcaa26ef497",
                                        "glosses": [
                                            "sehr voll"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "83d8c3da-0ad6-4f20-a248-bf37503ee40e",
                                                "sense_id": "ef6ff35e-d1b4-3a2e-a3ad-420b0f270223",
                                                "text": "In der Disco war es gestern rappelvoll."
                                            },
                                            {
                                                "example_id": "452d46c8-6ed7-46d2-8b6e-674cfca8e95b",
                                                "sense_id": "ef6ff35e-d1b4-3a2e-a3ad-420b0f270223",
                                                "text": "Die Gefängnisse in der Türkei sind rappelvoll."
                                            },
                                            {
                                                "example_id": "20164879-a1fc-4798-ad19-3c3ec038d23f",
                                                "sense_id": "ef6ff35e-d1b4-3a2e-a3ad-420b0f270223",
                                                "text": "„Sein Terminkalender ist rappelvoll.“"
                                            },
                                            {
                                                "example_id": "36aaef49-b6a1-4b5d-a18f-60a15d7ac89c",
                                                "sense_id": "ef6ff35e-d1b4-3a2e-a3ad-420b0f270223",
                                                "text": "Die Restaurantkette ist vor allem beliebt für ihre türkischen Grill-Spezialitäten und deswegen meist rappelvoll."
                                            },
                                            {
                                                "example_id": "fec5a657-bdc2-4e33-bf7e-89dc8f37e477",
                                                "sense_id": "ef6ff35e-d1b4-3a2e-a3ad-420b0f270223",
                                                "text": "Gerade jetzt ist das Deutsche unglaublich gut besucht in den ganzen Goethe-Instituten in Griechenland, in Spanien, in Portugal. Die sind rappelvoll, was sie jahrzehntelang - in Bezug auf Sprachunterricht - nicht waren."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "455df381-f4fd-416e-bacd-eb36c6fd7ce2",
                        "source_entry_id": "3faa63e3-25bf-3b60-b6b9-ee9328e0c54b",
