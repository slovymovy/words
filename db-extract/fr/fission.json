                ],
                "senses": [
                    {
                        "sense_id": "b20b96a6-7215-34da-b66b-4341c499f502",
                        "entry_id": "f2486b16-db8f-3944-a07b-71025ab25653",
                        "glosses": [
                            "Division cellulaire, scissiparité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89a75954-9a19-4ad2-a53c-796b884ff796",
                                "sense_id": "b20b96a6-7215-34da-b66b-4341c499f502",
                                "text": "Juste avant l’individualisation de la vésicule, il se forme le pore de fission qui apparaît sous la forme d’un raccordement aqueux entre la lumière de la vésicule et le milieu extracellulaire […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "bd260f1c-3151-325c-bd41-3bd4f8273069",
                        "entry_id": "f2486b16-db8f-3944-a07b-71025ab25653",
                        "glosses": [
                            "Division d’un noyau atomique lourd en deux fragments dont les masses sont du même ordre de grandeur, qui s’accompagne de l’émission de neutrons, de rayons gamma et d’une quantité d’énergie élevée."
                        ],
                        "tags": [
                            "Physique des réacteurs nucléaires"
                        ],
                        "examples": [
                            {
                                "example_id": "fa3c7c34-5733-4525-8616-f0c925a67ed7",
                                "sense_id": "bd260f1c-3151-325c-bd41-3bd4f8273069",
                                "text": "Les centrales nucléaires utilisent la fission pour obtenir l’énergie nécessaire à la production d’électricité."
                            },
                            {
                                "example_id": "047efdcb-fcb6-4be1-9a0a-c214e5c2e505",
                                "sense_id": "bd260f1c-3151-325c-bd41-3bd4f8273069",
                                "text": "Ce nouveau phénomène fut baptisé fission nucléaire par analogie avec la fission biologique (division cellulaire)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ac880fb9-f2f3-401a-bd59-96b9a39bdc5b",
                        "source_entry_id": "f2486b16-db8f-3944-a07b-71025ab25653",
