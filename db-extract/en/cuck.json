                        "entry_id": "ccad9904-fc30-397e-b637-db0f08515d93",
                        "glosses": [
                            "A cuckold or cuckquean."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "ecdf2b5e-23a2-412f-97c2-8655690c64e5",
                                "sense_id": "1329fe2c-daaf-378a-9b72-87be09c18ffa",
                                "text": "Not the Horn-Plague, but something worse, Had drove the frighted Cucks from thence."
                            },
                            {
                                "example_id": "6952cb2d-0616-4d77-a462-3313d902e662",
                                "sense_id": "1329fe2c-daaf-378a-9b72-87be09c18ffa",
                                "text": "We bounce from Bisset and Seymour’s increasingly happy shagging to Worsley, the willing cuck, watching on and, finally, the trial that Worsley brings against Bisset."
                            },
                            {
                                "example_id": "5a3ecf76-0d0e-40ae-8c4e-9965c22dd72e",
                                "sense_id": "1329fe2c-daaf-378a-9b72-87be09c18ffa",
                                "text": "Jeff and Allison secretly live the \"hotwife/cuckold\" lifestyle."
                            },
                            {
                                "example_id": "183902dd-d18f-4604-9291-b5df75721097",
                                "sense_id": "1329fe2c-daaf-378a-9b72-87be09c18ffa",
                                "text": "The King was made a cuck by his faithless Queen."
                            }
                        ]
                    },
                    {
                        "sense_id": "8c2862b3-6164-365e-9554-6062fb7874b4",
                        "entry_id": "ccad9904-fc30-397e-b637-db0f08515d93",
                        "glosses": [
                            "A weakling."
                        ],
                        "tags": [
                            "derogatory",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "5b33ec1d-befc-4b0a-9795-d3c6b64f592b",
                                "sense_id": "8c2862b3-6164-365e-9554-6062fb7874b4",
                                "text": "That silly cuck thinks she can beat me in a fight."
                            },
                            {
                                "example_id": "0d24573c-a3e9-49e3-ad84-4d40ff0185a5",
                                "sense_id": "8c2862b3-6164-365e-9554-6062fb7874b4",
                                "text": "He starts getting in my face. Thomas puts his hand on the dude’s chest to stop him. ‘Don’t touch me you cuck. Wanna go outside?’"
                            },
                            {
                                "example_id": "0dd8fa26-b13f-4090-aaf5-f48e563f024b",
                                "sense_id": "8c2862b3-6164-365e-9554-6062fb7874b4",
                                "text": "From there cuck evolved into a catch-all way of abusing men who might be otherwise referred to as “betas”."
                            },
                            {
                                "example_id": "419f2480-4b97-4f85-9445-95e103664335",
                                "sense_id": "8c2862b3-6164-365e-9554-6062fb7874b4",
                                "text": "You're site is SHITE. It gets hacked DAILY. You dumb cuck."
                            }
                        ]
                    },
                    {
                        "sense_id": "ea81219e-49b1-35d0-99bc-7a9f9db40c02",
                        "entry_id": "ccad9904-fc30-397e-b637-db0f08515d93",
                        "glosses": [
                            "One who meekly and submissively acts against their own interests, or those of their own race, gender, class, religion, etc."
                        ],
                        "tags": [
                            "derogatory",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "3c255bea-5ceb-40ca-a2a1-9c5a00f4cbd4",
                                "sense_id": "ea81219e-49b1-35d0-99bc-7a9f9db40c02",
                                "text": "The feel-good petition was only supported by cucks."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ec896eac-b5f2-4cde-bb69-803f933f8dbd",
                        "source_entry_id": "ccad9904-fc30-397e-b637-db0f08515d93",
                        "source_sense_description": "weakling",
                        "target_lang_word": "cocu",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cocu",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d3861439-3aec-3b75-8d51-0d6af778a2e9",
                                        "entry_id": "b5e934f3-8910-3aa5-91f5-ae28c2557aa7",
                                        "glosses": [
                                            "Dupé, trompé, victime d’infidélité conjugale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e86a145-a3b2-489f-afda-ec13959530f4",
                                                "sense_id": "d3861439-3aec-3b75-8d51-0d6af778a2e9",
                                                "text": "…il la conduirait devant le maire et devant le curé, se disant à lui-même, en manière de consolation, que, s’il était dans son destin de devenir cocu, il le serait certainement moins longtemps que s’il avait suivi l’exemple de ses anciens camarades et s’était comme ces derniers marié vers la trentaine."
                                            },
                                            {
                                                "example_id": "0167a262-6abc-4d9c-9f21-811fa526f126",
                                                "sense_id": "d3861439-3aec-3b75-8d51-0d6af778a2e9",
                                                "text": "– Et quelque chose me dit que vous êtes même cocu ! Il suffit de vous regarder pour comprendre, monsieur, à quel point vous l’êtes, cocu ! Et vous êtes un cocu triste, l’espèce la plus redoutable…"
                                            },
                                            {
                                                "example_id": "8f462191-cbe8-4b04-8e44-41593f1b6001",
                                                "sense_id": "d3861439-3aec-3b75-8d51-0d6af778a2e9",
                                                "text": "« Cocu » est un mot pour les riches. Moi, si ça m’arrivait, je ne serais pas cocu, je serais malheureux."
                                            },
                                            {
                                                "example_id": "782d0654-5161-4c15-8749-bd088965ded5",
                                                "sense_id": "d3861439-3aec-3b75-8d51-0d6af778a2e9",
                                                "text": "Félicienne, disait-il, avait d’abord épousé un joueur de boules « professionnel » qui la quittait souvent pour aller triompher dans les concours, et c’est à cette occasion que j’appris le mot « cocu »."
                                            },
                                            {
                                                "example_id": "b8105bf1-262d-4cae-9a14-a71e14dc6c8b",
                                                "sense_id": "d3861439-3aec-3b75-8d51-0d6af778a2e9",
                                                "text": "— Regarde : toi et moi, on vient de se sortir d'un nombre d’emmerdements que même un polygame cocu il aurait pas eu assez de femmes pour faire moins bien."
                                            },
                                            {
                                                "example_id": "6126d168-3df7-49bb-aa40-bc9f30d42a3a",
                                                "sense_id": "d3861439-3aec-3b75-8d51-0d6af778a2e9",
                                                "text": "On ne dit jamais d'une star qu'elle est alcoolo et cocue comme pas deux, on écrit : « D'aussi loin qu'elle se le rappelait, Simone avait toujours aimé les bons vins » et après on écrit : « D'aussi loin qu'il se le rappelait, Yves avait toujours eu beaucoup de succès auprès de la gente féminine. »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3c443bc0-9f02-3ea1-b2e6-c4d1480c7684",
                                        "entry_id": "b5e934f3-8910-3aa5-91f5-ae28c2557aa7",
                                        "glosses": [
                                            "(Par antiphrase) Chanceux, veinard."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47a1f6f6-19b8-491b-94f1-012b207ca80b",
                                                "sense_id": "3c443bc0-9f02-3ea1-b2e6-c4d1480c7684",
                                                "text": "Alors toi, aujourd'hui, tu es vraiment cocu, tu pourrais jouer les yeux fermés !"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cocu",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "448f58d7-ec57-3a48-92e6-0eb4e3d4e645",
                                        "entry_id": "9f642ed8-4d01-390d-953b-0dd4a8927f6e",
                                        "glosses": [
                                            "Personne dont le partenaire ou le conjoint est infidèle."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae34b917-7140-4854-80c8-b78b07b7df18",
                                                "sense_id": "448f58d7-ec57-3a48-92e6-0eb4e3d4e645",
                                                "text": "Sganarelle : A-t-on mieux cru jamais être cocu que moi.\nVous voyez qu’en ce fait la plus forte apparence\nPeut jeter dans l’esprit une fausse créance :\nDe cet exemple-ci, ressouvenez-vous bien,\nEt quand vous verriez tout, ne croyez jamais rien."
                                            },
                                            {
                                                "example_id": "52e5ca33-f757-47c6-a228-856794eab437",
                                                "sense_id": "448f58d7-ec57-3a48-92e6-0eb4e3d4e645",
                                                "text": "Lisette : Par ma foi, je lui sais bon gré de cette affaire,\nEt ce prix de ses soins est un trait exemplaire.\nLéonor : Je ne sais si ce trait se doit faire estimer ;\nMais je sais bien qu’au moins je ne le puis blâmer.\nErgaste : Au sort d’être cocu son ascendant l’expose,\nEt ne l’être qu’en herbe est pour lui douce chose."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "465cb6a0-2ffa-3999-8224-76b46385c22f",
                                        "entry_id": "9f642ed8-4d01-390d-953b-0dd4a8927f6e",
                                        "glosses": [
                                            "Celui qui est trompé, dupé, le dindon de la farce."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4611f23-92b3-4a02-ad22-02675170234c",
                                                "sense_id": "465cb6a0-2ffa-3999-8224-76b46385c22f",
                                                "text": "Dans cette histoire, c’est moi le cocu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76b69671-c729-344c-bfba-7fdf004f64b5",
                                        "entry_id": "9f642ed8-4d01-390d-953b-0dd4a8927f6e",
                                        "glosses": [
                                            "Personne qui a de la chance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3164ca1e-8af7-4c03-a532-7becc1bb35db",
                                                "sense_id": "76b69671-c729-344c-bfba-7fdf004f64b5",
                                                "text": "Avoir une veine (une chance) de cocu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7680313f-c03a-340f-8e38-2ca7087b05ae",
                                        "entry_id": "9f642ed8-4d01-390d-953b-0dd4a8927f6e",
                                        "glosses": [
                                            "Escargot (en France dans le Sud-Ouest), peut-être à cause des prétendues cornes dont on affuble parfois les maris trompés, ou à cause de sa coquille (ou coque)."
                                        ],
