                    {
                        "sense_id": "6e95ff68-08da-3ce7-b04a-b1ba8cf73243",
                        "entry_id": "0621b469-560b-3e6e-9a81-045499db4af8",
                        "glosses": [
                            "eine Person, die eine andere Person oder eine Sache in Schutz nimmt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90ab9993-ed26-41be-884d-e14fd2bedcab",
                                "sense_id": "6e95ff68-08da-3ce7-b04a-b1ba8cf73243",
                                "text": "Der Beschützer stellte sich dem Angreifer entgegen."
                            },
                            {
                                "example_id": "39922e57-6009-4a5c-9a29-5586c0471d35",
                                "sense_id": "6e95ff68-08da-3ce7-b04a-b1ba8cf73243",
                                "text": "„Zur Rolle des ältesten Sohnes gehört es nun, Beschützer der Mutter zu sein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ffacb09b-ec0e-36ac-8f52-a5535ebb7ce3",
                        "entry_id": "0621b469-560b-3e6e-9a81-045499db4af8",
                        "glosses": [
                            "eine Person, die eine andere Person unter ihre Fittiche nimmt und unterstützt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce3f3476-5240-488b-862e-e90a842285cf",
                                "sense_id": "ffacb09b-ec0e-36ac-8f52-a5535ebb7ce3",
                                "text": "Ihr Beschützer half ihr dann auch bei der Ausgabe ihres ersten Gedichtbandes."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "5144af06-6a90-3762-9b1d-700244f7ad05",
                        "entry_id": "0621b469-560b-3e6e-9a81-045499db4af8",
                        "glosses": [
                            "eine Person, die für eine andere Person der Zuhälter ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ff99804-abc7-431b-a622-b74475f4ee5e",
                                "sense_id": "5144af06-6a90-3762-9b1d-700244f7ad05",
                                "text": "Vorsicht, da drüben in der Corvette sitzt Mandys Beschützer!"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
