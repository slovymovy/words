                        "translation_id": "b4c18948-b86d-4534-977a-467bc7b6119f",
                        "source_entry_id": "2168abe0-6361-37b7-9d28-20e9914991d2",
                        "source_sense_id": "cade2780-222a-3c57-abcf-8660433d1193",
