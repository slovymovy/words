                                        "sense_id": "827b5156-b352-3667-ad79-9066ab169e74",
                                        "entry_id": "c3fa2d93-59a6-30f3-9c62-030217e03715",
                                        "glosses": [
                                            "The yield of harvesting, i.e., the gathered crops or fruits."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fbebd05d-9b1a-4d2e-9ec8-906b71a3e6bd",
                                                "sense_id": "827b5156-b352-3667-ad79-9066ab169e74",
                                                "text": "This year's cotton harvest was great but the corn harvest was disastrous."
                                            },
                                            {
                                                "example_id": "af0b2e60-65f3-4829-82a0-f87ea263fecc",
                                                "sense_id": "827b5156-b352-3667-ad79-9066ab169e74",
                                                "text": "Hester Earle and Violet Wayne were moving about the aisle with bundles of wheat-ears and streamers of ivy, for the harvest thanksgiving was shortly to be celebrated, while the vicar stood waiting for their directions on the chancel steps with a great handful of crimson gladioli."
                                            },
                                            {
                                                "example_id": "1f722f14-3558-4eb7-bfb9-2f22207b5d5b",
                                                "sense_id": "827b5156-b352-3667-ad79-9066ab169e74",
                                                "text": "The frizzle-headed man-eaters were loath to leave their fleshpots so long as the harvest of human carcases was plentiful. Sometimes, when the harvest was too plentiful, they imposed on the missionaries by letting the word slip out that on such a day there would be a killing and a barbecue."
                                            },
                                            {
                                                "example_id": "8d241cab-87a0-4011-bb5c-dbedd4e18b1c",
                                                "sense_id": "827b5156-b352-3667-ad79-9066ab169e74",
                                                "text": "To glean the broken ears after the man / That the main harvest reaps."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e98a29d-92fa-3886-871a-48b7be306c94",
                                        "entry_id": "c3fa2d93-59a6-30f3-9c62-030217e03715",
                                        "glosses": [
                                            "The product or result of any exertion or course of action; reward or consequences."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "59b53e50-096f-4cbf-8348-cc68f85c945a",
                                                "sense_id": "9e98a29d-92fa-3886-871a-48b7be306c94",
                                                "text": "The surveillance mission yielded a healthy harvest of intel."
                                            },
                                            {
                                                "example_id": "653da9b7-efab-4697-bd73-520169d910f9",
                                                "sense_id": "9e98a29d-92fa-3886-871a-48b7be306c94",
                                                "text": "The pope's principal harvest was in the jubilee."
                                            },
                                            {
                                                "example_id": "6de5f13c-2586-4819-a3c7-825c0719614f",
                                                "sense_id": "9e98a29d-92fa-3886-871a-48b7be306c94",
                                                "text": "the harvest of a quiet eye"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "39442c20-9a2c-30de-b248-cb3fc5a4e528",
                                        "entry_id": "c3fa2d93-59a6-30f3-9c62-030217e03715",
