                ],
                "senses": [
                    {
                        "sense_id": "126f8985-94b6-3213-ba39-38cfa1eaf09d",
                        "entry_id": "3bcf1af5-ceea-39d6-91ad-f654ab1c979f",
                        "glosses": [
                            "trouw, toegenegen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c00dd40-4c8b-41d0-9c81-e2529cdd094d",
                                "sense_id": "126f8985-94b6-3213-ba39-38cfa1eaf09d",
                                "text": "De kat was erg aanhankelijk."
                            },
                            {
                                "example_id": "7bb7c4ea-c1a6-40aa-bc68-2f28041ddc35",
                                "sense_id": "126f8985-94b6-3213-ba39-38cfa1eaf09d",
                                "text": "Maar de laatste jaren werd ze er ook weleens moe van, zoals je moe kunt worden van een al te aanhankelijk huisdier, een kat die om je benen draait en voortdurend op je schoot wil springen."
                            },
                            {
                                "example_id": "73ec661e-e769-40bd-b683-0079de0f3eb1",
                                "sense_id": "126f8985-94b6-3213-ba39-38cfa1eaf09d",
                                "text": "Helaas was ze door Dora's opruimactie alleen nog maar aanhankelijker geworden, zodat Dora serieus de indruk had dat ze met elke stap op een kindervoet of hondenpoot stapte."
                            }
                        ]
                    },
                    {
                        "sense_id": "a1f33bd6-7200-3446-8c49-dd38839b427a",
                        "entry_id": "3bcf1af5-ceea-39d6-91ad-f654ab1c979f",
                        "glosses": [
                            "niet zelfstandig"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea8c5333-700c-4b18-be05-53c187bbbd21",
                                "sense_id": "a1f33bd6-7200-3446-8c49-dd38839b427a",
                                "text": "Het onzekere meisje was heel aanhankelijk naar haar vriend, ze kon nog geen dag zonder hem."
                            },
                            {
                                "example_id": "5d9b75b2-1533-471b-a72d-befa55b21f1c",
                                "sense_id": "a1f33bd6-7200-3446-8c49-dd38839b427a",
                                "text": "Ik lijk wel een aanhankelijk huisvrouwtje."
                            },
                            {
                                "example_id": "9f5ac3ec-5ac5-4330-a1b1-edf22efe095d",
                                "sense_id": "a1f33bd6-7200-3446-8c49-dd38839b427a",
                                "text": "Helaas waren zijn problemen aanhankelijk als een hond die zijn baasje op de voet volgt."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9dd646b5-3f4c-4314-95ca-81c5503275d5",
                        "source_entry_id": "3bcf1af5-ceea-39d6-91ad-f654ab1c979f",
