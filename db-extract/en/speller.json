                                    {
                                        "sense_id": "708ec122-16b7-30a7-bfde-0171401f8da4",
                                        "entry_id": "49549f6b-2a54-356a-8776-24f541788bdf",
                                        "glosses": [
                                            "Programme informatique signalant à l’utilisateur la non-concordance d’un mot avec celui de son dictionnaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a9db78a-bf42-4501-8a3e-039cadec7bf6",
                                                "sense_id": "708ec122-16b7-30a7-bfde-0171401f8da4",
                                                "text": "Les correcteurs orthographiques sont très utiles pour la correction orthographique mais ne corrigent naturellement pas les erreurs de syntaxe ou les erreurs d’homonymies."
                                            },
                                            {
                                                "example_id": "49311270-db63-4665-aed7-9ed4e1e26c76",
                                                "sense_id": "708ec122-16b7-30a7-bfde-0171401f8da4",
                                                "text": "Il faudrait que nous nous associassions… Et mon correcteur orthographique qui s’entête à me proposer : associations !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8dabcd6e-8372-4678-b434-c568dc00de7c",
                        "source_entry_id": "d25b244b-aa37-3711-8d77-b015e50ac9ed",
                        "source_sense_description": "spell checker",
                        "target_lang_word": "vérificateur d’orthographe",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vérificateur d’orthographe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a32029ac-2468-3c90-b1c7-7735907e5a3a",
                                        "entry_id": "10db351a-8475-3925-b483-9fa4f906c83e",
                                        "glosses": [
                                            "Programme informatique signalant à l’utilisateur la non-concordance d’un mot avec celui de son dictionnaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dcc14a6c-db18-4218-b487-07eba00ad7be",
                                                "sense_id": "a32029ac-2468-3c90-b1c7-7735907e5a3a",
                                                "text": "Un vérificateur d’orthographe opérationnel dans un traitement de texte n’est rien d’autre qu’un algorithme interprétant, alors même que le scripteur est en train d’écrire, le texte qui s’écrit."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "22feb902-c946-4c8e-8617-6ce635624982",
                        "source_entry_id": "d25b244b-aa37-3711-8d77-b015e50ac9ed",
                        "source_sense_description": "spell checker",
                        "target_lang_word": "vérificateur orthographique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vérificateur orthographique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e194e29d-8475-3979-a467-39823764c120",
                                        "entry_id": "6a1b4823-0ffb-3baf-b90f-77c06b00fd92",
                                        "glosses": [
                                            "Programme informatique signalant à l’utilisateur la non-concordance d’un mot avec celui de son dictionnaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1cec1c64-c482-4f7f-85fc-29e4f9d923c5",
                                                "sense_id": "e194e29d-8475-3979-a467-39823764c120",
                                                "text": "Le vérificateur orthographique recherche les mots mal orthographiés à l’aide du dictionnaire de langue et d’un dictionnaire utilisateur."
                                            },
                                            {
                                                "example_id": "f9b21328-c345-4e9a-9652-91c437e8c7ea",
                                                "sense_id": "e194e29d-8475-3979-a467-39823764c120",
                                                "text": "En effet, le vérificateur orthographique se contente de vérifier si les mots rencontrés dans un document soumis à vérification figurent dans un dictionnaire […], sous la forme où ils sont rencontrés dans le document en question, compte non tenu de leur environnement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
