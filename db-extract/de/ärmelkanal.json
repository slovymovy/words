                "senses": [
                    {
                        "sense_id": "35b2cfa6-66f2-3439-8fda-6762a0f55416",
                        "entry_id": "76f80e91-e4e3-304c-842f-6efcc887f250",
                        "glosses": [
                            "Meerenge, die die Nordsee über die Straße von Dover mit dem Atlantik verbindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c64194a0-1177-41e6-9724-8e2f367c369c",
                                "sense_id": "35b2cfa6-66f2-3439-8fda-6762a0f55416",
                                "text": "Zwischen Frankreich im Süden und Großbritannien im Norden liegt der Ärmelkanal."
                            },
                            {
                                "example_id": "48c737d6-2bd6-44b4-af08-81464eaed8d3",
                                "sense_id": "35b2cfa6-66f2-3439-8fda-6762a0f55416",
                                "text": "Der Ärmelkanal ist etwa 6000 Jahre vor Christus entstanden, bis dahin waren die heutigen Britischen Inseln zu Fuß vom europäischen Kontinent aus erreichbar."
                            },
                            {
                                "example_id": "617e383f-9870-4b0a-83b3-3d10e0a8b824",
                                "sense_id": "35b2cfa6-66f2-3439-8fda-6762a0f55416",
                                "text": "„Gleich nach Kriegsbeginn richtet die britische Marine eine Seeblockade zwischen den Shetland-Inseln und Südnorwegen sowie im Ärmelkanal bei Dover ein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "24a69635-9c88-463b-9c6d-5a9dbccb0a86",
                        "source_entry_id": "76f80e91-e4e3-304c-842f-6efcc887f250",
                        "source_sense_id": "35b2cfa6-66f2-3439-8fda-6762a0f55416",
                        "source_sense_description": "Meerenge, die die Nordsee über die Straße von Dover mit dem Atlantik verbindet",
                        "target_lang_word": "English Channel",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "English Channel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "43b8f665-f074-3e1e-ab16-63864681cbe8",
                                        "entry_id": "6a305329-681a-378f-bbe1-8eb98d40b568",
                                        "glosses": [
                                            "The arm of the Atlantic Ocean that separates the British Isles from northern France, and joins the North Sea to the Atlantic Ocean."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "53c9f9d4-65ec-438b-9e6b-832828fe19c8",
                        "source_entry_id": "76f80e91-e4e3-304c-842f-6efcc887f250",
                        "source_sense_id": "35b2cfa6-66f2-3439-8fda-6762a0f55416",
                        "source_sense_description": "Meerenge, die die Nordsee über die Straße von Dover mit dem Atlantik verbindet",
                        "target_lang_word": "Manche",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Manche",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b594f21b-4cd9-36f1-8456-dbb550d0224d",
                                        "entry_id": "3d1a9bc7-df32-3583-af7b-cb779e475562",
                                        "glosses": [
                                            "Mer épicontinentale de l’océan Atlantique, située dans le nord-ouest de l’Europe, entre la France et l’Angleterre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f30f06f7-667a-495b-a0d8-038b244dc134",
                                                "sense_id": "b594f21b-4cd9-36f1-8456-dbb550d0224d",
                                                "text": "Les ravins dont la réunion forme la vallée de la Bresle qui s’ouvre dans la Manche, au-dessous de la ville d’Eu, commencent par des plis de terrain dans les bois de Formerie et à Secqueville, dépendance contiguë de Bouvresse : […]."
                                            },
                                            {
                                                "example_id": "83191a50-869b-4ef1-a06d-e6109c364c09",
                                                "sense_id": "b594f21b-4cd9-36f1-8456-dbb550d0224d",
                                                "text": "L’« éventrement » d’un supertanker menace la vie d’un petit équipage, mais pollue une fraction notable de la Manche ou de la mer du Nord."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba738452-ff20-3ec3-b089-cf695e455569",
                                        "entry_id": "3d1a9bc7-df32-3583-af7b-cb779e475562",
                                        "glosses": [
                                            "Département français, qui inclut la péninsule du Cotentin. Ce département porte le numéro 50."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8eefaa20-30d4-40b3-b4ff-deac4ab1db7a",
                                                "sense_id": "ba738452-ff20-3ec3-b089-cf695e455569",
                                                "text": "Les îles Saint-Marcouf, ne l’oubliez pas, sont presque équidistantes du littoral de la Manche et de celui du Calvados, par le travers de la baie des Veys."
                                            },
                                            {
                                                "example_id": "515e6a02-1eb6-49b4-b7a6-cc0e3e66968f",
                                                "sense_id": "ba738452-ff20-3ec3-b089-cf695e455569",
                                                "text": "Seuls deux sites pétroliers sont encore en grève : le dépôt de carburants de Feyzin (Rhône) et la raffinerie de Gonfreville (Manche), où la grève est reconduite jusqu’à jeudi."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Manche",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c074c3c4-72e1-32b7-ba38-525fc66f918d",
                                        "entry_id": "46fb2ecb-a594-3aab-8bbe-5cbb218507cb",
                                        "glosses": [
                                            "Région historique d’Espagne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72ba33d0-5a42-40c9-9486-96d3f7b9551c",
                                                "sense_id": "c074c3c4-72e1-32b7-ba38-525fc66f918d",
                                                "text": "L’Ingénieux Hidalgo Don Quichotte de la Manche."
                                            },
                                            {
                                                "example_id": "b99db83c-b2c9-4195-806b-6dda561e27d7",
                                                "sense_id": "c074c3c4-72e1-32b7-ba38-525fc66f918d",
                                                "text": "Il a toujours été maigre, mais il était, en ce temps-là, presque aussi maigre que l’illustre gentilhomme de la Manche."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
