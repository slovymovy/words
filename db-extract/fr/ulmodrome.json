                "senses": [
                    {
                        "sense_id": "dfb8cfe5-f380-357d-b86d-e15bb70e68a6",
                        "entry_id": "c07034c8-204f-3cf5-8dfc-8b1f921ee4d3",
                        "glosses": [
                            "Aérodrome destiné à l'utilisation d’aéronefs ultralégers motorisés (ULM)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4a6946e-f9e3-4390-b0c3-5f4dddb7aad5",
                                "sense_id": "dfb8cfe5-f380-357d-b86d-e15bb70e68a6",
                                "text": "La présente circulaire a pour objet de fixer les conditions techniques d’établissement et d’exploitation auxquelles doivent satisfaire les ulmodromes civils utilisés uniquement dans les conditions météorologiques permettant le vol à vue, sans préjudice des dispositions appliquées à chaque ulmodrome."
                            },
                            {
                                "example_id": "577e09cb-2355-4a1c-b180-32ac458eed6d",
                                "sense_id": "dfb8cfe5-f380-357d-b86d-e15bb70e68a6",
                                "text": "Celui qui veut aménager et exploiter un ulmodrome en Belgique doit disposer d'une autorisation de la Direction générale Transports aériens (DGTA), l’« autorisation d'établissement »."
                            },
                            {
                                "example_id": "1d340ada-b317-484b-9e2c-2b1f1fa1daed",
                                "sense_id": "dfb8cfe5-f380-357d-b86d-e15bb70e68a6",
                                "text": "Les exploitants de l’ulmodrome de Liernu peuvent pousser un \"ouf\" de soulagement. Ils viennent de recevoir un permis unique en bonne et due forme de la part du ministre wallon Carlo Di Antonio."
                            }
                        ]
                    }
                ],
