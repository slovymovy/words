                "senses": [
                    {
                        "sense_id": "5984c458-59d1-3ffc-8414-11afc58d14d9",
                        "entry_id": "dcd7970b-0f08-3758-b432-5cfb35bb0ec1",
                        "glosses": [
                            "Prinzip, das die Grundlage/Basis für etwas bildet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df47a92d-98f7-4bc8-b331-07314a3655c5",
                                "sense_id": "5984c458-59d1-3ffc-8414-11afc58d14d9",
                                "text": "„Der Monismus führt alle Phänomene der Welt auf ein einziges Grundprinzip zurück.“"
                            },
                            {
                                "example_id": "01de0637-17b4-43a1-9364-d08af042b930",
                                "sense_id": "5984c458-59d1-3ffc-8414-11afc58d14d9",
                                "text": "„Die Orthographietheoretiker seit dem 16. Jahrhundert haben nicht ohne Not als ein wichtiges Grundprinzip der Schreibung den Usus genannt, den Sprachgebrauch.“"
                            },
                            {
                                "example_id": "3621e162-850a-4e27-ab94-db8336dc1156",
                                "sense_id": "5984c458-59d1-3ffc-8414-11afc58d14d9",
                                "text": "„Denn das Grundprinzip der Naturwissenschaft ist die Überprüfung von Vermutungen durch das Experiment.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
