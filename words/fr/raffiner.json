            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f1c849e9-964d-355a-ac23-2da925e3c5e4",
                    "sense_definition": "Débarrasser une matière première de ses impuretés par des procédés chimiques ou mécaniques.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "chimie_industrie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette usine utilise des méthodes modernes pour <w>raffiner</w> le sucre brut importé."
                        },
                        {
                            "text": "Les artisans savaient déjà comment <w>raffiner</w> l'argent pour obtenir un métal pur."
                        }
                    ],
                    "synonyms": [
                        "purifier",
                        "épurer"
                    ],
                    "common_phrases": [
                        "raffiner le sucre",
                        "raffiner du minerai"
                    ]
                },
                {
                    "sense_id": "3694b9b0-0361-3193-8853-816627932b8d",
                    "sense_definition": "Traiter le pétrole brut ou le gaz naturel pour en extraire des carburants et des dérivés.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "chimie_industrie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le pays a décidé de construire une nouvelle usine pour <w>raffiner</w> le pétrole sur son propre territoire."
                        },
                        {
                            "text": "Les grandes compagnies pétrolières <w>raffinent</w> le brut avant de le distribuer dans les stations-service."
                        }
                    ],
                    "common_phrases": [
                        "raffiner le pétrole",
                        "raffiner le brut"
                    ]
                },
                {
                    "sense_id": "b03ef516-e13d-3f98-bef4-7a055e874c74",
                    "sense_definition": "Rendre quelque chose plus précis, subtil ou soigné ; perfectionner.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "perfectionnement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vous devez ajouter des filtres pour <w>raffiner</w> une recherche et trouver les bons documents."
                        },
                        {
                            "text": "L'écrivain prend le temps de <w>raffiner</w> son style avant d'envoyer le manuscrit à l'éditeur."
                        }
                    ],
                    "synonyms": [
                        "peaufiner",
                        "perfectionner",
                        "préciser"
                    ],
                    "common_phrases": [
                        "raffiner une recherche",
                        "raffiner son style"
                    ]
                },
                {
                    "sense_id": "30956fa2-32fb-38b9-ad63-3e7c4e42311e",
                    "sense_definition": "Pousser trop loin la subtilité dans un raisonnement ou s'attarder sur des détails futiles.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "subtilite_excessive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il ne sert à rien de <w>raffiner</w> sur les mots quand la situation exige une action immédiate."
                        },
                        {
                            "text": "Les critiques aiment <w>raffiner</w> sur chaque phrase sans saisir l'esprit général du livre."
                        }
                    ],
                    "synonyms": [
                        "chicaner",
                        "ergoter"
                    ],
                    "common_phrases": [
                        "raffiner sur les mots",
                        "raffiner sur des détails"
                    ]
                },
                {
                    "sense_id": "cd196a74-250f-35d2-bbf3-223f6d23f71d",
                    "sense_definition": "Rendre moins dense ou plus ténu ; raréfier.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "rarefaction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En montant dans les hautes altitudes, le froid semblait <w>raffiner</w> l'air de la montagne."
