                    {
                        "translation_id": "e44bbb55-39d5-4a16-a4dd-a577ccfc0a4d",
                        "source_entry_id": "edf5a140-4b81-396f-8c0d-ca143becae18",
                        "source_sense_id": "1a64bb10-de0c-3842-97be-925a47029f11",
