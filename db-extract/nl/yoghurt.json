                "senses": [
                    {
                        "sense_id": "d3b22083-b55b-3d8a-92ff-422e7b2cd3dc",
                        "entry_id": "0c08be99-3227-308e-a535-a505baec4532",
                        "glosses": [
                            "lichtzuur en enigszins lobbig zuivelproduct, gemaakt door het toevoegen van melkzuurbacteriën aan gewone melk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d782c0ce-1d49-4498-a7d2-ff7a55f6fdaf",
                                "sense_id": "d3b22083-b55b-3d8a-92ff-422e7b2cd3dc",
                                "text": "De yoghurt was, doordat hij in de zon gestaan had, helemaal zuur geworden."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "967afc55-4c1a-43ea-96e9-2c19aceec937",
                        "source_entry_id": "0c08be99-3227-308e-a535-a505baec4532",
                        "source_sense_id": "d3b22083-b55b-3d8a-92ff-422e7b2cd3dc",
                        "source_sense_description": "lichtzuur en enigszins lobbig zuivelproduct,...",
                        "target_lang_word": "Joghurt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Joghurt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e6f943e6-24cf-3259-8a2c-80a2fc914410",
                                        "entry_id": "78fbabc4-1fc1-3260-bfae-aaa3c846604c",
                                        "glosses": [
                                            "Dickmilchprodukt, welches aus eingedickter, pasteurisierter Milch gewonnen wird, in der durch spezielle Milchsäurebakterien eine Teilgärung hervorgerufen wurde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a3f4498-e2cf-4b2a-9a10-3d2a94a1b910",
                                                "sense_id": "e6f943e6-24cf-3259-8a2c-80a2fc914410",
                                                "text": "„Seit Jahrtausenden nutzen Menschen die Wirkung von Enzymen: Ohne sie gäbe es keinen Joghurt, keinen Wein, kein Bier.“"
                                            },
                                            {
                                                "example_id": "cd875bd6-2e50-4765-bb48-268e2982b842",
                                                "sense_id": "e6f943e6-24cf-3259-8a2c-80a2fc914410",
                                                "text": "Deutschland: „Diese Produkte kennt fast jeder: die \"Müller-Milch\", den \"Joghurt mit Ecke\" oder den \"Froop-Frucht auf Joghurt\".“"
                                            },
                                            {
                                                "example_id": "79cb88ee-8cd1-4b6c-86b2-ba6e87ab8cd6",
                                                "sense_id": "e6f943e6-24cf-3259-8a2c-80a2fc914410",
                                                "text": "Österreich: „Die Joghurt stammt aus dem Orient und entsteht durch die Gerinnung von Milch“"
                                            },
                                            {
                                                "example_id": "846fffec-3125-461f-855b-b0a9fa13fd8c",
                                                "sense_id": "e6f943e6-24cf-3259-8a2c-80a2fc914410",
                                                "text": "Schweiz: „Ihr Seliger zum Beispiel habe sich einmal zu Beginn einer Ohnmacht das Joghurt über den Kopf geleert und nachher behauptet, sie selber habe das getan“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "57b4b80e-db8f-4489-84e5-01f19a899532",
                        "source_entry_id": "0c08be99-3227-308e-a535-a505baec4532",
                        "source_sense_id": "d3b22083-b55b-3d8a-92ff-422e7b2cd3dc",
                        "source_sense_description": "lichtzuur en enigszins lobbig zuivelproduct,...",
                        "target_lang_word": "yoghurt",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "yoghurt",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "aec3ff10-1e7d-3fcc-b400-23d648506f6f",
                                        "entry_id": "d2d6d4bf-d5c2-3cfa-b5c7-c90f68525f4d",
                                        "glosses": [
                                            "Alternative spelling of yogurt."
                                        ],
                                        "tags": [
                                            "UK",
                                            "alt-of",
                                            "alternative",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f7e896a6-bde1-42c4-b080-280688f890e9",
                                                "sense_id": "aec3ff10-1e7d-3fcc-b400-23d648506f6f",
                                                "text": "Many icecream shops now sell soft-serve yoghurts, icecreams and ice-desserts that are high in carbos and low in fat."
                                            },
                                            {
                                                "example_id": "51b2f765-f4ad-4b71-b140-ecf4dccfd9b7",
                                                "sense_id": "aec3ff10-1e7d-3fcc-b400-23d648506f6f",
                                                "text": "It was certainly an old smell – of that I could be certain. But it was not, I was sure, produced by any of the three thousand one hundred and twenty-six cheeses, yoghurts and fromages blancs that were being stored in the crypt."
                                            },
                                            {
                                                "example_id": "46e1f109-2988-4bd4-958b-33531fbdf069",
                                                "sense_id": "aec3ff10-1e7d-3fcc-b400-23d648506f6f",
                                                "text": "One serve of carbohydrates is approximately equal to a slice of bread, a piece of fruit, third of a cup of cooked rice, half a cup of grains, cereals, starchy vegetables or cooked pasta, 200 grams of plain yoghurt, or 300 millilitres of milk."
                                            },
                                            {
                                                "example_id": "1f02eb8d-6a66-4730-8219-175a99d395ea",
                                                "sense_id": "aec3ff10-1e7d-3fcc-b400-23d648506f6f",
                                                "text": "fudgy flapjacky fudge […] I always buy one of those flapjacks with a layer of yoghurt on top. But even with the topping, they are just never sweet enough for me. I also love fudge but that can be toe-curlingly sweet. So, in my search for a middle ground, I decided to combine the two."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ae493c6b-e756-488c-8925-f92de7d85179",
                        "source_entry_id": "0c08be99-3227-308e-a535-a505baec4532",
                        "source_sense_id": "d3b22083-b55b-3d8a-92ff-422e7b2cd3dc",
                        "source_sense_description": "lichtzuur en enigszins lobbig zuivelproduct,...",
                        "target_lang_word": "yaourt",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "yaourt",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "43a25bcc-0719-3e95-a48c-ef788799058e",
                                        "entry_id": "ef9f3b37-979d-3f05-903b-cd317d299a1b",
                                        "glosses": [
                                            "Lait caillé préparé à partir de ferments lactiques."
                                        ],
                                        "tags": [
                                            "France"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e2a62d1-00d8-41e1-836c-b317febc092f",
                                                "sense_id": "43a25bcc-0719-3e95-a48c-ef788799058e",
                                                "text": "Le yaourt se conserve trois semaines à + 4 °C, 10 jours à 8-10 °C avec les bactéries lactiques toujours vivantes."
                                            },
                                            {
                                                "example_id": "64c995e3-3898-4b69-bde4-1834f946038e",
                                                "sense_id": "43a25bcc-0719-3e95-a48c-ef788799058e",
                                                "text": "Rien de plus facile que de fabriquer ses yaourts à la maison. Il suffit de mélanger du lait chauffé à environ 40 °C avec un ferment lactique et de maintenir cette température pendant un certain temps."
                                            },
                                            {
                                                "example_id": "acd8393a-0ccf-41a9-b39b-9d67187d6d93",
                                                "sense_id": "43a25bcc-0719-3e95-a48c-ef788799058e",
                                                "text": "Les yaourts se font de préférence avec du lait de vache entier ou bio. […]. S'il s'agit de lait UHT, vous pourrez conserver vos yaourts faits maison pendant une semaine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fdbed810-c54e-33cd-959d-6e022ddf7ca2",
                                        "entry_id": "ef9f3b37-979d-3f05-903b-cd317d299a1b",
                                        "glosses": [
                                            "Sorte de pot qui contient ce mets."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "89ee38ae-f97e-429d-b532-7320d9705a6a",
                                                "sense_id": "fdbed810-c54e-33cd-959d-6e022ddf7ca2",
                                                "text": "On peut aussi dire que cette opération est couramment utilisée dans la vie pratique, même si la notion mathématique de proportionnalité n’est pas explicitement requise : la ménagère qui compare le prix de la boîte de 6 yaourts à celui de la boîte de 8 yaourts utilise, inconsciemment peut-être, la notion de proportionnalité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "47bbae2c-e549-3634-a3df-d2457a13b2c2",
                                        "entry_id": "ef9f3b37-979d-3f05-903b-cd317d299a1b",
                                        "glosses": [
                                            "Préparation liquide épaisse à base de lait conditionnée dans un pot, telle que le fromage blanc et les entremets."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "28db5a2f-81bd-3355-b92c-b26fade03644",
                                        "entry_id": "ef9f3b37-979d-3f05-903b-cd317d299a1b",
                                        "glosses": [
                                            "Sorte de borborygme chantonné en imitant des paroles sans les connaître, ni les comprendre."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bc73045b-eedb-46ca-9c30-0be821a88f10",
                                                "sense_id": "28db5a2f-81bd-3355-b92c-b26fade03644",
                                                "text": "Vous vous êtes forcément retrouvé, un mercredi soir de Fêtes de Bayonne ou un samedi de match à Jean Dauger, en train de chanter du yaourt sur l’air d’Hegoak."
                                            },
                                            {
                                                "example_id": "6fe1b5ab-676c-4091-9bdf-6c067df57ab1",
                                                "sense_id": "28db5a2f-81bd-3355-b92c-b26fade03644",
                                                "text": "C’est un duo basse batterie à la Neurosis ! Attention, de vrai barjots ! Ils chantent du yaourt sur un son des plus rentre dedans ! ça s’crache à la gueule, ça transpire, ça boit d’la bière d’une main et joue d’la basse de l’autre !"
                                            },
                                            {
                                                "example_id": "e48d1597-2dc4-40fc-9811-852a40d87aaa",
                                                "sense_id": "28db5a2f-81bd-3355-b92c-b26fade03644",
                                                "text": "J’adorais ces insultes soudaines qui sonnaient comme des formules magiques, des imprécations de vieux grimoires. Je les répétais sans les comprendre, en langue yaourt."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
