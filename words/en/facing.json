                            {
                                "target_lang_word": "обращенный",
                                "target_lang_sense_clarification": "выходящий окнами или фасадом на"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d52e520e-e986-3802-9630-92182d163cf8",
