                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "38cde0f5-9dac-481b-8217-9f1d1d1903dd",
                                "sense_id": "5586973f-73ba-35be-b2f9-4d0330aef20e",
                                "text": "Il toise tout le monde parce que papa maman sont pleins d’argent, un vrai snobinard !"
                            },
                            {
                                "example_id": "75cfae43-9f7b-44cb-a995-eac05118972b",
                                "sense_id": "5586973f-73ba-35be-b2f9-4d0330aef20e",
                                "text": "« Nous en avons assez de cette littérature au jus de serpillière, de ce vocabulaire crapuleux pour snobinards décomposés, de ces personnages maladifs, hagards et malfaisants, et de ces auteurs qui jouent la note naturaliste pour étonner les gogos. »"
                            },
                            {
                                "example_id": "92136568-4dd8-4046-af79-d5e2d59171db",
                                "sense_id": "5586973f-73ba-35be-b2f9-4d0330aef20e",
                                "text": "Les snobinards new-yorkais ont imposé l’adage : « Plus c’est haut, plus c’est beau »."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "03c45264-1808-470a-aa8d-1ba2657b5aff",
                        "source_entry_id": "5a43c967-41ed-3753-98c4-28df6cd0272a",
                        "source_sense_id": "5586973f-73ba-35be-b2f9-4d0330aef20e",
