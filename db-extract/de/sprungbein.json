                                        "sense_id": "d6461d47-b337-3aa6-a762-185a1a7037f6",
                                        "entry_id": "0c10bdb5-cf85-3fc4-b54a-e3771c963b32",
                                        "glosses": [
                                            "A sloping heap of fragments of rock lying at the foot of a precipice."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2fba9e9-57d3-4d7c-852e-7464fb115145",
                                                "sense_id": "d6461d47-b337-3aa6-a762-185a1a7037f6",
                                                "text": "By the time he reached the first talus slides under the tall escarpments of the Pilares the dawn was not far to come."
                                            },
                                            {
                                                "example_id": "58471cb3-aabe-4dd9-8be1-98652e5ae04c",
                                                "sense_id": "d6461d47-b337-3aa6-a762-185a1a7037f6",
                                                "text": "Above here is what is known as a talus slope - sandstone that has gradually disintegrated and tumbled down to create a menacing sloping pile of loose rock."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c0cd605e-1c5d-3e4b-8f89-6f4ad49ad562",
                                        "entry_id": "0c10bdb5-cf85-3fc4-b54a-e3771c963b32",
                                        "glosses": [
                                            "The slope of an embankment wall, which is thicker at the bottom than at the top."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
