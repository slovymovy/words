                            },
                            {
                                "target_lang_word": "austro",
                                "target_lang_sense_clarification": "viento procedente del sur"
                            },
                            {
                                "target_lang_word": "ábrego",
                                "target_lang_sense_clarification": "viento templado y húmedo del suroeste/sur"
                            }
                        ]
                    }
                }
            ]
        }
    ]
