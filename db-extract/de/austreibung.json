                "senses": [
                    {
                        "sense_id": "c944e0ef-8d06-3c93-994b-fe5de42c5f80",
                        "entry_id": "cea83190-273b-3215-a12a-b2be021f61c4",
                        "glosses": [
                            "das erzwungene Verlassen eines Ortes"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "2539b80f-8f47-3a77-82f9-178324693500",
                        "entry_id": "cea83190-273b-3215-a12a-b2be021f61c4",
                        "glosses": [
                            "das Verbannen von (vermeintlich vorhandenen) Dämonen, bösen Geistern beziehungsweise des Teufels aus Menschen, Tieren, Orten oder Dingen"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "48463432-d65f-30b6-b2bc-3fd18e832d82",
                        "entry_id": "cea83190-273b-3215-a12a-b2be021f61c4",
                        "glosses": [
                            "das Hinauspressen nach Öffnung des Muttermundes bis zur vollständigen Geburt des Kindes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ac27970-4137-4cb1-aa7c-60fbcc2eb405",
                                "sense_id": "48463432-d65f-30b6-b2bc-3fd18e832d82",
                                "text": "„Nach Beendigung der Austreibung sind Mutter und Kind noch durch die Nabelschnur verbunden, die meist schon völlig kollabiert (in sich zusammengefallen) ist.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "74739195-4db0-3e30-83e7-ed00a1a2eb44",
                        "entry_id": "cea83190-273b-3215-a12a-b2be021f61c4",
                        "glosses": [
                            "Transport von Blut aus der Herzkammer in den Blutkreislauf"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6ba58c2-2a07-4167-b12c-aefb67fa354d",
                                "sense_id": "74739195-4db0-3e30-83e7-ed00a1a2eb44",
                                "text": "„Wegen des schalenförmigen Aufsitzens der rechten Ventrikelwand auf dem linken Ventrikel wird die Austreibung dabei noch durch Vorbuchtung des Septums in den rechten Ventrikel hinein unterstützt.“"
                            }
                        ],
                        "sense_index_json": "\"4\""
                    },
                    {
                        "sense_id": "5dbc27d9-54d9-37d9-b1e9-3acdd5cadeeb",
                        "entry_id": "cea83190-273b-3215-a12a-b2be021f61c4",
                        "glosses": [
                            "„Entfernung (Desorption) gelöster Gase aus einer Flüssigkeit“"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"5\""
                    }
