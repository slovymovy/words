                                "target_senses": [
                                    {
                                        "sense_id": "b9634c66-445e-3fac-a8e2-83308f7318b9",
                                        "entry_id": "d4035e2b-b918-34a6-9b6a-9d6c432b11a9",
                                        "glosses": [
                                            "Obsolete form of traitoress."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "90d4903e-1d65-4e7d-911f-00162c8a0ceb",
                                                "sense_id": "b9634c66-445e-3fac-a8e2-83308f7318b9",
                                                "text": "My wife, my traitress, let her not come near me."
                                            },
                                            {
                                                "example_id": "e55fc69f-e469-49f5-b2f4-91537696ebfb",
                                                "sense_id": "b9634c66-445e-3fac-a8e2-83308f7318b9",
                                                "text": "Would'st thou revenge thee, traitress, hadst thou pow'r?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
