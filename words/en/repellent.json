{
    "word_family": [
        "repel",
        "repulsion",
        "repulsive"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3d1b18cc-e98a-33c2-b631-86ee2b328439",
                    "sense_definition": "Causing strong dislike or disgust.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "disgusting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The smell of the rotting garbage was truly <w>repellent</w>.",
                            "target_lang_translations": {
                                "zh": "腐烂垃圾的气味实在<w>令人厌恶</w>。"
                            }
                        },
                        {
                            "text": "His <w>repellent</w> behavior made everyone leave the party early.",
                            "target_lang_translations": {
                                "zh": "他那<w>令人反感</w>的行为让大家早早离开了派对。"
                            }
                        }
                    ],
                    "synonyms": [
                        "repulsive",
                        "disgusting",
                        "revolting"
                    ],
                    "antonyms": [
                        "attractive",
                        "appealing"
                    ],
                    "common_phrases": [
                        "repellent behavior",
                        "repellent smell"
                    ],
                    "target_lang_definitions": {
                        "zh": "引起强烈反感或厌恶的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "令人厌恶的",
                                "target_lang_sense_clarification": "形容事物或行为让人感到反感。"
                            },
                            {
                                "target_lang_word": "排斥的",
                                "target_lang_sense_clarification": "形容让人想要远离或拒绝的。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e81d8154-86cc-37a9-8ace-e02a945815fe",
                    "sense_definition": "Able to push something away or drive it back.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "force",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The magnets exert a <w>repellent</w> force on each other.",
                            "target_lang_translations": {
                                "zh": "磁铁之间产生一种<w>排斥</w>力。"
                            }
                        },
                        {
                            "text": "The <w>repellent</w> force keeps the two objects apart.",
                            "target_lang_translations": {
                                "zh": "这种<w>排斥</w>力使两个物体保持分离。"
                            }
                        }
                    ],
                    "antonyms": [
                        "attractive"
                    ],
                    "common_phrases": [
                        "repellent force"
                    ],
                    "target_lang_definitions": {
                        "zh": "能够产生排斥力或将某物推开的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "排斥的",
                                "target_lang_sense_clarification": "指物理上产生推开作用的。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d056d235-ac51-33fd-a435-7d14a1703d6e",
                    "sense_definition": "Resistant or impervious to a specific substance.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "resistant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This jacket is water <w>repellent</w> and keeps you dry.",
                            "target_lang_translations": {
                                "zh": "这件夹克是<w>防水</w>的，能让你保持干爽。"
                            }
                        },
                        {
                            "text": "The new spray makes the carpet stain <w>repellent</w>.",
                            "target_lang_translations": {
                                "zh": "这种新喷雾能让地毯<w>防污</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "resistant",
                        "proof"
                    ],
                    "common_phrases": [
                        "water repellent",
                        "stain repellent"
                    ],
                    "target_lang_definitions": {
                        "zh": "对某种物质具有抵抗力或不渗透性的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "防……的",
                                "target_lang_sense_clarification": "用于复合词，表示防止某种物质渗入。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "beaeaa97-fb0f-3e22-b9ec-8bcbe18324f7",
                    "sense_definition": "A substance used to keep insects or pests away.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "protection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Apply insect <w>repellent</w> before going into the woods.",
                            "target_lang_translations": {
                                "zh": "进入树林前请涂抹<w>驱虫剂</w>。"
                            }
                        },
                        {
                            "text": "We bought some mosquito <w>repellent</w> for our camping trip.",
                            "target_lang_translations": {
                                "zh": "我们为露营旅行买了一些<w>驱蚊剂</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "deterrent"
                    ],
                    "common_phrases": [
                        "insect repellent",
                        "mosquito repellent"
                    ],
                    "target_lang_definitions": {
                        "zh": "用于驱赶昆虫或害虫的物质。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "驱虫剂",
                                "target_lang_sense_clarification": "专门用于驱赶蚊虫的化学制剂。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d85778d4-216b-3143-af3a-77d10f7dd985",
                    "sense_definition": "A treatment applied to materials to make them resistant to something.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "protection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The shop sells a special <w>repellent</w> for leather shoes.",
                            "target_lang_translations": {
                                "zh": "这家店出售一种专门用于皮鞋的<w>防护剂</w>。"
                            }
                        },
                        {
                            "text": "They applied a dirt <w>repellent</w> to the sofa fabric.",
                            "target_lang_translations": {
                                "zh": "他们在沙发面料上涂了一层<w>防污剂</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "dirt repellent"
                    ],
                    "target_lang_definitions": {
                        "zh": "涂抹在材料上使其具有抗性处理剂。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "防护剂",
                                "target_lang_sense_clarification": "用于保护材料表面免受污渍或液体侵害的物质。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b9a0fb26-f0b1-3e18-817e-756e1995a458",
                    "sense_definition": "Something that causes others to move away or stay away.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "no",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His rude attitude acts as a <w>repellent</w> to new friends.",
                            "target_lang_translations": {
                                "zh": "他粗鲁的态度成了结交新朋友的<w>阻碍</w>。"
                            }
                        },
                        {
                            "text": "The loud noise is a <w>repellent</w> for the birds in the garden.",
                            "target_lang_translations": {
                                "zh": "巨大的噪音是花园里鸟儿的<w>驱赶物</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "act as a repellent"
                    ],
                    "target_lang_definitions": {
                        "zh": "导致他人远离或避开的事物。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "排斥物",
                                "target_lang_sense_clarification": "指导致人或动物避开的因素。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}