                "senses": [
                    {
                        "sense_id": "f5830620-9ed5-3132-bf00-5507390ed8f5",
                        "entry_id": "f1ec32a8-252c-3261-92ec-9625040da211",
                        "glosses": [
                            "Person, die von einer Kolonie in das Mutterland der Kolonie übersiedelt/übergesiedelt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "14f6ff78-c47e-4833-a08d-3d1f44391214",
                                "sense_id": "f5830620-9ed5-3132-bf00-5507390ed8f5",
                                "text": "„Der Verlust der deutschen Kolonien im Ersten Weltkrieg hatte auch Folgen für die Kolonialmigranten und kündigte für sie eine neue Ära an.“"
                            },
                            {
                                "example_id": "0ec4f34d-eac1-4758-ba13-a5f8f62902ae",
                                "sense_id": "f5830620-9ed5-3132-bf00-5507390ed8f5",
                                "text": "„Die Deutsche Afrika-Schau sollte deshalb den für staatenlos erklärten Kolonialmigranten, die kaum noch Arbeit fanden, eine Verdienstmöglichkeit eröffnen.“"
                            },
                            {
                                "example_id": "e71c98bb-1684-4e35-9992-ac3862cd679e",
                                "sense_id": "f5830620-9ed5-3132-bf00-5507390ed8f5",
                                "text": "„Ende 1929 kam er als Kolonialmigrant nach Deutschland.“"
                            },
                            {
                                "example_id": "f61969df-cb63-4c4d-a20c-063e3d8cacc8",
                                "sense_id": "f5830620-9ed5-3132-bf00-5507390ed8f5",
                                "text": "„Nachdem er im Ersten Weltkrieg als Kindersoldat in der deutsch-ostafrikanischen Kolonialtruppe gedient hatte, kam er Ende 1929 als Kolonialmigrant nach Deutschland und gehörte hier zu den bekanntesten Persönlichkeiten unter den Schwarzen Deutschen.“"
                            },
                            {
                                "example_id": "23afc3ac-c985-459c-bc9d-6e76addc4f76",
                                "sense_id": "f5830620-9ed5-3132-bf00-5507390ed8f5",
                                "text": "„Michaels eigenes Leben fängt damit an, dass sein Vater, ein Kolonialmigrant, sich aufmacht in das Land der Kolonisierer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
