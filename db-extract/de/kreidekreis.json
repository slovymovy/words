                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8683eafe-5c88-499e-85c4-890d32510839",
                                "sense_id": "c57604b4-b09a-39a4-b601-afb001c7c4ba",
                                "text": "„Der Punkt erblühte zu einem grün-weißen Fallschirm, und TM landete durch geschickte Handhabung der Steuerleinen in dem weißen, nur einen Meter großen Kreidekreis, den man unmittelbar vor dem Podest aufgezeichnet hatte, von dem aus General Zia die Parade abnahm.“"
                            },
                            {
                                "example_id": "0be1f6a5-1588-4622-9ac1-5501e8ce687a",
                                "sense_id": "c57604b4-b09a-39a4-b601-afb001c7c4ba",
                                "text": "„Die Schusswaffe lag jetzt in einer durchsichtigen Plastiktüte für Beweisstücke auf dem Boden, wo die Spurensicherung mit einem weißen Kreidekreis ihre ursprüngliche Lage gekennzeichnet hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
