                                                "sense_id": "6aa667f1-351f-3843-b787-023b95d7b1a6",
                                                "text": "Currently there are 19 members, who are all in Spotlight and belong to Equity. Areas of work include theatre, musicals, television, film, commercials, corporates and voiceovers."
                                            }
