                ],
                "translations": [
                    {
                        "translation_id": "39c3686d-08e5-4c19-b4d1-c962985810d5",
                        "source_entry_id": "f7db88da-4d75-3dfe-ae5f-7901a34f5196",
                        "source_sense_id": "0b1f0715-b809-3477-881c-87296b7200cb",
                        "source_sense_description": "een vrucht van de hazelaar",
                        "target_lang_word": "Haselnuss",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Haselnuss",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9343a6a8-a66e-3f5b-965b-a282f31eb871",
                                        "entry_id": "3573f557-df81-3835-b6b4-f5523bac4872",
                                        "glosses": [
                                            "eine Gattung verholzender Sträucher und Bäume in der Familie der Birkengewächse"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9185572a-3dde-42be-bcf6-3fb0d2b9fd95",
                                                "sense_id": "9343a6a8-a66e-3f5b-965b-a282f31eb871",
                                                "text": "„Pollen von Frühblühern wie Haselnuss und Erle fliegen als Folge der Erderwärmung bereits im Januar statt im Februar relativ stark.“"
                                            },
                                            {
                                                "example_id": "ccdd3795-89aa-4dfc-b5ab-5aa8d9a6a908",
                                                "sense_id": "9343a6a8-a66e-3f5b-965b-a282f31eb871",
                                                "text": "„Die neuere Waldgeschichte dieser Region beginnt nach der letzten Eiszeit, vor etwa 12 000 Jahren. Auf den baumlosen Tundren siedelten sich Lichtbaumarten an. Weide, Birke, Kiefer, Haselnuss. Schließlich kam die Eiche zurück.“"
                                            },
                                            {
                                                "example_id": "ba091631-459d-4773-879d-1174d1e0a5c4",
                                                "sense_id": "9343a6a8-a66e-3f5b-965b-a282f31eb871",
                                                "text": "„Kunstgerecht gelegte Brände hielten die Eichen gesund und sorgten dafür, dass Haselnuss und Bärengras gedeihen, aus denen die Yurok Körbe flechten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2d76304d-b157-3652-bd38-1c71eeae79ef",
                                        "entry_id": "3573f557-df81-3835-b6b4-f5523bac4872",
                                        "glosses": [
                                            "die Frucht der Haselnuss von [1]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "461f99be-4012-4661-b61b-dbabeac3bf30",
                                                "sense_id": "2d76304d-b157-3652-bd38-1c71eeae79ef",
                                                "text": "„Die Türkei, hunderte Kilometer entfernt vom Ort des atomaren Super-Gaus in der Ukraine, konnte nur noch hochgradig mit Cäsium verseuchte Haselnüsse liefern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7f347e53-1e72-4c00-a37e-ca6d022b9199",
                        "source_entry_id": "f7db88da-4d75-3dfe-ae5f-7901a34f5196",
