                {
                    "sense_id": "6947c53f-6992-3665-92b5-2d830a9188f1",
                    "sense_definition": "vrijwillig of gedwongen afstand doen van een deel van je inkomen, luxe of comfort",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "opofferen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We moeten wel <w>inleveren</w> op onze vakantie nu we minder werken.",
                            "target_lang_translations": {
                                "en": "We do have to <w>sacrifice</w> some of our holiday now that we are working less.",
                                "ru": "Нам придется <w>пожертвовать</w> частью отпуска теперь, когда мы меньше работаем."
                            }
                        },
                        {
                            "text": "Iedereen moest salaris <w>inleveren</w> na de fusie om het bedrijf te redden.",
                            "target_lang_translations": {
                                "en": "Everyone had to <w>take a pay cut</w> after the merger to save the company.",
                                "ru": "Всем пришлось <w>согласиться на сокращение</w> зарплаты после слияния, чтобы спасти компанию."
                            }
                        }
                    ],
                    "common_phrases": [
                        "salaris inleveren",
                        "koopkracht inleveren",
                        "moeten inleveren"
                    ],
                    "target_lang_definitions": {
                        "en": "To voluntarily or forcibly give up a portion of your income, luxury, or comfort.",
                        "ru": "Добровольно или вынужденно отказаться от части дохода, роскоши или комфорта."
                    },
                    "translations": {
