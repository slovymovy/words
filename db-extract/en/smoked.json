                        ],
                        "examples": [
                            {
                                "example_id": "159b8bd6-9807-4dee-b7b2-6ca6464d8883",
                                "sense_id": "f73dbdb4-ea2e-33bd-8093-59c61668d5da",
                                "text": "'A pair of smoked spectacles will do it,' he said positively. 'Look at him now; he looks like an angelic office boy. Put him on a pair of smoked spectacles, and children will scream at the sight of him.'"
                            },
                            {
                                "example_id": "8cfa5226-6736-428d-8ca4-14501e54d8a9",
                                "sense_id": "f73dbdb4-ea2e-33bd-8093-59c61668d5da",
                                "text": "\"You'll need smoked glasses to protect your eyes,\" Paul warned him."
                            }
                        ]
