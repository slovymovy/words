                                        "entry_id": "fd5b5e20-f27b-365c-9ab5-db1519741076",
                                        "glosses": [
                                            "Wirksamkeit einer durchgeführten Maßnahme oder erbrachten Leistung in Hinblick auf das angestrebte Ziel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1cd8744-d088-44b9-a6e8-0891038ecdb8",
                                                "sense_id": "b99a677c-8db0-3920-8514-2b82f567d235",
                                                "text": "Die Effektivität der Umstellung können wir erst in einem Monat beurteilen."
                                            },
                                            {
                                                "example_id": "243534fc-57c3-43ee-a769-b7bdd242da15",
                                                "sense_id": "b99a677c-8db0-3920-8514-2b82f567d235",
                                                "text": "Es ist nicht ganz so leicht, die Effektivität von Online-Werbung zu berechnen."
                                            },
                                            {
                                                "example_id": "48287a0e-d062-4980-92fa-04dddc01272d",
                                                "sense_id": "b99a677c-8db0-3920-8514-2b82f567d235",
                                                "text": "Man könnte die Effektivität noch um 25% steigern, aber das führt natürlich zu höheren Eingangskosten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
