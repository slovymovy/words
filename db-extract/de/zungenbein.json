                    {
                        "form_id": "d7a4dc2b-f6a9-4c0d-9e74-79aea5b1667e",
                        "entry_id": "785bfc24-133b-3b1b-8935-41ea0adb3bc1",
                        "tags": [
                            "accusative",
                            "plural"
