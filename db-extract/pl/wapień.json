                        "translation_id": "13929b36-0c14-41c8-8ca5-c281e7dbfc2b",
                        "source_entry_id": "437842e6-96be-31ad-8f75-835f35deb93b",
                        "source_sense_id": "c6fb6f85-cd44-3ec1-a3de-688fad893f33",
                        "target_lang_word": "limestone",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "limestone",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cbcea8ec-9b04-35c6-b67c-bca20a558ae9",
                                        "entry_id": "04365941-4da9-39e7-8723-cc9d7c2e2878",
                                        "glosses": [
                                            "An abundant rock of marine and freshwater sediments; primarily composed of calcite (CaCO₃); and occurring in a variety of forms, both crystalline and amorphous."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1a4521f-733f-4bb0-8a11-0bc74333a993",
                                                "sense_id": "cbcea8ec-9b04-35c6-b67c-bca20a558ae9",
                                                "text": "a limestone viaduct"
                                            },
                                            {
                                                "example_id": "58b8916e-f883-49b4-8e66-ed61f3ed6fcb",
                                                "sense_id": "cbcea8ec-9b04-35c6-b67c-bca20a558ae9",
                                                "text": "The house was a big elaborate limestone affair, evidently new. Winter sunshine sparkled on lace-hung casement, on glass marquise, and the burnished bronze foliations of grille and door."
                                            },
                                            {
                                                "example_id": "18ae3c67-ac3d-4193-97c1-3ae5c4b901ec",
                                                "sense_id": "cbcea8ec-9b04-35c6-b67c-bca20a558ae9",
                                                "text": "As each blast furnace uses 200 tons of limestone daily, and each limestone kiln 150 tons, a total of 730 tons of limestone has to be carried daily, in addition to limestone chippings, which are sold."
                                            },
                                            {
                                                "example_id": "f38529d6-a38b-42cd-8801-3f9ba25346fe",
                                                "sense_id": "cbcea8ec-9b04-35c6-b67c-bca20a558ae9",
                                                "text": "Rutland (and some of the bordering ‘Notswolds’ counties of Lincolnshire, Leicestershire and Northamptonshire) have the same mellow, creamy limestone as the Cotswolds and boast beguiling market towns and villages that are every bit as attractive, but without the tourists or hefty prices."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
