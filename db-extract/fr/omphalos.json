            {
                "entry_id": "e8567033-230b-330b-b4eb-0394359dc53c",
                "word": "omphalos",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ee6e0a4d-6524-3cc5-b8f1-dfe8cb925afa",
                        "entry_id": "e8567033-230b-330b-b4eb-0394359dc53c",
                        "glosses": [
                            "Espèce de cône de pierre, entouré de bandelettes et dévotement arrosé d’huile, qui se dresse auprès du chasma, et sur lequel s’assoit la pythie qui va prophétiser ; c’est un symbole de la puissance fécondante de la terre."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "089e3889-6241-4c67-b446-5845b9f1cfe3",
                                "sense_id": "ee6e0a4d-6524-3cc5-b8f1-dfe8cb925afa",
                                "text": "L’omphalos est donc cette pierre arrondie qui symbolise le nombril du monde."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a3047b4e-a4f9-4e41-ba44-44b42ac65655",
                        "source_entry_id": "e8567033-230b-330b-b4eb-0394359dc53c",
