                        "form": "пле́шами"
                    },
                    {
                        "form_id": "36e321c7-7496-4392-833f-82b9b71bd3ac",
                        "entry_id": "0eb6cb2c-8841-3cd4-9ec8-27aa9128e72c",
                        "tags": [
                            "singular",
                            "prepositional"
                        ],
                        "form": "пле́ши"
                    },
                    {
                        "form_id": "c0d6b402-8b2b-4fd5-b697-f6448b6aa8bb",
                        "entry_id": "0eb6cb2c-8841-3cd4-9ec8-27aa9128e72c",
                        "tags": [
                            "plural",
                            "prepositional"
                        ],
                        "form": "пле́шах"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "bd9cbe50-d7a5-36fe-afce-055d18edb23d",
                        "entry_id": "0eb6cb2c-8841-3cd4-9ec8-27aa9128e72c",
                        "glosses": [
                            "прост. головка пениса"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80e2e56a-16d4-4a6a-8068-732710d6ca36",
                                "sense_id": "bd9cbe50-d7a5-36fe-afce-055d18edb23d",
                                "text": "И жарко плешь огнём горит, // Муде клубятся сжаты, // В могучих жилах кровь кипит, // И пышет керч мохнатый."
                            }
                        ]
                    },
                    {
                        "sense_id": "8745e39e-0ee3-3006-82bc-a14470b1007e",
                        "entry_id": "0eb6cb2c-8841-3cd4-9ec8-27aa9128e72c",
                        "glosses": [
                            "жарг. ерунда; чушь; безделица"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d5e8cb1-0136-412b-87ab-275484e80979",
                                "sense_id": "8745e39e-0ee3-3006-82bc-a14470b1007e",
                                "text": "«… Скучища у нас тут. Марсиане? Ерунда, плешь… Чего бы нам отколоть, орлы?»"
                            },
                            {
                                "example_id": "3a718309-75b5-48bf-bf86-d4a5e7c2cfa8",
                                "sense_id": "8745e39e-0ee3-3006-82bc-a14470b1007e",
                                "text": "— А я с тобой не согласен, — сказал Антипов. — Насчет Киянова. Что ж, и «Звезда-полынь» — плохая книга? — Ты серьезно? — Котов захохотал. — Перестань! — По-моему, вещь недурная. — А по-моему, плешь."
                            }
                        ]
                    }
                ],
