                "translations": [
                    {
                        "translation_id": "ca0be448-25fd-4905-b285-c790853311a4",
                        "source_entry_id": "6a0c86e6-66fe-3159-8ea1-da08cbc1fb96",
                        "source_sense_id": "76d67405-db54-3440-87a0-32459b9c65d7",
                        "target_lang_word": "snobism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "snobism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "83369335-16a8-3a27-957f-f07197b1b9b1",
                                        "entry_id": "677ef71b-abb4-33af-8894-2cfb18a3e000",
                                        "glosses": [
                                            "Alternative spelling of snobbism."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e448feee-b931-4e5b-84d1-3428f99e5a64",
                                                "sense_id": "83369335-16a8-3a27-957f-f07197b1b9b1",
                                                "text": "I apologize for appearing to sneer. Of *course* I'm anxious for all people who have an interest in wine to have their interest taken seriously. The last thing wine needs is more snobism."
                                            },
                                            {
                                                "example_id": "a4714f00-0418-4d86-b250-4e5189feb936",
                                                "sense_id": "83369335-16a8-3a27-957f-f07197b1b9b1",
                                                "text": "But snobism amoung royalty was still evident this century, when the newly independent Norway elected a king, whose wife was Princess Maud of GB, I think she was snubbed by her own father (???) the future King Edward VII."
                                            },
                                            {
                                                "example_id": "52834a96-9f09-448d-8980-84a0d07ca5a7",
                                                "sense_id": "83369335-16a8-3a27-957f-f07197b1b9b1",
                                                "text": "Sometimes, the intellectual snobism gets a little heavy for my taste."
                                            },
                                            {
                                                "example_id": "037b4476-d7af-420b-9afc-ed55e591b065",
                                                "sense_id": "83369335-16a8-3a27-957f-f07197b1b9b1",
                                                "text": "Maybe a little more snobism is in order, looking down on the ones who don't put forth the money or effort as unprofessional, content to let the profession be perceived by management and doctors as sweet little housewives earning a few extra bucks on the side."
                                            },
                                            {
                                                "example_id": "d03d00d8-c21b-4004-b43a-e061b2811166",
                                                "sense_id": "83369335-16a8-3a27-957f-f07197b1b9b1",
                                                "text": "Get over the stupid snobism and perhaps watch the film before whining."
                                            },
                                            {
                                                "example_id": "76d3d3dd-7f54-4cda-809e-7d34923e8d5b",
                                                "sense_id": "83369335-16a8-3a27-957f-f07197b1b9b1",
                                                "text": "Sorry if you expected your glaring snobisms to go unobserved and without comment from the peanut gallery. It was no great effort to detect them or point them out for what they are....I assure you."
                                            },
                                            {
                                                "example_id": "dcd04ea0-498f-4459-b1d8-6b629f37afcf",
                                                "sense_id": "83369335-16a8-3a27-957f-f07197b1b9b1",
                                                "text": "Rattle certainly did Elgar no favours by eliminating him entirely from his 20th Century series. I see this as a perverse form of intellectual snobism on his part and very regrettable."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ac18db86-b341-4983-a12f-9add890c6b0e",
                        "source_entry_id": "6a0c86e6-66fe-3159-8ea1-da08cbc1fb96",
                        "source_sense_id": "76d67405-db54-3440-87a0-32459b9c65d7",
