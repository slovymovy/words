                "senses": [
                    {
                        "sense_id": "27444a13-5cff-310e-ac5b-11cfca99deda",
                        "entry_id": "4a558b00-e7bd-3563-895f-d901a2ebe788",
                        "glosses": [
                            "морск. связанный, соотносящийся по значению с существительным кильватер; свойственный, характерный для него"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eff96752-9be6-49d0-9e53-64beef2e306c",
                                "sense_id": "27444a13-5cff-310e-ac5b-11cfca99deda",
                                "text": "Эскадра, увеличивая скорость, шла в кильватерном строе."
                            },
                            {
                                "example_id": "e53788aa-a51c-4b64-8c85-b1bc2b714524",
                                "sense_id": "27444a13-5cff-310e-ac5b-11cfca99deda",
                                "text": "Красивую картину представляли они, когда проделывали всякие повороты, принимая то строй кильватерной колонны, то строй фронта."
                            }
                        ]
                    }
