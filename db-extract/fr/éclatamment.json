                        "translation_id": "1a0bfc1d-23dd-4d5c-a016-f3d4abc00c3b",
                        "source_entry_id": "e939b7e0-dcc4-315a-8244-038726321bb8",
                        "source_sense_id": "7198cbf2-73cd-378d-8cdc-5cb83daed195",
                        "target_lang_word": "offensichtlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "offensichtlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3a4ec5be-1705-3e54-bbe5-95b13a30eb2b",
                                        "entry_id": "564020c4-c709-3d7c-a286-b83dc6d02c2b",
                                        "glosses": [
                                            "dem Anschein nach"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05e60d1e-ad13-4f2c-81fe-edec92866d25",
                                                "sense_id": "3a4ec5be-1705-3e54-bbe5-95b13a30eb2b",
                                                "text": "Den Wolken nach zu urteilen, wird es offensichtlich regnen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a7581c56-7f1c-38b9-a7f6-8949fc5a747b",
                                        "entry_id": "564020c4-c709-3d7c-a286-b83dc6d02c2b",
                                        "glosses": [
                                            "für jeden erkennbar"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11ab0e9c-a524-4a5e-bf78-47a736cd6f2a",
                                                "sense_id": "a7581c56-7f1c-38b9-a7f6-8949fc5a747b",
                                                "text": "Es war offensichtlich, dass er gelogen hatte."
                                            },
                                            {
                                                "example_id": "f3761dd4-c271-4717-a207-45ed4e44513b",
                                                "sense_id": "a7581c56-7f1c-38b9-a7f6-8949fc5a747b",
                                                "text": "„Die offensichtlichen Mängel der Expertisen, so die Behörde heute, wären ganz sicher schon damals »in einem ‚Obergutachten‘ und/oder anderem Klageverfahren festgestellt worden«.“"
                                            },
                                            {
                                                "example_id": "36473f8d-c9a5-48b5-80d0-e0d958f80517",
                                                "sense_id": "a7581c56-7f1c-38b9-a7f6-8949fc5a747b",
                                                "text": "„Denn offensichtlich ist Schokolade für Frauen DER Glücklichmacher schlechthin, der in allen Variationen stets zuverlässig funktioniert.“"
                                            },
                                            {
                                                "example_id": "a6529f20-b446-4a31-82cd-7b7758b7593c",
                                                "sense_id": "a7581c56-7f1c-38b9-a7f6-8949fc5a747b",
                                                "text": "„Wenn im Weißpigment eines alten Gemäldes Titanweiß nachgewiesen wird, handelt es sich offensichtlich um eine Fälschung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "91921fe7-d325-45bc-a1a5-4a521129c7b2",
                        "source_entry_id": "e939b7e0-dcc4-315a-8244-038726321bb8",
                        "source_sense_id": "7198cbf2-73cd-378d-8cdc-5cb83daed195",
                        "target_lang_word": "Aufsehen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aufsehen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4554025c-a148-321e-9ed9-6979b11c63c5",
                                        "entry_id": "30d32de7-69cd-3a44-a45f-7c6f51fbc7c6",
                                        "glosses": [
                                            "besondere öffentliche Aufmerksamkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1ec846a-b5b7-4801-a5a3-3c4d7561874c",
                                                "sense_id": "4554025c-a148-321e-9ed9-6979b11c63c5",
                                                "text": "Durch seinen Artikel hat er in der Fachwelt Aufsehen erregt."
                                            },
                                            {
                                                "example_id": "b1be78bc-a86e-499e-8a92-f94db03cf66d",
                                                "sense_id": "4554025c-a148-321e-9ed9-6979b11c63c5",
                                                "text": "„Wir führten eine beachtliche Warenladung mit, weshalb wir dort Aufsehen erregten und achtungsvoll empfangen wurden.“"
                                            },
                                            {
                                                "example_id": "0962fe40-afc5-4b3e-a6c0-f4d13087d48b",
                                                "sense_id": "4554025c-a148-321e-9ed9-6979b11c63c5",
                                                "text": "„In der Heilungskunst machte die Magnetenkur des Herrn Meßmers in Wien in und ausser Deutschland vieles Aufsehen.“ (1776)"
                                            },
                                            {
                                                "example_id": "3516deaf-216f-4c63-ad57-c95bbcf765c7",
                                                "sense_id": "4554025c-a148-321e-9ed9-6979b11c63c5",
                                                "text": "„Und erfreut über das Aufsehen, das sie durch ihre vorgeschrittene Heiterkeit machten, stießen sie mit den Kognakgläschen zusammen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
