                ],
                "senses": [
                    {
                        "sense_id": "a09ee74f-f630-3667-8005-362271f98399",
                        "entry_id": "a404af37-5445-3051-bc8e-b050f9952e58",
                        "glosses": [
                            "Situation, wenn ein LKW einen anderen auf einer Autobahn oder einer anderen mehrspurigen Straße mit nur geringem Geschwindigkeitsunterschied überholt"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "27d93e05-1785-41f7-8624-505d31c3ff14",
                                "sense_id": "a09ee74f-f630-3667-8005-362271f98399",
                                "text": "Die beiden 30-Tonner lieferten sich mehrere Minuten lang ein Elefantenrennen."
                            },
                            {
                                "example_id": "e1478c69-b2d3-4e3e-9b1d-f6e133ed7d0d",
                                "sense_id": "a09ee74f-f630-3667-8005-362271f98399",
                                "text": "Ein LKW-Fahrer setzt den Blinker, schert auf die linke Spur aus und was folgt ärgert viele Autofahrer, die nun abbremsen müssen: ein kilometerlanges Elefantenrennen zwischen zwei Fernfahrern. Solche Überholmanöver will Bundesverkehrsminister Tiefensee massiv einschränken."
                            },
                            {
                                "example_id": "e1797244-5242-4c90-81ae-afcb8112ce30",
                                "sense_id": "a09ee74f-f630-3667-8005-362271f98399",
                                "text": "Etwa 1.000 Meter vor ihm taucht ein Sattelschlepper auf, während in Gegenrichtung einige LKW ein \"Elefantenrennen\" austragen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
