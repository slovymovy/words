                "entry_id": "73310498-3e0d-3748-a90f-8cfa73bb8a25",
                "word": "satiné",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "d640fc0d-d172-43dc-adb3-d1464b070b4a",
                        "entry_id": "73310498-3e0d-3748-a90f-8cfa73bb8a25",
