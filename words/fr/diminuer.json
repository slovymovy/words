                {
                    "sense_id": "1b8d36a6-b9d1-3dfe-a595-9a122388ade1",
                    "sense_definition": "Perdre du poids de façon visible, maigrir.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "baisse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Depuis le début de sa maladie, le pauvre homme <w>diminue</w> à vue d'œil.",
                            "target_lang_translations": {
                                "en": "Since the start of his illness, the poor man is <w>wasting away</w> before our very eyes.",
                                "ru": "С начала болезни бедняга <w>тает</w> на глазах.",
                                "de": "Seit Beginn seiner Krankheit <w>magert</w> der arme Mann zusehends <w>ab</w>.",
                                "es": "Desde el inicio de su enfermedad, el pobre hombre <w>adelgaza</w> a ojos vistos.",
                                "zh": "这个可怜的男人自从患病以来，就眼看着一天天<w>消瘦</w>。"
                            }
                        },
                        {
                            "text": "Elle a tellement <w>diminué</w> ces derniers mois que ses vêtements flottent.",
                            "target_lang_translations": {
                                "en": "She has <w>lost</w> so much weight in recent months that her clothes hang off her.",
                                "ru": "За последние месяцы она так сильно <w>похудела</w>, что одежда на ней висит.",
                                "de": "Sie hat in den letzten Monaten so stark <w>abgenommen</w>, dass ihre Kleider nur so an ihr schlottern.",
                                "es": "En estos últimos meses ha <w>adelgazado</w> tanto que la ropa le queda grande.",
                                "zh": "她这几个月<w>瘦</w>了许多，衣服穿在身上都空荡荡的。"
                            }
                        }
