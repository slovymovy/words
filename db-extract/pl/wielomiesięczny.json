                ],
                "senses": [
                    {
                        "sense_id": "e8a9502b-9913-3e88-a7f9-e4660643889c",
                        "entry_id": "97d23698-bcfd-3b24-9abc-f84239472e5f",
                        "glosses": [
                            "trwający wiele miesięcy"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "943bfacb-d167-4249-ba4f-c19a5f0a7372",
                                "sense_id": "e8a9502b-9913-3e88-a7f9-e4660643889c",
                                "text": "Bogaty wujek zapłacił za wielomiesięczną opiekę medyczną swojego siostrzeńca."
                            },
                            {
                                "example_id": "73a2140f-69df-489a-9be8-07980f6a1d4a",
                                "sense_id": "e8a9502b-9913-3e88-a7f9-e4660643889c",
                                "text": "Wielomiesięczne śledztwo nie przyniosło oczekiwanych rezultatów."
                            },
                            {
                                "example_id": "d1abe157-6287-4d1a-9dd3-07b4297c86f7",
                                "sense_id": "e8a9502b-9913-3e88-a7f9-e4660643889c",
                                "text": "Budowa portu była poprzedzona wielomiesięcznymi przygotowaniami."
                            },
                            {
                                "example_id": "8bad2eb1-ca95-4c37-9c91-8c3d9b0f3650",
                                "sense_id": "e8a9502b-9913-3e88-a7f9-e4660643889c",
                                "text": "Rozporządzenie podpisano po wielomiesięcznej dyskusji międzyresortowej"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9c408c8c-f2a2-4138-b02e-464701499b20",
                        "source_entry_id": "97d23698-bcfd-3b24-9abc-f84239472e5f",
                        "source_sense_id": "e8a9502b-9913-3e88-a7f9-e4660643889c",
                        "target_lang_word": "mehrmonatig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mehrmonatig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1fd50d21-a125-3824-b285-0dd5f684f0f9",
                                        "entry_id": "08ff34cd-98b6-3df4-81c1-fc90bed05e63",
                                        "glosses": [
                                            "mehrere Monate dauernd"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12da57b0-2779-4280-986e-c600cef6761f",
                                                "sense_id": "1fd50d21-a125-3824-b285-0dd5f684f0f9",
                                                "text": "Die mehrmonatige Forschungsreise brachte keine neuen Erkenntnisse."
                                            },
                                            {
                                                "example_id": "513330a3-349d-4822-8e45-32f98887003b",
                                                "sense_id": "1fd50d21-a125-3824-b285-0dd5f684f0f9",
                                                "text": "„So sollen in mehrmonatig angelegten Sonderausstellungen aktuelle Themen der Forschung vorgestellt werden.“"
                                            },
                                            {
                                                "example_id": "61a8d311-4bb4-4436-85ec-c3b195753f0f",
                                                "sense_id": "1fd50d21-a125-3824-b285-0dd5f684f0f9",
                                                "text": "„Bei aggregierter globaler Betrachtung wurde im September die mehrmonatig andauernde Outperformance von Small-Caps gegenüber Large-Caps gebrochen.“"
                                            },
                                            {
                                                "example_id": "6ffa35c6-74f3-4313-a5de-57c106055009",
                                                "sense_id": "1fd50d21-a125-3824-b285-0dd5f684f0f9",
                                                "text": "„Er musste eine hohe Strafe zahlen, um einer mehrmonatigen Haftstrafe zu entgehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
