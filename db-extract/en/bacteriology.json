                                        "examples": [
                                            {
                                                "example_id": "a8e77881-6dec-42df-94d3-b95445c1a177",
                                                "sense_id": "6022c4fb-7038-3b93-b1cb-239054b98fc1",
                                                "text": "La bactériologie médicale est la branche de la microbiologie qui traite des interactions entre les micro-organismes et l’être humain."
