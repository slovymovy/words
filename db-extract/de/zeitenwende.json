                "senses": [
                    {
                        "sense_id": "6b6e1512-292a-33f5-a94e-fc208498497f",
                        "entry_id": "807cfc44-f6d5-30a3-b7be-15b19bbe27b0",
                        "glosses": [
                            "the turn from BC to AD, the “year zero”"
                        ],
                        "tags": [
                            "definite",
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "2fd46234-3fb3-4cbd-ae8a-baff9c061328",
                                "sense_id": "6b6e1512-292a-33f5-a94e-fc208498497f",
                                "text": "Die Vorzeit endet im deutschsprachigen Raum etwa um die Zeitenwende.",
                                "translation": "Prehistoric times in German-speaking Europe end around the beginning of the Christian/Common era.",
                                "english": "Prehistoric times in German-speaking Europe end around the beginning of the Christian/Common era."
                            }
                        ]
                    },
                    {
                        "sense_id": "3328a241-dca8-342b-ac47-2827b18e5faf",
                        "entry_id": "807cfc44-f6d5-30a3-b7be-15b19bbe27b0",
                        "glosses": [
                            "historical turning point, turn of eras"
                        ],
                        "tags": [
                            "broadly",
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "fc5c9ccb-90e9-476e-a5af-1377bea9ce11",
                                "sense_id": "3328a241-dca8-342b-ac47-2827b18e5faf",
                                "text": "Die Politiker schwafeln mal wieder von einer Zeitenwende.",
                                "translation": "The politicians once again are blathering about a new era.",
                                "english": "The politicians once again are blathering about a new era."
                            },
                            {
                                "example_id": "0dbcff25-ddc9-4af2-8889-064542201ca5",
                                "sense_id": "3328a241-dca8-342b-ac47-2827b18e5faf",
                                "text": "Der 24. Februar 2022 markiert eine Zeitenwende in der Geschichte unseres Kontinents. […] Wir erleben eine Zeitenwende. Und das bedeutet: Die Welt danach ist nicht mehr dieselbe wie die Welt davor.",
                                "translation": "24 February 2022 marks a turning point in the history of our continent. […] We are experiencing a historical turning point. And that means: The world afterwards is no longer the same as the world before.",
                                "english": "24 February 2022 marks a turning point in the history of our continent. […] We are experiencing a historical turning point. And that means: The world afterwards is no longer the same as the world before."
                            },
                            {
                                "example_id": "19226245-cc89-4181-9ba9-2f539089083f",
                                "sense_id": "3328a241-dca8-342b-ac47-2827b18e5faf",
                                "text": "Kein Wunder: Das erzwungene Aufwachen der deutschen Öffentlichkeit und Politik in sicherheitspolitischen Fragen gilt vielen nicht nur als \"Zeitenwende\", sondern zugleich als Abkehr von einem gewohnheitsmäßigen Idealismus.",
                                "translation": "No wonder: the forced awakening of the German public and politicians in questions of defense policy is seen by many not only as a \"historical turning point\", but also as a shift from habitual idealism.",
                                "english": "No wonder: the forced awakening of the German public and politicians in questions of defense policy is seen by many not only as a \"historical turning point\", but also as a shift from habitual idealism."
                            },
                            {
                                "example_id": "5d323d65-cd89-4948-9699-86dd8504e570",
                                "sense_id": "3328a241-dca8-342b-ac47-2827b18e5faf",
                                "text": "Park, Spielplatz, Freibad – und gleich nebenan die Munitionsfa­brik: Am Pierburg-Gelände entlang Hussiten- und Scheringstraße in Gesundbrunnen wird sichtbar, dass die „Zeitenwende“ schon längst Berlin erreicht hat. Die Stadt wird kriegstüchtig. Und fast niemand hat etwas dagegen."
                            }
                        ]
                    }
                ],
