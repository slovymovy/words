                "senses": [
                    {
                        "sense_id": "65aa7d90-d223-3874-b2c9-e04957f25291",
                        "entry_id": "9c13e3fb-ae3e-33fe-a776-d2877f8f86dc",
                        "glosses": [
                            "Geruchswahrnehmung, die von Fenchel stammt oder diesem ähnelt/an diesen erinnert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45b36241-ac17-43d4-9b5e-c42e6f18a31d",
                                "sense_id": "65aa7d90-d223-3874-b2c9-e04957f25291",
                                "text": "„Der Fenchel, eine feinblättrige (zwei-) bis mehrjährige Pflanze aus der Familie der Doldengewächse, wird 80 bis 150 cm hoch und verströmt vor allem, wenn man die Samen oder die feinen Blätter zerreibt, den intensiven typischen Fenchelgeruch.“"
                            },
                            {
                                "example_id": "18605cc2-7fef-4dfa-9000-6cd6ed455226",
                                "sense_id": "65aa7d90-d223-3874-b2c9-e04957f25291",
                                "text": "„Der zweite Bestandteil, der im Verein der mit dem Anethol den eigentümlichen Fenchelgeruch und Geschmack hervorbringt, ist das Fenchon.“"
                            },
                            {
                                "example_id": "d0378c1b-71e9-44d1-9101-2c0dc921b00e",
                                "sense_id": "65aa7d90-d223-3874-b2c9-e04957f25291",
                                "text": "„Der wichtigste Inhaltsstoff des Gemüsefenchels ist ein ätherisches Öl, das sich für den herzhaft-angenehmen, anisartigen Fenchelgeruch und -geschmack verantwortlich zeichnet.“"
                            },
                            {
                                "example_id": "92286448-a4e1-4b35-902f-078fa20e5573",
                                "sense_id": "65aa7d90-d223-3874-b2c9-e04957f25291",
                                "text": "„Beide haben diesen typischen Fenchelgeruch bzw. Geschmack, durch den der Fenchel bei einigen beliebt und bei anderen sehr unbeliebt ist.“"
                            },
                            {
                                "example_id": "b2d1b614-eb28-4389-acb9-094929d386c1",
                                "sense_id": "65aa7d90-d223-3874-b2c9-e04957f25291",
                                "text": "„Der wichtigste Inhaltsstoff des Gemüsefenchels ist ein ätherisches Öl, das den angenehmen Fenchelgeruch und -geschmack bewirkt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
