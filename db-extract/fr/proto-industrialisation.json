                "senses": [
                    {
                        "sense_id": "42e3ce55-2d05-34fe-add9-e80a5daf71c6",
                        "entry_id": "fadb1224-4c59-3616-a16a-059993ad5e4c",
                        "glosses": [
                            "Activité essentiellement rurale de production de biens destinés à des régions extérieures, avant la Révolution industrielle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "402a25b9-a7cc-4bce-b9cb-d799427f9c31",
                                "sense_id": "42e3ce55-2d05-34fe-add9-e80a5daf71c6",
                                "text": "Inventé en 1969 par l'historien américain Franklin Mendels, le terme de proto-industrialisation désigne la dispersion dans une campagne périurbaine d'une part de la production, surtout dans le textile."
                            },
                            {
                                "example_id": "813f075e-67d1-4e5f-a17d-3c98a361fc98",
                                "sense_id": "42e3ce55-2d05-34fe-add9-e80a5daf71c6",
                                "text": "Le concept de proto-industrialisation conçu par Franklin Mendels s'applique essentiellement aux nébuleuses textiles des plaines dominées par les marchands-fabricants citadins. Mais la proto-industrie montagnarde du fer constitue un autre monde où le dynamisme est fréquemment d'essence rurale."
                            }
                        ]
                    }
                ],
