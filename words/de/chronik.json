                    "sense_id": "c6028ed4-0b41-3df3-9381-339403c429dc",
                    "sense_definition": "Zeitlich geordnete Übersicht oder Liste vergangener Aktivitäten oder besuchter Seiten, beispielsweise in einem Browser oder sozialen Netzwerk",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er beschloss, die gesamte <w>Chronik</w> in seinem Browser vollständig zu löschen."
                        },
                        {
                            "text": "Auf ihrer persönlichen <w>Chronik</w> postete sie viele schöne Fotos aus dem Urlaub."
                        }
                    ],
                    "synonyms": [
                        "Verlauf"
                    ],
                    "common_phrases": [
                        "die Chronik löschen",
                        "in der Chronik nachsehen"
                    ]
                },
                {
                    "sense_id": "4507cf8d-e4f5-3d09-9456-2d44689607d0",
                    "sense_definition": "Fortlaufende, meist zeitlich geordnete Darstellung geschichtlicher Ereignisse eines Ortes, eines Vereins oder einer Epoche",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der Historiker verfasste eine ausführliche <w>Chronik</w> über die wechselhafte Geschichte der alten Stadt."
                        },
                        {
                            "text": "Eine mittelalterliche <w>Chronik</w> berichtet über das schwere Erdbeben im vierzehnten Jahrhundert."
                        }
                    ],
                    "synonyms": [
                        "Annalen"
                    ],
                    "common_phrases": [
