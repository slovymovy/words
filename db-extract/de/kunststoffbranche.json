                "senses": [
                    {
                        "sense_id": "1c0a0ed7-65c0-3f1a-9ce2-c57f8ecdc6ab",
                        "entry_id": "41095498-077f-35c0-b976-bd3dad2b1f1d",
                        "glosses": [
                            "beruflicher oder unternehmerischer Tätigkeitsbereich mit Kunststoffen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e2407bb3-4da0-4956-a26f-90e9e8eb1752",
                                "sense_id": "1c0a0ed7-65c0-3f1a-9ce2-c57f8ecdc6ab",
                                "text": "„Das Thema der steigenden Stromkosten als Folge des Erneuerbare-Energien-Gesetzes (EEG) beschäftigt die Kunststoffbranche weiterhin.“"
                            },
                            {
                                "example_id": "5e1c99c2-670d-40f0-b2c4-e04465d5ea26",
                                "sense_id": "1c0a0ed7-65c0-3f1a-9ce2-c57f8ecdc6ab",
                                "text": "„Nach der Ausbildung hast Du optimale Zukunftsperspektiven: Du verfügst über umfangreiche Kenntnisse der Produktionsverfahren in der Kunststoffbranche und kannst in unterschiedlichen Unternehmensabteilungen arbeiten.“"
                            },
                            {
                                "example_id": "3741c5ee-6126-49dc-8362-167a1b3d34d4",
                                "sense_id": "1c0a0ed7-65c0-3f1a-9ce2-c57f8ecdc6ab",
                                "text": "„Bei der Betrachtung der Energiebilanzen vieler Kunststoffprodukte ließe sich dieser Eindruck allerdings nicht bestätigen. Gerade Energieeffizienz sei das Kunststoffthema und werde in Zukunft in Deutschland für ein gesichertes Wachstum der Kunststoffbranche sorgen, ist Plastics Europe überzeugt.“"
                            }
                        ],
