                "senses": [
                    {
                        "sense_id": "0cd6760d-6f6e-37f2-a06a-d9445904bc18",
                        "entry_id": "a99e7c1f-4b57-3774-bfc9-6538685e9532",
                        "glosses": [
                            "Celui qui réalise."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f2bf529f-386a-465b-b1cd-acb7afe8803a",
                                "sense_id": "0cd6760d-6f6e-37f2-a06a-d9445904bc18",
                                "text": "Ce n’est pas seulement un imaginatif, c’est un réalisateur."
                            }
                        ]
                    },
                    {
                        "sense_id": "759747e3-f541-3d14-a068-147ed0ca5467",
                        "entry_id": "a99e7c1f-4b57-3774-bfc9-6538685e9532",
                        "glosses": [
                            "Personne responsable de la réalisation d’un film."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80c6a288-492c-4333-acbf-60510fa3aab7",
                                "sense_id": "759747e3-f541-3d14-a068-147ed0ca5467",
                                "text": "A Marchand, le réalisateur reprochera de « ribouler » quand il joue la colère. En pleine projection de rushes, sa voix s'élève, pour lancer à l'acteur sur l'écran : « Arrête de ribouler des yeux! »"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3f9ee48f-5966-4bc8-b5ae-3edde9aa807c",
                        "source_entry_id": "a99e7c1f-4b57-3774-bfc9-6538685e9532",
                        "source_sense_description": "Personne qui réalise un film",
                        "target_lang_word": "Regisseur",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Regisseur",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "59a83ac0-d9b1-3794-a594-1c704adc1c5e",
                                        "entry_id": "1d7fa317-48d7-38f8-931b-4f0daaa55a33",
                                        "glosses": [
                                            "Person, die die Regie führt, die (künstlerische) Leitung hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3d4b9a9-6011-42ab-aaf8-3301d10e34c1",
                                                "sense_id": "59a83ac0-d9b1-3794-a594-1c704adc1c5e",
                                                "text": "Alfred Hitchcock war einer der berühmtesten Regisseure."
                                            },
                                            {
                                                "example_id": "69abb6d2-72a4-424a-8050-8d6f3cabe928",
                                                "sense_id": "59a83ac0-d9b1-3794-a594-1c704adc1c5e",
                                                "text": "„Das Jüngste Gericht wird in Filmen so gut wie nie dargestellt, weil die Regisseure ihren Zuschauern wahrscheinlich nicht vorzeitig die gute Laune verderben wollen.“"
                                            },
                                            {
                                                "example_id": "e17fbb5c-fe63-4922-8a39-e56fde91e179",
                                                "sense_id": "59a83ac0-d9b1-3794-a594-1c704adc1c5e",
                                                "text": "„Er läuft monatelang, wird ein Publikumsrenner und bringt dem Produzenten und dem Regisseur den damals noch neuen, aber bereits begehrten Oscar ein.“"
                                            },
                                            {
                                                "example_id": "e1b68402-0903-4406-9fcc-c48592d45434",
                                                "sense_id": "59a83ac0-d9b1-3794-a594-1c704adc1c5e",
                                                "text": "„In diesem Land sprießen die Schauspieler, Regisseure, Drehbuchautoren und Produzenten mit großen Ideen im Kopf wie Pilze aus der Erde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5210aac3-04f2-44b0-8ba6-bb5f55011ffb",
                        "source_entry_id": "a99e7c1f-4b57-3774-bfc9-6538685e9532",
                        "source_sense_description": "Personne qui réalise un film",
                        "target_lang_word": "Filmregisseur",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Filmregisseur",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a0986773-d2b2-3424-8858-b74b04fa87e8",
                                        "entry_id": "eda909ec-cafd-33a8-9a7c-fb1dcf361758",
                                        "glosses": [
                                            "Person, die bei Filmen Regie führt, als Regisseur von Filmen tätig ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b7cab01-19f6-4a08-9e4e-24d40a7f893e",
                                                "sense_id": "a0986773-d2b2-3424-8858-b74b04fa87e8",
                                                "text": "„Mein Freund, Luis Buñuel, ist Filmregisseur.“"
                                            },
                                            {
                                                "example_id": "d2be5451-d8a5-4b57-a000-cf6b3462cef8",
                                                "sense_id": "a0986773-d2b2-3424-8858-b74b04fa87e8",
                                                "text": "„Sofern Giyoungs Erinnerung stimmte, hatte dieses Vorbereitungstraining stattgefunden, kurz bevor Südkoreas bekanntester Filmregisseur zusammen mit seiner Frau zurück nach Südkorea geflohen war.“"
                                            },
                                            {
                                                "example_id": "d1314769-10ab-4ec3-8f6f-bea75cf714d9",
                                                "sense_id": "a0986773-d2b2-3424-8858-b74b04fa87e8",
                                                "text": "„Weitere Recherchen ergaben, dass die Schauspielerin mit einem iranischen Filmregisseur verheiratet war und deshalb nicht die Frau von Doktor Ali sein konnte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
