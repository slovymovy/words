                "senses": [
                    {
                        "sense_id": "28410713-2127-3ad4-8650-0d31753c28be",
                        "entry_id": "f0090195-bcfa-3792-b129-ae6ad15c1372",
                        "glosses": [
                            "Donner un caractère offensif à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76d7a167-0551-44be-80b6-a5a496b67218",
                                "sense_id": "28410713-2127-3ad4-8650-0d31753c28be",
                                "text": "Je suis contre personnellement, c'est une énième tentative d'offensiviser le football à outrance, mais si c'est la règle l'arbitre doit l'appliquer."
                            },
                            {
                                "example_id": "c0a957c5-ee90-4706-a604-6e452cae4062",
                                "sense_id": "28410713-2127-3ad4-8650-0d31753c28be",
                                "text": "On peut même offensiviser tout ça en faisant entrer Dirar à la place d'Appiah (son bon repli défensif plaide dans ce sens)."
                            },
                            {
                                "example_id": "8c62210c-f087-4e67-83b6-bf974e2f6a02",
                                "sense_id": "28410713-2127-3ad4-8650-0d31753c28be",
                                "text": "A mon sens, il ne serait pas étonnant que slowking devienne encore plus courant vu sa capacité de pivoter facilement sur entei, de plus le méta risque de s'offensiviser (ça n'existe toujours pas), réduisant ses possibilités de spam feu sacré (et toute bonne offense a au moins un check espeed)."
                            }
                        ]
                    }
