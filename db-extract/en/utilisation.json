                                "target_senses": [
                                    {
                                        "sense_id": "20cf5af6-0ad3-3c67-9e7d-5e5bf39b381d",
                                        "entry_id": "45468a89-2735-3f36-82ec-d7ac5fd48a11",
                                        "glosses": [
                                            "Fait ou manière d’utiliser."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2bcb0053-9037-4039-b349-606adfb51f7b",
                                                "sense_id": "20cf5af6-0ad3-3c67-9e7d-5e5bf39b381d",
                                                "text": "L’utilisation des pesticides a beaucoup augmenté dans les pays en développement à la fin des années 60 et pendant les années 70, à mesure que l’agriculture se modernisait."
                                            },
                                            {
                                                "example_id": "fb689d81-a15b-4de4-b31c-2671fc7c0f4b",
                                                "sense_id": "20cf5af6-0ad3-3c67-9e7d-5e5bf39b381d",
                                                "text": "L’utilisation du pois dans le Croissant fertile est attestée par des données archéologiques datant de 8000 av. J.-C."
                                            },
                                            {
                                                "example_id": "9a1fb58c-b6dc-471a-a811-a1f5ef3f5721",
                                                "sense_id": "20cf5af6-0ad3-3c67-9e7d-5e5bf39b381d",
                                                "text": "Avec l’utilisation d’antigènes de tréponèmes pâles tués, les réactions sérologiques ont vu leur sensibilité et leur spécificité nettement améliorées."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
