                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "095c732f-4918-4e67-8994-b4f6d626b35f",
                                "sense_id": "85b1bd70-025a-3c5c-8b12-39af743cdf13",
                                "text": "Vous pouvez écrire au stylo ou au bic."
                            },
                            {
                                "example_id": "64858aec-4ee6-41e4-924f-0d7225cc3d0a",
                                "sense_id": "85b1bd70-025a-3c5c-8b12-39af743cdf13",
                                "text": "Les ennemis sont désignés: le bic, le clavier et ce foutu silence !"
                            }
                        ]
                    },
                    {
                        "sense_id": "b38dd85e-2256-342d-ba2f-6ad5af8a2646",
                        "entry_id": "babe6a84-897f-3158-b69b-40efe259330b",
                        "glosses": [
                            "Briquet."
                        ],
                        "tags": [
                            "Québec"
                        ],
                        "examples": [
                            {
                                "example_id": "579ed382-72ad-4093-9ec5-1cca1c074cde",
                                "sense_id": "b38dd85e-2256-342d-ba2f-6ad5af8a2646",
                                "text": "Mais le travail n’était pas terminé et elle alla remiser la brouette dans l’appentis avant de rentrer dans la maison où , avec la flamme de son Bic , elle alluma l’unique chandelle qu’elle avait apportée."
                            }
                        ]
                    }
