                ],
                "senses": [
                    {
                        "sense_id": "ffcd4961-cf63-3e42-a698-7bb386f3d5f8",
                        "entry_id": "edc8eec0-e66b-3851-9a08-9e3f59bac9ef",
                        "glosses": [
                            "с.-х. сочный корм для скота, получаемый заквашиванием кормовых растений в специальных сооружениях (башнях, траншеях, ямах и т. п.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86d25e17-1e96-4e72-91e4-288121134f08",
                                "sense_id": "ffcd4961-cf63-3e42-a698-7bb386f3d5f8",
                                "text": "Идут из вегетарианской столовой. Там фрукты одни да силос. Бифштекс ни-ни."
                            }
                        ]
                    },
                    {
                        "sense_id": "82d8dfc6-f875-3997-bd62-6be9737231df",
                        "entry_id": "edc8eec0-e66b-3851-9a08-9e3f59bac9ef",
                        "glosses": [
                            "с.-х. подземное хранилище для такого корма"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c55fe4a8-1fdb-4602-ad23-63af776ef0fa",
                                "sense_id": "82d8dfc6-f875-3997-bd62-6be9737231df",
                                "text": "Пневморазгрузчик подаёт материал в подрельсовый бункер, откуда пневмоподъёмник подаёт его в силосы."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e7669e3a-5f36-483a-b33c-476cb496857d",
                        "source_entry_id": "edc8eec0-e66b-3851-9a08-9e3f59bac9ef",
                        "source_sense_description": "корм",
                        "target_lang_word": "silage",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "silage",
