                ],
                "senses": [
                    {
                        "sense_id": "7b945dbf-ba65-3060-a1dc-a7eed53289e5",
                        "entry_id": "16f5510d-8d02-3be7-b8e7-09ce9ffb368c",
                        "glosses": [
                            "Angehöriger eines hinduistischen Volkes in Nepal"
                        ],
                        "tags": [
                            "Ethnologie"
                        ],
                        "examples": [
                            {
                                "example_id": "430c1c60-b7ad-4924-8734-cc00b882dbdd",
                                "sense_id": "7b945dbf-ba65-3060-a1dc-a7eed53289e5",
                                "text": "In der indischen Bevölkerung gibt es verschiedene Gruppierungen, zum Beispiel Hindus, Muslime, Bramahnen, Sikh, Gurkha und Bengalesen."
                            },
                            {
                                "example_id": "3caa1df2-4be9-4ae9-8ae9-85ed009c4032",
                                "sense_id": "7b945dbf-ba65-3060-a1dc-a7eed53289e5",
                                "text": "„Ihre Stütze waren nun Krieger der Sikhs aus den Punjab und Gurkhas aus Nepal.“"
                            },
                            {
                                "example_id": "08bbc30c-02e3-49c1-97d8-6e27a279a113",
                                "sense_id": "7b945dbf-ba65-3060-a1dc-a7eed53289e5",
                                "text": "Sikhs und Gurkhas aus Nordindien vollbrachten [auf den Schlachtfeldern des 1. Weltkrieges] mutige Heldentaten, Indianer galten als hervorragende Kundschafter und Botschafter."
                            },
                            {
                                "example_id": "894d46de-5f3b-4eba-b6cd-514c745c4204",
                                "sense_id": "7b945dbf-ba65-3060-a1dc-a7eed53289e5",
                                "text": "„Die Gurkha entstammen zum großen Teil den Bergvölkern der Magar, Gurung, Rai und Limbu aus Nepals mittlerem Bergland. Die meisten Jungen dieser Bevölkerungsgruppen träumen davon, Gurkha-Soldat zu werden.“"
                            },
                            {
                                "example_id": "716d0b0e-520f-4f2c-b901-33e7ccf141a8",
                                "sense_id": "7b945dbf-ba65-3060-a1dc-a7eed53289e5",
                                "text": "„Seit 1816 kämpft die aus Nepal stammende Ethnie der Gurkha als militärische Eliteeinheit im Dienste Großbritanniens.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b4530aee-79b6-3b34-8617-b9e9828678d8",
                        "entry_id": "16f5510d-8d02-3be7-b8e7-09ce9ffb368c",
                        "glosses": [
                            "Soldat einer nepalesischer Elitetruppe, der in der indischen oder britischen Armee kämpft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3626927-df33-4588-9b48-6db008aca943",
                                "sense_id": "b4530aee-79b6-3b34-8617-b9e9828678d8",
                                "text": "„Seit 1816 kämpft die aus Nepal stammende Ethnie der Gurkha als militärische Eliteeinheit im Dienste Großbritanniens.“"
                            },
                            {
                                "example_id": "55dbf7b2-d43a-4e55-81e7-0c9ef0b7f706",
                                "sense_id": "b4530aee-79b6-3b34-8617-b9e9828678d8",
                                "text": "„Der tapfere Gurkha am LRAD kam selbst unter Feuer, wurde von Splittern leicht verletzt, aber er lärmte weiter.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
