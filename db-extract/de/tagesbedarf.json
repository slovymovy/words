                "senses": [
                    {
                        "sense_id": "ed5ad42e-566d-3759-bf97-2f03dc89a791",
                        "entry_id": "ea90e5e0-0340-349a-b5c3-eed82c44306f",
                        "glosses": [
                            "Bedarf, der den Zeitraum eines Tages abdeckt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1585eb4f-2d74-4240-bdd4-9a242119bfb5",
                                "sense_id": "ed5ad42e-566d-3759-bf97-2f03dc89a791",
                                "text": "„Der Tagesbedarf einzelner Mineralstoffe kann und muss nicht an jedem einzelnen Tag erreicht werden.“"
                            },
                            {
                                "example_id": "d016ed72-bf2d-457b-aac8-4c4a62fb57fe",
                                "sense_id": "ed5ad42e-566d-3759-bf97-2f03dc89a791",
                                "text": "„Da es aber wichtig ist, die Stromlieferung an den jeweiligen Tagesbedarf anzupassen, gibt es z.B. auch Pakete, die nur eine Stunde Strom enthalten.“"
                            }
                        ],
