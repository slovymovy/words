                "senses": [
                    {
                        "sense_id": "70c74ca9-a5cd-3460-a9e5-3e19da7cf64b",
                        "entry_id": "690baab0-f557-3b2e-b5b2-f7eb43f8de56",
                        "glosses": [
                            "Nom familier du chevreau."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "a40a173f-9145-4d6a-83da-6d2158380944",
                                "sense_id": "70c74ca9-a5cd-3460-a9e5-3e19da7cf64b",
                                "text": "Le biquet soupçonneux par la fente regarde :\n« Montrez-moi patte blanche, ou je n’ouvrirai point, … »"
                            },
                            {
                                "example_id": "e77e1916-b652-4baa-8b3a-f2e962d7b3d1",
                                "sense_id": "70c74ca9-a5cd-3460-a9e5-3e19da7cf64b",
                                "text": "Trois étaient des biquettes et le quatrième un biquet."
                            },
                            {
                                "example_id": "224bd191-ef01-49cb-8c41-22161ee6466c",
                                "sense_id": "70c74ca9-a5cd-3460-a9e5-3e19da7cf64b",
                                "text": "— le petit Kasper, les pieds nus, le nez en l’air, arrivait fièrement, soufflant dans sa corne ; et derrière lui cinq ou six chèvres la mamelle traînante, un vieux bouc et trois biquets suivaient au pas dans le sentier poudreux."
                            }
                        ]
                    },
                    {
                        "sense_id": "7633ddbe-5597-3b97-bc32-a75eaad38735",
                        "entry_id": "690baab0-f557-3b2e-b5b2-f7eb43f8de56",
                        "glosses": [
                            "Trébuchet pour peser l’or et l’argent."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "2e3f5947-9c22-3ee0-9b59-1b2c6de67a13",
                        "entry_id": "690baab0-f557-3b2e-b5b2-f7eb43f8de56",
                        "glosses": [
                            "Appellation familière pour s'adresser à un être cher."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d7faa18-8d5d-4ee7-8337-5c776026baf8",
                                "sense_id": "2e3f5947-9c22-3ee0-9b59-1b2c6de67a13",
                                "text": "T’as donc rien dans ta vieille tête, dis, mon petit biquet ?"
                            }
                        ]
                    }
                ],
