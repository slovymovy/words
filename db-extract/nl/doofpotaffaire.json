                "senses": [
                    {
                        "sense_id": "2e527d86-cd77-3282-b197-c5a655199cc1",
                        "entry_id": "93c52066-ff25-3333-9cb5-759c366cc1a3",
                        "glosses": [
                            "misstand die men probeert geheim te houden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce79441f-edf8-45a6-8a42-eb7d9386acb2",
                                "sense_id": "2e527d86-cd77-3282-b197-c5a655199cc1",
                                "text": "Een Argentijnse openbaar aanklager die president Kirchner vorige week nog beschuldigde van een doofpotaffaire, is dood aangetroffen in zijn woning in Buenos Aires. Hij zou vandaag op een hoorzitting met bewijzen komen tegen de president en andere hooggeplaatsten."
                            },
                            {
                                "example_id": "9b963c5b-df3b-4a87-bd57-3b6c528cc656",
                                "sense_id": "2e527d86-cd77-3282-b197-c5a655199cc1",
                                "text": "De SP en de PvdA vinden het kwalijk dat Hillen niets van de kwestie wist. De PVV spreekt van een doofpotaffaire."
                            },
                            {
                                "example_id": "1f3d80ad-e3a8-4fe3-a5de-359de635bb22",
                                "sense_id": "2e527d86-cd77-3282-b197-c5a655199cc1",
                                "text": "De misbruikte man noemt het een doofpotaffaire. \"Het was een publiek geheim. Eigenlijk wist iedereen wat er aan de hand was. Als ze het niet gezien hebben, dan is dat alleen maar omdat ze het niet wilden zien.\""
                            }
                        ]
                    }
