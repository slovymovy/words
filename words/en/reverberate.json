{
    "word_family": [
        "reverberation",
        "reverberator"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c0a0360e-3827-3ff9-a6d4-54bde9a15324",
                    "sense_definition": "To echo or resound repeatedly against surfaces.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The loud thunder <w>reverberated</w> down the valley after the lightning strike.",
                            "target_lang_translations": {
                                "pl": "Głośny grzmot <w>rozbrzmiewał</w> w dolinie po uderzeniu pioruna."
                            }
                        },
                        {
                            "text": "The roar of the stream was <w>reverberating</w> through the dark woods.",
                            "target_lang_translations": {
                                "pl": "Szum strumienia <w>odbijał się echem</w> w ciemnym lesie."
                            }
                        }
                    ],
                    "synonyms": [
                        "reverberant"
                    ],
                    "common_phrases": [
                        "sound reverberates"
                    ],
                    "target_lang_definitions": {
                        "pl": "Odbijać się echem, rozbrzmiewać wielokrotnie od powierzchni."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "rozbrzmiewać",
                                "target_lang_sense_clarification": "o dźwięku wypełniającym przestrzeń"
                            },
                            {
                                "target_lang_word": "odbijać się echem",
                                "target_lang_sense_clarification": "o dźwięku powracającym od przeszkód"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "266a6f88-a784-3153-8c99-19f3a780865d",
                    "sense_definition": "To have lasting and significant effects or consequences.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "influence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The economic crisis <w>reverberated</w> through the entire global market for years.",
                            "target_lang_translations": {
                                "pl": "Kryzys gospodarczy <w>odbił się szerokim echem</w> na całym globalnym rynku na wiele lat."
                            }
                        },
                        {
                            "text": "The politician's controversial speech is still <w>reverberating</w> across the country.",
                            "target_lang_translations": {
                                "pl": "Kontrowersyjne przemówienie polityka wciąż <w>wywiera wpływ</w> na cały kraj."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Mieć trwałe i znaczące skutki lub konsekwencje."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "odbić się szerokim echem",
                                "target_lang_sense_clarification": "o wydarzeniu mającym duży wpływ"
                            },
                            {
                                "target_lang_word": "wywierać wpływ",
                                "target_lang_sense_clarification": "o długofalowych konsekwencjach"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "286fb1f4-1fd1-3150-aa42-75ac65281e1f",
                    "sense_definition": "Ringing or vibrating with many echoing sounds.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>reverberate</w> hills echoed the hunter's call back to him.",
                            "target_lang_translations": {
                                "pl": "<w>Dźwięczne</w> wzgórza odbiły echem wołanie myśliwego w jego stronę."
                            }
                        },
                        {
                            "text": "They stood in the <w>reverberate</w> hall listening to the music.",
                            "target_lang_translations": {
                                "pl": "Stali w <w>rozbrzmiewającej</w> echem sali, słuchając muzyki."
                            }
                        }
                    ],
                    "synonyms": [
                        "reverberant"
                    ],
                    "target_lang_definitions": {
                        "pl": "Dźwięczny, pełen echa, wibrujący od dźwięków."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "dźwięczny",
                                "target_lang_sense_clarification": "o miejscu pełnym echa"
                            },
                            {
                                "target_lang_word": "rozbrzmiewający",
                                "target_lang_sense_clarification": "o przestrzeni wypełnionej dźwiękiem"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}