                        "target_lang_word": "крест-на́крест",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "крест-на́крест",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "7f3aa044-ee1b-329f-be14-59789c316a79",
                                        "entry_id": "94d89824-ef9e-30c1-8760-4a1708ea23a0",
                                        "glosses": [
                                            "взаимно пересекаясь"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1882fb94-13b8-4494-83a0-f8efcd571b36",
                                                "sense_id": "7f3aa044-ee1b-329f-be14-59789c316a79",
                                                "text": "Окна в доме были заклеены крест-накрест."
                                            },
                                            {
                                                "example_id": "6ec77154-629c-48cd-91e9-5ca003da0447",
                                                "sense_id": "7f3aa044-ee1b-329f-be14-59789c316a79",
                                                "text": "Он подошёл, шатаясь, к барьеру и, сложив крест-накрест руки, стал прямо грудью против своего соперника."
                                            },
                                            {
                                                "example_id": "8f246f93-f411-442e-8975-4d9ccbb7a471",
                                                "sense_id": "7f3aa044-ee1b-329f-be14-59789c316a79",
                                                "text": "На партизанах были новые ватники, а поверх ватников ― крест-накрест пулемётные ленты."
                                            },
                                            {
                                                "example_id": "b754fa25-75a2-46a8-aa60-951703443fb6",
                                                "sense_id": "7f3aa044-ee1b-329f-be14-59789c316a79",
                                                "text": "― А старик наш такой быстрый — хвать карандаш да по австрийскому плану крест-накрест."
                                            },
                                            {
                                                "example_id": "e0094bc1-071f-4c11-bfdd-d3a072ca5825",
                                                "sense_id": "7f3aa044-ee1b-329f-be14-59789c316a79",
                                                "text": "Румата повернулся и опустил руки крест-накрест на рукояти мечей."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "84868159-5df8-43d6-ac93-dd70f24cf79b",
