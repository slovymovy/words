                ],
                "senses": [
                    {
                        "sense_id": "cb53b021-2232-32a2-8156-95e55fc1df71",
                        "entry_id": "9f79c341-15e2-3563-898c-c6166c430d08",
                        "glosses": [
                            "Eigenschaft, viele Vitamine zu enthalten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a45efd6-ad05-415b-8520-204d691e3dcb",
                                "sense_id": "cb53b021-2232-32a2-8156-95e55fc1df71",
                                "text": "„Besondere Vorzüge hat sie neben dem Vitaminreichtum für die trockene und faltige Haut, die gut genährt, geglättet und durchfeuchtet wird.“"
                            },
                            {
                                "example_id": "26f71dc8-e936-48ec-915e-b5784a4b8b13",
                                "sense_id": "cb53b021-2232-32a2-8156-95e55fc1df71",
                                "text": "„Von günstigem Einfluß ist jedenfalls der Vitaminreichtum, besonders bei reichlicher Verwendung von Rohkost und Beigabe von Lebertran.“"
                            },
                            {
                                "example_id": "6bb0a52c-6bd8-433b-a511-e054a1b7194b",
                                "sense_id": "cb53b021-2232-32a2-8156-95e55fc1df71",
                                "text": "„Auch dies dürfte wohl in dem Sinne erklärt werden, daß Eiweißreichtum und Vitaminreichtum mindestens subjektiv zweckmäßig erscheinen.“"
                            },
                            {
                                "example_id": "72d7c4c8-7f58-4ccc-b9ff-4a581b028a85",
                                "sense_id": "cb53b021-2232-32a2-8156-95e55fc1df71",
                                "text": "„Ihnen geht es wohl weniger um den Vitaminreichtum der Frucht, als vielmehr um deren angebliche Eigenschaft als Aphrodisiakum.“"
                            },
                            {
                                "example_id": "7efb2ec9-bbbc-4c69-8d4c-aac0b600ba15",
                                "sense_id": "cb53b021-2232-32a2-8156-95e55fc1df71",
                                "text": "„Ihr Vitaminreichtum stärkt das Immunsystem, und sie sind ideal als sättigende Zwischenmahlzeit, aber auch gebacken als Hauptmahlzeit eine Köstlichkeit.“"
                            },
                            {
                                "example_id": "aadb6059-7abb-4588-a1bc-975f45637925",
                                "sense_id": "cb53b021-2232-32a2-8156-95e55fc1df71",
                                "text": "„Im allgemeinen sind Biere jedoch vitaminarme Lebensmittel, da von dem großen Vitaminreichtum der Hefen fast nichts in Lösung geht.“"
                            },
                            {
                                "example_id": "a9f749eb-9633-41a3-8314-622c1e6da9a2",
                                "sense_id": "cb53b021-2232-32a2-8156-95e55fc1df71",
                                "text": "„Kalzium, der hohe Vitaminreichtum und die wichtige Proteinquelle in einem ‚guten Stück Fleisch‘.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
