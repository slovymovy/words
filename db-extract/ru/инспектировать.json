                                        "entry_id": "e8036bd2-80f7-3977-8177-3ff402f869de",
                                        "glosses": [
                                            "To examine critically or carefully; especially, to search out problems or determine condition; to scrutinize."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ae76eba-b212-4004-b70b-b5da75c0a780",
                                                "sense_id": "b3560f4b-ec37-3cba-ba22-c2104631ad72",
                                                "text": "Inspect the system for leaks."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "12f115f3-c630-3a16-bbee-48aa61d3106d",
                                        "entry_id": "e8036bd2-80f7-3977-8177-3ff402f869de",
                                        "glosses": [
                                            "To view and examine officially."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c297efcf-9ada-47b0-af38-0279ff580dbd",
                                                "sense_id": "12f115f3-c630-3a16-bbee-48aa61d3106d",
                                                "text": "The general inspected the troops and their barracks."
                                            },
                                            {
                                                "example_id": "c1758601-0dd1-4b12-a894-e5b3cbc274ce",
                                                "sense_id": "12f115f3-c630-3a16-bbee-48aa61d3106d",
                                                "text": "‘[…] I remember a lady coming to inspect St. Mary's Home where I was brought up and seeing us all in our lovely Elizabethan uniforms we were so proud of, and bursting into tears all over us because “it was wicked to dress us like charity children”.[…]’."
                                            }
                                        ]
                                    }
                                ]
