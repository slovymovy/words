            {
                "entry_id": "27b8a796-f817-3844-ba4b-2f1fe2b5f346",
                "word": "piaf",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "9731b7f5-bbf6-4771-9125-cea0e2c2cb71",
                        "entry_id": "27b8a796-f817-3844-ba4b-2f1fe2b5f346",
                        "tags": [
                            "plural"
                        ],
                        "form": "piafs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0491186e-377a-3233-b07b-13fee0f0fbfb",
                        "entry_id": "27b8a796-f817-3844-ba4b-2f1fe2b5f346",
                        "glosses": [
                            "Appellation populaire des moineaux, ou d’autres petits oiseaux mal identifiés."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "4d9beda2-3c1b-4e43-89f3-6968ea5f8b77",
                                "sense_id": "0491186e-377a-3233-b07b-13fee0f0fbfb",
                                "text": "Au retour, nous allons déranger un piaf femelle noir et blanc à long bec rouge couvant trois œufs ressemblant à ceux des mouettes. Cris stridents."
                            },
                            {
                                "example_id": "0950923f-93c5-42e2-8e82-808889332e76",
                                "sense_id": "0491186e-377a-3233-b07b-13fee0f0fbfb",
                                "text": "Un piaf curieux était déjà venu aux nouvelles. Posé sur la rambarde du balcon, il avait jeté un regard exploratoire dans la pièce. Constatant que ni les miettes de croissant, ni le fond de jus d'orange n'étaient au rendez-vous, il s'était envolé en piaillant de dépit."
                            },
                            {
                                "example_id": "29da8886-3844-43f7-be76-55908ca0f6cc",
                                "sense_id": "0491186e-377a-3233-b07b-13fee0f0fbfb",
                                "text": "Puis, les allées et venues des moineaux au rayon des pâtes, en face de sa caisse, retiennent son attention. Les piafs se faufilent sous les comptoirs et les plus culottés s'attaquent aux paquets de cellophane dans les rayons."
                            }
                        ]
                    },
                    {
                        "sense_id": "ad631302-148e-3257-823e-a7dd755493c9",
                        "entry_id": "27b8a796-f817-3844-ba4b-2f1fe2b5f346",
                        "glosses": [
                            "Élève venant de région parisienne."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e5bb174a-09bb-4cd9-af5a-2d5df928191e",
                        "source_entry_id": "27b8a796-f817-3844-ba4b-2f1fe2b5f346",
                        "source_sense_id": "0491186e-377a-3233-b07b-13fee0f0fbfb",
                        "source_sense_description": "(Familier) Appellation populaire des moineaux, ou d’autres petits oiseaux mal identifiés.",
                        "target_lang_word": "Spatz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Spatz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fb3af1a8-02ae-303d-bc56-9ad284a0dc98",
                                        "entry_id": "2ca996aa-8f8e-3152-b545-9d39838f0787",
                                        "glosses": [
                                            "der Sperling (Passer), ein körnerfressender Singvogel, speziell der Haussperling"
                                        ],
                                        "tags": [
                                            "P. domesticus"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e0f83d1-b0b3-4c36-bfc5-1c3b5da60e6d",
                                                "sense_id": "fb3af1a8-02ae-303d-bc56-9ad284a0dc98",
                                                "text": "“Ich bin ein armer Schreiber nur, / Hab weder Haus noch Acker, / Doch freut mich jede Kreatur, / Sogar der Spatz, der Racker.”"
                                            },
                                            {
                                                "example_id": "080de86c-e44d-400a-93fd-23291760ee3c",
                                                "sense_id": "fb3af1a8-02ae-303d-bc56-9ad284a0dc98",
                                                "text": "Früher traten die Spatzen in großen Schwärmen auf."
                                            },
                                            {
                                                "example_id": "5814fafe-63a7-4c22-9f3b-3c120a51a337",
                                                "sense_id": "fb3af1a8-02ae-303d-bc56-9ad284a0dc98",
                                                "text": "„Sie hat ein unglaubliches Klangvolumen. So laut und durchdringend, dass bei jedem Orgelkonzert die Spatzen tot vom Baum fallen.“"
                                            },
                                            {
                                                "example_id": "38157bea-d544-4467-86c7-1f445f64c234",
                                                "sense_id": "fb3af1a8-02ae-303d-bc56-9ad284a0dc98",
                                                "text": "„Ein paar Spatzen flogen schilpend auf das Vogelbad in der Mitte des Rasens.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "31a15a22-d936-3278-a79e-659fa7f334d2",
                                        "entry_id": "2ca996aa-8f8e-3152-b545-9d39838f0787",
                                        "glosses": [
                                            "Kosewort für einen geliebten Menschen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "182090fd-2c79-4ecd-bd88-37ad0ed4e271",
                                                "sense_id": "31a15a22-d936-3278-a79e-659fa7f334d2",
                                                "text": "Komm auf meinen Schoß, mein Spatz!"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "74e34eac-a66c-31af-8351-a1ea4f26e470",
                                        "entry_id": "2ca996aa-8f8e-3152-b545-9d39838f0787",
                                        "glosses": [
                                            "von einem Brett geschabte Nudeln"
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5b0964b8-7b13-40cb-954f-28f0aded3b25",
                                                "sense_id": "74e34eac-a66c-31af-8351-a1ea4f26e470",
                                                "text": "Ein beliebtes schwäbisches Gericht heißt Kartoffelschnitz und Spatzen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a44e17d3-fc86-4656-8be5-826b1aa1db64",
                        "source_entry_id": "27b8a796-f817-3844-ba4b-2f1fe2b5f346",
                        "source_sense_id": "0491186e-377a-3233-b07b-13fee0f0fbfb",
