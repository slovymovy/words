    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "76108d46-ea77-3aec-a14f-463ed8b57614",
                    "sense_definition": "Représentation publique ou séance au cours de laquelle des musiciens ou des chanteurs exécutent des morceaux musicaux.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "musique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous allons assister à un <w>concert</w> de jazz ce samedi soir en ville."
                        },
                        {
                            "text": "Le groupe a donné un magnifique <w>concert</w> devant des milliers de spectateurs enthousiastes."
                        }
                    ],
                    "synonyms": [
                        "récital"
                    ],
                    "common_phrases": [
                        "salle de concert",
                        "donner un concert",
                        "billet de concert"
                    ]
                },
                {
                    "sense_id": "ee65a302-17a6-38c1-9c07-8c444cf957ed",
                    "sense_definition": "Ensemble de bruits ou de sons divers qui retentissent en même temps.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "son",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dès l'aube, un joyeux <w>concert</w> d'oiseaux s'élève dans les arbres du grand parc."
                        },
                        {
                            "text": "Un assourdissant <w>concert</w> de klaxons a retenti dans toute la rue bloquée."
                        }
                    ],
                    "synonyms": [
                        "chœur",
                        "cacophonie"
                    ],
                    "antonyms": [
                        "silence"
                    ],
                    "common_phrases": [
                        "concert de klaxons"
                    ]
                },
                {
                    "sense_id": "f000aea3-31b3-3d65-b0f1-c2c75a2512ce",
                    "sense_definition": "Manifestation collective et simultanée d'opinions, de jugements ou de sentiments exprimés dans le même sens.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "opinion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La publication de ce rapport a déclenché un vaste <w>concert</w> de protestations parmi les citoyens."
                        },
                        {
                            "text": "Son discours courageux a suscité un véritable <w>concert</w> d'éloges au sein de l'assemblée."
                        }
                    ],
                    "synonyms": [
                        "chœur"
                    ],
                    "common_phrases": [
                        "concert de louanges",
                        "concert de critiques"
                    ]
                },
                {
                    "sense_id": "45ec3f4f-fac1-3a32-91a6-9e149cb156bf",
                    "sense_definition": "Accord, entente ou harmonie entre plusieurs personnes qui unissent leurs volontés.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "accord",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les deux ministères ont convenu d'agir de <w>concert</w> pour faire avancer ce dossier prioritaire."
                        },
                        {
                            "text": "Pour réussir cette mission complexe, les différents services doivent impérativement travailler de <w>concert</w>."
                        }
                    ],
                    "synonyms": [
                        "accord",
                        "entente",
                        "harmonie",
                        "concorde"
                    ],
                    "antonyms": [
                        "désaccord",
                        "discorde"
                    ],
                    "common_phrases": [
                        "de concert",
                        "agir de concert"
                    ]
                },
                {
                    "sense_id": "09788cbe-7297-3b37-991e-d58273eda17f",
                    "sense_definition": "Ensemble d'États, de nations ou de collectivités agissant en harmonie et visant la concorde internationale.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "accord",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après des années d'isolement diplomatique, le pays cherche à réintégrer le <w>concert</w> des nations."
                        },
                        {
                            "text": "Les puissances régionales s'efforcent d'harmoniser leurs politiques au sein du <w>concert</w> international."
                        }
                    ],
                    "synonyms": [
                        "communauté"
                    ],
                    "common_phrases": [
                        "concert des nations"
                    ]
                }
            ]
        }
    ]
}