                                        "sense_id": "f81143e9-457c-3b90-b72f-4e6fa76833fb",
                                        "entry_id": "39c55238-79c4-3b1b-9b01-028686f20bd0",
                                        "glosses": [
                                            "A member of a gang."
                                        ],
