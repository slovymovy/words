                "senses": [
                    {
                        "sense_id": "8c2e33f7-68ae-384e-8322-50b57d916e51",
                        "entry_id": "ded77db7-26e3-3045-bf09-0a223222d0ab",
                        "glosses": [
                            "Qualité de ce qui est pertinent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d5a10b0-a034-4861-a8b4-86e35953fe09",
                                "sense_id": "8c2e33f7-68ae-384e-8322-50b57d916e51",
                                "text": "En cas de doute sur la pertinence de l'exorcisme, mieux vaut alors faire appel aux chérifs détenteurs d'une baraka reconnue pour sa puissance thérapeutique."
                            },
                            {
                                "example_id": "7ff7ed1a-117a-4066-b121-56a5b4181a5c",
                                "sense_id": "8c2e33f7-68ae-384e-8322-50b57d916e51",
                                "text": "Chacun de nous put acquérir pour une modique somme une K7 contant le reportage et vingt minutes de rush qu'il eut la gentillesse de rendre intelligentes, ce qui dut lui donner beaucoup de mal, car, honnêtement, nos déplacements rugbystiques n'ont jamais vraiment brillé ni par leur originalité, ni par la pertinence de nos pensées."
                            },
                            {
                                "example_id": "1c01e0e4-a66f-4146-b702-3532c102fc8e",
                                "sense_id": "8c2e33f7-68ae-384e-8322-50b57d916e51",
                                "text": "L'origine onomatopéique d'un lexème est une question diachronique, sans pertinence en tant que telle pour la sémantique de la parole : ainsi, il n'est pas fondamental pour nous de trancher parmi les nombreux cas qui peuvent faire débats (quid de gong, flaque, grogner, grommeler, siffler, claquer, vrombir... ?)"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d1e60401-87a4-4033-9cc5-933151d2570c",
                        "source_entry_id": "ded77db7-26e3-3045-bf09-0a223222d0ab",
                        "source_sense_id": "8c2e33f7-68ae-384e-8322-50b57d916e51",
                        "target_lang_word": "Relevanz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Relevanz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fb813fff-3e13-394e-a123-ab753e8920b8",
                                        "entry_id": "c0922544-f988-36a8-9b92-f48128909e44",
                                        "glosses": [
                                            "Eigenschaft (in einem bestimmten Zusammenhang) wichtig, bedeutsam zu sein"
                                        ],
                                        "tags": [
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8363f89d-ef01-436a-aa7d-c46bb5b345f4",
                                                "sense_id": "fb813fff-3e13-394e-a123-ab753e8920b8",
                                                "text": "Ich bezweifle die Relevanz dieses Beitrags für unser Projekt."
                                            },
                                            {
                                                "example_id": "4ca18ed4-f409-4386-970e-53b0a79e6a43",
                                                "sense_id": "fb813fff-3e13-394e-a123-ab753e8920b8",
                                                "text": "„Maßstäbe für eine Rechtfertigung sind die Wahrhaftigkeit, Relevanz und Verständlichkeit des Gesagten.“"
                                            },
                                            {
                                                "example_id": "6c42ae2f-5e4a-4d35-9d0c-a5ce38668e9b",
                                                "sense_id": "fb813fff-3e13-394e-a123-ab753e8920b8",
                                                "text": "„Bereits 1891 untersuchte der Soziologe Herbert Spencer, welche Themen in den Medien besonders hysterisch und aufgeregt behandelt wurden und welche Relevanz sie nach dem damaligen Stand der Forschung tatsächlich hatten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
