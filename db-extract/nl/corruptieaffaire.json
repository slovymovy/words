                        "examples": [
                            {
                                "example_id": "7f092616-01b2-46e0-be8c-40a95fae2bb5",
                                "sense_id": "40101f14-bfd6-3ddb-8497-68eb28b4a452",
                                "text": "De corruptieaffaire is aan het licht gekomen na onderzoek door de fiscale politie op Sicilië. De regionale politiek op het eiland is in rep en roer omdat de openbaar aanklager heeft bepaald dat prominente politici van verschillende partijen gehoord zullen worden in deze zaak."
                            },
                            {
                                "example_id": "b0460cae-cd43-45c1-aa7d-ff10ffeb92d4",
                                "sense_id": "40101f14-bfd6-3ddb-8497-68eb28b4a452",
                                "text": "Eerder deze maand maakte de koning bekend dat hij zijn jacht aan de regering wil geven. Hij zou het ongepast vinden om het dure schip te houden nu Spanje in een financiële crisis zit. Hij komt met dat besluit op een moment dat de populariteit van de koning afneemt door een aantal schandalen, waaronder een corruptieaffaire van zijn schoonzoon."
                            }
                        ]
                    }
