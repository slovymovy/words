                                    {
                                        "sense_id": "56fe1e17-4f5b-312e-86ca-ad7432dc8490",
                                        "entry_id": "5fa0bc15-4edd-3e8b-8309-74726085486c",
                                        "glosses": [
                                            "A vehicle that may be hired for single journeys by members of the public, particularly one with an automated meter to calculate the fare."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aeab6943-4f7a-46ac-a718-1eb2f3858885",
                                                "sense_id": "56fe1e17-4f5b-312e-86ca-ad7432dc8490",
                                                "text": "\"Taxi,\" he called. And when one pulled up to the curb with screeching brakes he ordered, \"The nearest restaurant.\""
                                            },
                                            {
                                                "example_id": "0fdab039-f13b-482a-8b18-7ab72703a142",
                                                "sense_id": "56fe1e17-4f5b-312e-86ca-ad7432dc8490",
                                                "text": "[Sobbing uncontrollably] I thought I could make it work between us because you looked a bit like a man.\nTAXI!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a3fd3e4-2355-3e58-b4c2-1f191d0e8292",
                                        "entry_id": "5fa0bc15-4edd-3e8b-8309-74726085486c",
                                        "glosses": [
                                            "An aircraft used for practicing ground manoeuvres."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d51af053-b409-45f6-aeb6-98eb7826a023",
                                                "sense_id": "4a3fd3e4-2355-3e58-b4c2-1f191d0e8292",
                                                "text": "Capt. Dawes and Bellairs were out with the Deperdussin taxi, and also with the brevet machine, rolling."
                                            },
                                            {
                                                "example_id": "6377b762-088e-48d6-8fc8-5014419c43c4",
                                                "sense_id": "4a3fd3e4-2355-3e58-b4c2-1f191d0e8292",
                                                "text": "... some similar untidy pile of what had been a school biplane is recorded to have acted the part of red rag to the bull of a \"taxi\" monoplane , which despite its driver's efforts insisted on charging and trampling on the battered fragments."
                                            },
                                            {
                                                "example_id": "1a5e220f-d1bd-453e-929f-f220058f923d",
                                                "sense_id": "4a3fd3e4-2355-3e58-b4c2-1f191d0e8292",
                                                "text": "Mr. E. B. Bauman (new pupil) joined school and had first lesson on No. 2 taxi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9aa8eeb4-412b-3e98-8a2d-6fd4a64f5c1e",
                                        "entry_id": "5fa0bc15-4edd-3e8b-8309-74726085486c",
                                        "glosses": [
                                            "The movement of an aircraft across an airport's surface under its own power; a phase of aircraft operation involving this movement."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2879ce3-6df3-437c-9b74-3ad9423134bf",
                                                "sense_id": "9aa8eeb4-412b-3e98-8a2d-6fd4a64f5c1e",
                                                "text": "During taxi, the flaps and slats are extended and the second engine (if not already running) is started."
                                            },
                                            {
                                                "example_id": "8e8f91b2-3f45-4a58-96f6-af2b593de5c8",
                                                "sense_id": "9aa8eeb4-412b-3e98-8a2d-6fd4a64f5c1e",
                                                "text": "Seat belts must be kept fastened during taxi, takeoff, turbulence, and landing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "decbc36e-f21f-369d-8157-8ee6bf54cf0f",
                                        "entry_id": "5fa0bc15-4edd-3e8b-8309-74726085486c",
                                        "glosses": [
                                            "Synonym of shared taxi."
                                        ],
                                        "tags": [
                                            "Iran",
                                            "South-Africa",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
