                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e255ce2-f35d-41d6-9b32-cd715bb1a4cc",
                                                "sense_id": "a30b0fa3-7e4b-357f-802e-18d297809300",
                                                "text": "All other sergeants and barristers indiscriminately (except in the Court of Common Pleas, where only sergeants are admitted) may take upon them the protection and defense of any suitors."
                                            }
