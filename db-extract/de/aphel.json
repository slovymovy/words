                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6328fea-73ec-4670-871b-0e50d02221a7",
                                "sense_id": "db64e579-e604-3a32-974c-d0759b988654",
                                "text": "Die Bahngeschwindigkeit eines Planeten ist im Aphel am geringsten."
                            },
                            {
                                "example_id": "d21ed6b3-63f7-4c74-acdd-fc54cb958b3f",
                                "sense_id": "db64e579-e604-3a32-974c-d0759b988654",
                                "text": "„Auch die Erde kam in eine größte Nähe zur Sonne, ihr Perihel, und in eine größte Ferne, ihr Aphel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "543d7649-c320-4061-905a-4ad24a19244b",
                        "source_entry_id": "7d380430-fce4-3f8f-a0e2-331508f1f9e4",
                        "source_sense_id": "db64e579-e604-3a32-974c-d0759b988654",
                        "source_sense_description": "Astronomie: sonnenfernster Punkt einer Planetenbahn",
                        "target_lang_word": "aphelion",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aphelion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "47833b35-3d24-3a20-bbf5-7a43da2d4a9b",
                                        "entry_id": "ce713e78-221d-3b4e-bdf5-2c6dc37df1ae",
                                        "glosses": [
                                            "The point in the elliptical orbit of a comet, planet, or other astronomical object, where it is farthest from the Sun."
                                        ],
                                        "tags": [
                                            "also",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9281f624-c1c8-4fd3-9e96-4aa493bf5acb",
                                                "sense_id": "47833b35-3d24-3a20-bbf5-7a43da2d4a9b",
                                                "text": "[I]t follows from the theory of gravity, that the aphelia of Mercury, Venus, the Earth, and Mars, slightly progress."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "97c9d385-0262-4c57-a8aa-a6d3d65ab6a5",
                        "source_entry_id": "7d380430-fce4-3f8f-a0e2-331508f1f9e4",
                        "source_sense_id": "db64e579-e604-3a32-974c-d0759b988654",
                        "source_sense_description": "Astronomie: sonnenfernster Punkt einer Planetenbahn",
                        "target_lang_word": "aphélie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aphélie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "64d959f3-e3f1-3cd7-842a-c55db30c0bec",
                                        "entry_id": "d4e91952-e595-3faa-ba92-d25d5107a1ce",
                                        "glosses": [
                                            "Sur une orbite ayant pour foyer la Soleil, le point le plus éloigné de celui-ci ; autrement dit, l’apoapside d’une orbite héliocentrique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9cadc84d-3d1f-4204-98b6-16d7171fe8e3",
                                                "sense_id": "64d959f3-e3f1-3cd7-842a-c55db30c0bec",
                                                "text": "C’est en été que la Terre se trouve à l’aphélie de son orbite. La Terre arrive à son aphélie."
                                            },
                                            {
                                                "example_id": "b2cefef1-16c5-41cc-9cc4-48cb80f1eeb2",
                                                "sense_id": "64d959f3-e3f1-3cd7-842a-c55db30c0bec",
                                                "text": "Les perturbations planétaires agissent près du périhélie des orbites, par conséquent elles en changent l’aphélie."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "aphélie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9d1da353-1fd0-3363-959c-af108a8e3726",
                                        "entry_id": "171243d8-327d-35aa-8e87-ea3ff5b4668b",
                                        "glosses": [
                                            "Qui est à l’aphélie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3caed584-bd90-408a-8595-44bfd49940b5",
                                                "sense_id": "9d1da353-1fd0-3363-959c-af108a8e3726",
                                                "text": "L’époque où la Terre est aphélie."
                                            },
                                            {
                                                "example_id": "4299b375-ca4d-42c4-b160-a82a3d655ffd",
                                                "sense_id": "9d1da353-1fd0-3363-959c-af108a8e3726",
