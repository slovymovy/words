                "senses": [
                    {
                        "sense_id": "5a4f0e66-7faf-3793-b3fb-7d362f1fdbc5",
                        "entry_id": "212d050c-be4b-3252-a6f2-cac11309d4be",
                        "glosses": [
                            "Déchiffrer (quelque chose qui a été écrit en hiéroglyphes, qui a été écrit de façon illisible)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e778aa6-9ecc-49a0-8aa6-d64e4131e517",
                                "sense_id": "5a4f0e66-7faf-3793-b3fb-7d362f1fdbc5",
                                "text": "La parfaite connaissance de la technique du kyrioscope ne permet pas de déhiéroglypher un nombre individualisé sur sa bande symétrique sans la clef correspondante."
                            },
                            {
                                "example_id": "454539c9-f1c5-491a-8fea-d4aebcab6d21",
                                "sense_id": "5a4f0e66-7faf-3793-b3fb-7d362f1fdbc5",
                                "text": "Ai besoin d’une Pierre de Rosette pour déhiéroglypher le message précédent…"
                            },
                            {
                                "example_id": "19dd4463-46f7-4f56-9e59-dd6ea9216201",
                                "sense_id": "5a4f0e66-7faf-3793-b3fb-7d362f1fdbc5",
                                "text": "Et puis ceux qu’ils commencent à « déhiéroglypher » à bidouiller pour en exploiter leur contenu souvent pour des raisons militaires et non pour le bien de l’humanité en quête de la paix universelle (leurs motivations sont malsaines)."
                            }
                        ]
                    }
