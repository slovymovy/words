                        "entry_id": "e0c56985-06e7-3111-9c32-c11439a82cad",
                        "glosses": [
                            "Nom vernaculaire de la fausse-chenille (tenthrède) du rosier (Arge ochropus), qui se meut très lentement."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "2d809220-76b5-446f-b4f8-8549eae85071",
                                "sense_id": "ce0206c2-fbd0-3d57-a2ff-6f9800422dd8",
                                "text": "PARESSEUSE, nom donné par Goedart à une fausse chenille du rosier, fort lente, qui, lorsqu’on la touche, n’a pas l’air de se défendre, qui se roule sur elle- même, et ne mange que la nuit."
                            }
                        ]
                    }
