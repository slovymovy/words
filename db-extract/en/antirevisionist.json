                                        "glosses": [
                                            "Opposant, opposante au révisionnisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d51ef4ea-281c-4404-8bb9-25e3c5329d28",
                                                "sense_id": "d8388d0f-3830-35e9-b128-efe935402ab8",
                                                "text": "Méline démissionne, remplacé le 28 juin par Henri Brisson qui nomme le général Cavaignac, un antirévisionniste notoire, au ministère de la Guerre."
                                            }
                                        ]
                                    }
