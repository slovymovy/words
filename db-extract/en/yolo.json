                                        "glosses": [
                                            "Puisque la vie est trop courte, autant en profiter un maximum."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "afa3eb20-5eac-471e-bf27-949793ae4bab",
                                                "sense_id": "b94ec627-22d6-330f-a120-378daba7d93d",
                                                "text": "Vas-y, fonce, on ne vit qu’une fois."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c646519d-a055-47bf-a2be-0d6dd7701650",
                        "source_entry_id": "52090186-b3a7-3d38-a3fc-9f724158ed24",
                        "source_sense_id": "36cec084-068c-3ea5-a790-83f4d75bedba",
                        "source_sense_description": "you only live once",
                        "target_lang_word": "on n’a qu’une vie",
