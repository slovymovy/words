                ],
                "senses": [
                    {
                        "sense_id": "a5545e37-3e86-3500-877f-7ab6fcc422ef",
                        "entry_id": "2d0baf0d-b5b7-3f8f-ac2c-fba8916d10fb",
                        "glosses": [
                            "свойство или состояние по значению прилагательного долготерпеливый; способность к продолжительному терпению"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ce5e712-a20d-41f2-943a-bb3b95918036",
                                "sense_id": "a5545e37-3e86-3500-877f-7ab6fcc422ef",
                                "text": "Как ты слышишь такие душепагубные речи и терпишь такое беззаконие? Удивляюся твоему долготерпению."
                            },
                            {
                                "example_id": "f552116e-cf70-47d3-9385-b3eb50c7ec5f",
                                "sense_id": "a5545e37-3e86-3500-877f-7ab6fcc422ef",
                                "text": "Честь и слава искусству и долготерпению охотника!"
                            },
                            {
                                "example_id": "2a17133d-202b-4dae-b274-60ae8e104fe3",
                                "sense_id": "a5545e37-3e86-3500-877f-7ab6fcc422ef",
                                "text": "Или ты пренебрегаешь богатством благости Его и кротости и долготерпения, не помышляя, что благость Божия ведёт тебя к покаянию?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "163ee7d3-7a0d-4f4d-b2c8-96b87701a7f6",
                        "source_entry_id": "2d0baf0d-b5b7-3f8f-ac2c-fba8916d10fb",
                        "source_sense_id": "a5545e37-3e86-3500-877f-7ab6fcc422ef",
