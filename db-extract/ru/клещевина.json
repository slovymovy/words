                "senses": [
                    {
                        "sense_id": "655a6a26-ebc7-34e7-99b7-d0569da035be",
                        "entry_id": "dbf57d52-0fd1-3219-aaeb-19e4715f7070",
                        "glosses": [
                            "ботан. масличное, лекарственное и декоративное садовое растение"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3ed0167-f11f-4894-b76a-118344bca3f7",
                                "sense_id": "655a6a26-ebc7-34e7-99b7-d0569da035be",
                                "text": "Касторовое масло получают из семян клещевины — очень теплолюбивого растения, которое в нашей стране удается выращивать лишь в некоторых южных районах."
                            },
                            {
                                "example_id": "ac95223b-93b7-4c5c-8205-02d50e4c964a",
                                "sense_id": "655a6a26-ebc7-34e7-99b7-d0569da035be",
                                "text": "Пропашка и прополка клещевины должна обязательно производиться не менее двух раз."
                            }
                        ]
                    }
                ],
