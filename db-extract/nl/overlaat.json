                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6e746b0-af7f-4829-b42a-7ba14d26e987",
                                                "sense_id": "73e6c20f-ae52-3abf-a3ca-ae60afe617ec",
                                                "text": "Frau Wehr ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "de59421e-496b-4ada-8085-99415daedde6",
                                                "sense_id": "73e6c20f-ae52-3abf-a3ca-ae60afe617ec",
                                                "text": "Herr Wehr wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "fd58f9a4-f96d-428f-a227-d974730c35e1",
                                                "sense_id": "73e6c20f-ae52-3abf-a3ca-ae60afe617ec",
                                                "text": "Die Wehrs fliegen heute nach La Paz."
                                            },
                                            {
                                                "example_id": "8d687c6d-cd5a-449d-82b0-5b627aef02e9",
                                                "sense_id": "73e6c20f-ae52-3abf-a3ca-ae60afe617ec",
                                                "text": "Der Wehr trägt nie die Schals, die die Wehr ihm strickt."
                                            },
                                            {
                                                "example_id": "58405736-19d4-45dc-abed-8c6a8db58a5c",
                                                "sense_id": "73e6c20f-ae52-3abf-a3ca-ae60afe617ec",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Wehr kommt, geht der Herr Wehr.“"
                                            },
                                            {
                                                "example_id": "170a5635-a0e4-49cb-bf93-5110ed73f9f3",
                                                "sense_id": "73e6c20f-ae52-3abf-a3ca-ae60afe617ec",
                                                "text": "Wehr kommt und geht."
                                            },
                                            {
                                                "example_id": "4d378487-65c8-4a6e-a4f0-9d64e41454f5",
                                                "sense_id": "73e6c20f-ae52-3abf-a3ca-ae60afe617ec",
                                                "text": "Wehrs kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
