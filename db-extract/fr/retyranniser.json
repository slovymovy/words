                        "sense_id": "d7a05a9a-de8d-3895-a1d6-69f267da1b31",
                        "entry_id": "9bf9e393-1092-3fd2-8933-4a14fd5648df",
                        "glosses": [
                            "Tyranniser à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67ab3601-b1df-4f71-9eed-982143729e98",
                                "sense_id": "d7a05a9a-de8d-3895-a1d6-69f267da1b31",
                                "text": "À un certain moment, quelqu'un doit dire que nous cesserons de tyranniser et de retyranniser les victimes."
                            },
                            {
                                "example_id": "5f38c9b3-db8a-49b1-987e-051d3bf6446a",
                                "sense_id": "d7a05a9a-de8d-3895-a1d6-69f267da1b31",
                                "text": "en 1809, est-ce Napoléon qui revient de sa propre volonté en Bavière pour \"retyranniser\" l'Europe centrale? (accent ajouté à Bavière)"
                            },
                            {
                                "example_id": "8c0e980e-534e-43ed-a7a8-bbaf6d000f32",
                                "sense_id": "d7a05a9a-de8d-3895-a1d6-69f267da1b31",
                                "text": "Un ancien à retyranniser. (accent ajouté sur le à)"
                            }
                        ]
                    }
