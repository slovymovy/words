                        "sense_id": "1ab6429f-fc17-312d-82bb-73d9c6dd1579",
                        "entry_id": "43a69005-50f5-3a7a-9465-02020b3fd818",
                        "glosses": [
                            "Lehre der evangelischen Freikirchen, bei der ein persönliches Glaubensbekenntnis einer erwachsenen Person für die Taufe vorausgesetzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9167ab3-5482-4ffd-abee-2a7ab429edc4",
                                "sense_id": "1ab6429f-fc17-312d-82bb-73d9c6dd1579",
                                "text": "„Von der Hansestadt aus breitete sich der Baptismus in Deutschland und anderen Ländern Europas aus.“"
                            },
                            {
                                "example_id": "ca868bbe-eaa5-402f-8288-852a0c865463",
                                "sense_id": "1ab6429f-fc17-312d-82bb-73d9c6dd1579",
                                "text": "„In Deutschland ist der Baptismus seit 1834 vertreten.“"
                            },
                            {
                                "example_id": "c5d21e2f-e0ef-43ed-93c0-efe88332cf88",
                                "sense_id": "1ab6429f-fc17-312d-82bb-73d9c6dd1579",
                                "text": "„Mit 16 wurde er von einem reisenden Evangelisten zum Baptismus bekehrt.“"
                            }
                        ],
