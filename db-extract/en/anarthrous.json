                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "4cae39e4-ac8e-35c0-a94e-3a366798312d",
                        "entry_id": "d61d9dbb-5428-3220-a9a5-d6384f09afef",
                        "glosses": [
                            "Not having an article (especially of Greek nouns)."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "a527dc5a-f956-402a-b5ad-1a1efa9ff9ac",
                                "sense_id": "4cae39e4-ac8e-35c0-a94e-3a366798312d",
                                "text": "We have concluded that Paul does not distinguish between the arthrous and anarthrous use of nomos."
                            },
                            {
                                "example_id": "e91144d4-59ad-4051-968a-089af1feae09",
                                "sense_id": "4cae39e4-ac8e-35c0-a94e-3a366798312d",
                                "text": "Proper names are usually anarthrous (since they need no article to be definite), except in cases of anaphora"
                            }
                        ]
                    },
                    {
                        "sense_id": "5b0e4f2d-819f-3ecc-87a4-b99261154b58",
                        "entry_id": "d61d9dbb-5428-3220-a9a5-d6384f09afef",
                        "glosses": [
                            "Not having a determiner."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "42334f35-0e8d-49df-9337-093f708c4672",
                                "sense_id": "5b0e4f2d-819f-3ecc-87a4-b99261154b58",
                                "text": "Nouns indicating status often appear in anarthrous noun phrases, ie, as bare nouns."
                            },
                            {
                                "example_id": "8b83ff66-cc60-42fd-b056-92f155251432",
                                "sense_id": "5b0e4f2d-819f-3ecc-87a4-b99261154b58",
                                "text": "Meigret (1888), treats French P-D contractions as simple prepositions governing anarthrous objects. Associating determiners with NP, Abeillé et al. consider the determinerless objects to be instances of N'."
                            }
                        ]
                    },
                    {
