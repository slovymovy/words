                                "sense_id": "0618afa3-5d0e-32ba-81cd-711d03af20d8",
                                "text": "Mort de ma vie! Ich will ihn schon waschen! Ich will dem Naseweis den Appetit nach meinen Amouren verleiden.",
                                "translation": "Intrigue and Love",
                                "english": "Intrigue and Love"
                            },
                            {
                                "example_id": "1dac6934-1c35-46d8-8d5c-e22c10ac7d60",
                                "sense_id": "0618afa3-5d0e-32ba-81cd-711d03af20d8",
                                "text": "Die Lauten und die Stillen checkten einander ab, Flirts, Amouren, Trennungen, Dramen spielten sich ab—das ganze Programm."
                            }
                        ]
                    }
