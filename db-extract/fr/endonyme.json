                                "target_senses": [
                                    {
                                        "sense_id": "963b6bea-c524-356b-a9fc-b712e5bdcacb",
                                        "entry_id": "ed97abcc-89e3-3088-9bd0-7d1511ba08f0",
                                        "glosses": [
                                            "Name für ein topografisches Objekt (Stadt, Fluss oder Ähnliches) in der Sprache, die im Gebiet des Objektes gesprochen wird"
                                        ],
                                        "tags": [
                                            "Onomastik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3e44645c-bd17-4021-b2d0-7603694e086f",
                                                "sense_id": "963b6bea-c524-356b-a9fc-b712e5bdcacb",
                                                "text": "„Unterschieden werden zwei Typen von geographischen Namen: Endonyme und Exonyme. Als Endonyme bezeichnet man die von der Mehrheit der ansässigen Bevölkerung benutzten Namen, als standardisierte Endonyme die amtlich festgelegten Namensformen; […]“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "05226bf3-1621-487b-a4e3-a9e41bdf8930",
                        "source_entry_id": "5db1df47-8b79-30eb-a22a-a3dec3cf7407",
                        "target_lang_word": "Eigenbezeichnung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Eigenbezeichnung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ebbc4007-9979-3098-8234-997ea4b37d22",
                                        "entry_id": "ffd484d5-c852-3708-aa5e-7a3618b9b705",
                                        "glosses": [
                                            "Bezeichnung, die sich jemand selbst gibt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd145b81-2785-4da3-9154-91b06fd375dc",
                                                "sense_id": "ebbc4007-9979-3098-8234-997ea4b37d22",
                                                "text": "Die Eigenbezeichnung der Basken lautet „Euskara“."
                                            },
                                            {
                                                "example_id": "9f606c10-c496-4851-b7a3-1745a395ecdc",
                                                "sense_id": "ebbc4007-9979-3098-8234-997ea4b37d22",
                                                "text": "„Die Uiguren (andere Schreibweisen: Uyghuren, Uighuren; die Eigenbezeichnung heißt Uyghur) stellen mit etwa acht Millionen Menschen den größten Bevölkerungsanteil in Xinjiang.“"
                                            },
                                            {
                                                "example_id": "f0f6582b-a902-43c2-8d31-67d4735311f8",
                                                "sense_id": "ebbc4007-9979-3098-8234-997ea4b37d22",
                                                "text": "„Genau an dieser Schnittstelle gerieten die Kelten durch starke Expansionsbewegungen nach Griechenland, nach der heutigen Türkei und nach Italien erstmals in den Blickpunkt der klassischen antiken Geschichtsschreiber, die uns als Eigenbezeichnung bestimmter keltisch sprechender Völker die Namen Keltoi, also Kelten, Galater und Gallier überliefert haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "885d460b-45d7-4f94-905a-88f5be708ef2",
                        "source_entry_id": "5db1df47-8b79-30eb-a22a-a3dec3cf7407",
                        "target_lang_word": "endonym",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "endonym",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a0f3ba29-16fb-3ac0-b269-02bd003f8f9e",
                                        "entry_id": "e8b9dd9d-0132-3b32-a75f-f40cb7d3f151",
                                        "glosses": [
                                            "A name used by a group or category of people (an ingroup) to refer to themselves or their language, as opposed to a name given to them by other groups (outgroups)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ced3cab6-bdb5-4ba2-bf74-59506d507587",
                                                "sense_id": "a0f3ba29-16fb-3ac0-b269-02bd003f8f9e",
                                                "text": "The endonym is the basic toponymic exemplar and as such it needs to be understood properly. To do so we need to appreciate the context of space and place that produces it. Most endonyms arise from the elemental human relationship with space and place, and possess an intrinsic and enduring value which cannot normally be either bestowed or removed by political arbitrariness."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
