                                "target_senses": [
                                    {
                                        "sense_id": "cd0c6738-85f3-35c1-ac62-ba705de42f43",
                                        "entry_id": "aa288f11-19f6-3d06-b56b-db602a8b3409",
                                        "glosses": [
                                            "Douleur vive que le malade localise à l’épigastre et qui est accompagnée de troubles digestifs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cbff2d1d-a751-46c8-82af-56d9d93dcbf5",
                                                "sense_id": "cd0c6738-85f3-35c1-ac62-ba705de42f43",
                                                "text": "J’ai dû m’attribuer faussement une épouvantable gastralgie pour pouvoir refuser sans offense les nombreuses offres de café, imposées par le code du savoir-vivre. (À Ménilmonlant, le hasard veut toujours, dans chaque maison, que le café soit justement prêt, là, sur le poêle.) Grâce à ma mine peu brillante, la chance m’a favorisée, il y a, comme ça, des réussites qui tiennent à peu de chose : non seulement ma gastralgie est acceptée, mais elle devient un fait du quartier ; j’ai déjà entendu plusieurs fois, dans le groupe des mères, devant la porte de l’école, cette apostrophe effrayante : « Quand vous aurez une gastralgie, comme Rose !… »"
                                            },
                                            {
                                                "example_id": "4e0eb937-0e64-460f-bfba-b2d191c8b0b9",
                                                "sense_id": "cd0c6738-85f3-35c1-ac62-ba705de42f43",
                                                "text": "C’est pourquoi, face à une gastralgie qui résiste aux traitements habituels (médicaments antiacides, pansements gastriques...), il vaut mieux consulter un médecin qui fera le point."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
