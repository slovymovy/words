                "senses": [
                    {
                        "sense_id": "32fe9a48-0f2b-3da3-becd-9e5c8b24d908",
                        "entry_id": "f5015216-e3c1-3499-a8e9-1a0b9e18cde5",
                        "glosses": [
                            "Organiser en divisions."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3717873e-61ba-4e5f-ac7f-edc292a6e8ec",
                                "sense_id": "32fe9a48-0f2b-3da3-becd-9e5c8b24d908",
                                "text": "Parfois, des entreprises créent des divisions dans différents secteurs d’activités au lieu de, simplement, divisionnaliser des produits au sein d’un même secteur."
                            },
                            {
                                "example_id": "dfce83c3-17d0-4c0b-a6b0-1cb9ec2d44ed",
                                "sense_id": "32fe9a48-0f2b-3da3-becd-9e5c8b24d908",
                                "text": "Cette famille de structures peut se distinguer : – par le type de critère choisi pour « divisionnaliser » (produit, marché, etc. ; on pourrait assimiler aussi à cette catégorie les entreprises dont le découpage est à base géographique) ;"
                            },
                            {
                                "example_id": "2bd9da7c-b941-4bf7-bd36-06ec09f10359",
                                "sense_id": "32fe9a48-0f2b-3da3-becd-9e5c8b24d908",
                                "text": "Pourquoi les organisations ont-elles tendance à se divisionnaliser lorsqu'elles grandissent et vieillissent?"
                            }
                        ]
                    }
