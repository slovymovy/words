        "fr-extract.jsonl": [
            {
                "entry_id": "52801632-74d5-3091-aba2-011af5f027a1",
                "word": "bourgeron",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "fee32089-fbda-41f4-9e4f-ceb99f9802cc",
                        "entry_id": "52801632-74d5-3091-aba2-011af5f027a1",
                        "tags": [
                            "plural"
                        ],
                        "form": "bourgerons"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b854f4f5-b96e-3788-8b33-1ed213f00856",
                        "entry_id": "52801632-74d5-3091-aba2-011af5f027a1",
                        "glosses": [
                            "Blouse courte que portaient certains ouvriers en travaillant et les soldats à la caserne."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "f2fd81c1-e9c2-4096-b040-0843c4118d16",
                                "sense_id": "b854f4f5-b96e-3788-8b33-1ed213f00856",
                                "text": "La blouse, le bourgeron, la veste de velours dominent."
                            },
                            {
                                "example_id": "5983399c-5799-49dc-9696-7c4a4e203c1f",
                                "sense_id": "b854f4f5-b96e-3788-8b33-1ed213f00856",
                                "text": "Rouge d’indignation, il se démenait dans sa grande redingote, avec les gestes balourds des gens de campagne habitués au bourgeron."
                            },
                            {
                                "example_id": "db964c0e-b8e6-47ab-b251-2ac9849ffdf1",
                                "sense_id": "b854f4f5-b96e-3788-8b33-1ed213f00856",
                                "text": "Le gars aux biques portait, sous une limousine de roulier, un bourgeron bleu serré à la taille par une ceinture rouge qui maintenait un pantalon de velours à l'instar des charbonniers auvergnats, […]."
                            },
                            {
                                "example_id": "e0375f1c-1762-4252-90c1-183e07151962",
                                "sense_id": "b854f4f5-b96e-3788-8b33-1ed213f00856",
                                "text": "Il était là, au milieu des voitures des tripiers acculées aux trottoirs, dans la foule des hommes en bourgerons bleus et en tabliers blancs."
                            },
                            {
                                "example_id": "0ff2578d-affd-431f-873c-bde84715afca",
                                "sense_id": "b854f4f5-b96e-3788-8b33-1ed213f00856",
                                "text": "Il voyait passer les passants des faubourgs, depuis les femmes des ouvriers, qui dans la rue piaillent, jusqu’aux camarades en bourgeron bleu qu’une fille publique, leur femme, accompagne en riant."
                            },
                            {
                                "example_id": "8aa6c6cf-3af2-4f00-9b11-ae5652432440",
                                "sense_id": "b854f4f5-b96e-3788-8b33-1ed213f00856",
                                "text": "Des bourgerons et des pantalons de treillis, séchant au soleil, se balançaient dans le vide, comme des formes ridicules."
                            },
                            {
                                "example_id": "fb97ec93-19d4-4dfb-9c00-b2e566dd967a",
                                "sense_id": "b854f4f5-b96e-3788-8b33-1ed213f00856",
                                "text": "Au crépuscule, les garçons bouchers envahissent la rue pour accompagner le palefrenier jusqu’à son écurie, sarabande de tabliers blancs et de bourgerons à carreaux."
                            },
                            {
                                "example_id": "14a76ede-27f6-4077-8448-d3acaf5d0d1a",
                                "sense_id": "b854f4f5-b96e-3788-8b33-1ed213f00856",
                                "text": "En bourgerons sales, deux surveillants jouaient aux dames, tandis que le troisième, ceinturon bouclé, en touloupe et bottes de feutre, dormait sur un banc."
                            }
                        ]
                    },
                    {
                        "sense_id": "5979687c-44e4-3fec-9865-403c47b90092",
                        "entry_id": "52801632-74d5-3091-aba2-011af5f027a1",
                        "glosses": [
                            "Ouvrier."
                        ],
                        "tags": [
                            "metonymically"
                        ],
                        "examples": [
                            {
                                "example_id": "bbb71ebe-d751-4827-a1c5-f6d21cd15322",
                                "sense_id": "5979687c-44e4-3fec-9865-403c47b90092",
                                "text": "Car vous aimez les tâcherons\nDe l’idée et ceux qui la sèment,\nVous les blouses, les bourgerons,\nVous aimez les vrais qui vous aiment."
                            }
                        ]
                    }
                ],
