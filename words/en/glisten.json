{
    "word_family": [
        "glistening",
        "glisteningly"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4a5e9f83-9635-3094-b604-d785b63c057a",
                    "sense_definition": "To shine with a soft or sparkling light reflected from a wet or smooth surface.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "light reflection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The morning dew made the grass <w>glisten</w> under the early sunlight.",
                            "target_lang_translations": {
                                "ru": "Утренняя роса заставила траву <w>блестеть</w> в лучах раннего солнца."
                            }
                        },
                        {
                            "text": "Her eyes began to <w>glisten</w> with tears as she heard the beautiful music.",
                            "target_lang_translations": {
                                "ru": "Её глаза начали <w>блестеть</w> от слёз, когда она услышала прекрасную музыку."
                            }
                        }
                    ],
                    "synonyms": [
                        "gleam",
                        "glitter",
                        "shimmer",
                        "sparkle",
                        "twinkle"
                    ],
                    "common_phrases": [
                        "glisten with tears",
                        "glisten in the sun",
                        "glisten with sweat"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сиять мягким или искрящимся светом, отраженным от влажной или гладкой поверхности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "блестеть",
                                "target_lang_sense_clarification": "отражать свет, часто о влажной поверхности"
                            },
                            {
                                "target_lang_word": "сверкать",
                                "target_lang_sense_clarification": "ярко сиять или искриться"
                            },
                            {
                                "target_lang_word": "лосниться",
                                "target_lang_sense_clarification": "блестеть от влаги или жира"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5491ad40-0c7a-38bf-8316-84ea957de6fc",
                    "sense_definition": "A sparkling or lustrous shine, especially one reflected from a wet surface.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "light reflection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wet pavement had a strange <w>glisten</w> after the heavy rain shower.",
                            "target_lang_translations": {
                                "ru": "У мокрого тротуара был странный <w>блеск</w> после сильного ливня."
                            }
                        },
                        {
                            "text": "There was a faint <w>glisten</w> of oil on the surface of the water.",
                            "target_lang_translations": {
                                "ru": "На поверхности воды был виден слабый маслянистый <w>блеск</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "gleam",
                        "luster",
                        "sheen"
                    ],
                    "common_phrases": [
                        "faint glisten",
                        "wet glisten"
                    ],
                    "target_lang_definitions": {
                        "ru": "Искрящийся или глянцевый блеск, особенно отраженный от влажной поверхности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "блеск",
                                "target_lang_sense_clarification": "сияние отраженного света"
                            },
                            {
                                "target_lang_word": "отблеск",
                                "target_lang_sense_clarification": "слабое отражение света"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}