                "senses": [
                    {
                        "sense_id": "8456c882-9aad-38d5-a16d-1182466debb0",
                        "entry_id": "e200778d-9085-39a1-9983-370d288517dd",
                        "glosses": [
                            "jemand, der sich mit der Aufklärung von Kriminalfällen beschäftigt; ein Fachmann der Kriminalistik"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "626bdf76-a6da-4891-9d92-dd6fd9a84e39",
                                "sense_id": "8456c882-9aad-38d5-a16d-1182466debb0",
                                "text": "Mein Großvater war ein begnadeter Kriminalist."
                            },
                            {
                                "example_id": "fa10fe20-520e-45dd-b225-eafc6d8791d4",
                                "sense_id": "8456c882-9aad-38d5-a16d-1182466debb0",
                                "text": "„Kriminalisten erzählen von den Schwierigkeiten, die es macht, einen Verbrecher zu verhaften.“"
                            },
                            {
                                "example_id": "167a9f8c-01eb-4896-9af9-f2b58ee514e4",
                                "sense_id": "8456c882-9aad-38d5-a16d-1182466debb0",
                                "text": "„Das Refugium des ersten Kriminalisten Amerikas war mit schönen antiken Möbeln eingerichtet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
