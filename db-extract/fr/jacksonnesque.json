                                        "examples": [
                                            {
                                                "example_id": "da31e98b-b3c9-49f3-9483-18026c626483",
                                                "sense_id": "b31ea30e-b9d3-3dcb-bfc5-947ce8db7d93",
                                                "text": "In the [‘Billie Jean’ music] video, Jackson hoists up his drainpipe trousers, […] in order to strut his stuff – now-archetypal Jacksonesque dance movements involving either one shoe being stuck out and swivelled from side to side on the ball of the foot, or leaping knock-kneed up on to both toes."
                                            }
