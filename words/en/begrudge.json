{
    "word_family": [
        "begrudgingly",
        "unbegrudging",
        "grudge"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3b76d643-670c-3bec-9172-732a6a5c168b",
                    "sense_definition": "To feel envious of someone for possessing or enjoying something.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "envy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nobody could <w>begrudge</w> him his success after all the hard work he put in.",
                            "target_lang_translations": {
                                "cs": "Po vší té tvrdé práci mu ten úspěch nikdo nemohl <w>závidět</w>."
                            }
                        },
                        {
                            "text": "She seemed to <w>begrudge</w> her colleague the sudden promotion.",
                            "target_lang_translations": {
                                "cs": "Zdálo se, že své kolegyni to náhlé povýšení <w>nepřeje</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "envy",
                        "resent"
                    ],
                    "common_phrases": [
                        "begrudge someone their success"
                    ],
                    "target_lang_definitions": {
                        "cs": "Závidět někomu něco nebo mu nepřejit úspěch či majetek."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "závidět",
                                "target_lang_sense_clarification": "pociťovat závist"
                            },
                            {
                                "target_lang_word": "nepřát",
                                "target_lang_sense_clarification": "nechtít, aby někdo něco měl nebo zažil"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5b307e4a-1e3c-3ce4-9f7c-617d8f97c365",
                    "sense_definition": "To give, grant, or allow something reluctantly or resentfully.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "reluctance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He did not <w>begrudge</w> the money spent on his daughter's education.",
                            "target_lang_translations": {
                                "cs": "<w>Nelitoval</w> peněz vynaložených na vzdělání své dcery."
                            }
                        },
                        {
                            "text": "The company seemed to <w>begrudge</w> every penny they had to pay for benefits.",
                            "target_lang_translations": {
                                "cs": "Zdálo se, že společnost <w>lituje</w> každého halíře, který musela vyplatit na benefitech."
                            }
                        }
                    ],
                    "synonyms": [
                        "grudge"
                    ],
                    "common_phrases": [
                        "begrudge every penny"
                    ],
                    "target_lang_definitions": {
                        "cs": "Poskytnout, dát nebo povolit něco s nechutí či s odporem."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "litovat",
                                "target_lang_sense_clarification": "např. peněz či vynaloženého úsilí"
                            },
                            {
                                "target_lang_word": "dávat s nelibostí",
                                "target_lang_sense_clarification": "poskytovat něco velmi nerad"
                            },
                            {
                                "target_lang_word": "zdráhat se dát",
                                "target_lang_sense_clarification": "nerad poskytnout"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "17d02019-8324-3800-a24c-cfa07732c3ac",
                    "sense_definition": "To feel reluctant or unwilling to do something.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "reluctance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>begrudged</w> having to spend her entire weekend doing paperwork.",
                            "target_lang_translations": {
                                "cs": "<w>Štvalo ji</w>, že musela celý víkend strávit papírováním."
                            }
                        },
                        {
                            "text": "They <w>begrudged</w> paying the extra fee after such poor service.",
                            "target_lang_translations": {
                                "cs": "Po tak špatných službách platili ten příplatek <w>velmi neradi</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Dělat něco s velkou nechutí nebo odporem."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "dělat s nechutí",
                                "target_lang_sense_clarification": "velmi nerad něco vykonávat"
                            },
                            {
                                "target_lang_word": "nerad snášet",
                                "target_lang_sense_clarification": "vadit, protivit se"
                            },
                            {
                                "target_lang_word": "zdráhat se",
                                "target_lang_sense_clarification": "neochotně přistupovat k činnosti"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}