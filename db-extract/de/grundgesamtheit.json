                                "example_id": "c9d59eac-8768-4a90-b3fe-e8aed1b0adc4",
                                "sense_id": "f2e5bdc5-cee5-3cd2-b6ba-fbc416b660fd",
                                "text": "„Solche Überlegungen zielen darauf ab, von einer linguistisch wie auch immer zu definierenden »repräsentativen« beziehungsweise »homogenen« Stichprobe auf eine Grundgesamtheit schließen zu können.“"
                            },
                            {
                                "example_id": "59062567-008b-45a7-a6fa-41c41a567948",
                                "sense_id": "f2e5bdc5-cee5-3cd2-b6ba-fbc416b660fd",
                                "text": "„Der Schluß von Textstichproben auf die Grundgesamtheit ‚Sprache‘ ist allerdings mit nicht unerheblichen Problemen verbunden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
