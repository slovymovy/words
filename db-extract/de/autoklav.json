                        "entry_id": "9cf92b61-746c-3b9c-856b-8aa11119a978",
                        "glosses": [
                            "hermetisch verschließbares Metallgefäß mit eingebautem Thermometer und Manometer, in dem Stoffe bei Überdruck und hohen Temperaturen erhitzt werden können"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "f38ac787-1631-412f-b455-587f2d9260e8",
                                "sense_id": "76bb0c39-9220-3768-9f83-9c6f2fbd4104",
                                "text": "„Autoklaven aus Glas mit brennbaren Flüssigkeiten oder Gasen müssen grundsätzlich in Autoklavenräumen betrieben werden, da hier die Gefahr eines Zerknalls und damit der Bildung gefährlicher explosionsfähiger Atmosphäre noch größer ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
