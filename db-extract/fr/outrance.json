        "fr-extract.jsonl": [
            {
                "entry_id": "ea4f5c9f-da24-3d34-8346-4733fba71c16",
                "word": "Outrance",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "91586219-be46-3245-9768-a9cf6e6a3840",
                        "entry_id": "ea4f5c9f-da24-3d34-8346-4733fba71c16",
                        "glosses": [
                            "Nom donné aux locomotives à vapeur type 220 de la compagnie du Nord."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a454aa49-1940-4da8-8e1e-7bb8a26c1ed8",
                                "sense_id": "91586219-be46-3245-9768-a9cf6e6a3840",
                                "text": "La première machine Outrance de la Compagnie du Nord français, construite en 1871, était à trois essieux dont un porteur à l'avant."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": [
                    {
                        "linkage_id": "f9469c14-d5e2-45b6-ab8e-a6aa6eaec8f2",
                        "source_entry_id": "ea4f5c9f-da24-3d34-8346-4733fba71c16",
                        "source_sense_ids": [
                            "91586219-be46-3245-9768-a9cf6e6a3840"
                        ],
                        "linkage_type": "synonyms",
                        "word": "American"
                    }
                ]
            },
            {
                "entry_id": "d2fe5d9f-c7cf-38a6-a74c-bfc3e8630ff9",
                "word": "outrance",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "22625d15-5b14-4fe1-a35a-fd95b6215a61",
                        "entry_id": "d2fe5d9f-c7cf-38a6-a74c-bfc3e8630ff9",
                        "tags": [
                            "plural"
                        ],
                        "form": "outrances"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c61d235b-0b12-319e-9c7e-5509916134a9",
                        "entry_id": "d2fe5d9f-c7cf-38a6-a74c-bfc3e8630ff9",
                        "glosses": [
                            "Excès ; degré qui est au-delà des bornes habituelles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa096bd7-6f71-43a4-b719-49441b69cdeb",
                                "sense_id": "c61d235b-0b12-319e-9c7e-5509916134a9",
                                "text": "Le yé-yé désigne un genre, l’ensemble des exhibitions de mineurs ignares, exhibitions vocales ou instrumentales, individuelles ou collectives, caractérisées par leur outrance sonore et leur indigence d’expression."
                            },
                            {
                                "example_id": "a4c1140a-95ed-4ef2-88e5-316729f6f4e4",
                                "sense_id": "c61d235b-0b12-319e-9c7e-5509916134a9",
                                "text": "Mais les outrances de Poutine et les horreurs de la guerre semblent avoir peu à peu insensibilisé l’opinion publique."
                            }
                        ]
                    },
                    {
                        "sense_id": "8ea933b5-bd14-312c-a459-add394e839ae",
                        "entry_id": "d2fe5d9f-c7cf-38a6-a74c-bfc3e8630ff9",
                        "glosses": [
                            "Action ou parole qui est excessive, qui dépasse les bornes ou la mesure."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4897745a-e7fd-45d3-a2bd-043dafe31fee",
                                "sense_id": "8ea933b5-bd14-312c-a459-add394e839ae",
                                "text": "L’outrance de ses propos, de ses opinions. Il est usité surtout dans ces locutions adverbiales :"
                            },
                            {
                                "example_id": "2134158d-386b-43f5-af90-3b21d1b6fcc0",
                                "sense_id": "8ea933b5-bd14-312c-a459-add394e839ae",
                                "text": "à outrance, à toute outrance, Jusqu’à l’excès."
                            },
                            {
                                "example_id": "6362ac04-0fdf-41b2-85c9-aee85905aab4",
                                "sense_id": "8ea933b5-bd14-312c-a459-add394e839ae",
                                "text": "C’est un recueil de ses chroniques théâtrales avec une préface de Courteline. J’y rencontre des pages de maître, noyées exprès dans un flot d’outrance volontaire et préméditée."
                            },
                            {
                                "example_id": "672cfd92-eb31-4571-8627-634cf7ac68d3",
                                "sense_id": "8ea933b5-bd14-312c-a459-add394e839ae",
                                "text": "Il est avéré que le Front national a existé d'abord par Jean-Marie Le Pen, comédien patenté de la scène politique, bateleur maniant le calembour aussi bien que l’imparfait du subjonctif, vieux faluchard devenu charismatique par ses outrances mêmes."
                            },
                            {
                                "example_id": "def10fd6-4b2c-456d-9a0f-eaf40936de2e",
                                "sense_id": "8ea933b5-bd14-312c-a459-add394e839ae",
                                "text": "Cela explique pourquoi tous les comportements aberrants de Donald Trump, toutes ses déclarations qui oscillent entre l’obscénité et l’outrance, entre le mensonge et la diffamation, donnent à penser chaque fois que le pire est franchi."
                            },
                            {
                                "example_id": "7a981133-29c9-48d7-9850-289bc9f0c4eb",
                                "sense_id": "8ea933b5-bd14-312c-a459-add394e839ae",
                                "text": "Combat à outrance, Duel qui ne devait se terminer que lorsque l’un des deux adversaires était mis par sa blessure hors de combat ou demandait grâce."
                            },
                            {
                                "example_id": "e37e493c-3432-4826-b359-b061f71680f4",
                                "sense_id": "8ea933b5-bd14-312c-a459-add394e839ae",
                                "text": "Par extension, il signifie Combat acharné."
                            },
                            {
                                "example_id": "4105c80f-aaf0-446d-b6b0-c9908f810233",
                                "sense_id": "8ea933b5-bd14-312c-a459-add394e839ae",
                                "text": "Ces deux troupes ont livré un combat à outrance."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "59101f22-ee82-408d-9b21-8269dc8603d3",
                        "source_entry_id": "d2fe5d9f-c7cf-38a6-a74c-bfc3e8630ff9",
                        "source_sense_id": "c61d235b-0b12-319e-9c7e-5509916134a9",
                        "source_sense_description": "Excès ; degré qui est au-delà des bornes habituelles.",
                        "target_lang_word": "excess",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "excess",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ef891963-f1e1-373f-bfd2-0d95e0447e33",
                                        "entry_id": "01440bb8-3168-32c4-9c24-d6e33fa0f86a",
                                        "glosses": [
                                            "The state of surpassing or going beyond a limit; the state of being beyond sufficiency, necessity, or duty; more than what is usual or proper."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c541177c-243e-4a37-b975-1e6a87c7c9b9",
                                                "sense_id": "ef891963-f1e1-373f-bfd2-0d95e0447e33",
                                                "text": "The excess of heavy water was given away to the neighbouring country."
                                            },
                                            {
                                                "example_id": "0d8581c0-4825-4827-89ce-3086d6d0593f",
                                                "sense_id": "ef891963-f1e1-373f-bfd2-0d95e0447e33",
                                                "text": "To gild refined gold, to paint the lily,\nTo throw a perfume on the violet, […]\nIs wasteful and ridiculous excess."
                                            },
                                            {
                                                "example_id": "bad72eb1-38e9-4214-946d-8cd7a2ed89bf",
                                                "sense_id": "ef891963-f1e1-373f-bfd2-0d95e0447e33",
                                                "text": "That kills me with excess of grief, this with excess of joy."
                                            },
                                            {
                                                "example_id": "5c80b622-561e-486c-a846-e19d1abb53fb",
                                                "sense_id": "ef891963-f1e1-373f-bfd2-0d95e0447e33",
                                                "text": "[...] after the original Victorian station was demolished and then entombed in concrete in the 1960s, Birmingham New Street became a byword for the worst excesses of the much-loathed Brutalist architecture so widely used to reconstruct inner-city post-war Britain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a65a673a-5713-3cce-9133-665f6c6174df",
                                        "entry_id": "01440bb8-3168-32c4-9c24-d6e33fa0f86a",
                                        "glosses": [
                                            "The degree or amount by which one thing or number exceeds another; remainder."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ec59c88-449a-4b86-a01b-5b84743a5db1",
                                                "sense_id": "a65a673a-5713-3cce-9133-665f6c6174df",
                                                "text": "The difference between two numbers is the excess of one over the other."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a7b1c070-6154-3146-85f6-f44a6155b565",
                                        "entry_id": "01440bb8-3168-32c4-9c24-d6e33fa0f86a",
                                        "glosses": [
                                            "An act of eating or drinking more than enough."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "162ff9a1-8a5b-469c-b2c6-012b8c0c47bc",
                                                "sense_id": "a7b1c070-6154-3146-85f6-f44a6155b565",
                                                "text": "And be not drunk with wine, wherein is excess."
                                            },
                                            {
                                                "example_id": "621122a1-8368-4a21-8cf7-ea68a35d040e",
                                                "sense_id": "a7b1c070-6154-3146-85f6-f44a6155b565",
                                                "text": "Fair Angel, thy desire . . .\n. . . leads to no excess\nThat reaches blame"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a2988d5-a734-3976-9d98-db3fc325a24e",
                                        "entry_id": "01440bb8-3168-32c4-9c24-d6e33fa0f86a",
                                        "glosses": [
                                            "Spherical excess, the amount by which the sum of the three angles of a spherical triangle exceeds two right angles. The spherical excess is proportional to the area of the triangle."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
