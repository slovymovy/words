                ],
                "senses": [
                    {
                        "sense_id": "38175d8e-82e0-39e2-b9a3-f4e8dd30e59a",
                        "entry_id": "adaff484-219e-3d30-9dd0-623af1a1018c",
                        "glosses": [
                            "Supporting indigenous people or beliefs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0228f2c-359a-487c-9671-cf3b45a083e6",
                                "sense_id": "38175d8e-82e0-39e2-b9a3-f4e8dd30e59a",
                                "text": "The nationalist and indigenist positions often overlap, and both nationalists and indigenists tend to see themselves as apart from and in opposition to the cosmopolitans"
                            },
                            {
                                "example_id": "830c79b4-70ca-4891-ae13-4a2f8baa7fba",
                                "sense_id": "38175d8e-82e0-39e2-b9a3-f4e8dd30e59a",
                                "text": "Indigenist research rejects the oppressively dehumanizing characterization of Indigenous peoples as oppressed 'victims' in need of charity."
                            },
                            {
                                "example_id": "c9332bac-906c-467c-ac56-274bee0dac94",
                                "sense_id": "38175d8e-82e0-39e2-b9a3-f4e8dd30e59a",
                                "text": "Both indigenist and Communist views on land, moreover, are today articulated under the shadow of a neoliberal “model of empowerment based implicitly or explicitly on property rights”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f1e2ab37-4a11-4e72-a5ee-c265209391f9",
                        "source_entry_id": "adaff484-219e-3d30-9dd0-623af1a1018c",
                        "source_sense_id": "38175d8e-82e0-39e2-b9a3-f4e8dd30e59a",
