                        "entry_id": "ed6a4b20-753f-3500-b5f9-2a4ce6986399",
                        "glosses": [
                            "Relatif aux dinosaures."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32cd93f3-a790-4bb7-bfdb-faa9538d6052",
                                "sense_id": "a0e0553f-aad7-3940-a4e3-1f849f007fc9",
                                "text": "On y voit apparaître les premières espèces de reptiles marins, volants et dinosauriens."
                            }
                        ]
                    },
                    {
                        "sense_id": "e222f05d-9f07-3c1f-ac17-a1c66fdd5c97",
                        "entry_id": "ed6a4b20-753f-3500-b5f9-2a4ce6986399",
                        "glosses": [
                            "Préhistorique, antédiluvien."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51bf2226-8a71-4b6c-96e2-2444a171fe60",
                                "sense_id": "e222f05d-9f07-3c1f-ac17-a1c66fdd5c97",
                                "text": "Aucune surprise venant de ce gouvernement d'orangistes dinosauriens."
                            }
                        ]
                    },
                    {
                        "sense_id": "5f432d59-0f0e-3753-abbc-c5885addcd03",
                        "entry_id": "ed6a4b20-753f-3500-b5f9-2a4ce6986399",
                        "glosses": [
                            "Pachydermique, gigantesque."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98b34779-eab3-4be1-bb25-83383a5d7fb8",
                                "sense_id": "5f432d59-0f0e-3753-abbc-c5885addcd03",
                                "text": "Dans le marché de l'automobile, l'écart se creuse entre les voitures de luxe, de plus en plus chères et énergivores, voire carrément dinosauriennes, et le marché des plus petites voitures où se concentre un niveau étonnant de raffinement, autant du côté du confort que de la motorisation, de plus en plus efficace sur le plan énergétique."
                            }
                        ]
                    }
