                                        "glosses": [
                                            "jemand, der sehr/zu schnell fährt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58c293ca-1f6d-4e61-8b6c-6ce17f8a2c28",
                                                "sense_id": "82a538a1-9f88-3f6f-bcd4-31145586f62a",
                                                "text": "„Außerdem seien einige Raser auch schon erwischt worden.“"
                                            },
                                            {
                                                "example_id": "f872b580-31e9-41c9-8411-4098f4d7cf1b",
                                                "sense_id": "82a538a1-9f88-3f6f-bcd4-31145586f62a",
                                                "text": "„Wir sind ein Volk der Raser, das muss man leider sagen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
