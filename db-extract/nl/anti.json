                                "sense_id": "82e21231-f124-3d6f-8159-fd00489bea21",
                                "text": "Ik ben vaak anti, vooral als andere mensen vóór zijn."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f288cb7d-8df6-49a9-a52e-14b03d6c94fa",
