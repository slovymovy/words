                    {
                        "translation_id": "c6d961ba-d2ca-4bdd-9887-f81608a54202",
                        "source_entry_id": "d23a374b-d950-33da-9ec2-0f1e10736353",
                        "source_sense_id": "64f8c7c1-a2b8-3b49-8fa0-82bfcbba9f15",
                        "target_lang_word": "pénitence",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pénitence",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b785263d-32a3-3f9e-8ae5-0cae42aee2fc",
                                        "entry_id": "66c0390e-1c30-333b-a055-4e88c38ea7a5",
                                        "glosses": [
                                            "Repentir suivi d’expiation, regret d’avoir offensé Dieu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3a12bb9-b519-43b0-a2df-64b494f51b44",
                                                "sense_id": "b785263d-32a3-3f9e-8ae5-0cae42aee2fc",
                                                "text": "La pénitence est une vertu chrétienne."
                                            },
                                            {
                                                "example_id": "c1da8679-9243-4610-8d93-3a12e059030d",
                                                "sense_id": "b785263d-32a3-3f9e-8ae5-0cae42aee2fc",
                                                "text": "Une pénitence tardive."
                                            },
                                            {
                                                "example_id": "841df92f-677a-4388-8ede-b55ef45fe1ce",
                                                "sense_id": "b785263d-32a3-3f9e-8ae5-0cae42aee2fc",
                                                "text": "Les fruits de la pénitence."
                                            },
                                            {
                                                "example_id": "946efa2c-1775-4565-9cf8-9bc409bf8333",
                                                "sense_id": "b785263d-32a3-3f9e-8ae5-0cae42aee2fc",
                                                "text": "Sacrement de pénitence ou"
                                            },
                                            {
                                                "example_id": "0940f5f7-79df-43c7-848b-acf0d47142f9",
                                                "sense_id": "b785263d-32a3-3f9e-8ae5-0cae42aee2fc",
                                                "text": "Sacrement de la pénitence, Celui des sept sacrements de l’église par lequel le prêtre remet les péchés à ceux qui s’en confessent à lui."
                                            },
                                            {
                                                "example_id": "f7061ab7-05ac-412c-981e-36e765115637",
                                                "sense_id": "b785263d-32a3-3f9e-8ae5-0cae42aee2fc",
                                                "text": "Le tribunal de la pénitence se dit du Prêtre qui confesse et du Lieu où il confesse."
                                            },
                                            {
                                                "example_id": "494f0ae3-0b04-4f7b-829b-8b33fdc1e6b8",
                                                "sense_id": "b785263d-32a3-3f9e-8ae5-0cae42aee2fc",
                                                "text": "Aller porter ses péchés au tribunal de la pénitence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5ffe43ab-4554-3b7e-a746-130faf66a02c",
                                        "entry_id": "66c0390e-1c30-333b-a055-4e88c38ea7a5",
                                        "glosses": [
                                            "Ce que le prêtre ordonne en satisfaction des péchés que l’on lui a confessés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b752369-5fe9-48e5-93ed-36402444d005",
                                                "sense_id": "5ffe43ab-4554-3b7e-a746-130faf66a02c",
                                                "text": "Son confesseur lui a donné pour pénitence un Pater et un Avé à réciter."
                                            },
                                            {
                                                "example_id": "109707ee-f778-4e77-a4e8-eb6ff45750ac",
                                                "sense_id": "5ffe43ab-4554-3b7e-a746-130faf66a02c",
                                                "text": "Accomplir sa pénitence, satisfaire à sa pénitence, faire sa pénitence."
                                            },
                                            {
                                                "example_id": "64f4e02f-8056-4ba8-9ebb-747d86aba5c1",
                                                "sense_id": "5ffe43ab-4554-3b7e-a746-130faf66a02c",
                                                "text": "Les pénitences publiques ne sont plus en usage dans l’église."
                                            },
                                            {
                                                "example_id": "38f66c7d-9568-4fd1-a5b1-79fc891989c0",
                                                "sense_id": "5ffe43ab-4554-3b7e-a746-130faf66a02c",
                                                "text": "Le supérieur l’absout, sans l’obliger à des pénitences auxquelles il sait fort bien que son visiteur ne s’astreindra pas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a4bc8e88-88a0-3be3-a5c9-7a655116ae37",
                                        "entry_id": "66c0390e-1c30-333b-a055-4e88c38ea7a5",
                                        "glosses": [
                                            "Austérités qu’on s’impose volontairement pour l’expiation de ses péchés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2aad9066-e1b0-4d8a-8caa-87363e53bfb4",
                                                "sense_id": "a4bc8e88-88a0-3be3-a5c9-7a655116ae37",
                                                "text": "Faire pénitence de ses péchés."
                                            },
                                            {
                                                "example_id": "83f5bcda-f35b-485c-b1f6-480e14a521bf",
                                                "sense_id": "a4bc8e88-88a0-3be3-a5c9-7a655116ae37",
                                                "text": "Vivre dans la pénitence, dans une pénitence continuelle, dans les exercices de la pénitence."
                                            },
                                            {
                                                "example_id": "5c23e780-9905-4149-9d25-117d38f43d99",
                                                "sense_id": "a4bc8e88-88a0-3be3-a5c9-7a655116ae37",
                                                "text": "Il faut faire pénitence, si l’on veut être sauvé."
                                            },
                                            {
                                                "example_id": "8532243c-8639-43a5-b76e-990cba285b8d",
                                                "sense_id": "a4bc8e88-88a0-3be3-a5c9-7a655116ae37",
                                                "text": "Le carême est un temps de pénitence."
                                            },
                                            {
                                                "example_id": "53b2b1ab-5e61-4e8a-aa33-6feea8312ece",
                                                "sense_id": "a4bc8e88-88a0-3be3-a5c9-7a655116ae37",
                                                "text": "Les psaumes de la pénitence. Voyez « psaume »."
                                            },
                                            {
                                                "example_id": "0169af6b-9dbc-4f60-9d40-7bd09de3d757",
                                                "sense_id": "a4bc8e88-88a0-3be3-a5c9-7a655116ae37",
                                                "text": "Faire pénitence de ses excès, de ses torts, de sa mauvaise conduite, En être puni par quelque maladie, par quelque infirmité, par quelque malheur."
                                            },
                                            {
                                                "example_id": "81dfec9d-4575-48ef-b53d-dcf644dfc03c",
                                                "sense_id": "a4bc8e88-88a0-3be3-a5c9-7a655116ae37",
                                                "text": "Il fait pénitence du passé."
                                            },
                                            {
                                                "example_id": "dfa04420-aa84-461d-8325-4ce1ace74d3b",
                                                "sense_id": "a4bc8e88-88a0-3be3-a5c9-7a655116ae37",
                                                "text": "Il s’est abandonné à la débauche dans sa jeunesse, il en fait maintenant pénitence."
                                            },
                                            {
                                                "example_id": "021df387-a131-430e-ad8b-995909dbfb66",
                                                "sense_id": "a4bc8e88-88a0-3be3-a5c9-7a655116ae37",
                                                "text": "Il s’est perdu par son indiscrétion, et il a maintenant tout le loisir d’en faire pénitence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3609a0b2-d431-36b4-9d1a-d387e12ae2bd",
                                        "entry_id": "66c0390e-1c30-333b-a055-4e88c38ea7a5",
                                        "glosses": [
                                            "Mauvaise chère."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "70f87b2b-424c-4712-bd98-a5cbccd46042",
                                                "sense_id": "3609a0b2-d431-36b4-9d1a-d387e12ae2bd",
                                                "text": "Si vous voulez demeurer à dîner avec nous, vous ferez pénitence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a41b6185-074b-3412-b4a4-0834698986c5",
                                        "entry_id": "66c0390e-1c30-333b-a055-4e88c38ea7a5",
                                        "glosses": [
                                            "Punition imposée pour quelque faute."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d72e259-8661-4fb3-8a7d-e4229003992e",
                                                "sense_id": "a41b6185-074b-3412-b4a4-0834698986c5",
                                                "text": "Voilà une rude pénitence pour une faute bien légère."
                                            },
                                            {
                                                "example_id": "2c3f4f72-4c68-4cef-bf93-3990f6d39e64",
                                                "sense_id": "a41b6185-074b-3412-b4a4-0834698986c5",
                                                "text": "Faire subir une pénitence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c2441616-8efc-3bb3-b755-80fa510200a7",
                                        "entry_id": "66c0390e-1c30-333b-a055-4e88c38ea7a5",
                                        "glosses": [
                                            "Peine qu’on impose à ceux qui ont manqué aux règles, aux conventions, ou qui n’ont pas deviné quelque chose, qui ont mal répondu."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
