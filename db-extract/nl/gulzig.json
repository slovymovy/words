                "senses": [
                    {
                        "sense_id": "c6012010-dd93-35d2-a448-2dcdbd97032b",
                        "entry_id": "f49254d0-f3a2-3299-a225-ce371709621e",
                        "glosses": [
                            "met overmatige gretigheid iets verorberend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fdb8f006-820b-46d4-9580-7819f2233085",
                                "sense_id": "c6012010-dd93-35d2-a448-2dcdbd97032b",
                                "text": "De gulzige wolven maakten snel korte metten met hun prooi."
                            },
                            {
                                "example_id": "cbf31dfb-9728-4812-b01f-af3be8d87e8b",
                                "sense_id": "c6012010-dd93-35d2-a448-2dcdbd97032b",
                                "text": "Ze zou net als haar voorgangers uit de 17de eeuw ook wel een frisse duik willen nemen, maar voorlopig volstaan gulzige slokken uit haar bidon."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ca3b6cb6-739b-45c8-8f4f-9a80738b7a27",
                        "source_entry_id": "f49254d0-f3a2-3299-a225-ce371709621e",
                        "source_sense_id": "c6012010-dd93-35d2-a448-2dcdbd97032b",
