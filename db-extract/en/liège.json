                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b8b8a7f9-5569-30dc-a836-4154729069e4",
                                        "entry_id": "d7d131be-17fe-3b61-abb5-a745b8cae8bc",
                                        "glosses": [
                                            "die belgische Stadt Lüttich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f3e9561-b116-4e2b-b155-e268a38a7124",
                                                "sense_id": "b8b8a7f9-5569-30dc-a836-4154729069e4",
                                                "text": "Ich bin in Lüttich geboren."
                                            },
                                            {
                                                "example_id": "f72241e4-69b0-4fbd-955b-0f84a566be5c",
                                                "sense_id": "b8b8a7f9-5569-30dc-a836-4154729069e4",
                                                "text": "Ich habe in Lüttich meinen Urlaub verbracht."
                                            },
                                            {
                                                "example_id": "5e389841-8ffb-4017-8ce9-f58858ed31e6",
                                                "sense_id": "b8b8a7f9-5569-30dc-a836-4154729069e4",
                                                "text": "Nach Lüttich führen viele Wege."
                                            },
                                            {
                                                "example_id": "7a0efe23-991b-41d6-8351-b5411bf2d114",
                                                "sense_id": "b8b8a7f9-5569-30dc-a836-4154729069e4",
                                                "text": "„Wir rasteten einen Tag in Brüssel und einen weiteren in Lüttich.“"
                                            },
                                            {
                                                "example_id": "655c06cf-12fc-419e-af39-9a79ec415ae6",
                                                "sense_id": "b8b8a7f9-5569-30dc-a836-4154729069e4",
                                                "text": "„Die Ermordung des Bischofs von Lüttich ist um fünfzehn Jahre vorverlegt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
