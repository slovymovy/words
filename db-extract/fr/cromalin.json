                        "sense_id": "ee8891ab-2fad-356a-aa51-d941ad8e7f67",
                        "entry_id": "e16066f0-b937-323d-8e7e-e197637c7408",
                        "glosses": [
                            "Type d’épreuve en couleurs d’un document à imprimer utilisée pour le contrôle des couleurs avant l’établissement d’un bon à tirer, créée par la société américaine DuPont."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "e1f42a46-9391-39de-ad67-7cfb037594f6",
                        "entry_id": "e16066f0-b937-323d-8e7e-e197637c7408",
                        "glosses": [
                            "Tout type d’épreuve en couleurs utilisée pour les bons à tirer, aujourd’hui sous la forme d’un fichier informatique (généralement PDF)."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "73634bd1-9af5-4ed8-a1e3-154fa01cef3f",
                                "sense_id": "e1f42a46-9391-39de-ad67-7cfb037594f6",
                                "text": "Il pouvait déceler n’importe quelle nuance, lui qui avait été habitué à vérifier des cromalins et autres nuanciers avant pour l’impression des livres."
                            },
                            {
                                "example_id": "7b671204-305f-4fe0-8a9f-f6b1aedeb7e0",
                                "sense_id": "e1f42a46-9391-39de-ad67-7cfb037594f6",
                                "text": "Autrefois analogique et réalisé directement à partir des films, le cromalin, aujourd’hui numérique, est imprimé sur une imprimante laser ou jet d’encre à partir du fichier dont il est le reflet fidèle. Rapide et peu onéreux, il autorise aisément les corrections de dernières minutes."
                            }
                        ]
                    }
