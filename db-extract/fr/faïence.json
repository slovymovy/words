            {
                "entry_id": "2a5e7dcf-7e20-3720-9589-a16ddfcd4ff4",
                "word": "faïence",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "2f6912ae-305b-4a30-aefb-b1a19605e87a",
                        "entry_id": "2a5e7dcf-7e20-3720-9589-a16ddfcd4ff4",
                        "tags": [
                            "plural"
                        ],
                        "form": "faïences"
                    },
                    {
                        "form_id": "e52fc330-e55a-4664-9b42-819abd048ac3",
                        "entry_id": "2a5e7dcf-7e20-3720-9589-a16ddfcd4ff4",
                        "tags": [
                            "orthographe désuète"
                        ],
                        "form": "fayence"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "64354794-42b9-317a-a203-473a3f05dff9",
                        "entry_id": "2a5e7dcf-7e20-3720-9589-a16ddfcd4ff4",
                        "glosses": [
                            "Poterie de terre ordinairement vernissée ou émaillée de bleu sur fond blanc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b969fbe8-6511-44a9-a5e6-0cfc1779a97c",
                                "sense_id": "64354794-42b9-317a-a203-473a3f05dff9",
                                "text": "Elle y plaça deux chandeliers dont elle alluma les chandelles, et une jatte de faïence où trempait dans l’eau bénite une branche de buis."
                            },
                            {
                                "example_id": "1be64a4b-bca8-46af-8076-e9f7a8b00224",
                                "sense_id": "64354794-42b9-317a-a203-473a3f05dff9",
                                "text": "Où, avec génie, du reste, avez-vous caché le bouquetier de faïence qui sera pour votre chambre ? Je le cherche depuis quelques heures, dans la commode, le petit placard, l'office, en vain : et le plateau à thé ?"
                            },
                            {
                                "example_id": "84dc8590-a859-4d2b-946a-fb35cf447a7b",
                                "sense_id": "64354794-42b9-317a-a203-473a3f05dff9",
                                "text": "La porte s'ouvrit sur un corridor qui sentait le linoléum, avec un portemanteau en bambou à droite, des plantes vertes, dans des cache-pot de faïence."
                            }
                        ]
                    },
                    {
                        "sense_id": "544bb0f1-e68a-35b7-a723-47b478aebf18",
                        "entry_id": "2a5e7dcf-7e20-3720-9589-a16ddfcd4ff4",
                        "glosses": [
                            "Objet, vaisselle de faïence."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee5c95cc-de38-4fd2-97ba-5bfdc36e3942",
                                "sense_id": "544bb0f1-e68a-35b7-a723-47b478aebf18",
                                "text": "Cependant les murs de Montreuil et la faïence du déjeuner me rappelèrent tout à fait l'Angleterre."
                            },
                            {
                                "example_id": "51555af4-704a-4ad5-8ab1-f926825f6c65",
                                "sense_id": "544bb0f1-e68a-35b7-a723-47b478aebf18",
                                "text": "Après leur soupe, ils vidèrent un verre de vin dans leur assiette et firent chabrot, levant la lourde faïence brune jusqu'à leurs lèvres qu'ils essuyèrent ensuite d'un rapide coup de poignet."
                            }
                        ]
                    },
                    {
                        "sense_id": "5bce9f6f-020a-3fee-a397-d7f7ff492e32",
                        "entry_id": "2a5e7dcf-7e20-3720-9589-a16ddfcd4ff4",
                        "glosses": [
                            "Bleu, en parlant de l’iris."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7666fc22-7962-4511-a09d-e341e227265e",
                                "sense_id": "5bce9f6f-020a-3fee-a397-d7f7ff492e32",
                                "text": "Des femmes couleur de café brûlé (…) ouvrant tout ébahis leurs grands yeux de faïence."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2f443ad6-a0b1-4722-a2cf-27abe79abe1d",
                        "source_entry_id": "2a5e7dcf-7e20-3720-9589-a16ddfcd4ff4",
                        "target_lang_word": "Fayence",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fayence",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "02325f07-e10c-352c-87a4-4503102621c8",
                                        "entry_id": "398586a6-75b7-3439-bddf-6f7ad7605717",
                                        "glosses": [
                                            "(weiß) deckend glasiertes, oft auch bemaltes keramisches Erzeugnis"
                                        ],
                                        "tags": [
                                            "Kunsthandwerk"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "04fde74a-cc87-464b-b968-49065a9e823b",
                                                "sense_id": "02325f07-e10c-352c-87a4-4503102621c8",
                                                "text": "„Längst nicht so bekannt wie ihre Verwandten aus Faenza in Italien sind unverdienterweise die Kellinghusener Fayencen aus Mittelholstein. Dennoch hat die kunstvolle Herstellung von Tellern und Töpfen, von Krügen und Kummen in der kleinen Stadt eine lange Tradition, die bis auf die Zeit um 1760 zurückreicht.“"
                                            },
                                            {
                                                "example_id": "a6b978e0-c785-4ac5-bf34-eb1cacb67d51",
                                                "sense_id": "02325f07-e10c-352c-87a4-4503102621c8",
                                                "text": "„Die Blaue Moschee (Sultan Ahmet Moschee) ist ein einzigartiges Beispiel osmanischer Machtdemonstration mit wunderbaren Fayencen im lichtdurchfluteten Innenraum.“"
                                            },
                                            {
                                                "example_id": "fc9d5daa-b309-4c4a-b2ca-6bf6067b7d86",
                                                "sense_id": "02325f07-e10c-352c-87a4-4503102621c8",
                                                "text": "„Während dieser Streitereien hatte er ein paarmal die Suppenterrine wiedergesehen; und in seiner Seele war der heiße Wunsch erwacht, diese Fayence zu besitzen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "879185de-33e4-44c0-b42e-fab875d8ec63",
                        "source_entry_id": "2a5e7dcf-7e20-3720-9589-a16ddfcd4ff4",
                        "target_lang_word": "Steingut",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Steingut",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a68e427d-2dd6-383c-befb-68b6d7eb8ddc",
                                        "entry_id": "4160b4b1-342e-38af-b3f7-e65674392f9f",
                                        "glosses": [
                                            "aus Quarz, Ton und Feldspat bestehende, bei niedriger Hitze gebrannte, durchsichtig glasierte Tonwaren mit weißem, porösem Scherben für Geschirr, Fliesen, Waschtische, Badewannen und andere sanitäre Artikel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b3bb952-78e6-4d8c-b342-dbe222d21f35",
                                                "sense_id": "a68e427d-2dd6-383c-befb-68b6d7eb8ddc",
                                                "text": "Führt zur Hütte für traditionelle Fähigkeiten, wo die Jungen Körbe flechten und die Mädchen Steingut brennen."
                                            },
                                            {
                                                "example_id": "e2c06685-50c1-4bec-8bce-ebe4be0077e3",
                                                "sense_id": "a68e427d-2dd6-383c-befb-68b6d7eb8ddc",
                                                "text": "Kommunale Wohnungen sind vielleicht nicht das Tafelsilber, aber das Steingut des Stadthaushalts."
                                            },
                                            {
                                                "example_id": "6d475cdb-9aff-4168-930a-4ad370883368",
                                                "sense_id": "a68e427d-2dd6-383c-befb-68b6d7eb8ddc",
                                                "text": "Künftig durfte das Essen nur noch in Steingut und Porzellan serviert werden."
                                            },
                                            {
                                                "example_id": "106388b3-843b-467c-988b-0bd51a208675",
                                                "sense_id": "a68e427d-2dd6-383c-befb-68b6d7eb8ddc",
                                                "text": "Auch dieses [Waschbecken] war von weißem Steingut, und nun kamen auch die Handtücher zu Ehren."
                                            },
                                            {
                                                "example_id": "9a0b4694-ca02-4664-a3d5-79e2c6284166",
                                                "sense_id": "a68e427d-2dd6-383c-befb-68b6d7eb8ddc",
                                                "text": "Dicht neben den Verkaufsständen mit Kirchengeräten wurde kunstvoll geschliffenes Glas feilgeboten, und gegenüber den gewaltigen, mit Pokalen und Weingläsern reich besetzten Vitrinen leuchtete das blanke Steingut der Toiletteneinrichtungen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1b3c82d3-7841-43ba-9c04-fd79cca166bf",
                        "source_entry_id": "2a5e7dcf-7e20-3720-9589-a16ddfcd4ff4",
                        "target_lang_word": "faience",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "faience",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "29f9afb5-1689-3157-bec6-7ddc31cc6104",
                                        "entry_id": "8f9fb562-8a23-345a-8645-910c55f68129",
                                        "glosses": [
                                            "A type of tin-glazed earthenware ceramic, used domestically for tableware and in architecture as a decorative material."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ffa3a274-e902-4fca-be36-214bf6eb1b26",
                                                "sense_id": "29f9afb5-1689-3157-bec6-7ddc31cc6104",
                                                "text": "If she had wondered what Mrs. Burrage wished so particularly to talk about, she waited some time for the clearing-up of the mystery. During this interval she sat in a remarkably pretty boudoir, where there were flowers and faiences and little French pictures, and watched her hostess revolve round the subject in circles the vagueness of which she tried to dissimulate."
                                            },
                                            {
                                                "example_id": "64c5c4c5-be09-4d64-8cac-b05ae5a7cfb6",
                                                "sense_id": "29f9afb5-1689-3157-bec6-7ddc31cc6104",
                                                "text": "The word Majolica, or Maiolica […] was applied to all Stanniferous faience of Italy and Spain."
                                            },
                                            {
                                                "example_id": "dca12bac-6378-43c3-8093-2baf9d70f875",
                                                "sense_id": "29f9afb5-1689-3157-bec6-7ddc31cc6104",
                                                "text": "The white faience façade, the glazed Doultonware Carrera marble, was made locally. And being glazed, it was impervious to London's sooty atmosphere, enabling easier cleaning."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "73f95ed4-f812-3173-8b5e-eb3908b31241",
                                        "entry_id": "8f9fb562-8a23-345a-8645-910c55f68129",
                                        "glosses": [
                                            "Beads or small ornaments made from frit, from the eastern Mediterranean of the Bronze and Iron Ages."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "46bd3159-87e0-4a02-8a69-7afb52c14f2e",
                        "source_entry_id": "2a5e7dcf-7e20-3720-9589-a16ddfcd4ff4",
                        "target_lang_word": "porcelain",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "porcelain",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0b108e97-0f8b-3eb0-a192-2f76db4cd267",
                                        "entry_id": "b9db8a79-f461-3551-b550-ff3832ac0864",
                                        "glosses": [
                                            "A hard white translucent ceramic, originally made by firing kaolin, quartz, and feldspar at high temperatures but now also inclusive of similar artificial materials; also often (figurative) such a material as a symbol of the fragility, elegance, etc. traditionally associated with porcelain goods."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff496c59-25a6-489e-b649-fbdadf25c644",
                                                "sense_id": "0b108e97-0f8b-3eb0-a192-2f76db4cd267",
                                                "text": "Tableware and toilets are both made of porcelain."
                                            },
                                            {
                                                "example_id": "a7834126-28a4-4c96-8b84-4fbdda79f2ee",
                                                "sense_id": "0b108e97-0f8b-3eb0-a192-2f76db4cd267",
                                                "text": "Any power rail needs to be well insulated from earth, to minimise current leakage, and so the two power rails on the Underground sit on curiously genteel and antique-looking porcelain pots."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d1ba667-298f-330c-ad37-cd2762c8a7e1",
                                        "entry_id": "b9db8a79-f461-3551-b550-ff3832ac0864",
                                        "glosses": [
                                            "Synonym of china: porcelain tableware."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c93cbae6-cf13-4212-a533-fe8350e97975",
                                                "sense_id": "7d1ba667-298f-330c-ad37-cd2762c8a7e1",
                                                "text": "iij. potts of Erthe payntid, callyd Porseland."
                                            },
                                            {
                                                "example_id": "bdb87784-cd30-4467-a605-3ca09df5c4be",
                                                "sense_id": "7d1ba667-298f-330c-ad37-cd2762c8a7e1",
                                                "text": "He set the table with our porcelain and stemware."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89be6de7-2f78-3fb2-8132-8c32d9a33d8d",
                                        "entry_id": "b9db8a79-f461-3551-b550-ff3832ac0864",
                                        "glosses": [
                                            "Synonym of kaolin: the kind of clay traditionally used in China to manufacture porcelain."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "49dafdce-c6bf-45aa-bdd9-4bd9e3637668",
                                                "sense_id": "89be6de7-2f78-3fb2-8132-8c32d9a33d8d",
                                                "text": "[...] that earthen or pliable matter commonly called porcellan, which is pure white,... wherof vessels of all kinds are very curiously framed..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c2e66499-5859-3cf7-a659-39146e975ada",
                                        "entry_id": "b9db8a79-f461-3551-b550-ff3832ac0864",
                                        "glosses": [
                                            "An object made of porcelain, (particularly) art objects or items of tableware."
                                        ],
                                        "tags": [
                                            "countable",
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a4ae4eeb-2ed6-4e9a-a198-f08f930e7f52",
                                                "sense_id": "c2e66499-5859-3cf7-a659-39146e975ada",
                                                "text": "The museum has an extensive collection of rare Chinese porcelains."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a314982-1574-3aa8-ba33-0819e640c049",
                                        "entry_id": "b9db8a79-f461-3551-b550-ff3832ac0864",
                                        "glosses": [
                                            "Synonym of cowrie."
                                        ],
                                        "tags": [
                                            "countable",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6a3efa58-a1ff-48bf-931d-2531cc0ed684",
                                                "sense_id": "3a314982-1574-3aa8-ba33-0819e640c049",
                                                "text": "In the kingdomes of Caiacan and Carazan, certaine sea shels are currant, which some men terme Porcelline."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2fcf98e3-a455-3643-8350-0051cce13f98",
                                        "entry_id": "b9db8a79-f461-3551-b550-ff3832ac0864",
                                        "glosses": [
                                            "Synonym of wampum: strings of shells, beads, etc. used as ornamentation or currency; the composite shells, beads, etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "historical",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4fc485f0-6b11-446c-9736-1235a5ea3193",
                                                "sense_id": "2fcf98e3-a455-3643-8350-0051cce13f98",
                                                "text": "We mett severall gangs of men to our greatest disadvantage, ffor we weare forced to sing, and those that came to see us gave porcelaine to those that most did us injury."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4995dc1c-9c64-30ea-8370-a9867725160a",
                                        "entry_id": "b9db8a79-f461-3551-b550-ff3832ac0864",
                                        "glosses": [
                                            "A kind of pigeon with deep brown and off-white feathers."
                                        ],
                                        "tags": [
                                            "capitalized",
                                            "countable",
                                            "often"
                                        ],
