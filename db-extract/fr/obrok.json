                    {
                        "sense_id": "376f4c8a-1854-382e-aa21-4aaabf04eb83",
                        "entry_id": "97bfad0a-7ba7-3b6a-aa7c-47279b4bc996",
                        "glosses": [
                            "Dans la Russie impériale, taxe qu’un serf doit payer à son maître."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7bd38700-d437-4479-b5c4-06e0296548d1",
                                "sense_id": "376f4c8a-1854-382e-aa21-4aaabf04eb83",
                                "text": "Beaucoup de seigneurs autorisaient certains de leurs serfs à exercer dans les villes un métier quelconque, moyennant paiement d’une redevance ou obrok ; le serf pouvait parfois devenir ainsi plus riche que son seigneur, mais un caprice de celui-ci pouvait toujours le ramener au village."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "46e11a1f-7d85-4279-acf0-53fda21b5fda",
                        "source_entry_id": "97bfad0a-7ba7-3b6a-aa7c-47279b4bc996",
                        "source_sense_id": "376f4c8a-1854-382e-aa21-4aaabf04eb83",
