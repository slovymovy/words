                    },
                    {
                        "sense_id": "38d91ed3-711f-35fa-a4d6-855b88fa9505",
                        "entry_id": "1953c018-166b-3307-aadf-8f432d77b3db",
                        "glosses": [
                            "биол. принадлежащий к высшему типу животных, обладающий хордой или позвоночником"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "01139619-6c8b-4b99-91f6-12fee6d829e2",
                                "sense_id": "38d91ed3-711f-35fa-a4d6-855b88fa9505",
                                "text": "Самое название типа «полухордовые> оправдывается тем, что представители этой группы имеют признаки как хордовых, так и бесхордовых животных."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "94473b43-2a5e-4e41-a518-8e103b3b4c3f",
                        "source_entry_id": "1953c018-166b-3307-aadf-8f432d77b3db",
                        "source_sense_description": "связанный с хордой",
                        "target_lang_word": "chord",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chord",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0cf7d31f-09a5-351e-8202-4601b9f304a3",
                                        "entry_id": "48f1adbb-52d9-3935-9c0c-108d86971aad",
                                        "glosses": [
                                            "A harmonic set of three or more notes that is heard as if sounding simultaneously."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5dc95aeb-b42c-4b88-a3d7-b03dc2b897ed",
                                                "sense_id": "0cf7d31f-09a5-351e-8202-4601b9f304a3",
                                                "text": "He struck the opening chords of the passage; but this time Irene's voice was silent. Victor stopped in the middle of an arpeggio."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "13438959-737b-326d-a20f-42c1440f2970",
                                        "entry_id": "48f1adbb-52d9-3935-9c0c-108d86971aad",
                                        "glosses": [
                                            "A line segment between two points of a curve."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d81695fc-76b4-4c65-8ceb-c61c856ca99c",
                                                "sense_id": "13438959-737b-326d-a20f-42c1440f2970",
                                                "text": "The simplest method of calculating the radius of a curve in situ is to measure the versine; in railway practice this is done by extending a tape 66 ft. (1 ch.) long in a straight line or chord between two points on the periphery of a curve, and then measuring the maximum distance of the rail from the chord at the centre of the 66 ft. The radius in chains is found by dividing the versine in inches into 99. Thus if a versine measures 3 in., the radius will be 33 ch."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a463abd9-7bd5-3f1b-8a2e-4ece88af4460",
                                        "entry_id": "48f1adbb-52d9-3935-9c0c-108d86971aad",
                                        "glosses": [
                                            "A horizontal member of a truss."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "959e0547-a7a3-3666-b8fa-0d09d4985b19",
                                        "entry_id": "48f1adbb-52d9-3935-9c0c-108d86971aad",
                                        "glosses": [
                                            "A horizontal member of a truss.",
                                            "A section of subsidiary railway track that interconnects two primary tracks that cross at different levels, to permit traffic to flow between them."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8b89abad-0cf5-31b2-83ae-1b07309ad5d8",
                                        "entry_id": "48f1adbb-52d9-3935-9c0c-108d86971aad",
                                        "glosses": [
                                            "The distance between the leading and trailing edge of a wing, measured in the direction of the normal airflow."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fe7f571b-c7ef-3360-b6ee-cb46ca254de6",
                                        "entry_id": "48f1adbb-52d9-3935-9c0c-108d86971aad",
                                        "glosses": [
                                            "An imaginary line from the luff of a sail to its leech."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "449a8150-41c7-37be-b94c-2f72c68c5e4d",
                                        "entry_id": "48f1adbb-52d9-3935-9c0c-108d86971aad",
                                        "glosses": [
                                            "A keyboard shortcut that involves two or more distinct keypresses, such as Ctrl+M followed by P."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7fb93938-3e2d-4ca6-8426-2ab04798d222",
                                                "sense_id": "449a8150-41c7-37be-b94c-2f72c68c5e4d",
                                                "text": "Ctrl-K is the default first key for chords, but you can create chords using any keys that you want."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae053cbe-95d1-3394-8efd-b2a19def0ea9",
                                        "entry_id": "48f1adbb-52d9-3935-9c0c-108d86971aad",
                                        "glosses": [
                                            "The string of a musical instrument."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50394f29-9e09-4523-b0fd-c3d737d2f51b",
                                                "sense_id": "ae053cbe-95d1-3394-8efd-b2a19def0ea9",
                                                "text": "Instruments that made melodious Chime\nWas heard, of Harp and Organ; and who mov'd\nTheir Stops and Chords was seen"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "02db0bc1-a941-34ac-b0a8-d07422b3d642",
                                        "entry_id": "48f1adbb-52d9-3935-9c0c-108d86971aad",
                                        "glosses": [
                                            "A cord."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ccd196e7-766c-356b-866e-952763727f43",
                                        "entry_id": "48f1adbb-52d9-3935-9c0c-108d86971aad",
                                        "glosses": [
                                            "An edge that is not part of a cycle but connects two vertices of the cycle."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "chord",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4e89dbce-d47c-35b1-8af0-fcf385e2dd57",
                                        "entry_id": "079c39ac-1cf1-386a-bbd2-bdcaa785bcce",
                                        "glosses": [
                                            "To write chords for."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c681f25d-ef18-45d1-8fe2-114b8dcbb06d",
                                                "sense_id": "4e89dbce-d47c-35b1-8af0-fcf385e2dd57",
                                                "text": "This chording technique works well for learning any tune, but this is the only tune of the set that I will write out completely as a chorded version."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f48bfdc8-a563-38cb-a909-25eaedeb8237",
                                        "entry_id": "079c39ac-1cf1-386a-bbd2-bdcaa785bcce",
                                        "glosses": [
                                            "To accord; to harmonize together."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2dd42cfc-577b-4b01-878a-6f3c88d0ea0a",
                                                "sense_id": "f48bfdc8-a563-38cb-a909-25eaedeb8237",
                                                "text": "This note chords with that one."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8a1d28df-9853-301e-8809-cd8ab7e6c5a2",
                                        "entry_id": "079c39ac-1cf1-386a-bbd2-bdcaa785bcce",
                                        "glosses": [
                                            "To provide with musical chords or strings; to string; to tune."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e5ebdb9-304a-4cd5-8fc2-fa6c87318e6d",
                                                "sense_id": "8a1d28df-9853-301e-8809-cd8ab7e6c5a2",
                                                "text": "When Jubal struck the chorded shell."
                                            },
                                            {
                                                "example_id": "6e365b58-50b7-4313-9b5c-928749f693bb",
                                                "sense_id": "8a1d28df-9853-301e-8809-cd8ab7e6c5a2",
                                                "text": "Even the solitary old pine tree chords his harp."
                                            }
                                        ]
                                    }
                                ]
                            }
