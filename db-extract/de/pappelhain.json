                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c3a71f5-493f-45c1-bdc7-a15ce70a1bed",
                                "sense_id": "eee844b4-0a6f-392c-8960-e34feeb11798",
                                "text": "„In einem Pappelhain am anderen Flussufer, direkt hinter den Stadtmauern, schlugen sie ihr Lager auf; bei Einbruch der Dunkelheit zogen sie in kleinen Grüppchen durch die dunstigen Straßen.“"
                            },
                            {
                                "example_id": "ea54eee6-31ec-4b58-bf1e-97ddb327696c",
                                "sense_id": "eee844b4-0a6f-392c-8960-e34feeb11798",
                                "text": "„›Gehen Sie die Straße runter bis zum Bach, und unmittelbar bevor Sie zu dem Pappelhain kommen, biegen Sie links ab.‹“"
                            }
                        ],
                        "sense_index_json": "\"1\""
