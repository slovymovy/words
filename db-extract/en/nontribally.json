                        "glosses": [
                            "In a manner that is not tribal."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "9b5a23c0-4680-4ef5-973a-f326993b04d9",
                                "sense_id": "d07e80c4-675b-30fb-ae0a-ad8400d2732e",
                                "text": "Villages are of several different kinds depending upon the prevailing pattern of occupation and whether they are tribally or nontribally organized."
                            },
                            {
                                "example_id": "1ce0b0a9-b70b-43ca-842d-5d22638233ef",
                                "sense_id": "d07e80c4-675b-30fb-ae0a-ad8400d2732e",
                                "text": "Therefore, while nontribally identified Indians represent an interesting emergent American Indian ethnicity about which I will say more in subsequent chapters, such individuals do not appear to account for much of the recent Indian population growth."
                            },
                            {
                                "example_id": "aba41497-69e1-4c3d-b9a8-9e0d9f865c72",
                                "sense_id": "d07e80c4-675b-30fb-ae0a-ad8400d2732e",
                                "text": "Unions developed out of African miners' attempts to channel their grievances through nontribally based organizations, reflecting their growing consciousness of class and recognition of the weakness of mine-imposed types of organization based on rural models."
                            }
                        ]
