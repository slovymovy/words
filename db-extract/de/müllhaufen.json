                ],
                "senses": [
                    {
                        "sense_id": "012e6c3e-818d-3690-b1e7-f9f3ec6a4172",
                        "entry_id": "1fc6aab8-7f69-3cf2-a1c1-5a5575b40246",
                        "glosses": [
                            "ein Haufen aus Unrat"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "a61c9d93-3768-4f27-8e39-aadd1abd0325",
                                "sense_id": "012e6c3e-818d-3690-b1e7-f9f3ec6a4172",
                                "text": "Machen Sie den Müllhaufen Ihrer Familie von meinem liebevoll gepflegten englischen Rasen weg."
                            },
                            {
                                "example_id": "9d25b437-44a8-4770-aba2-e84b5e5d0fb4",
                                "sense_id": "012e6c3e-818d-3690-b1e7-f9f3ec6a4172",
                                "text": "Der Müllhaufen kann leicht zur Müllhalde werden, wenn er nicht regelmäßig entsorgt wird."
                            },
                            {
                                "example_id": "28afb542-d16c-4269-9c7d-e5e1e30d541e",
                                "sense_id": "012e6c3e-818d-3690-b1e7-f9f3ec6a4172",
                                "text": "„Ein Müllhaufen liegt vor uns.“"
                            },
                            {
                                "example_id": "74a76b61-fd31-4d23-8ffa-3549606ec22b",
                                "sense_id": "012e6c3e-818d-3690-b1e7-f9f3ec6a4172",
                                "text": "„Sie meinte, man hätte ihr Hausgerät und anderes Besitztum hier auf den Müllhaufen geworfen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
