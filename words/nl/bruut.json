{
    "word_family": [
        "brutaliteit",
        "brutaliseren",
        "brutaal"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "5ffdc0f5-5468-3245-b346-aa7ea9b53bb2",
                    "sense_definition": "Nietsontziend en gewelddadig; gekenmerkt door wreedheid.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "gewelddadig",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zelfs het <w>bruutste</w> optreden vermocht de opstand niet neer te slaan.",
                            "target_lang_translations": {
                                "en": "Even the <w>most brutal</w> action failed to crush the rebellion."
                            }
                        },
                        {
                            "text": "De politie maakte een einde aan het <w>brute</w> geweld op straat.",
                            "target_lang_translations": {
                                "en": "The police put an end to the <w>brutal</w> violence on the streets."
                            }
                        }
                    ],
                    "synonyms": [
                        "brutaal",
                        "wreed",
                        "gewelddadig"
                    ],
                    "antonyms": [
                        "zachtaardig",
                        "mild"
                    ],
                    "common_phrases": [
                        "bruut geweld"
                    ],
                    "target_lang_definitions": {
                        "en": "Ruthless and violent; characterized by cruelty."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "brutal",
                                "target_lang_sense_clarification": "savagely violent, vicious, or cruel"
                            },
                            {
                                "target_lang_word": "savage",
                                "target_lang_sense_clarification": "fierce, violent, and uncontrolled"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5fa30acf-4f9c-389a-a1d4-8ef49da1c3e7",
                    "sense_definition": "Ruw, onbeschaafd of grof in gedrag.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "onbeschaafd",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zijn <w>brute</w> manieren schrikten de gasten onmiddellijk af.",
                            "target_lang_translations": {
                                "en": "His <w>rude</w> manners immediately frightened the guests away."
                            }
                        },
                        {
                            "text": "Zij kon niet wennen aan zijn <w>brute</w> gedrag tijdens het diner.",
                            "target_lang_translations": {
                                "en": "She could not get used to his <w>coarse</w> behavior during dinner."
                            }
                        }
                    ],
                    "synonyms": [
                        "ruw",
                        "grof",
                        "onbeschaafd"
                    ],
                    "antonyms": [
                        "beschaafd",
                        "beleefd"
                    ],
                    "common_phrases": [
                        "brute manieren"
                    ],
                    "target_lang_definitions": {
                        "en": "Rough, uncivilized, or coarse in behavior."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "rude",
                                "target_lang_sense_clarification": "ill-mannered or discourteous"
                            },
                            {
                                "target_lang_word": "coarse",
                                "target_lang_sense_clarification": "rough or loose in texture or grain; rude or vulgar"
                            },
                            {
                                "target_lang_word": "brutish",
                                "target_lang_sense_clarification": "rough, crude, or insensitive"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "737dca7a-41e8-3cb3-8af3-8a04ec703963",
                    "sense_definition": "Iemand die nietsontziend en veelal gewelddadig optreedt.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "gewelddadig_persoon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die vent is een echte <w>bruut</w>.",
                            "target_lang_translations": {
                                "en": "That guy is a real <w>brute</w>."
                            }
                        },
                        {
                            "text": "Iedereen was bang voor de <w>bruut</w> die de buurt terroriseerde.",
                            "target_lang_translations": {
                                "en": "Everyone was afraid of the <w>thug</w> who was terrorizing the neighborhood."
                            }
                        }
                    ],
                    "synonyms": [
                        "beest",
                        "onmens",
                        "vandaal"
                    ],
                    "common_phrases": [
                        "een echte bruut"
                    ],
                    "target_lang_definitions": {
                        "en": "Someone who acts ruthlessly and often violently."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "brute",
                                "target_lang_sense_clarification": "a violently rough or insensitive person"
                            },
                            {
                                "target_lang_word": "thug",
                                "target_lang_sense_clarification": "a violent, aggressive, or criminal person"
                            },
                            {
                                "target_lang_word": "beast",
                                "target_lang_sense_clarification": "a brutal, savage, or uncivilized person"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}