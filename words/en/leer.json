{
    "word_family": [
        "leeringly"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "87533f46-f917-31a7-bd0a-2c4ee0adf170",
                    "sense_definition": "A sly or lecherous look, often expressing malice or sexual interest.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "look",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He gave her a <w>leer</w> that made her feel very uncomfortable.",
                            "target_lang_translations": {
                                "es": "Él le lanzó una <w>mirada lasciva</w> que la hizo sentir muy incómoda."
                            }
                        },
                        {
                            "text": "The villain watched the hero with a <w>leer</w> of pure malice.",
                            "target_lang_translations": {
                                "es": "El villano observó al héroe con una <w>mirada maliciosa</w> de pura maldad."
                            }
                        }
                    ],
                    "synonyms": [
                        "ogle"
                    ],
                    "common_phrases": [
                        "nasty leer",
                        "sickly leer"
                    ],
                    "target_lang_definitions": {
                        "es": "Una mirada astuta, lasciva o maliciosa."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "mirada lasciva",
                                "target_lang_sense_clarification": "referido a una mirada con intención sexual"
                            },
                            {
                                "target_lang_word": "mirada maliciosa",
                                "target_lang_sense_clarification": "referido a una mirada con intención de hacer daño"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "90859b1d-0110-39cc-bebe-e1aa80823c9f",
                    "sense_definition": "The cheek.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "body_part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tears rolled down his <w>leers</w> as he spoke.",
                            "target_lang_translations": {
                                "es": "Las lágrimas rodaban por sus <w>mejillas</w> mientras hablaba."
                            }
                        },
                        {
                            "text": "The old man wiped his <w>leers</w> with a handkerchief.",
                            "target_lang_translations": {
                                "es": "El anciano se secó las <w>mejillas</w> con un pañuelo."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This term is no longer used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "La mejilla (término arcaico)."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "mejilla",
                                "target_lang_sense_clarification": "término estándar para la parte de la cara"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "94af47a7-cb3e-39b3-ba16-9cad810a50cb",
                    "sense_definition": "To look at someone in a way that suggests sexual desire or malicious intent.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "look",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The stranger continued to <w>leer</w> at her from across the room.",
                            "target_lang_translations": {
                                "es": "El extraño continuó <w>mirándola lascivamente</w> desde el otro lado de la habitación."
                            }
                        },
                        {
                            "text": "He <w>leered</w> at the crowd with a <w>nasty</w> <w>leer</w> on his face.",
                            "target_lang_translations": {
                                "es": "Él <w>miró con malicia</w> a la multitud con una <w>mirada</w> desagradable en su rostro."
                            }
                        }
                    ],
                    "synonyms": [
                        "ogle"
                    ],
                    "common_phrases": [
                        "leer at"
                    ],
                    "target_lang_definitions": {
                        "es": "Mirar a alguien de forma lasciva o con intención maliciosa."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "mirar lascivamente",
                                "target_lang_sense_clarification": "mirar con deseo sexual"
                            },
                            {
                                "target_lang_word": "mirar con malicia",
                                "target_lang_sense_clarification": "mirar con intención de hacer daño"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b3525bf6-9be3-3d37-ac67-678644d110a2",
                    "sense_definition": "Empty or unoccupied.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "empty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The stable was <w>leer</w> after the horses were moved.",
                            "target_lang_translations": {
                                "es": "El establo estaba <w>vacío</w> después de que movieran a los caballos."
                            }
                        },
                        {
                            "text": "He left the house <w>leer</w> and moved to the city.",
                            "target_lang_translations": {
                                "es": "Dejó la casa <w>vacía</w> y se mudó a la ciudad."
                            }
                        }
                    ],
                    "synonyms": [
                        "empty",
                        "vacant",
                        "void"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This usage is obsolete in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Vacío o desocupado (término obsoleto)."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "vacío",
                                "target_lang_sense_clarification": "sin nada dentro"
                            },
                            {
                                "target_lang_word": "desocupado",
                                "target_lang_sense_clarification": "sin personas o cosas"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
