                        ],
                        "form": "die Tupí-Sprache"
                    },
                    {
                        "form_id": "86dcb14f-1392-41bd-b4df-003289d35160",
                        "entry_id": "cff077eb-1615-3ca6-8ecd-a3c9bb2d5290",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Tupí-Sprachen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e43ca8e0-4295-3b5c-a8ae-96ee399527bd",
                        "entry_id": "cff077eb-1615-3ca6-8ecd-a3c9bb2d5290",
                        "glosses": [
                            "eine Sprachfamilie südamerikanischer Ureinwohner"
                        ],
                        "tags": [
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "7554d30d-8c7c-4fe5-adb5-49255ac1d4bc",
                                "sense_id": "e43ca8e0-4295-3b5c-a8ae-96ee399527bd",
                                "text": "„Die Tupí-Sprachen werden gegenwärtig von mehreren Millionen Menschen gesprochen, die Verbreitung der einzelnen Zweige und Sprachen ist jedoch sehr ungleichmäßig.“"
                            },
                            {
                                "example_id": "62ecdc47-1ceb-47d7-a195-b133f785f6a3",
                                "sense_id": "e43ca8e0-4295-3b5c-a8ae-96ee399527bd",
                                "text": "„Die Tupi-Lingua geral wurde von den Jesuiten verwendet, um sich mit den Indios zu verständigen, und galt bisher als Derivat der Tupi-Sprachen Brasiliens.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a992d2f5-e2fb-326e-953e-395ccda0c29e",
                        "entry_id": "cff077eb-1615-3ca6-8ecd-a3c9bb2d5290",
                        "glosses": [
                            "Sprache, die Vertreter dieser Sprachfamilie ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0a477e7-97e5-40d8-8141-8cd204d22a35",
                                "sense_id": "a992d2f5-e2fb-326e-953e-395ccda0c29e",
                                "text": "„Um dies zu untersuchen wurde das vorhandene Material mit Guaraní […] sowie einer Tupí-Sprache vom Mutum Paraná bzw. Jamary verglichen, die im übrigen zur Sprache der […]“"
                            },
                            {
                                "example_id": "fb1a07f5-649b-42a5-8a68-f7d51798df15",
                                "sense_id": "a992d2f5-e2fb-326e-953e-395ccda0c29e",
                                "text": "„Auf jeden Fall sprechen sie eine Tupí-Sprache, wie ein Vergleich […]“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "4dc89056-a999-34ae-be02-2348e04446ab",
                        "entry_id": "cff077eb-1615-3ca6-8ecd-a3c9bb2d5290",
                        "glosses": [
                            "von der gleichnamigen Sprachfamilie abgeleitete südamerikanische Verkehrssprache"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "abc8b4e8-149a-4e68-8b64-ea463b7bbd68",
                                "sense_id": "4dc89056-a999-34ae-be02-2348e04446ab",
                                "text": "„Zu den ersten Geistlichen, die in der Tupí-Sprache predigten, gehörte João de Azpilcueta Navarro, der bereits mit Nóbrega nach Brasilien gekommen war und mehrere Reisen ins Hinterland unternahm.“"
                            },
                            {
                                "example_id": "001aebb7-0276-4cbc-abfb-3940abaa0f78",
                                "sense_id": "4dc89056-a999-34ae-be02-2348e04446ab",
                                "text": "„Es giebt selbst ein Genus einer kletternden Palme (Desmoncus), in der Tupí-Sprache Jacitara genannt.“"
                            },
                            {
                                "example_id": "63700d93-fd1e-464e-b48b-6008fa100737",
                                "sense_id": "4dc89056-a999-34ae-be02-2348e04446ab",
                                "text": "„Auch die frühesten Untersuchungsreisen, die auf Befehl der Regierung ausgeführt wurden, standen oft unter der Leitung von Männern ohne literarische Bildung oder von Solchen, die der Tupí-Sprache in ihrer Reinheit und mit grammatikalischer Sachkenntnis keineswegs mächtig waren.“"
                            },
                            {
                                "example_id": "65098386-591d-429a-a1b9-02feab4bd1c3",
                                "sense_id": "4dc89056-a999-34ae-be02-2348e04446ab",
                                "text": "„Sie erstrecken sich über die Tupi-Sprache und verschiedene Dialekte derselben[…]“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
