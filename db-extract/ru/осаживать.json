                        "entry_id": "91547186-0a63-33f4-9a7e-71ec035b2436",
                        "glosses": [
                            "разг. силой заставлять попятиться, отойти назад"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "1aa47494-6594-3283-bfdc-f77053907745",
