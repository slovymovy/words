                        "glosses": [
                            "Variante de auberonnière."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "a4d9253e-c269-4c99-9905-c0ac8f6cb87e",
                                "sense_id": "595db995-a5a3-3f24-889a-0d5fd79f97d7",
                                "text": "En position de fermeture, le pêne s’engage dans une gâche. Il peut être manoeuvré par un bouton droit ou coudé, une poignée, une ballotière ou un moraillon; celui-ci est doté d’un auberon qui s’engage dans l’auberonnière d'une serrure; dans ce cas, l’ensemble constitue une serrure à bosse,.."
                            },
                            {
                                "example_id": "ab0d6f62-9e0a-4063-a25a-01056cff5c10",
                                "sense_id": "595db995-a5a3-3f24-889a-0d5fd79f97d7",
                                "text": "Elle ne peut être prise, ce me semble, que pour un auberon ou une auberonière, qui, tenant à la couverture d’un coffre, se rabat lorsqu’on veut le fermer, et reçoit dans son anneau la pêle ou le pêne de la serrure qui doit le retenir."
                            }
                        ]
                    }
