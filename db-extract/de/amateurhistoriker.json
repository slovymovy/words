                "senses": [
                    {
                        "sense_id": "f55b2309-f0be-3cb6-83f2-33968fad9893",
                        "entry_id": "031f4f0c-6881-3672-9807-0a6e1c6f9ee5",
                        "glosses": [
                            "Person, die sich mit Geschichte nicht beruflich, sondern rein interessehalber (als Hobby) befasst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c724bcc-a03e-4e53-ab74-e07e8310580a",
                                "sense_id": "f55b2309-f0be-3cb6-83f2-33968fad9893",
                                "text": "„In den letzten Jahre erschienen zahlreiche, oft von Amateurhistorikern verfasste Studien über alliierte Bombenangriffe auf einzelne Städte oder Regionen.“"
                            },
                            {
                                "example_id": "fbfa7012-4192-4021-8199-e9a7643a1245",
                                "sense_id": "f55b2309-f0be-3cb6-83f2-33968fad9893",
                                "text": "„Nicht zuletzt deshalb haben Generationen von Fach- und Amateurhistorikern versucht, Hitlers apokalyptisches Wirken in der Geschichte zu erklären.“"
                            },
                            {
                                "example_id": "375528c2-a638-4e00-a2f7-9fad4b2e3dce",
                                "sense_id": "f55b2309-f0be-3cb6-83f2-33968fad9893",
                                "text": "„Sie wussten nur zu gut, dass ich als Amateurhistoriker mit Streckbank, Rad, Eiserner Jungfrau und dergleichen vertraut war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
