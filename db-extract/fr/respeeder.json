                "senses": [
                    {
                        "sense_id": "fc2cb8a2-e5d2-3594-afb0-d3d12330180d",
                        "entry_id": "c7c0bb61-32e8-3124-9d79-667f30075d83",
                        "glosses": [
                            "Speeder à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5364982-2963-42a1-a693-6843c080bc0f",
                                "sense_id": "fc2cb8a2-e5d2-3594-afb0-d3d12330180d",
                                "text": "Je viens de finir le jeu en normal et je me sens pas du tout de respeeder au travers des niveaux pour trois pauvres items."
                            },
                            {
                                "example_id": "cebef8f0-13eb-40b4-8178-1bab6a0b93db",
                                "sense_id": "fc2cb8a2-e5d2-3594-afb0-d3d12330180d",
                                "text": "Ne prends pas d'autres drogues pour équilibrer les effets, par exemple pour te respeeder pour aller bosser…"
                            },
                            {
                                "example_id": "45f0413e-afca-43f7-b79f-c719453f5bfb",
                                "sense_id": "fc2cb8a2-e5d2-3594-afb0-d3d12330180d",
                                "text": "Non, je vais pas m'en prendre à elle, mais je vais peut-être respeeder de l'orteil."
                            },
                            {
                                "example_id": "ffe8c5fc-7764-4589-ae91-3fef605f71b0",
                                "sense_id": "fc2cb8a2-e5d2-3594-afb0-d3d12330180d",
                                "text": "Putain, speeder le matin, mettre mon gamin à la périscolaire, respeeder sur le périph pour arriver à l'heure au boulot et là découvrir que je commençais que deux heures plus tard,ça m'éneeeeeeeeeeeeeeeeerve !!!!"
                            }
                        ]
                    }
