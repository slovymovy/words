                        "sense_id": "57b21db6-ccaa-3dbe-84d3-f87d518b1233",
                        "entry_id": "b5d6b1fe-ba92-3e0f-9217-3098b8e09dc4",
                        "glosses": [
                            "osoba lub instytucja zajmująca się dostarczaniem towarów lub usług dla klientów"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12db27d9-21e6-4af5-b7d0-dae80ed1bda5",
                                "sense_id": "57b21db6-ccaa-3dbe-84d3-f87d518b1233",
                                "text": "Ze względu na nadmierne koszty nasz dostawca miodu wycofał się z interesu."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
