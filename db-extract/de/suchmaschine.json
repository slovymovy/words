                        "form": "die Suchmaschinen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d50ed260-60fe-30ce-a1e7-b19f2dad0f1b",
                        "entry_id": "3332f22a-1f43-30ec-87cb-afb271723662",
                        "glosses": [
                            "Computerprogramm zur Recherche von Dokumenten oder Dateien, die auf einem Computer oder in einem Computernetzwerk gespeichert sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33f9a234-cd64-4e8e-a497-f384c9b138ac",
                                "sense_id": "d50ed260-60fe-30ce-a1e7-b19f2dad0f1b",
                                "text": "Google ist die beliebteste Suchmaschine."
                            },
                            {
                                "example_id": "ffebdfc5-9a3f-406b-9b00-1a0596a16455",
                                "sense_id": "d50ed260-60fe-30ce-a1e7-b19f2dad0f1b",
                                "text": "„Warum gab es nach Google keine relevante Suchmaschine mehr?“"
                            },
                            {
                                "example_id": "59d399c5-ba6f-4caa-9015-5531c05549a6",
                                "sense_id": "d50ed260-60fe-30ce-a1e7-b19f2dad0f1b",
                                "text": "Nur ein Bruchteil der Internetseiten kann mit Suchmaschinen gefunden werden."
                            },
                            {
                                "example_id": "bb2f14e5-6882-4684-bc26-52d813032ed2",
                                "sense_id": "d50ed260-60fe-30ce-a1e7-b19f2dad0f1b",
                                "text": "Diese Suchmaschine durchsucht meine eigenen, auf diesem Computer gespeicherte Dateien."
                            },
                            {
                                "example_id": "984a8840-57d4-4643-bbdb-705c3e80103c",
                                "sense_id": "d50ed260-60fe-30ce-a1e7-b19f2dad0f1b",
                                "text": "„Wissenschaftler und sonst wie Berufene lassen Guttenbergs Dissertation durch Suchmaschinen laufen und vermelden die Ergebnisse auf der Homepage GuttenPlag Wiki.“"
                            },
                            {
                                "example_id": "c75f1a38-1dde-44d3-903d-482c6780c811",
                                "sense_id": "d50ed260-60fe-30ce-a1e7-b19f2dad0f1b",
                                "text": "„Die Suchmaschine kennt meine Präferenzen - Katastrophen zuerst.“"
                            },
                            {
                                "example_id": "98c12f06-36df-453e-b860-7e51281d2935",
                                "sense_id": "d50ed260-60fe-30ce-a1e7-b19f2dad0f1b",
                                "text": "„Alles wissen diese Suchmaschinen also auch nicht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1d1f8ea0-fe70-48a2-9548-97eeda9da097",
                        "source_entry_id": "3332f22a-1f43-30ec-87cb-afb271723662",
                        "source_sense_id": "d50ed260-60fe-30ce-a1e7-b19f2dad0f1b",
                        "target_lang_word": "search engine",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "search engine",
