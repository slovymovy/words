                    {
                        "sense_id": "4efdc57a-961f-3989-9515-04c507d5486a",
                        "entry_id": "3b0508d7-0dde-3ef0-84d4-7e5bfab2044c",
                        "glosses": [
                            "единица измерения площади, равная 10 000 квадратных метров"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff0a7f7e-d2d7-458d-9449-15def28ff897",
                                "sense_id": "4efdc57a-961f-3989-9515-04c507d5486a",
                                "text": "Квадрат, длина стороны которого равна 100 м (гектометр), называют гектаром."
                            }
                        ]
                    },
                    {
                        "sense_id": "b1fb9c21-69a8-30bd-b15e-1814dc2d8a1d",
                        "entry_id": "3b0508d7-0dde-3ef0-84d4-7e5bfab2044c",
                        "glosses": [
                            "комп. жарг. гигабайт"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f5e7b720-4bf7-4563-92c1-03dd3bb0493a",
                        "source_entry_id": "3b0508d7-0dde-3ef0-84d4-7e5bfab2044c",
                        "target_lang_word": "hectare",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hectare",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "850e68c6-0d07-30b8-a85e-cb1be4ef3700",
                                        "entry_id": "40d2e494-0afc-3cab-a8b7-6288d2c3aaea",
                                        "glosses": [
                                            "A unit of surface area (symbol ㏊) equal to 100 ares (that is, 10,000 square metres, one hundredth of a square kilometre, or approximately 2.5 acres), used for measuring the areas of geographical features such as land and bodies of water."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2dcb1a0-7db6-47f1-9da9-f6dcb4cf9ad1",
                                                "sense_id": "850e68c6-0d07-30b8-a85e-cb1be4ef3700",
                                                "text": "With careful planning almost anyone can turn the dream of owning a small farm or a few hectares of country land into a reality."
                                            },
                                            {
                                                "example_id": "f4931e24-d29c-4956-ac71-c00a9bd0efd5",
                                                "sense_id": "850e68c6-0d07-30b8-a85e-cb1be4ef3700",
                                                "text": "One hectare (about 2.5 acres) of forest cleared and converted to ranchland or crops produces a piece of land worth, on average, $200 to $500."
                                            },
                                            {
                                                "example_id": "f3cb02b7-430c-44ae-9807-2593a28ccdbd",
                                                "sense_id": "850e68c6-0d07-30b8-a85e-cb1be4ef3700",
                                                "text": "Last year 1m square metres of plant-covered roofing was built in France, as much as in the US, and 10 times more than in Germany, the pioneer in this field. In Paris 22 hectares of roof have been planted, out of a potential total of 80 hectares."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6e2a4a9c-c2b7-49b3-93ec-b75b6d7368e8",
                        "source_entry_id": "3b0508d7-0dde-3ef0-84d4-7e5bfab2044c",
                        "target_lang_word": "hectárea",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hectárea",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "0087558b-1dd1-3220-ac5d-049ece43c2a1",
                                        "entry_id": "6776d593-0fcc-378b-b0da-3c9150c23a42",
                                        "glosses": [
                                            "Unidad de medida de superficie, usada únicamente para el terreno, equivalente a 10.000 metros cuadrados."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e434acb2-3bcc-4661-be8d-a97432ec1544",
                        "source_entry_id": "3b0508d7-0dde-3ef0-84d4-7e5bfab2044c",
                        "target_lang_word": "ettaro",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ettaro",
                                "target_lang_code": "it",
                                "target_senses": [
                                    {
                                        "sense_id": "33e67365-718a-3b48-9b27-912e65e98620",
                                        "entry_id": "04edea4a-c904-3ec0-aca2-0b5aa767638c",
                                        "glosses": [
                                            "superficie coltivabile pari all'area di un quadrato di lato di cento metri"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "22441ec0-04be-4e1e-8484-e4074775e0a0",
                        "source_entry_id": "3b0508d7-0dde-3ef0-84d4-7e5bfab2044c",
                        "target_lang_word": "Hektar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hektar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "73af3b96-e45d-317f-9487-837b3c4394bc",
                                        "entry_id": "83cef08b-323c-3736-aaaa-249012798e96",
                                        "glosses": [
                                            "Flächenmaß, das 100 Ar oder 10 000 Quadratmetern entspricht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93b8fa75-d218-4e30-a2de-696dc570f464",
                                                "sense_id": "73af3b96-e45d-317f-9487-837b3c4394bc",
                                                "text": "Sie wollte dasselbe und fünfhundert Hektar des umliegenden Landes bis zu ihrem Lebensende für sich behalten. (Max Eyth: Der Tartarenrebell hinter dem Dampfpflug)"
                                            },
                                            {
                                                "example_id": "6cee6fa9-b2fd-4700-8406-4db31dc04fc5",
                                                "sense_id": "73af3b96-e45d-317f-9487-837b3c4394bc",
                                                "text": "„Neben den handelsüblichen sächsischen Weinen bietet er eine selbstgekelterte Hausmarke an, die auf seinem etwa einen Hektar großen Weinberg gleich hinter seinem Gasthof reift.“"
                                            },
                                            {
                                                "example_id": "ca249e60-32af-44dc-8e4e-882fa72cd9e3",
                                                "sense_id": "73af3b96-e45d-317f-9487-837b3c4394bc",
                                                "text": "„Die Artenvielfalt soll hier auf einem Hektar höher sein als in ganz Europa.“"
                                            },
                                            {
                                                "example_id": "aed17d8d-c8d7-48f3-84b8-adb1fd1ca617",
                                                "sense_id": "73af3b96-e45d-317f-9487-837b3c4394bc",
                                                "text": "„Es bestehe aus einem Pachthof von achtunddreißig Hektar mit einer Art Schloß und einem sehr ertragreichen Garten.“"
                                            },
                                            {
                                                "example_id": "d3d32c1b-6460-44bd-8611-f1e253bc5b0b",
                                                "sense_id": "73af3b96-e45d-317f-9487-837b3c4394bc",
                                                "text": "„Der Stablack ist eine weitläufige, hügelige Landschaft, in die hinein zehn Jahre zuvor, 1934, ein riesiger Truppenübungsplatz mit einer Fläche von 10000 Hektar gebaut worden war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "974afb59-d145-438d-8373-64e49e7560b4",
                        "source_entry_id": "3b0508d7-0dde-3ef0-84d4-7e5bfab2044c",
                        "target_lang_word": "hectare",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hectare",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "e5856ade-d27e-396a-beab-c86a48b6dcc7",
                                        "entry_id": "0e89fc8c-69cd-3f56-a477-e14b700351f1",
                                        "glosses": [
                                            "een oppervlaktemaat ter grootte van 100 m × 100 meter, gelijk aan 10.000 m², gelijk aan één vierkante hectometer, gelijk aan 0,1 × 0,1 kilometer, gelijk aan 0,01 km², weergegeven met symbool ha"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "743bfd5f-7083-4462-8d9d-4d6f0015ede8",
                                                "sense_id": "e5856ade-d27e-396a-beab-c86a48b6dcc7",
                                                "text": "Een hectare bestaat uit honderd aren."
                                            },
                                            {
                                                "example_id": "2179eab8-ef49-465e-9760-49e05b18250c",
                                                "sense_id": "e5856ade-d27e-396a-beab-c86a48b6dcc7",
                                                "text": "De brandweer in Frankrijk heeft zaterdag een zeer grote bosbrand in de zuidelijke streek de Cevennen onder controle gebracht. Het vuur verspreidt zich niet meer, maar beslaat nog wel een gebied van 650 hectare."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
