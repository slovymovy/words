                        "entry_id": "bb52a08c-e220-3a76-bc10-b7ada82623d1",
                        "glosses": [
                            "mythologisch eiland dat in de zee zou zijn gezonken\\nTraditioneel wordt dit eiland meestal gesitueerd ten westen van Europa en Afrika"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19a3a95a-c15e-4905-a2ed-e79abb771afb",
                                "sense_id": "fe4e61f8-26a8-3e1f-8448-70771f11faac",
                                "text": "Over Atlantis doen vele verhalen de ronde."
                            },
                            {
                                "example_id": "631cde0b-218a-4ad6-9127-c0f60b53e7d0",
                                "sense_id": "fe4e61f8-26a8-3e1f-8448-70771f11faac",
                                "text": "Zal onze beschaving wegzinken onder de zeespiegel, zoals Atlantis ooit verdween?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f6d5aaf7-7cb3-4ed8-8702-ea70aa853236",
