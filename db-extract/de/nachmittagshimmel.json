                "senses": [
                    {
                        "sense_id": "cb25c67b-cdd2-369c-907a-b2abadfd624b",
                        "entry_id": "64df9645-9db0-3611-adfe-9fb126a3a399",
                        "glosses": [
                            "Anblick des Himmels am Nachmittag"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9dd0d079-321b-40c6-b805-a5054d5ed3ea",
                                "sense_id": "cb25c67b-cdd2-369c-907a-b2abadfd624b",
                                "text": "„Als Pilot trug er große Verantwortung und hatte eine Menge Pflichten an Bord zu erledigen, aber zum jetzigen Zeitpunkt, nach sieben Stunden seines Neun-Stunden-Flugs von Neu-Delhi nach Frankfurt, hatten er und sein Kopilot kaum mehr zu tun, als wach zu bleiben, die Bordsysteme im Blick zu behalten und hinaus in den Nachmittagshimmel zu glotzen.“"
                            },
                            {
                                "example_id": "aa13c633-2d39-4d16-bfb8-6085819dc27e",
                                "sense_id": "cb25c67b-cdd2-369c-907a-b2abadfd624b",
                                "text": "„Miller zeigte nach vorn; der Trail stieg weiter steil bis zu einer Stelle zwischen zwei buckligen Berggipfeln an, die sich düster und scharf umrissen vom hellen Nachmittagshimmel abhoben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
