                "translations": [
                    {
                        "translation_id": "22cdf5ff-2a3b-447a-9a2d-a9f0b737db29",
                        "source_entry_id": "67d0749a-eaf9-32e4-9172-7960df99d798",
                        "source_sense_id": "d4dfc807-08ec-31b3-97e8-e55295806f1e",
                        "target_lang_word": "kippah",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kippah",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "333868f3-a09a-3cd7-b89c-33be4ed25c1c",
                                        "entry_id": "572ec7cc-7bca-3bc9-9af5-4b6c2b14e5d7",
                                        "glosses": [
                                            "The cloth skullcap or yarmulke traditionally worn by male Jews."
                                        ],
                                        "tags": [
                                            "Judaism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de8125a4-d10e-42eb-9dd7-3bf76f4b3f7a",
                                                "sense_id": "333868f3-a09a-3cd7-b89c-33be4ed25c1c",
                                                "text": "In response, Germany’s most popular daily newspaper asked readers to wear the cut-out kippah as a mark of solidarity with the Jewish community, and even posted a video on its website showing how to make it."
                                            },
                                            {
                                                "example_id": "f9de6e04-19b6-4765-9293-0c587b37aed8",
                                                "sense_id": "333868f3-a09a-3cd7-b89c-33be4ed25c1c",
                                                "text": "Some Jewish Americans told CNN they are now hiding their kippahs, refusing to wear their Star of David necklaces and changing long-held traditions for religious holidays."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b3ac851c-6508-428d-a9a9-d7ac85765806",
                        "source_entry_id": "67d0749a-eaf9-32e4-9172-7960df99d798",
                        "source_sense_id": "d4dfc807-08ec-31b3-97e8-e55295806f1e",
                        "target_lang_word": "kipa",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "60fccb8b-7ff6-4d89-b7d1-90e5160ebff9",
                        "source_entry_id": "67d0749a-eaf9-32e4-9172-7960df99d798",
                        "source_sense_id": "d4dfc807-08ec-31b3-97e8-e55295806f1e",
                        "target_lang_word": "jarmulka",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "4cbe54d9-c27c-46da-80ee-86c9609c24b9",
                        "source_entry_id": "67d0749a-eaf9-32e4-9172-7960df99d798",
                        "source_sense_id": "d4dfc807-08ec-31b3-97e8-e55295806f1e",
                        "target_lang_word": "Kippa",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kippa",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1048a269-be6c-3193-90f6-4e6f8c0d1914",
                                        "entry_id": "4f406d14-59f1-3da0-93b4-a4019e126b6d",
                                        "glosses": [
                                            "eine den Hinterkopf bedeckende, mit einer Klammer an den Haaren fixierte, flache Kopfbedeckung, die vor allem während religiöser Rituale (aus Ehrfurcht vor Gott) zumeist von männlichen, zuweilen aber auch von weiblichen Juden getragen wird"
                                        ],
                                        "tags": [
                                            "jüdische Religion"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "95f8bbf0-3726-4c35-900e-51cdc18e158b",
                                                "sense_id": "1048a269-be6c-3193-90f6-4e6f8c0d1914",
                                                "text": "„Traditionell tragen jüdische Männer und Jungen ständig eine Kippa, als eine Art Symbol ihrer E[h]rfurcht und Demut gegenüber einem ‚höheren‘ Wesen.“"
                                            },
                                            {
                                                "example_id": "7530257a-94c6-4018-9e3b-598da6f11b33",
                                                "sense_id": "1048a269-be6c-3193-90f6-4e6f8c0d1914",
                                                "text": "„Besonders stolz sei sie, dass auch Muslime dabei sind, etwa Diplomatenkinder aus arabischen Ländern, und dass sich hier Kippa und Kopftuch gut vertragen.“"
                                            },
                                            {
                                                "example_id": "73b3b675-c11f-4c2f-b076-7b4f47154ac1",
                                                "sense_id": "1048a269-be6c-3193-90f6-4e6f8c0d1914",
                                                "text": "„Über 60 Jahre nach dem Holocaust ist auch das ein Stück Normalität: Mit Kippa und Uniform leisten Juden in der Bundeswehr ihren Wehrdienst.“"
                                            },
                                            {
                                                "example_id": "b9410404-863a-4574-b36a-fd4d707dd1b0",
                                                "sense_id": "1048a269-be6c-3193-90f6-4e6f8c0d1914",
                                                "text": "„Die Staatskanzlei in Düsseldorf hatte sich kurz zuvor mit einem Kontingent Kippot bei dem Versandhändler aus Berlin-Kreuzberg eingedeckt.“"
                                            },
                                            {
                                                "example_id": "3f5b0959-8a08-44cd-8bef-d9cdf9e7539d",
                                                "sense_id": "1048a269-be6c-3193-90f6-4e6f8c0d1914",
                                                "text": "„Im Unterschied zur vier-paneligen Kippa der Juden sind die katholischen Käppis aus sechs oder acht Kreissegmenten gefertigt.“"
                                            },
                                            {
                                                "example_id": "384e1318-fb27-4514-9a5c-1ca46b61d859",
                                                "sense_id": "1048a269-be6c-3193-90f6-4e6f8c0d1914",
                                                "text": "„Der Tel Aviv-Stürmer Itay Schechter zieht nach seinem Tor in der Champions League seine Kippa aus dem Stutzen, betet – und sieht Gelb.“"
                                            },
                                            {
                                                "example_id": "5a82b022-5ad1-4f5b-8b55-344dbb566f0d",
                                                "sense_id": "1048a269-be6c-3193-90f6-4e6f8c0d1914",
                                                "text": "„Dass die Kranzschleife des Generalinspekteurs ein Eisernes Kreuz zierte und dass Verteidigungsminister zu Guttenberg die traditionelle Kippa trug, hat für Hauptmann Berger symbolische Bedeutung:[…]“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
