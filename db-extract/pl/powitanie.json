                    {
                        "translation_id": "69f882c9-d26a-443d-b549-251cf54a5b23",
                        "source_entry_id": "966d5795-b8d4-31ad-9cd1-937ed3c692a4",
                        "source_sense_id": "dd128057-0c89-31a6-a8cc-a659f3129782",
                        "target_lang_word": "Begrüßung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Begrüßung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "084b3405-15b2-39b6-b1a2-f6f18e10e81d",
                                        "entry_id": "174bdb5c-3cbf-3aa6-b346-8b629ef84bbe",
                                        "glosses": [
                                            "Ritual (Wörter und/oder Gesten), um einer Person Respekt zu erweisen und sie willkommen zu heißen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58fff8a3-0d32-4914-9246-e99cb1ff5208",
                                                "sense_id": "084b3405-15b2-39b6-b1a2-f6f18e10e81d",
                                                "text": "Zur Begrüßung wird in manchen Ländern die Hand zum Schütteln gereicht, in einigen anderen Länder hingegen ist die Begrüßung eine Verbeugung."
                                            },
                                            {
                                                "example_id": "4fe5f811-933b-492c-ab06-d398918b8701",
                                                "sense_id": "084b3405-15b2-39b6-b1a2-f6f18e10e81d",
                                                "text": "Zur Begrüßung küsste Eva ihn auf die Wangen."
                                            },
                                            {
                                                "example_id": "dd1b5101-5c6d-4323-bd20-752800e912be",
                                                "sense_id": "084b3405-15b2-39b6-b1a2-f6f18e10e81d",
                                                "text": "Zur Begrüßung erhielt jeder Gast ein Glas Sekt."
                                            },
                                            {
                                                "example_id": "e9823750-53fc-48cc-b4bd-30cca713661d",
                                                "sense_id": "084b3405-15b2-39b6-b1a2-f6f18e10e81d",
                                                "text": "„Danach klopfte er mit seinem Bambusstock, den er bei der Begrüßung wie ein englischer Offizier unter dem Arm hielt, auf sein Pult.“"
                                            },
                                            {
                                                "example_id": "dfff091e-67ca-4565-a795-ea9208f2b259",
                                                "sense_id": "084b3405-15b2-39b6-b1a2-f6f18e10e81d",
                                                "text": "„Elma lächelte instinktiv zurück, als er ihr zur Begrüßung die Hand reichte und sich vorstellte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
