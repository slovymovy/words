                        "examples": [
                            {
                                "example_id": "76aa63e4-7d28-419e-b6c9-8432adeec102",
                                "sense_id": "0afd4bac-3094-3779-8a85-fab426d5a26e",
                                "text": "Philippe Colombel, codirigeant de Partech, était l’invité de Sébastien Couasnon dans Tech & Co, ce lundi 11 mai."
                            },
                            {
                                "example_id": "2ff178c1-3281-4291-8456-361a38d5f312",
                                "sense_id": "0afd4bac-3094-3779-8a85-fab426d5a26e",
                                "text": "À terme, les codirigeants aimeraient utiliser jusqu’à huit types de matériaux différents."
                            },
                            {
                                "example_id": "b61bd485-02c5-47f8-901f-e3f1dd349ee9",
                                "sense_id": "0afd4bac-3094-3779-8a85-fab426d5a26e",
                                "text": "Nous poursuivons la présentation de l’équipe Pouliquen par celle de son capitaine, Gérard Quillévéré, codirigeant de l’entreprise depuis 2018."
                            }
                        ]
