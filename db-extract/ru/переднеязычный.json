                                "target_senses": [
                                    {
                                        "sense_id": "822ae2b1-56ed-39ca-b31f-2d8265715796",
                                        "entry_id": "26af3aed-d2d5-3820-8cc8-b4f963833d7d",
                                        "glosses": [
                                            "Variante orthographique de prélingual."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d2726ac-a363-471d-8d77-4beeb7191bda",
                                                "sense_id": "822ae2b1-56ed-39ca-b31f-2d8265715796",
                                                "text": "Le cerveau du sujet sourd pré-lingual se sera entre-temps réorganisé et du fait de la surdité prolongée, le réseau auditif traitera d'autres informations limitant fortement les aires auditives dans la récupération de leurs fonctions initiales."
                                            },
                                            {
                                                "example_id": "09a69668-cf21-4278-ac5b-3b509880f4ec",
                                                "sense_id": "822ae2b1-56ed-39ca-b31f-2d8265715796",
                                                "text": "Les surdités unilatérales les plus pourvoyeuses de troubles sont celles de type pré-lingual et de niveau profond."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
