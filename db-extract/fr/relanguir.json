                "senses": [
                    {
                        "sense_id": "a12bd831-9d38-3f86-bffb-75d6f5061374",
                        "entry_id": "420eba75-58ef-3a73-b877-81fc1056e0fd",
                        "glosses": [
                            "Languir à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "229d9126-b41d-42f6-96e2-fc1b01238814",
                                "sense_id": "a12bd831-9d38-3f86-bffb-75d6f5061374",
                                "text": "Jamais, hélas! jamais, soupirant je m'écrie, Me sentirai-je atteint d'un si grand coup d'amour Que sans plus relanguir, je finirai ma vie."
                            },
                            {
                                "example_id": "48c6a3a0-7b87-44d4-96d9-7f2d616ba694",
                                "sense_id": "a12bd831-9d38-3f86-bffb-75d6f5061374",
                                "text": "Et ma creinte est une rude furie, Qui, au milieu de si douce ambrosie, Me fet languir et relanguir de faim."
                            }
                        ]
                    }
                ],
