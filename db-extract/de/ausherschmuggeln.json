                        "cross_references": [
                            {
                                "target_word": "herausschmuggeln",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "99a1cb2c-7c0b-32f4-a4cf-3f576e907cb2",
                                        "entry_id": "de5af6ea-3cf5-3b9f-9f57-f6ecab131fd5",
                                        "glosses": [
                                            "aus einem Land, Gebäude oder Ähnlichem heimlich und unerlaubt herausbringen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d57c5f4-fb61-4f4b-8d05-dabdbae7d4ba",
                                                "sense_id": "99a1cb2c-7c0b-32f4-a4cf-3f576e907cb2",
                                                "text": "„Der Kassiber konnte im Februar 1945 herausgeschmuggelt werden aus dem Gestapo-Hauptgefängnis, wo Dohnanyi, angeklagt wegen Hochverrats, gefangen gehalten wurde.“"
                                            },
                                            {
                                                "example_id": "cb65ac13-1485-477a-b911-6d2496db6f05",
                                                "sense_id": "99a1cb2c-7c0b-32f4-a4cf-3f576e907cb2",
                                                "text": "„Sie konnten Akten vernichten, verstellen oder herausschmuggeln, denn sie hatten als Wachschützer, als Archivare, als Magazinmitarbeiter oder als Rechercheure zum Teil ungehinderten und unbeaufsichtigten Zugang zu erschlossenem, aber auch zu unerschlossenem Material.“"
                                            },
                                            {
                                                "example_id": "61133a58-feba-43bb-a79f-b81b0cba54b9",
                                                "sense_id": "99a1cb2c-7c0b-32f4-a4cf-3f576e907cb2",
                                                "text": "„»Die Nofretete-Büste war von einem deutschen Archäologen aus Ägypten herausgeschmuggelt worden, durch Täuschung und Verschleierung.«“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
