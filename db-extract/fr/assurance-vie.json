                ],
                "senses": [
                    {
                        "sense_id": "af3718c5-c8b8-3560-b04e-22bb76587270",
                        "entry_id": "5159f321-a921-345d-88c1-7a0f0b9e0be5",
                        "glosses": [
                            "Système d'épargne garantissant le versement d’une rente ou d’un capital au souscripteur, ou à ses bénéficiaires en cas de décès."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63fbc1de-48c3-4d48-b6bb-32aeb5ea76e7",
                                "sense_id": "af3718c5-c8b8-3560-b04e-22bb76587270",
                                "text": "J’aurais normalement dû ressentir quelque chose de l’ordre du désir, ou du moins de la simple envie, en me retrouvant aux côtés de ces jeunes filles en jupes courtes, ou en leggings moulants, attablées non loin de moi dans la brasserie O’Jules, et qui commandaient des cafés en échangeant peut-être des confidences amoureuses, bien plus probablement qu’elles ne comparaient leurs plans respectifs d’assurance-vie."
                            },
                            {
                                "example_id": "4d62b9a6-6440-4ed9-b7f6-81c0a2c55580",
                                "sense_id": "af3718c5-c8b8-3560-b04e-22bb76587270",
                                "text": "Tout comme l’assurance-vie, l’assurance-décès bénéficie d’une fiscalité avantageuse : le capital versé est exonéré de droits de succession et de taxes pour le bénéficiaire direct."
                            }
                        ]
                    },
                    {
                        "sense_id": "6f4284a4-2762-3355-a076-e9309b51bb41",
                        "entry_id": "5159f321-a921-345d-88c1-7a0f0b9e0be5",
                        "glosses": [
                            "Capital transmis au(x) bénéficiaire(s) d'une assurance-vie en cas de décès du souscripteur."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "f5c627b9-344a-3977-b937-8d9c12203dbc",
                        "entry_id": "5159f321-a921-345d-88c1-7a0f0b9e0be5",
                        "glosses": [
                            "Tout élément utilisé comme menace tacite afin de dissuader autrui de s’en prendre à soi."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6937deec-5221-4e59-b5e9-e1f533637b7e",
                        "source_entry_id": "5159f321-a921-345d-88c1-7a0f0b9e0be5",
                        "target_lang_word": "Lebensversicherung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lebensversicherung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b4180d43-9a10-37b2-9442-9b7dcf6311d0",
                                        "entry_id": "83a9ee30-a1f1-3741-975f-a61476d199de",
                                        "glosses": [
                                            "Versicherung, die im Falle des Erreichens eines bestimmten Alters oder des Ablebens des Versicherten den Hinterbliebenen die Versicherungssumme auszahlt"
                                        ],
                                        "tags": [
                                            "Finanzwirtschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10eb38da-e70a-490e-adee-3ead7eeee549",
                                                "sense_id": "b4180d43-9a10-37b2-9442-9b7dcf6311d0",
                                                "text": "„Als Rückkauf bezeichnet man die Kündigung einer Lebensversicherung durch den Versicherungsnehmer, sofern im Kündigungsfall nach Vertrag oder Gesetz ein Rückkaufswert zu leisten ist.“"
                                            },
                                            {
                                                "example_id": "489b2a5b-733d-4c87-8b08-5010c56ec4a8",
                                                "sense_id": "b4180d43-9a10-37b2-9442-9b7dcf6311d0",
                                                "text": "„Von dem Verkauf des Hauses in Manchester und mehr noch von der Lebensversicherung, die der Vater abgeschlossen hatte, muss die Familie nun leben.“"
                                            },
                                            {
                                                "example_id": "1d125797-07a8-4973-b359-e0bb0a630dcc",
                                                "sense_id": "b4180d43-9a10-37b2-9442-9b7dcf6311d0",
                                                "text": "„Wie sehr mich die Geschichten über junge Auswanderer immer an Chrissi selbst erinnern, die sich vor fast 60 Jahren mutig für das Leben als Gastarbeiterin entschieden hat, ohne einen Schulabschluss und ein Studium als eine Art Lebensversicherung für ein neues Leben in der Ferne zu haben.“"
                                            },
                                            {
                                                "example_id": "a02cc449-b97a-45e6-bbd1-791a241630c4",
                                                "sense_id": "b4180d43-9a10-37b2-9442-9b7dcf6311d0",
                                                "text": "„Männer sterben früher, so dass wir das Bargeld aus ihrer Lebensversicherung kassieren können.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
