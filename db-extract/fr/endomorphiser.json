                "senses": [
                    {
                        "sense_id": "4b238ffd-a4a9-3373-9637-6aad4b5307b1",
                        "entry_id": "9941f9b5-9ff5-3a53-b445-5610b592df70",
                        "glosses": [
                            "Donner un caractère endomorphique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9eaa478f-ff3b-4081-9997-b70d34b993bb",
                                "sense_id": "4b238ffd-a4a9-3373-9637-6aad4b5307b1",
                                "text": "À mesure que,des profondeurs de la Matière aux cimes de l’Esprit, Dieu « métamorphisait » le Monde, le Monde, en retour, devait « endomorphiser » Dieu."
                            },
                            {
                                "example_id": "618f262b-b751-487d-a205-34b28b4ae843",
                                "sense_id": "4b238ffd-a4a9-3373-9637-6aad4b5307b1",
                                "text": "histoire de t’endomorphiser un peu, moi j’aurai ^([sic : aurais]) pas vendu feuille blanche, mais plein de dessins et un billet joint."
                            },
                            {
                                "example_id": "1c50f5f7-7b25-448d-b176-e58de0aede17",
                                "sense_id": "4b238ffd-a4a9-3373-9637-6aad4b5307b1",
                                "text": "Une chose est certaine, de Londres et de Washington, \"Paul Kagamé\" reçoit beaucoup d’aide pour endomorphiser les Congolais et leurs pays."
                            }
                        ]
                    }
