    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0fadaa57-a651-38a6-aeee-57dad21f2f98",
                    "sense_definition": "A state of physical inactivity, sluggishness, or stupor",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After a heavy meal, he fell into a deep <w>torpor</w> on the sofa.",
                            "target_lang_translations": {
                                "nl": "Na een zware maaltijd zakte hij op de bank weg in een diepe <w>lethargie</w>."
                            }
                        },
                        {
                            "text": "The hot afternoon sun induced a state of comfortable <w>torpor</w> among the beachgoers.",
                            "target_lang_translations": {
                                "nl": "De hete namiddagzon bracht de strandgangers in een toestand van aangename <w>loomheid</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "sluggishness",
                        "torpidity"
                    ],
                    "common_phrases": [
                        "fall into a torpor",
                        "state of torpor"
                    ],
                    "target_lang_definitions": {
                        "nl": "Een toestand van fysieke inactiviteit, traagheid of verdoving"
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "lethargie",
                                "target_lang_sense_clarification": "toestand van algehele traagheid of futloosheid"
                            },
                            {
                                "target_lang_word": "verdoving",
                                "target_lang_sense_clarification": "gevoelloosheid of roesachtige toestand"
                            },
                            {
                                "target_lang_word": "slaapzucht",
                                "target_lang_sense_clarification": "neiging tot diepe slaap of doezeligheid"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c0406cdd-f798-38aa-8a99-611b2b0c9f29",
                    "sense_definition": "A mental state of apathy, indifference, or lack of energy",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The long economic crisis plunged the entire community into a spiritless <w>torpor</w>.",
                            "target_lang_translations": {
                                "nl": "De lange economische crisis dompelde de hele gemeenschap onder in een moedeloze <w>apathie</w>."
                            }
                        },
                        {
                            "text": "She struggled to overcome the mental <w>torpor</w> that prevented her from writing.",
                            "target_lang_translations": {
                                "nl": "Ze deed moeite om de mentale <w>traagheid</w> te overwinnen die haar belette te schrijven."
                            }
                        }
                    ],
                    "synonyms": [
                        "lethargy",
                        "languor"
                    ],
                    "common_phrases": [
                        "mental torpor"
                    ],
                    "target_lang_definitions": {
                        "nl": "Een mentale toestand van apathie, onverschilligheid of gebrek aan energie"
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "apathie",
                                "target_lang_sense_clarification": "gebrek aan emotie, interesse of enthousiasme"
                            },
                            {
                                "target_lang_word": "lethargie",
                                "target_lang_sense_clarification": "geestelijke sloomheid of futloosheid"
                            },
                            {
                                "target_lang_word": "verstarring",
                                "target_lang_sense_clarification": "gebrek aan mentale beweeglijkheid of initiatief"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f0dc1ebd-ed43-337a-81f0-2020c58d4260",
                    "sense_definition": "A short-term state of decreased physiological activity in animals, characterized by reduced body temperature and metabolic rate",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hummingbirds enter daily <w>torpor</w> to conserve energy during cold nights.",
                            "target_lang_translations": {
                                "nl": "Kolibries gaan dagelijks in <w>torpor</w> om tijdens koude nachten energie te besparen."
                            }
                        },
                        {
                            "text": "Many small mammals rely on daily <w>torpor</w> to survive cold winter seasons.",
                            "target_lang_translations": {
                                "nl": "Veel kleine zoogdieren zijn afhankelijk van een dagelijkse <w>slaaptoestand</w> om koude winterseizoenen te overleven."
                            }
                        }
                    ],
                    "common_phrases": [
                        "daily torpor",
                        "enter torpor"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "scientific terminology"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Een tijdelijke toestand van verminderde fysiologische activiteit bij dieren, gekenmerkt door een lagere lichaamstemperatuur en stofwisseling"
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "torpor",
                                "target_lang_sense_clarification": "biologische vakterm voor lethargische toestand"
                            },
                            {
                                "target_lang_word": "slaaptoestand",
                                "target_lang_sense_clarification": "tijdelijke fysiologische rusttoestand"
                            },
                            {
                                "target_lang_word": "winterverstijving",
                                "target_lang_sense_clarification": "inactiviteit door kou bij koudbloedige dieren of kleine zoogdieren"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}