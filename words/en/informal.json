{
    "word_family": [
        "formal",
        "formality",
        "formalize",
        "informality",
        "informally"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "87b90d0d-2c6d-339f-bcac-5e619980b5a1",
                    "sense_definition": "Having a relaxed, friendly, or unofficial style or manner; not following strict rules of behavior.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager held an <w>informal</w> meeting to hear our ideas.",
                            "target_lang_translations": {
                                "ru": "Менеджер провёл <w>неформальную</w> встречу, чтобы выслушать наши идеи.",
                                "zh": "经理召开了一次<w>非正式</w>会议来听取我们的想法。"
                            }
                        },
                        {
                            "text": "We enjoyed a relaxed and <w>informal</w> dinner with our neighbors.",
                            "target_lang_translations": {
                                "ru": "Мы наслаждались спокойным и <w>неофициальным</w> ужином с нашими соседями.",
                                "zh": "我们和邻居们享用了一顿轻松<w>随意</w>的晚餐。"
                            }
                        }
                    ],
                    "synonyms": [
                        "not formal",
                        "relaxed",
                        "casual"
                    ],
                    "antonyms": [
                        "formal"
                    ],
                    "common_phrases": [
                        "informal meeting",
                        "informal gathering",
                        "informal atmosphere"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий расслабленный, дружеский или неофициальный стиль; не следующий строгим правилам поведения.",
                        "zh": "指风格或举止轻松、友好、非正式，不拘泥于严格的礼节或规则。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неформальный",
                                "target_lang_sense_clarification": "общий смысл; не следующий правилам"
                            },
                            {
                                "target_lang_word": "неофициальный",
                                "target_lang_sense_clarification": "не служебный, дружеский"
                            },
                            {
                                "target_lang_word": "непринуждённый",
                                "target_lang_sense_clarification": "свободный, лишенный натянутости"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "非正式",
                                "target_lang_sense_clarification": "指不拘礼节或不按正式程序"
                            },
                            {
                                "target_lang_word": "随意",
                                "target_lang_sense_clarification": "指轻松、不拘束的氛围"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "da2b2eff-4044-37a9-801b-b709f7050942",
                    "sense_definition": "Suitable for everyday use rather than for special or official occasions.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Most people prefer to wear <w>informal</w> clothes on the weekend.",
                            "target_lang_translations": {
                                "ru": "Большинство людей предпочитают носить <w>неформальную</w> одежду в выходные.",
                                "zh": "大多数人周末更喜欢穿<w>休闲</w>装。"
                            }
                        },
                        {
                            "text": "The invitation says the dress code for the party is <w>informal</w>.",
                            "target_lang_translations": {
                                "ru": "В приглашении сказано, что дресс-код для вечеринки — <w>неофициальный</w>.",
                                "zh": "请柬上说聚会的着装要求是<w>便装</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "casual",
                        "everyday"
                    ],
                    "antonyms": [
                        "formal"
                    ],
                    "common_phrases": [
                        "informal clothes",
                        "informal wear",
                        "informal dress"
                    ],
                    "target_lang_definitions": {
                        "ru": "Подходящий для повседневного использования, а не для особых или официальных случаев.",
                        "zh": "适合日常穿着或使用，而非用于正式场合。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неформальный",
                                "target_lang_sense_clarification": "о стиле одежды"
                            },
                            {
                                "target_lang_word": "неофициальный",
                                "target_lang_sense_clarification": "о дресс-коде"
                            },
                            {
                                "target_lang_word": "повседневный",
                                "target_lang_sense_clarification": "обычный, для ежедневного использования"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "休闲",
                                "target_lang_sense_clarification": "指适合日常穿着的风格"
                            },
                            {
                                "target_lang_word": "便装",
                                "target_lang_sense_clarification": "指非正式的服装"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3b3499bf-5596-3435-a5bc-1c207d1dd897",
                    "sense_definition": "Relating to speech or writing that is natural and casual, suitable for ordinary conversation.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is better to avoid <w>informal</w> language when writing academic essays.",
                            "target_lang_translations": {
                                "ru": "При написании академических эссе лучше избегать <w>разговорного</w> языка.",
                                "zh": "写学术论文时最好避免使用<w>口语</w>。"
                            }
                        },
                        {
                            "text": "Slang words are often used in <w>informal</w> speech between friends.",
                            "target_lang_translations": {
                                "ru": "Сленговые слова часто используются в <w>неформальной</w> речи между друзьями.",
                                "zh": "朋友间的<w>非正式</w>交谈中经常使用俚语。"
                            }
                        }
                    ],
                    "synonyms": [
                        "colloquial",
                        "casual",
                        "relaxed"
                    ],
                    "antonyms": [
                        "formal"
                    ],
                    "common_phrases": [
                        "informal language",
                        "informal speech",
                        "informal English"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к речи или письму, которые естественны и повседневны, подходят для обычного разговора.",
                        "zh": "指语言或文字自然、口语化，适合日常交流。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разговорный",
                                "target_lang_sense_clarification": "о стиле речи или лексике"
                            },
                            {
                                "target_lang_word": "неформальный",
                                "target_lang_sense_clarification": "о способе общения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "口语",
                                "target_lang_sense_clarification": "指日常交流中使用的语言"
                            },
                            {
                                "target_lang_word": "非正式",
                                "target_lang_sense_clarification": "指语言风格不严谨"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "12f2422f-eb58-3557-9773-044fedad4569",
                    "sense_definition": "Not officially recognized or controlled according to strict rules.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The two leaders reached an <w>informal</w> agreement to work together.",
                            "target_lang_translations": {
                                "ru": "Два лидера достигли <w>неофициального</w> соглашения о совместной работе.",
                                "zh": "两位领导人达成了一项<w>非正式</w>的合作协议。"
                            }
                        },
                        {
                            "text": "Many people work in the <w>informal</w> economy without paying taxes.",
                            "target_lang_translations": {
                                "ru": "Многие люди работают в <w>неформальной</w> экономике, не платя налоги.",
                                "zh": "许多人在<w>非正式</w>经济领域工作，无需纳税。"
                            }
                        }
                    ],
                    "synonyms": [
                        "unofficial"
                    ],
                    "antonyms": [
                        "formal"
                    ],
                    "common_phrases": [
                        "informal agreement",
                        "informal economy",
                        "informal sector"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официально не признанный или не контролируемый в соответствии со строгими правилами.",
                        "zh": "未经官方认可或未受严格规则约束的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неофициальный",
                                "target_lang_sense_clarification": "о соглашениях или договоренностях"
                            },
                            {
                                "target_lang_word": "неформальный",
                                "target_lang_sense_clarification": "об экономике или группах"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "非正式",
                                "target_lang_sense_clarification": "指未经官方程序"
                            },
                            {
                                "target_lang_word": "私下",
                                "target_lang_sense_clarification": "指非公开或非官方的协议"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "18bfcb56-9723-3d47-9841-713f2602bf84",
                    "sense_definition": "Lacking formal organization or structure.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Children often learn social skills through <w>informal</w> play.",
                            "target_lang_translations": {
                                "ru": "Дети часто осваивают социальные навыки через <w>неформальную</w> игру.",
                                "zh": "孩子们通常通过<w>非正式</w>的游戏来学习社交技巧。"
                            }
                        },
                        {
                            "text": "Museums and libraries are important centers for <w>informal</w> education.",
                            "target_lang_translations": {
                                "ru": "Музеи и библиотеки являются важными центрами <w>неформального</w> образования.",
                                "zh": "博物馆和图书馆是<w>非正式</w>教育的重要中心。"
                            }
                        }
                    ],
                    "antonyms": [
                        "formal"
                    ],
                    "common_phrases": [
                        "informal education",
                        "informal learning"
                    ],
                    "target_lang_definitions": {
                        "ru": "Лишённый формальной организации или структуры.",
                        "zh": "缺乏正式的组织结构或体系的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неформальный",
                                "target_lang_sense_clarification": "об обучении или образовании"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "非正式",
                                "target_lang_sense_clarification": "指缺乏系统性组织"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}