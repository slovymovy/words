                    },
                    {
                        "translation_id": "52395575-af72-4027-b56c-f35fe644a633",
                        "source_entry_id": "b1ed4ba3-7086-3103-ad68-3c684dbdf7fb",
                        "source_sense_id": "d68e7bfc-4b15-3fbc-a3ea-2c6673cb3a38",
                        "source_sense_description": "condition of being prudish; prudery",
                        "target_lang_word": "pudibonderie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pudibonderie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cc78940a-ed77-382d-afe1-4f5b6a04d77c",
                                        "entry_id": "75b50a9f-1434-3922-b367-505833972bf6",
                                        "glosses": [
                                            "Caractère de celui qui est pudibond."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d3e059c-e067-42c8-89a0-4254018dde07",
                                                "sense_id": "cc78940a-ed77-382d-afe1-4f5b6a04d77c",
                                                "text": "La pudibonderie ridicule qui, sous le manteau de la pudeur, sévit dans notre Occident civilisé, n’est point contrairement aux prétentions de certains doctrinaires, l’efflorescence d’un sentiment naturel aux humains."
                                            },
                                            {
                                                "example_id": "fadd4d57-ec33-493a-9865-579660c92c91",
                                                "sense_id": "cc78940a-ed77-382d-afe1-4f5b6a04d77c",
                                                "text": "J’avais toujours un peu intimidé maman à cause de l’estime intellectuelle où elle me tenait et qu’elle avait délibérément refusée à sa fille cadette. Réciproquement : très tôt, sa pudibonderie m’avait glacée."
                                            },
                                            {
                                                "example_id": "28247526-11d0-4db7-8dca-1fdcbe52f570",
                                                "sense_id": "cc78940a-ed77-382d-afe1-4f5b6a04d77c",
                                                "text": "De saintes personnes qu’eût suffoquées le moindre mot jugé indécent échangeaient volontiers, au salon, des détails hideux ou sales concernant des agonies. Nous avons changé tout cela : nos amours sont publiques ; nos morts sont escamotées. Il n’y a guère à choisir entre ces deux formes de pudibonderie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ad310f47-9e9e-445b-bc8b-cf1f9bc383e7",
                        "source_entry_id": "b1ed4ba3-7086-3103-ad68-3c684dbdf7fb",
                        "source_sense_id": "d68e7bfc-4b15-3fbc-a3ea-2c6673cb3a38",
                        "source_sense_description": "condition of being prudish; prudery",
                        "target_lang_word": "Prüderie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Prüderie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fbcc7af8-ac3a-3127-a2a5-db3d9b13df63",
                                        "entry_id": "6b0dd66b-3054-3ec9-8063-461bff7a6ce6",
                                        "glosses": [
                                            "übertrieben schamhafte Haltung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "456525cb-b02f-42f2-bc11-f973dbce5e23",
                                                "sense_id": "fbcc7af8-ac3a-3127-a2a5-db3d9b13df63",
                                                "text": "Mein Nachbar kann der Prüderie bezichtigt werden."
                                            },
                                            {
                                                "example_id": "e6db983d-560f-46ba-97cc-3f82e8cfeca0",
                                                "sense_id": "fbcc7af8-ac3a-3127-a2a5-db3d9b13df63",
                                                "text": "„Nach Jahrhunderten der Prüderie setzte sich der gesunde Körper um 1900 zum ersten Mal dem Sonnenschein, dem Wind und den entsetzten Blicken der Bürger aus.“"
                                            },
                                            {
                                                "example_id": "9b6114f0-9d50-4ee1-b36d-55783ccf2958",
                                                "sense_id": "fbcc7af8-ac3a-3127-a2a5-db3d9b13df63",
                                                "text": "„Die Prüderie in der Arbeiterklasse ist eine andere als die im Schatten einer Klosterkirche.“"
                                            },
                                            {
                                                "example_id": "e33487b4-9de8-4a4d-9a31-8e54b69545df",
                                                "sense_id": "fbcc7af8-ac3a-3127-a2a5-db3d9b13df63",
                                                "text": "„Die Prüderie, die Gezwungenheit, die Bigotterie und die geistige Unsauberkeit, die seit der viktorianischen Ära herrschen, waren erst nötig, um die Reinheit der Freundschaften zu trüben.“"
                                            },
                                            {
                                                "example_id": "7104398a-e846-4033-bb52-b03ea8042324",
                                                "sense_id": "fbcc7af8-ac3a-3127-a2a5-db3d9b13df63",
                                                "text": "„Stets kommt ein philosophischer Bettler vor, ein griesgrämiger Burgherr, unschuldige junge Mädchen, komische Diener und endlose Dialoge, eine dumme Prüderie und völliger Mangel an Tiefe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
