                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "547ca94b-51b6-41e8-9b14-ec87e5b5a80d",
                                "sense_id": "7d424f36-53f9-3880-b83b-d57c88bafd44",
                                "text": "Für seinen neuen Anzug kaufte er einen Ledergürtel beim Herrenausstatter."
                            },
                            {
                                "example_id": "3b77c135-2d14-4e31-8a91-5a9575464fc1",
                                "sense_id": "7d424f36-53f9-3880-b83b-d57c88bafd44",
                                "text": "„An diesem Abend trug sie ein raffiniertes, enganliegendes, hochgeschlossenes Kleid aus bestickter Chinaseide, darüber aber aparterweise einen schweren, handbreiten Ledergürtel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
