                "senses": [
                    {
                        "sense_id": "99161258-da4b-3ca1-916e-4fdb03643e4f",
                        "entry_id": "3741e962-879e-3c9b-9d4a-17bcdbb05bd9",
                        "glosses": [
                            "plaats waar men een serie handelingen verricht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d220cd3-ee99-40bb-8b84-82ed3c337f5c",
                                "sense_id": "99161258-da4b-3ca1-916e-4fdb03643e4f",
                                "text": "Aan het einde van de vijf werkstations rijdt de carbon sportwagen onder 24 lichtmodules door. Op die manier kunnen oneffenheden in het carbon worden opgespoord. Als laatste is het aan technicus Filippo Marocco de auto de fabriekshal uit te rijden. De bijna twee miljoen euro kostende sportwagen mag een frisse neus halen in de buitenlucht van Sant' Agata Bolognese. Hij is klaar en mag op weg naar een gelukkige, gefortuneerde koper."
                            }
                        ]
                    },
                    {
                        "sense_id": "c48d278c-23ee-33c7-b66a-75b61ab04593",
                        "entry_id": "3741e962-879e-3c9b-9d4a-17bcdbb05bd9",
                        "glosses": [
                            "krachtige computer die men voornamelijk gebruikt voor applicaties die veel rekenkracht vereisen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5e148cf-9162-471c-be59-47095080bb0b",
                                "sense_id": "c48d278c-23ee-33c7-b66a-75b61ab04593",
                                "text": "Ook nieuw is de Mac Pro, een werkstation voornamelijk bedoeld voor mensen die hoge resolutiebeelden bewerken en muziekproducenten. Standaard bevat de computer een 3,7GHz quad core processor, 12GB aan werkgeheugen en 256GB aan SSD-opslaggeheugen. Deze is vanaf december leverbaar en kost €3049."
                            },
                            {
                                "example_id": "3fd7eb27-06eb-4229-8ee7-781e53972f27",
                                "sense_id": "c48d278c-23ee-33c7-b66a-75b61ab04593",
                                "text": "De processors ondersteunen een breed scala aan computers, van desktops en combinaties van tablet en notebook tot mobiele werkstations."
                            },
                            {
                                "example_id": "d8e3cb3d-1e55-4fce-b2fd-b065cb9097bf",
                                "sense_id": "c48d278c-23ee-33c7-b66a-75b61ab04593",
                                "text": "De laptop is een werkstation met een krachtige Core i7-processor van Intel en een Quadro K1100M-grafische chip van Nvidia. Het apparaat is dan ook voornamelijk bedoeld voor mensen die veel aan videobewerking of 3D-modellering doen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
