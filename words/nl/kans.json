                                "target_lang_sense_clarification": "the ratio of probability"
                            },
                            {
                                "target_lang_word": "likelihood",
                                "target_lang_sense_clarification": "the state of being likely"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "вероятность",
                                "target_lang_sense_clarification": "степень осуществимости чего-либо"
                            },
                            {
                                "target_lang_word": "шанс",
