                {
                    "sense_id": "0b6fae2b-aabd-3435-9023-c98e41d5f125",
                    "sense_definition": "De eigenschap van een geluid die bepaald wordt door de frequentie van de trillingen.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De zangeres kon de <w>hoogte</w> van de noot niet goed vasthouden.",
                            "target_lang_translations": {
                                "en": "The singer could not hold the <w>pitch</w> of the note well.",
                                "ru": "Певица не могла хорошо удерживать <w>высоту</w> ноты.",
                                "pl": "Śpiewaczka nie potrafiła dobrze utrzymać <w>wysokości</w> dźwięku.",
                                "de": "Die Sängerin konnte die <w>Tonhöhe</w> der Note nicht gut halten.",
                                "fr": "La chanteuse n'arrivait pas à bien maintenir la <w>hauteur</w> de la note.",
                                "it": "La cantante non riusciva a mantenere bene l'<w>altezza</w> della nota.",
                                "cs": "Zpěvačka nedokázala dobře udržet <w>výšku</w> tónu.",
                                "tr": "Şarkıcı notanın <w>perdesini</w> iyi koruyamadı.",
                                "es": "La cantante no pudo mantener bien el <w>tono</w> de la nota."
                            }
                        },
                        {
                            "text": "Door de spanning in zijn stem veranderde de <w>hoogte</w> van zijn spraak.",
                            "target_lang_translations": {
                                "en": "Due to the tension in his voice, the <w>pitch</w> of his speech changed.",
                                "ru": "Из-за напряжения в голосе изменилась <w>высота</w> его речи.",
                                "pl": "Przez napięcie w głosie zmieniła się <w>wysokość</w> jego mowy.",
                                "de": "Durch die Spannung in seiner Stimme veränderte sich die <w>Tonhöhe</w> seiner Sprache.",
                                "fr": "À cause de la tension dans sa voix, la <w>hauteur</w> de sa parole a changé.",
                                "it": "A causa della tensione nella sua voce, l'<w>intonazione</w> del suo discorso è cambiata.",
                                "cs": "Kvůli napětí v hlase se změnila <w>výška</w> jeho řeči.",
                                "tr": "Sesindeki gerginlik nedeniyle konuşmasının <w>tonu</w> değişti.",
                                "es": "Debido a la tensión en su voz, el <w>tono</w> de su habla cambió."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The property of a sound determined by the frequency of the vibrations.",
                        "ru": "Характеристика звука, определяемая частотой колебаний.",
                        "pl": "Właściwość dźwięku określana przez częstotliwość drgań.",
                        "de": "Die Eigenschaft eines Tons, die durch die Frequenz der Schwingungen bestimmt wird.",
                        "fr": "La propriété d'un son déterminée par la fréquence des vibrations.",
                        "it": "La proprietà di un suono determinata dalla frequenza delle vibrazioni.",
                        "cs": "Vlastnost zvuku určená frekvencí kmitů.",
                        "tr": "Bir sesin, titreşimlerin frekansı tarafından belirlenen özelliği.",
                        "es": "La propiedad de un sonido determinada por la frecuencia de sus vibraciones."
                    },
