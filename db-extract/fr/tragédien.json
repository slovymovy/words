                                                "sense_id": "25ff773d-5411-39aa-aede-e93a6c6cb09e",
                                                "text": "Der Argentinier hat eine Reihe von preisgekrönten Tragödien verfasst und sich mittlerweile einen Namen als Tragöde gemacht."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
