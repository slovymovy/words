                        "source_sense_id": "ecc29812-c8a7-39ff-b849-9b603c0adddf",
                        "target_lang_word": "doze",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "doze",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0aae20b7-3080-3f10-bfae-4f7eb5b6585c",
                                        "entry_id": "45aa7378-ae5a-37e5-9aa1-70d4e17a8006",
                                        "glosses": [
                                            "To sleep lightly or briefly; to nap, snooze."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "adf90b28-3e2a-4155-a1b7-135658c6a717",
                                                "sense_id": "0aae20b7-3080-3f10-bfae-4f7eb5b6585c",
                                                "text": "I didn’t sleep very well, but I think I may have dozed a bit."
                                            },
                                            {
                                                "example_id": "d65cc87d-3400-4db0-ae79-17f27ea2425f",
                                                "sense_id": "0aae20b7-3080-3f10-bfae-4f7eb5b6585c",
                                                "text": "If he Happen'd to Doze a little no and then in a Morning, the Jolly Cobbler Wak'd him."
                                            },
                                            {
                                                "example_id": "b2d3722d-3673-4ce3-aaf3-fe29ca8a07f7",
                                                "sense_id": "0aae20b7-3080-3f10-bfae-4f7eb5b6585c",
                                                "text": "She dozes, too. Lies there for a minute or two, all these thoughts going through her head."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "beb21dd7-54b0-3ee0-a3b6-af32179512cd",
                                        "entry_id": "45aa7378-ae5a-37e5-9aa1-70d4e17a8006",
                                        "glosses": [
                                            "To make dull; to stupefy."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b482a1d-1c7e-413a-9e27-267cdda47046",
                                                "sense_id": "beb21dd7-54b0-3ee0-a3b6-af32179512cd",
                                                "text": "I was an hour […] in casting up about twenty sums, being dozed with much work."
                                            },
                                            {
                                                "example_id": "25c0e183-5c1d-4115-a721-b7275aaa33c7",
                                                "sense_id": "beb21dd7-54b0-3ee0-a3b6-af32179512cd",
                                                "text": "October 29, 1693, Robert South, a sermon preached at Christ-church in Oxford before the university\nThey left for a long time (as it were) dozed and benumbed."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "doze",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a2c9d0e8-aabb-3a3e-ab1a-046ea4ad47a5",
                                        "entry_id": "0a784180-7a02-3e70-b8a5-0a4e8c62f462",
                                        "glosses": [
                                            "A light, short sleep or nap."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f56111de-2744-4fe8-89ac-020528e190d0",
                                                "sense_id": "a2c9d0e8-aabb-3a3e-ab1a-046ea4ad47a5",
                                                "text": "I felt much better after a short doze."
                                            },
                                            {
                                                "example_id": "e0dd8747-4d83-4021-b707-4ec1c8e8767c",
                                                "sense_id": "a2c9d0e8-aabb-3a3e-ab1a-046ea4ad47a5",
                                                "text": "Others who conscientiously attended the Technical College at night often drooped over their desks in a doze, and one does not wonder at it."
                                            },
                                            {
                                                "example_id": "81d0d527-2227-493d-9a5b-9742c0355549",
                                                "sense_id": "a2c9d0e8-aabb-3a3e-ab1a-046ea4ad47a5",
                                                "text": "At the mention of money Mrs Dibble was overcome with great debility, and wheezed, \"I don't feel up to talking about money, matters just now, dearie. I think I better have a bit of a doze.\""
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "doze",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7d6cfb6a-1f6b-3c85-adfc-f04b80306f89",
                                        "entry_id": "ba69aac1-12b7-36d7-a267-e52615075757",
                                        "glosses": [
                                            "To bulldoze."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "doze",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "25fed296-eb2d-358e-a713-5164d96ca438",
                                        "entry_id": "f3313767-21d1-398a-b5db-3978199c31b6",
                                        "glosses": [
                                            "Pronunciation spelling of those."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "pronunciation-spelling"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "27900e73-a23d-4e8c-a7fc-7ed36d309f53",
                                                "sense_id": "25fed296-eb2d-358e-a713-5164d96ca438",
                                                "text": "Donald Duck: I'll give you $20 for those old license plates on your fence posts!\nOther man: Hah? No chance! I bought dis house 'cause it has dis address! It's me lucky number! […] It was me prison number at Leavenworst and de winning number in de weekly parole lottery! I wudn't never sell doze plates!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "52f88c05-bfc2-4f55-b1ea-79aae5471b0f",
                        "source_entry_id": "bae69da3-fa7a-3d0f-aeeb-ff5c6eb403c4",
                        "source_sense_id": "ecc29812-c8a7-39ff-b849-9b603c0adddf",
                        "target_lang_word": "slumber",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "slumber",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6fd72147-5aa8-3e9e-a3df-2e03179f3417",
                                        "entry_id": "6c60f998-45dd-3a88-8989-789008d30613",
                                        "glosses": [
                                            "A very light state of sleep, almost awake."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "138d9e03-09c8-4967-94f0-a4a4c6ba4ff9",
                                                "sense_id": "6fd72147-5aa8-3e9e-a3df-2e03179f3417",
                                                "text": "Fast asleep? It is no matter; / Enjoy the honey-heavy dew of slumber."
                                            },
                                            {
                                                "example_id": "a2c145f8-e58f-4cba-84da-e6322d926a70",
                                                "sense_id": "6fd72147-5aa8-3e9e-a3df-2e03179f3417",
                                                "text": "Ev’n Luſt and Envy ſleep, yet Love denies / Reſt to my Soul, and ſlumber to my Eyes."
                                            },
                                            {
                                                "example_id": "8a67120b-e437-4160-b6ba-044c2a9299ec",
                                                "sense_id": "6fd72147-5aa8-3e9e-a3df-2e03179f3417",
                                                "text": "He at last fell into a slumber, and thence into a fast sleep, which detained him in that place until it was almost night."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a10a2fd7-f4e3-313d-988f-09eb704d9fb9",
                                        "entry_id": "6c60f998-45dd-3a88-8989-789008d30613",
                                        "glosses": [
                                            "A state of ignorance or inaction."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b64a8a30-724d-4eb6-a21f-630d55f0a141",
                                                "sense_id": "a10a2fd7-f4e3-313d-988f-09eb704d9fb9",
                                                "text": "Marcel Duchamp's urinal and readymades seemed in the beginning to be insider jokes or jokelike paradoxes meant to awaken people from their aesthetic slumbers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f1924eb-5661-3f3e-b6b8-3f7ddd1197d4",
                                        "entry_id": "6c60f998-45dd-3a88-8989-789008d30613",
                                        "glosses": [
                                            "The snooze button on an alarm clock."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "slumber",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "566231f5-6595-3104-83d7-9753798ba987",
                                        "entry_id": "66e6483d-0db9-3879-a4ae-8dc222dbc6df",
                                        "glosses": [
                                            "To be in a very light state of sleep, almost awake."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "302b52da-a39e-47c3-8652-304903847659",
                                                "sense_id": "566231f5-6595-3104-83d7-9753798ba987",
                                                "text": "He that keepeth Israel shall neither slumber nor sleep."
                                            },
                                            {
                                                "example_id": "e16e3920-139c-4653-a32b-b564232a975e",
                                                "sense_id": "566231f5-6595-3104-83d7-9753798ba987",
                                                "text": "If Sleep and Death be truly one,\n⁠And every spirit’s folded bloom\n⁠Thro’ all its intervital gloom\nIn some long trance should slumber on; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9fce2b80-b174-3ef3-b0bd-634d89532b6a",
                                        "entry_id": "66e6483d-0db9-3879-a4ae-8dc222dbc6df",
                                        "glosses": [
                                            "To be inactive or negligent."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "25390df3-8c39-3493-bca3-2e6e340ef8d9",
                                        "entry_id": "66e6483d-0db9-3879-a4ae-8dc222dbc6df",
                                        "glosses": [
                                            "To lay to sleep."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fdb51ac4-b451-40e6-994e-ba09d04b190a",
                                                "sense_id": "25390df3-8c39-3493-bca3-2e6e340ef8d9",
                                                "text": "slumber his conscience"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79dfcede-20dc-307d-992c-6712c8ec6ba0",
                                        "entry_id": "66e6483d-0db9-3879-a4ae-8dc222dbc6df",
                                        "glosses": [
                                            "To stun; to stupefy."
                                        ],
                                        "tags": [
