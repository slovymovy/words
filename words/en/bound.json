{
    "word_family": [
        "boundary",
        "boundless",
        "unbound",
        "rebound",
        "outbound",
        "inbound",
        "abound"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5d1913d4-f110-3558-9d5c-9b406fa4641b",
                    "sense_definition": "Simple past and past participle of <w>bind</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "verb_bind",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hostages were <w>bound</w> with thick ropes.",
                            "target_lang_translations": {
                                "ru": "Заложники были <w>связаны</w> толстыми веревками.",
                                "zh": "人质被粗绳子<w>捆绑</w>着。"
                            }
                        },
                        {
                            "text": "We are <w>bound</w> together by our shared history.",
                            "target_lang_translations": {
                                "ru": "Мы <w>связаны</w> вместе нашей общей историей.",
                                "zh": "我们因共同的历史而<w>联系</w>在一起。"
                            }
                        }
                    ],
                    "synonyms": [
                        "tied",
                        "fastened",
                        "secured"
                    ],
                    "antonyms": [
                        "free"
                    ],
                    "common_phrases": [
                        "bound hand and foot",
                        "bound by law"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола bind (связывать).",
                        "zh": "动词 bind 的过去式和过去分词，意为被捆绑或被束缚。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "свя́занный",
                                "target_lang_sense_clarification": "скрепленный или соединенный чем-либо"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "被捆绑的",
                                "target_lang_sense_clarification": "指被绳索等物束缚的状态"
                            },
                            {
                                "target_lang_word": "被束缚的",
                                "target_lang_sense_clarification": "指在抽象意义上受到限制或联系"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ec64f4f2-c4cd-386e-b90d-980e488d9d8c",
                    "sense_definition": "To run with long, jumping strides or to leap energetically.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "verb_move",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The large dog <w>bounded</w> across the grass to greet us.",
                            "target_lang_translations": {
                                "ru": "Большая собака <w>проскакала</w> по траве, чтобы поприветствовать нас.",
                                "zh": "那只大狗<w>跳跃</w>着穿过草地来迎接我们。"
                            }
                        },
                        {
                            "text": "She <w>bounded</w> up the stairs to answer the phone.",
                            "target_lang_translations": {
                                "ru": "Она <w>взбежала</w> по лестнице, чтобы ответить на звонок.",
                                "zh": "她<w>飞奔</w>上楼去接电话。"
                            }
                        }
                    ],
                    "synonyms": [
                        "leap",
                        "spring",
                        "jump",
                        "bounce"
                    ],
                    "common_phrases": [
                        "bound away"
                    ],
                    "target_lang_definitions": {
                        "ru": "Бежать большими шагами или энергично прыгать.",
                        "zh": "指以大步跳跃的方式奔跑或充满活力地跳跃。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скака́ть",
                                "target_lang_sense_clarification": "перемещаться прыжками"
                            },
                            {
                                "target_lang_word": "пры́гать",
                                "target_lang_sense_clarification": "совершать прыжки"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "跳跃",
                                "target_lang_sense_clarification": "指动作轻快地跃起"
                            },
                            {
                                "target_lang_word": "飞奔",
                                "target_lang_sense_clarification": "指快速且带有跳跃感的奔跑"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9a31d3eb-6c1c-3710-9abb-603b94ac535c",
                    "sense_definition": "To form the boundary or limit of a specific area.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "verb_limit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The property is <w>bounded</w> by a river on the south side.",
                            "target_lang_translations": {
                                "ru": "Владение <w>ограничено</w> рекой с южной стороны.",
                                "zh": "该地产南侧以一条河流为<w>界</w>。"
                            }
                        },
                        {
                            "text": "A high stone wall <w>bounded</w> the ancient garden.",
                            "target_lang_translations": {
                                "ru": "Высокая каменная стена <w>ограничивала</w> старый сад.",
                                "zh": "一道高高的石墙<w>环绕</w>着这座古老的花园。"
                            }
                        }
                    ],
                    "synonyms": [
                        "border",
                        "enclose",
                        "surround",
                        "limit"
                    ],
                    "common_phrases": [
                        "bounded by"
                    ],
                    "target_lang_definitions": {
                        "ru": "Служить границей или пределом определенной территории.",
                        "zh": "指构成某特定区域的边界或界限。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ограни́чивать",
                                "target_lang_sense_clarification": "являться границей чего-либо"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "限制",
                                "target_lang_sense_clarification": "指作为范围的界限"
                            },
                            {
                                "target_lang_word": "环绕",
                                "target_lang_sense_clarification": "指围成边界"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "1f467e7f-4ef3-357f-8e20-24e3c83fa1ee",
                    "sense_definition": "Certain or extremely likely to happen or be true.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "adj_certain",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is <w>bound</w> to rain with all those dark clouds in the sky.",
                            "target_lang_translations": {
                                "ru": "С такими темными тучами на небе <w>непременно</w> пойдет дождь.",
                                "zh": "天上有那么多乌云，<w>注定</w>要下雨了。"
                            }
                        },
                        {
                            "text": "They are <w>bound</w> to find out the truth eventually.",
                            "target_lang_translations": {
                                "ru": "В конце концов они <w>непременно</w> узнают правду.",
                                "zh": "他们最终<w>肯定</w>会发现真相。"
                            }
                        }
                    ],
                    "synonyms": [
                        "certain",
                        "sure",
                        "destined",
                        "inevitable"
                    ],
                    "common_phrases": [
                        "bound to happen",
                        "bound to be"
                    ],
                    "target_lang_definitions": {
                        "ru": "Несомненный или крайне вероятный.",
                        "zh": "指某事极有可能发生或必然会发生。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "непреме́нный",
                                "target_lang_sense_clarification": "обязательный, неизбежный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "注定",
                                "target_lang_sense_clarification": "指必然会发生"
                            },
                            {
                                "target_lang_word": "肯定",
                                "target_lang_sense_clarification": "指极有可能"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "88c7be90-ac7a-30ea-9cb1-26c9c377383a",
                    "sense_definition": "Moving in a specific direction or ready to go to a destination.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "adj_direction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The train standing at platform two is <w>bound</w> for Paris.",
                            "target_lang_translations": {
                                "ru": "Поезд, стоящий на второй платформе, <w>направляется</w> в Париж.",
                                "zh": "停在二号站台的火车是<w>开往</w>巴黎的。"
                            }
                        },
                        {
                            "text": "We are finally homeward <w>bound</w> after a long trip.",
                            "target_lang_translations": {
                                "ru": "После долгого путешествия мы наконец <w>направляемся</w> домой.",
                                "zh": "长途旅行后，我们终于<w>踏上</w>了回家的路。"
                            }
                        }
                    ],
                    "synonyms": [
                        "headed",
                        "going"
                    ],
                    "common_phrases": [
                        "homeward bound",
                        "outward bound",
                        "north bound"
                    ],
                    "target_lang_definitions": {
                        "ru": "Движущийся в определенном направлении или готовый отправиться к месту назначения.",
                        "zh": "指正向特定方向移动或准备前往某目的地。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "направля́ющийся",
                                "target_lang_sense_clarification": "движущийся куда-либо"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "开往",
                                "target_lang_sense_clarification": "指交通工具前往某地"
                            },
                            {
                                "target_lang_word": "前往",
                                "target_lang_sense_clarification": "指人或物正向某处移动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "881cb6e8-d90b-3d0b-9e09-2454d0a084e0",
                    "sense_definition": "Forced to do something by law, duty, or a promise.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "adj_obliged",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You are not legally <w>bound</w> to sign this contract.",
                            "target_lang_translations": {
                                "ru": "Вы юридически не <w>обязаны</w> подписывать этот контракт.",
                                "zh": "你没有法律<w>义务</w>签署这份合同。"
                            }
                        },
                        {
                            "text": "I felt <w>bound</w> to help him after he had done so much for me.",
                            "target_lang_translations": {
                                "ru": "Я чувствовал себя <w>обязанным</w> помочь ему после того, как он так много для меня сделал.",
                                "zh": "在他为我做了那么多事之后，我觉得有<w>责任</w>帮助他。"
                            }
                        }
                    ],
                    "synonyms": [
                        "obliged",
                        "obligated",
                        "required",
                        "compelled"
                    ],
                    "antonyms": [
                        "free"
                    ],
                    "common_phrases": [
                        "legally bound",
                        "duty bound",
                        "honor bound"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вынужденный сделать что-то по закону, долгу или обещанию.",
                        "zh": "指因法律、职责或承诺而被迫做某事。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обяза́нный",
                                "target_lang_sense_clarification": "имеющий обязательство сделать что-то"
                            },
                            {
                                "target_lang_word": "до́лжный",
                                "target_lang_sense_clarification": "вынужденный долгом"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "有义务",
                                "target_lang_sense_clarification": "指因责任或法律而必须做"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2ba4cbfa-db83-3be5-9771-04a92cb3827a",
                    "sense_definition": "A limit or border that defines an area or acceptable behavior.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "noun_limit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ball went out of <w>bounds</w> and stopped the game.",
                            "target_lang_translations": {
                                "ru": "Мяч ушел за <w>пределы</w> поля, и игра остановилась.",
                                "zh": "球出了<w>界</w>，比赛暂停了。"
                            }
                        },
                        {
                            "text": "His enthusiasm for the project knows no <w>bounds</w>.",
                            "target_lang_translations": {
                                "ru": "Его энтузиазм по поводу проекта не знает <w>границ</w>.",
                                "zh": "他对这个项目的热情没有<w>限度</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "limit",
                        "border",
                        "boundary",
                        "confine"
                    ],
                    "common_phrases": [
                        "out of bounds",
                        "within bounds",
                        "know no bounds"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предел или граница, определяющая область или допустимое поведение.",
                        "zh": "指定义区域或可接受行为的界限或范围。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "грани́ца",
                                "target_lang_sense_clarification": "черта раздела территории или допустимого"
                            },
                            {
                                "target_lang_word": "преде́л",
                                "target_lang_sense_clarification": "крайняя степень или пространственная граница"
                            },
                            {
                                "target_lang_word": "рубе́ж",
                                "target_lang_sense_clarification": "граница, разделительная линия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "界限",
                                "target_lang_sense_clarification": "指范围的边缘"
                            },
                            {
                                "target_lang_word": "范围",
                                "target_lang_sense_clarification": "指允许的活动空间"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cc3a3db1-eca8-3102-8152-6874209a3a83",
                    "sense_definition": "A long or high jump.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "noun_jump",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The deer cleared the high fence in a single <w>bound</w>.",
                            "target_lang_translations": {
                                "ru": "Олень перемахнул через высокий забор одним <w>прыжком</w>.",
                                "zh": "那只鹿一<w>跃</w>就跳过了高高的栅栏。"
                            }
                        },
                        {
                            "text": "Technology is improving by leaps and <w>bounds</w> every year.",
                            "target_lang_translations": {
                                "ru": "Технологии с каждым годом совершенствуются гигантскими <w>скачками</w>.",
                                "zh": "科技每年都在<w>突飞猛进</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "leap",
                        "jump",
                        "spring"
                    ],
                    "common_phrases": [
                        "by leaps and bounds",
                        "in a single bound"
                    ],
                    "target_lang_definitions": {
                        "ru": "Длинный или высокий прыжок.",
                        "zh": "指一次长距离或高难度的跳跃。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прыжо́к",
                                "target_lang_sense_clarification": "перемещение тела в воздухе отталкиванием"
                            },
                            {
                                "target_lang_word": "скачо́к",
                                "target_lang_sense_clarification": "резкое перемещение прыжком"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "跳跃",
                                "target_lang_sense_clarification": "指一次跃起动作"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "5a7cb8eb-8458-31d4-a11e-ef5d4e3bf623",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Bound</w> arrived late for the meeting.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Баунд</w> опоздал на встречу.",
                                "zh": "<w>鲍恩德</w>先生开会迟到了。"
                            }
                        },
                        {
                            "text": "I have never met anyone with the last name <w>Bound</w> before.",
                            "target_lang_translations": {
                                "ru": "Я никогда раньше не встречал никого с фамилией <w>Баунд</w>.",
                                "zh": "我以前从未见过姓<w>鲍恩德</w>的人。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия.",
                        "zh": "姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Баунд",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "鲍恩德",
                                "target_lang_sense_clarification": "姓氏音译"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}