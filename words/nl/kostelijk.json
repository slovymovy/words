                {
                    "sense_id": "4b6973d7-8861-366e-8e9b-ea783f07f7fe",
                    "sense_definition": "van zeer grote waarde; kostbaar",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "waarde",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het museum bewaart een verzameling van <w>kostelijke</w> juwelen uit de zeventiende eeuw.",
                            "target_lang_translations": {
                                "fr": "Le musée conserve une collection de bijoux <w>précieux</w> du XVIIe siècle."
