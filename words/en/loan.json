{
    "word_family": [
        "loaner",
        "loanable",
        "reloan",
        "unloaned"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9867c952-42f5-39fe-944c-72460455ce68",
                    "sense_definition": "A sum of money or an object that is borrowed and must be returned or repaid, often with interest.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "borrowing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bank approved my <w>loan</w> for a new car yesterday.",
                            "target_lang_translations": {
                                "ru": "Вчера банк одобрил мой <w>кредит</w> на новый автомобиль.",
                                "zh": "银行昨天批准了我买新车的<w>贷款</w>。"
                            }
                        },
                        {
                            "text": "He had to take out a student <w>loan</w> to pay for his university tuition.",
                            "target_lang_translations": {
                                "ru": "Ему пришлось взять студенческий <w>заём</w>, чтобы оплатить обучение в университете.",
                                "zh": "为了支付大学学费，他不得不申请一笔学生<w>贷款</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "principal"
                    ],
                    "common_phrases": [
                        "student loan",
                        "bank loan",
                        "repay a loan",
                        "apply for a loan"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сумма денег или предмет, взятые в долг, которые необходимо вернуть или выплатить, часто с процентами.",
                        "zh": "借来的钱或物，之后必须归还或偿还，通常还可能要付利息。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кредит",
                                "target_lang_sense_clarification": "банковский или потребительский"
                            },
                            {
                                "target_lang_word": "заём",
                                "target_lang_sense_clarification": "денежная сумма в долг"
                            },
                            {
                                "target_lang_word": "ссуда",
                                "target_lang_sense_clarification": "предоставление средств или имущества"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "贷款",
                                "target_lang_sense_clarification": "向银行或金融机构借的钱；也可指需归还的借入款项"
                            },
                            {
                                "target_lang_word": "借款",
                                "target_lang_sense_clarification": "一般说法，指借来的钱或物，之后要归还"
                            },
                            {
                                "target_lang_word": "借贷",
                                "target_lang_sense_clarification": "较正式，可指借出的资金或财物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a7e08774-c3c3-3b9b-8945-98a2a7e09599",
                    "sense_definition": "The act of lending something to someone for a temporary period.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "borrowing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am very grateful for the <w>loan</w> of your car while mine was being repaired.",
                            "target_lang_translations": {
                                "ru": "Я очень благодарен за то, что вы <w>одолжили</w> мне машину, пока моя была в ремонте.",
                                "zh": "我的车送修期间，非常感谢你<w>出借</w>汽车给我。"
                            }
                        },
                        {
                            "text": "The museum has several famous paintings on <w>loan</w> from a private collection.",
                            "target_lang_translations": {
                                "ru": "В музее выставлено несколько известных картин, временно <w>предоставленных</w> из частной коллекции.",
                                "zh": "博物馆有几幅著名画作是从私人收藏中<w>借展</w>来的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "lending",
                        "loaning"
                    ],
                    "common_phrases": [
                        "on loan",
                        "short-term loan"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт временного предоставления чего-либо во владение другому лицу.",
                        "zh": "把某物暂时借给别人使用这一行为。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пользование",
                                "target_lang_sense_clarification": "временное предоставление вещи"
                            },
                            {
                                "target_lang_word": "аренда",
                                "target_lang_sense_clarification": "временное владение"
                            },
                            {
                                "target_lang_word": "выдача",
                                "target_lang_sense_clarification": "во временное пользование"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "出借",
                                "target_lang_sense_clarification": "把某物暂时借给别人使用"
                            },
                            {
                                "target_lang_word": "外借",
                                "target_lang_sense_clarification": "强调借给外部的人或机构"
                            },
                            {
                                "target_lang_word": "借展",
                                "target_lang_sense_clarification": "专指展品暂时借给别处展出"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aafca070-a24c-3366-94d8-9f25f16cd242",
                    "sense_definition": "The legal or formal agreement and obligations associated with borrowing money.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "borrowing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should read the <w>loan</w> agreement carefully before signing it.",
                            "target_lang_translations": {
                                "ru": "Вам следует внимательно прочитать <w>кредитный</w> договор перед его подписанием.",
                                "zh": "签字前你应该仔细阅读<w>贷款</w>协议。"
                            }
                        },
                        {
                            "text": "He missed a monthly payment on his <w>loan</w> and had to pay a fine.",
                            "target_lang_translations": {
                                "ru": "Он пропустил ежемесячный платеж по <w>займу</w> и был вынужден заплатить штраф.",
                                "zh": "他有一次没有按时偿还<w>贷款</w>月供，因此不得不支付罚金。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "loan agreement",
                        "loan contract"
                    ],
                    "target_lang_definitions": {
                        "ru": "Юридическое или официальное соглашение и обязательства, связанные с заимствованием денег.",
                        "zh": "与借钱有关的法律上或正式的协议，以及由此产生的义务。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заём",
                                "target_lang_sense_clarification": "договорные обязательства"
                            },
                            {
                                "target_lang_word": "кредит",
                                "target_lang_sense_clarification": "кредитные обязательства"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "贷款",
                                "target_lang_sense_clarification": "指借款关系本身，尤其是与银行等有关的正式债务或合同"
                            },
                            {
                                "target_lang_word": "借款",
                                "target_lang_sense_clarification": "较通用，指借钱形成的正式借款关系或义务"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "891ecbea-cbb8-3146-9433-76e4b7577c10",
                    "sense_definition": "An area of uncultivated or common land near a village or farm.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "land",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cattle were gathered in the <w>loan</w> before being driven to the market.",
                            "target_lang_translations": {
                                "ru": "Скот собрали на <w>выгоне</w> перед тем, как погнать на рынок.",
                                "zh": "牲口被赶去市场前，先被集中在那片<w>公地</w>上。"
                            }
                        },
                        {
                            "text": "They met in the <w>loan</w> above the house to discuss the harvest.",
                            "target_lang_translations": {
                                "ru": "Они встретились на <w>пустыре</w> за домом, чтобы обсудить урожай.",
                                "zh": "他们在房子上方那片<w>荒地</w>见面，讨论收成。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "chiefly Scotland"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Участок необработанной или общинной земли рядом с деревней или фермой (преимущественно в Шотландии).",
                        "zh": "村庄或农场附近未经耕种的土地或公共用地，主要见于苏格兰英语。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выгон",
                                "target_lang_sense_clarification": "общинная земля для скота"
                            },
                            {
                                "target_lang_word": "прогон",
                                "target_lang_sense_clarification": "дорога между полями для скота"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "公地",
                                "target_lang_sense_clarification": "苏格兰方言，指村庄或农场附近的公共土地"
                            },
                            {
                                "target_lang_word": "荒地",
                                "target_lang_sense_clarification": "苏格兰方言，指村庄或农场附近未开垦的土地"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6c8fec15-e715-31dc-bbbf-db958cb6c7cd",
                    "sense_definition": "To give something to someone for a period of time, expecting it to be returned.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "borrowing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Could you <w>loan</w> me ten dollars until I get paid on Friday?",
                            "target_lang_translations": {
                                "ru": "Не мог бы ты <w>одолжить</w> мне десять долларов до зарплаты в пятницу?",
                                "zh": "你能<w>借给</w>我十美元，等我周五发工资后还你吗？"
                            }
                        },
                        {
                            "text": "The library will <w>loan</w> books to anyone with a valid membership card.",
                            "target_lang_translations": {
                                "ru": "Библиотека <w>выдает</w> книги любому, у кого есть действующий читательский билет.",
                                "zh": "图书馆会向任何持有有效借书证的人<w>出借</w>图书。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "loan money"
                    ],
                    "target_lang_definitions": {
                        "ru": "Давать что-либо кому-либо на время с условием возврата.",
                        "zh": "把某物暂时给别人，并且预期对方之后会归还。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "одалживать",
                                "target_lang_sense_clarification": "давать в долг"
                            },
                            {
                                "target_lang_word": "давать взаймы",
                                "target_lang_sense_clarification": "предоставлять деньги"
                            },
                            {
                                "target_lang_word": "ссужать",
                                "target_lang_sense_clarification": "предоставлять ссуду"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "借给",
                                "target_lang_sense_clarification": "最常用，指暂时把东西给别人，之后要还"
                            },
                            {
                                "target_lang_word": "出借",
                                "target_lang_sense_clarification": "较正式，指把物品或书籍等借出"
                            },
                            {
                                "target_lang_word": "贷给",
                                "target_lang_sense_clarification": "多用于金钱或较正式语境"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}