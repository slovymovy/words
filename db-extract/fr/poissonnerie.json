        "fr-extract.jsonl": [
            {
                "entry_id": "a24b7bde-3d73-3e29-93bd-8ad41accf2a9",
                "word": "poissonnerie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "bda23c02-e660-4ccc-a7ea-0344c93ed0f4",
                        "entry_id": "a24b7bde-3d73-3e29-93bd-8ad41accf2a9",
                        "tags": [
                            "plural"
                        ],
                        "form": "poissonneries"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "74f48a13-a8c4-342d-b0dc-bce4bb1c82c2",
                        "entry_id": "a24b7bde-3d73-3e29-93bd-8ad41accf2a9",
                        "glosses": [
                            "Boutique où l’on vend le poisson."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed516dca-e4b8-495d-92a9-d3c73e0a06c1",
                                "sense_id": "74f48a13-a8c4-342d-b0dc-bce4bb1c82c2",
                                "text": "Il y a queue à la poissonnerie, signe d’une intégration généralisée de la tradition catholique. En réalité, la seule croyance qui fasse acheter du poisson le vendredi, c’est celle qu’il est plus frais que les autres jours."
                            },
                            {
                                "example_id": "25e05156-e896-4238-8fc6-7097e2dff18e",
                                "sense_id": "74f48a13-a8c4-342d-b0dc-bce4bb1c82c2",
                                "text": "Alric Paon, à la tête d’un réseau d’une quinzaine de poissonneries et points de vente en Loire-Atlantique, observe également cette augmentation soudaine du tarif du bulot : « Les habitués nous posent des questions, forcément. On explique le contexte et on tire sur nos marges. »"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "245f3060-e1d4-4af9-8df8-247273c19acb",
                        "source_entry_id": "a24b7bde-3d73-3e29-93bd-8ad41accf2a9",
                        "source_sense_id": "74f48a13-a8c4-342d-b0dc-bce4bb1c82c2",
                        "target_lang_word": "Fischgeschäft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fischgeschäft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8e565d31-19d4-344e-b0ed-edb4e3230fc3",
                                        "entry_id": "204bdfc8-20bc-32c8-afae-1a64e81111b6",
                                        "glosses": [
                                            "gewerbliche Räumlichkeiten, in denen Fische zum Verkauf angeboten werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23cabc32-71b5-4f9e-8133-7c5f7fdbc690",
                                                "sense_id": "8e565d31-19d4-344e-b0ed-edb4e3230fc3",
                                                "text": "„Ganz seltsam und merkwürdig wurde es dann aber, als ich ein kleines Fischgeschäft entdeckte und vermutete, dass Mama bereits in diesem Fischgeschäft eingekauft hatte.“"
                                            },
                                            {
                                                "example_id": "74aac8c6-fc8e-40bc-9a85-bf9dbabd1742",
                                                "sense_id": "8e565d31-19d4-344e-b0ed-edb4e3230fc3",
                                                "text": "„Zu den Namen, die Pellegrini in den Computer einfüttert, gehört einer, den die Familie des Opfers genannt hat: der Besitzer eines Fischgeschäfts in der Whitelock Street.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5105ba05-b4c3-4f51-8f65-efd5a8a7ceb0",
                        "source_entry_id": "a24b7bde-3d73-3e29-93bd-8ad41accf2a9",
                        "source_sense_id": "74f48a13-a8c4-342d-b0dc-bce4bb1c82c2",
                        "target_lang_word": "fishmonger",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fishmonger",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "608bbb03-fb79-3661-8593-9618cfa574eb",
                                        "entry_id": "01c5c263-2ebf-334f-81e9-acedaa238d42",
                                        "glosses": [
                                            "A person who sells fish."
                                        ],
                                        "tags": [
                                            "British"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "71c3e2bc-0e97-4314-83a2-85770143d1b9",
                                                "sense_id": "608bbb03-fb79-3661-8593-9618cfa574eb",
                                                "text": "If he made transcendental distinctions, he fortified himself by drawing all his illustrations from sources disdained by orators and polite conversers; from mares and puppies; from pitchers and soup-ladles; from cooks and criers; the shops of potters, horse-doctors, butchers, and fishmongers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "afc76c59-b9c4-3903-a18b-c610bcdfeb35",
                                        "entry_id": "01c5c263-2ebf-334f-81e9-acedaa238d42",
                                        "glosses": [
                                            "A shop that sells fish; a fishmonger's shop, a fishmonger's."
                                        ],
                                        "tags": [
                                            "British",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dda8ef74-6073-438f-a51d-6e36cab9aa8b",
                                                "sense_id": "afc76c59-b9c4-3903-a18b-c610bcdfeb35",
                                                "text": "And Susan, sure of this inevitable answer, would ask Cook to pop into the fishmonger for a nice bit of salmon, […]"
                                            },
                                            {
                                                "example_id": "e7f30582-ffd2-4c8b-931c-e8aa7be34f85",
                                                "sense_id": "afc76c59-b9c4-3903-a18b-c610bcdfeb35",
                                                "text": "A nice woman at the fishmonger in Earl’s Court Road—she had to walk miles to find a fish shop—told her how to cook the fillets of plaice she bought."
                                            },
                                            {
                                                "example_id": "24692526-b9c8-4a22-8a7b-c48da31c4fc6",
                                                "sense_id": "afc76c59-b9c4-3903-a18b-c610bcdfeb35",
                                                "text": "Cornish peppered mackerel, smoked haddock, Scottish herring and pearl-white skate wings are all laid on a bed of crushed ice at the fishmonger."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "598cf8ce-9895-3242-bc2e-50cd48a2c49f",
                                        "entry_id": "01c5c263-2ebf-334f-81e9-acedaa238d42",
                                        "glosses": [
                                            "A pimp."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "61db51ac-4ed3-48f4-8e8a-e11d288bcabe",
                                                "sense_id": "598cf8ce-9895-3242-bc2e-50cd48a2c49f",
                                                "text": "Excellent well; you are a fishmonger."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
