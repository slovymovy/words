                "senses": [
                    {
                        "sense_id": "3b6d0403-0c47-3dc1-b2ca-a183f68a0c13",
                        "entry_id": "6b8ec558-10ac-3d77-88fe-339f5f3fe460",
                        "glosses": [
                            "Qualifie un métal qui a été travaillé à la forge."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df5d0eb5-d2e8-454b-a153-5861bcbadeee",
                                "sense_id": "3b6d0403-0c47-3dc1-b2ca-a183f68a0c13",
                                "text": "Ce pont aboutissait à une magnifique grille en fer battu, vrai monument en serrurerie que l’on aurait cru façonné du propre marteau de Vulcain."
                            },
                            {
                                "example_id": "668e571a-488b-461d-a671-4c375d25945c",
                                "sense_id": "3b6d0403-0c47-3dc1-b2ca-a183f68a0c13",
                                "text": "Et les gens de Morgane entendirent un cri, et suivirent la princesse. Elle était agenouillée au milieu de la chambre murée, devant un plat de cuivre battu rempli de sang, et elle le regardait ardemment."
                            },
                            {
                                "example_id": "9d62f4b1-9cfe-4b25-9eaf-44c078db84a6",
                                "sense_id": "3b6d0403-0c47-3dc1-b2ca-a183f68a0c13",
                                "text": "[…] Des lézards, un serpent peut-être, qu’il s’attendait à tout instant à voir dégringoler parmi les assiettes de fer battu."
                            }
                        ]
                    },
                    {
                        "sense_id": "2f3c24ab-5426-3a66-b36e-2d98f6d6c891",
                        "entry_id": "6b8ec558-10ac-3d77-88fe-339f5f3fe460",
                        "glosses": [
