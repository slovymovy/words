{
    "word_family": [
        "instinctive",
        "instinctively",
        "instinctual"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "366ebd0e-2058-3907-9148-8f4fe1165296",
                    "sense_definition": "A natural or inherent impulse or behaviour that is not learned.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "natural_impulse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many animals know how to hunt and build homes by <w>instinct</w>.",
                            "target_lang_translations": {
                                "ru": "Многие животные умеют охотиться и строить жилища благодаря <w>инстинкту</w>.",
                                "zh": "许多动物凭借<w>本能</w>就知道如何捕猎和筑巢。"
                            }
                        },
                        {
                            "text": "A mother often has a strong maternal <w>instinct</w> to protect her child.",
                            "target_lang_translations": {
                                "ru": "Матери часто обладают сильным материнским <w>инстинктом</w> защищать своего ребёнка.",
                                "zh": "母亲往往有一种强烈的保护孩子的母性<w>本能</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "impulse",
                        "urge",
                        "drive"
                    ],
                    "common_phrases": [
                        "by instinct",
                        "survival instinct",
                        "maternal instinct",
                        "killer instinct"
                    ],
                    "target_lang_definitions": {
                        "ru": "Врождённый импульс или поведение, не являющееся приобретённым",
                        "zh": "一种非后天习得的、自然的或内在的冲动或行为。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "инстинкт",
                                "target_lang_sense_clarification": "врождённая способность"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "本能",
                                "target_lang_sense_clarification": "生物与生俱来的行为模式"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "62e5092b-0f6b-3b70-94af-1aa9c50aa093",
                    "sense_definition": "An intuitive reaction or feeling not based on rational conscious thought.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "intuition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My first <w>instinct</w> was to refuse the offer immediately.",
                            "target_lang_translations": {
                                "ru": "Моим первым <w>порывом</w> было немедленно отказаться от предложения.",
                                "zh": "我的第一<w>直觉</w>就是立刻拒绝这个提议。"
                            }
                        },
                        {
                            "text": "You should trust your <w>instincts</w> when you feel that something is wrong.",
                            "target_lang_translations": {
                                "ru": "Вам следует доверять своей <w>интуиции</w>, когда вы чувствуете, что что-то не так.",
                                "zh": "当你觉得不对劲时，你应该相信自己的<w>直觉</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "intuition",
                        "hunch",
                        "feeling"
                    ],
                    "antonyms": [
                        "reasoning",
                        "logic"
                    ],
                    "common_phrases": [
                        "gut instinct",
                        "trust your instincts",
                        "first instinct"
                    ],
                    "target_lang_definitions": {
                        "ru": "Интуитивная реакция или чувство, не основанное на рациональном мышлении",
                        "zh": "一种非基于理性意识思考的直觉反应或感觉。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "интуиция",
                                "target_lang_sense_clarification": "внутреннее чутьё"
                            },
                            {
                                "target_lang_word": "чутьё",
                                "target_lang_sense_clarification": "проницательность"
                            },
                            {
                                "target_lang_word": "инстинкт",
                                "target_lang_sense_clarification": "бессознательное влечение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "直觉",
                                "target_lang_sense_clarification": "不经逻辑推理的感悟"
                            },
                            {
                                "target_lang_word": "本能",
                                "target_lang_sense_clarification": "下意识的反应"
                            },
                            {
                                "target_lang_word": "第六感",
                                "target_lang_sense_clarification": "对事物的敏锐感觉"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0c0a4103-e2a0-3dd5-8182-adf599e5b37e",
                    "sense_definition": "Imbued or charged with a specific quality or feeling.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The atmosphere in the old house was <w>instinct</w> with mystery and fear.",
                            "target_lang_translations": {
                                "ru": "Атмосфера в старом доме была <w>преисполнена</w> тайны и страха.",
                                "zh": "老房子的氛围里<w>充满</w>了神秘与恐惧。"
                            }
                        },
                        {
                            "text": "Her performance was <w>instinct</w> with passion and deep emotion.",
                            "target_lang_translations": {
                                "ru": "Её выступление было <w>проникнуто</w> страстью и глубокими эмоциями.",
                                "zh": "她的表演<w>洋溢</w>着激情与深厚的情感。"
                            }
                        }
                    ],
                    "synonyms": [
                        "filled",
                        "imbued",
                        "charged"
                    ],
                    "antonyms": [
                        "void",
                        "devoid"
                    ],
                    "common_phrases": [
                        "instinct with"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "mostly found in literary contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Наполненный или проникнутый определённым качеством или чувством",
                        "zh": "充满或浸透了某种特定的品质或情感。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "преисполненный",
                                "target_lang_sense_clarification": "полный чего-либо"
                            },
                            {
                                "target_lang_word": "проникнутый",
                                "target_lang_sense_clarification": "наполненный чувством"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "充满",
                                "target_lang_sense_clarification": "形容状态或氛围"
                            },
                            {
                                "target_lang_word": "洋溢",
                                "target_lang_sense_clarification": "形容情感充沛"
                            }
                        ]
                    }
                }
            ]
        }
    ]
