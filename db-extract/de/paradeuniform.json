                    {
                        "sense_id": "8697bef9-7921-31ff-a45a-48a3e9eeaca3",
                        "entry_id": "153579e6-967d-37d8-8b25-8f2a6e31b6e3",
                        "glosses": [
                            "Uniform, die bei besonderen (feierlichen) Anlässen getragen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84bbce40-c94e-437d-ac9f-d9b155e7d6d4",
                                "sense_id": "8697bef9-7921-31ff-a45a-48a3e9eeaca3",
                                "text": "„Napoleon befahl, die Regimenter sollten in Paradeuniform durch die Stadt marschieren.“"
                            },
                            {
                                "example_id": "46a9fb48-1ca2-436b-a995-3dfd576d8c58",
                                "sense_id": "8697bef9-7921-31ff-a45a-48a3e9eeaca3",
                                "text": "„Rostow trat wieder in den Flur und sah, dass am Eingang schon eine Menge von Offizieren in voller Paradeuniform, darunter auch Generäle, stand, an denen er vorbeigehen musste.“"
                            }
                        ],
