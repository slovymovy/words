                "entry_id": "645b7d10-477d-3114-bab0-1bf34309ac10",
                "word": "nahebei",
                "pos": "adv",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e274b54f-3698-3bc6-900d-766ee497a01e",
                        "entry_id": "645b7d10-477d-3114-bab0-1bf34309ac10",
                        "glosses": [
                            "in geringer Entfernung (zu einer bestimmten Stelle), nicht weit (von einer bestimmten Stelle) entfernt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a06fadea-a2b0-42ce-9ba4-30259d007068",
                                "sense_id": "e274b54f-3698-3bc6-900d-766ee497a01e",
                                "text": "Steige in diesem Hotel ab, wenn du in Bitterfeld bist. Der Bahnhof ist nahebei und du hast kurze Wege."
                            },
                            {
                                "example_id": "332c8a18-3a20-4588-ac5d-f6ba15216646",
                                "sense_id": "e274b54f-3698-3bc6-900d-766ee497a01e",
                                "text": "Wir fanden einen idyllischen Campingplatz mit einem Naturfreibad nahebei."
                            },
                            {
                                "example_id": "edac92f0-45fd-46aa-a190-a597410e78bf",
                                "sense_id": "e274b54f-3698-3bc6-900d-766ee497a01e",
                                "text": "Zum Glück wohnt mein Schwager nahebei, so dass er schnell bei den Schwiegereltern ist, wenn sie Hilfe brauchen."
                            },
                            {
                                "example_id": "aab6d471-b796-44c3-83e8-2e29fb3f23c6",
                                "sense_id": "e274b54f-3698-3bc6-900d-766ee497a01e",
                                "text": "„Etwas südlich der Gruppe befindet sich der Candi Gatotkaca und nahebei das archäologische Museum Dieng Kailosa.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "14824417-fe27-3175-996c-b97d3f53ec42",
                        "entry_id": "645b7d10-477d-3114-bab0-1bf34309ac10",
                        "glosses": [
                            "nicht ganz (aber fast vollständig)"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "939694d9-8877-4893-8e96-e6ac4eaea214",
                                "sense_id": "14824417-fe27-3175-996c-b97d3f53ec42",
                                "text": "Der Wirt schenkte nahebei alle Sorten Mostes aus."
                            },
                            {
                                "example_id": "97eb9a3c-1805-4ba3-a617-215d1efd139a",
                                "sense_id": "14824417-fe27-3175-996c-b97d3f53ec42",
                                "text": "Nahebei das ganze Dorf befragte der Gesandte auf der Suche nach dem berühmten Heiler."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
