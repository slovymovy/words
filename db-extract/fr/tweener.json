                        "translation_id": "61bfcac7-8aad-451a-ad59-aa92a5e9c624",
                        "source_entry_id": "e8151056-2d75-342b-bfd3-058b58107c17",
                        "target_lang_word": "tweener",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tweener",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "27d2dccf-37fc-3677-a210-eb3ba0d949fa",
                                        "entry_id": "28816d51-6a99-3f4b-baea-6995706bf7a9",
                                        "glosses": [
                                            "Alternative spelling of 'tweener,"
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ff07aede-c8c9-39c2-880b-8d4f4a29f208",
                                        "entry_id": "28816d51-6a99-3f4b-baea-6995706bf7a9",
                                        "glosses": [
                                            "A tweenager."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5964611b-1fb9-49f0-916e-d3c5b2cd614a",
                                                "sense_id": "ff07aede-c8c9-39c2-880b-8d4f4a29f208",
                                                "text": "But a half-dozen other movies geared toward the teenage and 'tween girl market – 'tweeners are girls from 8 to 12 years old – have failed to make more than a slight dent at the box office."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6467dd85-c13c-3922-aacb-cb8d09718a24",
                                        "entry_id": "28816d51-6a99-3f4b-baea-6995706bf7a9",
                                        "glosses": [
                                            "A person or thing that is between two categories, classes or age groups."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8992124f-49e4-46dd-b762-c8f7d5b5d04b",
                                                "sense_id": "6467dd85-c13c-3922-aacb-cb8d09718a24",
                                                "text": "I assigned one of my groups of heart patients the task of sorting a hundred art reproductions into three piles: beautiful, in between, and ugly. The five men sat down to begin work. The first few paintings were easily classified and group decision was rapid. As they progressed, however, one of the men commented, “I think this one is sort of a tweener.”"
                                            },
                                            {
                                                "example_id": "0f0eb7b0-997f-4ed3-a9b3-ab9e887c17cc",
                                                "sense_id": "6467dd85-c13c-3922-aacb-cb8d09718a24",
                                                "text": "Right now, Mr. Ryan's attention is on the \"tweeners,\" savings and loans that are not obviously \"brain dead,\" in regulatory parlance, and that at the same time are not clear winners – a group with $247 billion in assets."
                                            },
                                            {
                                                "example_id": "77bfee87-35c6-46e4-8650-a2e5e4aab384",
                                                "sense_id": "6467dd85-c13c-3922-aacb-cb8d09718a24",
                                                "text": "So BMW has conjured a tweener — a roomier hatchback on platform shoes, with standard all-wheel drive — to attract customers who crave the 3 Series’ performance but need more utility to close the deal."
                                            },
                                            {
                                                "example_id": "2cd0fdaa-0fae-40dd-8bde-6cd6a4993c61",
                                                "sense_id": "6467dd85-c13c-3922-aacb-cb8d09718a24",
                                                "text": "Scout is old enough that her traveling dynamic with Sam isn’t the kid-adult one of “Paper Moon”; it’s more like a tweener with a crush on a college man."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e9c64a23-294f-3ce8-9f84-015936c50251",
                                        "entry_id": "28816d51-6a99-3f4b-baea-6995706bf7a9",
                                        "glosses": [
                                            "A person or thing that is between two categories, classes or age groups.",
                                            "A person who plays at two positions, especially if not good enough at either to be restricted to it."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57198ff2-0375-48df-8445-0ac5eaafa74a",
                                                "sense_id": "e9c64a23-294f-3ce8-9f84-015936c50251",
                                                "text": "Crowder was 6-foot-6 and 230 pounds, so those scouts naturally called him a tweener — a power forward in a wing player’s body. The Celtics forward admits to even going along with the stereotype."
                                            },
                                            {
                                                "example_id": "2942fac9-941a-498f-a50c-20003e7b7a90",
                                                "sense_id": "e9c64a23-294f-3ce8-9f84-015936c50251",
                                                "text": "“Isaac plays fast, never stops,” said Coach Parker, who labels him as “a tweener.” ¶ That means he’s big and strong enough to take care of business in the middle of the line, and quick and agile enough to cover the flanks and harass the quarterback."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89f1e2e0-a539-38eb-a0f4-0d622a58b8ae",
                                        "entry_id": "28816d51-6a99-3f4b-baea-6995706bf7a9",
                                        "glosses": [
                                            "A person or thing that is between two categories, classes or age groups.",
                                            "A computing device that is smaller than a traditional laptop, but larger than a PDA."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dbf78578-12d3-4810-97d2-e6f4855711ed",
                                                "sense_id": "89f1e2e0-a539-38eb-a0f4-0d622a58b8ae",
                                                "text": "Trailing a little behind that in hype are the ’tweeners: the larger-format Windows CE Palm Pro portables. They’re not quite notebooks or subnotebooks, but they’re bigger than handhelds."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2eee7e5a-cd9a-392c-8bb1-309a9dc3ac94",
                                        "entry_id": "28816d51-6a99-3f4b-baea-6995706bf7a9",
                                        "glosses": [
                                            "A person or thing that is between two categories, classes or age groups.",
                                            "A boxer in various newcomer weight classes whose names often contain super, light or junior."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1186f4ca-10b8-4fce-a893-ebe6c1c04aea",
                                                "sense_id": "2eee7e5a-cd9a-392c-8bb1-309a9dc3ac94",
                                                "text": "Undoubtedly, his record versus welterweights (147 pounds) is better than against full-blown middleweights (160 pounds). Being a tweener, Graziano probably would have campaigned as a junior middleweight (154 pounds) if he fought today."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "81ecdb4f-5d53-3e13-90f6-00f3091dd827",
                                        "entry_id": "28816d51-6a99-3f4b-baea-6995706bf7a9",
                                        "glosses": [
                                            "A person or thing that is between two categories, classes or age groups.",
                                            "A professional wrestler who is neutral or morally ambiguous; neither a face nor a heel, or showing no favoritism to either allegiance."
                                        ],
                                        "tags": [
                                            "informal",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3dac84fd-9df4-4ba0-a393-89c7940af7b1",
                                                "sense_id": "81ecdb4f-5d53-3e13-90f6-00f3091dd827",
                                                "text": "There are old-school wrestlers, submission wrestlers, hardcore wrestlers, hillbilly wrestlers, masked Mexican lucha libre wrestlers, shoot wrestlers, and wrestlers who just talk a lot and never actually wrestle. There are babyfaces (good guys), heels (bad guys), ’tweeners, and crossovers."
                                            },
                                            {
                                                "example_id": "69430f80-e57d-4757-b6bf-5ed94c3440e5",
                                                "sense_id": "81ecdb4f-5d53-3e13-90f6-00f3091dd827",
                                                "text": "When Crockett hit TBS, [Ric] Flair was a babyface within its territory, but a heel in the areas he visited as champion, so it compromised, and on TBS, he became a “tweener” who took on all comers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4116912b-9c5b-3f88-8b76-40e350611b93",
                                        "entry_id": "28816d51-6a99-3f4b-baea-6995706bf7a9",
                                        "glosses": [
                                            "A person or thing that is between two categories, classes or age groups.",
                                            "A film that falls between two genres or audiences (and thus may not be easily marketed)."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f93c543e-5bec-4496-b9f0-9f31a7fdc13f",
                                                "sense_id": "4116912b-9c5b-3f88-8b76-40e350611b93",
                                                "text": "With a less bankable cast, “Cold Mountain” became an $80-million-plus “tweener,” neither a blockbuster studio movie nor a modest “indiewood” production like “Lost in Translation.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df8605b5-0c82-31db-aecd-5a56a2adf96e",
                                        "entry_id": "28816d51-6a99-3f4b-baea-6995706bf7a9",
                                        "glosses": [
                                            "A shot that is hit between the legs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7fb15161-078c-456f-8dfe-ec415f9d4ce0",
                                                "sense_id": "df8605b5-0c82-31db-aecd-5a56a2adf96e",
                                                "text": "The No 2 seed dismissed the challenge of the world No 82, Panna Udvardy of Hungary, in just over an hour with eight aces, 27 winners and even a tweener, treating the crowd to her power and athleticism on her return to Wimbledon after missing the event last year because of the ban on Russians and Belarusians competing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "440aaa80-2fa1-36d3-9475-c081b3bd001a",
                                        "entry_id": "28816d51-6a99-3f4b-baea-6995706bf7a9",
                                        "glosses": [
                                            "A person, machine, or piece of software that performs tweening."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a4f5b2a-ceeb-4103-8949-9b980dd2ceae",
                                                "sense_id": "440aaa80-2fa1-36d3-9475-c081b3bd001a",
                                                "text": "While it lacks true function curves for complete control of tweening, Carrara has several kinds of tweeners that allow decent control of object movement between keyframes (the Spline and Velocity Graph tweeners are most useful)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
