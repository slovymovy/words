                ],
                "senses": [
                    {
                        "sense_id": "68f30572-c5a6-3fcd-826f-854c06f01614",
                        "entry_id": "60c1c2d3-b4e2-3b93-a5a1-27478fedcc7e",
                        "glosses": [
                            "Unternehmen, das Kleidungsstücke besonders zügig (meist chemisch) säubert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e30bf85-ea4a-4519-820e-755136ac2afe",
                                "sense_id": "68f30572-c5a6-3fcd-826f-854c06f01614",
                                "text": "In unserer Straße hat eine neue Schnellreinigung aufgemacht."
                            },
                            {
                                "example_id": "f2c6bc11-11a5-4ced-87a3-c0898387a84f",
                                "sense_id": "68f30572-c5a6-3fcd-826f-854c06f01614",
                                "text": "„Laut Quittung ließ sie Ende Januar 1963 in der Schnellreinigung „Fix“ einen Kissenbezug, einen Wandbehang und einen Bademantel reinigen.“"
                            },
                            {
                                "example_id": "88d672cf-6ee0-428c-a33a-4141c656eb70",
                                "sense_id": "68f30572-c5a6-3fcd-826f-854c06f01614",
                                "text": "„Funktionäre von Gastgeber Galatasaray klingelten […] zu später Stunde die Belegschaft einer Istanbuler Schnellreinigung aus den Betten, um die Trikots waschen zu lassen.“"
                            },
                            {
                                "example_id": "2a932474-cd5f-4ae3-9b64-fa6beeee2f4d",
                                "sense_id": "68f30572-c5a6-3fcd-826f-854c06f01614",
                                "text": "„[Der Journalist Seymour] Hersh führt die Schnellreinigung seines Vaters in einem Schwarzenviertel […]“"
                            },
                            {
                                "example_id": "f8a89320-5d40-4789-9f58-77fe58158023",
                                "sense_id": "68f30572-c5a6-3fcd-826f-854c06f01614",
                                "text": "„Er erzählt, wie sich der schmächtige 26-jährige Computerspiele-Entwickler Robert in Monika verliebt, die einen halben Kopf größer, 15 Jahre älter und Angestellte in einer Schnellreinigung ist.“"
                            },
                            {
                                "example_id": "419812e4-ce5f-49db-ba0a-f398bf6e588d",
                                "sense_id": "68f30572-c5a6-3fcd-826f-854c06f01614",
                                "text": "„Der Gewerkschafter und Betriebsratsvorsitzende einer Friedrichshafener Firma gab, da er nebenher eine Schnellreinigung betrieb, gegenüber der Landtagsverwaltung an, er beziehe seine Einkünfte überwiegend als \"selbständiger Kaufmann\".“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
