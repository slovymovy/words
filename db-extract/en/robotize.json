                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9b3f13e6-d0b7-4cc2-93b8-995634157f59",
                        "source_entry_id": "b507e113-00bd-39db-8124-9a6a75173607",
                        "source_sense_description": "to automate by making use of robots",
                        "target_lang_word": "roboterisieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "roboterisieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "af84eb17-7d7c-33f4-8d58-b0259d86ca75",
                                        "entry_id": "7f052947-965b-3f28-9590-aac11dd9bf33",
                                        "glosses": [
                                            "Robotertechnik in der Produktion, bei Dienstleistungen und in der Verwaltung einführen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02bb216d-7f47-4fde-8e94-bd49fa4f061a",
                                                "sense_id": "af84eb17-7d7c-33f4-8d58-b0259d86ca75",
                                                "text": "„Microsoft ist meiner Ansicht nach erst am Anfang seiner Wachstumsambitionen‘, ist Leber überzeugt, ‚solange Menschen mit einem PC ihre Arbeit verrichten, müssen diese PCs verbunden werden, müssen Videomeetings abgehalten und Standardabläufe roboterisiert werden.“"
                                            },
                                            {
                                                "example_id": "c279b3a5-cfa9-480a-a5b0-7f760b49f349",
                                                "sense_id": "af84eb17-7d7c-33f4-8d58-b0259d86ca75",
                                                "text": "„Im Jahr 2021 soll ein BMW mit dem Modellnamen iNext elektrisch wie roboterisiert herumfahren.“"
                                            },
                                            {
                                                "example_id": "f3d6e972-934f-49e0-8237-9a5b0bb5bc64",
                                                "sense_id": "af84eb17-7d7c-33f4-8d58-b0259d86ca75",
                                                "text": "„Wichtig ist, dass Menschen in manchen Berufen so roboterisiert worden sind, dass man sie erst wieder menschlich machen muss.“"
                                            },
                                            {
                                                "example_id": "4e7129d3-d952-4372-abc2-b7185b704ac5",
                                                "sense_id": "af84eb17-7d7c-33f4-8d58-b0259d86ca75",
                                                "text": "„Glyphosat in Alternativlosigkeit existiert doch nur, weil man die Landwirtschaft maximal ‚roboterisiert‘ hat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5059168e-b794-4b14-8610-d0822d725ff9",
                        "source_entry_id": "b507e113-00bd-39db-8124-9a6a75173607",
                        "source_sense_description": "to automate by making use of robots",
                        "target_lang_word": "robotisieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "robotisieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b2568bea-08ed-3c8f-9a63-1a401f571f1a",
                                        "entry_id": "60d494fd-775e-3459-b3f2-eb0f726652e9",
                                        "glosses": [
                                            "Robotertechnik in der Produktion, bei Dienstleistungen und in der Verwaltung einführen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a95581b8-5006-4297-8f60-7da92c1509cf",
                                                "sense_id": "b2568bea-08ed-3c8f-9a63-1a401f571f1a",
                                                "text": "„‚Henn Na‘-Hotel heißt so viel wie ‚seltsames Hotel‘ auf Japanisch, und ‚seltsam‘ ist das Mindeste, was man darüber sagen kann, denn alles in diesem Hotel ist robotisiert: Das Essen kommt aus einem Essensroboter, das Gepäck wird von einem Roboter aufs Zimmer gebracht, und an der Rezeption sitzen Roboter in Form einer Androiden oder eines Dinosauriers, wobei die Kunden, wenn ihr System mal wieder abstürzt, mehr Geduld mit der netten Frau als mit dem Dinosaurier haben, ein nicht funktionierender Dino-Roboter macht aggressiv, der Kunde denkt sofort, du da mit deinem albernen Reptilienmaul bist nicht umsonst ausgestorben, und nimmt sich ein anderes Hotel.“"
                                            },
                                            {
                                                "example_id": "de4b6ab5-513c-4073-8df4-3914fbc8a49d",
                                                "sense_id": "b2568bea-08ed-3c8f-9a63-1a401f571f1a",
                                                "text": "„Während der zweiten zu Beginn des 20. Jahrhunderts habe man die im System der Maschinen tätige Arbeitskraft rationalisiert, ‚gleichsam robotisiert‘.“"
                                            },
                                            {
                                                "example_id": "30f77c92-7716-4c97-8565-c3aa99508fa6",
                                                "sense_id": "b2568bea-08ed-3c8f-9a63-1a401f571f1a",
                                                "text": "„Die Klangflächen pumpen sich in Dubstep-Manier voran, als hätten sie Schluckauf, Karlos Gesang ist fragmentiert darüber gesetzt und die Backgroundstimmen wurden mittels Autotune ordentlich robotisiert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
