                        "sense_id": "49b49efb-6c7a-3d65-a296-063d8ef924eb",
                        "entry_id": "f9172e13-b369-3e59-a508-0a5cdece147e",
                        "glosses": [
                            "S’éteindre de nouveau."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "f57e782f-5e79-4c84-b0aa-5335d1c30d20",
                                "sense_id": "49b49efb-6c7a-3d65-a296-063d8ef924eb",
                                "text": "La bougie s’est encore rééteinte à cause du vent."
