                    {
                        "translation_id": "d7307440-811a-4556-ae06-ce8bd06b028b",
                        "source_entry_id": "9141d49d-0a9b-34f5-9baa-e9e6c5bfcaa0",
                        "source_sense_description": "relating to the conversion of heat",
                        "target_lang_word": "thermodynamique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "thermodynamique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c414b975-a402-368e-836f-1494978efa07",
                                        "entry_id": "38bcfcfd-c7b4-3a97-82cf-ebc5b9608356",
                                        "glosses": [
                                            "Relatif à la force produite par la chaleur."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fccb42af-106b-4ce9-9c74-5aa4f5d1f87e",
                                                "sense_id": "c414b975-a402-368e-836f-1494978efa07",
                                                "text": "Un équilibre thermodynamique."
                                            },
                                            {
                                                "example_id": "c5178a20-b103-4521-a83b-3ed1202a6d68",
                                                "sense_id": "c414b975-a402-368e-836f-1494978efa07",
                                                "text": "— recourir à des solutions qui utilisent une énergie gratuite, tels les chauffe-eaux thermodynamiques ou solaires."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "thermodynamique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7cb4305c-ad32-3ac4-bb78-66aff4999e7f",
                                        "entry_id": "8a8ed5e1-09ab-3463-b2b8-927252021cc8",
                                        "glosses": [
                                            "Discipline étudiant l’énergie physique et les changements d’état de la matière."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee36dd8c-4733-4453-95f3-b7a2bad26f65",
                                                "sense_id": "7cb4305c-ad32-3ac4-bb78-66aff4999e7f",
                                                "text": "Philippe Bourke, président du Bureau d’audiences publiques sur l’environnement (BAPE), en entrevue à Qub, hier, soulignait que l’expression « élimination des déchets » est « problématique ». Les règles de la thermodynamique demeurent…, souriait M. Bourke : « Rien ne se perd, rien ne se crée, tout se transforme »."
                                            },
                                            {
                                                "example_id": "635f2252-02a3-414f-b579-ecbde1ab3b35",
                                                "sense_id": "7cb4305c-ad32-3ac4-bb78-66aff4999e7f",
                                                "text": "La thermodynamique comprend l'étude des corps en tenant compte de l’influence de la température sur leurs caractéristiques."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fa8a5ca1-3fa0-40a4-aefc-1a00f9b0a259",
                        "source_entry_id": "9141d49d-0a9b-34f5-9baa-e9e6c5bfcaa0",
                        "source_sense_description": "relating to the conversion of heat",
                        "target_lang_word": "thermodynamisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "thermodynamisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c863f99f-19cf-3c19-bf12-4f3182ad4157",
                                        "entry_id": "e3094d13-16ae-3f41-a76d-129f5d421e4e",
                                        "glosses": [
                                            "die Thermodynamik betreffend; auf ihr beruhend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1be7775-30b1-4119-b7bd-545e2a841299",
                                                "sense_id": "c863f99f-19cf-3c19-bf12-4f3182ad4157",
                                                "text": "„Die innere Energie U ist die gesamte für thermodynamische Umwandlungsprozesse zur Verfügung stehende Energie eines physikalischen Systems, das sich in Ruhe und im thermodynamischen Gleichgewicht befindet.“"
                                            },
                                            {
                                                "example_id": "c57a667e-6a1e-4bc5-a1d6-048e236436fe",
                                                "sense_id": "c863f99f-19cf-3c19-bf12-4f3182ad4157",
                                                "text": "„Ein thermodynamisches System ist ein räumlich eingegrenzt betrachtetes physikalisches System, für das eine Energiebilanz – beim offenen System zusammen mit einer Stoffbilanz – erstellt werden kann.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
