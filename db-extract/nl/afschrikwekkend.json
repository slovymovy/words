                        "glosses": [
                            "schrik veroorzakend waardoor het handelen van iemand beïnvloed wordt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db8962ee-878d-4045-a3c8-2de0d45f405d",
                                "sense_id": "b255cd39-4619-365f-8926-0840bb6f0215",
                                "text": "Op zijn gezicht lag een vileine glimlach, waardoor het litteken op zijn linkerwang er nog afschrikwekkender uitzag."
                            },
                            {
                                "example_id": "3281d60f-e6e5-4cdb-820c-018b24c06287",
                                "sense_id": "b255cd39-4619-365f-8926-0840bb6f0215",
                                "text": "De kernwapens van Rusland zijn zeer afschrikwende wapens voor Groot-Brittanië, Frankrijk en de VS."
                            }
                        ]
                    }
