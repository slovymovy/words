{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "aadfabd6-e1e2-3273-944b-810f522fd0c5",
                    "sense_definition": "Een toestel dat doorstromend water verwarmt voor huishoudelijk gebruik, meestal werkend op gas of elektriciteit.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "apparaat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De waakvlam van de <w>geiser</w> in de keuken moet blijven branden.",
                            "target_lang_translations": {
                                "ru": "Запальник <w>газовой колонки</w> на кухне должен продолжать гореть."
                            }
                        },
                        {
                            "text": "In het oude appartement werd het warme water nog verwarmd door een <w>geiser</w>.",
                            "target_lang_translations": {
                                "ru": "В старой квартире горячая вода всё ещё нагревалась с помощью <w>газовой колонки</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "doorstroomverwarmer"
                    ],
                    "common_phrases": [
                        "oude geiser"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прибор для нагрева проточной воды для бытовых нужд, чаще всего работающий на газе или электричестве."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "газовая колонка",
                                "target_lang_sense_clarification": "проточный водонагреватель на газе"
                            },
                            {
                                "target_lang_word": "проточный водонагреватель",
                                "target_lang_sense_clarification": "общее техническое название"
                            },
                            {
                                "target_lang_word": "колонка",
                                "target_lang_sense_clarification": "разговорное название бытового водонагревателя"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2d4d309c-4b18-3dac-b6fd-e62a8d49ca41",
                    "sense_definition": "Een natuurlijke heetwaterbron die op gezette tijden heet water en stoom metershoog de lucht in spuit.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "natuur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tijdens hun reis door IJsland bezochten ze een beroemde actieve <w>geiser</w>.",
                            "target_lang_translations": {
                                "ru": "Во время своего путешествия по Исландии они посетили знаменитый действующий <w>гейзер</w>."
                            }
                        },
                        {
                            "text": "De toeristen stonden te wachten tot de <w>geiser</w> plotseling water omhoog spoot.",
                            "target_lang_translations": {
                                "ru": "Туристы стояли в ожидании, пока <w>гейзер</w> внезапно не выбросит воду вверх."
                            }
                        }
                    ],
                    "synonyms": [
                        "springbron"
                    ],
                    "common_phrases": [
                        "actieve geiser"
                    ],
                    "target_lang_definitions": {
                        "ru": "Природный горячий источник, периодически выбрасывающий фонтаны горячей воды и пара на большую высоту."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гейзер",
                                "target_lang_sense_clarification": "природный горячий источник"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}