        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4bce7dc6-53a2-3d07-9388-a6556159f9dd",
                    "sense_definition": "To make someone feel angry or annoyed.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "cause_emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The unfair decision <w>angered</w> the entire staff.",
                            "target_lang_translations": {
                                "ru": "Несправедливое решение <w>разозлило</w> весь персонал.",
                                "de": "Die ungerechte Entscheidung <w>ärgerte</w> das gesamte Personal.",
                                "zh": "这个不公平的决定<w>激怒</w>了全体员工。",
                                "nl": "Het oneerlijke besluit <w>maakte</w> het hele personeel <w>boos</w>.",
                                "pl": "Niesprawiedliwa decyzja <w>rozzłościła</w> cały personel."
                            }
                        },
                        {
                            "text": "It <w>angers</w> me when people are rude to waiters.",
                            "target_lang_translations": {
                                "ru": "Меня <w>злит</w>, когда люди грубы с официантами.",
                                "de": "Es <w>ärgert</w> mich, wenn Leute unhöflich zu Kellnern sind.",
                                "zh": "当人们对服务员无礼时，这让我感到<w>生气</w>。",
                                "nl": "Het <w>maakt</w> me <w>boos</w> wanneer mensen onbeleefd zijn tegen obers.",
                                "pl": "<w>Złości</w> mnie, gdy ludzie są nieuprzejmi wobec kelnerów."
                            }
                        }
                    ],
                    "synonyms": [
                        "enrage",
                        "infuriate",
                        "annoy",
                        "irritate",
                        "vex",
                        "displease",
                        "aggravate",
                        "madden",
                        "upset"
                    ],
                    "common_phrases": [
                        "anger someone",
                        "easily angered"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывать у кого-либо чувство злости или раздражения.",
                        "de": "Jemanden dazu bringen, sich über etwas zu ärgern oder verärgert zu sein.",
                        "zh": "使某人感到生气或烦恼。",
                        "nl": "Iemand een gevoel van boosheid of irritatie geven.",
                        "pl": "Sprawiać, że ktoś czuje się zły lub zirytowany."
                    },
                    "translations": {
