                                "target_lang_word": "próbować",
                                "target_lang_sense_clarification": "podejmować próbę"
                            },
                            {
                                "target_lang_word": "starać się",
                                "target_lang_sense_clarification": "dokładać starań"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "87c00151-1113-3618-9cb7-6e700b0d9884",
                    "sense_definition": "Difficult to endure; requiring great effort, patience, or stamina.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "difficult_annoying",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hikers faced a long and <w>trying</w> journey through the mountains.",
                            "target_lang_translations": {
                                "ru": "Туристов ждало долгое и <w>трудное</w> путешествие через горы.",
                                "pl": "Wędrowcy stanęli przed długą i <w>trudną</w> podróżą przez góry."
                            }
                        },
                        {
                            "text": "It was a <w>trying</w> time for the family while they waited for the news.",
                            "target_lang_translations": {
                                "ru": "Это было <w>тяжёлое</w> время для семьи, пока они ждали новостей.",
                                "pl": "To był <w>ciężki</w> czas dla rodziny, gdy czekali na wieści."
                            }
                        }
                    ],
