                "translations": [
                    {
                        "translation_id": "befa2971-dc3a-4ac9-815a-72d57e951575",
                        "source_entry_id": "b14dfdf9-d946-33c2-9ae9-a265c715d2a0",
                        "source_sense_description": "showing wickedness typical of a devil",
                        "target_lang_word": "ďábelský",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ďábelský",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "e875d838-ca9c-3c20-a596-d656a3755440",
                                        "entry_id": "3431251a-955d-359d-8d02-11c3ed18d98e",
                                        "glosses": [
                                            "ďáblův; související s ďáblem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "471fd3f1-fd81-4f84-b476-2a067e7d0aee",
                                                "sense_id": "e875d838-ca9c-3c20-a596-d656a3755440",
                                                "text": "Nebudu popírat, že jsem si Dirka van Rijsewijka představoval jako zvráceného satanistu, ďábelského elegána se stříbrnými nitkami ve vlasech a špičatými nehty, jak sedí v koženém ušáku obklopen černými svícemi, kočkami a polonahými otrokyněmi připravenými při sebemenším náznaku vyhovět jeho lačným choutkám."
                                            },
                                            {
                                                "example_id": "464288a5-cac0-4518-919c-1f430a64db5c",
                                                "sense_id": "e875d838-ca9c-3c20-a596-d656a3755440",
                                                "text": "Jednou dokonce někdo z nich vyhnal z vesnice zmrzlináře, ale ještě před tím mu nalil do zmrzliny petrolej, aby se ve vesnici se svými ďábelskými svody už neodvážil ukázat. Babička Toňa takové morální zásady neměla. Vůbec byla v ideologických otázkách blíže Jicchakovi než Mošemu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3894d1f0-8692-3e4d-a787-6a2d5304ceda",
                                        "entry_id": "3431251a-955d-359d-8d02-11c3ed18d98e",
                                        "glosses": [
                                            "zlý, zlomyslný"
                                        ],
                                        "tags": [
                                            "expressively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "69ed28a8-89d3-4bbf-b795-605866aa9c34",
                                                "sense_id": "3894d1f0-8692-3e4d-a787-6a2d5304ceda",
                                                "text": "Málo se ví o tom, že malá skupina spojeneckých pilotů se ocitla v tom nejďábelštějším Hitlerově systému likvidace lidí."
                                            },
                                            {
                                                "example_id": "84bd9b15-515b-4969-8f18-122162a52422",
                                                "sense_id": "3894d1f0-8692-3e4d-a787-6a2d5304ceda",
                                                "text": "„Jenže hezké řeči a silácké výhružky nám nepomohou, Vaše Excelence, když on zapírá,“ vzdychl Pálffy a jeho napjatá tvář prozrazovala velké rozpaky. „Máme před sebou hlavu ďábelského spolku – tento muž je zodpovědný za všechny ohavnosti a ještě píše výhružná psaní! Proč ho hned na místě nepopravíme?“"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60b8fc3e-7c3f-3bee-937c-46144ec08bbd",
                                        "entry_id": "3431251a-955d-359d-8d02-11c3ed18d98e",
                                        "glosses": [
                                            "divoký, prudký, nespoutaný"
                                        ],
                                        "tags": [
                                            "expressively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c0f1e92-54c9-469c-b7b5-841ae292e36b",
                                                "sense_id": "60b8fc3e-7c3f-3bee-937c-46144ec08bbd",
                                                "text": "Vlahým nočním vzduchem stoupaly výbuchy smíchu. Páry se vytřásaly pod stanem v rytmu ďábelského charlestonu. Třásně na šatech poletovaly kolem štíhlých stehen tanečnic, jejich dlouhé útlé paže vířily, zatímco jejich kavalíři se více či méně úspěšně snažili zachovat tempo paží i nohou."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9c74bf84-ba53-49d0-839d-370d2207c431",
                        "source_entry_id": "b14dfdf9-d946-33c2-9ae9-a265c715d2a0",
                        "source_sense_description": "showing wickedness typical of a devil",
                        "target_lang_word": "diabolique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "diabolique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "70869882-5613-33c1-96a5-1df8e45b7d6d",
                                        "entry_id": "f0586ab6-c52d-3ae4-882f-52539e870054",
                                        "glosses": [
                                            "Qui est relatif au diable, qui vient du diable, qui ressemble au diable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0e93434-f0db-4ab6-9dbc-d16d343d4824",
                                                "sense_id": "70869882-5613-33c1-96a5-1df8e45b7d6d",
                                                "text": "Jamais, peut-être, pareille orgie ne s'était déroulée à la face du ciel depuis les tristes âges du paganisme, et, si je n'avais été prévenu, je me serais cru transporté par un songe diabolique dans les sentines de Suburre, dans les lupanars de Capoue."
                                            },
                                            {
                                                "example_id": "94d62a6a-abab-4f24-9422-72014e64f280",
                                                "sense_id": "70869882-5613-33c1-96a5-1df8e45b7d6d",
                                                "text": "Comment, avec une force numérique aussi faible, résister aux Indiens dont il voyait les diaboliques silhouettes se dessiner fantastiquement aux reflets sinistres de l’incendie ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f40de0eb-854f-3f50-997f-cae6ce9da65a",
                                        "entry_id": "f0586ab6-c52d-3ae4-882f-52539e870054",
                                        "glosses": [
                                            "Qui est extrêmement méchant, pernicieux dans son genre."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62d6030d-7eff-43a1-9138-a7cea946e49d",
                                                "sense_id": "f40de0eb-854f-3f50-997f-cae6ce9da65a",
                                                "text": "En prenant position devant madame Mignon, madame Latournelle avait, avec sa diabolique intelligence de dévote, isolé Modeste."
                                            },
                                            {
                                                "example_id": "a7545de9-6787-4356-b715-d3f3a410e752",
                                                "sense_id": "f40de0eb-854f-3f50-997f-cae6ce9da65a",
                                                "text": "La lampe éteinte, Félicité ne put dormir. Les yeux fermés, elle faisait de merveilleux châteaux en Espagne. Les vingt mille francs de rente dansaient devant elle, dans l’ombre, une danse diabolique. Elle habitait un bel appartement de la ville neuve, avait le luxe de M. Peirotte, donnait des soirées, éclaboussait de sa fortune la ville entière. Ce qui chatouillait le plus ses vanités, c’était la belle position que son mari occuperait alors."
                                            },
                                            {
                                                "example_id": "938e071f-c128-4021-972a-547847673f25",
                                                "sense_id": "f40de0eb-854f-3f50-997f-cae6ce9da65a",
                                                "text": "J'accuse, en un mot, reprit-il, j'accuse la ballerine nommée Mirabelle d'avoir machiné une intrigue diabolique dans le but d'entraîner à l'abîme une âme que tant de soins et de piété paternelle avaient conservée à l'état de candeur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c21a54f-3c1f-3a2b-8086-de11872df328",
                                        "entry_id": "f0586ab6-c52d-3ae4-882f-52539e870054",
                                        "glosses": [
                                            "Qui est très difficile, très pénible, très dangereux."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b17bc620-f96b-481e-a0dc-030f5f5bef80",
                                                "sense_id": "5c21a54f-3c1f-3a2b-8086-de11872df328",
                                                "text": "C’est un travail diabolique. Il nous a menés par un chemin diabolique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
