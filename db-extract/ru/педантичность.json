                "senses": [
                    {
                        "sense_id": "893f911d-e411-3ab5-ae0a-f5b6bcd1668c",
                        "entry_id": "3670f95a-dc2c-349e-94d9-bfbb6c4060aa",
                        "glosses": [
                            "свойство по значению прилагательного педантичный; предельная точность и аккуратность в каких-либо действиях; чрезмерная склонность к соблюдению формальных требований, правил и т. п."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e14db2e-0784-4e3e-a0c0-c087b6005b92",
                                "sense_id": "893f911d-e411-3ab5-ae0a-f5b6bcd1668c",
                                "text": "Его благоразумие, педантичность и даже доброжелательство раздражали меня."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "85e44cec-dcbd-484e-97ea-82c058a0bc2b",
                        "source_entry_id": "3670f95a-dc2c-349e-94d9-bfbb6c4060aa",
                        "source_sense_id": "893f911d-e411-3ab5-ae0a-f5b6bcd1668c",
                        "target_lang_word": "pedantry",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pedantry",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e664e272-77f7-3945-9b37-6747f0689e31",
                                        "entry_id": "d2578e1b-26a2-37c4-b7aa-4326cda2f24c",
                                        "glosses": [
                                            "An excessive attention to detail or rules."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "440fcc26-1bb8-42c1-8f87-1df7780b3b76",
                                                "sense_id": "e664e272-77f7-3945-9b37-6747f0689e31",
                                                "text": "Another point on which Smart insists is the distinction between serf and surf […] A distinction can of course be made, and without much difficulty, by those who think of it, and is made by those who have formed a habit of doing so; but the distinction is so rarely made as to amount almost to pedantry […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1bfb6ecb-234c-3b56-93b3-482db8f2a6d9",
                                        "entry_id": "d2578e1b-26a2-37c4-b7aa-4326cda2f24c",
                                        "glosses": [
                                            "An excessive attention to detail or rules.",
                                            "An instance of such behaviour."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "648f5406-c109-43db-8ae5-c2403e4d369c",
                                                "sense_id": "1bfb6ecb-234c-3b56-93b3-482db8f2a6d9",
                                                "text": "I don’t want to listen to your pedantries anymore."
                                            },
                                            {
                                                "example_id": "aa0e6c1d-0a40-4725-83f6-7e22d9fa7729",
                                                "sense_id": "1bfb6ecb-234c-3b56-93b3-482db8f2a6d9",
                                                "text": "[T]he southern court of the ballium had become a flower-garden, with quaint terraces, statues, knots of flowers, clipped yews and hollies, and all the pedantries of the topiarian art."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86cdf555-d8f0-3560-a1fb-18c59e3e7b87",
                                        "entry_id": "d2578e1b-26a2-37c4-b7aa-4326cda2f24c",
                                        "glosses": [
                                            "An overly ambitious display of learning."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1a248e5a-00f7-44b2-8ab1-3028813fdd6f",
                        "source_entry_id": "3670f95a-dc2c-349e-94d9-bfbb6c4060aa",
                        "source_sense_id": "893f911d-e411-3ab5-ae0a-f5b6bcd1668c",
                        "target_lang_word": "formalidad",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "formalidad",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "e3f69382-f53f-37f9-b125-d4bf38fd0f2a",
                                        "entry_id": "27ade5a3-747b-33d0-809d-ef9561c754af",
                                        "glosses": [
                                            "Precisión, concreción y puntualidad."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b023692f-9554-460d-877a-aec468cf82ef",
                                                "sense_id": "e3f69382-f53f-37f9-b125-d4bf38fd0f2a",
                                                "text": "A pesar de la precisión y la formalidad del Sol, los relojes solares tienen dos problemas: la noche y los días nublados"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e301116f-9137-32b9-b42d-e64645946a58",
                                        "entry_id": "27ade5a3-747b-33d0-809d-ef9561c754af",
                                        "glosses": [
                                            "Trámite o exigencia necesaria para la ejecución de algo."
                                        ],
                                        "tags": [
                                            "generalmente en plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b3b0e98b-3593-43de-9484-e963010cce69",
                                                "sense_id": "e301116f-9137-32b9-b42d-e64645946a58",
                                                "text": "La definición de la función, considerada a menudo como una formalidad administrativa, debe servir de ocasión para establecer por escrito un \"contrato de confianza\""
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "7f708bd6-e111-3104-be65-d103035604f5",
                                        "entry_id": "27ade5a3-747b-33d0-809d-ef9561c754af",
                                        "glosses": [
                                            "Procedimiento concreto de ejecución de un acto público."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d44d14c-acff-49e8-ac9f-51dcbd61c0b6",
                                                "sense_id": "7f708bd6-e111-3104-be65-d103035604f5",
                                                "text": "La formalidad del acontecimiento se completó con el embanderamiento de la ciudad, y una impecable formación militar frente al Palacio"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "763d2869-05ba-3453-83b0-c949fa8c0967",
                                        "entry_id": "27ade5a3-747b-33d0-809d-ef9561c754af",
                                        "glosses": [
                                            "Solemnidad, gravedad, buen comportamiento."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2b6494c-e151-4dd3-9c6b-9183a0b9d139",
                                                "sense_id": "763d2869-05ba-3453-83b0-c949fa8c0967",
                                                "text": "Es característico del pésame el saludo no verbal, entre hombres con una palmada en el hombro y un beso en la mejilla entre las mujeres o entre mujeres y hombres: el darse la mano es señal de mucha formalidad, lo que es corriente en Alemania, pero no en Venezuela"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
