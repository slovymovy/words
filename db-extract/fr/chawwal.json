                    {
                        "sense_id": "7604582b-10f6-3725-b200-7b4c4951c9db",
                        "entry_id": "84be646f-f032-362a-95d7-199daca236b9",
                        "glosses": [
                            "Dixième mois du calendrier musulman."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8a4f686-2cf4-4abd-8cf5-d9972087f1f3",
                                "sense_id": "7604582b-10f6-3725-b200-7b4c4951c9db",
                                "text": "Abbas vécut 4 ans, et l'histoire de son règne est, comme on l'imagine bien, celle du conquérant persan, qui se fit couronner le 24 de chawwal 4448 (4\" mars 4736)."
                            },
                            {
                                "example_id": "5d7556db-b091-4e81-8157-400c5f25658d",
                                "sense_id": "7604582b-10f6-3725-b200-7b4c4951c9db",
                                "text": "Pourtant, son chemin n’est guère éclairé par la lune, frêle croissant en cette fin du mois de chawwal."
                            }
                        ]
                    }
                ],
