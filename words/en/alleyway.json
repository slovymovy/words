{
    "word_family": [
        "alley"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6af01379-73e2-36ba-b553-2acb4001ee9c",
                    "sense_definition": "A narrow street or passageway between or behind buildings.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "passageway",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He took a shortcut through a dark <w>alleyway</w> to reach the train station.",
                            "target_lang_translations": {
                                "it": "Ha preso una scorciatoia attraverso un <w>vicolo</w> buio per raggiungere la stazione ferroviaria."
                            }
                        },
                        {
                            "text": "The delivery truck was too wide to fit down the narrow <w>alleyway</w>.",
                            "target_lang_translations": {
                                "it": "Il camion delle consegne era troppo largo per passare nello stretto <w>vicolo</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "alley",
                        "lane",
                        "laneway",
                        "passage"
                    ],
                    "common_phrases": [
                        "dark alleyway",
                        "narrow alleyway"
                    ],
                    "target_lang_definitions": {
                        "it": "Una strada o un passaggio stretto situato tra o dietro agli edifici."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "vicolo",
                                "target_lang_sense_clarification": "stradina secondaria e stretta tra edifici"
                            },
                            {
                                "target_lang_word": "viottolo",
                                "target_lang_sense_clarification": "piccola via stretta, spesso pedonale"
                            },
                            {
                                "target_lang_word": "vicoletto",
                                "target_lang_sense_clarification": "diminutivo di vicolo, passaggio molto stretto"
                            },
                            {
                                "target_lang_word": "chiasso",
                                "target_lang_sense_clarification": "vicolo cieco o passaggio angusto (regionale/toscano)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3e15045d-46de-3218-816a-0e164c1e7e6e",
                    "sense_definition": "A narrow corridor or passage between rows of cabins on a ship.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "passageway",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The crew walked down the ship's <w>alleyway</w> toward their quarters.",
                            "target_lang_translations": {
                                "it": "L'equipaggio ha percorso il <w>corridoio</w> della nave verso i propri alloggi."
                            }
                        },
                        {
                            "text": "Water began to seep into the central <w>alleyway</w> during the heavy storm.",
                            "target_lang_translations": {
                                "it": "L'acqua cominciò a infiltrarsi nel <w>corridoio</w> centrale durante la violenta tempesta."
                            }
                        }
                    ],
                    "synonyms": [
                        "gangway",
                        "passage"
                    ],
                    "target_lang_definitions": {
                        "it": "Uno stretto corridoio o passaggio tra le cabine su una nave."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "corridoio",
                                "target_lang_sense_clarification": "passaggio interno stretto su una nave"
                            },
                            {
                                "target_lang_word": "corsia",
                                "target_lang_sense_clarification": "passaggio stretto tra alloggi o cabine navali"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}