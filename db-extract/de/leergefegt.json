                    }
                ],
                "senses": [
                    {
                        "sense_id": "640ce4b9-6de9-3350-960b-2307fd80f665",
                        "entry_id": "e08571d3-d020-374e-96d9-35921347f280",
                        "glosses": [
                            "ohne Menschen"
                        ],
                        "tags": [
                            "an Orten",
                            "wie Straßen",
                            "Plätzen"
                        ],
                        "examples": [
                            {
                                "example_id": "14f2a5a4-0d27-4eaa-955c-071f0895356d",
                                "sense_id": "640ce4b9-6de9-3350-960b-2307fd80f665",
                                "text": "Bei den Lockdwons während der Coronapandemie waren die Straßen wie leergefegt."
                            },
                            {
                                "example_id": "9c64014e-07dd-44dc-8ea1-345e5241c109",
                                "sense_id": "640ce4b9-6de9-3350-960b-2307fd80f665",
                                "text": "„»Wer ist denn da?«, fragt eine Frau. Ihr Hund bellt, als ich durch die leergefegten Straßen der italienischen Alpendorfs San Didero gehe.“"
                            },
                            {
                                "example_id": "e39c7b45-a537-49d9-b808-9378a3a3e62a",
                                "sense_id": "640ce4b9-6de9-3350-960b-2307fd80f665",
                                "text": "„Diese Rückfahrt über leergefegte Straßen war unheimlich“ […]."
                            },
                            {
                                "example_id": "e991a79f-79f1-43a1-a204-2010f4bfb7fb",
                                "sense_id": "640ce4b9-6de9-3350-960b-2307fd80f665",
                                "text": "„Wer tagsüber beim City-Bummel den Leerstand bei den Geschäften und abends die leergefegten Straßen sieht, kann das Gruseln kriegen.“"
                            },
                            {
                                "example_id": "cb864992-eb1a-4cba-b9b3-67a170a2a0e8",
                                "sense_id": "640ce4b9-6de9-3350-960b-2307fd80f665",
                                "text": "„Am Heiligen Abend unternehmen wir einen Spaziergang durch die leergefegte Stadt.“"
                            },
                            {
                                "example_id": "22f01c16-2ca7-40c4-a80b-b76866d6e287",
                                "sense_id": "640ce4b9-6de9-3350-960b-2307fd80f665",
                                "text": "„»Die Lockdowns im April und Mai haben die chinesische Wirtschaft stärker belastet, als das von Experten erwartet worden war. Präsent war bei uns ja vor allem das leergefegte Schanghai.«“"
                            },
                            {
                                "example_id": "6af1d2d9-c6cb-498c-bcc4-b754da00225d",
                                "sense_id": "640ce4b9-6de9-3350-960b-2307fd80f665",
                                "text": "„Für sein Album \"19\" erhielt der junge Pianist Ilja Ruf im vergangenen Jahr den Lübecker Jazzpreis. Ruf hat es mit 19 Jahren eingespielt, im Sommer 2020 im durch Corona leergefegten Kolosseum in Lübeck.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "9a0d4ae2-3d24-3fac-b6a4-0a49a3959881",
                        "entry_id": "e08571d3-d020-374e-96d9-35921347f280",
                        "glosses": [
                            "nicht erhältlich, nicht zu bekommen; ohne Waren, ohne Produkte"
                        ],
                        "tags": [
                            "in Geschäften"
                        ],
                        "examples": [
                            {
                                "example_id": "221b446f-1bf7-44af-884e-0d739b18937e",
                                "sense_id": "9a0d4ae2-3d24-3fac-b6a4-0a49a3959881",
                                "text": "Der Markt für günstige Wohnungen ist in Deutschland seit Jahren leergefegt und es wird jedes Jahr schlimmer."
                            },
                            {
                                "example_id": "00e08236-aa23-41ba-b0d4-11eb68854881",
                                "sense_id": "9a0d4ae2-3d24-3fac-b6a4-0a49a3959881",
                                "text": "„Ich kann mich nicht entsinnen, dass ich jemals in einem Supermarkt solch leergefegte Regale gesehen hatte. Dazu Schilder, oft handgeschrieben, dass pro Haushalt nur ein Paket abgegeben werden könne.“"
                            },
                            {
                                "example_id": "c77c6fac-b929-4ed5-8d6d-b6a178ea781d",
                                "sense_id": "9a0d4ae2-3d24-3fac-b6a4-0a49a3959881",
                                "text": "„So hat das Virus die globalen Versorgungsketten unterbrochen, Fabriken stillgelegt und Supermarktregale kurzzeitig leergefegt.“"
                            },
                            {
                                "example_id": "134cd062-05d2-4e08-aee1-0f290918f2ea",
                                "sense_id": "9a0d4ae2-3d24-3fac-b6a4-0a49a3959881",
                                "text": "[Restaurants:] „Weil der deutsche Arbeitsmarkt für Servicekräfte leergefegt ist, hat der Aachener Wirt Kellner und Köche aus Griechenland, Italien, Spanien und Tunesien angeworben.“"
                            },
                            {
                                "example_id": "d2ca2fb2-e41c-4b70-9755-d3cb750ca474",
                                "sense_id": "9a0d4ae2-3d24-3fac-b6a4-0a49a3959881",
                                "text": "„Der Arbeitsmarkt ist so leergefegt wie noch nie. 1,7 Millionen Mitarbeiter suchten Unternehmen in Deutschland im ersten Quartal laut den derzeit aktuellsten Zahlen des Instituts für Arbeitsmarkt- und Berufsforschung.“"
                            },
                            {
                                "example_id": "59909055-5ea6-400c-8a21-6c656b162530",
                                "sense_id": "9a0d4ae2-3d24-3fac-b6a4-0a49a3959881",
                                "text": "„In Bayern gibt es zwar ein sogenanntes Leserecht, das das Sammeln von Holz im Staatswald erlaubt. Allerdings gelten strenge Regeln und leergefegte Wälder sind ein ökologisches Problem.“"
                            },
                            {
                                "example_id": "21ba6c09-b6e6-4fa6-aad9-ea394ab5dcad",
                                "sense_id": "9a0d4ae2-3d24-3fac-b6a4-0a49a3959881",
                                "text": "[Sturm «Burglind» am 3. Januar 2018:] „Im Kanton Solothurn beispielsweise legte er so viele Bäume um, wie normalerweise in einem Jahr abgeholzt werden. Nebst altbekannten Baumarten wird auf den leergefegten Flächen auch die hitzebeständige «Douglasie» gepflanzt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
