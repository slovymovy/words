                    "frequency": "Middle",
                    "semantic_group_id": "karakter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij reageerde met een <w>kinderlijk</w> enthousiasme op het cadeau.",
                            "target_lang_translations": {
                                "en": "He reacted to the gift with <w>childlike</w> enthusiasm."
                            }
                        },
                        {
                            "text": "Soms gedroeg hij zich ronduit <w>kinderlijk</w> tijdens het spel.",
