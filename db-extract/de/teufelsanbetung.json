                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c29f287-6d79-4b03-8756-001396c22952",
                                "sense_id": "8e7683c4-e524-3d28-93fc-990c24792764",
                                "text": "„In ihrer Beschreibung von Braithwhites Arbeitsraum ließ sie den Glassarg unerwähnt und berichtete stattdessen von einer nicht näher bestimmten Auswahl merkwürdiger Vorrichtungen, die eher nach Teufelsanbetung als nach einem Regierungsauftrag aussahen.“"
                            },
                            {
                                "example_id": "96f95814-3233-4413-893c-7129d4110e4f",
                                "sense_id": "8e7683c4-e524-3d28-93fc-990c24792764",
                                "text": "„Ende des neunzehnten Jahrhunderts gab es viele Randgruppen, die sich mit Schwarzer Magie und Teufelsanbetung beschäftigten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
