        "fr-extract.jsonl": [
            {
                "entry_id": "9f72c397-614d-335e-9cca-405941b71000",
                "word": "importunité",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "5ae512be-ead5-4424-b7ba-c98a34090eb5",
                        "entry_id": "9f72c397-614d-335e-9cca-405941b71000",
                        "tags": [
                            "plural"
                        ],
                        "form": "importunités"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "bfa48e3a-b496-34c4-ac3c-513c1e8df607",
                        "entry_id": "9f72c397-614d-335e-9cca-405941b71000",
                        "glosses": [
                            "Caractère de ce qui est importun."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ea71bf9-6cb1-486a-912a-12d0a9578d36",
                                "sense_id": "bfa48e3a-b496-34c4-ac3c-513c1e8df607",
                                "text": "Lorsque Ivanhoé, tombé dans la lice, semblait abandonné de tout le monde, ce furent les importunités de Rébecca qui décidèrent son père à faire transporter ce jeune et vaillant guerrier."
                            },
                            {
                                "example_id": "18b800d7-5a16-40bd-a4aa-0b72ef071e43",
                                "sense_id": "bfa48e3a-b496-34c4-ac3c-513c1e8df607",
                                "text": "Vifs et irritables, ils trouveront aisément de nouveaux sujets de plainte, et quand enfin, cédant à leur importunité ou à leur force, le gouvernement aura satisfait à toutes leurs demandes, quand l’Irlande sera vraiment libre, l’Angleterre ne restera pas indifférente."
                            },
                            {
                                "example_id": "ebb2923b-c06d-4f1d-adcf-5390e5e3ca74",
                                "sense_id": "bfa48e3a-b496-34c4-ac3c-513c1e8df607",
                                "text": "Une troupe agile et criarde de mendiants, de guides, de proxénètes, détachée du porche, les entourait avec une importunité où se mêlait encore une certaine grâce que ne perdent jamais les légers Italiens."
                            },
                            {
                                "example_id": "ade02ed1-182e-4be8-a34f-a7ea80d770af",
                                "sense_id": "bfa48e3a-b496-34c4-ac3c-513c1e8df607",
                                "text": "Puisse-t-il interrompre un voyage dont je commençais à sentir lourdement l'importunité."
                            },
                            {
                                "example_id": "62e8d2ca-d863-44ef-ab75-5b9bb9116777",
                                "sense_id": "bfa48e3a-b496-34c4-ac3c-513c1e8df607",
                                "text": "Il est pourtant pénible de rester chez soi, à cause de la haïssable importunité des hôtes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7cabd2e0-78ad-4f0b-be00-8ccc8b81db81",
                        "source_entry_id": "9f72c397-614d-335e-9cca-405941b71000",
                        "source_sense_id": "bfa48e3a-b496-34c4-ac3c-513c1e8df607",
                        "target_lang_word": "importunity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "importunity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "61a46a34-691e-3757-a446-45335f5a8a52",
                                        "entry_id": "c72e7a45-58c5-3aa0-aaf1-31d09b17bf3f",
                                        "glosses": [
                                            "A constant and insistent demanding."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5260d7ef-14c8-4ff7-9255-9774e0e7ca87",
                                                "sense_id": "61a46a34-691e-3757-a446-45335f5a8a52",
                                                "text": "Then way what loſſe your honor may ſuſtaine / If with too credent eare you liſt his ſongs / Or looſe your hart, or your chaſt treaſure open / To his vnmaſtred importunity."
                                            },
                                            {
                                                "example_id": "13f1674a-d316-4a26-b2f2-86e9fc9bb7dc",
                                                "sense_id": "61a46a34-691e-3757-a446-45335f5a8a52",
                                                "text": "I say vnto you, Though he will not rise, and giue him, because he is his friend: yet because of his importunitie, hee will rise and giue him as many as he needeth."
                                            },
                                            {
                                                "example_id": "316324bd-d8ad-4737-9eb8-66a7b4a94f4f",
                                                "sense_id": "61a46a34-691e-3757-a446-45335f5a8a52",
                                                "text": "The truth of my Third Accuſation is confeſt, but the guilt, not acknovvledged; ſince that vvhich excites men to endleſs bavvlings, and altercations; Schiſms, Hereſies and Rebellions, by the vehemencies of Diſpute, is it ſeems vvith our Author no more noxious and criminal, then the Sun that ſtirrs men up to their vvork in the morning, by the importunity of it's beams."
                                            },
                                            {
                                                "example_id": "81ea0043-2161-487c-80a6-6feb273a1d6d",
                                                "sense_id": "61a46a34-691e-3757-a446-45335f5a8a52",
                                                "text": "For if through Importunity, a poor VVidovv-vvoman may prevail vvith an unjuſt Judge; and ſo conſequently vvith an unmerciful and hard-hearted Tyrant, hovv much more ſhall the poor, afflicted, diſtreſſed, and tempted People of God, prevail vvith, and obtain Mercy at the Hands of a loving, juſt, and merciful God?"
                                            },
                                            {
                                                "example_id": "37f273c8-2f97-46fc-881b-d5c8bfa28145",
                                                "sense_id": "61a46a34-691e-3757-a446-45335f5a8a52",
                                                "text": "Still, however, being surrounded with importunity, and no longer able to satisfy every request that was made him, instead of money he gave promises."
                                            },
                                            {
                                                "example_id": "15dc5244-b60b-4a85-afc2-cd85a097f7a8",
                                                "sense_id": "61a46a34-691e-3757-a446-45335f5a8a52",
                                                "text": "[…] Linton clung to his cousin, and implored her to accompany him, with a frantic importunity that admitted no denial."
                                            },
                                            {
                                                "example_id": "1f3b5867-82c5-4793-8b72-ce0e50404402",
                                                "sense_id": "61a46a34-691e-3757-a446-45335f5a8a52",
                                                "text": "But when she turned her thoughts to Morningside Park she perceived the tangled skein of life was now to be further complicated by his romantic importunity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "77e557b2-8965-3f41-b6c7-1df817f3bf38",
                                        "entry_id": "c72e7a45-58c5-3aa0-aaf1-31d09b17bf3f",
                                        "glosses": [
                                            "An inappropriate or unsuitable time; unseasonableness."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7295a0b1-953f-4819-8fa4-c6a5cbaccf62",
                        "source_entry_id": "9f72c397-614d-335e-9cca-405941b71000",
                        "source_sense_id": "bfa48e3a-b496-34c4-ac3c-513c1e8df607",
                        "target_lang_word": "unsuitableness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unsuitableness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "94efac07-3085-37d4-92c0-4604eace74b5",
                                        "entry_id": "1955f75a-f841-32aa-a7f5-861b768c0e02",
                                        "glosses": [
                                            "The state or quality of being unsuited or inappropriate."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4f599038-bfbf-451b-98eb-6d76a17fd644",
                                                "sense_id": "94efac07-3085-37d4-92c0-4604eace74b5",
                                                "text": "At the next lifting of the latch there entered a person with his hat awry upon his head, his clothes perversely ill-suited to his form, his eyes staring in directions opposite to their intelligence, and a certain odd unsuitableness pervading his whole figure."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "796b5e70-5806-41aa-916c-5747e88abf1a",
                        "source_entry_id": "9f72c397-614d-335e-9cca-405941b71000",
