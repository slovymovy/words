{
    "word_family": [
        "pious",
        "impious"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fa7e7bb1-6741-3733-b7e8-1c0947f32a06",
                    "sense_definition": "The quality of being religious or reverent toward God.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "devotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her <w>piety</w> was evident in the way she spent every Sunday morning volunteering at the local church.",
                            "target_lang_translations": {
                                "zh": "她每个周日上午都在当地教堂做义工，这足以证明她的<w>虔诚</w>。"
                            }
                        },
                        {
                            "text": "The monk lived a life of extreme <w>piety</w> and solitude in the mountains.",
                            "target_lang_translations": {
                                "zh": "那位僧人在山中过着极其<w>虔诚</w>且隐居的生活。"
                            }
                        }
                    ],
                    "synonyms": [
                        "devotion",
                        "reverence",
                        "faithfulness"
                    ],
                    "antonyms": [
                        "impiety",
                        "irreligion"
                    ],
                    "target_lang_definitions": {
                        "zh": "对神灵或宗教的虔诚与敬畏。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "虔诚",
                                "target_lang_sense_clarification": "指对宗教信仰的真诚与恭敬。"
                            },
                            {
                                "target_lang_word": "敬虔",
                                "target_lang_sense_clarification": "指对神灵的敬畏与虔诚。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d90d4add-40f4-373a-b85f-3555453d4f92",
                    "sense_definition": "Deep respect and loyalty toward one's parents, family, or country.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "devotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Filial <w>piety</w> remains a central value in many cultures, emphasizing the duty to care for aging parents.",
                            "target_lang_translations": {
                                "zh": "<w>孝道</w>在许多文化中依然是一项核心价值观，强调照顾年迈父母的责任。"
                            }
                        },
                        {
                            "text": "The soldier showed great <w>piety</w> toward his nation by serving with honor and courage.",
                            "target_lang_translations": {
                                "zh": "那名士兵以荣誉和勇气服役，展现了他对国家深厚的<w>忠诚</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "loyalty",
                        "devotion",
                        "allegiance"
                    ],
                    "common_phrases": [
                        "filial piety"
                    ],
                    "target_lang_definitions": {
                        "zh": "对父母、家庭或国家的深厚尊重与忠诚。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "孝道",
                                "target_lang_sense_clarification": "特指子女对父母应尽的义务与尊重。"
                            },
                            {
                                "target_lang_word": "忠诚",
                                "target_lang_sense_clarification": "指对国家或事业的坚定效忠。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "052d8111-17b9-318d-8352-80297cab643f",
                    "sense_definition": "A conventional or insincere statement that is often repeated but lacks genuine commitment.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "platitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politician offered empty <w>pieties</w> about change while failing to address the actual problems.",
                            "target_lang_translations": {
                                "zh": "那位政客说着关于变革的<w>空话</w>，却未能解决实际问题。"
                            }
                        },
                        {
                            "text": "He grew tired of hearing the same corporate <w>pieties</w> during every staff meeting.",
                            "target_lang_translations": {
                                "zh": "他厌倦了在每次员工会议上听到同样的职场<w>陈词滥调</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "platitude",
                        "cliché",
                        "truism"
                    ],
                    "target_lang_definitions": {
                        "zh": "指陈词滥调或虚伪的空话，缺乏真诚的承诺。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "陈词滥调",
                                "target_lang_sense_clarification": "指重复出现且缺乏新意或真诚的言论。"
                            },
                            {
                                "target_lang_word": "空话",
                                "target_lang_sense_clarification": "指言不由衷、没有实际意义的言辞。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}