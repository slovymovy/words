                "senses": [
                    {
                        "sense_id": "7128cdd0-853c-3baa-8c3a-f5b5d3a8019f",
                        "entry_id": "09e027d0-171e-3ed6-973f-60a71d9532b7",
                        "glosses": [
                            "een intens blauwe kleur"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e69a94a-b33f-4cfe-82e5-5b8b60fbd5a3",
                                "sense_id": "7128cdd0-853c-3baa-8c3a-f5b5d3a8019f",
                                "text": "Het biljet heeft, net als het nieuwe vijfje, drie nieuwe echtheidskenmerken: een portretwatermerk, een portrethologram en een smaragdgroen cijfer. Dat verandert van kleur, van smaragdgroen naar diepblauw en produceert een op en neer bewegend lichteffect."
                            },
                            {
                                "example_id": "5daeaf09-94ca-41e6-9958-a073393eedc3",
                                "sense_id": "7128cdd0-853c-3baa-8c3a-f5b5d3a8019f",
                                "text": "Sterrenvisagist Leco van Zadelhoff bedankt zijn vriendinnengroep, onder wie zijn besties Caroline Tensen en Leontine Borasto, met wie hij deze week in Marrakesh zijn 50ste verjaardag vierde. Allen helemaal stylish in diepblauw gekleed."
                            }
                        ]
                    }
