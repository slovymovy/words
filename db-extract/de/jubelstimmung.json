                "senses": [
                    {
                        "sense_id": "ff6035c2-3280-3823-b0d3-c29d701d41b2",
                        "entry_id": "6d87619c-87fb-383a-8f30-17af428d9273",
                        "glosses": [
                            "Gefühlslage/Stimmung, erfüllt von Jubel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eeb2a22a-0c61-49a1-9296-50fde71da1ea",
                                "sense_id": "ff6035c2-3280-3823-b0d3-c29d701d41b2",
                                "text": "„In den Berliner Kasernen herrschte nicht unbedingt Jubelstimmung, wie Harry Graf Kessler feststellte.“"
                            },
                            {
                                "example_id": "ff4680c7-09da-4fd7-80f7-d7048517c562",
                                "sense_id": "ff6035c2-3280-3823-b0d3-c29d701d41b2",
                                "text": "„Und doch waren alle in Jubelstimmung, trotz der Baustellen, der sich türmenden Müllberge, des Abfalls, der in die Flüsse gekippt wurde, der Unmengen von bunten Plastikflaschen überall.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
