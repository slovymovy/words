                ],
                "senses": [
                    {
                        "sense_id": "5e02593d-9999-3b32-a171-59d5463d3509",
                        "entry_id": "f566c2f6-e2bf-39fe-a517-79ac1efceea1",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "249bb28c-2ac4-4049-b372-21ba3c3ee13a",
                                "sense_id": "5e02593d-9999-3b32-a171-59d5463d3509",
                                "text": "Frau Messmer ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "4d3be487-a029-4071-ab39-72732ac641ee",
                                "sense_id": "5e02593d-9999-3b32-a171-59d5463d3509",
                                "text": "Herr Messmer wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "3c05b81c-8fb9-4b4b-8b78-090a8228720e",
                                "sense_id": "5e02593d-9999-3b32-a171-59d5463d3509",
                                "text": "Die Messmers fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "1fe51c2e-72ff-4eb8-9b9b-ae2cb3842269",
                                "sense_id": "5e02593d-9999-3b32-a171-59d5463d3509",
                                "text": "Der Messmer trägt nie die Schals, die die Messmer ihm strickt."
                            },
                            {
                                "example_id": "e9200544-165d-4067-82b1-12f089bd1a80",
                                "sense_id": "5e02593d-9999-3b32-a171-59d5463d3509",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Messmer kommt, geht der Herr Messmer.“"
                            },
                            {
                                "example_id": "05a25f76-00b8-4f95-a2a3-61b7f57730aa",
                                "sense_id": "5e02593d-9999-3b32-a171-59d5463d3509",
                                "text": "Messmer kommt und geht."
                            },
                            {
                                "example_id": "5f28e5a3-46db-4c1d-bbc8-1c50a3690d8c",
                                "sense_id": "5e02593d-9999-3b32-a171-59d5463d3509",
                                "text": "Messmers kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
