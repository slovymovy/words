                    {
                        "sense_id": "f9af4597-4ed5-3025-9dc4-c0caff0fd062",
                        "entry_id": "409921fd-64f6-3348-8c93-da7bfa632c98",
                        "glosses": [
                            "przywrócenie do życia kogoś znajdującego się w stanie śmierci klinicznej poprzez zastosowanie zabiegów pobudzających czynność serca, układu krążenia i oddychania"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c40c0cd0-3aa8-4d7d-be2f-5244d6db4771",
                                "sense_id": "f9af4597-4ed5-3025-9dc4-c0caff0fd062",
                                "text": "Lekarz zauważył ustanie czynności serca i rozpoczął reanimację."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "cace477b-5ffe-33bc-a7cb-e8f4f95915e5",
                        "entry_id": "409921fd-64f6-3348-8c93-da7bfa632c98",
                        "glosses": [
                            "przywrócenie do życia, obiegu idei, pomysłu, praktyki"
                        ],
                        "tags": [
                            "metaphoric"
                        ],
                        "examples": [
                            {
                                "example_id": "7ba6a12d-978f-4977-b1a6-86705e7a75db",
                                "sense_id": "cace477b-5ffe-33bc-a7cb-e8f4f95915e5",
                                "text": "Ambicje imperialne sowiecki dyktator ujawnił dopiero w 1934 r. na zjeździe kompartii, proponując reanimację polityki Rapalla. Sugestii tej w Berlinie wówczas nie podjęto."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fdba2890-52e7-43b0-a4ed-a1f300628b42",
