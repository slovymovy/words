        "fr-extract.jsonl": [
            {
                "entry_id": "f32f1f1c-8089-3d3b-8918-4e30f5422e3d",
                "word": "royalement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "93429cc6-bf08-3e4a-ac9e-cdca32efa97c",
                        "entry_id": "f32f1f1c-8089-3d3b-8918-4e30f5422e3d",
                        "glosses": [
                            "D’une manière royale, noblement, magnifiquement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0f69716-edd2-4ae3-b46c-8ca9aa35513b",
                                "sense_id": "93429cc6-bf08-3e4a-ac9e-cdca32efa97c",
                                "text": "C’est un homme qui vit royalement."
                            },
                            {
                                "example_id": "568f1aff-b5db-48e3-bb53-d6d50578a2b2",
                                "sense_id": "93429cc6-bf08-3e4a-ac9e-cdca32efa97c",
                                "text": "Il nous a traités royalement."
                            }
                        ]
                    },
                    {
                        "sense_id": "9cdb9dae-ef5e-3a70-98d2-3d1d62a14b62",
                        "entry_id": "f32f1f1c-8089-3d3b-8918-4e30f5422e3d",
                        "glosses": [
                            "et parfois Extrêmement, largement."
                        ],
                        "tags": [
                            "familiar",
                            "ironic"
                        ],
                        "examples": [
                            {
                                "example_id": "a73c72b6-b038-4d81-ada2-2c7090d8c174",
                                "sense_id": "9cdb9dae-ef5e-3a70-98d2-3d1d62a14b62",
                                "text": "Celui-ci, un doigt dans le nez, affiche une mine totalement absente. Il a l’air de s’ennuyer royalement."
                            },
                            {
                                "example_id": "f4c7a59c-8c14-4384-bd33-059f6dcde9ef",
                                "sense_id": "9cdb9dae-ef5e-3a70-98d2-3d1d62a14b62",
                                "text": "On s’en fout royalement."
                            },
                            {
                                "example_id": "b6b17ac8-1a24-41e6-83b0-b1209ef4c598",
                                "sense_id": "9cdb9dae-ef5e-3a70-98d2-3d1d62a14b62",
                                "text": "S’amuser royalement."
                            },
                            {
                                "example_id": "a3178e02-6ce6-4191-a419-4ce8ea068f3a",
                                "sense_id": "9cdb9dae-ef5e-3a70-98d2-3d1d62a14b62",
                                "text": "Pour mon stage de six mois, j’ai royalement touché une indemnité de cent euros."
                            },
                            {
                                "example_id": "80f5e3ad-4387-4380-95b8-1596c147fa4f",
                                "sense_id": "9cdb9dae-ef5e-3a70-98d2-3d1d62a14b62",
                                "text": "« Je m’en fiche royalement, totalement, présidentiellement », a encore répondu le chef de l’État au sujet de sa droitisation décomplexée et des commentaires qui en sont faits."
                            }
                        ]
                    }
                ],
