                        "glosses": [
                            "einleitende Vorbemerkungen oder das, was vor dem Eigentlichen geschieht, siehe Präliminarien"
                        ],
                        "tags": [
                            "nur im Plural",
                            "übertragen auf"
                        ],
                        "examples": [
