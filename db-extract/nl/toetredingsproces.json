                        "examples": [
                            {
                                "example_id": "da520943-d169-4648-9901-a98b623c0101",
                                "sense_id": "e50e2cd9-ee3a-3aed-9bcd-8704df05d00b",
                                "text": "\"De bescheiden vooruitgang die de afgelopen twintig jaar is geboekt, vormt een bedreiging voor de algehele duurzaamheid van de EU-steun die in het kader van het toetredingsproces werd verleend\", zegt Juhan Parts, lid van de Europese Rekenkamer."
                            },
                            {
                                "example_id": "fce0afe1-8910-4655-a645-cba8ee94fbce",
                                "sense_id": "e50e2cd9-ee3a-3aed-9bcd-8704df05d00b",
                                "text": "De Europese Commissie ijvert al een tijd voor de opening van toetredingsonderhandelingen met Noord-Macedonië en Albanië. Het leeuwendeel van de lidstaten en de Europese Commissie vinden dat de twee Balkanlanden perspectief moeten krijgen op EU-lidmaatschap, maar de Franse president Emmanuel Macron wil geen nieuwe kandidaten zolang het toetredingsproces niet wordt hervormd."
                            }
