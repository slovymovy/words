                "senses": [
                    {
                        "sense_id": "5f914ed7-c334-3776-a223-74d8a3008cad",
                        "entry_id": "2cfb586a-09d7-3bc2-83e7-0c99fa2ca37e",
                        "glosses": [
                            "Staat, der sich größtenteils über Steuern finanziert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "667f4468-0b10-40bc-bd74-1a91a3d4adea",
                                "sense_id": "5f914ed7-c334-3776-a223-74d8a3008cad",
                                "text": "„Das Grundgesetz geht von einem ‚Steuerstaat‘ aus, der die notwendigen Staatstätigkeiten prinzipiell über Steuern finanziert und sie nicht dem anheimgibt, der sie sich leisten kann oder will.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c8848df3-648c-3ef7-b3ca-ad97ac4164cc",
                        "entry_id": "2cfb586a-09d7-3bc2-83e7-0c99fa2ca37e",
                        "glosses": [
                            "Staat, der hohe Steuern erhebt"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "9bfee649-4f25-41cb-8ee5-577d57560462",
                                "sense_id": "c8848df3-648c-3ef7-b3ca-ad97ac4164cc",
                                "text": "„[Der Politiker] Bayal kritisierte die [im Wahlkampf] zum Teil scharfe Wortwahl. Es habe ihn irritiert, Wörter wie Blockwart oder Steuerstaat zu lesen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
