                        "translation_id": "979bcee0-92c2-430b-a2c5-aaee62a89404",
                        "source_entry_id": "dd733725-3a33-3bc7-992a-379ec64625ec",
                        "source_sense_id": "e78edfd1-39eb-3d68-91ab-8842e9b371b8",
