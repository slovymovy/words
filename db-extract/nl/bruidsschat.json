                    },
                    {
                        "form_id": "2ecbff99-d6c1-4144-b9a7-6b448f5088ae",
                        "entry_id": "b3c4f715-ecc9-347b-ad3b-8cb3310649f8",
                        "tags": [
                            "diminutive",
                            "plural"
                        ],
                        "form": "bruidsschatjes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8fdf1c17-8f1c-3d17-9c95-c106ea49ede4",
                        "entry_id": "b3c4f715-ecc9-347b-ad3b-8cb3310649f8",
                        "glosses": [
                            "een gift die een vrouw van haar ouders meekrijgt als ze in het huwelijk treedt."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e840402a-da73-4ed0-b344-42650708f927",
                                "sense_id": "8fdf1c17-8f1c-3d17-9c95-c106ea49ede4",
                                "text": "In Nederland neemt een vrouw vaak een uitzet mee in het huwelijk als een soort bruidsschat."
                            },
                            {
                                "example_id": "40055d0a-c46c-49a7-8776-ad2f7bf2adb9",
                                "sense_id": "8fdf1c17-8f1c-3d17-9c95-c106ea49ede4",
                                "text": "Ik zou zeker geen bruidsschat krijgen, en ons kleine huis had genoeg aan één paar meisjeshanden."
                            }
                        ]
                    },
                    {
                        "sense_id": "51c19479-b480-3aa8-8180-8e5202e8ac8b",
                        "entry_id": "b3c4f715-ecc9-347b-ad3b-8cb3310649f8",
                        "glosses": [
                            "geld dat een vrouw krijgt van de echtgenoot is de bruidsprijs maar wordt vaak, ten onrechte, ook bruidsschat genoemd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59503b26-3c0d-4c25-95a2-95b8ba25432d",
                                "sense_id": "51c19479-b480-3aa8-8180-8e5202e8ac8b",
                                "text": "Daarnaast is het in onze cultuur gewoonte dat de bruidegom goud geeft aan de bruid, als een soort bruidsschat. Dat goud, in de vorm van sieraden, kost al snel 5.000 tot 15.000 euro. Mensen die daar niet mee bekend zijn denken al snel: wow, dat is een hoop geld! Maar als je bedenkt dat de gasten tijdens het huwelijk vaak een financiële bijdrage geven waarmee meestal een groot deel van de kosten van de trouwerij worden gedekt, dan valt het wel mee. En het goud zie ik ook als een investering in de toekomst.”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "974f83ab-1bf9-4535-8cf5-ccd1d042b382",
                        "source_entry_id": "b3c4f715-ecc9-347b-ad3b-8cb3310649f8",
                        "source_sense_id": "8fdf1c17-8f1c-3d17-9c95-c106ea49ede4",
                        "source_sense_description": "een gift die een meisje van haar ouders meekrijgt als ze in het huwelijk treedt",
                        "target_lang_word": "Mitgift",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mitgift",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3e137b61-751b-305c-aea2-6d9dedba889d",
                                        "entry_id": "4bc4a028-ed85-3f39-8cec-4491cceef658",
                                        "glosses": [
                                            "Vermögen, in Form von Geld, Gütern oder Hausrat, das die Eltern ihrer Tochter bei der zukünftigen Heirat mitgeben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "046e8085-f929-40c3-9eda-4e44677f393a",
                                                "sense_id": "3e137b61-751b-305c-aea2-6d9dedba889d",
                                                "text": "Damit eure Tochter unseren Sohn heiraten darf, muss eure Familie zehn Kühe als Mitgift erbringen."
                                            },
                                            {
                                                "example_id": "7ae6f844-094e-468c-8c72-51179ee7b6e1",
                                                "sense_id": "3e137b61-751b-305c-aea2-6d9dedba889d",
                                                "text": "Zur Mitgift zählt klassischerweise die Truhe mit Bett- und Tischwäsche."
                                            },
                                            {
                                                "example_id": "24cc8b21-e198-4419-a2a9-bc01427989c3",
                                                "sense_id": "3e137b61-751b-305c-aea2-6d9dedba889d",
                                                "text": "Denn der Vorstandsvorsitzende Klaus Kleinfeld (48) hat vor gerade einmal einem Jahr seine Not leidende Handysparte an den taiwanesischen Elektronikkonzern verschenkt und als Mitgift noch einmal 250 Millionen Euro draufgelegt."
                                            },
                                            {
                                                "example_id": "b28289b0-2e24-4e20-a722-88cc1194e6d2",
                                                "sense_id": "3e137b61-751b-305c-aea2-6d9dedba889d",
                                                "text": "„Die Zigaretten sind wiederum in der russischen Zone besonders rar und besonders begehrt, und in Chemnitz gibt es die Strümpfe, die sich ein Schuhmachermeister im ländlichen Holstein für seine heiratsfähige Tochter als Mitgift wünscht.“"
                                            },
                                            {
                                                "example_id": "5e014288-9a00-4441-854c-a3243d8b2a58",
                                                "sense_id": "3e137b61-751b-305c-aea2-6d9dedba889d",
                                                "text": "„Vetter Menasche hat die Mitgift, die er verwaltet, aber leider nicht zur Hand.“"
                                            },
                                            {
                                                "example_id": "ee46a067-1eac-4643-941a-8ad444b0c8ba",
                                                "sense_id": "3e137b61-751b-305c-aea2-6d9dedba889d",
                                                "text": "„Mit einem solchen Augenpaar begabt zu sein, ist nun einmal eine unselige Mitgift der Natur, sowohl für einen Er, wie auch für eine Sie.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cf7deacc-5faa-4f27-829b-382ba8574c75",
                        "source_entry_id": "b3c4f715-ecc9-347b-ad3b-8cb3310649f8",
                        "source_sense_id": "8fdf1c17-8f1c-3d17-9c95-c106ea49ede4",
                        "source_sense_description": "een gift die een meisje van haar ouders meekrijgt als ze in het huwelijk treedt",
                        "target_lang_word": "dowry",
