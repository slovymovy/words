            "pos": "verb",
            "senses": [
                {
                    "sense_id": "622fba6d-3d4b-3d20-bc12-a1b54262da7d",
                    "sense_definition": "Organiser ou préparer quelque chose à l'avance en prenant les dispositions nécessaires.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "organisation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous devons <w>prévoir</w> une réunion dès demain pour discuter de ce projet."
                        },
                        {
                            "text": "Qu'avez-vous <w>prévu</w> de faire pendant vos prochaines vacances d'été ?"
                        }
                    ],
                    "common_phrases": [
                        "prévoir une réunion",
                        "prévoir un voyage"
                    ]
                },
                {
                    "sense_id": "5e598879-deba-308b-b709-b65e47624824",
                    "sense_definition": "Juger ou estimer à l'avance qu'un événement va se produire.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "anticipation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le bulletin météo <w>prévoit</w> de fortes chutes de neige pour ce soir."
                        },
                        {
                            "text": "Il est souvent très difficile de <w>prévoir</w> l'avenir avec exactitude."
                        }
                    ],
                    "synonyms": [
                        "prédire"
                    ],
                    "common_phrases": [
                        "difficile à prévoir",
                        "laisser prévoir"
                    ]
                },
                {
                    "sense_id": "96553773-bd1f-3a25-9f2e-80080760d8cb",
                    "sense_definition": "Fixer ou énoncer une règle ou une modalité, en parlant d'une loi, d'un contrat ou d'un règlement.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "juridique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le contrat de travail <w>prévoit</w> une période d'essai de trois mois renouvelable."
                        },
                        {
                            "text": "Comme le <w>prévoit</w> la loi, les membres de l'assemblée voteront à bulletin secret."
                        }
                    ],
                    "common_phrases": [
                        "comme le prévoit la loi",
                        "le contrat prévoit"
                    ]
                }
            ]
        }
