                "senses": [
                    {
                        "sense_id": "438dcbca-54b7-333c-b405-553c7ab53acb",
                        "entry_id": "acfab9b6-2120-3d3c-8d73-c218273dce95",
                        "glosses": [
                            "Fahrzeug, das vom FBI im Dienst verwendet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4b76856-470b-4667-9915-c27f04604cb2",
                                "sense_id": "438dcbca-54b7-333c-b405-553c7ab53acb",
                                "text": "„Der Plan sah vor, nach und nach ein credistisches Paradies zusammenzubringen, indem Hektar für Hektar die ganze Welt aufgekauft wurde. Bis die FBI-Wagen die amtlichen hundert Meter vom Versammlungshaus der Kirchenkolonie entfernt zum Stillstand kamen.“"
                            },
                            {
                                "example_id": "26dab0f0-99b2-4a01-93d0-7d1fc69ff42e",
                                "sense_id": "438dcbca-54b7-333c-b405-553c7ab53acb",
                                "text": "„Ich fahre einen der FBI-Wagen, meinen Squad Supervisor Bob Fitzpatrick neben mir.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
