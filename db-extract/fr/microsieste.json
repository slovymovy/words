                        "examples": [
                            {
                                "example_id": "7359d990-7870-4e59-bee0-2b8d822819fb",
                                "sense_id": "7e8ab4d9-102c-31ef-ad01-ffa7aa79b322",
                                "text": "Les manchots à jugulaire font plus de 10 000 microsiestes de quatre secondes en moyenne par jour, selon une étude publiée jeudi dans la revue Science."
                            },
                            {
                                "example_id": "1cfa9e41-4507-4446-bf94-f551695e5f49",
                                "sense_id": "7e8ab4d9-102c-31ef-ad01-ffa7aa79b322",
                                "text": "Mais attention, faire une microsieste ne consiste pas juste à rester immobile et à rêvasser durant un court laps de temps, c’est un exercice qui nécessite de se laisser complètement aller."
                            },
                            {
                                "example_id": "3299b277-4632-46a9-84ea-904638a89797",
                                "sense_id": "7e8ab4d9-102c-31ef-ad01-ffa7aa79b322",
                                "text": "Personnellement, je n’aurais jamais survécu à mes premières années de maman si je n’avais pas appris à faire des microsiestes."
                            }
                        ]
                    }
