                "senses": [
                    {
                        "sense_id": "4224e119-330e-3132-8bbd-07035ef2a065",
                        "entry_id": "a750fe46-2062-3f59-b756-eb3155083e64",
                        "glosses": [
                            "Salz oder Ester der Kohlensäure"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bdc11bab-c49f-4ad7-ae2b-00495992484d",
                                "sense_id": "4224e119-330e-3132-8bbd-07035ef2a065",
                                "text": "„Carbonate kommen überall in der Natur vor, meist in Form verschiedener Minerale.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "529b2922-41eb-4bb5-aa73-45fa5d668442",
                        "source_entry_id": "a750fe46-2062-3f59-b756-eb3155083e64",
                        "source_sense_id": "4224e119-330e-3132-8bbd-07035ef2a065",
                        "source_sense_description": "Chemie: Salz oder Ester der Kohlensäure",
                        "target_lang_word": "carbonate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "carbonate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7af34e1e-5bd8-36bb-8c76-837ea447aa9e",
                                        "entry_id": "c687da6b-bfc6-3395-ae5f-984f5c9db2e7",
                                        "glosses": [
                                            "Any salt or ester of carbonic acid."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b57de30-088e-4b1a-bda3-94389dfd5d31",
                                                "sense_id": "7af34e1e-5bd8-36bb-8c76-837ea447aa9e",
                                                "text": "A sample of carbon removed from the ocean in the solid form of calcium carbonate and magnesium hydroxide from UCLA's SeaChange program -- now known as Equatic -- in 2023."
                                            },
                                            {
                                                "example_id": "971ae975-c375-46a5-a7ae-4c9217e0f0f1",
                                                "sense_id": "7af34e1e-5bd8-36bb-8c76-837ea447aa9e",
                                                "text": "McCoy’s team, including 66 researchers across four continents, found the salt and minerals left behind as water on Bennu, or its larger parent asteroid, evaporated. The minerals include sodium phosphates, carbonates, sulfates, chlorides and fluorides, some of which are necessary to the formation of life."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "carbonate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c079aece-8de3-322f-9bc0-fdeaf058107a",
                                        "entry_id": "9551e44f-7d43-3dd3-bfcb-e8752c3b280a",
                                        "glosses": [
                                            "To charge (often a beverage) with carbon dioxide."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e9b5a787-edab-4e2b-9211-efa27bb1cf44",
                        "source_entry_id": "a750fe46-2062-3f59-b756-eb3155083e64",
                        "source_sense_id": "4224e119-330e-3132-8bbd-07035ef2a065",
                        "source_sense_description": "Chemie: Salz oder Ester der Kohlensäure",
                        "target_lang_word": "carbonate",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "carbonate",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "75e476cb-ec71-3aa5-b487-ef06d7c24d40",
                                        "entry_id": "546d71e3-aa29-3426-bdbf-1b283fa34757",
                                        "glosses": [
                                            "Composé ionique associant un ion carbonate CO₃²⁻ et une base cationique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8af81e4a-db97-4db3-bf4c-7cc8ba4f4d14",
                                                "sense_id": "75e476cb-ec71-3aa5-b487-ef06d7c24d40",
                                                "text": "La chaux ne se rencontre jamais à l'état libre dans la nature. Elle est le plus souvent combinée avec l’acide carbonique, et forme un corps que les chimistes appellent carbonate de chaux et qui est le principal composant des pierres calcaires."
                                            },
                                            {
                                                "example_id": "e491e12f-f32e-4fdd-a9e1-e1985d2e7fa6",
                                                "sense_id": "75e476cb-ec71-3aa5-b487-ef06d7c24d40",
                                                "text": "Les carbonates, borates et silicates alcalins à chaud dissolvent le grès."
                                            },
                                            {
                                                "example_id": "33fe66ff-ceef-4d99-ad93-aecdbbe4efc9",
                                                "sense_id": "75e476cb-ec71-3aa5-b487-ef06d7c24d40",
                                                "text": "Ainsi les bouillies bourguignonnes ne sont caustiques qu’autant qu’elles renferment du cuivre dissous à l'état de carbonate, c'est-à-dire tant qu'elles sont plus ou moins dans l'état primitif."
                                            },
                                            {
                                                "example_id": "1dd04cec-033a-48ab-999b-bdaa563810e0",
                                                "sense_id": "75e476cb-ec71-3aa5-b487-ef06d7c24d40",
                                                "text": "De nos jours, le CO₂ des volcans est partiellement absorbé par des processus naturels tels que le lessivage des roches, qui le transforme en carbonates par réaction chimique."
                                            },
                                            {
                                                "example_id": "275459fa-8139-4637-b802-7fa62a6fab0a",
                                                "sense_id": "75e476cb-ec71-3aa5-b487-ef06d7c24d40",
                                                "text": "Les climats passés sont enregistrés dans les rapports isotopiques d’hydrogène et d’oxygène dans la glace accumulée au cours des millénaires, ou dans ceux de carbone et d’oxygène dans les carbonates (des squelettes de micro-organismes) des sédiments marins."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "carbonate",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d06d066c-f971-3f65-8c2b-78881c5aa18c",
                                        "entry_id": "6f6a7bb9-ca0d-3e2d-adf7-47c1947e6037",
