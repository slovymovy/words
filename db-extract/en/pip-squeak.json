                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Winzling",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a2d63f9c-083e-37c0-870e-943fd840a873",
                                        "entry_id": "ef4de74f-dceb-3c39-8423-8c761adad132",
                                        "glosses": [
                                            "etwas oder jemand sehr Kleines (im Vergleich zu anderen Exemplaren dieser Art)"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "83bef940-7702-4918-b31f-6db12ad4a849",
                                                "sense_id": "a2d63f9c-083e-37c0-870e-943fd840a873",
                                                "text": "„Als Stromer ist der offene Winzling flott und sehr unmittelbar, weil nichts stinkt oder lärmt.“"
                                            },
                                            {
                                                "example_id": "8145193f-d287-47bd-b14f-c9ba54f76bca",
                                                "sense_id": "a2d63f9c-083e-37c0-870e-943fd840a873",
                                                "text": "„Merkur ist der Winzling unter den Planeten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "032e1268-a7c5-4c04-a6ac-a8c283ebb178",
                        "source_entry_id": "2ce635ea-49b3-3899-a267-0b791273bbbe",
                        "source_sense_id": "b3a86816-4390-34b5-90b7-dc3d9c3e0ff4",
                        "source_sense_description": "small and insignificant person",
                        "target_lang_word": "Würstchen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Würstchen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1ea9e68f-b36b-392a-b215-45f3a96056e3",
                                        "entry_id": "9961d866-4846-3108-8b53-6cc57e03d55d",
                                        "glosses": [
                                            "dünne Brühwurst im Saitling"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fab66c4a-2570-492c-b31a-f264d2d0c5c0",
                                                "sense_id": "1ea9e68f-b36b-392a-b215-45f3a96056e3",
                                                "text": "Silvester gibt’s bei uns Kartoffelsalat und Würstchen."
                                            },
                                            {
                                                "example_id": "414e10cc-8f5e-4eaa-9f41-bb70ec6a2e91",
                                                "sense_id": "1ea9e68f-b36b-392a-b215-45f3a96056e3",
                                                "text": "„Später gingen wir noch einmal hinab zu Paul und Hanna und aßen Würstchen mit viel Senf und frisch gemachtem Kartoffelsalat.“"
                                            },
                                            {
                                                "example_id": "4b255980-fcd8-4e2b-a0ae-dba89eac915b",
                                                "sense_id": "1ea9e68f-b36b-392a-b215-45f3a96056e3",
                                                "text": "„Es wird geraucht, herumgestanden im Wind, es werden Würstchen gegessen und es wird geküsst.“"
                                            },
                                            {
                                                "example_id": "f5a2b691-ab15-4ac0-9c01-a29f6b60c2ca",
                                                "sense_id": "1ea9e68f-b36b-392a-b215-45f3a96056e3",
                                                "text": "„Der Duft von saurem Kartoffelsalat und heißen Würstchen, die unsere Gastgeberin, eine üppige indische Göttin, in einem silbernen Kessel hereintrug, stieg mir wohlig in die Nase.“"
                                            },
                                            {
                                                "example_id": "3a8b866d-0449-47e3-a944-481efd734b73",
                                                "sense_id": "1ea9e68f-b36b-392a-b215-45f3a96056e3",
                                                "text": "„In der Mitte stand ein Tisch, darauf ein Spirituskocher, auf dem sie Würstchen heißmachte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a1cae8eb-55a9-3a40-99f8-43f8b2713b32",
                                        "entry_id": "9961d866-4846-3108-8b53-6cc57e03d55d",
                                        "glosses": [
                                            "schwacher, benachteiligter Mensch"
                                        ],
                                        "tags": [
                                            "bedauernd oder geringschätzig"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c869bdd2-30d4-41c4-9d9a-8723c766ff09",
                                                "sense_id": "a1cae8eb-55a9-3a40-99f8-43f8b2713b32",
                                                "text": "Du kommst aus Frankfurt, du bist ein Würstchen!"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4a074e48-39fc-4c6c-b1f7-f0e92224ab56",
                        "source_entry_id": "2ce635ea-49b3-3899-a267-0b791273bbbe",
                        "source_sense_id": "b3a86816-4390-34b5-90b7-dc3d9c3e0ff4",
