{
    "word_family": [
        "polubić",
        "ulubiony",
        "ulubieniec",
        "luby"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "39a96587-a008-307e-a85f-d3a633a127ea",
                    "sense_definition": "Darzyć kogoś sympatią lub znajdować w czymś przyjemność",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mój młodszy brat bardzo <w>lubi</w> grać w piłkę nożną.",
                            "target_lang_translations": {
                                "ru": "Мой младший брат очень <w>любит</w> играть в футбол.",
                                "en": "My younger brother really <w>likes</w> playing football."
                            }
                        },
                        {
                            "text": "Czy ty <w>lubisz</w> chodzić do kina w weekendy?",
                            "target_lang_translations": {
                                "ru": "Ты <w>любишь</w> ходить в кино по выходным?",
                                "en": "Do you <w>like</w> going to the cinema on weekends?"
                            }
                        }
                    ],
                    "antonyms": [
                        "nienawidzić"
                    ],
                    "common_phrases": [
                        "bardzo kogoś lubić",
                        "lubić słodycze",
                        "lubić czytać książki",
                        "lubić podróżować"
                    ],
                    "target_lang_definitions": {
                        "ru": "Испытывать симпатию к кому-либо или находить удовольствие в чем-либо",
                        "en": "To feel affection for someone or to find pleasure in something."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "любить",
                                "target_lang_sense_clarification": "испытывать глубокую привязанность или интерес"
                            },
                            {
                                "target_lang_word": "нравиться",
                                "target_lang_sense_clarification": "быть по вкусу, вызывать симпатию"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "like",
                                "target_lang_sense_clarification": "to enjoy, be pleased by, or favor"
                            },
                            {
                                "target_lang_word": "be fond of",
                                "target_lang_sense_clarification": "to have a liking or affection for"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4d4a93f8-fbfe-315e-be31-60e1bf3c535d",
                    "sense_definition": "Odczuwać wzajemną sympatię i dobrze się ze sobą dogadywać",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Marek i Tomek bardzo się <w>lubią</w> od czasów szkoły.",
                            "target_lang_translations": {
                                "ru": "Марек и Томек очень хорошо <w>ладят</w> со школьных времен.",
                                "en": "Marek and Tomek have <w>liked each other</w> since school."
                            }
                        },
                        {
                            "text": "Nasze psy niestety się nie <w>lubią</w> i ciągle na siebie szczekają.",
                            "target_lang_translations": {
                                "ru": "Наши собаки, к сожалению, не <w>ладят</w> и постоянно лают друг на друга.",
                                "en": "Our dogs unfortunately do not <w>get along</w> and are constantly barking at each other."
                            }
                        }
                    ],
                    "synonyms": [
                        "dogadywać się"
                    ],
                    "antonyms": [
                        "nienawidzić"
                    ],
                    "common_phrases": [
                        "lubić się z sąsiadami",
                        "oni się lubią",
                        "nie lubić się"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувствовать взаимную симпатию и хорошо ладить друг с другом",
                        "en": "To feel mutual affection and get along well with each other."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ладить",
                                "target_lang_sense_clarification": "быть в хороших отношениях"
                            },
                            {
                                "target_lang_word": "нравиться друг другу",
                                "target_lang_sense_clarification": "испытывать взаимную симпатию"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "like each other",
                                "target_lang_sense_clarification": "to have mutual affection"
                            },
                            {
                                "target_lang_word": "get along",
                                "target_lang_sense_clarification": "to have a harmonious relationship"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e90b9ead-388d-33f0-9326-9687c6662b49",
                    "sense_definition": "Wymagać określonych warunków do dobrego rozwoju (zwykle o roślinach)",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Te egzotyczne kwiaty <w>lubią</w> stać w pełnym słońcu.",
                            "target_lang_translations": {
                                "ru": "Эти экзотические цветы <w>любят</w> стоять на ярком солнце.",
                                "en": "These exotic flowers <w>thrive in</w> full sun."
                            }
                        },
                        {
                            "text": "Pomidory <w>lubią</w> ciepło i regularne podlewanie wodą.",
                            "target_lang_translations": {
                                "ru": "Помидоры <w>любят</w> тепло и регулярный полив.",
                                "en": "Tomatoes <w>prefer</w> warmth and regular watering."
                            }
                        }
                    ],
                    "common_phrases": [
                        "lubić słońce",
                        "lubić wilgoć",
                        "lubić cień"
                    ],
                    "target_lang_definitions": {
                        "ru": "Требовать определенных условий для хорошего развития (обычно о растениях)",
                        "en": "To require specific conditions for healthy growth (usually referring to plants)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "любить",
                                "target_lang_sense_clarification": "нуждаться в благоприятных условиях"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "thrive in",
                                "target_lang_sense_clarification": "to grow or develop well in specific conditions"
                            },
                            {
                                "target_lang_word": "prefer",
                                "target_lang_sense_clarification": "to require or favor specific environmental conditions"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b5960197-49a8-380d-86d5-750121c8071f",
                    "sense_definition": "Mieć skłonność do psucia się lub zachowywania w niepożądany sposób",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Stary silnik w zimie <w>lubi</w> odmawiać posłuszeństwa.",
                            "target_lang_translations": {
                                "ru": "Старый двигатель зимой <w>любит</w> отказывать.",
                                "en": "The old engine <w>is prone to</w> failing in winter."
                            }
                        },
                        {
                            "text": "Ten program komputerowy <w>lubi</w> się zawieszać przy dużych plikach.",
                            "target_lang_translations": {
                                "ru": "Эта компьютерная программа <w>любит</w> зависать при работе с большими файлами.",
                                "en": "This computer program <w>has a habit of</w> crashing with large files."
                            }
                        }
                    ],
                    "common_phrases": [
                        "zamek lubi się zacinać",
                        "auto lubi się psuć"
                    ],
                    "target_lang_definitions": {
                        "ru": "Иметь склонность ломаться или вести себя нежелательным образом",
                        "en": "To have a tendency to break down or behave in an undesirable way."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "любить",
                                "target_lang_sense_clarification": "иметь обыкновение (разговорное)"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "be prone to",
                                "target_lang_sense_clarification": "to have a tendency to do something undesirable"
                            },
                            {
                                "target_lang_word": "have a habit of",
                                "target_lang_sense_clarification": "to frequently do something (often negative)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}