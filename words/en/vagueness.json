    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e12554a5-4071-3ebd-89e1-c320ea67b0f6",
                    "sense_definition": "The state or quality of being unclear, imprecise, or indistinct in meaning or expression.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "imprecision",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The extreme <w>vagueness</w> of the contract caused serious misunderstandings between the two companies.",
                            "target_lang_translations": {
                                "nl": "De extreme <w>vaagheid</w> van het contract leidde tot ernstige misverstanden tussen de twee bedrijven."
                            }
                        },
                        {
                            "text": "He answered the difficult questions with deliberate <w>vagueness</w> to avoid committing himself.",
                            "target_lang_translations": {
                                "nl": "Hij beantwoordde de moeilijke vragen met opzettelijke <w>vaagheid</w> om zich nergens aan te binden."
                            }
                        }
                    ],
                    "synonyms": [
                        "ambiguity",
                        "imprecision",
                        "haziness",
                        "unclearness"
                    ],
                    "antonyms": [
                        "clarity",
                        "precision",
                        "clearness"
                    ],
                    "common_phrases": [
                        "deliberate vagueness",
                        "constitutional vagueness"
                    ],
                    "target_lang_definitions": {
                        "nl": "De toestand of eigenschap van het onduidelijk, onnauwkeurig of vaag zijn van betekenis of uitdrukking."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "vaagheid",
                                "target_lang_sense_clarification": "onduidelijkheid of gebrek aan precisie"
                            },
                            {
                                "target_lang_word": "onduidelijkheid",
                                "target_lang_sense_clarification": "het niet helder of duidelijk zijn"
                            },
                            {
                                "target_lang_word": "onnauwkeurigheid",
                                "target_lang_sense_clarification": "gebrek aan nauwkeurigheid of precisie"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "077555c1-2c08-386b-a353-e07908c6618a",
                    "sense_definition": "An instance, statement, or feature that is indefinite or unclear.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "imprecision",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The committee criticized several <w>vaguenesses</w> in the wording of the proposed policy.",
                            "target_lang_translations": {
                                "nl": "De commissie bekritiseerde verschillende <w>onduidelijkheden</w> in de formulering van het voorgestelde beleid."
                            }
                        },
                        {
                            "text": "Her speech was full of pleasant promises and general <w>vaguenesses</w>.",
                            "target_lang_translations": {
                                "nl": "Haar toespraak zat vol met prettige beloften en algemene <w>vaagheden</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "ambiguity",
                        "generality"
                    ],
                    "target_lang_definitions": {
                        "nl": "Een specifiek geval, uitspraak of element dat onbepaald of onduidelijk is."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "vaagheid",
