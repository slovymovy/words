                        "glosses": [
                            "Se mettre à l’aise."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f46defe-271f-4a95-be21-131f59ba7de1",
                                "sense_id": "5a460de7-d6ed-30fa-ba1c-1b9cf9822005",
                                "text": "Et, tout en promenant son petit doigt tremblant\nSur sa joue, un velours de pêche rose et blanc,\nEn faisant, de sa lèvre enfantine, une moue,\nElle arrangeait les plats, près de moi pour m’aiser ;\n– Puis, comme ça, – bien sûr pour avoir un baiser, –\nTout bas : « Sens donc, j’ai pris une froid sur la joue... »"
                            }
                        ]
                    }
