                        ]
                    },
                    {
                        "translation_id": "2a1a85ef-b573-4864-913c-2991fcabf495",
                        "source_entry_id": "7ec917b4-5a6f-316e-a7ec-5f897804bef9",
                        "source_sense_description": "In a momentary manner",
                        "target_lang_word": "brièvement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "brièvement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "22a979c3-0058-3b25-a03d-c6f47d5fd8eb",
                                        "entry_id": "714e0f27-ff97-31f4-8498-86fb01e50438",
                                        "glosses": [
                                            "En peu de mots, de façon brève."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0de1dfb8-7232-475b-b97c-f0a5f4315d4b",
                                                "sense_id": "22a979c3-0058-3b25-a03d-c6f47d5fd8eb",
                                                "text": "Nous avons montré aussi brièvement qu’il a été possible, quelle est la dignité de duc et pair dans tous les âges de la monarchie."
                                            },
                                            {
                                                "example_id": "1ac47509-57a8-4ad5-8d96-6bf2e4a9c73f",
                                                "sense_id": "22a979c3-0058-3b25-a03d-c6f47d5fd8eb",
                                                "text": "Je lui exposai brièvement mes aventures, et il m’écouta en silence."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "55c70317-c9b5-45d4-93c1-e7a990c4fafb",
                        "source_entry_id": "7ec917b4-5a6f-316e-a7ec-5f897804bef9",
                        "source_sense_description": "In a momentary manner",
                        "target_lang_word": "momentan",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "momentan",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "66ac41ef-4c5d-37eb-90e2-6b624f2d67ab",
                                        "entry_id": "140815df-4b3e-3f1a-b2ca-43e8ea89fdc0",
                                        "glosses": [
                                            "in diesem Moment, jetzt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aba289f1-c008-444f-b15c-20766b4e1407",
                                                "sense_id": "66ac41ef-4c5d-37eb-90e2-6b624f2d67ab",
                                                "text": "Momentan habe ich sehr wenig Zeit."
                                            },
                                            {
                                                "example_id": "c7af6a8a-f0a2-48b3-9808-43646bd7e31f",
                                                "sense_id": "66ac41ef-4c5d-37eb-90e2-6b624f2d67ab",
                                                "text": "Eine Versetzung ist momentan leider nicht möglich."
                                            },
                                            {
                                                "example_id": "3c4465f4-cf6e-479d-beec-c7ac6f3e6f5d",
                                                "sense_id": "66ac41ef-4c5d-37eb-90e2-6b624f2d67ab",
                                                "text": "„Und das ist klug,betrachtet man die momentane Lage der Werbekonzerne: Sie haben große Probleme, denn ihr Geschäftsmodell wackelt bedenklich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "47a51772-23b9-4403-882a-4057b41211d6",
                        "source_entry_id": "7ec917b4-5a6f-316e-a7ec-5f897804bef9",
