                {
                    "sense_id": "c7140c04-5cf0-354d-aebe-a075f6d839d8",
                    "sense_definition": "A type of invasive grass, specifically couch grass, or its underground stems.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "plants",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer spent the whole afternoon pulling <w>quickens</w> out of the vegetable patch.",
                            "target_lang_translations": {
                                "ru": "Фермер провел весь день, вырывая <w>пырей</w> с овощной грядки."
