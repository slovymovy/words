{
    "word_family": [
        "disingenuous",
        "disingenuousness",
        "ingenuous",
        "ingenuously",
        "ingenuousness"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "8bbf6f32-8835-3127-bdae-27a65d3a83c4",
                    "sense_definition": "In a manner that is not sincere, honest, or open; deceitfully or insincerely.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "deceitful",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The spokesperson <w>disingenuously</w> claimed that the company had no knowledge of the safety issues.",
                            "target_lang_translations": {
                                "ru": "Представитель компании <w>лицемерно</w> утверждал, что фирма ничего не знала о проблемах с безопасностью."
                            }
                        },
                        {
                            "text": "He argued <w>disingenuously</w>, knowing full well that his statistics were completely out of date.",
                            "target_lang_translations": {
                                "ru": "Он аргументировал <w>неискренне</w>, прекрасно зная, что его статистика безнадёжно устарела."
                            }
                        }
                    ],
                    "synonyms": [
                        "deceitfully",
                        "deceptively"
                    ],
                    "antonyms": [
                        "candidly",
                        "frankly",
                        "openly"
                    ],
                    "common_phrases": [
                        "act disingenuously",
                        "argue disingenuously",
                        "claim disingenuously"
                    ],
                    "target_lang_definitions": {
                        "ru": "Неискренне, лукаво, нечестно или не откровенно."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лицемерно",
                                "target_lang_sense_clarification": "неискренне, скрывая истинные намерения"
                            },
                            {
                                "target_lang_word": "неискренне",
                                "target_lang_sense_clarification": "без искренности, фальшиво"
                            },
                            {
                                "target_lang_word": "лукаво",
                                "target_lang_sense_clarification": "хитро, не вполне честно"
                            },
                            {
                                "target_lang_word": "нечестно",
                                "target_lang_sense_clarification": "предосудительно, обманным путём"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f14048a4-4982-3bce-bdb2-ed6c03099073",
                    "sense_definition": "In a way that feigns innocence, ignorance, or simple-mindedness, often to manipulate or deceive.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "deceitful",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>disingenuously</w> asked how the files were leaked, pretending she had not shared them herself.",
                            "target_lang_translations": {
                                "ru": "Она <w>с наигранным простодушием</w> поинтересовалась, как произошла утечка файлов, делая вид, будто сама их не распространяла."
                            }
                        },
                        {
                            "text": "The politician smiled and responded <w>disingenuously</w> with an air of complete innocence.",
                            "target_lang_translations": {
                                "ru": "Политик улыбнулся и ответил <w>притворно</w>, с видом полнейшей невинности."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ask disingenuously",
                        "smile disingenuously"
                    ],
                    "target_lang_definitions": {
                        "ru": "Притворно, симулируя невинность, наивность или незнание с целью манипуляции или обмана."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "притворно",
                                "target_lang_sense_clarification": "изображая наивность или неведение"
                            },
                            {
                                "target_lang_word": "с наигранным простодушием",
                                "target_lang_sense_clarification": "делая вид, что ничего не понимаешь"
                            },
                            {
                                "target_lang_word": "ханжески",
                                "target_lang_sense_clarification": "лицемерно прикрываясь добродетелью"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fc7719ed-a6e2-3d2b-b255-a36fe5dbe9a0",
                    "sense_definition": "In an ignoble or dishonorable manner; unworthily.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "dishonor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He behaved <w>disingenuously</w> toward his former comrades by denying them the credit they deserved.",
                            "target_lang_translations": {
                                "ru": "Он поступил <w>недостойно</w> по отношению к своим бывшим товарищам, отказавшись признать их заслуги."
                            }
                        },
                        {
                            "text": "The knight was accused of acting <w>disingenuously</w>, forsaking his vows of chivalry.",
                            "target_lang_translations": {
                                "ru": "Рыцаря обвинили в том, что он поступил <w>бесчестно</w>, нарушив свои рыцарские клятвы."
                            }
                        }
                    ],
                    "synonyms": [
                        "ignobly",
                        "unworthily"
                    ],
                    "antonyms": [
                        "nobly",
                        "worthily"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rare or archaic usage denoting lack of nobility or honor"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Низко, недостойно, бесчестно (устаревшее значение)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "недостойно",
                                "target_lang_sense_clarification": "не подобающим честному человеку образом"
                            },
                            {
                                "target_lang_word": "низко",
                                "target_lang_sense_clarification": "подло, бесчестно"
                            },
                            {
                                "target_lang_word": "бесчестно",
                                "target_lang_sense_clarification": "нарушая долг чести"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}