                        "glosses": [
                            "A thin mattress or under bed stuffed with straw."
                        ],
                        "tags": [
                            "British"
                        ],
                        "examples": [
                            {
                                "example_id": "7c8effbf-b602-4ab1-88e1-4f565ad7190a",
                                "sense_id": "6889befd-2e05-3645-8dbd-8538952182de",
                                "text": "Out I sallied and spent sixteen shillings of it upon a new palliasse which should go under the straw mattress upon my bed."
                            },
                            {
                                "example_id": "07d206ed-043d-480f-ab32-7519002eee6f",
                                "sense_id": "6889befd-2e05-3645-8dbd-8538952182de",
                                "text": "First Hiker. Not even a straw mattress to cling to?\n Rosenstock. Not even a palliasse."
                            },
                            {
                                "example_id": "38f409ce-0f12-4096-b9aa-04e918ee44dd",
                                "sense_id": "6889befd-2e05-3645-8dbd-8538952182de",
                                "text": "1969, Dad's Army S03E02 You see that pile of straw over there? With it you stuff your palliasse."
                            }
                        ]
