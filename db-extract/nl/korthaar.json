                        "examples": [
                            {
                                "example_id": "ca5e0f78-1606-484e-8bab-fbeca32d3a3b",
                                "sense_id": "7346f33f-a007-32af-aaa8-f47b64de8304",
                                "text": "Twee dierenartsen hebben een sms-zoekdienst opgezet om weggelopen huisdieren terug te vinden. Het is geïnspireerd op het Amber Alert voor vermiste kinderen. Het systeem draait nu een week en Reutem had de primeur: een weggelopen kat - een Europese korthaar - is in één dag bij z'n baasje terug."
                            },
                            {
                                "example_id": "9c34f884-2e92-4db6-822c-72c440aac30c",
                                "sense_id": "7346f33f-a007-32af-aaa8-f47b64de8304",
                                "text": "De oudste kat ter wereld is overleden. Draquepitt uit Vlaardingen blies vorige week haar laatste adem uit. De Europese korthaar is 27 jaar geworden. Voor haar baasjes kwam haar dood toch nog als een verrassing. 'We hadden net twee dozen voer gehaald', vertellen zij in AD Rotterdams Dagblad."
                            }
                        ]
                    }
