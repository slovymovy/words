                    },
                    {
                        "translation_id": "c2e98e69-226b-4aa3-9479-593f7944c561",
                        "source_entry_id": "f340aa80-5704-329b-9123-970ed08b5f5a",
                        "source_sense_id": "497559c6-4473-3e43-9bcd-8222b25b3f51",
                        "target_lang_word": "traquet motteux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "traquet motteux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8258ebcb-e589-3978-9a30-a6b8a00826db",
                                        "entry_id": "51220334-446c-326e-9c9a-cb138458899e",
                                        "glosses": [
                                            "Espèce de petit oiseau, traquet brun, roussâtre, gris ou beige, et noir et blanc, avec le croupion blanc et chez le mâle un masque facial noir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b62b068c-35f8-475e-a883-9271f797355c",
                                                "sense_id": "8258ebcb-e589-3978-9a30-a6b8a00826db",
                                                "text": "Le traquet motteux d’Europe migre en septembre-octobre jusqu’en Afrique équatoriale."
                                            },
                                            {
                                                "example_id": "f23a392f-983b-4710-9370-ae5bf37e20c6",
                                                "sense_id": "8258ebcb-e589-3978-9a30-a6b8a00826db",
                                                "text": "Un traquet motteux sautillait sur le muret, et plus loin des alouettes chantaient."
                                            },
                                            {
                                                "example_id": "920541d4-d4bf-4c45-b7c5-a43d4809d077",
                                                "sense_id": "8258ebcb-e589-3978-9a30-a6b8a00826db",
                                                "text": "Dans les prairies plus ouvertes, ou au bord des rivières, on trouve des cincles, des traquets motteux et des alouettes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eb360a61-548f-4f19-a7b8-31492a9d4c68",
                        "source_entry_id": "f340aa80-5704-329b-9123-970ed08b5f5a",
                        "source_sense_id": "497559c6-4473-3e43-9bcd-8222b25b3f51",
                        "target_lang_word": "motteux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "motteux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ae0d37dc-bbe6-3efe-a30b-27860a81d285",
                                        "entry_id": "53f0b26e-9dc9-3e8c-a8cc-cd4d45bd1a7a",
                                        "glosses": [
                                            "Traquet motteux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "606cceb4-00f8-4e93-b169-1bd9af8c26e6",
                                                "sense_id": "ae0d37dc-bbe6-3efe-a30b-27860a81d285",
                                                "text": "On pourrait le reconnaître par les seuls noms qui lui ont été donnés en divers lieux : on l'appelle dans nos provinces motteux, tourne-motte, brise-motte et terrasson, de ses habitudes de se tenir toujours à terre et d'en habiter les trous, de se poser sur les mottes, et de paraître les frapper en secouant sa queue."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f568d7c7-3651-457e-9b37-1b2039324c6b",
                        "source_entry_id": "f340aa80-5704-329b-9123-970ed08b5f5a",
                        "source_sense_id": "497559c6-4473-3e43-9bcd-8222b25b3f51",
                        "target_lang_word": "cul-blanc",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cul-blanc",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e60298f9-7a8f-3aa6-9aca-80de43c4e533",
                                        "entry_id": "d6e30fb0-4248-3b62-b6ea-11845eea993c",
                                        "glosses": [
                                            "Oiseau ayant un croupion blanc tel que le chevalier culblanc, l’hirondelle de fenêtre, le pétrel, ou encore le traquet motteux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f579d3a-2f79-4c08-b506-4d0a929b9de1",
                                                "sense_id": "e60298f9-7a8f-3aa6-9aca-80de43c4e533",
                                                "text": "Çà et là s’évasent quelques mares où barbotent des culs-blancs, des bécassines et des judelles."
                                            },
                                            {
                                                "example_id": "70ecd0d6-a5ae-420a-b167-63da97398527",
                                                "sense_id": "e60298f9-7a8f-3aa6-9aca-80de43c4e533",
                                                "text": "Mon nouvel ami ramassa plusieurs culs-blancs, que les Français appellent « motteux », encore deux bédouïdes (il m’expliqua que c’était un « genre d’alouette ») et trois darnagas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "05e1a358-79b1-3f82-97b5-aba1ed5666f8",
                                        "entry_id": "d6e30fb0-4248-3b62-b6ea-11845eea993c",
                                        "glosses": [
                                            "Soldat de l’infanterie de ligne dont l’uniforme comporte un pantalon blanc."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a7f43fdf-e2a5-3261-b625-a8be5ec00a93",
                                        "entry_id": "d6e30fb0-4248-3b62-b6ea-11845eea993c",
                                        "glosses": [
                                            "Insulte utilisée envers les personnes leucodermes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8cc20b87-6ce8-4ef3-8f5d-0faa9e98707c",
                                                "sense_id": "a7f43fdf-e2a5-3261-b625-a8be5ec00a93",
                                                "text": "Petit cul-blanc, lâche vil et débauché, le grand cul-noir va venir te manger !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
