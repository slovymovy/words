    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "981ae609-d555-39a3-ae2c-4bd70d553e71",
                    "sense_definition": "Text displayed at the bottom of a screen that translates or transcribes the dialogue of a film or video.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "media_text",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I prefer to watch foreign movies with <w>subtitles</w> instead of dubbed audio."
                        },
                        {
                            "text": "The <w>subtitles</w> were too small to read clearly during the action scene."
                        }
                    ],
                    "synonyms": [
                        "caption"
                    ],
                    "common_phrases": [
                        "read subtitles",
                        "turn on subtitles"
                    ]
                },
                {
                    "sense_id": "7007a885-7830-30e3-a4cb-05697a9db822",
                    "sense_definition": "A secondary or explanatory title that follows the main title of a book or article.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "media_text",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The book has a long <w>subtitle</w> that explains its main argument."
                        },
                        {
                            "text": "The article's <w>subtitle</w> provides more context about the research findings."
                        }
                    ],
                    "common_phrases": [
                        "book subtitle"
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f39bbb69-da99-3fe3-826c-e1bc397836fd",
                    "sense_definition": "To add text to a film or video that translates or transcribes the dialogue.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "media_text",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The studio decided to <w>subtitle</w> the documentary for international audiences."
                        },
                        {
                            "text": "It is expensive to <w>subtitle</w> every episode of the series."
                        }
                    ],
                    "common_phrases": [
                        "subtitled film"
                    ]
                }
            ]
        }
    ]
