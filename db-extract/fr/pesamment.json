                    }
                ],
                "senses": [
                    {
                        "sense_id": "b25f9e17-3f99-316c-8d76-e59bcb99e31e",
                        "entry_id": "5f42cda8-2485-3866-ad92-d173e4d65d51",
                        "glosses": [
                            "D’une manière pesante."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9398d78b-5ae8-4504-ac8f-e8e3a786c66e",
                                "sense_id": "b25f9e17-3f99-316c-8d76-e59bcb99e31e",
                                "text": "Hemmelrich leva la main, la laissa retomber pesamment, comme s’il n’eût pu choisir qu’entre la détresse et l’absurdité de sa vie."
                            },
                            {
                                "example_id": "4b8c55d6-cdac-4504-b821-95349d0ed2bb",
                                "sense_id": "b25f9e17-3f99-316c-8d76-e59bcb99e31e",
                                "text": "Quand elle les rouvrit, les camions roulaient déjà et tressautaient pesamment sur le mauvais chemin."
                            },
                            {
                                "example_id": "dc7e44cf-7901-420b-8ded-47af4a08a8c1",
                                "sense_id": "b25f9e17-3f99-316c-8d76-e59bcb99e31e",
                                "text": "Marcher pesamment."
                            },
                            {
                                "example_id": "228c916e-93d1-4808-9b6e-cb447c8e5dd7",
                                "sense_id": "b25f9e17-3f99-316c-8d76-e59bcb99e31e",
                                "text": "Être chargé pesamment."
                            }
                        ]
                    },
                    {
                        "sense_id": "56962478-551f-3489-851b-393f73d19026",
                        "entry_id": "5f42cda8-2485-3866-ad92-d173e4d65d51",
                        "glosses": [
                            "De toutes pièces, en parlant d'armer des soldats de l’antiquité, fantassins ou cavaliers."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "ec4310ba-5614-4019-a033-8ab446fb28b0",
                                "sense_id": "56962478-551f-3489-851b-393f73d19026",
                                "text": "Pesamment armé."
                            }
                        ]
                    },
                    {
                        "sense_id": "f3bd9321-af70-3390-9b6a-9d8b27bdc214",
                        "entry_id": "5f42cda8-2485-3866-ad92-d173e4d65d51",
                        "glosses": [
                            "De façon peu élégante, avec lourdeur, avec insistance."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "b9351347-ad0a-479b-ad25-691b18d2ced1",
                                "sense_id": "f3bd9321-af70-3390-9b6a-9d8b27bdc214",
                                "text": "Parler, écrire pesamment."
                            },
                            {
                                "example_id": "8c6f4814-b58e-49d3-9992-b1af89922dbf",
                                "sense_id": "f3bd9321-af70-3390-9b6a-9d8b27bdc214",
                                "text": "Insister pesamment."
                            }
                        ]
                    }
                ],
