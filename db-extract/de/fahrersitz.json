                "senses": [
                    {
                        "sense_id": "8c27d445-b9b0-3212-a9b9-f5892007b95b",
                        "entry_id": "79584667-2722-34d1-b78f-7c1baa784263",
                        "glosses": [
                            "Platz in einem Fahrzeug, der für den Fahrer des Fahrzeugs vorgesehen ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49de2336-df88-4dab-ad5d-035e24319871",
                                "sense_id": "8c27d445-b9b0-3212-a9b9-f5892007b95b",
                                "text": "„Frauen sind generell risikobewusster als Männer: Neun von zehn Lenkerinnen schnallen sich am Fahrersitz an, bei den Männer tun dies wenigstens auch 88 Prozent.“"
                            },
                            {
                                "example_id": "aac5ed8f-a7ad-41f3-a2d3-867a54f4ca1a",
                                "sense_id": "8c27d445-b9b0-3212-a9b9-f5892007b95b",
                                "text": "„Es ist kurz vor sechs Uhr morgens und noch dunkel, der Hafen von Chania nur spärlich beleuchtet, als sich Marco Didone auf den Fahrersitz des vollbepackten Wohnmobils schwingt.“"
                            },
                            {
                                "example_id": "a77f1c08-d85c-4344-851e-2562359d60f3",
                                "sense_id": "8c27d445-b9b0-3212-a9b9-f5892007b95b",
                                "text": "„Die Gefahr für die Fahrer der Hochleistungshäcksler sei sehr groß, weil der Mais bei der Ernte direkt unter dem Fahrersitz aufgenommen und ‚mit Riesenkräften‘ zerkleinert wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
