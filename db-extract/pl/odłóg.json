                                    },
                                    {
                                        "sense_id": "326d63d6-b3c7-3574-9673-f7e9a1d50c47",
                                        "entry_id": "438d4335-d195-3b43-9007-a950f6d8dc98",
                                        "glosses": [
                                            "The ploughing or tilling of land, without sowing it for a season."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26641e44-0f0e-4cd1-b8a3-59085e9486e9",
                                                "sense_id": "326d63d6-b3c7-3574-9673-f7e9a1d50c47",
                                                "text": "By a complete summer fallow, land is rendered tender and mellow. The fallow gives it a better tilth than can be given by a fallow crop."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fallow",
