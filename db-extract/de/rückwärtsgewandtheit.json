                "senses": [
                    {
                        "sense_id": "d7d01ee1-7147-3b39-a993-13881b908bbd",
                        "entry_id": "101cdc71-eb30-3e57-9a62-ce2940372e1a",
                        "glosses": [
                            "Haltung, auf eine zurückliegende Zeit gerichtet zu sein, sich auf einen vergangenen Zustand zu beziehen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44b9f14b-e962-43cd-91de-eca3e9ba14b6",
                                "sense_id": "d7d01ee1-7147-3b39-a993-13881b908bbd",
                                "text": "„Wenn überhaupt, scheint es eine zunehmende Rückwärtsgewandtheit zu geben, eine Sehnsucht nach früheren, einfacheren Tagen.“"
                            },
                            {
                                "example_id": "bf07f1d8-89f2-4ccc-a82a-5af4431a87e3",
                                "sense_id": "d7d01ee1-7147-3b39-a993-13881b908bbd",
                                "text": "„All dies mag auch auf einen besonderen Bezug der Melancholie zum autobiographischen Schreiben hindeuten, auf eine Rückwärtsgewandtheit, derer das eigene Ich in immer neuen Spiegeln und Reflexionen gewahr werden will.“"
                            },
                            {
                                "example_id": "8cb9ad0f-c234-452d-a81d-a0506a153351",
                                "sense_id": "d7d01ee1-7147-3b39-a993-13881b908bbd",
                                "text": "„Denn bei aller Rückwärtsgewandtheit war der Nationalsozialismus keineswegs eine antimodernistische oder technikfeindliche Ideologie.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
