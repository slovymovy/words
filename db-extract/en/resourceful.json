                                                "example_id": "a41c9565-9278-455d-b30a-4de821926ff2",
                                                "sense_id": "37e3d18f-c14e-373b-b1ba-8e2f106ce4a8",
                                                "text": "C’est un futé matois."
                                            },
                                            {
                                                "example_id": "dcd68ce4-0e79-4d6c-806e-d8dce8f809b2",
                                                "sense_id": "37e3d18f-c14e-373b-b1ba-8e2f106ce4a8",
                                                "text": "Un air futé, une mine futée, un sourire futé."
                                            },
                                            {
                                                "example_id": "4017c092-a95c-4919-ba80-c5bcfc1e2d38",
                                                "sense_id": "37e3d18f-c14e-373b-b1ba-8e2f106ce4a8",
                                                "text": "Toute cette physionomie de naine futée était comme le masque vivant de l’intrigue, de l’ambition active et envieuse."
                                            },
                                            {
                                                "example_id": "0e36df91-fb3b-4f29-8427-8b2d6a4db0ed",
                                                "sense_id": "37e3d18f-c14e-373b-b1ba-8e2f106ce4a8",
                                                "text": "Distraction ou manque de jugement, plusieurs suspects peu futés ont facilité le travail des policiers en 2020."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "futé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "70acdbb6-eb88-37df-b020-ae441c416665",
                                        "entry_id": "3b2d8be8-cb3a-3d70-b7bb-1010240af462",
                                        "glosses": [
                                            "Qualifie le fût, le bois d'un meuble dont la couleur est d'un autre émail."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "843806f8-3cbd-4e3b-bf99-eb33e9cedb59",
                                                "sense_id": "70acdbb6-eb88-37df-b020-ae441c416665",
                                                "text": "D’or à trois javelines de gueules, futées de sable."
                                            },
                                            {
                                                "example_id": "8590c0ac-1d5c-4f20-ab55-198a82676125",
                                                "sense_id": "70acdbb6-eb88-37df-b020-ae441c416665",
                                                "text": "De gueules à la bêche d’argent futée d’or, mantelé d’azur à deux étoiles d’argent, au chevron d’or brochant sur la partition, qui est de Moriat dans le Puy-de-Dôme"
                                            }
                                        ]
                                    }
