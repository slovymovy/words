                "translations": [
                    {
                        "translation_id": "1f376229-cabc-4368-8b16-c72c44cf327e",
                        "source_entry_id": "2b8c56ef-ab37-3843-b7ad-9649eec0afa6",
                        "source_sense_id": "b2550433-fa6a-3a3c-b460-bddb677073b1",
                        "source_sense_description": "een stuk vlees van een varken, kalf of lam",
                        "target_lang_word": "Kotelett",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kotelett",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bb87fd4a-3deb-330f-90c8-b36d36063e8e",
                                        "entry_id": "89052b28-661e-3788-8734-bcd5e2f120fc",
                                        "glosses": [
                                            "Fleischscheibe aus dem Rippenstück eines Schlachttieres"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0c26b91-5357-4243-937f-311812d7a444",
                                                "sense_id": "bb87fd4a-3deb-330f-90c8-b36d36063e8e",
                                                "text": "Zur Hauptspeise gibt es Koteletts vom Lamm mit Kartoffeln und Bohnen."
                                            },
                                            {
                                                "example_id": "1ab84ae2-38d2-4be2-b941-2b3ead017c56",
                                                "sense_id": "bb87fd4a-3deb-330f-90c8-b36d36063e8e",
                                                "text": "„Am Rand des Tisches im Vordergrund liegen zwei Stücke Fleisch, eine große Lammkeule und ein kleines Kotelett.“"
                                            },
                                            {
                                                "example_id": "a08f20d5-14a8-4ec3-810d-eb06aab44b92",
                                                "sense_id": "bb87fd4a-3deb-330f-90c8-b36d36063e8e",
                                                "text": "„Während sie sich ein Mittagessen aus Porreegemüse, Kartoffeln und – weil Sonntag ist – einem Kotelett zubereitet, beruhigt sie sich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8f38d5d4-e5f6-3ab0-afe5-5d14e2d7a696",
                                        "entry_id": "89052b28-661e-3788-8734-bcd5e2f120fc",
                                        "glosses": [
                                            "Haarfläche vor den Ohren"
                                        ],
                                        "tags": [
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c68d5c71-e78e-4152-8bbe-1224750710b3",
                                                "sense_id": "8f38d5d4-e5f6-3ab0-afe5-5d14e2d7a696",
                                                "text": "„Er trug einen Anzug aus geköpertem Barchent, seine Haltung war steif, der Backenbart zu Koteletten gestutzt; so wirkte er wie ein Beamter und Dandy zugleich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
