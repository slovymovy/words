                                "target_senses": [
                                    {
                                        "sense_id": "b9e82f3b-b4ca-39f3-822d-707768bc8632",
                                        "entry_id": "0502bfc1-da4f-3c96-8c44-aa0c331c539a",
                                        "glosses": [
                                            "The act of giving comfort."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e07d1d92-03fe-470a-809b-ff945bd0c760",
                                                "sense_id": "b9e82f3b-b4ca-39f3-822d-707768bc8632",
                                                "text": "Intrenched within the citadel of our apartment, and cheered by the comfortings of a coal fire, we passed the day in letter-writing, conversation, or gazing from the sheltered security of our windows upon the agitated sea[…]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "14a9d1f7-5b03-488d-a292-2c5e4b5e3b19",
                        "source_entry_id": "ba02b6a4-7957-388f-8fd5-c2776b81215e",
                        "source_sense_id": "301f260e-b8f1-3bdf-91e5-68d446560067",
                        "target_lang_word": "troostend",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "troostend",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "b07fb5b5-e83a-31a8-ba3b-8b771bc392a5",
                                        "entry_id": "1f6cf84a-0b52-368b-bd7b-6732e38515c7",
                                        "glosses": [
                                            "onvoltooid deelwoord van troosten"
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed64a399-9ef6-4e5d-af5a-6df04bcc59c4",
                                                "sense_id": "b07fb5b5-e83a-31a8-ba3b-8b771bc392a5",
                                                "text": "Bij het verlaten van de zaal raakte Romy's moeder troostend de schouder aan van Brians huilende pleegmoeder."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "troostend",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "8b9ef315-b162-3c94-92a6-0dd392273274",
                                        "entry_id": "f9f55918-0db9-3275-9600-1fe028b9d6ae",
                                        "glosses": [
                                            "uiting waarbij men probeert het verdriet van anderen te verzachten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8367322-b006-4633-87a1-1717fce25579",
                                                "sense_id": "8b9ef315-b162-3c94-92a6-0dd392273274",
                                                "text": ",,Ik weet niet of het een verrassing is, maar alle ouders hebben dezelfde klachten. Ze luisteren niet. Je kunt honderd keer iets zeggen, dan doen ze het nóg niet. Daarom is dit een troostend programma. Het is ook gewoon leuk om te zien dat iedereen worstelt met dezelfde dingen die over een paar jaar helemaal voorbij zijn. Dan krijgen pubers relaties en kinderen, want ja, het gáát over.”"
                                            },
                                            {
                                                "example_id": "41e5b4b6-a1f8-4c86-b826-3cde09e73c2f",
                                                "sense_id": "8b9ef315-b162-3c94-92a6-0dd392273274",
                                                "text": "Ook bij het afscheid van de Republikeinse Senator John McCain maakte hij weer indruk met zijn troostende woorden. Amerikaanse media denken dat die eigenschappen hem in 2020 wel eens in het Witte Huis zouden kunnen brengen."
                                            },
                                            {
                                                "example_id": "234e7e75-10a9-42d7-a051-af14d2b2e214",
                                                "sense_id": "8b9ef315-b162-3c94-92a6-0dd392273274",
                                                "text": ",,Ik heb je vandaag hard zien werken en je toren staat. Daar mag je trots op zijn\", luidden de troostende woorden van Robèrt."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "10f3bc2c-30a1-4ead-bc4e-f5db02bb2946",
                        "source_entry_id": "ba02b6a4-7957-388f-8fd5-c2776b81215e",
                        "source_sense_id": "301f260e-b8f1-3bdf-91e5-68d446560067",
                        "target_lang_word": "geruststellend",
                        "target_lang_code": "nl",
