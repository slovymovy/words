                                            {
                                                "example_id": "a1357b9e-52fa-429c-9969-4c570864e366",
                                                "sense_id": "c5a52179-dae9-3dce-8064-652b9221a5ef",
                                                "text": "Hij schrijft zo onduidelijk dat ik niet weet of hier een één of een zeven staat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8aba05f3-1878-3572-aef1-728286f76bcc",
                                        "entry_id": "ef7ac255-b4bb-32f1-857f-732cdcef58ed",
                                        "glosses": [
                                            "dat wat in een (rang)ordening met 7 is aangeduid"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cde6cd4b-2106-4940-89c7-41d2a3b5972f",
                                                "sense_id": "8aba05f3-1878-3572-aef1-728286f76bcc",
                                                "text": "Het is weer de zeven die het niet doet, kunnen we die niet simpel vervangen?"
                                            },
                                            {
                                                "example_id": "1bcda2cc-cb25-439e-b562-afab57cec4fd",
                                                "sense_id": "8aba05f3-1878-3572-aef1-728286f76bcc",
                                                "text": "Ze dacht dat ze niets van het examen had begrepen, maar ze haalde toch een zeven."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "863cdfa4-75d7-3b04-8482-e44242d89151",
                                        "entry_id": "ef7ac255-b4bb-32f1-857f-732cdcef58ed",
                                        "glosses": [
                                            "groep van 7 eenheden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2d1b8cd-cba4-4234-aa0e-ce6cd0d427c9",
                                                "sense_id": "863cdfa4-75d7-3b04-8482-e44242d89151",
                                                "text": "De grote zeven zijn natuurlijk blij met dit beleid, maar alle kleinere bedrijven worden juist benadeeld."
                                            }
                                        ]
