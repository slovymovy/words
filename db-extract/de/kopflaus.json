                "senses": [
                    {
                        "sense_id": "4d5d6304-c31f-32ec-b0bd-d914889ac8f3",
                        "entry_id": "da443167-4a8f-3537-adc7-c3c88f4abf32",
                        "glosses": [
                            "Laus, die im Haupthaar des Menschen siedelt"
                        ],
                        "tags": [
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "3499f0f8-3a19-45f8-b253-fba1787df65a",
                                "sense_id": "4d5d6304-c31f-32ec-b0bd-d914889ac8f3",
                                "text": "„Eine Kopflaus muss alle drei bis vier Stunden essen.“"
                            },
                            {
                                "example_id": "5e4f6146-b8b9-4b30-9a7f-071b3b44b7a8",
                                "sense_id": "4d5d6304-c31f-32ec-b0bd-d914889ac8f3",
                                "text": "„Archäologen haben einen 2000 Jahre alten Kamm mit intakter Kopflaus in einem römischen Kastell in England entdeckt.“"
                            },
                            {
                                "example_id": "df36512b-415d-4d10-8e3b-7f991471cc82",
                                "sense_id": "4d5d6304-c31f-32ec-b0bd-d914889ac8f3",
                                "text": "„Denn entgegen einer beliebten Annahme verbreiten sich Kopfläuse nicht über Gegenstände, sondern praktisch ausschließlich über direkten Kopfkontakt.“"
                            },
                            {
                                "example_id": "7f8930af-2900-4977-a82f-d87abe6f1e99",
                                "sense_id": "4d5d6304-c31f-32ec-b0bd-d914889ac8f3",
                                "text": "„Graeber hatte keine Kopfläuse.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7c88f738-0513-4676-95a1-3300a85a0346",
                        "source_entry_id": "da443167-4a8f-3537-adc7-c3c88f4abf32",
                        "source_sense_id": "4d5d6304-c31f-32ec-b0bd-d914889ac8f3",
                        "source_sense_description": "meist im Plural: Laus, die im Haupthaar des Menschen siedelt",
                        "target_lang_word": "head louse",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "head louse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d481fd3a-91b4-32d5-892e-158d4d701ee7",
                                        "entry_id": "973e6c3b-1591-34e2-a7cb-543e3a771605",
                                        "glosses": [
                                            "A parasitic insect, Pediculus humanus capitis, which lives among the hairs on the head of a human and feeds on blood."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bd783b5d-5cfb-476f-99a2-1a37b2bd7903",
                        "source_entry_id": "da443167-4a8f-3537-adc7-c3c88f4abf32",
                        "source_sense_id": "4d5d6304-c31f-32ec-b0bd-d914889ac8f3",
                        "source_sense_description": "meist im Plural: Laus, die im Haupthaar des Menschen siedelt",
                        "target_lang_word": "pou",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pou",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "777f5b05-4a83-3675-910f-1d24d7434025",
                                        "entry_id": "5c660169-9845-3d09-99d2-0b58bebb74d2",
                                        "glosses": [
                                            "Très petit insecte parasite sans ailes qui s’attache à plusieurs espèces d’animaux dont l’humain, agent de phtiriase et pouvant transmettre des maladies."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2951909d-4ed4-4a99-bf29-e47b9a92e39d",
                                                "sense_id": "777f5b05-4a83-3675-910f-1d24d7434025",
                                                "text": "La nicotiane eﬅ ennemie des poux & des puces, ſuivant J. Bauhin : on prétend que ſa fumée éloigne toute ſorte d’inſectes, même les punaiſes. On a obſervé que ſa poudre est mortelle aux léſards, ſang-ſues & limaçons."
                                            },
                                            {
                                                "example_id": "ea83dfb5-6e37-476e-9d84-5a2b32dae644",
                                                "sense_id": "777f5b05-4a83-3675-910f-1d24d7434025",
                                                "text": "Il entend leurs cils noirs battant sous les silences\nParfumés ; et leurs doigts électriques et doux\nFont crépiter parmi ses grises indolences\nSous leurs ongles royaux la mort des petits poux."
                                            },
                                            {
                                                "example_id": "f58279bb-3a26-45be-ae2f-19216f879fb6",
                                                "sense_id": "777f5b05-4a83-3675-910f-1d24d7434025",
                                                "text": "Syphilitique par vocation, sans qu’un regard en arrière vînt lui donner quelque regret, elle eut la tête pleine de poux sans qu’un désir lui vînt de propreté et ses jupes enroulaient autour d’elles une odeur de vice et de crasse qui faisait les hommes accourir."
                                            },
                                            {
                                                "example_id": "245129c0-6bb5-4bb7-b391-ce2001c76d38",
                                                "sense_id": "777f5b05-4a83-3675-910f-1d24d7434025",
                                                "text": "Une distinction biologique fondamentale avec R. prowazeki consiste en ce que R. quintana se multiplie extracellulairement dans l’estomac des poux. L'agent n'est donc pas pathogène pour les poux – nouvelle différence avec R. prowazeki."
                                            },
                                            {
                                                "example_id": "149806ca-a063-4e76-a655-3a13ba96b404",
                                                "sense_id": "777f5b05-4a83-3675-910f-1d24d7434025",
                                                "text": "… j’avais l’impression d’être toujours plutôt propre, et ces poux dans ma tête ne me paraissaient pas bien différents des microbes qu’on attrape, on n’y peut rien, par contagion, comme j’avais attrapé la rougeole…"
                                            },
                                            {
                                                "example_id": "d7b2b951-9ab9-4778-bd17-93e7caa69be6",
                                                "sense_id": "777f5b05-4a83-3675-910f-1d24d7434025",
                                                "text": "Contrairement aux diptères et aux hémiptères, les poux (ou Phtiraptères) sont dépourvus d’ailes et sont de vrais parasites, dans la mesure où leur vie se déroule entièrement sur la peau de leur hôte et où ils sont incapables de survivre beaucoup plus d’une journée privés de son contact. Ils sont aplatis dorso-ventralement et, bien plus petits en taille que les mouches, mesurent entre 1 et 5 mm environ."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d8fe0875-d5d9-38df-8181-62a57cbd1610",
                                        "entry_id": "5c660169-9845-3d09-99d2-0b58bebb74d2",
                                        "glosses": [
                                            "Personne laide."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dea5b40a-3780-4556-8147-488e77427516",
                                                "sense_id": "d8fe0875-d5d9-38df-8181-62a57cbd1610",
                                                "text": "– Mademoiselle, ils m’ont appelé vilain pou ! Ils ont dit que j’étais un affreux !\nElle n’a même pas besoin de parler ; elle donne un sourire à l’affreux et il s’en retourne plein de superbe :\n– Ah ! ah ! c’est pas vrai, j’suis pas un vilain pou !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
