                "senses": [
                    {
                        "sense_id": "d31da8fb-0f93-3220-bfc6-c4075fb07bbe",
                        "entry_id": "7b15e930-de2d-3bfc-95bd-ed2f4d6e1538",
                        "glosses": [
                            "Person, die eine Sportart nicht beruflich, sondern nur als Hobby ausübt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d59d36ff-1e6c-4f62-a597-a645a6bfd36d",
                                "sense_id": "d31da8fb-0f93-3220-bfc6-c4075fb07bbe",
                                "text": "„Einen Tag nach der Siegerehrung erfuhr der Amateursportler, dass ihm der Sieg aberkannt wurde.“"
                            },
                            {
                                "example_id": "94515167-600c-48b4-bbca-06a14e8708c2",
                                "sense_id": "d31da8fb-0f93-3220-bfc6-c4075fb07bbe",
                                "text": "„Die Stiftung Deutsche Sporthilfe macht in diesen Tagen mit einer Anzeigenkampagne darauf aufmerksam, wie wenig Amateursportler verdienen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
