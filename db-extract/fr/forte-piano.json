                                                "sense_id": "36bd7324-885f-306b-a55a-7750103cd0ec",
                                                "text": "В зале стояло фортепиано, матушка играла вальс, дети вертелись."
                                            },
                                            {
                                                "example_id": "e3e01277-2464-474e-a3d7-29e5af95ae9d",
                                                "sense_id": "36bd7324-885f-306b-a55a-7750103cd0ec",
                                                "text": "Сегодня проснулся оттого, что за стеной играли на фортепиано."
                                            }
                                        ]
                                    }
