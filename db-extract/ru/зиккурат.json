                "senses": [
                    {
                        "sense_id": "480c8a44-2e5d-3c05-b808-c1e116f8119e",
                        "entry_id": "ad57828d-1c87-31a8-b686-c741c98c8dc2",
                        "glosses": [
                            "истор., архит. многоступенчатое культовое сооружение в древнем Междуречье"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3af37a99-28d6-40c3-b334-960d3442f6e2",
                                "sense_id": "480c8a44-2e5d-3c05-b808-c1e116f8119e",
                                "text": "Пирамиды строго ориентированы по странам света, зиккураты служили для астрономических наблюдений и так далее."
                            }
                        ]
                    },
                    {
                        "sense_id": "dbd4cd3d-b1d9-3547-8bdb-aa9b871926db",
                        "entry_id": "ad57828d-1c87-31a8-b686-c741c98c8dc2",
                        "glosses": [
                            "перен. монументальное сооружение"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a16c61c-c3bb-497c-a637-b9f2af2c27e6",
                                "sense_id": "dbd4cd3d-b1d9-3547-8bdb-aa9b871926db",
                                "text": "Увидев любимого друга Фиделя и прочих команданте на трибуне московского зиккурата, Тушинский воспрял."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c7d197cb-d4c1-4849-97f0-3b2552322e3b",
                        "source_entry_id": "ad57828d-1c87-31a8-b686-c741c98c8dc2",
                        "source_sense_description": "многоступенчатое культовое сооружение в древнем Междуречье",
                        "target_lang_word": "ziggurat",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ziggurat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5acd7baa-22a8-339f-a676-777cf95e4e73",
                                        "entry_id": "769c6741-a829-3199-8e51-f3039976e0a1",
                                        "glosses": [
                                            "A temple tower of the ancient Mesopotamian valley, having the form of a terraced pyramid of successively receding stories"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87825f64-e331-4371-a968-a99e3b834394",
                                                "sense_id": "5acd7baa-22a8-339f-a676-777cf95e4e73",
                                                "text": "It would be uplifting to think that the ziggurat was the first expression of Near Eastern civilization, for then one could speak about humanity's fascination with the heavens, of the human quest for communion with the infinite."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a4be634-8b04-33af-be86-a32462fc8255",
                                        "entry_id": "769c6741-a829-3199-8e51-f3039976e0a1",
                                        "glosses": [
                                            "Any building with similar style or shape."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "344f98a1-0912-426b-9ee9-25f8a1fa06fb",
                                                "sense_id": "1a4be634-8b04-33af-be86-a32462fc8255",
                                                "text": "He works in an old ziggurat of an office building."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
