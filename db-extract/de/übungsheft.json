                "senses": [
                    {
                        "sense_id": "e7bc12d5-8827-3ea6-ae72-d29fa950cd64",
                        "entry_id": "da53b5f5-89f6-33ef-bcb9-34e3b44339f2",
                        "glosses": [
                            "Heft mit Übungsaufgaben für Schüler"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1988dd70-09af-4841-bcfe-678709759512",
                                "sense_id": "e7bc12d5-8827-3ea6-ae72-d29fa950cd64",
                                "text": "„So blätterte auch der fünfjährige Justus aus Lübstorf schon mal in Übungsheften der Grundschüler und ließ sich von seinem großen Bruder Tim-Luca, der bereits die dritte Klasse in Lübstorf besucht, einiges über den Unterricht erzählen.“"
                            },
                            {
                                "example_id": "19ec8e4f-33ca-4b50-938b-fe9b4b1d4a57",
                                "sense_id": "e7bc12d5-8827-3ea6-ae72-d29fa950cd64",
                                "text": "„Zum ersten Anleitungsbuch sind schnell weitere dazugekommen, mittlerweile gibt es ein Übungsheft und ein Buch nur mit Schmuckelementen wie Blumenkränzen oder Borten – auch in einer Weihnachtsversion.“"
                            },
                            {
                                "example_id": "aa2458f3-5dc0-436c-99e4-bb768d680aa2",
                                "sense_id": "e7bc12d5-8827-3ea6-ae72-d29fa950cd64",
                                "text": "„Tina Beer bekommt ein Übungsheft, ein Linienpapier und einen Füller in die Hand gedrückt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
