                "senses": [
                    {
                        "sense_id": "209388dd-87d1-332c-9da6-e1603eedbb10",
                        "entry_id": "9cabc5ef-d5a4-31d6-8473-efe0b16a7b7d",
                        "glosses": [
                            "Présider en commun."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "634085ba-17b9-4073-a74e-8977466f9aca",
                                "sense_id": "209388dd-87d1-332c-9da6-e1603eedbb10",
                                "text": "La Roumanie a été l’un des trois pays à co-présider la Charte pour l’investissement en Europe du Sud-Est parrainée par l’OCDE."
                            },
                            {
                                "example_id": "fc482cd1-eb90-4727-baf8-6cbfa03de859",
                                "sense_id": "209388dd-87d1-332c-9da6-e1603eedbb10",
                                "text": "Ils n’ont impliqué aucun autre pays, si ce n’est en faisant estampiller le résultat de leurs négociations préliminaires par les Soviétiques, invités à co-présider la réunion de Madrid par pur souci de symétrie."
                            }
                        ]
                    }
