                                "target_senses": [
                                    {
                                        "sense_id": "691548fd-7149-3ee8-873f-9db5e3002328",
                                        "entry_id": "10cc1726-6bba-39df-a27c-876739f62ee8",
                                        "glosses": [
                                            "To caramelize."
                                        ],
