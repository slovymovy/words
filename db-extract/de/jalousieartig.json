                ],
                "senses": [
                    {
                        "sense_id": "a6875480-a9b8-3773-bbf4-261e37d7d982",
                        "entry_id": "47ab5bae-8645-371a-bc61-40da303e3ac1",
                        "glosses": [
                            "Jalousien ähnelnd, wie Jalousien aussehend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0cec5b62-74eb-481a-8897-1415d5e3b35b",
                                "sense_id": "a6875480-a9b8-3773-bbf4-261e37d7d982",
                                "text": "„Er schob das Nachtschränkchen an die Wand hinüber, stieg darauf, zog einen Schraubenzieher aus der Gesäßtasche und begann die Schrauben der jalousieartigen Abdeckung des Belüftungsschachts herauszudrehen.“"
                            },
                            {
                                "example_id": "628dd8c6-b4bc-4895-b89b-aa504eb855cd",
                                "sense_id": "a6875480-a9b8-3773-bbf4-261e37d7d982",
                                "text": "„Die Wände bestanden aus leichten verschiebbaren Shoji, von denen manche mit jalousieartigen Latten versehen, die meisten jedoch mit dem üblichen Ölpapier bezogen waren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
