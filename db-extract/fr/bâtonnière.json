                                        "glosses": [
                                            "A lawyer with the right to speak and argue as an advocate in higher lawcourts."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "Ireland",
                                            "New-Zealand",
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10730967-3b03-4bdf-8a67-7b251ab3e817",
                                                "sense_id": "23522915-7997-34a9-8f29-23174342d61c",
                                                "text": "Postmen, binmen, dock workers, even barristers are now on strike. Where will all this end?"
