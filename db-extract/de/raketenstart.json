                "senses": [
                    {
                        "sense_id": "349ebdeb-9701-345e-8912-3eae1c2a5032",
                        "entry_id": "e3dd44e2-dcb7-339c-8177-d45e888be996",
                        "glosses": [
                            "das Abheben, der Start einer Rakete"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "973d2c5e-3da6-41c5-a7a4-6ecf250f856b",
                                "sense_id": "349ebdeb-9701-345e-8912-3eae1c2a5032",
                                "text": "Der umstrittene Raketenstart von Nordkorea endete nach kurzer Flugzeit mit einem Absturz in das Meer."
                            },
                            {
                                "example_id": "a7c6046c-aee3-49dd-8a4b-94ff8916ed5c",
                                "sense_id": "349ebdeb-9701-345e-8912-3eae1c2a5032",
                                "text": "„Der Generalstab der südkoreanischen Armee warf dem Nachbarland am Sonntag vor, mit dem Raketenstart gegen UNO-Resolutionen verstoßen und eine Demonstration der Stärke gegenüber der neuen US-Regierung von Präsident Donald Trump unternommen zu haben.“"
                            },
                            {
                                "example_id": "da6a2056-f850-4723-9cfb-ab695981bd90",
                                "sense_id": "349ebdeb-9701-345e-8912-3eae1c2a5032",
                                "text": "„Der Tesla-Gründer und Raketenpionier Elon Musk will es erneut wissen. Seine Weltraumfirma SpaceX wagt heute einen weiteren Raketenstart und hofft, dass das Schiff wieder landen kann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
