                ],
                "senses": [
                    {
                        "sense_id": "8997b5dd-83bc-3de8-909f-2c3b6d06ce9a",
                        "entry_id": "8219c38f-e85e-3820-8501-c222b95111cb",
                        "glosses": [
                            "zusammenhängende unterrichtsfreie Tage im Sommer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c498506-9055-483f-bea0-77ffce7e13ee",
                                "sense_id": "8997b5dd-83bc-3de8-909f-2c3b6d06ce9a",
                                "text": "In den Sommerferien fahren wir nach Italien."
                            },
                            {
                                "example_id": "ddf33530-5696-4f0a-bafb-663a8d8e1fca",
                                "sense_id": "8997b5dd-83bc-3de8-909f-2c3b6d06ce9a",
                                "text": "„Es ist das Ende der Sommerferien, jedenfalls für die, die das Glück haben, einer Arbeit nachgehen zu können, von der sie sich erholen müssen.“"
                            },
                            {
                                "example_id": "273b7c58-d15b-4b36-a92a-492df6c1ae29",
                                "sense_id": "8997b5dd-83bc-3de8-909f-2c3b6d06ce9a",
                                "text": "„Die Sommerferien erschienen ihm zu lang.“"
                            },
                            {
                                "example_id": "0aaacb1f-357b-4906-b8d3-18923d8f774a",
                                "sense_id": "8997b5dd-83bc-3de8-909f-2c3b6d06ce9a",
                                "text": "„Die Sommerferien erschienen uns unendlich lang.“"
                            },
                            {
                                "example_id": "6b5674b9-f62b-4632-ad0b-bc6ce9e14254",
                                "sense_id": "8997b5dd-83bc-3de8-909f-2c3b6d06ce9a",
                                "text": "„Es folgen die ersten Sommerferien im Kinderdorf.“"
                            },
                            {
                                "example_id": "68d2d7cf-4c79-42eb-a74e-66de49dfdfd7",
                                "sense_id": "8997b5dd-83bc-3de8-909f-2c3b6d06ce9a",
                                "text": "„Zur Einstimmung in die Sommerferien hatte Renate sich Asterix in Spanien gekauft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
