                        "examples": [
                            {
                                "example_id": "6109a25e-5ffe-47cd-9336-52d5a873f1ca",
                                "sense_id": "907557be-b5fa-3ac9-95e1-e6a6bdbb5d19",
                                "text": "It has been little altered over the years save for the addition of a platform awning which rather obscures the arcaded entrance to the booking hall."
                            },
                            {
                                "example_id": "43a22da4-1a07-49d4-bd8f-82fb1d2a1045",
                                "sense_id": "907557be-b5fa-3ac9-95e1-e6a6bdbb5d19",
                                "text": "There they were, already, in the central hall, the great feature of the house, two storeys high, with an arcaded gallery on the upper level, and a giant chimneypiece made from bits of a baroque tomb."
                            },
                            {
                                "example_id": "98f25c94-8bc0-41dd-b374-1f8902595afc",
                                "sense_id": "907557be-b5fa-3ac9-95e1-e6a6bdbb5d19",
                                "text": "The station also boasts a large semi-domed French pavilion roof with fish-scale tiles and iron cresting, plus a rectangular hall with arcaded upper storey and wooden lantern."
                            }
                        ]
