                        "entry_id": "7a750760-1964-3242-aae6-9e1fccf6701f",
                        "glosses": [
                            "Migration massive et destructrice de fourmis légionnaires."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "847323af-db5b-4a39-8b57-9aeee29ab58e",
                                "sense_id": "62cc0faf-e10d-3e3a-a01d-73ebcfd50ba6",
                                "text": "Des milliards de grains de silice rapides et disciplinés par un vent invisible, comme des marabuntas de minuscules fourmis blondes, minérales et obstinées."
                            },
                            {
                                "example_id": "e3b83408-cdfe-46be-9b53-170fd70be8e5",
                                "sense_id": "62cc0faf-e10d-3e3a-a01d-73ebcfd50ba6",
                                "text": "Quand la marabunta gronde."
                            }
                        ]
                    },
                    {
                        "sense_id": "a3cc19cd-4f75-31a2-87c0-ce2e458b962b",
                        "entry_id": "7a750760-1964-3242-aae6-9e1fccf6701f",
                        "glosses": [
                            "Fourmi légionnaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3a7e41c-37d0-4a2e-bcd4-bcb746c7d0de",
                                "sense_id": "a3cc19cd-4f75-31a2-87c0-ce2e458b962b",
                                "text": "Les maras, abréviation de « marabunta », une fourmi carnivore d'Amazonie, comptent aussi des dizaines de milliers de membres aux États-Unis, au Honduras ou au Guatemala."
                            }
                        ]
                    }
