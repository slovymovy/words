                                        "sense_id": "bbc1b5b6-a3d5-3bd1-8e2d-c823498594ac",
                                        "entry_id": "e3fbb861-4c76-3884-b3e9-261944d3ba1f",
                                        "glosses": [
                                            "A small projection of three or four feathers on the first digit of the wing on some birds."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62d41129-0e66-4dfe-8ae0-df6d4c18b75f",
                                                "sense_id": "bbc1b5b6-a3d5-3bd1-8e2d-c823498594ac",
                                                "text": "More recently, the upturned wing tips of jet aircraft mimic the \"fingers\" of birds' terminal primary feathers, and the slotted leading edges of aircraft wings are directly copied from the alula (\"thumb\" wings) in birds."
                                            },
                                            {
                                                "example_id": "43550394-f89c-453f-9bc7-54218287a913",
                                                "sense_id": "bbc1b5b6-a3d5-3bd1-8e2d-c823498594ac",
                                                "text": "On the wing, even the tiny “thumb feather” or alula can be seen."
                                            }
                                        ]
                                    }
                                ]
                            },
