                ],
                "senses": [
                    {
                        "sense_id": "60e55a9d-87fc-3c83-985c-0daf58f9ea20",
                        "entry_id": "311c52b6-f910-3b08-afef-d0a86888ac29",
                        "glosses": [
                            "Rückstände aus der Pferdehaltung, die in der Hauptsache aus den Exkrementen der Tiere bestehen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8fe174b-b06b-47c3-a256-56ce27ff0a9a",
                                "sense_id": "60e55a9d-87fc-3c83-985c-0daf58f9ea20",
                                "text": "„Eines Tages schickt die Prinzipalin sie mit einer Kehrschaufel und einem Eimer auf die Straße um Pferdemist.“"
                            },
                            {
                                "example_id": "31ae6ffc-792b-4266-af8c-5a4b019f4897",
                                "sense_id": "60e55a9d-87fc-3c83-985c-0daf58f9ea20",
                                "text": "„Vor hundertfünfzig Jahren war man sich in der Fachwelt einig, das größte Zukunftsproblem in Großstädten werde der Pferdemist sein.“"
                            },
                            {
                                "example_id": "55343f79-49e7-43ca-aa47-b5dfbb63f499",
                                "sense_id": "60e55a9d-87fc-3c83-985c-0daf58f9ea20",
                                "text": "„In den Wänden waren Einschusslöcher, und im Keller lag Pferdemist, alles musste neu gemacht werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
