                },
                {
                    "sense_id": "0cecdf90-d677-35be-bcf6-4c3da59d1209",
                    "sense_definition": "Happening at the most suitable or advantageous time to be helpful.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "opportune",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her <w>timely</w> advice helped me avoid making a terrible mistake.",
                            "target_lang_translations": {
                                "ru": "Её <w>своевременный</w> совет помог мне избежать ужасной ошибки.",
                                "de": "Ihr <w>rechtzeitiger</w> Rat half mir, einen schrecklichen Fehler zu vermeiden."
                            }
                        },
                        {
                            "text": "The rain was very <w>timely</w> for the farmers after such a long drought.",
                            "target_lang_translations": {
                                "ru": "Дождь был очень <w>своевременным</w> для фермеров после такой долгой засухи.",
                                "de": "Der Regen kam für die Landwirte nach einer so langen Dürre sehr <w>gelegen</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "opportune",
                        "well-timed",
                        "seasonable"
                    ],
                    "antonyms": [
                        "ill-timed",
                        "inopportune",
                        "untimely",
                        "unseasonable"
                    ],
                    "common_phrases": [
                        "timely reminder",
                        "timely intervention",
                        "timely advice",
                        "timely arrival"
                    ],
                    "target_lang_definitions": {
                        "ru": "Происходящий в наиболее подходящее или выгодное время.",
                        "de": "Geschieht zum günstigsten oder vorteilhaftesten Zeitpunkt, um hilfreich zu sein."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "своевременный",
                                "target_lang_sense_clarification": "удачный по времени"
                            },
                            {
                                "target_lang_word": "уместный",
                                "target_lang_sense_clarification": "подходящий к случаю"
                            }
