                "senses": [
                    {
                        "sense_id": "5977a3e6-72c4-3cc9-9210-44656dd3d92c",
                        "entry_id": "7bc93774-a7c6-320d-946a-9d6f7293a9dc",
                        "glosses": [
                            "по форме напоминающий комету, то же что кометовидный, кометоподобный"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a2d406a-a2f1-43dc-980c-45cc26fe6ccc",
                                "sense_id": "5977a3e6-72c4-3cc9-9210-44656dd3d92c",
                                "text": "Газовое облако имеет кометообразный хвост, простирающийся на 0.5 млн. световых лет."
                            },
                            {
                                "example_id": "4fbde801-7f69-4292-9677-aeaf47f39d6d",
                                "sense_id": "5977a3e6-72c4-3cc9-9210-44656dd3d92c",
                                "text": "Учёным удалось обнаружить неяркий кометообразный след в полярном сиянии планеты, обусловленный влиянием Европы."
                            }
                        ]
                    }
