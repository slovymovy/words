{
    "word_family": [
        "машинист",
        "машинистка",
        "машинный"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3bce7ffe-66b2-30c0-852c-eb634f5b8c64",
                    "sense_definition": "автомобиль, транспортное средство",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "transport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он купил новую <w>машину</w> в прошлом месяце.",
                            "target_lang_translations": {
                                "en": "He bought a new <w>car</w> last month."
                            }
                        },
                        {
                            "text": "На дороге стоит много <w>машин</w>.",
                            "target_lang_translations": {
                                "en": "There are many <w>cars</w> on the road."
                            }
                        }
                    ],
                    "synonyms": [
                        "автомоби́ль"
                    ],
                    "common_phrases": [
                        "водить машину",
                        "купить машину"
                    ],
                    "target_lang_definitions": {
                        "en": "A road vehicle, typically with four wheels, powered by an internal combustion engine or electric motor."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "car",
                                "target_lang_sense_clarification": "A standard personal motor vehicle."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a05bed8a-8aea-32eb-abda-8bb6517e6151",
                    "sense_definition": "компьютер или вычислительное устройство",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "technology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Эта <w>машина</w> работает очень быстро.",
                            "target_lang_translations": {
                                "en": "This <w>machine</w> works very fast."
                            }
                        },
                        {
                            "text": "Программист долго сидел за своей <w>машиной</w>.",
                            "target_lang_translations": {
                                "en": "The programmer sat at his <w>computer</w> for a long time."
                            }
                        }
                    ],
                    "synonyms": [
                        "компьютер",
                        "комп"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "часто используется в профессиональной среде"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A computer or electronic device used for processing data."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "computer",
                                "target_lang_sense_clarification": "A general-purpose electronic device."
                            },
                            {
                                "target_lang_word": "machine",
                                "target_lang_sense_clarification": "Used colloquially in technical contexts to refer to a computer."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bc8b9298-789c-3efb-87dd-9647e6ac3412",
                    "sense_definition": "техническое устройство для выполнения работы",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mechanism",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "На заводе установили новую <w>машину</w> для упаковки товаров.",
                            "target_lang_translations": {
                                "en": "A new <w>machine</w> for packaging goods was installed at the factory."
                            }
                        },
                        {
                            "text": "Сложная <w>машина</w> требует регулярного обслуживания.",
                            "target_lang_translations": {
                                "en": "A complex <w>machine</w> requires regular maintenance."
                            }
                        }
                    ],
                    "synonyms": [
                        "механи́зм"
                    ],
                    "target_lang_definitions": {
                        "en": "A mechanical or electrical device that performs a specific task or function."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "machine",
                                "target_lang_sense_clarification": "A device that uses energy to perform work."
                            },
                            {
                                "target_lang_word": "mechanism",
                                "target_lang_sense_clarification": "A system of parts working together in a machine."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "52f12ba9-ac33-3cfc-a01f-5cb1c5f3a577",
                    "sense_definition": "государственная или бюрократическая система",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "metaphor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Государственная <w>машина</w> работает медленно.",
                            "target_lang_translations": {
                                "en": "The government <w>machine</w> works slowly."
                            }
                        },
                        {
                            "text": "Он не хотел быть частью этой бюрократической <w>машины</w>.",
                            "target_lang_translations": {
                                "en": "He did not want to be part of this bureaucratic <w>machine</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A large, complex, and often impersonal organization or system, especially in government."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "machine",
                                "target_lang_sense_clarification": "Used metaphorically to describe a powerful, efficient, or rigid system."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "69f6ae07-3150-3b6b-932c-7bacbf72f47b",
                    "sense_definition": "ускоритель частиц",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "physics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Учёные проводят эксперименты на этой <w>машине</w>.",
                            "target_lang_translations": {
                                "en": "Scientists are conducting experiments on this <w>accelerator</w>."
                            }
                        },
                        {
                            "text": "Строительство новой <w>машины</w> заняло десять лет.",
                            "target_lang_translations": {
                                "en": "The construction of the new <w>accelerator</w> took ten years."
                            }
                        }
                    ],
                    "synonyms": [
                        "ускоритель"
                    ],
                    "target_lang_definitions": {
                        "en": "A large scientific apparatus used to accelerate subatomic particles to high speeds."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "accelerator",
                                "target_lang_sense_clarification": "A device for accelerating charged particles."
                            },
                            {
                                "target_lang_word": "particle accelerator",
                                "target_lang_sense_clarification": "The full technical term for a particle-smashing machine."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}