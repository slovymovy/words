                                        "sense_id": "6a5a0e32-bd1d-3854-8fc5-240073ddba72",
                                        "entry_id": "f148e024-fd5a-3e0f-add7-57f98145b691",
                                        "glosses": [
                                            "To exert oneself."
                                        ],
