                "senses": [
                    {
                        "sense_id": "51c96ab4-4a49-3180-82c8-b55eddfb5900",
                        "entry_id": "c29e3d3e-7fb5-3e98-a1b8-3b2a51706911",
                        "glosses": [
                            "Produkt, das für die Hygiene benutzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c867eb4e-2bcf-46fa-931e-da2ad12cffdd",
                                "sense_id": "51c96ab4-4a49-3180-82c8-b55eddfb5900",
                                "text": "„Arzneimittel waren bei 182 Personen die Ursache für eine Vergiftung, Pestizide schlugen mit 107 Fällen zu Buche. Kosmetika und Hygieneprodukte lösten in 72 Fällen gesundheitliche Schwierigkeiten aus, und in 49 Fällen erfolgten die negativen Reaktionen auf den Konsum von Speisen und Getränken.“"
                            },
                            {
                                "example_id": "d2ea3a1b-a4b8-4f3b-b5ec-b0b1cf2c12c1",
                                "sense_id": "51c96ab4-4a49-3180-82c8-b55eddfb5900",
                                "text": "„Shampoo, Spülung, Cremes und Lotions - Hamburger geben im bundesweiten Vergleich am meisten Geld für Körperpflege-, Kosmetik- und Hygieneprodukte aus.“"
                            },
                            {
                                "example_id": "bc0b1e9d-c956-4751-b07c-d9c7849d4587",
                                "sense_id": "51c96ab4-4a49-3180-82c8-b55eddfb5900",
                                "text": "„Impfstoffe und Hygieneprodukte werden zu Umsatzbringern – und die Aktienkurse der beteiligten Unternehmen steigen.“"
                            },
                            {
                                "example_id": "278564a1-5579-470a-b9d3-ad8b7a76f914",
                                "sense_id": "51c96ab4-4a49-3180-82c8-b55eddfb5900",
                                "text": "„Auch in die Rezeptur von Kosmetika und Hygieneprodukten gehört immer öfter Palmöl.“"
                            },
                            {
                                "example_id": "663ea9a9-db23-4dd4-8379-ed04469a05f1",
                                "sense_id": "51c96ab4-4a49-3180-82c8-b55eddfb5900",
                                "text": "„Im Lebensmittelhandel, den daher Gerber beschickte, fehlte zumeist das attraktive Produktumfeld, das mit Windeln, Kinderpflegemitteln, Hygieneprodukten, Kleinkindernährung, Tees und Hartwaren von der Flasche bis zum Beißring für hohe Kundenfrequenz sorgt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
