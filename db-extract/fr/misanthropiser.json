                "senses": [
                    {
                        "sense_id": "4d7996e2-e832-3697-a393-2a5481f6ad4e",
                        "entry_id": "e0e62b7a-ce81-3fd8-95c0-8cb0c5644efb",
                        "glosses": [
                            "Donner un caractère misanthrope à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf6b467e-2415-45d9-8820-84978916c80f",
                                "sense_id": "4d7996e2-e832-3697-a393-2a5481f6ad4e",
                                "text": "Le grand satirique, pour donner carrière à son talent et à son humeur, m’avait misanthropisé, et je vous dois être reconnaissant d’avoir protesté contre cette peinture inexacte de mon caractère."
                            },
                            {
                                "example_id": "9846e2f4-37a2-470c-88c5-968f7421ae6e",
                                "sense_id": "4d7996e2-e832-3697-a393-2a5481f6ad4e",
                                "text": "Déjà passablement aviné, je me dis qu'il est peut-être préférable de partir maintenant avec mon alcool ne termine de me misanthropiser."
                            },
                            {
                                "example_id": "c3c7fc5a-1a00-4844-a25b-5f89466cea01",
                                "sense_id": "4d7996e2-e832-3697-a393-2a5481f6ad4e",
                                "text": "Je refuse de plus en plus les soirées où je sais que les gens vont fumer dans un espace clos, je me misanthropise..."
                            }
                        ]
                    }
                ],
