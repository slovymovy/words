                "senses": [
                    {
                        "sense_id": "83c0932e-c17f-361c-9ec3-7e7bfcbeecf4",
                        "entry_id": "5d0b828a-eb77-3e10-8f67-128382f7bcec",
                        "glosses": [
                            "Gaumenzäpfchen"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "4c4b8de9-f935-4183-81aa-509a1a8c9bf0",
                                "sense_id": "83c0932e-c17f-361c-9ec3-7e7bfcbeecf4",
                                "text": "Dei Huk uptrecken. Wenn Einem das Zäpfchen angeschwollen ist, werden drei Haare aus der Mitte der Kopfplatte um die Hand gewunden und stark daran gezogen. Viel verbreitetes Mittel."
                            },
                            {
                                "example_id": "ae9dd81a-0c55-4c4f-b32f-3c48449d079a",
                                "sense_id": "83c0932e-c17f-361c-9ec3-7e7bfcbeecf4",
                                "text": "In dieser Zusammensetzung bedeutet Huk — das Zäpfchen am Gaumen; auch die ganze Halsdrüsengegend."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
