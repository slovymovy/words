                    },
                    {
                        "translation_id": "fd1a42be-2a18-4cb6-8339-5a8753ec0959",
                        "source_entry_id": "fe659032-f8f4-3e59-a874-fc07711ba8d5",
                        "source_sense_description": "превысить",
                        "target_lang_word": "excéder",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
