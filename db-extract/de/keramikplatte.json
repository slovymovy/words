                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07d2cd87-0ce4-4662-9ddc-53662e439b5b",
                                "sense_id": "96f2190a-d36f-39fa-a657-26a0568c9ac9",
                                "text": "„In Hallstatt entsteht derzeit ein Archiv unserer Kultur - mit ungewöhnlichen Datenträgern: Die Dokumente werden auf Keramikplatten gespeichert.“"
                            },
                            {
                                "example_id": "837f4a94-07c4-47fc-8ce1-faaac6df8962",
                                "sense_id": "96f2190a-d36f-39fa-a657-26a0568c9ac9",
                                "text": "„Die Soldaten tragen Helme aus Kevlar und Splitterschutzwesten mit Keramikplatten, dazu Kampfanzüge in \"Wüstentarn\", den bleichen Farben des Weltkrisenherdes Mittlerer Osten.“"
                            },
                            {
                                "example_id": "1972f261-0358-4eb0-9605-0cf4dd112582",
                                "sense_id": "96f2190a-d36f-39fa-a657-26a0568c9ac9",
                                "text": "„Die nur 3 mm dicken Keramikplatten können auf unterschiedlichste Trägermaterialien verklebt und zudem exakt geschnitten, gebohrt und weiter verarbeitet werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
