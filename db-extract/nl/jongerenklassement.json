                        "glosses": [
                            "ranglijst van jonge sporters die meedoen aan een klassementswedstrijd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c677120-2ab8-4a65-9022-cec8474254ee",
                                "sense_id": "d371164b-b73b-3d2b-bb66-ba0476d09d88",
                                "text": "Er werd toch vooral over Frank van den Broek gesproken, die ijzersterke debutant die zijn kopman eerst naar de kopgroep en vervolgens naar de dagwinst loodste. Zelf staat hij aan de leiding van het puntenklassement en jongerenklassement en werd hij uitgeroepen tot de meest strijdlustige renner."
                            },
                            {
                                "example_id": "05b3eceb-3803-4f8d-94b8-0f759026316c",
                                "sense_id": "d371164b-b73b-3d2b-bb66-ba0476d09d88",
                                "text": "Dat was wel even wat anders dan zaterdag, toen de jonge Van den Broek de sterkste renner in koers bleek en zijn kopman Romain Bardet aan de etappezege en de gele trui hielp. Zelf pakte hij het groen en wit, de truien van het punten- en jongerenklassement."
                            }
                        ]
                    }
