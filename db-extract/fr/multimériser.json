                        "glosses": [
                            "Provoquer la transformation de monomères en polymères."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee508e5f-df29-4057-bd9e-868ff9d57262",
                                "sense_id": "9362151b-040a-3458-a4fa-839b7b797859",
                                "text": "Une propriété commune des ligands capables de stimuler des cellules est celle d'oligomériser, au minimum de dimériser, souvent de multimériser, d'une façon générale d'agréger les récepteurs à la surface des cellules [1, 2]."
                            },
                            {
                                "example_id": "0fea6b5f-5c11-461d-aac4-f6ec21b77afe",
                                "sense_id": "9362151b-040a-3458-a4fa-839b7b797859",
                                "text": "Le signal incomplet ou négatif fourni par les petits Ags serait dû à leur incapacité à multimériser le BCR."
                            }
                        ]
                    }
