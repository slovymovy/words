                "senses": [
                    {
                        "sense_id": "fc5442b9-e785-3a64-add1-30911bd6b2ff",
                        "entry_id": "35991c01-394d-3508-bb2a-2f0deec12ece",
                        "glosses": [
                            "weibliche Person, die eine Fälschung herstellt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0bfd2ba6-c6a1-4bf7-af58-0d84da279a40",
                                "sense_id": "fc5442b9-e785-3a64-add1-30911bd6b2ff",
                                "text": "Die Fälscherin konnte von der Polizei ausfindig gemacht und verhaftet werden."
                            },
                            {
                                "example_id": "74fc1acc-931b-4271-94df-45bc1e73e94c",
                                "sense_id": "fc5442b9-e785-3a64-add1-30911bd6b2ff",
                                "text": "„Die schlaueste unter den Insassinnen der gehobenen Abteilung war eine Fälscherin und Geschäftsfrau namens Nelly Kerwin.“"
                            },
                            {
                                "example_id": "29b5ec76-3f30-4a74-b175-1de579917753",
                                "sense_id": "fc5442b9-e785-3a64-add1-30911bd6b2ff",
                                "text": "„Gabriele Sauler wollte berühmte Vorbilder abmalen, Klimts, Schieles, Gauguins, und sie wollte seriös dabei bleiben, jedes Bild mit ihrem Namen zeichnen. Eine ehrliche Fälscherin, das war die Idee.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "985d2e23-4e17-42ee-9569-5392164b7f37",
                        "source_entry_id": "35991c01-394d-3508-bb2a-2f0deec12ece",
                        "source_sense_id": "fc5442b9-e785-3a64-add1-30911bd6b2ff",
                        "source_sense_description": "weibliche Person, die eine Fälschung herstellt",
                        "target_lang_word": "faker",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "faker",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "350d44da-99df-38d7-8e68-555bfb962fb4",
                                        "entry_id": "3d35cfd7-fab2-39cd-8ba7-5383b27ea3e5",
                                        "glosses": [
                                            "One who fakes something."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a22eb59b-ddd1-323a-84fc-7c8886046141",
                                        "entry_id": "3d35cfd7-fab2-39cd-8ba7-5383b27ea3e5",
                                        "glosses": [
                                            "An impostor or impersonator."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2d4268b-d96f-4093-bab8-e6b7dfb3ec9f",
                                                "sense_id": "a22eb59b-ddd1-323a-84fc-7c8886046141",
                                                "text": "The ordinary Christian will read the claims of the New Thought fakers with contempt; but have I not shown the Catholic Church publishing long lists of money-miracles?"
                                            },
                                            {
                                                "example_id": "ccc5e66f-aa62-41d5-bf0d-8daede601b1a",
                                                "sense_id": "a22eb59b-ddd1-323a-84fc-7c8886046141",
                                                "text": "Sonic: I found you, faker!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e22daaa-9e0a-36d7-b8bc-a083b7655247",
                                        "entry_id": "3d35cfd7-fab2-39cd-8ba7-5383b27ea3e5",
                                        "glosses": [
                                            "A friendly unit (usually aircraft) that acts as a hostile unit in a military exercise."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "61edd0b9-6b8b-4ebd-9180-4d307a93b551",
                                                "sense_id": "8e22daaa-9e0a-36d7-b8bc-a083b7655247",
                                                "text": "faker: A friendly track acting as a hostile for exercise purposes. (STANAG 1241)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "80c318f4-9a8a-34f8-aa0c-c5a0bf940db5",
                                        "entry_id": "3d35cfd7-fab2-39cd-8ba7-5383b27ea3e5",
                                        "glosses": [
                                            "A thief."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "08c3e5e7-f45c-3b18-b338-e0f288554872",
                                        "entry_id": "3d35cfd7-fab2-39cd-8ba7-5383b27ea3e5",
                                        "glosses": [
                                            "A peddler of petty things."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b555278-c7f3-4788-b753-813a5082d8db",
                                                "sense_id": "08c3e5e7-f45c-3b18-b338-e0f288554872",
                                                "text": "He has been lagged for beaker hunting, was a mushroom faker [umbrella seller], has been on the steel for snamming a wedge sneezer; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ccc4ad6-1924-34f9-a263-9bc137830f71",
                                        "entry_id": "3d35cfd7-fab2-39cd-8ba7-5383b27ea3e5",
                                        "glosses": [
                                            "A snake oil salesman; one who makes exaggerated claims about a product he sells."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0d4b48a-8c1a-4461-8356-5a0e6d25eca3",
                                                "sense_id": "7ccc4ad6-1924-34f9-a263-9bc137830f71",
                                                "text": "Yet the faker is not an unpopular visitor to the country fair. On the contrary, a country fair at which was not heard the stentorian shouts of the faker to \"come on, boys; here's the chance to make your fortune,\" would be considered a dismal failure."
                                            },
                                            {
                                                "example_id": "d682d2fd-a53b-4165-b563-e58ad2a686bb",
                                                "sense_id": "7ccc4ad6-1924-34f9-a263-9bc137830f71",
                                                "text": "All the doctor has to do nowadays is to read the labels on the bottles and boxes of samples the faker brings him."
                                            },
                                            {
                                                "example_id": "697837e2-d472-4100-b6a8-904a25b4ef29",
                                                "sense_id": "7ccc4ad6-1924-34f9-a263-9bc137830f71",
                                                "text": "Business interests citizens against the food adulterator are severely hampered and injured and the \"patent-medicine” faker."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "faker",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f3c4a971-57e5-3b38-aa1b-b022ac56db81",
                                        "entry_id": "2e990319-2912-3769-bccb-f235e18fc961",
                                        "glosses": [
                                            "comparative form of fake: more fake."
                                        ],
                                        "tags": [
                                            "comparative",
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "793ac336-525e-473a-b47f-b6296ac30e56",
                                                "sense_id": "f3c4a971-57e5-3b38-aa1b-b022ac56db81",
                                                "text": "She's faker than the plastic food in the pictures on the McDonald's menu."
                                            },
                                            {
                                                "example_id": "10c5f1f0-de3d-41b2-842e-dd5ec2c40c8f",
                                                "sense_id": "f3c4a971-57e5-3b38-aa1b-b022ac56db81",
                                                "text": "He returns my smile, although his is probably faker than mine."
                                            },
                                            {
                                                "example_id": "373d88e9-2d5a-4819-9ccf-9094c83b0afe",
                                                "sense_id": "f3c4a971-57e5-3b38-aa1b-b022ac56db81",
                                                "text": "The name sounds faker than fake."
                                            }
