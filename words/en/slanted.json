{
    "word_family": [
        "slant",
        "slanting",
        "slantwise"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d67f4ac5-78b1-342e-a357-8e3005e4dfc6",
                    "sense_definition": "Placed at an angle or on a slope.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "angle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>slanted</w> roof helped the snow slide off easily during the winter.",
                            "target_lang_translations": {
                                "ru": "<w>Наклонная</w> крыша помогала снегу легко соскальзывать зимой."
                            }
                        },
                        {
                            "text": "She wrote her name in <w>slanted</w> letters across the top of the page.",
                            "target_lang_translations": {
                                "ru": "Она написала своё имя <w>косыми</w> буквами в верхней части страницы."
                            }
                        }
                    ],
                    "synonyms": [
                        "tilted",
                        "sloping",
                        "inclined"
                    ],
                    "antonyms": [
                        "level",
                        "straight"
                    ],
                    "common_phrases": [
                        "slanted roof",
                        "slanted writing"
                    ],
                    "target_lang_definitions": {
                        "ru": "Расположенный под углом или на склоне."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наклонный",
                                "target_lang_sense_clarification": "расположенный под углом к горизонтали"
                            },
                            {
                                "target_lang_word": "косой",
                                "target_lang_sense_clarification": "имеющий наклон, не прямой"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d779ff1e-0423-33eb-bc26-f95d6bf90522",
                    "sense_definition": "Showing a preference for one side or opinion; biased.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "bias",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The newspaper article provided a <w>slanted</w> view of the political situation.",
                            "target_lang_translations": {
                                "ru": "Газетная статья представила <w>предвзятый</w> взгляд на политическую ситуацию."
                            }
                        },
                        {
                            "text": "Critics argued that the documentary was <w>slanted</w> against the company.",
                            "target_lang_translations": {
                                "ru": "Критики утверждали, что документальный фильм был <w>настроен предвзято</w> против компании."
                            }
                        }
                    ],
                    "synonyms": [
                        "biased",
                        "prejudiced",
                        "one-sided"
                    ],
                    "antonyms": [
                        "impartial",
                        "objective",
                        "neutral"
                    ],
                    "target_lang_definitions": {
                        "ru": "Демонстрирующий предпочтение одной стороне или мнению; предвзятый."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предвзятый",
                                "target_lang_sense_clarification": "необъективный, основанный на предубеждении"
                            },
                            {
                                "target_lang_word": "однобокий",
                                "target_lang_sense_clarification": "рассматривающий ситуацию только с одной стороны"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f704e0b6-f3ca-3c4f-b826-fe902e708e5e",
                    "sense_definition": "Simple past and past participle of <w>slant</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "angle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sunlight <w>slanted</w> through the window and lit up the dusty floor.",
                            "target_lang_translations": {
                                "ru": "Солнечный свет <w>падал под углом</w> через окно и освещал пыльный пол."
                            }
                        },
                        {
                            "text": "He <w>slanted</w> the board to make it easier for the ball to roll down.",
                            "target_lang_translations": {
                                "ru": "Он <w>наклонил</w> доску, чтобы мячу было легче скатываться вниз."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and past participle of slant"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие от глагола «наклонять» или «падать под углом»."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наклонил",
                                "target_lang_sense_clarification": "изменил положение предмета под углом"
                            },
                            {
                                "target_lang_word": "падал под углом",
                                "target_lang_sense_clarification": "о свете или лучах, проникающих через отверстие"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}