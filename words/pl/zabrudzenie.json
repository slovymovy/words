                {
                    "sense_id": "0179aec6-86b9-3161-ace7-d5a7373abbbd",
                    "sense_definition": "brudny ślad, plama lub nagromadzony brud na jakiejś powierzchni",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "brud",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Trudno było usunąć to tłuste <w>zabrudzenie</w> z jasnego dywanu.",
                            "target_lang_translations": {
                                "ru": "Было трудно удалить это жирное <w>пятно</w> со светлого ковра."
                            }
                        },
                        {
                            "text": "Specjalny płyn szybko zmywa wszelkie <w>zabrudzenia</w> ze szklanych powierzchni.",
                            "target_lang_translations": {
                                "ru": "Специальная жидкость быстро смывает любые <w>загрязнения</w> со стеклянных поверхностей."
                            }
                        }
                    ],
                    "synonyms": [
                        "plama",
                        "zanieczyszczenie",
                        "brud"
                    ],
                    "common_phrases": [
                        "trudne zabrudzenie",
                        "usuwanie zabrudzeń"
                    ],
                    "target_lang_definitions": {
