                "senses": [
                    {
                        "sense_id": "60a8d783-262a-3438-b3ae-2ee9c0f4dcce",
                        "entry_id": "9da01c34-3464-3668-8f70-74cd29bca2e4",
                        "glosses": [
                            "Relatif aux satyres."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "f8257c39-abf5-4250-8bff-b1190fccb09d",
                                "sense_id": "60a8d783-262a-3438-b3ae-2ee9c0f4dcce",
                                "text": "Danse satyrique, danse qui consistait en postures indécentes et lubriques."
                            },
                            {
                                "example_id": "227239ea-ebd8-433c-aca9-e999d9c9dda6",
                                "sense_id": "60a8d783-262a-3438-b3ae-2ee9c0f4dcce",
                                "text": "Drame satyrique, pièce bouffonne qui était jouée chez les Grecs après les trois tragédies formant trilogie et qui complétait la tétralogie."
                            },
                            {
                                "example_id": "5f88ac69-057c-4908-9d7c-b0c10bb9b7b6",
                                "sense_id": "60a8d783-262a-3438-b3ae-2ee9c0f4dcce",
                                "text": "Le Cyclope d’Euripide est un drame satyrique."
                            }
                        ]
                    },
                    {
                        "sense_id": "20703762-e6d8-37c8-b001-921ff6655273",
                        "entry_id": "9da01c34-3464-3668-8f70-74cd29bca2e4",
                        "glosses": [
                            "Définition manquante ou à compléter. (Ajouter)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c791477c-3117-4bf9-8e2d-741d5871b99e",
                                "sense_id": "20703762-e6d8-37c8-b001-921ff6655273",
                                "text": "Les jeux satyriques étaient des farces qu’on jouait à Rome avant les grandes pièces."
                            }
                        ]
                    }
