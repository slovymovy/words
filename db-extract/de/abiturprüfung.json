                ],
                "senses": [
                    {
                        "sense_id": "4f3651fc-85dd-3011-b71b-f4a1ce0f9005",
                        "entry_id": "7070be20-35c8-35b2-9831-c30e42dab68a",
                        "glosses": [
                            "Abschlussprüfung zur Erlangung des Abiturs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "309ab0e0-6287-4c4c-8e52-be5d793c217e",
                                "sense_id": "4f3651fc-85dd-3011-b71b-f4a1ce0f9005",
                                "text": "„Nach seiner Meldung als Freiwilliger, der vorgezogenen Abiturprüfung und der Immatrikulation an der Heidelberger Universität im Fach Zoologie beginnt Anfang Oktober die kurze Grundausbildung in Hannover.“"
                            },
                            {
                                "example_id": "4693fd86-af0d-4540-8bc9-022abe1db3fa",
                                "sense_id": "4f3651fc-85dd-3011-b71b-f4a1ce0f9005",
                                "text": "„Nach dem Sturz der irakischen Diktatur erzählte mir mein Bruder am Telefon, es gebe in Bagdad nun die Möglichkeit, die Abiturprüfung mit Richtung Geisteswissenschaft zu absolvieren, wenn man bereits ein anderes Abitur habe.“"
                            },
                            {
                                "example_id": "15608c20-ee04-4da5-83fd-1d68ee42e1e6",
                                "sense_id": "4f3651fc-85dd-3011-b71b-f4a1ce0f9005",
                                "text": "„An dem Tag, an dem Rotermund von seiner letzten Abiturprüfung nach Hause zurückgekehrt war, begann er mit der dreitägigen Ausmistung seines Zimmers.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
