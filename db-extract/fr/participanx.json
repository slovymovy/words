                        "sense_id": "6315b084-6c43-33eb-954f-5320f1f25b04",
                        "entry_id": "0776cfb5-6dff-302b-ac12-f6a8d0c6bbe3",
                        "glosses": [
                            "Personne non-binaire ou sans détermination de son genre qui participe à quelque chose."
                        ],
                        "tags": [
                            "neologism"
                        ],
                        "examples": [
                            {
                                "example_id": "a80bb85d-5478-4dca-8235-e6687522fa4a",
                                "sense_id": "6315b084-6c43-33eb-954f-5320f1f25b04",
                                "text": "Les ateliers sont l’élément clef du festival, nous pensons que l’expérimentation dans les corps peut rendre les participanx actrix de leurs propres sexualités."
                            },
                            {
                                "example_id": "12899592-18e6-48fb-b507-1385330b9b51",
                                "sense_id": "6315b084-6c43-33eb-954f-5320f1f25b04",
                                "text": "Chaque participanx a décelé au moins une situation d’oppression dans son existence – ce qui est très fréquent."
                            },
                            {
                                "example_id": "f5ac5bbe-c37a-45c2-b595-27c8062c894e",
                                "sense_id": "6315b084-6c43-33eb-954f-5320f1f25b04",
                                "text": "Inscriptions participanx jusqu’à Dimanche 4 Octobre, 10H."
                            },
                            {
                                "example_id": "40e7d639-aeba-445d-9345-78ad01c1f8b9",
                                "sense_id": "6315b084-6c43-33eb-954f-5320f1f25b04",
                                "text": "Dans ce milieu un peu déconstruit, il n’est pas rare que les participanx soient dans des dynamiques non exclusives."
                            }
                        ]
                    }
