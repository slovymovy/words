                    {
                        "translation_id": "a17bd009-e970-4b3e-ba7e-9267b7f00e79",
                        "source_entry_id": "4b21c0a6-1ef1-32ac-89a3-f98019940c32",
                        "source_sense_id": "ae01beff-e259-30b3-8d16-5d94c3f9578f",
                        "source_sense_description": "Radweg, Fahrradweg",
                        "target_lang_word": "Radweg",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Radweg",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9b7c0877-83d0-34ff-8dc3-8763dd03a1ce",
                                        "entry_id": "27d8a096-292c-3fcb-a2d1-50dbe01c2489",
                                        "glosses": [
                                            "der gekennzeichnete Abschnitt auf oder neben einer Straße, auf dem Radfahrer fahren können"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b737d01-9fe8-4005-ab51-42dcc1fa77e9",
                                                "sense_id": "9b7c0877-83d0-34ff-8dc3-8763dd03a1ce",
                                                "text": "Auf dem Radweg fühle ich mich sicher."
                                            },
                                            {
                                                "example_id": "09210b5f-4d2d-4eed-afc9-3673d16fd074",
                                                "sense_id": "9b7c0877-83d0-34ff-8dc3-8763dd03a1ce",
                                                "text": "„Auf Geh- und Radwegen haben sich Radfahrer so zu verhalten, dass Fußgänger nicht gefährdet werden.“"
                                            },
                                            {
                                                "example_id": "0aa29ea0-3362-40e6-ae75-8673b91df965",
                                                "sense_id": "9b7c0877-83d0-34ff-8dc3-8763dd03a1ce",
                                                "text": "„Ein breiter, gut geteerter Radweg führte mich am kurvigen Verlauf des Wassers entlang, tiefer in Richtung Osten.“"
                                            },
                                            {
                                                "example_id": "e79f0656-7753-4970-b6a6-a1d70599f51d",
                                                "sense_id": "9b7c0877-83d0-34ff-8dc3-8763dd03a1ce",
                                                "text": "Im Gegensatz zu Radwegen sind Radfahrstreifen und Schutzstreifen reine Markierungslösungen auf einer baulichen Fahrbahn."
                                            },
                                            {
                                                "example_id": "a7c763e1-3315-4155-b56f-006ee216db0e",
                                                "sense_id": "9b7c0877-83d0-34ff-8dc3-8763dd03a1ce",
                                                "text": "„Eine Pflicht, Radwege in der jeweiligen Fahrtrichtung zu benutzen, besteht nur, wenn dies durch Zeichen 237, 240 oder 241 angeordnet ist. Rechte Radwege ohne die Zeichen 237, 240 oder 241 dürfen benutzt werden. “"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0c4257ed-ab90-482f-8ca3-2bef5fdd378f",
                        "source_entry_id": "4b21c0a6-1ef1-32ac-89a3-f98019940c32",
                        "source_sense_id": "ae01beff-e259-30b3-8d16-5d94c3f9578f",
                        "source_sense_description": "Radweg, Fahrradweg",
                        "target_lang_word": "Fahrradweg",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fahrradweg",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "248ffe58-0dbc-3f76-ae30-f68620aaae4d",
                                        "entry_id": "1c79c888-ce35-31ef-98c0-f8fb52f46b9b",
                                        "glosses": [
                                            "ein speziell für Fahrradfahrer ausgebauter und reservierter Weg"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ea5a9b0-709c-4430-bd4e-3ad607dbfe37",
                                                "sense_id": "248ffe58-0dbc-3f76-ae30-f68620aaae4d",
                                                "text": "Jeder Fahrradfahrer und jede Fahrradfahrerin muss den Fahrradweg benutzen, wenn dieser auf der Fahrbahn extra eingezeichnet ist."
                                            },
                                            {
                                                "example_id": "331a15bd-4b32-45ba-a6b0-7efb6de480d4",
                                                "sense_id": "248ffe58-0dbc-3f76-ae30-f68620aaae4d",
                                                "text": "„Berlin, Berlin – auf dem Fahrradweg nach Hause sprach sie sich dieses Wort an jeder Kreuzung vor und begann sich unbändig zu freuen, wie immer, wenn ein schneller Aufbruch bevorstand.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
