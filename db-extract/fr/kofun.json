                    {
                        "sense_id": "f532a911-56a7-3602-8ab2-3f981a89523c",
                        "entry_id": "40e2ea6d-acd7-3c54-a0bd-2eff3f86aa1e",
                        "glosses": [
                            "Tertre funéraire édifié entre le IIIᵉ et le VIIᵉ siècle au Japon."
                        ],
                        "tags": [
                            "Funéraire"
                        ],
                        "examples": [
                            {
                                "example_id": "5012ba5c-069f-455c-8753-31c31ef9ae06",
                                "sense_id": "f532a911-56a7-3602-8ab2-3f981a89523c",
                                "text": "Un tumulus funéraire est appelé en japonais kofun. Le plus immense du Japon est situé dans la préfecture d’Osaka et se nomme le kofun « Daisenryô »."
                            },
                            {
                                "example_id": "95724276-e31e-4556-b775-304e8fcd4919",
                                "sense_id": "f532a911-56a7-3602-8ab2-3f981a89523c",
                                "text": "C’est que, jusqu’à ce jour, les kofun conservent une grande part de leur mystère. Aucun écrit ne conte leur réalisation."
                            },
                            {
                                "example_id": "3c60c8d3-d853-4793-8881-e1fcd9477504",
                                "sense_id": "f532a911-56a7-3602-8ab2-3f981a89523c",
                                "text": "Le diamètre important du kofun Tomio Maruyama où a été mise au jour l’épée laisse penser que la personne enterrée s’inscrivait dans un rang important de la société."
                            }
                        ]
                    }
