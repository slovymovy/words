        "fr-extract.jsonl": [
            {
                "entry_id": "9fb9e9fd-c70b-381e-9b93-51e86d6af9b9",
                "word": "lesbophobie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "63526b56-e7be-43d6-9541-de9dc87ac444",
                        "entry_id": "9fb9e9fd-c70b-381e-9b93-51e86d6af9b9",
                        "tags": [
                            "plural"
                        ],
                        "form": "lesbophobies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ccf61ff8-a1d0-3308-a4a2-a1fbf7b6b006",
                        "entry_id": "9fb9e9fd-c70b-381e-9b93-51e86d6af9b9",
                        "glosses": [
                            "Discrimination, haine ou hostilité envers les lesbiennes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a89c72b-ba69-4a7f-b827-769f9999bc92",
                                "sense_id": "ccf61ff8-a1d0-3308-a4a2-a1fbf7b6b006",
                                "text": "« La lesbophobie a ceci de particulier qu’elle conjugue sexisme et homophobie », pointe Jocelyne Fildard, co-présidente de la Coordination lesbienne en France."
                            },
                            {
                                "example_id": "6b2fd58a-b5a6-47d4-b519-ed8df44298c4",
                                "sense_id": "ccf61ff8-a1d0-3308-a4a2-a1fbf7b6b006",
                                "text": "Le regard situé des lesbiennes permet de penser l’imbrication des oppressions dans une démarche intersectionnelle : la lesbophobie est ainsi une discrimination dans laquelle sexisme et homophobie se cumulent et se renforcent."
                            },
                            {
                                "example_id": "5c411b67-b370-4ea8-b18f-68b24c6f29b8",
                                "sense_id": "ccf61ff8-a1d0-3308-a4a2-a1fbf7b6b006",
                                "text": "Un triste et malheureux constat pour l’association, qui souligne par exemple que la fin des débats sur le mariage pour tous n’a pas endigué la lesbophobie et que les attaques gayphobes ont significativement augmenté."
                            }
                        ]
                    }
                ],
