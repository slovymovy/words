                                                "example_id": "123522c9-e61b-41ac-b5e5-84ded88382eb",
                                                "sense_id": "fc05e4e3-98d5-3f94-946a-8383f7593efa",
                                                "text": "Manche Menschen wünschen eine Korrektur ihrer faltigen Haut durch den Schönheitschirurgen."
                                            }
