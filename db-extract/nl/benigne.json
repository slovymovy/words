                                            {
                                                "example_id": "c562445d-a020-451a-8477-ea20a13c28f8",
                                                "sense_id": "e10c2ff1-b51e-3af6-8a40-04b7e15943f4",
                                                "text": "But though we both entertained these ideas, we differed in their application. Resentment added also a sting to my censure; and I reprobated Raymond's conduct in severe terms. Adrian was more benign, more considerate."
                                            },
                                            {
                                                "example_id": "48796960-a921-495c-af9a-c250dd158050",
                                                "sense_id": "e10c2ff1-b51e-3af6-8a40-04b7e15943f4",
                                                "text": "I people my world with benign spirits. Everything talks to me and I respond to it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43208439-2da0-39a7-8cc6-dd9d263bc182",
                                        "entry_id": "60d9ef2b-4564-3b47-b603-cfd30e0df496",
                                        "glosses": [
