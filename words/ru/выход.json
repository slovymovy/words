{
    "word_family": [
        "выходить",
        "выходной",
        "выходка"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6dbcea18-f2fa-3473-b35e-dc63108ecad1",
                    "sense_definition": "место, через которое можно выйти из помещения или территории",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "location",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Где находится <w>выход</w> из этого здания?",
                            "target_lang_translations": {
                                "en": "Where is the <w>exit</w> from this building?"
                            }
                        },
                        {
                            "text": "Пожарный <w>выход</w> всегда должен быть свободен.",
                            "target_lang_translations": {
                                "en": "The fire <w>exit</w> must always be kept clear."
                            }
                        }
                    ],
                    "antonyms": [
                        "вход"
                    ],
                    "common_phrases": [
                        "запасной выход",
                        "пожарный выход"
                    ],
                    "target_lang_definitions": {
                        "en": "A place or opening through which one can go from inside a building or area to the outside."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "exit",
                                "target_lang_sense_clarification": "A way out of a building or area."
                            },
                            {
                                "target_lang_word": "way out",
                                "target_lang_sense_clarification": "A means of exit."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3825e7df-54b5-31d2-8cdc-39ddc28104d5",
                    "sense_definition": "процесс перемещения наружу или за пределы чего-либо",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Наш <w>выход</w> на берег реки был запланирован на утро.",
                            "target_lang_translations": {
                                "en": "Our <w>departure</w> to the riverbank was planned for the morning."
                            }
                        },
                        {
                            "text": "После долгого совещания состоялся <w>выход</w> сотрудников из офиса.",
                            "target_lang_translations": {
                                "en": "After a long meeting, the <w>exit</w> of employees from the office took place."
                            }
                        }
                    ],
                    "synonyms": [
                        "уход"
                    ],
                    "antonyms": [
                        "вход"
                    ],
                    "common_phrases": [
                        "быстрый выход"
                    ],
                    "target_lang_definitions": {
                        "en": "The act or process of moving outwards or leaving a place."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "departure",
                                "target_lang_sense_clarification": "The act of leaving."
                            },
                            {
                                "target_lang_word": "exit",
                                "target_lang_sense_clarification": "The act of going out or leaving."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9697b3df-c852-36d6-86aa-10113ae2d64f",
                    "sense_definition": "способ разрешения сложной ситуации или проблемы",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "solution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы обязательно найдём <w>выход</w> из этой трудной ситуации.",
                            "target_lang_translations": {
                                "en": "We will definitely find a <w>solution</w> to this difficult situation."
                            }
                        },
                        {
                            "text": "Это единственный <w>выход</w> для нашей компании сейчас.",
                            "target_lang_translations": {
                                "en": "This is the only <w>way out</w> for our company right now."
                            }
                        }
                    ],
                    "synonyms": [
                        "решение"
                    ],
                    "common_phrases": [
                        "найти выход"
                    ],
                    "target_lang_definitions": {
                        "en": "A method or means of resolving a difficult situation or problem."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "solution",
                                "target_lang_sense_clarification": "A means of solving a problem."
                            },
                            {
                                "target_lang_word": "way out",
                                "target_lang_sense_clarification": "A figurative escape or resolution to a problem."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "af8d9204-e5b4-3541-b3b8-5ed2a370e10c",
                    "sense_definition": "момент появления чего-либо нового, например книги, фильма или артиста",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Все ждали <w>выход</w> нового фильма известного режиссёра.",
                            "target_lang_translations": {
                                "en": "Everyone was waiting for the <w>release</w> of the famous director's new film."
                            }
                        },
                        {
                            "text": "Артист готовился к своему <w>выход</w> на сцену.",
                            "target_lang_translations": {
                                "en": "The artist was preparing for his <w>appearance</w> on stage."
                            }
                        }
                    ],
                    "synonyms": [
                        "появление"
                    ],
                    "common_phrases": [
                        "выход фильма",
                        "выход книги"
                    ],
                    "target_lang_definitions": {
                        "en": "The moment when something new, such as a film, book, or performer, is presented to the public."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "release",
                                "target_lang_sense_clarification": "The act of making a product available to the public."
                            },
                            {
                                "target_lang_word": "appearance",
                                "target_lang_sense_clarification": "The act of coming before the public."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "af0a6faf-1b8f-397d-bb2e-084a4143f3f0",
                    "sense_definition": "достижение определённого этапа в соревновании или конкурсе",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "competition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Команда праздновала <w>выход</w> в финал чемпионата мира.",
                            "target_lang_translations": {
                                "en": "The team celebrated their <w>advancement</w> to the World Cup final."
                            }
                        },
                        {
                            "text": "Этот матч решил <w>выход</w> сборной в следующий этап.",
                            "target_lang_translations": {
                                "en": "This match decided the national team's <w>advancement</w> to the next stage."
                            }
                        }
                    ],
                    "common_phrases": [
                        "выход в финал"
                    ],
                    "target_lang_definitions": {
                        "en": "Reaching a specific stage or level in a competition or tournament."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "advancement",
                                "target_lang_sense_clarification": "Moving forward to a higher stage in a competition."
                            },
                            {
                                "target_lang_word": "qualification",
                                "target_lang_sense_clarification": "The act of qualifying for a later stage."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d073e554-06c4-3d34-b387-84072fb3a683",
                    "sense_definition": "количество готовой продукции, полученной в результате процесса",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "production",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Общий <w>выход</w> продукции на заводе значительно увеличился.",
                            "target_lang_translations": {
                                "en": "The total <w>output</w> of products at the factory has increased significantly."
                            }
                        },
                        {
                            "text": "Химическая реакция дала высокий <w>выход</w> чистого вещества.",
                            "target_lang_translations": {
                                "en": "The chemical reaction gave a high <w>yield</w> of the pure substance."
                            }
                        }
                    ],
                    "synonyms": [
                        "производство"
                    ],
                    "antonyms": [
                        "затраты"
                    ],
                    "common_phrases": [
                        "выход продукции"
                    ],
                    "target_lang_definitions": {
                        "en": "The quantity of finished goods produced by a process."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "output",
                                "target_lang_sense_clarification": "The amount of something produced."
                            },
                            {
                                "target_lang_word": "yield",
                                "target_lang_sense_clarification": "The quantity of a product obtained from a process."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d83c055f-3ee7-3326-a6c9-69f11ebb016a",
                    "sense_definition": "гимнастическое упражнение на турнике для перехода в упор",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Спортсмен легко сделал <w>выход</w> силой на перекладине.",
                            "target_lang_translations": {
                                "en": "The athlete easily performed a <w>muscle-up</w> on the horizontal bar."
                            }
                        },
                        {
                            "text": "Для выполнения этого элемента нужен качественный <w>выход</w> на две руки.",
                            "target_lang_translations": {
                                "en": "To perform this element, a high-quality <w>muscle-up</w> is required."
                            }
                        }
                    ],
                    "common_phrases": [
                        "выход силой"
                    ],
                    "target_lang_definitions": {
                        "en": "A gymnastic exercise on a horizontal bar to transition into a support position."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "muscle-up",
                                "target_lang_sense_clarification": "A specific gymnastic move on a bar."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}