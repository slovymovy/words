                    },
                    {
                        "translation_id": "751f115a-d62c-4d5f-8e33-e71dc342d3d5",
                        "source_entry_id": "7cbdf1a6-a832-385a-813b-b26fc763ee38",
                        "source_sense_id": "6d518047-2cf8-3162-97a5-1b2e542b16e5",
                        "target_lang_word": "poderosamente",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "19728bff-1a81-4fa5-9b43-fa6201d62a80",
                        "source_entry_id": "7cbdf1a6-a832-385a-813b-b26fc763ee38",
                        "source_sense_id": "6d518047-2cf8-3162-97a5-1b2e542b16e5",
                        "target_lang_word": "puissamment",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "puissamment",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "578cd8c7-93e9-3f0f-b0fe-720ee79b5b1a",
                                        "entry_id": "ce7bdb40-73c1-3265-a92a-ef9e31ab8252",
                                        "glosses": [
                                            "Avec puissance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e39393a-30e8-46f2-ab8d-2970bdcad789",
                                                "sense_id": "578cd8c7-93e9-3f0f-b0fe-720ee79b5b1a",
                                                "text": "Voir de si faibles vainqueurs [les femmes] Régner si puissamment sur les plus nobles cœurs !"
                                            },
                                            {
                                                "example_id": "677c966a-0af1-44e8-88f0-7d5902a07a97",
                                                "sense_id": "578cd8c7-93e9-3f0f-b0fe-720ee79b5b1a",
                                                "text": "Il sait… que le Grand Seigneur arme puissamment,"
                                            },
                                            {
                                                "example_id": "7788598e-b0b3-48ec-a701-dbd87481ba80",
                                                "sense_id": "578cd8c7-93e9-3f0f-b0fe-720ee79b5b1a",
                                                "text": "À peine le guéritier, se bouchant du pouce la narine droite, en aspira-t-il par la gauche un demi-pincée, le mort toussa si puissamment qu’il aveugla par ses postillons les yeux des trois pandores."
                                            },
                                            {
                                                "example_id": "74db40ec-3903-4d63-93d2-19f6858ee087",
                                                "sense_id": "578cd8c7-93e9-3f0f-b0fe-720ee79b5b1a",
                                                "text": "Enfin, comme à dessein de le rendre plus complexe, des odeurs de caroube, de denrées coloniales, de goudron, d’air marin arrivaient puissamment du port et se mêlaient à celles qui montaient des pavés et des caves."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ecceb1f-61a5-3cd9-b561-b00e0bad29fe",
                                        "entry_id": "ce7bdb40-73c1-3265-a92a-ef9e31ab8252",
                                        "glosses": [
                                            "Avec force."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d113a91f-ca9b-45b7-b3dc-850041bc54cf",
                                                "sense_id": "1ecceb1f-61a5-3cd9-b561-b00e0bad29fe",
                                                "text": "Rien n'éloigne plus promptement et plus puissamment les surprises captieuses des sophistes…."
                                            },
                                            {
                                                "example_id": "ea66973b-dee8-41e6-8598-0321fa2779be",
                                                "sense_id": "1ecceb1f-61a5-3cd9-b561-b00e0bad29fe",
                                                "text": "Cela confirme puissamment ce que vous dites si bien, que nos yeux ne sont point ceux qu’on devrait avoir, si nous regardions les choses comme des chrétiens,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b5141eed-dc04-3b5b-a570-1597d395c899",
                                        "entry_id": "ce7bdb40-73c1-3265-a92a-ef9e31ab8252",
                                        "glosses": [
                                            "Extrêmement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6fb4417b-e2bc-4185-a803-c03dd4010c20",
                                                "sense_id": "b5141eed-dc04-3b5b-a570-1597d395c899",
                                                "text": "À sa propagande de quartier, il alliait une action incessante dans les ateliers du boulevard Masséna. Il avait puissamment resserré les liens moraux qui unissaient à la C. G. T. les typographes, les minervistes et les relieurs de Delaborde."
                                            },
                                            {
                                                "example_id": "4ea3938c-6db6-4212-9464-caf7e52e5cdb",
                                                "sense_id": "b5141eed-dc04-3b5b-a570-1597d395c899",
                                                "text": "Je sentirais mon mal puissamment soulagé,"
                                            },
                                            {
                                                "example_id": "ec10b2e3-de5a-47f0-94ba-35748b44b43b",
                                                "sense_id": "b5141eed-dc04-3b5b-a570-1597d395c899",
                                                "text": "Et qu’Isabelle en est puissamment irritée,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "19966dd9-2a43-3fa8-ada9-88dc1a61094d",
                                        "entry_id": "ce7bdb40-73c1-3265-a92a-ef9e31ab8252",
                                        "glosses": [
                                            "très."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "700f41c6-35f1-4c4d-8369-8afce460f6ed",
                                                "sense_id": "19966dd9-2a43-3fa8-ada9-88dc1a61094d",
                                                "text": "Puissamment riche très riche."
                                            },
                                            {
                                                "example_id": "b11faaf8-91ef-482b-a460-c0cecaba00f9",
                                                "sense_id": "19966dd9-2a43-3fa8-ada9-88dc1a61094d",
                                                "text": "Oui, madame, je suis puissamment riche,"
                                            },
                                            {
                                                "example_id": "6979a1a3-ff77-4b06-b29b-74fdd355955b",
                                                "sense_id": "19966dd9-2a43-3fa8-ada9-88dc1a61094d",
                                                "text": "Un brave laboureur […], et qui, après avoir payé la taille, le taillon, les aides et gabelles, le sou pour livre, la capitation et les vingtièmes, ne se trouvait pas puissamment riche au bout de l’année,"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "be82b950-48dc-48af-b388-4236f7dbec4d",
                        "source_entry_id": "7cbdf1a6-a832-385a-813b-b26fc763ee38",
                        "source_sense_id": "6d518047-2cf8-3162-97a5-1b2e542b16e5",
                        "target_lang_word": "vigoureusement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vigoureusement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5177984f-a7ed-3963-95dd-38b1cc41b027",
                                        "entry_id": "5941c26e-3c84-3ec7-8908-763578d86cbe",
                                        "glosses": [
                                            "Avec vigueur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f99603f3-0b13-4705-b18f-cff6a8957244",
                                                "sense_id": "5177984f-a7ed-3963-95dd-38b1cc41b027",
                                                "text": "[…] et la plupart des héros d'arguments ont le génie de la nation française : ils attaquent vigoureusement, mais sont perdus s'ils sont réduits à la guerre défensive."
                                            },
                                            {
                                                "example_id": "df00c615-8e42-443f-82cd-df79b3c11d34",
                                                "sense_id": "5177984f-a7ed-3963-95dd-38b1cc41b027",
                                                "text": "Elle [l'androsace ciliata] végète vigoureusement dans des situations bien plus froides encore ; je l’ai recueillie couverte de fleurs au haut du glacier de Tuquerouye,"
                                            },
                                            {
                                                "example_id": "70b99bce-55f3-4df6-a331-8ffb29754fcd",
                                                "sense_id": "5177984f-a7ed-3963-95dd-38b1cc41b027",
                                                "text": "La ramie jaune et la ramie rouge sont acclimatées en Indochine. Pourtant elles poussent moins vigoureusement ; elles ne périclitent pas, mais leurs tiges sont moins belles."
                                            },
                                            {
                                                "example_id": "c51fe4b1-e0cc-429e-bd3a-b3530feadb7c",
                                                "sense_id": "5177984f-a7ed-3963-95dd-38b1cc41b027",
                                                "text": "Il empoigna Bert par l’épaule, et le secoua vigoureusement, accompagnant ses gourmades d’objurgations irritées et le repoussant avec violence en arrière."
                                            },
                                            {
                                                "example_id": "941877d5-81ea-4cd9-b451-bc61e379f2f9",
                                                "sense_id": "5177984f-a7ed-3963-95dd-38b1cc41b027",
                                                "text": "Grande donc fut sa surprise lorsque, […], il se vit appréhender vigoureusement par deux douaniers qui s’étaient dissimulés dans l’intérieur du taillis et dont il n’avait naturellement pu soupçonner la présence."
                                            },
                                            {
                                                "example_id": "5dc5f2f0-ef97-4bce-862b-70a322658e09",
                                                "sense_id": "5177984f-a7ed-3963-95dd-38b1cc41b027",
                                                "text": "C’est souvent problématique, notamment pour les autorités, mais il ne peut y avoir de système démocratique fort si les journalistes ne remplissent pas librement et vigoureusement leur rôle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be554ac0-bf39-34b1-adc3-541cee024038",
                                        "entry_id": "5941c26e-3c84-3ec7-8908-763578d86cbe",
                                        "glosses": [
                                            "Fortement, avec force."
                                        ],
                                        "tags": [
                                            "Peinture"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee07004e-e0ca-4207-879f-0f6fc66f4314",
                                                "sense_id": "be554ac0-bf39-34b1-adc3-541cee024038",
                                                "text": "La blancheur des toiles que portent les paludiers, nom des gens qui cultivent le sel dans les marais salants, contraste vigoureusement avec les couleurs bleues et brunes des paysans, avec les parures originales et saintement conservées des femmes."
                                            },
                                            {
                                                "example_id": "ca1b4c47-e330-4ae3-bbab-5378906d9506",
                                                "sense_id": "be554ac0-bf39-34b1-adc3-541cee024038",
                                                "text": "Tableau vigoureusement colorié."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
