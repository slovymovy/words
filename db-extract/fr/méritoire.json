                "forms": [
                    {
                        "form_id": "7a297357-0526-4cab-86ef-68a2c0ee5441",
                        "entry_id": "05b27037-2661-30f9-bef9-5582eb5fc62f",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "méritoires"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d9fc5522-9963-34be-9508-3e10ed067757",
                        "entry_id": "05b27037-2661-30f9-bef9-5582eb5fc62f",
                        "glosses": [
                            "Qui mérite l’approbation, l’estime."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad80cc60-73ff-4de8-a437-485d2a25b7d9",
                                "sense_id": "d9fc5522-9963-34be-9508-3e10ed067757",
                                "text": "Il se mit ensuite en apprentissage, en renouvelant les mêmes efforts, entêtement d’autant plus méritoire qu’il lui fallait un jour pour apprendre ce que d’autres savaient en une heure."
                            },
                            {
                                "example_id": "0dbdcde8-8019-4320-a045-e4d30729fa16",
                                "sense_id": "d9fc5522-9963-34be-9508-3e10ed067757",
                                "text": "Il allait se marier sans arrière-pensée d'aucune sorte et il menait déjà une conduite exemplaire, ce qui était assez méritoire de la part d'un ancien viveur."
                            },
                            {
                                "example_id": "4c0d2572-1049-44dd-a3b7-5b3fb31666e2",
                                "sense_id": "d9fc5522-9963-34be-9508-3e10ed067757",
                                "text": "Au total, et grâce à des efforts déjà méritoires, on a crée à Rouen un peu moins de 500 logements."
                            },
                            {
                                "example_id": "64bf4a8e-e53b-4b5e-bccc-06ae315e5c7d",
                                "sense_id": "d9fc5522-9963-34be-9508-3e10ed067757",
                                "text": "Mais ce catéchisme est donné comme le résultat des méditations pénibles et consciencieuses et méritoires des hommes de bien qui fabriquent la Philosophie."
                            },
                            {
                                "example_id": "74707b9a-bf69-4d13-be12-e3b3f9d97384",
                                "sense_id": "d9fc5522-9963-34be-9508-3e10ed067757",
                                "text": "On ne s'improvise pas usurier, il faut parvenir d'abord à une méritoire insertion dans la mafia des gens bien placés pour exploiter leur prochain."
                            }
                        ]
                    },
                    {
                        "sense_id": "dfbb79b7-e5c9-32ee-9e0d-cf666f99b13c",
                        "entry_id": "05b27037-2661-30f9-bef9-5582eb5fc62f",
                        "glosses": [
                            "Qui rend Dieu miséricordieux pour le croyant."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "df9c8b07-cd09-4bfa-ba0e-0b764475a126",
                                "sense_id": "dfbb79b7-e5c9-32ee-9e0d-cf666f99b13c",
                                "text": "Dans ses discours, il défendit avec force cette thèse que la stricte observance des lois religieuses doit s'accompagner, pour devenir méritoire, de la pratique de la justice et de l'amour du prochain, envers les juifs comme envers les non-juifs."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7d1ade90-ec20-4594-ba19-9bd4987db9d1",
