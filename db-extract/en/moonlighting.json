                                    {
                                        "sense_id": "578cf413-ca60-3313-a263-3f2887f0befb",
                                        "entry_id": "d4260219-f779-3ece-8f06-3df5ec4104f1",
                                        "glosses": [
                                            "побочная, неосновная, одноразовая или временная работа (и заработок на этой работе) по отношению к основной работе"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "272ed8e7-5c15-43b2-bd40-5f5c7b1dce5b",
                                                "sense_id": "578cf413-ca60-3313-a263-3f2887f0befb",
                                                "text": "У меня тогда была небольшая подработка — раз в неделю брала вычитывать тексты в одном издательстве."
                                            },
                                            {
                                                "example_id": "114d5534-b9b2-43a1-926f-0def02ab1179",
                                                "sense_id": "578cf413-ca60-3313-a263-3f2887f0befb",
                                                "text": "У многих научных сотрудников НИИ есть подработки, связанная с чтением лекций в одном или даже нескольких вузах."
                                            }
                                        ]
                                    }
                                ]
