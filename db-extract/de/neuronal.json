                "senses": [
                    {
                        "sense_id": "c1878c68-75e3-37b7-8ba5-bfdc1b5afe3b",
                        "entry_id": "56cbb328-b560-39b8-bb2b-07028e2f9591",
                        "glosses": [
                            "Nerven, Nervenzellen, ihre Funktionen und Funktionsweisen betreffend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "615c9aa5-31bd-486c-b958-4a71c1b2c4f9",
                                "sense_id": "c1878c68-75e3-37b7-8ba5-bfdc1b5afe3b",
                                "text": "Sind Tierversuche an Affen wirklich notwendig? Der Tierphysiologe Andreas Nieder sagt: „Ja!“. Viele neuronale Erkrankungen und Infektionskrankheiten können wir erst durch diese Forschung verstehen und bekämpfen."
                            },
                            {
                                "example_id": "43aba51c-a71b-45cf-9cc2-a5fe52c6e513",
                                "sense_id": "c1878c68-75e3-37b7-8ba5-bfdc1b5afe3b",
                                "text": "Das Zika Virus […] dringt durch die Plazenta der schwangeren Frau und wandert im Fötus bis ins Gehirn. Dort verursacht es neuronale Schäden […]"
                            },
                            {
                                "example_id": "e3d7b4c1-a264-4cb4-8a75-62b9f60d6d56",
                                "sense_id": "c1878c68-75e3-37b7-8ba5-bfdc1b5afe3b",
                                "text": "Unsere Wahrnehmung ist kein innerer Spiegel der Wirklichkeit, sondern ein neuronales Modell der Wirklichkeit. Unser Gehirn schafft also ein funktionierendes Modell, mit dem wir uns in der Wirklichkeit zurechtfinden. Erst unser Gehirn erschafft also das, was wir für Wirklichkeit halten."
                            },
                            {
                                "example_id": "ec21f5ef-930b-4c34-82c2-ba3a5e963c36",
                                "sense_id": "c1878c68-75e3-37b7-8ba5-bfdc1b5afe3b",
                                "text": "[…] die Vorstellung, dass sich Gefühle durch neuronale Aktivität in klar abgegrenzten Hirnregionen abbilden, durch bildgebende Verfahren wie die Magnetresonanztomografie, kurz MRT, [hat sich] nicht bestätigt - bis auf eine Ausnahme: […] die Amygdala, der Mandelkern."
                            }
                        ],
                        "sense_index_json": "\"1\""
