                    "sense_id": "202e0f3d-a710-3bff-ba48-f763cd6ae3b2",
                    "sense_definition": "The activity or process of creating words or text on paper or a screen.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
