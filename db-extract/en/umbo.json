                        "glosses": [
                            "The boss of a shield, at or near the middle and usually projecting, sometimes in a sharp spike."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "edb6def2-1dca-41b6-a4c6-897eedc28d68",
                                "sense_id": "e26a1226-8eaa-3d2f-904e-fc5f5b081d79",
                                "text": "It is thirteen inches diameter, made of wood covered with leather, and an iron plate decorated with nails and mouldings; the boss or umbo projects four inches."
                            },
                            {
                                "example_id": "e6e2d457-8ea6-4951-99b6-d6e727eeade7",
                                "sense_id": "e26a1226-8eaa-3d2f-904e-fc5f5b081d79",
                                "text": "serves as the umbo of the region’s so-called Silicon Shield"
                            }
