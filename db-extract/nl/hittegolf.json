                "senses": [
                    {
                        "sense_id": "c597c0a1-b337-3781-835d-03f7f70cf458",
                        "entry_id": "5d604594-ebe2-3cb0-bae3-d407f0e50030",
                        "glosses": [
                            "aaneengesloten periode van minstens vijf dagen met een maximumtemperatuur van minstens 25° C, waarvan drie dagen met een maximumtemperatuur van minstens 30° C"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb0d80fb-fe95-4941-bcab-b8ac4dd2e0df",
                                "sense_id": "c597c0a1-b337-3781-835d-03f7f70cf458",
                                "text": "Nederland heeft officieel een hittegolf."
                            },
                            {
                                "example_id": "45845f9b-1583-4804-9eea-c7fb9908f654",
                                "sense_id": "c597c0a1-b337-3781-835d-03f7f70cf458",
                                "text": "Deze hittegolf met temperaturen boven de 40° C is werkelijk niet te harden."
                            },
                            {
                                "example_id": "e06be2a4-384e-495e-91f6-1a0c834b8a12",
                                "sense_id": "c597c0a1-b337-3781-835d-03f7f70cf458",
                                "text": "Na Casa de Luna trok ik met The Rat Pack weer verder en onderweg bespraken we hoe we het beste konden omgaan met de komende hittegolf van meer dan 42 °C."
                            },
                            {
                                "example_id": "83f97aa9-4072-4d5e-850a-2a2440fc9ec6",
                                "sense_id": "c597c0a1-b337-3781-835d-03f7f70cf458",
                                "text": "De komende dagen wordt het nog weer even flink warm en dan zal iedereen terugdenken aan de hittegolf van deze zomer."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2fdb8f56-8139-4645-b7b8-208a84a43c13",
                        "source_entry_id": "5d604594-ebe2-3cb0-bae3-d407f0e50030",
                        "source_sense_id": "c597c0a1-b337-3781-835d-03f7f70cf458",
                        "target_lang_word": "Hitzewelle",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hitzewelle",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9b4ad708-c125-3469-9e04-2f3c1d53d285",
                                        "entry_id": "2a681f7a-c7b4-356c-8472-315518aacdd6",
                                        "glosses": [
                                            "lange Periode von sehr heißen Tagen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50476d29-f5ca-456a-a6a5-db88c5e9de32",
                                                "sense_id": "9b4ad708-c125-3469-9e04-2f3c1d53d285",
                                                "text": "Bei der letzten Hitzewelle starben viele Menschen."
                                            },
                                            {
                                                "example_id": "b27f85b7-b60a-4a1d-810c-60b486ad92b5",
                                                "sense_id": "9b4ad708-c125-3469-9e04-2f3c1d53d285",
                                                "text": "„So forderte die Hitzewelle im Sommer 2003 bei uns geschätzt rund 8.000 zusätzliche Todesopfer. In Europa starben damals vermutlich so um die 60.000 Menschen.“"
                                            },
                                            {
                                                "example_id": "cb734e86-c77b-4175-add5-631b5b931f97",
                                                "sense_id": "9b4ad708-c125-3469-9e04-2f3c1d53d285",
                                                "text": "„Mehr als 1.150 Menschen sind nach offiziellen Angaben der Katastrophenbehörden seit Beginn der Hitzewelle infolge der extremen Temperaturen gestorben.“"
                                            },
                                            {
                                                "example_id": "39ca4f82-1dcb-4847-95dd-1983b716fd34",
                                                "sense_id": "9b4ad708-c125-3469-9e04-2f3c1d53d285",
                                                "text": "„Eigentlich sind hohe Temperaturen in Deutschland selten. Doch immer häufiger gibt es auch hier Hitzewellen. 2015 wurde sogar ein neuer Rekord gemessen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "18fc156f-ac05-4a54-830d-32ecda0ddf5a",
                        "source_entry_id": "5d604594-ebe2-3cb0-bae3-d407f0e50030",
                        "source_sense_id": "c597c0a1-b337-3781-835d-03f7f70cf458",
