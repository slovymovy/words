                    {
                        "translation_id": "9ff442a5-191a-4490-aaee-a289279ead5c",
                        "source_entry_id": "4b1f2a20-57df-3218-986b-f1fe86c524d3",
                        "source_sense_id": "a971a440-fc3c-3af9-b90c-5fb37ef3f92b",
                        "source_sense_description": "Prostituierte, die telefonisch gebucht wird",
                        "target_lang_word": "call girl",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "call girl",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "37627302-329d-3766-90bb-2f3e97221e2b",
                                        "entry_id": "38b87648-809f-32c8-8bca-58e706bea77c",
                                        "glosses": [
                                            "A female prostitute who is hired by telephone."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "df2b0298-7e29-3c69-bc84-081cd05aec93",
                                        "entry_id": "38b87648-809f-32c8-8bca-58e706bea77c",
                                        "glosses": [
                                            "A woman who works as a call center agent. (see usage notes)"
                                        ],
                                        "tags": [
                                            "humorous"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b9333118-4066-4f9d-826b-630c594ece25",
                                                "sense_id": "df2b0298-7e29-3c69-bc84-081cd05aec93",
                                                "text": "The Quinlan Marketing Coordination Plan – \"Call girl\" approach , separating sales from prospecting doubled agency sales in one year."
                                            },
                                            {
                                                "example_id": "72598ef6-bb1b-49ac-b1cc-2092c865f30b",
                                                "sense_id": "df2b0298-7e29-3c69-bc84-081cd05aec93",
                                                "text": "The telephone reduced isolation and danger for rural families. City dwellers used it as a babysitter. It reinforced the social phenomenon of the teenage peer group. It led to new social and occupational roles: telephone operator, telemarketer, call girl. It helped the geographic expansion of organizations."
                                            },
                                            {
                                                "example_id": "db7c4f05-21f6-47ee-8cf3-31fe540617cb",
                                                "sense_id": "df2b0298-7e29-3c69-bc84-081cd05aec93",
                                                "text": "Designed primarily as a marketing tool for television stations, the \"call-girl\" console is produced by Key Marketing and sells for $3,995."
                                            },
                                            {
                                                "example_id": "febf0ff6-362b-479d-97fa-bf194b198cdc",
                                                "sense_id": "df2b0298-7e29-3c69-bc84-081cd05aec93",
                                                "text": "Girl: Yeah, Pay was okay, but it just wasn't worth it. Everybody always yelling at you and hanging up on you. Guy: Hanging up on you? Girl: Yeah. Guy: Because you were a call girl? Girl: Yeah. Guy: Like a telemarketer? Girl: Yes! Guy: Oh. Well, this girl wasn't...that kind of call girl."
                                            },
                                            {
                                                "example_id": "bfbad063-f03e-4070-a86f-e412021a88dc",
                                                "sense_id": "df2b0298-7e29-3c69-bc84-081cd05aec93",
                                                "text": "My position taking telephone calls in customer service at Hewlett-Packard wasn't a high-status job—in fact, we were originally known as 'the call girls'—but soon I learned enough about the company's products to move into marketing and corporate communications."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6d5482fb-71a1-43a8-90f6-3166e01aa2ac",
                        "source_entry_id": "4b1f2a20-57df-3218-986b-f1fe86c524d3",
                        "source_sense_id": "a971a440-fc3c-3af9-b90c-5fb37ef3f92b",
