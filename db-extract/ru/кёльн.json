                    {
                        "translation_id": "1a365585-1e1c-4670-bce6-a90df8a1e9a6",
                        "source_entry_id": "7e5e570a-c41b-3d01-8a1f-cd89cbf4449c",
                        "source_sense_id": "9ad0c576-6029-371b-a4d7-3701d01b91a4",
                        "target_lang_word": "Köln",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Köln",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f9325592-4e94-3b9d-9a5e-36044305ffb5",
                                        "entry_id": "5b4a5a06-fd04-334c-9387-319b65e8343f",
                                        "glosses": [
                                            "Stadt in Nordrhein-Westfalen, viertgrößte Stadt Deutschlands, gelegen am Rhein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c90a5fdc-8d52-46ef-9827-7d70903eca35",
                                                "sense_id": "f9325592-4e94-3b9d-9a5e-36044305ffb5",
                                                "text": "Meine Tante arbeitet bei RTL in Köln."
                                            },
                                            {
                                                "example_id": "b6201d84-e090-4d81-af8b-963a3596a003",
                                                "sense_id": "f9325592-4e94-3b9d-9a5e-36044305ffb5",
                                                "text": "„Im Zweiten Weltkrieg fielen am 18. Juni 1940 auf Köln die ersten Bomben, ab 1942 wurde das Bombardement durch die britische Luftwaffe intensiviert.“"
                                            },
                                            {
                                                "example_id": "fed0c26d-55ba-4796-8593-3b3ef724f0d7",
                                                "sense_id": "f9325592-4e94-3b9d-9a5e-36044305ffb5",
                                                "text": "„Die ehemaligen Römerstädte Köln, Mainz, Worms, Speyer, Straßburg und Basel gewannen wirtschaftliche Bedeutung, seit der Warenaustausch mit Italien nicht mehr hauptsächlich über Marseille und Fos auf dem Seeweg, sondern immer mehr über die Alpenpässe abgewickelt wurde.“"
                                            },
                                            {
                                                "example_id": "f597ed13-9af8-4d3b-9cb9-af088f95441b",
                                                "sense_id": "f9325592-4e94-3b9d-9a5e-36044305ffb5",
                                                "text": "„Wir erreichen Köln am späten Mittag.“"
                                            },
                                            {
                                                "example_id": "a08cd648-8622-4203-9fda-472e54b23f7c",
                                                "sense_id": "f9325592-4e94-3b9d-9a5e-36044305ffb5",
                                                "text": "Ich bin in Köln geboren."
                                            },
                                            {
                                                "example_id": "84ca16c7-cdc2-4597-9850-bc611946de9d",
                                                "sense_id": "f9325592-4e94-3b9d-9a5e-36044305ffb5",
                                                "text": "Wir haben in Köln unseren Urlaub verbracht."
                                            },
                                            {
                                                "example_id": "88f3c464-e664-43bd-a85d-0c2b630c8403",
                                                "sense_id": "f9325592-4e94-3b9d-9a5e-36044305ffb5",
                                                "text": "Nach Köln führen viele Wege."
                                            },
                                            {
                                                "example_id": "ea0f1994-86d6-4bae-9e7a-55969b34d994",
                                                "sense_id": "f9325592-4e94-3b9d-9a5e-36044305ffb5",
                                                "text": "Köln liegt auf der Nordhalbkugel."
                                            },
                                            {
                                                "example_id": "f8f40845-ebbb-4836-be87-bee2cbada1d8",
                                                "sense_id": "f9325592-4e94-3b9d-9a5e-36044305ffb5",
                                                "text": "„Ich verbrachte den Vormittag damit, von einem Lohndiener begleitet, alle die heroisch-komischen Wunderwerke Kölns zu besichtigen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
