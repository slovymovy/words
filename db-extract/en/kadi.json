                        "sense_id": "cf3f7889-1217-3a9c-889e-30b7b2ef6cc9",
                        "entry_id": "4bc3f303-7b0a-3521-a66e-c991d5d0a030",
                        "glosses": [
                            "Alternative spelling of qadi, Islamic judge, particularly (historical) in Ottoman contexts where they initially oversaw local administration as well as Islamic law."
                        ],
                        "tags": [
                            "alt-of",
                            "alternative"
                        ],
                        "examples": [
                            {
                                "example_id": "c47874f0-44e7-4976-9215-fb8f5e6fafb7",
                                "sense_id": "cf3f7889-1217-3a9c-889e-30b7b2ef6cc9",
                                "text": "Each has an imaum, but the kadi is their head, of which dignity he seems not a little proud."
                            },
                            {
                                "example_id": "27589b95-2d50-4ecc-abef-42631297bd7e",
                                "sense_id": "cf3f7889-1217-3a9c-889e-30b7b2ef6cc9",
                                "text": "\"You shall go to Mecca when you grow up, and become a Hadji, and when you come back the high kadi shall take you in the mosque and make a kateeb of you,\" said I. \"Now put your forehead to the ground and thank the good Allah that the kuching had eaten dog before he got you.\""
                            },
                            {
                                "example_id": "ff1e3d3f-ba55-4abc-bb65-651747c9f928",
                                "sense_id": "cf3f7889-1217-3a9c-889e-30b7b2ef6cc9",
                                "text": "To this the Jew agreed, and the two went together to the great hall, in which the kadi was administering justice."
                            }
                        ]
                    }
                ],
