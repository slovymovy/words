                        "entry_id": "6ca43ab1-d57a-327a-9265-9d42439c11e5",
                        "glosses": [
                            "Vogel aus der Familie der Habichtartigen mit auffälligen borstigen Federn über dem Schnabel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1df9f30-646c-488c-8cdd-f6f7d185d828",
                                "sense_id": "cda8b513-5885-3240-b6f8-4fd409f61901",
                                "text": "Bartgeier wurden in den Alpen erfolgreich wieder angesiedelt."
                            },
                            {
                                "example_id": "2d1995f4-1a68-4943-bbcd-b08b472446cd",
                                "sense_id": "cda8b513-5885-3240-b6f8-4fd409f61901",
                                "text": "„Naturschützer haben bei Berchtesgaden zwei Bartgeier in die Freiheit entlassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
