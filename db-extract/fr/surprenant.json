                            {
                                "example_id": "822ea0e4-f1f9-4d89-bbed-108a0408795b",
                                "sense_id": "9a1a2ac6-bffb-3beb-9dcf-be3ec8e42d68",
                                "text": "Bien que prévisible, la violence est surprenante."
                            },
                            {
                                "example_id": "17b4d054-4a99-4f95-bf28-ccf93013848f",
                                "sense_id": "9a1a2ac6-bffb-3beb-9dcf-be3ec8e42d68",
                                "text": "Amil Event a donc reçu pour consigne de prévoir une vingtaine d’obstacles simples mais surprenants sur un parcours d’environ cinq kilomètres."
                            }
                        ]
