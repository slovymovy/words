                        "glosses": [
                            "Absence of faith."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "116f8a2a-10fa-467c-81d9-8cad5a0f05fd",
                                "sense_id": "b03e60e4-259f-3582-9ddd-9eab7394ec5f",
                                "text": "The true religion occupies the happy mean between miserable unfaith, on the one hand, and timorous superstition, wild fanaticism, and pietistical zeal on the other."
                            },
                            {
                                "example_id": "69254e3d-27a2-463d-97da-a91ab788abfa",
                                "sense_id": "b03e60e4-259f-3582-9ddd-9eab7394ec5f",
                                "text": "But schooling and native shrewdness had raised up in the younger men an unfaith in old usages, so judgment halted between sentence and execution."
                            },
                            {
                                "example_id": "abd084f4-3f6a-4939-a45f-f6f5b57987d9",
                                "sense_id": "b03e60e4-259f-3582-9ddd-9eab7394ec5f",
                                "text": "Remember old years and do not break your oath with me, Jehane, since God abhors nothing so much as unfaith."
                            }
                        ]
                    }
                ],
