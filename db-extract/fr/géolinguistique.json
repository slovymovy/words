            {
                "entry_id": "f0570d05-86e6-3c27-8f8f-a377a38348ba",
                "word": "géolinguistique",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "5b773e39-063c-32a8-9298-ee60e74f0ef4",
                        "entry_id": "f0570d05-86e6-3c27-8f8f-a377a38348ba",
                        "glosses": [
                            "Étude de la variation linguistique ou dialectale au niveau géographique."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d0cf5af3-b605-4e53-8dc4-4dd06df7c616",
                        "source_entry_id": "f0570d05-86e6-3c27-8f8f-a377a38348ba",
                        "source_sense_id": "5b773e39-063c-32a8-9298-ee60e74f0ef4",
                        "target_lang_word": "Sprachgeographie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sprachgeographie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d592e5ea-cc97-3342-abfe-fe117bee603b",
                                        "entry_id": "507aaeee-9500-38fd-bf22-d60fc39d4758",
                                        "glosses": [
                                            "linguistische Disziplin, die sich mit der räumlichen Verbreitung sprachlicher Einheiten und Eigenschaften befasst."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c03306af-d455-45a7-9c3a-efb1104a3eab",
                                                "sense_id": "d592e5ea-cc97-3342-abfe-fe117bee603b",
                                                "text": "Die Sprachgeographie stellt die Grenzen von Dialekten fest."
                                            },
                                            {
                                                "example_id": "b407253a-e465-496c-a696-35704068aac0",
                                                "sense_id": "d592e5ea-cc97-3342-abfe-fe117bee603b",
                                                "text": "Die Sprachgeographie erarbeitet u.a. Sprachkarten bzw. Sprachatlanten, die die regionale Verbreitung bestimmter Laute oder Wörter oder anderer Einheiten oder Eigenschaften zeigen."
                                            },
                                            {
                                                "example_id": "e8ade95d-f67a-4512-a467-d2601054f096",
                                                "sense_id": "d592e5ea-cc97-3342-abfe-fe117bee603b",
                                                "text": "Sprachgeographie wird z.T. mit Areallinguistik gleichgesetzt, die aber nicht auf Dialekte beschränkt ist, z.B. wenn sie als Arealtypologie betrieben wird."
                                            },
                                            {
                                                "example_id": "80413a3c-d569-40a8-9d63-843960eeabbe",
                                                "sense_id": "d592e5ea-cc97-3342-abfe-fe117bee603b",
                                                "text": "„Die Sprachgeographie ist eine linguistische Methode, die Übereinstimmungen und Unterschiede zwischen Mundarten, deren Verbreitungsgebiete meistens aneinander grenzen, zu deuten versucht.“"
                                            },
                                            {
                                                "example_id": "836c26f2-1ce6-498a-9511-2898eadb3f25",
                                                "sense_id": "d592e5ea-cc97-3342-abfe-fe117bee603b",
                                                "text": "„Mit Problemen der Ausbreitung von Neuerungen beschäftigte sich zuerst systematisch die Sprachgeographie, die sich in Opposition zu der Junggrammatischen Schule entwickelte…“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "88a5e81e-23f9-4b3a-8393-d397be763b47",
                        "source_entry_id": "f0570d05-86e6-3c27-8f8f-a377a38348ba",
                        "source_sense_id": "5b773e39-063c-32a8-9298-ee60e74f0ef4",
                        "target_lang_word": "Areallinguistik",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Areallinguistik",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b7bd1206-3328-3a7c-b4a0-58f037fd347b",
                                        "entry_id": "2d7fd68e-c67f-3cca-8259-ab9429a33b7b",
                                        "glosses": [
                                            "linguistische Disziplin, die sich mit Spracherscheinungen in abgegrenzten Gebieten befasst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dff1c937-3d8a-4490-a6be-02ccbff9f05a",
                                                "sense_id": "b7bd1206-3328-3a7c-b4a0-58f037fd347b",
                                                "text": "Entscheidend bei der Areallinguistik ist die Ausrichtung auf den geographischen Aspekt."
                                            },
                                            {
                                                "example_id": "0e5e94dc-8c07-4708-b854-3f737086c12c",
                                                "sense_id": "b7bd1206-3328-3a7c-b4a0-58f037fd347b",
                                                "text": "„Eine Areallinguistik (Dialektgeographie) ist von der Soziolinguistik immer dann deutlich zu trennen, wenn der variabel gehaltene Raumfaktor (Dialekt vs. Sprachraum) eine extrakommunikative Fragestellung bewirkt.“"
                                            },
                                            {
                                                "example_id": "d453b740-f9ca-47c1-a8ae-bb7ace3c23ad",
                                                "sense_id": "b7bd1206-3328-3a7c-b4a0-58f037fd347b",
                                                "text": "„Areallinguistik heißt diejenige Teildisziplin, in der Übereinstimmungen und Unterschiede zwischen sich räumlich gegeneinander abhebenden Sprachsystemen oder zwischen geographisch differenzierten sprachlichen Subsystemen sowie die Verbreitung der Übereinstimmungen mit Hilfe kartographischer Darstellungen interpretiert werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3156d67a-6625-41f9-82e1-6c9a0a4fce07",
                        "source_entry_id": "f0570d05-86e6-3c27-8f8f-a377a38348ba",
