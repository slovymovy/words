                                        "examples": [
                                            {
                                                "example_id": "983fc39b-ccb5-48f4-a930-8fd879605849",
                                                "sense_id": "dd7a933c-deed-3743-8b3d-fcde47b83d67",
                                                "text": "Вторая специальность Бена ― открытие и описание ископаемых животных колонии, между которыми встречается много двузубых змей."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "711bf2b5-28b8-3c14-9401-8ca7cd8ab9a7",
                                        "entry_id": "84f01541-6a98-3034-a578-7f3a8d1a4d3a",
                                        "glosses": [
                                            "имеющий два зубца"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a75810e9-dad5-4475-a962-1bdacefdceab",
                                                "sense_id": "711bf2b5-28b8-3c14-9401-8ca7cd8ab9a7",
                                                "text": "Он покропил лимончиком моллюска, поддел его двузубой вилочкой и отправил в рот."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
