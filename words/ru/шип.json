                    ],
                    "common_phrases": [
                        "зимние шипы",
                        "шины с шипами"
                    ],
                    "target_lang_definitions": {
                        "en": "A metal projection on the sole of a shoe or tire for better traction."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stud",
                                "target_lang_sense_clarification": "A metal projection on a tire or shoe sole for grip."
                            },
                            {
                                "target_lang_word": "cleat",
                                "target_lang_sense_clarification": "A projection on the sole of a shoe to provide traction."
                            },
                            {
                                "target_lang_word": "spike",
                                "target_lang_sense_clarification": "A sharp metal projection on sports shoes."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "80228b47-6658-30f0-972b-5b3af2628f66",
                    "sense_definition": "Выступ в детали, который вставляется в паз другой детали для соединения.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "technology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мастер аккуратно вставил <w>шип</w> в паз деревянной рамы.",
                            "target_lang_translations": {
                                "en": "The craftsman carefully inserted the <w>tenon</w> into the mortise of the wooden frame."
                            }
                        },
                        {
                            "text": "Соединение на <w>шипах</w> считается очень прочным.",
                            "target_lang_translations": {
                                "en": "A <w>tenon</w> joint is considered very strong."
                            }
                        }
                    ],
                    "antonyms": [
                        "паз",
                        "гнездо"
                    ],
                    "common_phrases": [
                        "шип и паз"
                    ],
                    "target_lang_definitions": {
                        "en": "A projecting part of a component that fits into a slot in another component to create a joint."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "tenon",
                                "target_lang_sense_clarification": "A projecting piece of wood designed to fit into a mortise."
                            },
                            {
                                "target_lang_word": "dowel",
                                "target_lang_sense_clarification": "A cylindrical pin used to hold two pieces of material together."
                            }
                        ]
                    }
                },
                {
