                        "cross_references": [
                            {
                                "target_word": "taborite",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e238ed85-5c13-388d-9b6e-943d21cc2a1d",
                                        "entry_id": "50f6a179-d51a-3354-91b6-1b86f25aea42",
                                        "glosses": [
                                            "Variante de thaborite."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "69b5a92a-ade5-4622-95a0-a3d920971a3b",
                                                "sense_id": "e238ed85-5c13-388d-9b6e-943d21cc2a1d",
                                                "text": "Nous nous attacherons donc surtout aux éclats soudains, aux violences excessives, aux utopies sanglantes et aux promptes débandades, les unes et les autres ayant pu toutefois s'inscrire comme une séquence particulière dans le film d'actions plus cohérentes d'opposition : ainsi les comportements aberrants des chiliastes de Bohême à l'intérieur du camp taborite en 1419-1421."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0b02ecb6-03bf-4c3d-a70a-62fb3a840114",
                        "source_entry_id": "74ba837d-d47d-31b8-8b75-2454abfab8c4",
                        "source_sense_id": "cc05f4b8-7e72-3201-b0ae-e0b4370808da",
                        "target_lang_word": "thaborite",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "thaborite",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4e2b080a-5b73-313f-a211-a7d5b90c22fd",
                                        "entry_id": "69662e82-5848-3ca7-9333-590d6b2f49b8",
                                        "glosses": [
                                            "Membre d’une secte de hussites qui, sous la conduite de Ziska, se retirèrent en Bohême."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "510d205b-1d8f-4228-9dca-a2c9a8f00a16",
                                                "sense_id": "4e2b080a-5b73-313f-a211-a7d5b90c22fd",
                                                "text": "Les thaborites rejetaient le purgatoire, la confession auriculaire, l’extrême-onction et la présence réelle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "22b72459-37bb-4d1c-872b-b7bacb32b278",
                        "source_entry_id": "74ba837d-d47d-31b8-8b75-2454abfab8c4",
                        "source_sense_id": "cc05f4b8-7e72-3201-b0ae-e0b4370808da",
                        "target_lang_word": "Taborit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "cfa33ab9-51f5-4bfd-a16d-46f9339f663a",
                        "source_entry_id": "74ba837d-d47d-31b8-8b75-2454abfab8c4",
                        "source_sense_id": "cc05f4b8-7e72-3201-b0ae-e0b4370808da",
                        "target_lang_word": "таборит",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "таборит",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "000fa153-73f1-3eb4-89b6-9dd37408a4cc",
                                        "entry_id": "bf8c66be-407f-3732-aed4-a54b0ecf7f5b",
                                        "glosses": [
                                            "истор. в середине XV в — последователь радикального крыла чешского реформаторского религиозного движения гуситов"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a55a27bc-c542-47a1-bc47-4250aeed9a8b",
                                                "sense_id": "000fa153-73f1-3eb4-89b6-9dd37408a4cc",
                                                "text": "Глядя на этот крепкий, сжатый лоб, на покойное выражение глаз, на нечесаную бороду, на волосы с проседью и на всю его фигуру, мне казалось, что это или какой-нибудь фанатический пастор из войска Густава-Адольфа, забывший умереть, или какой-нибудь таборит, проповедующий покаяние и причастие в двух видах."
                                            },
                                            {
                                                "example_id": "22a375f1-5c2e-4dbe-b2fd-eeb424cb9077",
                                                "sense_id": "000fa153-73f1-3eb4-89b6-9dd37408a4cc",
                                                "text": "В нем течет гуситская кровь, горячая кровь таборитов, живет память Жижки; и что, по нашему собственному опыту и по воспоминаниям, вынесенным нами из 1848, составляет одно из завиднейших преимуществ чешской учащейся молодежи, это ее родственное, истинно братское отношение к этому народу."
                                            },
                                            {
                                                "example_id": "eade4892-7cfd-4099-a419-60a6a0650fc3",
                                                "sense_id": "000fa153-73f1-3eb4-89b6-9dd37408a4cc",
                                                "text": "― Так в Табор, как в Прагу весной известного вам года, слетались оппозиционеры и гуманисты истинно западного толка, я имею в виду проповедников еретических сект всей Европы, среди них иохамиты, беггарды, вальденсы, то есть те, кого принято называть таборитами."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
