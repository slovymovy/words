                        "entry_id": "2357f044-b3e8-380d-a7f0-2998228aeeb1",
                        "glosses": [
                            "een klier in het lichaam dat zweet produceert."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4541bf7-eb3e-4e79-b6cc-2722d1531e82",
                                "sense_id": "58801011-dd24-39e6-a173-9e1db458975a",
                                "text": "De zweetklier moest tijdens het sporten hard werken."
                            },
                            {
                                "example_id": "651f6b34-7198-4ee0-b2d7-d328ec591e7c",
                                "sense_id": "58801011-dd24-39e6-a173-9e1db458975a",
                                "text": "Ik voelde mijn armen prikken van de zenuwen, zweetklieren die dreigden open te springen."
                            },
                            {
                                "example_id": "54829d92-1b41-42a8-8158-482a2a271c34",
                                "sense_id": "58801011-dd24-39e6-a173-9e1db458975a",
                                "text": "In zijn grijze pak ziet de gestalte er zo rustig en koel uit dat men zich onwillekeurig afvraagt of een dergelijke volmaakte verschijning wel zweetklieren, slijmvliezen en een spijsvertering heeft."
                            }
                        ]
                    }
