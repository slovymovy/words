                "senses": [
                    {
                        "sense_id": "0f056b3e-bcd1-31d9-95c6-6f9141172001",
                        "entry_id": "4f4227b2-ba3e-38b2-88ab-17ec46654731",
                        "glosses": [
                            "mithilfe einer Flüssigkeit gekühlt; Flüssigkeiten zum Abführen von Wärme nutzend"
