                        "glosses": [
                            "To strain or filter outward."
                        ],
                        "tags": [
                            "poetic",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "869d0df5-d16a-4406-bc72-628f552d4e6b",
                                "sense_id": "4f8331a7-13d1-3e36-8db2-c6ddf25c872d",
                                "text": "Hark, in the organ, the caught Wind, outstraining,\nJubilant rise in a soaring prayer!"
                            }
                        ]
