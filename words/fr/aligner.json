                        "aligner des rangées"
                    ]
                },
                {
                    "sense_id": "73cb7df8-68fe-3977-9286-9f1fed134fd2",
                    "sense_definition": "Présenter ou engager des sportifs, des candidats ou des troupes dans une compétition ou une confrontation.",
