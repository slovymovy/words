    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "93415d97-9c2d-3c79-b4f9-5a310356471c",
                    "sense_definition": "Evidence or an argument that establishes a fact or the truth of a statement.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "evidence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police are still looking for <w>proof</w> that he was at the scene of the crime.",
                            "target_lang_translations": {
                                "ru": "Полиция все еще ищет <w>доказательства</w> того, что он был на месте преступления."
                            }
                        },
                        {
                            "text": "You will need to provide <w>proof</w> of identity before you can enter the building.",
                            "target_lang_translations": {
                                "ru": "Вам нужно будет предоставить <w>подтверждение</w> личности, прежде чем вы сможете войти в здание."
                            }
                        }
                    ],
                    "synonyms": [
                        "testament"
                    ],
                    "antonyms": [
                        "disproof"
                    ],
                    "common_phrases": [
                        "proof of identity",
                        "conclusive proof",
                        "burden of proof",
                        "living proof"
                    ],
                    "target_lang_definitions": {
                        "ru": "Свидетельство или аргумент, устанавливающий факт или истинность утверждения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "доказательство",
                                "target_lang_sense_clarification": "факт или информация"
                            },
                            {
                                "target_lang_word": "подтверждение",
                                "target_lang_sense_clarification": "свидетельство истинности"
                            },
                            {
                                "target_lang_word": "пруф",
                                "target_lang_sense_clarification": "сленг, интернет-доказательство"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "403561ff-77a3-3af4-8fec-e2a6d88cc69e",
                    "sense_definition": "A logical sequence of statements showing that a mathematical or philosophical conclusion is true.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "logic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The student struggled to complete the mathematical <w>proof</w> for the geometry theorem.",
                            "target_lang_translations": {
                                "ru": "Студент с трудом завершил математическое <w>доказательство</w> геометрической теоремы."
                            }
                        },
                        {
                            "text": "This elegant <w>proof</w> demonstrates that there are infinitely many prime numbers.",
                            "target_lang_translations": {
                                "ru": "Это элегантное <w>доказательство</w> демонстрирует, что существует бесконечно много простых чисел."
                            }
                        }
                    ],
                    "common_phrases": [
                        "mathematical proof",
                        "formal proof"
                    ],
                    "target_lang_definitions": {
                        "ru": "Логическая последовательность утверждений, показывающая истинность математического или философского вывода."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "доказательство",
                                "target_lang_sense_clarification": "математическое или логическое"
                            },
                            {
                                "target_lang_word": "обоснование",
                                "target_lang_sense_clarification": "логический вывод"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c6f01026-3d88-3bd0-8610-d71e211c1db8",
                    "sense_definition": "A trial impression of a printed work used for making corrections before final printing.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "printing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The author spent the entire weekend checking the <w>proofs</w> for any spelling errors.",
                            "target_lang_translations": {
                                "ru": "Автор провел все выходные, проверяя <w>корректуру</w> на наличие орфографических ошибок."
                            }
                        },
                        {
                            "text": "We need to send the final <w>proof</w> to the publisher by tomorrow morning.",
                            "target_lang_translations": {
                                "ru": "Нам нужно отправить финальный <w>оттиск</w> издателю к завтрашнему утру."
                            }
                        }
                    ],
                    "common_phrases": [
                        "page proof",
                        "galley proof"
                    ],
                    "target_lang_definitions": {
                        "ru": "Пробный оттиск печатного издания, используемый для внесения исправлений перед окончательной печатью."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "корректура",
                                "target_lang_sense_clarification": "пробный оттиск"
                            },
                            {
                                "target_lang_word": "пробный оттиск",
                                "target_lang_sense_clarification": "для проверки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2dfe18cc-3753-3b32-8928-8983e3a85e56",
                    "sense_definition": "A measure of the alcohol content in a distilled liquid.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "alcohol",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The label indicates that this whiskey is eighty <w>proof</w> which means it is forty percent alcohol.",
                            "target_lang_translations": {
                                "ru": "Этикетка указывает, что крепость этого виски составляет восемьдесят <w>пруф</w>, что означает сорок процентов содержания спирта."
                            }
                        },
                        {
                            "text": "In the United States the <w>proof</w> of a spirit is exactly double its alcohol percentage.",
                            "target_lang_translations": {
                                "ru": "В Соединенных Штатах <w>крепость</w> спиртного напитка ровно в два раза превышает процент содержания алкоголя."
                            }
                        }
                    ],
                    "common_phrases": [
                        "hundred proof",
                        "alcohol proof"
                    ],
                    "target_lang_definitions": {
                        "ru": "Мера содержания алкоголя в дистиллированной жидкости."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пруф",
                                "target_lang_sense_clarification": "единица крепости алкоголя"
                            },
                            {
                                "target_lang_word": "градус крепости",
                                "target_lang_sense_clarification": "содержание спирта"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "6e216d04-b32b-3401-abaa-ffc8a3130716",
                    "sense_definition": "Able to withstand or resist something, often used in combination.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "resistance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new watch is <w>proof</w> against water damage even at great depths.",
                            "target_lang_translations": {
                                "ru": "Новые часы <w>устойчивы</w> к воздействию воды даже на большой глубине."
                            }
                        },
                        {
                            "text": "He remained <w>proof</w> against all temptation and stayed focused on his goals.",
                            "target_lang_translations": {
                                "ru": "Он оставался <w>стоек</w> ко всем искушениям и сохранял концентрацию на своих целях."
                            }
                        }
                    ],
                    "common_phrases": [
                        "proof against harm",
                        "proof against temptation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Способный выдерживать или сопротивляться чему-либо, часто используется в словосочетаниях."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "устойчивый",
                                "target_lang_sense_clarification": "к воздействию"
                            },
                            {
                                "target_lang_word": "непроницаемый",
                                "target_lang_sense_clarification": "защищенный"
                            },
                            {
                                "target_lang_word": "-стойкий",
                                "target_lang_sense_clarification": "в составе сложных слов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9af7b7e3-698a-3617-a736-acf2a89c010c",
                    "sense_definition": "Meeting a specific standard of alcohol content.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "alcohol",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sailors were given a ration of <w>proof</w> spirit every afternoon.",
                            "target_lang_translations": {
                                "ru": "Каждый день после полудня морякам выдавали порцию спирта <w>стандартной крепости</w>."
                            }
                        },
                        {
                            "text": "He preferred drinking <w>proof</w> liquor despite its very strong taste.",
                            "target_lang_translations": {
                                "ru": "Он предпочитал пить <w>крепкий</w> алкоголь, несмотря на его очень резкий вкус."
                            }
                        }
                    ],
                    "common_phrases": [
                        "proof spirit"
                    ],
                    "target_lang_definitions": {
                        "ru": "Соответствующий определенному стандарту содержания алкоголя."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стандартной крепости",
                                "target_lang_sense_clarification": "об алкоголе"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b524777c-ef35-3a24-9e44-be67c351df28",
                    "sense_definition": "To read and mark corrections in a text before it is published.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "editing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I need to <w>proof</w> this article one last time before I submit it.",
                            "target_lang_translations": {
                                "ru": "Мне нужно <w>вычитать</w> эту статью в последний раз перед отправкой."
                            }
                        },
                        {
                            "text": "She spent hours <w>proofing</w> the manuscript to ensure there were no typos.",
                            "target_lang_translations": {
                                "ru": "Она часами <w>корректировала</w> рукопись, чтобы убедиться в отсутствии опечаток."
                            }
                        }
                    ],
                    "common_phrases": [
                        "proof a manuscript"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "shortened form of proofread"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Читать и отмечать исправления в тексте перед его публикацией."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вычитывать",
                                "target_lang_sense_clarification": "текст на ошибки"
                            },
                            {
                                "target_lang_word": "корректировать",
                                "target_lang_sense_clarification": "исправлять опечатки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e9b213de-7cfa-3b56-9645-34ddf2ec9dc2",
                    "sense_definition": "To allow dough to rise before baking.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "cooking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should <w>proof</w> the dough in a warm place for about an hour.",
                            "target_lang_translations": {
                                "ru": "Вам следует <w>расстаивать</w> тесто в теплом месте около часа."
                            }
                        },
                        {
                            "text": "The recipe says to <w>proof</w> the bread until it has doubled in size.",
                            "target_lang_translations": {
                                "ru": "В рецепте сказано <w>давать подняться</w> хлебу, пока он не увеличится в объеме вдвое."
                            }
                        }
                    ],
                    "common_phrases": [
                        "proof the dough"
                    ],
                    "target_lang_definitions": {
                        "ru": "Дать тесту подняться перед выпечкой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "расстаивать",
                                "target_lang_sense_clarification": "давать тесту подняться"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "391eae3c-eb10-349e-a9a0-ea7e8f01994e",
                    "sense_definition": "To test if yeast is alive by mixing it with warm water and sugar.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "cooking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Always <w>proof</w> the yeast first to make sure it is still active.",
                            "target_lang_translations": {
                                "ru": "Всегда сначала <w>проверяйте</w> дрожжи, чтобы убедиться, что они все еще активны."
                            }
                        },
                        {
                            "text": "If the mixture doesn't bubble after ten minutes you failed to <w>proof</w> the yeast correctly.",
                            "target_lang_translations": {
                                "ru": "Если смесь не запузырилась через десять минут, значит, вам не удалось правильно <w>активировать</w> дрожжи."
                            }
                        }
                    ],
                    "synonyms": [
                        "bloom",
                        "rehydrate"
                    ],
                    "common_phrases": [
                        "proof the yeast"
                    ],
                    "target_lang_definitions": {
                        "ru": "Проверить жизнеспособность дрожжей, смешав их с теплой водой и сахаром."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проверять",
                                "target_lang_sense_clarification": "активность дрожжей"
                            },
                            {
                                "target_lang_word": "активировать",
                                "target_lang_sense_clarification": "дрожжи"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "31339ca5-f7ad-3fdf-9921-13512538e46d",
                    "sense_definition": "To treat a surface or material so that it becomes resistant to something like water.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "resistance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We need to <w>proof</w> the basement walls against moisture before the winter starts.",
                            "target_lang_translations": {
                                "ru": "Нам нужно <w>защитить</w> стены подвала от влаги до начала зимы."
                            }
                        },
                        {
                            "text": "The company uses a special chemical to <w>proof</w> the fabric against stains.",
                            "target_lang_translations": {
                                "ru": "Компания использует специальный химикат, чтобы <w>сделать</w> ткань <w>устойчивой</w> к пятнам."
                            }
                        }
                    ],
                    "common_phrases": [
                        "proof against water"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обработать поверхность или материал так, чтобы они стали устойчивыми к чему-либо, например, к воде."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пропитывать",
                                "target_lang_sense_clarification": "для защиты"
                            },
                            {
                                "target_lang_word": "делать устойчивым",
                                "target_lang_sense_clarification": "защищать поверхность"
                            }
                        ]
                    }
                }
            ]
        },
        {
