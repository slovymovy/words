                        "glosses": [
                            "Radfahrer, der ein Einrad fährt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dcf3b491-a1c2-4d43-8c22-a267dc85f5f1",
                                "sense_id": "c0e75f0e-f450-321c-b23c-175020f1f7a3",
                                "text": "„Einer der bekanntesten ist tinyurl.com, wurde 2002 von einem Einradfahrer namens Kevin Gilbertson aus Liebhaberei gegründet und bringt in seiner Bezeichnung die Sache auf den Punkt: die URL (Uniform Resource Locator), die oft unendlich langen Adressen im Netz winzig, tiny, zu machen.“"
                            },
                            {
                                "example_id": "d371cebb-ead7-4c30-bf13-47024020985f",
                                "sense_id": "c0e75f0e-f450-321c-b23c-175020f1f7a3",
                                "text": "„Zurück wählte der Einradfahrer den bequemeren Weg – im Auto mit Einheimnischen, im Taxi und Bus, um ins Hotel zurückzukommen.“"
                            },
                            {
                                "example_id": "87a2349a-17ea-44f0-a120-8710904a1297",
                                "sense_id": "c0e75f0e-f450-321c-b23c-175020f1f7a3",
                                "text": "„Noch nie wagte ein Einradfahrer eine Abfahrt aus solch spektakulärer Höhe. “"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
