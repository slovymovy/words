                                "example_id": "d42e5905-3df9-47b7-a623-2600b2497c59",
                                "sense_id": "ed889d4b-db24-33ba-8f1d-3eb1af28b611",
                                "text": "Nederland won uiteindelijk toch door een daverende score bij de tv-kijkers thuis. Van het publiek kreeg hij 261 punten, waarmee hij tweede werd achter Noorwegen."
                            }
                        ]
                    },
