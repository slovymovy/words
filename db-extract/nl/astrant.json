                "senses": [
                    {
                        "sense_id": "4cac7349-18dc-304f-8dfe-f4fe342df16c",
                        "entry_id": "03bab016-8fac-379f-b7bb-3bdedf73f860",
                        "glosses": [
                            "van een persoon dat deze (te) vrijmoedig is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "248f6fe7-a8bf-43a3-8717-6cfa24387af3",
                                "sense_id": "4cac7349-18dc-304f-8dfe-f4fe342df16c",
                                "text": "'Wordt mijn dochter daarginds niet te astrant?', weifelde mijn moeder."
                            },
                            {
                                "example_id": "61c73c16-f9b2-4433-9f97-80b969dca04b",
                                "sense_id": "4cac7349-18dc-304f-8dfe-f4fe342df16c",
                                "text": "Als Carmen ten slotte trakteerde ze het publiek op een heerlijk manmoedige Habanera: geen sensuele lokzang, maar astrante vrijheidsmuziek."
                            }
                        ]
                    }
                ],
