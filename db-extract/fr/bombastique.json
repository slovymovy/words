                        "examples": [
                            {
                                "example_id": "5c8e375a-7b52-412d-b3fc-60c4443f014b",
                                "sense_id": "65bddde2-f34f-37a2-889b-942a21877363",
                                "text": "La collection de ses œuvres [de Paracelse] plus ou moins authentique […] mélange de grossièreté et d’affectation, méritait pleinement par son style étrange de donner naissance à l’expression de style bombastique."
                            },
                            {
                                "example_id": "b7512646-496c-4b48-9deb-edb9afc3c8ab",
                                "sense_id": "65bddde2-f34f-37a2-889b-942a21877363",
                                "text": "Cette bombastique péroraison n’a pas manqué son effet."
                            }
                        ]
