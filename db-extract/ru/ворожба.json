                                    {
                                        "sense_id": "ee7ce244-fa1e-3644-b005-4c5dbdf814cc",
                                        "entry_id": "3d29a856-639c-3881-879f-94329fac9c72",
                                        "glosses": [
                                            "The act of divining; a foreseeing or foretelling of future events."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ca359fb4-d47e-325d-bb3f-ed397ac333cd",
                                        "entry_id": "3d29a856-639c-3881-879f-94329fac9c72",
                                        "glosses": [
                                            "The apparent art of discovering secrets or the future by preternatural means."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f36a91bc-1178-313f-ae58-1ec408d3d95d",
                                        "entry_id": "3d29a856-639c-3881-879f-94329fac9c72",
                                        "glosses": [
                                            "An indication of what is to come in the future or what is secret; a prediction."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4a545257-ce05-4a77-82dd-f2e61415757a",
                        "source_entry_id": "f3d0b1d0-b85c-3345-93f1-446f6ace4405",
                        "source_sense_id": "2f6cc741-4220-36b6-a688-b46fb566c732",
                        "target_lang_word": "sorcellerie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sorcellerie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "379cbc59-fcb4-3abe-9da8-b8576b75a612",
                                        "entry_id": "2f4a25d5-4647-3dfb-92b0-56f15b7d4536",
                                        "glosses": [
                                            "Art des sorciers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "726a90ec-1616-4c01-9ff2-f980083af20d",
                                                "sense_id": "379cbc59-fcb4-3abe-9da8-b8576b75a612",
                                                "text": "On vous dira que le diable seul a pu produire de telles pierres, et l’on vous intentera un procès en sorcellerie."
                                            },
                                            {
                                                "example_id": "3ce2d49a-b41b-473f-b1c0-4c0f16b4eacc",
                                                "sense_id": "379cbc59-fcb4-3abe-9da8-b8576b75a612",
                                                "text": "Comme Katrina Van Tassel, dans Sleepy Hollow, Mercredi possède un don de sorcellerie qu’elle a hérité de sa mère."
                                            },
                                            {
                                                "example_id": "1e6b1fb3-d755-4bd2-9415-9998b55ae908",
                                                "sense_id": "379cbc59-fcb4-3abe-9da8-b8576b75a612",
                                                "text": "Dans la logique mentale de leur temps, les magistrats l’accusent et la condamnent de « sorcellerie », crime pour lequel le bourreau l’énuque avec la « hart » de la potence (corde d’infamie)."
                                            },
                                            {
                                                "example_id": "e9644a58-bcc8-49da-aa57-eec850aa5432",
                                                "sense_id": "379cbc59-fcb4-3abe-9da8-b8576b75a612",
                                                "text": "« J’ai l’impression d’être entré dans une maison hantée de fête foraine. » Kara essuya ses yeux humides et regarda autour d’elle. La minuscule boutique était bourrée d’articles de sorcellerie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c83d2c89-834c-38f5-a246-f0431c161f13",
                                        "entry_id": "2f4a25d5-4647-3dfb-92b0-56f15b7d4536",
                                        "glosses": [
                                            "Pratiques des sorciers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f348c27a-5592-4671-9fb5-b1a690248f85",
                                                "sense_id": "c83d2c89-834c-38f5-a246-f0431c161f13",
                                                "text": "Leur pouvoir était illimité; ils guérissaient les malades abandonnés des médecins, rendaient fécondes les terres stériles, arrêtaient les épidémies de bestiaux, mais ils n’étaient point toujours d’humeur à ces sorcelleries bienfaisantes, et, plus volontiers, ils se servaient de leur puissance magique pour tourmenter les hommes et les bêtes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5f8e7c59-525a-4f80-87a1-78335ccec932",
                        "source_entry_id": "f3d0b1d0-b85c-3345-93f1-446f6ace4405",
                        "source_sense_id": "2f6cc741-4220-36b6-a688-b46fb566c732",
                        "target_lang_word": "divination",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "divination",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0ab87ff1-89cb-3e51-84e0-f23b5c9bbada",
                                        "entry_id": "4010e01c-2cc2-3bfc-84f7-0df3731f248f",
                                        "glosses": [
                                            "Art de deviner, de prédire l’avenir."
                                        ],
                                        "tags": [
                                            "Pseudo-sciences"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab171a34-d062-4676-83df-126670748177",
                                                "sense_id": "0ab87ff1-89cb-3e51-84e0-f23b5c9bbada",
                                                "text": "Eh bien! c'est un homme d'Hoffmann. Toute la vie, il a cherché à appliquer les cartes et les nombres à la divination de l'avenir; …."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "29d76f40-4eb7-3fb3-999d-d4b61ed1f6ef",
                                        "entry_id": "4010e01c-2cc2-3bfc-84f7-0df3731f248f",
                                        "glosses": [
                                            "Ensemble des moyens employés pour deviner et prédire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d68ad3f7-5542-477c-af68-d804bc9729c9",
                                                "sense_id": "29d76f40-4eb7-3fb3-999d-d4b61ed1f6ef",
                                                "text": "Précisément parce que la divination par les oiseaux était d'un usage universel et que chaque peuple la pratiquait pour son compte, l’auguration toscane n'a guère servi qu'aux Toscans eux-mêmes."
                                            },
                                            {
                                                "example_id": "def62cfd-c137-4383-a23b-a69130d87dfb",
                                                "sense_id": "29d76f40-4eb7-3fb3-999d-d4b61ed1f6ef",
                                                "text": "— Descartes, c'est le type qui a mis au point la divination par le tarot, non ? Je connais un gars, Jasper, qui est du genre à y croire dur comme fer mais, pour être franche, je doute un peu que le tarot permette d'accéder à la vérité éternelle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32ffe9ee-125b-3066-ae53-0d761b06feb2",
                                        "entry_id": "4010e01c-2cc2-3bfc-84f7-0df3731f248f",
                                        "glosses": [
                                            "Dans la recherche, sagacité permettant de retrouver des choses cachées pour lesquelles la logique seule ne suffit pas ; intuition."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "02d3a91a-a51c-46e1-89ca-68536a10316b",
                                                "sense_id": "32ffe9ee-125b-3066-ae53-0d761b06feb2",
                                                "text": "C’est par une véritable divination qu’on a retrouvé le sens de plusieurs langues anciennes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "10bf8c5c-79b7-486f-8dd1-d0610d8b8079",
                        "source_entry_id": "f3d0b1d0-b85c-3345-93f1-446f6ace4405",
                        "source_sense_id": "2f6cc741-4220-36b6-a688-b46fb566c732",
                        "target_lang_word": "voyance",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "voyance",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5bdd7eb2-3142-3ae4-af88-f7150bbf2888",
                                        "entry_id": "b09b500c-d23c-384c-94ed-6a0882709bcb",
                                        "glosses": [
                                            "Capacité à obtenir une information par des méthodes qui s’affranchissent des lois de la nature habituellement reconnues, comme les limites de temps et d’espace."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "358cb62f-7962-4588-9de3-f97ce84a28c3",
                                                "sense_id": "5bdd7eb2-3142-3ae4-af88-f7150bbf2888",
                                                "text": "Il n'y a pas de publicité vantant les talents de voyance d'une quelconque Ange-Marie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
