                        ],
                        "examples": [
                            {
                                "example_id": "ec7c10a1-69af-4aae-a5e7-bc061228341c",
                                "sense_id": "105ae72d-34ea-367b-9435-64fd5d46b241",
                                "text": "Dzwonny szmer ponika wyrywa się z łożyska, chcąc się do zabawy przyłączyć, lecz żywe jego wody, porozdzierane przez głazy na liczne strumienie, muszą uciekać, uciekać w dolinę"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
