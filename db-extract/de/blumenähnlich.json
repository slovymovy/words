                ],
                "senses": [
                    {
                        "sense_id": "317f9798-849b-3a5e-af6d-519bc3654718",
                        "entry_id": "2dd385e4-8345-364a-962a-732cb5799194",
                        "glosses": [
                            "wie eine Blume (aussehend); einer Blume ähnelnd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c319632-1a42-4a52-b0bc-f706a688437f",
                                "sense_id": "317f9798-849b-3a5e-af6d-519bc3654718",
                                "text": "„Nebenher dient ein Blumenkelch zur Andeutung blumiger Wiesen; blumenähnlich ist auch die Mündung des Griffes verziert.“"
                            },
                            {
                                "example_id": "df536cb4-1dcd-4ff2-97b4-cd04077763ba",
                                "sense_id": "317f9798-849b-3a5e-af6d-519bc3654718",
                                "text": "„Aber in ihm gelingt das zähe, blumenähnliche Gemüse im Nu zart und wohlschmeckend.“"
                            },
                            {
                                "example_id": "0d467083-e84a-4d2b-af1f-8d64a3a4a8cf",
                                "sense_id": "317f9798-849b-3a5e-af6d-519bc3654718",
                                "text": "„Doch lag auch Besorgnis in ihrem Blick auf ihre Töchter, die darin vertieft waren, Sterne und blumenähnliche Formen aus den Waffeln herauszuknabbern.“"
                            },
                            {
                                "example_id": "a3e11d43-8837-4714-82d6-cf52f20e5a04",
                                "sense_id": "317f9798-849b-3a5e-af6d-519bc3654718",
                                "text": "„Sein Geruch ist angenehm blumenähnlich, sein Geschmack brennend.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
