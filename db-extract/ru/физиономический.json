                                    {
                                        "sense_id": "68aa36ee-e0f5-371d-8c78-44eaa2fee2ed",
                                        "entry_id": "306c8db8-bd9c-39c4-b02c-4faeb784da07",
                                        "glosses": [
                                            "Of or pertaining to physiognomy."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7694d1ab-4adb-4a1d-b173-63dd5bbab417",
                                                "sense_id": "68aa36ee-e0f5-371d-8c78-44eaa2fee2ed",
                                                "text": "While they are not saying “yippee, look what AI can do” (in fact, some say they are trying to highlight risks), by publishing in scientific journals, they are risking lending credibility to the very idea of using AI in problematic, physiognomic ways."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4d1cdfa4-ffc4-4273-9956-5ef31a42fae5",
                        "source_entry_id": "df5668d8-e7fe-374b-8f82-aaf9748a45e5",
                        "source_sense_id": "50413299-0d82-3f6a-b7e6-a055238a2183",
                        "target_lang_word": "physiognomisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "physiognomisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "04c10e6a-73fc-3eeb-9d91-8a3952b24b5a",
                                        "entry_id": "5d1c26d2-4488-3179-b75b-203f294ef44b",
                                        "glosses": [
                                            "die Physiognomie betreffend"
                                        ],
                                        "tags": [
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06bd00e4-ef20-4ff3-9499-654032b952e4",
                                                "sense_id": "04c10e6a-73fc-3eeb-9d91-8a3952b24b5a",
                                                "text": "Eine physiognomische Analyse begnügt sich jedoch nicht mit einer Untersuchung des Bildmaterials. Die Autorin liefert vielmehr eine umfassende Studie zu Augen- und Ohrenzeugenberichten über das „Phänomen Hitler“."
                                            },
                                            {
                                                "example_id": "fd7dd163-ef38-4204-8510-aaf5d6f5a3a3",
                                                "sense_id": "04c10e6a-73fc-3eeb-9d91-8a3952b24b5a",
                                                "text": "Claudia Schmölders läßt ihre physiognomische Biographie jedoch nicht mit Hitlers Tod enden, sondern geht weiter."
                                            },
                                            {
                                                "example_id": "7799c95c-be00-4bc6-8bb7-ed66f0e00e4d",
                                                "sense_id": "04c10e6a-73fc-3eeb-9d91-8a3952b24b5a",
                                                "text": "Wenn in den Gesichtsmuskeln weder eine mimische noch physiognomische Spannung sich geltend macht, so ist die Mundlinie wellenförmig geschwungen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "03134bec-ac28-41d5-9c56-db0d0b596189",
