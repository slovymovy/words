                        "entry_id": "2fdf524e-e01f-358f-b836-151333ce11f0",
                        "glosses": [
                            "Fähigkeit, (bestimmte) Farbstoffe aufzunehmen oder zu absorbieren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90f2bf1f-91ce-40d1-95dd-fb7b2a2b5329",
                                "sense_id": "f9fc8894-e8bb-3473-9455-72660686efaf",
                                "text": "„Dacron wird auch als Copolyester mit Isophthalsäure zur Erzielung eines kontrollierten Schrumpfverhaltens, zur Verminderung des Pilling und zur Verbesserung der Anfärbbarkeit hergestellt.“"
                            }
                        ],
