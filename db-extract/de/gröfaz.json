                ],
                "senses": [
                    {
                        "sense_id": "838943b8-c0c8-3742-9e96-0d3558551a39",
                        "entry_id": "91a78637-061b-3bd0-8e90-7ae2467c2a61",
                        "glosses": [
                            "spöttische Bezeichnung Adolf Hitlers"
                        ],
                        "tags": [
                            "nur Singular"
                        ],
                        "examples": [
                            {
                                "example_id": "de1ae0b7-b8cf-4f8e-9637-93732fbdb19d",
                                "sense_id": "838943b8-c0c8-3742-9e96-0d3558551a39",
                                "text": "„Als Morgengabe hatte Großadmiral Dönitz noch eine Ergebenheitsadresse an den Gröfaz sowie eine Ladung frischer, dem Tode geweihter, weil für den Häuserkampf unausgebildeter Rekruten der Marine nach Berlin geschickt.“"
                            },
                            {
                                "example_id": "6a390d98-dd1f-40c8-acb9-44a4a5e77f3d",
                                "sense_id": "838943b8-c0c8-3742-9e96-0d3558551a39",
                                "text": "„Über den Reichsjägermeister Göring lacht auch keiner – und über den Gröfaz erst recht nicht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "dbbf58cb-c540-3dc2-9d8a-a15afebb1111",
                        "entry_id": "91a78637-061b-3bd0-8e90-7ae2467c2a61",
                        "glosses": [
                            "Person, die man mit Hitler gleichstellen möchte"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "b0825727-202b-4cce-87aa-1ffb7a215c69",
                                "sense_id": "dbbf58cb-c540-3dc2-9d8a-a15afebb1111",
                                "text": "„Die überkompensierende Hybris der ‚Gröfaze‘ nach 1918 bzw. 1933 ist das eine, das andere, dass – nicht erst seit Stalingrad – Hagen aus Siegfrieds Schatten tritt und jetzt die Weltbühne massenmörderisch beherrscht: […]“"
                            },
                            {
                                "example_id": "1a05164e-e4f4-4b45-afba-b783d7fad634",
                                "sense_id": "dbbf58cb-c540-3dc2-9d8a-a15afebb1111",
                                "text": "„Nicht einer der Täter, die er konfrontiert, erscheint Garton Ash als das personifizierte Böse. Keine kleinen Gröfaze, nur ganz gewöhnliche Gestalten, deren Beweggründe und Rechtfertigungen nicht aus dem Kompendium der Unmenschlichkeit, sondern aus dem endlosen Katalog menschlicher Korrumpierbarkeit stammen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
