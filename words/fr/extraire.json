                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "chimie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce laboratoire utilise une méthode moderne pour <w>extraire</w> l'huile essentielle de lavande.",
                            "target_lang_translations": {
                                "en": "This laboratory uses a modern method to <w>extract</w> the essential oil from lavender.",
                                "ru": "Эта лаборатория применяет современный метод, чтобы <w>извлечь</w> эфирное масло лаванды.",
                                "de": "Dieses Labor verwendet ein modernes Verfahren, um ätherisches Lavendelöl zu <w>extrahieren</w>.",
                                "es": "Este laboratorio utiliza un método moderno para <w>extraer</w> el aceite esencial de lavanda.",
                                "zh": "这家实验室采用一种现代方法来<w>提取</w>薰衣草精油。"
