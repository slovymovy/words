                        "examples": [
                            {
                                "example_id": "e2a064ee-4f30-4061-b392-262167027eab",
                                "sense_id": "a607a130-ddb9-363b-8821-e868deb1f955",
                                "text": "Die Hanseaten treffen sich nächste Woche zu einer Sitzung."
                            },
                            {
                                "example_id": "4107870d-cc0c-401b-8dd7-3a6e2ab1831c",
                                "sense_id": "a607a130-ddb9-363b-8821-e868deb1f955",
                                "text": "„Überhaupt kann man ostdeutsche von westdeutschen Hanseaten nur an sprachlichen Nuancen unterscheiden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "8b35c543-f3b9-3124-9551-5bf7782297b6",
