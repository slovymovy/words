                {
                    "sense_id": "3ee8a37d-a747-3145-a881-fbb5754d59fa",
                    "sense_definition": "Сомнительное предприятие, нечестное заведение или нелегальное дело.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "scheme",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Полиция быстро приехала и прикрыла эту нелегальную <w>лавочку</w>.",
                            "target_lang_translations": {
                                "en": "The police arrived quickly and shut down this illegal <w>operation</w>.",
                                "es": "La policía llegó rápidamente y cerró ese <w>chiringuito</w> ilegal.",
                                "fr": "La police est rapidement arrivée et a fermé cette <w>boutique</w> illégale."
                            }
                        },
                        {
                            "text": "Директор пообещал закрыть <w>лавочку</w>, если сотрудники продолжат нарушать рабочие правила.",
                            "target_lang_translations": {
                                "en": "The director promised to shut down the whole <w>racket</w> if the employees kept breaking company rules.",
                                "es": "El director prometió cerrar el <w>chiringuito</w> si los empleados continúan infringiendo las normas laborales.",
                                "fr": "Le directeur a promis de fermer la <w>boîte</w> si les employés continuaient à enfreindre le règlement intérieur."
                            }
                        }
                    ],
                    "synonyms": [
                        "контора",
                        "афёра"
                    ],
                    "common_phrases": [
                        "закрыть лавочку",
                        "прикрыть лавочку"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорно-сниженное"
                        }
                    ],
                    "target_lang_definitions": {
