{
    "word_family": [
        "лещевый",
        "лещовый",
        "лещевина"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f573bfd5-06d0-3523-afd7-62f1766c109a",
                    "sense_definition": "Пресноводная рыба семейства карповых с высоким, сжатым с боков телом.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "рыба",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ранним утром опытный рыбак поймал в реке крупного серебристого <w>леща</w>.",
                            "target_lang_translations": {
                                "en": "Early in the morning, an experienced fisherman caught a large silvery <w>bream</w> in the river."
                            }
                        },
                        {
                            "text": "В чистых и спокойных водах этого озера обычно водится речной <w>лещ</w>.",
                            "target_lang_translations": {
                                "en": "In the clear and calm waters of this lake, river <w>bream</w> are usually found."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ловить леща",
                        "речной лещ",
                        "копчёный лещ"
                    ],
                    "target_lang_definitions": {
                        "en": "A freshwater fish of the carp family with a deep, laterally compressed body."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bream",
                                "target_lang_sense_clarification": "freshwater fish"
                            },
                            {
                                "target_lang_word": "common bream",
                                "target_lang_sense_clarification": "Abramis brama"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "33c5f35c-c895-3555-a939-9bd1e16eb7a3",
                    "sense_definition": "Шлепок, затрещина, удар ладонью по затылку или лицу.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "удар",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "За дерзкие и обидные слова старший брат отвесил хулигану увесистого <w>леща</w>.",
                            "target_lang_translations": {
                                "en": "For the insolent and offensive words, the older brother gave the bully a heavy <w>slap</w>."
                            }
                        },
                        {
                            "text": "Отец разозлился не на шутку и смачно дал непослушному сыну звонкого <w>леща</w>.",
                            "target_lang_translations": {
                                "en": "The father got seriously angry and gave his disobedient son a resounding <w>cuff round the ear</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "затрещина",
                        "подзатыльник",
                        "оплеуха",
                        "тумак"
                    ],
                    "common_phrases": [
                        "дать леща",
                        "отвесить леща",
                        "получить леща"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорное выражение удара или пощёчины"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A slap, cuff, or blow delivered with the palm to the face or the back of the head."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "slap",
                                "target_lang_sense_clarification": "blow with an open hand"
                            },
                            {
                                "target_lang_word": "cuff",
                                "target_lang_sense_clarification": "blow with the hand, often to the head"
                            },
                            {
                                "target_lang_word": "clip round the ear",
                                "target_lang_sense_clarification": "informal blow to the head"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "174eba05-ef55-38aa-9167-e1221742b34b",
                    "sense_definition": "Мясо такой рыбы как кулинарный продукт или блюдо из него.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "рыба",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "К праздничному обеду бабушка приготовила вкусного запечённого <w>леща</w> с кашей и луком.",
                            "target_lang_translations": {
                                "en": "For the festive dinner, grandmother prepared delicious baked <w>bream</w> with porridge and onions."
                            }
                        },
                        {
                            "text": "На прилавке рыбного магазина лежал свежий вяленый <w>лещ</w> отличного качества.",
                            "target_lang_translations": {
                                "en": "On the counter of the fish shop lay fresh dried <w>bream</w> of excellent quality."
                            }
                        }
                    ],
                    "common_phrases": [
                        "жареный лещ",
                        "запечённый лещ",
                        "вяленый лещ"
                    ],
                    "target_lang_definitions": {
                        "en": "The meat of a bream as food or a culinary dish prepared from it."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bream",
                                "target_lang_sense_clarification": "meat of the fish as food"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ce2a8bdb-843d-3e52-aa45-9687368c45c4",
                    "sense_definition": "Человек, находящийся в состоянии сильного алкогольного опьянения.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "У подъезда шатался какой-то пьяный <w>лещ</w>, громко выкрикивая бессвязные ругательства.",
                            "target_lang_translations": {
                                "en": "Some drunken <w>wino</w> was staggering near the entrance, loudly shouting incoherent curses."
                            }
                        },
                        {
                            "text": "Милицейский патруль быстро подобрал на темной аллее бесчувственного <w>леща</w>.",
                            "target_lang_translations": {
                                "en": "The police patrol quickly picked up the unconscious <w>drunkard</w> on the dark alleyway."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "криминальный жаргон"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A person in a state of severe alcohol intoxication."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "drunkard",
                                "target_lang_sense_clarification": "intoxicated person"
                            },
                            {
                                "target_lang_word": "wino",
                                "target_lang_sense_clarification": "slang for a drunk person"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}