                                        "examples": [
                                            {
                                                "example_id": "c56f816e-36b0-49ac-9f62-eae4c606648d",
                                                "sense_id": "6315612d-e0c2-3139-a972-da3fd1bc30cd",
                                                "text": "Ein Baiser krümelt beim Abbeißen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Baiser",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f8834a9e-87a3-37a0-80d0-482ce488214e",
                                        "entry_id": "9d3d5e02-26ea-38e7-be5d-bb8fb2653ab1",
                                        "glosses": [
                                            "ein männlicher Vorname aus Nordfriesland"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69e3c9d0-0dca-443b-a5a5-c31788bf6836",
                                                "sense_id": "f8834a9e-87a3-37a0-80d0-482ce488214e",
                                                "text": "Baiser sucht immer noch einen Mitbewohner, der täglich das Bad reinigt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aed8257f-1d66-4df3-8997-2ca22287347f",
                        "source_entry_id": "10a87d75-a0f9-39d2-bb90-cbc0029c0c06",
                        "source_sense_id": "d8b79957-d8b2-30da-92a7-22902efeb04b",
                        "target_lang_word": "безе",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "безе",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "cf8e6731-abcb-35fb-8c40-1e52a28003cf",
                                        "entry_id": "8406939d-34ad-3495-b305-e30470106b07",
                                        "glosses": [
                                            "кулин. десерт из взбитых с сахаром и запечённых яичных белков"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1776a5e7-0e71-4a6f-833b-a2d99e3352d3",
                                                "sense_id": "cf8e6731-abcb-35fb-8c40-1e52a28003cf",
                                                "text": "Ибрагим в кухне белки сбивал, к пасхе желает пирожное устроить, совсем по-городскому, называется — безе."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a721536-4fc2-37f6-bef1-1f1b2c0da2a7",
                                        "entry_id": "8406939d-34ad-3495-b305-e30470106b07",
                                        "glosses": [
                                            "устар. поцелуй"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4fcceda6-5b07-4505-b571-2eb66b4eeed2",
                                                "sense_id": "3a721536-4fc2-37f6-bef1-1f1b2c0da2a7",
                                                "text": "Позволь, душа, я тебе влеплю один безе. Уж вы позвольте, ваше превосходительство, поцеловать мне его. Да, Чичиков, уж ты не противься, одну безешку позволь напечатлеть тебе в белоснежную щеку твою! Ноздрёв был так оттолкнут с своими безе, что чуть не полетел на землю: от него все отступились и не слушали больше…"
                                            },
                                            {
                                                "example_id": "1eede9d4-3e2a-4a8c-a9dc-cc861e0cee38",
                                                "sense_id": "3a721536-4fc2-37f6-bef1-1f1b2c0da2a7",
                                                "text": "Члены комиссии: два брата Зуботыкины, один Недотыкин и один Перетыкин выступают вперёд. Их поочерёдно целуют, но самые сладкие безе, конечно, достаются на долю Недотыкина…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
