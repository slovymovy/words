{
    "word_family": [
        "overstatement",
        "understate",
        "statement",
        "state"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1a781dd2-149a-33b2-8763-11f378c3627b",
                    "sense_definition": "To describe something in a way that makes it seem more important, serious, or great than it actually is.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "exaggeration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is easy to <w>overstate</w> the importance of this minor event in the history of the company.",
                            "target_lang_translations": {
                                "ru": "Легко <w>преувеличить</w> важность этого незначительного события в истории компании.",
                                "zh": "人们很容易<w>夸大</w>这起小事件在公司历史上的重要性。"
                            }
                        },
                        {
                            "text": "The politician was careful not to <w>overstate</w> his case during the televised debate.",
                            "target_lang_translations": {
                                "ru": "Политик старался не <w>преувеличивать</w> убедительность своих доводов во время теледебатов.",
                                "zh": "这位政客在电视辩论中很谨慎，避免<w>夸大</w>自己的论点。"
                            }
                        }
                    ],
                    "synonyms": [
                        "exaggerate",
                        "overdo"
                    ],
                    "antonyms": [
                        "understate"
                    ],
                    "common_phrases": [
                        "overstate his case",
                        "hard to overstate",
                        "overstate the importance",
                        "overstate the impact"
                    ],
                    "target_lang_definitions": {
                        "ru": "Описывать что-либо таким образом, чтобы оно казалось более важным, серьезным или значительным, чем есть на самом деле.",
                        "zh": "把某事描述得比实际情况更重要、严重或夸大其词；夸大。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "преувеличивать",
                                "target_lang_sense_clarification": "делать что-то более значимым в описании"
                            },
                            {
                                "target_lang_word": "завышать",
                                "target_lang_sense_clarification": "оценку или значимость"
                            },
                            {
                                "target_lang_word": "переоценивать",
                                "target_lang_sense_clarification": "придавать слишком большое значение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "夸大",
                                "target_lang_sense_clarification": "夸大重要性或程度"
                            },
                            {
                                "target_lang_word": "过分强调",
                                "target_lang_sense_clarification": "过度重视或强调"
                            },
                            {
                                "target_lang_word": "夸张",
                                "target_lang_sense_clarification": "言过其实地描述"
                            }
                        ]
                    }
                }
