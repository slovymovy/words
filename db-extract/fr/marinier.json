                                "target_senses": [
                                    {
                                        "sense_id": "efe08d17-5fdf-382c-9b46-7ff30c02a23a",
                                        "entry_id": "9200fde7-42e6-35d3-bf13-eb435b6a8d30",
                                        "glosses": [
                                            "A member of the crew of a barge."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a09322ca-1856-4ef3-a835-c91c36071f49",
                                                "sense_id": "efe08d17-5fdf-382c-9b46-7ff30c02a23a",
                                                "text": "Though Hambleden's parish register records the death, in 1753, of a bargeman 'Kill'd by accident, shooting ye lock', the turbulent waters of Mill End weir on the River Thames, about a mile from the village, still attract canoeists."
                                            },
                                            {
                                                "example_id": "0ca3cdde-e910-4016-96a7-e6654aea30dd",
                                                "sense_id": "efe08d17-5fdf-382c-9b46-7ff30c02a23a",
                                                "text": "Laurie still has Sam's work log from 1919–1934, a fifty-page volume documenting Sam's day-to-day experiences and serves well to show the kind of working conditions an Ouse bargeman endured in the 1920s."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9beda3df-fbf1-3013-a206-ca3af71baa92",
                                        "entry_id": "9200fde7-42e6-35d3-bf13-eb435b6a8d30",
                                        "glosses": [
                                            "A barge owner, maintainer, or captain of a barge."
                                        ],
