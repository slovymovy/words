                ],
                "senses": [
                    {
                        "sense_id": "f8fe47f7-61f4-3d9b-a114-92e3ba8191a0",
                        "entry_id": "5c7f4e4d-f884-34cb-a28a-99731c803713",
                        "glosses": [
                            "spielerische Rauferei"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ea3adb7-4162-4ddb-9cf1-083c530deabb",
                                "sense_id": "f8fe47f7-61f4-3d9b-a114-92e3ba8191a0",
                                "text": "Bei der Balgerei ging seine Brille zu Bruch."
                            },
                            {
                                "example_id": "fec0bd0b-1960-461e-be42-d06ad65d5b66",
                                "sense_id": "f8fe47f7-61f4-3d9b-a114-92e3ba8191a0",
                                "text": "„Lange spannten sie mich nicht auf die Folter, und bald begann die Balgerei, Toberei und Spielerei von Neuem.“"
                            },
                            {
                                "example_id": "15982470-cf29-4c69-8d42-f25b2055645b",
                                "sense_id": "f8fe47f7-61f4-3d9b-a114-92e3ba8191a0",
                                "text": "„An die Balgerei, die er mit dem Landstreicher gehabt hatte, mochte ich gar nicht denken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cf705f7f-1cf7-4ae3-8e3d-ffc0afaea3ab",
                        "source_entry_id": "5c7f4e4d-f884-34cb-a28a-99731c803713",
                        "source_sense_id": "f8fe47f7-61f4-3d9b-a114-92e3ba8191a0",
                        "source_sense_description": "spielerische Rauferei",
                        "target_lang_word": "scrap",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "scrap",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e256e1f3-9166-3d7d-b35c-d390f235fee6",
                                        "entry_id": "f54716c1-3351-3c37-a1be-369fc27185b5",
                                        "glosses": [
                                            "A (small) piece; a fragment; a detached, incomplete portion."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e979d3eb-9219-4109-90d8-f695021f8339",
                                                "sense_id": "e256e1f3-9166-3d7d-b35c-d390f235fee6",
                                                "text": "I found a scrap of cloth to patch the hole."
                                            },
                                            {
                                                "example_id": "148147a5-b069-407f-8b8c-8f718f4d0757",
                                                "sense_id": "e256e1f3-9166-3d7d-b35c-d390f235fee6",
                                                "text": "I have no materials — not a scrap."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c3a0fa1-57b2-3ea5-8e80-ae1c77eb1cc5",
                                        "entry_id": "f54716c1-3351-3c37-a1be-369fc27185b5",
                                        "glosses": [
                                            "A (small) piece; a fragment; a detached, incomplete portion.",
                                            "The smallest amount."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7da2460d-35b4-481d-90ef-83f0da492ad2",
                                                "sense_id": "5c3a0fa1-57b2-3ea5-8e80-ae1c77eb1cc5",
                                                "text": "I don't care a scrap."
                                            },
                                            {
                                                "example_id": "1441a70a-d77c-43d8-8dca-cc71f2d82635",
                                                "sense_id": "5c3a0fa1-57b2-3ea5-8e80-ae1c77eb1cc5",
                                                "text": "“I don't mind anything. I don't mind your being technically German a scrap. All I think is that it was a little—well, perhaps a little excessive to marry another German when you had done it once already. […]”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "04fc14db-fcb5-36f7-8739-efd733427126",
                                        "entry_id": "f54716c1-3351-3c37-a1be-369fc27185b5",
                                        "glosses": [
                                            "Leftover food."
                                        ],
                                        "tags": [
                                            "countable",
                                            "plural-normally",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fcd939a7-f913-4e85-b4b9-510e3bb812bf",
                                                "sense_id": "04fc14db-fcb5-36f7-8739-efd733427126",
                                                "text": "Give the scraps to the animals: any meat to the dogs, and the rest to the hogs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "853744c3-5195-38ab-96a2-5625a9d0eccd",
                                        "entry_id": "f54716c1-3351-3c37-a1be-369fc27185b5",
                                        "glosses": [
                                            "The crisp substance that remains after drying out animal fat."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6c291f76-2895-476c-b2c9-8ff341593dbc",
                                                "sense_id": "853744c3-5195-38ab-96a2-5625a9d0eccd",
                                                "text": "pork scraps"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2575539d-0375-3906-bc6a-4b31ab7b7704",
                                        "entry_id": "f54716c1-3351-3c37-a1be-369fc27185b5",
                                        "glosses": [
                                            "Discarded objects (especially metal) that may be dismantled to recover their constituent materials, junk."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7cc338bb-90aa-431e-a438-77b97cc258a0",
                                                "sense_id": "2575539d-0375-3906-bc6a-4b31ab7b7704",
                                                "text": "That car isn't good for anything but scrap."
                                            },
                                            {
                                                "example_id": "21a10f99-2c2a-4555-90b7-ee20091d04f5",
                                                "sense_id": "2575539d-0375-3906-bc6a-4b31ab7b7704",
                                                "text": "“We need a set of wheels to carry out this plan of yours.”\n“Queenie?”\n“We need her now more than ever.”\n“Will she still be in the field where we left her?”\n“No, no, no. The fuzz will have towed her away by now.”\n“Where will she be, then?”\n“They will have sold the old girl off for scrap.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43a914ee-01fe-3a3e-856b-d0296abf7f6b",
                                        "entry_id": "f54716c1-3351-3c37-a1be-369fc27185b5",
                                        "glosses": [
                                            "A piece of deep-fried batter left over from frying fish, sometimes sold with chips."
                                        ],
                                        "tags": [
                                            "UK",
                                            "countable",
                                            "in-plural",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0e9260bd-fbca-3ee6-ac76-169d5f404e95",
                                        "entry_id": "f54716c1-3351-3c37-a1be-369fc27185b5",
                                        "glosses": [
                                            "Loose-leaf tobacco of a low grade, such as sweepings left over from handling higher grades."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
