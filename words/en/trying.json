                {
                    "sense_id": "8910db44-ccc4-3753-9d3e-684d536cb59e",
                    "sense_definition": "Causing annoyance, irritation, or stress; hard to tolerate.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "difficult_annoying",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His constant complaints can be very <w>trying</w> for everyone in the office.",
                            "target_lang_translations": {
                                "ru": "Его постоянные жалобы могут быть очень <w>утомительными</w> для всех в офисе.",
                                "pl": "Jego ciągłe narzekanie może być bardzo <w>męczące</w> dla wszystkich w biurze."
                            }
                        },
                        {
                            "text": "She found his rude behavior increasingly <w>trying</w>.",
                            "target_lang_translations": {
                                "ru": "Его грубое поведение казалось ей всё более <w>невыносимым</w>.",
                                "pl": "Uważała jego niegrzeczne zachowanie za coraz bardziej <w>nieznośne</w>."
                            }
                        }
