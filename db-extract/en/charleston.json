                        "examples": [
                            {
                                "example_id": "7b9a6e2e-8622-4734-8b83-90753b357e9d",
                                "sense_id": "0ee39fe5-50d4-3100-801f-71a99db6b7c7",
                                "text": "The Cambridge professor was charlestoning madly with a well-built woman in a backless evening dress; there were dark patches under his arms where the sweat had soaked through his suit."
                            },
                            {
                                "example_id": "6d315ef3-b346-4d5d-8874-fa41ccfe5efa",
                                "sense_id": "0ee39fe5-50d4-3100-801f-71a99db6b7c7",
                                "text": "[…] in the Jazz Age she shook, shimmied and charlestoned whilst men just ogled."
                            }
                        ]
                    }
