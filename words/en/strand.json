    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "788aca8d-ea1d-3c98-816e-6e823c4cdc0a",
                    "sense_definition": "An individual length of any fine, string-like substance.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "string_like",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She carefully brushed a single <w>strand</w> of hair away from her face.",
                            "target_lang_translations": {
                                "ru": "Она осторожно убрала с лица одну <w>прядь</w> волос.",
                                "de": "Sie strich sich vorsichtig eine einzelne <w>Strähne</w> aus dem Gesicht.",
                                "tr": "Yüzünden tek bir saç <w>telini</w> dikkatlice kenara çekti.",
                                "zh": "她小心地把脸前的一<w>缕</w>头发拨开。"
                            }
                        },
                        {
                            "text": "The chef served a long <w>strand</w> of spaghetti to test if it was cooked.",
                            "target_lang_translations": {
                                "ru": "Шеф-повар подал длинную <w>нитку</w> спагетти, чтобы проверить, готова ли она.",
                                "de": "Der Koch servierte einen langen <w>Faden</w> Spaghetti, um zu prüfen, ob sie gar waren.",
                                "tr": "Şef, pişip pişmediğini kontrol etmek için uzun bir spagetti <w>teli</w> servis etti.",
                                "zh": "厨师夹起一<w>根</w>长长的意大利面，看看有没有煮熟。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "strand of hair",
                        "strand of spaghetti"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отдельная нить или волокно любого тонкого, похожего на веревку вещества.",
                        "de": "Ein einzelner, dünner, fadenartiger Teil einer Substanz.",
                        "tr": "Herhangi bir ince, ip benzeri maddenin tek bir parçası.",
                        "zh": "细而像线的物质中的单独一根。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прядь",
                                "target_lang_sense_clarification": "волос"
                            },
                            {
                                "target_lang_word": "нитка",
                                "target_lang_sense_clarification": "спагетти или тонкое волокно"
                            },
                            {
