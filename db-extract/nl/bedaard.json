                    }
                ],
                "senses": [
                    {
                        "sense_id": "8af77d73-9c34-36b7-9fbd-39b6e1ccbed2",
                        "entry_id": "2c7034a9-c73f-3208-81d8-577d9d57e80c",
                        "glosses": [
                            "rustig, kalm"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f45c7ef-6d36-4a83-8b86-6f59ce7d3e67",
                                "sense_id": "8af77d73-9c34-36b7-9fbd-39b6e1ccbed2",
                                "text": "Diplomaten zijn altijd zulke bedaarde mensen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "06df0f60-a54d-4e5a-8d57-de679351bbc7",
                        "source_entry_id": "2c7034a9-c73f-3208-81d8-577d9d57e80c",
                        "source_sense_id": "8af77d73-9c34-36b7-9fbd-39b6e1ccbed2",
                        "source_sense_description": "rustig, kalm",
                        "target_lang_word": "sedate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sedate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "be6b7b11-9106-3477-8109-4cef1002a465",
                                        "entry_id": "d9a1b0ae-92a1-3af6-b8a0-500a168339c3",
                                        "glosses": [
                                            "Remaining composed and dignified, and avoiding too much activity or excitement."
                                        ],
                                        "tags": [
                                            "of a person or their behaviour"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ee44f61-cb50-45fa-942b-8f367540da26",
                                                "sense_id": "be6b7b11-9106-3477-8109-4cef1002a465",
                                                "text": "[…] they will rashly huddle up all together, and not admitting the least check of a sedate judgement, publish onely the impetuous dictates of their indiscreet and too precipitant fancie […]"
                                            },
                                            {
                                                "example_id": "e7a0cd58-0dbc-47a6-8f55-4bac4444cb1c",
                                                "sense_id": "be6b7b11-9106-3477-8109-4cef1002a465",
                                                "text": "But who like thee can boast a Soul sedate, / So firmly Proof to all the Shocks of Fate?"
                                            },
                                            {
                                                "example_id": "20561254-7ac3-49c2-a3d7-b2bc71f89f90",
                                                "sense_id": "be6b7b11-9106-3477-8109-4cef1002a465",
                                                "text": "The animadverſions of critics are commonly ſuch as may eaſily provoke the ſedateſt vvriter to ſome quickneſs of reſentment and aſperity of reply."
                                            },
                                            {
                                                "example_id": "202bb59b-7f66-49a7-901b-018bece27d89",
                                                "sense_id": "be6b7b11-9106-3477-8109-4cef1002a465",
                                                "text": "A reel or fling of some sort was in progress; and the usually sedate Farfrae was in the midst of the other dancers in the costume of a wild Highlander, flinging himself about and spinning to the tune."
                                            },
                                            {
                                                "example_id": "0ebc34b3-b9e9-4911-9069-79fbda3919ea",
                                                "sense_id": "be6b7b11-9106-3477-8109-4cef1002a465",
                                                "text": "Then she saw that they were waving their handkerchiefs; dipping them up and down, with a curiously sedate, formal motion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9cd613f-a05e-3f5c-85e6-9148c958feb7",
                                        "entry_id": "d9a1b0ae-92a1-3af6-b8a0-500a168339c3",
                                        "glosses": [
                                            "Not overly ornate or showy."
                                        ],
                                        "tags": [
                                            "of an object"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "718fc5b0-eefe-4398-baa5-68d49b6a7cc9",
                                                "sense_id": "f9cd613f-a05e-3f5c-85e6-9148c958feb7",
                                                "text": "Sometimes she passed down avenues of sedate mansions, soberly numbered ‘one’, ‘two’, ‘three’, and so on right up to two or three hundred, each the copy of the other, with two pillars and six steps and a pair of curtains neatly drawn […]"
                                            },
                                            {
                                                "example_id": "91fe6ea9-533c-4baa-b67a-56c41f83b607",
                                                "sense_id": "f9cd613f-a05e-3f5c-85e6-9148c958feb7",
                                                "text": "The shiny carriages of Yankee officers’ wives and newly rich Carpetbaggers splashed mud on the dilapidated buggies of the townspeople, and gaudy new homes of wealthy strangers crowded in among the sedate dwellings of older citizens."
                                            },
                                            {
                                                "example_id": "5f282447-3a7d-47eb-947a-87c1757cbfc0",
                                                "sense_id": "f9cd613f-a05e-3f5c-85e6-9148c958feb7",
                                                "text": "Facing the Parliament Buildings across James’ Bay arose a sedate stone and cement Post Office."
                                            },
                                            {
                                                "example_id": "8cdc9878-c4fd-488e-9d76-ab6b5737e2d4",
                                                "sense_id": "f9cd613f-a05e-3f5c-85e6-9148c958feb7",
                                                "text": "The great hotel, with its look of sedate luxury, brooded massively there with people teeming about it."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sedate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "da507b76-42ad-3997-a288-3ad252103092",
                                        "entry_id": "c042f76a-dafd-3596-9850-b25d44dfee22",
                                        "glosses": [
                                            "To calm or put (a person) to sleep using a sedative drug."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19b18c8e-a545-4408-ab37-bb92a1df2dac",
                                                "sense_id": "da507b76-42ad-3997-a288-3ad252103092",
                                                "text": "Though he may have been sedated, he knew I was there, knew who I was, knew I was talking to him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a080a619-72ef-3782-8583-538e8a9114f7",
                                        "entry_id": "c042f76a-dafd-3596-9850-b25d44dfee22",
                                        "glosses": [
                                            "To make tranquil."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dde12b64-69c7-4a3b-a880-2ba2ff2eeaa8",
                        "source_entry_id": "2c7034a9-c73f-3208-81d8-577d9d57e80c",
                        "source_sense_id": "8af77d73-9c34-36b7-9fbd-39b6e1ccbed2",
                        "source_sense_description": "rustig, kalm",
                        "target_lang_word": "sosegado",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sosegado",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "b79859f4-e7d5-3440-8225-8fa0356afb07",
                                        "entry_id": "6babb09e-bad8-3bac-983f-a93a42cbfb6f",
                                        "glosses": [
                                            "Quieto, tranquilo."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff9ef636-56e9-4f53-adb1-d122059a422a",
                                                "sense_id": "b79859f4-e7d5-3440-8225-8fa0356afb07",
                                                "text": "Que sosegadas, muy sosegadas, estén las tribus. Que perfectas, muy perfectas, sean las tribus. Que perfecta sea la vida, la existencia que nos dais, oh Maestro Gigante"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
