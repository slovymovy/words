                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "344c6669-57f5-4ffc-8f58-7b7731bc4322",
                        "entry_id": "640c185a-6ada-3662-b895-d67c0654f0d0",
                        "tags": [
                            "plural"
                        ],
                        "form": "prestidigitations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5c22df77-fd5c-3fd2-b1a6-0a3edd7e7b7f",
                        "entry_id": "640c185a-6ada-3662-b895-d67c0654f0d0",
                        "glosses": [
                            "Art du prestidigitateur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c46eced-3378-4923-ac78-64a6401f42e3",
                                "sense_id": "5c22df77-fd5c-3fd2-b1a6-0a3edd7e7b7f",
                                "text": "J’y pensais souvent, avec stupeur, et sur mes carnets je m’interrogeais ; il me semblait être dupe « d’un tour de prestidigitation dont le truc est enfantin, mais qu’on n’arrive pas à deviner »."
                            }
                        ]
                    },
                    {
                        "sense_id": "8ce47fc6-af93-3405-92fd-2267aa4a0b56",
                        "entry_id": "640c185a-6ada-3662-b895-d67c0654f0d0",
                        "glosses": [
                            "Grande dextérité manuelle."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "880c6486-1532-42bc-889f-e4158fefd3b9",
                                "sense_id": "8ce47fc6-af93-3405-92fd-2267aa4a0b56",
                                "text": "La prestidigitation de certaines courtisanes réussit des tours incompréhensibles..."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "849b80dd-9069-428d-9bdd-408a82b2773f",
                        "source_entry_id": "640c185a-6ada-3662-b895-d67c0654f0d0",
                        "target_lang_word": "Taschenspielerkunst",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "c0dfe4d2-9f89-4600-8378-7f99c7617393",
                        "source_entry_id": "640c185a-6ada-3662-b895-d67c0654f0d0",
                        "target_lang_word": "prestidigitation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prestidigitation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5b92a540-fcad-3742-b1e7-d3f2e8a6ab8f",
                                        "entry_id": "52ba94a0-6fa2-3112-9ded-66b61438e38b",
                                        "glosses": [
                                            "A performance of or skill in performing magic or conjuring tricks with the hands."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "48a14a99-380a-4474-83ac-749ba561b7b0",
                                                "sense_id": "5b92a540-fcad-3742-b1e7-d3f2e8a6ab8f",
                                                "text": "My favorite prestidigitation was when he pulled the live dove out of that tiny scarf."
                                            },
                                            {
                                                "example_id": "659c5af1-db0e-46d3-9428-0eae7a238ad1",
                                                "sense_id": "5b92a540-fcad-3742-b1e7-d3f2e8a6ab8f",
                                                "text": "He borrowed another hat and displayed its perfect emptiness; he held up his empty hands: \"This is one of the most marvellous bits of prestidigitation known,\" he said. \"You have all seen this hat holds nothing in the world: I will now see if I can extract anything from its emptiness. You can all observe my hands go nowhere but into the hat, and they are both open and turned to you. Yet what is this?\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3268f2a3-4e2d-3188-926c-07d3c28b6790",
                                        "entry_id": "52ba94a0-6fa2-3112-9ded-66b61438e38b",
                                        "glosses": [
                                            "A show of skill or deceitful cleverness."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7515de1d-ddd3-482a-9f0c-b69dc627dece",
                                                "sense_id": "3268f2a3-4e2d-3188-926c-07d3c28b6790",
                                                "text": "His writing was peppered with verbal tricks and prestidigitation."
                                            },
                                            {
                                                "example_id": "d4da7527-5c7f-4128-a63a-f869e4d2cb74",
                                                "sense_id": "3268f2a3-4e2d-3188-926c-07d3c28b6790",
                                                "text": "The more modest place became the picture better; yet, as my eyes grew accustomed to the half-light, all the characteristic qualities came out--all the hesitations disguised as audacities, the tricks of prestidigitation by which, with such consummate skill, he managed to divert attention from the real business of the picture to some pretty irrelevance of detail."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6c9a70eb-36ba-468f-8aab-79b4ebc90b21",
                        "source_entry_id": "640c185a-6ada-3662-b895-d67c0654f0d0",
                        "target_lang_word": "magic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "magic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2f87e12a-9b0c-3c6a-8ed8-3770d9f5a087",
                                        "entry_id": "222d6aab-6b64-3f90-8d14-d4857922c323",
                                        "glosses": [
                                            "The application of rituals or actions, especially those based on occult knowledge, to subdue or manipulate natural or supernatural beings and forces in order to have some benefit from them."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ad3bd2e-6c2d-465b-9238-a44ebc4fac15",
                                                "sense_id": "2f87e12a-9b0c-3c6a-8ed8-3770d9f5a087",
                                                "text": "“My magic will help you find true love,” said the witch as she looked for the right herbs in her collection."
                                            },
                                            {
                                                "example_id": "2082b4b7-7808-42f8-b69a-d54f9ae7f56a",
                                                "sense_id": "2f87e12a-9b0c-3c6a-8ed8-3770d9f5a087",
                                                "text": "And whan he shall be arrayed as I telle you / lete hym thenne doo his incantacyons & his magyke as he wyll […]."
                                            },
                                            {
                                                "example_id": "dbd67167-6f34-4d3d-9ba5-9407918a3001",
                                                "sense_id": "2f87e12a-9b0c-3c6a-8ed8-3770d9f5a087",
                                                "text": "But by what magique I, that here have ſtood / Four hunderd yeares (thou know’ſt how truly ſpoke), / Can now remove, think’ſt thou?"
                                            },
                                            {
                                                "example_id": "234cb8ff-36b9-4bda-8b0c-e48343c9f53f",
                                                "sense_id": "2f87e12a-9b0c-3c6a-8ed8-3770d9f5a087",
                                                "text": "The arts of magic and divination were strictly prohibited."
                                            },
                                            {
                                                "example_id": "1db28c89-57a3-4439-952d-d796cfb295df",
                                                "sense_id": "2f87e12a-9b0c-3c6a-8ed8-3770d9f5a087",
                                                "text": "Does not the very name stir the heart [...] with a thrill more mysterious and romantic than any allusion to the magics of Egypt or Hind?"
                                            },
                                            {
                                                "example_id": "606da9fd-f4e4-4611-9ccd-d04924d3d1f1",
                                                "sense_id": "2f87e12a-9b0c-3c6a-8ed8-3770d9f5a087",
                                                "text": "Conversions to the new religion […] have frequently been assisted by the view of converts that they are acquiring not just a means of otherworldly salvation, but a new and more powerful magic."
                                            },
                                            {
                                                "example_id": "ea345120-13a1-4bd7-a55d-336be1e77fba",
                                                "sense_id": "2f87e12a-9b0c-3c6a-8ed8-3770d9f5a087",
                                                "text": "Any sufficiently advanced technology is indistinguishable from magic."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e23259f-672b-348e-88cf-ac99e2ab0408",
                                        "entry_id": "222d6aab-6b64-3f90-8d14-d4857922c323",
                                        "glosses": [
                                            "The application of rituals or actions, especially those based on occult knowledge, to subdue or manipulate natural or supernatural beings and forces in order to have some benefit from them.",
                                            "The supernatural forces which are drawn on in such a ritual."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ff0a938b-4675-3bff-b8fe-3ae9a1fd8d23",
                                        "entry_id": "222d6aab-6b64-3f90-8d14-d4857922c323",
                                        "glosses": [
                                            "The application of rituals or actions, especially those based on occult knowledge, to subdue or manipulate natural or supernatural beings and forces in order to have some benefit from them.",
                                            "A specific ritual or procedure associated with such magic; a spell; a magical ability."
                                        ],
                                        "tags": [
                                            "countable",
                                            "rare",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "31950c4e-4e80-44c3-8449-c3ff1dd177e1",
                                                "sense_id": "ff0a938b-4675-3bff-b8fe-3ae9a1fd8d23",
                                                "text": "And she can turn people into stone and do all kinds of horrible things. And she has made a magic so that it is always winter in Narnia—always winter, but it never gets to Christmas."
                                            },
                                            {
                                                "example_id": "ea07969d-81db-47b3-8b02-57e0089192a6",
                                                "sense_id": "ff0a938b-4675-3bff-b8fe-3ae9a1fd8d23",
                                                "text": "\"I am the master of mighty magics.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0cb0ded2-11eb-3239-8e05-68e6befd190b",
                                        "entry_id": "222d6aab-6b64-3f90-8d14-d4857922c323",
                                        "glosses": [
                                            "The application of rituals or actions, especially those based on occult knowledge, to subdue or manipulate natural or supernatural beings and forces in order to have some benefit from them.",
                                            "The ability to cast a magic spell."
                                        ],
                                        "tags": [
                                            "countable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "43c5cf8e-47a5-49d2-8eec-7002e475860b",
                                                "sense_id": "0cb0ded2-11eb-3239-8e05-68e6befd190b",
                                                "text": "I learned a new magic after rescuing the tree fairy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "260918e9-56e1-3a49-8b99-695932ac3828",
                                        "entry_id": "222d6aab-6b64-3f90-8d14-d4857922c323",
                                        "glosses": [
                                            "Something producing successful and remarkable results, especially when not fully understood; an enchanting quality; exceptional skill."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "37f037b3-9525-4d74-9863-5c2b86330167",
                                                "sense_id": "260918e9-56e1-3a49-8b99-695932ac3828",
                                                "text": "The original family who had begun to build a palace to outrival Nonesuch had died out before they had put up little more than the gateway, so that the actual structure which had come down to posterity retained the secret magic of a promise rather than the overpowering splendour of a great architectural achievement."
                                            },
                                            {
                                                "example_id": "7e5af595-33e6-42b7-b5fe-8ed0c366e998",
                                                "sense_id": "260918e9-56e1-3a49-8b99-695932ac3828",
                                                "text": "We began to take Santa Claus to the kids at the isolated sidings for the same reason men all over Australia on the lines back o' beyond did [...] we didn't want them to miss that magic."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a7ef7ecc-2c07-3e45-8507-e474fc8131cb",
                                        "entry_id": "222d6aab-6b64-3f90-8d14-d4857922c323",
                                        "glosses": [
                                            "Something producing successful and remarkable results, especially when not fully understood; an enchanting quality; exceptional skill.",
                                            "Complicated or esoteric code that is not expected to be generally understood."
                                        ],
                                        "tags": [
                                            "slang",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "218571e9-b24f-46ca-a2d8-0bd63316057e",
                                                "sense_id": "a7ef7ecc-2c07-3e45-8507-e474fc8131cb",
                                                "text": "The stringstream class hides a lot of string parsing magic from us at this point."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3972f5d8-b8de-34de-b921-32a6014b2498",
                                        "entry_id": "222d6aab-6b64-3f90-8d14-d4857922c323",
