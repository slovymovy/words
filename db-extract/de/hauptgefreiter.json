                        ],
                        "examples": [
                            {
                                "example_id": "700f8f24-d26e-4b89-827e-ed7d3f4a90b8",
                                "sense_id": "a055b4cb-fd0e-330c-864e-88e1e70f9825",
                                "text": "„Hauptgefreiter Müller, machen Sie zehn Klimmzüge!“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "fc97546b-59c8-3317-9216-3e9e75f2fb6c",
                        "entry_id": "18c9f0f9-5675-3078-9498-aaa74165f0a6",
                        "glosses": [
                            "Person, die den Dienstgrad eines Hauptgefreiten innehat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f58374a8-07ed-469f-a2ca-7eff91d61c5b",
                                "sense_id": "fc97546b-59c8-3317-9216-3e9e75f2fb6c",
                                "text": "Der Hauptgefreite befahl ihm, zehn Liegestütze zu machen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9b5a8494-db4e-4315-bacd-6fbe02d2397d",
                        "source_entry_id": "18c9f0f9-5675-3078-9498-aaa74165f0a6",
                        "source_sense_id": "a055b4cb-fd0e-330c-864e-88e1e70f9825",
                        "source_sense_description": "Bundeswehr: Dienstgrad eines Soldaten zwischen dem Obergefreiten und Stabsgefreiten",
                        "target_lang_word": "caporal",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "caporal",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e3d0afef-1c88-3ef5-8478-82acfee735ae",
                                        "entry_id": "f3f27dee-531e-3d52-a8fb-9d0e99347834",
                                        "glosses": [
                                            "Grade le moins élevé dans l’infanterie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c5025d9-693a-4aab-8b1a-88577c7f6966",
                                                "sense_id": "e3d0afef-1c88-3ef5-8478-82acfee735ae",
                                                "text": "Tu nous rends un service impayable.\nMais quand s’acquittera le compte général,\nJe ne t’oublîrai ^([sic]) point ; tu seras caporal !"
                                            },
                                            {
                                                "example_id": "a9cbf9b6-4428-46c7-b1be-c314702900ab",
                                                "sense_id": "e3d0afef-1c88-3ef5-8478-82acfee735ae",
                                                "text": "Passer caporal."
                                            },
                                            {
                                                "example_id": "c15530d2-188f-4979-b8de-d8d7d3ea5b28",
                                                "sense_id": "e3d0afef-1c88-3ef5-8478-82acfee735ae",
                                                "text": "Le galon de caporal."
                                            },
                                            {
                                                "example_id": "50f38517-0718-46d3-bb88-8b2a8cb24f85",
                                                "sense_id": "e3d0afef-1c88-3ef5-8478-82acfee735ae",
                                                "text": "Caporal de consigne."
                                            },
                                            {
                                                "example_id": "6326b4ec-05ff-413d-9791-93691c60e803",
                                                "sense_id": "e3d0afef-1c88-3ef5-8478-82acfee735ae",
                                                "text": "Le caporal du poste."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f1691626-146f-3dc0-b6a8-a63fdd0f87c0",
                                        "entry_id": "f3f27dee-531e-3d52-a8fb-9d0e99347834",
                                        "glosses": [
                                            "Grade donné dans l’Armée de terre et l’Armée de l’air françaises, situé entre son supérieur hiérarchique, le caporal-chef, et son subordonné, le soldat de première classe ou l’aviateur de première classe, correspondant au quartier-maître de deuxième classe dans la Marine nationale française. Le code OTAN : OR-3."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2282ae6f-e7f9-4e22-9f91-a360de44998e",
                                                "sense_id": "f1691626-146f-3dc0-b6a8-a63fdd0f87c0",
                                                "text": "— P’t’êt, m’sieur, dit Chalumot en posant un pied sur le plancher, sans hâte.\n— Pas monsieur, mais caporal, dit Fromentel. Voyez, j’ai deux galons noirs sur mes manches. C’est là l’insigne de mon grade."
                                            },
                                            {
                                                "example_id": "21bef5c2-2d04-48fa-8ef2-bb8b85384afe",
                                                "sense_id": "f1691626-146f-3dc0-b6a8-a63fdd0f87c0",
                                                "text": "De mon époque, on saluait les caporaux, t’entends ? Les caporaux !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c6ebedf3-16c7-3a91-96b3-2f91f8ffa2d3",
                                        "entry_id": "f3f27dee-531e-3d52-a8fb-9d0e99347834",
                                        "glosses": [
                                            "Grade des Forces armées canadiennes."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a40d270f-0f52-36ec-91a2-7ad3e02c8365",
                                        "entry_id": "f3f27dee-531e-3d52-a8fb-9d0e99347834",
                                        "glosses": [
                                            "Tabac à fumer d’une espèce supérieure au tabac de troupe et devenu en France d’un usage général."
                                        ],
                                        "tags": [
                                            "singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2a974fd4-ea5a-4846-8738-0285ed25c331",
                                                "sense_id": "a40d270f-0f52-36ec-91a2-7ad3e02c8365",
                                                "text": "Mon triste cœur bave à la poupe\nMon cœur est plein de caporal"
                                            },
                                            {
                                                "example_id": "5ee79aec-6596-4630-aa01-2d93f1adeeee",
                                                "sense_id": "a40d270f-0f52-36ec-91a2-7ad3e02c8365",
                                                "text": "M. Morvanchut déchirait tous mes meubles avec ses éperons, venait fumer son caporal jusque dans ma chambre. Je voulus lui faire observer que mon appartement n’était pas une caserne."
                                            },
                                            {
                                                "example_id": "9a5dadb0-cef8-4a3a-8a43-4fb7a7d2a86c",
                                                "sense_id": "a40d270f-0f52-36ec-91a2-7ad3e02c8365",
                                                "text": "Un léger parfum de caporal flottait agréablement dans l’atmosphère et la bière prenait sur la langue un petit arrière-goût de buis."
                                            },
                                            {
                                                "example_id": "343d1779-d5e1-429b-bbcc-3b1d78fa8956",
                                                "sense_id": "a40d270f-0f52-36ec-91a2-7ad3e02c8365",
                                                "text": "Joigneau a pris sur la table le pot à tabac, l’a calé entre ses genoux, et, sans se presser, se roule un cigarette de caporal fin."
                                            },
                                            {
                                                "example_id": "6be13523-96ad-442f-9a8c-627c46203905",
                                                "sense_id": "a40d270f-0f52-36ec-91a2-7ad3e02c8365",
                                                "text": "— Nous avons du virginie, offrit Fromentine.\n— Voulez-vous du caporal ? dit M. de Rocheflamme.\n— Excusez-moi. J’ai l’habitude du « scaferlati Levant »."
                                            },
                                            {
                                                "example_id": "82dfcee3-43b8-4689-83d6-02a0026b98a0",
                                                "sense_id": "a40d270f-0f52-36ec-91a2-7ad3e02c8365",
                                                "text": "Car les songeries de Minne ignorent le caporal vulgaire, et, pour elle, il n’est de cigarettes qu’orientales."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
