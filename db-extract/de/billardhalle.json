                "senses": [
                    {
                        "sense_id": "661cefcf-b42f-3f8d-b566-d8b47147b884",
                        "entry_id": "508fb934-6c6c-32af-9c1e-170edeea416e",
                        "glosses": [
                            "Räumlichkeit, in der Billard gespielt werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b878529b-ec5b-4a7a-baaf-702d8f26e65e",
                                "sense_id": "661cefcf-b42f-3f8d-b566-d8b47147b884",
                                "text": "„Jack rannte. Er wusste nicht wohin, er rannte einfach. Direkt auf das nächste Gebäude zu, das zufällig eine Billardhalle war.“"
                            },
                            {
                                "example_id": "750e4824-ab2e-471e-9dc4-3237eb661503",
                                "sense_id": "661cefcf-b42f-3f8d-b566-d8b47147b884",
                                "text": "„Im hinteren Teil des Raumes standen zwei Sofas, ein Couchtisch und ein Wasserbehälter, und erhellt wurde alles von zwei langen Neonröhren, die die Behaglichkeit einer Billardhalle verströmten.“"
                            },
                            {
                                "example_id": "107dc636-fa2d-4ade-ae56-97967c1c91fb",
                                "sense_id": "661cefcf-b42f-3f8d-b566-d8b47147b884",
                                "text": "„Dann ging er die Treppe hinauf, die zur Billardhalle führte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
