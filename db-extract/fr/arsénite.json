                "senses": [
                    {
                        "sense_id": "bcd7576b-e734-3ee4-b79c-ebad95d5e5d7",
                        "entry_id": "8100383d-dfe8-3383-8ce1-d8426d1eb2fe",
                        "glosses": [
                            "Nom générique des sels composés d’acide arsénieux et d’une base, ou de l'anion trivalent (AsO₃³⁻) obtenu par dissociation de l'acide orthoarsénieux en milieu aqueux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c14ee4e5-be99-4a50-ab7c-0d279801667e",
                                "sense_id": "bcd7576b-e734-3ee4-b79c-ebad95d5e5d7",
                                "text": "Arsénite de potasse, de soude, d’ammoniaque."
                            },
                            {
                                "example_id": "83494dbe-baeb-4bfd-9d32-595f4d9adb7a",
                                "sense_id": "bcd7576b-e734-3ee4-b79c-ebad95d5e5d7",
                                "text": "Tous les arsénites sont artificiels."
                            },
                            {
                                "example_id": "a35d49d6-fc76-44af-ad07-c4945fd07be9",
                                "sense_id": "bcd7576b-e734-3ee4-b79c-ebad95d5e5d7",
                                "text": "L'ion arsénite a pour formule brute AsO₃³⁻."
                            },
                            {
                                "example_id": "58b0c6b3-af2b-4a3b-9455-38ced3f0ab83",
                                "sense_id": "bcd7576b-e734-3ee4-b79c-ebad95d5e5d7",
                                "text": "Le phosphate de chaux du sang et l’arsénite de soude subissent, en effet, une double décomposition."
                            }
                        ]
                    }
                ],
