                        "examples": [
                            {
                                "example_id": "3663fff4-ff45-4979-9a1d-3871ec54400c",
                                "sense_id": "dd3be4e3-c84c-38be-bbb9-19e01f3b21f7",
                                "text": "Même la nuit, jamais je ne m'y perdrais. Les flammeroles me guident. Je les appelle ; elles sortent de terre, pour moi seul."
                            }
                        ]
                    },
                    {
                        "sense_id": "90da8933-4094-397e-a191-640a7a7df722",
                        "entry_id": "6295de96-e4b1-31b1-848e-5492317e957d",
                        "glosses": [
                            "Petite flamme, flammèche, flammette, le plus souvent multiple."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9926b55b-b0b6-43a6-a9c3-69a24c3cd15a",
                                "sense_id": "90da8933-4094-397e-a191-640a7a7df722",
                                "text": "… ce furent des hurrahs qui la saluèrent, au moment où s’écroulaient, au milieu d’une gerbe de flammeroles, les derniers restes de la ragged-school."
                            }
                        ]
                    },
