                "senses": [
                    {
                        "sense_id": "b98b87f7-7de3-3734-a7af-75196b710896",
                        "entry_id": "ead1803b-9e79-31e1-a4f3-dee10b9555b2",
                        "glosses": [
                            "Diagramm zur Darstellung der Häufigkeitsverteilung mit Hilfe auf der x-Achse senkrecht stehender, nicht aneinander grenzender Säulen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06f214cf-fdb3-471d-b044-262562f9592e",
                                "sense_id": "b98b87f7-7de3-3734-a7af-75196b710896",
                                "text": "Im Mathematikunterricht zeichnete der Lehrer ein Säulendiagramm an die Tafel."
                            },
                            {
                                "example_id": "ba4b8db0-2c98-49a8-b75a-b92d2d3fed46",
                                "sense_id": "b98b87f7-7de3-3734-a7af-75196b710896",
                                "text": "„Bei der Betrachtung des Säulendiagramms (…) können wir eine grobe Dreiteilung der überprüften Doppelkonsonanz vornehmen.“"
                            },
                            {
                                "example_id": "6b81ebe4-b1bd-42a8-b5ee-31ae834e389b",
                                "sense_id": "b98b87f7-7de3-3734-a7af-75196b710896",
                                "text": "„Das gestapelte Säulendiagramm wurde auch zur einzelnen Erfassung der Einschätzungen eines jeden Befragten verwendet, sodass in der Download-Version dieses Werkes nach der Gesamtansicht auch die Säulendiagramme aller Befragten einzeln aufgeführt sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
