    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f3f686b9-4945-3964-83f4-ffa5f44b6e70",
                    "sense_definition": "The act of moving from one place to another, especially for a job or home.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "moving",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company offered a generous <w>relocation</w> package to help employees move to the new office.",
                            "target_lang_translations": {
                                "ru": "Компания предложила щедрый пакет услуг по <w>релокации</w>, чтобы помочь сотрудникам переехать в новый офис."
                            }
                        },
                        {
                            "text": "After the <w>relocation</w> of the equipment, the laboratory had much more space for experiments.",
                            "target_lang_translations": {
                                "ru": "После <w>перемещения</w> оборудования в лаборатории стало гораздо больше места для экспериментов."
                            }
                        }
                    ],
                    "synonyms": [
                        "move",
                        "removal"
                    ],
                    "common_phrases": [
                        "relocation",
                        "package",
                        "business",
                        "relocation",
                        "relocation",
                        "costs"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс перемещения из одного места в другое, особенно в связи с работой или сменой жилья."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "переезд",
                                "target_lang_sense_clarification": "смена места жительства или офиса"
                            },
                            {
                                "target_lang_word": "релокация",
                                "target_lang_sense_clarification": "перевод сотрудника или компании в другой регион/страну"
                            },
                            {
                                "target_lang_word": "перемещение",
                                "target_lang_sense_clarification": "смена местоположения объектов или оборудования"
                            },
                            {
                                "target_lang_word": "переселение",
                                "target_lang_sense_clarification": "массовый или вынужденный переезд людей"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e64e6c83-b6ed-3ef3-b739-aca66fede1f8",
                    "sense_definition": "The renewal of a lease or rental agreement.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "legal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tenant requested a <w>relocation</w> of the lease for another five years.",
                            "target_lang_translations": {
                                "ru": "Арендатор запросил <w>пролонгацию</w> договора аренды еще на пять лет."
                            }
                        },
                        {
                            "text": "Legal fees for the <w>relocation</w> of the commercial contract were higher than expected.",
                            "target_lang_translations": {
                                "ru": "Юридические расходы на <w>переоформление</w> коммерческого контракта оказались выше, чем ожидалось."
                            }
                        }
                    ],
                    "common_phrases": [
                        "lease",
                        "relocation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Продление срока действия договора аренды или найма."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пролонгация",
                                "target_lang_sense_clarification": "продление договора"
                            },
                            {
                                "target_lang_word": "переоформление",
                                "target_lang_sense_clarification": "обновление документов аренды"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d22c337b-eec8-3136-ad79-c3562b27b8a4",
                    "sense_definition": "The process of assigning memory addresses to variables during program linking or execution.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The linker handles the <w>relocation</w> of symbols to ensure the program runs correctly in memory.",
                            "target_lang_translations": {
                                "ru": "Компоновщик управляет <w>релокацией</w> символов, чтобы обеспечить корректную работу программы в памяти."
                            }
                        },
                        {
                            "text": "Errors in the <w>relocation</w> table can cause the software to crash upon startup.",
                            "target_lang_translations": {
                                "ru": "Ошибки в таблице <w>перемещений</w> могут привести к сбою программного обеспечения при запуске."
                            }
                        }
                    ],
                    "common_phrases": [
                        "relocation",
                        "table",
                        "dynamic",
                        "relocation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс назначения адресов памяти переменным во время связывания или выполнения программы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перемещение",
                                "target_lang_sense_clarification": "настройка адресов в памяти"
                            },
                            {
                                "target_lang_word": "релокация",
                                "target_lang_sense_clarification": "изменение адресов кода или данных"
                            }
                        ]
                    }
                }
            ]
        }
    ]
