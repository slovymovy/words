                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a858d14f-6be4-4d66-9ded-e37da52ba3c2",
                                "sense_id": "f5122638-d984-33ab-aa3c-d03664ac530b",
                                "text": "Да, кстати, и читатели начали понемножку отрезвляться, стали цидулки газетчику посылать."
                            },
                            {
                                "example_id": "2ef9e107-4049-4044-96c4-b1643346397d",
                                "sense_id": "f5122638-d984-33ab-aa3c-d03664ac530b",
                                "text": "Сговоришься, напиши мне две строчки, вручи батюшке, и он мне мигом твою цидулку пришлет"
                            }
                        ]
                    }
