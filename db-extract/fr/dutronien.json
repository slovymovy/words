                        "glosses": [
                            "Propre ou relatif à Jacques et/ou à Thomas Dutronc, leurs chansons, leurs interprétations."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d12232ed-7b69-4649-b0db-76c4e55400d2",
                                "sense_id": "77cc8e07-ef79-346f-82be-bbcaa4b8aedf",
                                "text": "\"Le Gala chez Renault\", un délire dutronien, une sorte de fête d'entreprise improvisée dans laquelle il joue plusieurs personnages."
                            },
                            {
                                "example_id": "daeff6eb-3c02-4fdc-bafc-963b118b0e14",
                                "sense_id": "77cc8e07-ef79-346f-82be-bbcaa4b8aedf",
                                "text": "Ce sont les gènes, je n’y peux rien. J’ai coécrit le texte avec un copain, qui était déjà dans une image assez dutronienne."
                            },
                            {
                                "example_id": "de981f96-537d-4d54-ac0e-2c16725a5b09",
                                "sense_id": "77cc8e07-ef79-346f-82be-bbcaa4b8aedf",
                                "text": "Un petit coté dadaïste Punk, pourquoi pas (rires) mais dans la tradition d’une certaine chanson française ! \"La caissière du super\" a un coté Nino Ferrer ou Dutronien."
                            }
                        ]
                    }
