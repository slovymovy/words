                ],
                "senses": [
                    {
                        "sense_id": "4b2ef4c2-3588-3d85-89ba-89d8d498e899",
                        "entry_id": "f28419f3-338a-3ad1-98ba-671dbc52a172",
                        "glosses": [
                            "книжн., филол. содержание событий, изображаемых в литературном произведении, в их последовательной связи, сюжетная схема, канва литературного произведения"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "750e7cf9-b382-4b4d-8e67-66105197c7a3",
                                "sense_id": "4b2ef4c2-3588-3d85-89ba-89d8d498e899",
                                "text": "Интересная фабула."
                            },
                            {
                                "example_id": "cb054d30-5b7e-40de-a714-ce735c0b32ab",
                                "sense_id": "4b2ef4c2-3588-3d85-89ba-89d8d498e899",
                                "text": "Главная фабула."
                            },
                            {
                                "example_id": "991054c0-4daf-47fd-aed2-9a56a6ab511d",
                                "sense_id": "4b2ef4c2-3588-3d85-89ba-89d8d498e899",
                                "text": "Побочная фабула."
                            },
                            {
                                "example_id": "61cad9b0-c520-4998-ab97-cd4317c73429",
                                "sense_id": "4b2ef4c2-3588-3d85-89ba-89d8d498e899",
                                "text": "Фабула романа взята из жизни."
                            },
                            {
                                "example_id": "b964164b-2adc-4525-9593-06905adc7174",
                                "sense_id": "4b2ef4c2-3588-3d85-89ba-89d8d498e899",
                                "text": "Он сделал, что мог: оставил и в общем, и в частностях развитие Эсхиловой фабулы, прибавил от себя несколько сцен и ради ясности, и ради эффекта ― и вышло то, что могло и должно было выйти."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1fe11b22-f50a-41b9-b556-6602f7d75c40",
                        "source_entry_id": "f28419f3-338a-3ad1-98ba-671dbc52a172",
                        "source_sense_id": "4b2ef4c2-3588-3d85-89ba-89d8d498e899",
                        "target_lang_word": "fabuła",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fabuła",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "7ac597a9-2f52-38b3-9ab5-435938db7263",
                                        "entry_id": "304fae51-3f20-3521-86e6-df1ce72737a9",
                                        "glosses": [
                                            "szereg wątków i motywów powiązanych czasowo i przyczynowo, przedstawionych w utworze literackim lub filmowym"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7847e3c5-3d86-4f33-92f1-3b9d1563bb3a",
                                                "sense_id": "7ac597a9-2f52-38b3-9ab5-435938db7263",
                                                "text": "Jak każde porównanie, porównanie homeryckie składa się z dwóch członów – drugi z nich (następujący po spójniku „jak”, „jako”, „jak gdyby” itp.) jest w porównaniu homeryckim obszernym, rozwiniętym obrazem, często stanowiącym samodzielny epizod fabuły utworu o dygresyjnym charakterze."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "dcdfba7c-b47c-3d19-bd8c-c2f73c7d4b24",
                                        "entry_id": "304fae51-3f20-3521-86e6-df1ce72737a9",
                                        "glosses": [
                                            "treść utworu"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2ffa3b0-cf34-4d1e-9397-adab08aaea06",
                                                "sense_id": "dcdfba7c-b47c-3d19-bd8c-c2f73c7d4b24",
                                                "text": "Fabuła tej książki jest naprawdę zaskakująca."
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    },
                                    {
                                        "sense_id": "43a03e21-7750-3b5c-a799-3f85d2a086e0",
