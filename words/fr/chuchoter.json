            "senses": [
                {
                    "sense_id": "825a0a9a-256a-310f-84fb-cb2f2348147a",
                    "sense_definition": "Parler à voix très basse de manière à n'être entendu que de très près.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "parole",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pour ne pas réveiller les enfants, nous devons <w>chuchoter</w> dans le salon."
                        },
                        {
                            "text": "Il s'est approché pour lui <w>chuchoter</w> à l'oreille une nouvelle surprenante."
                        }
                    ],
                    "synonyms": [
                        "susurrer"
                    ],
                    "antonyms": [
                        "crier"
                    ],
                    "common_phrases": [
                        "chuchoter à l'oreille",
                        "chuchoter un secret"
                    ]
                },
                {
                    "sense_id": "de8a7a3b-1ee5-3336-9d60-98f45fbb4605",
                    "sense_definition": "Faire entendre un bruit léger et doux, en parlant du vent, de l'eau ou des feuilles.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "bruit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Au fond du parc, les feuilles des grands arbres <w>chuchotent</w> sous la brise nocturne."
                        },
                        {
                            "text": "Le vent d'automne faisait doucement <w>chuchoter</w> les roseaux au bord de la rivière."
                        }
                    ],
