                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "41d41c80-7d0b-4026-9a57-2fee219471fb",
                                "sense_id": "a820b1c5-bb0f-315e-a242-8e5c0c5d16bc",
                                "text": "Tot twee jaar geleden kregen leerlingen op de Johannes Calvijnschool in Veenendaal vanaf groep 7 Engels. Dat nu ook de jongere groepen Engels krijgen, is vooral te danken aan Wim van den Bosch, teamleider van groep 7 en 8. „Een paar jaar geleden bezocht ik een congres in Hoevelaken over vroegtijdig veeltalig onderwijs. Daar werd benadrukt hoe belangrijk Engels onderwijs is, ook met het oog op de verscherpte exameneisen. Leerlingen mogen vanaf dit jaar geen onvoldoende meer halen voor het vak Engels. Veel van onze kinderen vallen dan door de mand.”"
                            },
                            {
                                "example_id": "93f67d5d-cf6f-4488-ad44-b66285c218fe",
                                "sense_id": "a820b1c5-bb0f-315e-a242-8e5c0c5d16bc",
                                "text": "Volgens Hammerstein is de oud-president van plan zich te vestigen in Amsterdam. De veeltalige Saakasjvili is getrouwd met de Nederlandse Sandra Roelofs, uit Zeeuws-Vlaanderen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ebded4dc-31b7-40c4-8df5-20771b93af43",
                        "source_entry_id": "d8ff2db8-b110-37ee-82d4-7014a513e6e3",
                        "source_sense_id": "a820b1c5-bb0f-315e-a242-8e5c0c5d16bc",
                        "target_lang_word": "polyglot",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "polyglot",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "97eac5dd-2033-3497-aee8-e03c98f4635a",
                                        "entry_id": "5b400ba4-01c7-3928-a904-4cbf6e65a2a8",
                                        "glosses": [
                                            "Of a person: speaking, or versed in, many languages; multilingual."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a4fdbe85-ad5e-4b12-b731-19674f126dbd",
                                                "sense_id": "97eac5dd-2033-3497-aee8-e03c98f4635a",
                                                "text": "'[T]is thought the two and twenty Languages which Mythrydates the great Polyglot King of Pontus did ſpeak, wer all within the circumference of Anatolia in regard his dominions extended but a little further: […]"
                                            },
                                            {
                                                "example_id": "824ce057-8820-4eea-88e2-20acfc2f7a54",
                                                "sense_id": "97eac5dd-2033-3497-aee8-e03c98f4635a",
                                                "text": "For this flyaway son of a Phœnician did not seem to wait for the decision of the polyglot Judges of the Emigration Board."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "423b1bff-e6e6-333a-a063-894058612047",
                                        "entry_id": "5b400ba4-01c7-3928-a904-4cbf6e65a2a8",
                                        "glosses": [
                                            "Containing, or made up of, several languages; specifically, of a book (especially a bible): having text translated into several languages."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "641f1c41-2321-4fe0-ab11-2eb14cbf601b",
                                                "sense_id": "423b1bff-e6e6-333a-a063-894058612047",
                                                "text": "a polyglot bible    a polyglot lexicon"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b6aaa59-51b5-38ff-bbbf-f241032eff49",
                                        "entry_id": "5b400ba4-01c7-3928-a904-4cbf6e65a2a8",
                                        "glosses": [
                                            "Comprising various (native) linguistic groups; multilingual."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6109db64-1e35-4667-b3e0-66b3af1d63da",
                                                "sense_id": "0b6aaa59-51b5-38ff-bbbf-f241032eff49",
                                                "text": "A polyglot region without a clearly dominant culture may develop an artificial lingua franca, such as Pidgin English in the South Sea."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "polyglot",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f0807627-8cee-3f8a-8732-57b7235014cd",
                                        "entry_id": "3da37eac-da77-30bd-b9c3-52a87cd9437d",
                                        "glosses": [
                                            "A publication in several languages; specifically, a book (especially a bible) containing several versions of the same subject matter or text in several languages."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24066ea7-5966-48fc-8048-918c6fbb2be9",
                                                "sense_id": "f0807627-8cee-3f8a-8732-57b7235014cd",
                                                "text": "[T]hose coming to the warehouses' doors fired them, and burned all the books and the pillars of the church, […] A great want thereof there will be of books, specially Latin books and foreign books; and, among others, the Polyglottes and new Bible, which he believes will be presently worth £40 a-piece."
                                            },
                                            {
                                                "example_id": "ca8edf49-93ba-42d9-a954-cb1c8a2c576c",
                                                "sense_id": "f0807627-8cee-3f8a-8732-57b7235014cd",
                                                "text": "But ſince that period the biblical apparatus has been much enriched by the publication of polyglots; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa9f7fc7-f392-33a5-a6e0-311f6b3eeeba",
                                        "entry_id": "3da37eac-da77-30bd-b9c3-52a87cd9437d",
                                        "glosses": [
                                            "One who has mastered (especially when able to speak) several languages."
                                        ],
                                        "tags": [
                                            "also",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e1e6938a-0bc0-4bdf-b8d9-c18031c80233",
                                                "sense_id": "fa9f7fc7-f392-33a5-a6e0-311f6b3eeeba",
                                                "text": "Laſtly, a polyg[l]ot or good linguiſt may alſo be term'd a uſefull learned man, ſpecially if vers'd in School-languages."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "360b31a4-44e2-3ab6-a2d0-324fc54cd392",
                                        "entry_id": "3da37eac-da77-30bd-b9c3-52a87cd9437d",
                                        "glosses": [
                                            "A mixture of languages or nomenclatures."
                                        ],
                                        "tags": [
                                            "also",
                                            "figuratively"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "854496da-f16a-3e4c-9c4c-dbd526319ca7",
                                        "entry_id": "3da37eac-da77-30bd-b9c3-52a87cd9437d",
                                        "glosses": [
                                            "A file that can be interpreted validly as multiple formats."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c9c135c-4c1c-4a25-addc-ea5784b807e0",
                                                "sense_id": "854496da-f16a-3e4c-9c4c-dbd526319ca7",
                                                "text": "If you are interested in polyglot file formats, take a look at the polyglot web page in the Corkami wiki. There are various example polyglots, including a PDF file that is also a valid HTML file with JavaScript, as well as a valid Windows PE executable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "705eea90-86a1-3d51-a96c-4865525ee089",
                                        "entry_id": "3da37eac-da77-30bd-b9c3-52a87cd9437d",
                                        "glosses": [
                                            "A program written to be valid in multiple programming languages."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e7d22047-ff3b-3eb7-aa5a-256ae35a40d6",
                                        "entry_id": "3da37eac-da77-30bd-b9c3-52a87cd9437d",
                                        "glosses": [
                                            "A bird able to imitate the sounds of other birds."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4b267071-68c1-4cd5-8a88-82ab323af7fe",
                        "source_entry_id": "d8ff2db8-b110-37ee-82d4-7014a513e6e3",
                        "source_sense_id": "a820b1c5-bb0f-315e-a242-8e5c0c5d16bc",
