                                "sense_id": "e15b8295-6262-338f-8d23-e0aaa8293875",
                                "text": "Bob a titré l’analyte pour le doser."
                            },
                            {
                                "example_id": "5bbeb0af-11ff-47f7-a240-2211a28ffbe6",
                                "sense_id": "e15b8295-6262-338f-8d23-e0aaa8293875",
                                "text": "Celle-ci est à l’origine d’un signal qui, après traitement, peut être directement corrélé à la concentration en solution de l’analyte cible."
                            }
                        ]
                    }
