                        "sense_id": "fe47a694-4f26-325d-8711-a999959c0e8a",
                        "entry_id": "59f88070-ff81-37ee-be89-bd3a74a99d39",
                        "glosses": [
                            "Qui permet de traiter les œdèmes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "604ddc6f-834c-4b89-9dc0-24b9edd53201",
                                "sense_id": "fe47a694-4f26-325d-8711-a999959c0e8a",
                                "text": "Elle est obtenue en faisant macérer des fleurs d’arnica, bien connues pour leur action anti-œdème, dans une huile végétale neutre (souvent de tournesol)."
                            },
                            {
                                "example_id": "aa1ebc05-bdda-4c26-ad3e-17d6ff77ef99",
                                "sense_id": "fe47a694-4f26-325d-8711-a999959c0e8a",
                                "text": "Il s’agit d’une enzyme rare qui a des propriétés digestives, anti-inflammatoires, anti-œdèmes et anti-tumorales."
                            },
                            {
                                "example_id": "4eedfb41-bdb8-46f2-83eb-2132389d55eb",
                                "sense_id": "fe47a694-4f26-325d-8711-a999959c0e8a",
                                "text": "Misez aussi sur l’ananas : grâce à ses propriétés anti-œdèmes, il aide à faire dégonfler."
                            }
                        ]
                    }
                ],
