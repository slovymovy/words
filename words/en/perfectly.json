                                "ru": "Это <w>совершенно</w> нормально — чувствовать усталость после долгой пробежки.",
                                "zh": "长跑后感到疲劳是<w>完全</w>正常的。",
                                "nl": "Het is <w>volkomen</w> normaal om je moe te voelen na een lange hardloopsessie.",
                                "pl": "To <w>zupełnie</w> normalne, że czujesz się zmęczony po długim biegu.",
                                "de": "Es ist <w>vollkommen</w> normal, sich nach einem langen Lauf müde zu fühlen.",
                                "fr": "Il est <w>tout à fait</w> normal de se sentir fatigué après une longue course.",
                                "it": "È <w>perfettamente</w> normale sentirsi stanchi dopo una lunga corsa.",
                                "cs": "Je <w>naprosto</w> normální cítit se po dlouhém běhu unaveně.",
                                "tr": "Uzun bir koşudan sonra yorgun hissetmek <w>gayet</w> normaldir.",
                                "es": "Es <w>perfectamente</w> normal sentirse cansado después de una carrera larga."
                            }
                        },
                        {
                            "text": "She made it <w>perfectly</w> clear that she was not interested.",
                            "target_lang_translations": {
                                "ru": "Она дала <w>совершенно</w> ясно понять, что не заинтересована.",
                                "zh": "她<w>十分</w>明确地表示她没兴趣。",
                                "nl": "Ze maakte <w>volkomen</w> duidelijk dat ze niet geïnteresseerd was.",
                                "pl": "Dała <w>całkowicie</w> jasno do zrozumienia, że nie jest zainteresowana.",
                                "de": "Sie hat <w>durchaus</w> deutlich gemacht, dass sie nicht interessiert ist.",
                                "fr": "Elle a fait comprendre <w>parfaitement</w> clairement qu'elle n'était pas intéressée.",
                                "it": "Ha messo in <w>perfettamente</w> chiaro che non era interessata.",
                                "cs": "Dala <w>zcela</w> jasně najevo, že nemá zájem.",
                                "tr": "İlgilenmediğini <w>son derece</w> açık bir şekilde belirtti.",
                                "es": "Ella dejó <w>perfectamente</w> claro que no estaba interesada."
                            }
                        }
