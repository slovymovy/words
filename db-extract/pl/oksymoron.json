                                    {
                                        "sense_id": "dc2b3657-f7d5-31d4-8d51-0478733f400e",
                                        "entry_id": "9271081f-b61c-3907-8e3c-b783e748a451",
                                        "glosses": [
                                            "Expresión en la que se emplean dos términos incongruentes o contradictorios."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07378855-9840-4908-9ebc-7229bff9e82a",
                                                "sense_id": "dc2b3657-f7d5-31d4-8d51-0478733f400e",
                                                "text": "\"Silencio atronador\" es un oxímoron."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ad6267e3-2bfb-41fd-8776-0fd8e778aa2c",
                        "source_entry_id": "d315e43d-73df-3d5d-bf03-161f934e7f56",
                        "source_sense_id": "e1c74319-71db-3857-a319-daba3d67ba68",
                        "target_lang_word": "Oxymoron",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Oxymoron",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b1534129-01f6-3c0e-ba4d-46515c45d06b",
                                        "entry_id": "4aca9856-5f88-3fd5-9ec7-c8c3132be0fa",
                                        "glosses": [
                                            "sprachliche Konstruktion (rhetorische Figur), die aussieht wie ein Widerspruch in sich innerhalb eines Worts oder bei Wortkombinationen"
                                        ],
                                        "tags": [
                                            "Literaturwissenschaft",
                                            "Rhetorik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f58469ec-f353-4b3b-bb66-96d58619eec0",
                                                "sense_id": "b1534129-01f6-3c0e-ba4d-46515c45d06b",
                                                "text": "Die deutsche Redewendung „alter Knabe“ ist ein Oxymoron."
                                            },
                                            {
                                                "example_id": "5fe28dd7-e333-468e-957a-03868284bc99",
                                                "sense_id": "b1534129-01f6-3c0e-ba4d-46515c45d06b",
                                                "text": "„süßsauer“, „scharfsinniger Unsinn“, „virtuelle Realität“ oder „Bürgeradel“ sind Beispiele für beide Formen von Oxymora."
                                            },
                                            {
                                                "example_id": "3d265fe4-2627-48df-a6fa-44b441d01704",
                                                "sense_id": "b1534129-01f6-3c0e-ba4d-46515c45d06b",
                                                "text": "Das Gedicht „Dunkel wars, der Mond schien helle“ lebt von Oxymora. (in Wikisource, Wikipedia)"
                                            },
                                            {
                                                "example_id": "1df09eda-7725-413d-b972-2240b30fd9cf",
                                                "sense_id": "b1534129-01f6-3c0e-ba4d-46515c45d06b",
                                                "text": "„Die auffallendste Stilfigur in dieser Evokation des Hochgebirges ist das Oxymoron, also die enge Verbindung von logisch Widersprüchlichem.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "017f471d-7651-3388-a416-9200988248dd",
                                        "entry_id": "4aca9856-5f88-3fd5-9ec7-c8c3132be0fa",
                                        "glosses": [
                                            "(scheinbar) sich selbst widersprechende Aussage ohne rhetorischen Anspruch; eine so bezeichnete Sache"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "68dada57-b0bd-4780-95e4-a93c6591832a",
                                                "sense_id": "017f471d-7651-3388-a416-9200988248dd",
                                                "text": "„Die Bezeichnung \"fehlerhaftes XML-Dokument\" ist gemäß der XML-Spezifikation also ein Oxymoron, da der Begriff XML-Dokument definitionsgemäß eigentlich impliziert, dass das Dokument korrekt ist.“"
                                            },
                                            {
                                                "example_id": "fc3bb1cf-50f5-4e33-852f-b562dfc71ac6",
                                                "sense_id": "017f471d-7651-3388-a416-9200988248dd",
                                                "text": "„Definiert man eine Enzyklopädie allerdings als ein fächerübergreifendes Nachschlagewerk, dann ist Universalenzyklopädie ein Pleonasmus und Fachenzyklopädie ein Oxymoron.“"
                                            },
                                            {
                                                "example_id": "fd65cfe6-980e-4fdf-ade0-c6cadca0272e",
                                                "sense_id": "017f471d-7651-3388-a416-9200988248dd",
                                                "text": "„Dies ist ein moderner, makelloser Film, was vielleicht schon ein Oxymoron darstellt.“"
                                            },
                                            {
                                                "example_id": "e0ac84f8-481a-41f5-b3e6-8d590f96f3cb",
                                                "sense_id": "017f471d-7651-3388-a416-9200988248dd",
                                                "text": "„»Ein gutes Manuskript über William Hague ist ein Oxymoron«, ein Widerspruch in sich, meinte einer. Warum? »Biographien von unmaßgeblichen Politikern verkaufen sich nicht, und Hague ist ein unmaßgeblicher Politiker.«“"
                                            },
                                            {
                                                "example_id": "209cbdb0-3978-4a7c-bc03-48a5964463a3",
                                                "sense_id": "017f471d-7651-3388-a416-9200988248dd",
                                                "text": "„Somit sind Begriffe wie „orale Literatur“ und auch „Gebärdensprachliteratur“ Oxymora.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
