                ],
                "senses": [
                    {
                        "sense_id": "00b7287a-56df-36cc-ab5a-b7cb9bb30f0b",
                        "entry_id": "794d4975-1828-3135-a52f-485930ab7e8b",
                        "glosses": [
                            "Menge über- und aufeinanderliegender Reifen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56ef9bcf-06b9-4b65-ab8e-9489a1c88b17",
                                "sense_id": "00b7287a-56df-36cc-ab5a-b7cb9bb30f0b",
                                "text": "[…] „die beiden Ermittler [stoßen] auf einen schrecklichen Fund: Tankstellenbesitzer Martin Geier liegt erstochen hinter einem Reifenstapel in seiner Werkstatt.“"
                            },
                            {
                                "example_id": "e47cf7ec-29e2-4f9c-9485-626c4eeedeb7",
                                "sense_id": "00b7287a-56df-36cc-ab5a-b7cb9bb30f0b",
                                "text": "[…] „alljährlich in der Zeit der Reifenwechsel finden sich wild abgelegte Reifenstapel in der Landschaft, oft so viele auf einmal, dass diese mutmaßlich von gewerblichen Anbietern stammen.“"
                            },
                            {
                                "example_id": "7d887a38-ee51-4bd5-af5c-c7b0c70262a4",
                                "sense_id": "00b7287a-56df-36cc-ab5a-b7cb9bb30f0b",
                                "text": "„Zwei Kinder (10 und 11 Jahre alt) haben laut Polizei den Großbrand in Retzow verursacht. Sie hatten bei dem Reifenstapel mit einem Feuerzeug gespielt, dabei geriet der in Brand.“"
                            },
                            {
                                "example_id": "c0d271e4-c279-4078-9742-cd62b1daebf2",
                                "sense_id": "00b7287a-56df-36cc-ab5a-b7cb9bb30f0b",
                                "text": "Ist ein Reifenstapel erst einmal in Brand geraten, kann er nur schwer gelöscht werden."
                            },
                            {
                                "example_id": "e6bbb58b-2a8f-4e13-8e3a-0459bcd6b7a3",
                                "sense_id": "00b7287a-56df-36cc-ab5a-b7cb9bb30f0b",
                                "text": "„Nach einem kleinen Fahrfehler war Hamilton im letzten Training in die Reifenstapel gekracht und hatte seinen Wagen dabei schwer beschädigt.“"
                            },
                            {
                                "example_id": "a9ce38e5-47a9-4b3d-a926-49d1352bcf5b",
                                "sense_id": "00b7287a-56df-36cc-ab5a-b7cb9bb30f0b",
                                "text": "„Auf seiner Aufwärmrunde verbremste sich der Mercedes-Pilot offensichtlich, sein Rennauto drehte sich von der Strecke und landete im Reifenstapel.“"
                            },
                            {
                                "example_id": "7cf8b94c-099b-4466-8ad8-b9bc2d647625",
                                "sense_id": "00b7287a-56df-36cc-ab5a-b7cb9bb30f0b",
                                "text": "„Adrian Sutil fuhr in seinem Sauber im hinteren Feld in der Schlussphase in einen Reifenstapel und schied aus.“"
                            },
                            {
                                "example_id": "5f65f5a5-72dc-429f-8957-0ef8eb4753af",
                                "sense_id": "00b7287a-56df-36cc-ab5a-b7cb9bb30f0b",
                                "text": "„Charles Leclerc verlor später die Kontrolle über sein Auto, die letzte Hoffnung der Scuderia zerschellte im Reifenstapel.“"
                            },
                            {
                                "example_id": "b6a1ee3a-0f03-4b5b-b5bd-b51bf1cdada5",
                                "sense_id": "00b7287a-56df-36cc-ab5a-b7cb9bb30f0b",
                                "text": "„»Grundsätzlich ist Sicherheit nen ganz großes Thema hier. Wenn se da raus schauen, sehen Sie die Fangzäune, die Leitplanken, die Kies-Bette, die Reifenstapel.«“"
                            },
                            {
                                "example_id": "05294c72-3feb-46f3-be23-90a4274bc146",
                                "sense_id": "00b7287a-56df-36cc-ab5a-b7cb9bb30f0b",
                                "text": "„Manche Rennen enden im Kiesbett, im Reifenstapel oder sogar manchmal tödlich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
