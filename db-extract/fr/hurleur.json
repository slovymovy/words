                    {
                        "sense_id": "c25014b6-cbe5-375a-add0-91b99bd58413",
                        "entry_id": "d99e091a-d79c-317e-a04e-9b90ecaefb9b",
                        "glosses": [
                            "Qui hurle, qui a l’habitude de pousser des cris."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ea08dbf-8192-4c82-8e3f-91e4742c29c3",
                                "sense_id": "c25014b6-cbe5-375a-add0-91b99bd58413",
                                "text": "Derviches hurleurs, sorte de religieux musulmans qui se distinguent par la violence de leurs gestes et de leurs cris."
                            },
                            {
                                "example_id": "364bdf36-4aae-43dd-a819-3861367780ca",
                                "sense_id": "c25014b6-cbe5-375a-add0-91b99bd58413",
                                "text": "La surveillance détaillée est si difficile dans le pêle-mêle hurleur et forcené de deux cents enfants !"
                            }
                        ]
                    }
                ],
