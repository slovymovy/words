                "senses": [
                    {
                        "sense_id": "e717896c-bd67-3037-918f-97efd7e05533",
                        "entry_id": "82ab2286-f1d0-3717-b65c-e62df81c33bc",
                        "glosses": [
                            "op een oneerlijke wijze veranderd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35e45c4f-bda0-476d-9689-beaf28013b04",
                                "sense_id": "e717896c-bd67-3037-918f-97efd7e05533",
                                "text": "De gemanipuleerde foto's van het fotomodel waren prachtig maar leken niet meer op de echte persoon."
                            },
                            {
                                "example_id": "b87641c3-23e4-4bd0-8b91-f7adf6d808c5",
                                "sense_id": "e717896c-bd67-3037-918f-97efd7e05533",
                                "text": "De aanklager van Cremona laat in totaal dertig personen voorleiden, die ervan verdacht worden wedstrijden uit de tweede en derde klasse te hebben gemanipuleerd. Daarnaast zouden ze zowel in Italië als in het buitenland grote sommen geld op die duels hebben ingezet."
                            }
                        ]
                    },
                    {
                        "sense_id": "2d767fc0-84a4-326e-a857-58c9be20cd02",
                        "entry_id": "82ab2286-f1d0-3717-b65c-e62df81c33bc",
                        "glosses": [
                            "op een oneerlijke wijze beïnvloed"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8077fac-fd6f-4cb9-be5e-36a3bb9debf4",
                                "sense_id": "2d767fc0-84a4-326e-a857-58c9be20cd02",
                                "text": "De gemanipuleerde bevolking was ervan overtuigd dat zonder economische groei het eind der tijden nabij was."
                            }
                        ]
                    }
