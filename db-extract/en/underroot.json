                "senses": [
                    {
                        "sense_id": "464048d5-1d48-364a-80ee-69ebfd354aa4",
                        "entry_id": "fca7e5dc-f906-34da-b24b-9140a9825eb3",
                        "glosses": [
                            "Square root."
                        ],
                        "tags": [
                            "India"
                        ],
                        "examples": [
                            {
                                "example_id": "26242c56-eb9b-44e6-bdb2-da87ccb3e0c0",
                                "sense_id": "464048d5-1d48-364a-80ee-69ebfd354aa4",
                                "text": "The underroot of the product of two regression coefficients gives us the coefficient of correlation ."
                            },
                            {
                                "example_id": "d9c397d0-fca5-45fe-baa8-611ab18c8e33",
                                "sense_id": "464048d5-1d48-364a-80ee-69ebfd354aa4",
                                "text": "To take the underroot of (2c-n)/n, the negative (2c-n)/n is multiplied with the minus sign to make it positive since one cannot take the underroot of minus item."
                            },
                            {
                                "example_id": "aafb8e56-962d-4bf1-be90-97b21493002a",
                                "sense_id": "464048d5-1d48-364a-80ee-69ebfd354aa4",
                                "text": "The Euclidian distance uses the under-root of the squared sum of the difference between individual ratings of the two samples whose similarity we want to find."
                            }
                        ]
                    }
                ],
