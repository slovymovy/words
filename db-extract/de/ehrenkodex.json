                "senses": [
                    {
                        "sense_id": "53ef2311-d2b1-3c01-8ea3-1f2773582611",
                        "entry_id": "bc89d958-31d7-3ec4-b532-17bcb6c734db",
                        "glosses": [
                            "die Gesamtheit der in einer Gemeinschaft maßgebenden Vorschriften, um die Ehre zu bewahren oder wiederherzustellen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f83203e6-9e84-4aad-ae4e-70800dffb45b",
                                "sense_id": "53ef2311-d2b1-3c01-8ea3-1f2773582611",
                                "text": "„Obwohl Duelle in den meisten Ländern verboten wurden, war der gesellschaftliche Ehrenkodex so stark, dass Duelle noch bis zum Beginn des 20. Jahrhunderts weiterlebten.“"
                            },
                            {
                                "example_id": "48fdb77a-c30e-4ae0-9b2d-4b784668a68b",
                                "sense_id": "53ef2311-d2b1-3c01-8ea3-1f2773582611",
                                "text": "„Zum Ehrenkodex gehörte, nicht abzuschreiben und nicht zu lügen.“"
                            },
                            {
                                "example_id": "6efc3559-449a-4fc0-8684-b5016d08d098",
                                "sense_id": "53ef2311-d2b1-3c01-8ea3-1f2773582611",
                                "text": "„Daß es ein Offizier ist, ein Mann also, der, er mag sein wie er will, einem gewissen Ehrenkodex unterliegt, ist eine kleine Beruhigung.“"
                            },
                            {
                                "example_id": "1756fe02-3ba0-478f-b91f-39a2dd893dc1",
                                "sense_id": "53ef2311-d2b1-3c01-8ea3-1f2773582611",
                                "text": "„Ob Ehrenkodex oder noch etwas anderes, jedenfalls war sie am Ende ihrer Besprechung mit Dincklage niedergeschlagen und verstört gewesen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
