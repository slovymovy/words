                    {
                        "sense_id": "0bb115ee-2b9d-3d5d-a170-d76015016e0c",
                        "entry_id": "039772cf-28ec-3abc-89fb-fe5c08e5a7e4",
                        "glosses": [
                            "A buttock, or the buttocks; a person's bottom."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "29847bc5-25bb-4ff7-b651-d9f6dd9f9149",
                                "sense_id": "0bb115ee-2b9d-3d5d-a170-d76015016e0c",
                                "text": "Pratt, a Buttock."
                            },
                            {
                                "example_id": "bc399b66-d183-44ae-a914-78fffc253379",
                                "sense_id": "0bb115ee-2b9d-3d5d-a170-d76015016e0c",
                                "text": "No gentry mort hath prats like thine, / No cove e'er wap'd with such a one."
                            },
                            {
                                "example_id": "9a81d57f-0f3f-4e01-8485-e80a716a0b3e",
                                "sense_id": "0bb115ee-2b9d-3d5d-a170-d76015016e0c",
                                "text": "Burt shook his head, wanting to tell Mac what a pain in the prat he was when he went on a take, but instead, repeated his instruction, keeping his voice at a whisper, moving his fingertips along the table […]"
                            },
                            {
                                "example_id": "09e7a4b3-bb9e-42e9-8b55-d7dd97432610",
                                "sense_id": "0bb115ee-2b9d-3d5d-a170-d76015016e0c",
                                "text": "Mungo didn't like their attitude. Nor did he like exposing his prat in mixed company."
                            }
                        ]
                    },
                    {
                        "sense_id": "603b152c-cde3-3f0c-afae-8e609294fc79",
                        "entry_id": "039772cf-28ec-3abc-89fb-fe5c08e5a7e4",
                        "glosses": [
                            "A fool, contemptible person."
                        ],
                        "tags": [
                            "Commonwealth",
                            "Ireland",
                            "UK",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "66134048-9f18-4a91-9990-ec60e35343a3",
                                "sense_id": "603b152c-cde3-3f0c-afae-8e609294fc79",
                                "text": "Those protestors will have achieved nothing good. They are stupid prats."
                            }
                        ]
                    },
                    {
                        "sense_id": "76d51ee3-f9fa-3611-a47d-13527830c005",
                        "entry_id": "039772cf-28ec-3abc-89fb-fe5c08e5a7e4",
                        "glosses": [
                            "The female genitals."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "de14051d-b5b5-4d0e-8881-10ecc2d57e33",
                                "sense_id": "76d51ee3-f9fa-3611-a47d-13527830c005",
                                "text": "\"She's a far better piece\nThan the Viceroy's niece,\nWho has also more fur on her prat.\""
                            },
                            {
                                "example_id": "ef6bdb36-a820-416f-8aa1-046dc68db552",
                                "sense_id": "76d51ee3-f9fa-3611-a47d-13527830c005",
                                "text": "...they would kidnap a girl and take her back to their camp where they would pull down her knickers, hoping to find hairs on her prat."
                            },
                            {
                                "example_id": "6c718b09-de7a-4f99-9b5c-01482d9f290e",
                                "sense_id": "76d51ee3-f9fa-3611-a47d-13527830c005",
                                "text": "\"My prat was sore from the unfamiliar activities of the night before, but my virgin bleeding had ceased, and we rode most of the day in that unworldly haze that comes with lack of sleep.\""
                            }
                        ]
                    }
