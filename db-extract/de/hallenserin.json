                "senses": [
                    {
                        "sense_id": "4af56ceb-60ee-3e8e-8ed0-0e8c3deda87a",
                        "entry_id": "bd97c2be-c22b-3636-a9bd-0d00ca23f59e",
                        "glosses": [
                            "in Halle geborene oder dort auf Dauer lebende weibliche Person"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6fb03aea-ad9c-4c94-ad06-5d8e43da896d",
                                "sense_id": "4af56ceb-60ee-3e8e-8ed0-0e8c3deda87a",
                                "text": "„Gefeiert haben sie schon immer gern, die Hallenserinnen und Hallenser.“"
                            },
                            {
                                "example_id": "ee1485cc-ddac-4d95-8435-d2a087ebf9c6",
                                "sense_id": "4af56ceb-60ee-3e8e-8ed0-0e8c3deda87a",
                                "text": "„Im Rahmen des stadtweiten Themenjahres 2006 ‚Die Welt statt der Provinz. Die internationale Dimension Halles‘ hatten die Franckeschen Stiftungen Hallenserinnen und Hallenser eingeladen, ihre Reisemitbringsel für eine Ausstellung vor der Wunderkammer ganz nach dem alten Wunderkammerprinzip zur Verfügung zu stellen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
