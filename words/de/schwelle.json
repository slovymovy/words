                    "frequency": "Middle",
                    "semantic_group_id": "architektur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er trug seine Braut über die <w>Schwelle</w> der neuen Wohnung."
                        },
                        {
                            "text": "Er blieb zögernd an der <w>Schwelle</w> stehen und schaute vorsichtig in das Zimmer."
                        }
                    ],
                    "synonyms": [
                        "Türschwelle"
                    ],
                    "antonyms": [
                        "Türsturz"
                    ],
                    "common_phrases": [
