    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "20baeb83-c64e-3ca1-a064-e31808441bdf",
                "word": "flogger",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "0187e391-fae2-4ff6-a6c2-63826a6f400c",
                        "entry_id": "20baeb83-c64e-3ca1-a064-e31808441bdf",
                        "tags": [
                            "plural"
                        ],
                        "form": "floggers"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "70fe2e33-e2fb-3790-b13d-036a2d559101",
                        "entry_id": "20baeb83-c64e-3ca1-a064-e31808441bdf",
                        "glosses": [
                            "One who flogs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ceda156c-6162-4586-8312-34650865cdd1",
                                "sense_id": "70fe2e33-e2fb-3790-b13d-036a2d559101",
                                "text": "How could the flogger of urchins be otherwise than animated and joyous?"
                            },
                            {
                                "example_id": "ff705d3f-8035-4579-afe5-0d27e6d44d07",
                                "sense_id": "70fe2e33-e2fb-3790-b13d-036a2d559101",
                                "text": "The High Masters were as shrewd floggers as any."
                            }
                        ]
                    },
                    {
                        "sense_id": "87f00454-139c-3134-8433-c85671729ccf",
                        "entry_id": "20baeb83-c64e-3ca1-a064-e31808441bdf",
                        "glosses": [
                            "A whip."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a896140-d861-4823-817c-2bcecb162965",
                                "sense_id": "87f00454-139c-3134-8433-c85671729ccf",
                                "text": "But the \"Sac\" party imagines that if the boy had not dropped his whip, their horse would have won, for he was so partial to his flogger, that the Treasure in all probability would have stopped to it, and Custance been just enabled to do him."
                            }
                        ]
                    },
                    {
                        "sense_id": "c38e2bfe-9314-3104-a16c-2d62b25c42a8",
                        "entry_id": "20baeb83-c64e-3ca1-a064-e31808441bdf",
                        "glosses": [
                            "A whip.",
                            "A lightweight whip with multiple lashes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1dbc47c-c5d2-4922-8e70-485ab0cf3aad",
                                "sense_id": "c38e2bfe-9314-3104-a16c-2d62b25c42a8",
                                "text": "Savanna walked around the stock, unhooking her flogger from her belt."
                            }
                        ]
                    },
                    {
                        "sense_id": "af041c1b-c967-3272-a817-ca79de5221c2",
                        "entry_id": "20baeb83-c64e-3ca1-a064-e31808441bdf",
                        "glosses": [
                            "A handle with strips of cloth attached, used for beating away charcoal dust etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56f5e151-cf1c-451a-8e4d-e5b324a6e086",
                                "sense_id": "af041c1b-c967-3272-a817-ca79de5221c2",
                                "text": "Schlepitchka is a texturing trick done by twirling a feather duster or flogger around gently and dabbing it on the surface of the scenery between each twirl of the tool so that the splayed pattern prints on the scenery."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "13b5f252-29ad-4935-9fe7-6944b28f6585",
                        "source_entry_id": "20baeb83-c64e-3ca1-a064-e31808441bdf",
                        "source_sense_description": "lightweight whip",
                        "target_lang_word": "martinet",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "martinet",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "474af16e-1b96-37f9-a5a4-0d697ba56fe3",
                                        "entry_id": "9b91fee2-68ac-3a22-96a8-a74175b754d5",
                                        "glosses": [
                                            "Espèce d’oiseau à très longues ailes et à pattes très petites, migrateur. Ressemblant à l'hirondelle, il ne lui est en fait pas du tout apparenté génétiquement : il appartient à la famille des apodidés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "875e9df0-dd53-428b-ac5e-dc5b676d2a9e",
                                                "sense_id": "474af16e-1b96-37f9-a5a4-0d697ba56fe3",
                                                "text": "Salut, clochers où vient nicher le martinet."
                                            },
                                            {
                                                "example_id": "2ac550cd-9c8c-4baf-bce8-382be8af5e29",
                                                "sense_id": "474af16e-1b96-37f9-a5a4-0d697ba56fe3",
                                                "text": "C’est aujourd’hui la propriété d’un vieil ami de celui qui raconte cette histoire, et tout le monde est tellement habitué à son aspect, si terrible qu’il soit, que le premier paysan venu va chercher, l’été, l’ombre de ses hautes murailles sans plus de crainte que les martinets aux grandes ailes noires et aux cris aigus, et les hirondelles aux doux gazouillements, qui, chaque année, viennent y suspendre leurs nids."
                                            },
                                            {
                                                "example_id": "90dacd51-60c3-4e4b-b359-4d13b79c69a8",
                                                "sense_id": "474af16e-1b96-37f9-a5a4-0d697ba56fe3",
                                                "text": "Ces champs ne sont-ils pas à moi, et ces bois chanteurs, et ce ciel que raye continuellement le vol fantaisiste des martinets ?"
                                            },
                                            {
                                                "example_id": "9eb43696-dd1d-4429-93b6-2be3765eed7e",
                                                "sense_id": "474af16e-1b96-37f9-a5a4-0d697ba56fe3",
                                                "text": "La destruction des hirondelles est au reste le plus cruel des avicides , car ces oiseaux ne se nourrissent que de moucherons, et ne causent aucun préjudice. Il en est de même du martinet et du crapaud-volant."
                                            },
                                            {
                                                "example_id": "6ea80da5-6766-490a-a1d2-af2d38b623df",
                                                "sense_id": "474af16e-1b96-37f9-a5a4-0d697ba56fe3",
                                                "text": "– Voyez-vous ce mince oiseau noir qui passe et repasse ? C’est un martinet pourpré.\n– Eh bien ?\n– Un martinet pourpré. S’il était jour, vous verriez son dos bleu, les belles petites plumes rousses de son ventre."
                                            },
                                            {
                                                "example_id": "0a526701-742f-4c25-a8cd-f1515e67d2bb",
                                                "sense_id": "474af16e-1b96-37f9-a5a4-0d697ba56fe3",
                                                "text": "Vous vous rappelez l’arrivée de Duncan et de Banquo au château de Macbeth, hanté par l’ambition meurtrière :\nDuncan dit : « Ce château est sis en un lieu plaisant. L’air, par son souffle léger et doux, s’y recommande à nos sens apaisés. »\nBanquo répond : « Cet hôte de l’été, le martinet qui hante les temples, montre, par son logis préféré, que l’haleine du ciel y souffle un parfum caressant, amoureux. Il n’est frise, saillant, arc-boutant, coin, vantail, où cet oiseau n`ait suspendu, avec son nid, le berceau de sa progéniture. Là où il fréquente et pullule, j’ai remarqué que l’air est délicat. »"
                                            },
                                            {
                                                "example_id": "d7802620-60a5-4c14-a121-5ac32366da79",
                                                "sense_id": "474af16e-1b96-37f9-a5a4-0d697ba56fe3",
                                                "text": "Dans son Caligula Albert Camus évoque le calme bonheur de vivre par ces quatre mots qui sont en vérité extraordinairement évocateurs : \"le cri des martinets dans le ciel vert\"."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "martinet",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f4fccfdd-30db-3f41-85be-1f99bff565b9",
                                        "entry_id": "38a6c7ef-a690-39b6-93f9-33bc9e493390",
                                        "glosses": [
                                            "Marteau qui est mû ordinairement par la force de l’eau et qui sert dans les forges, dans les moulins à papier, à tan, à foulon, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0984e30b-78ba-4a09-84ed-a1b1db9f2d00",
                                                "sense_id": "f4fccfdd-30db-3f41-85be-1f99bff565b9",
                                                "text": "Dans la principauté de Blankenbourg, on trouve une marbrière , une fabrique de cobalt, quatre hauts-fourneaux et plusieurs forges, martinets et fours à chaux et à plâtre."
                                            },
                                            {
                                                "example_id": "154c1e88-9f7f-4683-88fe-b424d64aad38",
                                                "sense_id": "f4fccfdd-30db-3f41-85be-1f99bff565b9",
                                                "text": "Nos fers passent de l'état de lopins de fonte à peine corroyée au martinet, à l'état de barres par le laminage au cylindre."
                                            },
                                            {
                                                "example_id": "1e1b91c4-aaac-41e7-95bb-24486ac8327c",
                                                "sense_id": "f4fccfdd-30db-3f41-85be-1f99bff565b9",
                                                "text": "Depuis plus d’une heure, nous entendions de puissants ronflements, un mugissement semblable à celui de la mer avec des coups sourds, — les ronflements étaient produits par les ventilateurs, les coups sourds par les martinets et les pilons."
                                            },
                                            {
                                                "example_id": "f6308f3c-6f28-4660-bf95-4f258cb52577",
                                                "sense_id": "f4fccfdd-30db-3f41-85be-1f99bff565b9",
                                                "text": "Alors, on levait les vannes de l’étang, l’eau faisait se mouvoir la roue à aubes qui commandait le martinet, l’immense marteau horizontal se soulevait, retombait, cognait dur et lourd sur la fonte chaude, d’où fusaient des millions de vives étincelles, et la transformait lentement en fer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d4500098-d005-3e6e-aacd-7cb8b62b4099",
                                        "entry_id": "38a6c7ef-a690-39b6-93f9-33bc9e493390",
                                        "glosses": [
                                            "Forte molette de grès à laquelle est attachée une corde pour la faire mouvoir, et qui sert, avec du grès pulvérisé et de l'eau, à égriser les carreaux de marbre."
                                        ],
                                        "tags": [
                                            "Marbrerie"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b4844f29-ecca-3208-9f4c-547e18eacc77",
                                        "entry_id": "38a6c7ef-a690-39b6-93f9-33bc9e493390",
                                        "glosses": [
                                            "Petit fouet composé d’un manche en bois et de quelques lanières de cuir d’une vingtaine de centimètres dont on se sert pour battre les habits et qui était aussi utilisé autrefois pour corriger les enfants difficiles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4299514-3117-4638-a974-bf60d7b996e4",
                                                "sense_id": "b4844f29-ecca-3208-9f4c-547e18eacc77",
                                                "text": "Aussitôt je saisis le glaive de la justice, mon martinet, et je lui applique…"
                                            },
                                            {
                                                "example_id": "9668c0d6-1513-4a06-b0dc-952f1377d916",
                                                "sense_id": "b4844f29-ecca-3208-9f4c-547e18eacc77",
                                                "text": "Le dimanche, la trompette les assemble à l’église, où l’on voit accrochés trois martinets qui servent à punir les délinquants, les voleurs et les intrus, car leur discipline est sévère."
                                            },
                                            {
                                                "example_id": "defccb8b-74b4-40dc-a878-211c9b45e2c9",
                                                "sense_id": "b4844f29-ecca-3208-9f4c-547e18eacc77",
                                                "text": "Ni les marionnettes, ni l’pain n’épice\nN’ont produit d’effet.\nMais l’martinet\nA vit rappagé l’petit Narcisse"
                                            },
                                            {
                                                "example_id": "455dc776-0592-4276-8b70-01a4dc505010",
                                                "sense_id": "b4844f29-ecca-3208-9f4c-547e18eacc77",
                                                "text": "Nous bavardions, nous riions, je grignotais un de ces faux objets qui me plaisaient tant — un martinet en réglisse — lorsque maman apparut à un détour du chemin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7512c948-49d0-30a1-afe6-bdad3fa44d3f",
                                        "entry_id": "38a6c7ef-a690-39b6-93f9-33bc9e493390",
                                        "glosses": [
                                            "Définition manquante ou à compléter. (Ajouter)"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "07e7f1ee-4033-342d-954d-949fbfd157e5",
                                        "entry_id": "38a6c7ef-a690-39b6-93f9-33bc9e493390",
                                        "glosses": [
                                            "Il (Godefroid) entendit le bruit de ferraille causé par les clefs que Manon prenait dans un tiroir, et il lui vit allumer la chandelle d’un grand martinet en cuivre jaune. — (Honoré de Balzac, L’Envers de l’Histoire contemporaine, 1848, premier épisode)"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
