                ],
                "senses": [
                    {
                        "sense_id": "4c735cf9-edcb-3c8c-b94d-de1157216a53",
                        "entry_id": "e96c2939-888f-3a00-be53-9d7681eccf6d",
                        "glosses": [
                            "Reklame mit Schrift oder Figuren aus Leuchtstofflampen, Leuchtröhren oder Leuchtdioden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e5e0b31-ef3d-478b-86f2-6a9729a862a7",
                                "sense_id": "4c735cf9-edcb-3c8c-b94d-de1157216a53",
                                "text": "„Der Times Square ist berühmt für seine zahlreichen Leuchtreklamen.“"
                            },
                            {
                                "example_id": "9ec997e5-3c23-4132-a3f0-7ab2671429c6",
                                "sense_id": "4c735cf9-edcb-3c8c-b94d-de1157216a53",
                                "text": "„Nach den dunklen Villenauffahrten verdichtete sich die Stadt, die blinkenden Leuchtreklamen blendeten sie.“"
                            },
                            {
                                "example_id": "c9699140-abf7-490f-afd7-4b82df7dc043",
                                "sense_id": "4c735cf9-edcb-3c8c-b94d-de1157216a53",
                                "text": "„Ich hatte hinausgeblickt an diesem Sommerabend im Jahr 1954, fasziniert von den bunten Leuchtreklamen der großen Stadt und von den nach und nach grauer und immer schwärzer werdenden Häusern.“"
                            },
                            {
                                "example_id": "fc9f367b-05a2-4da0-8192-443335369c02",
                                "sense_id": "4c735cf9-edcb-3c8c-b94d-de1157216a53",
                                "text": "„Manchmal huschte der rote Schein einer Leuchtreklame über ihr Gesicht und ihre Hände.“"
                            },
                            {
                                "example_id": "7f5d5bb0-22ac-4e87-b23d-d9131ffc24c8",
                                "sense_id": "4c735cf9-edcb-3c8c-b94d-de1157216a53",
                                "text": "„Als er sich umdrehte, sah er das Mündungsfeuer des zweiten Schusses schwach, aber wahrnehmbar unter dem rosa Gleißen der fünf Meter hohen Leuchtreklame des Hotels.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
