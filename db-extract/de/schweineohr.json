                        "entry_id": "586e981c-6bf7-3eb1-a89f-3c86515e93e6",
                        "glosses": [
                            "Gebäck, das aus Blätterteig besteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b95f811c-8a5b-400a-b196-c811b443e99e",
                                "sense_id": "9d495d04-561a-399f-a1d1-137c0a530b60",
                                "text": "„Trotz seiner Schweineohren schlossen die Kinder Sebastian ins Herz.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "ffa66452-67ef-34fc-a8b2-ad4889da3c4d",
                        "entry_id": "586e981c-6bf7-3eb1-a89f-3c86515e93e6",
                        "glosses": [
                            "Ohr eines Schweines"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a99422cf-ee5f-4549-b93f-a081845f1f5c",
                                "sense_id": "ffa66452-67ef-34fc-a8b2-ad4889da3c4d",
                                "text": "„Als Abendessen haben wir eine Erbsensuppe zu uns genommen, die so dick war, daß der Schöpflöffel aufrecht darin stehenblieb – dazu haben wir das Fleisch gegessen, das hineingekocht worden ist – Schweinepfoten, Schweineohren und für jeden ein sehr fettes Stück Schweinebauch.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
