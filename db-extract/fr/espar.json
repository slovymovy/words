                                        "sense_id": "96c4a229-d81f-3736-8f52-f21503666370",
                                        "entry_id": "bdfb3d56-d299-3bae-bc00-7d05a412cc26",
                                        "glosses": [
                                            "To fight, especially as practice for martial arts or hand-to-hand combat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c229a17-b0be-4bb7-b704-1ffc35e862be",
                                                "sense_id": "96c4a229-d81f-3736-8f52-f21503666370",
                                                "text": "After early sparring, Spurs started to take control as the interval approached and twice came close to taking the lead. Terry blocked Rafael van der Vaart's header on the line and the same player saw his cross strike the post after Adebayor was unable to apply a touch."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9613b363-9fbb-3ec0-ac27-45ca541ff3fe",
                                        "entry_id": "bdfb3d56-d299-3bae-bc00-7d05a412cc26",
                                        "glosses": [
                                            "To strike with the feet or spurs, as cocks do."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "925ff77e-896d-3c12-ae12-4aafe7dcb27b",
