        "fr-extract.jsonl": [
            {
                "entry_id": "6d8e2522-dba5-3c0b-8cc6-a7283cfb6a5b",
                "word": "intrépidité",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "5705e960-9878-4a09-b69b-c7ea1542195e",
                        "entry_id": "6d8e2522-dba5-3c0b-8cc6-a7283cfb6a5b",
                        "tags": [
                            "plural"
                        ],
                        "form": "intrépidités"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a81b6056-7571-3e93-a714-8d9dc9ab671b",
                        "entry_id": "6d8e2522-dba5-3c0b-8cc6-a7283cfb6a5b",
                        "glosses": [
                            "Fermeté inébranlable dans le péril."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea9bcb13-5c97-43b3-a213-8708af295a24",
                                "sense_id": "a81b6056-7571-3e93-a714-8d9dc9ab671b",
                                "text": "Il a fait preuve d’intrépidité, d’une grande intrépidité."
                            },
                            {
                                "example_id": "1bd5d373-9ec1-4859-b538-71330b022bce",
                                "sense_id": "a81b6056-7571-3e93-a714-8d9dc9ab671b",
                                "text": "Il avait arraché ses galons sur le front grâce à une intrépidité remarquable."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f70d2904-4132-4dd5-b416-d49e710a6af1",
                        "source_entry_id": "6d8e2522-dba5-3c0b-8cc6-a7283cfb6a5b",
                        "source_sense_id": "a81b6056-7571-3e93-a714-8d9dc9ab671b",
                        "target_lang_word": "fearlessness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fearlessness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e8bcad94-0d6d-3224-826c-e8521cc40a34",
                                        "entry_id": "48c498bb-88e0-3708-9ef9-5943c45bda0a",
                                        "glosses": [
                                            "The quality of being fearless."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "59db7d8b-8d8d-4784-95e3-30c294c056ae",
                                                "sense_id": "e8bcad94-0d6d-3224-826c-e8521cc40a34",
                                                "text": "Anne was indignant with that straight-out and generous indignation which belongs to women, who are ready to follow their principles to any result with more inconsiderate fearlessness than men."
                                            },
                                            {
                                                "example_id": "44907e95-c803-43aa-9d12-3e0a4e35a362",
                                                "sense_id": "e8bcad94-0d6d-3224-826c-e8521cc40a34",
                                                "text": "The only thing to fear is fearlessness / The bigger the weapon, the greater the fear / Hyena is ambassador to here"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2e7260f7-7b74-42a7-b3eb-a650ac88bf25",
                        "source_entry_id": "6d8e2522-dba5-3c0b-8cc6-a7283cfb6a5b",
                        "source_sense_id": "a81b6056-7571-3e93-a714-8d9dc9ab671b",
                        "target_lang_word": "intrepidity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "intrepidity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2123c61b-a04e-3e9c-a2a3-cff697eda696",
                                        "entry_id": "a36a00cc-706c-3646-937f-06702e132786",
                                        "glosses": [
                                            "The quality of being intrepid; bravery."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0fbfda63-414a-4a83-9c2b-bb0b0dca4a54",
                                                "sense_id": "2123c61b-a04e-3e9c-a2a3-cff697eda696",
                                                "text": "[…] Pipes, who acted as the enemy's forlorn hope, advanced to the gate with great intrepidity, and clapping his foot to the door, which was none of the ſtouteſt, with the execution and diſpatch of a petard, ſplit it into a thouſand pieces."
                                            },
                                            {
                                                "example_id": "8f88b273-e9ea-4d96-8012-9c5ec7624afc",
                                                "sense_id": "2123c61b-a04e-3e9c-a2a3-cff697eda696",
                                                "text": "Miss Bingley immediately fixed her eyes on his face, and desired he would tell her what lady had the credit of inspiring such reflections. Mr. Darcy replied with great intrepidity, \"Miss Elizabeth Bennet.\""
                                            },
                                            {
                                                "example_id": "49a72826-02cf-4849-9a3e-7ca6689c5d0c",
                                                "sense_id": "2123c61b-a04e-3e9c-a2a3-cff697eda696",
                                                "text": "The pale, inscrutable determinateness, and flinchless intrepidity of Pierre, now began to domineer upon them; for any social unusualness or greatness is sometimes most impressive in the retrospect."
                                            },
                                            {
                                                "example_id": "5a2b6e27-d5c6-478d-899e-a8796ea6ec1f",
                                                "sense_id": "2123c61b-a04e-3e9c-a2a3-cff697eda696",
                                                "text": "And then I think I saw the most tremendous exhibition of moral courage and intrepidity that it is possible to conceive."
                                            },
                                            {
                                                "example_id": "d272a082-250a-4d8b-9ec6-e84f7e4bbce3",
                                                "sense_id": "2123c61b-a04e-3e9c-a2a3-cff697eda696",
                                                "text": "[T]here are common and covert ones [dangers], that \"look like nothing\" and that can be but inwardly and occultly dealt with, which involve the sharpest hazards to life and honour and the highest instant decisions and intrepidities of action."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "00df6066-b644-4fdc-a5f1-5119ef4d4156",
                        "source_entry_id": "6d8e2522-dba5-3c0b-8cc6-a7283cfb6a5b",
                        "source_sense_id": "a81b6056-7571-3e93-a714-8d9dc9ab671b",
