                        "examples": [
                            {
                                "example_id": "b613247f-85c0-438a-9735-99b70c1b1378",
                                "sense_id": "d2c73b44-04b3-32de-9dd2-d7262756346f",
                                "text": "De brand in de bus was veroorzaakt door een defect in de aandrijfmotor van de koelventilator. Dat defect is niet aangetroffen in de andere bussen, ruim 200 in totaal."
                            },
                            {
                                "example_id": "021b0edb-5af1-4bd5-a093-a18be6fc761b",
                                "sense_id": "d2c73b44-04b3-32de-9dd2-d7262756346f",
                                "text": "De storing was de zwaarste in twintig jaar. Oorzaak bleek een kapotte aandrijfmotor in een schakelaar van TenneTs hoogspanningsstation in Diemen. Door een daaropvolgende menselijke fout schakelde het station zich vervolgens uit voorzorg uit. ,,Binnen minuten tot uren is de samenleving in het gestoorde gebied terug naar het niveau van de middeleeuwen”, schreef de Auditdienst Rijk in 2016 in een rapport."
                            }
                        ]
