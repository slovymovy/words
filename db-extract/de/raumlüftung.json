                    {
                        "sense_id": "137063ef-93ed-32ad-a321-2a1d599a5d89",
                        "entry_id": "80d62eb4-568b-3d29-b39a-4ff07f313356",
                        "glosses": [
                            "Lüftungsart und Lüftungstechnik zum lüften eines Raumes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a91959b7-e148-4c39-b993-36dd1b77880a",
                                "sense_id": "137063ef-93ed-32ad-a321-2a1d599a5d89",
                                "text": "„Der Raumlüftung kommt eine hohe Bedeutung zu. Unterschieden wird zwischen der freien Lüftung (auch natürliche Lüftung genannt) und der mechanischen Lüftung (auch maschinelle Lüftung genannt).“"
                            },
                            {
                                "example_id": "7ab079a2-c9cc-4a59-b41a-ef7fb823621b",
                                "sense_id": "137063ef-93ed-32ad-a321-2a1d599a5d89",
                                "text": "„Die Werte für die vorschriftsmäßige Raumlüftung in Deutschland sind abhängig von der Größe und der Auslastung (Personenzahl) des Raumes. (DIN 18017-3 und DIN 1946-6)“"
                            },
                            {
                                "example_id": "ce5b3c48-a834-446e-983a-4d7232b93e49",
                                "sense_id": "137063ef-93ed-32ad-a321-2a1d599a5d89",
                                "text": "„GEALAN bietet mit dem GECCO 4 im Bereich der selbsttätigen Raumlüftung eine Neuentwicklung mit deutlich höherer Luftleistung an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
