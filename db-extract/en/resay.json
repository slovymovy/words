                "senses": [
                    {
                        "sense_id": "a1fb636a-f82e-3960-8360-0feb836a9d0f",
                        "entry_id": "b86f8003-bb2c-3f50-857d-7f8debe7c851",
                        "glosses": [
                            "To say again, to repeat, to iterate."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d82866d9-19a0-44b8-8195-389c2cc1189b",
                                "sense_id": "a1fb636a-f82e-3960-8360-0feb836a9d0f",
                                "text": "If we say something and people reject it because they don't like that it is true then we must resay it, and keep resaying it, until the truth is heard."
                            },
                            {
                                "example_id": "ce692d65-a946-4ae9-a45c-c93ddb258d63",
                                "sense_id": "a1fb636a-f82e-3960-8360-0feb836a9d0f",
                                "text": "He's like a human parrot: he resays whatever he's told - without any comprehension of its meaning."
                            }
                        ]
                    }
                ],
