                        "glosses": [
                            "therapeutische Maßnahme, die über einen besonders langen Zeitraum hinweg eingesetzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a140121-e35a-438b-a766-586e32b6c9ab",
                                "sense_id": "41b26675-62be-39d3-b0bb-5e52ae44467e",
                                "text": "„Nach einer Langzeittherapie bleiben rund 50 Prozent der Suchtkranken über ein Jahr clean, schätzt er.“"
                            },
                            {
                                "example_id": "5a6eed56-746f-4508-8e44-e2c9d7f40dab",
                                "sense_id": "41b26675-62be-39d3-b0bb-5e52ae44467e",
                                "text": "„Doch die Langzeittherapie ist genau das, worauf Ärzte wie Walter Berghoff bauen.“"
                            }
                        ],
