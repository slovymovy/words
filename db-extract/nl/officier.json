                "senses": [
                    {
                        "sense_id": "6dd1b478-19d5-3858-974e-4c3f56159090",
                        "entry_id": "cf529f88-5d34-3672-bfaa-28e789edaae8",
                        "glosses": [
                            "iemand die een rang (in het leger) bekleedt die hem of haar het bevel over een zeker aantal ondergeschikten geeft"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "12492964-dc7c-45ad-9d84-15e3852b1bec",
                                "sense_id": "6dd1b478-19d5-3858-974e-4c3f56159090",
                                "text": "Omdat ze een vrij klassiek beeld had van de oorlog was ze er snel van overtuigd dat Albert 'met zijn intelligentie' na korte tijd zou uitblinken, promotie zou maken en ze zag hem al in de voorste linie in de aanval gaan. Ze stelde zich voor dat hij een heldendaad verrichtte, meteen officier werd, kapitein, commandant of meer nog, generaal, die dingen gebeuren tijdens de oorlog."
                            }
                        ]
                    },
                    {
                        "sense_id": "21882b73-2fe2-3299-a3bb-186567a4f41a",
                        "entry_id": "cf529f88-5d34-3672-bfaa-28e789edaae8",
                        "glosses": [
                            "ambtenaar in een bepaalde functie"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "b491f585-272c-3f2f-934e-059975980aa4",
                        "entry_id": "cf529f88-5d34-3672-bfaa-28e789edaae8",
                        "glosses": [
                            "stuurman of machinist"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "933b7a4a-1810-3ec2-b6f4-07e4ad159e34",
                        "entry_id": "cf529f88-5d34-3672-bfaa-28e789edaae8",
                        "glosses": [
                            "rang binnen een ridderorde, hoger dan ridder, maar niet zo hoog als commandeur of grootkruis"
