                    },
                    {
                        "translation_id": "b9d531c7-df5c-4cd6-97f9-59c66cb37bc8",
                        "source_entry_id": "a7c75229-cd8c-3bfe-8188-73e8d96fe050",
                        "source_sense_id": "099dfff8-9424-3e23-95a0-52b86a1e6e8d",
                        "source_sense_description": "book of the Bible",
                        "target_lang_word": "Richter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Richter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ee6474a0-e8a2-3c6f-b032-e9699d418dc1",
                                        "entry_id": "018418d6-a3aa-353c-873f-8ef8391e5750",
                                        "glosses": [
                                            "(männlicher^☆) Inhaber eines öffentlichen Amtes bei einem Gericht, der Aufgaben der Judikatur (Rechtsprechung) wahrnimmt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8bd9d18f-e221-49c1-8afb-1ac9fd245ba6",
                                                "sense_id": "ee6474a0-e8a2-3c6f-b032-e9699d418dc1",
                                                "text": "Der gute Richter zog den Prozeß im größten Maßstab auf, und vier Tage gelang es ihm, in der denkbar wirkungsvollsten Weise die Einheit von Szene und Tribunal herzustellen. (Erich Mühsam, Unpolitische Erinnerungen, Der gute Richter, z.n. Projekt Gutenberg)"
                                            },
                                            {
                                                "example_id": "3f126ea1-fb08-4721-895d-d378b747bae1",
                                                "sense_id": "ee6474a0-e8a2-3c6f-b032-e9699d418dc1",
                                                "text": "Und will endlich ein Richter oder ein andrer Beamte von den Wenigen, welchen das Recht und das gemeine Wohl lieber ist, als ihr Bauch und der Mammon, ein Volksrat und kein Volksschinder sein, so wird er von den obersten Räten des Fürsten selber geschunden. (Nach: Georg Büchner, Der Hessische Landbote, z.n. Projekt Gutenberg)"
                                            },
                                            {
                                                "example_id": "49ed4a45-5766-4474-802a-09b71be891ea",
                                                "sense_id": "ee6474a0-e8a2-3c6f-b032-e9699d418dc1",
                                                "text": "„Der Richter rauchte und trank seinen Cognac.“"
                                            },
                                            {
                                                "example_id": "83550305-8a1d-41ad-ba1e-3777b191979a",
                                                "sense_id": "ee6474a0-e8a2-3c6f-b032-e9699d418dc1",
                                                "text": "„Schon am einunddreißigsten März stand sie vor einem Richter.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "034cbf35-4f5e-369d-b8e2-606ea3c29beb",
                                        "entry_id": "018418d6-a3aa-353c-873f-8ef8391e5750",
                                        "glosses": [
                                            "Buch des Alten Testaments"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Richter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c0f71756-dae4-382c-9168-613ae9bce0f5",
                                        "entry_id": "a278e3a8-45de-36af-b6ef-85b0a3c2be7c",
                                        "glosses": [
                                            "deutschsprachiger Familienname, Nachname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0698223d-5f12-43c3-af4c-ff4630fe2168",
                                                "sense_id": "c0f71756-dae4-382c-9168-613ae9bce0f5",
                                                "text": "Gestern waren Herr und Frau Richter bei uns."
                                            },
                                            {
                                                "example_id": "2ace4f54-1b72-4669-86aa-5a183ba649fa",
                                                "sense_id": "c0f71756-dae4-382c-9168-613ae9bce0f5",
                                                "text": "Beate Richter habe ich schon lange nicht mehr im Fernsehen gesehen."
                                            },
                                            {
                                                "example_id": "c6f291e0-26a7-4af2-bb72-20d77b963267",
                                                "sense_id": "c0f71756-dae4-382c-9168-613ae9bce0f5",
                                                "text": "Frau Richter ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "55c5cba6-f8a6-4146-9bb0-8d07e6d68a66",
                                                "sense_id": "c0f71756-dae4-382c-9168-613ae9bce0f5",
                                                "text": "Herr Richter wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "09afd77a-97ea-49f4-9448-a7571857660f",
                                                "sense_id": "c0f71756-dae4-382c-9168-613ae9bce0f5",
                                                "text": "Die Richters fahren heute ins Elsterland."
                                            },
                                            {
                                                "example_id": "f844c320-62d4-4747-9dc1-942f0c8733a7",
                                                "sense_id": "c0f71756-dae4-382c-9168-613ae9bce0f5",
                                                "text": "Der Richter trägt nie die Schals, die die Richter ihm strickt."
                                            },
                                            {
                                                "example_id": "8bcd0d89-9e56-4cc6-897b-83bd8abfe37f",
                                                "sense_id": "c0f71756-dae4-382c-9168-613ae9bce0f5",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Richter kommt, geht der Herr Richter.“"
                                            },
                                            {
                                                "example_id": "5b792605-1286-4005-b694-00aaa915faa0",
                                                "sense_id": "c0f71756-dae4-382c-9168-613ae9bce0f5",
                                                "text": "Richter kommt und geht."
                                            },
                                            {
                                                "example_id": "549e2ab8-5e5c-4fd8-8eed-4249a329dba1",
                                                "sense_id": "c0f71756-dae4-382c-9168-613ae9bce0f5",
                                                "text": "Richters kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
