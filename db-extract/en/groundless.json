                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "92ff9cb2-579c-4867-9b19-114e580d3d97",
                                                "sense_id": "548b483d-d2a0-3ba7-b149-eb556df74b1b",
                                                "text": "„Und so sollen alle Ströme der Gnade in uns in das Meer fließen, aus dem sie kamen, in das grundlose, uferlose Meer ewiger Liebe.“"
