                                                "example_id": "cc678c48-1f69-4199-be2d-b76fdc40e446",
                                                "sense_id": "2c2b5741-3a2c-3bdc-89fa-12702de0bdcf",
                                                "text": "Sie war heute wieder besonders charmant."
                                            }
