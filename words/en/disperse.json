{
    "word_family": [
        "dispersal",
        "dispersion",
        "dispersive"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "28d30368-c9c1-33ed-b76a-d0dced2925d5",
                    "sense_definition": "To drive or send off in various directions; to scatter.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "scatter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police used water cannon to <w>disperse</w> the crowd outside the town hall.",
                            "target_lang_translations": {
                                "tr": "Polis, belediye binasının önündeki kalabalığı <w>dağıtmak</w> için tazyikli su kullandı."
                            }
                        },
                        {
                            "text": "Strong winds quickly began to <w>disperse</w> the seeds across the open field.",
                            "target_lang_translations": {
                                "tr": "Şiddetli rüzgârlar tohumları açık araziye hızla <w>savurmaya</w> başladı."
                            }
                        }
                    ],
                    "synonyms": [
                        "scatter",
                        "spread"
                    ],
                    "antonyms": [
                        "assemble",
                        "collect",
                        "round up"
                    ],
                    "common_phrases": [
                        "disperse a crowd",
                        "disperse the protesters"
                    ],
                    "target_lang_definitions": {
                        "tr": "Farklı yönlere sürmek, saçmak veya bir topluluğu birbirinden uzaklaştırarak ayırmak; dağıtmak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "dağıtmak",
                                "target_lang_sense_clarification": "kalabalık veya toplanmış nesneleri ayırmak"
                            },
                            {
                                "target_lang_word": "saçmak",
                                "target_lang_sense_clarification": "etrafa yaymak, savurmak"
                            },
                            {
                                "target_lang_word": "dağılmak",
                                "target_lang_sense_clarification": "kalabalığın kendiliğinden veya etkiyle ayrılması"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "11b26213-17cb-3d0e-825d-a486b8b6c595",
                    "sense_definition": "To break up and vanish; to fade away or dissipate.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "scatter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The thick morning fog began to <w>disperse</w> as the sun rose higher.",
                            "target_lang_translations": {
                                "tr": "Güneş yükseldikçe yoğun sabah sisi <w>dağılmaya</w> başladı."
                            }
                        },
                        {
                            "text": "It took several hours for the smoke to <w>disperse</w> completely from the kitchen.",
                            "target_lang_translations": {
                                "tr": "Dumanın mutfaktan tamamen <w>dağılması</w> birkaç saat sürdü."
                            }
                        }
                    ],
                    "synonyms": [
                        "dissipate",
                        "dispel"
                    ],
                    "common_phrases": [
                        "disperse into the air",
                        "clouds disperse"
                    ],
                    "target_lang_definitions": {
                        "tr": "Parçalanıp yok olmak; yavaş yavaş kaybolmak veya dağılarak etkisini yitirmek."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "dağılmak",
                                "target_lang_sense_clarification": "sis veya dumanın dağılıp yok olması"
                            },
                            {
                                "target_lang_word": "kaybolmak",
                                "target_lang_sense_clarification": "ortadan kalkmak, yok olmak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4fcd98b3-b736-34fd-a361-5bb04e91fb48",
                    "sense_definition": "To spread widely, especially information, ideas, or knowledge.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "spread_info",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The organization works tirelessly to <w>disperse</w> critical health information to rural communities.",
                            "target_lang_translations": {
                                "tr": "Kuruluş, kırsal topluluklara kritik sağlık bilgilerini <w>yaymak</w> için yorulmaksızın çalışıyor."
                            }
                        },
                        {
                            "text": "Digital media has made it much easier to <w>disperse</w> important news across the globe.",
                            "target_lang_translations": {
                                "tr": "Dijital medya, önemli haberleri dünya genelinde <w>yaymayı</w> çok daha kolay hale getirdi."
                            }
                        }
                    ],
                    "synonyms": [
                        "disseminate",
                        "broadcast"
                    ],
                    "common_phrases": [
                        "disperse information",
                        "disperse knowledge"
                    ],
                    "target_lang_definitions": {
                        "tr": "Özellikle bilgi, fikir veya haberleri geniş bir alana veya kitleye iletmek, yaymak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "yaymak",
                                "target_lang_sense_clarification": "bilgi, haber veya fikirleri ulaştırmak"
                            },
                            {
                                "target_lang_word": "dağıtmak",
                                "target_lang_sense_clarification": "bilgi materyallerini iletmek, paylaşmak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7d6a535e-f8d4-3e95-9216-7402cf05e83d",
                    "sense_definition": "To distribute something evenly throughout a medium or space.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "distribute",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The technician stirred the mixture carefully to <w>disperse</w> the dye evenly throughout the liquid.",
                            "target_lang_translations": {
                                "tr": "Teknisyen, boyayı sıvının her yerine eşit biçimde <w>dağıtmak</w> için karışımı dikkatlice karıştırdı."
                            }
                        },
                        {
                            "text": "Tiny oil droplets were able to <w>disperse</w> uniformly through the solvent.",
                            "target_lang_translations": {
                                "tr": "Küçük yağ damlacıkları çözücü içerisinde homojen bir şekilde <w>dağılabildi</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "distribute",
                        "diffuse"
                    ],
                    "common_phrases": [
                        "disperse evenly",
                        "disperse throughout"
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir maddeyi bir ortam veya hacim içinde her tarafa eşit şekilde dağıtmak, yaymak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "dağıtmak",
                                "target_lang_sense_clarification": "karışım içinde homojen biçimde yaymak"
                            },
                            {
                                "target_lang_word": "yaymak",
                                "target_lang_sense_clarification": "ortamın geneline homojen olarak saçmak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0aac4721-1d1a-3709-bdbd-c0eb515aab4b",
                    "sense_definition": "To separate light or radiation into different wavelengths or spectral components.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "physics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A glass prism will <w>disperse</w> white light into a brilliant rainbow of colours.",
                            "target_lang_translations": {
                                "tr": "Bir cam prizma, beyaz ışığı rengârenk bir gökkuşağına <w>ayırır</w>."
                            }
                        },
                        {
                            "text": "The optical lens is specifically designed not to <w>disperse</w> the incoming laser beam.",
                            "target_lang_translations": {
                                "tr": "Optik mercek, gelen lazer ışınını <w>saçmayacak</w> şekilde özel olarak tasarlanmıştır."
                            }
                        }
                    ],
                    "common_phrases": [
                        "disperse light"
                    ],
                    "target_lang_definitions": {
                        "tr": "Işığı veya radyasyonu farklı dalga boylarına ya da spektrum bileşenlerine ayırmak; kırmak veya saçmak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "kırmak",
                                "target_lang_sense_clarification": "ışığı renklerine veya dalga boylarına ayırmak"
                            },
                            {
                                "target_lang_word": "saçmak",
                                "target_lang_sense_clarification": "ışınları farklı yönlere yaymak"
                            },
                            {
                                "target_lang_word": "ayırmak",
                                "target_lang_sense_clarification": "ışık tayfını bileşenlerine ayrıştırmak"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "58d5edc8-3820-310f-ac8a-922a2642da19",
                    "sense_definition": "Scattered, widely separated, or spread out over a large area.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "scatter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The research team studied several <w>disperse</w> settlements scattered across the arid desert region.",
                            "target_lang_translations": {
                                "tr": "Araştırma ekibi, kurak çöl bölgesine yayılmış birkaç <w>dağınık</w> yerleşimi inceledi."
                            }
                        },
                        {
                            "text": "Managing such a <w>disperse</w> network of remote offices proved challenging for the company.",
                            "target_lang_translations": {
                                "tr": "Uzak ofislerden oluşan bu denli <w>dağınık</w> bir ağı yönetmek şirket için zor oldu."
                            }
                        }
                    ],
                    "common_phrases": [
                        "disperse population"
                    ],
                    "target_lang_definitions": {
                        "tr": "Geniş bir alana yayılmış, birbirinden uzak veya dağınık durumda olan."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "dağınık",
                                "target_lang_sense_clarification": "geniş alana yayılmış, seyrek"
                            },
                            {
                                "target_lang_word": "yayılmış",
                                "target_lang_sense_clarification": "farklı yerlere dağılmış"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}