{
    "word_family": [
        "exquisitely",
        "exquisiteness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "efcbec9a-f7e6-36d2-91c1-eb894994c675",
                    "sense_definition": "Extremely beautiful and typically delicate.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "beauty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The museum displayed an <w>exquisite</w> collection of hand-painted porcelain from the eighteenth century.",
                            "target_lang_translations": {
                                "ru": "В музее была представлена <w>изысканная</w> коллекция расписанного вручную фарфора восемнадцатого века.",
                                "tr": "Müze, on sekizinci yüzyıldan kalma <w>enfes</w> bir el boyaması porselen koleksiyonu sergiledi."
                            }
                        },
                        {
                            "text": "She wore an <w>exquisite</w> silk dress that featured intricate embroidery along the sleeves.",
                            "target_lang_translations": {
                                "ru": "На ней было <w>изящное</w> шелковое платье с замысловатой вышивкой на рукавах.",
                                "tr": "Kollarında karmaşık işlemeler bulunan <w>zarif</w> bir ipek elbise giymişti."
                            }
                        }
                    ],
                    "synonyms": [
                        "beautiful",
                        "delicate",
                        "elegant"
                    ],
                    "antonyms": [
                        "crude",
                        "ugly"
                    ],
                    "common_phrases": [
                        "exquisite detail",
                        "exquisite craftsmanship"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чрезвычайно красивый и, как правило, утонченный или хрупкий.",
                        "tr": "Son derece güzel ve genellikle zarif veya narin."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "изящный",
                                "target_lang_sense_clarification": "о красоте и тонкости работы"
                            },
                            {
                                "target_lang_word": "изысканный",
                                "target_lang_sense_clarification": "о стиле и внешнем виде"
                            },
                            {
                                "target_lang_word": "превосходный",
                                "target_lang_sense_clarification": "о красоте"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "zarif",
                                "target_lang_sense_clarification": "güzellik ve incelik hakkında"
                            },
                            {
                                "target_lang_word": "enfes",
                                "target_lang_sense_clarification": "görünüm ve estetik hakkında"
                            },
                            {
                                "target_lang_word": "narin",
                                "target_lang_sense_clarification": "hassas ve ince işçilik hakkında"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a7dbf7e8-3648-3042-93e8-2995cf56eaee",
                    "sense_definition": "Of special or extraordinarily high quality; exceptional.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The restaurant is famous for its <w>exquisite</w> cuisine and impeccable service.",
                            "target_lang_translations": {
                                "ru": "Ресторан славится своей <w>изысканной</w> кухней и безупречным обслуживанием.",
                                "tr": "Restoran, <w>mükemmel</w> mutfağı ve kusursuz hizmetiyle ünlüdür."
                            }
                        },
                        {
                            "text": "They sell good coffee and pastries, but their chocolate is <w>exquisite</w>.",
                            "target_lang_translations": {
                                "ru": "Они продают хороший кофе и выпечку, но их шоколад просто <w>превосходен</w>.",
                                "tr": "İyi kahve ve hamur işleri satıyorlar ama çikolataları <w>olağanüstü</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "excellent",
                        "superb",
                        "perfect"
                    ],
                    "antonyms": [
                        "poor",
                        "inferior"
                    ],
                    "common_phrases": [
                        "exquisite taste",
                        "exquisite meal"
                    ],
                    "target_lang_definitions": {
                        "ru": "Особого или необычайно высокого качества; исключительный.",
                        "tr": "Özel veya olağanüstü yüksek kalitede; seçkin."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "изысканный",
                                "target_lang_sense_clarification": "о еде или вкусе"
                            },
                            {
                                "target_lang_word": "исключительный",
                                "target_lang_sense_clarification": "о качестве"
                            },
                            {
                                "target_lang_word": "редкостный",
                                "target_lang_sense_clarification": "о выдающихся качествах"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "mükemmel",
                                "target_lang_sense_clarification": "kalite hakkında"
                            },
                            {
                                "target_lang_word": "seçkin",
                                "target_lang_sense_clarification": "üstün nitelik hakkında"
                            },
                            {
                                "target_lang_word": "olağanüstü",
                                "target_lang_sense_clarification": "yüksek kalite hakkında"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7d0a048e-602b-32c4-9e32-1189f0f6aa95",
                    "sense_definition": "Intense or sharp, used to describe feelings or sensations.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "intensity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient suffered <w>exquisite</w> pain whenever he tried to move his injured leg.",
                            "target_lang_translations": {
                                "ru": "Пациент испытывал <w>острую</w> боль всякий раз, когда пытался пошевелить поврежденной ногой.",
                                "tr": "Hasta, yaralı bacağını hareket ettirmeye çalıştığında <w>şiddetli</w> bir acı çekiyordu."
                            }
                        },
                        {
                            "text": "Watching the sunset over the ocean brought her a sense of <w>exquisite</w> pleasure.",
                            "target_lang_translations": {
                                "ru": "Наблюдение за закатом над океаном приносило ей чувство <w>утонченного</w> наслаждения.",
                                "tr": "Okyanus üzerinde gün batımını izlemek ona <w>derin</w> bir haz duygusu verdi."
                            }
                        }
                    ],
                    "synonyms": [
                        "intense",
                        "acute",
                        "keen"
                    ],
                    "antonyms": [
                        "mild",
                        "dull"
                    ],
                    "common_phrases": [
                        "exquisite pain",
                        "exquisite pleasure"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often used in medical or literary contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Интенсивный или острый, используется для описания чувств или ощущений.",
                        "tr": "Duyguları veya hisleri tanımlamak için kullanılan yoğun veya keskin."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "острый",
                                "target_lang_sense_clarification": "о боли"
                            },
                            {
                                "target_lang_word": "сильнейший",
                                "target_lang_sense_clarification": "об ощущениях"
                            },
                            {
                                "target_lang_word": "утонченный",
                                "target_lang_sense_clarification": "о наслаждении"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "şiddetli",
                                "target_lang_sense_clarification": "acı hakkında"
                            },
                            {
                                "target_lang_word": "derin",
                                "target_lang_sense_clarification": "haz veya duygu hakkında"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7eea0a2a-5904-3f78-ad41-0aa95676971c",
                    "sense_definition": "Having highly sensitive or discriminating judgment or taste.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "judgment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His <w>exquisite</w> judgment in art allowed him to identify masterpieces before they became famous.",
                            "target_lang_translations": {
                                "ru": "Его <w>тонкое</w> чутье в искусстве позволяло ему распознавать шедевры еще до того, как они становились известными.",
                                "tr": "Sanattaki <w>ince</w> zevki, başyapıtları ünlü olmadan önce teşhis etmesini sağladı."
                            }
                        },
                        {
                            "text": "She has an <w>exquisite</w> ear for music and can detect even the slightest tuning error.",
                            "target_lang_translations": {
                                "ru": "У нее <w>тончайший</w> музыкальный слух, и она способна уловить даже малейшую ошибку в настройке.",
                                "tr": "Müzik konusunda <w>hassas</w> bir kulağı var ve en ufak bir akort hatasını bile fark edebiliyor."
                            }
                        }
                    ],
                    "synonyms": [
                        "discriminating",
                        "refined",
                        "fastidious"
                    ],
                    "antonyms": [
                        "undiscriminating"
                    ],
                    "common_phrases": [
                        "exquisite manners",
                        "exquisite discernment"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обладающий высокой чувствительностью или тонким, разборчивым вкусом.",
                        "tr": "Yüksek hassasiyete veya seçici bir yargı yeteneğine/zevk anlayışına sahip."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тонкий",
                                "target_lang_sense_clarification": "о вкусе или слухе"
                            },
                            {
                                "target_lang_word": "изысканный",
                                "target_lang_sense_clarification": "о манерах или суждениях"
                            },
                            {
                                "target_lang_word": "утонченный",
                                "target_lang_sense_clarification": "о восприятии"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "ince",
                                "target_lang_sense_clarification": "zevk veya duyu hakkında"
                            },
                            {
                                "target_lang_word": "seçici",
                                "target_lang_sense_clarification": "yargı yeteneği hakkında"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "11d41c46-8444-3fc4-9e18-958083de3460",
                    "sense_definition": "Carefully adjusted; precise; accurate; exact.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "precision",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scientist made <w>exquisite</w> measurements to ensure the experiment was perfectly controlled.",
                            "target_lang_translations": {
                                "ru": "Ученый провел <w>высокоточные</w> измерения, чтобы обеспечить идеальный контроль над экспериментом.",
                                "tr": "Bilim insanı, deneyin mükemmel bir şekilde kontrol edildiğinden emin olmak için <w>hassas</w> ölçümler yaptı."
                            }
                        },
                        {
                            "text": "The watchmaker worked with <w>exquisite</w> precision on the tiny gears of the clock.",
                            "target_lang_translations": {
                                "ru": "Часовщик с <w>ювелирной</w> точностью работал над крошечными шестеренками часов.",
                                "tr": "Saatçi, saatin minik dişlileri üzerinde <w>kusursuz</w> bir hassasiyetle çalıştı."
                            }
                        }
                    ],
                    "synonyms": [
                        "precise",
                        "accurate",
                        "exact"
                    ],
                    "antonyms": [
                        "inaccurate",
                        "imprecise"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тщательно выверенный; точный; аккуратный.",
                        "tr": "Dikkatlice ayarlanmış; hassas; doğru; tam."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ювелирный",
                                "target_lang_sense_clarification": "о точности работы"
                            },
                            {
                                "target_lang_word": "высочайший",
                                "target_lang_sense_clarification": "о степени точности"
                            },
                            {
                                "target_lang_word": "прецизионный",
                                "target_lang_sense_clarification": "о измерениях"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "hassas",
                                "target_lang_sense_clarification": "ölçüm veya çalışma hakkında"
                            },
                            {
                                "target_lang_word": "kusursuz",
                                "target_lang_sense_clarification": "doğruluk hakkında"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6f9414a0-2d18-3e6c-8a4c-0481be7a78d3",
                    "sense_definition": "A man who is excessively concerned about his clothes and appearance; a dandy.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young <w>exquisite</w> spent hours every morning selecting the perfect silk cravat.",
                            "target_lang_translations": {
                                "ru": "Молодой <w>щеголь</w> каждое утро часами выбирал идеальный шелковый галстук.",
                                "tr": "Genç <w>züppe</w>, her sabah mükemmel ipek kravatı seçmek için saatler harcardı."
                            }
                        },
                        {
                            "text": "He was known as a Broadway <w>exquisite</w>, always dressed in the latest and most expensive fashions.",
                            "target_lang_translations": {
                                "ru": "Он был известен как бродвейский <w>денди</w>, всегда одетый по последней и самой дорогой моде.",
                                "tr": "Her zaman en son ve en pahalı moda kıyafetlerle giyinen, Broadway'in <w>şık</w> bir adamı olarak bilinirdi."
                            }
                        }
                    ],
                    "synonyms": [
                        "dandy",
                        "fop",
                        "beau"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "this noun sense is rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Мужчина, чрезмерно заботящийся о своей одежде и внешности; денди.",
                        "tr": "Giyimine ve dış görünüşüne aşırı derecede önem veren erkek; züppe."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "щеголь",
                                "target_lang_sense_clarification": "о человеке"
                            },
                            {
                                "target_lang_word": "денди",
                                "target_lang_sense_clarification": "о человеке"
                            },
                            {
                                "target_lang_word": "франт",
                                "target_lang_sense_clarification": "о человеке"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "züppe",
                                "target_lang_sense_clarification": "kişi hakkında"
                            },
                            {
                                "target_lang_word": "şık",
                                "target_lang_sense_clarification": "giyim tarzı hakkında"
                            },
                            {
                                "target_lang_word": "fiyakalı",
                                "target_lang_sense_clarification": "görünüş hakkında"
                            }
                        ]
                    }
                }
            ]
        }
