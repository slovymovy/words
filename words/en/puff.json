{
    "word_family": [
        "puffball",
        "puffer",
        "puffery",
        "puffin",
        "puffiness",
        "puffy"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0c247b36-6469-32eb-855b-f768bc6a16a3",
                    "sense_definition": "A small quantity of gas or smoke in the air.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "air_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A small <w>puff</w> of smoke rose from the chimney as the fire started.",
                            "target_lang_translations": {
                                "ru": "Небольшой <w>клубок</w> дыма поднялся из трубы, когда разгорелся огонь."
                            }
                        },
                        {
                            "text": "The steam engine released a <w>puff</w> of white vapor into the cold morning air.",
                            "target_lang_translations": {
                                "ru": "Паровоз выпустил <w>облачко</w> белого пара в холодный утренний воздух."
                            }
                        }
                    ],
                    "common_phrases": [
                        "puff of smoke",
                        "puff of steam"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшое количество газа или дыма в воздухе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "клубок",
                                "target_lang_sense_clarification": "дыма или пара"
                            },
                            {
                                "target_lang_word": "облачко",
                                "target_lang_sense_clarification": "небольшое скопление газа"
                            },
                            {
                                "target_lang_word": "струйка",
                                "target_lang_sense_clarification": "тонкий поток дыма"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2a0e337e-aa87-3a38-8acb-867c77e2060d",
                    "sense_definition": "A light cake filled with cream, cream cheese, or other soft fillings.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She bought a delicious cream <w>puff</w> from the local bakery for dessert.",
                            "target_lang_translations": {
                                "ru": "Она купила в местной пекарне на десерт вкусный <w>профитроль</w> с кремом."
                            }
                        },
                        {
                            "text": "The tray was filled with every kind of pastry, including a chocolate <w>puff</w>.",
                            "target_lang_translations": {
                                "ru": "Поднос был уставлен всевозможной выпечкой, включая шоколадную <w>слойку</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "pastry",
                        "cream puff"
                    ],
                    "common_phrases": [
                        "cream puff",
                        "cocoa puff"
                    ],
                    "target_lang_definitions": {
                        "ru": "Легкое пирожное с кремом или другой мягкой начинкой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "профитроль",
                                "target_lang_sense_clarification": "маленькое пирожное из заварного теста"
                            },
                            {
                                "target_lang_word": "слойка",
                                "target_lang_sense_clarification": "изделие из слоеного теста"
                            },
                            {
                                "target_lang_word": "заварное пирожное",
                                "target_lang_sense_clarification": "общее название"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6d25cad8-4ca2-39b5-9451-ebbe0274ad7f",
                    "sense_definition": "A sharp exhalation of a small amount of breath through the mouth.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "breath",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "With a <w>puff</w> of air, she blew out the single candle on her cupcake.",
                            "target_lang_translations": {
                                "ru": "Одним <w>выдохом</w> она задула единственную свечу на своем кексе."
                            }
                        },
                        {
                            "text": "He gave a short <w>puff</w> to clear the dust off the old book cover.",
                            "target_lang_translations": {
                                "ru": "Он коротко <w>дунул</w>, чтобы смахнуть пыль со старой книжной обложки."
                            }
                        }
                    ],
                    "common_phrases": [
                        "puff of air",
                        "short puff"
                    ],
                    "target_lang_definitions": {
                        "ru": "Резкий выдох небольшого количества воздуха через рот."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выдох",
                                "target_lang_sense_clarification": "короткий и резкий"
                            },
                            {
                                "target_lang_word": "дуновение",
                                "target_lang_sense_clarification": "легкий поток воздуха изо рта"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0bb0e6e7-d6b4-3994-8ac4-c1e19a985f4a",
                    "sense_definition": "An act of inhaling smoke from a cigarette, cigar, or pipe.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "smoking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He took a long <w>puff</w> on his cigar while thinking about the problem.",
                            "target_lang_translations": {
                                "ru": "Он сделал глубокую <w>затяжку</w> сигарой, размышляя над проблемой."
                            }
                        },
                        {
                            "text": "She paused for a <w>puff</w> of her cigarette before continuing the story.",
                            "target_lang_translations": {
                                "ru": "Она прервалась на <w>затяжку</w>, прежде чем продолжить рассказ."
                            }
                        }
                    ],
                    "synonyms": [
                        "drag"
                    ],
                    "common_phrases": [
                        "take a puff"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт вдыхания дыма сигареты, сигары или трубки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "затяжка",
                                "target_lang_sense_clarification": "вдох при курении"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "56364be9-3c5d-3b79-a8a9-702208978073",
                    "sense_definition": "A sudden but small gust of wind.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "air_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A sudden <w>puff</w> of wind caught the sails and moved the boat forward.",
                            "target_lang_translations": {
                                "ru": "Внезапный <w>порыв</w> ветра наполнил паруса и погнал лодку вперед."
                            }
                        },
                        {
                            "text": "The curtains fluttered slightly with every <w>puff</w> of wind from the open window.",
                            "target_lang_translations": {
                                "ru": "Шторы слегка колыхались от каждого <w>дуновения</w> ветра из открытого окна."
                            }
                        }
                    ],
                    "synonyms": [
                        "wind"
                    ],
                    "common_phrases": [
                        "puff of wind"
                    ],
                    "target_lang_definitions": {
                        "ru": "Внезапный, но слабый порыв ветра."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "порыв",
                                "target_lang_sense_clarification": "ветра"
                            },
                            {
                                "target_lang_word": "дуновение",
                                "target_lang_sense_clarification": "легкий ветерок"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "489492e7-2e67-3f6b-a1c0-11875faafdfe",
                    "sense_definition": "The ability to breathe easily while exerting oneself.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "breath",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After running up the steep hill, the athlete was completely out of <w>puff</w>.",
                            "target_lang_translations": {
                                "ru": "После бега на крутой холм атлет совсем выбился из <w>сил</w> (у него кончилась дыхалка)."
                            }
                        },
                        {
                            "text": "It took him a few minutes to get his <w>puff</w> back after the race.",
                            "target_lang_translations": {
                                "ru": "Ему потребовалось несколько минут, чтобы восстановить <w>дыхание</w> после забега."
                            }
                        }
                    ],
                    "common_phrases": [
                        "out of puff"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Commonly used in British English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Способность легко дышать при физической нагрузке."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дыхалка",
                                "target_lang_sense_clarification": "выносливость, дыхание"
                            },
                            {
                                "target_lang_word": "дыхание",
                                "target_lang_sense_clarification": "способность дышать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3013defd-e137-3260-93b4-1c90df21254a",
                    "sense_definition": "A portion of fabric gathered up so as to be left full in the middle.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "clothing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dress featured a stylish <w>puff</w> at the shoulder for a vintage look.",
                            "target_lang_translations": {
                                "ru": "Платье было украшено стильным <w>буфом</w> на плече для создания винтажного образа."
                            }
                        },
                        {
                            "text": "She adjusted the <w>puff</w> of her sleeve before walking onto the stage.",
                            "target_lang_translations": {
                                "ru": "Она поправила <w>фонарик</w> на рукаве, прежде чем выйти на сцену."
                            }
                        }
                    ],
                    "common_phrases": [
                        "shoulder puff"
                    ],
                    "target_lang_definitions": {
                        "ru": "Часть ткани, собранная так, чтобы она оставалась пышной посередине."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "буф",
                                "target_lang_sense_clarification": "пышная сборка на одежде"
                            },
                            {
                                "target_lang_word": "фонарик",
                                "target_lang_sense_clarification": "о фасоне рукава"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "52c1e615-78b9-3dc6-9ccb-0e7c3950c993",
                    "sense_definition": "A soft pad used for applying powder to the skin.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "cosmetics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She used a large powder <w>puff</w> to apply the finishing touches to her makeup.",
                            "target_lang_translations": {
                                "ru": "Она использовала большую <w>пуховку</w>, чтобы нанести последние штрихи в макияже."
                            }
                        },
                        {
                            "text": "The vintage vanity set included a silver bowl and a soft <w>puff</w>.",
                            "target_lang_translations": {
                                "ru": "В винтажный туалетный набор входила серебряная чаша и мягкая <w>пуховка</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "powder puff"
                    ],
                    "target_lang_definitions": {
                        "ru": "Мягкая подушечка для нанесения пудры на кожу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пуховка",
                                "target_lang_sense_clarification": "для косметической пудры"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6e3594f8-dd91-38db-ab18-5cabf02af020",
                    "sense_definition": "A flamboyant or alluring statement of praise, often used for promotion.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "praise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The book's jacket was covered in marketing <w>puffs</w> from other famous authors.",
                            "target_lang_translations": {
                                "ru": "Обложка книги была усыпана рекламными <w>отзывами</w> других известных авторов."
                            }
                        },
                        {
                            "text": "Critics often dismiss such glowing reviews as mere commercial <w>puffs</w>.",
                            "target_lang_translations": {
                                "ru": "Критики часто отвергают такие восторженные отзывы как обычную коммерческую <w>завлекаловку</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "critical puff"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чрезмерно восторженное или завлекающее хвалебное заявление, часто используемое для рекламы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рекламный трюк",
                                "target_lang_sense_clarification": "преувеличенная похвала"
                            },
                            {
                                "target_lang_word": "дифирамб",
                                "target_lang_sense_clarification": "преувеличенная похвала"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a0f6ad8e-a5ac-3b08-9439-1b6b373d04ae",
                    "sense_definition": "The drug cannabis.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "drugs",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police found a small amount of <w>puff</w> in the suspect's pocket.",
                            "target_lang_translations": {
                                "ru": "Полиция нашла небольшое количество <w>травки</w> в кармане подозреваемого."
                            }
                        },
                        {
                            "text": "He was known in the neighborhood for selling <w>puff</w> to teenagers.",
                            "target_lang_translations": {
                                "ru": "В округе он был известен тем, что продавал <w>анашу</w> подросткам."
                            }
                        }
                    ],
                    "synonyms": [
                        "cannabis",
                        "dope",
                        "ganja",
                        "grass",
                        "marijuana",
                        "pot",
                        "weed"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Informal term for marijuana"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Наркотик каннабис."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "травка",
                                "target_lang_sense_clarification": "сленговое название марихуаны"
                            },
                            {
                                "target_lang_word": "анаша",
                                "target_lang_sense_clarification": "наркотик из конопли"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "06484622-3e58-3a79-96a8-af6d7b7b1799",
                    "sense_definition": "A derogatory term for a gay man, especially one perceived as effeminate.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "people",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bully used the word <w>puff</w> as an insult on the playground.",
                            "target_lang_translations": {
                                "ru": "Хулиган использовал слово <w>гомик</w> как оскорбление на детской площадке."
                            }
                        },
                        {
                            "text": "Using the term <w>puff</w> in that context is considered highly offensive.",
                            "target_lang_translations": {
                                "ru": "Использование термина <w>puff</w> в таком контексте считается крайне оскорбительным."
                            }
                        }
                    ],
                    "synonyms": [
                        "poof"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Offensive and derogatory"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Оскорбительное обозначение гомосексуального мужчины, особенно воспринимаемого как женственный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гомик",
                                "target_lang_sense_clarification": "презрительное"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b1203e73-5a48-3050-b0ee-2c45fb10fa03",
                    "sense_definition": "To emit smoke, gas, or steam in short, sudden bursts.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "emission",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old steam engine <w>puffed</w> away as it pulled the heavy train.",
                            "target_lang_translations": {
                                "ru": "Старый паровоз <w>пыхтел</w>, таща за собой тяжелый состав."
                            }
                        },
                        {
                            "text": "The chimney <w>puffed</w> out thick black smoke into the clear blue sky.",
                            "target_lang_translations": {
                                "ru": "Труба <w>выбрасывала</w> густой черный дым в чистое голубое небо."
                            }
                        }
                    ],
                    "common_phrases": [
                        "puff away",
                        "puff out"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выпускать дым, газ или пар короткими, резкими вспышками."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пыхтеть",
                                "target_lang_sense_clarification": "выпускать пар или дым"
                            },
                            {
                                "target_lang_word": "дымить",
                                "target_lang_sense_clarification": "выпускать дым"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bbb042d9-a07c-3e7b-a056-befde4e36d83",
                    "sense_definition": "To breathe loudly and quickly, usually after hard physical exercise.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "breath",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was <w>puffing</w> and panting by the time he reached the top.",
                            "target_lang_translations": {
                                "ru": "Он <w>пыхтел</w> и отдувался к тому времени, как добрался до вершины."
                            }
                        },
                        {
                            "text": "The runners were <w>puffing</w> hard as they crossed the finish line.",
                            "target_lang_translations": {
                                "ru": "Бегуны тяжело <w>дышали</w>, пересекая финишную черту."
                            }
                        }
                    ],
                    "common_phrases": [
                        "puff and pant"
                    ],
                    "target_lang_definitions": {
                        "ru": "Громко и часто дышать, обычно после тяжелой физической нагрузки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пыхтеть",
                                "target_lang_sense_clarification": "тяжело дышать"
                            },
                            {
                                "target_lang_word": "запыхаться",
                                "target_lang_sense_clarification": "сбиться с дыхания"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9acb0a0d-e666-3491-bd7b-68d63faf7a0d",
                    "sense_definition": "To cause something to swell or expand with air or fluid.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "expansion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bird <w>puffed</w> its feathers to stay warm in the winter.",
                            "target_lang_translations": {
                                "ru": "Птица <w>взъерошила</w> перья, чтобы согреться зимой."
                            }
                        },
                        {
                            "text": "He <w>puffed</w> out his cheeks and blew a loud whistle.",
                            "target_lang_translations": {
                                "ru": "Он <w>надул</w> щеки и громко свистнул."
                            }
                        }
                    ],
                    "common_phrases": [
                        "puff out",
                        "puff up"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заставлять что-либо раздуваться или расширяться с помощью воздуха или жидкости."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "взъерошивать",
                                "target_lang_sense_clarification": "о перьях"
                            },
                            {
                                "target_lang_word": "раздувать",
                                "target_lang_sense_clarification": "наполнять воздухом"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "42d23bb6-7fd8-3f6d-82d2-eceefda60ea8",
                    "sense_definition": "To make someone feel proud or conceited.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young soldier was <w>puffed</w> up with pride after receiving his medal.",
                            "target_lang_translations": {
                                "ru": "Молодой солдат <w>раздулся</w> от гордости после получения медали."
                            }
                        },
                        {
