                        "glosses": [
                            "boek van het Nieuwe Testament in de vorm van een brief van Paulus aan de christenen in Kolossi"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d84b604-4dba-4f59-8110-83c75bba68cf",
                                "sense_id": "a6fb1d41-e650-3a99-b2a8-b9b2ede8da69",
                                "text": "De reactie die `Efeziërs’ vormt op `Kolossenzen’ weerspiegelt dus een discussie over de status van de kosmos zoals die ook buiten de christelijke kerk werd gevoerd."
                            }
                        ]
                    }
                ],
                "translations": [
