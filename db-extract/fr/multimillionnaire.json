                        "entry_id": "0f8f486b-5983-3272-913a-ddce00702eb9",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "multimillionnaires"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ac83bae5-8644-35d5-a80b-75345895ada3",
                        "entry_id": "0f8f486b-5983-3272-913a-ddce00702eb9",
                        "glosses": [
                            "Qui possède plusieurs millions (de dollars, d’euro, etc.)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ccd2eb02-30e1-43ea-aee2-4c8f8d464336",
                                "sense_id": "ac83bae5-8644-35d5-a80b-75345895ada3",
                                "text": "Le multimillionnaire armateur grec, faisant un bref déplacement sur la côte d’Azur, honorait ce soir-là de sa visite la Résidence de Bois-Joli."
                            },
                            {
                                "example_id": "471693a4-59f2-4a9e-9b48-647fd1b4517a",
                                "sense_id": "ac83bae5-8644-35d5-a80b-75345895ada3",
                                "text": "Les gosses les plus riches de son lycée, dont les pères multimillionnaires fréquentaient des country-clubs ultra-sélects, considéraient qu’ils faisaient partie de la classe moyenne."
                            }
                        ]
                    },
                    {
                        "sense_id": "fbbdfe84-c9c5-3c73-9f7e-85f148cf33f7",
                        "entry_id": "0f8f486b-5983-3272-913a-ddce00702eb9",
                        "glosses": [
                            "Relatif à plusieurs millions (de dollars, d’euro, etc.)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac5959ff-833e-4cba-96c3-53642f51a69e",
                                "sense_id": "fbbdfe84-c9c5-3c73-9f7e-85f148cf33f7",
                                "text": "Donc, la réponse à votre multimillionnaire proposition est : non."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "83cb39cb-6f91-3c73-80b7-799bb400ac45",
                "word": "multimillionnaire",
                "pos": "noun",
                "lang_code": "fr",
