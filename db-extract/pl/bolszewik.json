                        "source_entry_id": "cd38d82d-97cf-35db-ad1b-a4b61e611f6f",
                        "source_sense_id": "8ac75b5f-e562-39cd-92b1-e53f5ba60099",
                        "target_lang_word": "bolchevique",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bolchevique",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "e90f3da7-c007-3610-a5d6-d9c12d746dfa",
                                        "entry_id": "73f3dc6f-414d-3474-a62e-9d678f8a0f43",
                                        "glosses": [
                                            "Propio de o relativo a la facción radical del Partido Obrero Socialdemócrata de Rusia dirigida por Vladimir Lenin, que abogaba por una modificación revolucionaria del régimen político y económico."
                                        ],
                                        "tags": [
                                            "Política"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c9834e6-9fcb-4873-b530-be75a953661b",
                                                "sense_id": "e90f3da7-c007-3610-a5d6-d9c12d746dfa",
                                                "text": "Pero la Revolución rusa y el advenimiento al Poder del Partido comunista o bolchevique ha tenido trascendentales consecuencias en todo el mundo."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "11e2c216-be75-3e47-99a5-54fcf648627b",
                                        "entry_id": "73f3dc6f-414d-3474-a62e-9d678f8a0f43",
                                        "glosses": [
                                            "Que promueve las ideas del bando bolchevique₁."
                                        ],
                                        "tags": [
                                            "noun"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d42dec49-3332-432e-8978-cb29bc643ee9",
                                                "sense_id": "11e2c216-be75-3e47-99a5-54fcf648627b",
                                                "text": "Todos pensaron en Máximo Gorki, aunque éste no se había adherido a los bolcheviques, manteniéndose alejado de la política."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "ab42d451-a22b-3ce2-a621-e518afcea454",
                                        "entry_id": "73f3dc6f-414d-3474-a62e-9d678f8a0f43",
                                        "glosses": [
                                            "Por extensión, propio de o relativo al socialismo o el comunismo revolucionario."
                                        ],
                                        "tags": [
                                            "Política"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d45f35ab-7871-479f-872a-d464d8231350",
                                                "sense_id": "ab42d451-a22b-3ce2-a621-e518afcea454",
                                                "text": "Jorge Sorel, crítico acerbo de la degeneración reformista del socialismo, aprobaba el método clasista de los bolcheviques."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "6fe78468-edeb-37a8-b98e-dfd57f5a7345",
                                        "entry_id": "73f3dc6f-414d-3474-a62e-9d678f8a0f43",
                                        "glosses": [
                                            "Que promueve las ideas del bando bolchevique₃."
                                        ],
                                        "tags": [
                                            "noun"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "5df2b07d-eeef-397c-93dc-76acc963df83",
                                        "entry_id": "73f3dc6f-414d-3474-a62e-9d678f8a0f43",
                                        "glosses": [
                                            "Por extensión, propio de o relativo a la izquierda política."
                                        ],
                                        "tags": [
                                            "Política"
                                        ],
