                        ],
                        "form": "die Schwermut"
                    },
                    {
                        "form_id": "17f977ef-90af-46da-b7d5-f77d1cbca5d9",
                        "entry_id": "1b4a0c62-0be1-339d-a728-8cfd2fdf3314",
                        "tags": [
