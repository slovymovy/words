                        "glosses": [
                            "taal die in Cambodja gesproken wordt"
                        ],
                        "tags": [
                            "linguistics",
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "bb410381-1bc1-4b9a-84ed-6124fa92b1f5",
                                "sense_id": "79647fb4-ca77-3845-a0d7-97c4a624994c",
                                "text": "Een man uit Cambodja bezoekt mijn spreekuur in verband met hepatitis B. De patiënt spreekt uitsluitend Khmer, waardoor het gesprek via de Tolkentelefoon wordt gevoerd."
                            },
                            {
                                "example_id": "d874b18d-6dda-4dee-b0e1-c66691576588",
                                "sense_id": "79647fb4-ca77-3845-a0d7-97c4a624994c",
                                "text": "Aangezien mijn Hebreeuws bijna zo goed is als mijn Tolmeeks of Khmer, zou ik er niet uit kunnen citeren."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
