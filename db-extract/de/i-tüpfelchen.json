                ],
                "senses": [
                    {
                        "sense_id": "134ddcac-be6c-3559-8b74-fabd02758716",
                        "entry_id": "938de698-81a6-3e04-83d4-8dd2c82c5a22",
                        "glosses": [
                            "der Punkt über dem kleinen i"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "108520fc-e8ca-4aa2-829a-1b3caff9f12e",
                                "sense_id": "134ddcac-be6c-3559-8b74-fabd02758716",
                                "text": "Sie hat eine sehr mädchenhafte Handschrift, manchmal malt sie sogar Herzchen anstelle der i-Tüpfelchen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3b7b0651-7680-376d-bbff-f0056bc21f13",
                        "entry_id": "938de698-81a6-3e04-83d4-8dd2c82c5a22",
                        "glosses": [
                            "kleine zusätzliche Beigabe zu etwas, Krönung von etwas"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "a86c6cde-4ab5-4b99-adcf-e21ea67aaf98",
                                "sense_id": "3b7b0651-7680-376d-bbff-f0056bc21f13",
                                "text": "Schnee am 24.12., das ist das i-Tüpfelchen für perfekte Weihnachten."
                            },
                            {
                                "example_id": "7e366886-580f-4f77-98e0-bfaaa061c5e7",
                                "sense_id": "3b7b0651-7680-376d-bbff-f0056bc21f13",
                                "text": "Ich gönne meiner Tochter ihre glückliche Beziehung sehr, aber meine Enkelin, sie ist das i-Tüpfelchen."
                            },
                            {
                                "example_id": "1db9fe0d-4332-4c7d-9dfd-190c333f50b1",
                                "sense_id": "3b7b0651-7680-376d-bbff-f0056bc21f13",
                                "text": "„Vanillesoße ist für viele das i-Tüpfelchen auf Nachspeisen wie Kaiserschmarrn, Roter Grütze oder Apfelstrudel.“"
                            },
                            {
                                "example_id": "fcb44f08-6d23-4a9b-9e0f-7c1504004258",
                                "sense_id": "3b7b0651-7680-376d-bbff-f0056bc21f13",
                                "text": "„Dass die Dose noch immer verschlossen ist, ist für mich so etwas wie das i-Tüpfelchen, obwohl Bier- oder Coladosen, die man am Strand findet, oft voll sind – sie schwimmen dank der kleinen Luftblase in der verschlossenen Dose.“"
                            },
                            {
                                "example_id": "ebbbe632-38ed-4a1e-b724-9a316174ea10",
                                "sense_id": "3b7b0651-7680-376d-bbff-f0056bc21f13",
                                "text": "[Rudern – Goldmedaille für den Deutschlandachter:] „»Das ist das i-Tüpfelchen auf eine ganze tolle Saison«, sagte Trainer Bender über seine im gesamten Jahr 2017 ungeschlagene Mannschaft […].“"
                            },
                            {
                                "example_id": "f655e7e0-1e61-48fa-9eae-e1c20fa7e9fe",
                                "sense_id": "3b7b0651-7680-376d-bbff-f0056bc21f13",
                                "text": "„[…] Im Supercup bezwang der THW den großen Rivalen aus Flensburg mit 28:24 (14:13). Damit feierte er den zehnten Supercup-Sieg der Vereinsgeschichte. Das i-Tüpfelchen waren für alle Beteiligten wohl die 2.100 Zuschauer, die trotz Corona-Krise in der Düsseldorfer Halle dabei sein durften.“"
                            },
                            {
                                "example_id": "944f4b69-a2e6-43ad-904f-2d838f6f2ec1",
                                "sense_id": "3b7b0651-7680-376d-bbff-f0056bc21f13",
                                "text": "[Abstieg des 1. FC Köln aus derBundesliga:] „»Das 2:3 war das i-Tüpfelchen einer völlig verkorksten Saison«, befand FC-Torwart Timo Horn hinterher - und hatte recht.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
