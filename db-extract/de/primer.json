                "senses": [
                    {
                        "sense_id": "287adc97-e567-31f8-b802-cd8fc74f6a88",
                        "entry_id": "02731be0-90ee-33b5-9a5c-1e10713e364b",
                        "glosses": [
                            "die Grundierung einer Beschichtung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61d5b5b1-e504-416b-81e1-b5873bec84b0",
                                "sense_id": "287adc97-e567-31f8-b802-cd8fc74f6a88",
                                "text": "Tragen Sie zunächst den Primer auf und lassen Sie ihn gut durchtrocknen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ca52ac4e-2d0d-3c79-b017-3a4b097c0b7f",
                        "entry_id": "02731be0-90ee-33b5-9a5c-1e10713e364b",
                        "glosses": [
                            "ein Haftvermittler zur Verbesserung der Adhäsion"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e668452-a8a3-46a9-bf65-15be414f055d",
                                "sense_id": "ca52ac4e-2d0d-3c79-b017-3a4b097c0b7f",
                                "text": "„Primer können aber chemisch auch andersartig zusammengesetzt sein als die Klebstoffe, um eine gezielte Beeinflussung der Adhäsion und der Korrosionsbeständigkeit der Verbunde zu erreichen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "a97e33ef-1444-3be0-b2d6-a3fb07bc3505",
                        "entry_id": "02731be0-90ee-33b5-9a5c-1e10713e364b",
                        "glosses": [
                            "eine Kaltstartvorrichtung an Vergasern von kleinen Verbrennungsmotoren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ca4818f-f852-4367-a027-6b775a6bc6ac",
                                "sense_id": "a97e33ef-1444-3be0-b2d6-a3fb07bc3505",
                                "text": "„Als nächstes wird die Kaltstartklappe (Choke) betätigt und etwas Benzin in den Vergaser gepumpt (Primer/Handpumpe).“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "ee9a258f-c0bd-3815-94dc-dcda46908167",
                        "entry_id": "02731be0-90ee-33b5-9a5c-1e10713e364b",
                        "glosses": [
                            "Grundsubstanz für eine DNA-Polymerase in der Molekularindustrie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5c0f237-d186-4311-a15e-ebead624a0af",
                                "sense_id": "ee9a258f-c0bd-3815-94dc-dcda46908167",
                                "text": "„Hierbei werden mehrfach wiederholt beide komplementäre DNA-Stränge simultan kopiert, wobei der synthetisierte DNA-Bereich durch zwei Primer begrenzt wird.“"
                            }
                        ],
                        "sense_index_json": "\"4\""
                    }
                ],
