                "senses": [
                    {
                        "sense_id": "8cad0ec4-8a0b-32eb-b20f-789742734f54",
                        "entry_id": "fea509ff-088a-332b-849a-cdc412c1b6da",
                        "glosses": [
                            "(Dans certaines expressions) Cause ou source de contentieux ou de discorde."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "e238cbad-ee82-44b5-87ad-6ecaea04780d",
                                "sense_id": "8cad0ec4-8a0b-32eb-b20f-789742734f54",
                                "text": "Les braises du refus du président de recevoir son mari comme chef d'État sont encore chaudes […]."
                            },
                            {
                                "example_id": "75af1f41-9e83-4965-9d7b-1b17d5f888ad",
                                "sense_id": "8cad0ec4-8a0b-32eb-b20f-789742734f54",
                                "text": "Le bois d’oeuvre a longtemps été une source de discorde entre le Canada et les États-Unis et la dernière année a ravivé, pour une cinquième fois, les braises de cette dispute commerciale ayant pris racine dans les années 1980."
                            },
                            {
                                "example_id": "390e470a-f1ab-4455-ad83-0f0aead0bf42",
                                "sense_id": "8cad0ec4-8a0b-32eb-b20f-789742734f54",
                                "text": "Philippe Couillard a accusé mercredi la Coalition avenir Québec (CAQ) de « souffler sur les braises de l’intolérance » en remettant en question l’accueil d’immigrants supplémentaires au Québec."
                            }
                        ]
                    }
