                "senses": [
                    {
                        "sense_id": "b0223326-4c1b-394c-8cd0-6d1719402e25",
                        "entry_id": "3588e2e5-630d-30ff-ab5c-50f6c23580e6",
                        "glosses": [
                            "Qui concerne à la fois l’esprit et le corps."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e3794f9-4fd8-4076-a857-a91a3fa1a832",
                                "sense_id": "b0223326-4c1b-394c-8cd0-6d1719402e25",
                                "text": "De nombreuses méthodes partagent cette approche d’authenticité et de respect de la personne : la gestalt-thérapie, l’approche centrée sur la personne, l’analyse transactionnelle, ou encore les thérapies psychocorporelles."
                            },
                            {
                                "example_id": "acad55e2-3844-4b1f-8392-49009cbc624c",
                                "sense_id": "b0223326-4c1b-394c-8cd0-6d1719402e25",
                                "text": "L’agitation et la retenue, qui s’expriment à différents niveaux psychomoteurs et dans lesquels intervient l’enveloppe psychocorporelle, peuvent tirer leurs origines des défaillances de cette dernière."
                            },
                            {
                                "example_id": "0b80c4d7-56ef-476c-9cc3-cda53fd396f5",
                                "sense_id": "b0223326-4c1b-394c-8cd0-6d1719402e25",
                                "text": "Les exercices psychocorporels ont pour but de vous faire vivre votre corporalité, d’élargir votre champ de conscience pour entrer dans une perception de plus en plus fine du corps."
                            }
                        ]
                    }
