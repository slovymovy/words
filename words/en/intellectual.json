{
    "word_family": [
        "intellect",
        "intellectually",
        "intellectualism",
        "intellectualize"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e5bdd5b6-72ee-3a18-a128-8e65b15d2bbd",
                    "sense_definition": "Relating to the ability to think and understand ideas and information; mental or cognitive.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "mental_capacity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The game is designed to test your <w>intellectual</w> ability and problem-solving skills.",
                            "target_lang_translations": {
                                "ru": "Эта игра разработана для проверки ваших <w>интеллектуальных</w> способностей и навыков решения проблем.",
                                "zh": "这款游戏旨在测试你的<w>智力</w>水平和解决问题的能力。"
                            }
                        },
                        {
                            "text": "Companies must take legal action to protect their <w>intellectual</w> property from theft.",
                            "target_lang_translations": {
                                "ru": "Компании должны предпринимать правовые действия для защиты своей <w>интеллектуальной</w> собственности от кражи.",
                                "zh": "公司必须采取法律行动，以保护其<w>知识产权</w>免遭窃取。"
                            }
                        }
                    ],
                    "synonyms": [
                        "mental",
                        "cerebral",
                        "rational"
                    ],
                    "antonyms": [
                        "visceral"
                    ],
                    "common_phrases": [
                        "intellectual property",
                        "intellectual ability",
                        "intellectual development",
                        "intellectual freedom"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к способности мыслить и понимать идеи; умственный или когнитивный.",
                        "zh": "与思考和理解概念及信息的能力有关的；智力的或认知的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "интеллектуа́льный",
                                "target_lang_sense_clarification": "относящийся к интеллекту (напр. собственность, способности)"
                            },
                            {
                                "target_lang_word": "у́мственный",
                                "target_lang_sense_clarification": "связанный с деятельностью ума"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "智力的",
                                "target_lang_sense_clarification": "与智力活动相关的"
                            },
                            {
                                "target_lang_word": "脑力的",
                                "target_lang_sense_clarification": "涉及思维活动的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "95c58ff5-70e4-38d0-9525-93ee2141fc57",
                    "sense_definition": "Having a high level of education and a keen interest in complex ideas and thinking.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "person_attribute",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is a very <w>intellectual</w> person who enjoys reading philosophy and history.",
                            "target_lang_translations": {
                                "ru": "Она очень <w>интеллектуальный</w> человек, которому нравится читать философию и историю.",
                                "zh": "她是一个非常有<w>思想</w>的人，喜欢阅读哲学和历史书籍。"
                            }
                        },
                        {
                            "text": "His <w>intellectual</w> curiosity drove him to explore subjects far beyond his school curriculum.",
                            "target_lang_translations": {
                                "ru": "Его <w>интеллектуальное</w> любопытство заставило его изучать предметы, выходящие далеко за рамки школьной программы.",
                                "zh": "他那强烈的<w>求知欲</w>驱使他去探索远超学校课程范围的学科。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cerebral",
                        "academic"
                    ],
                    "antonyms": [
                        "nonintellectual"
                    ],
                    "common_phrases": [
                        "intellectual curiosity",
                        "intellectual elite"
                    ],
                    "target_lang_definitions": {
                        "ru": "Высокообразованный, проявляющий живой интерес к сложным идеям и мышлению.",
                        "zh": "受过良好教育，对复杂思想和思考有浓厚兴趣的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "интеллектуа́льный",
                                "target_lang_sense_clarification": "обладающий высоким интеллектом"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "知识分子的",
                                "target_lang_sense_clarification": "具有知识分子特质的"
                            },
                            {
                                "target_lang_word": "有思想的",
                                "target_lang_sense_clarification": "善于思考的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "10910db7-ab06-3750-bb41-0747b22ac811",
                    "sense_definition": "Involving serious study and deep thought; suitable for exercising the intellect.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "activity_attribute",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They engaged in an <w>intellectual</w> discussion about the future of the economy.",
                            "target_lang_translations": {
                                "ru": "Они вступили в <w>интеллектуальную</w> дискуссию о будущем экономики.",
                                "zh": "他们就经济的未来进行了一场<w>学术性</w>的讨论。"
                            }
                        },
                        {
                            "text": "He found the job boring because it offered no real <w>intellectual</w> challenge.",
                            "target_lang_translations": {
                                "ru": "Он находил эту работу скучной, потому что она не предлагала никакого реального <w>интеллектуального</w> вызова.",
                                "zh": "他觉得这份工作很无聊，因为它没有提供任何真正的<w>智力</w>挑战。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cerebral",
                        "academic",
                        "highbrow"
                    ],
                    "common_phrases": [
                        "intellectual challenge",
                        "intellectual discussion",
                        "intellectual debate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Связанный с серьезным изучением и глубокими размышлениями; требующий работы ума.",
                        "zh": "涉及严肃研究和深入思考的；适合锻炼智力的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "интеллектуа́льный",
                                "target_lang_sense_clarification": "требующий работы интеллекта (напр. беседа, вызов)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "智力上的",
                                "target_lang_sense_clarification": "需要动脑的"
                            },
                            {
                                "target_lang_word": "学术性的",
                                "target_lang_sense_clarification": "具有学术研究性质的"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2df6f226-630a-3e04-ae90-d33f88bc0401",
                    "sense_definition": "A very educated person who is interested in complex ideas, literature, and culture.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "person_entity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A group of writers and <w>intellectuals</w> met at the cafe to discuss the political situation.",
                            "target_lang_translations": {
                                "ru": "Группа писателей и <w>интеллектуалов</w> встретилась в кафе, чтобы обсудить политическую ситуацию.",
                                "zh": "一群作家和<w>知识分子</w>在咖啡馆聚会，讨论当前的政治局势。"
                            }
                        },
                        {
                            "text": "He became a well-known public <w>intellectual</w> after publishing his book on social reform.",
                            "target_lang_translations": {
                                "ru": "Он стал известным публичным <w>интеллектуалом</w> после публикации своей книги о социальных реформах.",
                                "zh": "在出版了关于社会改革的书籍后，他成为了一位著名的公共<w>知识分子</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "academic",
                        "scholar",
                        "highbrow"
                    ],
                    "common_phrases": [
                        "public intellectual",
                        "leading intellectual"
                    ],
                    "target_lang_definitions": {
                        "ru": "Образованный человек, интересующийся сложными идеями, литературой и культурой.",
                        "zh": "受过高等教育，对复杂思想、文学和文化感兴趣的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "интеллектуа́л",
                                "target_lang_sense_clarification": "человек умственного труда"
                            },
                            {
                                "target_lang_word": "интеллиге́нт",
                                "target_lang_sense_clarification": "человек, принадлежащий к интеллигенции (культурный и образованный)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "知识分子",
                                "target_lang_sense_clarification": "从事脑力劳动的人"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}