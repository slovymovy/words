                        "examples": [
                            {
                                "example_id": "e91004e0-3ef6-41a1-9e37-6ad1fd07a125",
                                "sense_id": "fcbf3756-7231-3099-b8fa-656c5622cdae",
                                "text": "Vanaf de Veilinghaven lopen we langs het Jaarbeursterrein over de Doctor Tellegenlaan langs de imposante vipdorpen met terrassen."
                            },
                            {
                                "example_id": "39ce8387-a688-469a-bd8d-f754cc4699ba",
                                "sense_id": "fcbf3756-7231-3099-b8fa-656c5622cdae",
                                "text": "Ik liep nog even door naar het Village Départ om kranten te scoren. Het vipdorp stond mooi voor het tempelachtige bronnenbad van Luchon."
                            },
                            {
                                "example_id": "213e79c4-2b78-4923-97e4-b55615de9c4c",
                                "sense_id": "fcbf3756-7231-3099-b8fa-656c5622cdae",
                                "text": "De binnenstad is in de afgelopen dagen omgetoverd tot een circuit. Zo is aan de voet van de Willemsbrug een groot vipdorp opgetrokken."
                            }
                        ]
                    }
