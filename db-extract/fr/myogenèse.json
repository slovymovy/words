                        "entry_id": "31ebf878-5d38-30a6-ab72-ea29eea8e490",
                        "glosses": [
                            "Phénomène biologique qui conduit à la formation des tissus musculaires."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee7c806b-0cc5-482f-afff-cbe052ed283a",
                                "sense_id": "9a99604b-bff4-3dae-a296-424ee4bddc75",
                                "text": "Le FGF1 (fibroblast growth factor 1) est un facteur de croissance connu pour son rôle dans l’angiogenèse, qui est également impliqué dans la myogenèse."
                            },
                            {
                                "example_id": "5da6bf0c-0949-4fe9-98a1-96ce480b815a",
                                "sense_id": "9a99604b-bff4-3dae-a296-424ee4bddc75",
                                "text": "La myogenèse se définit comme étant l’ensemble des étapes requises à la formation et au développement du système musculaire, ainsi qu’à sa régénération."
                            }
                        ]
                    }
