                                                "sense_id": "4ba50497-87d4-31c4-b019-8b2c7f8eeb00",
                                                "text": "Michał nadal uprawia czynnie piłkę nożną."
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    },
                                    {
                                        "sense_id": "c5940a88-04a1-3614-82f3-0b55b0879bd8",
                                        "entry_id": "fe155593-e9f4-3aca-83dd-2c9cea212386",
                                        "glosses": [
                                            "władając dobrze językiem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8fbeafdc-4289-4127-8862-42a2da3c083f",
                                                "sense_id": "c5940a88-04a1-3614-82f3-0b55b0879bd8",
                                                "text": "Misjonarka władała czynnie sango."
                                            }
                                        ],
                                        "sense_index_json": "\"1.3\""
                                    },
                                    {
                                        "sense_id": "fca2dd4f-74b3-3fb7-8607-7b6ab70299c2",
                                        "entry_id": "fe155593-e9f4-3aca-83dd-2c9cea212386",
                                        "glosses": [
                                            "będąc stale aktywnym w jakimś zajęciu"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0f67806-9575-4421-a8bb-3c78f29ec631",
                                                "sense_id": "fca2dd4f-74b3-3fb7-8607-7b6ab70299c2",
                                                "text": "Ilu więźniów czynnie wykonuje swój wyuczony zawód?"
                                            }
