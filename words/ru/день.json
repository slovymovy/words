{
    "word_family": [
        "дневной",
        "ежедневный",
        "дневник",
        "полдень",
        "дневать",
        "ежедневно"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7a8d1676-0b2d-3493-a424-d4860000220e",
                    "sense_definition": "Светлая часть суток от восхода до заката солнца, противоположная ночи.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "time_period_light",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Зимой <день> становится короче, а ночь длиннее.",
                            "target_lang_translations": {
                                "en": "In winter the <w>day</w> becomes shorter, and the night longer.",
                                "zh": "冬天<w>白天</w>变短了，夜晚变长了。"
                            }
                        },
                        {
                            "text": "Мы гуляли в парке целый <день>, пока не стемнело.",
                            "target_lang_translations": {
                                "en": "We walked in the park all <w>day</w> until it got dark.",
                                "zh": "我们在公园里玩了整整一<w>天</w>，直到天黑。"
                            }
                        }
                    ],
                    "antonyms": [
                        "ночь"
                    ],
                    "common_phrases": [
                        "добрый день",
                        "целый день",
                        "ясный день",
                        "среди бела дня"
                    ],
                    "target_lang_definitions": {
                        "en": "The period of light between sunrise and sunset, opposite to night.",
                        "zh": "从日出到日落的明亮时间段，与夜晚相对。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "day",
                                "target_lang_sense_clarification": "period of light"
                            },
                            {
                                "target_lang_word": "daytime",
                                "target_lang_sense_clarification": "time of daylight"
                            },
                            {
                                "target_lang_word": "daylight",
                                "target_lang_sense_clarification": "light from the sun"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "白天",
                                "target_lang_sense_clarification": "日出到日落间的时间"
                            },
                            {
                                "target_lang_word": "日",
                                "target_lang_sense_clarification": "指白昼"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cf550a6b-73f6-3297-a55e-1bba88c45925",
                    "sense_definition": "Единица исчисления времени, равная 24 часам; промежуток времени от одной полуночи до другой.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "time_unit_24h",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В неделе семь <дней>, и пять из них рабочие.",
                            "target_lang_translations": {
                                "en": "There are seven <w>days</w> in a week, and five of them are working days.",
                                "zh": "一周有七<w>天</w>，其中五天是工作日。"
                            }
                        },
                        {
                            "text": "Врач сказал принимать это лекарство через <день>.",
                            "target_lang_translations": {
                                "en": "The doctor said to take this medicine every other <w>day</w>.",
                                "zh": "医生说这药要隔<w>天</w>吃一次。"
                            }
                        }
                    ],
                    "synonyms": [
                        "сутки"
                    ],
                    "common_phrases": [
                        "каждый день",
                        "через день",
                        "изо дня в день",
                        "день за днём"
                    ],
                    "target_lang_definitions": {
                        "en": "A unit of time equal to 24 hours; the period from one midnight to the next.",
                        "zh": "计量时间的单位，等于24小时；从一个午夜到下一个午夜的时间段。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "day",
                                "target_lang_sense_clarification": "24 hours"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "天",
                                "target_lang_sense_clarification": "24小时的时间单位"
                            },
                            {
                                "target_lang_word": "日",
                                "target_lang_sense_clarification": "一昼夜"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1cef6140-f2e7-3e46-9f2a-cdcd646da232",
                    "sense_definition": "Время суток после утра и до вечера (используется при указании конкретного времени на часах).",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "time_indication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Поезд отправляется в два часа <дня> по местному времени.",
                            "target_lang_translations": {
                                "en": "The train departs at two in the <w>afternoon</w> local time.",
                                "zh": "火车在当地时间<w>下午</w>两点出发。"
                            }
                        },
                        {
                            "text": "Мы договорились встретиться в кафе в пять часов <дня>.",
                            "target_lang_translations": {
                                "en": "We agreed to meet at the cafe at five in the <w>afternoon</w>.",
                                "zh": "我们约好<w>下午</w>五点在咖啡馆见面。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "два часа дня",
                        "три часа дня"
                    ],
                    "target_lang_definitions": {
                        "en": "The time of day between morning and evening (used when specifying time).",
                        "zh": "早晨之后、傍晚之前的时间（用于指代具体钟点）。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "afternoon",
                                "target_lang_sense_clarification": "time of day"
                            },
                            {
                                "target_lang_word": "day",
                                "target_lang_sense_clarification": "time period"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "下午",
                                "target_lang_sense_clarification": "一天中早晨之后的时间"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d3b46226-7f74-3aee-b4ae-a15de08ebdd6",
                    "sense_definition": "Календарная дата, посвященная какому-либо важному событию или празднику.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "holiday_event",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Скоро наступит <день> рождения моего лучшего друга.",
                            "target_lang_translations": {
                                "en": "My best friend's birth<w>day</w> is coming soon.",
                                "zh": "我最好的朋友的生<w>日</w>快到了。"
                            }
                        },
                        {
                            "text": "Девятого мая вся страна отмечает <День> Победы.",
                            "target_lang_translations": {
                                "en": "On May 9th the whole country celebrates Victory <w>Day</w>.",
                                "zh": "五月九日全国都在庆祝胜利<w>日</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "праздник",
                        "юбилей",
                        "годовщина",
                        "дата"
                    ],
                    "common_phrases": [
                        "день рождения",
                        "выходной день",
                        "праздничный день"
                    ],
                    "target_lang_definitions": {
                        "en": "A calendar date dedicated to a specific event or holiday.",
                        "zh": "用于纪念特定事件或节日的日期。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "day",
                                "target_lang_sense_clarification": "date or holiday"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "日",
                                "target_lang_sense_clarification": "日期或节日"
                            },
                            {
                                "target_lang_word": "节",
                                "target_lang_sense_clarification": "节日"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b267e278-d06c-3a19-a1a0-3e9b604213e5",
                    "sense_definition": "Определенный момент времени или период жизни, связанный с важными событиями.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "abstract_time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Настал тот <день>, когда он наконец получил свой диплом.",
                            "target_lang_translations": {
                                "en": "The <w>day</w> came when he finally received his diploma.",
                                "zh": "他终于拿到毕业证的那一<w>天</w>到来了。"
                            }
                        },
                        {
                            "text": "В <дни> моей молодости в этом городе было намного тише.",
                            "target_lang_translations": {
                                "en": "In the <w>days</w> of my youth, it was much quieter in this city.",
                                "zh": "在我年轻的<w>日子</w>里，这座城市安静得多。"
                            }
                        }
                    ],
                    "synonyms": [
                        "момент",
                        "час"
                    ],
                    "common_phrases": [
                        "в наши дни",
                        "со дня на день"
                    ],
                    "target_lang_definitions": {
                        "en": "A specific moment in time or a period of life associated with important events.",
                        "zh": "与重要事件相关的特定时刻或人生阶段。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "day",
                                "target_lang_sense_clarification": "era or period"
                            },
                            {
                                "target_lang_word": "time",
                                "target_lang_sense_clarification": "period of life"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "日子",
                                "target_lang_sense_clarification": "特定时期或生活阶段"
                            },
                            {
                                "target_lang_word": "时代",
                                "target_lang_sense_clarification": "一段时期"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0627b9a6-3dc4-356c-88aa-90d7924dc6a5",
                    "sense_definition": "Форма второго лица единственного числа повелительного наклонения глагола <w>деть</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "verb_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<День> куда-нибудь эти старые вещи, чтобы они не мешали.",
                            "target_lang_translations": {
                                "en": "<w>Put</w> these old things somewhere so they don't get in the way.",
                                "zh": "把这些旧东西<w>放</w>到别处去，别碍事。"
                            }
                        },
                        {
                            "text": "Не знаю, куда <день> лишний билет, может быть, отдать другу?",
                            "target_lang_translations": {
                                "en": "I don't know where to <w>put</w> the extra ticket; maybe give it to a friend?",
                                "zh": "不知道多余的票该<w>放</w>哪儿，要不送给朋友吧？"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "imperative of деть"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Imperative form of the verb 'to put' or 'to place'.",
                        "zh": "动词“放”或“安置”的祈使形式。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "put",
                                "target_lang_sense_clarification": "imperative verb"
                            },
                            {
                                "target_lang_word": "stick",
                                "target_lang_sense_clarification": "informal, to place"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "放",
                                "target_lang_sense_clarification": "放置"
                            },
                            {
                                "target_lang_word": "搁",
                                "target_lang_sense_clarification": "放置"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}