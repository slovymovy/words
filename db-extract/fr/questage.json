                        "glosses": [
                            "Méthode de recherche qui permet à des chiens dressés spécialement de retrouver toutes personnes vivantes dans un périmètre donné, sans avoir d'odeur de référence."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c04352d9-27a8-4fb4-bb03-4cd286531884",
                                "sense_id": "8942bf8c-1457-31a7-813d-15422838849a",
                                "text": "Le chien de questage, appelé aussi chien de recherche en surface, travaille sans odeur de référence (contrairement à son homologue le chien de Pistage)."
                            },
                            {
                                "example_id": "52d7efc0-57d6-4ec1-8f31-a6d08c3c357c",
                                "sense_id": "8942bf8c-1457-31a7-813d-15422838849a",
                                "text": "Cette méthode s’appelle le questage, c’est incroyable, les chiens arrivent à retrouver des victimes sans odeur de référence et jusqu’à douze mètres de profondeur."
                            }
                        ]
                    }
