{
    "word_family": [
        "afwachten",
        "wachten",
        "afwachting"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "5632f3fc-b29a-3912-b402-bfe070ce337c",
                    "sense_definition": "Observerend maar nog niet handelend; geneigd om eerst te zien wat er gebeurt.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De directie nam een <w>afwachtende</w> houding aan voordat ze besloot te investeren.",
                            "target_lang_translations": {
                                "en": "The management adopted a <w>wait-and-see</w> attitude before deciding to invest."
                            }
                        },
                        {
                            "text": "Hij keek me met een <w>afwachtende</w> blik aan, hopend op een snel antwoord.",
                            "target_lang_translations": {
                                "en": "He looked at me with an <w>expectant</w> gaze, hoping for a quick answer."
                            }
                        }
                    ],
                    "synonyms": [
                        "expectatief",
                        "temporiserend"
                    ],
                    "antonyms": [
                        "actief",
                        "daadkrachtig",
                        "proactief"
                    ],
                    "common_phrases": [
                        "een afwachtende houding",
                        "afwachtend aankijken"
                    ],
                    "target_lang_definitions": {
                        "en": "Observing but not yet acting; inclined to wait and see what happens first."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "wait-and-see",
                                "target_lang_sense_clarification": "referring to an attitude or approach of waiting for developments"
                            },
                            {
                                "target_lang_word": "expectant",
                                "target_lang_sense_clarification": "waiting with anticipation or expectation"
                            },
                            {
                                "target_lang_word": "cautious",
                                "target_lang_sense_clarification": "hesitant to act before knowing the outcome"
                            },
                            {
                                "target_lang_word": "watchful",
                                "target_lang_sense_clarification": "observing closely before making a move"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cc4f2aa3-3f2a-3f19-b639-0136347f8f3a",
                    "sense_definition": "Onvoltooid deelwoord van <w>afwachten</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Rustig de resultaten <w>afwachtend</w> dronk hij een kop koffie in de kantine.",
                            "target_lang_translations": {
                                "en": "Quietly <w>awaiting</w> the results, he drank a cup of coffee in the cafeteria."
                            }
                        },
                        {
                            "text": "De kat zat urenlang bij het holletje, geduldig op de muis <w>afwachtend</w>.",
                            "target_lang_translations": {
                                "en": "The cat sat by the hole for hours, patiently <w>waiting</w> for the mouse."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Present participle of 'afwachten' (to wait for, to await)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "waiting",
                                "target_lang_sense_clarification": "the action of awaiting something"
                            },
                            {
                                "target_lang_word": "awaiting",
                                "target_lang_sense_clarification": "expectantly waiting for an event or result"
                            }
                        ]
                    }
                }
            ]
        }
    ]
