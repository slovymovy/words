                                "example_id": "c7ed4be8-d699-4749-aa04-1be8e34f7a34",
                                "sense_id": "eb96a5c4-7a70-3465-9ae8-a29f132dd984",
                                "text": "Les maîtres coraniques à Diourbel rencontrent d’énormes difficultés pour nourrir leurs talibés en cette période de couvre-feu."
                            }
                        ]
                    },
