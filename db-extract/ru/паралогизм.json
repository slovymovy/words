                        "translation_id": "df927eb2-16e6-40ca-a7bc-c747aa135c4b",
                        "source_entry_id": "52b2a273-9947-3852-83c2-757b4ea82612",
                        "source_sense_id": "68912fd1-7821-3d81-b8f6-8ca938031fe2",
                        "target_lang_word": "paralogism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "paralogism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eb053ed7-9ce3-3d87-b163-5595fbff2207",
                                        "entry_id": "d5d6aae5-4dc7-3ca5-be5f-e49e9cc6e39a",
                                        "glosses": [
                                            "A fallacious argument or illogical conclusion, especially one committed by mistake, or believed by the speaker to be logical."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "899fed2c-a93d-4779-8cfe-8dc1fb992fd3",
                                                "sense_id": "eb053ed7-9ce3-3d87-b163-5595fbff2207",
                                                "text": "Which is a Paralogism not admittible; a fallacy that dwels not in a cloud, and needs not the Sun to scatter it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "01bae0fa-9c19-4469-9df9-e9d9c583b8d1",
                        "source_entry_id": "52b2a273-9947-3852-83c2-757b4ea82612",
                        "source_sense_id": "68912fd1-7821-3d81-b8f6-8ca938031fe2",
                        "target_lang_word": "Paralogismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "dd55693e-0331-4d66-9e57-cfc120a35013",
                        "source_entry_id": "52b2a273-9947-3852-83c2-757b4ea82612",
                        "source_sense_id": "68912fd1-7821-3d81-b8f6-8ca938031fe2",
                        "target_lang_word": "paralogisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "paralogisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "38d30041-b06a-3378-853c-550c29f1244f",
                                        "entry_id": "784f980e-d654-3f19-9d3c-82f7207cb57a",
                                        "glosses": [
                                            "Faux raisonnement fait de bonne foi, raisonnement qui porte à faux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc265b71-8bc9-445c-ba6f-670b966d192d",
                                                "sense_id": "38d30041-b06a-3378-853c-550c29f1244f",
                                                "text": "De ces glissements, de ces paralogismes, de ces recouvrements ou confusions de champs, Freud n’est pas exempt."
                                            },
                                            {
                                                "example_id": "6895fca3-6d7d-41b2-8a88-a2eeb4b48576",
                                                "sense_id": "38d30041-b06a-3378-853c-550c29f1244f",
                                                "text": "Elle m’a dit qu’il s’agissait d’une erreur logique qui a pour nom « paralogisme naturaliste ». Elle m’a dit que le constat d’un fait n’implique en rien la validité d’un jugement moral."
                                            },
                                            {
                                                "example_id": "4790a638-65f3-42bf-99ed-0405a4f25f11",
                                                "sense_id": "38d30041-b06a-3378-853c-550c29f1244f",
                                                "text": "C'est comme si on disait : telle pomme pourrie dans un panier non seulement contamine toutes les autres, mais fait de « la » pomme un fruit malsain. Paralogisme – le sophisme de généralisation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
