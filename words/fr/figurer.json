                        "figurer dans le dictionnaire"
                    ]
                },
                {
                    "sense_id": "0288e12d-cd7a-3a4d-a0c1-1a58e7bae049",
                    "sense_definition": "Se représenter mentalement quelque chose, imaginer.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "imagination",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle se <w>figure</w> que tout le monde approuve sans réserve sa nouvelle proposition de projet."
                        },
                        {
                            "text": "On a souvent du mal à se <w>figurer</w> l'immensité de cet océan sans l'avoir vu de près."
