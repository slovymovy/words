{
    "word_family": [
        "factual",
        "factoid",
        "factuality",
        "factually",
        "counterfactual"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "33faaf8f-0678-3ffb-bb22-d165836768fc",
                    "sense_definition": "A piece of information that is known to be true or to have happened, as opposed to an opinion or fiction.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "reality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In this story, the Gettysburg Address is a <w>fact</w>, but the rest is fiction.",
                            "target_lang_translations": {
                                "ru": "В этой истории Геттисбергская речь — это <w>факт</w>, а всё остальное — вымысел."
                            }
                        },
                        {
                            "text": "The journalist presented the <w>hard</w> <w>facts</w> in a clear and logical way.",
                            "target_lang_translations": {
                                "ru": "Журналист изложил <w>неоспоримые</w> <w>факты</w> четко и логично."
                            }
                        }
                    ],
                    "synonyms": [
                        "truth",
                        "reality",
                        "certainty"
                    ],
                    "antonyms": [
                        "opinion"
                    ],
                    "common_phrases": [
                        "hard facts",
                        "facts and figures",
                        "establish the facts",
                        "stick to the facts"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сведения, которые считаются истинными или реально произошедшими, в отличие от мнения или вымысла."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "факт",
                                "target_lang_sense_clarification": "реальное событие или истина"
                            },
                            {
                                "target_lang_word": "действительность",
                                "target_lang_sense_clarification": "то, что существует на самом деле"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "12ce705c-2ff1-3648-bc7f-cc43ad5c7cb5",
                    "sense_definition": "Something that exists in reality; an actual state of affairs.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "reality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Gravity is a <w>fact</w>, not just a theory.",
                            "target_lang_translations": {
                                "ru": "Гравитация — это <w>факт</w>, а не просто теория."
                            }
                        },
                        {
                            "text": "We must accept the <w>fact</w> <w>that</w> the climate is changing rapidly.",
                            "target_lang_translations": {
                                "ru": "Мы должны принять тот <w>факт</w>, что климат стремительно меняется."
                            }
                        }
                    ],
                    "synonyms": [
                        "actuality",
                        "existence"
                    ],
                    "common_phrases": [
                        "the fact that",
                        "matter of fact",
                        "in point of fact"
                    ],
                    "target_lang_definitions": {
                        "ru": "То, что существует в реальности; фактическое положение дел."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "факт",
                                "target_lang_sense_clarification": "реальное положение дел"
                            },
                            {
                                "target_lang_word": "реальность",
                                "target_lang_sense_clarification": "объективное существование"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "778dfb28-f70f-3f52-826f-a918ef2878ed",
                    "sense_definition": "Information or data about a specific subject or condition.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "information",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The book provides many interesting <w>facts</w> <w>about</w> space travel.",
                            "target_lang_translations": {
                                "ru": "В книге приводится много интересных <w>фактов</w> о космических путешествиях."
                            }
                        },
                        {
                            "text": "Children learn basic addition <w>facts</w> like two plus two equals four.",
                            "target_lang_translations": {
                                "ru": "Дети учат базовые <w>примеры</w> на сложение, такие как два плюс два равно четыре."
                            }
                        }
                    ],
                    "synonyms": [
                        "detail",
                        "particular",
                        "datum"
                    ],
                    "common_phrases": [
                        "facts about",
                        "basic facts",
                        "interesting facts"
                    ],
                    "target_lang_definitions": {
                        "ru": "Информация или данные о конкретном предмете или условии."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "факт",
                                "target_lang_sense_clarification": "сведения о чем-либо"
                            },
                            {
                                "target_lang_word": "данные",
                                "target_lang_sense_clarification": "информация для изучения"
                            },
                            {
                                "target_lang_word": "сведения",
                                "target_lang_sense_clarification": "познавательная информация"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e9a62993-05ee-3a2f-ab97-21f0389c58b1",
                    "sense_definition": "A concrete piece of evidence used as a basis for interpretation or a legal case.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "legal_evidence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Let's look at the <w>facts</w> <w>of</w> <w>the</w> <w>case</w> before deciding on a verdict.",
                            "target_lang_translations": {
                                "ru": "Давайте рассмотрим <w>обстоятельства</w> дела, прежде чем выносить вердикт."
                            }
                        },
                        {
                            "text": "The lawyer spent hours reviewing the <w>facts</w> to build a strong defense.",
                            "target_lang_translations": {
                                "ru": "Адвокат часами изучал <w>факты</w>, чтобы выстроить надежную защиту."
                            }
                        }
                    ],
                    "synonyms": [
                        "evidence",
                        "circumstance"
                    ],
                    "common_phrases": [
                        "facts of the case",
                        "known facts"
                    ],
                    "target_lang_definitions": {
                        "ru": "Конкретное доказательство, используемое в качестве основы для интерпретации или судебного дела."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обстоятельство",
                                "target_lang_sense_clarification": "деталь дела"
                            },
                            {
                                "target_lang_word": "факт",
                                "target_lang_sense_clarification": "доказанный эпизод"
                            },
                            {
                                "target_lang_word": "улика",
                                "target_lang_sense_clarification": "доказательство вины"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "22154377-7de9-39cc-81f8-0be8dd91fc08",
                    "sense_definition": "A wrongful or criminal deed; an act of wrongdoing.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "legal_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was charged with being an <w>accessory</w> <w>after</w> <w>the</w> <w>fact</w>.",
                            "target_lang_translations": {
                                "ru": "Его обвинили в <w>соучастии</w> после совершения преступления."
                            }
                        },
                        {
                            "text": "The jury found that the <w>fact</w> of the crime was clearly proven.",
                            "target_lang_translations": {
                                "ru": "Присяжные сочли, что <w>событие</w> преступления было четко доказано."
                            }
                        }
                    ],
                    "synonyms": [
                        "deed",
                        "act",
                        "crime"
                    ],
                    "common_phrases": [
                        "accessory after the fact",
                        "confess the fact"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "primarily used in legal contexts like 'accessory after the fact'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Противоправное или преступное деяние; акт правонарушения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "событие",
                                "target_lang_sense_clarification": "факт совершения преступления"
                            },
                            {
                                "target_lang_word": "деяние",
                                "target_lang_sense_clarification": "преступный акт"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fa95d7ff-4c56-3b74-a1ea-380c4fc5b076",
                    "sense_definition": "An individual value or measurement at the lowest level of detail in a data warehouse.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "technical_data",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Each <w>fact</w> in the table represents a single sales transaction.",
                            "target_lang_translations": {
                                "ru": "Каждый <w>факт</w> в таблице представляет собой отдельную операцию по продаже."
                            }
                        },
                        {
                            "text": "The data architect defined the <w>fact</w> table to store quantitative measurements.",
                            "target_lang_translations": {
                                "ru": "Архитектор данных определил таблицу <w>фактов</w> для хранения количественных измерений."
                            }
                        }
                    ],
                    "synonyms": [
                        "measure",
                        "metric"
                    ],
                    "common_phrases": [
                        "fact table"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "technical term in computing and data science"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Отдельное значение или измерение на самом низком уровне детализации в хранилище данных."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "факт",
                                "target_lang_sense_clarification": "технический термин в базах данных"
                            },
                            {
                                "target_lang_word": "показатель",
                                "target_lang_sense_clarification": "количественное измерение"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "4b69befd-81a0-3861-9ff2-844d8c7a0f2b",
                    "sense_definition": "Used to emphasize that the following statement is true or to introduce a surprising truth.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "emphasis",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I don't like that restaurant; <w>fact</w>, the food is always cold.",
                            "target_lang_translations": {
                                "ru": "Мне не нравится тот ресторан; <w>факт</w>, еда там всегда холодная."
                            }
                        },
                        {
                            "text": "He is the best player on the team, <w>fact</w>.",
                            "target_lang_translations": {
                                "ru": "Он лучший игрок в команде, это <w>факт</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "truthfully",
                        "really"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used for emphasis in speech"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется для подчеркивания истинности последующего утверждения или сообщения удивительной правды."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "факт",
                                "target_lang_sense_clarification": "в значении 'это правда'"
                            },
                            {
                                "target_lang_word": "точно",
                                "target_lang_sense_clarification": "подтверждение правоты"
                            },
                            {
                                "target_lang_word": "реально",
                                "target_lang_sense_clarification": "молодежный сленг для акцента"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "f2e7149c-989d-3814-8504-d86b7668388b",
                    "sense_definition": "Initialism of Federation Against Copyright Theft.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "organization",
                    "name_type": "organization_name",
                    "examples": [
                        {
                            "text": "The <w>FACT</w> warning appears at the beginning of many DVDs in the UK.",
                            "target_lang_translations": {
                                "ru": "Предупреждение <w>FACT</w> появляется в начале многих DVD-дисков в Великобритании."
                            }
                        },
                        {
                            "text": "Investigators from <w>FACT</w> worked with the police to stop the piracy ring.",
                            "target_lang_translations": {
                                "ru": "Следователи из <w>FACT</w> работали вместе с полицией, чтобы ликвидировать пиратскую сеть."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Аббревиатура Федерации по борьбе с кражей авторских прав (Federation Against Copyright Theft)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "FACT",
                                "target_lang_sense_clarification": "название организации"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}