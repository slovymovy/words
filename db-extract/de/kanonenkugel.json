                ],
                "senses": [
                    {
                        "sense_id": "19ce9be3-26d0-3d62-8420-5d65c22d8d55",
                        "entry_id": "637f6bbf-4545-30b5-a758-4242e9bafee3",
                        "glosses": [
                            "kugelförmiges Geschoss von Kanonen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1dfb86f4-0612-4ae2-9131-0faa3683ec8d",
                                "sense_id": "19ce9be3-26d0-3d62-8420-5d65c22d8d55",
                                "text": "Kanonen konnten nicht nur Kanonenkugeln schießen, sondern auch sämtliche anderen Gegenstände."
                            },
                            {
                                "example_id": "e9b61ce2-9b5c-45d9-8d37-44c0c880b8bd",
                                "sense_id": "19ce9be3-26d0-3d62-8420-5d65c22d8d55",
                                "text": "„Proviant für zwei Monate lagert unter Deck, neben 174 Kanonen und 82000 Kanonenkugeln.“"
                            },
                            {
                                "example_id": "5911d663-155c-4dc0-820d-5b57200c0cce",
                                "sense_id": "19ce9be3-26d0-3d62-8420-5d65c22d8d55",
                                "text": "„Wir schossen nur mit Kanonenkugeln auf sie, und dies aus ganzem Herzen.“"
                            },
                            {
                                "example_id": "558ff15e-f227-4000-b79d-203f7710c0f5",
                                "sense_id": "19ce9be3-26d0-3d62-8420-5d65c22d8d55",
                                "text": "„Er zeigte Martin den rechten Umgang mit einer Muskete und die furchtbare Wirkung einer Kanonenkugel.“"
                            },
                            {
                                "example_id": "02c6c93f-aa61-4e94-96d6-cc648b7144e6",
                                "sense_id": "19ce9be3-26d0-3d62-8420-5d65c22d8d55",
                                "text": "„Neswitzkij begriff, dass das eine Kanonenkugel gewesen war.“"
                            },
                            {
                                "example_id": "ac49ea41-e464-4907-8d43-184a84b76140",
                                "sense_id": "19ce9be3-26d0-3d62-8420-5d65c22d8d55",
                                "text": "„Als dessen Elefanten von den Kanonenkugeln getroffen wurden, gab es kein Halten mehr.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1dc47548-8243-482d-8013-9772b9f3b3e7",
                        "source_entry_id": "637f6bbf-4545-30b5-a758-4242e9bafee3",
                        "source_sense_id": "19ce9be3-26d0-3d62-8420-5d65c22d8d55",
