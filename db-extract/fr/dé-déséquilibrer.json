                        "glosses": [
                            "Rééquilibrer (quelque chose qui avait été déséquilibré)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e824c3e9-49f3-4b46-8f40-ac21f3125eb8",
                                "sense_id": "e921b8d5-038d-31cb-857b-65a4ff1c5431",
                                "text": "Puisque ca ne marche pas, on pourrait peut être (à coup de millions) maintenant essayer de dé-déséquilibrer les « déséquilibrés » ou de dé-solitariser les « loups solitaires »…"
                            },
                            {
                                "example_id": "35c3f3d9-6ad2-4198-a0b7-262ca58aeae6",
                                "sense_id": "e921b8d5-038d-31cb-857b-65a4ff1c5431",
                                "text": "j’ai poncé les 2 plots du milieu des micros d’à peine 1mm, afin de la dé-déséquilibrer légèrement."
                            },
                            {
                                "example_id": "6b60ae66-3a7b-4ecf-b49e-05dc4edd0e7d",
                                "sense_id": "e921b8d5-038d-31cb-857b-65a4ff1c5431",
                                "text": "Le problème c'est que j'ai proposé ça vite et que je vois pas comment \"dé-déséquilibrer\" l'offre un minimum"
                            }
                        ]
                    }
