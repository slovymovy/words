                                "target_senses": [
                                    {
                                        "sense_id": "676a7ea9-156f-3f92-8fd8-62cf8e1e509e",
                                        "entry_id": "8f691c9b-32c6-3c0e-b40a-1ad593712537",
                                        "glosses": [
                                            "Noble in behaviour or actions; principled, not petty; kind, magnanimous."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90aaff68-7477-4b5f-b1ce-fd789b482cdf",
                                                "sense_id": "676a7ea9-156f-3f92-8fd8-62cf8e1e509e",
                                                "text": "Thank you for your generous words."
                                            },
                                            {
                                                "example_id": "de5311f3-f674-47cb-976f-2982a4636922",
                                                "sense_id": "676a7ea9-156f-3f92-8fd8-62cf8e1e509e",
                                                "text": "Although the extension to Crewe carried the line much nearer to the town, it was decided to retain this station, and a large enclosure there was roofed over to accommodate third class passengers (the M.B.R. was more generous than most railways in its treatment of what were then known as the \"lower orders\")."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b38e47f8-42e8-3986-8dc6-23d5099e3a26",
                                        "entry_id": "8f691c9b-32c6-3c0e-b40a-1ad593712537",
                                        "glosses": [
                                            "Willing to give and share unsparingly; showing a readiness to give more (especially money) than is expected or needed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ccc8464-5906-42e8-8712-1bcb4781925e",
                                                "sense_id": "b38e47f8-42e8-3986-8dc6-23d5099e3a26",
                                                "text": "She's been extremely generous with her winnings."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "30f82bb3-b3c8-3eb0-9d17-a10f06bdaddf",
                                        "entry_id": "8f691c9b-32c6-3c0e-b40a-1ad593712537",
                                        "glosses": [
                                            "Large, more than ample, copious."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ad7ef80-31cc-47f5-8995-1877babda3fc",
                                                "sense_id": "30f82bb3-b3c8-3eb0-9d17-a10f06bdaddf",
                                                "text": "The ice cream parlors served generous scoops, hand-dipped by college-bound teenagers who spoke through colorful orthodontia."
                                            },
                                            {
                                                "example_id": "8e90b018-efaf-4fd1-bb55-2d1e336524fd",
                                                "sense_id": "30f82bb3-b3c8-3eb0-9d17-a10f06bdaddf",
                                                "text": "Add a generous helping of mayonnaise."
                                            },
                                            {
                                                "example_id": "27b0498b-f39b-421f-88d7-1c3c8c91f121",
                                                "sense_id": "30f82bb3-b3c8-3eb0-9d17-a10f06bdaddf",
                                                "text": "his generous buttocks"
                                            },
                                            {
                                                "example_id": "39e4de7e-215c-4681-b6d8-1a9355a99a00",
                                                "sense_id": "30f82bb3-b3c8-3eb0-9d17-a10f06bdaddf",
                                                "text": "[H]is hard jaw worked slowly upon a generous mouthful of plug cut."
                                            }
                                        ]
                                    },
