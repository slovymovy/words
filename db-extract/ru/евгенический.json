                    {
                        "translation_id": "2525032a-3c64-4d60-b795-c1a53fdb2174",
                        "source_entry_id": "f753a662-a090-32f8-9ea4-9e8b6e9e047d",
                        "source_sense_id": "297f02fe-4df3-3bd9-bce5-218ebc7bce45",
                        "target_lang_word": "eugéniste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eugéniste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5aa1c92d-ca8f-382f-89cf-904077fc4107",
                                        "entry_id": "d8a8c5f2-a34b-38d3-b2a1-cc45272833ec",
                                        "glosses": [
                                            "Partisan de l’eugénisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "edfb5cef-926f-40fc-9d10-3ce2f72d0eee",
                                                "sense_id": "5aa1c92d-ca8f-382f-89cf-904077fc4107",
                                                "text": "C’est un immonde raciste et un eugéniste nauséabond."
                                            },
                                            {
                                                "example_id": "ffe24bcc-0b94-418c-aff8-27e07eb31d30",
                                                "sense_id": "5aa1c92d-ca8f-382f-89cf-904077fc4107",
                                                "text": "En établissant un parallèle entre le destin naturel et le destin lié à la socialisation, les eugénistes libéraux rendent les choses trop simples."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "eugéniste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e963b6fd-9a1a-309f-a695-76d866882ac4",
                                        "entry_id": "aa7f05d8-5546-37da-939d-fc0b2849834d",
                                        "glosses": [
                                            "Relatif à l’eugénisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e99bdd25-fda8-4331-a50d-2af66a4399e2",
                                                "sense_id": "e963b6fd-9a1a-309f-a695-76d866882ac4",
                                                "text": "De fait, l'approche franchement eugéniste de Carrel ne trouvera pas sa place dans les congrès néohippocratiques."
                                            },
                                            {
                                                "example_id": "cdbe3c2c-c074-40e9-b639-c31b673399ef",
                                                "sense_id": "e963b6fd-9a1a-309f-a695-76d866882ac4",
                                                "text": "Fasciné par la politique eugéniste allemande, il se sait associé à tous les parias de l'univers nazi (handicapés, gitans, criminels, opposants politiques et juifs) :[…]."
                                            },
                                            {
