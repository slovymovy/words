                        "entry_id": "bbb0ff84-0120-3383-b42f-3d6e32357d33",
                        "glosses": [
                            "meubelstuk waarin flessen alcoholische drank en glazen bewaard en getoond kunnen worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c88e6d8d-8c2e-4bf2-ae2c-284b4a6be4ac",
                                "sense_id": "4b3ca42c-efa2-31a1-8d6a-80ebdbf0f0e2",
                                "text": "Van Schotse whisky, Engelse gin, Italiaanse vermout, Caraïbische rum, over Mexicaanse tequila tot Vlaamse jenever. Doe de gemiddelde barkast open en je ziet de wereld samenkomen."
                            },
                            {
                                "example_id": "5c7b6cd7-085c-44a0-8e99-7824398c2415",
                                "sense_id": "4b3ca42c-efa2-31a1-8d6a-80ebdbf0f0e2",
                                "text": "‘De groene barkast heb ik tijdens mijn studentenjaren ooit nog gered van het groot huisvuil’, zegt Elke, die moet toegeven dat de barkast aan de kleine kant is, of dat er ten huize Arijs te veel wordt gedronken."
                            }
                        ]
                    }
