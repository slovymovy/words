                ],
                "senses": [
                    {
                        "sense_id": "3d2f6ad4-8863-3cef-86df-51eb18433716",
                        "entry_id": "a7fcbc11-0e3b-37de-95e4-304a1e53270f",
                        "glosses": [
                            "das, was mit einem Wort tatsächlich gemeint ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef9e3928-381d-4c2c-be14-9b567a795812",
                                "sense_id": "3d2f6ad4-8863-3cef-86df-51eb18433716",
                                "text": "„Darum waren die Dome für sie im Wortsinne die Burgen Gottes.“"
                            },
                            {
                                "example_id": "124699b2-903d-4a47-bd4a-33e046030ff5",
                                "sense_id": "3d2f6ad4-8863-3cef-86df-51eb18433716",
                                "text": "„In die andere Richtung muss deshalb Kritik gehen, wenn sich das Eigene einfältig im engsten Wortsinn auf sich selbst konzentriert und mit sich selbst begnügt.“"
                            },
                            {
                                "example_id": "184fe8dd-ef0f-48e7-99c4-2be964217e90",
                                "sense_id": "3d2f6ad4-8863-3cef-86df-51eb18433716",
                                "text": "„Schon seinem Wortsinn nach ist ein Sprichwort ein viel gesprochenes Wort, und leicht wird aus einem vielgesprochenen dann ein zu viel gesprochenes Wort.“"
                            },
                            {
                                "example_id": "0c3665b1-e9a3-4b20-ae16-887eb59bb919",
                                "sense_id": "3d2f6ad4-8863-3cef-86df-51eb18433716",
                                "text": "„Es gab Geizteufel, Faulteufel, Hausteufel, Hurenteufel, Saufteufel und Spielteufel, um nur einige aus der im Wortsinn erlesenen Schar zu nennen, die von der lutherischen Traktatliteratur aufgeboten wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
