    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "aff14055-37e0-3d96-baa9-0900f010a20f",
                "word": "lappet",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "698fe5cb-8790-4fd3-9776-a25de4bd4648",
                        "entry_id": "aff14055-37e0-3d96-baa9-0900f010a20f",
                        "tags": [
                            "plural"
                        ],
                        "form": "lappets"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9482339c-5849-3c0d-8928-cf968cadced3",
                        "entry_id": "aff14055-37e0-3d96-baa9-0900f010a20f",
                        "glosses": [
                            "A small decorative fold or flap, especially of lace or muslin, in a garment or headdress."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bceb98ce-7e23-41dc-9ba8-e25f2a2b25b6",
                                "sense_id": "9482339c-5849-3c0d-8928-cf968cadced3",
                                "text": "Oout of hiz boozom drawn foorth a lappet of his napkin, edged with a blu la[c]e, and marked with a trulooue, a hart & a D, for Damian: for he waz but a bachelar yet."
                            },
                            {
                                "example_id": "8d9853ba-cf59-4a3a-8e30-c77b2099131c",
                                "sense_id": "9482339c-5849-3c0d-8928-cf968cadced3",
                                "text": "[…] lifting up the Lappet of his Coat, he put me gently into it, and immediately ran along with me to his Master […]"
                            },
                            {
                                "example_id": "91d4d3d7-e925-4a29-bb5d-90f38334dcdf",
                                "sense_id": "9482339c-5849-3c0d-8928-cf968cadced3",
                                "text": "[…] he was presently undrest, all to his shirt, the fore-lappet of which, as he lean’d languishingly on me, he smilingly pointed to me, to observe, as it bellied out, or rose, and fell, according to the unruly starts of the motion behind it:",
                                "translation": "Fanny Hill",
                                "english": "Fanny Hill"
                            },
                            {
                                "example_id": "033c2bf0-1b33-4f5a-aa0a-59c69d5a6cdf",
                                "sense_id": "9482339c-5849-3c0d-8928-cf968cadced3",
                                "text": "He wears […] a white wig, the curls of which hang down like lappets over his shoulders, and form a good contrast with the plump, rosy, shining face beneath it."
                            },
                            {
                                "example_id": "26a76971-a613-42f1-afdc-f3eed4d86256",
                                "sense_id": "9482339c-5849-3c0d-8928-cf968cadced3",
                                "text": "Her rich, becoming dress fitted her perfect shape most admirably, and Fanchette had never arranged her coiffure to more advantage; the rich lappet of blonde, carelessly tied under the chin, hid all the \"defeatures time had made,\" without hiding the long white throat, for which she had always been remarkable, and was a beauty which had descended to all her daughters, even to the stigmatized Isabella."
                            },
                            {
                                "example_id": "29c64c8d-3ae5-4b0a-9075-634f78709774",
                                "sense_id": "9482339c-5849-3c0d-8928-cf968cadced3",
                                "text": "I have small breasts that lie flattened against the chest like lappets."
                            },
                            {
                                "example_id": "903f0560-8c38-4772-921a-60a4c12d9ce5",
                                "sense_id": "9482339c-5849-3c0d-8928-cf968cadced3",
                                "text": "She raises her face to the light. ‘How do you think I look? What will you say of me when the king asks you? I have not seen myself in a mirror these many months.’ She pats her fur cap, pulls its lappets over her ears; laughs."
                            }
                        ]
                    },
                    {
                        "sense_id": "5bbc30e7-821d-306f-8973-f82746c46ba3",
                        "entry_id": "aff14055-37e0-3d96-baa9-0900f010a20f",
                        "glosses": [
                            "A wattle or flap-like structure on the face."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26b872bc-c4a4-4218-9101-58b9def59a34",
                                "sense_id": "5bbc30e7-821d-306f-8973-f82746c46ba3",
                                "text": "Some vultures have lappets of bare flesh on the sides of the head."
                            },
                            {
                                "example_id": "8656dbc7-f568-4ac7-8412-e1db09a7034b",
                                "sense_id": "5bbc30e7-821d-306f-8973-f82746c46ba3",
                                "text": "Tompot blennies are distinguished by a pair of lappets above the eyes and dark stripes along the body."
                            }
                        ]
                    },
                    {
                        "sense_id": "2807960f-2591-3445-b06a-c66027323fac",
                        "entry_id": "aff14055-37e0-3d96-baa9-0900f010a20f",
                        "glosses": [
                            "A head-dress made with lappets for lace pendants."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "046a441e-4eb9-34bd-88b1-6e364a75d060",
                        "entry_id": "aff14055-37e0-3d96-baa9-0900f010a20f",
                        "glosses": [
                            "A lobe (division of an organ)."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "656e33a1-8235-448b-960d-222ee9c3f380",
                                "sense_id": "046a441e-4eb9-34bd-88b1-6e364a75d060",
                                "text": "In the tender lappet of the eare is supposed to rest the seat of remembrance, which we vse to touch when we mean to take one to beare witnesse of an arrest or other thing done,"
                            },
                            {
                                "example_id": "53422cf6-be6c-42a2-b60e-ecd19f73bfa1",
                                "sense_id": "046a441e-4eb9-34bd-88b1-6e364a75d060",
                                "text": "[…] he ran him in with the spit a little above the navel, towards the right flank, till he pierced the third lappet of his liver,"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1ab97bda-6a9e-4002-a1a8-175c70abc731",
                        "source_entry_id": "aff14055-37e0-3d96-baa9-0900f010a20f",
                        "source_sense_description": "small decorative fold or flap",
                        "target_lang_word": "bout",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bout",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "63f95e18-2cc6-3f38-9857-7529ade67c2f",
                                        "entry_id": "f1ccf1c4-f64b-347c-863e-5dcbd1e97c67",
                                        "glosses": [
                                            "Partie extrême d’une chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bbb34aaf-bfa2-4087-8713-61ef8806d8c0",
                                                "sense_id": "63f95e18-2cc6-3f38-9857-7529ade67c2f",
                                                "text": "Il habite à l’autre bout de la ville."
                                            },
                                            {
                                                "example_id": "7b4fa99e-9338-49dd-aea2-bca8aec65e8a",
                                                "sense_id": "63f95e18-2cc6-3f38-9857-7529ade67c2f",
                                                "text": "Le gros bout de poitrine, morceau de boucherie, à l’avant de la poitrine."
                                            },
                                            {
                                                "example_id": "b04195e1-8fdb-44e1-8db8-24722a729cb0",
                                                "sense_id": "63f95e18-2cc6-3f38-9857-7529ade67c2f",
                                                "text": "Il leur suffisait de tremper le bout des doigts dans une pipe de cidre ou une cuvée de vin pour changer cidre et vin en bouse liquide ; […]."
                                            },
                                            {
                                                "example_id": "7fb40c99-3008-4a40-8371-54ff9941960e",
                                                "sense_id": "63f95e18-2cc6-3f38-9857-7529ade67c2f",
                                                "text": "Il y a encore une autre région frontière orificielle qui est un foyer sexuel tactile de haute importance : le bout des seins."
                                            },
                                            {
                                                "example_id": "16610fca-046a-416a-a077-18e68c9d4994",
                                                "sense_id": "63f95e18-2cc6-3f38-9857-7529ade67c2f",
                                                "text": "À l’autre bout de l’horizon, un long troupeau de vaches montait vers les pâturages qui dominent la frontière tchéco-polonaise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c6da7521-faf8-33e3-a215-034d01b75e29",
                                        "entry_id": "f1ccf1c4-f64b-347c-863e-5dcbd1e97c67",
                                        "glosses": [
                                            "Ce qui garnit l’extrémité de certaines choses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58f4189f-1be6-4bff-972b-2723a94fff6e",
                                                "sense_id": "c6da7521-faf8-33e3-a215-034d01b75e29",
                                                "text": "Le bout d’un parapluie."
                                            },
                                            {
                                                "example_id": "a5f30739-36e4-4f49-9d78-14a489bace74",
                                                "sense_id": "c6da7521-faf8-33e3-a215-034d01b75e29",
                                                "text": "Le bout d’une allumette."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8510f1e0-c4eb-3434-99ca-e9a922e1625b",
                                        "entry_id": "f1ccf1c4-f64b-347c-863e-5dcbd1e97c67",
                                        "glosses": [
                                            "Petite partie de certaines choses ; morceau résiduel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ff31d96-6db7-4bd9-90d7-040aa7646636",
                                                "sense_id": "8510f1e0-c4eb-3434-99ca-e9a922e1625b",
                                                "text": "De mon cigare il ne me restait plus qu’un bout entre les lèvres, et, après en avoir aspiré les dernières bouffées, je le jette par-dessus le bord."
                                            },
                                            {
                                                "example_id": "5138acfe-cc07-4864-beee-940c9d8747b1",
                                                "sense_id": "8510f1e0-c4eb-3434-99ca-e9a922e1625b",
                                                "text": "Tous les paysans en étaient là, avec leur rapacité, leurs habitudes d’avarice. Ils faisaient le malheur de leurs enfants, en ne voulant pas les marier, quand l’un avait deux bouts de terre de plus que l’autre."
                                            },
                                            {
                                                "example_id": "6a5d2c4d-80e9-4752-80cb-90387a9c7580",
                                                "sense_id": "8510f1e0-c4eb-3434-99ca-e9a922e1625b",
                                                "text": "[…], M. Smallways se livrait à l’horticulture, sur ce dernier bout de terrain investi de jour en jour plus étroitement par les accaparements urbains."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fb5fc450-9e3f-32f2-8073-d391d3cd099e",
                                        "entry_id": "f1ccf1c4-f64b-347c-863e-5dcbd1e97c67",
                                        "glosses": [
                                            "Fin, terme, d’une chose qui dure dans le temps."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8652d874-6cce-42e2-a61b-367f7366d275",
                                                "sense_id": "fb5fc450-9e3f-32f2-8073-d391d3cd099e",
                                                "text": "Au bout du mois vous recevrez votre salaire."
                                            },
                                            {
                                                "example_id": "90e40f45-0db8-43b3-8d6c-a79998d04242",
                                                "sense_id": "fb5fc450-9e3f-32f2-8073-d391d3cd099e",
                                                "text": "C’est une affaire dont il ne verra jamais le bout."
                                            },
                                            {
                                                "example_id": "4e54a00a-af75-4b96-bb0d-135c53561852",
                                                "sense_id": "fb5fc450-9e3f-32f2-8073-d391d3cd099e",
                                                "text": "Telle était, ce soir, la misère d’Yves, qu’il n’imaginait même pas d’en voir jamais le bout."
                                            },
                                            {
                                                "example_id": "1e82e3cd-cf40-4cbc-b696-501a65ce6911",
                                                "sense_id": "fb5fc450-9e3f-32f2-8073-d391d3cd099e",
                                                "text": "le Périat a été mon précepteur, un si saint homme qu’on a dû le jeter dehors avant le bout de l’an, parce qu’on ne pouvait pas garder une bonne avec lui, qu’il ne l’eût mise enceinte, avant le bout du mois."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9268b195-4180-3a66-8e4b-08f4cfcfa149",
                                        "entry_id": "f1ccf1c4-f64b-347c-863e-5dcbd1e97c67",
                                        "glosses": [
                                            "Carte spéciale dans certains jeux de cartes, comme le tarot"
                                        ],
                                        "tags": [
                                            "Cartes à jouer"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "603d3e5b-54aa-4955-aa97-fa0158d041ae",
                                                "sense_id": "9268b195-4180-3a66-8e4b-08f4cfcfa149",
                                                "text": "Au tarot, il y a trois bouts : le petit (le un d’atout), l’excuse et le 21 d’atout."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c73574c-117c-3ceb-8817-572b39c1a647",
                                        "entry_id": "f1ccf1c4-f64b-347c-863e-5dcbd1e97c67",
                                        "glosses": [
                                            "Avant, proue, du bâtiment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b0a8b5e-f1b1-4c2e-b9fb-161247db574a",
                                                "sense_id": "1c73574c-117c-3ceb-8817-572b39c1a647",
                                                "text": "Ce bâtiment a le bout à terre."
                                            },
                                            {
                                                "example_id": "1058d501-96b0-4431-a4c6-8d5a6a705669",
                                                "sense_id": "1c73574c-117c-3ceb-8817-572b39c1a647",
                                                "text": "Naviguer vent de bout."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "083fc4d0-d9d7-34c1-887d-0f72a0087f03",
                                        "entry_id": "f1ccf1c4-f64b-347c-863e-5dcbd1e97c67",
                                        "glosses": [
                                            "Bord le plus court d’une plaque, d’une tôle, d’une planche ; et plus généralement, face étroite d’un objet pris dans sa largeur, par opposition au plat et au chant."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "bout",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f419023e-1ba2-3373-bbef-68f482360ccf",
                                        "entry_id": "0c5772b3-14c4-30ee-8b9f-ba3a9bd98b9f",
                                        "glosses": [
                                            "Cordage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04c3a894-e312-4179-9cda-a9915f714df7",
                                                "sense_id": "f419023e-1ba2-3373-bbef-68f482360ccf",
                                                "text": "Corde est donc un mot tabou à bannir de votre vocabulaire si vous voulez vous faire des amis dans le monde de la voile et chez les marins, malgré le nombre de cordages utilisés à bord pour le maniement des voiles et l’amarrage. Pour désigner une « corde » il faut dire un bout (prononcé boute), une aussière, un filin ou un cordage..."
                                            },
                                            {
                                                "example_id": "11da10ed-957a-4f39-bb71-2456fe9b125f",
                                                "sense_id": "f419023e-1ba2-3373-bbef-68f482360ccf",
                                                "text": "il plonge lui-même, sans masque ni palmes, avec la fameuse petra, la pierre plate de 12 kilogrammes qui était utilisée comme gueuse par les pêcheurs d’éponges, à l’extrémité d’un simple bout lové sur le pont du bateau."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
