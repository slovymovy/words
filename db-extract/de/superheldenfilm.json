                "senses": [
                    {
                        "sense_id": "a4fb29bb-c68a-3468-baa0-5d76bb6eb263",
                        "entry_id": "2adcc32f-b05d-3d00-b184-71369c2a0f9f",
                        "glosses": [
                            "Film mit einem oder mehreren Superhelden als Hauptfigur"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b11276e-c35e-42af-9b35-c7740532b97a",
                                "sense_id": "a4fb29bb-c68a-3468-baa0-5d76bb6eb263",
                                "text": "„Schon bald werden sie durch etliche gemeinsame Interessen und Anschauungen dicke Freunde. Zum Beispiel gefallen ihnen Superheldenfilme jeder Art, und beide sind fest entschlossen, in einträglichere Ränge der Gang aufzusteigen.“"
                            },
                            {
                                "example_id": "ad124453-4840-489e-9df5-596c5ca7a421",
                                "sense_id": "a4fb29bb-c68a-3468-baa0-5d76bb6eb263",
                                "text": "„Don und Joey waren zu Hause und haben sich einen Film angesehen, einen Superheldenfilm, hinten im Hobbyraum.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
