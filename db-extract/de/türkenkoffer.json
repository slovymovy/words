                        "examples": [
                            {
                                "example_id": "e3e87c12-44e5-4aa4-9078-c9de40449014",
                                "sense_id": "44628094-5da1-33f4-869b-3a1e12404b4e",
                                "text": "Lange Zeit galt die als \"Türkenkoffer\" verunglimpfte Aldi-Plastiktasche als Makel unter Imagebewußten. Doch es gibt bereits Leute, die tragen freiwillig das blau-orange Aldi-Signet auf dem T-Shirt."
                            },
                            {
                                "example_id": "0e9d3061-b640-4fd2-a99d-172b34853586",
                                "sense_id": "44628094-5da1-33f4-869b-3a1e12404b4e",
                                "text": "Vor ihnen auf dem Boden standen zwei prallgefüllte Tragetaschen, drei reichlich bestückte Körbe und vier Binkerln. Die beiden reisen gern mit Gepäck der Sorte »Türkenkoffer«."
                            }
                        ]
                    }
