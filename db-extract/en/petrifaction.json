                    },
                    {
                        "sense_id": "7678517b-c42f-32ff-83e5-9715747c17fc",
                        "entry_id": "8e730783-5e0a-30be-b120-58546208bc96",
                        "glosses": [
                            "An object that has become petrified."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "25639c70-04da-4a57-9b46-3afede6b0c5c",
                                "sense_id": "7678517b-c42f-32ff-83e5-9715747c17fc",
                                "text": "An Indian cabinet, consisting of a small but choice collection of petrefactions and fossils, was placed in a recess at the bottom of the room; a few paintings and portraits from the pencil of the most eminent artists adorned the walls."
                            }
                        ]
                    },
                    {
                        "sense_id": "b0bf2a05-84b3-30f5-9c4c-ba807e76f4e5",
                        "entry_id": "8e730783-5e0a-30be-b120-58546208bc96",
                        "glosses": [
                            "The condition of being petrified."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "db145eca-4a7c-484f-8969-9b5eec47f3ba",
                                "sense_id": "b0bf2a05-84b3-30f5-9c4c-ba807e76f4e5",
                                "text": "The crisp leaves of holly, mistletoe, and ivy reflected back the light, as if so many little mirrors had been scattered there; and such a mighty blaze went roaring up the chimney, as that dull petrifaction of a hearth had never known in Scrooge's time, or Marley's, or for many and many a winter season gone."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ee2c8793-a8d6-46ba-9b7b-8eec7e4fef12",
                        "source_entry_id": "8e730783-5e0a-30be-b120-58546208bc96",
                        "source_sense_description": "condition of being petrified",
                        "target_lang_word": "Versteinerung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Versteinerung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e23821f5-640e-313d-956b-a07579cdf4ad",
                                        "entry_id": "80c64e93-5a91-3018-8dcd-0cb496b09b42",
                                        "glosses": [
                                            "der Vorgang des Versteinerns"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d04ec5b-f18e-4def-a186-b0b030df6b9d",
                                                "sense_id": "e23821f5-640e-313d-956b-a07579cdf4ad",
                                                "text": "Die Versteinerung spielt sich in mehreren Schritten ab."
                                            },
                                            {
                                                "example_id": "ec335db4-74d7-4a9e-b679-aa10bda194d6",
                                                "sense_id": "e23821f5-640e-313d-956b-a07579cdf4ad",
                                                "text": "übertragen: Allmählich erwachte er aus seiner Versteinerung."
                                            },
                                            {
                                                "example_id": "0350bfe1-892d-4b59-8778-a68f7b2c21f0",
                                                "sense_id": "e23821f5-640e-313d-956b-a07579cdf4ad",
                                                "text": "übertragen: „Balaschow bemerkte, dass des Kaisers linke Wade jetzt noch rascher als zuvor zitterte und sein Gesicht gleichsam einen Ausdruck der Versteinerung angenommen hatte.“"
                                            },
                                            {
                                                "example_id": "c32a0da6-fd33-47c9-8ca1-19a8ce3171ff",
                                                "sense_id": "e23821f5-640e-313d-956b-a07579cdf4ad",
                                                "text": "übertragen: „Sie ist um so mehr erforderlich, als die Politik der Bundesregierung praktisch zu einer Versteinerung des Haushalts geführt hat; er hat kaum noch eine nennenswerte Beweglichkeit aufzuweisen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6e92b470-a333-397f-a4e2-f8464aa35af5",
                                        "entry_id": "80c64e93-5a91-3018-8dcd-0cb496b09b42",
                                        "glosses": [
                                            "versteinertes Fossil"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cce44fb2-48fa-4375-8c4a-33616ceb40f1",
                                                "sense_id": "6e92b470-a333-397f-a4e2-f8464aa35af5",
                                                "text": "Hier sind viele Versteinerungen zu finden."
                                            },
                                            {
                                                "example_id": "8eb171f7-1ff9-45a6-ad6f-236b0a092984",
                                                "sense_id": "6e92b470-a333-397f-a4e2-f8464aa35af5",
                                                "text": "„In der Vergangenheit gingen Expertinnen und Experten davon aus, dass es sich bei den in einer Sammlung gelagerten Versteinerungen um Überreste von Plateosauriern handelt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
