                "senses": [
                    {
                        "sense_id": "83c73725-795c-3cb4-8660-b757796c5e6f",
                        "entry_id": "0ac7f211-1878-3c19-8d7f-e361643a717c",
                        "glosses": [
                            "iemand die geneigd is alles van de negatieve kant te zien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "88cecc08-7a4d-4975-b98a-ce765005a80b",
                                "sense_id": "83c73725-795c-3cb4-8660-b757796c5e6f",
                                "text": "Toen de wapenstilstand ten slotte een aannemelijk vooruitzicht werd, begon de hoop het er levend af te brengen zelfs bij de grootste pessimisten post te vatten."
                            }
                        ]
                    },
                    {
                        "sense_id": "c1e6a94a-d560-3540-bf70-6b9213fbf4f6",
                        "entry_id": "0ac7f211-1878-3c19-8d7f-e361643a717c",
                        "glosses": [
                            "aanhanger van het pessimisme"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ba410e91-b204-4b46-ab23-4523c72a6f7f",
                        "source_entry_id": "0ac7f211-1878-3c19-8d7f-e361643a717c",
                        "target_lang_word": "Pessimist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pessimist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bfc8dc11-f7be-393a-b2da-5a0cb3c510aa",
                                        "entry_id": "d7ba3975-48cf-3a6a-a763-95ee51843303",
                                        "glosses": [
                                            "pessimistisch denkender Mensch; Mensch, der eine negative Einstellung zum Leben hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c63fa2ed-4859-444b-87cd-06fbcc3db2c6",
                                                "sense_id": "bfc8dc11-f7be-393a-b2da-5a0cb3c510aa",
                                                "text": "Du bist unverbesserlicher Pessimist. Lächle doch einmal!"
                                            },
                                            {
                                                "example_id": "9b3e902c-3d0a-4ee4-a3ec-058582225272",
                                                "sense_id": "bfc8dc11-f7be-393a-b2da-5a0cb3c510aa",
                                                "text": "„George, mit dem ich in den letzten zwei Jahren schon viele tiefsinnige Gespräche über Leben und Tod, Gott und die Welt, Geld, Familie, Freundschaft und Gerechtigkeit geführt hatte, war ein eingefleischter Pessimist.“"
                                            },
                                            {
                                                "example_id": "ec87aa00-5a37-407c-b7f2-bbb1c88bc71a",
                                                "sense_id": "bfc8dc11-f7be-393a-b2da-5a0cb3c510aa",
                                                "text": "„Ludda-Kristjan wusste nicht, was ein Pessimist ist, und Adelheid, die ihn gern ärgerte, sagte, ein Pessimist sei das Gegenteil eines Optimisten.“"
                                            },
                                            {
                                                "example_id": "6d5b77c1-9e79-459a-9558-f324a37c349d",
                                                "sense_id": "bfc8dc11-f7be-393a-b2da-5a0cb3c510aa",
                                                "text": "„Der Pessimist und Gestalter der melancholischen Trauer feiert sie immer wieder, sie ist die letzte Stütze seiner müden Verlierer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0df5c47d-6038-4e19-a7bf-a6c6cf3921b0",
                        "source_entry_id": "0ac7f211-1878-3c19-8d7f-e361643a717c",
                        "target_lang_word": "pessimist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pessimist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "efbafcc5-0f9e-3356-b096-cf657be45949",
                                        "entry_id": "aa073281-4a76-3c5e-b068-8b15aa3a24d3",
                                        "glosses": [
                                            "Someone who habitually expects the worst outcome; one who looks on the dark side of things."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b15ad7f7-1dd6-462d-a699-cccfbf1b230e",
                                                "sense_id": "efbafcc5-0f9e-3356-b096-cf657be45949",
                                                "text": "I will not marry a pessimist, a born loser, a fellow who has no fight in him."
                                            },
                                            {
                                                "example_id": "6731ccf5-a131-4a56-a759-2d2deae0c888",
                                                "sense_id": "efbafcc5-0f9e-3356-b096-cf657be45949",
                                                "text": "We are becoming as a nation, as a world, indeed, atom-conscious. Many of us are already afflicted with atomphobia, though so far it has manifested itself only in a mirage of autoaeromotive discs and a war of words between chronic optimists and empirical pessimists concerning civilization’s probable future."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c48ce015-08b9-4cfe-b24c-9a38a6f7b380",
                        "source_entry_id": "0ac7f211-1878-3c19-8d7f-e361643a717c",
                        "target_lang_word": "pessimiste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pessimiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a2a47589-0ab4-3bd1-a6e0-73efd743c76f",
                                        "entry_id": "db534a62-b169-3fa6-bcef-3dbd99b2264f",
                                        "glosses": [
                                            "Qui a rapport au pessimisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f27049e4-0776-4e1b-83d3-83b593b8683c",
                                                "sense_id": "a2a47589-0ab4-3bd1-a6e0-73efd743c76f",
                                                "text": "Doctrine pessimiste."
                                            },
                                            {
                                                "example_id": "d99fc85c-86d0-4538-ad51-08f0297df4ea",
                                                "sense_id": "a2a47589-0ab4-3bd1-a6e0-73efd743c76f",
                                                "text": "Une des plus sombres et des plus pessimistes tragédies, Hécube, illustre les conséquences d’une guerre sanglante qui pèsent sur la vie des populations vaincues."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b65d9617-9ee7-3c29-a3dd-8a0c8ba8a6d5",
                                        "entry_id": "db534a62-b169-3fa6-bcef-3dbd99b2264f",
                                        "glosses": [
                                            "Qui est disposé naturellement à trouver que tout est mauvais, que tout va mal, à être mécontent de tout."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15aca53e-a8ba-4524-8dab-98e125bd8201",
                                                "sense_id": "b65d9617-9ee7-3c29-a3dd-8a0c8ba8a6d5",
                                                "text": "Certaines enquêtes ne retiennent que les études qui leur paraissent de bonne qualité ; d’autres sont moins exigeantes et il est probable que les précautionnistes ou les écologistes ont tendance à privilégier les travaux les plus pessimistes, au nom de l’heuristique de la peur, […]."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pessimiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fc44d4b3-7c6f-3df9-94fc-22022e92392f",
                                        "entry_id": "b9f9c479-726e-3be2-af13-83b252de5556",
                                        "glosses": [
                                            "Philosophe qui professe le pessimisme."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "379dced6-a72b-34dd-8631-265d978a5995",
                                        "entry_id": "b9f9c479-726e-3be2-af13-83b252de5556",
                                        "glosses": [
                                            "Celui ou celle qui voit les choses en noir."
                                        ],
                                        "tags": [
                                            "common"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ce35c45-f6de-4365-b802-170eb49c99e9",
                                                "sense_id": "379dced6-a72b-34dd-8631-265d978a5995",
                                                "text": "Oh! tu sais, je ne suis qu’un pessimiste platonique, moi; il y en a de plus forcenés."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "702cbde9-b780-4c57-8db0-1b2329fbaa29",
                        "source_entry_id": "0ac7f211-1878-3c19-8d7f-e361643a717c",
