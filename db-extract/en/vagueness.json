                                        "entry_id": "3a57886a-191a-379e-8133-f5ab3e87480a",
                                        "glosses": [
                                            "Eigenschaft oder Zustand, nicht genau bestimmt zu sein"
                                        ],
                                        "tags": [
                                            "no-plural"
