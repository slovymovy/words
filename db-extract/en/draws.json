                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "3e4e9fac-9ee3-31bc-8c37-275dce14c875",
                        "entry_id": "9207c660-f17b-3541-99b0-c01f77868643",
                        "glosses": [
                            "Synonym of drawers."
                        ],
                        "tags": [
                            "plural",
                            "plural-only",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "9aee2741-fe18-45a8-a414-f00d40cce7d4",
                                "sense_id": "3e4e9fac-9ee3-31bc-8c37-275dce14c875",
                                "text": "He’d said, “Boss, that lady packed that man right up. She put his suits and shirts in wardrobe boxes, and then”—the man started laughing—“and then she went and stuffed all of old boy’s funky draws down in that box with all of his good clothes.” “Mookie, how did you know his draws were in the wardrobe boxes?” Mookie just looked at Charles like he was crazy, and then said, “Dawg, dawg. You know what your draws smell like when you take ’em off and drop ’em in the hamper, right?”"
                            },
                            {
                                "example_id": "09c9a6f3-54a3-4ea5-8bae-6391e83404ee",
                                "sense_id": "3e4e9fac-9ee3-31bc-8c37-275dce14c875",
                                "text": "When them girls crowded around him, he looked like he was about to shit his draws!"
                            },
                            {
                                "example_id": "6b38064c-8270-4623-ace6-0a687bc69166",
                                "sense_id": "3e4e9fac-9ee3-31bc-8c37-275dce14c875",
                                "text": "“I finally asked him to choose, and he told me on her front porch in holey draws and a dingy wifebeater, he was in love with the other woman.”"
                            }
                        ]
                    }
                ],
