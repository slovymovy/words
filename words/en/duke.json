{
    "word_family": [
        "duchess",
        "duchy",
        "dukedom",
        "ducal"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "afc8c3a0-6a61-3aa9-81f3-1d3584eff693",
                    "sense_definition": "A nobleman of the highest rank, historically the ruler of a duchy or a member of royalty ranking just below a prince.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "nobility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>duke</w> and duchess greeted the guests at the castle entrance.",
                            "target_lang_translations": {
                                "ru": "<w>Герцог</w> и герцогиня приветствовали гостей у входа в замок.",
                                "zh": "<w>公爵</w>和公爵夫人在城堡入口处迎接客人。"
                            }
                        },
                        {
                            "text": "In the fairy tale, the king granted the brave knight the title of <w>duke</w>.",
                            "target_lang_translations": {
                                "ru": "В сказке король даровал отважному рыцарю титул <w>герцога</w>.",
                                "zh": "在童话故事里，国王授予那位勇敢的骑士<w>公爵</w>的头衔。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Дворянин высшего ранга, исторически правитель герцогства или член королевской семьи, стоящий рангом ниже принца.",
                        "zh": "欧洲贵族等级之一，地位仅次于亲王，通常是公国的统治者。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ге́рцог",
                                "target_lang_sense_clarification": "Титул в Западной Европе"
                            },
                            {
                                "target_lang_word": "князь",
                                "target_lang_sense_clarification": "Аналог в славянских странах (например, Великий князь)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "公爵",
                                "target_lang_sense_clarification": "欧洲贵族爵位"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8994d864-24ed-3fb6-bfa4-ebb5177506ad",
                    "sense_definition": "A fist, typically used in the context of fighting.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "body_part_slang",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "\"Put up your <w>dukes</w>!\" he shouted, challenging the man to a fight.",
                            "target_lang_translations": {
                                "ru": "«Поднимай <w>кулаки</w>!» — крикнул он, вызывая мужчину на бой.",
                                "zh": "“亮出你的<w>拳头</w>来！”他大喊着，向那个人发起挑战。"
                            }
                        },
                        {
                            "text": "The old boxer showed us how to hold our <w>dukes</w> properly for defense.",
                            "target_lang_translations": {
                                "ru": "Старый боксер показал нам, как правильно держать <w>кулаки</w> для защиты.",
                                "zh": "那位老拳击手向我们展示了如何正确地握紧<w>拳头</w>以进行防御。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "put up one's dukes"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Кулак, обычно используется в контексте драки (сленг).",
                        "zh": "指拳头，多用于打架斗殴的语境（俚语）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кулак",
                                "target_lang_sense_clarification": "Прямое значение"
                            },
                            {
                                "target_lang_word": "клешня",
                                "target_lang_sense_clarification": "Сленг, грубое"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "拳头",
                                "target_lang_sense_clarification": "指手部握紧的状态"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "53ff9f71-5eba-3ac6-b111-7e9706a92d75",
                    "sense_definition": "A male given name or nickname.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "name_person",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "My uncle <w>Duke</w> has lived in Texas for over thirty years.",
                            "target_lang_translations": {
                                "ru": "Мой дядя <w>Дюк</w> живет в Техасе уже более тридцати лет.",
                                "zh": "我的叔叔<w>杜克</w>在德克萨斯州已经住了三十多年了。"
                            }
                        },
                        {
                            "text": "He earned the nickname <w>Duke</w> because of his confident and commanding walk.",
                            "target_lang_translations": {
                                "ru": "Он получил прозвище <w>Дюк</w> из-за своей уверенной и властной походки.",
                                "zh": "他因为走路姿势自信且威严，所以赢得了“<w>杜克</w>”这个绰号。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Мужское имя или прозвище.",
                        "zh": "男性的名字或绰号。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Дюк",
                                "target_lang_sense_clarification": "Имя/Прозвище"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "杜克",
                                "target_lang_sense_clarification": "人名或绰号"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a5898b06-dc1c-3b67-a56b-4ce32168a37f",
                    "sense_definition": "A private research university located in Durham, North Carolina.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "name_org",
                    "name_type": "organization_name",
                    "examples": [
                        {
                            "text": "She was thrilled to receive her acceptance letter from <w>Duke</w>.",
                            "target_lang_translations": {
                                "ru": "Она была в восторге, получив письмо о зачислении из <w>Дьюка</w>.",
                                "zh": "她收到<w>杜克大学</w>的录取通知书时感到非常激动。"
                            }
                        },
                        {
                            "text": "The basketball team from <w>Duke</w> is known for its strong performance in the tournament.",
                            "target_lang_translations": {
                                "ru": "Баскетбольная команда из <w>Дьюка</w> известна своим сильным выступлением на турнире.",
                                "zh": "<w>杜克大学</w>的篮球队以其在锦标赛中的出色表现而闻名。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Частный исследовательский университет, расположенный в Дареме, Северная Каролина.",
                        "zh": "位于美国北卡罗来纳州达勒姆市的一所私立研究型大学。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Дьюк",
                                "target_lang_sense_clarification": "Университет"
                            },
                            {
                                "target_lang_word": "Университет Дьюка",
                                "target_lang_sense_clarification": "Полное название"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "杜克大学",
                                "target_lang_sense_clarification": "美国著名高校"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3f121d76-02ae-32f3-9f2b-a13d4e87c05d",
                    "sense_definition": "To hit or fight someone using fists.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "action_fight",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The two rivals decided to <w>duke</w> it out in the parking lot after school.",
                            "target_lang_translations": {
                                "ru": "Два соперника решили <w>подраться</w> на парковке после школы.",
                                "zh": "那两个对手决定放学后在停车场<w>打一架</w>。"
                            }
                        },
                        {
                            "text": "He got <w>duked</w> in the eye during the scuffle at the bar.",
                            "target_lang_translations": {
                                "ru": "Во время потасовки в баре ему <w>заехали</w> в глаз.",
                                "zh": "在酒吧的混战中，他的眼睛被人<w>打</w>了一拳。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "duke it out"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Бить кого-то или драться с кем-то на кулаках.",
                        "zh": "用拳头打人或与人打架（俚语）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "драться",
                                "target_lang_sense_clarification": "Выяснять отношения"
                            },
                            {
                                "target_lang_word": "мутузить",
                                "target_lang_sense_clarification": "Сленг"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "打架",
                                "target_lang_sense_clarification": "肢体冲突"
                            },
                            {
                                "target_lang_word": "挥拳",
                                "target_lang_sense_clarification": "动作描述"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b0ab69f5-0a6a-3bfd-bbe3-734623cbf454",
                    "sense_definition": "To give cash to someone, often as a tip or gratuity.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "action_give",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I <w>duked</w> the doorman twenty dollars to get us a good table.",
                            "target_lang_translations": {
                                "ru": "Я <w>сунул</w> швейцару двадцать долларов, чтобы нам дали хороший столик.",
                                "zh": "我给门卫<w>塞</w>了二十美元，让他给我们安排了一个好位子。"
                            }
                        },
                        {
                            "text": "He quietly <w>duked</w> the porter for carrying the heavy luggage upstairs.",
                            "target_lang_translations": {
                                "ru": "Он тихо <w>дал на чай</w> носильщику за то, что тот поднял тяжелый багаж наверх.",
                                "zh": "他悄悄地<w>给</w>了搬运工小费，感谢他把沉重的行李搬上楼。"
                            }
                        }
                    ],
                    "synonyms": [
                        "tip"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Давать кому-то наличные, часто в качестве чаевых или взятки.",
                        "zh": "给某人现金，通常指给小费或贿赂（俚语）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сунуть",
                                "target_lang_sense_clarification": "Дать денег (разг.)"
                            },
                            {
                                "target_lang_word": "дать на лапу",
                                "target_lang_sense_clarification": "Дать взятку (идиома)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "塞钱",
                                "target_lang_sense_clarification": "私下给钱"
                            },
                            {
                                "target_lang_word": "给小费",
                                "target_lang_sense_clarification": "酬谢服务"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}