                "senses": [
                    {
                        "sense_id": "4468bb05-3b5f-355e-a6c5-9fa8de049645",
                        "entry_id": "9e98f50a-9de6-3163-8af3-195f56c5a609",
                        "glosses": [
                            "цитол. деление ядра соматических клеток эукариотов с сохранением числа хромосом"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91ac709d-849d-4207-b82d-5cab95f2f202",
                                "sense_id": "4468bb05-3b5f-355e-a6c5-9fa8de049645",
                                "text": "Точно так же, вопреки тому, что пишется почти во всех школьных и вузовских учебниках, митоз и мейоз ― это не деление клеток, а деление клеточных ядер."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b64b4000-7dec-4ebd-a3fd-bddfbb953268",
                        "source_entry_id": "9e98f50a-9de6-3163-8af3-195f56c5a609",
                        "source_sense_id": "4468bb05-3b5f-355e-a6c5-9fa8de049645",
                        "target_lang_word": "mitosis",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mitosis",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fca3c2c7-3cb1-36a3-b419-605543caf2be",
                                        "entry_id": "f8b4d33c-cf56-39a0-bcc3-33ae2c8843c7",
                                        "glosses": [
                                            "The division of a cell nucleus in which the genome is copied and separated into two identical halves. It is normally followed by cell division."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b4fc6d9e-dde9-42c7-b132-ffe3b96007e1",
                                                "sense_id": "fca3c2c7-3cb1-36a3-b419-605543caf2be",
                                                "text": "Meronyms: prophase, metaphase, anaphase, telophase"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1e5b0fe1-316c-4b11-8095-b99ea0a67270",
                        "source_entry_id": "9e98f50a-9de6-3163-8af3-195f56c5a609",
                        "source_sense_id": "4468bb05-3b5f-355e-a6c5-9fa8de049645",
                        "target_lang_word": "mitosis",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mitosis",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "7290bfa2-d612-35bd-9055-8b7dcc888b5d",
