                "senses": [
                    {
                        "sense_id": "e79840a0-ba49-3882-8cc5-f8711e7bb077",
                        "entry_id": "4fbe0f39-8773-3659-8848-257659a81018",
                        "glosses": [
                            "Rendre rectilinéaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "068c5e81-d67d-47d4-9941-9a7b89372c92",
                                "sense_id": "e79840a0-ba49-3882-8cc5-f8711e7bb077",
                                "text": "Si tu n'utilises ni Photoshop ni Lightroom.... alors je peux te conseiller \"PTLens\", un outil qui te permettra de \"rectilinéariser\" ton image fisheye."
                            },
                            {
                                "example_id": "243e8ec0-f39f-486a-815f-3f9e107252b5",
                                "sense_id": "e79840a0-ba49-3882-8cc5-f8711e7bb077",
                                "text": "Deuxièmement, l’abattage permettait également de « rectilinéariser » le bord abrupt. (vraisemblablement en vue de l’emmanchement)."
                            },
                            {
                                "example_id": "9a81178b-04fd-4b9d-be26-cde22e54ca18",
                                "sense_id": "e79840a0-ba49-3882-8cc5-f8711e7bb077",
                                "text": "Les zones construites sur les anciens deltas des fleuves côtiers sont déjà celles qui subissent le plus le recul du trait de côte, la côte tendant à se rectilinéariser, en gommant complètement les dernières aspérités."
                            }
                        ]
                    }
