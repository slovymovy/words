                "senses": [
                    {
                        "sense_id": "f2b4f042-5c1f-316f-accc-07cfb9ca59b0",
                        "entry_id": "c5ba6015-bd32-3119-8481-cd93331eee88",
                        "glosses": [
                            "Qui siffle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "919b3214-acea-4d0f-b275-002beddf56f6",
                                "sense_id": "f2b4f042-5c1f-316f-accc-07cfb9ca59b0",
                                "text": "Parmi ces bruits anormaux, deux ont été signalés comme pouvant se rattacher plus directement que les autres à l’emphysème : le râle sous-crépitant, par Laënnec, et le râle sibilant, par M. Louis."
                            },
                            {
                                "example_id": "34007f53-15c8-4b34-ba67-f143a2f8cf56",
                                "sense_id": "f2b4f042-5c1f-316f-accc-07cfb9ca59b0",
                                "text": "Elle sentait ses bagues tortiller autour de ses doigts comme de petites et sibilantes vipères, à la langue de flamme, et elle tremblait de s’être trop attachée à quelque favorite de Satan."
                            }
                        ]
                    },
                    {
                        "sense_id": "8bbecc73-c16e-34d7-9395-c3c9d2cb080c",
                        "entry_id": "c5ba6015-bd32-3119-8481-cd93331eee88",
                        "glosses": [
                            "Qui émet un son rappelant un sifflement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6fb4971-37da-4c2a-8c7e-eccb3614eb21",
                                "sense_id": "8bbecc73-c16e-34d7-9395-c3c9d2cb080c",
                                "text": "Vêtue d’une jupe droite au bruissement sibilant, comme pour prévenir qu’elle mordrait la main qui oserait s’approcher de sa fermeture Éclair, elle ressemblait davantage à une directrice de collège privé qu’à un modèle de féminité."
                            }
                        ]
                    }
                ],
