                        ],
                        "examples": [
                            {
                                "example_id": "78a7a34b-b558-4140-99d0-cf9e18288b0c",
                                "sense_id": "c3829917-1cb1-3b37-8826-a07a9f9fecf2",
                                "text": "Le Chaouch est répandu sur toutes les côtes de la Méditerranée, depuis l'Algérie et l'Égypte jusqu'à l'Adriatique, mais il est le plus particulièrement cultivé en Turquie d'Europe, en Turquie d'Asie, en Grèce et en Crimée."
                            }
                        ]
                    }
                ],
