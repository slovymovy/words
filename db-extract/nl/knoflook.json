                        "entry_id": "1c0722ea-764f-3c03-9488-bac2d097caec",
                        "glosses": [
                            "overblijvend bolgewas Allium sativum uit de lookonderfamilie met samengevouwen bol en roze tot violette tweeslachgtige bloemen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e89c0a96-7406-47fe-bdfd-6b7157f0f7de",
                                "sense_id": "1bd2fc7e-2dcf-3fa6-82ea-9be9d8c5da51",
                                "text": "En mengsel uit de middeleeuwen bestaande uit wijn, knoflook en maagzuur kan mogelijk helpen tegen de moderne MRSA-bacterie"
                            },
                            {
                                "example_id": "16c327f2-3cf9-4602-9349-8aa615f0b631",
                                "sense_id": "1bd2fc7e-2dcf-3fa6-82ea-9be9d8c5da51",
                                "text": "Van avocado en knoflook wordt guacamole gemaakt."
                            }
                        ]
                    }
