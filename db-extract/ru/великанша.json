                "senses": [
                    {
                        "sense_id": "95c4dffd-1587-3dff-bd9b-8e4da9bedb9c",
                        "entry_id": "4c8e870a-ab90-3fbb-af53-b5898c282e6e",
                        "glosses": [
                            "женск. к великан; очень высокая женщина"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9f30193-6974-4f49-bb90-d7f9f538d360",
                                "sense_id": "95c4dffd-1587-3dff-bd9b-8e4da9bedb9c",
                                "text": "И представила, что учительница Недыбайла должна быть огромная, как каменная великанша, с большими руками и ногами."
                            },
                            {
                                "example_id": "5d9200ea-cb10-4711-9211-4dde4e962083",
                                "sense_id": "95c4dffd-1587-3dff-bd9b-8e4da9bedb9c",
                                "text": "Пришлось поднять голову. Великанша оказалась женщиной-вамп. Я сполз с табуретки и сказал..."
                            }
                        ]
                    }
                ],
