                                        "sense_id": "d3ef2a3a-38d9-351e-ad87-a86dff5560a7",
                                        "entry_id": "2006ea1e-4bb0-3e9a-b5bc-b02199e82d2f",
                                        "glosses": [
                                            "durch bestimmte Umstände im Nachteil seiend"
