                                "target_lang_word": "минус",
                                "target_lang_sense_clarification": "математический знак"
                            },
                            {
                                "target_lang_word": "знак минуса",
                                "target_lang_sense_clarification": "графический символ"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "减号",
                                "target_lang_sense_clarification": "数学符号"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "663e3aa8-057d-3920-bffe-a9308f493c13",
                    "sense_definition": "A quantity that is less than zero.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mathematics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The final result of the calculation was a <w>minus</w>.",
                            "target_lang_translations": {
                                "ru": "Итоговым результатом вычисления стала <w>отрицательная величина</w>.",
                                "zh": "计算的最终结果是一个<w>负数</w>。"
                            }
                        },
                        {
                            "text": "In this equation, the <w>minus</w> represents a debt.",
                            "target_lang_translations": {
                                "ru": "В этом уравнении <w>минус</w> обозначает долг.",
                                "zh": "在这个等式中，这个<w>负数</w>代表债务。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Величина, которая меньше нуля.",
                        "zh": "小于零的量。"
                    },
                    "translations": {
                        "ru": [
