                        ],
                        "examples": [
                            {
                                "example_id": "43370acd-6076-4ac7-8b6e-84f4432f0105",
                                "sense_id": "91e91735-d519-3434-a165-fc90de515780",
                                "text": "Chrysippus said that some Philosophers would in open view of all men shew a dozen of tumbling-tricks, yea, without any slops or breeches, for a dozen of olives."
                            },
                            {
                                "example_id": "cbfd3f70-02bc-4a04-9746-3b83b22036cf",
                                "sense_id": "91e91735-d519-3434-a165-fc90de515780",
                                "text": "A pair of slops.",
                                "translation": "The New Arcadia",
