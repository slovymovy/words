                        ],
                        "examples": [
                            {
                                "example_id": "4e31aa32-2503-4067-81f6-90d274981448",
                                "sense_id": "84e81271-c9d1-3d92-8ae1-4cc4ae530f43",
                                "text": "„Iss’n richtiges Scheißkaff; kann man vergessen, was?“"
                            },
                            {
                                "example_id": "1662938c-9dab-413a-984d-99dfcc8b16a7",
                                "sense_id": "84e81271-c9d1-3d92-8ae1-4cc4ae530f43",
                                "text": "„Menschen haben mich vor meiner Zeit in diesem Scheißkaff eigentlich einen Dreck interessiert, aber irgendwie gefällt mir die Sache mittlerweile; Leute, die sich ernst über Abwasserentsorgung und untreue Ehepartner unterhalten, darüber, dass Unterkünfte für den Winter und bessere Lehrmethoden für Mathe hermüssen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
