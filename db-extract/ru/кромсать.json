                            "future"
                        ],
                        "form": "буду/будешь… кромса́ть"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d420f42b-c5f4-3fbd-aac5-0b3602f08f0a",
                        "entry_id": "3dfa4f85-fa3c-385a-9649-775465226106",
                        "glosses": [
                            "небрежно, неаккуратно резать что-либо на куски, на части"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b2fc90f-a9bb-474e-aa7f-26ea658e60e5",
                                "sense_id": "d420f42b-c5f4-3fbd-aac5-0b3602f08f0a",
                                "text": "Скоро вернулась Варвара, ― ещё Передонов кромсал остатки платья. Она подумала, что он пьян, и принялась ругаться."
                            },
                            {
                                "example_id": "c1a6291e-682c-4ecd-9504-89df177af295",
                                "sense_id": "d420f42b-c5f4-3fbd-aac5-0b3602f08f0a",
                                "text": "И опять занялся своим делом: тонкими на диво ломтиками кромсал крупитчатый белый картофель."
                            },
                            {
                                "example_id": "4f776395-1c5b-4d1d-a054-311b299ed20e",
                                "sense_id": "d420f42b-c5f4-3fbd-aac5-0b3602f08f0a",
                                "text": "Рядом дед Артем из-под шершавой ладони смотрит, как за пахучими буграми сурчи́ных нор трактор чернозёмную целину кромсает глянцевитыми ломтями."
                            },
                            {
                                "example_id": "2ce918f3-9509-454c-9624-507af260de10",
                                "sense_id": "d420f42b-c5f4-3fbd-aac5-0b3602f08f0a",
                                "text": "Денис Караваев кромсал арбуз, преподносил на кончике ножа лучшие куски царю."
                            }
                        ]
                    },
                    {
                        "sense_id": "2eb6ebde-17ad-361e-a646-f8db6a3aa148",
                        "entry_id": "3dfa4f85-fa3c-385a-9649-775465226106",
                        "glosses": [
                            "перен. портить, искажать что-либо, дробя на части или меняя расположение частей (обычно о рукописи)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "713a9819-37fa-40a5-af6f-86ebd3969db0",
                                "sense_id": "2eb6ebde-17ad-361e-a646-f8db6a3aa148",
                                "text": "Я уверен, что фильм может получиться отличный, если Вы будете держаться достаточно твёрдо и не позволите никому кромсать и коверкать текст сценария, как это было при экранизации «Сказки о глупом мышонке», «Теремка» и т. д."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eb80b903-9ffe-47bd-99b0-9b7c0dfdea79",
                        "source_entry_id": "3dfa4f85-fa3c-385a-9649-775465226106",
                        "target_lang_word": "déchiqueter",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "déchiqueter",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dc4beb50-7984-3713-861b-57697a311cad",
                                        "entry_id": "7932521a-affd-3e1a-a6c3-c402b6e1b3ef",
                                        "glosses": [
                                            "Tailler menu, découper en faisant diverses taillades."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0294e0de-6242-412c-98a4-c8d0ff7846c0",
                                                "sense_id": "dc4beb50-7984-3713-861b-57697a311cad",
                                                "text": "Son pied gauche, dont l'orteil rongeait la chaussette dix fois raccommodée, déchiquetant les mailles et creusant sa trouée, le faisait souffrir cruellement."
                                            },
                                            {
                                                "example_id": "56ebbc0b-761e-4da1-b0ca-91601201ee46",
                                                "sense_id": "dc4beb50-7984-3713-861b-57697a311cad",
                                                "text": "Déchiqueter la peau. - Déchiqueter la chair."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e32e56bd-11ee-3aa3-bde0-7d8f7826a485",
                                        "entry_id": "7932521a-affd-3e1a-a6c3-c402b6e1b3ef",
                                        "glosses": [
                                            "Découper avec maladresse."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e6d1e0c9-f771-4e7d-9fa2-892dc02e8557",
                                                "sense_id": "e32e56bd-11ee-3aa3-bde0-7d8f7826a485",
                                                "text": "Il ne découpe pas le poulet, il le déchiquette."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e650a221-de25-35a0-995d-6407f9964d97",
                                        "entry_id": "7932521a-affd-3e1a-a6c3-c402b6e1b3ef",
                                        "glosses": [
                                            "Critiquer très durement."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa4bf661-a53e-4878-a749-1bbd9788787b",
                                                "sense_id": "e650a221-de25-35a0-995d-6407f9964d97",
                                                "text": "Nous affections de parler de lui, certes. Mais notre admiration pour lui se mêlait d’un certain dégoût. Nous le déchiquetions en détail pour le plaisir de nous rencontrer sur une proie commune."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "016fc5cc-d115-455c-ac84-6309229f4748",
                        "source_entry_id": "3dfa4f85-fa3c-385a-9649-775465226106",
                        "target_lang_word": "lacérer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lacérer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dbdbc7c8-31be-3ba5-8179-f1a8155afc4c",
                                        "entry_id": "d55baeaf-dfcf-35bf-8f24-340426c5a776",
                                        "glosses": [
                                            "Déchirer un écrit, un livre."
                                        ],
                                        "tags": [
                                            "Ancienne Jurisprudence"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "44fdb27f-b9e1-4261-86de-b2424fd2a805",
                                                "sense_id": "dbdbc7c8-31be-3ba5-8179-f1a8155afc4c",
                                                "text": "Ce livre fut lacéré et brûlé par arrêt du Parlement."
                                            },
                                            {
                                                "example_id": "63d93889-5e5c-4d43-bfe8-474824f18560",
                                                "sense_id": "dbdbc7c8-31be-3ba5-8179-f1a8155afc4c",
                                                "text": "14 octobre 1940 – Des affiches ont fleuri dans le métro qu’on lacère en passant avec un petit frisson patriotique : « Déclarons la guerre à l’Angleterre. » Non, mais ! Pour qui nous prend-on ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f5acee6-88fa-3c4d-9f67-0405edf27ce3",
                                        "entry_id": "d55baeaf-dfcf-35bf-8f24-340426c5a776",
                                        "glosses": [
                                            "Mettre en lambeaux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5820ce0-c10a-4cd3-b53d-7803fb9a0dea",
                                                "sense_id": "0f5acee6-88fa-3c4d-9f67-0405edf27ce3",
                                                "text": "Il sortit de la bagarre les vêtements lacérés."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "014066ea-d409-401b-b962-8d8d834b61ff",
                        "source_entry_id": "3dfa4f85-fa3c-385a-9649-775465226106",
                        "target_lang_word": "charcuter",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "charcuter",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ee7f8a4f-82de-3490-9fae-6caff4237910",
                                        "entry_id": "633b4876-8313-3857-aeab-29eef658bcd0",
                                        "glosses": [
                                            "Préparer pour en faire de la charcuterie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19af9791-80ea-4261-9efa-bd0f08ee0e57",
                                                "sense_id": "ee7f8a4f-82de-3490-9fae-6caff4237910",
                                                "text": "Toute cette viande à saler, à charcuter, ces pâtés et ces grotillons à cuire et mettre en pots, lui avaient soulevé l’estomac."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a72cb16a-a789-3b2b-b963-94fb2dff8dc7",
                                        "entry_id": "633b4876-8313-3857-aeab-29eef658bcd0",
                                        "glosses": [
                                            "Découper maladroitement de la viande."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34be8248-ed33-4b5e-871e-9bfef62a1459",
                                                "sense_id": "a72cb16a-a789-3b2b-b963-94fb2dff8dc7",
                                                "text": "Weiss a tué Roger Deutsch, il ne s’est pas contenté de charcuter son cadavre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d4a35139-67f4-3225-9ef1-ac84f29d06f4",
                                        "entry_id": "633b4876-8313-3857-aeab-29eef658bcd0",
                                        "glosses": [
                                            "Taillader maladroitement les chairs."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c736856-494b-4f3d-8b48-185a9294548b",
                                                "sense_id": "d4a35139-67f4-3225-9ef1-ac84f29d06f4",
                                                "text": "Elle dit qu’elle vient de chez son dentiste qui l’a charcutée."
                                            },
                                            {
                                                "example_id": "23f81837-a9c7-46ea-a53e-de759382b893",
                                                "sense_id": "d4a35139-67f4-3225-9ef1-ac84f29d06f4",
                                                "text": "La lance, qui l’avait perforé, se retirait en le charcutant encore, mais enfin sortait."
                                            },
                                            {
                                                "example_id": "8c0a34d4-f9af-4297-96a1-96ce3714c7f9",
                                                "sense_id": "d4a35139-67f4-3225-9ef1-ac84f29d06f4",
                                                "text": "Lapute continuait à répéter qu’elle allait me tuer et menaçait de revenir me charcuter les intérieurs à coups de lame."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "963ba753-7aff-3d1d-821a-3d968fb60ecc",
                                        "entry_id": "633b4876-8313-3857-aeab-29eef658bcd0",
                                        "glosses": [
                                            "Couper en morceaux, diviser de façon grossière et inappropriée."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "468a05f7-2432-4a0e-b0fb-e7383d82fce9",
                                                "sense_id": "963ba753-7aff-3d1d-821a-3d968fb60ecc",
                                                "text": "… une misérable chambre dans le quartier étudiant, où on avait charcuté de belles et hautes maisons pour faire un maximum de petites chambres."
                                            },
                                            {
                                                "example_id": "b27c706a-a3c9-4ec5-89fc-39ad48e5d778",
                                                "sense_id": "963ba753-7aff-3d1d-821a-3d968fb60ecc",
                                                "text": "La CAQ trouve cela trop cher et a demandé de charcuter le projet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "471ef41a-8a7f-3d18-ac7b-1c575b9fb993",
                                        "entry_id": "633b4876-8313-3857-aeab-29eef658bcd0",
                                        "glosses": [
                                            "Détruire sans méthode, dénaturer a avec quasi-acharnement."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0af614df-56b1-463f-ad94-4c1f2dc91aeb",
                                                "sense_id": "471ef41a-8a7f-3d18-ac7b-1c575b9fb993",
                                                "text": "Ce que nous savons, toutefois, c’est que la réputation d’une femme a été charcutée sur la place publique sans que nous ne sachions rien sérieusement des motifs et des raisons ayant justifié cette campagne de salissage."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
