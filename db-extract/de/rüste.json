                                "sense_id": "df2918d2-4088-36bb-9f1d-ec87da703044",
                                "text": "Die Sonne geht zur Rüste.",
                                "translation": "The sun is setting.",
                                "english": "The sun is setting."
                            },
                            {
                                "example_id": "0ef25fa4-d5af-4423-8c78-3bead3952f74",
                                "sense_id": "df2918d2-4088-36bb-9f1d-ec87da703044",
                                "text": "Sein Leben ging zur Rüste.",
                                "translation": "His life was ending.",
                                "english": "His life was ending."
                            },
                            {
                                "example_id": "7bd552b6-d355-4081-8757-697437737224",
                                "sense_id": "df2918d2-4088-36bb-9f1d-ec87da703044",
                                "text": "die Rüste des Tages",
                                "translation": "the end of the day / the evening or nightfall",
                                "english": "the end of the day / the evening or nightfall"
                            }
                        ]
