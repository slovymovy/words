                "senses": [
                    {
                        "sense_id": "a41fe29e-9caa-3e40-b76e-14f957a81460",
                        "entry_id": "8d9d8ce7-41a0-368e-8992-301c811599b2",
                        "glosses": [
                            "een in het water om het lijf gedragen vest met hoog drijfvermogen om verdrinken te voorkomen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e605d07d-3064-46d5-8ab7-4c6386ba4b5d",
                                "sense_id": "a41fe29e-9caa-3e40-b76e-14f957a81460",
                                "text": "Het is aan boord van een zeilboot verplicht een zwemvest te dragen."
                            },
                            {
                                "example_id": "370b9dc7-54b0-4e11-a81e-f45c51392dcb",
                                "sense_id": "a41fe29e-9caa-3e40-b76e-14f957a81460",
                                "text": "Men had ons toen verteld dat we warme kleding moesten aantrekken, en ook onze zwemvesten die in een kastje in de hut lagen, en ons naar het verzamelpunt begeven dat ons was aangewezen."
                            },
                            {
                                "example_id": "6b8d404d-033e-4e26-b0e6-eb0a4dd5ce74",
                                "sense_id": "a41fe29e-9caa-3e40-b76e-14f957a81460",
                                "text": "We hadden allemaal een fluitje aan ons zwemvest en als hij een zeil of iets ongewoons aan de horizon zou ontdekken, kon hij ons onmiddellijk waarschuwen."
                            }
                        ]
                    }
                ],
