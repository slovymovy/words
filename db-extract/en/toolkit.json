            {
                "entry_id": "3951a089-048f-3739-9c88-e3f847285982",
                "word": "toolkit",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "ab954cf1-3857-4fdf-a35c-347955854182",
                        "entry_id": "3951a089-048f-3739-9c88-e3f847285982",
                        "tags": [
                            "plural"
                        ],
