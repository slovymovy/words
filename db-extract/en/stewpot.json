                                                "sense_id": "07cd08cd-103f-3693-8db3-4439deff52b6",
                                                "text": "Frau Hafen ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "ffbf42b4-4b53-4ee5-ab62-e3c8af2653f1",
                                                "sense_id": "07cd08cd-103f-3693-8db3-4439deff52b6",
                                                "text": "Herr Hafen wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "9ec8bf10-afe6-45a1-b0e0-9ce5a4ba978e",
                                                "sense_id": "07cd08cd-103f-3693-8db3-4439deff52b6",
                                                "text": "Die Hafens fliegen heute nach La Paz."
                                            },
                                            {
                                                "example_id": "24e0fb1e-d6d8-4ef1-82d3-50ed02f2f8da",
                                                "sense_id": "07cd08cd-103f-3693-8db3-4439deff52b6",
                                                "text": "Der Hafen trägt nie die Schals, die die Hafen ihm strickt."
                                            },
                                            {
                                                "example_id": "4729e517-1ed9-4a21-8bed-defcc1250d2e",
                                                "sense_id": "07cd08cd-103f-3693-8db3-4439deff52b6",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Hafen kommt, geht der Herr Hafen.“"
                                            },
                                            {
                                                "example_id": "2475d159-6ef4-4704-93d7-9f0725c4ec9c",
                                                "sense_id": "07cd08cd-103f-3693-8db3-4439deff52b6",
                                                "text": "Hafen kommt und geht."
                                            },
                                            {
                                                "example_id": "5927653e-b815-4379-900b-26e04c1127e2",
                                                "sense_id": "07cd08cd-103f-3693-8db3-4439deff52b6",
                                                "text": "Hafens kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
