                                            {
                                                "example_id": "61fcc1b9-a974-414d-85ea-accd8a925732",
                                                "sense_id": "84ffe0ab-b8da-3c33-b4cc-06f7917cca96",
                                                "text": "Offizielle kenianische Amtssprachen sind Swahili und Englisch."
                                            },
                                            {
                                                "example_id": "78f12aa5-9068-49d3-bc2e-1210d771cf8a",
                                                "sense_id": "84ffe0ab-b8da-3c33-b4cc-06f7917cca96",
                                                "text": "Es wird immer noch vor und nach jedem Rugbyspiel, dieser englischsten der kenianischen und kenianischsten der englischen Sportarten, gesungen und getanzt - und der Text immer neu improvisiert."
                                            },
                                            {
                                                "example_id": "08c24b0c-c2b8-4709-93a2-c269ee442704",
                                                "sense_id": "84ffe0ab-b8da-3c33-b4cc-06f7917cca96",
                                                "text": "„Die meisten kenianischen Aktivisten setzen auf friedliche Petitionen und Verhandlungen mit der Kolonialregierung.“"
                                            }
