                    "frequency": "Middle",
                    "semantic_group_id": "economics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company decided to increase production because the <w>marginal</w> cost was low.",
                            "target_lang_translations": {
                                "ru": "Компания решила увеличить производство, так как <w>предельные</w> издержки были низкими.",
                                "zh": "公司决定扩大生产，因为<w>边际</w>成本很低。"
                            }
                        },
                        {
                            "text": "Economists study <w>marginal</w> utility to understand consumer behavior.",
