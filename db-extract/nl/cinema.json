                "senses": [
                    {
                        "sense_id": "f3cd5c8c-a11a-3d86-80c2-83dc07f6ca1b",
                        "entry_id": "83c6b950-d88a-30ca-80b6-616db6ce6e78",
                        "glosses": [
                            "bioscoop, gebouw waarin mensen in stoelen naar een film geprojecteerd op een groot scherm kunnen kijken."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56d5dd0b-ca60-455f-b483-ecdaa5bce0bf",
                                "sense_id": "f3cd5c8c-a11a-3d86-80c2-83dc07f6ca1b",
                                "text": "Het lang verwaarloosde Collège Néerlandais is een van slechts twee gebouwen die Dudok buiten Nederland neerzette. Het ander is de niet meer bestaande Light House Cinema in Calcutta."
                            }
                        ]
                    },
                    {
                        "sense_id": "510d2a9a-5272-3792-9d16-e0da6d257a7a",
                        "entry_id": "83c6b950-d88a-30ca-80b6-616db6ce6e78",
                        "glosses": [
                            "film, filmkunst, in hoog tempo na elkaar geprojecteerde afbeeldingen die de suggestie van beweging reproduceren of creëren."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e41ab5e0-a37b-41b9-b7bd-6f856a04ba21",
                                "sense_id": "510d2a9a-5272-3792-9d16-e0da6d257a7a",
                                "text": "Het bezit van enige voorkennis is bijna onontbeerlijk. Zo helpt het bijvoorbeeld om te weten dat die zelfingenomen oudere man op toneel, Manfred Zapatka, een icoon is in de Duitse cinema en theaterwereld, en in zijn lange carrière vele Duitse oorlogshelden en -misdadigers heeft gespeeld."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e434d102-b6eb-464d-a019-9a1a57e0222f",
                        "source_entry_id": "83c6b950-d88a-30ca-80b6-616db6ce6e78",
                        "source_sense_id": "f3cd5c8c-a11a-3d86-80c2-83dc07f6ca1b",
                        "target_lang_word": "Kino",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kino",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "29362556-8a34-3e99-aa48-ff057e9a97c9",
                                        "entry_id": "f2d23c7c-ff3f-3534-8bcb-8f4d9f9143e3",
                                        "glosses": [
                                            "Gebäude oder Raum, in dem Filme auf einer Leinwand vorgeführt werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12e6ae5f-ca63-4c18-9c57-6f5d48445dc9",
                                                "sense_id": "29362556-8a34-3e99-aa48-ff057e9a97c9",
                                                "text": "In unserem Kino läuft ein spannender Film."
                                            },
                                            {
                                                "example_id": "df11675f-c6ea-4eef-98b4-8598a9cdceb9",
                                                "sense_id": "29362556-8a34-3e99-aa48-ff057e9a97c9",
                                                "text": "„Ich habe mir eine Kassette auf häuslicher Mattscheibe angeschaut; in Kinos läuft der Schwarzweißfilm schon lange nicht mehr.“"
                                            },
                                            {
                                                "example_id": "4c44bad7-8a20-48ff-96d8-4a06fcfc5a9f",
                                                "sense_id": "29362556-8a34-3e99-aa48-ff057e9a97c9",
                                                "text": "„Wenn du dann abends das Kino oder das Theater in der Königgrätzer Straße verläßt, wo Čapeks »Aus dem Leben der Insekten« immer noch als die einzige Sensation gespielt wird, strecken sich dir halbe Arme und halbe Beine wie Querhölzer eines Tourniquets entgegen…“"
                                            },
                                            {
                                                "example_id": "bebdb358-b707-4508-a463-52afcd47eac6",
                                                "sense_id": "29362556-8a34-3e99-aa48-ff057e9a97c9",
                                                "text": "„Als wir das Kino verließen, war es schon dunkel.“"
                                            },
                                            {
                                                "example_id": "7b081a5e-ae1e-4ee8-8eef-a35ab83f57e9",
                                                "sense_id": "29362556-8a34-3e99-aa48-ff057e9a97c9",
                                                "text": "„Wir sind ins Kino gegangen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "699b561a-d7c6-3bac-b632-b06c30925458",
                                        "entry_id": "f2d23c7c-ff3f-3534-8bcb-8f4d9f9143e3",
                                        "glosses": [
                                            "Filmvorführung auf einer Leinwand"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4c4e81c-a2b4-4251-b948-0c92cc72fc77",
                                                "sense_id": "699b561a-d7c6-3bac-b632-b06c30925458",
                                                "text": "Um 18 Uhr ist das Kino aus; dann können wir noch gemütlich essen gehen."
                                            },
                                            {
                                                "example_id": "30c0dd61-7fb2-4e50-aa9b-9bee14af03c3",
                                                "sense_id": "699b561a-d7c6-3bac-b632-b06c30925458",
                                                "text": "„Sie besuchte zum erstem Mal ein Kino, ein Museum, ging ins Theater und in die Oper.“"
                                            },
                                            {
                                                "example_id": "71ef35f5-3a1a-48e7-93fb-5a8c11eafef8",
                                                "sense_id": "699b561a-d7c6-3bac-b632-b06c30925458",
                                                "text": "„Rita und Gabi waren im Kino.“"
                                            },
                                            {
                                                "example_id": "4a60d292-5429-4287-875d-267783ab887b",
                                                "sense_id": "699b561a-d7c6-3bac-b632-b06c30925458",
                                                "text": "„Die Selbstverständlichkeit, mit der er sich als Anti-Nazi geriert, hat etwas Unerlöstes, Unrechtmäßiges, als ob er ohne Eintrittskarte im Kino säße und eine Kontrolle fürchte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "1f19a786-3e37-31b1-b612-11b7d7b15416",
                                        "entry_id": "f2d23c7c-ff3f-3534-8bcb-8f4d9f9143e3",
                                        "glosses": [
                                            "Gattungsbezeichnung, statt \\\"der Film\\"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29916c6c-a9a1-4760-a8d6-a73bb1cdf6d0",
                                                "sense_id": "1f19a786-3e37-31b1-b612-11b7d7b15416",
                                                "text": "In der Nazizeit wurde das Kino für propagandistische Zwecke eingesetzt."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2e294e78-429c-4012-a221-85b29777f139",
                        "source_entry_id": "83c6b950-d88a-30ca-80b6-616db6ce6e78",
                        "source_sense_id": "f3cd5c8c-a11a-3d86-80c2-83dc07f6ca1b",
