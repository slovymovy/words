                "senses": [
                    {
                        "sense_id": "a410735c-620d-349d-9114-6d0dbbc089c2",
                        "entry_id": "4e9e334e-04f1-3995-a0a1-53acf8db2cc5",
                        "glosses": [
                            "Flânerie, déambulation dans une zone habitée."
                        ],
                        "tags": [
                            "Québec"
                        ],
                        "examples": [
                            {
                                "example_id": "6148f136-1af1-4c06-8ebc-88e39c834c0e",
                                "sense_id": "a410735c-620d-349d-9114-6d0dbbc089c2",
                                "text": "Selon l’époque, la place du marché est aussi une place publique, un lieu de rendez-vous, de flânage, d’activités culturelles, de fêtes, de cérémonies religieuses, d’assemblées politiques, voire de châtiments..."
                            },
                            {
                                "example_id": "a068341f-84f8-4bf8-8d21-61809a8a21cf",
                                "sense_id": "a410735c-620d-349d-9114-6d0dbbc089c2",
                                "text": "Elle [cette rue] se prête à merveille au flânage et au lèche-vitrine lors des beaux jours ensoleillés."
                            }
                        ]
                    },
                    {
                        "sense_id": "e9a556f9-921c-3d63-a294-70206b552c46",
                        "entry_id": "4e9e334e-04f1-3995-a0a1-53acf8db2cc5",
                        "glosses": [
                            "Fait de traîner sans but précis dans un lieu public d’une manière ressentie comme gênante, voire suspecte."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "0c2c0593-56b7-4cec-b2ca-155257d3ade6",
                                "sense_id": "e9a556f9-921c-3d63-a294-70206b552c46",
                                "text": "Les itinérants sont souvent accusés de violation des règlements municipaux, par le flânage, le bruit et la mendicité."
                            },
                            {
                                "example_id": "ac2b927b-ab48-4ae9-9449-1d5ab71f1afb",
                                "sense_id": "e9a556f9-921c-3d63-a294-70206b552c46",
                                "text": "J’ai toujours été étonné de voir ces panneaux que l’on peut retrouver un peu partout dans nos villes occidentales et qui interdisent — oh ! grand crime s'il en est un ! — le flânage. Oui, vous avez bien lu, le flânage, fléau de notre monde contemporain…"
                            },
                            {
                                "example_id": "d423b8df-6d5b-43d6-a8df-c4f5ec3b7358",
                                "sense_id": "e9a556f9-921c-3d63-a294-70206b552c46",
                                "text": "Nous partageons un but unique : créer un environnement sécuritaire pour vos clients et votre personnel et réduire le vol, le flânage et le vandalisme."
                            }
                        ]
                    }
                ],
