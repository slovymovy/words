                "senses": [
                    {
                        "sense_id": "a4108893-ab19-3e7e-a25c-f6d22e179c4e",
                        "entry_id": "9181b077-01a3-3b2d-b87c-9b5c86049d82",
                        "glosses": [
                            "ein Ausdruck, der dazu eingesetzt wird, jemanden oder etwas herabzusetzen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0527efc-52ce-4e6b-bfe3-20d6d08304d9",
                                "sense_id": "a4108893-ab19-3e7e-a25c-f6d22e179c4e",
                                "text": "„Mit diesen Schmähreden befasst sich auch die Aischrologie (griechisch, ›Aussprechen von Schändlichem‹), die im engeren Sinn Schmähreden im kultischen Kontext der Antike bezeichnet: Beispiel sind obszöne Reden, die Frauen bei Festen zu Ehren der Götter führten, oder Auftritte von Slaven, die ihre Herren schmähten.“"
                            },
                            {
                                "example_id": "1d25dde6-93e8-4ae6-867a-2ec1b77dfbb9",
                                "sense_id": "a4108893-ab19-3e7e-a25c-f6d22e179c4e",
                                "text": "„Die Aischrologie gehört zur Gruppe der Periphrasen (Umschreibung eines Begriffes durch eine seiner Eigenschaften).“"
                            },
                            {
                                "example_id": "f6160c85-1c73-4795-b7dd-c3304c067b9b",
                                "sense_id": "a4108893-ab19-3e7e-a25c-f6d22e179c4e",
                                "text": "„Während manche Belege von einer Aischrologie zwischen einzelnen Gruppen der Frauenversammlung ausgehen, wird auch die Verhöhnung des anderen Geschlechts, das für diese Komödie so wichtig ist, durchaus vorgekommen sein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
