{
    "word_family": [
        "sloerig"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7d6fa4a3-7795-3e5e-8779-de252c23d2f4",
                    "sense_definition": "Een beledigende term voor een vrouw die als promiscue of zedeloos wordt beschouwd.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "belediging_vrouw",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij schold haar uit voor een <w>sloerie</w> toen ze met een andere man praatte.",
                            "target_lang_translations": {
                                "en": "He called her a <w>slut</w> when she talked to another man."
                            }
                        },
                        {
                            "text": "Zulke grove beledigingen zoals <w>sloerie</w> horen niet thuis in een fatsoenlijk gesprek.",
                            "target_lang_translations": {
                                "en": "Such coarse insults like <w>slut</w> have no place in a decent conversation."
                            }
                        }
                    ],
                    "synonyms": [
                        "slet",
                        "del",
                        "snol"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "beledigend en informeel"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "An offensive term for a woman who is considered promiscuous or immoral."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "slut",
                                "target_lang_sense_clarification": "offensive term for a promiscuous woman"
                            },
                            {
                                "target_lang_word": "trollop",
                                "target_lang_sense_clarification": "derogatory term for a promiscuous woman"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e6af3c1f-7d29-3b9b-b4e1-a087b066a40b",
                    "sense_definition": "Een slonzige, onverzorgde of ordinaire vrouw.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "belediging_vrouw",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ze liep erbij als een <w>sloerie</w> in haar oude, versleten kleren.",
                            "target_lang_translations": {
                                "en": "She walked around looking like a <w>slattern</w> in her old, worn-out clothes."
                            }
                        },
                        {
                            "text": "Niemand nam haar serieus omdat ze zich gedroeg als een ordinaire <w>sloerie</w>.",
                            "target_lang_translations": {
                                "en": "Nobody took her seriously because she behaved like a vulgar <w>trollop</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "slons",
                        "flodder"
                    ],
                    "common_phrases": [
                        "ordinaire sloerie"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informeel en minachtend"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A slovenly, untidy, or vulgar woman."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "slattern",
                                "target_lang_sense_clarification": "an untidy, slovenly woman"
                            },
                            {
                                "target_lang_word": "slut",
                                "target_lang_sense_clarification": "archaic sense of a slovenly, untidy woman"
                            },
                            {
                                "target_lang_word": "trollop",
                                "target_lang_sense_clarification": "a slovenly or untidy woman"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}