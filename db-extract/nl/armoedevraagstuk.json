                        "glosses": [
                            "alle problemen die spelen rond het hebben van onvoldoende middelen voor het levensonderhoud"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3ad9c8c-f3fd-47b1-8705-639c7f2b9dcd",
                                "sense_id": "6922b1ae-96d3-3d09-a235-4d5754b90d35",
                                "text": "Van der Hout: „Dat kwijtscheldingsbeleid van de gemeente is er toch niet zonder reden? Er bestaat een armoedevraagstuk, er is een groep die in toenemende mate om extra aandacht vraagt. Wat is de redenering daar nu anders mee om te gaan?”"
                            },
                            {
                                "example_id": "0271bcff-82ce-4a2a-bbda-b0cd800bc9aa",
                                "sense_id": "6922b1ae-96d3-3d09-a235-4d5754b90d35",
                                "text": "We kunnen dit probleem als gemeente niet alleen oplossen. Dit vraagt meer dan eens om een brede, gezamenlijke aanpak door alle partijen die in Enschede bij het armoedevraagstuk zijn betrokken.”"
                            }
                        ]
                    }
