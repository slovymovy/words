                "senses": [
                    {
                        "sense_id": "5d4ea0a3-a272-3623-af9b-8914b71883ca",
                        "entry_id": "4d64daba-c110-3006-8ab8-cdbea31a7c06",
                        "glosses": [
                            "overgang (van een stof) van de ene fase in een andere"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "64b96e2b-c543-4182-b95d-48efa243be69",
                                "sense_id": "5d4ea0a3-a272-3623-af9b-8914b71883ca",
                                "text": "De overgang van de fase 'gas' naar de fase 'vloeibaar' heet condenseren; de overgang van de fase 'vloeibaar' naar 'gas' heet verdampen."
                            },
                            {
                                "example_id": "0a11bd85-1f8b-4520-842c-0049b0137f4e",
                                "sense_id": "5d4ea0a3-a272-3623-af9b-8914b71883ca",
                                "text": "De overgang van de fase 'vloeibaar' naar de fase 'vast' heet stollen; de overgang van de fase 'vast' naar 'vloeibaar' heet smelten."
                            },
                            {
                                "example_id": "5c2f0d5f-568a-4f0c-92a0-d81d0417a233",
                                "sense_id": "5d4ea0a3-a272-3623-af9b-8914b71883ca",
                                "text": "De overgang van de fase 'vast' naar de fase 'gast' heet sublimeren; de overgang van de fase 'gas' naar 'vast' heet rijpen."
                            }
                        ]
                    }
                ],
