                ],
                "senses": [
                    {
                        "sense_id": "53862c52-40b7-3c3c-b071-0b5187c5447b",
                        "entry_id": "60060b7f-d9bb-35fc-8989-04544e4bf618",
                        "glosses": [
                            "Sicherung/Wahrung der Macht einer Person oder Organisation"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18974455-ff3b-4048-8dea-8c41a403cb28",
                                "sense_id": "53862c52-40b7-3c3c-b071-0b5187c5447b",
                                "text": "„Als rechtbeugender Paria verachtet, der sich zum Machterhalt die Verfassung umschreibt, hätte er sich seinen Spielraum auf der Weltbühne unnötig selber eingeschränkt.“"
                            },
                            {
                                "example_id": "a4016509-02e4-460d-b913-326bb81064cb",
                                "sense_id": "53862c52-40b7-3c3c-b071-0b5187c5447b",
                                "text": "„‚Es geht nur um den Machterhalt und um den Kopf des Landeshauptmannes‘, so Oppitz-Plörer – wiewohl Letzterer einen Stillstand im Land zu verantworten habe.“"
                            },
                            {
                                "example_id": "34a4075c-5e21-4716-b6bf-b5537ce20415",
                                "sense_id": "53862c52-40b7-3c3c-b071-0b5187c5447b",
                                "text": "„Doch der Mann, der Äthiopien gegen alle konservativen Widerstände in die Moderne geführt hat, verfolgt in den letzten Jahrzehnten seiner Herrschaft nur noch ein Ziel: den eigenen Machterhalt.“"
                            },
                            {
                                "example_id": "e8913a51-49da-43b0-a02d-bdced97cc97b",
                                "sense_id": "53862c52-40b7-3c3c-b071-0b5187c5447b",
                                "text": "„Die städtische Oberschicht organisierte den Machterhalt, indem sie die Organisationen der mittleren Schichten unterdrückte.“"
                            },
                            {
                                "example_id": "2e09fe9e-4fe2-401b-8297-7620346d5cba",
                                "sense_id": "53862c52-40b7-3c3c-b071-0b5187c5447b",
                                "text": "„Der Machterhalt um seiner selbst willen wurde immer wichtiger.“"
                            },
                            {
                                "example_id": "78af4e63-09c6-47b2-96d4-91f75956e426",
                                "sense_id": "53862c52-40b7-3c3c-b071-0b5187c5447b",
                                "text": "„Rehberg weiß aber auch, wie entschlossen sie ist, um den Machterhalt zu kämpfen, nachdem die Entscheidung einmal gefallen ist.“"
                            },
                            {
                                "example_id": "51024775-7218-4a55-a30d-e297d859d7df",
                                "sense_id": "53862c52-40b7-3c3c-b071-0b5187c5447b",
                                "text": "„In der Forschung wie in den Medien wurde viel gemutmaßt, wie der «Befreier» Mugabe sich zu einem korrupten Präsidenten entwickeln konnte. Dies ist nur dann ein Rätsel, wenn man davon ausgeht, dass er jemals andere Prioritäten als seinen Machterhalt hatte.“"
                            },
                            {
                                "example_id": "e9a2dcc4-0eff-4104-9134-01b2a7f30ea4",
                                "sense_id": "53862c52-40b7-3c3c-b071-0b5187c5447b",
                                "text": "„‚Diese Burg diente den damaligen Grafen von Montclair in erster Linie zum Machterhalt – und eher nicht als Wohnsitz‘, berichtet die Führerin und kann diese Einschätzung gut begründen.“"
                            },
                            {
                                "example_id": "f322e45f-249f-4c2c-869f-d03c7badbd62",
                                "sense_id": "53862c52-40b7-3c3c-b071-0b5187c5447b",
                                "text": "„Wenn nun aber auch Teile der CDU sich Selbstbeschränkung auferlegen (‚asymmetrische Demobilisierung‘), dann mag dies vielleicht dem Machterhalt von Ministerpräsident Wüst in NRW mit den Grünen als Koalitionspartner dienlich sein, bundes- und gesellschaftspolitisch gesehen ist es eine Bankrotterklärung.“"
                            },
                            {
                                "example_id": "ae2d0ccd-20d9-41e8-8333-b10f9271a859",
                                "sense_id": "53862c52-40b7-3c3c-b071-0b5187c5447b",
                                "text": "„Und das wiederum lässt darauf schließen, dass bei diesen Herr- bzw. Frauschaften das eigene Ego und der eigene Machterhalt vor das Parteiwohl gesetzt wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
