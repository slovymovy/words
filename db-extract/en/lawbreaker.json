    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "dffe938c-661f-3f79-8c90-12515e6f2c6b",
                "word": "lawbreaker",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "a14442d6-f9ac-4b51-9e14-1dcd80329079",
                        "entry_id": "dffe938c-661f-3f79-8c90-12515e6f2c6b",
                        "tags": [
                            "plural"
                        ],
                        "form": "lawbreakers"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b7d0359f-384e-3deb-bcb9-5ea5b3724919",
                        "entry_id": "dffe938c-661f-3f79-8c90-12515e6f2c6b",
                        "glosses": [
                            "One who breaks (violates) the law, a criminal."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf2914d0-6918-478c-88b5-1bc7922238a4",
                                "sense_id": "b7d0359f-384e-3deb-bcb9-5ea5b3724919",
                                "text": "I'm just a poor old man. I have no time for law-breakers. My legs are grey. My ears are gnarled. My eyes are old and bent."
                            },
                            {
                                "example_id": "1f11c07b-6e31-430a-b25c-7a693a91f898",
                                "sense_id": "b7d0359f-384e-3deb-bcb9-5ea5b3724919",
                                "text": "People often assume that speedboarders are disrespectful lawbreakers."
                            },
                            {
                                "example_id": "9ba00557-a4d9-4437-ab0c-ded6343b9a93",
                                "sense_id": "b7d0359f-384e-3deb-bcb9-5ea5b3724919",
                                "text": "Mr. Grimm pleaded guilty to a single count of tax fraud and was convicted in July 2015; he went on to serve eight months in prison. Lawmaker, law enforcer and lawbreaker — that’s a heck of a résumé, and alliterative, too!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "86f6741e-4e07-4620-ae24-03d92b0e0f42",
                        "source_entry_id": "dffe938c-661f-3f79-8c90-12515e6f2c6b",
                        "source_sense_id": "b7d0359f-384e-3deb-bcb9-5ea5b3724919",
                        "source_sense_description": "person who breaks the law",
                        "target_lang_word": "hors-la-loi",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hors-la-loi",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b4f685ae-0571-3a51-9866-429081f1375c",
                                        "entry_id": "b41f8657-a716-340b-9a3d-051743f1ac52",
                                        "glosses": [
                                            "Personnage qui fait ce que la loi interdit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3b601e8-1b44-4744-8a79-3991dd4996b5",
                                                "sense_id": "b4f685ae-0571-3a51-9866-429081f1375c",
                                                "text": "Entre les territoires des tribus s'étendaient souvent de vastes landes de bled khalia où l’on ne hasardait même pas les troupeaux, sorte de no man’s land que l’on abandonnait aux hors-la-loi et aux bêtes de la brousse."
                                            },
                                            {
                                                "example_id": "e89abaca-0234-4938-a9eb-91f89129f765",
                                                "sense_id": "b4f685ae-0571-3a51-9866-429081f1375c",
                                                "text": "Mais le maître des Hautes Héez dédaigne toute convenance. Qu’il garde sa barbe toute entière, mais qu’il la cultive. Elle lui donne l’air d’un Robinson, d’un homme des cavernes, voire d’un hors-la-loi."
                                            },
                                            {
                                                "example_id": "1d0d5c76-43fc-495c-b92a-55111211ab2d",
                                                "sense_id": "b4f685ae-0571-3a51-9866-429081f1375c",
                                                "text": "– À la tête d’une trentaine de braves, durant des lunes, il a mené la vie dure aux convois de ravitaillement de l’armée et aux fermiers du coin. Sa tête a été mise à prix dix fois. Et dans son cas, ils ne se contenteront pas d’un simple scalp, comme ils le font pour n’importe quel autre Indien. Les vôtres le traitent de renégat, d’assassin, de hors-la-loi, mais pourtant il ne fait que se défendre, et défendre les siens. Résister !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "74a924cf-2fcf-3df3-9521-66b459ac9b0b",
                                        "entry_id": "b41f8657-a716-340b-9a3d-051743f1ac52",
                                        "glosses": [
                                            "Ce qui existe en dehors des lois."
                                        ],
                                        "tags": [
                                            "singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d13a4c08-7c17-4f8a-94d2-17cbb94e052b",
                                                "sense_id": "74a924cf-2fcf-3df3-9521-66b459ac9b0b",
                                                "text": "La Corse est un lieu baroque au sens de sa recherche de l’irrégulier, du hors-norme, qui peut aller parfois jusqu’au hors-la-loi. Rien ne s’y fait comme ailleurs […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hors-la-loi",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1e1bfd56-d507-3a98-ab94-1fc9531aa4b7",
                                        "entry_id": "9cff37a7-de56-3b12-a59d-8ec1c1c2c767",
                                        "glosses": [
                                            "Interdit par la loi."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3411c5f-c1d2-471c-a152-5386570d88eb",
                                                "sense_id": "1e1bfd56-d507-3a98-ab94-1fc9531aa4b7",
                                                "text": "À Rouen, les autorités firent savoir que ceux qui n’accepteraient pas le baptême seraient considérés comme hors-la-loi."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0a7a8f27-68a9-456c-b078-0c4223541723",
                        "source_entry_id": "dffe938c-661f-3f79-8c90-12515e6f2c6b",
                        "source_sense_id": "b7d0359f-384e-3deb-bcb9-5ea5b3724919",
                        "source_sense_description": "person who breaks the law",
                        "target_lang_word": "criminel",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "criminel",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0cb5c8f7-0a06-32b0-b22c-646bd290900a",
                                        "entry_id": "2168d4c8-09f9-3aaf-8151-663d205bc56e",
                                        "glosses": [
                                            "Qui est coupable d’un crime, de crimes."
                                        ],
                                        "tags": [
                                            "Illégalité"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d764c1a-a99a-4c2c-a82e-b3d7d982a12d",
                                                "sense_id": "0cb5c8f7-0a06-32b0-b22c-646bd290900a",
                                                "text": "Tous ceux qui sont accusés ne sont pas criminels."
                                            },
                                            {
                                                "example_id": "67f4c230-a134-43c2-b895-a2964b1db5ee",
                                                "sense_id": "0cb5c8f7-0a06-32b0-b22c-646bd290900a",
                                                "text": "Se rendre criminel."
                                            },
                                            {
                                                "example_id": "4f592232-8094-42ca-b680-052a5143ac1e",
                                                "sense_id": "0cb5c8f7-0a06-32b0-b22c-646bd290900a",
                                                "text": "Ô phrénologues ! L’inéducabilité érigée en principe ? quel inhominalisme ! La sublime créature est éducable, voyante et libre, criminelle ou vertueuse à son choix, responsable."
                                            },
                                            {
                                                "example_id": "6c4b32b0-e49d-4041-b181-fbead080dbc5",
                                                "sense_id": "0cb5c8f7-0a06-32b0-b22c-646bd290900a",
                                                "text": "Quelle main criminelle avait accompli cette sinistre besogne ? Et à qui en voulait l'incendiaire ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "577abcad-e40f-3e87-b337-83682368bc42",
                                        "entry_id": "2168d4c8-09f9-3aaf-8151-663d205bc56e",
                                        "glosses": [
                                            "Condamnable, illicite."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de0590a6-ae24-4ac6-880f-5f1408adc203",
                                                "sense_id": "577abcad-e40f-3e87-b337-83682368bc42",
                                                "text": "Dessein criminel."
                                            },
                                            {
                                                "example_id": "2f288efa-dcb2-4113-a9cd-ed4fecc1ca10",
                                                "sense_id": "577abcad-e40f-3e87-b337-83682368bc42",
                                                "text": "Action, pensée, passion criminelle."
                                            },
                                            {
                                                "example_id": "2103801e-1451-4d61-abac-3d932a29adc4",
                                                "sense_id": "577abcad-e40f-3e87-b337-83682368bc42",
                                                "text": "Vie criminelle."
                                            },
                                            {
                                                "example_id": "352b8770-5048-4266-b779-4b49d484ce8d",
                                                "sense_id": "577abcad-e40f-3e87-b337-83682368bc42",
                                                "text": "Désirs criminels."
                                            },
                                            {
                                                "example_id": "e1414764-65c4-48b1-b5cb-a9369e3305c0",
                                                "sense_id": "577abcad-e40f-3e87-b337-83682368bc42",
                                                "text": "Attachement criminel."
                                            },
                                            {
                                                "example_id": "c8017f38-d146-47b5-9aaf-3cef727f2836",
                                                "sense_id": "577abcad-e40f-3e87-b337-83682368bc42",
                                                "text": "Le comportement criminel trouve le plus souvent son origine dans une frustration, un manque d’affection."
                                            },
                                            {
                                                "example_id": "f3d48943-17b6-4128-87f1-d9fc69b114a8",
                                                "sense_id": "577abcad-e40f-3e87-b337-83682368bc42",
                                                "text": "Accusé d’entretenir des relations criminelles avec Lepida, femme de Sulpicius Quirinus, personnage consulaire, et reconnu coupable, il fut exilé par Tibère César."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45d13191-ecd1-3602-9ead-de71e0f1a422",
                                        "entry_id": "2168d4c8-09f9-3aaf-8151-663d205bc56e",
                                        "glosses": [
                                            "Qui appartient à une personne criminelle, ou qui conçoit des pensées criminelles."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b3155a1f-864d-424e-ac33-2efbb9759d84",
                                                "sense_id": "45d13191-ecd1-3602-9ead-de71e0f1a422",
                                                "text": "Une main criminelle."
                                            },
                                            {
                                                "example_id": "bed65fff-deff-4acc-b870-c64d8840d62e",
                                                "sense_id": "45d13191-ecd1-3602-9ead-de71e0f1a422",
                                                "text": "Des regards criminels."
                                            },
                                            {
                                                "example_id": "b0f2426e-e6a5-4ca7-b663-0b1810d3ea5a",
                                                "sense_id": "45d13191-ecd1-3602-9ead-de71e0f1a422",
                                                "text": "Une âme criminelle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e1ce058-1f0a-357a-81ba-c40fe49cf109",
                                        "entry_id": "2168d4c8-09f9-3aaf-8151-663d205bc56e",
                                        "glosses": [
                                            "Qualifie la législation qui concerne les crimes et tout ce qui regarde la procédure qu’on fait contre les personnes accusées de crime."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7741bc49-6198-4469-b73c-eb0e47e5b993",
                                                "sense_id": "7e1ce058-1f0a-357a-81ba-c40fe49cf109",
                                                "text": "Le droit de justice des seigneurs hauts justiciers était absolu. Il emportait la plénitude de la juridiction civile et criminelle, limitée seulement par les cas royaux."
                                            },
                                            {
                                                "example_id": "5fa05800-417c-4d69-a8de-d2d61d5ac4b8",
                                                "sense_id": "7e1ce058-1f0a-357a-81ba-c40fe49cf109",
                                                "text": "Le Droit criminel ne signifie nullement qu'on ait le droit de commettre un crime."
                                            },
                                            {
                                                "example_id": "1712ca51-d10e-4592-8401-87d175afcebb",
                                                "sense_id": "7e1ce058-1f0a-357a-81ba-c40fe49cf109",
                                                "text": "La plupart des Parisiens rencontrés au fil des archives criminelles se déplacent en effet à pied, et crotter ses vêtements n'est pas le pire qui puisse arriver au piéton lors de ses déplacements."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "criminel",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4c1d0c65-bbcf-3102-980d-86b0a840463b",
                                        "entry_id": "61dcd9da-bcc4-3a49-87ef-ef7541464b5f",
                                        "glosses": [
                                            "Personne convaincue de crime."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d332d181-9b74-4ba2-8731-3272692d40a6",
                                                "sense_id": "4c1d0c65-bbcf-3102-980d-86b0a840463b",
                                                "text": "De l’autre côté, quelques-uns parmi nous discutaient s'il fallait ajouter foi aux affirmations du criminel qui s'était montré menteur incorrigible."
                                            },
                                            {
                                                "example_id": "5aa24398-c5d6-4edc-bfa4-d6c06256f4e1",
                                                "sense_id": "4c1d0c65-bbcf-3102-980d-86b0a840463b",
                                                "text": "Du Paty l'a compris et, connaissant par expérience l’implacabilité du criminel aux abois, il se voit abandonné sans recours à toutes les puissances du mal dont il fut le serviteur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4333878f-9e7d-39c8-9ab2-199a9b5c4b35",
                                        "entry_id": "61dcd9da-bcc4-3a49-87ef-ef7541464b5f",
                                        "glosses": [
                                            "(Usage critiqué) référence nécessaire (résoudre le problème) Simple accusé ou prévenu."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "criminel",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9916a14b-e60c-318b-af91-f7c8eea7c748",
                                        "entry_id": "1c73dfd6-b830-3b7e-97e5-cbdb0b85e7dd",
                                        "glosses": [
                                            "Matière ou procédure criminelle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca4624b9-eea4-407a-b6db-3633a97ee70b",
                                                "sense_id": "9916a14b-e60c-318b-af91-f7c8eea7c748",
                                                "text": "Poursuivre quelqu’un au criminel."
                                            },
                                            {
                                                "example_id": "f30b2f62-3952-49d3-9f48-641d3b5a6b0b",
                                                "sense_id": "9916a14b-e60c-318b-af91-f7c8eea7c748",
                                                "text": "Procéder au criminel."
                                            },
                                            {
                                                "example_id": "67787558-5759-4c2c-86b4-629be5f39759",
                                                "sense_id": "9916a14b-e60c-318b-af91-f7c8eea7c748",
                                                "text": "L’affaire ainsi posée arriverait au Tribunal, et monsieur Lesourd verrait alors à porter l’affaire au criminel en provoquant une instruction."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
