                "senses": [
                    {
                        "sense_id": "9d935291-6ea0-350e-b9ac-e5ad86e989d1",
                        "entry_id": "17f39c97-074a-39d9-ba7b-e44b54552efa",
                        "glosses": [
                            "Person, die bereit ist, für eine Sache den höchsten Betrag zu zahlen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3100761-3302-43be-b74a-554427c5fe21",
                                "sense_id": "9d935291-6ea0-350e-b9ac-e5ad86e989d1",
                                "text": "„Autos, die abgeschleppt und nie zurückgefordert wurden: Sie alle werden an den Meistbietenden verramscht.“"
                            },
                            {
                                "example_id": "34a39215-2bdc-4694-b303-ee3a36438336",
                                "sense_id": "9d935291-6ea0-350e-b9ac-e5ad86e989d1",
                                "text": "„Black hieß in Wirklichkeit David Mars, und hinter Barnacle verbarg sich Mars' geheime Quelle innerhalb der CIA. Ein Mann, der seit Kurzem Informationen über Geheimoperationen mit Codenamen an die Meistbietenden verscherbelte - die Chinesen, die Iraner oder eben David Mars.“"
                            },
                            {
                                "example_id": "26a49a6f-c443-41f7-b34d-e14db64eab7b",
                                "sense_id": "9d935291-6ea0-350e-b9ac-e5ad86e989d1",
                                "text": "„Wenig Wertvolles im Boden, nun, dann musste das Land, wie es eben war, aufgeteilt oder an den Meistbietenden verkauft werden.“"
                            },
                            {
                                "example_id": "d8eab3a1-0ac8-4671-849c-b57dd37b3b4c",
                                "sense_id": "9d935291-6ea0-350e-b9ac-e5ad86e989d1",
                                "text": "„›Einstein ist ein zwielichtiger Scheißkerl, der den Tod an den Meistbietenden verkauft.‹“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
