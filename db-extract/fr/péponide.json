                        "glosses": [
                            "Fruit du type d'une baie caractérisée par sa cuticule dure et imperméable de nombreuses espèces de cucurbitacées."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83eed3c7-3aaf-4b77-9ecb-da5de002c47a",
                                "sense_id": "46480608-8043-38f9-ade9-2517bcd990ae",
                                "text": "Le fruit est très souvent une grosse baie (péponide), à couches externes coriaces et dont l’intérieur, qui comprend les placentas accrus, est charnu; ce peut être aussi une petite baie, parfois déhiscente."
                            }
                        ]
                    }
