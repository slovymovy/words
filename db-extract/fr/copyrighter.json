                ],
                "senses": [
                    {
                        "sense_id": "463f42ab-a743-3b57-bbe1-fb3832924b9a",
                        "entry_id": "ddba923c-f18d-376c-9123-e9aa3ed55c48",
                        "glosses": [
                            "Placer sous la protection d'un copyright."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0e4ea07-86b0-4817-bf8b-7e736863d2aa",
                                "sense_id": "463f42ab-a743-3b57-bbe1-fb3832924b9a",
                                "text": "En tout cas, le début d'un ouvrage obéit à un principe de précaution : signer, titrer, sous-titrer, sur-titrer, dédicacer, préfacer, remercier, copyrighter, dater, localiser, identifier d'un numéro d'ordre dans une « collection », dans une « série », enfin, marquer d'un prix, pourvoir d'une « bande », couvrir d'une illustration à la jaquette, au frontispice ou ailleurs, etc., (...)"
                            },
                            {
                                "example_id": "e69e545b-e592-4634-adc3-e5def9ac9812",
                                "sense_id": "463f42ab-a743-3b57-bbe1-fb3832924b9a",
                                "text": "Pour marquer ses droits d'antériorité, autant sur l'idée que sur la réalisation, elle a fait copyrighter le mot, de sorte que, légalement, elle est la seule à avoir le droit d'utiliser le label de « Multiple »."
                            }
                        ]
                    }
                ],
