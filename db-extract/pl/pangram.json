                                "target_senses": [
                                    {
                                        "sense_id": "4bcc8890-7811-349c-98bd-1bf742b9a828",
                                        "entry_id": "46c1758c-f47b-367e-b033-753e93a72402",
                                        "glosses": [
                                            "Wort oder Satz, in dem jeder Buchstabe eines Alphabets mindestens einmal vorkommt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8fc9c20-1597-469a-b4f6-e0ed4c8853c3",
                                                "sense_id": "4bcc8890-7811-349c-98bd-1bf742b9a828",
                                                "text": "Der Satz „Franz jagt im komplett verwahrlosten Taxi quer durch Bayern.“ ist ein Pangramm des deutschen Alphabets ohne Umlaute."
                                            },
                                            {
                                                "example_id": "7a7abdba-82f2-4467-b55e-fc63ee71b79b",
                                                "sense_id": "4bcc8890-7811-349c-98bd-1bf742b9a828",
                                                "text": "„Früher wurden Pangramme als Prüftext von Schreibmaschinen benutzt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
