                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "огнемёт",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "092e4cad-3ccf-3221-9f8d-06e04c1d5c66",
                                        "entry_id": "c3296754-e805-3c53-9a18-63158f4c88e9",
                                        "glosses": [
                                            "воен. оружие, поражающее цель огнесмесью"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d6e93e2-72ba-4377-8035-7a6817454d71",
                                                "sense_id": "092e4cad-3ccf-3221-9f8d-06e04c1d5c66",
                                                "text": ".. и все дома сожгли из огнемётов, жителей вывели в карантин."
                                            }
