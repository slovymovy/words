{
    "word_family": [
        "alien",
        "alienation",
        "alienator",
        "inalienable"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "06f7b0cc-5af5-3b9a-a0f0-85507fd6bd3f",
                    "sense_definition": "To make someone unfriendly or hostile; to estrange or withdraw affections from.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "estrange",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His constant criticism began to <w>alienate</w> his closest friends.",
                            "target_lang_translations": {
                                "ru": "Его постоянная критика начала <w>отдалять</w> от него самых близких друзей."
                            }
                        },
                        {
                            "text": "The politician's controversial remarks managed to <w>alienate</w> voters who had previously supported him.",
                            "target_lang_translations": {
                                "ru": "Противоречивые высказывания политика сумели <w>оттолкнуть</w> избирателей, которые ранее его поддерживали."
                            }
                        }
                    ],
                    "synonyms": [
                        "estrange",
                        "antagonize"
                    ],
                    "antonyms": [
                        "befriend"
                    ],
                    "common_phrases": [
                        "alienate voters",
                        "alienate friends"
                    ],
                    "target_lang_definitions": {
                        "ru": "Настраивать кого-либо против себя, вызывать враждебность или неприязнь; отдалять от себя."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отчуждать",
                                "target_lang_sense_clarification": "делать чуждым, прекращать близкие отношения"
                            },
                            {
                                "target_lang_word": "отдалять",
                                "target_lang_sense_clarification": "делать менее близким, разрушать эмоциональную связь"
                            },
                            {
                                "target_lang_word": "отталкивать",
                                "target_lang_sense_clarification": "вызывать неприязнь, заставлять отвернуться"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bb184f48-1a7f-378b-805f-59865c7d7dba",
                    "sense_definition": "To cause someone to feel isolated, excluded, or unable to relate to their surrounding society or group.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "isolate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rapid changes in technology can <w>alienate</w> the elderly from modern society.",
                            "target_lang_translations": {
                                "ru": "Стремительные изменения в технологиях могут <w>отчуждать</w> пожилых людей от современного общества."
                            }
                        },
                        {
                            "text": "The new school policies threatened to <w>alienate</w> students who felt their voices were not being heard.",
                            "target_lang_translations": {
                                "ru": "Новые школьные правила грозили <w>оттолкнуть</w> учеников, которые чувствовали, что их мнение не учитывается."
                            }
                        }
                    ],
                    "synonyms": [
                        "isolate",
                        "marginalize"
                    ],
                    "antonyms": [
                        "accept"
                    ],
                    "common_phrases": [
                        "alienate from society"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заставлять кого-либо чувствовать себя изолированным, чужим или неспособным адаптироваться к обществу или группе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отчуждать",
                                "target_lang_sense_clarification": "вызывать чувство изоляции от общества"
                            },
                            {
                                "target_lang_word": "изолировать",
                                "target_lang_sense_clarification": "делать одиноким, отделять от группы"
                            },
                            {
                                "target_lang_word": "отдалять",
                                "target_lang_sense_clarification": "делать чуждым по отношению к окружению"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "22ba5386-c3d0-3272-9622-f666439a443d",
                    "sense_definition": "To transfer the ownership of property, title, or a right to another person.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "transfer_property",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The contract states that the owner cannot <w>alienate</w> the land without prior written consent.",
                            "target_lang_translations": {
                                "ru": "В контракте указано, что владелец не может <w>отчуждать</w> землю без предварительного письменного согласия."
                            }
                        },
                        {
                            "text": "He chose to <w>alienate</w> his property to a local charity before moving abroad.",
                            "target_lang_translations": {
                                "ru": "Он решил <w>передать</w> свое имущество местной благотворительной организации перед переездом за границу."
                            }
                        }
                    ],
                    "common_phrases": [
                        "alienate property"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "legal terminology"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Передавать право собственности на имущество, титул или права другому лицу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отчуждать",
                                "target_lang_sense_clarification": "юридически передавать имущество или права"
                            },
                            {
                                "target_lang_word": "отчудить",
                                "target_lang_sense_clarification": "передать собственность (совершенный вид)"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0d570005-3173-31b7-b7f9-57a19bd9d544",
                    "sense_definition": "Estranged, withdrawn in affection, or feeling like a stranger.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "estranged_adj",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He felt completely <w>alienate</w> from his family after years of living abroad.",
                            "target_lang_translations": {
                                "ru": "Он чувствовал себя совершенно <w>отчужденным</w> от своей семьи после многих лет жизни за границей."
                            }
                        },
                        {
                            "text": "The poet described an <w>alienate</w> soul wandering through a crowded city.",
                            "target_lang_translations": {
                                "ru": "Поэт описал <w>отчужденную</w> душу, блуждающую по переполненному городу."
                            }
                        }
                    ],
                    "synonyms": [
                        "estrange"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used as an adjective in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Отчужденный, отдалившийся, чувствующий себя чужим."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отчужденный",
                                "target_lang_sense_clarification": "чувствующий себя чужим, далеким"
                            },
                            {
                                "target_lang_word": "отдалившийся",
                                "target_lang_sense_clarification": "потерявший прежнюю близость"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "21d40b03-06f8-39e7-8532-1c7e9bb3233c",
                    "sense_definition": "A stranger or an alien.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "stranger_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In that remote village, any newcomer was treated as an <w>alienate</w>.",
                            "target_lang_translations": {
                                "ru": "В той глухой деревне к любому приезжему относились как к <w>чужаку</w>."
                            }
                        },
                        {
                            "text": "The old laws did not grant the same rights to an <w>alienate</w> as to a citizen.",
                            "target_lang_translations": {
                                "ru": "Старые законы не предоставляли <w>иностранцу</w> тех же прав, что и гражданину."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "no longer in common use as a noun"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Чужак, иностранец или посторонний человек."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чужак",
                                "target_lang_sense_clarification": "посторонний человек, не принятый в общество"
                            },
                            {
                                "target_lang_word": "иностранец",
                                "target_lang_sense_clarification": "гражданин другого государства"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}