                                "target_lang_sense_clarification": "a bike or horse"
                            },
                            {
                                "target_lang_word": "to dismount",
                                "target_lang_sense_clarification": "formal, from a horse or bike"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d1ba61d4-da11-36f0-8073-77a6129b7f36",
                    "sense_definition": "naar iemand of iets toe lopen, vaak met een specifiek doel of om een gesprek te beginnen",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "benaderen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je moet gewoon op die persoon <w>afstappen</w> en jezelf netjes voorstellen.",
                            "target_lang_translations": {
                                "en": "You should just <w>walk up to</w> that person and introduce yourself properly."
                            }
                        },
                        {
                            "text": "Toen hij op hen <w>afstapte</w>, was er direct de herkenning.",
                            "target_lang_translations": {
