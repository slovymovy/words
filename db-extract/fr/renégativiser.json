                "senses": [
                    {
                        "sense_id": "96ed2614-d883-3c87-b8c5-70244b05f4bf",
                        "entry_id": "804e9c4e-33dd-3de2-ac8e-406446878ee8",
                        "glosses": [
                            "Redonner un caractère négatif à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9eb09c70-e8e5-46e6-9d3c-c4fafcdef518",
                                "sense_id": "96ed2614-d883-3c87-b8c5-70244b05f4bf",
                                "text": "D’autres sont allés plus loin et ont carrément «renégativisé» le mot en proposant «désavantage» pour sa traduction depuis l’anglais-OMS, imitant les Américains qui l’ont remplacé par «disability», dans le rejet."
                            },
                            {
                                "example_id": "bc4e5d90-82f0-4aaf-85c7-ca14aae75e67",
                                "sense_id": "96ed2614-d883-3c87-b8c5-70244b05f4bf",
                                "text": "J’avais dit à la fenêtre de renégativiser sa polarité, et derrière le dos de Jos il n’y avait plus à nouveau qu’un grand rectangle noir et mat qui absorbait même les luisances intérieures."
                            }
                        ]
                    }
