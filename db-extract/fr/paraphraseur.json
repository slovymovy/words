                "senses": [
                    {
                        "sense_id": "57078dee-3370-3665-861f-e7bf033113fe",
                        "entry_id": "fc8731f2-dc76-3ee5-9bf8-76d8d7234d9b",
                        "glosses": [
                            "Personne qui paraphrase sans créer réellement."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "7c99df89-b456-4ccd-9a53-0be8c69eacca",
                                "sense_id": "57078dee-3370-3665-861f-e7bf033113fe",
                                "text": "L’empereur s’avérait tout simplement un paraphraseur hors pair."
                            },
                            {
                                "example_id": "e1653a1f-1baf-4469-a3ad-cd9136d7aaf6",
                                "sense_id": "57078dee-3370-3665-861f-e7bf033113fe",
                                "text": "Nos fabulistes patois ne sont pas plus des traducteurs que La Fontaine ou Phèdre ; ce sont des arrangeurs ou plutôt des paraphraseurs."
                            },
                            {
                                "example_id": "5d29962d-ba31-4750-b204-cece373eeb57",
                                "sense_id": "57078dee-3370-3665-861f-e7bf033113fe",
                                "text": "Ses \"transversions\" ne sont ni pires ni meilleures que celles d’autres paraphraseurs."
                            },
                            {
                                "example_id": "03fccccd-9630-42f2-8b5c-32e75c5998e4",
                                "sense_id": "57078dee-3370-3665-861f-e7bf033113fe",
                                "text": "Les inventeurs et paraphraseurs de fables se trouvent autorisés à critiquer la fable musicale, même s’ils ne possèdent pas la pleine connaissance du procédé harmonique."
                            }
                        ]
                    }
                ],
