                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "473c7103-db41-4c7e-840e-b9bdea7a282e",
                                                "sense_id": "656d3238-80c1-31bc-8673-1e3c912b9589",
                                                "text": "Lest anyone on the left think that Tucker [Carlson] and his friends are potential anti-capitalist allies, their specific objections to corporate capitalism are revealing. To them, the real issue is not labor exploitation, but rather the “corporate alliance with the progressive left.”"
                                            },
                                            {
                                                "example_id": "9f88511a-ccd2-4249-8f03-e256921634f2",
                                                "sense_id": "656d3238-80c1-31bc-8673-1e3c912b9589",
