                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f7ec67f-961d-40cd-a2e8-6a971191cc5f",
                                "sense_id": "26b388a8-0422-3873-a5ab-7d3d8fc369ef",
                                "text": "„Ebenso steht es mit den Höhenmarkierungen, die der Ort, die Baumgrenze, die Gletscherzunge oder der Berggipfel bieten: Sie sind in ihrer skalensprengenden Wirkung selber die Signale eines Höhentaumels, diese Meter-Angaben.“"
                            },
                            {
                                "example_id": "df1f1132-cf8e-414a-9ad0-3c05bac95ac8",
                                "sense_id": "26b388a8-0422-3873-a5ab-7d3d8fc369ef",
                                "text": "„Die berühmte Gletscherzunge ist rund sechs Autostunden vom Stadtzentrum Reykjavíks entfernt, rund zwei von Vík.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
