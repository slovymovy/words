                        "form_id": "d929e60b-85d3-4ed9-abc9-eaf195148866",
                        "entry_id": "72fbdbe3-1da0-314b-81cb-55a294864d1b",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Weilchen"
