                    {
                        "translation_id": "d7628a24-8cf7-4b95-80ad-7316a4bd98d2",
                        "source_entry_id": "c9f216a4-91c2-3572-b6fa-a63149f3278f",
                        "source_sense_id": "5c1f51ef-ec38-31b3-86a1-f42a8f11782a",
                        "source_sense_description": "zoogdier met pantser van beweegbare schubben uit de familie Dasipodidae",
                        "target_lang_word": "Gürteltier",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gürteltier",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b30838b0-773e-3f47-92bf-052bda4c9311",
                                        "entry_id": "61672b15-c2a3-3e3d-975f-38941c29b38f",
                                        "glosses": [
                                            "Tier der gleichnamigen Ordnung von Säugetieren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d510ae2f-2c88-41b0-8a5d-98357128e510",
                                                "sense_id": "b30838b0-773e-3f47-92bf-052bda4c9311",
                                                "text": "„Ueberhaupt findet man die Gürthelthiere immer einzeln und höchstens die Mutter mit ihren saugenden Jungen in einem und demselben Baue.“"
                                            },
                                            {
                                                "example_id": "8c53f37a-2ebb-4a85-ad71-da55171a71e7",
                                                "sense_id": "b30838b0-773e-3f47-92bf-052bda4c9311",
                                                "text": "„Von diesen sind der kleine Ameisenfresser, verschiedene Gürthelthiere und die Schaalenstücke eigene Zeichnungen, wobey wir an H. Kretsch einen nicht unglücklichen Nachahmer eines de Seve bemerken.“"
                                            },
                                            {
                                                "example_id": "dbf9daaa-ce4a-4b7b-b53e-dff09abdf9f1",
                                                "sense_id": "b30838b0-773e-3f47-92bf-052bda4c9311",
                                                "text": "„Fast die gleiche Bildung zeigt der Magen des schwarzen Gürtelthiers, indem die kleine Curvatur nicht konkav erscheint […].“"
                                            },
                                            {
                                                "example_id": "330c7d26-e3e1-4514-ab80-7e919a7fe6d2",
                                                "sense_id": "b30838b0-773e-3f47-92bf-052bda4c9311",
                                                "text": "„Braucht man für ein Gürteltier ein Halsband zum Gassigehen oder reicht der Gürtel?“"
                                            },
                                            {
                                                "example_id": "e01a4c52-4243-49fd-8004-7020b6e52338",
                                                "sense_id": "b30838b0-773e-3f47-92bf-052bda4c9311",
                                                "text": "„Dieses Gürteltier ist eher leicht zu zeichnen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "de971be3-203e-4f4c-aa35-b4855229a994",
                        "source_entry_id": "c9f216a4-91c2-3572-b6fa-a63149f3278f",
                        "source_sense_id": "5c1f51ef-ec38-31b3-86a1-f42a8f11782a",
                        "source_sense_description": "zoogdier met pantser van beweegbare schubben uit de familie Dasipodidae",
                        "target_lang_word": "armadillo",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "armadillo",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "98accdf4-7ff3-38e6-9aeb-2697da061f2f",
                                        "entry_id": "fb0acf0e-014a-3730-ba1c-c868eac49e1b",
                                        "glosses": [
                                            "Any of the burrowing mammals covered with bony, jointed, protective plates, families Dasypodidae and Chlamyphoridae in the order Cingulata, found in the Americas, especially in South America."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c30f53be-6c0a-4cd5-9017-f94da919a1b6",
                                                "sense_id": "98accdf4-7ff3-38e6-9aeb-2697da061f2f",
                                                "text": "The San Juan market is Mexico City's most famous deli of exotic meats, where an adventurous shopper can hunt down hard-to-find critters …. But the priciest items in the market aren't the armadillo steaks or even the bluefin tuna."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5d2e5150-54d8-475b-b0d7-ded22333b72d",
                        "source_entry_id": "c9f216a4-91c2-3572-b6fa-a63149f3278f",
                        "source_sense_id": "5c1f51ef-ec38-31b3-86a1-f42a8f11782a",
                        "source_sense_description": "zoogdier met pantser van beweegbare schubben uit de familie Dasipodidae",
                        "target_lang_word": "tatou",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tatou",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fbd46af2-cb51-391f-813a-033d9622b1ea",
                                        "entry_id": "3150375f-f368-3f53-ba5e-dba92cfdbe41",
                                        "glosses": [
                                            "Mammifère sauvage du super-ordre des xénarthres, famille des Dasypodidés, dont le corps est couvert d’un test écailleux en forme de cuirasse, et divisé en plusieurs bandes ou ceintures."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5bbe0e2-5e98-4cf4-99ed-fd0c4e53c88b",
                                                "sense_id": "fbd46af2-cb51-391f-813a-033d9622b1ea",
                                                "text": "En moins d’une demi-heure, les chasseurs, sans se fatiguer, abattirent tout le gibier dont ils avaient besoin ; Robert, pour sa part, s’empara d’un curieux animal appartenant à l’ordre des édentés, « un armadillo », sorte de tatou couvert d’une carapace à pièces osseuses et mobiles, qui mesurait un pied et demi de long."
                                            },
                                            {
                                                "example_id": "0842baa9-b851-411f-ac5e-91dd379fce09",
                                                "sense_id": "fbd46af2-cb51-391f-813a-033d9622b1ea",
                                                "text": "Les Tatous sont des animaux innocents et frugivores ; leurs griffes, qui sont très aiguës, les mettent à même de creuser un terrier en un instant : les uns et les autres se mettent en boule, mais ne sont pas invulnérables, comme les Pangolins, parce que leur ennemi peut les saisir au défaut de la cuirasse; on prétend même que lorsqu'ils sont attaqués près d'un précipice, ils s'élancent au fond sans se faire de mal. Il y a plusieurs espèces de Tatous."
                                            },
                                            {
                                                "example_id": "78d48e1b-c5d0-429d-9246-3425f0aecb9e",
                                                "sense_id": "fbd46af2-cb51-391f-813a-033d9622b1ea",
                                                "text": "En 1931, Lizard Ridge, \"La Crête aux Lezards\", Oklahoma, était une ville de bouseux qui se mourait dans les poumons du Poussier. Elle n'avait qu'une seule source de revenus : une usine qui fabriquait des tatous empaillés comme souvenirs, des sacs à main en tatou et des portefeuilles en cuir de gila qu'elle revendait aux touristes qui défilaient à toute vitesse sur la grand-route."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tatou",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "70394b11-57c2-31df-b1d1-2143cf807101",
                                        "entry_id": "db7cd819-5935-3b49-b0aa-e2fe57876519",
                                        "glosses": [
                                            "Couteau multifonction pliable français."
                                        ],
                                        "tags": [
                                            "Coutellerie"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "tatou",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b6acae3a-839c-3b1e-a2f9-8e0e81494517",
                                        "entry_id": "2e9a473b-7cbd-3f21-ad59-1664d42a8b37",
                                        "glosses": [
                                            "Tatouage."
                                        ],
                                        "tags": [
                                            "Tatouage"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ad75187-bd68-41a6-8e0a-003550d10118",
                                                "sense_id": "b6acae3a-839c-3b1e-a2f9-8e0e81494517",
                                                "text": "Les enfants n’ont pas besoin d’être inscrits à une liste électorale pour voter. Après avoir rempli leur bulletin, les enfants recevront un tatou « j’ai voté »."
                                            }
                                        ]
