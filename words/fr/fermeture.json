            "senses": [
                {
                    "sense_id": "124a5ce9-f87c-3246-9666-de2d6a09ace4",
                    "sense_definition": "Action de fermer ou d'interdire le passage ou l'accès.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "N'oubliez pas de vérifier l'heure de <w>fermeture</w> du magasin avant de partir faire vos courses."
                        },
                        {
                            "text": "La police a annoncé la <w>fermeture</w> temporaire de la route principale pour des raisons de sécurité."
                        }
                    ],
                    "antonyms": [
                        "ouverture"
                    ],
                    "common_phrases": [
                        "heure de fermeture",
                        "fermeture des portes",
                        "fermeture annuelle"
                    ]
                },
                {
                    "sense_id": "37c0126e-aff5-3782-8def-83df358e3fb9",
                    "sense_definition": "Dispositif ou mécanisme servant à tenir une chose fermée.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "objet",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La <w>fermeture</w> de mon blouson est coincée et je n'arrive plus à l'ouvrir."
                        },
                        {
                            "text": "Fais bien attention à la <w>fermeture</w> de ta valise pour ne rien perdre en chemin."
                        }
                    ],
                    "common_phrases": [
                        "fermeture éclair"
                    ]
                },
                {
                    "sense_id": "424ecff5-b1e2-3aff-97e7-383674a868a4",
                    "sense_definition": "Arrêt définitif ou temporaire de l'activité d'une entreprise, d'un commerce ou d'un établissement public.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "cessation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les employés manifestent contre la <w>fermeture</w> définitive de l'usine textile de la ville."
                        },
                        {
                            "text": "La crise économique a provoqué la <w>fermeture</w> de plusieurs petits commerces du quartier."
                        }
                    ],
                    "synonyms": [
                        "clôture"
                    ],
                    "antonyms": [
                        "ouverture"
                    ],
                    "common_phrases": [
                        "fermeture définitive",
                        "fermeture d'usine"
                    ]
                },
                {
                    "sense_id": "c75dfb40-189b-337d-9cbd-9b3f4573c4b0",
                    "sense_definition": "En programmation, fonction qui capture et retient les variables de son environnement lexical d'origine.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "technique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le développeur a utilisé une <w>fermeture</w> pour conserver l'état du compteur entre chaque appel de fonction."
                        },
                        {
                            "text": "En JavaScript, chaque fonction crée une <w>fermeture</w> qui englobe ses variables locales."
                        }
                    ],
                    "synonyms": [
                        "closure"
                    ]
                },
                {
                    "sense_id": "b24ec71e-8a54-3263-baaa-b677db35414c",
                    "sense_definition": "En mathématiques, plus petit ensemble stable contenant un ensemble donné pour une opération ou une topologie déterminée.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "technique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans cet espace topologique, la <w>fermeture</w> d'une partie correspond à l'union de celle-ci et de ses points adhérents."
                        },
                        {
                            "text": "Tout ensemble fermé est strictement identique à sa propre <w>fermeture</w>."
                        }
                    ],
                    "synonyms": [
                        "clôture"
                    ],
                    "common_phrases": [
                        "fermeture topologique"
                    ]
                }
            ]
        }
    ]
