                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "141b9e18-d0b3-4126-8209-c05b9869d8d3",
                                                "sense_id": "cfa7afba-7b40-32c3-8748-ac6c97b70b12",
                                                "text": "When the hammer impacts the nail, it bends."
                                            },
                                            {
                                                "example_id": "6a29b06a-372b-4109-9721-84db9df50b49",
                                                "sense_id": "cfa7afba-7b40-32c3-8748-ac6c97b70b12",
                                                "text": "As a microbullet impacts the graphene, the diameter of the cone it creates – determined by later examination of the petals – provides a way to measure how much energy the graphene absorbs before breaking."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "78865f29-4025-3ec8-8a7c-4566044b69b2",
                                        "entry_id": "52b2fde0-10b0-388a-a479-75e36a8a83bf",
                                        "glosses": [
                                            "To compress; to compact; to press into something or pack together."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "08907597-8fdd-4c49-bf6e-b3eb53ed293b",
                                                "sense_id": "78865f29-4025-3ec8-8a7c-4566044b69b2",
                                                "text": "The footprints of birds do not impact the soil in the way those of dinosaurs do."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ffd15e4-c18e-3976-b28c-dac0c18614ba",
