                                        "sense_id": "07fd6db1-2cbb-3079-b544-2d3a6cb7292b",
                                        "entry_id": "0cca5cf6-1e82-3b10-9175-6b3c28823945",
                                        "glosses": [
                                            "Intimate, closely acquainted; familiar, close."
