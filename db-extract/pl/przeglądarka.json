                "translations": [
                    {
                        "translation_id": "1694a5f1-fedc-400a-b909-ae5d62b33e75",
                        "source_entry_id": "ad444150-0ba5-31c6-a341-444addae5c20",
                        "source_sense_id": "7541d930-0f07-3649-a388-167b10a6b6c1",
                        "target_lang_word": "viewer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
