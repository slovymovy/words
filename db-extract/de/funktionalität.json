                                "target_senses": [
                                    {
                                        "sense_id": "2a33d8f4-1b8e-360b-b257-b595157e0820",
                                        "entry_id": "d9e8c643-4f69-3bf1-aa82-59f634741788",
                                        "glosses": [
                                            "The ability to do a task, performance, or execution; a set of functions that something is able or equipped to perform."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d894d7f5-4936-4db4-8382-09aa2a419008",
                                                "sense_id": "2a33d8f4-1b8e-360b-b257-b595157e0820",
                                                "text": "Glu Mobile, who realigned its workforce towards centralized GaaS functions last year, announced earlier this month that it will shut down GameSpy Technology on May 31. The service provides multiplayer functionality for dozens of games on consoles, computers and mobile devices."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7167e70c-c2c8-313b-bdfe-f7ddcb3a4fce",
                                        "entry_id": "d9e8c643-4f69-3bf1-aa82-59f634741788",
                                        "glosses": [
                                            "In trademark law, the tendency of a product design to serve a function other than the identification of the product, preventing that design from being protected as a trademark."
                                        ],
                                        "tags": [
                                            "US",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d21bd74e-cbac-36e6-b706-c3e78c45c4b9",
                                        "entry_id": "d9e8c643-4f69-3bf1-aa82-59f634741788",
                                        "glosses": [
                                            "The presence of a functional group."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ca665034-4783-4b50-819c-e01a3e5dbb79",
                                                "sense_id": "d21bd74e-cbac-36e6-b706-c3e78c45c4b9",
                                                "text": "To appreciate the tasks and problems arising in the synthesis of the monomers it is of fundamental importance to understand that the process used must be capable of yielding organosilanes with different functionalities, since all functionalities are required for synthesis of silicones."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7692c9ee-09ec-41c3-a52d-d5a1f09b1b1a",
                        "source_entry_id": "40059a9b-2570-3618-93ed-7f82d9f653b8",
                        "source_sense_id": "eacc8a9e-d3e3-3d6f-ae80-c371540a8603",
                        "source_sense_description": "die Fähigkeit eines Produktes oder einer Komponente, bestimmte Aufgaben zu lösen",
                        "target_lang_word": "fonctionnalité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fonctionnalité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5bfe57d2-e192-3b3f-939e-9c5d07c21e2f",
                                        "entry_id": "61300785-7d48-3c53-8f39-b25395357236",
                                        "glosses": [
                                            "Ensemble des caractères ou des propriétés qui font que quelque chose remplit bien sa fonction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7284809e-9759-4dcc-a806-a1bfea2c6764",
                                                "sense_id": "5bfe57d2-e192-3b3f-939e-9c5d07c21e2f",
                                                "text": "En effet, une bonne fonctionnalité de la cellule pancréatique va compenser le déficit d’efficacité de l’insuline."
                                            },
                                            {
                                                "example_id": "e2383812-314e-46ec-a527-dce54fcca9be",
                                                "sense_id": "5bfe57d2-e192-3b3f-939e-9c5d07c21e2f",
                                                "text": "Les études consacrées à la situation linguistique en Alsace ont été élaborées à partir d’enquêtes qui ont révélé la perte de fonctionnalité du dialecte, éliminé de nombreux domaines d’utilisation par le français, ainsi qu’une érosion lexicale manifeste…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7dab389b-f79d-3ac1-931b-44c50e6fd810",
                                        "entry_id": "61300785-7d48-3c53-8f39-b25395357236",
                                        "glosses": [
                                            "Fonction implantée dans un système informatique permettant à l’utilisateur d’effectuer un traitement."
                                        ],
                                        "tags": [
                                            "Anglicism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4288f58b-9aa8-4192-8874-8be03955d544",
                                                "sense_id": "7dab389b-f79d-3ac1-931b-44c50e6fd810",
                                                "text": "Par exemple, il semble logique que deux logiciels de réservation de billets de trains aient tous deux prévu une fonctionnalité permettant de choisir une destination particulière."
                                            },
                                            {
                                                "example_id": "f7dabf2e-a903-4b5d-bd42-624f30d490f7",
                                                "sense_id": "7dab389b-f79d-3ac1-931b-44c50e6fd810",
                                                "text": "La plupart du temps, ces programmes ne peuvent fonctionner seuls car ils sont uniquement destinés à apporter une fonctionnalité à un ou plusieurs logiciels […]"
                                            },
                                            {
                                                "example_id": "0cdf416f-0eaa-46d8-87a5-5e938728f2c8",
                                                "sense_id": "7dab389b-f79d-3ac1-931b-44c50e6fd810",
                                                "text": "Ce logiciel a de nombreuses fonctionnalités."
                                            },
                                            {
                                                "example_id": "1b828cb2-2600-4fed-a14e-6e9a54b8d730",
                                                "sense_id": "7dab389b-f79d-3ac1-931b-44c50e6fd810",
                                                "text": "Je dois coder la fonctionnalité de modification interactive pour demain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d32a5589-6492-3749-89ea-d756d2f2ba03",
                                        "entry_id": "61300785-7d48-3c53-8f39-b25395357236",
                                        "glosses": [
                                            "Nombre de fonctions réactives d'une molécule."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f17f08bc-133b-43a5-bbc3-969c1e2574cc",
                                                "sense_id": "d32a5589-6492-3749-89ea-d756d2f2ba03",
                                                "text": "Pour obtenir un polymère tridimensionnel, il faut au moins un monomère de fonctionnalité supérieure à 2."
                                            }
                                        ]
                                    }
                                ]
                            }
