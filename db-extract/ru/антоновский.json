                "senses": [
                    {
                        "sense_id": "8233aa4f-3085-3fe5-ba49-c0630307d5c6",
                        "entry_id": "2807f66d-c5b4-38c5-a368-d8f6be87fb7a",
                        "glosses": [
                            "относящийся к человеку по фамилии Антонов"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd0ede0e-0003-48ba-acf1-69a99d05eccf",
                                "sense_id": "8233aa4f-3085-3fe5-ba49-c0630307d5c6",
                                "text": "Это было до так называемого антоновского восстания, охватившего огромный район и явившегося скорее ответом на то, что делали большевики во имя «классового террора» с деревней."
                            },
                            {
                                "example_id": "a059ed07-f6a8-427a-b2e1-7930f567212c",
                                "sense_id": "8233aa4f-3085-3fe5-ba49-c0630307d5c6",
                                "text": "В руке он держал коробку с тортом, который купил для Антоновых. […] Пышные купы акаций заслонили антоновский домик."
                            }
                        ]
                    }
