                "senses": [
                    {
                        "sense_id": "4bfb05c9-a47a-39d0-82b7-d2aba4294aa6",
                        "entry_id": "7cd2d31a-be29-3700-be4b-d481e4564754",
                        "glosses": [
                            "een geheim bekend makend; het verborgene zichtbaar makend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9d9eec4-f2b4-4260-a484-0b0d8ccfdcac",
                                "sense_id": "4bfb05c9-a47a-39d0-82b7-d2aba4294aa6",
                                "text": "De biografie is een onthullende en ontluisterende reconstructie van het illustere en duistere zakenleven van de \"topvrouw\""
                            },
                            {
                                "example_id": "3ff5f88f-0b41-4255-80a4-d3e664d7e4df",
                                "sense_id": "4bfb05c9-a47a-39d0-82b7-d2aba4294aa6",
                                "text": "In zijn vrije tijd is Stegeman, bekend van onder meer het tv-programma Undercover in Nederland en diverse onthullende documentaires, een verwoed pokeraar. Hij deed op diverse plaatsen in de wereld mee aan toernooien, maar heeft nu een hele grote titel op zijn naam gebracht."
                            },
                            {
                                "example_id": "3398a68f-a574-445b-99d5-0c6f4cdd65fe",
                                "sense_id": "4bfb05c9-a47a-39d0-82b7-d2aba4294aa6",
                                "text": "De Europese voetbalbond reageert daarmee op de onthullende publicaties van vorige maand in Der Spiegel."
                            }
                        ]
                    }
                ],
