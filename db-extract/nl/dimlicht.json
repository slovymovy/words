                        "entry_id": "3452f124-b0f8-3ea3-a6dd-3a8977cf7c28",
                        "glosses": [
                            "de verlichting van een voertuig dat bedoeld is om de weg voor het voertuig te verlichten zonder dat daarbij de bestuurders in tegemoetkomende voertuigen te verblinden."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cdc68395-ca70-43e5-9a72-e9d6a60bd6a7",
                                "sense_id": "d8e81dc7-2482-38d8-bb8f-80cde0e8f216",
                                "text": "Toen de tegenligger er aan kwam werd gauw overgeschakeld van grootlicht naar dimlicht om deze niet te verblinden."
                            }
                        ]
                    }
                ],
