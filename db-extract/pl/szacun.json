                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dfefe22d-e6e9-41d2-b84d-80d56c0f7c73",
                                                "sense_id": "1e9c1a81-90e8-31cf-ae5c-dd7c92a4e173",
                                                "text": "The company is based in New York."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "based",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e291c8f3-359e-3824-ae38-0487a3891b12",
                                        "entry_id": "6a30b5ff-af5e-3f1a-b909-7a1b617d1cd5",
                                        "glosses": [
                                            "Not caring what others think about one's personality, style, or behavior; focused on maintaining individuality."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "064a6ed8-60e9-408e-8a85-3112558bc70c",
                                                "sense_id": "e291c8f3-359e-3824-ae38-0487a3891b12",
                                                "text": "Based means being yourself. Not being scared of what people think about you. Not being afraid to do what you wanna do. Being positive. […] Based is positive."
                                            },
                                            {
                                                "example_id": "e9b9cc85-94e8-4a57-84d1-5f2429e14f28",
                                                "sense_id": "e291c8f3-359e-3824-ae38-0487a3891b12",
                                                "text": "You have to work as a human with empathy and love in your heart, staying positive and staying based and staying normal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "37768ada-6ff4-329b-8a4e-17528791011a",
                                        "entry_id": "6a30b5ff-af5e-3f1a-b909-7a1b617d1cd5",
                                        "glosses": [
                                            "Admirable; praiseworthy, especially if simultaneously unpopular or controversial."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "humorous",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "90f89c55-efcd-41bd-be35-6c29cac1ad11",
                                                "sense_id": "37768ada-6ff4-329b-8a4e-17528791011a",
                                                "text": "I hate l'Académie Française, but their spelling reforms are kind of based."
                                            },
                                            {
                                                "example_id": "07eb404d-224b-402c-a007-f1e9794fe6c3",
                                                "sense_id": "37768ada-6ff4-329b-8a4e-17528791011a",
                                                "text": "I officially approve of North Korea. This is... this is incredibly based."
                                            },
                                            {
                                                "example_id": "41e723da-96f6-4608-9ff8-8153306b3eb1",
                                                "sense_id": "37768ada-6ff4-329b-8a4e-17528791011a",
                                                "text": "OP is based as hell"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd89bfda-772b-33bf-a176-b3844ae1bfa9",
                                        "entry_id": "6a30b5ff-af5e-3f1a-b909-7a1b617d1cd5",
                                        "glosses": [
                                            "Admirable; praiseworthy, especially if simultaneously unpopular or controversial.",
                                            "Admirable for rejecting political correctness or socially progressive values."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "humorous",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0d9020a-d799-4eac-87ee-05c75329754c",
                                                "sense_id": "dd89bfda-772b-33bf-a176-b3844ae1bfa9",
                                                "text": "based and redpilled"
                                            },
                                            {
                                                "example_id": "9f006124-2bfb-4724-bff0-a83a46b1caf7",
                                                "sense_id": "dd89bfda-772b-33bf-a176-b3844ae1bfa9",
                                                "text": "My last account got banned for being too based."
                                            },
                                            {
                                                "example_id": "237d9c9d-56b0-4348-a070-1f0ae46e6a09",
                                                "sense_id": "dd89bfda-772b-33bf-a176-b3844ae1bfa9",
                                                "text": "Those who are against Trump are not based at all. On February 16th, The Donald users comment on a “based” post in r/DankMemes which uses a classic Squidward sleeping meme to criticize those who are upset by Chris Pratt going to “church” (one which was purportedly anti-LGBT) but “ok” with sex predators in Hollywood: […]"
                                            },
                                            {
                                                "example_id": "5cc64230-9d39-41b2-bf8a-f20daf4cea82",
                                                "sense_id": "dd89bfda-772b-33bf-a176-b3844ae1bfa9",
                                                "text": "His [Brenton Tarrant's] meme-themed shooting greatly represents the spirit of the aussie people, in the sense of shitposting until their last moment, based and redpilled he is."
                                            },
                                            {
                                                "example_id": "50a477da-d5e2-425c-a63a-bd92ed233c5f",
                                                "sense_id": "dd89bfda-772b-33bf-a176-b3844ae1bfa9",
                                                "text": "Then, in the same month, noted feminist Christina Hoff Sommers was branded “white supremacy-adjacent” by feminist Roxane Gay. Her reasoning? That our beloved “Based Mom” once appeared at an event with Milo Yiannopoulos and didn't disavow him enough."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "based",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4594da54-33be-3f7a-a6d8-f3fb0cc19e2a",
                                        "entry_id": "1b77edbd-fa91-37f4-9849-0756bfebd92b",
                                        "glosses": [
                                            "Indicating emphatic approval of a statement or opinion, often a controversial or unpopular one."
                                        ],
                                        "tags": [
