{
    "word_family": [
        "spherical",
        "spheroid",
        "sphericity",
        "hemisphere",
        "biosphere",
        "atmosphere",
        "stratosphere",
        "lithosphere",
        "hydrosphere",
        "ensphere",
        "semisphere"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d7376547-3b6b-367c-a793-eb172975f4f3",
                    "sense_definition": "A round object or ball, or something that appears to be shaped like one.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "geometric_shape",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The astronaut looked back at the Earth and saw a beautiful blue <w>sphere</w> floating in space.",
                            "target_lang_translations": {
                                "ru": "Астронавт оглянулся на Землю и увидел прекрасный голубой <w>шар</w>, парящий в космосе.",
                                "zh": "宇航员回望地球，看到一个美丽的蓝色<w>球体</w>漂浮在太空中。"
                            }
                        },
                        {
                            "text": "The artist sculpted a perfect <w>sphere</w> out of a single block of white marble.",
                            "target_lang_translations": {
                                "ru": "Художник высек идеальный <w>шар</w> из цельного блока белого мрамора.",
                                "zh": "艺术家用一块完整的白色大理石雕刻出了一个完美的<w>球</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "orb"
                    ],
                    "common_phrases": [
                        "perfect sphere",
                        "hollow sphere",
                        "crystal sphere"
                    ],
                    "target_lang_definitions": {
                        "ru": "Круглый объект или шар, или нечто, имеющее такую форму.",
                        "zh": "圆形的物体或球体，或看起来像球体的东西。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шар",
                                "target_lang_sense_clarification": "физический объект круглой формы"
                            },
                            {
                                "target_lang_word": "сфера",
                                "target_lang_sense_clarification": "объект шарообразной формы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "球",
                                "target_lang_sense_clarification": "物理上的球形物体"
                            },
                            {
                                "target_lang_word": "球体",
                                "target_lang_sense_clarification": "具有球形特征的物体"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "73231a4c-0732-32f2-855e-e1688b3c0d98",
                    "sense_definition": "An area of activity, interest, or expertise; a person's domain or field of influence.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "domain",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The diplomat worked hard to expand his country's <w>sphere</w> of influence in the region.",
                            "target_lang_translations": {
                                "ru": "Дипломат усердно работал над расширением <w>сферы</w> влияния своей страны в регионе.",
                                "zh": "这位外交官努力扩大他所在国家在该地区的<w>势力范围</w>。"
                            }
                        },
                        {
                            "text": "In the political <w>sphere</w>, decisions are often made based on public opinion polls.",
                            "target_lang_translations": {
                                "ru": "В политической <w>сфере</w> решения часто принимаются на основе опросов общественного мнения.",
                                "zh": "在政治<w>领域</w>，决策往往基于民意调查。"
                            }
                        }
                    ],
                    "synonyms": [
                        "area",
                        "field",
                        "sector",
                        "orbit"
                    ],
                    "common_phrases": [
                        "sphere of influence",
                        "political sphere",
                        "public sphere",
                        "social sphere"
                    ],
                    "target_lang_definitions": {
                        "ru": "Область деятельности, интересов или компетенции; сфера влияния человека.",
                        "zh": "活动、兴趣或专长的领域；某人的势力范围或影响范围。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сфера",
                                "target_lang_sense_clarification": "область деятельности или влияния"
                            },
                            {
                                "target_lang_word": "область",
                                "target_lang_sense_clarification": "определенная сфера интересов или знаний"
                            },
                            {
                                "target_lang_word": "поле",
                                "target_lang_sense_clarification": "пространство для деятельности"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "领域",
                                "target_lang_sense_clarification": "活动或知识的范围"
                            },
                            {
                                "target_lang_word": "范围",
                                "target_lang_sense_clarification": "影响或权力的界限"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eaac6c82-c4d5-38d3-a34d-528f2dcad947",
                    "sense_definition": "A three-dimensional surface where all points are at an equal distance from the center.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "geometric_shape",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In geometry class, we learned how to calculate the surface area of a <w>sphere</w>.",
                            "target_lang_translations": {
                                "ru": "На уроке геометрии мы учились вычислять площадь поверхности <w>сферы</w>.",
                                "zh": "在几何课上，我们学习了如何计算<w>球体</w>的表面积。"
                            }
                        },
                        {
                            "text": "A <w>sphere</w> is the most efficient shape for containing a volume with minimal surface area.",
                            "target_lang_translations": {
                                "ru": "<w>Сфера</w> — это наиболее эффективная форма для удержания объема при минимальной площади поверхности.",
                                "zh": "<w>球体</w>是在最小表面积下容纳体积最高效的形状。"
                            }
                        }
                    ],
                    "synonyms": [
                        "2-sphere"
                    ],
                    "common_phrases": [
                        "surface of a sphere",
                        "radius of the sphere"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "mathematical definition"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Трехмерная поверхность, все точки которой находятся на равном расстоянии от центра.",
                        "zh": "三维表面，其上所有点到中心的距离相等。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сфера",
                                "target_lang_sense_clarification": "геометрическая поверхность"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "球体",
                                "target_lang_sense_clarification": "几何学上的三维形状"
                            },
                            {
                                "target_lang_word": "球面",
                                "target_lang_sense_clarification": "几何学上的表面"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "53030079-1c50-32ad-a909-ce7f4dc9fc4d",
                    "sense_definition": "In ancient astronomy, one of the transparent globes thought to carry the planets and stars around the Earth.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "astronomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ancient philosophers believed that the movement of the planets created the music of the <w>spheres</w>.",
                            "target_lang_translations": {
                                "ru": "Древние философы верили, что движение планет рождает музыку <w>сфер</w>.",
                                "zh": "古代哲学家认为行星的运动创造了<w>天球</w>音乐。"
                            }
                        },
                        {
                            "text": "The Ptolemaic system described the universe as a series of nested <w>spheres</w> with Earth at the center.",
                            "target_lang_translations": {
                                "ru": "Система Птолемея описывала вселенную как ряд вложенных друг в друга <w>сфер</w> с Землей в центре.",
                                "zh": "托勒密体系将宇宙描述为一系列以地球为中心的嵌套<w>球体</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "music of the spheres",
                        "celestial sphere"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical astronomical concept"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "В античной астрономии — одна из прозрачных оболочек, которые, как считалось, несут планеты и звезды вокруг Земли.",
                        "zh": "在古代天文学中，指被认为承载行星和恒星绕地球运行的透明球壳。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сфера",
                                "target_lang_sense_clarification": "небесная оболочка в древних представлениях"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "天球",
                                "target_lang_sense_clarification": "古代天文学中的天体运行轨道"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c8e5f4ba-fbf9-305e-a449-f3a848c074b0",
                    "sense_definition": "To form into a round shape or to make something spherical.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The liquid metal began to <w>sphere</w> as it cooled in the zero-gravity environment.",
                            "target_lang_translations": {
                                "ru": "Жидкий металл начал <w>принимать форму шара</w> по мере остывания в условиях невесомости.",
                                "zh": "液态金属在零重力环境下冷却时开始<w>变圆</w>。"
                            }
                        },
                        {
                            "text": "The sculptor worked the clay to <w>sphere</w> the base of the vase perfectly.",
                            "target_lang_translations": {
                                "ru": "Скульптор работал с глиной, чтобы идеально <w>округлить</w> основание вазы.",
                                "zh": "雕塑家处理黏土，将花瓶的底部完美地<w>塑成球形</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "rare verbal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Придавать круглую форму или делать что-либо сферическим.",
                        "zh": "形成圆形或使某物呈球形。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "придавать форму шара",
                                "target_lang_sense_clarification": "делать объект круглым"
                            },
                            {
                                "target_lang_word": "округлять",
                                "target_lang_sense_clarification": "делать сферическим"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "使成球形",
                                "target_lang_sense_clarification": "将物体塑造成球状"
                            },
                            {
                                "target_lang_word": "变圆",
                                "target_lang_sense_clarification": "物体自身形成圆形"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}