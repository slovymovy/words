                        "glosses": [
                            "Membre d’une communauté réputée pour manger beaucoup de raves (la région concernée peut varier)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "838dafab-7699-4e43-9ac6-b102b1b0e291",
                                "sense_id": "123b88aa-3910-3ea6-b18d-d8ef6c6a11f5",
                                "text": "Ils interdisaient à leurs filles de fréquenter un mange-rave occasionnel."
                            },
                            {
                                "example_id": "fb864cdc-71d8-4b05-b02b-14382e627a38",
                                "sense_id": "123b88aa-3910-3ea6-b18d-d8ef6c6a11f5",
                                "text": "Ce sont les mange-raves du fond. Ils sont toujours à girier."
                            },
                            {
                                "example_id": "75ed8b11-ca8c-4d50-a600-6a7ea54c433f",
                                "sense_id": "123b88aa-3910-3ea6-b18d-d8ef6c6a11f5",
                                "text": "Ce n’est point Homère, Montaigne, ni Hugo, ni même M. André Theuriet de l’Académie française, qu’il nous lit, le Parisien exilé au pays des mange-raves, mais un roman-feuilleton, dans le genre de ceux que publiaient un Pierre Frondaie ou un Maurice Dekobra."
                            }
                        ]
                    }
