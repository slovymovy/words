{
    "word_family": [
        "glaringly"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0a986a06-bbac-3bd3-bc74-12e45ae170f1",
                    "sense_definition": "An intense, blinding light.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "light",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>glare</w> of the sun on the snow made it hard to see.",
                            "target_lang_translations": {
                                "tr": "Kardaki güneşin <w>göz kamaştırıcı ışığı</w> görmeyi zorlaştırdı."
                            }
                        },
                        {
                            "text": "Drivers often wear sunglasses to reduce the <w>glare</w> from the road.",
                            "target_lang_translations": {
                                "tr": "Sürücüler yoldan gelen <w>parıltıyı</w> azaltmak için genellikle güneş gözlüğü takarlar."
                            }
                        }
                    ],
                    "synonyms": [
                        "dazzle"
                    ],
                    "common_phrases": [
                        "sun glare"
                    ],
                    "target_lang_definitions": {
                        "tr": "Göz kamaştırıcı, parlak ışık."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "göz kamaştırıcı ışık",
                                "target_lang_sense_clarification": "Yoğun ve rahatsız edici parlaklık."
                            },
                            {
                                "target_lang_word": "parıltı",
                                "target_lang_sense_clarification": "Yansımadan kaynaklanan yoğun ışık."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "24c0ee28-29fa-376b-9176-9a1394b90f8a",
                    "sense_definition": "An angry or fierce stare.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "stare",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He gave her an angry <w>glare</w> before walking out of the room.",
                            "target_lang_translations": {
                                "tr": "Odadan çıkmadan önce ona <w>ters bir bakış</w> attı."
                            }
                        },
                        {
                            "text": "She ignored his cold <w>glare</w> and continued with her work.",
                            "target_lang_translations": {
                                "tr": "Onun soğuk <w>bakışlarını</w> görmezden geldi ve işine devam etti."
                            }
                        }
                    ],
                    "synonyms": [
                        "scowl"
                    ],
                    "target_lang_definitions": {
                        "tr": "Öfkeli veya sert bir bakış."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "ters bakış",
                                "target_lang_sense_clarification": "Hoşnutsuzluğu ifade eden sert bakış."
                            },
                            {
                                "target_lang_word": "sert bakış",
                                "target_lang_sense_clarification": "Öfke dolu, delici bakış."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8272b703-a7fc-3ba8-9ce4-74e1c8106391",
                    "sense_definition": "A smooth, bright, glassy surface.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "surface",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lake was a <w>glare</w> of ice in the winter morning.",
                            "target_lang_translations": {
                                "tr": "Göl, kış sabahında <w>buz tutmuş parlak bir yüzeydi</w>."
                            }
                        },
                        {
                            "text": "Walking across the <w>glare</w> of ice requires great caution.",
                            "target_lang_translations": {
                                "tr": "<w>Buzlu yüzeyde</w> yürümek büyük dikkat gerektirir."
                            }
                        }
                    ],
                    "common_phrases": [
                        "glare of ice"
                    ],
                    "target_lang_definitions": {
                        "tr": "Pürüzsüz, parlak ve buzlu yüzey."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "buz tabakası",
                                "target_lang_sense_clarification": "Donmuş, parlak ve kaygan yüzey."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7ee2a842-f30a-38b4-bfd9-caea3030a0e5",
                    "sense_definition": "To stare angrily.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "stare",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher began to <w>glare</w> at the students who were talking.",
                            "target_lang_translations": {
                                "tr": "Öğretmen konuşan öğrencilere <w>ters ters bakmaya</w> başladı."
                            }
                        },
                        {
                            "text": "He continued to <w>glare</w> at his opponent throughout the entire match.",
                            "target_lang_translations": {
                                "tr": "Maç boyunca rakibine <w>dik dik bakmaya</w> devam etti."
                            }
                        }
                    ],
                    "synonyms": [
                        "scowl"
                    ],
                    "target_lang_definitions": {
                        "tr": "Öfkeyle bakmak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "ters ters bakmak",
                                "target_lang_sense_clarification": "Birine öfkeyle veya düşmanca bakmak."
                            },
                            {
                                "target_lang_word": "dik dik bakmak",
                                "target_lang_sense_clarification": "Sert ve rahatsız edici bir şekilde bakmak."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ded0a8fc-f554-3a00-a82e-3f4c61e1bf7d",
                    "sense_definition": "To shine brightly.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "light",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The neon signs <w>glare</w> in the dark city streets at night.",
                            "target_lang_translations": {
                                "tr": "Neon tabelalar gece karanlık şehir sokaklarında <w>göz kamaştırıyor</w>."
                            }
                        },
                        {
                            "text": "Bright lights <w>glare</w> down from the ceiling of the stadium.",
                            "target_lang_translations": {
                                "tr": "Parlak ışıklar stadyumun tavanından aşağıya <w>göz kamaştırıcı bir şekilde parlıyor</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "shine"
                    ],
                    "target_lang_definitions": {
                        "tr": "Parlak bir şekilde ışıldamak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "göz kamaştırmak",
                                "target_lang_sense_clarification": "Çok parlak ışık yaymak."
                            },
                            {
                                "target_lang_word": "parlamak",
                                "target_lang_sense_clarification": "Yoğun bir ışık saçmak."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}