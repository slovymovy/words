                ],
                "senses": [
                    {
                        "sense_id": "aa71852b-83ac-373a-9a0c-fe1a48015366",
                        "entry_id": "b564f3a8-42ee-347a-885f-fcb6d02fca60",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7bc28b37-1d6e-419d-a3f9-4185223fdd39",
                                "sense_id": "aa71852b-83ac-373a-9a0c-fe1a48015366",
                                "text": "Frau Kuhner ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "dfa215ab-f014-4653-bfa2-4a64fb55c08a",
                                "sense_id": "aa71852b-83ac-373a-9a0c-fe1a48015366",
                                "text": "Herr Kuhner wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "cca677a8-5bd9-4262-afea-a6e3eae385d7",
                                "sense_id": "aa71852b-83ac-373a-9a0c-fe1a48015366",
                                "text": "Die Kuhners fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "b32273ee-7ab4-4844-9a88-e14689a153bf",
                                "sense_id": "aa71852b-83ac-373a-9a0c-fe1a48015366",
                                "text": "Der Kuhner trägt nie die Schals, die die Kuhner ihm strickt."
                            },
                            {
                                "example_id": "965e8c99-efe6-4fc1-ab58-795ecc03986f",
                                "sense_id": "aa71852b-83ac-373a-9a0c-fe1a48015366",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Kuhner kommt, geht der Herr Kuhner.“"
                            },
                            {
                                "example_id": "7a26511b-ca47-44cc-a1ad-7b0e08982f58",
                                "sense_id": "aa71852b-83ac-373a-9a0c-fe1a48015366",
                                "text": "Kuhner kommt und geht."
                            },
                            {
                                "example_id": "b05c56f8-46e5-4c4d-af17-db291670847d",
                                "sense_id": "aa71852b-83ac-373a-9a0c-fe1a48015366",
                                "text": "Kuhners kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
