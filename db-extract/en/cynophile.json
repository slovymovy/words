                                "target_senses": [
                                    {
                                        "sense_id": "dc825c04-d2b8-31fe-81f4-97dcca41850a",
                                        "entry_id": "53a9ba3b-783f-35be-9c7e-913e6726e2a8",
                                        "glosses": [
                                            "Qui aime les chiens."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c2c61c6-57eb-4222-bca4-29bdf5657fbd",
                                                "sense_id": "dc825c04-d2b8-31fe-81f4-97dcca41850a",
                                                "text": "L’unité cynophile de la Direction de la police urbaine de proximité voit ainsi le jour en 1950, avec comme mission première d’assurer la sécurité des personnes et des biens."
                                            },
                                            {
                                                "example_id": "8e5fa031-e0ee-41c2-8d16-cd9e5fde0729",
                                                "sense_id": "dc825c04-d2b8-31fe-81f4-97dcca41850a",
                                                "text": "«Plus de 200» membres de la DIA, «une centaine» de policiers et gendarmes, soutenus par des hélicoptères et des unités cynophiles ainsi qu'un régiment militaire, participent à cette opération, sur le territoire italien, tandis que «500 agents» y participent dans les trois autres pays, selon la même source."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cynophile",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b6ccc564-2054-3350-acd6-62aca519b8d0",
                                        "entry_id": "503fdab5-d892-33d0-a27b-21ea68626994",
                                        "glosses": [
                                            "Personne qui aime les chiens."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3a9d505-d22f-4652-82ef-b52c1651a6c1",
                                                "sense_id": "b6ccc564-2054-3350-acd6-62aca519b8d0",
                                                "text": "Et Grant a sûrement repéré en moi la cynophile inconditionnelle."
                                            },
                                            {
                                                "example_id": "51adcccf-7145-4c48-982c-426c9e28ab05",
                                                "sense_id": "b6ccc564-2054-3350-acd6-62aca519b8d0",
                                                "text": "Pareil saligaud, voleur, arnaqueur, esclavagiste, cynophile…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
