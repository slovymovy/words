                    {
                        "form_id": "08a4352f-7414-43a7-9f8b-1d17f37404e7",
                        "entry_id": "c461ab2c-8b83-3a7c-973f-0a9decf422f9",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Meerwässer"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f346a9b2-9731-3f0b-8dd3-743953f42a5d",
                        "entry_id": "c461ab2c-8b83-3a7c-973f-0a9decf422f9",
                        "glosses": [
                            "das salzhaltige Wasser, aus dem die Meere bestehen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1007e9b3-994c-48da-b920-4df25ef86f7c",
                                "sense_id": "f346a9b2-9731-3f0b-8dd3-743953f42a5d",
                                "text": "„Auf der frühen Erde wurden die Kontinente durch Vulkanausbrüche erschüttert und jeder komplexe chemische Stoff wäre auf dem Land bald zerstört worden. Meerwasser hingegen löst chemische Stoffe gut auf und ermöglicht es ihnen, zu reagieren.“"
                            },
                            {
                                "example_id": "82f84503-87a1-4188-935e-aff999430789",
                                "sense_id": "f346a9b2-9731-3f0b-8dd3-743953f42a5d",
                                "text": "„In größeren Mengen genossen führt das Meerwasser zu schweren gesundheitlichen Störungen, die bei verdurstenden Personen im Wahnsinn enden.“"
                            },
                            {
                                "example_id": "06cec1b3-9d39-47d0-af15-d7d4aaacff7e",
                                "sense_id": "f346a9b2-9731-3f0b-8dd3-743953f42a5d",
                                "text": "„Die Festung liegt am Rande der Stadt, direkt neben einer Dattelpalmenplantage, und sieht aus wie eine Sandburg, die jemand mit viel Ehrgeiz erbaut hat und über die schon etliche Wellen Meerwasser geschwappt sind.“"
                            },
                            {
                                "example_id": "92443fbf-24e9-4be4-a3bf-ba5e04e0f74d",
                                "sense_id": "f346a9b2-9731-3f0b-8dd3-743953f42a5d",
                                "text": "„Das warme, salzhaltige Meerwasser hat bei ihr die Wirkung einer Heilquelle.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
