                                        "entry_id": "4acb38fb-d9df-3157-80fc-fbf82f469c8a",
                                        "glosses": [
                                            "Martyr des premiers temps du christianisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15852d89-a33f-43e8-a240-337f26fedca4",
                                                "sense_id": "c8e7a3ce-7839-3861-ab76-0a3fe1f3050c",
                                                "text": "Les esprits impurs criaient : Malheur à nous, voila que le protomartyr Étienne passe en nous frappant cruellement d'un glaive de feu."
                                            }
                                        ]
                                    }
                                ]
