                ],
                "senses": [
                    {
                        "sense_id": "ee7a01bb-e345-3ca2-ae0d-a26f8ee3c2a7",
                        "entry_id": "25b56150-a94c-34f1-8b5a-9a29a63897c0",
                        "glosses": [
                            "Laufbahn, bei der die oberen Schichten aus Kunststoff sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "973bc660-5139-4ea9-b263-5841ae74efc0",
                                "sense_id": "ee7a01bb-e345-3ca2-ae0d-a26f8ee3c2a7",
                                "text": "„Laufbahnen sind ein beliebtes Trainingsrevier in Großstädten, aber auch in Gegenden bzw. Ländern, die nicht über derart paradiesische Laufreviere verfügen wie wir in Mitteleuropa. Mittlerweile sind die meisten mit Kunststoffbahnen belegt, auf denen sich mit normalen Laufschuhen wunderbar laufen lässt.“"
                            },
                            {
                                "example_id": "1052f544-6d29-444a-8051-2ebdac24733c",
                                "sense_id": "ee7a01bb-e345-3ca2-ae0d-a26f8ee3c2a7",
                                "text": "„Der ASC investiert in seine Trainingsanlagen und trägt einen Großteil der Kosten an der neuen Kunststoffbahn.“"
                            },
                            {
                                "example_id": "5c37d3fc-27f7-4eaa-bf0b-92edb248f51e",
                                "sense_id": "ee7a01bb-e345-3ca2-ae0d-a26f8ee3c2a7",
                                "text": "„Es hat sich schon herumgesprochen, dass die Übach-Palenberger Kunststoffbahn im Stadion Am Bucksberg ziemlich schnell ist und der Wind meistens von der richtigen Seite weht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "564fbd9f-e4a0-3c5a-ad88-76187ece1728",
                        "entry_id": "25b56150-a94c-34f1-8b5a-9a29a63897c0",
                        "glosses": [
                            "elastische Kunststofffolie zur abdichtenden Flächenbespannung"
                        ],
                        "tags": [
                            "Bau"
                        ],
                        "examples": [
                            {
                                "example_id": "c0341b18-8821-4a83-a45c-b9597ab6933e",
                                "sense_id": "564fbd9f-e4a0-3c5a-ad88-76187ece1728",
                                "text": "„Unter einer Kunststoffbahn versteht man eine Dach- oder Dichtungsbahn aus thermoplastischem Kunststoff.“"
                            },
                            {
                                "example_id": "6579379c-7a10-4b66-841a-1fc87feb265d",
                                "sense_id": "564fbd9f-e4a0-3c5a-ad88-76187ece1728",
                                "text": "„Wenn man bedenkt, was aus diesem Material alles gefertigt wird - so ziemlich alles, von der Freizeitsandale bis zur hochwertigen Kunststoffbahn für die Abdichtung von Flachdächern und zur Bauwerksabdichtung. Kunststoffbahnen sind beständig, biegsam, wasserundurchlässig und daher sehr gut für die Abdichtung von Bauwerken und Dächern geeignet.“"
                            },
                            {
                                "example_id": "f82d4769-6146-4f23-b4de-e8771a1cad99",
                                "sense_id": "564fbd9f-e4a0-3c5a-ad88-76187ece1728",
                                "text": "„Visualisierung der Hauptarbeitsschritte bei der Sanierung eines typischen Flachdachs. Von der Gerüststellung, Demontage des alten Aufbaus, Verlegung von Dampfsperre,Grund- und Gefälledämmung, Herstellung der neuen, lose verlegten Abdichtung aus Kunststoffbahn, Montage der Alu-Dachranabdeckung bis hin zur Verlegung einer extensiven Dachbegrünung, werden die wichtigsten Arbeitsschritte gezeigt.“"
                            },
                            {
                                "example_id": "cd023320-ef6d-4421-a838-c33459ae8b79",
                                "sense_id": "564fbd9f-e4a0-3c5a-ad88-76187ece1728",
                                "text": "„Kunststoffbahnen werden in vielen Bereichen eingesetzt: Im Schwimmbad, auf dem Flachdach, auf Tiefgaragen, in Großküchen, in Chemiewannen usw. Natürlich sind die Folien auf die jeweiligen Anforderungen abgestimmt und entsprechend viele verschiedene Hersteller und Materialien gibt es.“"
                            },
                            {
                                "example_id": "13e158a4-02c4-4489-a382-b3a381aabc72",
                                "sense_id": "564fbd9f-e4a0-3c5a-ad88-76187ece1728",
                                "text": "„Schwere Baumaschinen glätten den Boden über dem Deponiekörper. Anschließend wird eine 2,5 Millimeter dicke Kunststoffbahn aufgetragen und verschweißt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
