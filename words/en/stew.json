                            {
                                "target_lang_word": "изнывать от жары",
                                "target_lang_sense_clarification": "мучиться в жарких условиях"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "闷热",
                                "target_lang_sense_clarification": "形容天气或环境空气不流通且热"
                            },
                            {
