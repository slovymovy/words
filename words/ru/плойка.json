{
    "word_family": [
        "плоить",
        "плоение"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "586c0534-23f5-3ae4-963c-083cf49c4b87",
                    "sense_definition": "Электрический прибор или щипцы для горячей завивки волос",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "укладка волос",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Перед выходом на праздник сестра быстро уложила волосы горячей <w>плойкой</w>.",
                            "target_lang_translations": {
                                "nl": "Voordat ze naar het feest vertrok, bracht mijn zus haar haar snel in model met een hete <w>krultang</w>."
                            }
                        },
                        {
                            "text": "Эта современная <w>плойка</w> для волос нагревается всего за несколько секунд.",
                            "target_lang_translations": {
                                "nl": "Deze moderne <w>krultang</w> warmt binnen enkele seconden op."
                            }
                        }
                    ],
                    "synonyms": [
                        "щипцы для завивки"
                    ],
                    "common_phrases": [
                        "плойка для волос",
                        "завивать на плойку"
                    ],
                    "target_lang_definitions": {
                        "nl": "Elektrisch apparaat of tang om het haar warm mee te krullen"
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "krultang",
                                "target_lang_sense_clarification": "apparaat om krullen mee te maken"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c988dcfb-e188-38dc-b704-3a02f497b634",
                    "sense_definition": "Игровая приставка семейства PlayStation",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "brand_or_product_name",
                    "examples": [
                        {
                            "text": "Мы собрались у друга дома, чтобы поиграть в новую игру на <w>плойке</w>.",
                            "target_lang_translations": {
                                "nl": "We kwamen samen bij een vriend thuis om een nieuw spel te spelen op de <w>PlayStation</w>."
                            }
                        },
                        {
                            "text": "Он давно мечтал купить <w>плойку</w> последнего поколения со скидкой.",
                            "target_lang_translations": {
                                "nl": "Hij droomde er al lang van om een <w>PlayStation</w> van de nieuwste generatie met korting te kopen."
                            }
                        }
                    ],
                    "common_phrases": [
                        "играть в плойку"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Spelcomputer uit de PlayStation-serie (straattaal/informeel)"
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "PlayStation",
                                "target_lang_sense_clarification": "spelcomputer"
                            },
                            {
                                "target_lang_word": "PS",
                                "target_lang_sense_clarification": "afkorting voor PlayStation"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1e913262-f761-3e06-97e3-678c916ab0e0",
                    "sense_definition": "Процесс завивки или сборки ткани мелкими волнистыми складками",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "складки",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Аккуратная <w>плойка</w> воротника требовала от портного особого мастерства и терпения.",
                            "target_lang_translations": {
                                "nl": "Het zorgvuldige <w>plisseren</w> van de kraag vereiste bijzonder vakmanschap en geduld van de kleermaker."
                            }
                        },
                        {
                            "text": "В старинных руководствах по шитью подробно описывалась <w>плойка</w> тонких кружев.",
                            "target_lang_translations": {
                                "nl": "In oude naaihandboeken werd het <w>plooien</w> van fijn kant tot in detail beschreven."
                            }
                        }
                    ],
                    "synonyms": [
                        "плоение",
                        "завивка"
                    ],
                    "target_lang_definitions": {
                        "nl": "Het plooien of rimpelen van stof in fijne, golvende plooitjes"
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "plooien",
                                "target_lang_sense_clarification": "het aanbrengen van plooien in stof"
                            },
                            {
                                "target_lang_word": "plisseren",
                                "target_lang_sense_clarification": "fijne plooitjes in stof vouwen of persen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "24fd4249-615a-3608-aff4-2499ad5e83ab",
                    "sense_definition": "Ряд мелких параллельных складок или волнообразных сборок на ткани",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "складки",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Праздничный фартук был украшен изящной кружевной <w>плойкой</w> по всему краю.",
                            "target_lang_translations": {
                                "nl": "Het feestelijke schort was langs de hele rand versierd met een sierlijke kanten <w>ruche</w>."
                            }
                        },
                        {
                            "text": "На старинном бальном платье пышная <w>плойка</w> подчеркивала строгий силуэт юбки.",
                            "target_lang_translations": {
                                "nl": "Op de antieke baljurk benadrukte het weelderige <w>plooisel</w> het strakke silhouet van de rok."
                            }
                        }
                    ],
                    "synonyms": [
                        "плиссе",
                        "складки"
                    ],
                    "target_lang_definitions": {
                        "nl": "Reeks fijne evenwijdige plooitjes of golvende rimpels op kleding of stof"
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "plissé",
                                "target_lang_sense_clarification": "fijne plooitjes in textiel"
                            },
                            {
                                "target_lang_word": "plooisel",
                                "target_lang_sense_clarification": "versiering van samengeplooide stof"
                            },
                            {
                                "target_lang_word": "ruche",
                                "target_lang_sense_clarification": "gerimpelde strook stof als afwerking"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7b2f6522-ed95-3b09-97e6-5fb96da86b8d",
                    "sense_definition": "Мелкая складчатость горных пород",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Геологи обнаружили, что в этих кристаллических сланцах развита мелкая <w>плойка</w>.",
                            "target_lang_translations": {
                                "nl": "Geologen ontdekten dat er in deze kristallijne schisten sprake was van fijne <w>microplooiing</w>."
                            }
                        },
                        {
                            "text": "Характерная <w>плойка</w> горных пород свидетельствовала о сильном тектоническом давлении.",
                            "target_lang_translations": {
                                "nl": "De kenmerkende <w>crenulatie</w> van de gesteenten wees op een sterke tektonische druk."
                            }
                        }
                    ],
                    "synonyms": [
                        "складчатость"
                    ],
                    "target_lang_definitions": {
                        "nl": "Fijne plooiing of microplooiing van gesteentelagen"
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "microplooiing",
                                "target_lang_sense_clarification": "zeer fijne plooien in gesteente"
                            },
                            {
                                "target_lang_word": "crenulatie",
                                "target_lang_sense_clarification": "geologische term voor fijne plooiing"
                            }
                        ]
                    }
                }
            ]
        }
    ]
