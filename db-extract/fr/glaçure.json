                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "глазурь",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "4551aeeb-0788-30b6-82d3-ef8982480e3c",
                                        "entry_id": "86ef0f92-2007-366f-9946-8895fecf3301",
                                        "glosses": [
                                            "стекловидное покрытие на керамических изделиях, закреплённое обжигом"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3183e61-488e-4968-b326-3e3ce1383de0",
                                                "sense_id": "4551aeeb-0788-30b6-82d3-ef8982480e3c",
                                                "text": "Китайские фарфоровые мастера, если какая-нибудь ваза выходила особенно хорошей, нарочито неискусно охлаждали изделие, и глазурь покрывалась сеткой мелких трещин."
                                            },
                                            {
                                                "example_id": "615e52b5-d63c-499f-bb92-b393142abb81",
                                                "sense_id": "4551aeeb-0788-30b6-82d3-ef8982480e3c",
                                                "text": "Прозрачная голубая глазурь покрывала фаянсовые плиты на стенах комнат, сквозь неё нежно мерцали, просвечивая, замысловатые рисунки из листового золота ― волшебное произведение искусства."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "46bacded-c34c-3deb-8756-4f13ffea237f",
                                        "entry_id": "86ef0f92-2007-366f-9946-8895fecf3301",
                                        "glosses": [
                                            "кулин. густой сладкий сироп (сахарный, шоколадный и т. п.), которым украшают кондитерские изделия и в котором варят фрукты"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8f26d91-777e-44fe-8e7e-1bc984ecfc8a",
                                                "sense_id": "46bacded-c34c-3deb-8756-4f13ffea237f",
                                                "text": "Подготовленные ягоды чёрной смородины погрузить в глазурь, чтобы она полностью их накрыла, уложить на блюдо, посыпанное сахарной пудрой."
                                            }
                                        ]
                                    }
                                ]
                            }
