                "senses": [
                    {
                        "sense_id": "53486a86-35af-3042-b2ff-b49b9789468c",
                        "entry_id": "52e5a338-cb3c-343f-a005-6f62dd70ee4d",
                        "glosses": [
                            "Person, die bahnbrechende Leistungen für die Entwicklung der Raumfahrt erbracht hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd915777-ff02-4a30-93bc-d2e29f8e4ece",
                                "sense_id": "53486a86-35af-3042-b2ff-b49b9789468c",
                                "text": "„Was sind ein paar tausend Tote, wenn man sich dafür als Raumfahrtpionier unsterblich machen kann?“"
                            },
                            {
                                "example_id": "25579cdc-4493-40cf-bea0-652a1b1772bc",
                                "sense_id": "53486a86-35af-3042-b2ff-b49b9789468c",
                                "text": "„Wie kein zweiter Raumfahrtpionier erkannte Oberth die wirtschaftliche Bedeutung der Raumfahrt sowie deren Bedeutung für die Globalisierung des Planeten.“"
                            },
                            {
                                "example_id": "11453565-8c48-47c3-9ef4-b4fc9a880769",
                                "sense_id": "53486a86-35af-3042-b2ff-b49b9789468c",
                                "text": "„Jetzt, wo sich am 16. Juni 2007 der 30. Todestag des Raumfahrtpioniers jährt, wird daran viel offener gedacht als noch zu Hochzeiten des Kalten Kriegs.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
