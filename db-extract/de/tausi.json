                "senses": [
                    {
                        "sense_id": "baffd5e7-b272-3d1a-be4d-4b24b2e7d868",
                        "entry_id": "f2f1b6e7-daff-3244-b847-5577f7e2a0e6",
                        "glosses": [
                            "A grand; 1000 units of some currency (usually Euros or Deutschmarks)."
                        ],
                        "tags": [
                            "masculine",
                            "slang",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "a8373aa9-d91f-43b8-bd28-a8a854ccf776",
                                "sense_id": "baffd5e7-b272-3d1a-be4d-4b24b2e7d868",
                                "text": "Missmutig zückte der Ehemalige unter den Journalisten einen Tausi und reichte ihn dem Bürgermeister.",
                                "translation": "Sullenly, the former members among the journalists pulled out a grand and handed it to the mayor.",
                                "english": "Sullenly, the former members among the journalists pulled out a grand and handed it to the mayor."
                            },
                            {
                                "example_id": "ba1496c7-4a76-49d1-ae75-5a1cf4502f4a",
                                "sense_id": "baffd5e7-b272-3d1a-be4d-4b24b2e7d868",
                                "text": "Der Schönling grüßte in die Schlange, weil ihn alle kannten, und schlenderte Richtung Brad & Berkersdorf, Superedelklamottenladen – eine Unterhose kostet mindestens einen Tausi.",
                                "translation": "The pretty boy saluted the queue since he knew them all and sauntered towards Brad & Berkersdorf, ultra-luxury clothing boutique – a pair of underpants costs at least a grand.",
                                "english": "The pretty boy saluted the queue since he knew them all and sauntered towards Brad & Berkersdorf, ultra-luxury clothing boutique – a pair of underpants costs at least a grand."
                            },
                            {
                                "example_id": "83acb7ab-0d4f-4541-9db4-66303b32d763",
                                "sense_id": "baffd5e7-b272-3d1a-be4d-4b24b2e7d868",
                                "text": "„Was kostet so ein Traktor, Herr Abbenroth?“\n„Der hat hundertachtzig PS. Pro PS ein Tausi, sagen wir.“",
                                "translation": "\"How much does that sort of tractor cost, Herr Abbenroth?\"\n\"It's got 180 HP. Per HP, one grand, we say.\"",
                                "english": "\"How much does that sort of tractor cost, Herr Abbenroth?\"\n\"It's got 180 HP. Per HP, one grand, we say.\""
                            }
                        ]
                    }
