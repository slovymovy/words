{
    "word_family": [
        "dilapidate",
        "dilapidation"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c8078362-defe-3148-b987-6b304f53e998",
                    "sense_definition": "Having fallen into a state of disrepair or deterioration, especially through neglect.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The family decided to buy and restore a <w>dilapidated</w> house in the countryside.",
                            "target_lang_translations": {
                                "de": "Die Familie beschloss, ein <w>baufälliges</w> Haus auf dem Land zu kaufen und zu renovieren."
                            }
                        },
                        {
                            "text": "They walked past a <w>dilapidated</w> building that had been abandoned for decades.",
                            "target_lang_translations": {
                                "de": "Sie gingen an einem <w>heruntergekommenen</w> Gebäude vorbei, das seit Jahrzehnten verlassen war."
                            }
                        }
                    ],
                    "synonyms": [
                        "ramshackle"
                    ],
                    "common_phrases": [
                        "dilapidated building",
                        "dilapidated house"
                    ],
                    "target_lang_definitions": {
                        "de": "In einem Zustand des Verfalls oder der Vernachlässigung befindlich, besonders durch mangelnde Pflege."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "baufällig",
                                "target_lang_sense_clarification": "baulich instabil, vom Einsturz bedroht"
                            },
                            {
                                "target_lang_word": "heruntergekommen",
                                "target_lang_sense_clarification": "in einem desolaten, vernachlässigten Zustand"
                            },
                            {
                                "target_lang_word": "verfallen",
                                "target_lang_sense_clarification": "durch Alter oder Vernachlässigung beschädigt"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f112e05e-fdec-37c1-a8c0-24b7fec054ac",
                    "sense_definition": "simple past and past participle of <w>dilapidate</w>",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The harsh winter weather <w>dilapidated</w> the old wooden fence until it collapsed.",
                            "target_lang_translations": {
                                "de": "Das raue Winterwetter <w>beschädigte</w> den alten Holzzaun so stark, bis er zusammenbrach."
                            }
                        },
                        {
                            "text": "Years of neglect had <w>dilapidated</w> the historic estate beyond recognition.",
                            "target_lang_translations": {
                                "de": "Jahre der Vernachlässigung hatten das historische Anwesen bis zur Unkenntlichkeit <w>verfallen lassen</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and past participle form"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Vergangenheitsform von 'dilapidate' (verfallen lassen, ruinieren)"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "verfallen lassen",
                                "target_lang_sense_clarification": "etwas durch Vernachlässigung ruinieren"
                            },
                            {
                                "target_lang_word": "ruiniert",
                                "target_lang_sense_clarification": "in den Ruin getrieben oder stark beschädigt"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}