                    {
                        "form_id": "24c89e67-ae11-44c4-a001-f3dcfbee1051",
                        "entry_id": "a83db660-31f3-3820-a252-bd4f64078a4a",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Empfängerinnen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "915fda81-be3a-3da2-a79f-cce12e4fdfe3",
                        "entry_id": "a83db660-31f3-3820-a252-bd4f64078a4a",
                        "glosses": [
                            "weibliche Person, die etwas empfängt (= bekommt; erhält; entgegennimmt); die etwas in Empfang nimmt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8fa5fcde-f67d-4eef-a58d-d0c667350501",
                                "sense_id": "915fda81-be3a-3da2-a79f-cce12e4fdfe3",
                                "text": "Die Empfängerin des unfrankierten Briefes musste Strafporto zahlen."
                            },
                            {
                                "example_id": "03412abe-a17e-4fc2-994e-94440a49eeda",
                                "sense_id": "915fda81-be3a-3da2-a79f-cce12e4fdfe3",
                                "text": "„Bei der Ankunft des Gutes in Hamburg stellte sich heraus, daß das Malz mit einem widerlichen Geruch behaftet war, weshalb die Empfängerin, Firma A. J. Ww. in Hamburg, die Annahme verweigerte.“"
                            },
                            {
                                "example_id": "727f6685-8a22-4a81-86e6-cb4f15e5d631",
                                "sense_id": "915fda81-be3a-3da2-a79f-cce12e4fdfe3",
                                "text": "„Nicht nur war die Nachricht an sich eine außerordentliche, auch die Empfängerin, die Tochter, eine Studierte, war perplex.“"
                            },
                            {
                                "example_id": "bfe19882-dfc9-4d49-91a6-fb87d40165b0",
                                "sense_id": "915fda81-be3a-3da2-a79f-cce12e4fdfe3",
                                "text": "„Ihr war es sofort klar, daß Nixblume die Empfängerin gewesen sei.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
