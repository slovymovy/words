{
    "word_family": [
        "wispy",
        "wispiness"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fa6270ec-fa2a-369e-b737-37a4ca8343bd",
                    "sense_definition": "A small, thin, or slender piece, bundle, or streak of something.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "slender-structure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A <w>wisp</w> of smoke rose from the candle for a few moments after he blew it out.",
                            "target_lang_translations": {
                                "ru": "Тонкая <w>струйка</w> дыма поднималась от свечи еще несколько мгновений после того, как он ее задул."
                            }
                        },
                        {
                            "text": "She tried to tuck a <w>wisp</w> of hair behind her ear while she was working.",
                            "target_lang_translations": {
                                "ru": "Она пыталась заправить <w>прядь</w> волос за ухо, пока работала."
                            }
                        }
                    ],
                    "synonyms": [
                        "strand",
                        "shred",
                        "tuft",
                        "streak"
                    ],
                    "common_phrases": [
                        "wisp of smoke",
                        "wisp of hair",
                        "wisp of cloud"
                    ],
                    "target_lang_definitions": {
                        "ru": "Маленький, тонкий или узкий кусочек, пучок или полоска чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "клочок",
                                "target_lang_sense_clarification": "тумана, дыма или волос"
                            },
                            {
                                "target_lang_word": "прядь",
                                "target_lang_sense_clarification": "волос"
                            },
                            {
                                "target_lang_word": "струйка",
                                "target_lang_sense_clarification": "дыма"
                            },
                            {
                                "target_lang_word": "пучок",
                                "target_lang_sense_clarification": "соломы или травы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a32c34ee-da28-3d23-8bc9-6d2ee528597e",
                    "sense_definition": "Something that is thin, fragile, or barely perceptible, often used metaphorically for a spirit or memory.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "ethereal-essence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He felt like a <w>wisp</w> of spirit, as if his physical body no longer mattered.",
                            "target_lang_translations": {
                                "ru": "Он чувствовал себя бесплотной <w>тенью</w>, словно его физическое тело больше не имело значения."
                            }
                        },
                        {
                            "text": "The memory was just a <w>wisp</w> of a dream that faded as soon as he woke up.",
                            "target_lang_translations": {
                                "ru": "Воспоминание было лишь <w>отголоском</w> сна, который растаял, как только он проснулся."
                            }
                        }
                    ],
                    "synonyms": [
                        "trace",
                        "glimmer",
                        "shadow"
                    ],
                    "common_phrases": [
                        "wisp of a dream",
                        "wisp of a girl"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Что-то тонкое, хрупкое или едва заметное; часто используется метафорически о духе или воспоминании."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тень",
                                "target_lang_sense_clarification": "едва заметный след"
                            },
                            {
                                "target_lang_word": "отголосок",
                                "target_lang_sense_clarification": "воспоминания"
                            },
                            {
                                "target_lang_word": "призрак",
                                "target_lang_sense_clarification": "чего-то мимолетного"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "470ec26a-1098-361a-ac49-0b9e76491ef3",
                    "sense_definition": "A brief, flickering light seen at night over marshy ground.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "light-phenomenon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The travelers were lured off the path by a flickering <w>wisp</w> in the distance.",
                            "target_lang_translations": {
                                "ru": "Путешественников сбил с пути мерцающий <w>огонек</w> вдали."
                            }
                        },
                        {
                            "text": "Legends say the <w>wisp</w> that flickers in the swamp is a lost soul.",
                            "target_lang_translations": {
                                "ru": "Легенды гласят, что <w>блуждающий огонек</w>, мерцающий на болоте — это потерянная душа."
                            }
                        }
                    ],
                    "synonyms": [
                        "will-o'-the-wisp",
                        "ignis fatuus"
                    ],
                    "common_phrases": [
                        "will o the wisp"
                    ],
                    "target_lang_definitions": {
                        "ru": "Слабый, мерцающий огонек, видимый ночью над болотистой местностью."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "блуждающий огонек",
                                "target_lang_sense_clarification": "природное явление"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ddffe489-1fe1-3fc1-b47c-2a3fd9bc7d89",
                    "sense_definition": "A collective term for a flock of snipe.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "collective-noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hunter spotted a <w>wisp</w> of snipe rising suddenly from the marsh.",
                            "target_lang_translations": {
                                "ru": "Охотник заметил <w>стаю</w> бекасов, внезапно взлетевшую с болота."
                            }
                        },
                        {
                            "text": "A <w>wisp</w> of snipe is known for its rapid twisting and turning in flight.",
                            "target_lang_translations": {
                                "ru": "<w>Стая</w> бекасов известна своими резкими поворотами и виражами в полете."
                            }
                        }
                    ],
                    "synonyms": [
                        "flock"
                    ],
                    "common_phrases": [
                        "wisp of snipe"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Собирательное название для стаи бекасов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стая",
                                "target_lang_sense_clarification": "бекасов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1a06c521-3b19-38bf-8be4-253f976d6f05",
                    "sense_definition": "A small broom or whisk made of straw or similar material.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "tool",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He used a small <w>wisp</w> to brush the dust off his boots.",
                            "target_lang_translations": {
                                "ru": "Он использовал небольшую <w>метелку</w>, чтобы смахнуть пыль с сапог."
                            }
                        },
                        {
                            "text": "The old stable hand kept a <w>wisp</w> of straw for cleaning the horses.",
                            "target_lang_translations": {
                                "ru": "Старый конюх держал <w>пучок</w> соломы для чистки лошадей."
                            }
                        }
                    ],
                    "synonyms": [
                        "whisk",
                        "broom"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Маленькая метелка или щетка из соломы или подобного материала."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "метелка",
                                "target_lang_sense_clarification": "из соломы"
                            },
                            {
                                "target_lang_word": "пучок",
                                "target_lang_sense_clarification": "для чистки"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ad03720a-f31f-348f-a82c-0db44047ad15",
                    "sense_definition": "To move or be emitted in thin, faint streaks or clouds.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "emission",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chimney was <w>wisping</w> smoke into the cold morning air.",
                            "target_lang_translations": {
                                "ru": "Из трубы в холодный утренний воздух <w>вился</w> дымок."
                            }
                        },
                        {
                            "text": "Steam <w>wisped</w> from the hot cup of tea on the table.",
                            "target_lang_translations": {
                                "ru": "Над чашкой горячего чая на столе <w>струился</w> пар."
                            }
                        }
                    ],
                    "synonyms": [
                        "drift",
                        "curl"
                    ],
                    "common_phrases": [
                        "wisping smoke"
                    ],
                    "target_lang_definitions": {
                        "ru": "Двигаться или исходить тонкими, слабыми струйками или облачками."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "виться",
                                "target_lang_sense_clarification": "о дыме или паре"
                            },
                            {
                                "target_lang_word": "струиться",
                                "target_lang_sense_clarification": "тонкими потоками"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e16b45be-0025-3557-a673-864c04f8f007",
                    "sense_definition": "To brush, rub, or groom using a small bundle of straw or a whisk.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "grooming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The groom <w>wisped</w> the horse's coat until it shone in the sunlight.",
                            "target_lang_translations": {
                                "ru": "Конюх <w>чистил</w> шкуру лошади пучком соломы, пока она не заблестела на солнце."
                            }
                        },
                        {
                            "text": "He <w>wisped</w> the dirt from his trousers with a handful of dry grass.",
                            "target_lang_translations": {
                                "ru": "Он <w>счистил</w> грязь с брюк охапкой сухой травы."
                            }
                        }
                    ],
                    "synonyms": [
                        "brush",
                        "whisk"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "primarily used in historical or equestrian contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Чистить, тереть или приводить в порядок с помощью пучка соломы или щетки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чистить",
                                "target_lang_sense_clarification": "пучком соломы"
                            },
                            {
                                "target_lang_word": "обтирать",
                                "target_lang_sense_clarification": "лошадь или одежду"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}