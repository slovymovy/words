                    },
                    {
                        "translation_id": "dcc0c1f5-5e23-4cfc-9cdd-740e80124d2e",
                        "source_entry_id": "cb37b054-5185-399f-b18d-6d7c6bf8995c",
                        "source_sense_id": "58b227fb-95a9-3a97-aefe-02e3d9474aa6",
                        "target_lang_word": "chronologie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chronologie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "12b7a586-e4f1-3c63-b7a4-9f8f6ab2179b",
                                        "entry_id": "7c56cf5e-34f9-31be-9e66-54208e2dadc1",
                                        "glosses": [
                                            "Science des temps ; connaissance des époques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95e1748a-0f52-4fc3-872e-b25a788e2ea0",
                                                "sense_id": "12b7a586-e4f1-3c63-b7a4-9f8f6ab2179b",
                                                "text": "Pour ce qui est de la forme à donner à cette étude, il apparaît que la chronologie impose quelques divisions principales."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e59e3a39-9622-39a7-b817-1b315544eb3d",
                                        "entry_id": "7c56cf5e-34f9-31be-9e66-54208e2dadc1",
                                        "glosses": [
                                            "Liste d’évènements classés suivant leur date, généralement du plus ancien au plus récent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1437d6b4-19e2-4f77-97a3-f442586ae900",
                                                "sense_id": "e59e3a39-9622-39a7-b817-1b315544eb3d",
                                                "text": "Un temps historique, une histoire dont la chronologie est aisément retraçable, sont le fait d'une classe dominante."
                                            },
                                            {
                                                "example_id": "0e045155-4166-40f1-923c-47818b0f6e16",
                                                "sense_id": "e59e3a39-9622-39a7-b817-1b315544eb3d",
                                                "text": "Malheureusement, le temps réel – toujours enregistrable sur machine – et le temps subjectif – souvent remémorable et restituable après réveil – du rêve sont deux chronologies neurophysiologique et psychologique que nous ne pouvons pas encore discerner objectivement et convenablement par voie expérimentale."
                                            },
                                            {
                                                "example_id": "b6a1868c-a474-494c-8f06-93c39f3af3ad",
                                                "sense_id": "e59e3a39-9622-39a7-b817-1b315544eb3d",
                                                "text": "Cette première esquisse d'une chronologie de l'art rupestre au Yémen est fondée sur une étude limitée géographiquement, essentiellement à la région de Saada, augmentée de quelques relevés aux alentours de Rad' et dans le Wadi Dahr (…)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4a3c0c61-d4e0-4dd7-8656-f0ed93bec5fd",
                        "source_entry_id": "cb37b054-5185-399f-b18d-6d7c6bf8995c",
                        "source_sense_id": "58b227fb-95a9-3a97-aefe-02e3d9474aa6",
                        "target_lang_word": "Chronologie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Chronologie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8cd51801-183f-3615-822b-0e28daf4951f",
                                        "entry_id": "ad78a518-d878-3413-8f1a-4a2063711903",
                                        "glosses": [
                                            "Zeitmessung, Zeitrechnung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ebc639c2-471e-466a-8d3e-e7dd86fc6d80",
                                                "sense_id": "8cd51801-183f-3615-822b-0e28daf4951f",
                                                "text": "Die frühere Chronologie unterscheidet sich von der heutigen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c8766787-e2f6-3d46-b44c-63a12758003e",
                                        "entry_id": "ad78a518-d878-3413-8f1a-4a2063711903",
                                        "glosses": [
                                            "zeitliche Abfolge"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50ff7d19-07f3-4a2d-b132-5cf2cc0c22c2",
                                                "sense_id": "c8766787-e2f6-3d46-b44c-63a12758003e",
                                                "text": "„Die Chronologie der Lexikografie im deutschsprachigen Raum setzt im frühen Mittelalter ein.“"
                                            },
                                            {
                                                "example_id": "d3527004-bc87-4d41-b84f-524a582f377e",
                                                "sense_id": "c8766787-e2f6-3d46-b44c-63a12758003e",
                                                "text": "Die genaue Chronologie der Ereignisse war nicht aufzuklären."
                                            },
                                            {
                                                "example_id": "03531746-ce91-439f-a642-6d7d611a3095",
                                                "sense_id": "c8766787-e2f6-3d46-b44c-63a12758003e",
                                                "text": "„Die beste Möglichkeit einer Geschichtsschreibung nach mathematischem Vorbild sah Leibniz in der Chronologie und in der Genealogie.“"
                                            },
                                            {
                                                "example_id": "0899ddde-5ec4-4eb2-8398-f4a56ae7e0bc",
                                                "sense_id": "c8766787-e2f6-3d46-b44c-63a12758003e",
                                                "text": "„Ich wurde müder und müder, mühte mich um die Chronologie der Ereignisse.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "3a026e8d-0ce5-302f-a63c-fba8460ca1e1",
                                        "entry_id": "ad78a518-d878-3413-8f1a-4a2063711903",
                                        "glosses": [
                                            "Wissenschaft der Zeitmessung, -rechnung"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cde4b369-a8c4-46e3-bc86-644c08a7f140",
                                                "sense_id": "3a026e8d-0ce5-302f-a63c-fba8460ca1e1",
                                                "text": "Die Chronologie bemüht sich um eine möglichst präzise Bestimmung der Zeit."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
