                "senses": [
                    {
                        "sense_id": "165a6cfa-8aa2-39c3-897e-e41db9f35383",
                        "entry_id": "994ef4dd-ebb1-31f2-bb92-52bd2884c8c4",
                        "glosses": [
                            "Relating to, resembling or characteristic of the family Unionidae or its order Unionida of freshwater mussels."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d64167b9-c209-44a1-a79f-cc408a1c4b1c",
                                "sense_id": "165a6cfa-8aa2-39c3-897e-e41db9f35383",
                                "text": "Carbonicola, of the Devonian and Carboniferous, comprises Unionoid Bivalves, with thick shells, an external ligament, and a concentrically-striated surface."
                            },
                            {
                                "example_id": "c801ef67-2be6-4c29-8093-8c62e5f4e7ae",
                                "sense_id": "165a6cfa-8aa2-39c3-897e-e41db9f35383",
                                "text": "I know nothing of that of Solenaia beyond the statement of Fischer regarding its greatly developed, mushroom shaped foot and its burrowing habit. It is, I am satisfied, an unionoid animal and the fact that there is a decided posterior pallial sinus to the shell leads me to believe that it has two siphons."
                            },
                            {
                                "example_id": "ca6ce095-c43b-4d40-afd2-f076613e5e09",
                                "sense_id": "165a6cfa-8aa2-39c3-897e-e41db9f35383",
                                "text": "The current record of Australian Lower Cretaceous non-marine macroinvertebrates is substantial but mainly limited to a few highly productive localities. Some remains have been recovered from near-shore marine rocks including the Valanginian Trinity Well Sandstone Member of the Cadna-owie Formation (South Australia) and the Aptian Wallumbilla Formation (White Cliffs, New South Wales). These have produced freshwater unionoid bivalves (Alathyria coatsi, Hyridella whitecliffsensis) and Australia’s oldest known non-marine gastropod – the viviparid Notopala alboscopularis."
                            }
                        ]
                    }
                ],
