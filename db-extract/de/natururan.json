                        "examples": [
                            {
                                "example_id": "9623b29a-c63f-450c-93d4-5098b79b05ff",
                                "sense_id": "29739f69-fd93-34cd-8191-37af80b02a02",
                                "text": "„Am Institut für chemische Physik in Leningrad führten Julij B. Chariton und Jakow B. Seldowitsch […] Pionierarbeiten zur Untersuchung der Kettenreaktion in Natururan durch, die sie auch veröffentlichten.“"
                            },
                            {
                                "example_id": "7ce5fe5f-5f34-4e91-b253-712588de6ff5",
                                "sense_id": "29739f69-fd93-34cd-8191-37af80b02a02",
                                "text": "„Da schweres Wasser nur einen geringen Einfangquerschnitt für Neutronen besitzt, können Schwerwasserreaktoren grundsätzlich mit Natururan betrieben werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
