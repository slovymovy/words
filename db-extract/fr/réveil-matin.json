                                    {
                                        "sense_id": "1e132aec-d5e3-3147-9ccc-941f780850dd",
                                        "entry_id": "2aa9516e-a70c-37fc-90d2-d75762e75399",
                                        "glosses": [
                                            "Uhr, die zu einer vorher eingestellten Zeit ein Signal gibt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "99d2bd89-530f-455f-aa37-71b79a219da3",
                                                "sense_id": "1e132aec-d5e3-3147-9ccc-941f780850dd",
                                                "text": "Wenn du den Wecker nicht einschaltest, klingelt er auch nicht."
                                            },
                                            {
                                                "example_id": "445e1369-289e-4827-909a-57522042c567",
                                                "sense_id": "1e132aec-d5e3-3147-9ccc-941f780850dd",
                                                "text": "„Um fünf Uhr am nächsten Morgen weckte mich der Ruf des Muezzins, noch bevor mein Wecker losging.“"
                                            },
                                            {
                                                "example_id": "9fd85e71-7542-4b49-9e6a-3f9af78e0c4c",
                                                "sense_id": "1e132aec-d5e3-3147-9ccc-941f780850dd",
                                                "text": "„Die Zeiger des Weckers im Schlafzimmer ticken lauter als sonst.“"
                                            },
                                            {
                                                "example_id": "d2f52492-ad28-4270-8bbc-bb484492013b",
                                                "sense_id": "1e132aec-d5e3-3147-9ccc-941f780850dd",
                                                "text": "„Zuerst dachte er, es sei der Wecker, der ihn aufstehen hieß, aber dann wurde er vollends wach und besann sich auf seinen Beruf.“"
                                            },
                                            {
                                                "example_id": "6d173184-cc39-427e-a3dd-a8fc5f498050",
                                                "sense_id": "1e132aec-d5e3-3147-9ccc-941f780850dd",
                                                "text": "„Dann sah sie zum Wecker auf der Nachkonsole.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Wecker",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f48c92fa-eb80-30b7-80ab-a362f3507c15",
                                        "entry_id": "af8da273-8b43-3664-a585-e616a370bee5",
