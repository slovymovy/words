    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bd912a6f-a267-36af-a496-95f543ff2543",
                    "sense_definition": "Agir ou se conduire d'une certaine manière.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "comportement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les enfants doivent bien se <w>comporter</w> lorsqu'ils sont invités chez leurs grands-parents."
                        },
                        {
                            "text": "Il se <w>comporte</w> toujours comme un adulte responsable face aux difficultés."
                        }
                    ],
                    "synonyms": [
                        "se conduire"
                    ],
                    "common_phrases": [
                        "bien se comporter",
                        "se comporter comme un adulte"
                    ]
                },
                {
                    "sense_id": "693d7520-2af9-371d-8656-9ccbc5b2430e",
                    "sense_definition": "Être constitué de, contenir en soi des parties ou des éléments.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "composition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce nouveau manuel scolaire <w>comporte</w> plusieurs éléments interactifs pour aider les élèves."
                        },
                        {
                            "text": "Notre formule d'abonnement <w>comporte</w> des avantages exclusifs pour tous les membres."
                        }
                    ],
                    "synonyms": [
                        "comprendre",
                        "contenir",
                        "inclure"
                    ],
                    "antonyms": [
                        "exclure"
                    ],
                    "common_phrases": [
                        "comporter plusieurs éléments",
                        "comporter des avantages"
                    ]
                },
                {
                    "sense_id": "3236e547-a5d0-3de1-8bfa-0c5ddfa96b69",
                    "sense_definition": "Avoir pour conséquence inhérente, impliquer ou présenter.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "composition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette intervention médicale délicate peut <w>comporter</w> des risques graves pour le patient."
                        },
                        {
                            "text": "Toute décision financière importante <w>comporte</w> un danger qu'il ne faut pas sous-estimer."
                        }
                    ],
                    "synonyms": [
                        "impliquer",
                        "entraîner"
                    ],
                    "common_phrases": [
                        "comporter des risques",
                        "comporter un danger"
                    ]
                },
                {
                    "sense_id": "22e85a28-6bf8-382b-b589-9912d2677054",
                    "sense_definition": "Réagir ou fonctionner d'une manière particulière dans certaines conditions, en parlant d'un matériau ou d'un objet.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "comportement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce matériau innovant se <w>comporte</w> très bien face à la chaleur extrême."
                        },
                        {
                            "text": "Le nouveau véhicule se <w>comporte</w> à merveille sur les routes de montagne enneigées."
                        }
                    ],
                    "synonyms": [
                        "réagir"
                    ],
                    "common_phrases": [
