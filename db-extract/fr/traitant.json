                "senses": [
                    {
                        "sense_id": "d0bbe3eb-6201-3bd7-a032-2390911ea807",
                        "entry_id": "2e362cb9-6200-3549-baaa-134bcd01bd93",
                        "glosses": [
                            "Qui traite, en particulier en parlant d’un médecin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7ab3c56-3808-499d-b8c8-72f5abb66c92",
                                "sense_id": "d0bbe3eb-6201-3bd7-a032-2390911ea807",
                                "text": "Médecin traitant, celui qui est chargé de surveiller de façon continue le cours d’une maladie, ou un patient), par opposition à un médecin vu de façon exceptionnelle."
                            },
                            {
                                "example_id": "6fbc58a4-343e-43a2-93a0-dda50edefb51",
                                "sense_id": "d0bbe3eb-6201-3bd7-a032-2390911ea807",
                                "text": "Officier traitant, membre des services de renseignement chargé de recruter et de traiter des agents."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "4161979f-8d8d-3bee-891a-d387ded1eb48",
                "word": "traitant",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "28954ee9-9a86-3f90-9f0a-cebbd422d0fe",
                        "entry_id": "4161979f-8d8d-3bee-891a-d387ded1eb48",
                        "glosses": [
                            "Celui qui se chargeait du recouvrement des impositions ou deniers publics, à certaines conditions réglées par un traité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ec6f4b4-1c91-49dc-a83a-7cc732523a7e",
                                "sense_id": "28954ee9-9a86-3f90-9f0a-cebbd422d0fe",
                                "text": "Les traitants s’enrichirent beaucoup sous ce règne."
                            },
                            {
                                "example_id": "38c4c79e-735a-46c1-ad9d-218958fea309",
                                "sense_id": "28954ee9-9a86-3f90-9f0a-cebbd422d0fe",
                                "text": "Le faste de la réception atteignit son comble quand il leur proposa une visite de la forteresse : le roi Soleil à court d’argent menant promener les traitants dans le parc de Versailles ne m’eût pas plus scandalisé."
                            },
                            {
                                "example_id": "d7ca439b-94ea-4d9c-975a-5744eafa7771",
                                "sense_id": "28954ee9-9a86-3f90-9f0a-cebbd422d0fe",
                                "text": "La légende veut que cette maison, avant d’appartenir à Monsieur de Rouvroy, ait été le luxueux hôtel d’un traitant qui y hébergeait des filles d’opéra."
                            }
                        ]
                    },
                    {
                        "sense_id": "8d91c9f3-2c7c-3a0d-8acd-721b521704ed",
                        "entry_id": "4161979f-8d8d-3bee-891a-d387ded1eb48",
                        "glosses": [
                            "Colon qui commerce avec la population indigène."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46218b19-5dc1-4d56-9590-648301a751dd",
                                "sense_id": "8d91c9f3-2c7c-3a0d-8acd-721b521704ed",
                                "text": "Au temps où elle était hollandaise, l'île de Manhattan comptait à peine quelques centaines de hardis traitants qui faisaient, avec les Mohawks et les Mohicans : Indiens des nations iroquoises et algonquines, le commerce des fourrures…, et surtout des peaux de castor.. Les marchands établis à demeure à Fort-Orange et Nieuw-Amsterdani échangeaient ces pelleteries contre des armes, des munitions, de l'eau-de-vie, et les envoyaient aux Pays-Bas."
                            }
                        ]
                    }
                ],
