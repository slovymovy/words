                "senses": [
                    {
                        "sense_id": "207f8d31-8a33-3c7c-81f2-48bc8d1b58a2",
                        "entry_id": "710327ce-df92-31a0-a4b2-9572f33d1d5d",
                        "glosses": [
                            "Relatif au néofascisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e091f05-9734-4fb7-98db-045949a3f613",
                                "sense_id": "207f8d31-8a33-3c7c-81f2-48bc8d1b58a2",
                                "text": "Mais la dynamique néofasciste est mondiale car elle procède d’un phénomène qui s’est déployé à cette échelle : l’avènement du capitalisme néolibéral puis sa crise. Une crise multiforme : sociale, économique, environnementale, et bien sûr politique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "35668efb-7090-46d5-93db-cecd4791b908",
                        "source_entry_id": "710327ce-df92-31a0-a4b2-9572f33d1d5d",
                        "source_sense_id": "207f8d31-8a33-3c7c-81f2-48bc8d1b58a2",
                        "target_lang_word": "neofascist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "neofascist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5843b278-47fb-385c-b1c0-3fe21d59f8dc",
                                        "entry_id": "80b8f13f-f121-3db5-b6cc-893466dfe975",
                                        "glosses": [
                                            "Of or pertaining to neofascism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00931b42-9787-4395-b08c-a1038dc10614",
                                                "sense_id": "5843b278-47fb-385c-b1c0-3fe21d59f8dc",
                                                "text": "The neoliberal era in the United States ended with a neofascist bang."
                                            },
                                            {
                                                "example_id": "1f5f95d9-0537-44f7-94cc-74e6efaa6daf",
                                                "sense_id": "5843b278-47fb-385c-b1c0-3fe21d59f8dc",
                                                "text": "Throughout this area, which includes the Ruhr, Germany's industrial arsenal, there has been a steady growth in Nationalist and neo-Fascist sentiments in the last six months."
                                            },
                                            {
                                                "example_id": "767b145c-396f-42dd-92b9-0eee668acc1a",
                                                "sense_id": "5843b278-47fb-385c-b1c0-3fe21d59f8dc",
                                                "text": "Italian opposition leaders have called on Giorgia Meloni’s rightwing government to ban neofascist groups after a chilling video emerged of hundreds of men making fascist salutes during an event in Rome."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "neofascist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a544ca9c-fec7-3a05-97c1-3d35e1942d08",
                                        "entry_id": "15a2e6ec-73ba-3165-a071-67e1f70c0ba0",
                                        "glosses": [
                                            "A follower of neofascism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac13fd80-d915-4bc5-98b1-7ead1dcf3744",
                                                "sense_id": "a544ca9c-fec7-3a05-97c1-3d35e1942d08",
                                                "text": "By this summer, everything — her youthful admiration for Benito Mussolini, her party’s links to neofascists, her often extreme rhetoric — had been forgiven."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
