                    {
                        "translation_id": "2e3eff38-20dd-4685-9c81-86920d876b37",
                        "source_entry_id": "18854e45-9431-3f63-b62b-dc85b0483876",
                        "source_sense_description": "person who supervises students as they take an examination",
                        "target_lang_word": "наблюда́тель",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "наблюда́тель",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "b1f6d92f-aedd-3f61-8900-7a9c9ac35b53",
                                        "entry_id": "33c7be7f-844d-36a3-8ee2-24b397d07bb7",
                                        "glosses": [
                                            "тот, кто наблюдает за кем-либо, чем-либо, наблюдает что-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "522709aa-b167-499c-8d05-9fc85c9fc14f",
                                                "sense_id": "b1f6d92f-aedd-3f61-8900-7a9c9ac35b53",
                                                "text": "Москва ― богатый, неисчерпаемый рудник для каждого наблюдателя отечественных нравов."
                                            },
                                            {
                                                "example_id": "7207a477-b2cb-4706-80c9-67f34fefac39",
                                                "sense_id": "b1f6d92f-aedd-3f61-8900-7a9c9ac35b53",
                                                "text": "Тут был и ещё наблюдатель, который тоже ещё не избавился от своего чуть не онемения при виде Настасьи Филипповны; но он хоть и стоял «столбом», на прежнем месте своём, в дверях гостиной, однако успел заметить бледность и злокачественную перемену лица Гани. Этот наблюдатель был князь."
                                            },
                                            {
                                                "example_id": "cbfe93f4-9a8a-4a0e-be9f-3ffa795417e4",
                                                "sense_id": "b1f6d92f-aedd-3f61-8900-7a9c9ac35b53",
                                                "text": "Первым наблюдателем, нацелившим на звезды оптический инструмент, был изобретатель телескопа, великий естествоиспытатель Галилео Галилей."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6133d385-292f-33db-a2f7-0d9eebc68bdb",
                                        "entry_id": "33c7be7f-844d-36a3-8ee2-24b397d07bb7",
                                        "glosses": [
                                            "тот, кто по профессии, по службе отслеживает что-либо, занимается наблюдениями за кем-либо, чем-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3c57e99-b8e0-4f23-8b91-ecc390cb4f14",
                                                "sense_id": "6133d385-292f-33db-a2f7-0d9eebc68bdb",
                                                "text": "Посылая прощальные поклоны всему семейству в Мещерское, я не упомянул о бароне Льве Карловиче потому, что он был тогда в Москве по своим обязанностям наблюдателя за построением Большого дворца."
                                            },
                                            {
                                                "example_id": "d08b941d-f92d-45a9-8725-0d424d07c4e8",
                                                "sense_id": "6133d385-292f-33db-a2f7-0d9eebc68bdb",
                                                "text": "На НП иметь постоянных наблюдателей-офицеров, ведущих журнал наблюдения, и карту с нанесёнными на ней огневыми точками противника."
                                            },
                                            {
                                                "example_id": "1ca13b46-7ac5-4bde-8c71-6fb363c1077b",
                                                "sense_id": "6133d385-292f-33db-a2f7-0d9eebc68bdb",
                                                "text": "Так же была утверждена должность специального наблюдателя за соблюдением конституционных прав индейского населения страны."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d79ad6b-946b-3e79-82ce-037492c90ee8",
                                        "entry_id": "33c7be7f-844d-36a3-8ee2-24b397d07bb7",
                                        "glosses": [
                                            "регистратор событий со своей системой отсчёта"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
