                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62cd9eb3-84d3-4b84-9aa5-9af8b81ededf",
                                "sense_id": "0c5c85b4-8174-34ab-9475-429dccbbc039",
                                "text": "For promotion of the secretion of semen virile, an analeptic diet is recommended by one writer."
                            }
                        ]
