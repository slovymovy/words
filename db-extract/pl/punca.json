                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "118f6589-77bb-4afb-80d2-0adf4b9afcf3",
                                                "sense_id": "d6d0ed05-8974-3587-837a-58784716d7bc",
                                                "text": "If she punches me, I'm gonna break her nose."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c94501ce-f4de-32da-a98d-8cd923e629d9",
                                        "entry_id": "fb5a1c9b-4cdf-3af8-9b0d-0bf18183977f",
                                        "glosses": [
                                            "To herd."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "154031f3-90a1-3ef5-b585-0f444a6b9f55",
                                        "entry_id": "fb5a1c9b-4cdf-3af8-9b0d-0bf18183977f",
                                        "glosses": [
                                            "To operate (a device or system) by depressing a button, key, bar, or pedal, or by similar means."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db85c440-da2c-41cb-868c-ab1d7a5ed6e4",
                                                "sense_id": "154031f3-90a1-3ef5-b585-0f444a6b9f55",
                                                "text": "As night watchman he was required to punch a watchman's clock; the stations were scattered all over the place."
                                            },
                                            {
                                                "example_id": "34ac4798-8df0-4952-8525-30e516a32779",
                                                "sense_id": "154031f3-90a1-3ef5-b585-0f444a6b9f55",
                                                "text": "The patrol clock and punch key system made sure that crewmen completed their patrols. At the far end of his patrol, he used a key to punch his clock and start the return trip."
                                            },
                                            {
                                                "example_id": "9fec86a8-7795-48f7-b840-223717337be1",
                                                "sense_id": "154031f3-90a1-3ef5-b585-0f444a6b9f55",
                                                "text": "Another shipmate remembered the watch clock on the strap we had to carry to punching stations. He was assigned to a guard shack. He had rounds to the Officer's Club and sleeping quarters where he'd have to punch the clock at different stations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2038ea50-5915-3c97-99cb-08495de069a2",
                                        "entry_id": "fb5a1c9b-4cdf-3af8-9b0d-0bf18183977f",
                                        "glosses": [
                                            "To enter (information) on a device or system."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "467baa43-c089-319c-af90-dc0d2f6a24ac",
                                        "entry_id": "fb5a1c9b-4cdf-3af8-9b0d-0bf18183977f",
                                        "glosses": [
                                            "To hit (a ball or similar object) with less than full force."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "832f30ca-62ca-4645-b069-bffb70309962",
                                                "sense_id": "467baa43-c089-319c-af90-dc0d2f6a24ac",
                                                "text": "He punched a hit into shallow left field."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bc424023-0ba5-3dce-aab4-42f274e4d84e",
                                        "entry_id": "fb5a1c9b-4cdf-3af8-9b0d-0bf18183977f",
                                        "glosses": [
                                            "To make holes in something (rail ticket, leather belt, etc) (see also the verb under Etymology 2)."
