                                "example_id": "7126ac79-4abb-4b88-af15-90eec25bb20e",
                                "sense_id": "6e93693b-20db-3899-be62-eb54883dd98a",
                                "text": "Zijn beweringen werden met ongeloof ontvangen door de meeste mensen.",
                                "translation": "His claims were met with disbelief by most people.",
                                "english": "His claims were met with disbelief by most people."
                            },
                            {
                                "example_id": "5e8a9a61-664b-41ac-92de-3d16e0b40b48",
                                "sense_id": "6e93693b-20db-3899-be62-eb54883dd98a",
                                "text": "De getuigenis van de ooggetuige zorgde voor groot ongeloof bij het publiek.",
                                "translation": "The eyewitness testimony caused great disbelief among the audience.",
                                "english": "The eyewitness testimony caused great disbelief among the audience."
                            }
                        ]
                    }
                ],
