                        "cross_references": [
                            {
                                "target_word": "koppeln",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6f34261d-2aba-3e2a-8547-2aa17d9ca867",
                                        "entry_id": "7d428110-6dcb-3cdb-931e-fb64d5cb515b",
                                        "glosses": [
                                            "etwas durch ein Seil, Gurt oder Riemen oder eine technische Vorrichtung verbinden"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2fbe0640-7add-470a-b830-a0689ad12d8d",
                                                "sense_id": "6f34261d-2aba-3e2a-8547-2aa17d9ca867",
                                                "text": "Der Busfahrer koppelte den Anhänger mit den Skiern an den Bus."
                                            },
                                            {
                                                "example_id": "6b4e0051-3b45-4eff-866f-ac650eb52b2d",
                                                "sense_id": "6f34261d-2aba-3e2a-8547-2aa17d9ca867",
                                                "text": "Ich koppelte den Laptop via Bluetooth mit den Lautspechern."
                                            },
                                            {
                                                "example_id": "33cc932e-c754-40cf-8a73-ffed16b4968e",
                                                "sense_id": "6f34261d-2aba-3e2a-8547-2aa17d9ca867",
                                                "text": "„Endlich brachte Sancho den Ritter auf den Esel, koppelte Rosinante hinter ihm fest, und den Esel an der Halfter führend, nahm er seinen Weg, so gut es ging, in der Richtung, wo er die Heerstraße vermutete;“ […]"
                                            },
                                            {
                                                "example_id": "64c8a264-2912-4299-9a07-f790d92396b3",
                                                "sense_id": "6f34261d-2aba-3e2a-8547-2aa17d9ca867",
                                                "text": "„Man koppelte also die ledigen Pferde zusammen, stieg auf und ritt davon, zunächst gerade nordwärts, um dann nach Osten umzubiegen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4e0e90ea-5205-3992-9968-12d260ff24a5",
                                        "entry_id": "7d428110-6dcb-3cdb-931e-fb64d5cb515b",
                                        "glosses": [
                                            "etwas von etwas abhängig machen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "151ea39f-6e5e-4b7b-9b0c-899a91e7c43b",
                                                "sense_id": "4e0e90ea-5205-3992-9968-12d260ff24a5",
                                                "text": "Meine Chefin koppelte ihre Zustimmung zu meiner Gehaltserhöhung an den Erfolg des Projektes."
                                            },
                                            {
                                                "example_id": "f6c79173-c6b4-4f60-87d0-81a8f253fb7c",
                                                "sense_id": "4e0e90ea-5205-3992-9968-12d260ff24a5",
                                                "text": "Die Aufhebung von Sanktionen gegenüber Russland ist an die Einhaltung des Minsker Abkommens gekoppelt."
                                            },
                                            {
                                                "example_id": "2cb91041-081c-45ec-b637-4c1b3997cac5",
                                                "sense_id": "4e0e90ea-5205-3992-9968-12d260ff24a5",
                                                "text": "Der Wert des kubanischen sogenannten Konvertiblen Peso (CUC) ist an den US-Dollar gekoppelt."
                                            },
                                            {
                                                "example_id": "c2b109a9-7d09-4f83-8f99-104cc42d7362",
                                                "sense_id": "4e0e90ea-5205-3992-9968-12d260ff24a5",
                                                "text": "„In Polen sind rund 550.000 Hypothekenkredite an die Schweizer Währung gekoppelt, in Rumänien gut 150.000, in Kroatien 60.000 und in Serbien 22.000.“"
                                            },
                                            {
                                                "example_id": "6acd0e6e-642f-49c0-8733-7544465b55fb",
                                                "sense_id": "4e0e90ea-5205-3992-9968-12d260ff24a5",
                                                "text": "„Weil importiertes Erdgas vom Weltmarkt an den Ölpreis gekoppelt ist und der Transport Kosten verursacht, ist internationales Gas deutlich teurer.“"
                                            },
                                            {
                                                "example_id": "2004656a-6081-434b-8a24-3a1b69fa109b",
                                                "sense_id": "4e0e90ea-5205-3992-9968-12d260ff24a5",
                                                "text": "„Die Auszahlungen [der Gläubiger an Griechenland] sind an sogenannte \"Milestones\" gekoppelt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "3deb540f-03cf-332d-86f8-8d69a2bf3a1f",
                                        "entry_id": "7d428110-6dcb-3cdb-931e-fb64d5cb515b",
                                        "glosses": [
                                            "zwei oder mehr Wörter durch einen oder mehrere Bindestriche verbinden"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "900a0d50-fa61-3eeb-80f6-96ddd5e4e632",
                                        "entry_id": "7d428110-6dcb-3cdb-931e-fb64d5cb515b",
                                        "glosses": [
                                            "seinen Standort durch Nachzeichnen der zurückgelegten Distanz auf der Seekarte bestimmen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "377e859f-93bb-4904-ba3d-a99349338d55",
                                                "sense_id": "900a0d50-fa61-3eeb-80f6-96ddd5e4e632",
                                                "text": "„Segelt eine Yacht ohne Landsicht, so bestimmt man ihren Standort durch Koppeln, d.h. man trägt die versegelte Distanz an dem in der Seekarte eingetragenen Kurs ab.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
