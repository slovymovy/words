                "senses": [
                    {
                        "sense_id": "680ab53d-5c72-36ee-91a6-011c5caafa5c",
                        "entry_id": "b5b6cadb-9113-3c88-beee-f8305c24c555",
                        "glosses": [
                            "Dernière partie, conclusion d’une œuvre (discours, roman, film, pièce théâtrale, etc.)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9db0c7b-0595-42f1-823c-517bd63ff69d",
                                "sense_id": "680ab53d-5c72-36ee-91a6-011c5caafa5c",
                                "text": "L’épilogue doit résumer les principaux points d’un discours."
                            },
                            {
                                "example_id": "f438669d-1610-454b-a2e4-8df0fb61805e",
                                "sense_id": "680ab53d-5c72-36ee-91a6-011c5caafa5c",
                                "text": "L’épilogue d’un récit, d’un drame."
                            },
                            {
                                "example_id": "d16348f5-af23-4ba6-a915-0622b4b3904a",
                                "sense_id": "680ab53d-5c72-36ee-91a6-011c5caafa5c",
                                "text": "Le récit de l’ensevelissement et la description de l’église sont un véritable épilogue, ajouté postérieurement."
                            }
                        ]
                    },
                    {
                        "sense_id": "5f0df3a8-c5bb-345e-91f6-ab71a423b358",
                        "entry_id": "b5b6cadb-9113-3c88-beee-f8305c24c555",
                        "glosses": [
                            "Fin."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "d1444e67-4905-4b28-8174-d50e2334b692",
                                "sense_id": "5f0df3a8-c5bb-345e-91f6-ab71a423b358",
                                "text": "Tel fut l’épilogue de cette aventure, de ce procès."
                            }
                        ]
                    }
                ],
