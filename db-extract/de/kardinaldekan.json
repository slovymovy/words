                        ],
                        "examples": [
                            {
                                "example_id": "3e8312f7-1264-4392-bb1c-d7c3749910b3",
                                "sense_id": "1b37cd5a-1f2b-3576-a7a0-c147fc8ad368",
                                "text": "Der Kardinaldekan ist der ranghöchste Kardinal überhaupt, hat aber weder Leitungs- noch Jurisdiktionsbefugnis über die anderen Kardinäle, sondern gilt als ›primus inter pares‹."
                            },
                            {
                                "example_id": "31e558d7-6731-4359-9251-e7418a8be158",
                                "sense_id": "1b37cd5a-1f2b-3576-a7a0-c147fc8ad368",
                                "text": "Während der Sedisvakanz kommen dem Kardinaldekan bedeutende Funktionen zu."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
