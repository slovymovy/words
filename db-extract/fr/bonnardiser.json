                ],
                "senses": [
                    {
                        "sense_id": "0bf86d18-a7e8-3404-b34c-5a481b8b349f",
                        "entry_id": "3d0e0a2a-972e-36e5-909e-71203c7bdac6",
                        "glosses": [
                            "Retoucher une œuvre d’art qu’on a créée, y compris à l’insu de ses nouveaux propriétaires."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57318c5a-6d4d-4785-852a-417d48dc3377",
                                "sense_id": "0bf86d18-a7e8-3404-b34c-5a481b8b349f",
                                "text": "Bonnard était à l'image de ses autoportraits. Angoissé, il ne pouvait s'empêcher de retoucher ses toiles, même après les avoir achevées. Ce que, dans le milieu, on appelait «bonnarder» ou «bonnardiser»."
                            },
                            {
                                "example_id": "69a1b755-56c8-451a-bd07-6b36f86e7e5f",
                                "sense_id": "0bf86d18-a7e8-3404-b34c-5a481b8b349f",
                                "text": "Sous l'impulsion de Pierre Bonnard (1867-1947), les peintres de l'avant-garde du mouvement nabi s'étaient mis à bonnardiser."
                            }
                        ]
                    }
                ],
