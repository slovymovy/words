                        "target_lang_word": "Schläfenlocke",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schläfenlocke",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "05b6d947-b8e7-35a6-be15-35f8e40c36f6",
                                        "entry_id": "42a7fcf2-6b7f-3d7c-8d40-9f37152285cf",
                                        "glosses": [
                                            "an der Schläfe getragene Locke"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ad1720c-f595-46cc-a41d-f6e9d528d3ae",
                                                "sense_id": "05b6d947-b8e7-35a6-be15-35f8e40c36f6",
                                                "text": "„Ein Junge mit roten Schläfenlocken stand auf dem Balkon.“"
                                            },
                                            {
                                                "example_id": "e3a9457e-ce92-4451-96c8-94bd04098fe8",
                                                "sense_id": "05b6d947-b8e7-35a6-be15-35f8e40c36f6",
                                                "text": "„Linksherum riss er das Steuer, rechtsherum, jagte bergan und bergab, neben mir gerieten die Schläfenlocken ins Schwingen.“"
                                            },
                                            {
                                                "example_id": "18a7271c-6223-4829-be8f-f8a36d5fbd05",
                                                "sense_id": "05b6d947-b8e7-35a6-be15-35f8e40c36f6",
                                                "text": "„Bei einem anderen Paket beschrieb Helena ihn mit Bart, Schläfenlocken, einer Kippa auf dem Kopf und mit großen, braunen Augen, klug, jemand, der die Tora kannte und ihre Gebote erfüllte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
