        {
            "pos": "conjunction",
            "senses": [
                {
                    "sense_id": "3a1281ff-422a-3713-a694-29a3b63cac47",
                    "sense_definition": "Omdat; geeft een reden of oorzaak aan.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "reason",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Daar</w> hij ziek was, kon hij niet naar het feest komen.",
                            "target_lang_translations": {
                                "en": "<w>Since</w> he was sick, he could not come to the party.",
                                "ru": "<w>Так как</w> он был болен, он не смог прийти на вечеринку.",
                                "pl": "<w>Jako że</w> był chory, nie mógł przyjść na przyjęcie.",
                                "de": "<w>Da</w> er krank war, konnte er nicht zur Party kommen.",
                                "fr": "<w>Comme</w> il était malade, il n'a pas pu venir à la fête.",
                                "it": "<w>Poiché</w> era malato, non è potuto venire alla festa.",
                                "cs": "<w>Jelikož</w> byl nemocný, nemohl přijít na oslavu.",
                                "tr": "Hasta <w>olduğu için</w> partiye gelemedi.",
                                "es": "<w>Como</w> estaba enfermo, no pudo venir a la fiesta."
                            }
                        },
                        {
                            "text": "We bleven thuis, <w>daar</w> het buiten hard regende.",
                            "target_lang_translations": {
                                "en": "We stayed home, <w>as</w> it was raining hard outside.",
                                "ru": "Мы остались дома, <w>поскольку</w> на улице шел сильный дождь.",
                                "pl": "Zostaliśmy w domu, <w>gdyż</w> na zewnątrz mocno padało.",
