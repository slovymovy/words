                                        "entry_id": "fdb5e565-6fb4-3bbc-9301-cfc6baf8225d",
                                        "glosses": [
                                            "An egg case of any of the orthopteroid insects (such as cockroaches and mantids)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc5c7a4b-3b00-4f3c-ae0e-749d4bb73315",
                                                "sense_id": "c46282c7-da21-3ae0-a24e-53fd196011f4",
                                                "text": "Since the founding of the colony it had been a tradition to unload oothecae – egg sacs – in the cabinets so the younglings would be near the principal food stocks."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "183d9d8d-b0fc-3ed6-9c04-533ae67a1607",
