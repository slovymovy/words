                                "target_senses": [
                                    {
                                        "sense_id": "1f1081aa-76b7-3ff3-82bd-b378fd5aa010",
                                        "entry_id": "d4e7daf2-1a52-313e-abe5-18fa24f99224",
                                        "glosses": [
                                            "Processus de développement d’un être vivant depuis sa conception jusqu'à sa maturité."
                                        ],
                                        "tags": [
                                            "Anatomie comparée"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "15738c48-27c5-3555-b98b-6cd8e3b49eaa",
                                        "entry_id": "d4e7daf2-1a52-313e-abe5-18fa24f99224",
                                        "glosses": [
                                            "Développement d’un individu en termes d’expérience et d’identité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c176883-f232-4fae-8ecb-29de905bce7b",
                                                "sense_id": "15738c48-27c5-3555-b98b-6cd8e3b49eaa",
                                                "text": "Le crime sexuel réalise un crime contre toutes les humanités. Il efface les constructions historisantes de l’ontogenèse et de la phylogenèse. Sa contingence est transculturelle, transconfessionnelle et transhistorique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "878c1b63-c16b-4788-af45-091c0f80aa62",
                        "source_entry_id": "d695f59c-049a-3281-a8e6-f151fbe70fde",
                        "source_sense_id": "ced657b3-8f7e-34ce-b0b0-2cafeccc9147",
                        "source_sense_description": "development of an individual organism",
                        "target_lang_word": "Ontogenie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ontogenie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2139d019-7d98-34de-a929-31c178b6bf6f",
                                        "entry_id": "1f52adf5-bcb3-335a-ab44-aa3f2dc0fcd4",
                                        "glosses": [
                                            "Entwicklungsgeschichte eines einzelnen Organismus von der befruchteten Eizelle zum geschlechtsreifen Organismus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ad9580f-21b8-4c79-bd4e-b12897363912",
                                                "sense_id": "2139d019-7d98-34de-a929-31c178b6bf6f",
                                                "text": "„Die Ontogenie oder Entwickelungsgeschichte der organischen Individuen ist die gesamte Wissenschaft von den Formveränderungen, welche die Bionten oder physiologischen Individuen während der ganzen Zeit ihrer individuellen Existenz durchlaufen, von ihrer Entstehung an bis zu ihrer Vernichtung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "db1d1dbd-87a4-40d8-bfa1-24336bf8e833",
                        "source_entry_id": "d695f59c-049a-3281-a8e6-f151fbe70fde",
                        "source_sense_id": "ced657b3-8f7e-34ce-b0b0-2cafeccc9147",
                        "source_sense_description": "development of an individual organism",
                        "target_lang_word": "Ontogenese",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ontogenese",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "517b5beb-fcad-3e2f-9aef-ba08bf1e307b",
                                        "entry_id": "b776ce2c-73b8-3691-a4eb-1c2d61fb605d",
                                        "glosses": [
                                            "die Individualentwicklung eines biologischen Organismus von seiner Entstehung bis zu seinem Vergehen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "319bd120-d1e3-4e34-a3c0-56a7c67378fb",
                                                "sense_id": "517b5beb-fcad-3e2f-9aef-ba08bf1e307b",
                                                "text": "„Der wissenschaftliche Sprachgebrauch unterscheidet zwischen der Phylogenese, der Entwicklung der Art, und der Ontogenese, der lebensgeschichtlichen Entwicklung jedes einzelnen Individuums.“"
                                            },
                                            {
                                                "example_id": "546da3a5-ab27-44bf-8a24-24c1c513ab97",
                                                "sense_id": "517b5beb-fcad-3e2f-9aef-ba08bf1e307b",
                                                "text": "Nach der nicht mehr gültigen biogenetischen Grundregel von Ernst Haeckel stellt die Ontogenese eine kurze Rekapitulation der Phylogenese dar."
                                            },
                                            {
                                                "example_id": "c54cc72d-fbd0-47d3-9e08-5c2f4f23380d",
                                                "sense_id": "517b5beb-fcad-3e2f-9aef-ba08bf1e307b",
                                                "text": "„In der Ontogenese des Menschen verändern sich Schlafzeiten und Stadienanteile: In der 30. Woche in utero zeigt der Fetus 80 % REM-Schlaf, zur Zeit der Geburt 50 %, in der frühen Schulzeit 25 % und 20 % beim Erwachsenen.“"
                                            },
                                            {
                                                "example_id": "7e5360c3-e70f-4490-8429-ebfbee3ce10b",
                                                "sense_id": "517b5beb-fcad-3e2f-9aef-ba08bf1e307b",
                                                "text": "„Seit über zwei Jahrzehnten werden in der Zoologischen Anstalt der Universität Basel vergleichende Untersuchungen über die Ontogenese der Vögel durchgeführt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
