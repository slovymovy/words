    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ef01a5e1-5b68-3730-a25f-181542367a67",
                    "sense_definition": "Organisme vivant aux dépens d'un autre organisme hôte pour se nourrir ou se reproduire.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "biologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le vétérinaire a trouvé un <w>parasite</w> intestinal dangereux dans l'estomac du chien."
                        },
                        {
                            "text": "Cette tique est un vilain <w>parasite</w> qui peut transmettre des maladies graves."
                        }
                    ],
                    "common_phrases": [
                        "parasite intestinal"
                    ]
                },
                {
                    "sense_id": "3b08e77e-9086-3d5d-b391-7e92f526142c",
                    "sense_definition": "Personne qui vit aux dépens des autres sans fournir d'effort ni de travail.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "social",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ses voisins le considèrent comme un véritable <w>parasite</w> qui profite de tout le monde."
                        },
                        {
                            "text": "Il refuse de travailler et agit comme un <w>parasite</w> au sein de sa famille."
                        }
                    ],
                    "synonyms": [
                        "pique-assiette",
                        "écornifleur"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "terme péjoratif"
                        }
                    ]
                },
                {
                    "sense_id": "42d8ded0-47c1-32a0-bc93-1a0ee797fcfe",
                    "sense_definition": "Perturbation ou bruit indésirable qui altère la transmission d'un signal électrique ou radio.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "technique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Un <w>parasite</w> sur la ligne téléphonique empêche d'entendre clairement la voix."
                        },
                        {
                            "text": "L'orage provoque souvent des <w>parasites</w> qui coupent la réception de la radio."
                        }
                    ],
                    "common_phrases": [
                        "parasite sur la ligne"
                    ]
                }
            ]
        },
