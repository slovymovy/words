{
    "word_family": [
        "sudsy"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8d770a72-c07e-3386-94b4-49318f1fa2e6",
                    "sense_definition": "Froth or foam produced by mixing soap and water.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "foam",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The kitchen sink was full of warm water and thick soapy <w>suds</w>.",
                            "target_lang_translations": {
                                "zh": "厨房水槽里满是温水和浓厚的<w>肥皂泡沫</w>。"
                            }
                        },
                        {
                            "text": "Be sure to rinse all the <w>suds</w> out of your hair before getting out of the shower.",
                            "target_lang_translations": {
                                "zh": "洗完澡前一定要把头发上的<w>泡沫</w>彻底冲洗干净。"
                            }
                        }
                    ],
                    "synonyms": [
                        "foam",
                        "froth",
                        "lather",
                        "soapsuds"
                    ],
                    "common_phrases": [
                        "soapy suds"
                    ],
                    "target_lang_definitions": {
                        "zh": "肥皂和水混合产生的泡沫或肥皂水。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "肥皂泡沫",
                                "target_lang_sense_clarification": "指肥皂水产生的泡沫"
                            },
                            {
                                "target_lang_word": "肥皂水",
                                "target_lang_sense_clarification": "带泡沫的肥皂液体"
                            },
                            {
                                "target_lang_word": "泡沫",
                                "target_lang_sense_clarification": "洗涤时产生的泡沫"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d5f90f7f-0263-35b8-a4fe-9d362c136ea2",
                    "sense_definition": "Beer, especially when served cold.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "alcohol",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After a hard day at work, the friends stopped by the pub for a few cold <w>suds</w>.",
                            "target_lang_translations": {
                                "zh": "辛苦工作了一天后，朋友们顺道去了酒吧喝了几杯冰爽的<w>啤酒</w>。"
                            }
                        },
                        {
                            "text": "We sat on the porch watching the game with pizza and <w>suds</w>.",
                            "target_lang_translations": {
                                "zh": "我们坐在门廊上吃着披萨、喝着<w>啤酒</w>看比赛。"
                            }
                        }
                    ],
                    "synonyms": [
                        "beer",
                        "brew"
                    ],
                    "common_phrases": [
                        "cold suds"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "informal slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "啤酒（尤指冰镇啤酒，俚语）。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "啤酒",
                                "target_lang_sense_clarification": "俚语口语表达"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7c9ef40a-39d7-3adc-9c3b-9e7cc9fcaafa",
                    "sense_definition": "Initialism of sudden unexpected death syndrome (or sudden unexplained death syndrome).",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Medical researchers are investigating the genetic factors that might contribute to <w>SUDS</w>.",
                            "target_lang_translations": {
                                "zh": "医学研究人员正在调查可能导致<w>猝死综合征</w>的遗传因素。"
                            }
                        },
                        {
                            "text": "Cases of <w>SUDS</w> often leave families without any clear medical answers.",
                            "target_lang_translations": {
                                "zh": "<w>猝死综合征</w>病例往往让家属无法得到明确的医学解释。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "猝死综合征（突发意外死亡综合征或突发不明原因死亡综合征）的首字母缩写。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "猝死综合征",
                                "target_lang_sense_clarification": "医学名词，突发不明原因死亡综合征"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "16112b30-f01c-38b5-9e5c-2e7e1e099112",
                    "sense_definition": "Plural of <w>SUD</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Clinicians must understand the various <w>SUDs</w> to provide appropriate treatment plans for their patients.",
                            "target_lang_translations": {
                                "zh": "临床医生必须了解各种<w>物质使用障碍</w>，以便为患者提供合适的治疗方案。"
                            }
                        },
                        {
                            "text": "Several common <w>SUDs</w> often co-occur with depression and anxiety.",
                            "target_lang_translations": {
                                "zh": "几种常见的<w>物质使用障碍</w>常常与抑郁和焦虑并存。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "物质使用障碍（SUD，Substance Use Disorder）的复数形式。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "物质使用障碍",
                                "target_lang_sense_clarification": "医学名词，指物质滥用或成瘾疾患"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "585378ab-4fc7-3d83-b6bf-c5cc5a685c4e",
                    "sense_definition": "To cover with lather or soapy water.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "foam",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>sudsed</w> his hands thoroughly before preparing the food.",
                            "target_lang_translations": {
                                "zh": "他在准备食物前把双手彻底<w>抹上肥皂揉搓起泡</w>。"
                            }
                        },
                        {
                            "text": "We <w>sudsed</w> the dirty car before hosing it down until it shone.",
                            "target_lang_translations": {
                                "zh": "我们把这辆脏车<w>涂满肥皂泡清洗</w>，然后用水管冲洗直到它光亮如新。"
                            }
                        }
                    ],
                    "synonyms": [
                        "lather",
                        "soap"
                    ],
                    "common_phrases": [
                        "suds up"
                    ],
                    "target_lang_definitions": {
                        "zh": "涂上肥皂水或揉出泡沫。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "抹上肥皂",
                                "target_lang_sense_clarification": "用肥皂涂抹起泡"
                            },
                            {
                                "target_lang_word": "打起泡沫",
                                "target_lang_sense_clarification": "使产生肥皂泡沫"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}