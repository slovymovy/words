                    }
                ],
                "translations": [
                    {
                        "translation_id": "b5384f44-3f2c-40b4-b5f6-31a5c2cf0ab8",
                        "source_entry_id": "27fbd521-721c-3be7-a770-e7252a480eaf",
                        "source_sense_id": "b9a58506-dc9d-3f75-b7d3-ccf025ee9e1d",
                        "source_sense_description": "kleiner Turm",
                        "target_lang_word": "turret",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "turret",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "74f75f71-01de-3e90-89ab-8e9505023ff8",
                                        "entry_id": "803d81d8-4569-364a-9dfe-e43a4ce76584",
                                        "glosses": [
                                            "A little tower, frequently a merely ornamental structure at one of the corners of a building or castle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ec5cc0f-caaf-41f9-9d47-b158658e74bd",
                                                "sense_id": "74f75f71-01de-3e90-89ab-8e9505023ff8",
                                                "text": "Their Victorian house had three turrets and a large amount of gingerbread trim."
                                            },
                                            {
                                                "example_id": "24f917cb-c094-471d-b13d-21e14425b190",
                                                "sense_id": "74f75f71-01de-3e90-89ab-8e9505023ff8",
                                                "text": "There breathes no being but has some pretence / To that fine instinct called poetic sense; […] / The freeman, casting with unpurchased hand / The vote that shakes the turrets of the land."
                                            },
                                            {
                                                "example_id": "4406b6fc-e797-484e-a7b9-f8a788cfccbd",
                                                "sense_id": "74f75f71-01de-3e90-89ab-8e9505023ff8",
                                                "text": "Awake! for Morning in the Bowl of Night,\nHas flung the Stone that puts the Stars to Flight:\nAnd Lo! the Hunter of the East has caught\nThe Sultán's Turret in a Noose of light."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "576ec483-4bc8-3af2-b38a-a5a71afc6fcc",
                                        "entry_id": "803d81d8-4569-364a-9dfe-e43a4ce76584",
                                        "glosses": [
                                            "A siege tower; a movable building, of a square form, consisting of ten or even twenty stories and sometimes one hundred and twenty cubits high, usually moved on wheels, and employed in approaching a fortified place, for carrying soldiers, engines, ladders, casting bridges, and other necessaries."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8aff3d55-bc1e-3dd1-9016-bd40e3bd7112",
                                        "entry_id": "803d81d8-4569-364a-9dfe-e43a4ce76584",
                                        "glosses": [
                                            "A tower-like solder post on a turret board (a circuit board with posts instead of holes)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cc61299a-b927-34e1-93ec-8004aada7b26",
                                        "entry_id": "803d81d8-4569-364a-9dfe-e43a4ce76584",
                                        "glosses": [
                                            "An armoured, rotating gun installation on a fort, ship, aircraft, or armoured fighting vehicle."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4a7d85e2-8f9a-30e1-b68a-e84f0d82f6e8",
                                        "entry_id": "803d81d8-4569-364a-9dfe-e43a4ce76584",
                                        "glosses": [
                                            "The elevated central portion of the roof of a passenger car, with sides that are pierced for light and ventilation."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "de349719-1326-319d-9923-f8d512497063",
                                        "entry_id": "803d81d8-4569-364a-9dfe-e43a4ce76584",
                                        "glosses": [
                                            "A turret head."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e6ba11bd-92c4-46bc-ac00-d378c83604e5",
                        "source_entry_id": "27fbd521-721c-3be7-a770-e7252a480eaf",
                        "source_sense_id": "b9a58506-dc9d-3f75-b7d3-ccf025ee9e1d",
                        "source_sense_description": "kleiner Turm",
                        "target_lang_word": "tourelle",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tourelle",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "16200fc4-fa60-3338-a4c0-74679b873830",
                                        "entry_id": "44d2824d-669b-3831-b02c-bcdf3d44ec65",
                                        "glosses": [
                                            "Petite tour."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7fb8f5c3-7761-4832-9c03-83d05b4c85c1",
                                                "sense_id": "16200fc4-fa60-3338-a4c0-74679b873830",
                                                "text": "Cette tourelle est répétée vers le jardin par une autre à cinq pans, terminée en cul-de-four, et qui supporte un clocheton, au lieu d’être coiffée, comme sa sœur, d’une poivrière."
                                            },
                                            {
                                                "example_id": "75146887-4a9f-46e6-af3c-35349c231c04",
                                                "sense_id": "16200fc4-fa60-3338-a4c0-74679b873830",
                                                "text": "Hermann était, […], resté debout contre un des supports massifs de la cheminée, écoutant le bruit du vent dans les hautes tourelles."
                                            },
                                            {
                                                "example_id": "a234ef8b-0967-4bf4-be7b-6453b47e32be",
                                                "sense_id": "16200fc4-fa60-3338-a4c0-74679b873830",
                                                "text": "Ces arcs-boutants massifs sont creux à partir de quelques pieds du sol, et se terminent par une sorte de tourelle qui communique avec l’intérieur du donjon."
                                            },
                                            {
                                                "example_id": "e478616e-dec6-44fb-ac74-e92ea9d77bf4",
                                                "sense_id": "16200fc4-fa60-3338-a4c0-74679b873830",
                                                "text": "C'est un de ces petits châteaux de Touraine, blancs, jolis, à tourelles sculptées, brodés comme une dentelle de Malines."
                                            },
                                            {
                                                "example_id": "1f3204a6-69ff-4e76-a101-7740e369f7f9",
                                                "sense_id": "16200fc4-fa60-3338-a4c0-74679b873830",
                                                "text": "Pour vous punir, je devrais vous cacher que vous m'avez surprise rêvant manoirs à tourelles, landes fleuries, pierres druidiques et autres curiosités bretonnes."
                                            },
                                            {
                                                "example_id": "bc5bae31-bcf7-4b8f-b7f6-46350a68498b",
                                                "sense_id": "16200fc4-fa60-3338-a4c0-74679b873830",
                                                "text": "Les tourelles connues de deux ou trois châteaux voisins lui faisaient, pour les éviter, décrire quelques détours, puis il se perdait dans la campagne ou dans la forêt, très loin, au diable vert."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "50488605-3c64-3c2d-8b75-248bdb826204",
                                        "entry_id": "44d2824d-669b-3831-b02c-bcdf3d44ec65",
                                        "glosses": [
                                            "Tour cuirassée, tournant souvent sur elle-même, et qui sert à abriter des canons."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85911061-e9cf-4b92-a405-d68ef801125a",
                                                "sense_id": "50488605-3c64-3c2d-8b75-248bdb826204",
                                                "text": "La ceinture supérieure, depuis la première tourelle jusqu'à la dernière, était haute de 4,50 mètres et épaisse de 180 millimètres, le navire avait 4 ponts blindés et les tourelles principales avaient reçu un blindage de 320 millimètres, quant au blockhaus il avait un blindage de 300 millimètres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f401532-19f4-317f-978f-516277091146",
                                        "entry_id": "44d2824d-669b-3831-b02c-bcdf3d44ec65",
                                        "glosses": [
                                            "Poste de mitraillage de certains bombardiers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8958758-dc48-45b2-8d3d-090634c94814",
                                                "sense_id": "4f401532-19f4-317f-978f-516277091146",
                                                "text": "Le père de Garp était un mitrailleur de tourelle de queue revenu du ciel de France avec une blessure non accidentelle. « De tous les membres de l'équipage d'un bombardier, écrivit Garp, le mitrailleur de la tourelle de queue se trouvait l'un des plus exposés au feu des batteries antiaériennes."
                                            },
                                            {
                                                "example_id": "6adb038d-505f-4fee-883b-ef2d09bb71c9",
                                                "sense_id": "4f401532-19f4-317f-978f-516277091146",
                                                "text": "C'est sa petite taille qui l'a fait désigner pour occuper la tourelle ventrale. Littéralement replié, ses genoux presque au contact de sa poitrine, à l'intérieur de cette boule Sperry dotée de deux mitrailleuses M2 Browning et susceptible de pivoter sur 360 degrés, il protège le ventre du bombardier, son point faible."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bcb38a08-1023-32a6-aecb-73dbe06f9e88",
                                        "entry_id": "44d2824d-669b-3831-b02c-bcdf3d44ec65",
                                        "glosses": [
                                            "Ensemble de tuyaux verticaux du buffet arrangés en forme de tour."
                                        ],
                                        "tags": [
                                            "Orgues"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
