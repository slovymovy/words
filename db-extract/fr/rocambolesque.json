                "forms": [
                    {
                        "form_id": "c586c49b-9b26-434c-8853-2030569ceaf2",
                        "entry_id": "c0a6a12f-792f-3373-8ab8-aa7edf744060",
                        "tags": [
                            "plural",
                            "masculine",
