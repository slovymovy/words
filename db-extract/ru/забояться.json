                        "glosses": [
                            "(+ génitif) Avoir peur, craindre, redouter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bed9959a-e151-4bd1-9574-f472328f8107",
                                "sense_id": "5615bf35-f603-33ae-adf6-15e8e1841363",
                                "text": "бояться темноты : avoir peur de l’obscurité."
                            },
                            {
                                "example_id": "0a10925d-18f9-4f27-b484-6b06014eef41",
                                "sense_id": "5615bf35-f603-33ae-adf6-15e8e1841363",
                                "text": "бояться собак : avoir peur des chiens."
                            }
                        ]
                    },
                    {
                        "sense_id": "15adca98-fb5a-3f8f-ac12-36f9da1a6b86",
                        "entry_id": "7ac409fa-2365-3371-a991-8e5fc13f17b2",
                        "glosses": [
                            "(за + accusatif) Avoir peur (pour quelqu’un)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49b9d8f8-8919-4f43-8d01-e2aa2352ac38",
                                "sense_id": "15adca98-fb5a-3f8f-ac12-36f9da1a6b86",
                                "text": "бояться за своих детей : avoir peur pour ses enfants."
                            }
                        ]
                    },
                    {
                        "sense_id": "17e33686-d545-36b9-9e5e-bc482e57e15e",
                        "entry_id": "7ac409fa-2365-3371-a991-8e5fc13f17b2",
                        "glosses": [
                            "(+ génitif) Se méfier, éviter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d59ecb73-dfd4-4fd3-b55a-0193ed90aca0",
                                "sense_id": "17e33686-d545-36b9-9e5e-bc482e57e15e",
                                "text": "бояться простуды : éviter le refroidissement."
                            },
                            {
                                "example_id": "bf007b17-2ea9-4451-a5d5-cd5e2d3b03e1",
                                "sense_id": "17e33686-d545-36b9-9e5e-bc482e57e15e",
                                "text": "бояться сплетен : se méfier des commérages."
                            }
                        ]
                    },
                    {
                        "sense_id": "074b79b7-1699-3a90-97c2-a7a495f297af",
                        "entry_id": "7ac409fa-2365-3371-a991-8e5fc13f17b2",
                        "glosses": [
                            "(+ génitif) Craindre, ne pas supporter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b06a4f0-2524-486a-aef0-240cd7a2b096",
                                "sense_id": "074b79b7-1699-3a90-97c2-a7a495f297af",
                                "text": "материал боится сырости : [ce] matériel craint l’humidité."
                            },
                            {
                                "example_id": "98d033b4-4f0b-4881-89e5-ed3d47dd246c",
                                "sense_id": "074b79b7-1699-3a90-97c2-a7a495f297af",
                                "text": "цветущие яблони боятся заморозков : les pommiers en fleur craignent le gel."
