                                        "entry_id": "1ab7432f-f7bd-39fa-ab17-c324c3894398",
                                        "glosses": [
                                            "Médecin spécialisé dans l’oto-rhino-laryngologie (nez, gorge, oreilles)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c6e3be1-21a4-4c15-b992-eec3c0f73982",
                                                "sense_id": "08d9de40-c71d-3290-b942-2e2aee63406a",
                                                "text": "Vous êtes dispensé d’avance de frais, sur présentation de votre carte de tiers payant France Mutuelle, accompagnée de votre carte Vitale et de la prescription médicale établie par votre ophtalmologue ou votre oto-rhino-laryngologiste."
                                            },
                                            {
                                                "example_id": "04506c7a-a134-4865-81b3-4d01fb6a5672",
                                                "sense_id": "08d9de40-c71d-3290-b942-2e2aee63406a",
                                                "text": "Fille d'un cardiologue et d'une oto-rhino-laryngologiste, elle a consulté pour tenter de comprendre ce qui lui arrivait."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
