                    {
                        "form_id": "0d277b7a-8204-42c5-8edd-07a267ec809d",
                        "entry_id": "e9caff0c-48e3-32b2-ad6b-0b745c10e82b",
                        "tags": [],
                        "form": "chéfesse"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "61511f78-ec5b-37cd-bb8b-e5b594b48987",
                        "entry_id": "e9caff0c-48e3-32b2-ad6b-0b745c10e82b",
                        "glosses": [
                            "Celle qui est à la tête d’un corps, d’une assemblée, etc., qui y a le premier rang et la principale autorité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9030a498-0d6e-4bf2-8ee2-543b23d6b475",
                                "sense_id": "61511f78-ec5b-37cd-bb8b-e5b594b48987",
                                "text": "Et vous, mesdemoiselles, à l’ouvrage ! Obéissance à votre seconde cheffesse ! Gare aux paresseuses !"
                            },
                            {
                                "example_id": "523c9902-e557-4f3f-91c9-49a4d83870ca",
                                "sense_id": "61511f78-ec5b-37cd-bb8b-e5b594b48987",
                                "text": "Horreur !… ma femme cheffesse de voleurs !… Ah ! le cœur me manque… les jambes aussi…"
                            },
                            {
                                "example_id": "f7a6dd57-9462-4197-b44e-239915507892",
                                "sense_id": "61511f78-ec5b-37cd-bb8b-e5b594b48987",
                                "text": "Parfois aussi, à la tête d’un clan ou d’un village, il s’est trouvé une cheffesse, une femme exerçant l’autorité."
                            },
                            {
                                "example_id": "007d22b1-0cd4-4a4d-8926-fa86979cf144",
                                "sense_id": "61511f78-ec5b-37cd-bb8b-e5b594b48987",
                                "text": "Receveuse était l’équivalent de chef de station — on disait couramment « cheffesse », car le féminisme triomphant n’avait pas encore masculinisé toutes les fonctions."
                            }
                        ]
                    },
                    {
                        "sense_id": "bb00116b-a04f-3f7e-88b7-b7af166c689d",
                        "entry_id": "e9caff0c-48e3-32b2-ad6b-0b745c10e82b",
                        "glosses": [
                            "Nom de la dignité de certaines femmes en Polynésie."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "38009c8a-ede0-3c4f-9b48-8525089d97d4",
                        "entry_id": "e9caff0c-48e3-32b2-ad6b-0b745c10e82b",
                        "glosses": [
                            "Épouse d’un chef."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "a225125f-a61e-46af-b0f0-59bcd4753569",
                                "sense_id": "38009c8a-ede0-3c4f-9b48-8525089d97d4",
                                "text": "Elle n’ignorait pas non plus que ses huit compagnes la haïssaient cordialement, parce qu’elle était la cheffesse de toutes les femmes des villages relevant de l’autorité de leur mari commun, et, en même temps, sa favorite."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f063dd4a-b3b4-4e32-9416-4e9df7adbb4d",
                        "source_entry_id": "e9caff0c-48e3-32b2-ad6b-0b745c10e82b",
                        "target_lang_word": "chiefess",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chiefess",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "aeeeb3d1-83bc-3bde-b9ed-9c616de850d5",
                                        "entry_id": "a73bb3ea-034b-31ff-b78c-2eecffbb8227",
                                        "glosses": [
                                            "Synonym of chieftainess, a female chief."
                                        ],
                                        "tags": [
                                            "Hawaii"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f0e680c5-37ef-4dba-9811-5ad5e7ba9bbd",
                                                "sense_id": "aeeeb3d1-83bc-3bde-b9ed-9c616de850d5",
                                                "text": "Although Lili‘u was born a high chiefess, with lineage that reached back to the high chiefs under Kamehameha the Great, at the time of her birth it would never have seemed possible that she would someday become queen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3daf0989-ecc8-47e3-bcab-7a7a23710588",
                        "source_entry_id": "e9caff0c-48e3-32b2-ad6b-0b745c10e82b",
                        "target_lang_word": "chieftainess",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chieftainess",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "86c21107-a79a-34a5-80eb-e0104cc621b3",
                                        "entry_id": "de9667af-21e2-316c-9178-b5a01ed24214",
                                        "glosses": [
                                            "A female chieftain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c9decea-e6c5-4d36-896f-d32875cd21e6",
                                                "sense_id": "86c21107-a79a-34a5-80eb-e0104cc621b3",
                                                "text": "He gazed in silence for some minutes upon the body of Meg Merrilies, as it lay before him, with the features sharpened by death, yet still retaining the stern and energetic character which had maintained in life her superiority as the wild chieftainess of the lawless people amongst whom she was born."
                                            },
                                            {
                                                "example_id": "a9ec6b36-de04-48d6-af1e-ea9fdcd51a13",
                                                "sense_id": "86c21107-a79a-34a5-80eb-e0104cc621b3",
                                                "text": "Mrs. Douse was more important than Mr. Douse; she was a chieftainess in her own right, and had great dignity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d268782c-1a57-3787-a28d-b37807bb9a32",
                                        "entry_id": "de9667af-21e2-316c-9178-b5a01ed24214",
                                        "glosses": [
                                            "The wife of a chieftain."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
