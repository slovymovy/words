                        "source_sense_id": "d77d27ba-0bc5-35d7-8b4d-7459496d8427",
                        "source_sense_description": "Anatomie: Drüse, in der Keimzellen und Geschlechtshormone gebildet werden",
                        "target_lang_word": "gonade",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
