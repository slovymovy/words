                "senses": [
                    {
                        "sense_id": "387bd086-580a-35b2-9ab5-09c84145c078",
                        "entry_id": "e3e325cf-d3f1-38aa-a649-8b96ec84422b",
                        "glosses": [
                            "schouwtoneel, met meestal niet meer dan een zanderige bodem, waar bijv. sportwedstrijden, gevechten of circusvoorstellingen gehouden worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52fc8f16-0a7d-4152-8327-0b5db11dcbb9",
                                "sense_id": "387bd086-580a-35b2-9ab5-09c84145c078",
                                "text": "De dompteur betrad de arena met een fikse zweep in de hand en opende de kooi met de leeuw."
                            },
                            {
                                "example_id": "e077fc49-7543-4b3f-b6b1-fd78e9325f2d",
                                "sense_id": "387bd086-580a-35b2-9ab5-09c84145c078",
                                "text": "Ze was een christelijke pottenbakster die geen knieval voor de autoriteiten wilde maken toen ze haar opdroegen om heidense afbeeldingen te vervaardigen, en toen hebben ze haar in een arena met een leeuw gesmeten."
                            }
                        ]
                    },
                    {
                        "sense_id": "d10ae986-3fb9-39e7-acbf-d7b45b22569d",
                        "entry_id": "e3e325cf-d3f1-38aa-a649-8b96ec84422b",
                        "glosses": [
                            "achtergrond, setting waartegen iets zich afspeelt"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "db400dfc-d249-4952-9811-2b4fcb78b9bf",
                                "sense_id": "d10ae986-3fb9-39e7-acbf-d7b45b22569d",
                                "text": "De politieke arena."
                            },
                            {
                                "example_id": "e2e11a34-3085-49cb-b07a-be76bf0a58d3",
                                "sense_id": "d10ae986-3fb9-39e7-acbf-d7b45b22569d",
                                "text": "Het internet is de arena van de leugen geworden."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5a44a29a-fbab-4636-ba69-1cd699453ec0",
                        "source_entry_id": "e3e325cf-d3f1-38aa-a649-8b96ec84422b",
                        "source_sense_id": "387bd086-580a-35b2-9ab5-09c84145c078",
