                },
                {
                    "sense_id": "4936324a-e4b8-34de-a77e-3c895423f196",
                    "sense_definition": "The curved, extra area along the aft edge (leech) or foot of a sail designed to increase surface area.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "nautical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sailmaker added a generous <w>roach</w> to the mainsail to improve light-air performance.",
                            "target_lang_translations": {
                                "ru": "Парусный мастер добавил к гроту широкий <w>серп</w>, чтобы улучшить его ход при слабом ветре."
