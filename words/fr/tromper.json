{
    "word_family": [
        "tromperie",
        "trompeur",
        "trompeuse",
        "détromper"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1f04bf9c-3fb1-39f3-9cb8-ed89e207e511",
                    "sense_definition": "Commettre une erreur, faire fausse route ou avoir un jugement erroné.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "erreur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Excusez-moi, je crois que je me <w>trompe</w> de numéro de téléphone."
                        },
                        {
                            "text": "Il a pris la mauvaise direction car il s'est <w>trompé</w> d'adresse hier soir."
                        }
                    ],
                    "synonyms": [
                        "faire une erreur"
                    ],
                    "common_phrases": [
                        "se tromper de numéro",
                        "se tromper d'adresse"
                    ]
                },
                {
                    "sense_id": "70cf6bc3-f98f-3621-b214-ee15eb1bb46c",
                    "sense_definition": "Induire volontairement quelqu'un en erreur par la ruse ou le mensonge.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "duperie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce voleur rusé a réussi à <w>tromper</w> la vigilance des gardiens du musée."
                        },
                        {
                            "text": "Cet escroc a cherché à <w>tromper</w> les clients avec de fausses promesses financières."
                        }
                    ],
                    "synonyms": [
                        "berner",
                        "leurrer",
                        "mystifier"
                    ],
                    "common_phrases": [
                        "tromper la vigilance",
                        "tromper son monde"
                    ]
                },
                {
                    "sense_id": "ed59a90f-77a1-3e39-8451-d6539e650038",
                    "sense_definition": "Être infidèle à son conjoint ou à son partenaire amoureux.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "infidelite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a décidé de le quitter après avoir découvert qu'il la <w>trompait</w>."
                        },
                        {
                            "text": "Il a avoué avoir <w>trompé</w> son partenaire pendant leurs dernières vacances à l'étranger."
                        }
                    ],
                    "common_phrases": [
                        "tromper son mari",
                        "tromper son partenaire"
                    ]
                },
                {
                    "sense_id": "1b2bb89f-91b1-3c86-ad47-c42fc94302c4",
                    "sense_definition": "Échapper temporairement à une sensation désagréable ou faire passer le temps à l'aide d'un dérivatif.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "attenuation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pendant ce long voyage en train, il lisait un roman pour <w>tromper</w> l'ennui."
                        },
                        {
                            "text": "Les enfants ont mangé une pomme afin de <w>tromper</w> leur faim avant le dîner."
                        }
                    ],
                    "common_phrases": [
                        "tromper la faim",
                        "tromper l'ennui"
                    ]
                }
            ]
        }
    ]
}