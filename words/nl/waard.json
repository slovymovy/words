                },
                {
                    "sense_id": "c6fe8a2a-b90b-3725-bfaa-f36c4aebb81f",
                    "sense_definition": "Geacht of dierbaar (vooral gebruikt in formele aanhef).",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Waarde</w> vrienden, wij zijn hier vandaag bijeen om feest te vieren.",
                            "target_lang_translations": {
                                "ru": "<w>Дорогие</w> друзья, мы собрались здесь сегодня, чтобы отпраздновать.",
                                "en": "<w>Dear</w> friends, we are gathered here today to celebrate.",
                                "it": "<w>Cari</w> amici, siamo qui riuniti oggi per festeggiare."
                            }
                        },
                        {
                            "text": "In de brief stond: \"<w>Waarde</w> heer Jansen, hierbij ontvangt u de documenten.\"",
                            "target_lang_translations": {
                                "ru": "В письме было написано: \"<w>Уважаемый</w> господин Янсен, настоящим вы получаете документы.\"",
                                "en": "The letter read: \"<w>Dear</w> Mr. Jansen, enclosed you will find the documents.\"",
                                "it": "Nella lettera c'era scritto: \"<w>Egregio</w> signor Jansen, con la presente riceve i documenti.\""
                            }
                        }
                    ],
                    "common_phrases": [
                        "waarde heer",
                        "waarde vriend"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "formeel of archaïsch taalgebruik"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Уважаемый или дорогой (используется преимущественно в официальных обращениях).",
                        "en": "Respected or dear (used primarily in formal addresses).",
                        "it": "Stimato o caro (usato principalmente in formule d'intestazione formali)."
