    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "559c3463-a583-3fde-8f35-447f6c340e6c",
                    "sense_definition": "Happening once every year.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "periodicity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company holds an <w>annual</w> meeting to discuss future plans.",
                            "target_lang_translations": {
                                "ru": "Компания проводит <w>ежегодное</w> собрание для обсуждения планов на будущее.",
                                "tr": "Şirket, gelecekteki planları tartışmak için <w>yıllık</w> bir toplantı düzenliyor."
                            }
                        },
                        {
                            "text": "We look forward to our <w>annual</w> family vacation in the summer.",
                            "target_lang_translations": {
                                "ru": "Мы с нетерпением ждем нашего <w>ежегодного</w> семейного отпуска летом.",
                                "tr": "Yazın yapacağımız <w>yıllık</w> aile tatilimizi dört gözle bekliyoruz."
                            }
                        }
                    ],
                    "synonyms": [
                        "yearly"
                    ],
                    "common_phrases": [
                        "annual event",
                        "annual meeting",
                        "annual conference",
                        "annual report"
                    ],
                    "target_lang_definitions": {
                        "ru": "Происходящий один раз в год.",
                        "tr": "Yılda bir kez gerçekleşen."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ежего́дный",
                                "target_lang_sense_clarification": "происходящий раз в год"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "yıllık",
                                "target_lang_sense_clarification": "yılda bir yapılan"
                            },
                            {
                                "target_lang_word": "senelik",
                                "target_lang_sense_clarification": "yılda bir gerçekleşen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f64ac41e-cced-3da2-8a9b-791b5429b96c",
                    "sense_definition": "Calculated over or covering a period of one year.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "periodicity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her <w>annual</w> income has increased significantly since she got the promotion.",
                            "target_lang_translations": {
                                "ru": "Её <w>годовой</w> доход значительно вырос после повышения.",
                                "tr": "Terfi aldığından beri <w>yıllık</w> geliri önemli ölçüde arttı."
                            }
                        },
                        {
                            "text": "The region receives an average <w>annual</w> rainfall of fifty inches.",
                            "target_lang_translations": {
                                "ru": "В этом регионе выпадает среднее <w>годовое</w> количество осадков в пятьдесят дюймов.",
                                "tr": "Bölge ortalama elli inç <w>yıllık</w> yağış almaktadır."
                            }
                        }
                    ],
                    "synonyms": [
                        "yearly"
                    ],
                    "common_phrases": [
                        "annual salary",
                        "annual income",
                        "annual rate",
                        "annual budget"
                    ],
                    "target_lang_definitions": {
                        "ru": "Рассчитанный за год или охватывающий период в один год.",
                        "tr": "Bir yıllık bir süre üzerinden hesaplanan veya bu süreyi kapsayan."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "годово́й",
                                "target_lang_sense_clarification": "относящийся к целому году"
                            },
                            {
                                "target_lang_word": "ежего́дный",
                                "target_lang_sense_clarification": "суммарный за год"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "yıllık",
                                "target_lang_sense_clarification": "bir yılı kapsayan veya bir yıl üzerinden hesaplanan"
                            },
                            {
                                "target_lang_word": "senelik",
                                "target_lang_sense_clarification": "bir yıllık süreye ait"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9f7728e3-cab0-3d96-844c-4623e0d9cf1a",
                    "sense_definition": "Living for only one growing season or year.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "biology_lifespan",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Corn is an <w>annual</w> crop that must be replanted every spring.",
                            "target_lang_translations": {
                                "ru": "Кукуруза — это <w>однолетняя</w> культура, которую нужно сажать заново каждую весну.",
                                "tr": "Mısır, her bahar yeniden ekilmesi gereken <w>tek yıllık</w> bir üründür."
                            }
                        },
                        {
                            "text": "These <w>annual</w> flowers will die once the winter frost arrives.",
                            "target_lang_translations": {
                                "ru": "Эти <w>однолетние</w> цветы погибнут с наступлением зимних заморозков.",
                                "tr": "Bu <w>tek yıllık</w> çiçekler kış donları geldiğinde ölecektir."
                            }
                        }
                    ],
                    "antonyms": [
                        "perennial"
                    ],
                    "common_phrases": [
                        "annual plant",
                        "annual flower"
                    ],
                    "target_lang_definitions": {
                        "ru": "Живущий только один вегетационный период или год.",
                        "tr": "Sadece bir büyüme mevsimi veya bir yıl yaşayan."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "одноле́тний",
                                "target_lang_sense_clarification": "о растениях"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "tek yıllık",
                                "target_lang_sense_clarification": "bitkiler için, ömrü bir yıl olan"
                            },
                            {
                                "target_lang_word": "bir yıllık",
                                "target_lang_sense_clarification": "tek bir büyüme mevsimi yaşayan"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "24a07bcf-1d00-3d7a-a20a-4d30249b13be",
                    "sense_definition": "A book or magazine that is published once a year.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I bought the latest <w>annual</w> of my favorite comic book series.",
                            "target_lang_translations": {
                                "ru": "Я купил свежий <w>ежегодник</w> моей любимой серии комиксов.",
                                "tr": "En sevdiğim çizgi roman serisinin son <w>yıllığını</w> satın aldım."
                            }
                        },
                        {
                            "text": "The society publishes an <w>annual</w> containing recent research papers.",
                            "target_lang_translations": {
                                "ru": "Общество выпускает <w>ежегодник</w>, содержащий последние научные статьи.",
                                "tr": "Dernek, son araştırma makalelerini içeren bir <w>yıllık</w> yayımlıyor."
                            }
                        }
