                "senses": [
                    {
                        "sense_id": "dccf359c-0708-34e9-9209-4a681a471d5d",
                        "entry_id": "13f89eac-642a-3382-a0fa-7c3cddb9632f",
                        "glosses": [
                            "de hoef van een paard"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fcc3b24c-65eb-4bac-8957-8a180ce695b9",
                                "sense_id": "dccf359c-0708-34e9-9209-4a681a471d5d",
                                "text": "De kolken onderweg herhaalden 't Geklikklak van de paardenvoet."
                            },
                            {
                                "example_id": "4896e69f-a8e7-4273-baef-9ba7bfb2fe6e",
                                "sense_id": "dccf359c-0708-34e9-9209-4a681a471d5d",
                                "text": "Hij hamert nog eens op het ijzer, en loopt een paar keer heen en weer. Ten slotte slaat hij nagels of spijkers door gaatjes in het ijzer heen schuin in de paardenvoet. „Sla je te ver naar buiten, dan gaat de hoef brokkelen. Sla je te ver naar binnen, dan begint het paard te steigeren en komt er bloed tevoorschijn.”"
                            }
                        ]
                    },
