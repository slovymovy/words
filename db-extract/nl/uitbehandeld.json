                        "examples": [
                            {
                                "example_id": "56eb5c0f-310c-4b81-8d8c-80c2a59da30c",
                                "sense_id": "07e4ef87-44fd-3bb9-9e4d-ec6242bf013e",
                                "text": "Uiteindelijk ontliep Van de Loo het vuurpeloton, omdat hij ontoerekeningsvatbaar werd verklaard. Hij kreeg enkele jaren gevangenisstraf met dwangverpleging en kwam in 1956 vrij nadat hij was uitbehandeld."
                            }
                        ]
                    },
                    {
                        "sense_id": "4b3b16ce-11bb-37c4-8295-17f541204a58",
                        "entry_id": "c4d9118f-dc11-3671-8569-b4d3dbc5ac4f",
                        "glosses": [
                            "van een patiënt dat verdere medische behandeling geen nut heeft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9575a544-aab9-494e-9d1d-35d8bd8b1a73",
                                "sense_id": "4b3b16ce-11bb-37c4-8295-17f541204a58",
                                "text": "In november kreeg De Wagt te horen dat hij was uitbehandeld. Hij bezocht die maand nog wel de thuiswedstrijd van Heerenveen tegen Vitesse. De spelers kwamen samen met zijn twee kinderen het veld op in shirts met daarop de tekst 'Let's do it, Chris'. Ook zijn oude club Cambuur steunde hem door op de foto te gaan met een groot spandoek waar 'Sterkte Chris' op stond."
                            }
                        ]
