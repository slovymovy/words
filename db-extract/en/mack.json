                ],
                "translations": [
                    {
                        "translation_id": "2f215468-faeb-4d15-91aa-8b879c795821",
                        "source_entry_id": "ee6f3d91-4529-3047-b796-b2ed8a26ad49",
                        "source_sense_id": "7d3b51e5-33cc-3554-8e36-d3276081b7fd",
