                                        "glosses": [
                                            "Made of gold or covered by a thin layer of gold."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2ce4c605-f1e4-3ca0-9717-70fec358103f",
                                        "entry_id": "45e4e9a2-1442-3766-a943-e937280981c4",
                                        "glosses": [
                                            "Having a falsely pleasant appearance; sugarcoated."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a286e64f-b073-4a8c-bcd2-c347ad89576a",
                                                "sense_id": "2ce4c605-f1e4-3ca0-9717-70fec358103f",
                                                "text": "All that glisters is not gold;\nOften have you heard that told:\nMany a man his life hath sold\nBut my outside to behold:\nGilded tombs do worms infold.\nHad you been as wise as bold,\nYoung in limbs, in judgement old,\nYour answer had not been inscroll'd:\nFare you well; your suit is cold."
                                            }
                                        ]
                                    }
