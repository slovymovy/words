                    {
                        "translation_id": "5dc840ee-97ab-461c-8ff2-4c0a70f0c8e9",
                        "source_entry_id": "ec949ed0-7a60-35fd-ae76-dc099d4e7554",
                        "source_sense_id": "69d4bc60-c1e3-3cda-8660-0ab8b7edc3b3",
                        "source_sense_description": "herstelde toestand",
                        "target_lang_word": "progress",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "progress",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "13121f66-dd1b-3593-8d1e-7012ea1af5a8",
                                        "entry_id": "1c42412e-c78d-3d22-a90b-0d5affdd5cef",
                                        "glosses": [
                                            "Movement or advancement through a series of events, or points in time; development through time."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1773c84a-74a8-417d-a295-1acce20f27cd",
                                                "sense_id": "13121f66-dd1b-3593-8d1e-7012ea1af5a8",
                                                "text": "Testing for the new antidote is currently in progress."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c26ab3d-8b86-3881-986d-523f7457f4dc",
                                        "entry_id": "1c42412e-c78d-3d22-a90b-0d5affdd5cef",
                                        "glosses": [
                                            "Specifically, advancement to a higher or more developed state; development, growth."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "78608f63-1e5a-48dc-a941-67bb9cfb1cbf",
                                                "sense_id": "7c26ab3d-8b86-3881-986d-523f7457f4dc",
                                                "text": "Science has made extraordinary progress in the last fifty years."
                                            },
                                            {
                                                "example_id": "29d8253e-6fe8-4767-ae30-fff2f8386491",
                                                "sense_id": "7c26ab3d-8b86-3881-986d-523f7457f4dc",
                                                "text": "You wish for progress? The Ascians have it. They are deafened by it, crazed by the death of Nature till they are ready to accept Erebus and the rest as gods."
                                            },
                                            {
                                                "example_id": "89b596d1-e8e9-41d7-9431-66972d26f672",
                                                "sense_id": "7c26ab3d-8b86-3881-986d-523f7457f4dc",
                                                "text": "Becoming more aware of the progress that scientists have made on behavioral fronts can reduce the risk that other natural scientists will resort to mystical agential accounts when they exceed the limits of their own disciplinary training."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a5741388-74bb-3860-b59a-80019162d5cc",
                                        "entry_id": "1c42412e-c78d-3d22-a90b-0d5affdd5cef",
                                        "glosses": [
                                            "An official journey made by a monarch or other high personage; a state journey, a circuit."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ef442fb4-f246-4d08-a57c-a7cfc877e0e0",
                                                "sense_id": "a5741388-74bb-3860-b59a-80019162d5cc",
                                                "text": "... Queen Elizabeth in one of her progresses, stopping at Crawley to breakfast, was so delighted with some remarkably fine Hampshire beer which was then presented to her by the Crawley of the day (a handsome gentleman with a trim beard and a good leg), that she forthwith erected Crawley into a borough to send two members to Parliament ..."
                                            },
                                            {
                                                "example_id": "2c255e18-8faa-4882-98ae-b02932a7b460",
                                                "sense_id": "a5741388-74bb-3860-b59a-80019162d5cc",
                                                "text": "With the king about to go on progress, the trials and executions were deliberately timed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "81de91fe-088a-34ae-8e29-fe0b345f27a5",
                                        "entry_id": "1c42412e-c78d-3d22-a90b-0d5affdd5cef",
                                        "glosses": [
                                            "A journey forward; travel."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee567c01-c29b-4123-a9a1-3cd5717ca5ce",
                                                "sense_id": "81de91fe-088a-34ae-8e29-fe0b345f27a5",
                                                "text": "Now Tim began to be struck with these loitering progresses along the garden boundaries in the gloaming, and wondered what they boded."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5fbc9126-13d6-326e-bdec-244aa30ec692",
                                        "entry_id": "1c42412e-c78d-3d22-a90b-0d5affdd5cef",
                                        "glosses": [
                                            "Movement onwards, forwards, or towards a specific objective or direction; advance."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df84ea9d-5b0d-4755-a9e8-af87e6541fab",
                                                "sense_id": "5fbc9126-13d6-326e-bdec-244aa30ec692",
                                                "text": "The thick branches overhanging the path made progress difficult."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "progress",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dc933f01-db3e-3588-8f1e-83248b9eb555",
                                        "entry_id": "3366fd4e-703c-3c1d-8859-2672107809e5",
                                        "glosses": [
                                            "To move, go, or proceed forward; to advance."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d99ebab-34a3-4d11-8bdd-ecc4f29c7577",
                                                "sense_id": "dc933f01-db3e-3588-8f1e-83248b9eb555",
                                                "text": "Visitors progress through the museum at their own pace."
                                            },
                                            {
                                                "example_id": "636bbeda-c05e-4e33-8cef-04549bdf7bf9",
                                                "sense_id": "dc933f01-db3e-3588-8f1e-83248b9eb555",
                                                "text": "Scotland needed a victory by eight points to have a realistic chance of progressing to the knock-out stages, and for long periods of a ferocious contest looked as if they might pull it off."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bb04839d-ca44-3b77-9c0e-33df965287af",
                                        "entry_id": "3366fd4e-703c-3c1d-8859-2672107809e5",
                                        "glosses": [
                                            "To develop."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1484f753-452d-45db-8f63-cc17026da5f5",
                                                "sense_id": "bb04839d-ca44-3b77-9c0e-33df965287af",
                                                "text": "Societies progress unevenly."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "28d9bb4d-7450-3772-afb7-89bab8340b4a",
                                        "entry_id": "3366fd4e-703c-3c1d-8859-2672107809e5",
                                        "glosses": [
                                            "To develop.",
                                            "To improve; to become better or more complete."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1b82f2e5-c73f-3f46-aebb-bcd73a7a5449",
                                        "entry_id": "3366fd4e-703c-3c1d-8859-2672107809e5",
                                        "glosses": [
                                            "To expedite."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb2e9514-3e11-424f-9634-2464c29bda3b",
                                                "sense_id": "1b82f2e5-c73f-3f46-aebb-bcd73a7a5449",
                                                "text": "Or […] they came to progress matters in which Dudley had taken a hand, and left defrauded or bound over to the king."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
