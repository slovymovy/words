                    }
                ],
                "senses": [
                    {
                        "sense_id": "dc41d9d1-e549-3fe5-8cc2-e61714ffcd92",
                        "entry_id": "b6aa8be6-2814-3788-9407-4219098c76f8",
                        "glosses": [
                            "Adorateur des images (sculptures ou peintures) religieuses, considérées comme réceptacle de la déité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6592bcf5-ccee-4516-aa46-26aa93afc496",
                                "sense_id": "dc41d9d1-e549-3fe5-8cc2-e61714ffcd92",
                                "text": "Au contraire, l’iconophile, qui, répétons-le, ne sera jamais un iconolâtre, veut développer une pensée non locale et non sacramentelle du sacré, une pensée qui le rendrait ouvert au monde profane, qui lui promettrait un déploiement contaminateur par-delà les enceintes, les frontières et la hiérarchie étatique."
                            },
                            {
                                "example_id": "059fc785-1132-4f6d-8de5-c50ee5ec5fca",
                                "sense_id": "dc41d9d1-e549-3fe5-8cc2-e61714ffcd92",
                                "text": "Vers cette époque, il y eut dans tout l’Orient persécution des Iconolâtres et destruction des images."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c5e11838-37f4-4a5b-ae2c-7e8d2d00f205",
