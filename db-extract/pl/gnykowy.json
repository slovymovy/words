                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f29a513f-77e2-4e59-ab01-e7ffdbd1cbf8",
                                "sense_id": "f31eb1f7-2990-31e5-83f0-0079d9572f2c",
                                "text": "Ogólną budową aparat gnykowy dzięciołów nie różni się jednak od aparatu gnykowego występującego u ptaków mających krótsze języki"
