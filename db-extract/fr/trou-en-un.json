                                        "examples": [
                                            {
                                                "example_id": "e667f9c9-92e8-424b-82c2-2cb2b4b78fae",
                                                "sense_id": "a59fef9e-a3c5-344f-922f-50f82bf3a7a7",
                                                "text": "\"Most of the aces weren't on holes I would have liked to have made them on,\" confessed Colk, who dropped his fifth dodo of 1935 on December 29, which was believed at the time to be a record for most aces in a year."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "40080237-5fa4-3d98-9d02-133a792dd742",
                                        "entry_id": "9733c8ec-8bb7-3cc0-a360-b42f53a726b1",
                                        "glosses": [
                                            "An expert at something; a maverick, genius; a person of supreme talent."
                                        ],
                                        "tags": [
                                            "attributive",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "30ca8be6-e9eb-45e5-a3b2-ab16fa876e71",
                                                "sense_id": "40080237-5fa4-3d98-9d02-133a792dd742",
                                                "text": "an ace detective"
                                            },
                                            {
                                                "example_id": "215b0fcd-74ae-4e43-8928-9ec9fccd5106",
                                                "sense_id": "40080237-5fa4-3d98-9d02-133a792dd742",
                                                "text": "‘Weston, the ace of theatrical agents.’"
                                            },
                                            {
                                                "example_id": "d19e1c1a-208e-4be0-8a51-0ddfae5a0e86",
                                                "sense_id": "40080237-5fa4-3d98-9d02-133a792dd742",
                                                "text": "Mexican ace Dos Santos smashed home the third five minutes later after good work from Defoe."
                                            }
