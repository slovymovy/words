                ],
                "senses": [
                    {
                        "sense_id": "2c911782-0638-368a-b45a-2526b8974a23",
                        "entry_id": "e9410de2-66bb-3755-a971-f8068d7243d0",
                        "glosses": [
                            "Détraquer, déranger."
                        ],
                        "tags": [
                            "Lyonnais"
                        ],
                        "examples": [
                            {
                                "example_id": "b22ac927-e865-4c95-813f-3142b0dcac72",
                                "sense_id": "2c911782-0638-368a-b45a-2526b8974a23",
                                "text": "Des fois y avait des bécanes si détrancannées que tout y allait d’une fesse, mais souvent et maintes fois y en avait pas."
                            },
                            {
                                "example_id": "d0c49762-a366-4109-9575-17d37e47bb6b",
                                "sense_id": "2c911782-0638-368a-b45a-2526b8974a23",
                                "text": "Remarque, on perd pas grand chose vu qu’elle est détrancannée la moitié du temps."
                            },
                            {
                                "example_id": "3cfbe1ae-bba6-4fbc-b499-3924bac86d03",
                                "sense_id": "2c911782-0638-368a-b45a-2526b8974a23",
                                "text": "Et nous deux, enragés, on « pan ! pan ! pan ! » à nous détrancanner les biceps, triceps, forceps et colonne vertébreuse."
                            }
                        ]
                    },
                    {
                        "sense_id": "9c2ee120-0bb9-3d46-a62f-b2bf4767f2db",
                        "entry_id": "e9410de2-66bb-3755-a971-f8068d7243d0",
                        "glosses": [
                            "Perdre la tête."
                        ],
