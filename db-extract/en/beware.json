                                                "sense_id": "fd464243-9e33-3edc-b05f-bee914afef53",
                                                "text": "Attention, la route est verglacée."
                                            },
                                            {
                                                "example_id": "134dff1c-2b59-46b1-b9ed-4fda37754f06",
                                                "sense_id": "fd464243-9e33-3edc-b05f-bee914afef53",
                                                "text": "Attention au commandement."
                                            },
