                            },
                            {
                                "target_word": "zigzag",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5602306d-d7f9-36b2-9b14-32d82cb85ea8",
                                        "entry_id": "61628f32-e480-346c-aa3c-2e89e5d6b0ec",
                                        "glosses": [
                                            "To move or to twist in a zigzag manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "014952ec-eb9e-4d96-a285-57e0c56333ce",
                                                "sense_id": "5602306d-d7f9-36b2-9b14-32d82cb85ea8",
                                                "text": "[…] she saw them as we see the throngs which cover the canvases of Sallaert, Van Alsloot, and others of that school—vast masses of beings, jostling, zigzagging, and processioning in definite directions, but whose features are indistinguishable by the very comprehensiveness of the view."
                                            },
                                            {
                                                "example_id": "e4f6a9b0-884f-4239-8550-8ecb47f205cb",
                                                "sense_id": "5602306d-d7f9-36b2-9b14-32d82cb85ea8",
                                                "text": "At the base this vent was dark, cool, and smelled of dry, musty dust. It zigzagged so that he could not see ahead more than a few yards at a time."
                                            },
                                            {
                                                "example_id": "f050f705-24e6-402d-9048-e9853f00bbf7",
                                                "sense_id": "5602306d-d7f9-36b2-9b14-32d82cb85ea8",
                                                "text": "If the first two novels created a new genre — Peakean fantasy — then this third volume zigzags between several: the Bildungsroman, science fiction, social satire, morality tale and dystopian prophecy."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "zigzag",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9a293bfa-e261-3113-94f3-e69e50d084e5",
                                        "entry_id": "28d093f9-e9fb-3125-8214-74807ae4e6b6",
                                        "glosses": [
                                            "in a zigzag manner or pattern"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8ad10458-7d23-45f0-b15f-8f8f627528a4",
                        "source_entry_id": "3966fb90-f0be-3aa3-86cb-d7df31fc5e0d",
                        "source_sense_id": "9c38217d-7c02-3280-91c3-d389b747fc55",
                        "source_sense_description": "mehrfache Richtungsänderung in spitzem Winkel",
                        "target_lang_word": "zigzag",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zigzag",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d6318041-8d5c-3f42-b198-72bf6a52418b",
                                        "entry_id": "a02c08cb-5f56-3140-a274-a5774230818e",
                                        "glosses": [
                                            "Ligne brisée formant des angles alternativement saillants et rentrants."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dcf3fba8-0b90-32cc-926f-d3033719b123",
                                        "entry_id": "a02c08cb-5f56-3140-a274-a5774230818e",
                                        "glosses": [
                                            "Trajet ou tracé comportant de brusques ou fréquents changements de direction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "460bcb23-6049-4091-9930-5b44462b4349",
                                                "sense_id": "dcf3fba8-0b90-32cc-926f-d3033719b123",
                                                "text": "— Je ferai même des zigzags, et je parcourrai toutes les lignes possibles en géométrie, si le besoin l’exige."
                                            },
                                            {
                                                "example_id": "7341b9da-e420-40f0-a373-b68c3ff889e9",
                                                "sense_id": "dcf3fba8-0b90-32cc-926f-d3033719b123",
                                                "text": "Il s’était posté dans le repli que faisait un zigzag de la rue."
                                            },
                                            {
                                                "example_id": "1bd8a8b8-7098-4bb7-8a12-526e7afeede7",
                                                "sense_id": "dcf3fba8-0b90-32cc-926f-d3033719b123",
                                                "text": "Je pris la pancarte et je vis un tas de barbouillages en zigzag, qui me troublaient la vue."
                                            },
                                            {
                                                "example_id": "423d978f-9e8b-474e-8b8a-8390dd3d2121",
                                                "sense_id": "dcf3fba8-0b90-32cc-926f-d3033719b123",
                                                "text": "Chaque fois qu’il voulait atteindre un objet, sa main décrivait un crochet rapide, une sorte de zigzag affolé, avant de parvenir à toucher ce qu’elle cherchait."
                                            },
                                            {
                                                "example_id": "812b7764-3d1d-4fd1-96d4-3c870764d275",
                                                "sense_id": "dcf3fba8-0b90-32cc-926f-d3033719b123",
                                                "text": "Cela lui rappela un joujou fait avec d’étroites planchettes de bois clouées en zigzag les unes sur les autres, qui, par un mouvement semblable, conduisaient l’exercice de petits soldats piqués dessus."
                                            },
                                            {
                                                "example_id": "a6a9661c-bb39-4f8e-87b6-a9440a2460f9",
                                                "sense_id": "dcf3fba8-0b90-32cc-926f-d3033719b123",
                                                "text": "Avec son teint terreux et plissé, son dos en zigzag, ses jambes torses, ses os spongieux et mous, cet enfant semble avoir soixante-dix ans."
                                            },
                                            {
                                                "example_id": "56118a03-5769-4790-a9ea-1555b56c3f64",
                                                "sense_id": "dcf3fba8-0b90-32cc-926f-d3033719b123",
                                                "text": "Ainsi que des ciseaux fantasques, les éclairs en zigzag tailladaient la rue."
                                            },
                                            {
                                                "example_id": "97c4a416-bda3-4b93-bba8-8d07f4bce966",
                                                "sense_id": "dcf3fba8-0b90-32cc-926f-d3033719b123",
                                                "text": "Je suivis une route en zigzags qui devaient me faire éviter tous les dangers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "712e8ef5-7a97-31a2-af66-1957d12735d5",
                                        "entry_id": "a02c08cb-5f56-3140-a274-a5774230818e",
                                        "glosses": [
                                            "Changements fréquents de direction, d’opinion."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "729c009c-ee64-40f2-bddf-bda8dbd05e6d",
                                                "sense_id": "712e8ef5-7a97-31a2-af66-1957d12735d5",
                                                "text": "Cet élu fait bien souvent des zigzags."
                                            },
                                            {
                                                "example_id": "db4d8e08-f7a8-46a5-915a-5480a2ac504e",
                                                "sense_id": "712e8ef5-7a97-31a2-af66-1957d12735d5",
                                                "text": "Pendant que sa mère était là, elle l’avait souvent empêché de travailler, sans le savoir, avec sa nature d’oiseau étourdi, ses envolements, et cette volonté en zigzag qui la faisait tout à coup s’apprêter pour sortir, puis se débarrasser de son chapeau et de son châle dans une soudaine décision de rester."
                                            },
                                            {
                                                "example_id": "c284fb99-6b61-4af8-b7f5-a4a089f476a8",
                                                "sense_id": "712e8ef5-7a97-31a2-af66-1957d12735d5",
                                                "text": "Le jeune homme dont je tente de retracer les zigzags et les faux pas, est-il bien moi ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "313c001a-a0e4-31af-bd8c-e04d8b96840e",
                                        "entry_id": "a02c08cb-5f56-3140-a274-a5774230818e",
                                        "glosses": [
                                            "Autre nom du bombyx disparate (papillon)."
                                        ],
                                        "tags": [
                                            "Lépidoptérologie"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
