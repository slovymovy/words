    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ea902826-d97a-3659-af22-db4d1aa7aac1",
                    "sense_definition": "Naître une seconde fois ou revenir à la vie après la mort ou une épreuve.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le phénix mythique est un oiseau capable de <w>renaître</w> de ses cendres.",
                            "target_lang_translations": {
                                "en": "The mythical phoenix is a bird capable of being <w>reborn</w> from its ashes.",
                                "ru": "Мифический феникс — птица, способная <w>возрождаться</w> из пепла.",
                                "de": "Der mythische Phönix ist ein Vogel, der aus seiner Asche <w>auferstehen</w> kann.",
                                "es": "El fénix mítico es un ave capaz de <w>renacer</w> de sus cenizas.",
                                "zh": "神话中的凤凰是一种能从灰烬中<w>重生</w>的鸟。"
                            }
                        },
                        {
                            "text": "Après cette longue période de convalescence, elle a enfin le sentiment de <w>renaître</w>.",
                            "target_lang_translations": {
                                "en": "After this long period of convalescence, she finally feels <w>reborn</w>.",
                                "ru": "После долгого периода выздоровления она наконец почувствовала, что <w>возрождается</w>.",
                                "de": "Nach dieser langen Zeit der Genesung hat sie endlich das Gefühl, <w>wiedergeboren</w> zu sein.",
                                "es": "Tras esta larga convalecencia, por fin siente que <w>renace</w>.",
                                "zh": "经过这段漫长的康复期，她终于感到自己<w>重生</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ressusciter"
                    ],
                    "antonyms": [
                        "mourir",
                        "périr"
                    ],
                    "common_phrases": [
                        "renaître de ses cendres",
                        "renaître à la vie"
                    ],
                    "target_lang_definitions": {
                        "en": "To come back to life or be reborn after death or a hardship.",
                        "ru": "Вновь обрести жизнь после смерти или тяжёлого испытания.",
                        "de": "Nach dem Tod oder einer schweren Prüfung wieder ins Leben zurückkehren.",
                        "es": "Volver a nacer o recobrar la vida tras la muerte o una prueba difícil.",
                        "zh": "再次获得生命，或在死亡或磨难之后重新恢复生机。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "revive",
                                "target_lang_sense_clarification": "coming back to life"
                            },
                            {
                                "target_lang_word": "be reborn",
                                "target_lang_sense_clarification": "after illness or near-death"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "возрождаться",
                                "target_lang_sense_clarification": "после упадка или кризиса"
                            },
                            {
                                "target_lang_word": "воскресать",
                                "target_lang_sense_clarification": "в религиозном или мифологическом смысле"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "auferstehen",
                                "target_lang_sense_clarification": "religiös oder mythologisch"
                            },
                            {
                                "target_lang_word": "wiedergeboren werden",
                                "target_lang_sense_clarification": "neues Leben nach einer Krise"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "renacer",
                                "target_lang_sense_clarification": "tras una crisis o pérdida"
                            },
                            {
                                "target_lang_word": "revivir",
                                "target_lang_sense_clarification": "recuperar la vida o el ánimo"
                            },
                            {
                                "target_lang_word": "resucitar",
                                "target_lang_sense_clarification": "volver de entre los muertos"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "重生",
                                "target_lang_sense_clarification": "经历磨难后的新生"
                            },
                            {
                                "target_lang_word": "复活",
                                "target_lang_sense_clarification": "宗教或神话语境"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "598ff1a3-12e5-3588-94da-8671153f287c",
                    "sense_definition": "Recommencer à pousser, en parlant de la végétation ou de la flore.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "nature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dès l'arrivée du printemps, toute la forêt commence à <w>renaître</w>.",
                            "target_lang_translations": {
                                "en": "As soon as spring arrives, the whole forest begins to <w>regrow</w>.",
                                "ru": "С приходом весны весь лес начинает <w>отрастать</w>.",
                                "de": "Sobald der Frühling kommt, beginnt der ganze Wald <w>nachzuwachsen</w>.",
                                "es": "En cuanto llega la primavera, todo el bosque empieza a <w>rebrotar</w>.",
                                "zh": "一到春天，整片森林就开始<w>返青</w>。"
                            }
                        },
                        {
                            "text": "Les fleurs coupées par l'hiver rigoureux finissent toujours par <w>renaître</w>.",
                            "target_lang_translations": {
                                "en": "Flowers cut down by the harsh winter always eventually <w>regrow</w>.",
                                "ru": "Цветы, побитые суровой зимой, в конце концов всегда вновь <w>прорастают</w>.",
                                "de": "Vom strengen Winter abgeschnittene Blumen <w>wachsen</w> am Ende immer wieder <w>nach</w>.",
                                "es": "Las flores cortadas por el crudo invierno siempre acaban por <w>rebrotar</w>.",
                                "zh": "被严冬折断的花，最终总会再次<w>萌发</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "repousser"
                    ],
                    "antonyms": [
                        "dépérir",
                        "sécher"
                    ],
                    "target_lang_definitions": {
                        "en": "To start growing again, said of plants and vegetation.",
                        "ru": "Снова начать расти и развиваться — о растениях и растительном покрове.",
                        "de": "Von Pflanzen und Vegetation gesagt: wieder zu wachsen beginnen.",
                        "es": "Volver a brotar o a crecer, referido a plantas y vegetación.",
                        "zh": "植物或植被重新开始生长、发芽。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "regrow",
                                "target_lang_sense_clarification": "plants returning after winter"
                            },
                            {
                                "target_lang_word": "sprout again",
                                "target_lang_sense_clarification": "new shoots in spring"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "отрастать",
                                "target_lang_sense_clarification": "побеги и листья после зимы"
                            },
                            {
                                "target_lang_word": "прорастать",
                                "target_lang_sense_clarification": "новые ростки из корней"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "nachwachsen",
                                "target_lang_sense_clarification": "Pflanzen nach Schnitt oder Winter"
                            },
                            {
                                "target_lang_word": "neu austreiben",
                                "target_lang_sense_clarification": "Blätter und Triebe im Frühling"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "rebrotar",
                                "target_lang_sense_clarification": "plantas tras el invierno"
                            },
                            {
                                "target_lang_word": "retoñar",
                                "target_lang_sense_clarification": "nuevos brotes en primavera"
                            },
                            {
                                "target_lang_word": "reverdecer",
                                "target_lang_sense_clarification": "campos y bosques en primavera"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "返青",
                                "target_lang_sense_clarification": "春天草木重新变绿"
                            },
                            {
                                "target_lang_word": "再生",
                                "target_lang_sense_clarification": "植物断茬后重新长出"
                            },
                            {
                                "target_lang_word": "萌发",
                                "target_lang_sense_clarification": "新芽或种子萌动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5d7cd3f4-dcd9-329c-8250-e4a1950025e6",
                    "sense_definition": "Se ranimer, reparaître dans l'esprit ou dans un groupe, en parlant d'un sentiment, d'une idée ou d'une activité.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "esprit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette bonne nouvelle a aussitôt fait <w>renaître</w> l'espoir parmi les ouvriers.",
                            "target_lang_translations": {
                                "en": "This good news instantly <w>revived</w> hope among the workers.",
                                "ru": "Эта добрая весть тотчас <w>возродила</w> надежду среди рабочих.",
                                "de": "Diese gute Nachricht ließ unter den Arbeitern sofort die Hoffnung <w>wiederaufleben</w>.",
                                "es": "Esta buena noticia <w>revivió</w> de inmediato la esperanza entre los obreros.",
                                "zh": "这个好消息立刻让工人们心中的希望<w>重燃</w>了。"
                            }
                        },
                        {
                            "text": "Leur brève rencontre a permis de faire <w>renaître</w> une amitié oubliée.",
                            "target_lang_translations": {
                                "en": "Their brief meeting made it possible to <w>rekindle</w> a forgotten friendship.",
                                "ru": "Их короткая встреча позволила <w>возродить</w> забытую дружбу.",
                                "de": "Ihr kurzes Treffen machte es möglich, eine vergessene Freundschaft <w>wiederaufleben</w> zu lassen.",
                                "es": "Su breve encuentro permitió <w>reavivar</w> una amistad olvidada.",
                                "zh": "他们的短暂相遇让一段早已被遗忘的友谊<w>复苏</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "revivre",
                        "resurgir"
                    ],
                    "antonyms": [
                        "s'éteindre",
                        "disparaître"
                    ],
                    "common_phrases": [
                        "faire renaître l'espoir",
                        "faire renaître la flamme"
                    ],
                    "target_lang_definitions": {
                        "en": "To be revived or reappear in the mind or in a group, said of a feeling, an idea or an activity.",
                        "ru": "Снова ожить и появиться в сознании или в группе — о чувствах, идеях или деятельности.",
                        "de": "Von Gefühlen, Ideen oder Tätigkeiten gesagt: im Bewusstsein oder in einer Gruppe wieder lebendig werden.",
                        "es": "Volver a cobrar fuerza en la mente o en un grupo, referido a sentimientos, ideas o actividades.",
                        "zh": "感情、想法或活动在人的意识或群体中重新出现，再度兴起。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "revive",
                                "target_lang_sense_clarification": "hope, feelings or ideas"
                            },
                            {
                                "target_lang_word": "rekindle",
                                "target_lang_sense_clarification": "feelings, flames or friendships"
                            },
                            {
                                "target_lang_word": "reawaken",
                                "target_lang_sense_clarification": "memories, interest or emotions"
                            }
                        ],
                        "ru": [
