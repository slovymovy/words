                    }
                ],
                "senses": [
                    {
                        "sense_id": "9d55ead0-7619-3a72-b135-6accbea9b741",
                        "entry_id": "14ba2dca-5af5-3ab4-826b-1b0322f15195",
                        "glosses": [
                            "Hallucination visuelle mettant en scène des animaux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe394847-ffe3-484d-ab77-65a0b378cb3d",
                                "sense_id": "9d55ead0-7619-3a72-b135-6accbea9b741",
                                "text": "La zoopsie, que l'on voit fréquemment chez les hystériques, peut faire penser à l’alcoolisme ; mais ici, ces hallucinations ont un caractère bien particulier ; les animaux n’apparaissent que du côté anesthésié, courant toujours dans le même sens."
                            },
                            {
                                "example_id": "e426d8bf-9d60-46a5-8698-cd750285c902",
                                "sense_id": "9d55ead0-7619-3a72-b135-6accbea9b741",
                                "text": "… la malade a de la zoopsie, elle voit des animaux, des perroquets, et principalement des singes, toujours du même côté, à gauche."
                            },
                            {
                                "example_id": "0a402e01-2ce0-4419-889d-a909b8d24ffc",
                                "sense_id": "9d55ead0-7619-3a72-b135-6accbea9b741",
                                "text": "Au réveil, il était souvent lourdaud à cause de ses nuits encombrées de visions d’animaux, ce que les médecins d’asile appellent la zoopsie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0fdea417-945e-4830-a435-c4db87c5ecc4",
                        "source_entry_id": "14ba2dca-5af5-3ab4-826b-1b0322f15195",
                        "source_sense_id": "9d55ead0-7619-3a72-b135-6accbea9b741",
                        "target_lang_word": "zoopsia",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zoopsia",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b972e49c-2de1-32f0-81de-57e2359d470f",
                                        "entry_id": "62b22c3c-191d-37fa-a134-140f1639e35d",
                                        "glosses": [
                                            "The visual hallucinations of animals."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2dc944e1-1ccd-40f6-a019-43b83135f838",
                                                "sense_id": "b972e49c-2de1-32f0-81de-57e2359d470f",
                                                "text": "One of her most persistent hallucinations was a small brightly patterned snake moving across the floor in the periphery of her vision. Her zoöpsia was accompanied by a terror of real animals."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
