                ],
                "senses": [
                    {
                        "sense_id": "c5d96aa1-c8af-3092-a5fd-0cc3a15661df",
                        "entry_id": "c384973b-039b-375e-9495-c77991e6916c",
                        "glosses": [
                            "eine gewisse Anzahl von Sitzgelegenheiten, die nebeneinander angeordnet sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc931b67-8b97-49db-92e9-b864e2a42837",
                                "sense_id": "c5d96aa1-c8af-3092-a5fd-0cc3a15661df",
                                "text": "„Die Sitzreihen verliefen rund um die große Bühne (auch hinter der Bühne gab es Sitzreihen), und sie stiegen dann von der Bühne aus ganz unregelmäßig wie Strahlen nach oben hin zu den dunklen Wänden.“"
                            },
                            {
                                "example_id": "155f27e2-0fa9-4338-880c-568208eb04d8",
                                "sense_id": "c5d96aa1-c8af-3092-a5fd-0cc3a15661df",
                                "text": "Auf Wunsch ist er [der Van] auch mit sieben Sitzen erhältlich. […] Mit wenigen Handgriffen lassen sich die äußeren Sitze der zweiten Sitzreihe kindgerecht umbauen, sodass für Kleinkinder kein separater Sitz notwendig ist."
                            },
                            {
                                "example_id": "2cacf78f-b98d-4359-bc23-b351097e11d5",
                                "sense_id": "c5d96aa1-c8af-3092-a5fd-0cc3a15661df",
                                "text": "„Es war fürchterlich eng in den Sitzreihen, und sie mussten sich beim Essen abwechseln, während sie die Sandwiches mit Garnelen und sonstigem Belag aus der Plastikfolie schälten.“"
                            },
                            {
                                "example_id": "37d03316-2ca6-485d-a35a-81c0dc144876",
                                "sense_id": "c5d96aa1-c8af-3092-a5fd-0cc3a15661df",
                                "text": "„Zielstrebig arbeitet sich der Mann durch die Sitzreihen in meine Nähe.“"
                            },
                            {
                                "example_id": "7da05cbc-a586-42a4-8c9d-6ea20c635abd",
                                "sense_id": "c5d96aa1-c8af-3092-a5fd-0cc3a15661df",
                                "text": "„»Sie waren unfähig, den Ausbau der erneuerbaren Energien herbeizuführen. Sie haben Abwehrkämpfe geführt gegen jede einzelne Windkraftanlage«, sagt Scholz und zeigt dabei auf die Sitzreihen von CDU und CSU.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cec1ed7f-98fb-4b64-8a7b-e2ef598c5ca9",
                        "source_entry_id": "c384973b-039b-375e-9495-c77991e6916c",
                        "source_sense_id": "c5d96aa1-c8af-3092-a5fd-0cc3a15661df",
