                                                "sense_id": "0728b571-c97c-3895-aeb9-9b997d62d548",
                                                "text": "Die Beute wird meistens von den Löwinnen erlegt."
                                            },
                                            {
                                                "example_id": "eff94353-1b89-417e-8230-4afdd361242f",
                                                "sense_id": "0728b571-c97c-3895-aeb9-9b997d62d548",
                                                "text": "„Im Wiener Tiergarten Schönbrunn setzt man bei den Löwen auf dauerhafte Geburtenkontrolle. Dies teilte Zoodirektorin Dagmar Schratter am Montag auf APA-Nachfrage mit: Die drei Löwinnen seien kastriert, den letzten Nachwuchs habe es 2008 gegeben.“"
                                            },
                                            {
                                                "example_id": "1c56fae9-811f-4691-bd18-7667931c7a70",
                                                "sense_id": "0728b571-c97c-3895-aeb9-9b997d62d548",
                                                "text": "„Der Zoo ließ nach eigenen Angaben nichts unversucht, um die Löwin dennoch an die neuen Babys zu gewöhnen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
