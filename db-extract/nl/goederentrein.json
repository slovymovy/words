                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "freight train",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6cbedba5-45f1-3207-80f3-60ec901346c1",
                                        "entry_id": "daefbbb5-30c8-3577-ae15-431b2be54b02",
                                        "glosses": [
                                            "A railway train used for the transportation of freight (goods)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "43056565-eb25-38b7-8ef8-10afd3293cad",
                                        "entry_id": "daefbbb5-30c8-3577-ae15-431b2be54b02",
                                        "glosses": [
                                            "A large, unstoppable force; a juggernaut."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "73ba98ce-53db-467f-b95c-1c5ee46a7059",
                                                "sense_id": "43056565-eb25-38b7-8ef8-10afd3293cad",
                                                "text": "Williams was known as an unstoppable freight train of a guy, a man who was unfazed by pain and unafraid of getting hurt."
                                            },
                                            {
                                                "example_id": "cdec524d-851e-4f3e-8dc0-4b3188bfd9c7",
                                                "sense_id": "43056565-eb25-38b7-8ef8-10afd3293cad",
                                                "text": "My estimable love and gratitude go out to my family for their continued support and patience in standing by me over the past months while I literally withdrew from life to 'grab a tail feather' and fly with this runaway freight-train of a project."
                                            },
                                            {
                                                "example_id": "941e0f42-6519-4541-917f-6dd3ad11cc1d",
                                                "sense_id": "43056565-eb25-38b7-8ef8-10afd3293cad",
                                                "text": "BenYeshu's theory was that 'these experiments will supply the necessary data as to when and why the freight train of civilization leapt the rails'."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d1e69925-d715-4889-bde7-26ae6467cadd",
                        "source_entry_id": "cc438eb0-a262-3753-a25f-adb76586deb7",
                        "source_sense_id": "42914f48-c58b-3874-8a75-2a73f8a9b0c4",
