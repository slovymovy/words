                    {
                        "translation_id": "d93eb7c0-5300-4925-b19e-63178fc86580",
                        "source_entry_id": "c08cbfd3-cdc6-3919-8ada-77cc178ec078",
                        "source_sense_description": "With consensus",
                        "target_lang_word": "consensueel",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "consensueel",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "e84ae086-8a7a-3851-9410-dfc0c8913fb5",
                                        "entry_id": "99612fe7-e52a-3c03-a7bd-1964a31f5a00",
                                        "glosses": [
                                            "met wederzijdse toestemming; met wederzijdse instemming"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a09cbcc3-dab4-428d-b897-9bcd95c56613",
                                                "sense_id": "e84ae086-8a7a-3851-9410-dfc0c8913fb5",
                                                "text": "De relatie zou consensueel zijn geweest maar bracht Veltroni toch in de problemen, nadat bleek dat er verschillende beschuldigingen van seksueel wangedrag waren geuit richting de chef."
                                            },
                                            {
                                                "example_id": "cbeddb3a-fe35-402b-a2aa-8a2fcf51404c",
                                                "sense_id": "e84ae086-8a7a-3851-9410-dfc0c8913fb5",
                                                "text": "De advocaat van de 34-jarige acteur ontkende alle aantijgingen en zei dat alle interactie tussen Armie en Effie ‘volledig consensueel’ was. Volgens de raadsheer geldt dat ook voor alle andere voormalig bedpartners van Armie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d3f628df-f206-40fa-a98e-6d3dd3756a3a",
                        "source_entry_id": "c08cbfd3-cdc6-3919-8ada-77cc178ec078",
                        "source_sense_description": "With consensus",
                        "target_lang_word": "afgesproken",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "afgesproken",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "dad7d3d3-594c-37da-9d1e-8cb8bcc56c18",
                                        "entry_id": "a3227cc1-684e-34f3-9f10-3692bde425bf",
                                        "glosses": [
                                            "voltooid deelwoord van afspreken"
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f9c1e04-cff0-4b09-b116-6190013e1e1b",
                                                "sense_id": "dad7d3d3-594c-37da-9d1e-8cb8bcc56c18",
                                                "text": "Alsof het zo was afgesproken, stapte Denise de kamer binnen op het moment dat zij alle aanwezigen kort had bekeken."
                                            },
                                            {
                                                "example_id": "e88f7f5f-496b-48b8-aad5-88e60e2e0d26",
                                                "sense_id": "dad7d3d3-594c-37da-9d1e-8cb8bcc56c18",
                                                "text": "Het was een groot feest in Deventer: Deventer kan zijn geluk niet op na bekerwinst Go Ahead Eagles: 'We gaan Europa in!' De horeca in het centrum van Deventer had al eerder afgesproken om middernacht te sluiten. Vanaf toen stroomde de binnenstad dan ook grotendeels leeg."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "36399db9-46ea-4aff-80a7-9d941662d96f",
                        "source_entry_id": "c08cbfd3-cdc6-3919-8ada-77cc178ec078",
                        "source_sense_description": "With consensus",
                        "target_lang_word": "consensuel",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "consensuel",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4b19aacb-3135-3ff5-98b6-3406564e9283",
                                        "entry_id": "fff06901-ddbb-342e-bd6d-35675e7ad1d5",
                                        "glosses": [
                                            "Issu d’un consensus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f81a07d6-e645-4b09-94d5-25e57910b634",
                                                "sense_id": "4b19aacb-3135-3ff5-98b6-3406564e9283",
                                                "text": "Je me lève en prenant soin de traîner mes pieds enchâssés dans des chaussons si conformes que seule la coalition de la baguette de pain et du béret peut leur lancer le défi des clichés consensuels."
                                            },
                                            {
                                                "example_id": "3064b439-a706-4560-a1c2-75e60d5aae54",
                                                "sense_id": "4b19aacb-3135-3ff5-98b6-3406564e9283",
                                                "text": "C’est l’un des paradoxes de l’époque : on se plaint des interviews consensuelles et aseptisées, mais dès qu’un échange est un peu tendu, il est considéré comme un clash, dès qu’une parole surnage, ça devient l’engueulade du siècle."
                                            },
                                            {
                                                "example_id": "becec331-05eb-4320-b7b8-8f5770111014",
                                                "sense_id": "4b19aacb-3135-3ff5-98b6-3406564e9283",
                                                "text": "L’idée d’une famille nucléaire originelle est consensuelle chez les anthropologues américains : […]. Leur mérite n’est pas si grand : leurs sujets d’étude furent les Indiens de leur continent, dont la nucléarité familiale crevait les yeux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d98cde8f-f76a-3771-ad1d-8b6a2e44c454",
                                        "entry_id": "fff06901-ddbb-342e-bd6d-35675e7ad1d5",
                                        "glosses": [
                                            "Qui est formé par le consentement des parties."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2458ea9f-07e1-40fc-b852-58aed66bbd48",
                                                "sense_id": "d98cde8f-f76a-3771-ad1d-8b6a2e44c454",
                                                "text": "Après avoir nié connaître la victime, il admet avoir entretenu « une liaison consensuelle » avec la jeune vendeuse."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "01ce606b-882c-483d-ab35-011f95efa54d",
                        "source_entry_id": "c08cbfd3-cdc6-3919-8ada-77cc178ec078",
                        "source_sense_description": "With consensus",
                        "target_lang_word": "einvernehmlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "einvernehmlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9022febe-7c83-3593-a14c-18d8a5c4cf57",
                                        "entry_id": "1404cb17-0f01-399f-86c9-15daa8e30a9c",
                                        "glosses": [
                                            "mit Zustimmung aller betroffenen Parteien"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "400f4a19-e573-40cc-86e4-d6991e0110a4",
                                                "sense_id": "9022febe-7c83-3593-a14c-18d8a5c4cf57",
                                                "text": "Während die Regierung von einer einvernehmlichen Lösung sprach, skandierte die Opposition einen faulen Kompromiss."
                                            },
                                            {
                                                "example_id": "83b3f3ab-c850-4940-aafe-a6a9951f83cc",
                                                "sense_id": "9022febe-7c83-3593-a14c-18d8a5c4cf57",
                                                "text": "Fast 90 % der Ehescheidungen erfolgen einvernehmlich."
                                            },
                                            {
                                                "example_id": "5e10d8b1-21d5-47f3-98f7-85318719d3f8",
                                                "sense_id": "9022febe-7c83-3593-a14c-18d8a5c4cf57",
                                                "text": "Für einen Zeitraum, der achtzehn Monate vom Inkrafttreten dieses Vertrages an gerechnet nicht zu überschreiten hat, werden die Chefs der diplomatischen Missionen der Sowjetunion, des Vereinigten Königreiches, der Vereinigten Staaten von Amerika und Frankreichs in Wien im einvernehmlichen Vorgehen die Alliierten und Assoziierten Mächte in allen die Durchführung und Auslegung des vorliegenden Vertrages betreffenden Fragen der österreichischen Regierung gegenüber vertreten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
