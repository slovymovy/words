    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "536c399d-519c-3ffd-9b04-7c8b8e898a36",
                "word": "bussed",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d63c65f8-e80a-393f-bde2-1cd8292144ba",
                        "entry_id": "536c399d-519c-3ffd-9b04-7c8b8e898a36",
                        "glosses": [
                            "Having or involving transportation by bus."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54ea19e1-9f2b-4f2c-9a61-388dea530e5b",
                                "sense_id": "d63c65f8-e80a-393f-bde2-1cd8292144ba",
                                "text": "The percentage of patients who missed their scheduled appointment was 19 percent for the bussed and 51 percent for the nonbussed group (P < 0.001)."
                            },
                            {
                                "example_id": "34071bd5-e58b-4ca4-97ef-82afe9f14dc1",
                                "sense_id": "d63c65f8-e80a-393f-bde2-1cd8292144ba",
                                "text": "In the 2012 academic year, a total of 13,366 bussed school centers were provided within the scope of bussed education. In that same year, a total of 109,058 school buses were used to transport students to bussed education school centers."
                            },
                            {
                                "example_id": "58ccc331-4701-488f-8f87-0f94558de59e",
                                "sense_id": "d63c65f8-e80a-393f-bde2-1cd8292144ba",
                                "text": "Reporters started catching wind of the story, but they quickly learned there was a problem with the bussed protestors narrative."
                            }
                        ]
                    },
                    {
                        "sense_id": "99489ede-332e-386a-bc9d-a13da275675c",
                        "entry_id": "536c399d-519c-3ffd-9b04-7c8b8e898a36",
                        "glosses": [
                            "Involving desegregation through bussing from the inner city to the suburbs."
                        ],
                        "tags": [
                            "US"
                        ],
                        "examples": [
                            {
                                "example_id": "0ebe7a85-3d7f-4b37-8d1c-983891ac07ad",
                                "sense_id": "99489ede-332e-386a-bc9d-a13da275675c",
                                "text": "Originally, the bussed students were not integrated into the receiving schools, but were treated as separate administrative units."
                            },
                            {
                                "example_id": "449c4207-bfb4-4299-b302-329745c085ba",
                                "sense_id": "99489ede-332e-386a-bc9d-a13da275675c",
                                "text": "Then I focus on the bussed students' school experience, highlighting their beliefs about the variability and malleability of school rules and procedures, their self-expression of critical attitudes and beliefs, and how suburban school staff promoted particular cultural skills and beliefs."
                            },
                            {
                                "example_id": "b95b39c1-7259-473a-8a8e-499edc6fd906",
                                "sense_id": "99489ede-332e-386a-bc9d-a13da275675c",
                                "text": "Many of the bussed students took public transportation so they could stay after school and work on the play."
                            },
                            {
                                "example_id": "67a5117d-4441-449b-8b1d-b58fe302c5a9",
                                "sense_id": "99489ede-332e-386a-bc9d-a13da275675c",
                                "text": "Since it was though that the bussed students did not have the money to pay the fee, the policy was changed so that library privilege to take a book was withheld until the other book was returned, a better policy for all of the students, which I voiced in the teachers lunchroom when the subject of late library books surfaced."
                            }
                        ]
                    },
                    {
                        "sense_id": "30faa582-1e53-3af1-9dc3-8f08ef0ce697",
                        "entry_id": "536c399d-519c-3ffd-9b04-7c8b8e898a36",
                        "glosses": [
                            "Having had the remains of a meal removed."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f682e74-c1f8-438b-aba9-be91db5d5014",
                                "sense_id": "30faa582-1e53-3af1-9dc3-8f08ef0ce697",
                                "text": "[…] he goes in the kitchen to sort through the plates from the bussed tables, picking through the hushpuppies for pieces of fried fish to take home."
                            },
                            {
                                "example_id": "c85d287a-fdba-4f00-b660-575650b712f3",
                                "sense_id": "30faa582-1e53-3af1-9dc3-8f08ef0ce697",
                                "text": "He set off, his arm still around Callie, letting her cling to the man who saved her life, practically tripping as they ran past the partially bussed tables ."
                            },
                            {
                                "example_id": "479cde23-c446-4371-ab4f-c35f945e2bcf",
                                "sense_id": "30faa582-1e53-3af1-9dc3-8f08ef0ce697",
                                "text": "In the bussed condition (11 tables and 31 people), the residual bones from the chicken wings were removed continuously, and participants were encouraged to serve themselves additional wings."
                            }
                        ]
                    },
                    {
                        "sense_id": "f6744252-7023-36c4-8955-1fcbd3ff8e89",
                        "entry_id": "536c399d-519c-3ffd-9b04-7c8b8e898a36",
                        "glosses": [
                            "Having a bus (electrical conductor or interface serving as a common connection for two or more circuits or components)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8966adc1-f635-47f5-9e99-02822eb3fff6",
                                "sense_id": "f6744252-7023-36c4-8955-1fcbd3ff8e89",
                                "text": "an electrical interconnect connecting said at least one bus wire on said bussed electrical distribution center with said conductive path on said printed circuit board, said electrical interconnect having a flexible bend located between the bussed electrical distribution center and the printed circuit board to provide a flexible interconnection, wherein said electrical interconnect comprises a strain relief loop."
                            },
                            {
                                "example_id": "8c2efd84-6bb2-4fcf-b5df-3cab2034d096",
                                "sense_id": "f6744252-7023-36c4-8955-1fcbd3ff8e89",
                                "text": "If δ≤max{R_A, C_A}, the bussed array is R_A/ C_A-reconfigurable."
                            },
                            {
                                "example_id": "77962857-a3a2-4ed3-b090-e5416550e237",
                                "sense_id": "f6744252-7023-36c4-8955-1fcbd3ff8e89",
                                "text": "The bussed arrangement also increases the potential for generator damage by increasing the stator current during the LOF event."
                            }
                        ]
                    },
                    {
                        "sense_id": "81f21bc9-6c28-3f07-b898-a0b1edf247f7",
                        "entry_id": "536c399d-519c-3ffd-9b04-7c8b8e898a36",
                        "glosses": [
                            "Transferring power by an electrical connection as opposed to using a direct physical coupling."
                        ],
