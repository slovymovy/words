                                        "entry_id": "26cf1ac4-fe26-38cf-8a23-d5fea66b128d",
                                        "glosses": [
                                            "een vorm van ongeslachtelijke voortplanting, het verschijnsel dat vrouwtjes van bepaalde diersoorten nakomelingen kunnen krijgen zonder dat hier mannetjes aan te pas komen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f783869-8c59-498a-93f4-5d3da668c03a",
                                                "sense_id": "0a72de13-6b9a-3c76-bfd4-78bdefad5753",
                                                "text": "Maagdelijke voortplanting of parthenogenese is bij enkele soorten reptielen, insecten en vissen bekend."
                                            },
                                            {
                                                "example_id": "ace55f54-7174-46f1-94be-42e76af71eeb",
                                                "sense_id": "0a72de13-6b9a-3c76-bfd4-78bdefad5753",
                                                "text": "Deze vorm van aseksuele voortplanting heet 'parthenogenese' of maagdelijke voortplanting en komt vrij vaak voor bij ongewervelde dieren."
                                            }
                                        ]
