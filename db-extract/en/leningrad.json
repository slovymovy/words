                        "sense_id": "c8d14d8d-5eb3-3c28-a1cc-f7d75ff1d46c",
                        "entry_id": "9290f5e0-4d58-3011-bbfe-6e03148bb1f6",
                        "glosses": [
                            "An oblast of Russia, which surrounds, but no longer contains, Saint Petersburg, its former administrative centre."
                        ],
