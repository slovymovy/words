                    },
                    {
                        "translation_id": "e670fa07-6abc-4c11-a32d-4d379735462c",
                        "source_entry_id": "95451a2c-25f9-36df-9b35-390ac2715828",
                        "target_lang_word": "mikado",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mikado",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b71dc814-05f0-37bc-b584-976d93139f8c",
                                        "entry_id": "a2033d57-c824-328e-b0d6-e06ab9902c72",
                                        "glosses": [
                                            "A former title of the emperors of Japan during a certain period."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c640c37c-1f8c-3716-95fb-31b8d5a34bea",
                                        "entry_id": "a2033d57-c824-328e-b0d6-e06ab9902c72",
                                        "glosses": [
                                            "Any emperor of Japan."
                                        ],
                                        "tags": [
                                            "countable",
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bbb049b6-4e80-4e1b-b3f2-7be7256a941d",
                                                "sense_id": "c640c37c-1f8c-3716-95fb-31b8d5a34bea",
                                                "text": "The mikados of Japan are its emperors."
                                            },
                                            {
                                                "example_id": "34af8862-a23b-4140-990d-7237e041bf07",
                                                "sense_id": "c640c37c-1f8c-3716-95fb-31b8d5a34bea",
                                                "text": "An interval of eighty years, occupied by two mikado of whose doings nothing is recorded, brings us to the celebrated female sovereign who invaded and conquered Korea."
                                            },
                                            {
                                                "example_id": "b68164ef-04d9-4ea8-a83a-645c18c1240a",
                                                "sense_id": "c640c37c-1f8c-3716-95fb-31b8d5a34bea",
                                                "text": "Our great Mikado, virtuous man,\nWhen he to rule our land began,\nResolved to try a plan whereby\nYoung men might best be steadied."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b65388ae-7971-3d8e-8400-d01202339569",
                                        "entry_id": "a2033d57-c824-328e-b0d6-e06ab9902c72",
                                        "glosses": [
                                            "A game of skill, in which identically shaped (but differently colored and valued) wooden sticks must be removed from a pile without disturbing the remaining stack."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3a5eba42-5d6c-32c9-a4de-78bfdbb22f38",
                                        "entry_id": "a2033d57-c824-328e-b0d6-e06ab9902c72",
                                        "glosses": [
                                            "A fabric having a stiff twill weave."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
