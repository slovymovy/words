                ],
                "senses": [
                    {
                        "sense_id": "78c8df3d-4974-3f9a-8c9f-8ba8a13b5dd0",
                        "entry_id": "239423f3-867d-3548-9d57-d9d67b63091d",
                        "glosses": [
                            "eine nicht transparente Farbe, die nach dem Anstrich die ursprüngliche Oberflächenfarbe überdeckt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "22abed90-25d8-426f-b0a6-9b8eeb002740",
                                "sense_id": "78c8df3d-4974-3f9a-8c9f-8ba8a13b5dd0",
                                "text": "„Es stank schon sehr nach Qualm, aber wir haben das Nikotin mit rund 50 Litern Abdeckfarbe gut verbannt.“"
                            },
                            {
                                "example_id": "4acdd1a5-678c-4711-8293-0df44bda94e8",
                                "sense_id": "78c8df3d-4974-3f9a-8c9f-8ba8a13b5dd0",
                                "text": "„Die Folie oder das Papier werden durch Zeichnen, Malen, Spritzen und andere mögliche Techniken mit der lichtundurchlässigen Abdeckfarbe an den Stellen des Motivs bedeckt, die später drucken sollen.“"
                            },
                            {
                                "example_id": "3f47d692-e4f6-4539-9fa7-3d7c6fb78009",
                                "sense_id": "78c8df3d-4974-3f9a-8c9f-8ba8a13b5dd0",
                                "text": "„Die nicht zu rastemden Flächen können jedoch auch erst nach der zweiten Beschichtung bei gelbem Licht mit roter Abdeckfarbe abgedeckt werden, die sich mach dem Aufkopieren des Rasters leicht wieder mit Wasser abwaschen läßt.“"
                            },
                            {
                                "example_id": "0d3c5d97-d25c-4e20-8c36-750356d0a751",
                                "sense_id": "78c8df3d-4974-3f9a-8c9f-8ba8a13b5dd0",
                                "text": "„Überwiegend im künstlerischen Siebdruck wird auch die Gelegenheit der direkten Aufbringung der Schablone auf das Sieb mittels Pinsel und Abdeckfarbe praktiziert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
