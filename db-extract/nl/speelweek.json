                        "examples": [
                            {
                                "example_id": "3b928e7e-662a-4b75-9983-dafe96ac05cb",
                                "sense_id": "87a808d8-194a-38ba-90f0-6b9cfecb540b",
                                "text": "De familiefilm Dikkertje Dap draait in zijn eerste speelweek in maar liefst 147 bioscopen door het hele land. Dat is een record."
                            },
                            {
                                "example_id": "7fe2e257-df8c-42db-923e-9abc97fbf94d",
                                "sense_id": "87a808d8-194a-38ba-90f0-6b9cfecb540b",
                                "text": "We rennen naar voren om applaus in ontvangst te nemen. Dankbaar en moe sluiten we deze speelweek van de comedy Husbands And Wives in Amsterdam af."
                            },
                            {
                                "example_id": "e2a828e5-1e57-4c59-96e3-e1de1971ecb1",
                                "sense_id": "87a808d8-194a-38ba-90f0-6b9cfecb540b",
                                "text": "Tennisclubs De Mors, Rijssen, Holten en Enter strijden van maandag 12- tot en met zaterdag 17 juni om de Noaberscup. De wisselbeker gaat naar de vereniging, die aan het einde van deze speelweek de meeste punten heeft verzameld."
                            }
                        ]
                    }
