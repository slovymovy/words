                    {
                        "sense_id": "dc288a02-950e-3f82-915a-6b2aa241af07",
                        "entry_id": "087ce473-8323-302b-9048-67bd9290bfc5",
                        "glosses": [
                            "To travel in a straight line, ignoring established paths of travel."
                        ],
                        "tags": [
                            "intransitive",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "57d34d6f-6bdf-4c7d-8d82-259d02d5b1ed",
                                "sense_id": "dc288a02-950e-3f82-915a-6b2aa241af07",
                                "text": "A uniformed policeman came off the elevator and beelined for the nurse's station. I beelined into the stairwell. I wasn't in the mood for chatting with the police."
                            },
                            {
                                "example_id": "2420bc08-5ed7-40da-a9e7-079329186509",
                                "sense_id": "dc288a02-950e-3f82-915a-6b2aa241af07",
                                "text": "Suddenly, a woman beelines to the president, climbs to join him on his platform, there’s no security around to stop her and leans in for a kiss."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
