            "senses": [
                {
                    "sense_id": "1fbe1e96-583b-33c4-a273-dec45f5c3276",
                    "sense_definition": "von ernstem Gesichtsausdruck oder Gemüt; frei von Scherz, Ausgelassenheit oder Heiterkeit",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "stimmung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der Lehrer setzte eine <w>ernsthafte</w> Miene auf, als er über die Prüfungen sprach."
                        },
                        {
                            "text": "Mit einem <w>ernsthaften</w> Blick hörte sie den Schilderungen ihrer Freundin aufmerksam zu."
                        }
                    ],
                    "antonyms": [
                        "fröhlich",
                        "gutgelaunt",
                        "heiter"
                    ],
                    "common_phrases": [
