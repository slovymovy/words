                        "target_lang_word": "verunglücken",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verunglücken",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "da737cc3-86d5-356e-8533-a64b7b0e38e8",
                                        "entry_id": "a7278e3d-63ca-339c-87e5-b48fee5fb8df",
                                        "glosses": [
                                            "einen Unfall erleiden"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f24deb18-ffe7-4b4a-9283-cb5aaf78163e",
                                                "sense_id": "da737cc3-86d5-356e-8533-a64b7b0e38e8",
                                                "text": "Die Nachrichten von Wanderern, die in den Alpen verunglücken, häufen sich."
                                            },
                                            {
                                                "example_id": "dd21499f-fe1c-4c50-a665-8602f7e4726d",
                                                "sense_id": "da737cc3-86d5-356e-8533-a64b7b0e38e8",
                                                "text": "Die Unfallstatistik des Deutschen Alpenvereins (DAV), die jetzt in München vorgestellt wurde, bestätigt den Eindruck, dass immer mehr Menschen beim Bergsport verunglücken."
                                            },
                                            {
                                                "example_id": "a9361968-d851-4177-928f-b41b526b8b0d",
                                                "sense_id": "da737cc3-86d5-356e-8533-a64b7b0e38e8",
                                                "text": "Beim Paragliding in Österreich sind am Wochenende zwei Deutsche schwer verunglückt."
                                            },
                                            {
                                                "example_id": "033a23e7-d995-4619-a349-ea221b4d3ce2",
                                                "sense_id": "da737cc3-86d5-356e-8533-a64b7b0e38e8",
                                                "text": "Die Unfallbilanz der ersten neun Monate des Jahres 2017 zeigt, dass gegenüber dem Vorjahr weniger Pkw-Insassen und Fußgänger tödlich verunglückten."
                                            },
                                            {
                                                "example_id": "63b139b7-191b-4ac4-8586-7e65134b5bce",
                                                "sense_id": "da737cc3-86d5-356e-8533-a64b7b0e38e8",
                                                "text": "Am Montagmittag ist der Kradfahrer mit seiner Suzuki auf der Schraplauer Straße in Röblingen am See tödlich verunglückt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bbca0909-a9f4-3181-b38a-79ec9be5d3e8",
                                        "entry_id": "a7278e3d-63ca-339c-87e5-b48fee5fb8df",
                                        "glosses": [
                                            "nicht gelingen"
                                        ],
                                        "tags": [
                                            "humorous",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba6a983b-9e13-4006-bbc3-829a15333896",
                                                "sense_id": "bbca0909-a9f4-3181-b38a-79ec9be5d3e8",
                                                "text": "Der Kuchen ist leider verunglückt, den kann man nur noch wegwerfen."
                                            },
                                            {
                                                "example_id": "42362cd2-9627-4ca9-a7b5-f9a23dbab55c",
                                                "sense_id": "bbca0909-a9f4-3181-b38a-79ec9be5d3e8",
                                                "text": "Der Zweck seiner Sendung war verunglückt."
                                            },
                                            {
                                                "example_id": "585cd0bf-20a2-49bc-80f5-5b6b4349b5fb",
                                                "sense_id": "bbca0909-a9f4-3181-b38a-79ec9be5d3e8",
                                                "text": "Verunglückt war die Expedition; die Zuschauer saßen da und wollten etwas sehen."
                                            },
                                            {
                                                "example_id": "89a47a56-44b9-4141-900d-c51f72cf9080",
                                                "sense_id": "bbca0909-a9f4-3181-b38a-79ec9be5d3e8",
                                                "text": "So Wackernagel: »… Bei uns war nirgend ein Anlaß auf den sich ein solcher hätte bilden können, und so haben denn auch die Versuche die von den deutschen Dramatikern des XVI. und XVII. Jahrhunderts… sind gemacht worden ihn auch auf die deutsche Bühne überzuleiten, nur verunglücken können.«"
                                            },
                                            {
                                                "example_id": "0efb5179-584b-4696-9cd3-d4462477ca8e",
                                                "sense_id": "bbca0909-a9f4-3181-b38a-79ec9be5d3e8",
                                                "text": "Ohne das Erste würde die Einbildungskraft gar nicht angefordert werden, eine Darstellung seiner Totalität zu versuchen; ohne das Zweite würde ihr dieser Versuch nicht verunglücken können."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
