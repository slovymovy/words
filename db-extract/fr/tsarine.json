                    },
                    {
                        "form_id": "91f570c1-bac4-4617-8558-6cba510b51dd",
                        "entry_id": "dcb3bbeb-6c99-30e5-8fae-28a5fcb1b34d",
                        "tags": [],
                        "form": "czarine"
                    },
                    {
                        "form_id": "087ae486-5c33-4883-b1eb-4e3a5bfa1ec6",
                        "entry_id": "dcb3bbeb-6c99-30e5-8fae-28a5fcb1b34d",
                        "tags": [
                            "orthographe traditionnelle"
                        ],
                        "form": "tzarine"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "bd650f1e-b23a-3593-b222-3cef8161bd16",
                        "entry_id": "dcb3bbeb-6c99-30e5-8fae-28a5fcb1b34d",
                        "glosses": [
                            "Impératrice de Russie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30b0dc07-aa39-430f-b3a1-b706023f74d4",
                                "sense_id": "bd650f1e-b23a-3593-b222-3cef8161bd16",
                                "text": "Catherine II (1729-1796) est la plus grande tsarine du xviiiᵉ siècle."
                            },
                            {
                                "example_id": "60650ceb-e149-43aa-ae30-4d17b3670ab9",
                                "sense_id": "bd650f1e-b23a-3593-b222-3cef8161bd16",
                                "text": "La tsarine Catherine Iʳᵉ édicte, le 26 avril 1727, un décret aux motivations essentiellement financières sur « l’expulsion des youpins de Russie et sur la vérification qu’ils n’emportent pas avec eux des pièces de monnaie russes en argent et en or. »"
                            },
                            {
                                "example_id": "569efe26-5d38-4bb6-8220-6a416074c27e",
                                "sense_id": "bd650f1e-b23a-3593-b222-3cef8161bd16",
                                "text": "Le kaiser Joseph II et la tsarine Catherine II, les césars de l’Est, se rapprochaient l’un de l’autre. Le 30 avril, la flotte arriva à Krementchouk, retardée par des vents violents."
                            }
                        ]
                    },
                    {
                        "sense_id": "30085ec1-3f62-3358-a8ca-2b8d4870c64b",
                        "entry_id": "dcb3bbeb-6c99-30e5-8fae-28a5fcb1b34d",
                        "glosses": [
                            "Épouse d’un tsar."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e47b48b3-f8d5-4474-a875-8f4721169ec4",
                                "sense_id": "30085ec1-3f62-3358-a8ca-2b8d4870c64b",
                                "text": "Enfermées dans le terem, gynécée tatar ou byzantin, les tsarines et les tsarevnas laissaient les tsars à la grossièreté de leur sexe. La Moscovie n’eut ni châteaux ni palais ; le Kremlin n'était qu'une forteresse et un couvent, […]."
                            },
                            {
                                "example_id": "68b2b63b-47d5-44f3-b5b7-765ea2384b93",
                                "sense_id": "30085ec1-3f62-3358-a8ca-2b8d4870c64b",
                                "text": "J’y ai vu des intérieurs modestes d’une adorable propreté, les portraits du tsar et de la tsarine de Russie, pour mon étonnement, en honneur sur les murs ; j’ai pu, dans d’autres milieux, me rendre compte de l’intelligence partout reconnue de cette race « la plus pure de l’Égypte »."
                            },
                            {
                                "example_id": "7f91dccf-194d-44b9-8273-648e61fe7e89",
                                "sense_id": "30085ec1-3f62-3358-a8ca-2b8d4870c64b",
                                "text": "Ce portrait intime de la tsarine Alexandra (1872-1918), l’épouse allemande de Nicolas II, n’est ni l’histoire d’un règne ni une biographie traditionnelle, mais l’évocation d’une existence privée…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9d8c15e6-2d29-45e8-b93e-ab64ed01914a",
                        "source_entry_id": "dcb3bbeb-6c99-30e5-8fae-28a5fcb1b34d",
                        "source_sense_id": "bd650f1e-b23a-3593-b222-3cef8161bd16",
                        "source_sense_description": "Impératrice",
                        "target_lang_word": "Zarin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zarin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9969f696-5454-3108-a924-aea537c8e617",
                                        "entry_id": "d2439828-b100-38c0-a939-5d5e336ee220",
                                        "glosses": [
                                            "Frau als Zar/oberste Herrscherin"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be0ec8d9-4295-4720-b8d9-c31cc875d0f5",
                                                "sense_id": "9969f696-5454-3108-a924-aea537c8e617",
                                                "text": "„Denn die Zarin verbot den Sklavenhandel, der im Krim-Khanat geherrscht hatte.“"
                                            },
                                            {
                                                "example_id": "8331409d-1779-446b-b7fa-a537539f84d8",
                                                "sense_id": "9969f696-5454-3108-a924-aea537c8e617",
                                                "text": "„Er verließ Rußland, weil die Orlows die Zarin überredet hatten, die Glücksspiele zu verbieten.“"
                                            },
                                            {
                                                "example_id": "1c576697-4f79-4fa1-9f62-1d462c339604",
                                                "sense_id": "9969f696-5454-3108-a924-aea537c8e617",
                                                "text": "„Der damals von der Zarin eingesetzte Gouverneur Nikolaus von Korff stammte aus einem kurländischen Adelsgeschlecht und genoss das freie Geistesleben an der Königsberger Universität in vollen Zügen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5fbdd64d-bc76-3bea-8afa-dd43a79efd74",
                                        "entry_id": "d2439828-b100-38c0-a939-5d5e336ee220",
                                        "glosses": [
                                            "Frau eines Zaren"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
