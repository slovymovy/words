                "senses": [
                    {
                        "sense_id": "c29eb117-e6ce-365b-a7ec-72cd8c8a2d1d",
                        "entry_id": "a703ac95-8cc9-3103-9c06-e525dfb21da3",
                        "glosses": [
                            "theatraal zoals past bij een opera uitvoering"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33b94135-0571-4dde-9f3a-3a8a59fe6406",
                                "sense_id": "c29eb117-e6ce-365b-a7ec-72cd8c8a2d1d",
                                "text": "Ernst Daniël Smit, Henk Poort en Marco Bakker vertolken samen met The New Symphonics Orchestra de klassiekers uit het repertoire van de overleden artiesten, maar dan wel operatesk in de stijl van de baritons."
                            },
                            {
                                "example_id": "b9792e5b-36e1-4986-97bd-c06dfaf6446c",
                                "sense_id": "c29eb117-e6ce-365b-a7ec-72cd8c8a2d1d",
                                "text": "Met Benjamin Clementine krijgen we een intrigerende Brit die muziek een haast operateske soulglans meegeeft."
                            },
                            {
                                "example_id": "418df725-c480-4db9-996a-9aaf947c13d7",
                                "sense_id": "c29eb117-e6ce-365b-a7ec-72cd8c8a2d1d",
                                "text": "Bochum heeft daarbij ook een behoorlijk afwijkend decor, meer dramatisch en operatesk: de acteurs staan in wat een woonkamer lijkt, waar de meubels zijn overtrokken met lakens, als in een verlaten huis. Een lege kinderwagen en een hobbelpaard herinneren opzichtig aan het drama."
                            }
                        ]
                    }
