                "senses": [
                    {
                        "sense_id": "eec56edc-06df-36b4-85f6-9f636c8a128b",
                        "entry_id": "79138372-af52-3344-a72b-1a4c757a4d83",
                        "glosses": [
                            "von Siedlern gegründete Kolonie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30091037-21a2-47bd-bd4e-d44c377fb0c6",
                                "sense_id": "eec56edc-06df-36b4-85f6-9f636c8a128b",
                                "text": "„Siedlerkolonien unterschieden sich von anderen europäischen Besitzungen dadurch, dass die weißen Einwanderer aufgrund ihrer Hautfarbe und Herkunft eine privilegierte Stellung einnahmen, weshalb sie leichter das Gehör der Regierung fanden als die Afrikaner.“"
                            },
                            {
                                "example_id": "b9d25998-3d96-488a-8dbc-a37059db178e",
                                "sense_id": "eec56edc-06df-36b4-85f6-9f636c8a128b",
                                "text": "„Wie in Nordamerika sollte auch die Kolonisierung Palästinas – wie in Südafrika, Australien, Algerien und Teilen Ostafrikas – eine weiße europäische Siedlerkolonie hervorbringen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
