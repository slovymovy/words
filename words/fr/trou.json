    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "140fb715-1a48-3531-a3e2-5d59f1755c0c",
                    "sense_definition": "Ouverture, perforation ou cavité naturelle ou artificielle dans une matière ou une surface.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "ouverture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "J'ai fait un petit <w>trou</w> dans le mur pour accrocher un tableau."
                        },
                        {
                            "text": "Il y a un grand <w>trou</w> dans ta chaussette droite."
                        }
                    ],
                    "synonyms": [
                        "brèche",
                        "creux",
                        "percement"
                    ],
                    "common_phrases": [
                        "trou de serrure",
                        "faire un trou",
                        "trou noir"
                    ]
                },
                {
                    "sense_id": "57e4b911-c82f-3ccd-8730-ac1f44c55f8c",
                    "sense_definition": "Oubli soudain ou défaillance momentanée de la mémoire.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "manque",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pendant l'examen, j'ai eu un <w>trou</w> et j'ai oublié la réponse."
                        },
                        {
                            "text": "Il a souvent des petits <w>trous</w> quand il est fatigué."
                        }
                    ],
                    "common_phrases": [
                        "trou de mémoire"
                    ]
                },
                {
                    "sense_id": "c964e7bb-7c21-3a7b-9524-2ccf764f5355",
                    "sense_definition": "Déficit dans des finances ou interruption dans une organisation temporelle.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "manque",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'entreprise essaie de combler un <w>trou</w> de plusieurs milliers d'euros."
                        },
                        {
                            "text": "J'ai un <w>trou</w> de deux heures entre mes deux cours cet après-midi."
                        }
                    ],
                    "common_phrases": [
                        "trou dans le budget"
                    ]
                },
                {
                    "sense_id": "ede963db-7754-3309-bed6-f0bb0202c52b",
                    "sense_definition": "Localité isolée, petite ville ou village sans animation ni intérêt.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "lieu",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a passé toute son enfance dans un petit <w>trou</w> de province."
                        },
                        {
                            "text": "Pourquoi veux-tu déménager dans un <w>trou</w> pareil où il n'y a rien ?"
                        }
                    ],
                    "synonyms": [
                        "bled",
                        "patelin"
                    ],
                    "common_phrases": [
                        "trou perdu",
                        "trou de province"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Familier et péjoratif pour désigner un lieu ennuyeux."
                        }
                    ]
                },
                {
                    "sense_id": "6c113ee5-c878-3b1b-af80-159426ac6579",
                    "sense_definition": "Petite cavité aménagée sur un terrain de golf dans laquelle la balle doit tomber.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "ouverture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le joueur a réussi à mettre la balle dans le <w>trou</w> en trois coups."
                        },
                        {
                            "text": "Nous avons joué sur un parcours de dix-huit <w>trous</w> ce matin."
                        }
                    ],
                    "common_phrases": [
                        "parcours de dix-huit trous"
                    ]
                },
                {
                    "sense_id": "f3838243-e558-3837-a11b-b5cf21f0f516",
                    "sense_definition": "Cellule disciplinaire, cachot ou prison.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "lieu",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après cette bagarre, le prisonnier a passé trois semaines au <w>trou</w>."
                        },
                        {
                            "text": "Si la police t'attrape avec ça, tu vas finir au <w>trou</w>."
                        }
                    ],
                    "common_phrases": [
                        "aller au trou",
                        "finir au trou"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Terme argotique désignant la prison ou le cachot."
                        }
                    ]
                },
                {
                    "sense_id": "2b568e39-ec1d-314a-b2ea-d174c6baed94",
                    "sense_definition": "En physique des semi-conducteurs, absence d'un électron dans la bande de valence se comportant comme une charge positive.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La conductivité électrique dépend du mouvement des électrons et des <w>trous</w>."
                        },
                        {
                            "text": "Un <w>trou</w> se comporte comme une particule chargée positivement dans le semi-conducteur."
                        }
                    ],
                    "synonyms": [
                        "électron-trou",
                        "trou d'électron",
                        "trou électronique"
                    ]
                }
            ]
        }
    ]
