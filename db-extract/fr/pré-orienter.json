                "senses": [
                    {
                        "sense_id": "8449ea70-21c2-36b2-9019-45dc1e54f31d",
                        "entry_id": "37dddce0-11f2-30ab-a218-e36e77ddbe80",
                        "glosses": [
                            "Donner une première orientation à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f9ebd8f-7982-4570-86c0-4c6b20e83869",
                                "sense_id": "8449ea70-21c2-36b2-9019-45dc1e54f31d",
                                "text": "Selon que l'on recherche une orientation en coupe plane-longitudinale, section transverse par rapport à l'orientation préférentielle, ou dans une direction cristallographique particulière différente, il faudra pré-orienter l'échantillon massif, ou pré-enrober l'échantillon dispersé, avant de l'amincir."
                            },
                            {
                                "example_id": "30c74cbd-96ff-48dc-96d1-5de96feefc1d",
                                "sense_id": "8449ea70-21c2-36b2-9019-45dc1e54f31d",
                                "text": "Cette intervention semblerait donc être d'une efficacité accrue comme frein à la conflictualité par sa capacité à prévoir et pré-orienter la solution des conflits, à les étouffer dans l'œuf."
                            }
                        ]
                    }
