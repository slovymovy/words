{
    "word_family": [
        "customer",
        "customize",
        "customization",
        "customary",
        "accustom"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "8edfe0e7-bd1c-31b8-82c8-bf2fb92f649a",
                    "sense_definition": "Made or modified to fit the specific needs or tastes of a particular person or group; not ready-made.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "made_to_order",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He decided to buy a <w>custom</w> suit for his wedding so that it would fit perfectly.",
                            "target_lang_translations": {
                                "ru": "Он решил купить <w>сшитый на заказ</w> костюм на свадьбу, чтобы тот сидел идеально.",
                                "zh": "他决定为婚礼买一套<w>定制</w>西装，这样穿起来才合身。"
                            }
                        },
                        {
                            "text": "The company offers <w>custom</w> software solutions for small businesses.",
                            "target_lang_translations": {
                                "ru": "Компания предлагает <w>индивидуальные</w> программные решения для малого бизнеса.",
                                "zh": "这家公司为小型企业提供<w>定制</w>软件解决方案。"
                            }
                        },
                        {
                            "text": "She loves her <w>custom</w> car because no one else has one like it.",
                            "target_lang_translations": {
                                "ru": "Она обожает свой <w>сделанный на заказ</w> автомобиль, потому что ни у кого больше нет такого же.",
                                "zh": "她很喜欢她的<w>定制</w>汽车，因为没有人和她的一样。"
                            }
                        }
                    ],
                    "synonyms": [
                        "bespoke"
                    ],
                    "common_phrases": [
                        "custom made",
                        "custom design",
                        "custom built",
                        "custom settings"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделанный или изменённый в соответствии с конкретными потребностями или вкусами конкретного человека или группы; не серийный.",
                        "zh": "指为满足特定个人或群体的需求而专门制作或修改的，而非现成的产品。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сделанный на заказ",
                                "target_lang_sense_clarification": "общий термин для вещей, изготовленных индивидуально"
                            },
                            {
                                "target_lang_word": "заказной",
                                "target_lang_sense_clarification": "выполненный по специальному заказу"
                            },
                            {
                                "target_lang_word": "пользовательский",
                                "target_lang_sense_clarification": "в контексте настроек или программного обеспечения"
                            },
                            {
                                "target_lang_word": "нестандартный",
                                "target_lang_sense_clarification": "отличающийся от типового образца"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "定制",
                                "target_lang_sense_clarification": "指根据个人需求专门制作"
                            },
                            {
                                "target_lang_word": "定做",
                                "target_lang_sense_clarification": "指按要求制作"
                            },
                            {
                                "target_lang_word": "个性化",
                                "target_lang_sense_clarification": "指针对特定需求进行调整"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1f525957-9762-3318-8f7d-f3518e086c95",
                    "sense_definition": "Performed for others on a contract or for-hire basis, rather than for oneself (often used in agriculture).",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "contract_work",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer does <w>custom</w> threshing for his neighbors to earn extra money.",
                            "target_lang_translations": {
                                "ru": "Фермер занимается молотьбой <w>по найму</w> для соседей, чтобы заработать дополнительные деньги.",
                                "zh": "这位农民通过为邻居<w>代工</w>脱粒来赚取额外收入。"
                            }
                        },
                        {
                            "text": "They hired a <w>custom</w> harvesting crew to clear the fields quickly.",
                            "target_lang_translations": {
                                "ru": "Они наняли бригаду для уборки урожая <w>по контракту</w>, чтобы быстро очистить поля.",
                                "zh": "他们雇佣了一支<w>承包</w>收割队来快速清理田地。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "custom farming",
                        "custom work"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "North America"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Выполняемый для других на договорной основе или по найму, а не для себя (часто используется в сельском хозяйстве).",
                        "zh": "指以合同或受雇形式为他人提供的服务，而非为自己工作（常用于农业）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выполняемый по найму",
                                "target_lang_sense_clarification": "о работах или услугах"
                            },
                            {
                                "target_lang_word": "на заказ",
                                "target_lang_sense_clarification": "о выполнении работ сторонним исполнителем"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "代工",
                                "target_lang_sense_clarification": "指受雇为他人进行生产或加工"
                            },
                            {
                                "target_lang_word": "承包",
                                "target_lang_sense_clarification": "指通过合同承担某项工作"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ea1d7006-096e-3333-bd8e-4153ae9824f3",
                    "sense_definition": "A traditional and widely accepted way of behaving or doing something that is specific to a particular society, place, or time.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "tradition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is a local <w>custom</w> to take off your shoes before entering a home.",
                            "target_lang_translations": {
                                "ru": "Снимать обувь перед входом в дом — это местный <w>обычай</w>.",
                                "zh": "进屋前脱鞋是当地的一种<w>习俗</w>。"
                            }
                        },
                        {
                            "text": "The festival is an ancient <w>custom</w> that has been celebrated for centuries.",
                            "target_lang_translations": {
                                "ru": "Этот фестиваль — древняя <w>традиция</w>, которую отмечают веками.",
                                "zh": "这个节日是一项已经庆祝了几个世纪的古老<w>传统</w>。"
                            }
                        },
                        {
                            "text": "Social <w>custom</w> dictates that we bring a gift to the host.",
                            "target_lang_translations": {
                                "ru": "Общественный <w>обычай</w> предписывает нам принести подарок хозяину.",
                                "zh": "社会<w>习俗</w>要求我们给主人带一份礼物。"
                            }
                        }
                    ],
                    "synonyms": [
                        "habit",
                        "practice",
                        "usage",
                        "tradition",
                        "convention"
                    ],
                    "common_phrases": [
                        "local custom",
                        "ancient custom",
                        "social custom",
                        "according to custom"
                    ],
                    "target_lang_definitions": {
                        "ru": "Традиционный и общепринятый способ поведения или действия, характерный для конкретного общества, места или времени.",
                        "zh": "特定社会、地点或时代所特有的，被广泛接受的传统行为方式或做事方法。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обычай",
                                "target_lang_sense_clarification": "общепринятый порядок, традиционно установившиеся правила"
                            },
                            {
                                "target_lang_word": "традиция",
                                "target_lang_sense_clarification": "то, что перешло от одного поколения к другому"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "习俗",
                                "target_lang_sense_clarification": "指长期形成的社会行为规范"
                            },
                            {
                                "target_lang_word": "传统",
                                "target_lang_sense_clarification": "指世代相传的习惯或信仰"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c5681a82-ab4c-3f00-8d08-7c343753d87e",
                    "sense_definition": "The support given to a business by its customers buying goods or services.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "business_patronage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The small shop lost a lot of <w>custom</w> when the large supermarket opened nearby.",
                            "target_lang_translations": {
                                "ru": "Маленький магазин потерял много <w>клиентов</w>, когда поблизости открылся большой супермаркет.",
                                "zh": "附近的大型超市开业后，这家小店流失了许多<w>客源</w>。"
                            }
                        },
                        {
                            "text": "We appreciate your <w>custom</w> and hope to serve you again soon.",
                            "target_lang_translations": {
                                "ru": "Мы ценим ваш <w>выбор</w> и надеемся вскоре снова обслужить вас.",
                                "zh": "我们感谢您的<w>惠顾</w>，并希望很快能再次为您服务。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "lose custom",
                        "attract custom",
                        "take my custom"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "British English"
                        },
                        {
                            "trait_type": "form",
                            "comment": "formal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Поддержка, оказываемая бизнесу его клиентами, покупающими товары или услуги.",
                        "zh": "指顾客通过购买商品或服务对企业提供的支持。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "клиентура",
                                "target_lang_sense_clarification": "совокупность постоянных посетителей или заказчиков"
                            },
                            {
                                "target_lang_word": "покупатели",
                                "target_lang_sense_clarification": "люди, обеспечивающие доход бизнесу"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "客源",
                                "target_lang_sense_clarification": "指企业的顾客来源"
                            },
                            {
                                "target_lang_word": "生意",
                                "target_lang_sense_clarification": "指商业往来或买卖"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "07775e55-e0cb-3f21-a00d-478400ae5bcc",
                    "sense_definition": "A product, such as a piece of art, clothing, or modification, that has been made to order.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "made_to_order",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She paints shoes and sells the <w>customs</w> online to fans.",
                            "target_lang_translations": {
                                "ru": "Она расписывает обувь и продает эти <w>кастомы</w> фанатам через интернет.",
                                "zh": "她给鞋子手绘图案，并将这些<w>定制品</w>在网上卖给粉丝。"
                            }
                        },
                        {
                            "text": "I ordered a <w>custom</w> from the artist, but it will take weeks to arrive.",
                            "target_lang_translations": {
                                "ru": "Я заказал у художника <w>индивидуальное изделие</w>, но его доставки придется ждать несколько недель.",
                                "zh": "我向那位艺术家订购了一件<w>定制品</w>，但需要几周才能送到。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in internet commerce or art communities"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Продукт, такой как произведение искусства, одежда или модификация, который был сделан на заказ.",
                        "zh": "指按订单制作的艺术品、服装或改装产品。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кастом",
                                "target_lang_sense_clarification": "сленг: уникальная, переделанная вещь"
                            },
                            {
                                "target_lang_word": "изделие на заказ",
                                "target_lang_sense_clarification": "предмет, изготовленный индивидуально"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "定制品",
                                "target_lang_sense_clarification": "指专门定制的物品"
                            },
                            {
                                "target_lang_word": "改装件",
                                "target_lang_sense_clarification": "指经过个性化改装的物品"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "36b83837-478c-3f04-82a2-1395ff3f354b",
                    "sense_definition": "A tax or duty paid on goods imported or exported.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "tax",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Merchants were required to pay a heavy <w>custom</w> on all silk brought into the city.",
                            "target_lang_translations": {
                                "ru": "Купцы были обязаны платить большую <w>пошлину</w> за весь шелк, ввозимый в город.",
                                "zh": "商人们被要求为所有带入城市的丝绸缴纳高额<w>关税</w>。"
                            }
                        },
                        {
                            "text": "Render therefore to all their dues: tribute to whom tribute is due; <w>custom</w> to whom custom.",
                            "target_lang_translations": {
                                "ru": "Итак, отдавайте всякому должное: кому подать — подать; кому <w>оброк</w> — оброк.",
                                "zh": "你们要向所有该得的人纳税：该纳贡的纳贡，该纳<w>关税</w>的纳关税。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "modern usage typically uses the plural form 'customs' or 'duty'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Налог или сбор, уплачиваемый за импортируемые или экспортируемые товары.",
                        "zh": "对进出口商品征收的税款或费用。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пошлина",
                                "target_lang_sense_clarification": "денежный сбор, взимаемый государством"
                            },
                            {
                                "target_lang_word": "сбор",
                                "target_lang_sense_clarification": "налог или плата"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "关税",
                                "target_lang_sense_clarification": "指国家对进出口货物征收的税"
                            },
                            {
                                "target_lang_word": "税费",
                                "target_lang_sense_clarification": "指应缴纳的税款"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7841dc03-4c34-3cb6-89d7-82615ad58137",
                    "sense_definition": "To make familiar; to accustom.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "accustom_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is difficult to <w>custom</w> oneself to such a harsh climate.",
                            "target_lang_translations": {
                                "ru": "Трудно <w>приучить</w> себя к такому суровому климату.",
                                "zh": "很难让自己<w>适应</w>如此恶劣的气候。"
                            }
                        },
                        {
                            "text": "He tried to <w>custom</w> his thoughts to the new reality.",
                            "target_lang_translations": {
                                "ru": "Он пытался <w>приспособить</w> свои мысли к новой реальности.",
                                "zh": "他试图让自己的思想<w>适应</w>新的现实。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "modern English uses 'accustom'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Делать привычным; приучать.",
                        "zh": "使熟悉；使习惯。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приучать",
                                "target_lang_sense_clarification": "заставлять привыкнуть"
                            },
                            {
                                "target_lang_word": "свыкаться",
                                "target_lang_sense_clarification": "становиться привычным"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "使习惯",
                                "target_lang_sense_clarification": "指适应某种环境或事物"
                            },
                            {
                                "target_lang_word": "适应",
                                "target_lang_sense_clarification": "指调整自己以符合新情况"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}