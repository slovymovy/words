                            {
                                "example_id": "278b9b03-74e9-4430-8663-125845d02e17",
                                "sense_id": "020b72a7-2db2-339f-8b65-7d7f37de061a",
                                "text": "Wir eröffnen demnächst unsere Dependance in Konstanz."
                            }
