                {
                    "sense_id": "70d7082e-4002-3e0d-9c99-5b80bd0080a9",
                    "sense_definition": "Se déplacer d'un mouvement continu et fluide, en parlant d'un liquide.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "mouvement_liquide",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La rivière <w>coule</w> tranquillement à travers la vallée avant de rejoindre la mer."
                        },
                        {
                            "text": "Pendant que tu te brosses les dents, ne laisse pas <w>couler</w> l'eau du robinet."
                        }
                    ],
                    "common_phrases": [
                        "laisser couler l'eau",
                        "faire couler l'eau"
                    ]
                },
                {
                    "sense_id": "a43c040d-c462-3509-960c-e14685b1137c",
                    "sense_definition": "S'enfoncer dans l'eau et descendre vers le fond, sombrer.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "sombrer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après avoir heurté un rocher, le petit bateau a commencé à <w>couler</w> rapidement."
                        },
                        {
                            "text": "Si une pierre lourde tombe dans le lac, elle va immédiatement <w>couler</w> au fond."
