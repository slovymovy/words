                        "sense_id": "22800bbb-e411-32fc-af41-3d5394a56935",
                        "entry_id": "b7de5eda-8dbc-3488-9edb-843be9667994",
                        "glosses": [
                            "Matière scolaire traitant des sciences économiques et sociales."
