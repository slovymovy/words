                    {
                        "sense_id": "800a1414-6fa8-3159-aa5c-deecbfc25fe2",
                        "entry_id": "53a0dcfe-df9e-3678-9b44-dde4a8a61927",
                        "glosses": [
                            "Qualifie un nez dont le bout est un peu relevé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b5c6356-a6a5-465a-80c9-0932563f67c0",
                                "sense_id": "800a1414-6fa8-3159-aa5c-deecbfc25fe2",
                                "text": "Son visage est tout rond et tout rose et son nez est si retroussé qu’on dit, et ça l’amuse, qu’à travers lui on lit dans sa tête ses pensées."
                            }
                        ]
                    },
                    {
                        "sense_id": "fc3ccddb-7f84-3981-96ad-25345cefd1e9",
                        "entry_id": "53a0dcfe-df9e-3678-9b44-dde4a8a61927",
                        "glosses": [
                            "Ramené, remonté, s’agissant d’un vêtement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8dc6cd3-de27-4b6f-9407-8986b96973a8",
                                "sense_id": "fc3ccddb-7f84-3981-96ad-25345cefd1e9",
                                "text": "Fandor, le pantalon retroussé, le col du pardessus relevé, traversait stoïquement sous la pluie l’esplanade des Invalides."
                            }
                        ]
                    }
                ],
