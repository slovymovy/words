                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e065b3c-ff27-49de-a0f4-fd957f9a1e8c",
                                "sense_id": "2a218124-8ebb-343a-9849-58f1eaad76cf",
                                "text": "De bewapening van de politie 'schiet te kort' meldde het ochtendblad."
                            }
                        ]
                    },
                    {
                        "sense_id": "31addf49-4304-3d65-bbe3-4ed0a1f5123e",
                        "entry_id": "953ccbbb-056f-37ba-8433-9d4b809ed573",
                        "glosses": [
                            "de verschafte wapens die iemand in handen heeft"
