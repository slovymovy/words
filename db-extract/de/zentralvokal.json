                "senses": [
                    {
                        "sense_id": "176bf082-b0f4-31c9-9805-b5ccd4c4a208",
                        "entry_id": "44a45962-1db5-3044-8f09-e2e03ada532a",
                        "glosses": [
                            "deutsche Bezeichnung vor allem für den Schwa-Laut [ə]. Der Vokal liegt bei der Darstellung der Vokale in einem Vokaldreieck genau im Zentrum; er hat weder das artikulatorische Merkmal vorne noch hinten. Daher wohl diese Bezeichnung."
                        ],
                        "tags": [
                            "speziell Phonetik"
                        ],
                        "examples": [
                            {
                                "example_id": "51921466-0e36-4b99-9b8c-4cfe95786105",
                                "sense_id": "176bf082-b0f4-31c9-9805-b5ccd4c4a208",
                                "text": "Das [ə] (Schwa) ist ein Zentralvokal. Der letzte Laut in dem Wort \"Tante\" [ˈtantə] ist ein Schwa und daher ein Zentralvokal. Nach Hakkarainen hat auch der Laut [ɐ] das phonetische Merkmal zentral und kann daher als ein Zentralvokal angesehen werden."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
