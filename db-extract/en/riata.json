                        ],
                        "examples": [
                            {
                                "example_id": "4eff1415-b4a8-478c-b7ee-5e16ed83fdcf",
                                "sense_id": "6530e401-affa-36e9-9f94-2d360a02dc8b",
                                "text": "“You double-crossing devil,” the young man growled. “[…] Hereafter you'll trot ahead of me at the end of a riata, while I keep you on the jump with a four-horse whip. Right now you're scattering my dunnage from hell to breakfast, […]”"
                            },
                            {
                                "example_id": "5b923692-f16e-4281-ab0f-a8d526bea0cb",
                                "sense_id": "6530e401-affa-36e9-9f94-2d360a02dc8b",
                                "text": "A few blocks from the capitol we stripped him, cut off everything hanging between his legs, then fixed him with a riata and dragged him up and down Congress."
                            }
                        ]
                    }
