                "senses": [
                    {
                        "sense_id": "76df2175-d051-3e3f-b514-97ac0b10d764",
                        "entry_id": "267e7203-260e-3ad2-a775-549eaee84b00",
                        "glosses": [
                            "Any of the genus Eptesicus of several small bats."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8377c9b1-f7e1-47a3-bee7-50aa76f65798",
                        "source_entry_id": "267e7203-260e-3ad2-a775-549eaee84b00",
                        "source_sense_id": "76df2175-d051-3e3f-b514-97ac0b10d764",
                        "source_sense_description": "any of several small bats of the genus Eptesicus",
                        "target_lang_word": "sérotine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sérotine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "76b6c727-831d-3890-b0ef-d7d21038f6f7",
                                        "entry_id": "f9dab66b-a326-3f2e-a718-1351068ac5c4",
                                        "glosses": [
                                            "Espèce de chauve-souris du genre Eptesicus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58bad481-d152-45c6-91fe-836d3bb944f7",
                                                "sense_id": "76b6c727-831d-3890-b0ef-d7d21038f6f7",
                                                "text": "Nous nommerons sérotine la quatrième espèce, qui n’étoit nullement connue ; elle est plus petite que la chauve-souris et que la noctule ; elle est à peu près de la grandeur de l’oreillard, mais elle en diffère par les oreilles qu’elle a courtes et pointues, et par la couleur du poil ; elle a les ailes plus noires et le poil d’un brun plus foncé."
                                            },
                                            {
                                                "example_id": "468f748e-1fb1-4b39-9ecd-c7e83d1e9860",
                                                "sense_id": "76b6c727-831d-3890-b0ef-d7d21038f6f7",
                                                "text": "Taphien de l’île Maurice, taphien des tombeaux, molosse d’Angola, molosse du Nigéria, petit molosse, molosse d’Égypte, minioptère de Schreibers, sérotine de Rendall, pipistrelle rouille… comptent parmi les autres espèces de chiroptères que l’on peut rencontrer dans le delta."
                                            },
                                            {
                                                "example_id": "f35ce231-291f-43c2-9b6c-4a7c3f0ff16b",
                                                "sense_id": "76b6c727-831d-3890-b0ef-d7d21038f6f7",
                                                "text": "En fait de mammifères, la zone forestière possède, outre le rongeur resté inconnu, la taupe européenne, la leucode aranivore, la sérotine, l’ours, la martre, la loutre vulgaire, le mus arianus, un campagnol, le cerf, le sanglier, enfin le bison, nommé zoubr dans le pays."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a9312902-7ed8-3340-9353-3da6ecba1e60",
                                        "entry_id": "f9dab66b-a326-3f2e-a718-1351068ac5c4",
                                        "glosses": [
                                            "Une des six espèces de pommes distinguées par Théophraste dans son Histoire des Plantes, variété tardive."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "sérotine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "46b71076-8c20-3b99-9c30-e2a020557bf7",
                                        "entry_id": "174edcd8-1969-35a2-994e-3b7baf0b47e3",
                                        "glosses": [
                                            "Membrane qui est entre l'utérus et le placenta, et ne tombe pas avec lui."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3af7a050-ab4d-4b4d-9fdc-8cda246ab834",
                                                "sense_id": "46b71076-8c20-3b99-9c30-e2a020557bf7",
                                                "text": "La Sérotine a reçu les appellations de placenta maternel, de membrane secondaire, intermédiaire, utéro-épichoriale , inter-utéro-placentaire, etc. A bien des égards, elle se distingue des caduques directe et réfléchie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6af3b6ac-e477-4793-b103-9d03cf323be8",
                        "source_entry_id": "267e7203-260e-3ad2-a775-549eaee84b00",
                        "source_sense_id": "76df2175-d051-3e3f-b514-97ac0b10d764",
