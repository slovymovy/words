                                        "entry_id": "76de6d07-7eda-3b2f-bfe9-8d1bb14107c4",
                                        "glosses": [
                                            "Le plus petit continent du monde, au sud-ouest de l’océan Pacifique et à l’est de l’océan Indien."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "248597e2-4fa6-4c3c-9dcd-589e5e3ec2bd",
                                                "sense_id": "4faaf29a-3a3f-366d-a7f5-c5581dc388a5",
                                                "text": "L’Australie entre dans l’ère des autoroutes intelligentes"
                                            },
                                            {
                                                "example_id": "f72f1820-0b01-4a6b-a102-cc79e3219b82",
                                                "sense_id": "4faaf29a-3a3f-366d-a7f5-c5581dc388a5",
                                                "text": "Le repas était composé d'un délicieux gigot d'agneau, viande que l'Australie produisait en abondance."
                                            },
                                            {
                                                "example_id": "2bb3498c-a9c0-473b-8a5c-6f771451df5f",
                                                "sense_id": "4faaf29a-3a3f-366d-a7f5-c5581dc388a5",
                                                "text": "On sait que des populations ont atteint l'Australie il y a près de 65 000 ans, et elles ont probablement d'abord dû traverser l'archipel indonésien oriental Wallacea, dont Sulawesi fait partie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2652d34b-3354-35cd-9276-97a5a8fed605",
                                        "entry_id": "76de6d07-7eda-3b2f-bfe9-8d1bb14107c4",
                                        "glosses": [
                                            "Le pays occupant la totalité de ce continent, et l'île de Tasmanie, avec pour capitale Canberra."
                                        ],
                                        "tags": [
                                            "Pays"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b93ede98-e1db-4664-9eb9-08169b355bdb",
                                                "sense_id": "2652d34b-3354-35cd-9276-97a5a8fed605",
                                                "text": "L’Afrique du Sud, avec la fin de l’apartheid a vu ainsi affluer des migrants venus du Mozambique, de Zambie ou d’Angola quand les Afrikaners partaient vers l’Australie ou l’Amérique."
                                            }
                                        ]
                                    }
                                ]
                            }
