                        "examples": [
                            {
                                "example_id": "17a90c78-2200-4550-aaf6-da9aa8ec9f24",
                                "sense_id": "07fdce71-0fdd-3144-89c6-efdc7b2277be",
                                "text": "Po szkole chodziliśmy do salek na religię."
                            },
                            {
                                "example_id": "64e538b3-eda5-4ea2-b4f1-e09e71a77d7e",
                                "sense_id": "07fdce71-0fdd-3144-89c6-efdc7b2277be",
                                "text": "Odkąd katecheza odbywa się w szkole, salki stoją puste."
                            },
                            {
                                "example_id": "c5ee2083-fa5f-49a6-96a0-b189b964317e",
                                "sense_id": "07fdce71-0fdd-3144-89c6-efdc7b2277be",
                                "text": "Katecheza w salkach miała swoje plusy i minusy."
                            }
                        ],
