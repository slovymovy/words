                "translations": [
                    {
                        "translation_id": "788d0be7-e80d-4586-88f4-d9830e78e216",
                        "source_entry_id": "8a8b0c06-a0c9-356b-bc44-94f6d3b721dc",
                        "source_sense_id": "1a914e8c-2716-3001-b8fe-7eabca99f9e9",
                        "target_lang_word": "rudimentär",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rudimentär",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2925f881-92af-3481-8d43-737b7ba895fc",
                                        "entry_id": "a675ec18-f9cd-3825-af56-f479f2487f16",
                                        "glosses": [
                                            "im Laufe der Evolution verkümmert oder unvollständig entwickelt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ee9703f-25c4-4fe0-9a0e-9a07cf9f6a09",
                                                "sense_id": "2925f881-92af-3481-8d43-737b7ba895fc",
                                                "text": "Unser Steißbein ist ein rudimentärer Schwanz."
                                            },
                                            {
                                                "example_id": "29d1fe4c-bd3d-4a66-8dcc-10c2fd8740bb",
                                                "sense_id": "2925f881-92af-3481-8d43-737b7ba895fc",
                                                "text": "Beim Menschen ist das [Vomeronasale] Organ möglicherweise nur noch ein rudimentärer Rest und daher auch nicht mehr funktionsfähig."
                                            },
                                            {
                                                "example_id": "417a76f3-8cea-42b9-952a-217e10f91f34",
                                                "sense_id": "2925f881-92af-3481-8d43-737b7ba895fc",
                                                "text": "Bei allen Mäuse-Embryonen bilden sich in der frühesten Schwangerschaft fünf rudimentäre Knospen von Milchdrüsengewebe."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2cc58170-15d1-34d0-b593-ebad758f7b12",
                                        "entry_id": "a675ec18-f9cd-3825-af56-f479f2487f16",
                                        "glosses": [
                                            "in Ansätzen, als Rudiment vorhanden"
                                        ],
                                        "tags": [
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd7bf7d5-e78c-44bd-9eaa-f8cdf4494903",
                                                "sense_id": "2cc58170-15d1-34d0-b593-ebad758f7b12",
                                                "text": "Das sind bloß rudimentäre Überlegungen zu einem Thema."
                                            },
                                            {
                                                "example_id": "bca3f97a-546a-4041-bc44-68cd6c819d92",
                                                "sense_id": "2cc58170-15d1-34d0-b593-ebad758f7b12",
                                                "text": "Wann Menschen die natürlich entstandene Genitalienkollektion künstlerisch verzierten, verrät womöglich die stilistische Analyse der rudimentären Aktzeichnungen."
                                            },
                                            {
                                                "example_id": "94d69d59-169d-4a6a-9eea-dcfe435ffd17",
                                                "sense_id": "2cc58170-15d1-34d0-b593-ebad758f7b12",
                                                "text": "Wenn sich Personalchefs auf eine rudimentäre Suche von fünf Minuten pro Bewerber beschränkten, fänden sie nicht, was sie suchen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f865543e-ee53-4352-b651-28d18b57c61d",
                        "source_entry_id": "8a8b0c06-a0c9-356b-bc44-94f6d3b721dc",
                        "source_sense_id": "1a914e8c-2716-3001-b8fe-7eabca99f9e9",
                        "target_lang_word": "rudimentary",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rudimentary",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "452fad10-a4d0-312e-a12c-bfa502fc1d52",
                                        "entry_id": "4792aaef-455b-3887-bd80-b6807019f643",
                                        "glosses": [
                                            "Of or relating to one or more rudiments."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b0c46cc-7b83-4092-a735-685da1d6d14c",
                                                "sense_id": "452fad10-a4d0-312e-a12c-bfa502fc1d52",
                                                "text": "I have only a rudimentary grasp of chemistry."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bc0460a8-e518-3cbe-8d23-aa89f522778f",
                                        "entry_id": "4792aaef-455b-3887-bd80-b6807019f643",
                                        "glosses": [
                                            "Basic; minimal; with less than, or only the minimum, necessary."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2719de3-7992-4b26-b48f-d6c2c2b78e70",
                                                "sense_id": "bc0460a8-e518-3cbe-8d23-aa89f522778f",
                                                "text": "His grasp of rudimentary English allowed him at least to do the shopping."
                                            },
                                            {
                                                "example_id": "815fc625-aa12-41b0-8808-ca32e6a8faf9",
                                                "sense_id": "bc0460a8-e518-3cbe-8d23-aa89f522778f",
                                                "text": "His rudimentary driving skills meant that he was a danger on the road."
                                            },
                                            {
                                                "example_id": "6aef3e78-1590-4a01-bac0-b3e2f905dbcb",
                                                "sense_id": "bc0460a8-e518-3cbe-8d23-aa89f522778f",
                                                "text": "Using a tractor fan, shock absorbers, PVC pipes, a bicycle frame and anything else he could lay his hands on, he then built a rudimentary wooden tower, plonked his home-made generator on the top, and eventually got one, and then four bulbs to light up."
                                            },
                                            {
                                                "example_id": "c38ace22-5d60-46df-a7fd-1d1e41838f0a",
                                                "sense_id": "bc0460a8-e518-3cbe-8d23-aa89f522778f",
                                                "text": "Safdar, in his rudimentary ambulance, has been at the frontline of the shifting conflicts consuming his city, placing himself at huge personal risk for very little money."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "rudimentary",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "42f06111-1c57-3ebf-a0a0-b4aa8d8b2c91",
                                        "entry_id": "5a48953f-1437-386c-9f37-1d7cf1f58fbc",
                                        "glosses": [
                                            "One of the rudimentary mammae of boars."
                                        ],
                                        "tags": [
                                            "plural-normally"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bea5ef10-dff0-4763-a9e3-c966af42d7cc",
                        "source_entry_id": "8a8b0c06-a0c9-356b-bc44-94f6d3b721dc",
                        "source_sense_id": "1a914e8c-2716-3001-b8fe-7eabca99f9e9",
                        "target_lang_word": "rudimentaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rudimentaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5466d135-6a04-3259-b4c6-323089bf109e",
                                        "entry_id": "44abdd95-84e3-3e7e-9cda-77cb5da39b1b",
                                        "glosses": [
                                            "Qui a le caractère d’un rudiment, d’une ébauche."
                                        ],
                                        "tags": [
                                            "Surtout dans le cadre de l’histoire naturelle"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a291a325-c4da-43c3-a237-a164bb98300f",
                                                "sense_id": "5466d135-6a04-3259-b4c6-323089bf109e",
                                                "text": "L'odorat, qui a pour siège les poils olfactifs est, chez lui, rudimentaire, et partiellement inhibé par la vision."
                                            },
                                            {
                                                "example_id": "f3f9440e-cd7a-4339-8a94-00ecc76d6a28",
                                                "sense_id": "5466d135-6a04-3259-b4c6-323089bf109e",
                                                "text": "— (les Martiens, au moyen d’une drogue procurant des rêves magnifiques, supprimaient les malades, les infirmes et les mal nés, de sorte que, chez eux, la pitié était des plus rudimentaires) —"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "50d4b9e1-bd7e-367c-a20d-0056cd9ab03c",
                                        "entry_id": "44abdd95-84e3-3e7e-9cda-77cb5da39b1b",
                                        "glosses": [
                                            "Qui en est à ses débuts, qui est à l’état d’ébauche, qui n’est pas encore développé."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8fe73cd2-5d2f-4618-b285-94654bd0656f",
                                                "sense_id": "50d4b9e1-bd7e-367c-a20d-0056cd9ab03c",
                                                "text": "Science rudimentaire."
                                            },
                                            {
                                                "example_id": "cb64c76c-9700-482a-be85-4d6b78ddefd7",
                                                "sense_id": "50d4b9e1-bd7e-367c-a20d-0056cd9ab03c",
                                                "text": "Une civilisation rudimentaire."
                                            },
                                            {
                                                "example_id": "e006cc73-3bd2-4044-b5e1-46d6fdc454e8",
                                                "sense_id": "50d4b9e1-bd7e-367c-a20d-0056cd9ab03c",
                                                "text": "Une organisation rudimentaire."
                                            },
                                            {
                                                "example_id": "ae32e164-b8aa-472f-98af-8ff3b4cfe941",
                                                "sense_id": "50d4b9e1-bd7e-367c-a20d-0056cd9ab03c",
                                                "text": "D'après ce que j'ai pu voir, tu n'es qu'un toxicomane, trop bête pour comprendre et suivre des instructions rudimentaires."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
