                "senses": [
                    {
                        "sense_id": "366ac303-032a-3dba-8d92-2ce1f3371735",
                        "entry_id": "b3764180-591e-3e78-9a68-aaab2ec46b08",
                        "glosses": [
                            "Redakteur, der sich als Mitglied einer Lokalredaktion um die Berichterstattung aus dem ortsnahen/lokalen Bereich kümmert"
                        ],
                        "tags": [
                            "Journalistik"
                        ],
                        "examples": [
                            {
                                "example_id": "47bd9fc3-c1a5-4cf0-a5e2-4289c58afcf8",
                                "sense_id": "366ac303-032a-3dba-8d92-2ce1f3371735",
                                "text": "„Lokalredakteure sind die Frontschweine des Journalismus, und man kommt von keinem Krieg unbefleckt zurück.“"
                            },
                            {
                                "example_id": "1ce0e62a-2ab7-4d59-8f83-adba854b065b",
                                "sense_id": "366ac303-032a-3dba-8d92-2ce1f3371735",
                                "text": "„Nur dreimal habe ich etwas veröffentlichen können, im Tageblatt der Stadt, allerdings mit Georgs Hilfe, der den Lokalredakteur kennt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
