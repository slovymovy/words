                    }
                ],
                "senses": [
                    {
                        "sense_id": "6f1bab8d-0259-3056-a1cd-15692634843a",
                        "entry_id": "9a494905-8075-3d1c-bfa5-c88bf6047bba",
                        "glosses": [
                            "bedekt met aangevroren mist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2dbee07d-e117-40e8-8091-439e35e6e4dd",
                                "sense_id": "6f1bab8d-0259-3056-a1cd-15692634843a",
                                "text": "Je denkt: hij komt niet meer dit jaar, dit keer blijft het voor altijd winter, voor altijd donker, het leven voor eeuwig een januari vol berijpte kunstgrasvelden en verwoed rondjes pootje-overende schaatsers. Maar nee."
                            },
                            {
                                "example_id": "60274da7-2715-4af1-a124-0ac1844bbbc7",
                                "sense_id": "6f1bab8d-0259-3056-a1cd-15692634843a",
                                "text": "'Misschien dat een enkel grasveld dus wit berijpt gaat worden, maar vanwege de warmte in de grond zal dat zeer lokaal zijn'."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0fb3bdc9-b40a-4d23-952e-6449d849616b",
                        "source_entry_id": "9a494905-8075-3d1c-bfa5-c88bf6047bba",
                        "source_sense_id": "6f1bab8d-0259-3056-a1cd-15692634843a",
                        "source_sense_description": "bedekt met aangevroren mist",
                        "target_lang_word": "hoary",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hoary",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9e2f5ca9-3b5b-31db-bbb0-7834bc7d407e",
                                        "entry_id": "cdb69582-469d-3b99-9bd2-1b0ed3ec9602",
                                        "glosses": [
                                            "White, whitish, or greyish-white."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b876377-a864-4320-93a6-57328d86a588",
                                                "sense_id": "9e2f5ca9-3b5b-31db-bbb0-7834bc7d407e",
                                                "text": "As hoary frost with spangles doth attire,\n The mossy braunches of an oke halfe ded,"
                                            },
                                            {
                                                "example_id": "ac176398-bf5c-4869-815a-e82c8907a0ad",
                                                "sense_id": "9e2f5ca9-3b5b-31db-bbb0-7834bc7d407e",
                                                "text": "But hoary Winter, unadorn'd and bare,\nDwells in the dire Retreat, and freezes there."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "278996e1-534c-3332-bf78-1580d0067160",
                                        "entry_id": "cdb69582-469d-3b99-9bd2-1b0ed3ec9602",
                                        "glosses": [
                                            "White or grey with age."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b645e5e-a43c-4db2-b273-c9d94f56ea4f",
                                                "sense_id": "278996e1-534c-3332-bf78-1580d0067160",
                                                "text": "The old man bowed his hoary head in acquiescence."
                                            },
                                            {
                                                "example_id": "2ac64ff4-3296-4a7f-b3ed-fe2519f30266",
                                                "sense_id": "278996e1-534c-3332-bf78-1580d0067160",
                                                "text": "And ever and anon a silent tear\nStole down, and trickled from his hoary beard."
                                            },
                                            {
                                                "example_id": "b1358e07-f1a3-4442-892f-531dedb27333",
                                                "sense_id": "278996e1-534c-3332-bf78-1580d0067160",
                                                "text": "And when hoary hairs shall their temples adorn,\nLike lambs they shall still in My bosom be borne."
                                            },
                                            {
                                                "example_id": "b909a5d2-3987-4af9-b7f1-adf298633ce1",
                                                "sense_id": "278996e1-534c-3332-bf78-1580d0067160",
                                                "text": "My first thought was, he lied in every word,\nThat hoary cripple, with malicious eye\nAskance to watch the working of his lie\nOn mine […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a51f7e64-c33e-37cf-820e-fc92d67b4916",
                                        "entry_id": "cdb69582-469d-3b99-9bd2-1b0ed3ec9602",
                                        "glosses": [
                                            "Of a pale silvery grey."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f5f736c2-ba2b-3fb3-85e6-5b0420954d0e",
                                        "entry_id": "cdb69582-469d-3b99-9bd2-1b0ed3ec9602",
                                        "glosses": [
                                            "Covered with short, dense, greyish white hairs."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cad586af-ea14-3571-ba97-c7a315d30268",
                                        "entry_id": "cdb69582-469d-3b99-9bd2-1b0ed3ec9602",
                                        "glosses": [
                                            "Old or old-fashioned; trite."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "27ac3a2b-a702-4c79-855c-837b7a4f6920",
                                                "sense_id": "cad586af-ea14-3571-ba97-c7a315d30268",
                                                "text": "It was, however, most interesting work, and the moulders themselves were a decent crowd, never tired of making jokes about themselves such as the hoary one that moulders did not live long, which however ran counter to the other one that no germs could live in a foundry—the atmosphere was too foul."
                                            },
                                            {
                                                "example_id": "aa280638-7ca0-462e-a55c-be3173961f70",
                                                "sense_id": "cad586af-ea14-3571-ba97-c7a315d30268",
                                                "text": "In its God-like prime, The Simpsons attacked well-worn satirical fodder from unexpected angles, finding fresh laughs in the hoariest of subjects."
                                            },
                                            {
                                                "example_id": "35b9f40e-8a74-4954-8f5f-a06b7ef7e3d7",
                                                "sense_id": "cad586af-ea14-3571-ba97-c7a315d30268",
                                                "text": "Nevertheless, the hoary capitalist principle of innovation and competition leading to consolidation and monopoly still operated."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "40c864fe-0bd0-3620-bc86-75126ed00dbc",
                                        "entry_id": "cdb69582-469d-3b99-9bd2-1b0ed3ec9602",
                                        "glosses": [
                                            "Remote in time past."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ab58d6a-2f3a-4d69-9b89-ae30cb942229",
                                                "sense_id": "40c864fe-0bd0-3620-bc86-75126ed00dbc",
                                                "text": "The probability of these flattering fictions could no longer be examined, when the hoary antiquity of such traditions had gained them veneration. An adventure of ancient date was in blind after-ages too readily received as truth."
                                            },
                                            {
                                                "example_id": "71f7c352-cb64-4e0d-84c6-f019856f8727",
                                                "sense_id": "40c864fe-0bd0-3620-bc86-75126ed00dbc",
                                                "text": "Plant and animal species of hoary antiquity or at an evolutionary dead end seem similarly outdated. Remnant exemplars of the coelacanth, the tuatara, the Joshua tree are anachronisms more at home in previous than present environments."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "120ad774-4bd4-3555-909a-b1c32f741a6e",
                                        "entry_id": "cdb69582-469d-3b99-9bd2-1b0ed3ec9602",
                                        "glosses": [
                                            "Moldy; mossy; musty."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c799130-9b55-454c-908d-0d94ec398618",
                                                "sense_id": "120ad774-4bd4-3555-909a-b1c32f741a6e",
                                                "text": "By chance there was at that time brought out of the citie into the campe verie course, hoarie, moulded bread, which some of the souldiours hauing bought, and thrusting it vpon the points of their speares, shewed it vnto their fellowes in great choller, railing against king Ferdinand, which in his owne kingdome in the beginning of the warre had made no better prouision, but with such corrupt and pestilent bread to feed them being strangers, which were onely for his defence and quarrell to aduenture their liues."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "513f2755-3bda-43b6-b05d-acc0154e3bee",
                        "source_entry_id": "9a494905-8075-3d1c-bfa5-c88bf6047bba",
                        "source_sense_id": "6f1bab8d-0259-3056-a1cd-15692634843a",
                        "source_sense_description": "bedekt met aangevroren mist",
                        "target_lang_word": "frosted",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "frosted",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cd2e3e90-08bc-341e-963f-bd19e6ea1b5b",
                                        "entry_id": "886e8d1c-d4ae-30b8-820c-7accfd9ac5b5",
                                        "glosses": [
                                            "Covered in frost; frosty."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c257dab7-180b-4385-bb37-a4e6b64d55a2",
                                                "sense_id": "cd2e3e90-08bc-341e-963f-bd19e6ea1b5b",
                                                "text": "Eiswein is made from frosted grapes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce6eba42-c7fe-3e3c-be30-b8bb26555f7a",
                                        "entry_id": "886e8d1c-d4ae-30b8-820c-7accfd9ac5b5",
                                        "glosses": [
                                            "Translucent, appearing to be covered in frost."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ced6059-db15-431d-9ffb-772e5e59ab6f",
                                                "sense_id": "ce6eba42-c7fe-3e3c-be30-b8bb26555f7a",
                                                "text": "She installed frosted windows, since there was a clear view of her bathroom from her neighbor's bedroom."
                                            },
                                            {
                                                "example_id": "795905bc-60a1-4b6e-9e0c-5fcb30bf5918",
                                                "sense_id": "ce6eba42-c7fe-3e3c-be30-b8bb26555f7a",
                                                "text": "The point of interest about this particular specimen was that it must have remained intact for at least a quarter of a century, as it had embossed in the frosted glass the initials of the old Great North of Scotland Railway in the form of a scroll, the sort of relic of pre-grouping days that can still be found here and there if one is observant."
                                            },
                                            {
                                                "example_id": "b08e03b4-0047-4f39-8977-d20fca84a477",
                                                "sense_id": "ce6eba42-c7fe-3e3c-be30-b8bb26555f7a",
                                                "text": "The vestibule has a row of brass mailboxes and a varnished umbrella rack and a rubber mat on the marble floor and two doors, one to the right with frosted glass and another in front of them of wire-reinforced glass through which he sees rubber-treaded stairs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8ff3aa14-c421-3e66-b6c2-f8cfd109312c",
                                        "entry_id": "886e8d1c-d4ae-30b8-820c-7accfd9ac5b5",
                                        "glosses": [
                                            "Damaged by frost."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba79abc0-a1c2-4ee1-b8c0-9b0dc2ddc9aa",
                                                "sense_id": "8ff3aa14-c421-3e66-b6c2-f8cfd109312c",
                                                "text": "Frosted fruit will be unsalable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2bb31d37-7e8e-34ec-89b8-a074bf8bddb5",
                                        "entry_id": "886e8d1c-d4ae-30b8-820c-7accfd9ac5b5",
                                        "glosses": [
                                            "Extremely intoxicated."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "202a9550-bd64-43ca-a39c-3b1cf432f568",
                                                "sense_id": "2bb31d37-7e8e-34ec-89b8-a074bf8bddb5",
                                                "text": "I was so frosted after drinking that 12-pack."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "frosted",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "820f4c47-c18b-384d-b99f-109e47185d78",
                                        "entry_id": "b933108d-0c92-3e59-82a3-bb386f2f3a38",
                                        "glosses": [
                                            "A kind of milkshake made with ice cream."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c15a0f1-7453-434e-ba7d-947b99b91669",
                                                "sense_id": "820f4c47-c18b-384d-b99f-109e47185d78",
                                                "text": "Except for those times when I am drugging myself with movies, vanilla frosteds, the latest novel, or cremes de nepenthe, it is difficult for me to avoid the bothersome thought […]"
                                            },
                                            {
                                                "example_id": "ce300de4-be29-4579-9ce6-d295b97663b9",
                                                "sense_id": "820f4c47-c18b-384d-b99f-109e47185d78",
                                                "text": "They had continued to laugh at the milk bar, tasting in the chocolate frosteds the unlikely flavor of Mr. Mather's turpitude."
                                            },
                                            {
                                                "example_id": "ca616668-ec6e-4b07-99e7-6734f045edac",
                                                "sense_id": "820f4c47-c18b-384d-b99f-109e47185d78",
                                                "text": "Opening with standard flavors and moving quickly to grape, raspberry, blueberry, cinnamon, apple and the frosteds, the variety is putting many chains in a one-out-for-every-one-in frame of mind."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "frosted",
                                "target_lang_code": "en",
                                "target_senses": [
