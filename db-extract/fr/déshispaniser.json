                "senses": [
                    {
                        "sense_id": "f503d886-86bf-3284-ba68-61c6a525d11d",
                        "entry_id": "2daf6f8f-c973-3bed-9bdf-8f6912ee8abb",
                        "glosses": [
                            "Faire perdre à quelque chose son caractère hispanique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e7d38c8-b43c-49c6-8f62-2f866fbeff25",
                                "sense_id": "f503d886-86bf-3284-ba68-61c6a525d11d",
                                "text": "Mais elle rêve surtout de déshispaniser le pays."
                            },
                            {
                                "example_id": "cbbef993-f713-46c7-a41a-5a5abd6b3c4a",
                                "sense_id": "f503d886-86bf-3284-ba68-61c6a525d11d",
                                "text": "il a fallu l'électricité pour déshispaniser la guitare."
                            },
                            {
                                "example_id": "2bbb495e-2b2a-4d1e-aedf-9bc3ad2ef83d",
                                "sense_id": "f503d886-86bf-3284-ba68-61c6a525d11d",
                                "text": "L'objectif n'est pas de \"désislamiser\" ou de \"déshispaniser\" mais de permettre aux peuples européens de conserver leur souveraneté qu'ils perdraient en devenant minoritaires et un territoire pour assurer leur survie."
                            }
                        ]
                    }
