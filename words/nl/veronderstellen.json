{
    "word_family": [
        "veronderstelling"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b8959489-333e-3f1a-8b43-79ffd7995915",
                    "sense_definition": "iets als waar aannemen zonder dat het bewezen is",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "aanname",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij <w>veronderstelde</w> ten onrechte dat dit met gejuich begroet zou worden.",
                            "target_lang_translations": {
                                "en": "He wrongly <w>assumed</w> that this would be greeted with cheers."
                            }
                        },
                        {
                            "text": "Laten we voor een moment <w>veronderstellen</w> dat het plan wel werkt.",
                            "target_lang_translations": {
                                "en": "Let's <w>suppose</w> for a moment that the plan does work."
                            }
                        }
                    ],
                    "synonyms": [
                        "aannemen",
                        "vermoeden",
                        "supponeren"
                    ],
                    "antonyms": [
                        "weten",
                        "bewijzen"
                    ],
                    "common_phrases": [
                        "laten we veronderstellen",
                        "ten onrechte veronderstellen"
                    ],
                    "target_lang_definitions": {
                        "en": "To accept something as true without proof or evidence."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "assume",
                                "target_lang_sense_clarification": "to take for granted without proof"
                            },
                            {
                                "target_lang_word": "suppose",
                                "target_lang_sense_clarification": "to believe or conclude based on limited data"
                            },
                            {
                                "target_lang_word": "presume",
                                "target_lang_sense_clarification": "to take for granted as being likely"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "938bf764-0ae2-3e9c-8ffd-6bfb5da02a74",
                    "sense_definition": "als noodzakelijke voorwaarde met zich meebrengen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "vereiste",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Deze functie <w>veronderstelt</w> een grote mate van zelfstandigheid.",
                            "target_lang_translations": {
                                "en": "This position <w>presupposes</w> a high degree of independence."
                            }
                        },
                        {
                            "text": "Het begrijpen van deze tekst <w>veronderstelt</w> enige voorkennis van de geschiedenis.",
                            "target_lang_translations": {
                                "en": "Understanding this text <w>requires</w> some prior knowledge of history."
                            }
                        }
                    ],
                    "synonyms": [
                        "vereisen",
                        "vergen"
                    ],
                    "common_phrases": [
                        "een zekere voorkennis veronderstellen"
                    ],
                    "target_lang_definitions": {
                        "en": "To involve or require as a necessary condition."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "presuppose",
                                "target_lang_sense_clarification": "to require as a prior condition"
                            },
                            {
                                "target_lang_word": "assume",
                                "target_lang_sense_clarification": "to take as a necessary basis for something"
                            },
                            {
                                "target_lang_word": "require",
                                "target_lang_sense_clarification": "to need something as a condition"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}