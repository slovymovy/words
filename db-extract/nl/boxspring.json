                            {
                                "example_id": "bb126df9-c68b-4d8d-9db9-2705f9c06522",
                                "sense_id": "faa9db2f-22e7-3a54-8bbf-01b465c070e6",
                                "text": "'Elke kamer heeft boxsprings van Zwitserse makelij.'Dat was eigenlijk het belangrijkste, de rest geloofde Wayne wel, hij moet een goed bed hebben, met die rug."
                            },
                            {
                                "example_id": "8f19820e-849a-4f95-a9af-b6102dbf6ba9",
                                "sense_id": "faa9db2f-22e7-3a54-8bbf-01b465c070e6",
                                "text": "Het lijkt dan ook vooral de oudere garde te zijn die geld overheeft voor het niet hoeven slapen in een zweterig tentje. “Als je al een aantal festivals hebt meegemaakt, wil je toch wel wat luxe hebben”, beaamt Jan van Berkel, die de luxe tenten verhuurt. “Wij bieden dan de mogelijkheid om op een boxspring te slapen.”"
                            }
                        ]
