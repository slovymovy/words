                "senses": [
                    {
                        "sense_id": "68f99eb9-cf40-3924-9016-ff2102411fb3",
                        "entry_id": "9faf6bb2-523d-34aa-8bb0-7eefa26512c8",
                        "glosses": [
                            "Glocke auf einem Dom"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bdc0ea62-a750-480b-bd72-ece56e213c3d",
                                "sense_id": "68f99eb9-cf40-3924-9016-ff2102411fb3",
                                "text": "„Die Zurückhaltung der europäischen Glockengießereien, den Auftrag für die Domglocke anzunehmen, war nicht nur mit dem Mißgeschick des Andreas Hamm in Frankenthal zu erklären, dessen Betrieb nach dem dreimaligen Guß der Kaiserglocke in Konkurs ging.“"
                            },
                            {
                                "example_id": "d2b583ed-aef9-4c3a-90bb-e99b196ac5de",
                                "sense_id": "68f99eb9-cf40-3924-9016-ff2102411fb3",
                                "text": "„Hierin findet sich ein Lied auf die altehrwürdige, berühmte, Erfurter Domglocke mit dem wundervollen Namen Gloriosa.“"
                            },
                            {
                                "example_id": "d2199855-027b-4126-bfb9-8d4dea19ef56",
                                "sense_id": "68f99eb9-cf40-3924-9016-ff2102411fb3",
                                "text": "„Der Gerichtsstreit um die Linzer Domglocken wandert zum Obersten Gerichtshof: Das Oberlandesgericht hat nun die Berufung des Dom-Anrainers Wolfgang Lassy gegen ein Urteil des Landesgerichts abgewiesen. Der Architekt hatte bekanntlich geklagt, weil ihm der Glockenschlag den Schlaf rauben würde.“"
                            },
                            {
                                "example_id": "2e89f884-e8bd-41ee-87a0-7e262c026687",
                                "sense_id": "68f99eb9-cf40-3924-9016-ff2102411fb3",
                                "text": "„Kein stürmisches Läuten der Mainzer Domglocken zur Papstwahl, sondern die normalen Glockenschläge zur vollen Stunde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
