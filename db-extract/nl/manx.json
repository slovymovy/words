                        "entry_id": "8fd7bc19-7e9c-3c63-ba0b-010fca867536",
                        "glosses": [
                            "Keltische taal die (als tweede taal) wordt gesproken op het eiland Man"
                        ],
                        "tags": [
                            "linguistics",
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "64a50095-2689-49c4-b012-361cd50b0280",
                                "sense_id": "9642be22-9e08-3bcd-9ef7-8b51aaf30e2a",
                                "text": "De laatste echte moedertaalspreker van het Manx was Ned Maddrell, die in 1974 stierf."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4ed28a1b-c9c8-4ef0-9a59-55ecda67fa98",
                        "source_entry_id": "8fd7bc19-7e9c-3c63-ba0b-010fca867536",
                        "source_sense_id": "9642be22-9e08-3bcd-9ef7-8b51aaf30e2a",
