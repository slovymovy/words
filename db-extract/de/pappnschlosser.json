                        "examples": [
                            {
                                "example_id": "07e9bdde-8fc0-474d-8bf9-e18b538ba56b",
                                "sense_id": "a0789e1d-7036-37ab-8a02-b3c86f311df0",
                                "text": "„Den Zahnarzt bezeichnen die stets witzelnden Wiener als Pappnschlosser.“"
                            },
                            {
                                "example_id": "e8c036dd-a95c-432a-bde3-bf1c14989a7c",
                                "sense_id": "a0789e1d-7036-37ab-8a02-b3c86f311df0",
                                "text": "„Vuagestern beim Pappnschlosser how I a Sprechstundenhüf gsegn, de wos sie über jeden von meine Schmäh obpeckt hot.“"
                            },
                            {
                                "example_id": "b8fb3540-f83b-4040-a22b-7ebbd157d2bc",
                                "sense_id": "a0789e1d-7036-37ab-8a02-b3c86f311df0",
                                "text": "„Und is dera Tog a mittelalterliche Dame beim Pappnschlosser gwesn, weil hot’s a poar neiche Grandln braucht und hot er’s gscheit eingschpritzt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
