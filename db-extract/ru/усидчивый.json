                ],
                "translations": [
                    {
                        "translation_id": "1e78e101-6a11-4cc0-b115-36656b1b9fe1",
                        "source_entry_id": "7af10a40-e712-3ff8-baa3-a877cd7a4d2f",
                        "source_sense_description": "способный усердно, длительно заниматься тем, что требует сидячей работы",
                        "target_lang_word": "assiduous",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "assiduous",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "22a614e9-4502-32d0-b78b-47a0793e9210",
                                        "entry_id": "bdc3ac6a-3deb-3d18-9e90-3b02197a65b2",
                                        "glosses": [
                                            "Hard-working, diligent or regular (in attendance or work); industrious."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4518bfad-0880-4079-a391-fd3221795441",
                                                "sense_id": "22a614e9-4502-32d0-b78b-47a0793e9210",
                                                "text": "He was officious in the right time and place, quiet as a lamb when his patron seemed inclined to study or to muse, active and assiduous to assist or divert him whenever it seemed to be wished."
                                            },
                                            {
                                                "example_id": "190c7766-2b32-4366-ba50-e822ac1d8103",
                                                "sense_id": "22a614e9-4502-32d0-b78b-47a0793e9210",
                                                "text": "He died after three weeks' illness, during which Mrs. Penniman, as well as his daughter, had been assiduous at his bedside."
                                            },
                                            {
                                                "example_id": "3a18b4dd-67d1-4b09-ad50-f9f263e07ba0",
                                                "sense_id": "22a614e9-4502-32d0-b78b-47a0793e9210",
                                                "text": "A good deal of assiduous attention had enabled Henry to win this place in her affections."
                                            },
                                            {
                                                "example_id": "eef6b0ce-cfa3-4634-88f9-390819b63781",
                                                "sense_id": "22a614e9-4502-32d0-b78b-47a0793e9210",
                                                "text": "The most recent attempt to contact Pioneer 10 was on 6-7 February 2003. But in this case, the Madrid station got conclusively null results after an assiduous search."
                                            },
                                            {
                                                "example_id": "7a0b39a6-e6de-417a-8eab-b09518013da6",
                                                "sense_id": "22a614e9-4502-32d0-b78b-47a0793e9210",
                                                "text": "Klein rose to prominence in the 1960s by assiduous application of accounting methods to the music industry."
                                            },
                                            {
                                                "example_id": "3fca8a83-c86a-4878-89aa-d21d0ac2c7b2",
                                                "sense_id": "22a614e9-4502-32d0-b78b-47a0793e9210",
                                                "text": "“Asteroid City,” the latest from Wes Anderson, is filled with the assiduous visuals, mythic faces and charming curiosities that you expect from this singular filmmaker."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0c0d4e4c-2a16-475f-bee5-0fc5800fe4b7",
                        "source_entry_id": "7af10a40-e712-3ff8-baa3-a877cd7a4d2f",
                        "source_sense_description": "способный усердно, длительно заниматься тем, что требует сидячей работы",
                        "target_lang_word": "diligent",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "diligent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fa62f3bf-3e38-3afa-96b3-dad7fa075808",
                                        "entry_id": "044b9642-b49a-3463-9ee0-ba2f1e83a3e0",
                                        "glosses": [
                                            "Performing with industrious concentration; hard-working and focused."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e96d6af-b7d3-48e8-b059-f706a930d5ba",
                                                "sense_id": "fa62f3bf-3e38-3afa-96b3-dad7fa075808",
                                                "text": "Scientists are very diligent in their work."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c29feae3-f837-4775-85d6-2a40cfae8128",
                        "source_entry_id": "7af10a40-e712-3ff8-baa3-a877cd7a4d2f",
                        "source_sense_description": "способный усердно, длительно заниматься тем, что требует сидячей работы",
                        "target_lang_word": "assidu",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "assidu",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1c0af34a-98ba-3821-badf-cfd2cd59992e",
                                        "entry_id": "f8d7cd4b-cdd9-3dfb-81a9-474b4944eecb",
                                        "glosses": [
                                            "Qui fait preuve d’assiduité."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "literally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3e61109-957f-4223-812f-0fcc407bc42a",
                                                "sense_id": "1c0af34a-98ba-3821-badf-cfd2cd59992e",
                                                "text": "Magistrat assidu aux audiences."
                                            },
                                            {
                                                "example_id": "46e8d901-fb84-4a81-b0d4-44521ca5bb52",
                                                "sense_id": "1c0af34a-98ba-3821-badf-cfd2cd59992e",
                                                "text": "Écolier assidu au travail."
                                            },
                                            {
                                                "example_id": "0ae6757e-c659-4651-a716-12203541c04c",
                                                "sense_id": "1c0af34a-98ba-3821-badf-cfd2cd59992e",
                                                "text": "Être fort assidu auprès du prince."
                                            },
                                            {
                                                "example_id": "abfe6e47-7aee-4a61-8801-e160f59793b2",
                                                "sense_id": "1c0af34a-98ba-3821-badf-cfd2cd59992e",
                                                "text": "Il était fort assidu auprès de cette femme."
                                            },
                                            {
                                                "example_id": "87bb4a61-874a-4002-984e-427c8622fc98",
                                                "sense_id": "1c0af34a-98ba-3821-badf-cfd2cd59992e",
                                                "text": "Martin de l’Aisne, député au Corps législatif en 1809, fut nommé l’année suivante membre de la commission des finances, dont les travaux assidus et secrets convenaient à son esprit laborieux et timide."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a610d0db-c38c-385a-8885-5bbb0de628d0",
                                        "entry_id": "f8d7cd4b-cdd9-3dfb-81a9-474b4944eecb",
                                        "glosses": [
                                            "Qui est continu, qui se répète fréquemment."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec8d6875-f0ba-40d1-ac89-4eebe54671fa",
                                                "sense_id": "a610d0db-c38c-385a-8885-5bbb0de628d0",
                                                "text": "La famille entretenait un culte marial assidu. Les grands-mères et arrière-grands-mères avaient toutes accompli le pèlerinage de Lourdes. Le folklore conservait de ces antiques pérégrinations quelques histoires scabreuses […]."
                                            },
                                            {
                                                "example_id": "c37d30e6-a94a-483b-9a65-05984c745ddc",
                                                "sense_id": "a610d0db-c38c-385a-8885-5bbb0de628d0",
                                                "text": "Reconnaissons que l’infidélité plurielle, systématique, récurrente et assidue, est plus facilement revendiquée par les hommes, en particulier par ceux qui prônent le papillonnage érotico-relationnel, et qu'elle reste assez mal perçue chez les femmes, à qui l'on prête moins facilement le droit à de nombreuses aventures sans lendemain."
                                            },
                                            {
                                                "example_id": "63e2d371-a9f2-4522-8055-70c234466808",
                                                "sense_id": "a610d0db-c38c-385a-8885-5bbb0de628d0",
                                                "text": "C'est désormais au Pakistan, ou en Iran, que la fréquentation des sites de téléchargement de films X est le plus assidue. Qui sait quelles bombes mentales s'allument dans les nuits solitaires de Kaboul ou de Karachi ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
