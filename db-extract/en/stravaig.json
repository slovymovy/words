                        "examples": [
                            {
                                "example_id": "d501bdd9-8944-4b8f-a831-2263758b64a9",
                                "sense_id": "1bb683c5-f552-37dc-8f65-270d44a415eb",
                                "text": "Whenever we came to any habitations now he would not call at back doors, nor go stravaiging in yards for odd pieces to eat, but he would go gallantly into an inn and offer his payment for the things we would like."
                            },
                            {
                                "example_id": "0380bb91-12f1-4be0-b438-e15fe4fdcc0c",
                                "sense_id": "1bb683c5-f552-37dc-8f65-270d44a415eb",
                                "text": "It is tedious work, training clematis over low posts, so that its beauty does not stravaig up the walls but lies open under the eye; but on the edge of the town many gardeners grew it thus."
                            },
                            {
                                "example_id": "f0e02b0b-4bad-4425-b428-c0a858eafd61",
                                "sense_id": "1bb683c5-f552-37dc-8f65-270d44a415eb",
                                "text": "Michael, stop stravaiging along behind."
                            }
                        ]
                    }
                ],
