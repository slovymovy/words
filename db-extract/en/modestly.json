                                            "plural"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "bescheiden",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "faeb51f3-15b7-377d-abac-70a1fe35f828",
                                        "entry_id": "1a0189e3-19ca-3cde-b15d-42aaa40fa8be",
                                        "glosses": [
                                            "over iemand beslissen, iets bepalen"
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2d25c0af-2406-4b19-952b-d515d17c8fbe",
                                                "sense_id": "faeb51f3-15b7-377d-abac-70a1fe35f828",
                                                "text": "Niemand weet wat God over hem bescheiden heeft."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bescheiden",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "de3aa648-1b5c-3016-a97a-623c327811fd",
                                        "entry_id": "12a944cd-6457-3f58-b219-b3b60240bfc1",
