                        "sense_id": "879de58d-1832-34ee-96e9-b8b3d1111a8b",
                        "entry_id": "c490f058-d72f-3aa6-9789-d0ddd5cb85de",
                        "glosses": [
                            "Cabaret ; endroit où se réunissent les voleurs."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "5328a2ea-ef95-44fe-9101-53462988218d",
                                "sense_id": "879de58d-1832-34ee-96e9-b8b3d1111a8b",
                                "text": "Un tapis-franc, en argot de vol et de meurtre, signifie un estaminet ou un cabaret du plus bas étage."
                            },
                            {
                                "example_id": "7461934c-7290-493b-b18e-5b309c74c59e",
                                "sense_id": "879de58d-1832-34ee-96e9-b8b3d1111a8b",
                                "text": "A l'argot du tapis-franc le Maître d'école avait substitué un langage presque recherché, qui annonçait un esprit cultivé et contrastait étrangement avec ses forfanteries sanguinaires."
                            },
                            {
                                "example_id": "e3c7f3bf-c40d-40a7-9127-d436289eac4f",
                                "sense_id": "879de58d-1832-34ee-96e9-b8b3d1111a8b",
                                "text": "J’ai fait des études de mœurs que peu de gens ont pu faire, dans les cours des miracles et les tapis francs des juifs de la Turquie."
                            }
                        ]
                    }
                ],
