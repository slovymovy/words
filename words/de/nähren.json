                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "nahrungsaufnahme",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Viele Wildtiere im dichten Wald <w>nähren</w> sich im Herbst hauptsächlich von Nüssen und Eicheln."
                        },
                        {
                            "text": "Auf der anstrengenden Reise durch die Wildnis <w>nährten</w> sie sich fast ausschließlich von Beeren."
                        }
                    ],
                    "synonyms": [
                        "leben"
                    ],
                    "common_phrases": [
