                "senses": [
                    {
                        "sense_id": "e7faf770-0767-35b3-b584-41efad40de4b",
                        "entry_id": "08370954-7563-388e-98c0-00da49941139",
                        "glosses": [
                            "Person, die (auch) in den Wintermonaten (bei kaltem Wetter) (regelmäßig/öfter) läuft"
                        ],
                        "tags": [
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "fe40128c-fb76-4902-94aa-39320762eca8",
                                "sense_id": "e7faf770-0767-35b3-b584-41efad40de4b",
                                "text": "„Trotz oft schwierigen Wetterbedingten – war das Streckenbild doch nicht selten von der Witterung gezeichnet – zeigten sich die ‚Winterläufer’ unbeeindruckt und erschienen dennoch zahlreich Sonntagmorgens am Sportplatz Gropiusring.“"
                            },
                            {
                                "example_id": "e9b3405f-264b-4bdb-8ee4-838a580e1d8d",
                                "sense_id": "e7faf770-0767-35b3-b584-41efad40de4b",
                                "text": "„Für Winterläufer hat C3fit in seine Kompressionshose Kodenshi Thermal Long Tights die selbst entwickelte, technische Kodenshi Faser eingearbeitet.“"
                            },
                            {
                                "example_id": "bac5f4e5-a0f5-403c-98cd-c10ad1af70a5",
                                "sense_id": "e7faf770-0767-35b3-b584-41efad40de4b",
                                "text": "„Wir sind gespannt wie sich die ‚Winterläufer‘ schlagen und hoffen, dass sie alle wieder gesund und glücklich im Ziel ankommen.“"
                            },
                            {
                                "example_id": "59ed5272-d2fe-44af-9702-d1b0d48e162a",
                                "sense_id": "e7faf770-0767-35b3-b584-41efad40de4b",
                                "text": "„53 Winterläufer, davon acht Frauen, schafften bei den fünf Läufen die 20 km und stehen nun zum Abschluss mit 100 km in der Gesamtwertung.“"
                            },
                            {
                                "example_id": "6c561121-1bbb-45ba-945d-72524ec6fa40",
                                "sense_id": "e7faf770-0767-35b3-b584-41efad40de4b",
                                "text": "„Für alle Winterläufer hat ‚Being fit is fun‘ einige Tipps wie man den Lauf durch die Kälte noch ein bisschen besser meistern kann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
