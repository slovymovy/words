                        "cross_references": []
                    },
                    {
                        "translation_id": "0e6d653b-7dab-4c3f-a6f0-074393f5f989",
                        "source_entry_id": "23d836cc-6ac0-381a-8018-3fd2aa199613",
                        "target_lang_word": "undress",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "undress",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "03f16b5b-880c-34ad-8120-b231dda32f31",
                                        "entry_id": "bcc10e33-fca8-3179-8fe8-e2679545501b",
                                        "glosses": [
                                            "To remove one's clothing."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ac47761-a6aa-43c0-bb5f-6617c6ab338c",
                                                "sense_id": "03f16b5b-880c-34ad-8120-b231dda32f31",
                                                "text": "She undressed herself before putting on her bedclothes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fca4dbe1-80f8-3dca-96b0-0cd6d7bb8d4b",
                                        "entry_id": "bcc10e33-fca8-3179-8fe8-e2679545501b",
                                        "glosses": [
                                            "To remove one’s clothing."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be05d0b4-9b27-4905-8272-83b4ba58632f",
                                                "sense_id": "fca4dbe1-80f8-3dca-96b0-0cd6d7bb8d4b",
                                                "text": "The doctor asked me to undress for the examination."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "014ef863-f161-3b60-811f-b51f770593e3",
                                        "entry_id": "bcc10e33-fca8-3179-8fe8-e2679545501b",
                                        "glosses": [
                                            "To remove the clothing of (someone)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "40847fda-4599-49bb-9ea8-5088032d6188",
                                                "sense_id": "014ef863-f161-3b60-811f-b51f770593e3",
                                                "text": "Mary began to undress her daughter in preparation for bathtime."
                                            },
                                            {
                                                "example_id": "0fa24ebb-ec2f-4c6a-8adb-29625d59cc94",
                                                "sense_id": "014ef863-f161-3b60-811f-b51f770593e3",
                                                "text": "The young men slowly and sensually undressed each other before making passionate love."
                                            },
                                            {
                                                "example_id": "3d558929-0190-42c6-9e13-c90cd415f4cd",
                                                "sense_id": "014ef863-f161-3b60-811f-b51f770593e3",
                                                "text": "You can brush my hair, undress me everywhere / Imagination, life is your creation"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "caf25ab5-a128-3f33-b985-f7d2ebf63d63",
                                        "entry_id": "bcc10e33-fca8-3179-8fe8-e2679545501b",
                                        "glosses": [
                                            "To strip something off."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0402b518-b40f-3e71-a705-f901e2a8cf64",
                                        "entry_id": "bcc10e33-fca8-3179-8fe8-e2679545501b",
                                        "glosses": [
                                            "To take the dressing, or covering, from."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "804ae6bf-6e40-4a23-a522-d183c9ac9c9a",
                                                "sense_id": "0402b518-b40f-3e71-a705-f901e2a8cf64",
                                                "text": "to undress a wound"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "undress",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b817c99c-3221-37c6-8bbc-e39fcc5b95ad",
                                        "entry_id": "b2be8787-d187-3da9-93a6-0dbf39317a5f",
                                        "glosses": [
                                            "Partial or informal dress for women, as worn in the home rather than in public."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "historical",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e015f89-a1d1-4117-99e7-f7ba8bb83215",
                                                "sense_id": "b817c99c-3221-37c6-8bbc-e39fcc5b95ad",
                                                "text": "Here he had not waited above ten minutes, when Emilia entered in a most inchanting undress, with all the graces of nature playing about her person, and in a moment rivetted the chains of his slavery beyond the power of accident to unbind."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a2d26dda-1f80-3cd2-8e9e-2be0be08d8a8",
                                        "entry_id": "b2be8787-d187-3da9-93a6-0dbf39317a5f",
                                        "glosses": [
                                            "Informal clothing for men, as opposed to formal or ceremonial wear."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "historical",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "22cee1c2-7b81-4fab-8324-72ab041765d3",
                                                "sense_id": "a2d26dda-1f80-3cd2-8e9e-2be0be08d8a8",
                                                "text": "His undress, and the agitation he was apparently in, which she imputed to the effect of her charms, combined to make him appear more interesting both to the mother and daughter […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cbd9b40a-a526-3aea-8c56-5b81b7a1d259",
                                        "entry_id": "b2be8787-d187-3da9-93a6-0dbf39317a5f",
                                        "glosses": [
                                            "Now more specifically, a state of having few or no clothes on."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "410cfca1-5bdb-4697-98d6-11489f1a99b2",
                                                "sense_id": "cbd9b40a-a526-3aea-8c56-5b81b7a1d259",
                                                "text": "She returned to her dorm to find her roommate, fresh out of the shower, in a state of undress."
                                            },
                                            {
                                                "example_id": "73774423-7038-47bd-ad0d-3634198ce76c",
                                                "sense_id": "cbd9b40a-a526-3aea-8c56-5b81b7a1d259",
                                                "text": "The visitor, observing that she held the door on the inside, and that, when the uncle tried to open it, there was a sharp adjuration of 'Don't, stupid!' and an appearance of loose stocking and flannel, concluded that the young lady was in an undress."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8d1d5256-a89b-4818-853c-370f18ed97dd",
