                ],
                "senses": [
                    {
                        "sense_id": "42d117b0-2e92-36e3-8218-34e05d2ede76",
                        "entry_id": "bbcb0886-9a11-3b53-a79f-aa1f59b922d7",
                        "glosses": [
                            "Inverser le processus de momification."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "93af377d-4a22-397b-8b37-f181df16beae",
                        "entry_id": "bbcb0886-9a11-3b53-a79f-aa1f59b922d7",
                        "glosses": [
                            "Inverser le processus de momification.",
                            "Enlever les bandages, démailloter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c8fadea-ca85-4e65-82de-9249fa3c255d",
                                "sense_id": "93af377d-4a22-397b-8b37-f181df16beae",
                                "text": "Il lui faut deux valets pour le déshabiller avec soin et le démomifier de ses bandelettes."
                            }
                        ]
                    },
                    {
                        "sense_id": "bf788f7e-75de-3348-928f-5863e7ada136",
                        "entry_id": "bbcb0886-9a11-3b53-a79f-aa1f59b922d7",
                        "glosses": [
                            "Inverser le processus de momification.",
                            "Rendre vie à un être momifié."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ddbb7bd0-f20a-48c7-9c04-4aeb65bb2dbe",
                                "sense_id": "bf788f7e-75de-3348-928f-5863e7ada136",
                                "text": "De leur côté, Mérimée convoque les dames galantes du règne de Charles IX, Gautier démomifie les pharaons et, dans La Comtesse de Chargny, Dumas convoque tous les acteurs de la Révolution."
                            }
                        ]
                    },
                    {
                        "sense_id": "18a41220-7165-3078-bc43-9b1e571c6cf4",
                        "entry_id": "bbcb0886-9a11-3b53-a79f-aa1f59b922d7",
                        "glosses": [
                            "Faire surgir du passé, remettre au goût du jour, redonner vie."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "dbdc26f6-568e-4861-abc7-c126a6c14f60",
                                "sense_id": "18a41220-7165-3078-bc43-9b1e571c6cf4",
                                "text": "Quant à la forme, il remua la vieille langue et lui donna les allures de la vie. Il tua la périphrase. Il démomifia le vers classique et le vivifia par plus d’exactitude à la fois et de liberté, par le respect de la rime et l’enjambement."
                            }
                        ]
                    },
                    {
                        "sense_id": "9af2cdbe-41a2-3366-8b0b-8427888c299b",
                        "entry_id": "bbcb0886-9a11-3b53-a79f-aa1f59b922d7",
                        "glosses": [
                            "Libérer."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "b1d94e15-6db8-4a92-8126-9b8b45330e3c",
                                "sense_id": "9af2cdbe-41a2-3366-8b0b-8427888c299b",
                                "text": "La zone glaciale qui s’étend encor sur les domaines du cœur commence à remonter au degré de la glace fondante ; il y a progrès, les femmes tendent à se démomifier. Leur allure s’engaillardit et, leur toilette se civilise."
                            }
                        ]
                    }
                ],
