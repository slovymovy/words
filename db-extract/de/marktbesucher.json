                        "examples": [
                            {
                                "example_id": "71e8cec6-b4c9-4097-821e-ee8f26948d1c",
                                "sense_id": "84f0fa94-c797-31d2-a1b6-847a677b6b0f",
                                "text": "„Eine weitere Gruppe von Marktbesuchern eilt die drei Kilometer zum Meer hinunter.“"
                            },
                            {
                                "example_id": "4be911bf-d2f7-496d-ac3d-44b18697fdb2",
                                "sense_id": "84f0fa94-c797-31d2-a1b6-847a677b6b0f",
                                "text": "„Heute hatte er nur zwei Porträts von Markbesuchern angefertigt, aber die Kohlezeichnung der St.-Bartholomäus-Kirche und das Landschaftsaquarell – ein Tal der Wallonie – hatten Käufer gefunden.“"
                            }
                        ],
