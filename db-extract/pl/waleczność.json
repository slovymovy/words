                "senses": [
                    {
                        "sense_id": "90f03b13-18a6-3d7f-a4db-b99744b8bc4e",
                        "entry_id": "85a7416a-90c5-3d40-a207-82251d8b084b",
                        "glosses": [
                            "wyjątkowe poświęcenie walce, odwaga; cecha tego, kto jest waleczny"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "031fb216-80b5-4857-88cf-6f72b257c3cd",
                                "sense_id": "90f03b13-18a6-3d7f-a4db-b99744b8bc4e",
                                "text": "Krzyż ten miał być nagrodą za waleczność, a także służył jako upamiętnienie działań formacji."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ccd6a060-1268-4785-b2bb-3625b2a79c0f",
                        "source_entry_id": "85a7416a-90c5-3d40-a207-82251d8b084b",
                        "source_sense_id": "90f03b13-18a6-3d7f-a4db-b99744b8bc4e",
                        "target_lang_word": "prowess",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prowess",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "167df5e8-543a-3212-9cc1-5ca61680c9af",
                                        "entry_id": "746055fd-2329-38f0-817d-b4ba61187747",
                                        "glosses": [
                                            "Skillfulness or extraordinary ability in a particular area of expertise; dexterity, mastery, or proficiency."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e1bf92f6-f728-46f7-8d66-667af39367cd",
                                                "sense_id": "167df5e8-543a-3212-9cc1-5ca61680c9af",
                                                "text": "When in liquor he would make foolish wagers. On one of these too frequent occasions he was boasting of his prowess as a pedestrian and athlete, and the outcome was a match against nature. For a stake of one sovereign he undertook to run all the way to Coventry and back, a distance of something more than forty miles."
                                            },
                                            {
                                                "example_id": "cd25034e-4e40-4f93-9868-a57cac722262",
                                                "sense_id": "167df5e8-543a-3212-9cc1-5ca61680c9af",
                                                "text": "There is such a sense of inferiority sometimes when it comes to facing Germany, with all their World Cups, their penalty prowess and easy sophistication, it might come as a surprise to learn that, in head-to-head encounters, England actually match their opponents."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3c350d5b-bc6d-391e-91ea-68cefbb7b515",
                                        "entry_id": "746055fd-2329-38f0-817d-b4ba61187747",
                                        "glosses": [
                                            "Distinguished bravery or courage, especially in battle; heroism."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23f973e7-c853-4586-8bbb-fde71d454f45",
                                                "sense_id": "3c350d5b-bc6d-391e-91ea-68cefbb7b515",
                                                "text": "That libertie Poets of late in their invectives have exceeded: they have borne their ſword up where it is not lawfull for a poynado, that is but the page of proweſſe, to intermeddle."
                                            },
                                            {
                                                "example_id": "138ff1b6-ab84-41e8-abcb-3035b43076b5",
                                                "sense_id": "3c350d5b-bc6d-391e-91ea-68cefbb7b515",
                                                "text": "[…] But, wroth because this man in full assembly, / Came and reviled thee, thou wouldst shew thy prowess, / The prowess that attends thee, that henceforth / Not e'er a man might think to scorn thy prowess, […]"
                                            },
                                            {
                                                "example_id": "c51e8427-20d6-4276-97a4-91862d7d5478",
                                                "sense_id": "3c350d5b-bc6d-391e-91ea-68cefbb7b515",
                                                "text": "A beautiful great lady, past her prime, / Behold her dreaming in her easy chair; / Grey robed, and veiled, in laces old and rare, / Her smiling eyes see but the vanished time / Of splendid prowess, and of deeds sublime."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad7a80f6-dba6-307e-8208-ebb6d9afec19",
                                        "entry_id": "746055fd-2329-38f0-817d-b4ba61187747",
                                        "glosses": [
                                            "An act of prowess.",
                                            "An act of adroitness or dexterity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7e0f5058-d274-4878-929c-f21986dee343",
                                                "sense_id": "ad7a80f6-dba6-307e-8208-ebb6d9afec19",
                                                "text": "I recollect hearing […] of his [Sir William Hamilton's] simple, independent, meditative habits, ruggedly athletic modes of exercise, fondness for his big dog, etc. etc.: […] I did not witness, much less share in, any of the swimming or other athletic prowesses."
                                            },
                                            {
                                                "example_id": "8b2f58b1-547b-4076-a82d-3922451d6497",
                                                "sense_id": "ad7a80f6-dba6-307e-8208-ebb6d9afec19",
                                                "text": "As the Middle Ages drew to a close and the Renaissance rose like a new sun, knowledge of philosophy and the sciences became objects of interest to a nobility that had once held only skill in battle as a prowess worth attaining."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cfec8747-5e77-336b-8636-3b1368439912",
                                        "entry_id": "746055fd-2329-38f0-817d-b4ba61187747",
                                        "glosses": [
                                            "An act of prowess.",
                                            "An act of distinguished bravery or courage; a heroic deed."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10e058dd-eacb-43e6-9be8-ade0a7df9488",
                                                "sense_id": "cfec8747-5e77-336b-8636-3b1368439912",
                                                "text": "Thenne the batails approuched and ſhoue and ſhowted on bothe ſydes / many men ouerthrowen / hurte / & ſlayn and grete valyaunces / proweſſes and appertyces of werre were that day ſhewed […]"
                                            },
                                            {
                                                "example_id": "444ac6d1-9f88-43c1-a0a0-60a2a9632498",
                                                "sense_id": "cfec8747-5e77-336b-8636-3b1368439912",
                                                "text": "If it is deemed of so much importance, why has no attention been paid to the effects of general friendship, such as certain military prowesses, in which you see a portion of a regiment sacrifice itself in support of another portion?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "deee61bf-fc5a-4cc5-9c51-4962c701f239",
                        "source_entry_id": "85a7416a-90c5-3d40-a207-82251d8b084b",
                        "source_sense_id": "90f03b13-18a6-3d7f-a4db-b99744b8bc4e",
                        "target_lang_word": "bravery",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bravery",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "af225c33-a68a-34ee-afba-a153502ae780",
                                        "entry_id": "8e915c92-84c7-3f96-ae2e-7c6cbbbc976b",
                                        "glosses": [
                                            "Being brave, courageousness."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "31ac31ab-e761-3f20-a80f-8dcba77bc8fc",
                                        "entry_id": "8e915c92-84c7-3f96-ae2e-7c6cbbbc976b",
                                        "glosses": [
                                            "A brave act."
                                        ],
                                        "tags": [
                                            "countable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "badfe5ce-de09-41bd-9331-c012f480637c",
                                                "sense_id": "31ac31ab-e761-3f20-a80f-8dcba77bc8fc",
                                                "text": "Such abundance must be laid out on superfluous recreations, buildings, ornaments, furniture, equipage, attendants, entertainments, visitations, braveries, and a world of need-nots […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "559f3722-1250-3a45-a1bb-b9d2fe38da5f",
                                        "entry_id": "8e915c92-84c7-3f96-ae2e-7c6cbbbc976b",
                                        "glosses": [
                                            "Splendor, magnificence."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c655f4dc-e4d9-4358-b829-54edc69774d6",
                                                "sense_id": "559f3722-1250-3a45-a1bb-b9d2fe38da5f",
                                                "text": "Why didst thou promise such a beauteous day,\nAnd make me travel forth without my cloak,\nTo let base clouds o'ertake me in my way,\nHiding thy brav'ry in their rotten smoke?"
                                            },
                                            {
                                                "example_id": "4e6de46a-0b9a-42a7-bc9b-609df2714f2e",
                                                "sense_id": "559f3722-1250-3a45-a1bb-b9d2fe38da5f",
                                                "text": "In that day the Lord will take away the bravery of their tinkling ornaments about their feet, and their cauls, and their round tires like the moon"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
