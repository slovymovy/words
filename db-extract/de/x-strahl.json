                        "examples": [
                            {
                                "example_id": "f2e43330-c47d-42d2-a16f-d84737438291",
                                "sense_id": "864f93b7-242a-39c6-8029-04f4a63671fa",
                                "text": "Das würde in gewisser Hinsicht eine Anwendung der X-Strahlen, zur Entdeckung von außerhalb unseres Raumes, für uns sonst verborgenen Körpern sein. Und so würde nicht Licht, sondern „sichtbare Finsternis“ in den Dienst der Wissenschaft gestellt werden, und dadurch würden Dinge entdeckt werden, an die jetzt zu denken für uns unmöglich ist."
                            }
