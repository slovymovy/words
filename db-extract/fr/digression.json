        "fr-extract.jsonl": [
            {
                "entry_id": "55f7a147-a696-3368-a2dc-94819edcba84",
                "word": "digression",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f33cd987-15f4-4a4e-98e8-76a5499239ad",
                        "entry_id": "55f7a147-a696-3368-a2dc-94819edcba84",
                        "tags": [
                            "plural"
                        ],
                        "form": "digressions"
                    },
                    {
                        "form_id": "d61a9619-07de-4149-ac07-01d4540efb4b",
                        "entry_id": "55f7a147-a696-3368-a2dc-94819edcba84",
                        "tags": [],
                        "form": "disgression"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "529f3d0e-1f19-378c-b23f-43e0c81aec6c",
                        "entry_id": "55f7a147-a696-3368-a2dc-94819edcba84",
                        "glosses": [
                            "Ce qui dans un exposé, dans une conversation, un discours ou un développement s’écarte du sujet principal."
                        ],
                        "tags": [
                            "rhetoric"
                        ],
                        "examples": [
                            {
                                "example_id": "bc838b37-2121-4803-bddc-a5e99178e131",
                                "sense_id": "529f3d0e-1f19-378c-b23f-43e0c81aec6c",
                                "text": "J’avais une vieille parente de beaucoup d’esprit dont la conversation était des plus intéressantes ; mais sa mémoire à la fois inconstante et fertile, la faisait passer souvent d’épisodes en épisodes et de digressions en digressions, au point qu’elle était obligée d’implorer le secours de ses auditeurs : « Que voulais-je donc vous raconter ? » disait-elle, et souvent aussi ses auditeurs l’avaient oublié, ce qui jetait toute la société dans un embarras inexprimable."
                            },
                            {
                                "example_id": "10ef2bab-0bd8-46f4-a284-af20926766c9",
                                "sense_id": "529f3d0e-1f19-378c-b23f-43e0c81aec6c",
                                "text": "Il n’en est pas de même du roman. On lui permet le détour, la digression, l’épisode. On pardonne au romancier de s’amuser en route, s’il nous amuse aussi."
                            },
                            {
                                "example_id": "d4e7aa1a-3dc5-499f-8049-d8223248ada5",
                                "sense_id": "529f3d0e-1f19-378c-b23f-43e0c81aec6c",
                                "text": "Les digressions, ne trouvez-vous pas ? doivent être comme ces cerceaux que les enfants ont l’air de jeter à l’abandon, fort loin, mais qui, grâce à un mouvement essentiel de retour, imprimé dans le lancé, reviennent dans la main qui les a projetés."
                            },
                            {
                                "example_id": "507a276c-4619-4cd1-924b-9ca1d2f751af",
                                "sense_id": "529f3d0e-1f19-378c-b23f-43e0c81aec6c",
                                "text": "Certaines personnes ont l’esprit très digressif. Dans la conversation surtout, de digression en digression, la fin de leur discours finit par ne plus avoir de corrélation avec le commencement. Lorsque je rêvasse, ce cas m’arrive fréquemment."
                            },
                            {
                                "example_id": "34daba0e-a905-4852-b5ce-d08c86d4d858",
                                "sense_id": "529f3d0e-1f19-378c-b23f-43e0c81aec6c",
                                "text": "Comme toujours, Alloman dirigeait tout naturellement le débat et ne permettait aucune digression, aucun écart de la ligne juste du sujet, avant que celui-ci soit épuisé et la conclusion tirée."
                            }
                        ]
                    },
                    {
                        "sense_id": "42513225-1265-3a3c-b826-ac7f7d2aaea9",
                        "entry_id": "55f7a147-a696-3368-a2dc-94819edcba84",
                        "glosses": [
                            "Éloignement apparent des planètes par rapport au soleil."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f125b5b0-7406-4a6b-8dd8-da0ac3194055",
                                "sense_id": "42513225-1265-3a3c-b826-ac7f7d2aaea9",
                                "text": "Vénus, au contraire, sera visible le matin avant le lever du Soleil, et c’est le 14 juillet qu’elle atteindra le point de sa digression occidentale maximum."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fabef084-8aab-4fa2-840d-9c3c489d9fbf",
                        "source_entry_id": "55f7a147-a696-3368-a2dc-94819edcba84",
                        "target_lang_word": "digression",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "digression",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "37d84b26-9853-396a-a772-155a6351695f",
                                        "entry_id": "d249b866-c34e-3255-bf73-b0ed2675e61c",
                                        "glosses": [
                                            "An aside, an act of straying from the main subject in speech or writing."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eff61bb5-55aa-41a2-bc00-1c10bf27b1a5",
                                                "sense_id": "37d84b26-9853-396a-a772-155a6351695f",
                                                "text": "The lectures included lengthy digressions on topics ranging from the professor's dog to the meaning of life."
                                            },
                                            {
                                                "example_id": "27ea2196-25ca-4646-b378-86a848b41fea",
                                                "sense_id": "37d84b26-9853-396a-a772-155a6351695f",
                                                "text": "History tells us stodgy, cautious stuff, cardigan-football is the way to go here. The 1966 World Cup kicked off with 0-0 draw against Uruguay so tedious the Guardian match report contains a whimsical digression on the writer’s urge to drift off to sleep in the second half."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45659f7b-d6e1-3420-9152-3364b334c7ab",
                                        "entry_id": "d249b866-c34e-3255-bf73-b0ed2675e61c",
                                        "glosses": [
                                            "The act of straying from the main subject in speech or writing, (rhetoric) particularly for rhetorical effect."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "54560b9c-240d-4ccc-8455-9f574f62f4ce",
                                                "sense_id": "45659f7b-d6e1-3420-9152-3364b334c7ab",
                                                "text": "make digression... by way of digression..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c657b313-d747-399b-b75c-e297b97ce368",
                                        "entry_id": "d249b866-c34e-3255-bf73-b0ed2675e61c",
                                        "glosses": [
                                            "A deviancy, a sin or error, an act of straying from the path of righteousness or a general rule."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d41c0a4-0294-44d0-9e98-10180438c778",
                                                "sense_id": "c657b313-d747-399b-b75c-e297b97ce368",
                                                "text": "Nature...\nMore stronger hadde her operacyon\nThan she hath nowe in her dygressyon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "784cf8b0-e536-38db-b720-726a6bbec4c8",
                                        "entry_id": "d249b866-c34e-3255-bf73-b0ed2675e61c",
                                        "glosses": [
                                            "A deviation, an act of straying from a path."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba31df69-a99e-4015-b351-b1f575932aff",
                                                "sense_id": "784cf8b0-e536-38db-b720-726a6bbec4c8",
                                                "text": "By this little digression into Gascony, the Duke had an opportunity... to re-inforce himself with some particular Servants of his."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3abafaa4-e474-3798-ad6d-2afec685c266",
                                        "entry_id": "d249b866-c34e-3255-bf73-b0ed2675e61c",
                                        "glosses": [
                                            "An elongation, a deflection or deviation from a mean position or expected path."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5f6c4545-59f5-489e-a0c4-34dc1c7553e2",
                                                "sense_id": "3abafaa4-e474-3798-ad6d-2afec685c266",
                                                "text": "This digression [of the Sun] is not equall, but neare the Æquinoxiall intersections, it is right and greater, near the Solstices, more oblique and lesser."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
