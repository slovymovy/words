                "senses": [
                    {
                        "sense_id": "278a4235-fb35-3ff5-b350-59ff70ea723f",
                        "entry_id": "26d394a0-4402-32b9-940b-83d69455db58",
                        "glosses": [
                            "Without signs and symptoms that are detectable by physical examination or laboratory test; not clinically manifest."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "2ba78058-452e-4f75-825b-800c69b6cb7c",
                                "sense_id": "278a4235-fb35-3ff5-b350-59ff70ea723f",
                                "text": "Some conditions may remain subclinical until they resolve without intervention, whereas others worsen from subclinical to clinical status."
                            }
                        ]
                    },
                    {
                        "sense_id": "241cd8ec-d32b-3278-95d8-606d7dd24b6c",
                        "entry_id": "26d394a0-4402-32b9-940b-83d69455db58",
                        "glosses": [
                            "Where some criteria are met but not enough to reach the status of a clinical diagnosis."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "8c4d56b7-f0f2-3e2f-a02a-b1807c3d73f8",
                        "entry_id": "26d394a0-4402-32b9-940b-83d69455db58",
                        "glosses": [
                            "Less than is needed for clinical reasons."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "e7c9d77f-ab47-4403-a6a3-f2ccb02a6717",
                                "sense_id": "8c4d56b7-f0f2-3e2f-a02a-b1807c3d73f8",
                                "text": "Off-label use of certain drugs at subclinical dosages has been a theme in realms of activity such as metabolic optimization, weight loss, body hacking, and neurohacking (e.g., nootropics); such drugs include metformin, beta-blockers, and others."
                            }
                        ]
                    }
