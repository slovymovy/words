                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "41a5e8c5-2a16-3dc4-a4f0-a84a580a23dc",
                                        "entry_id": "14d5315e-7c56-37ef-af6e-4f614f60ec17",
                                        "glosses": [
                                            "An element of decoration; that which embellishes or adorns."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3e7527c3-83d9-44ac-b571-ebb0c9efe301",
                                                "sense_id": "41a5e8c5-2a16-3dc4-a4f0-a84a580a23dc",
                                                "text": "Dust are our frames; and, gilded dust, our pride / Looks only for a moment whole and sound; / Like that long-buried body of the king / Found lying with his urns and ornaments, / Which at a touch of light, an air of heaven, / Slipt into ashes and was found no more."
                                            },
                                            {
                                                "example_id": "6a0d7426-48dc-48c4-b79d-775195da78f4",
                                                "sense_id": "41a5e8c5-2a16-3dc4-a4f0-a84a580a23dc",
                                                "text": "I'm a bit short on brain myself; the old bean would appear to have been constructed more for ornament than for use."
                                            },
                                            {
                                                "example_id": "a4b89678-c9f6-48cf-a237-f3e5e1eef89f",
                                                "sense_id": "41a5e8c5-2a16-3dc4-a4f0-a84a580a23dc",
                                                "text": "Drawings and pictures are more than mere ornaments in scientific discourse. Blackboard sketches, geological maps, diagrams of molecular structure, astronomical photographs, MRI images, the many varieties of statistical charts and graphs: These pictorial devices are indispensable tools for presenting evidence, for explaining a theory, for telling a story."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "74ca53cd-45bb-38f0-b41f-154ceead094f",
                                        "entry_id": "14d5315e-7c56-37ef-af6e-4f614f60ec17",
                                        "glosses": [
                                            "A Christmas tree decoration."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e5781031-7b43-30fc-93d7-b804bd6c81b4",
                                        "entry_id": "14d5315e-7c56-37ef-af6e-4f614f60ec17",
                                        "glosses": [
                                            "A musical flourish that is unnecessary to the overall melodic or harmonic line, but serves to decorate that line."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c08bea5a-61f7-3afc-9d6b-cda6daf9225f",
                                        "entry_id": "14d5315e-7c56-37ef-af6e-4f614f60ec17",
                                        "glosses": [
                                            "The articles used in church services."
                                        ],
                                        "tags": [
                                            "countable",
                                            "in-plural",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "43446cc1-8a09-309f-b07b-a36cf0843a0c",
                                        "entry_id": "14d5315e-7c56-37ef-af6e-4f614f60ec17",
                                        "glosses": [
                                            "A characteristic that has a decorative function (typically in order to attract a mate)"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
