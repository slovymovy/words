                    "frequency": "Middle",
                    "semantic_group_id": "beïnvloeding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De politicus wist zijn <w>publiek te bespelen</w> met mooie woorden.",
                            "target_lang_translations": {
                                "en": "The politician knew how to <w>play</w> his audience with beautiful words.",
                                "ru": "Политик умел <w>играть на публику</w> красивыми словами."
                            }
                        },
                        {
                            "text": "De nieuwe medewerker liet zich makkelijk <w>bespelen</w> door zijn collega's.",
                            "target_lang_translations": {
                                "en": "The new employee was easily <w>manipulated</w> by his colleagues.",
                                "ru": "Новый сотрудник позволял коллегам легко собой <w>манипулировать</w>."
                            }
                        }
                    ],
                    "synonyms": [
