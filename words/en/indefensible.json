{
    "word_family": [
        "defend",
        "defense",
        "defensive",
        "defensible"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "6bf2e01f-2efd-3f74-9cc6-f07a39f371b7",
                    "sense_definition": "Not capable of being protected or guarded against attack.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "defensibility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The small fort was <w>indefensible</w> against the large invading army.",
                            "target_lang_translations": {
                                "pl": "Mały fort był <w>nie do obrony</w> przed wielką armią najeźdźców."
                            }
                        },
                        {
                            "text": "Without proper walls, the village remained <w>indefensible</w> during the night.",
                            "target_lang_translations": {
                                "pl": "Bez odpowiednich murów wioska pozostawała <w>nie do obrony</w> w nocy."
                            }
                        }
                    ],
                    "synonyms": [
                        "vulnerable",
                        "untenable"
                    ],
                    "antonyms": [
                        "defensible"
                    ],
                    "common_phrases": [
                        "remain indefensible"
                    ],
                    "target_lang_definitions": {
                        "pl": "Taki, którego nie da się obronić przed atakiem lub zagrożeniem."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "nie do obrony",
                                "target_lang_sense_clarification": "odnoszące się do pozycji militarnej lub fizycznej"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "26abd07d-f8ba-3326-9322-19c30272e7a9",
                    "sense_definition": "Not capable of being justified, excused, or supported by reason.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "defensibility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Such cruel behavior is completely <w>indefensible</w> in a civilized society.",
                            "target_lang_translations": {
                                "pl": "Tak okrutne zachowanie jest całkowicie <w>niewybaczalne</w> w cywilizowanym społeczeństwie."
                            }
                        },
                        {
                            "text": "The politician made an <w>indefensible</w> choice that angered many voters.",
                            "target_lang_translations": {
                                "pl": "Polityk dokonał <w>nieuzasadnionego</w> wyboru, który rozgniewał wielu wyborców."
                            }
                        }
                    ],
                    "synonyms": [
                        "inexcusable",
                        "unpardonable",
                        "insupportable"
                    ],
                    "common_phrases": [
                        "morally indefensible",
                        "completely indefensible"
                    ],
                    "target_lang_definitions": {
                        "pl": "Taki, którego nie można usprawiedliwić, wybaczyć ani logicznie uzasadnić."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "niewybaczalny",
                                "target_lang_sense_clarification": "w kontekście moralnym lub etycznym"
                            },
                            {
                                "target_lang_word": "nieuzasadniony",
                                "target_lang_sense_clarification": "w kontekście braku logicznych podstaw"
                            },
                            {
                                "target_lang_word": "niedopuszczalny",
                                "target_lang_sense_clarification": "w kontekście zachowań, których nie można tolerować"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0805625b-da65-3bb4-bfff-2ca7ef127fb6",
                    "sense_definition": "Impossible to explain or account for.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "defensibility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His sudden change of heart remains <w>indefensible</w> to those who know him well.",
                            "target_lang_translations": {
                                "pl": "Jego nagła zmiana zdania pozostaje <w>niewytłumaczalna</w> dla tych, którzy dobrze go znają."
                            }
                        },
                        {
                            "text": "The strange error in the report is <w>indefensible</w> given the data provided.",
                            "target_lang_translations": {
                                "pl": "Dziwny błąd w raporcie jest <w>nie do wyjaśnienia</w>, biorąc pod uwagę dostarczone dane."
                            }
                        }
                    ],
                    "synonyms": [
                        "invalid"
                    ],
                    "target_lang_definitions": {
                        "pl": "Taki, którego nie da się wyjaśnić lub racjonalnie wytłumaczyć."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "niewytłumaczalny",
                                "target_lang_sense_clarification": "w kontekście braku logicznego wyjaśnienia"
                            },
                            {
                                "target_lang_word": "nie do wyjaśnienia",
                                "target_lang_sense_clarification": "w kontekście braku dowodów lub przyczyn"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}