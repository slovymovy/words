                "senses": [
                    {
                        "sense_id": "d3fb61fd-7c8f-392f-a04d-87a29009b9bd",
                        "entry_id": "f3323b8c-dc52-3d30-9b85-ca9cd6c70d1c",
                        "glosses": [
                            "церк., : предназначенный для (домашнего) чтения, а не для богослужения"
                        ],
                        "tags": [
                            "о религиозных книгах"
                        ],
                        "examples": [
                            {
                                "example_id": "664b5462-2b4a-4b5d-ae82-17d048d91037",
                                "sense_id": "d3fb61fd-7c8f-392f-a04d-87a29009b9bd",
                                "text": "Например, непорочное зачатие Богородицы упоминается в текстах четьих миней и акафистов."
                            },
                            {
                                "example_id": "fab6bf33-3e41-4aad-9207-bec2572029fb",
                                "sense_id": "d3fb61fd-7c8f-392f-a04d-87a29009b9bd",
                                "text": "В отечественной науке принято делить Библию в рукописную эпоху ее существования на три разновидности: служебную (или литургическую), четью и толковую."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5d416ac9-0192-46db-98cd-888136929d5f",
