                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "950b8e82-c5fe-3902-a0cb-23c6d180b511",
                                        "entry_id": "737a4273-19e9-3fd7-b0b2-6b688d748376",
                                        "glosses": [
                                            "Being or relating to a hostile takeover."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e507ec04-9bbc-47ba-a657-2b3a4ffa8fb6",
                                                "sense_id": "950b8e82-c5fe-3902-a0cb-23c6d180b511",
                                                "text": "Microsoft may go hostile in its bid for Yahoo! as soon as Friday, according to a published report."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7ac9e815-2e26-4358-bdc3-23056c7a5999",
                        "source_entry_id": "ac74b45b-7f5f-3bfb-aa0a-6252d31cbc89",
                        "source_sense_id": "02660e0f-752a-3fc7-9575-f3e9dc3e73fe",
                        "target_lang_word": "inimical",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inimical",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "57f6d8c5-db6f-3872-9a96-4f58204d332e",
                                        "entry_id": "7c5ce6e3-b69b-374e-8b3d-3fc1a81983e6",
                                        "glosses": [
                                            "Harmful in effect."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ccbf81eb-7399-49be-8d34-0d7c828d7e72",
                                                "sense_id": "57f6d8c5-db6f-3872-9a96-4f58204d332e",
                                                "text": "She doesn’t want to touch it, and indeed every particle of her screams against doing so because it is somehow inimical to her."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8afddb8e-7b95-320c-96c2-c2f6f0cd3a4d",
                                        "entry_id": "7c5ce6e3-b69b-374e-8b3d-3fc1a81983e6",
                                        "glosses": [
                                            "Unfriendly, hostile."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3b24acd-9a0c-408a-a2cd-0bd1a34ec440",
                                                "sense_id": "8afddb8e-7b95-320c-96c2-c2f6f0cd3a4d",
                                                "text": "Her inimical attitude precludes romance."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5587e6d8-d638-4ca1-9d3d-eb9f77100fc0",
                        "source_entry_id": "ac74b45b-7f5f-3bfb-aa0a-6252d31cbc89",
                        "source_sense_id": "02660e0f-752a-3fc7-9575-f3e9dc3e73fe",
                        "target_lang_word": "unfriendly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unfriendly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8adc53d8-0c05-3513-8556-ff60a5a5402a",
                                        "entry_id": "68e84966-cfe1-34ea-b25d-63f3260da9ee",
                                        "glosses": [
                                            "Not friendly; hostile; mean."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d59c45a9-b769-445f-b7b1-49634a3eb2a8",
                                                "sense_id": "8adc53d8-0c05-3513-8556-ff60a5a5402a",
                                                "text": "Shrekkies will notice that the musical is going off-piste from the film right from the start when the curtain rises to reveal a seven-year-old Shrek turfed out into an unfriendly world by his parents."
                                            },
                                            {
                                                "example_id": "ba625882-6d1b-4027-88c0-0f015dc87121",
                                                "sense_id": "8adc53d8-0c05-3513-8556-ff60a5a5402a",
                                                "text": "The reputations of our universities and our research base are already under threat because of the fallout from the EU referendum result, which is making the UK an unfriendlier place for overseas scholars and students, as well as cutting off access to an important stream of research funding and to a vibrant and well-developed ecosystem for collaborative work."
                                            },
                                            {
                                                "example_id": "809878df-90c3-40a9-a31b-395dc387c87f",
                                                "sense_id": "8adc53d8-0c05-3513-8556-ff60a5a5402a",
                                                "text": "I thought of him as a young man in Washington for the first time, first job with McCarthy, and that that was probably one of the unfriendliest spaces at the time for a gay person."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "375dbc40-510b-3b97-b45c-ecb3249669b4",
                                        "entry_id": "68e84966-cfe1-34ea-b25d-63f3260da9ee",
                                        "glosses": [
                                            "Unfavourable."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "unfriendly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1f172228-b417-33aa-970d-f47e52e972c3",
                                        "entry_id": "46c151eb-2a43-3dbf-a2ed-53ae328d6540",
                                        "glosses": [
                                            "An enemy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0152353b-b5aa-4012-9183-547f231baa37",
                                                "sense_id": "1f172228-b417-33aa-970d-f47e52e972c3",
                                                "text": "Sweep the valley compound and eliminate any unfriendlies you encounter."
                                            },
                                            {
                                                "example_id": "ad5f1d13-ca39-407f-97a1-1e90d3b644a9",
                                                "sense_id": "1f172228-b417-33aa-970d-f47e52e972c3",
                                                "text": "You see, the mission of almost every teenage girl on the loose is to first identify the targets, just like a war. These include the primary objective (the boy), the enemy (other girls), the friendlies (sympathetic girl friends and the boy's family), and unfriendlies (other boys)."
                                            }
                                        ]
                                    }
                                ]
                            },
