                "senses": [
                    {
                        "sense_id": "8f0df767-e7f7-30ab-aaca-0f54b9d0f74e",
                        "entry_id": "1e33476e-bb9f-35d5-8c6f-57fa2e82f2fc",
                        "glosses": [
                            "Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83bfc123-338a-4fa2-a3d0-84efa03388fa",
                                "sense_id": "8f0df767-e7f7-30ab-aaca-0f54b9d0f74e",
                                "text": "Frau Negwer ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "1286676a-0606-418b-8d78-9c19fd93c124",
                                "sense_id": "8f0df767-e7f7-30ab-aaca-0f54b9d0f74e",
                                "text": "Herr Negwer wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "9e44a886-8c92-4edf-99ca-99af3a5ad757",
                                "sense_id": "8f0df767-e7f7-30ab-aaca-0f54b9d0f74e",
                                "text": "Die Negwers fahren heute nach Rostock."
                            },
                            {
                                "example_id": "009c21e1-9e5c-4da9-8b7b-276ca3de24ec",
                                "sense_id": "8f0df767-e7f7-30ab-aaca-0f54b9d0f74e",
                                "text": "Der Negwer trägt nie die Pullover, die die Negwer ihm strickt."
                            },
                            {
                                "example_id": "ef131172-9f53-4799-9474-fbd369bb4aa4",
                                "sense_id": "8f0df767-e7f7-30ab-aaca-0f54b9d0f74e",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Negwer kommt, geht der Herr Negwer.“"
                            },
                            {
                                "example_id": "a3b5def4-d166-4104-a973-d9e614dacf4c",
                                "sense_id": "8f0df767-e7f7-30ab-aaca-0f54b9d0f74e",
                                "text": "Negwer kommt und geht."
                            },
                            {
                                "example_id": "55e25e40-87f3-4079-b33d-351e579dd55c",
                                "sense_id": "8f0df767-e7f7-30ab-aaca-0f54b9d0f74e",
                                "text": "Negwers kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
