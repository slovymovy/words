                                        "sense_id": "9e1857d5-c246-3731-88d8-944ec4c5018a",
                                        "entry_id": "74542543-8ff8-39ba-8bca-f404c86cdd96",
                                        "glosses": [
                                            "The bulk; the mass."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "gross",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "09bc2d38-246f-38fc-8d4a-0e439095d298",
                                        "entry_id": "7576c696-1b7f-3acb-9835-00ef753d2e2f",
                                        "glosses": [
                                            "To earn money, not including expenses."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0309aa7f-041c-487c-ada5-bb25b5e95b0a",
                                                "sense_id": "09bc2d38-246f-38fc-8d4a-0e439095d298",
                                                "text": "The movie grossed three million on the first weekend."
                                            },
                                            {
                                                "example_id": "2c5cf90e-68d7-4a2c-ad3f-52a3ae8fffd6",
                                                "sense_id": "09bc2d38-246f-38fc-8d4a-0e439095d298",
                                                "text": "The film grossed $464 million worldwide, ensconcing her in the Hollywood A-list."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
