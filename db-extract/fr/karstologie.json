                    {
                        "sense_id": "628a754d-48c0-3adf-bcfa-f8e9df1f38c0",
                        "entry_id": "e2449ad9-0006-3875-8670-a1354bbc54df",
                        "glosses": [
                            "Discipline scientifique consacrée à l’étude des milieux karstiques, englobant l’analyse des reliefs de surface (comme les dolines, poljés, lapiés), des réseaux souterrains, des écoulements souterrains et des processus géologiques, hydrologiques, géochimiques et biologiques associés."
                        ],
                        "tags": [
                            "Hydrogéologie"
                        ],
                        "examples": [
                            {
                                "example_id": "79434b93-86f3-4460-a22d-5c98e1be54aa",
                                "sense_id": "628a754d-48c0-3adf-bcfa-f8e9df1f38c0",
                                "text": "Aujourd’hui, s’appuyant sur les travaux de plusieurs générations de karstologues, de spéléologues et d’hydrogéologues, la karstologie bénéficie d’une vision globale du phénomène de karstification."
                            }
                        ]
                    }
                ],
