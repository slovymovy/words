                        "glosses": [
                            "nagranie muzyczne lub zbiór utworów większy niż singiel i mniejszy niż album, zawierający zazwyczaj od trzech do pięciu kompozycji"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "687313b4-73a9-4d63-8ffe-4263f787a74f",
                                "sense_id": "b156c49f-809b-3d6b-a27e-10a62d22fbd2",
                                "text": "Wydany na początku roku minialbum \"Kolekcjoner\" osiągnął nakład 50 tys. egzemplarzy."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
