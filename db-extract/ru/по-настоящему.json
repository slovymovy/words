        "ru-extract.jsonl": [
            {
                "entry_id": "f557309e-e463-31fc-88ab-215671040b06",
                "word": "по-настоящему",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "904a30e6-ab1f-345f-ace5-a1942630aa61",
                        "entry_id": "f557309e-e463-31fc-88ab-215671040b06",
                        "glosses": [
                            "так, как нужно; так, как полагается; должным образом"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d144a82-5269-4d37-b6bf-c1b0df258d6b",
                                "sense_id": "904a30e6-ab1f-345f-ace5-a1942630aa61",
                                "text": "― Вихры бы по-настоящему в парикмахерской подвить следует, да уж теперь поздно!"
                            },
                            {
                                "example_id": "63c8efee-adc4-4e9a-a12b-1439312c7258",
                                "sense_id": "904a30e6-ab1f-345f-ace5-a1942630aa61",
                                "text": "Мы здесь работаем по-настоящему, а у вас там в Москве лодыри."
                            }
                        ]
                    },
                    {
                        "sense_id": "a4fb54a4-0d0c-331e-a61a-2ba043c1f994",
                        "entry_id": "f557309e-e463-31fc-88ab-215671040b06",
                        "glosses": [
                            "разг. в самом деле, в действительности, по-хорошему, по сути"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9aace6d-8c89-4629-9e07-42bcc9dcb5a6",
                                "sense_id": "a4fb54a4-0d0c-331e-a61a-2ba043c1f994",
                                "text": "По-настоящему мне следовало бы, сейчас же после свидания с графом Твэрдоонто, уехать из Интерлакена; но меня словно колдовство пришпилило к этому месту."
                            },
                            {
                                "example_id": "43792315-1645-430e-a65e-da14d3ee40e7",
                                "sense_id": "a4fb54a4-0d0c-331e-a61a-2ba043c1f994",
                                "text": "Побуждения ваши прекрасны. Вы по-настоящему сильный человек."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9dc88015-b09a-4d5b-a031-3ae968792afa",
                        "source_entry_id": "f557309e-e463-31fc-88ab-215671040b06",
                        "target_lang_word": "properly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "properly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a05a3702-62e4-3c16-8391-b1c92326468a",
                                        "entry_id": "f48dfd00-84c4-3767-809d-07695bceca5a",
                                        "glosses": [
                                            "In a proper manner, appropriately, suitably; correctly, justifiably"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95abe135-9f29-4948-a1be-bd8176d7eb46",
                                                "sense_id": "a05a3702-62e4-3c16-8391-b1c92326468a",
                                                "text": "Does she think the repairs have been properly done?"
                                            },
                                            {
                                                "example_id": "c68e092f-cace-4091-82cc-abe43a24bcd7",
                                                "sense_id": "a05a3702-62e4-3c16-8391-b1c92326468a",
                                                "text": "I know that I am spoiling your life that without me you could work. And you will I know. You see I cant[sic] even write this properly."
                                            },
                                            {
                                                "example_id": "b5b6eca5-dddc-4fe8-a7cc-a5a22e8daee7",
                                                "sense_id": "a05a3702-62e4-3c16-8391-b1c92326468a",
                                                "text": "Hospitals are failing to care properly for the growing number of people with dementia, according to an NHS-funded report, which has prompted demands for big improvements to help patients."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7f13bcaa-a273-387d-b971-e6f55dba4f99",
                                        "entry_id": "f48dfd00-84c4-3767-809d-07695bceca5a",
                                        "glosses": [
                                            "individually; in one's own manner."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "58ec283c-36f9-3214-a6da-be62626b5b77",
                                        "entry_id": "f48dfd00-84c4-3767-809d-07695bceca5a",
                                        "glosses": [
                                            "Entirely; extremely; thoroughly."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e158e6e6-d158-4e36-970c-cefbae211fcf",
                                                "sense_id": "58ec283c-36f9-3214-a6da-be62626b5b77",
                                                "text": "I was properly tired after that party."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
