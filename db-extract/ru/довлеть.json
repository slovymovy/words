                    },
                    {
                        "form_id": "88015bc0-6f1a-4d24-b65f-fbee2a0069fe",
                        "entry_id": "7e5f8661-e172-3313-b81b-3690971407eb",
                        "tags": [
                            "future"
                        ],
                        "form": "буду/будешь… довле́ть"
