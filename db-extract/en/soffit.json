    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "e21f8fce-bff9-3acb-9093-5e5c5e54f4d1",
                "word": "soffit",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "6ca865ab-65c9-439d-83d6-d58d5e584cb7",
                        "entry_id": "e21f8fce-bff9-3acb-9093-5e5c5e54f4d1",
                        "tags": [
                            "plural"
                        ],
                        "form": "soffits"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "eaaa3585-6c93-3239-b97c-ac93201e6148",
                        "entry_id": "e21f8fce-bff9-3acb-9093-5e5c5e54f4d1",
                        "glosses": [
                            "The visible underside of an arch, balcony, beam, cornice, staircase, vault or any other architectural element."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b848b5f-a4b8-4650-ac8d-799814f9a8c6",
                                "sense_id": "eaaa3585-6c93-3239-b97c-ac93201e6148",
                                "text": "From 1945 onwards, deterioration in the condition of the brickwork in the arch soffits was kept under close observation, and in 1951 it was decided that strengthening must be undertaken."
                            },
                            {
                                "example_id": "972bfcba-74c3-419d-b891-03b65448db2f",
                                "sense_id": "eaaa3585-6c93-3239-b97c-ac93201e6148",
                                "text": "If the soffit is to be sloping, simply attach the soffit board(s) to the underside of the rafters, butting the edges tight against the fascia board in front and the barn siding in the back."
                            },
                            {
                                "example_id": "61799760-d885-41f1-917b-4d9d933e55db",
                                "sense_id": "eaaa3585-6c93-3239-b97c-ac93201e6148",
                                "text": "A soffit is the underside of any part of a building's structure. Most people know about the soffit boards below their fascia boards (which cap off the ends of a roof's rafters). But if you walk through a brick-built tunnel and glance upwards, for example, you will be looking at the soffit of the arch."
                            }
                        ]
                    },
                    {
                        "sense_id": "0873795f-76a8-3c8a-b35a-4b53642a9c9f",
                        "entry_id": "e21f8fce-bff9-3acb-9093-5e5c5e54f4d1",
                        "glosses": [
                            "The top point of the inside open section of a pipe or box conduit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "950b0f4e-bdbd-48c4-965b-f2deba4c0952",
                                "sense_id": "0873795f-76a8-3c8a-b35a-4b53642a9c9f",
                                "text": "The elevation of the pipe soffit is 10.4 meters above mean sea level."
                            },
                            {
                                "example_id": "8a892c57-21ac-4699-8975-834f18d137dd",
                                "sense_id": "0873795f-76a8-3c8a-b35a-4b53642a9c9f",
                                "text": "The vents on the bottom of the soffit should be open, and the vents on the side of the soffit should be closed."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "34fc89b6-b75f-452b-afb4-00aa1ba2605a",
                        "source_entry_id": "e21f8fce-bff9-3acb-9093-5e5c5e54f4d1",
                        "source_sense_description": "the visible underside of an arch, balcony, beam, cornice, staircase, vault or any other architectural element",
                        "target_lang_word": "podhled",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "podhled",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "5592aed2-295c-316c-939d-8e85c83b8cf7",
                                        "entry_id": "84faa0ad-b9b9-38b7-a886-b825248f9092",
                                        "glosses": [
                                            "pohled na objekt zdola"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d86822a-ed79-4fe3-a80e-f29df470d445",
                                                "sense_id": "5592aed2-295c-316c-939d-8e85c83b8cf7",
                                                "text": "A přitom pro ozvláštnění fotky stačí jedna jediná věc - sednout nebo dokonce si lehnout na zem. Budete se divit, jak takový podhled dodá vašim fotkám zcela nový rozměr."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1226708b-bd18-3f36-b892-03f29d90d7c0",
                                        "entry_id": "84faa0ad-b9b9-38b7-a886-b825248f9092",
                                        "glosses": [
                                            "viditelná spodní plocha"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f194eecc-03ca-49e8-85d4-fcb4cdd89df2",
                                                "sense_id": "1226708b-bd18-3f36-b892-03f29d90d7c0",
                                                "text": "Je ale potřeba počítat s vyššími investičními náklady, kdy je nutné připravit stropní podhledy s rozvody vodního potrubí a počítat s nákupem tepelného čerpadla."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "712e5372-c7df-4db8-80cf-5d047e9e75b2",
                        "source_entry_id": "e21f8fce-bff9-3acb-9093-5e5c5e54f4d1",
                        "source_sense_description": "the visible underside of an arch, balcony, beam, cornice, staircase, vault or any other architectural element",
                        "target_lang_word": "soffite",
                        "target_lang_code": "fr",
