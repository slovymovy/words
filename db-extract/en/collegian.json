                        ],
                        "examples": [
                            {
                                "example_id": "2d65c734-6146-4d40-932f-51447657b233",
                                "sense_id": "a5b6558f-010a-31ca-a3a9-2411dd45eb8c",
                                "text": "While it [the wind] roared through the steeple of St George’s Church, and twirled all the cowls in the neighbourhood, it made a swoop to beat the Southwark smoke into the jail; and, plunging down the chimneys of the few early collegians who were yet lighting their fires, half suffocated them."
                            }
                        ]
