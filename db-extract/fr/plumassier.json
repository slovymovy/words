                ],
                "senses": [
                    {
                        "sense_id": "90c7533b-182f-3333-b8f7-3e59ddee1db0",
                        "entry_id": "cd05e1b1-1138-3517-8d8b-ea9eafaf0925",
                        "glosses": [
                            "Personne qui prépare, qui vend des plumes, des aigrettes, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9bfe706d-e480-4472-992f-fbfac0b294f4",
                                "sense_id": "90c7533b-182f-3333-b8f7-3e59ddee1db0",
                                "text": "Le plumassier prépare des plumes, fabrique et vend des garnitures qui deviendront accessoires ou éléments de costumes."
                            }
                        ]
                    },
                    {
                        "sense_id": "cb54a66b-11f2-349a-8003-25d98dde5766",
                        "entry_id": "cd05e1b1-1138-3517-8d8b-ea9eafaf0925",
                        "glosses": [
                            "Personne qui réalise des présentations artistiques, des compositions, des décors à base de plumes."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "72f0b8ed-73f3-4c50-8f25-44238229250f",
                                "sense_id": "cb54a66b-11f2-349a-8003-25d98dde5766",
                                "text": "Et dans nos métiers du luxe, on a besoin de ces privilégiés qui font travailler nos ateliers, nos brodeurs, nos plumassiers."
                            },
                            {
                                "example_id": "200cdf2e-2385-4f57-a20b-4b1b740759ec",
                                "sense_id": "cb54a66b-11f2-349a-8003-25d98dde5766",
                                "text": "Parmi les créations figurent ainsi des commandes réalisées en collaboration et croisant plusieurs disciplines : des photographies se voient décorées par une brodeuse, un paravent en bois sculpté peint par un artiste, une moto ornée par un plumassier […]."
                            }
                        ]
                    }
