{
    "word_family": [
        "nickel-and-dime",
        "nickelodeon"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "44470c3c-972c-362f-8682-1d9ace9ff519",
                    "sense_definition": "A coin worth 5 cents.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I found a <w>nickel</w> on the sidewalk yesterday.",
                            "target_lang_translations": {
                                "ru": "Вчера я нашел <w>монету в пять центов</w> на тротуаре.",
                                "zh": "我昨天在人行道上捡到了一枚<w>五美分硬币</w>。"
                            }
                        },
                        {
                            "text": "You need another <w>nickel</w> to buy that candy bar.",
                            "target_lang_translations": {
                                "ru": "Тебе нужно еще <w>пять центов</w>, чтобы купить этот батончик.",
                                "zh": "你还需要<w>五美分</w>才能买那块糖。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "wooden nickel",
                        "plug nickel"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "North America"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Монета достоинством в 5 центов (в США и Канаде).",
                        "zh": "一种面值为5美分的硬币。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "монета в пять центов",
                                "target_lang_sense_clarification": "номинал"
                            },
                            {
                                "target_lang_word": "пять центов",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "五美分硬币",
                                "target_lang_sense_clarification": "面值"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e3cbfecd-50b8-3ee9-80ae-122507fdecdc",
                    "sense_definition": "A silvery elemental metal with an atomic number of 28 and symbol Ni.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Stainless steel is often an alloy of iron, chromium, and <w>nickel</w>.",
                            "target_lang_translations": {
                                "ru": "Нержавеющая сталь часто представляет собой сплав железа, хрома и <w>никеля</w>.",
                                "zh": "不锈钢通常是铁、铬和<w>镍</w>的合金。"
                            }
                        },
                        {
                            "text": "Some people are allergic to jewelry that contains <w>nickel</w>.",
                            "target_lang_translations": {
                                "ru": "У некоторых людей аллергия на украшения, содержащие <w>никель</w>.",
                                "zh": "有些人对含有<w>镍</w>的首饰过敏。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "nickel alloy",
                        "nickel plating",
                        "nickel steel"
                    ],
                    "target_lang_definitions": {
                        "ru": "Серебристый металл, химический элемент с атомным номером 28 и символом Ni.",
                        "zh": "一种银白色的金属元素，原子序数为28，符号为Ni。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ни́кель",
                                "target_lang_sense_clarification": "металл"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "镍",
                                "target_lang_sense_clarification": "金属元素"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c60283ae-8b15-3fc3-82af-42e8eb9f3f84",
                    "sense_definition": "A defensive formation in American football with five defensive backs.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The coach called for a <w>nickel</w> package to counter the passing game.",
                            "target_lang_translations": {
                                "ru": "Тренер назначил схему <w>никель</w>, чтобы противостоять пасовой игре.",
                                "zh": "教练要求使用<w>镍式防守</w>阵型来应对传球进攻。"
                            }
                        },
                        {
                            "text": "They switched to a <w>nickel</w> defense on third down.",
                            "target_lang_translations": {
                                "ru": "На третьем дауне они переключились на защиту <w>никель</w>.",
                                "zh": "在第三次进攻机会时，他们换成了<w>镍式防守</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "nickel defense",
                        "nickel back"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "American Football"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Оборонительная схема в американском футболе с пятью защитниками (бэками).",
                        "zh": "美式橄榄球中一种由五名防守后卫组成的防守阵型。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "никель",
                                "target_lang_sense_clarification": "схема защиты"
                            },
                            {
                                "target_lang_word": "защита никель",
                                "target_lang_sense_clarification": "термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "镍式防守",
                                "target_lang_sense_clarification": "体育术语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5d8a6537-1385-33c1-b7bb-704ed36c13f7",
                    "sense_definition": "A five-year prison sentence.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He served a <w>nickel</w> in the state penitentiary for robbery.",
                            "target_lang_translations": {
                                "ru": "Он отсидел <w>пятёрку</w> в тюрьме штата за ограбление.",
                                "zh": "他因抢劫罪在州立监狱服了<w>五年刑期</w>。"
                            }
                        },
                        {
                            "text": "The judge sentenced him to a <w>nickel</w> behind bars.",
                            "target_lang_translations": {
                                "ru": "Судья приговорил его к <w>пятёрке</w> за решеткой.",
                                "zh": "法官判处他<w>五年</w>监禁。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "criminal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Пятилетний тюремный срок.",
                        "zh": "指五年刑期的监狱服刑。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пятёрка",
                                "target_lang_sense_clarification": "жаргон"
                            },
                            {
                                "target_lang_word": "пять лет",
                                "target_lang_sense_clarification": "срок"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "五年刑期",
                                "target_lang_sense_clarification": "俚语"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "343e97df-2501-3c00-b796-eebbcbe05559",
                    "sense_definition": "To coat or plate a surface with nickel.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The factory <w>nickels</w> the car bumpers to prevent them from rusting.",
                            "target_lang_translations": {
                                "ru": "Завод <w>никелирует</w> автомобильные бамперы, чтобы предотвратить их ржавление.",
                                "zh": "工厂给汽车保险杠<w>镀镍</w>以防止生锈。"
                            }
                        },
                        {
                            "text": "He had the antique door handles <w>nickeled</w> to restore their shine.",
                            "target_lang_translations": {
                                "ru": "Он отдал старинные дверные ручки, чтобы их <w>никелировали</w> и вернули им блеск.",
                                "zh": "他把古董门把手拿去<w>镀镍</w>，以恢复它们的光泽。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Покрывать поверхность изделия слоем никеля.",
                        "zh": "在物体表面镀上一层镍。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "никелирова́ть",
                                "target_lang_sense_clarification": "покрывать металлом"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "镀镍",
                                "target_lang_sense_clarification": "工艺"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "6a9a2dce-1c25-3126-a425-27fb4896218d",
                    "sense_definition": "Involving low cost or value; cheap.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager gave us the <w>nickel</w> tour of the new office building.",
                            "target_lang_translations": {
                                "ru": "Менеджер провел для нас <w>беглую</w> экскурсию по новому офисному зданию.",
                                "zh": "经理带我们对新办公楼进行了<w>简略的</w>参观。"
                            }
                        },
                        {
                            "text": "I only need the <w>nickel</w> explanation, not the full technical details.",
                            "target_lang_translations": {
                                "ru": "Мне нужно лишь <w>краткое</w> объяснение, а не полные технические подробности.",
                                "zh": "我只需要一个<w>简略的</w>解释，不需要完整的技术细节。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cheap"
                    ],
                    "common_phrases": [
                        "nickel tour"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Дешёвый, недорогой или поверхностный (не вдающийся в детали).",
                        "zh": "指成本低廉或内容浅显、不深入的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "копеечный",
                                "target_lang_sense_clarification": "о стоимости"
                            },
                            {
                                "target_lang_word": "беглый",
                                "target_lang_sense_clarification": "поверхностный"
                            },
                            {
                                "target_lang_word": "дешёвый",
                                "target_lang_sense_clarification": "низкой стоимости"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "简略的",
                                "target_lang_sense_clarification": "形容内容"
                            },
                            {
                                "target_lang_word": "廉价的",
                                "target_lang_sense_clarification": "形容价值"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "26f95062-aae6-3c62-8a34-25eb7b29d171",
                    "sense_definition": "A surname.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Nickel</w> will see you now.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Никель</w> сейчас вас примет.",
                                "zh": "<w>尼克尔</w>先生现在要见你。"
                            }
                        },
                        {
                            "text": "I went to school with a girl named Sarah <w>Nickel</w>.",
                            "target_lang_translations": {
                                "ru": "Я учился в школе с девочкой по имени Сара <w>Никель</w>.",
                                "zh": "我和一个叫莎拉·<w>尼克尔</w>的女孩上过同一所学校。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
