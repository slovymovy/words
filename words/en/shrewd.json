                    "synonyms": [
                        "sharp-tongued",
                        "satirical",
                        "scolding"
                    ],
                    "antonyms": [
                        "mild-spoken"
                    ],
                    "common_phrases": [
                        "shrewd of tongue"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Obsolete meaning of sharp-tongued"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Cięty, satyryczny lub mający ostry język (przestarzałe)."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "ostry",
                                "target_lang_sense_clarification": "o języku lub dowcipie"
                            },
                            {
                                "target_lang_word": "cięty",
                                "target_lang_sense_clarification": "o ripoście lub języku"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}