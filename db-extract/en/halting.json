                        "examples": [
                            {
                                "example_id": "6bb21aa3-4d92-480b-8184-ba17b7055cdf",
                                "sense_id": "bc9bfab4-158b-30db-883d-18e0ccad8e81",
                                "text": "his halting speech"
                            },
                            {
                                "example_id": "e2f002b4-115f-45f0-a489-48e01cb92410",
                                "sense_id": "bc9bfab4-158b-30db-883d-18e0ccad8e81",
                                "text": "her halting steps"
                            },
                            {
                                "example_id": "22e13e3f-fc36-476f-87b9-ed9dc62ddc3a",
                                "sense_id": "bc9bfab4-158b-30db-883d-18e0ccad8e81",
                                "text": "Him we enlisted at Para, on the recommendation of the steamship company, on whose vessels he had learned to speak a halting English."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ff12e860-9da1-4cfe-9111-1cdb6d4bbc64",
