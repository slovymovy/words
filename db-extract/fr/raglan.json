            {
                "entry_id": "999520a3-5710-3fbc-ac2f-e5883b12a249",
                "word": "raglan",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ddb03c78-40e5-3e73-b3aa-64900fd5d43c",
                        "entry_id": "999520a3-5710-3fbc-ac2f-e5883b12a249",
                        "glosses": [
                            "Se dit d’un vêtement dont l’assemblage et la fixation des manches est en forme de raglan."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b51518ed-8427-4987-83af-987d628148dc",
                                "sense_id": "ddb03c78-40e5-3e73-b3aa-64900fd5d43c",
                                "text": "Hmm… Voyons…Homme jeune, imberbe, petite moustache… lunettes noires… manteau raglan, tissu chevronné, chapeau mou, avec petite plume dans la ganse…"
                            },
                            {
                                "example_id": "f9914060-9d5e-474a-8d70-330974cc51ce",
                                "sense_id": "ddb03c78-40e5-3e73-b3aa-64900fd5d43c",
                                "text": "C’était un genre de capote, à manches raglan, taillée dans un tissu à toute épreuve, conçu pour défier le temps et représenter la Grande-Bretagne."
                            },
                            {
                                "example_id": "5c5a40ba-cf85-4b91-858b-6265f5b8f1e0",
                                "sense_id": "ddb03c78-40e5-3e73-b3aa-64900fd5d43c",
                                "text": "Un pull sombre, à col officier et manches raglan, donne un effet austère et plat de soutane."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
