                        "glosses": [
                            "Substance ou médicament destiné à augmenter la tonicité des parois veineuses pour améliorer la circulation sanguine."
                        ],
                        "tags": [
                            "Pharmacie"
                        ],
                        "examples": [
                            {
                                "example_id": "da02369d-d41a-4565-80cd-98deac940ab6",
                                "sense_id": "cd7007a3-67d6-3901-bfc3-76ff8790c785",
                                "text": "Le phlébotonique que vous lui prescrivez doit être suffisamment efficace pour la soulager rapidement. Il doit agir de façon durable pour protéger réellement la paroi vasculaire et assurer le confort permanent de votre patient."
                            },
                            {
                                "example_id": "edbd832a-efa9-4692-b99a-d4ae5d5a84a9",
                                "sense_id": "cd7007a3-67d6-3901-bfc3-76ff8790c785",
                                "text": "Un repos vocal associé à des phlébotoniques, du magnésium, un anti-inflammatoire permet une récupération totale."
                            }
                        ]
                    }
