                        "glosses": [
                            "To produce dimples in; to dimple."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "6751be19-6b4d-44e8-95dc-ab929a7d25ab",
                                "sense_id": "245fb74e-ee55-305f-8a88-fd994af05c29",
                                "text": "Here he ſpies a pleaſant rivulet, which, through its flow'ry banks, glides along over the brighteſt ſand, and remurmurs over the whiteſt pebbles that bedimple its ſmooth ſurface, while that other, through its liquid cryſtal, feaſts the eye with a proſpect of gold and orient pearl."
                            },
                            {
                                "example_id": "69d578f4-0bb8-436d-aace-ada33ba9807c",
                                "sense_id": "245fb74e-ee55-305f-8a88-fd994af05c29",
                                "text": "Good nature, believe me, 'tis the smoothest of varnish, Which ever bedimples the beautiful cheek; [...]"
                            },
                            {
                                "example_id": "9c7f9bea-bcd7-48f2-81c7-c4f8a67ca24a",
                                "sense_id": "245fb74e-ee55-305f-8a88-fd994af05c29",
                                "text": "And the smiles of delight / Bedimple her mouth, / And heaven-born zephyrs / Are sweet from the south; [...]"
                            }
                        ]
                    }
