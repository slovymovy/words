                                                "sense_id": "eedb4ab7-2c75-30a6-8b93-aa231b930087",
                                                "text": "Épouser un impuissant."
                                            },
                                            {
                                                "example_id": "6d656470-19d6-4251-8381-d5867db1d2b7",
                                                "sense_id": "eedb4ab7-2c75-30a6-8b93-aa231b930087",
                                                "text": "Tim Gyakari est un impuissant, et son sexe est plus petit que celui d’un enfant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dbe620b0-5227-3719-ba85-36c9f764ac64",
                                        "entry_id": "57b15f7a-d1a9-3024-9beb-101232095747",
                                        "glosses": [
                                            "Personne qui n’a pas de pouvoirs, de moyens, pour faire quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
