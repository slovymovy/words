                "senses": [
                    {
                        "sense_id": "44a18861-1eb9-3e33-a25a-5c3764424b81",
                        "entry_id": "2e4f733e-3631-34ed-875d-0972ff8d0216",
                        "glosses": [
                            "alle bedrijven en organisaties die op grote schaal mensen de gelegenheid geven om aan een kansspel deel te nemen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "844610c6-9bf3-4727-ab5b-aa288709eeae",
                                "sense_id": "44a18861-1eb9-3e33-a25a-5c3764424b81",
                                "text": "Eind 2014 stapte Noble op en werd zijn functie overgenomen door de Duitser Jürgen Stock. Die maakte een einde aan verschillende samenwerkingsovereenkomsten en beloofde meer transparantie. \"Sinds 2015 worden er geen giften meer geaccepteerd van de tabaks-, wapen-, alcohol-, seks- en gokindustrie\", laat Interpol zelf weten."
                            },
                            {
                                "example_id": "2da458e8-58ee-4871-ac69-6ddf4df02249",
                                "sense_id": "44a18861-1eb9-3e33-a25a-5c3764424b81",
                                "text": "AFM-bestuursvoorzitter Merel van Vroonhoven waarschuwt in de Volkskrant dat beleggen begint te lijken op gokken en gamen. \"Financiële producten, zoals cryptovaluta of binaire opties - wat zeer risicovolle producten zijn - worden aan de man gebracht met verleidingstechnieken die we kennen uit de wereld van de games en de online gokindustrie.\""
                            },
                            {
                                "example_id": "021c90a8-e649-4948-bd5f-fa5f7bf627cd",
                                "sense_id": "44a18861-1eb9-3e33-a25a-5c3764424b81",
                                "text": "Volgens Schrils heeft de maffia een flinke vinger in de pap op het Nederlandse deel van het eiland. Vorig jaar werd op Sint-Maarten de beruchte casinobaas Francesco Corallo opgepakt. De gokindustrie zou banden hebben met politieke partijen op het eiland, meldt anti-corruptieorganisatie Transparency International."
                            }
                        ]
                    }
