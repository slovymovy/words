                "senses": [
                    {
                        "sense_id": "707ce64a-ce74-32bc-adc8-eb236e124af6",
                        "entry_id": "9a18e9aa-7537-3407-99cc-67c09ad04ab9",
                        "glosses": [
                            "self-delusion, self-deception, lived lie, (rare) life lie (a delusion that is at the core of how a person or a group see themselves and that is part of their identity)"
                        ],
                        "tags": [
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "2b25ee84-cf37-4294-9936-ee8371df99fc",
                                "sense_id": "707ce64a-ce74-32bc-adc8-eb236e124af6",
                                "text": "Gregers. Herr Doktor, ich ruhe nicht, bis ich Hjalmar aus Ihren Klauen befreit habe.\nRelling. Das wäre für ihn das größte Unglück. Nehmen Sie einem Durchschnittsmenschen die Lebenslüge, und Sie nehmen ihm zu gleicher Zeit das Glück.",
                                "translation": "Gregers. Doctor, I will not rest until I have freed Hjalmar from your claws.\nRelling. That would be the greatest misfortune for him. If you take from an average person the lie they are living, you at the same time take away their happiness.",
                                "english": "Gregers. Doctor, I will not rest until I have freed Hjalmar from your claws.\nRelling. That would be the greatest misfortune for him. If you take from an average person the lie they are living, you at the same time take away their happiness."
                            },
                            {
                                "example_id": "f8578356-c620-4768-bef4-25e7dab2f392",
                                "sense_id": "707ce64a-ce74-32bc-adc8-eb236e124af6",
                                "text": "Hieß es seit den 1960er Jahren, die Wiedervereinigung sei die Lebenslüge der Bundesrepublik, so erscholl es mit der Wiedervereinigung Deutschlands ab 1989/90 aus dem Munde eher konservativer Historiker, die postnationale Demokratie sei die Lebenslüge der Bundesrepublik gewesen."
                            },
                            {
                                "example_id": "d14b6b05-9725-4d00-a2ef-4410dafc0293",
                                "sense_id": "707ce64a-ce74-32bc-adc8-eb236e124af6",
                                "text": "Das normative Projekt des Westens beginnt schon mit einer Lebenslüge. Die Unterzeichner der ersten Menschenrechtserklärung von 1776 in Virginia waren zum erheblichen Teil Sklavenhalter.",
                                "translation": "The normative project of the West already starts with a self-delusion. A large part of the signatories of the first Declaration of Human Rights of 1776 in Virginia were slaveholders.",
                                "english": "The normative project of the West already starts with a self-delusion. A large part of the signatories of the first Declaration of Human Rights of 1776 in Virginia were slaveholders."
                            }
                        ]
                    }
