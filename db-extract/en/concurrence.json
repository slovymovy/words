                    },
                    {
                        "sense_id": "6a8ff146-cd51-387a-a1f9-081633a672be",
                        "entry_id": "4f128c21-896a-32c6-9343-79a76cb47e62",
                        "glosses": [
                            "An instance of simultaneous occurrence."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "1dde8a07-f381-4986-89b1-bf45cc2a5b9c",
                                "sense_id": "6a8ff146-cd51-387a-a1f9-081633a672be",
                                "text": "The time came when they ceased to cry and began to think; by the way, if Georgiana had not, from a concurrence of circumstances, been enabled to eat her breakfast, this operation of the mind could not have been engaged in without further injury, for she was, indeed, weak and exhausted;..."
                            },
                            {
                                "example_id": "fb36d651-8cba-422f-afba-4d5183d946b9",
                                "sense_id": "6a8ff146-cd51-387a-a1f9-081633a672be",
                                "text": "This book owes its existence to a concurrence of accidents."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e436b26d-17cc-4ea6-ac5d-1d755714f2a3",
                        "source_entry_id": "4f128c21-896a-32c6-9343-79a76cb47e62",
