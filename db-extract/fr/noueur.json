                        "sense_id": "1ae5f2b5-48fa-362d-a7d0-6b075c28943b",
                        "entry_id": "2e0e4896-1cc2-3d4c-b08f-fdb27831f762",
                        "glosses": [
                            "Personne qui fait des nœuds, qui est chargée de nouer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67658782-8998-4fdf-b28d-f911547d1a99",
                                "sense_id": "1ae5f2b5-48fa-362d-a7d0-6b075c28943b",
                                "text": "Le noueur sʼassure quʼy a pas de défauts dans le tissu, et si tout va bien le tisseur met le métier en marche."
                            },
                            {
                                "example_id": "f5de990a-e77e-417b-98d3-29106e52feb9",
                                "sense_id": "1ae5f2b5-48fa-362d-a7d0-6b075c28943b",
                                "text": "Une fois celle-ci arrivée, il lui fallait la monter, la nouer (à la charge du tisseur, la noueuse recevait 2 F pour son travail) et, enfin, la « mettre en train »."
                            }
                        ]
                    }
                ],
