                ],
                "senses": [
                    {
                        "sense_id": "dcaf2df1-6c03-33eb-8b9f-6e04d6e2ba72",
                        "entry_id": "0f0a74c1-c4ee-3c86-a462-5f2aab391fa7",
                        "glosses": [
                            "Arbeitstreffen/Meeting (Sitzung) der Minister einer Regierung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e34a2122-d6b0-4b5b-b47a-e400105a6e8f",
                                "sense_id": "dcaf2df1-6c03-33eb-8b9f-6e04d6e2ba72",
                                "text": "„Es stimmt: Die Kabinettssitzung war diese Woche ausnahmsweise bei der Kabinettsklausur am Montag in Meseberg abgehalten worden.“"
                            },
                            {
                                "example_id": "0fc96b11-204f-41c8-b49d-78112cab15d2",
                                "sense_id": "dcaf2df1-6c03-33eb-8b9f-6e04d6e2ba72",
                                "text": "„Der Bayerische Ministerrat hat in der heutigen Kabinettssitzung entscheidende Weichen in der Sozial- und Gesundheitspolitik gestellt.“"
                            },
                            {
                                "example_id": "b578b271-d1c6-4331-88e4-c64ba1dc602e",
                                "sense_id": "dcaf2df1-6c03-33eb-8b9f-6e04d6e2ba72",
                                "text": "„Dieser Besuch steht im Einklang mit dem Vertrag von Aachen, der am 22. Januar 2019 unterzeichnet wurde und vorsieht, dass ein Mitglied der Regierung einer der beiden Staaten einmal im Quartal an einer Kabinettssitzung des anderen Staates teilnimmt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
