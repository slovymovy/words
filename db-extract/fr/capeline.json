        "fr-extract.jsonl": [
            {
                "entry_id": "d7afc98c-f78b-3200-b197-2c4d0b676a76",
                "word": "capeline",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "411ec7eb-e6f1-4b96-b32a-30e858da085a",
                        "entry_id": "d7afc98c-f78b-3200-b197-2c4d0b676a76",
                        "tags": [
                            "plural"
                        ],
                        "form": "capelines"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "73180846-d72b-393a-9395-fe7a852598af",
                        "entry_id": "d7afc98c-f78b-3200-b197-2c4d0b676a76",
                        "glosses": [
                            "Chapeau de femme à bords souples pouvant éventuellement être rabattus et attachés."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "34b8eb20-cced-4ff2-a2c3-aefb0ca94343",
                                "sense_id": "73180846-d72b-393a-9395-fe7a852598af",
                                "text": "[…] et elle était apparue debout, les mains ouvertes devant les épaules, haussant la tête sous une capeline de corail qui tremblait le long des joues."
                            },
                            {
                                "example_id": "76934ee6-5555-4555-b9dc-450c3281ac29",
                                "sense_id": "73180846-d72b-393a-9395-fe7a852598af",
                                "text": "Au fond de la pièce, près du fourneau, la vieille femme se tenait assise dans son fauteuil rouge, une capeline sur la tête et les épaules, les mains jointes au creux du tablier, les pieds sur une chaufferette."
                            },
                            {
                                "example_id": "8a9bbbd2-7173-4eac-bda7-92628ca02cf6",
                                "sense_id": "73180846-d72b-393a-9395-fe7a852598af",
                                "text": "J’aimais la caresse soyeuse de ma robe en foulard bleu ; un ruban de velours noir retenait mes boucles et je portais une capeline de paille bise, fleurie de coquelicots et de bleuets."
                            }
                        ]
                    },
                    {
                        "sense_id": "1ca1a4ea-3f58-315c-bd6e-45d961306ee6",
                        "entry_id": "d7afc98c-f78b-3200-b197-2c4d0b676a76",
                        "glosses": [
                            "Capote légère de femme qui tombe sur les épaules."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "23c6e72e-a976-4879-9055-d8f5b7d24cbf",
                                "sense_id": "1ca1a4ea-3f58-315c-bd6e-45d961306ee6",
                                "text": "Devant l’auberge, elle questionna une bourgeoise en capeline de veuve, et qui précisément cherchait une cuisinière."
                            },
                            {
                                "example_id": "fa713670-d1bb-4977-bf39-f2fa9cc2d277",
                                "sense_id": "1ca1a4ea-3f58-315c-bd6e-45d961306ee6",
                                "text": "Puis, en bas, dans des casiers, sur des tables, au milieu d’un empilement de coupons, débordaient des articles de bonneterie vendus pour rien, gants et fichus de laine tricotés, capelines, gilets, tout un étalage d’hiver aux couleurs bariolées."
                            },
                            {
                                "example_id": "0b62bcd0-95f1-4e76-b208-e2d287f5a33a",
                                "sense_id": "1ca1a4ea-3f58-315c-bd6e-45d961306ee6",
                                "text": "J’étais dans ma chambre, deux heures plus tard, quand ma mère entra portant sa capeline de voyage et un long châle de Paisley."
                            }
                        ]
                    },
                    {
                        "sense_id": "77c8eb07-6b71-3ab1-8456-c1376ab9a62e",
                        "entry_id": "d7afc98c-f78b-3200-b197-2c4d0b676a76",
                        "glosses": [
                            "Casque de fer qui faisait partie de l’armure."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "c3bfb496-88df-3370-8e53-1eae44280e07",
                        "entry_id": "d7afc98c-f78b-3200-b197-2c4d0b676a76",
