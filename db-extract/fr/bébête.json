                ],
                "senses": [
                    {
                        "sense_id": "59cead17-d514-3e61-ac68-586f5fe37082",
                        "entry_id": "f8a06dfe-16d5-3aa8-ab8d-4555d6067044",
                        "glosses": [
                            "Animal, bête."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "b77b937f-510d-4077-a52d-5c0f89f77ce4",
                                "sense_id": "59cead17-d514-3e61-ac68-586f5fe37082",
                                "text": "Son truc : les bébêtes effrayantes, qu’il a notamment croisées à Bekasi, Jakarta, Batam ou encore sur l’île de Java occidentale."
                            },
                            {
                                "example_id": "1e55b6ed-7197-4b04-bdf5-cb9f4db1ecef",
                                "sense_id": "59cead17-d514-3e61-ac68-586f5fe37082",
                                "text": "Allons butiner la fleurette,\nTu m’épouilleras de mes bébêtes."
                            },
                            {
                                "example_id": "3de4b612-7ba9-43f6-9f4e-55fe57879867",
                                "sense_id": "59cead17-d514-3e61-ac68-586f5fe37082",
                                "text": "Des bébêtes sanguinolentes\nMolles comme une omelette\nDes machins qui se traînent mi-chenille mi-humain\nDes trucs pas câlins qu’ont toujours super faim"
                            }
                        ]
                    },
                    {
                        "sense_id": "f5eb5a2c-75f0-3a08-b303-7230f50ae087",
                        "entry_id": "f8a06dfe-16d5-3aa8-ab8d-4555d6067044",
                        "glosses": [
                            "Pénis, zizi."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "2e24e4f7-d3dd-4ebf-b0d6-19c3d7eb871d",
                                "sense_id": "f5eb5a2c-75f0-3a08-b303-7230f50ae087",
                                "text": "Ne touche pas à ta petite bébête !"
                            },
                            {
                                "example_id": "c5e25cbc-718b-4c7d-87f7-7a0062045d58",
                                "sense_id": "f5eb5a2c-75f0-3a08-b303-7230f50ae087",
                                "text": "Tous les prêtres, les éducateurs, les toubibs et sans doute le Maréchal faisaient une guerre incessante à la masturbation ! On nous montrait des photographies d'avortons, d'affreux scrofuleux crétins comme exemples... ce que vous allez devenir si vous vous touchez trop la bébête !"
                            }
                        ]
                    },
                    {
                        "sense_id": "1d9907ac-0217-32aa-8bf4-6c68c7919a79",
                        "entry_id": "f8a06dfe-16d5-3aa8-ab8d-4555d6067044",
                        "glosses": [
                            "Désigne le Diable. masculin"
                        ],
                        "tags": [
                            "La Réunion"
                        ],
                        "examples": [
                            {
                                "example_id": "f2eae5c5-5761-4e33-a1d8-cbe7dbed21e5",
                                "sense_id": "1d9907ac-0217-32aa-8bf4-6c68c7919a79",
                                "text": "Sur un mur, une inscription surmontée d’un tissu rouge : Attention Bébête !"
                            },
                            {
                                "example_id": "1fad4501-c2e1-40fb-9229-f347a1a9fcbd",
                                "sense_id": "1d9907ac-0217-32aa-8bf4-6c68c7919a79",
                                "text": "L’affaire marchait bien puisque aucun goulou, aucun bébête n’avait troublé sa tranquillité jusqu’à présent."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4d2f1d29-8ab8-4c06-9717-10138200759c",
                        "source_entry_id": "f8a06dfe-16d5-3aa8-ab8d-4555d6067044",
                        "source_sense_description": "Animal",
                        "target_lang_word": "Tierchen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tierchen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fca83fa2-324b-3744-8edd-71e1b0c0ac2e",
                                        "entry_id": "01f3126e-e6e5-3e76-a7ab-d67388a9d0fa",
                                        "glosses": [
                                            "kleines Tier, junges Tier"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3dabbeb-e7bd-4732-a673-90503692a613",
                                                "sense_id": "fca83fa2-324b-3744-8edd-71e1b0c0ac2e",
                                                "text": "Die Kinder pflegten das verletzte Tierchen wieder gesund."
                                            },
                                            {
                                                "example_id": "a957090e-d927-4e8b-85d6-7f5b3509d130",
                                                "sense_id": "fca83fa2-324b-3744-8edd-71e1b0c0ac2e",
                                                "text": "„Der Wirt schmeckt an seiner Plombe, man muß den Stieglitz mehr ans Fenster rücken, solch Tierchen will auch ein bißchen Licht.“"
                                            },
                                            {
                                                "example_id": "f851dd53-5b4a-4d50-9cb0-7c0f31183260",
                                                "sense_id": "fca83fa2-324b-3744-8edd-71e1b0c0ac2e",
                                                "text": "„Uns, als künftigen Weltraumpassagieren, drängt sich die Frage auf, was die Tierchen unter diesen ungewöhnlichen Umständen bewogen haben mag, sich so kühn zu vermehren.“"
                                            },
                                            {
                                                "example_id": "76c336d2-381d-4ae8-bcaa-10de9ce89218",
                                                "sense_id": "fca83fa2-324b-3744-8edd-71e1b0c0ac2e",
                                                "text": "„Im Schrank roch es seltsam, und sie war sicher, dass allerlei Tierchen herumkrabbelten, aber dort konnte ihr niemand etwas anhaben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1fd109eb-e27d-4a71-80f1-1e60c5c8a4f4",
                        "source_entry_id": "f8a06dfe-16d5-3aa8-ab8d-4555d6067044",
                        "source_sense_description": "Animal",
                        "target_lang_word": "Viech",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Viech",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2c731b66-74b3-328a-ad11-10b3ae6d7ad1",
                                        "entry_id": "f892a028-c285-30e4-9afa-f8784594306a",
                                        "glosses": [
                                            "Tier"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c913dbd8-8e22-424e-815d-e158b699505d",
                                                "sense_id": "2c731b66-74b3-328a-ad11-10b3ae6d7ad1",
                                                "text": "Im Zoo sind allerlei seltsame Viecher zu sehen."
                                            },
                                            {
                                                "example_id": "5d4522ae-82fc-44c4-95c3-4967287e04d5",
                                                "sense_id": "2c731b66-74b3-328a-ad11-10b3ae6d7ad1",
                                                "text": "„Bevor ich irgendeinen Gedanken fassen konnte, rasten die verrückten Viecher davon, der alte klapprige Wagen hüpfte auf und ab wie ein Schiff im Hurrikan, und mir wurden fast die Arme vom Leib getrennt, während ich verzweifelt an den Zügeln riß.“"
                                            },
                                            {
                                                "example_id": "fe4e298a-074a-43bb-a81f-a0e1fa48b4df",
                                                "sense_id": "2c731b66-74b3-328a-ad11-10b3ae6d7ad1",
                                                "text": "„Wenn ich sehr schnell gefahren bin, sind mir immerzu irgendwelche Viecher ins Gesicht und manchmal sogar direkt ins Auge geflogen.“"
                                            },
                                            {
                                                "example_id": "0585f807-3bea-4596-9c96-2e57f2ea4fad",
                                                "sense_id": "2c731b66-74b3-328a-ad11-10b3ae6d7ad1",
                                                "text": "„Schließlich füttert er die Viecher seit zwanzig Jahren.“"
                                            },
                                            {
                                                "example_id": "3ebcae6a-c315-474b-b0b3-f4b2565ccf57",
                                                "sense_id": "2c731b66-74b3-328a-ad11-10b3ae6d7ad1",
                                                "text": "„Die Viecher waren wach geworden und begannen zu grunzen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c5c951eb-42e7-3b90-9d88-96aec243829c",
                                        "entry_id": "f892a028-c285-30e4-9afa-f8784594306a",
                                        "glosses": [
                                            "roher, brutaler Mensch"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8bc49f34-d24d-47f2-999d-92d116eacaad",
                                                "sense_id": "c5c951eb-42e7-3b90-9d88-96aec243829c",
                                                "text": "Er hat sich als ausgesprochenes Viech aufgeführt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
