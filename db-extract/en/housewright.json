                "forms": [
                    {
                        "form_id": "4a56b786-0c35-4cf2-b4b5-15979f16c6f6",
                        "entry_id": "c932f33b-9421-3114-8e50-db244389b6d5",
                        "tags": [
                            "plural"
                        ],
                        "form": "housewrights"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "604ff9c1-d879-3a7e-af4e-c56eb18360e0",
                        "entry_id": "c932f33b-9421-3114-8e50-db244389b6d5",
                        "glosses": [
                            "A person who builds and repairs houses, especially wooden houses. Particularly, in eighteenth-century colonial America, a craftsman who cut timber (like a lumberjack) in the quantity required for the construction of a house, then sawed it into planks, and finally jointed and assembled them (like a carpenter)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48806bb3-78bb-4d0e-a5c5-2ef379ff5b68",
                                "sense_id": "604ff9c1-d879-3a7e-af4e-c56eb18360e0",
                                "text": "The north and west corners are indeed sometimes penetrated by the rain and require a little attention from the housewright to remedy the evil."
                            },
                            {
                                "example_id": "9121b0a8-1358-4503-b83d-0537917cd614",
                                "sense_id": "604ff9c1-d879-3a7e-af4e-c56eb18360e0",
                                "text": "The names of the colonial craftsmen had changed. The joiner and the turner and the housewright had become the cabinet-maker, the chair-maker, and the carpenter."
                            },
                            {
                                "example_id": "be51f808-0857-49c1-9a68-a92ba2590164",
                                "sense_id": "604ff9c1-d879-3a7e-af4e-c56eb18360e0",
                                "text": "John Johnson resided in Woburn, Mass., and was by occupation a housewright or carpenter and owned a saw-mill in Woburn."
                            }
                        ]
                    }
                ],
