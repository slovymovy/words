                "senses": [
                    {
                        "sense_id": "0fed8765-8a20-391a-a965-a5ba0e6e8b9f",
                        "entry_id": "e1acb8e4-cdea-3eb4-9b0a-e4fb6fcd8e7c",
                        "glosses": [
                            "Donner un caractère thermogène à."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "9d06b3cd-8d5f-4431-95a1-533b867c45cb",
                                "sense_id": "0fed8765-8a20-391a-a965-a5ba0e6e8b9f",
                                "text": "Les extraits de thé vert, ainsi que le métabolisme, aident également à thermogéniser ou à augmenter les dépenses énergétiques du corps."
                            },
                            {
                                "example_id": "2b1d95df-43ee-4ab5-9ec1-911e621112a7",
                                "sense_id": "0fed8765-8a20-391a-a965-a5ba0e6e8b9f",
                                "text": "Pneus neige ou pneus thermogénisés: ce type de pneu améliore l'adhérence sur neige fraîche."
                            },
                            {
                                "example_id": "0534f1f3-4361-4ad2-b3fc-86e822196686",
                                "sense_id": "0fed8765-8a20-391a-a965-a5ba0e6e8b9f",
                                "text": "La caféine est souvent un composant des pilules de perte de poids car elles permettent au corps de se thermogéniser."
                            }
                        ]
                    }
