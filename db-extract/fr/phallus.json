        "fr-extract.jsonl": [
            {
                "entry_id": "aa6ab169-54bf-39ef-aafc-398a99c2ee13",
                "word": "phallus",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "5c052ddc-89da-4461-a08d-c7479504849f",
                        "entry_id": "aa6ab169-54bf-39ef-aafc-398a99c2ee13",
                        "tags": [],
                        "form": "phalle"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f420d4f8-0583-390b-a90f-58e4e683bf5c",
                        "entry_id": "aa6ab169-54bf-39ef-aafc-398a99c2ee13",
                        "glosses": [
                            "Représentation du membre viril en érection, emblème de la fécondité, de la puissance génésique."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "df3277c0-cc63-4135-b92b-2bad58ad5aab",
                                "sense_id": "f420d4f8-0583-390b-a90f-58e4e683bf5c",
                                "text": "Du temps que j’étais gouverneur de Syrie, j’ai vu des phallus érigés sur les propylées de la ville d’Héra."
                            },
                            {
                                "example_id": "0187ef37-ddd2-409a-83c7-ae61fbcb3a0f",
                                "sense_id": "f420d4f8-0583-390b-a90f-58e4e683bf5c",
                                "text": "Dans une comédie, il fallait bien sûr que les phallus pendouillassent par moments, mais il fallait aussi qu'ils pussent se dresser sur commande. Tout le monde savait cela."
                            }
                        ]
                    },
                    {
                        "sense_id": "ec803331-c064-3d72-a6bc-84142a5f9203",
                        "entry_id": "aa6ab169-54bf-39ef-aafc-398a99c2ee13",
                        "glosses": [
                            "Concept psychanalytique recouvrant le désir de puissance ou la puissance attribuée à l’objet d’un désir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "64ed7363-bf7a-43ad-acde-b13059b566b9",
                                "sense_id": "ec803331-c064-3d72-a6bc-84142a5f9203",
                                "text": "avoir le phallus."
                            },
                            {
                                "example_id": "8af800fa-eabd-4076-a55f-765d95d4894c",
                                "sense_id": "ec803331-c064-3d72-a6bc-84142a5f9203",
                                "text": "Le phallus maternel."
                            }
                        ]
                    },
                    {
                        "sense_id": "add0369d-e6d8-37a5-8c2c-906550bff46f",
                        "entry_id": "aa6ab169-54bf-39ef-aafc-398a99c2ee13",
                        "glosses": [
                            "Concept psychanalytique recouvrant le désir de puissance ou la puissance attribuée à l’objet d’un désir.",
                            "Signifiant du manque."
                        ],
                        "tags": [
                            "Chez Lacan"
                        ],
                        "examples": [
                            {
                                "example_id": "c9893fd5-4e16-4adc-ae7b-70d2d3b4aadd",
                                "sense_id": "add0369d-e6d8-37a5-8c2c-906550bff46f",
                                "text": "Le phallus dans la doctrine freudienne n’est pas un fantasme […]. Il n’est pas non plus comme tel un objet (partiel, interne, bon, mauvais etc.) […]. Il est encore bien moins l’organe, pénis ou clitoris, qu’il symbolise […]. C’est le signifiant destiné à désigner dans leur ensemble les effets de signifié, en tant que le signifiant les conditionne par sa présence de signifiant."
                            }
                        ]
                    },
                    {
                        "sense_id": "f1a73fe0-0e11-3fc2-9b08-a131035acaf4",
                        "entry_id": "aa6ab169-54bf-39ef-aafc-398a99c2ee13",
                        "glosses": [
                            "Champignon, également appelé satyre puant, de forme phallique, à odeur repoussante."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "df8800c7-3ab5-4189-b537-30bc3ea394a9",
                        "source_entry_id": "aa6ab169-54bf-39ef-aafc-398a99c2ee13",
                        "source_sense_description": "Pénis en érection",
                        "target_lang_word": "Phallus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Phallus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "752775f7-1183-3362-a820-018910686c16",
                                        "entry_id": "4544e46f-25aa-334a-8b59-a33473ce5b40",
                                        "glosses": [
                                            "das erigierte männliche Glied (oft in kulturgeschichtlichen Zusammenhängen)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a051aabb-d6f6-4ca6-aa9f-d3dfc59e96a3",
                                                "sense_id": "752775f7-1183-3362-a820-018910686c16",
                                                "text": "„Auf dem Kornhausplatz fand am Mittwoch zum zweiten Mal die Verleihung des goldenen Phallus statt.“"
                                            },
                                            {
                                                "example_id": "ba1865ac-b156-496c-b109-66a01e7daee4",
                                                "sense_id": "752775f7-1183-3362-a820-018910686c16",
                                                "text": "„Insgesamt drei Arten, die Phalli auszustellen, hat er sich ausgedacht: getrocknet, als Ganzes in Formalin (mal mit, mal ohne Hoden) oder schlicht die Penisknochen.“"
                                            },
                                            {
                                                "example_id": "0f755c8a-d901-42a6-af69-a263aa6071eb",
                                                "sense_id": "752775f7-1183-3362-a820-018910686c16",
                                                "text": "„Dank seiner Sammelleidenschaft umfasst seine Kollektion inzwischen Phalli aller auf Island beheimateten Säugetiere vom Buckelwal bis zur Maus.“"
                                            },
                                            {
                                                "example_id": "beb9464b-575c-459b-86cc-b22c02a7f2bc",
                                                "sense_id": "752775f7-1183-3362-a820-018910686c16",
                                                "text": "„Sie zeigt einen nackten Krieger mit erigiertem Phallus wohl als Zeichen seiner Potenz, die ihn wahrscheinlich als Ahnherr eines Clans beziehungsweise einer Fürstendynastie kennzeichnen sollte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9b87c71c-2936-3131-86b9-15212d9a9c1f",
                                        "entry_id": "4544e46f-25aa-334a-8b59-a33473ce5b40",
                                        "glosses": [
                                            "die embryonale Vorstufe von Penis und Klitoris"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b69b9c0c-dc23-4781-9e7a-da1acda5e541",
                                                "sense_id": "9b87c71c-2936-3131-86b9-15212d9a9c1f",
                                                "text": "„Der Genitalhöcker verlängert sich rasch zur Anlage des Phallus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "cbb71c75-f67a-3bfa-beba-5474d092ce99",
                                        "entry_id": "4544e46f-25aa-334a-8b59-a33473ce5b40",
                                        "glosses": [
                                            "zu den Ständerpilzen gehörige Pilzgattung"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9976b763-b714-4213-b476-6daf6e094712",
                                                "sense_id": "cbb71c75-f67a-3bfa-beba-5474d092ce99",
                                                "text": "„Einen europäischen Pilz (die Stinkmorchel) nannte er Phallus impudicus und ein Bohnengewächs aus Amerika Clitoria, weil er meinte, die beiden sähen aus wie Penis und Klitoris. Beide heißen heute noch so.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
