                "senses": [
                    {
                        "sense_id": "0b4cf8d0-4545-3bc1-89fc-6f807681f763",
                        "entry_id": "3117430e-fc7e-3096-9c79-8085f93018b4",
                        "glosses": [
                            "sunrise"
