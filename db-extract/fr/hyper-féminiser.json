                        "glosses": [
                            "Féminiser à l’extrême."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ccd661d-8aae-469e-aa17-6c1941f569bd",
                                "sense_id": "d7db727a-24ed-320c-a261-1b201eef2cc1",
                                "text": "Non seulement il habillait une de mes idoles de préadolescente (Madonna), non seulement il réussissait à hyper-féminiser les femmes tout en les rendant puissantes (voir le corset avec les bonnets en métal), mais en plus il troublait les codes de genre, mettant des jupes aux hommes et valorisant des figures viriles gays."
                            },
                            {
                                "example_id": "2c5e30d5-9732-4448-a9bc-f9facf3ef0d2",
                                "sense_id": "d7db727a-24ed-320c-a261-1b201eef2cc1",
                                "text": "Ces substances féminisent les embryons mâles et hyper-féminisent les embryons femelles."
                            }
                        ]
                    }
