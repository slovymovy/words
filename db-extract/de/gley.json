                                "sense_id": "fba71774-74bd-364c-b7ed-87ada71af61f",
                                "text": "„Der Gley ( russisch: „sumpfiger Boden“) gehört zu den sogenannten hydromorphen, d.h. vom Bodenwasser beeinflussten, Böden.“"
                            },
                            {
                                "example_id": "b72c29e9-ad9e-45bd-82a9-9fa4576739b9",
                                "sense_id": "fba71774-74bd-364c-b7ed-87ada71af61f",
                                "text": "„Grundwasserböden (= Gley) sind in der Tiefe ständig mit Wasser gesättigt.“"
                            }
                        ],
