                                "example_id": "a7b4762b-6c62-4a48-b9a2-be5e61c15d99",
                                "sense_id": "8c3c836f-c0f2-344e-b152-f329da708bf0",
                                "text": "„Wird Frederic D. die radikale Umstellung schaffen und so von den Gichttabletten weg kommen?“"
                            },
                            {
                                "example_id": "fa4a8537-cae1-486b-83b9-21950f41a336",
                                "sense_id": "8c3c836f-c0f2-344e-b152-f329da708bf0",
                                "text": "„Hier, im südlichen Afrika, war das Medikament ohne Rezept günstig zu bekommen, ebenso wie meine Gichttabletten und bestimmte Antibiotika.“"
                            }
