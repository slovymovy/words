                ],
                "senses": [
                    {
                        "sense_id": "44e406fa-21a1-35bf-8d03-cc0d79db7126",
                        "entry_id": "b850a24c-1d80-3d71-9e04-3014eacd1cb1",
                        "glosses": [
                            "стремление к чему-нибудь новому, поиски новых путей (в науке, искусстве)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d732a5c9-956e-449d-b8ec-ec7c9c711d05",
                                "sense_id": "44e406fa-21a1-35bf-8d03-cc0d79db7126",
                                "text": "Искания художника."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "86d6e95e-69a3-4146-87c2-52b65e5dc23d",
                        "source_entry_id": "b850a24c-1d80-3d71-9e04-3014eacd1cb1",
                        "source_sense_id": "44e406fa-21a1-35bf-8d03-cc0d79db7126",
                        "target_lang_word": "recherche",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "recherche",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7d58088e-ffba-3d39-be87-bd04d8652db1",
                                        "entry_id": "c584d3ae-845b-368a-8dd7-c02dd65113eb",
                                        "glosses": [
                                            "Action de rechercher."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34368724-2eb6-4cdd-92be-e24e662939ec",
                                                "sense_id": "7d58088e-ffba-3d39-be87-bd04d8652db1",
                                                "text": "Et il s’abîma en des recherches mentales, évidemment compliquées et très pénibles, s’il fallait en juger par les diverses grimaces qui se succédèrent sur son visage, […]."
                                            },
                                            {
                                                "example_id": "3797c517-2b78-4590-ae66-d322df9ccb48",
                                                "sense_id": "7d58088e-ffba-3d39-be87-bd04d8652db1",
                                                "text": "Rentrée à la maison, ayant réussi à faire partager aux voisins son inquiétude, Mme Mirondeau les décida, […], à partir sans tarder à la recherche de son époux."
                                            },
                                            {
                                                "example_id": "fc1c1ab9-baf0-4a98-b580-6200278d192d",
                                                "sense_id": "7d58088e-ffba-3d39-be87-bd04d8652db1",
                                                "text": "Ce n’est qu’en 1930 que son assistant, Clyde Tombough, a trouvé, après une recherche exhaustive parmi des milliers de plaques photographiques, une nouvelle planète."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3c044c3-33e2-30f9-a824-45e7efc28367",
                                        "entry_id": "c584d3ae-845b-368a-8dd7-c02dd65113eb",
                                        "glosses": [
                                            "Travaux de science et d’érudition. Publication de ces travaux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1caba9e9-858f-4d46-8488-7577838efe1f",
                                                "sense_id": "f3c044c3-33e2-30f9-a824-45e7efc28367",
                                                "text": "Solanum anomalum restera un légume-fruit secondaire. Sa taxinomie, sa composition nutritionnelle et ses propriétés médicinales nécessitent des recherches."
                                            },
                                            {
                                                "example_id": "84367955-878a-40dd-9001-8f2aa1664682",
                                                "sense_id": "f3c044c3-33e2-30f9-a824-45e7efc28367",
                                                "text": "Ce livre a été écrit d’après les dernières recherches de l’érudition."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cff2c2df-b888-3da0-8d25-68483819bcd7",
                                        "entry_id": "c584d3ae-845b-368a-8dd7-c02dd65113eb",
                                        "glosses": [
                                            "Enquête."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "081780b3-f2c9-4eae-a33d-9a62659dd39e",
                                                "sense_id": "cff2c2df-b888-3da0-8d25-68483819bcd7",
                                                "text": "La recherche des concussionnaires."
                                            },
                                            {
                                                "example_id": "01464724-cf4c-482f-b13c-ad34801e6e30",
                                                "sense_id": "cff2c2df-b888-3da0-8d25-68483819bcd7",
                                                "text": "La recherche des faux nobles. Il a vieilli dans cette acception."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a5e98138-ccb8-3f7f-9d66-2dd20b6c02cc",
                                        "entry_id": "c584d3ae-845b-368a-8dd7-c02dd65113eb",
                                        "glosses": [
                                            "Enquête judiciaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2271a60a-d2ec-4494-a5d3-87889c384a94",
                                                "sense_id": "a5e98138-ccb8-3f7f-9d66-2dd20b6c02cc",
                                                "text": "On ne lit aucune recherche sur sa mort."
                                            },
                                            {
                                                "example_id": "e504d729-58ba-41e4-b545-21c40660d96c",
                                                "sense_id": "a5e98138-ccb8-3f7f-9d66-2dd20b6c02cc",
                                                "text": "Toutes les recherches sont restées sans résultat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b58066be-2b9a-3c57-be8f-5abf1b00111c",
                                        "entry_id": "c584d3ae-845b-368a-8dd7-c02dd65113eb",
                                        "glosses": [
                                            "Démarches que l’on fait en vue de se marier."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e6c5ae02-6885-4892-8859-a94facd562fe",
                                                "sense_id": "b58066be-2b9a-3c57-be8f-5abf1b00111c",
                                                "text": "Faire la recherche d’une jeune fille."
                                            },
                                            {
                                                "example_id": "af81f6e6-08a3-4c6f-badc-499ad265a0d8",
                                                "sense_id": "b58066be-2b9a-3c57-be8f-5abf1b00111c",
                                                "text": "Faire agréer sa recherche."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86ff6f92-4afc-3051-8b85-96691dba0e97",
                                        "entry_id": "c584d3ae-845b-368a-8dd7-c02dd65113eb",
                                        "glosses": [
                                            "Soin, art, raffinement qu’on met dans certaines choses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1ed29f4-b785-41bd-9b8a-54daf5e484ea",
                                                "sense_id": "86ff6f92-4afc-3051-8b85-96691dba0e97",
                                                "text": "Une des recherches de leur luxe est encore d’avoir un très beau mouchoir de batiste brodé garni de dentelles."
                                            },
                                            {
                                                "example_id": "f3d91ef2-6154-457a-81b3-8cb08e9bdec9",
                                                "sense_id": "86ff6f92-4afc-3051-8b85-96691dba0e97",
                                                "text": "Les Vannetaises qui se rendaient au marché remarquèrent ce jeune homme, pour plusieurs motifs.\nD'abord, parce qu'il était fort bien de sa personne, et velu avec une certaine recherche élégante ; puis , parce qu'il n'était pas de la ville, […]."
                                            },
                                            {
                                                "example_id": "4212f090-5b61-444b-baeb-89a6ad5ad1be",
                                                "sense_id": "86ff6f92-4afc-3051-8b85-96691dba0e97",
                                                "text": "Cette femme est toujours mise avec recherche, avec une extrême recherche. Il comporte le plus souvent une nuance de blâme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "35262ae6-e963-3a5c-8f45-0b144ed849eb",
                                        "entry_id": "c584d3ae-845b-368a-8dd7-c02dd65113eb",
                                        "glosses": [
                                            "Réparation que l’on fait en remettant des tuiles, des ardoises ou des pavés aux endroits où il en manque."
                                        ],
                                        "tags": [
                                            "Couvreur",
                                            "Paveur"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e15c02e-ca2a-4c81-86a4-476cba8671eb",
                                                "sense_id": "35262ae6-e963-3a5c-8f45-0b144ed849eb",
                                                "text": "Il suffira de faire une recherche à ce pavé, à cette couverture."
                                            },
                                            {
                                                "example_id": "c3e245dc-5b4a-4209-90f5-35d4e7473358",
                                                "sense_id": "35262ae6-e963-3a5c-8f45-0b144ed849eb",
                                                "text": "Il faut faire une recherche par an pour entretenir cette chaussée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c330277-a2d7-32ae-b38b-d75f3e9c10f8",
                                        "entry_id": "c584d3ae-845b-368a-8dd7-c02dd65113eb",
                                        "glosses": [
                                            "Opération par laquelle on s’assure des arbres qui manquent et qui doivent être remplacés."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b3e535ef-b4cf-3521-bcf2-f42097ce60a0",
                                        "entry_id": "c584d3ae-845b-368a-8dd7-c02dd65113eb",
                                        "glosses": [
                                            "Recherche de renseignements."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
