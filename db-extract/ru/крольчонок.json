                ],
                "senses": [
                    {
                        "sense_id": "7f7fa7d2-712e-35ad-9f87-1abface52112",
                        "entry_id": "c8d4ad04-3b67-360f-aee8-54d565e8978b",
                        "glosses": [
                            "детёныш кролика"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c1cd1097-5773-40a7-a55a-0c04ecd5caea",
                                "sense_id": "7f7fa7d2-712e-35ad-9f87-1abface52112",
                                "text": "Крольчонок дрыгал лапками и кричал, совсем как маленький ребёнок."
                            },
                            {
                                "example_id": "556b4df0-957f-4a75-aaea-2616a8c6dba4",
                                "sense_id": "7f7fa7d2-712e-35ad-9f87-1abface52112",
                                "text": "Крольчат Нюрка выпустила на траву, в загон, огороженный сеткой."
                            },
                            {
                                "example_id": "07af3844-0475-49d1-930a-b1d82d336d79",
                                "sense_id": "7f7fa7d2-712e-35ad-9f87-1abface52112",
                                "text": "Кролики росли, появилось множество крольчат, поредели морковные грядки."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a0b076a3-f7db-4d3f-bb50-ccd1bf2b238f",
                        "source_entry_id": "c8d4ad04-3b67-360f-aee8-54d565e8978b",
