                        "examples": [
                            {
                                "example_id": "b9aa8016-f3b6-47ea-ab1d-e9e107ed1c65",
                                "sense_id": "e1672b04-fb09-318b-914d-f03f131313ed",
                                "text": "Une puissance qui s’affirme\n Le ton, on le sait aussi, a beaucoup changé à Pékin. Cette réunion annuelle de l’ANP permettra encore une fois de le constater."
                            },
                            {
                                "example_id": "93cf206c-9cf8-411c-a162-80e20a79e671",
                                "sense_id": "e1672b04-fb09-318b-914d-f03f131313ed",
                                "text": "À la suite du vote de jeudi, le comité permanent de l'ANP devrait être chargé de rédiger un projet de loi qui sera formellement approuvé par le Parlement chinois avant d'être imposé à Hong Kong."
                            }
                        ]
                    }
