                    {
                        "sense_id": "964953ac-3372-3509-abdf-530f8eb69baf",
                        "entry_id": "3d6d15f7-38e2-3d3f-ba79-1ac87e6f297c",
                        "glosses": [
                            "To undo the effects of curing; return (something) to an untreated state"
                        ],
                        "tags": [
                            "rare",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "1b74fdfa-4677-4bc1-b747-747d11378a16",
                                "sense_id": "964953ac-3372-3509-abdf-530f8eb69baf",
                                "text": "The fabrics are finished and cured at the mill and are then cut and sewn into garments. The garment is pressed with a hot head press which temporarily uncures the resin, then re-cures it, permanently setting the garment into the desired shape."
                            },
                            {
                                "example_id": "53dfe7f5-a274-4cf7-8d5f-216455788076",
                                "sense_id": "964953ac-3372-3509-abdf-530f8eb69baf",
                                "text": "Placement at 4°C \"uncures\" the slides, making the cover-slips slide around, so always leave them out for at least one night (manufacturer recommends 80 h) prior to examining the slides."
                            }
                        ]
                    }
