                "senses": [
                    {
                        "sense_id": "7ca572b8-b285-329f-ad41-35804e775216",
                        "entry_id": "d33db827-d970-357f-b7a7-659fab8218a6",
                        "glosses": [
                            "Alternative form of palone."
                        ],
                        "tags": [
                            "alt-of",
                            "alternative"
                        ],
                        "examples": [
                            {
                                "example_id": "54cf1470-2a76-46ff-b272-b68f9f261d5b",
                                "sense_id": "7ca572b8-b285-329f-ad41-35804e775216",
                                "text": "“What about that polony he was with?” ¶ “She doesn't matter”, the Boy said, “She's just a buer—he gave her a half. I saw him hand it out.”"
                            },
                            {
                                "example_id": "29fb8457-471f-4f0f-91fd-de5c4ecf6b9e",
                                "sense_id": "7ca572b8-b285-329f-ad41-35804e775216",
                                "text": "“I don't need a razor with a polony. If you don't know what it is, it's a bottle.”"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "24e15f36-2ae2-3b84-bd60-a35679091c10",
                "word": "polony",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ab7a536c-b9d1-338a-a3dc-62e897765bc0",
                        "entry_id": "24e15f36-2ae2-3b84-bd60-a35679091c10",
                        "glosses": [
                            "A cluster of polymers produced by clonal amplification of DNA."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "473aab42-c16f-482e-bf1c-394aa7d3b291",
                                "sense_id": "ab7a536c-b9d1-338a-a3dc-62e897765bc0",
                                "text": "Fluorescent in situ sequencing (FISSEQ) or beadbased polony sequencing FISSEQ involves localized amplification of single DNA molecules, using an acrylarnide gel, thus creating colonies of PCR product that are called polonies."
                            },
                            {
                                "example_id": "1b4d13b3-0a98-4d98-8cd8-ae60194f770d",
                                "sense_id": "ab7a536c-b9d1-338a-a3dc-62e897765bc0",
                                "text": "The development of polony technology is an extreme example of spatial compression; a polony array essentially consists of millions of distinguishable, immobilized, and femtoliter-scale \"test tubes\" filled with clonal DNA arising from individual DNA or RNA molecules via a single polymerase chain reaction (PCR)."
                            },
                            {
                                "example_id": "69c9bd66-701f-4aab-970a-fd331357ed55",
                                "sense_id": "ab7a536c-b9d1-338a-a3dc-62e897765bc0",
                                "text": "This cycle is repeated several dozen times to generate DNA sequence information for each polony."
                            }
                        ]
                    }
                ],
