        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "5578ab54-b138-352d-83a6-9bb4b412c1ce",
                "word": "polytope",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "dcb0f625-6091-41c3-a2ca-c499b6eb6187",
                        "entry_id": "5578ab54-b138-352d-83a6-9bb4b412c1ce",
                        "tags": [
                            "plural"
                        ],
                        "form": "polytopes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "80f9ead6-b61e-306d-b631-fb83ca3cd26f",
                        "entry_id": "5578ab54-b138-352d-83a6-9bb4b412c1ce",
                        "glosses": [
                            "A geometric shape (of any number of dimensions) which is fully enclosed and has flat sides, making it a member of the generalized class of shapes which includes the two-dimensional polygon and three-dimensional polyhedron; (formally) a finite region of n-dimensional space bounded by hyperplanes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "efcc917e-ce34-44ab-a892-b79b952d9d23",
                                "sense_id": "80f9ead6-b61e-306d-b631-fb83ca3cd26f",
                                "text": "As is well known, the theory of linear inequalities is closely related to the study of convex polytopes."
                            },
                            {
                                "example_id": "6d96bcb2-5831-4971-a4cc-2c5cdffdfaa7",
                                "sense_id": "80f9ead6-b61e-306d-b631-fb83ca3cd26f",
                                "text": "This polytope is mapped into a Cartesian force polytope (resp. torque polytope) in the Cartesian space. Such a polytope represents the exact force (resp. torque) that can be produced on the vehicle main body."
                            },
                            {
                                "example_id": "d1641830-4493-4169-95fc-f6b09d654e4a",
                                "sense_id": "80f9ead6-b61e-306d-b631-fb83ca3cd26f",
                                "text": "Verify the Hirsch conjecture for the 3-cube, 4-cube and any other polytope that takes your fancy.\nThe Steinitz theorem is a very satisfactory understanding of the graphs of three-dimensional polytopes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "34cb9e99-a8d6-49d5-b174-4815223681d1",
                        "source_entry_id": "5578ab54-b138-352d-83a6-9bb4b412c1ce",
                        "source_sense_id": "80f9ead6-b61e-306d-b631-fb83ca3cd26f",
