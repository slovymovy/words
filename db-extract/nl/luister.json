        "nl-extract.jsonl": [
            {
                "entry_id": "e625d46f-e15b-336b-8f10-72ee0f85c586",
                "word": "luister",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "56e6b982-9519-3712-817a-ae1a55f4ba5b",
                        "entry_id": "e625d46f-e15b-336b-8f10-72ee0f85c586",
                        "glosses": [
                            "straling, schitteringen, flonkering"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9cd81ce1-5561-4126-a443-23da71ff332d",
                                "sense_id": "56e6b982-9519-3712-817a-ae1a55f4ba5b",
                                "text": "De luister van de kerstmarkt is de trots van de stad Keulen."
                            },
                            {
                                "example_id": "28c5ecfe-a298-4c22-b700-144e32a95a10",
                                "sense_id": "56e6b982-9519-3712-817a-ae1a55f4ba5b",
                                "text": "Meneer Wang heeft nadrukkelijk verklaard dat het in zijn intenties ligt het hotel in zijn oude luister te herstellen, waarbij de financiële armslag waarover hij naar het zich laat aanzien beschikt zeer zeker van pas zal komen."
                            },
                            {
                                "example_id": "7f1a5ceb-d525-465e-bbb6-1b643d020e80",
                                "sense_id": "56e6b982-9519-3712-817a-ae1a55f4ba5b",
                                "text": "Zes jaar nadat een deel van de eeuwenoude stadsmuur van Maastricht plotseling was ingestort, is de vestingwal in oude luister hersteld. Vandaag is het open dag, nadat gisteravond de muur officieel werd heropend met een speciaal gebrouwen bier."
                            }
                        ]
                    },
                    {
                        "sense_id": "f1678ed2-ba73-331d-bc27-37b8416a5645",
                        "entry_id": "e625d46f-e15b-336b-8f10-72ee0f85c586",
                        "glosses": [
                            "gekendheid, aanzien, roem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e2de0c35-62d2-4bde-bf32-9668dc6ae91e",
                                "sense_id": "f1678ed2-ba73-331d-bc27-37b8416a5645",
                                "text": "De luister van de Harry Potter-sterren is ongeëvenaard."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0cc2a676-eeee-4241-b731-7fa9e07a743e",
                        "source_entry_id": "e625d46f-e15b-336b-8f10-72ee0f85c586",
                        "target_lang_word": "pomp",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pomp",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "667aff7e-8a11-3734-a9f1-e8d3bb4bd339",
                                        "entry_id": "0ac85a72-154d-33d3-a377-38ce00cbc61d",
                                        "glosses": [
                                            "Show of magnificence; parade; display; power."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0a1fb21-f377-4bfd-ae2f-295a5647f70e",
                                                "sense_id": "667aff7e-8a11-3734-a9f1-e8d3bb4bd339",
                                                "text": "'Tis a gross visible errour, which Tertullian teaches in his Book of Idolatry cap. 18. That all the marks of Dignity and Power, and all the ornaments annexed to Office, are forbid Christians, and that Jesus Christ hath plac'd all these things amongst the pomps of the Devil, since he himself appeared in a condition so far from all pomp and splendour."
                                            },
                                            {
                                                "example_id": "7731f2f9-41b0-41bb-9bbb-7159d1dc9378",
                                                "sense_id": "667aff7e-8a11-3734-a9f1-e8d3bb4bd339",
                                                "text": "The deafening claps of thunder and the dazzling flashes of lightning which lit up the ghastly scene testified that the artillery of heaven had lent its supernatural pomp to the already gruesome spectacle."
                                            },
                                            {
                                                "example_id": "42c482cf-fb94-4722-b4e2-d5c8cdeb93ff",
                                                "sense_id": "667aff7e-8a11-3734-a9f1-e8d3bb4bd339",
                                                "text": "In its pomp Victoria had 17 platforms, but many of the through platforms were demolished in the early 1990s to make way for the Manchester Arena."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5826d98e-8b99-3951-b2c1-d7880ed75080",
                                        "entry_id": "0ac85a72-154d-33d3-a377-38ce00cbc61d",
                                        "glosses": [
                                            "A procession distinguished by ostentation and splendor; a pageant."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ef80b0db-7cc0-450c-8baf-c77a60c0f2f6",
                                                "sense_id": "5826d98e-8b99-3951-b2c1-d7880ed75080",
                                                "text": "[…] a more beautiful expression of joy and thanksgiving than could have been exhibited by all the pomps of a Roman triumph."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pomp",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "419cf58e-0892-3600-8bd3-b2daf9132e57",
                                        "entry_id": "fa721b18-9ff2-3aec-a21d-0e37e23ebd57",
                                        "glosses": [
                                            "To make a pompous display."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e14b948-c263-46cc-bab3-3b7e1e60b9f4",
                                                "sense_id": "419cf58e-0892-3600-8bd3-b2daf9132e57",
                                                "text": "pomp'd for those hard trifles"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pomp",
