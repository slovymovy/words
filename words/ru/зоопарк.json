{
    "word_family": [
        "зоолог",
        "зоология",
        "зоологический",
        "зоотехник"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "583ba01e-aa08-36ea-9b20-43ddab072037",
                    "sense_definition": "Учреждение, где содержат диких животных для показа посетителям, изучения и сохранения видов.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "place",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В выходные мы с детьми ходили в <w>зоопарк</w> смотреть на тигров.",
                            "target_lang_translations": {
                                "en": "On the weekend, the children and I went to the <w>zoo</w> to look at the tigers.",
                                "de": "Am Wochenende sind wir mit den Kindern in den <w>Zoo</w> gegangen, um uns die Tiger anzusehen."
                            }
                        },
                        {
                            "text": "Городской <w>зоопарк</w> открывается в девять часов утра.",
                            "target_lang_translations": {
                                "en": "The city <w>zoo</w> opens at nine o'clock in the morning.",
                                "de": "Der städtische <w>Zoo</w> öffnet um neun Uhr morgens."
                            }
                        }
                    ],
                    "synonyms": [
                        "зоосад",
                        "зверинец"
                    ],
                    "common_phrases": [
                        "пойти в зоопарк",
                        "городской зоопарк",
                        "контактный зоопарк"
                    ],
                    "target_lang_definitions": {
                        "en": "An institution where wild animals are kept for exhibition, study, and conservation.",
                        "de": "Eine Einrichtung, in der Wildtiere zur Schau, zur wissenschaftlichen Untersuchung und zum Artenschutz gehalten werden."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "zoo",
                                "target_lang_sense_clarification": "place with animals"
                            },
                            {
                                "target_lang_word": "zoological garden",
                                "target_lang_sense_clarification": "formal"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Zoo",
                                "target_lang_sense_clarification": "Einrichtung zur Haltung von Tieren"
                            },
                            {
                                "target_lang_word": "Tiergarten",
                                "target_lang_sense_clarification": "formellere Bezeichnung für einen Zoo"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "39377cd5-e3f2-3691-9d14-f9c4c63ea04d",
                    "sense_definition": "Шумное, беспорядочное сборище людей, которые ведут себя некультурно или агрессивно.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "figurative_chaos",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "На собрании устроили настоящий <w>зоопарк</w>, никто никого не слушал.",
                            "target_lang_translations": {
                                "en": "They turned the meeting into a real <w>zoo</w>; nobody was listening to anyone.",
                                "de": "Auf der Versammlung herrschte ein echtes <w>Chaos</w>, niemand hat dem anderen zugehört."
                            }
                        },
                        {
                            "text": "Это не офис, а какой-то <w>зоопарк</w>.",
                            "target_lang_translations": {
                                "en": "This isn't an office, it's a total <w>zoo</w>.",
                                "de": "Das ist kein Büro, sondern ein wahres <w>Irrenhaus</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "зверинец"
                    ],
                    "common_phrases": [
                        "устроить зоопарк",
                        "настоящий зоопарк"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "неодобрительно"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A noisy, disorderly, or chaotic place or situation.",
                        "de": "Ein lärmender, ungeordneter oder chaotischer Ort oder eine solche Situation."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "zoo",
                                "target_lang_sense_clarification": "chaotic place"
                            },
                            {
                                "target_lang_word": "madhouse",
                                "target_lang_sense_clarification": "figurative"
                            },
                            {
                                "target_lang_word": "circus",
                                "target_lang_sense_clarification": "figurative"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Irrenhaus",
                                "target_lang_sense_clarification": "figurativ für chaotische Zustände"
                            },
                            {
                                "target_lang_word": "Zirkus",
                                "target_lang_sense_clarification": "figurativ für ein unorganisiertes Spektakel"
                            },
                            {
                                "target_lang_word": "Chaos",
                                "target_lang_sense_clarification": "allgemeiner Begriff für Unordnung"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eaa825e7-f4a4-3842-8eb4-6eb89ced80ae",
                    "sense_definition": "Набор разнородных, часто несовместимых программ или оборудования, которые сложно поддерживать.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "tech_slang",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Системному администратору трудно управлять таким <w>зоопарком</w> устройств.",
                            "target_lang_translations": {
                                "en": "It is difficult for a system administrator to manage such a <w>zoo</w> of devices.",
                                "de": "Für den Systemadministrator ist es schwierig, ein solches <w>Sammelsurium</w> an Geräten zu verwalten."
                            }
                        },
                        {
                            "text": "В компании образовался <w>зоопарк</w> операционных систем.",
                            "target_lang_translations": {
                                "en": "A <w>zoo</w> of operating systems has formed in the company.",
                                "de": "In der Firma hat sich ein <w>Flickenteppich</w> an Betriebssystemen gebildet."
                            }
                        }
                    ],
                    "synonyms": [
                        "фрагментация"
                    ],
                    "common_phrases": [
                        "зоопарк технологий",
                        "развести зоопарк"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "профессиональный жаргон"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A diverse, often incompatible mix of technologies or equipment that is difficult to manage.",
                        "de": "Eine vielfältige, oft inkompatible Mischung aus Technologien oder Geräten, die schwer zu verwalten ist."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "zoo",
                                "target_lang_sense_clarification": "heterogeneous collection"
                            },
                            {
                                "target_lang_word": "menagerie",
                                "target_lang_sense_clarification": "varied collection"
                            },
                            {
                                "target_lang_word": "hodgepodge",
                                "target_lang_sense_clarification": "disordered mix"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Sammelsurium",
                                "target_lang_sense_clarification": "bunte, ungeordnete Mischung"
                            },
                            {
                                "target_lang_word": "Flickenteppich",
                                "target_lang_sense_clarification": "figurativ für eine uneinheitliche Struktur"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e687ce15-d97f-3687-977c-33077f1e4391",
                    "sense_definition": "Компьютер или система, зараженная большим количеством вирусов и вредоносных программ.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "tech_slang",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Твой компьютер — это просто <w>зоопарк</w> вирусов, его нужно срочно чистить.",
                            "target_lang_translations": {
                                "en": "Your computer is just a <w>zoo</w> of viruses; it needs to be cleaned immediately.",
                                "de": "Dein Computer ist eine reine <w>Virenschleuder</w>, er muss dringend bereinigt werden."
                            }
                        },
                        {
                            "text": "Антивирус обнаружил на диске целый <w>зоопарк</w>.",
                            "target_lang_translations": {
                                "en": "The antivirus found a whole <w>zoo</w> on the disk.",
                                "de": "Das Antivirenprogramm hat auf der Festplatte eine ganze <w>Virensammlung</w> gefunden."
                            }
                        }
                    ],
                    "synonyms": [
                        "зверинец"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "компьютерный сленг"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A system or computer heavily infected with a wide variety of viruses or malware.",
                        "de": "Ein System oder Computer, der mit einer Vielzahl von Viren oder Schadprogrammen infiziert ist."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "zoo",
                                "target_lang_sense_clarification": "collection of malware"
                            },
                            {
                                "target_lang_word": "nest",
                                "target_lang_sense_clarification": "breeding ground"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Virenschleuder",
                                "target_lang_sense_clarification": "umgangssprachlich für ein stark infiziertes System"
                            },
                            {
                                "target_lang_word": "verseuchtes System",
                                "target_lang_sense_clarification": "technisch beschreibend"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}