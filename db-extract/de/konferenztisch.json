                "senses": [
                    {
                        "sense_id": "4cd9419e-7b01-3761-aa56-83d0ef9a45d8",
                        "entry_id": "d7272ea2-3734-338d-8e0d-9fc3746146a1",
                        "glosses": [
                            "Tisch, an dem die Teilnehmer einer Konferenz während der Sitzungen Platz nehmen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69ed2b8e-b4b1-41e0-bc07-6beb304494fa",
                                "sense_id": "4cd9419e-7b01-3761-aa56-83d0ef9a45d8",
                                "text": "„Punkt neun saßen sie alle um den ovalen Konferenztisch aus polierter Kiefer, jeder mit einem Schreiblock und der Konferenzakte vor sich.“"
                            },
                            {
                                "example_id": "fa4af7ad-f853-4cfc-8b9f-46b789a21fcc",
                                "sense_id": "4cd9419e-7b01-3761-aa56-83d0ef9a45d8",
                                "text": "„An diesem Konferenztisch an der Tür arbeitet sie.“"
                            },
                            {
                                "example_id": "1fbe65f0-d99c-47e1-b53c-e50e40dacdad",
                                "sense_id": "4cd9419e-7b01-3761-aa56-83d0ef9a45d8",
                                "text": "„Seiner meisterhaften Vorstellung am Konferenztisch tat dies indes keinen Abbruch.“"
                            },
                            {
                                "example_id": "b052682a-62c5-4036-9a8b-cdf588161939",
                                "sense_id": "4cd9419e-7b01-3761-aa56-83d0ef9a45d8",
                                "text": "„Um den Konferenztisch saßen neben dem britischen Regierungschef die Premierminister der selbstverwalteten «weißen» Dominions Kanada, Australien, Neuseeland und Südafrika, während Südrhodesien die volle Gleichberechtigung verwehrt blieb.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
