                        {
                            "text": "Wij verwachten de levering <w>rondom</w> het middaguur.",
                            "target_lang_translations": {
                                "en": "We expect the delivery <w>around</w> noon.",
                                "ru": "Мы ожидаем доставку <w>около</w> полудня.",
                                "pl": "Spodziewamy się dostawy <w>około</w> południa.",
                                "de": "Wir erwarten die Lieferung <w>gegen</w> Mittag.",
                                "fr": "Nous attendons la livraison <w>vers</w> midi.",
                                "it": "Ci aspettiamo la consegna <w>verso</w> mezzogiorno.",
                                "cs": "Dodávku očekáváme <w>kolem</w> poledne.",
                                "tr": "Teslimatı öğle saatleri <w>civarında</w> bekliyoruz.",
                                "es": "Esperamos la entrega <w>alrededor del</w> mediodía.",
                                "zh": "我们预计中午<w>左右</w>送货。"
