                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "housing_structure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij heeft net een mooie <w>flat</w> in het centrum gekocht.",
                            "target_lang_translations": {
                                "en": "She has just bought a beautiful <w>apartment</w> in the city center.",
                                "ru": "Она только что купила хорошую <w>квартиру</w> в центре.",
                                "pl": "Ona właśnie kupiła ładne <w>mieszkanie</w> w centrum.",
                                "de": "Sie hat gerade eine schöne <w>Wohnung</w> im Zentrum gekauft.",
                                "fr": "Elle vient d'acheter un bel <w>appartement</w> dans le centre-ville.",
                                "it": "Ha appena comprato un bell'<w>appartamento</w> in centro.",
                                "cs": "Právě si koupila pěkný <w>byt</w> v centru.",
                                "tr": "Merkezde yeni güzel bir <w>daire</w> satın aldı.",
                                "es": "Ella acaba de comprar un hermoso <w>apartamento</w> en el centro."
                            }
                        },
                        {
                            "text": "Zijn <w>flat</w> is klein, maar wel heel gezellig ingericht.",
                            "target_lang_translations": {
                                "en": "His <w>flat</w> is small, but very cosily furnished.",
                                "ru": "Его <w>квартира</w> маленькая, но очень уютно обставлена.",
                                "pl": "Jego <w>mieszkanie</w> jest małe, ale bardzo przytulnie urządzone.",
                                "de": "Seine <w>Wohnung</w> ist klein, aber sehr gemütlich eingerichtet.",
                                "fr": "Son <w>appartement</w> est petit, mais très chaleureusement meublé.",
                                "it": "Il suo <w>appartamento</w> è piccolo, ma arredato in modo molto accogliente.",
                                "cs": "Jeho <w>byt</w> je malý, ale velmi útulně zařízený.",
                                "tr": "Onun <w>dairesi</w> küçük ama çok şirin döşenmiş.",
                                "es": "Su <w>piso</w> es pequeño, pero está amueblado de manera muy acogedora."
                            }
                        }
