                "senses": [
                    {
                        "sense_id": "2abed446-7906-3314-b664-698e94fd1f54",
                        "entry_id": "cfcfa213-0584-3380-81fa-82c533ba94e0",
                        "glosses": [
                            "Hot-dog composé d’une saucisse cuite à la vapeur placée dans un pain à hot-dog, souvent garni d’oignons et de la moutarde."
                        ],
                        "tags": [
                            "Québec"
                        ],
                        "examples": [
                            {
                                "example_id": "20913ecf-2a23-4bf5-9201-628a7b300eff",
                                "sense_id": "2abed446-7906-3314-b664-698e94fd1f54",
                                "text": "— Cet été-là, mon père nous avait toutefois payé trois jours de Pitoune, de barbe à papa, de hot dogs steamés et de voyages intersidéraux à l'Expo 67, au terme desquels, l'esprit chargé d'Afrique et de spoutniks, nous avions pris la route pour Bondrée, […]."
                            },
                            {
                                "example_id": "2ea86d2c-52f4-4c90-bc21-e9f1f6b397fd",
                                "sense_id": "2abed446-7906-3314-b664-698e94fd1f54",
                                "text": "— Ah ! j'pense que j'vais plutôt prendre une poutine et un steamé oignons seulement."
                            },
                            {
                                "example_id": "982132a0-32d1-46e7-b75f-03c64923f435",
                                "sense_id": "2abed446-7906-3314-b664-698e94fd1f54",
                                "text": "— Ça va être quoi, pour toi, Cam ? lui demande Justin, depuis la caisse. Un steamé ?\nDe là où je suis, j'entends le bruit que font les frites lorsqu'elles sont plongées dans l'huile. Que ça me semble appétissant !"
                            }
                        ]
                    }
                ],
