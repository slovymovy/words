                                "example_id": "727bbcfc-99e7-4be1-b35b-af4138e46b5b",
                                "sense_id": "24345b48-b502-36df-957d-456bcc04a317",
                                "text": "„Er besuchte die öffentliche Schule bis zum siebten Unterrichtsjahr und kann daher in Oriya lesen und schreiben.“"
                            },
                            {
                                "example_id": "66b81f89-73f3-417f-a85b-b4d906bcf88a",
                                "sense_id": "24345b48-b502-36df-957d-456bcc04a317",
                                "text": "„Mit den Bihor sprach ich in Bihori und Oriya, der Landessprache Orissas.“"
                            }
                        ],
