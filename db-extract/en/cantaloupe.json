                                        "glosses": [
                                            "ботан. растение семейства Тыквенные, разновидность дыни с плодами круглой или приплюснутой формы с бородавчатой поверхностью (Cucumis melo var. cantalupensis)"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "241f78e5-11b9-3a7b-b9c0-f68204f9478d",
                                        "entry_id": "953f2968-b2b4-33c7-a80f-bc44aa700075",
                                        "glosses": [
                                            "плод такой дыни"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a35b6668-980d-419e-97b5-76eb52f19d8e",
                                                "sense_id": "241f78e5-11b9-3a7b-b9c0-f68204f9478d",
                                                "text": "Сейчас болгарин принёс две дыни. Ананасные. На манер вроде как канталупы, но только за́пах куда ароматнее."
                                            }
                                        ]
