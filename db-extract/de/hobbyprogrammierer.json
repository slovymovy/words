                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d5b813a-3186-48d5-b567-9ec632816b6f",
                                "sense_id": "d206c5dc-1bf2-3fd1-a60a-bf62ec823711",
                                "text": "„Kryptowährungen faszinieren nicht mehr nur Hobbyprogrammierer und experimentierfreudige Privatanleger.“"
                            },
                            {
                                "example_id": "c9203fc5-68bb-4118-b5a3-e79cf24ac510",
                                "sense_id": "d206c5dc-1bf2-3fd1-a60a-bf62ec823711",
                                "text": "„Nicht mehr Hobbyprogrammierer arbeiten an der Software, sondern fest angestellte Entwickler überwiegend großer Firmen wie Microsoft, Google oder IBM.“"
                            },
                            {
                                "example_id": "3d56fccb-7d6c-46e8-bf18-1af011caed12",
                                "sense_id": "d206c5dc-1bf2-3fd1-a60a-bf62ec823711",
                                "text": "„Nach zahlreichen inoffiziellen Treibern und Werkzeugen hat Microsoft jetzt selbst seine offizielle Software dazu zum Download für Forscher und Hobbyprogrammierer freigegeben.“"
                            }
                        ],
