                            "casual"
                        ],
                        "examples": [
                            {
                                "example_id": "d9cea4a9-aa48-4f9d-af27-063de67ede34",
                                "sense_id": "799a44db-264f-3c25-8b7a-6f13cab2ca77",
                                "text": "„Alle Medien sind nur so frei, wie es ihre Brötchengeber zulassen.“"
                            },
                            {
                                "example_id": "55c1ccea-e0a5-4df2-957d-76da8768b301",
                                "sense_id": "799a44db-264f-3c25-8b7a-6f13cab2ca77",
                                "text": "„Der angehende Religionslehrer Thomas Niederbühl hat am eigenen Leib erfahren, was es heißt, als kirchlicher Mitarbeiter gegen Glaubenssätze und Moralvorstellungen des Brötchengebers zu verstoßen.“"
                            }
                        ],
