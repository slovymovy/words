                        "glosses": [
                            "Relatif aux Comanches, une ethnie amérindienne vivant principalement en Oklahoma et accessoirement au Texas, en Californie et au Nouveau-Mexique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f597860-e1e7-4562-8454-1e9eb7fe9266",
                                "sense_id": "8b88dd80-9cfa-3b60-be41-153b5d34d560",
                                "text": "La nation comanche."
                            },
                            {
                                "example_id": "e0772ef8-49f1-4ae4-ac97-3ca8204bd515",
                                "sense_id": "8b88dd80-9cfa-3b60-be41-153b5d34d560",
                                "text": "Il gagna la protection d’un chef de tribu comanche, en lui promettant en mariage sa fille, qui n’était encore qu’une charmante enfant."
                            }
                        ]
