                "senses": [
                    {
                        "sense_id": "a5f6c02a-ee34-3d15-8190-5dbeeab19c02",
                        "entry_id": "c97f1f76-7315-30d8-b755-f7c1da51b46c",
                        "glosses": [
                            "nog in de natuurlijke staat en dus nog niet door mensen bewerkt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59c3bf66-e607-454c-b552-0c1b582da974",
                                "sense_id": "a5f6c02a-ee34-3d15-8190-5dbeeab19c02",
                                "text": "De onbewerkte diamant glinstert nog niet heel erg mooi."
                            },
                            {
                                "example_id": "2a3ee84a-2042-4aa9-8f32-ec78e215cb27",
                                "sense_id": "a5f6c02a-ee34-3d15-8190-5dbeeab19c02",
                                "text": "De onbewerkte grond is nog niet geschikt om te bebouwen."
                            }
                        ]
                    },
                    {
                        "sense_id": "349ca4a1-7a30-3032-9195-af46b3d4e755",
                        "entry_id": "c97f1f76-7315-30d8-b755-f7c1da51b46c",
                        "glosses": [
                            "niet geschuurd of geschaafd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7beaaaf-9c6a-4ebd-baf4-782416da25c2",
                                "sense_id": "349ca4a1-7a30-3032-9195-af46b3d4e755",
                                "text": "De onbewerkte vloerplanken in zijn zolderkamer met uitzicht op de rivier waren zorgvuldig geboend met groene zeep."
                            }
                        ]
                    }
                ],
