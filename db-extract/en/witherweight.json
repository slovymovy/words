                        ],
                        "examples": [
                            {
                                "example_id": "4f849781-e84e-4da7-b2b7-93d6e19f9f4f",
                                "sense_id": "2a9606cf-49a9-3c15-ac0f-f2b15c331288",
                                "text": "It is good to have a speciall care that gifts come not in the ballance with grace; for that is too gross a wither-weight. Lay by the painted case when you weigh the jewell; […]"
                            },
                            {
                                "example_id": "da9b274d-bc0a-49b1-afa0-2ab7168e1788",
                                "sense_id": "2a9606cf-49a9-3c15-ac0f-f2b15c331288",
                                "text": "He puts it ay so upon their hand that he gives them it with a wother weight; […]"
                            },
                            {
                                "example_id": "4cda1fa2-f091-482b-8918-c4d8590bea6f",
                                "sense_id": "2a9606cf-49a9-3c15-ac0f-f2b15c331288",
                                "text": "So, upon the whole, you judge that the balance preponderates on our side just now ?\" \" I should think sae, Sire, when sic a clod as this castle of Roxburgh is thrown into the bucket. It is nae witherweight this for the end of a weigh-bauk."
                            }
                        ]
                    }
