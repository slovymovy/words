                            "Vitrerie"
                        ],
                        "examples": [
                            {
                                "example_id": "7618721d-ee14-4fb3-9d42-17bb72c563ec",
                                "sense_id": "50d442d7-f795-37e9-8737-01fbf5607a3b",
                                "text": "Les outils ne manquaient pas, haches, besaiguës, égoïnes, herminettes, rabots, scies à bras, masses, marteaux, ciseaux, etc."
                            }
                        ]
