                            {
                                "example_id": "882f6fbf-2520-4649-904c-d26d784ea9b5",
                                "sense_id": "580aee9e-3886-38c3-88c1-5f28d5a72454",
                                "text": "„Ich möchte auf die umgekippte Pütz hinweisen: vier solcher Pützen mit flüssiger Seife brauchen wir für Rein-Schiff.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
