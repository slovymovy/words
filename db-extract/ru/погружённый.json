                "senses": [
                    {
                        "sense_id": "08fc3601-6edd-33f5-93e2-c194347dc082",
                        "entry_id": "402cdbc6-825a-35b3-a623-7cfb70cae0dc",
                        "glosses": [
                            "страд. прич. прош. вр. от погрузить"
                        ],
                        "tags": [
                            "participle"
                        ],
                        "examples": [
                            {
                                "example_id": "aa808bc3-39ba-4ff9-a0b2-05652648eaee",
                                "sense_id": "08fc3601-6edd-33f5-93e2-c194347dc082",
                                "text": "Ранний синрифтовый метаморфизм привёл к низкотемпературному изменению погружённого архейского фундамента и протерозойских андезито-базальтов."
                            },
                            {
                                "example_id": "ec24b19b-e28c-48c6-9de9-3942af8fd5fa",
                                "sense_id": "08fc3601-6edd-33f5-93e2-c194347dc082",
                                "text": "На переднем плане, в окружении разбросанных в беспорядке столярных и строительных инструментов, сидит, подперев рукой голову, погружённая в глубокую задумчивость крылатая женщина."
                            }
                        ]
                    }
                ],
