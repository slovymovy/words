                ],
                "senses": [
                    {
                        "sense_id": "50559b2a-0d20-30f7-8a73-146e743a54b6",
                        "entry_id": "b0f4c9d1-d4bf-3b13-9c69-73918bc21b16",
                        "glosses": [
                            "Kampfhandlung im Krieg, welche vor allem durch die Anzahl der eingesetzten Waffen sowie deren Heranführbarkeit und Herstellungszahl geprägt ist und weniger vom Kriegsgeschick"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43695d80-d468-4d08-aaa8-f2fe4f42860e",
                                "sense_id": "50559b2a-0d20-30f7-8a73-146e743a54b6",
                                "text": "„In diesen Jahren vor dem Kriege lebte in der Romantik des Wandervogels die Begeisterung für eine neue, freie Zukunft, die dann in den Schützengräben noch eine Zeit lang loderte und 1917 im Grauen der Materialschlachten zusammenbrach.“"
                            },
                            {
                                "example_id": "3a4a8a88-0a1b-4608-bc95-720752980791",
                                "sense_id": "50559b2a-0d20-30f7-8a73-146e743a54b6",
                                "text": "„Die Rote Armee war dank der inzwischen in großem Stil angelaufenen Hilfslieferungen der Vereinigten Staaten bestens für eine Materialschlacht gerüstet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c0a507b9-5b60-350a-b695-1beb9d2f5fca",
                        "entry_id": "b0f4c9d1-d4bf-3b13-9c69-73918bc21b16",
                        "glosses": [
                            "verschwenderischer Einsatz von dinglichen Mitteln"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "3113ad07-ad50-4367-abd6-613f8bf41995",
                                "sense_id": "c0a507b9-5b60-350a-b695-1beb9d2f5fca",
                                "text": "Dieses Stück haben die anderen immer gefürchtet, weil es eben die reinste Materialschlacht ist."
                            },
                            {
                                "example_id": "adc910c0-a840-48cf-a687-c4983e8b2f26",
                                "sense_id": "c0a507b9-5b60-350a-b695-1beb9d2f5fca",
                                "text": "„Der mehr oder weniger subtile Druck, der häufig auf sie ausgeübt wird, das Klassenzimmer »perfekt« auszugestalten und eine »Materialschlacht« auf eigene Kosten zu veranstalten, ist unzulässig.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
