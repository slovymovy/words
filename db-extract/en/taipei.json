                        "examples": [
                            {
                                "example_id": "649b7c90-d1c8-4b7f-92a8-3afb1d1176c6",
                                "sense_id": "e987ff35-fdab-3269-82b9-ba9afe72230f",
                                "text": "Under new regulations the purchasers of camphor are not allowed to approach the stills for fear of injury from the savages ; but four markets have been selected, viz.: Taipei, Tokoham, and Sokko-k'eng, and in Chung-lu, or middle district, Chipchipkoi and Tohchay, whither all produce is to be taken for sale."
                            },
                            {
                                "example_id": "66a1c3b3-5b61-4e0d-8b87-8fd5d0f5e03a",
                                "sense_id": "e987ff35-fdab-3269-82b9-ba9afe72230f",
                                "text": "Years later, when I was governor, I found myself in the same hotel with Nureyev in Taipei, Taiwan."
                            },
                            {
                                "example_id": "b052b0af-db4c-4a36-a6f3-9b383abf1e8e",
                                "sense_id": "e987ff35-fdab-3269-82b9-ba9afe72230f",
                                "text": "We lived in the county of Taoyuan, in northern Taiwan, around twenty-five miles south of the capital of Taipei."
                            },
                            {
                                "example_id": "abc54d93-4082-4cc7-b009-0b9a03d2ac43",
                                "sense_id": "e987ff35-fdab-3269-82b9-ba9afe72230f",
                                "text": "ONE IS A small, surprisingly successful and relatively democratic country bullied by a larger, dictatorial neighbour which considers it to be part of its own territory. The other is Taiwan. On September 9th Somaliland, a breakaway republic in the north of Somalia, opened a \"representative office\" in Taipei, the capital of Taiwan. It followed the opening in August of a similar Taiwanese office in Hargeisa, Somaliland's capital."
                            }
                        ]
