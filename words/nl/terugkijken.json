                    "semantic_group_id": "physical_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Toen hij <w>terugkeek</w> naar de oever, zag hij een groep vogels.",
                            "target_lang_translations": {
                                "en": "When he <w>looked back</w> at the bank, he saw a flock of birds.",
                                "ru": "Когда он <w>оглянулся</w> на берег, то увидел стаю птиц.",
                                "pl": "Kiedy <w>spojrzał za siebie</w> na brzeg, zobaczył stado ptaków.",
                                "de": "Als er zum Ufer <w>zurückblickte</w>, sah er eine Gruppe von Vögeln.",
                                "fr": "Quand il a <w>regardé en arrière</w> vers la rive, il a vu un groupe d'oiseaux.",
                                "it": "Quando si è <w>voltato</w> verso la riva, ha visto uno stormo di uccelli.",
                                "cs": "Když se <w>ohlédl</w> na břeh, uviděl hejno ptáků.",
                                "tr": "Kıyıya doğru <w>geriye baktığında</w> bir kuş sürüsü gördü.",
                                "es": "Cuando <w>miró hacia atrás</w> a la orilla, vio un grupo de pájaros.",
                                "zh": "当他<w>回头</w>望向岸边时，他看见了一群鸟。"
                            }
                        },
                        {
                            "text": "Je moet goed <w>terugkijken</w> voordat je met de fiets afslaat.",
                            "target_lang_translations": {
                                "en": "You must <w>look back</w> carefully before turning on your bike.",
                                "ru": "Нужно внимательно <w>посмотреть назад</w>, прежде чем поворачивать на велосипеде.",
                                "pl": "Musisz dobrze <w>obejrzeć się za siebie</w>, zanim skręcisz na rowerze.",
                                "de": "Du musst dich gut <w>umsehen</w>, bevor du mit dem Fahrrad abbiegst.",
                                "fr": "Tu dois bien <w>regarder derrière toi</w> avant de tourner à vélo.",
                                "it": "Devi <w>guardare bene dietro di te</w> prima di svoltare in bicicletta.",
                                "cs": "Než odbočíš na kole, musíš se pořádně <w>podívat dozadu</w>.",
                                "tr": "Bisikletle dönmeden önce iyice <w>arkana bakmalısın</w>.",
                                "es": "Debes <w>mirar bien hacia atrás</w> antes de girar con la bicicleta.",
                                "zh": "骑自行车转弯前，你必须仔细<w>向后看</w>。"
                            }
