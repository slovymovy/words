                "senses": [
                    {
                        "sense_id": "424642d8-4090-3aa1-a6ae-ba8fd5429043",
                        "entry_id": "cdbd77dc-2321-3a16-a789-fb10a7fb052c",
                        "glosses": [
                            "in Süd- und Zentralasien verbreitete, aus gesäuertem Teig hergestellte Brotsorte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b8c793f-bef5-4a62-815e-0870af4085d7",
                                "sense_id": "424642d8-4090-3aa1-a6ae-ba8fd5429043",
                                "text": "„Sie reichen ein Naan von der Größe einer Tischdecke herum und diskutieren begeistert die Vor- und Nachteile der einzelnen Gefängnisse im Land.“"
                            },
                            {
                                "example_id": "9285ff35-a071-41a3-bd0f-5fd44664be3f",
                                "sense_id": "424642d8-4090-3aa1-a6ae-ba8fd5429043",
                                "text": "„Carl steuerte eine Sky Shark über der Altstadtinsel Gamla Stan, konnte aber nebenher mit einer Hand immer wieder ein Stück Naan in Soße dippen und mit einem Schluck Bier runterspülen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
