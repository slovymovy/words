                ],
                "senses": [
                    {
                        "sense_id": "fd918919-0819-334a-b2f1-c6a037c7391e",
                        "entry_id": "ca909283-4e14-3f77-86bc-52cc3fb4032c",
                        "glosses": [
                            "To rule; to govern"
                        ],
                        "tags": [
                            "obsolete",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "ec0f75e5-97d8-481f-aa36-7d8dcaa74174",
                                "sense_id": "fd918919-0819-334a-b2f1-c6a037c7391e",
                                "text": "As Britain-founding Brute first Monarchiz’d the Land:"
                            },
                            {
                                "example_id": "09cc2da6-4266-4507-b8fe-57fdc3d67d93",
                                "sense_id": "fd918919-0819-334a-b2f1-c6a037c7391e",
                                "text": "We must confesse, she can all Soules subdue,"
                            }
                        ]
                    },
                    {
                        "sense_id": "35a54a1d-8a30-39ee-91d8-5058d1793e35",
                        "entry_id": "ca909283-4e14-3f77-86bc-52cc3fb4032c",
                        "glosses": [
                            "To convert to a monarchy."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "90502f3f-8216-47c5-a10e-865e3095df9d",
                                "sense_id": "35a54a1d-8a30-39ee-91d8-5058d1793e35",
                                "text": "[…] so far we shall be from mending our condition by monarchizing our government, whatever new conceit now possesses us."
                            },
                            {
                                "example_id": "5d6a9579-ce15-450e-9e46-5f5120f5e1d7",
                                "sense_id": "35a54a1d-8a30-39ee-91d8-5058d1793e35",
                                "text": "1800, Thomas Jefferson, letter to Gideon Granger dated 13 August, 1800, in Richard S. Poppen (ed.), Thomas Jefferson: The Declaration of Independence and Letters, Addresses, Excerpts and Aphorisms, St. Louis, Missouri, 1898, p. 72,\n[Our government] can never be harmonious and solid, while so respectable a portion of its citizens support principles which go directly to a change of the Federal Constitution to sink the State governments, consolidate them into one, and to monarchize that."
                            },
                            {
                                "example_id": "55adbb0d-5b0e-460e-bd3d-a68abdfe6404",
                                "sense_id": "35a54a1d-8a30-39ee-91d8-5058d1793e35",
                                "text": "[…] there has existed in this country from the close of the revolutionary war a powerful party fortified by intelligence, respectability and welath and sleepless in efforts to monarchize the republic."
                            }
                        ]
                    },
                    {
                        "sense_id": "ac616661-4af9-3b12-8989-c4f241b9f6f4",
                        "entry_id": "ca909283-4e14-3f77-86bc-52cc3fb4032c",
                        "glosses": [
                            "To act or play the part of a monarch."
                        ],
                        "tags": [
                            "intransitive",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "9e8a0f2e-74d3-45c4-b8cc-a5d769d7973d",
                                "sense_id": "ac616661-4af9-3b12-8989-c4f241b9f6f4",
                                "text": "[…] within the hollow crown\nThat rounds the mortal temples of a king\nKeeps Death his court and there the antic sits,\nScoffing his state and grinning at his pomp,\nAllowing him a breath, a little scene,\nTo monarchize, be fear’d and kill with looks […]"
                            },
                            {
                                "example_id": "21bc6f81-83a6-4255-a33e-95663ca34e26",
                                "sense_id": "ac616661-4af9-3b12-8989-c4f241b9f6f4",
                                "text": "1600, Thomas Dekker, Old Fortunatus, London: William Aspley, [Act I, Scene 3],\nUice hath golden cheekes, O pittie, pittie,\nShe in euery land doth monarchize.\nUertue is exilde from euery Cittie,\nUertue is a foole, Uice onely wise."
                            },
                            {
                                "example_id": "af7110ee-5d62-4f37-8406-981072cacb00",
                                "sense_id": "ac616661-4af9-3b12-8989-c4f241b9f6f4",
                                "text": "[…] the delegated power,\nArray’d in which those worms did monarchize,\nWho make this earth their charnel."
                            }
                        ]
                    }
                ],
