                    "frequency": "Middle",
                    "semantic_group_id": "recht",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der Anwalt kündigte an, gegen das Urteil sofort <w>Berufung</w> einzulegen."
                        },
                        {
                            "text": "Das Gericht wies die <w>Berufung</w> der Klägerin aus formalen Gründen zurück."
                        }
                    ],
                    "synonyms": [
                        "Einspruch",
                        "Rekurs",
                        "Beschwerde"
                    ],
                    "antonyms": [],
