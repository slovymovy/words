                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "6ce2ff68-4507-32b2-8724-b76a4364fe41",
                        "entry_id": "4eca2341-9497-3c94-b3b9-35d38e135279",
                        "glosses": [
                            "Pertaining to chromatic lithography (the production of lithographs that support color through the application of oil colors on stone)."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "9ace7c4c-7f48-4555-81e0-e2f49fbc083a",
                                "sense_id": "6ce2ff68-4507-32b2-8724-b76a4364fe41",
                                "text": "M. Hercule Nicolet, an able artist especially versed in the recently invented art of chromatic lithography, headed the new establishment. Guyot says that here were produced “almost the first essays” of the lithochromatic art, and remarks on their beauty as well as their perfection of color and outline."
                            },
                            {
                                "example_id": "977ec293-092d-43af-8c3b-3138e8b70b0c",
                                "sense_id": "6ce2ff68-4507-32b2-8724-b76a4364fe41",
                                "text": "We are glad to hear that the Somersetshire Architectural Society contemplate publishing, in lithochromatic drawing, a sheet of the very remarkable coloured sculptures discovered in Wellington church, and described by us in a previous volume."
                            },
                            {
                                "example_id": "e73bb473-ba25-4a12-b16d-ae8257ce95ee",
                                "sense_id": "6ce2ff68-4507-32b2-8724-b76a4364fe41",
                                "text": "The Ecclesiastical Architecture of Italy, from the time of Constantino to the Fifteenth Century, represented in eighty-one Lithochromatic Plates."
                            }
                        ]
                    },
                    {
                        "sense_id": "57941bc4-9e3d-31ee-9dd2-016d9c06b39d",
                        "entry_id": "4eca2341-9497-3c94-b3b9-35d38e135279",
                        "glosses": [
                            "Displaying color that results from the inclusion of particles of pulverised stone."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "b1e5fa50-2096-4f57-82eb-70afce4b648e",
                                "sense_id": "57941bc4-9e3d-31ee-9dd2-016d9c06b39d",
                                "text": "Low chroma colors due to reduced conditions are often indistinguishable from lithochromatic colors imparted by till parent materials."
                            },
                            {
                                "example_id": "fb09bbe3-a611-48fa-b5b8-5ab2d1368fd9",
                                "sense_id": "57941bc4-9e3d-31ee-9dd2-016d9c06b39d",
                                "text": "Values of 5 dry and 3 moist with low chroma are lithochromatic."
                            },
                            {
                                "example_id": "46f95d28-f868-4363-983c-2ccf7a444b25",
                                "sense_id": "57941bc4-9e3d-31ee-9dd2-016d9c06b39d",
                                "text": "...few fine and medium prominent light gray (10YR 7/2) lithochromatic streaks and pockets; moderate medium subangular blocky structure."
                            }
                        ]
                    }
