                ],
                "translations": [
                    {
                        "translation_id": "7137eafe-0813-4100-8abc-6abf7c32a7ae",
                        "source_entry_id": "7ba5758a-1857-3255-8010-6d0caa7f1a80",
                        "source_sense_id": "e27380c0-cbf9-377b-955f-f814e282823c",
                        "target_lang_word": "permit",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "permit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "18887e21-d6b6-3168-ae59-23790015edee",
                                        "entry_id": "853b1d22-e722-31ea-8f0d-615269191a8a",
                                        "glosses": [
                                            "A pompano of the species Trachinotus falcatus."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "permit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "51ed5a99-be1a-3788-9a70-dd6831a3fb4a",
                                        "entry_id": "264ae3c0-28bf-38b6-8348-1b950d3f7201",
                                        "glosses": [
                                            "To allow (something) to happen, to give permission for."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "579ebad6-0870-4faa-84d9-7d393c79edcd",
                                                "sense_id": "51ed5a99-be1a-3788-9a70-dd6831a3fb4a",
                                                "text": "Mr. Cooke at once began a tirade against the residents of Asquith for permitting a sandy and generally disgraceful condition of the roads. So roundly did he vituperate the inn management in particular, and with such a loud flow of words, that I trembled lest he should be heard on the veranda."
                                            },
                                            {
                                                "example_id": "46ce9dce-6e36-4480-9a81-9e24e5bb050d",
                                                "sense_id": "51ed5a99-be1a-3788-9a70-dd6831a3fb4a",
                                                "text": "Last week the decision on two points was conclusive: the Presbyterian Church in the U. S. A. will not permit ordination of women as ministers, but will permit their election as ruling elders, permission which makes possible a woman as moderator."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ae9ff49-b905-3c1a-9904-743c3be1830e",
                                        "entry_id": "264ae3c0-28bf-38b6-8348-1b950d3f7201",
                                        "glosses": [
                                            "To allow (someone) to do something; to give permission to."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3974c881-c068-47f3-9e03-5e78d61544c8",
                                                "sense_id": "0ae9ff49-b905-3c1a-9904-743c3be1830e",
                                                "text": "He was ultimately cleared, but during that period, Mr. Ackman said, his lawyers would not permit him to defend himself publicly."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dbe11309-aa76-3d91-b553-e2c7cd3b2228",
                                        "entry_id": "264ae3c0-28bf-38b6-8348-1b950d3f7201",
                                        "glosses": [
                                            "To allow for, to make something possible."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7a8de9f-0061-40c6-bc5c-96059f925994",
                                                "sense_id": "dbe11309-aa76-3d91-b553-e2c7cd3b2228",
                                                "text": "What was left to say? Quite a lot, if only parliamentary time permitted."
                                            },
                                            {
                                                "example_id": "80060bc9-b9d4-4c39-984b-a95c66d6a987",
                                                "sense_id": "dbe11309-aa76-3d91-b553-e2c7cd3b2228",
                                                "text": "For snackage there's a 1950s-themed diner plus a barbie on the terrace, weather permitting."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e5d70820-68a3-3e91-92a2-ab9f68d89b10",
                                        "entry_id": "264ae3c0-28bf-38b6-8348-1b950d3f7201",
                                        "glosses": [
                                            "To allow, to admit (of)."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8816b4bf-561e-4b1d-b62e-c11bfadebd9d",
                                                "sense_id": "e5d70820-68a3-3e91-92a2-ab9f68d89b10",
                                                "text": "\"You English are always so frivolous,\" said the Princess. \"In Russia we have too many troubles to permit of our being light-hearted.\""
                                            },
                                            {
                                                "example_id": "21e4a033-43af-4ee2-9409-4202c53ce5af",
                                                "sense_id": "e5d70820-68a3-3e91-92a2-ab9f68d89b10",
                                                "text": "\"As an instrument of economic policy, incantation does not permit of minor doubts or scruples.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e1e01ab-cf85-3ca2-8ee0-552d8b663208",
                                        "entry_id": "264ae3c0-28bf-38b6-8348-1b950d3f7201",
                                        "glosses": [
                                            "To grant formal authorization for (something)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ca8df136-1a27-4dd3-93e5-084b0e604f1c",
                                                "sense_id": "2e1e01ab-cf85-3ca2-8ee0-552d8b663208",
                                                "text": "The Building Department permitted that project last week."
                                            },
                                            {
                                                "example_id": "93956845-692f-43b1-9214-1e7beb9b4335",
                                                "sense_id": "2e1e01ab-cf85-3ca2-8ee0-552d8b663208",
                                                "text": "[…] they have not expanded so far federal permitting authority to site and permit transmission lines that are important for interstate commerce."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9cb464af-ae64-36ff-90a3-c471f9d16dab",
                                        "entry_id": "264ae3c0-28bf-38b6-8348-1b950d3f7201",
                                        "glosses": [
                                            "To attempt to obtain or succeed in obtaining formal authorization for (something)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f55af001-0018-4c5a-b599-ca087b5d6d38",
                                                "sense_id": "9cb464af-ae64-36ff-90a3-c471f9d16dab",
                                                "text": "We've been busy permitting the State Street development."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aab6eb8f-aca9-3ca7-8286-028d3c7e8de1",
                                        "entry_id": "264ae3c0-28bf-38b6-8348-1b950d3f7201",
                                        "glosses": [
                                            "To hand over, resign (something to someone)."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d991cfc-86f3-4951-afe7-8562cfdfb391",
                                                "sense_id": "aab6eb8f-aca9-3ca7-8286-028d3c7e8de1",
                                                "text": "Let us not aggravate our sorrows, / But to the gods permit the event of things."
                                            }
                                        ]
                                    }
                                ]
                            },
