                ],
                "senses": [
                    {
                        "sense_id": "5e315296-ef70-3815-88ae-e37f35159e8c",
                        "entry_id": "d2da6200-2d0d-3865-829e-10190a5ee705",
                        "glosses": [
                            "ein kleines Gefecht am Rande eines Krieges, oder Handgemenge"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d38c0fe4-0fa8-48d4-828b-1ae5993d33f9",
                                "sense_id": "5e315296-ef70-3815-88ae-e37f35159e8c",
                                "text": "Jöns Månsson Teitt berichtet in seinen Erinnerungen an den Dreißigjährigen Krieg über ein Scharmützel, das am 17. Juni 1629 zwischen Marienwerder und Stuhm stattfand."
                            },
                            {
                                "example_id": "29c03381-88ca-4789-8116-d4ba4372b443",
                                "sense_id": "5e315296-ef70-3815-88ae-e37f35159e8c",
                                "text": "„Die Offensive wurde nur wenig durch kleine Scharmützel im Hinterhalt verzögert; gelegentlich stieß man auch auf eine Verteidigungsstellung an einem Hohlweg oder quer zu einem Pfad.“"
                            },
                            {
                                "example_id": "1775b02e-560c-4547-adb0-0f894112b61b",
                                "sense_id": "5e315296-ef70-3815-88ae-e37f35159e8c",
                                "text": "„Beim ersten Scharmützel siegten die Götzendiener über die ihnen entgegengeschickten königlichen Streitkräfte, und voller Zuversicht beschlossen sie den Marsch auf Kailua.“"
                            },
                            {
                                "example_id": "948f00f7-6d2b-4233-8c57-6b87de0e426c",
                                "sense_id": "5e315296-ef70-3815-88ae-e37f35159e8c",
                                "text": "„Provokationen und Scharmützel waren in den kommenden Jahren an der Tagesordnung.“"
                            },
                            {
                                "example_id": "0e658f7f-7eee-4a23-84b3-d16a2de34c72",
                                "sense_id": "5e315296-ef70-3815-88ae-e37f35159e8c",
                                "text": "„Am 19. April 1775 fanden die ersten Scharmützel einer amerikanischen Miliz mit britischen Truppen statt, die Gefechte von Lexington und Concord.“"
                            },
                            {
                                "example_id": "9f243ded-1ad6-40d2-bc5c-23a5908e3880",
                                "sense_id": "5e315296-ef70-3815-88ae-e37f35159e8c",
                                "text": "„Die erste dieser Schlachten war eher ein Scharmützel als eine große Schlacht, und sie wurde durch Verrat und nicht durch militärische Überlegenheit entschieden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b566ec93-a8be-3c1f-aeaf-cc09d6c529b4",
                        "entry_id": "d2da6200-2d0d-3865-829e-10190a5ee705",
                        "glosses": [
                            "Papiertüte"
                        ],
                        "tags": [
                            "oberdeutsch"
                        ],
                        "examples": [
                            {
                                "example_id": "1d93a9a8-af7d-4702-b114-cb7b2bd1cdcf",
                                "sense_id": "b566ec93-a8be-3c1f-aeaf-cc09d6c529b4",
                                "text": "Ein Scharmützel sagte sie und zeigte auf die braune dreieckige Papiertüte."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "39417b93-466d-446a-86a2-270d77f4e07f",
                        "source_entry_id": "d2da6200-2d0d-3865-829e-10190a5ee705",
                        "source_sense_id": "5e315296-ef70-3815-88ae-e37f35159e8c",
                        "source_sense_description": "ein kleines Gefecht am Rande eines Krieges, oder Handgemenge",
                        "target_lang_word": "skirmish",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "skirmish",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "02bed939-797c-3099-be25-84da1e704f45",
                                        "entry_id": "6577e845-864f-3265-858c-8b3b82af9889",
                                        "glosses": [
                                            "A brief battle between small groups, usually part of a longer or larger battle or war."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2643b16a-6172-40d5-b390-7923148f0eb0",
                                                "sense_id": "02bed939-797c-3099-be25-84da1e704f45",
                                                "text": "On 2 March, Chinese border guards with the help of regular PLA forces skillfully ambushed Strelnikov's unit on the ice near Chen Pao, killing him and 30 Soviets in the subsequent skirmish."
                                            },
                                            {
                                                "example_id": "ce21b10d-84e6-43ab-80b6-4ac587cca09f",
                                                "sense_id": "02bed939-797c-3099-be25-84da1e704f45",
                                                "text": "The walls are slitted with embrasures through which bowmen could fire, indicating that the belfry also served as a stronghold during border skirmishes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6279d4d-3c36-3f80-a0d1-058498fa95d3",
                                        "entry_id": "6577e845-864f-3265-858c-8b3b82af9889",
                                        "glosses": [
                                            "Any minor dispute."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "64c49f50-992b-4728-9bf4-ca601ffb1f9a",
                                                "sense_id": "b6279d4d-3c36-3f80-a0d1-058498fa95d3",
                                                "text": "Three people were arrested after a skirmish in a bar."
                                            },
                                            {
                                                "example_id": "2dc778bb-c64c-4afc-89bb-c0a95b8636a7",
                                                "sense_id": "b6279d4d-3c36-3f80-a0d1-058498fa95d3",
                                                "text": "Fires which have heretofore been one‐alarm skirmishes are now multialarm small wars."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5390ec15-2f52-3d7e-942c-5f24b7cb3097",
                                        "entry_id": "6577e845-864f-3265-858c-8b3b82af9889",
                                        "glosses": [
                                            "A type of outdoor military style game using paintball or similar weapons."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "skirmish",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7d3f4e9c-aa74-3bcf-8f9d-83b13e7066fc",
                                        "entry_id": "71014977-97c1-3f67-9422-5a4f011c521d",
                                        "glosses": [
                                            "To engage in a minor battle or dispute."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f082c05b-7707-4a2d-86e6-ab3863eefe5b",
                                                "sense_id": "7d3f4e9c-aa74-3bcf-8f9d-83b13e7066fc",
                                                "text": "The deer and the pig and the nilghai were milling round and round in a circle of eight or ten miles radius, while the Eaters of Flesh skirmished round its edge."
                                            },
                                            {
                                                "example_id": "64c7c6b9-c63e-43b8-b698-c69c01c05f23",
                                                "sense_id": "7d3f4e9c-aa74-3bcf-8f9d-83b13e7066fc",
                                                "text": "Other historians might also remark that […] they have persisted all this time, constantly wrestling and skirmishing and yet never destroying themselves."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "49186630-7bb2-4c0e-b0ef-7848f5c75d98",
                        "source_entry_id": "d2da6200-2d0d-3865-829e-10190a5ee705",
                        "source_sense_id": "5e315296-ef70-3815-88ae-e37f35159e8c",
                        "source_sense_description": "ein kleines Gefecht am Rande eines Krieges, oder Handgemenge",
                        "target_lang_word": "escarmouche",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "escarmouche",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "79fef100-b207-3fb8-a955-fda1c68db797",
                                        "entry_id": "54b4fad9-048e-3682-a6b8-10ba9dda6628",
                                        "glosses": [
                                            "Combat entre de petits détachements ou entre des tirailleurs, lorsque deux armées sont proches l’une de l’autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5824b50d-ef2d-4997-8035-6a9211c5e7ba",
                                                "sense_id": "79fef100-b207-3fb8-a955-fda1c68db797",
                                                "text": "Si on les questionnait, leur maître leur avait ordonné de dire que la litière appartenait à lady Rowena, et qu’elle était momentanément occupée par un de leurs camarades blessé dans l’escarmouche."
                                            },
                                            {
                                                "example_id": "fc48960c-bfd3-4cf1-9864-269e715142b8",
                                                "sense_id": "79fef100-b207-3fb8-a955-fda1c68db797",
                                                "text": "Après cette escarmouche, nous remontâmes la rivière jusqu’à quinze milles et nous détruisîmes les villages et les plantations sur les deux rives."
                                            },
                                            {
                                                "example_id": "54e71032-d2f0-4244-a1f4-f206aca56e9b",
                                                "sense_id": "79fef100-b207-3fb8-a955-fda1c68db797",
                                                "text": "A l'arrivée des Anglois, aucuns compagnons saillirent, et il y eut par diverses fois, de gaillardes escarmouches."
                                            },
                                            {
                                                "example_id": "7872e1ac-69d3-4b0e-8cfe-ed2d6c56d05d",
                                                "sense_id": "79fef100-b207-3fb8-a955-fda1c68db797",
                                                "text": "Enfin, malgré tout, cette première affaire, escarmouche plus que bataille, tourna bien, puisque les Turcs cédèrent sur tous les points à la furie française et que le roi coucha sur leur camp abandonné."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e415cbf-1b53-38c3-bd1b-448f55ccebce",
                                        "entry_id": "54b4fad9-048e-3682-a6b8-10ba9dda6628",
                                        "glosses": [
                                            "Contestation, dispute."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ad91ca6-3069-49af-b31e-dbe22e89ed54",
                                                "sense_id": "8e415cbf-1b53-38c3-bd1b-448f55ccebce",
                                                "text": "Il y avait dans cette petite guerre d’escarmouche qu’il lui livrait des points où il touchait malheureusement assez juste."
                                            },
                                            {
                                                "example_id": "87508547-8baa-4085-b220-672adf7a0e4f",
                                                "sense_id": "8e415cbf-1b53-38c3-bd1b-448f55ccebce",
                                                "text": "La première escarmouche se produit avec la discussion relative aux crédits nécessités par la création de deux ministères nouveaux : celui des Postes et Télégraphes et celui des Beaux-Arts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a78dccd-77d7-30f4-a48e-48a23217c9a9",
                                        "entry_id": "54b4fad9-048e-3682-a6b8-10ba9dda6628",
                                        "glosses": [
                                            "Dans les jeux de guerre, échelle à laquelle un pion représente un combattant et un tour de jeu de quelques dizaines de secondes."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
