                "senses": [
                    {
                        "sense_id": "fd0e9e42-2927-323e-877b-634793c2b00b",
                        "entry_id": "7a400f35-08f7-3b11-8acd-af27a59c50d1",
                        "glosses": [
                            "Retirer une personne d'une liste d’amis sur un réseau social."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68850e58-5f79-42fd-ae93-c130b1c52de4",
                                "sense_id": "fd0e9e42-2927-323e-877b-634793c2b00b",
                                "text": "Au moment de mettre en ligne, tous les amis de l'homme envoyaient un fax au Navet pour annoncer qu'ils comptaient le désamicaliser dans les cinq prochaines secondes."
                            },
                            {
                                "example_id": "cea651e3-dc18-4be0-a2cb-9f136a118300",
                                "sense_id": "fd0e9e42-2927-323e-877b-634793c2b00b",
                                "text": "En passant, de nos jours, une autre façon de le faire est de « désamicaliser » l'autre sur les réseaux sociaux."
                            },
                            {
                                "example_id": "352cf06d-8d5e-4da4-8821-2b65069be809",
                                "sense_id": "fd0e9e42-2927-323e-877b-634793c2b00b",
                                "text": "\"Désamicalisez-moi !\" en replay sur France Culture."
                            },
                            {
                                "example_id": "2521dda5-ad5a-458d-8b40-c0a054dd16e0",
                                "sense_id": "fd0e9e42-2927-323e-877b-634793c2b00b",
                                "text": "Accepter un ami, rechercher un ami, se « désamicaliser »."
                            }
                        ]
                    }
                ],
