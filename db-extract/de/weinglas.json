                    }
                ],
                "senses": [
                    {
                        "sense_id": "3260b695-6b28-3fce-a621-867d5599552b",
                        "entry_id": "1ebe1657-e56d-34ef-a951-f75a29bf3c7e",
                        "glosses": [
                            "Trinkgefäß für Wein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5aea94c-22a9-441d-aa39-8739e1e7ae88",
                                "sense_id": "3260b695-6b28-3fce-a621-867d5599552b",
                                "text": "Gib mir mal das Weinglas."
                            },
                            {
                                "example_id": "1efd8506-73d1-447a-aded-fd77800c5e2b",
                                "sense_id": "3260b695-6b28-3fce-a621-867d5599552b",
                                "text": "Wo sind denn die Weingläser?"
                            },
                            {
                                "example_id": "3dc0b654-ae52-4e46-b9f9-78398e86f71e",
                                "sense_id": "3260b695-6b28-3fce-a621-867d5599552b",
                                "text": "„Wir erhielten als Abschiedsgeschenk einige ihrer besten Weine und vier wunderschöne Weingläser mit eingraviertem Familienwappen, die in einer kleinen Holzkiste verpackt waren.“"
                            },
                            {
                                "example_id": "15dff0f2-a979-4a15-8555-662fd276a9bb",
                                "sense_id": "3260b695-6b28-3fce-a621-867d5599552b",
                                "text": "„Das Weinglas stört mich, ich rücke es fort.“"
                            },
                            {
                                "example_id": "b1986454-ba8c-4709-b680-010ca76b36d4",
                                "sense_id": "3260b695-6b28-3fce-a621-867d5599552b",
                                "text": "„Sie hob ihr Weinglas nach oben.“"
                            },
                            {
                                "example_id": "6d4a29c4-0d34-4bd8-8ade-6b2781d5e329",
                                "sense_id": "3260b695-6b28-3fce-a621-867d5599552b",
                                "text": "„Sie nahm sein Weinglas, goss es randvoll, trank es gierig hinunter.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
