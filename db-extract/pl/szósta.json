                "translations": [
                    {
                        "translation_id": "6f3516dc-442f-4e72-b017-a05c884708b7",
                        "source_entry_id": "6f17666a-8892-3876-beb0-89c156460caf",
                        "source_sense_id": "64f8f168-dbb7-3c4c-9f43-c6a9c68b3f5a",
