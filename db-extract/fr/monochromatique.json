            {
                "entry_id": "67fb8bf4-372f-37c0-8e5e-1b3675839b1b",
                "word": "monochromatique",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "933750de-f4f1-4176-b019-aef0b7f7f68b",
                        "entry_id": "67fb8bf4-372f-37c0-8e5e-1b3675839b1b",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "monochromatiques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2853fb6d-095b-334f-9f10-022976c9755b",
                        "entry_id": "67fb8bf4-372f-37c0-8e5e-1b3675839b1b",
                        "glosses": [
                            "D’une seule couleur."
                        ],
                        "tags": [
                            "Peinture"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "b23e6871-263f-38c4-9479-a74bd00ccb2c",
                        "entry_id": "67fb8bf4-372f-37c0-8e5e-1b3675839b1b",
                        "glosses": [
                            "Qui contient seulement des luminances et non pas de différence de chromaticité, comme le noir et blanc."
                        ],
                        "tags": [
                            "Peinture"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "122d17af-7003-33a9-aa57-20f7748ee7cd",
                        "entry_id": "67fb8bf4-372f-37c0-8e5e-1b3675839b1b",
                        "glosses": [
                            "Qui ne contient qu’une seule longueur d’onde."
                        ],
                        "tags": [
                            "physical"
                        ],
                        "examples": [
                            {
                                "example_id": "45c4fcd7-7614-4aaf-9968-1bf645678f2b",
                                "sense_id": "122d17af-7003-33a9-aa57-20f7748ee7cd",
                                "text": "Une source monochromatique émet un rayonnement électromagnétique à une longueur d’onde précise."
                            },
                            {
                                "example_id": "5c58a0b0-8e4e-4c20-837a-8f089bbc42b0",
                                "sense_id": "122d17af-7003-33a9-aa57-20f7748ee7cd",
                                "text": "Quand un rayon laser traverse un prisme, il s’infléchit sans donner une gamme de couleurs. Le laser ne donne donc qu’une lumière monochromatique."
                            },
                            {
                                "example_id": "e7e3d86a-3b53-4ef1-a556-853df20c3360",
                                "sense_id": "122d17af-7003-33a9-aa57-20f7748ee7cd",
                                "text": "Dans sa communication, Einstein reprend l’hypothèse de Planck et l’adapte à la lumière. Il suppose qu’une lumière monochromatique, c’est-à-dire ne contenant qu’une radiation de fréquence unique ν, est formée de myriades de corpuscules porteurs d’un même quantum d’énergie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1822d570-71d2-43e4-81bf-6adb61d7e981",
                        "source_entry_id": "67fb8bf4-372f-37c0-8e5e-1b3675839b1b",
                        "source_sense_id": "b23e6871-263f-38c4-9479-a74bd00ccb2c",
                        "source_sense_description": "(Peinture) (Photographie) Qui contient seulement des luminances et non pas de différence de chromaticité, comme le noir et blanc.",
                        "target_lang_word": "monochromatisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "monochromatisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ace98191-51dd-3f5c-84ef-63ed897d6651",
                                        "entry_id": "28cbc9e8-5ea9-3e6d-99fb-92e79919e43c",
                                        "glosses": [
                                            "nur eine Farbe habend; von nur einer Wellenlänge"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c00de2b4-8249-4d85-a975-15f99fd4e176",
                                                "sense_id": "ace98191-51dd-3f5c-84ef-63ed897d6651",
                                                "text": "„Laserlicht ist nahezu parallel, kohärent, monochromatisch und vollständig linear polarisiert.“"
                                            },
                                            {
                                                "example_id": "83b98ddd-dffd-4ac7-af6e-7184c5efc7a4",
                                                "sense_id": "ace98191-51dd-3f5c-84ef-63ed897d6651",
                                                "text": "„Die Papiere sind natürlich nicht monochromatisch, sondern geben einen bestimmten Bereich des Spektrums.“"
                                            },
                                            {
                                                "example_id": "be652451-8005-48cb-9b21-58fcd3a66c23",
                                                "sense_id": "ace98191-51dd-3f5c-84ef-63ed897d6651",
                                                "text": "„Wäre das Licht ideal monochromatisch, so wäre die Welle exakt sinusförmig und ihre Kohärenzlänge unendlich.“"
                                            },
                                            {
                                                "example_id": "a4212ad7-7877-405e-8106-024600445aa0",
                                                "sense_id": "ace98191-51dd-3f5c-84ef-63ed897d6651",
                                                "text": "„Jeder solchen Welle ist eine einzelne, konstante Frequenz zuzuordnen; die Welle heißt monochromatisch oder (besser) monoenergetisch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
