                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d13b3679-c77e-382d-9c1e-b00baeb2eec2",
                                        "entry_id": "baa2db32-c6e9-3989-abfa-95a40bdf631e",
                                        "glosses": [
                                            "jemanden anwerben, jemanden gegen Lohn eine Aufgabe erledigen lassen (heute vor allem im Zusammenhang mit kriminellen Machenschaften benutzt)"
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d12f2e42-fce1-45a1-b0bd-421889b680ce",
                                                "sense_id": "d13b3679-c77e-382d-9c1e-b00baeb2eec2",
                                                "text": "Der Condottiere dang neue Söldner und überfiel Mailand. Hätten die USA ein Motiv gehabt, Sgrena zu töten «hätten sie diese schmutzige Arbeit von gedungenen Irakern erledigen lassen», sagten Geheimdienstangehörige dem Blatt."
                                            },
                                            {
                                                "example_id": "771ac59e-36e5-40ef-b2af-e11b1547115f",
                                                "sense_id": "d13b3679-c77e-382d-9c1e-b00baeb2eec2",
                                                "text": "„Ein Weibsstück wie sie würde sich nicht scheuen, ihn bei der Polizei zu verpfeifen oder Schläger und Erpresser zu dingen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c1a4e972-e59e-404c-9012-1301d1fca5df",
                        "source_entry_id": "ce9590a8-cd5a-38b8-87f2-57e6f9069a62",
