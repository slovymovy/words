                ],
                "senses": [
                    {
                        "sense_id": "01be7d52-731e-3cbe-bd2d-3346d17b6004",
                        "entry_id": "54dba2f8-503b-3a9f-9790-2d2e1b72d84d",
                        "glosses": [
                            "Opportune; occurring at an appropriate or suitable time."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "824a3413-bd70-4618-9202-e69ff80f1df4",
                                "sense_id": "01be7d52-731e-3cbe-bd2d-3346d17b6004",
                                "text": "Nor is it seasonable to have to do with Hercules, whil'st he is enraged, and amongst the Furies, but when he is telling merry tales amongst the Meonion Damosels."
                            }
                        ]
                    },
                    {
                        "sense_id": "502c5778-5ee6-3903-8a46-4d7df96a2d62",
                        "entry_id": "54dba2f8-503b-3a9f-9790-2d2e1b72d84d",
                        "glosses": [
                            "Appropriate to the current season of the year."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "700854e7-fe28-44f9-94f2-adde9da75775",
                                "sense_id": "502c5778-5ee6-3903-8a46-4d7df96a2d62",
                                "text": "The temperature outside was quite seasonable, neither warmer nor colder than I had expected."
                            },
                            {
                                "example_id": "a6061de9-d391-4d6a-a5d3-4faedd08b788",
                                "sense_id": "502c5778-5ee6-3903-8a46-4d7df96a2d62",
                                "text": "It was a wild, cold, seasonable night of March, with a pale moon, lying on her back as though the wind had tilted her, and flying wrack of the most diaphanous and lawny texture."
                            }
                        ]
                    },
                    {
                        "sense_id": "24d5ad32-447f-3ea2-a03a-80087af4a38b",
                        "entry_id": "54dba2f8-503b-3a9f-9790-2d2e1b72d84d",
                        "glosses": [
                            "Ephemeral; lasting for just one season."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "a4fd23f0-7bfb-3d35-b2f3-e73dde820912",
