                    {
                        "sense_id": "18f1a5fa-8464-3315-ac74-863b342648b4",
                        "entry_id": "ca7fb47f-38df-318f-bb94-32caf246ada0",
                        "glosses": [
                            "Wealth."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "fe9c393a-ec64-3cb4-a93f-896b68f48cc3",
                        "entry_id": "ca7fb47f-38df-318f-bb94-32caf246ada0",
                        "glosses": [
                            "Abundance, bounty, profusion."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "a3509260-7556-36e9-b9b9-1419e43b86d8",
                        "entry_id": "ca7fb47f-38df-318f-bb94-32caf246ada0",
                        "glosses": [
                            "Ostentatious display of wealth and luxury; plushness."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "8e32b893-e724-4a17-967f-c47205b91d93",
                                "sense_id": "a3509260-7556-36e9-b9b9-1419e43b86d8",
                                "text": "There in full Opulence a Banker dwelt,\nWho all the Joys and Pangs of Riches felt;\nHis Side-board glitter’d with imagin’d Plate;\nAnd his proud Fancy held a vaſt Eſtate."
                            },
                            {
                                "example_id": "35205504-3033-4d84-8e40-cbd10428dba5",
                                "sense_id": "a3509260-7556-36e9-b9b9-1419e43b86d8",
                                "text": "The most meritorious persons have always … been removed from opulence."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b580315e-6cea-4f4d-8918-9d683d84e349",
                        "source_entry_id": "ca7fb47f-38df-318f-bb94-32caf246ada0",
                        "source_sense_description": "wealth",
                        "target_lang_word": "rijkdom",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rijkdom",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "78818dd3-4655-3e23-a20c-47e3bc917832",
                                        "entry_id": "a314010e-1a6e-3a95-859f-857aa89c406d",
                                        "glosses": [
                                            "het bezitten van veel geld en goud"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8bbe1047-b7a6-4c08-b0e5-295f314f4029",
                                                "sense_id": "78818dd3-4655-3e23-a20c-47e3bc917832",
                                                "text": "Hij leefde in grote rijkdom."
                                            },
                                            {
                                                "example_id": "315c3d7a-e081-431f-aa8c-a30fe18df95b",
                                                "sense_id": "78818dd3-4655-3e23-a20c-47e3bc917832",
                                                "text": "De broeders vonden het ontoelaatbaar dat ze van het toppunt van waardigheid, invloed, macht en al die rijkdom naar beneden tuimelden door de lectuur van één boekje; daarom vielen ze de auteur aan."
                                            },
                                            {
                                                "example_id": "19576fcc-5cea-43ba-b8cf-2b953a291f58",
                                                "sense_id": "78818dd3-4655-3e23-a20c-47e3bc917832",
                                                "text": "Het was vooral een herinnering aan al die dingen waaraan hij vermeed te denken, de laatste jaren tenminste, aan hoe makkelijk het was geweest om van armoede tot rijkdom te komen, al hield hij niet van dat woord."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d86d585c-121d-3784-98a0-e5f0da24bdb1",
                                        "entry_id": "a314010e-1a6e-3a95-859f-857aa89c406d",
                                        "glosses": [
                                            "het bezitten van andere waarden zoals geluk"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9d409b6-cdc2-498b-91de-70ac9ba250c6",
                                                "sense_id": "d86d585c-121d-3784-98a0-e5f0da24bdb1",
                                                "text": "Hij had niet veel geld, maar beschouwde zijn gezin en zijn gezondheid als rijkdom."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8e1a285-d2d7-39d0-87ec-249e807ac93a",
                                        "entry_id": "a314010e-1a6e-3a95-859f-857aa89c406d",
                                        "glosses": [
                                            "gewoonlijk meervoud de bezittingen die iemand rijk maken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7eb28da5-7450-4ab2-b093-d4c0a12b3b0f",
                                                "sense_id": "b8e1a285-d2d7-39d0-87ec-249e807ac93a",
                                                "text": "De rijkdommen die hij daar te zien kreeg, verbijsterden hem."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "afa078be-a923-326c-88c7-fafd52e22bd7",
                                        "entry_id": "a314010e-1a6e-3a95-859f-857aa89c406d",
                                        "glosses": [
                                            "overvloed"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f8c36ef-a271-4f3e-87dc-6e4468ece1e4",
                                                "sense_id": "afa078be-a923-326c-88c7-fafd52e22bd7",
                                                "text": "In het oerwoud is een rijkdom van bomen en planten te vinden."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9573c2d8-7b9a-4ab1-a369-ffd42b05f5f3",
                        "source_entry_id": "ca7fb47f-38df-318f-bb94-32caf246ada0",
                        "source_sense_description": "wealth",
                        "target_lang_word": "weelde",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "weelde",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "10726ae3-525f-3db5-9da1-a0308b6be1c3",
                                        "entry_id": "d5cc79b5-c679-3233-b785-d79a7f55c221",
                                        "glosses": [
                                            "omstandigheden van overvloed waar men in leeft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7313b963-576e-43e7-a197-2c327e7b3fd9",
                                                "sense_id": "10726ae3-525f-3db5-9da1-a0308b6be1c3",
                                                "text": "Aan het Franse hof heerste grote weelde, terwijl het volk hongerde."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0d1bedca-d595-4b19-a1be-58d98e973290",
                        "source_entry_id": "ca7fb47f-38df-318f-bb94-32caf246ada0",
                        "source_sense_description": "wealth",
                        "target_lang_word": "Reichtum",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Reichtum",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dbd3c85a-560c-30cb-a9ca-5a8ac9d1f1dd",
                                        "entry_id": "4ea42588-9c1a-3705-b3bf-8325e0b563cc",
                                        "glosses": [
                                            "großer materieller Besitz"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4dd52b8-fbb2-414a-ae3b-ae5bbbb4c9e5",
                                                "sense_id": "dbd3c85a-560c-30cb-a9ca-5a8ac9d1f1dd",
                                                "text": "Der Reichtum des Landes begründet sich auf Öl."
                                            },
                                            {
                                                "example_id": "7c5fdab2-e1cf-46c0-ad9c-eb6b73551525",
                                                "sense_id": "dbd3c85a-560c-30cb-a9ca-5a8ac9d1f1dd",
                                                "text": "„Tribute und Handel spülen Reichtum in die Hauptstadt.“"
                                            },
                                            {
                                                "example_id": "754411a8-0c0d-4611-8006-966a7b5ed3f0",
                                                "sense_id": "dbd3c85a-560c-30cb-a9ca-5a8ac9d1f1dd",
                                                "text": "„Die koloniale Unterdrückung hatte keine Rücksicht auf die Menschen genommen, durch deren Arbeit die Engländer ihren Reichtum vermehrten.“"
                                            },
                                            {
                                                "example_id": "40b8cbef-54b2-472c-b2e6-982ebe38e68b",
                                                "sense_id": "dbd3c85a-560c-30cb-a9ca-5a8ac9d1f1dd",
                                                "text": "„Hüten muss man sich nach Ansicht der Ägypter davor, dass sich der Reichtum zu sehr vermehrt und dadurch nicht mehr zu kontrollieren ist.“"
                                            },
                                            {
                                                "example_id": "c650f0ba-7d2e-4dd3-9b18-298ccabce2ee",
                                                "sense_id": "dbd3c85a-560c-30cb-a9ca-5a8ac9d1f1dd",
                                                "text": "„Ohne Lebensglück wiegen all unsere Erfolge nicht viel, ist aller Reichtum sinnlos.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "24090ee9-79ba-3f8b-8fc5-0f544e937934",
                                        "entry_id": "4ea42588-9c1a-3705-b3bf-8325e0b563cc",
                                        "glosses": [
                                            "große Menge kostbarer Dinge"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ca2f0e8-4a08-442a-8c83-e32dbb8b36ef",
                                                "sense_id": "24090ee9-79ba-3f8b-8fc5-0f544e937934",
                                                "text": "Die alte Gutenbergbibel ist einer der Reichtümer der Bibliothek."
                                            },
                                            {
                                                "example_id": "1e73caff-3ad9-4704-b589-91ee84bdd4b6",
                                                "sense_id": "24090ee9-79ba-3f8b-8fc5-0f544e937934",
                                                "text": "„Bald will er wieder lossegeln und diesmal auch Reichtümer finden.“"
                                            },
                                            {
                                                "example_id": "78360e9c-5f1c-42a5-bdcc-b8a84b82127c",
                                                "sense_id": "24090ee9-79ba-3f8b-8fc5-0f544e937934",
                                                "text": "„Aller Reichtum Russlands geht in die vergoldeten Kirchtürme, sagte Henry.“"
                                            },
                                            {
                                                "example_id": "a5c1d68f-8206-4c26-b437-35afd617a3dc",
                                                "sense_id": "24090ee9-79ba-3f8b-8fc5-0f544e937934",
                                                "text": "„Untereinander unterhielten die Adelshäuser mithilfe gegenseitiger Geschenke und Tributzahlungen enge Verbindungen und häuften so ganz nebenbei gewaltige Reichtümer an.“"
                                            },
                                            {
                                                "example_id": "8329454d-757e-435b-880b-e8eb619af493",
                                                "sense_id": "24090ee9-79ba-3f8b-8fc5-0f544e937934",
                                                "text": "„Er hatte einen Neffen, der alle seine Reichtümer erben sollte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aa7abb5e-0642-422f-a7b7-0e9057b238b0",
                        "source_entry_id": "ca7fb47f-38df-318f-bb94-32caf246ada0",
                        "source_sense_description": "wealth",
                        "target_lang_word": "Wohlstand",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wohlstand",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "951ecab2-6662-3c42-9c85-fd4e8c65cd33",
                                        "entry_id": "6adaf4c7-7944-34ef-8691-a5644d2d727a",
                                        "glosses": [
                                            "gute wirtschaftliche Lage"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "892e4235-dafe-44b1-bc42-749ec08c4c02",
                                                "sense_id": "951ecab2-6662-3c42-9c85-fd4e8c65cd33",
                                                "text": "„Ich neide anderen Menschen ihren Wohlstand nicht.“"
                                            },
                                            {
                                                "example_id": "4d81d02d-216e-4395-8663-a7f67a4f7a0d",
                                                "sense_id": "951ecab2-6662-3c42-9c85-fd4e8c65cd33",
                                                "text": "„Dieser Hof verschaffte ihr Wohlstand und Einfluss.“"
                                            },
                                            {
                                                "example_id": "2fd30c53-19b9-4581-864e-fbddd6195b45",
                                                "sense_id": "951ecab2-6662-3c42-9c85-fd4e8c65cd33",
                                                "text": "„Bei Renate war der Wohlstand ausgebrochen.“"
                                            },
                                            {
                                                "example_id": "2550827d-5f5b-4dc2-9bc7-92088ed0e782",
                                                "sense_id": "951ecab2-6662-3c42-9c85-fd4e8c65cd33",
                                                "text": "„Der neue Wohlstand und die Macht von Addis Abeba untergraben den Einfluss der Provinzfürsten zusätzlich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7861c7cb-0d71-47b3-8b72-c0cb6045306e",
                        "source_entry_id": "ca7fb47f-38df-318f-bb94-32caf246ada0",
                        "source_sense_description": "wealth",
                        "target_lang_word": "obfitość",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "obfitość",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "00128a71-f92f-3287-90be-cbaad964e47a",
                                        "entry_id": "9235ea52-b148-3ae7-9ab8-99d039ad019c",
                                        "glosses": [
                                            "duża, w zupełności wystarczająca ilość czegoś"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32ccaf63-bd39-47dd-8a38-4f7d88503cd0",
                                                "sense_id": "00128a71-f92f-3287-90be-cbaad964e47a",
                                                "text": "Nie będą już wiedzieli o obfitości w tym kraju wskutek głodu, który potem nadejdzie, bo będzie to głód bardzo ciężki."
                                            },
                                            {
                                                "example_id": "a2bbf424-341e-4ddc-af9e-94f3cbbfc5d6",
                                                "sense_id": "00128a71-f92f-3287-90be-cbaad964e47a",
                                                "text": "Wiedział, gdzie najłatwiej poławiają się kiełbie i płotki, lub w największej obfitości mieszkają szczupaki, u jakich brzegów raki najgęściej obsiadają podwodne mchy i kamienie, w jakiej porze dnia i roku jakie gatunki ryb na jakie biorą się przynęty"
                                            },
                                            {
                                                "example_id": "785867f8-fbb6-4f27-a0b2-3e159a41ad9e",
                                                "sense_id": "00128a71-f92f-3287-90be-cbaad964e47a",
                                                "text": "Mamy szczęście, że żyjemy w kraju pokoju i obfitości."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c4023b4e-0e80-42b3-aefe-925af6ad2c96",
                        "source_entry_id": "ca7fb47f-38df-318f-bb94-32caf246ada0",
