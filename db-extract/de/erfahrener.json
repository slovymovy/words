                "senses": [
                    {
                        "sense_id": "6ced6802-4735-3522-b1f0-36622c2ddbb3",
                        "entry_id": "3d624fa0-e052-3029-b069-7301a76e0d52",
                        "glosses": [
                            "Person, die über viel Erfahrung, Kenntnisse oder Fertigkeiten in einem bestimmten Bereich verfügt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b82e4907-0756-418b-8a33-88620d26986a",
                                "sense_id": "6ced6802-4735-3522-b1f0-36622c2ddbb3",
                                "text": "„Wir haben genügend Erfahrene, um hoffentlich nicht komplett zu verkrampfen.“"
                            },
                            {
                                "example_id": "beda070e-8579-41a2-8fea-8452553c53c6",
                                "sense_id": "6ced6802-4735-3522-b1f0-36622c2ddbb3",
                                "text": "„Ein Geheimtipp der Erfahrenen ist dahingegen Sex am See.“"
                            },
                            {
                                "example_id": "1b9b2bef-a7d1-4435-a7d9-2a71cd44640c",
                                "sense_id": "6ced6802-4735-3522-b1f0-36622c2ddbb3",
                                "text": "„Ob die Fachwelt aus den Erfahrungen und Warnungen Erfahrener lernen wird?“"
                            },
                            {
                                "example_id": "089a4634-6809-4632-acd5-b440d3020514",
                                "sense_id": "6ced6802-4735-3522-b1f0-36622c2ddbb3",
                                "text": "„Sie erhalten Informationen, wie Sie in Kontakt kommen mit Erfahrenen in der Flüchtlingsarbeit und wie Sie selbst aktiv werden können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
