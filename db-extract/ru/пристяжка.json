                "senses": [
                    {
                        "sense_id": "64adea40-10a6-3653-bd42-2cf899426d0f",
                        "entry_id": "effc1707-93cf-3600-8dab-3b32011640d3",
                        "glosses": [
                            "запряжка лошади сбоку от оглобель для помощи коренной"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "195b7121-fea4-4009-9365-49590ec3e982",
                                "sense_id": "64adea40-10a6-3653-bd42-2cf899426d0f",
                                "text": "Запрячь в пристяжку"
                            },
                            {
                                "example_id": "5783cfb3-a875-488e-accd-67c5228c03fc",
                                "sense_id": "64adea40-10a6-3653-bd42-2cf899426d0f",
                                "text": "Запряги новую лошадь в правую пристяжку"
                            },
                            {
                                "example_id": "cde7e43b-8482-4824-84cd-345525e51275",
                                "sense_id": "64adea40-10a6-3653-bd42-2cf899426d0f",
                                "text": "Она лучше идет не в корню, а на пристяжке"
                            }
                        ]
                    },
                    {
                        "sense_id": "6236403c-1c7a-3aee-8ced-ef2452d01e22",
                        "entry_id": "effc1707-93cf-3600-8dab-3b32011640d3",
                        "glosses": [
                            "лошадь, запряженная сбоку от оглобель для помощи коренной"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85f352f8-0216-4e80-ae76-e08ba7f5df40",
                                "sense_id": "6236403c-1c7a-3aee-8ced-ef2452d01e22",
                                "text": "Пристяжка захромала"
                            },
                            {
                                "example_id": "21317daa-19c9-4dda-8be8-c46f0ff63c2b",
                                "sense_id": "6236403c-1c7a-3aee-8ced-ef2452d01e22",
                                "text": "Загнув голову набок, словно пристяжка из ухарской тройки, человек с гиком выкатил тележку из оврага на дорогу и победно остановился."
