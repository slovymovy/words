                                "target_lang_sense_clarification": "osoba nebo věc známá jako předmět posměchu či opovržení"
                            },
                            {
                                "target_lang_word": "předmět posměchu",
                                "target_lang_sense_clarification": "ten, kdo je všeobecně terčem posměchu"
                            },
                            {
                                "target_lang_word": "symbol opovržení",
                                "target_lang_sense_clarification": "literárně: všeobecně známý symbol hanby nebo neštěstí"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "01b1b55a-884e-3a01-b993-6bce7de328ef",
                    "sense_definition": "A common phrase or metaphor used to describe something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "saying",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The term was once used to describe any common <w>proverb</w> or metaphor.",
                            "target_lang_translations": {
                                "cs": "Tento termín se kdysi používal pro označení jakéhokoli běžného <w>rčení</w> nebo metafory."
                            }
                        },
                        {
                            "text": "Scholars debate the historical definition of a <w>proverb</w>.",
                            "target_lang_translations": {
                                "cs": "Badatelé diskutují o historické definici <w>rčení</w>."
                            }
