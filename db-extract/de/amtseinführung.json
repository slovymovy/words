                ],
                "senses": [
                    {
                        "sense_id": "effa440a-450f-3710-86d8-3837a31c5ce8",
                        "entry_id": "2830a632-a9ca-3ca4-bd6b-deacdb2cab2f",
                        "glosses": [
                            "Ernennung, Berufung in ein bestimmtes Amt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d83eb40f-fb85-4c3b-935e-321b8272f481",
                                "sense_id": "effa440a-450f-3710-86d8-3837a31c5ce8",
                                "text": "„Das Schlimmste, was sich ein amtierender Präsident bisher geleistet hat, war die Nichtteilnahme an der Amtseinführung seines Nachfolgers.“"
                            },
                            {
                                "example_id": "1b6f732d-e2f4-471b-81a8-2fb967050325",
                                "sense_id": "effa440a-450f-3710-86d8-3837a31c5ce8",
                                "text": "„Onkel Roy hat eine Sitzung zur Amtseinführung des Bürgermeisters einberufen, aber sie wurde verschoben.““"
                            },
                            {
                                "example_id": "db49b437-d816-4a74-982d-96eebf8d9c22",
                                "sense_id": "effa440a-450f-3710-86d8-3837a31c5ce8",
                                "text": "„Für Donald Trump gab es nach seiner Wahl zum US-Präsidenten kaum ein wichtigeres Thema, als wie viele Menschen zu seiner Amtseinführung gekommen waren.“"
                            },
                            {
                                "example_id": "5aaf304c-951e-4217-83b3-a6ae2b5ec52b",
                                "sense_id": "effa440a-450f-3710-86d8-3837a31c5ce8",
                                "text": "„Philip Roth wurde zwei Wochen nach Roosevelts erster Amtseinführung und etwa sieben Wochen nach Hitlers Ernennung zum Reichskanzler geboren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
