                "senses": [
                    {
                        "sense_id": "030dff24-e823-358f-a3a9-96c89fc5d7b4",
                        "entry_id": "e5343495-64fa-397e-8b05-4a66c4e3a522",
                        "glosses": [
                            "A former local government region in the west of Scotland, created in 1975, abolished in 1996."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d472c37-eaec-4848-b20a-bb7550bdf4a7",
                                "sense_id": "030dff24-e823-358f-a3a9-96c89fc5d7b4",
                                "text": "Subsequent to the re-organisation of Scottish local government in 1973, West Central Scotland effectively became the urbanised industrial heartland of Strathclyde Region which focused upon the area previously known as the Clydeside..."
                            },
                            {
                                "example_id": "4c2762ee-d333-4413-8507-15ed71b121d5",
                                "sense_id": "030dff24-e823-358f-a3a9-96c89fc5d7b4",
                                "text": "It remains a key part of the busy Strathclyde railway system, with its high-level platforms served by trains to Lanarkshire, Ayrshire and England, and its low-level platforms a key artery at the heart of the busiest commuter network outside London."
                            }
                        ]
                    },
                    {
                        "sense_id": "6d28e5d9-1f56-3ac1-ac92-77a23f073897",
                        "entry_id": "e5343495-64fa-397e-8b05-4a66c4e3a522",
                        "glosses": [
                            "The Kingdom of Strathclyde, a former kingdom (AD 450–1093) spanning southern Scotland and northern England."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d97aec0d-fd54-4fa9-b7cd-146f8deb2c3e",
                                "sense_id": "6d28e5d9-1f56-3ac1-ac92-77a23f073897",
                                "text": "The Scots then had to deal with the Britons of Strathclyde, the British kingdom in southwest Scotland that at its height included Cumbria down to the Welsh border. The Britons shared power with the Scots and Picts in the early medieval period..."
                            }
                        ]
                    },
                    {
                        "sense_id": "570a67b2-357a-31e7-b13d-0af48b9fc7e4",
                        "entry_id": "e5343495-64fa-397e-8b05-4a66c4e3a522",
                        "glosses": [
                            "Strathclyde University"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cef2258f-97b7-4221-bfc4-1cf87e7c043a",
                                "sense_id": "570a67b2-357a-31e7-b13d-0af48b9fc7e4",
                                "text": "Strathclyde University was the first in Britain to offer a full range of degrees—undergraduate, postgraduate and doctoral—in the subject of Marketing..."
                            }
                        ]
                    }
