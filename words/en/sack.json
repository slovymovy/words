    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c22075d9-ee9e-3f18-b8e4-668c2fa59878",
                    "sense_definition": "A large bag made of strong, coarse material for storage and handling of goods; also, a paper or plastic bag used for groceries.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "c22075d9-ee9e-3f18-b8e4-668c2fa59878",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer carried a heavy <w>sack</w> of potatoes on his shoulder.",
                            "target_lang_translations": {
                                "ru": "Фермер нес на плече тяжелый <w>мешок</w> картошки.",
                                "zh": "农夫肩上扛着一<w>麻袋</w>沉重的土豆。"
                            }
                        },
                        {
                            "text": "Please put the apples in a paper <w>sack</w>.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, положи яблоки в бумажный <w>пакет</w>.",
                                "zh": "请把苹果装进纸<w>袋子</w>里。"
                            }
                        }
