                "translations": [
                    {
                        "translation_id": "62942ee1-1a17-4b9c-813c-b820b0441a09",
                        "source_entry_id": "5edd58d6-fc72-39b8-9df9-50eff782471e",
                        "source_sense_description": "art of making and performing with puppets",
                        "target_lang_word": "Puppenspiel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Puppenspiel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ff6cf5e6-c8fb-39cb-b6c4-89bef3d06948",
                                        "entry_id": "33da332e-9612-39b8-b313-05916278de39",
                                        "glosses": [
                                            "Sondergebiet des Theaters mit Puppen als Schauspielern, die auf einer verkleinerten Bühne agieren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "367963d5-d282-4561-87fc-0478758eabc6",
                                                "sense_id": "ff6cf5e6-c8fb-39cb-b6c4-89bef3d06948",
                                                "text": "Als Volks- oder Kindertheater haben Puppenspiele einen hohen erzieherischen Wert."
                                            },
                                            {
                                                "example_id": "e181d272-93a3-4529-bf63-e8556ff11c83",
                                                "sense_id": "ff6cf5e6-c8fb-39cb-b6c4-89bef3d06948",
                                                "text": "Ich sehe mir gerne ein Puppenspiel an."
                                            },
                                            {
                                                "example_id": "75b684fa-415a-4c69-b9f6-d4f22472995c",
                                                "sense_id": "ff6cf5e6-c8fb-39cb-b6c4-89bef3d06948",
                                                "text": "„Später, etwa von 1933 an, wurde das Puppenspiel auch für systematische und experimentelle Untersuchungen verwendet, und zwar in sehr verschiedenartigen Forschungsarrangements.“"
                                            },
                                            {
                                                "example_id": "49c5efd8-835e-4f88-9f38-154dfd2d7bb6",
                                                "sense_id": "ff6cf5e6-c8fb-39cb-b6c4-89bef3d06948",
                                                "text": "„Der Senior des deutschen Puppenspiels selbst, Max Jacob, leitet ihn; er erzählt von seinen ‚Hohnsteinern’, mit denen er seit 1921 das Handpuppenspiel auf ein bis dahin unbekanntes künstlerisches und literarisches Niveau erhoben, ja, geradezu den Stil für das ernstzunehmende Puppentheater geschaffen hat.“"
                                            },
                                            {
                                                "example_id": "3050e861-5537-4cbd-8189-53b7de498644",
                                                "sense_id": "ff6cf5e6-c8fb-39cb-b6c4-89bef3d06948",
                                                "text": "„Er nahm teil an Maiwein-Waldpartien und an Tanzbelustigungen und schrieb nebenher noch schnell ein Puppenspiel im Stil grausiger Ritterdramen.“"
                                            },
                                            {
                                                "example_id": "a1a74a8a-bd61-43b3-8a69-1a36cc1e19aa",
                                                "sense_id": "ff6cf5e6-c8fb-39cb-b6c4-89bef3d06948",
                                                "text": "„Eleanor erlöste Julie für ein paar Stunden von ihren Mutterpflichten und strahlte genauso wie Amélie, wenn sie nach einem Spaziergang durch den Jardin du Luxembourg, einem Puppenspiel, einer Runde Ponyreiten oder einem Crêpe mit Erdbeermarmelade zu Shakespeare and Company zurückkehrten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
