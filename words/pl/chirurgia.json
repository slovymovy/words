                    "sense_id": "680e6de2-0440-3d70-842e-1eabc3d76935",
                    "sense_definition": "dział medycyny zajmujący się leczeniem operacyjnym chorób i urazów",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "medycyna",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W Warszawie odbyła się konferencja na temat <w>chirurgii</w> plastycznej, w której uczestniczyło wielu lekarzy.",
                            "target_lang_translations": {
                                "ru": "В Варшаве прошла конференция по пластической <w>хирургии</w>, в которой приняли участие многие врачи."
                            }
                        },
                        {
                            "text": "Współczesna <w>chirurgia</w> rozwija się bardzo szybko dzięki nowoczesnym technologiom.",
                            "target_lang_translations": {
                                "ru": "Современная <w>хирургия</w> развивается очень быстро благодаря новым технологиям."
                            }
                        }
                    ],
                    "synonyms": [
