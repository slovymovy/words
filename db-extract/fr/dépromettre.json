                "senses": [
                    {
                        "sense_id": "3a35bee2-0ea3-35bf-be46-bc013a39a184",
                        "entry_id": "fe542763-a256-33c3-8d01-adf8d6481be7",
                        "glosses": [
                            "Retirer une promesse."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "25ffd2a8-fc98-423b-bd55-e7fb4d8110e4",
                                "sense_id": "3a35bee2-0ea3-35bf-be46-bc013a39a184",
                                "text": "Elle l’avait promise, c’est vrai : eh bien, elle la dépromet."
                            },
                            {
                                "example_id": "68a32088-bae4-4102-b050-22c7f4daeb6d",
                                "sense_id": "3a35bee2-0ea3-35bf-be46-bc013a39a184",
                                "text": "Julie : Quand est-ce donc que vous me marierez avec Monsieur ?\nOronte : Jamais ; et tu n’es pas pour lui.\nJulie : Je le veux avoir, moi, puisque vous me l’avez promis.\nOronte : Si je te l’ai promis, je te le dépromets."
                            },
                            {
                                "example_id": "56b05eb2-71df-4581-8f72-2eaeb039cede",
                                "sense_id": "3a35bee2-0ea3-35bf-be46-bc013a39a184",
                                "text": "Je crois, encore un coup, qu’il vous l’a promise [ma fille, en mariage] ; mais il peut vous la dépromettre ; car, apparemment, il n’en sera rien"
                            },
                            {
                                "example_id": "58232f15-f16b-42f8-a8ca-13f4666fac40",
                                "sense_id": "3a35bee2-0ea3-35bf-be46-bc013a39a184",
                                "text": "Je me suis bien promis qu’en faveur de l'affaire Vous feriez de vos biens donation entière…. - Vous vous êtes promis ? … il faut vous dépromettre"
                            }
                        ]
                    }
                ],
