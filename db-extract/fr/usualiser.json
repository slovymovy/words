                "senses": [
                    {
                        "sense_id": "c7301f72-0d94-35d2-8022-d9912ffb6ca0",
                        "entry_id": "a1d32cb0-99da-345e-913c-f6288431ee03",
                        "glosses": [
                            "Donner un caractère usuel à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1680bdb8-c771-48ab-ba10-235b87dce307",
                                "sense_id": "c7301f72-0d94-35d2-8022-d9912ffb6ca0",
                                "text": "Non fonctionnel parce qu’il est livré sans distribution (donc sans « mode d’emploi »), et que la distribution d’un vocable, surtout graduée, est beaucoup plus difficile à découvrir qu’on ne pense même par le natif averti, et pratiquement impossible à « usualiser » par l’apprenti en langue."
                            },
                            {
                                "example_id": "c29f4c31-bbf7-491d-8081-7d24446420d2",
                                "sense_id": "c7301f72-0d94-35d2-8022-d9912ffb6ca0",
                                "text": "Au cours de l’évolution de la langue, ces métaphores peuvent perdre leur caractère de métaphore et s’usualiser."
                            }
                        ]
                    }
                ],
