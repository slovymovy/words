                        "sense_id": "75527481-40b6-3962-bde7-09640f129dd7",
                        "entry_id": "e450fbfb-ea6b-33b8-bda7-318ede3aae8c",
                        "glosses": [
                            "Schaftstiefel mit einem manchmal umschlagbaren oberen Rand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cbfdd692-2fbc-40ea-a8fc-302ca6428193",
                                "sense_id": "75527481-40b6-3962-bde7-09640f129dd7",
                                "text": "Der Stulpenstiefel schützt vor eindringendem Wasser."
                            },
                            {
                                "example_id": "da6445ea-a02a-481c-b3c7-434515237fc7",
                                "sense_id": "75527481-40b6-3962-bde7-09640f129dd7",
                                "text": "„Der Kapitän trug stets einen blauen Zivilanzug, graubraune Hosen und Stulpenstiefel, wenn er an Land ging.“"
                            },
                            {
                                "example_id": "9c49b836-7e45-4287-a6a2-d141e49f1c35",
                                "sense_id": "75527481-40b6-3962-bde7-09640f129dd7",
                                "text": "„Nur der dänische Landvogt hatte blanke Stulpenstiefel aus weichem, schön braunem und frisch eingefettetem Leder, die bis zu den Knien reichten, mit blitzblanken silbernen Sporen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
