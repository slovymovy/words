                                    {
                                        "sense_id": "991a55be-940a-3145-8cfb-0d3b43ee125a",
                                        "entry_id": "372140e3-b7fd-301c-a51a-ec78e96cebeb",
                                        "glosses": [
                                            "Anlage zur Stauung von Wasser, die quer durch ein fließendes Gewässer verläuft"
                                        ],
                                        "tags": [
                                            "Wasserbau"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c604527d-1cb8-4663-8bed-4601d39cea88",
                                                "sense_id": "991a55be-940a-3145-8cfb-0d3b43ee125a",
                                                "text": "Das Wehr staut den kleinen Bach auf."
                                            },
                                            {
                                                "example_id": "ef4437ea-de86-4041-850d-91f53318c3fd",
                                                "sense_id": "991a55be-940a-3145-8cfb-0d3b43ee125a",
                                                "text": "Martin Pusch hat vor drei Jahren den Hauptstadtfluss eingehend untersucht, vom Ufer bis zur Sohle. Dabei haben er und seine Mitarbeiter entdeckt, wie fragil das mit Wehren, Schleusen und Ufermauern künstlich im Gleichgewicht gehaltene Flüsschen ist."
                                            },
                                            {
                                                "example_id": "0d68059d-7dc5-4b22-a641-ae1f4a28d8fc",
                                                "sense_id": "991a55be-940a-3145-8cfb-0d3b43ee125a",
                                                "text": "„Ich bin ziemlich lange mit nackten Füßen durch den Eltzbach gegangen, Papa aber hat sich nach einer Weile an das Ufer gesetzt und das kleine Wehr gezeichnet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Wehr",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "73e6c20f-ae52-3abf-a3ca-ae60afe617ec",
                                        "entry_id": "2b8af523-bf7e-38d6-8599-6f56cf437a80",
                                        "glosses": [
                                            "deutschsprachiger Nachname, Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6e746b0-af7f-4829-b42a-7ba14d26e987",
                                                "sense_id": "73e6c20f-ae52-3abf-a3ca-ae60afe617ec",
                                                "text": "Frau Wehr ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "de59421e-496b-4ada-8085-99415daedde6",
                                                "sense_id": "73e6c20f-ae52-3abf-a3ca-ae60afe617ec",
                                                "text": "Herr Wehr wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "fd58f9a4-f96d-428f-a227-d974730c35e1",
                                                "sense_id": "73e6c20f-ae52-3abf-a3ca-ae60afe617ec",
                                                "text": "Die Wehrs fliegen heute nach La Paz."
                                            },
                                            {
                                                "example_id": "8d687c6d-cd5a-449d-82b0-5b627aef02e9",
                                                "sense_id": "73e6c20f-ae52-3abf-a3ca-ae60afe617ec",
                                                "text": "Der Wehr trägt nie die Schals, die die Wehr ihm strickt."
                                            },
                                            {
                                                "example_id": "58405736-19d4-45dc-abed-8c6a8db58a5c",
                                                "sense_id": "73e6c20f-ae52-3abf-a3ca-ae60afe617ec",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Wehr kommt, geht der Herr Wehr.“"
                                            },
                                            {
                                                "example_id": "170a5635-a0e4-49cb-bf93-5110ed73f9f3",
                                                "sense_id": "73e6c20f-ae52-3abf-a3ca-ae60afe617ec",
                                                "text": "Wehr kommt und geht."
                                            },
                                            {
                                                "example_id": "4d378487-65c8-4a6e-a4f0-9d64e41454f5",
                                                "sense_id": "73e6c20f-ae52-3abf-a3ca-ae60afe617ec",
                                                "text": "Wehrs kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
