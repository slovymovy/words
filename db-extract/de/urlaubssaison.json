                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6cb10d76-781d-4348-9f4d-afe8232c1ffe",
                                "sense_id": "b45e1638-b6c7-307a-a542-4bc9e12ae25d",
                                "text": "„Der italienische Fotograf Stefano Cerio hat die Touristenhochburgen Chinas außerhalb der Urlaubssaison besucht.“"
                            },
                            {
                                "example_id": "54cb0844-8d50-4637-88fe-3f461d8e4e6c",
                                "sense_id": "b45e1638-b6c7-307a-a542-4bc9e12ae25d",
                                "text": "„Für Touristinnen und Touristen, die zum Start der Urlaubssaison auf die östlichste der bewohnten Ostfriesischen Inseln wollen, kommt die Havarie zur Unzeit.“"
                            }
                        ],
