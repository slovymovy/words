                            {
                                "example_id": "94a94d08-2b1c-4d78-83b2-884dd73f9e26",
                                "sense_id": "92041fc5-cf2d-3c74-942d-2abd707030bf",
                                "text": "Het is het ergste Tourongeluk ooit. Minuten eerder stond het volk nog rijendik in het minuscule Port de Couze. Allemaal dorpelingen, wachtend op het Tourcircus dat ze alleen van hun radio kennen. Tot er plots een tank­wagen kwam aangereden. De tankwagen raast op volle snelheid door, recht de massa in, ramt de brugleuning, vaagt alles en iedereen weg en verdwijnt in het water."
                            }
                        ]
                    },
