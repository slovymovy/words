    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "fc40b604-86fb-3fbe-af1a-2881a0896c86",
                    "sense_definition": "Barely sufficient in amount, size, or extent; meager or inadequate.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "insufficiency",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The committee paid <w>scant</w> attention to the safety concerns raised by the workers.",
                            "target_lang_translations": {
                                "ru": "Комитет уделил <w>ничтожно мало</w> внимания вопросам безопасности, поднятым рабочими."
                            }
                        },
                        {
                            "text": "There was only <w>scant</w> information available about the cause of the sudden power failure.",
                            "target_lang_translations": {
                                "ru": "О причине внезапного отключения электроэнергии имелась лишь <w>скудная</w> информация."
                            }
