                "senses": [
                    {
                        "sense_id": "d83adcda-c53a-3ebd-a118-004bb6054b1c",
                        "entry_id": "c0de0202-fc3f-36df-8c26-7dca0da328c0",
                        "glosses": [
                            "Déesse du temps, de la mort et de la délivrance, mère destructrice et créatrice."
                        ],
                        "tags": [
                            "Hinduism"
                        ],
                        "examples": [
                            {
                                "example_id": "cf8e0563-2156-4a89-ae97-7f3e88ba935b",
                                "sense_id": "d83adcda-c53a-3ebd-a118-004bb6054b1c",
                                "text": "Sa Notre-Dame-des-Flammes me fait songer malgré moi à Durga ou à Kali, à la puissante Mère hindoue dont tout sort et en qui tout s’abîme, et qui danse sur le monde, annulant les formes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "227a188b-3fae-496a-baff-6f6968b0ac70",
                        "source_entry_id": "c0de0202-fc3f-36df-8c26-7dca0da328c0",
                        "source_sense_id": "d83adcda-c53a-3ebd-a118-004bb6054b1c",
                        "target_lang_word": "Kali",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kali",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1d092e73-edec-37ae-9d41-35c67d5895f9",
                                        "entry_id": "838ba54c-4951-3e88-b474-44bbc59473a0",
                                        "glosses": [
                                            "Kalium"
                                        ],
                                        "tags": [
                                            "short-form"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ce74d22f-d6fb-4c5f-b74d-fc7e254cf501",
                                                "sense_id": "1d092e73-edec-37ae-9d41-35c67d5895f9",
                                                "text": "Zusätzlich entstehen aus Kalium aber auch vielfältige Vorprodukte für die Herstellung industrieller und pharmazeutischer Erzeugnisse, die ohne Kali nicht denkbar wären."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bbfdc115-6a1f-3dae-9e24-9e4658f27226",
                                        "entry_id": "838ba54c-4951-3e88-b474-44bbc59473a0",
                                        "glosses": [
                                            "Kalisalze, Kalidünger"
                                        ],
                                        "tags": [
                                            "short-form"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "50adecf8-3c66-4a1d-abf4-752f15f00800",
                                                "sense_id": "bbfdc115-6a1f-3dae-9e24-9e4658f27226",
                                                "text": "Schwefelsaures Kali ist ein Pflanzendünger."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Kali",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a7030837-f946-33e5-8174-4b41879007a5",
                                        "entry_id": "4f33d539-2e10-314f-8194-e46acf36e184",
                                        "glosses": [
                                            "Göttin des Todes, der Zerstörung und der Erneuerung im Hinduismus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d149a31d-0891-4726-86c1-e4b8d6d9a38b",
                                                "sense_id": "a7030837-f946-33e5-8174-4b41879007a5",
                                                "text": "„Sie behaupten, Yasus Kinder zu sein, aber im Herzen bleiben sie Anbeter der Hindu-Göttin Kali, die Menschen nach ihrer Herkunft beurteilen und nicht nach ihrer Hingabe an Unseren Herrn Yasu und nach dem, was sie für Yasus Kinder tun.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "43120a00-2e0d-4cfa-bd34-6b72f59c97fe",
                        "source_entry_id": "c0de0202-fc3f-36df-8c26-7dca0da328c0",
                        "source_sense_id": "d83adcda-c53a-3ebd-a118-004bb6054b1c",
                        "target_lang_word": "Kali",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kali",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2ff8bb28-490e-3017-909f-3e41c7aa873b",
                                        "entry_id": "caca9181-e597-31cf-9c30-d55c5b32f50d",
                                        "glosses": [
                                            "A goddess in Hinduism, one of the most significant figures within that religion, who destroys evil forces and bestows liberation."
                                        ],
                                        "tags": [
                                            "Hinduism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "92b86e49-1d1f-4e85-96fd-2b04a099cbfd",
                                                "sense_id": "2ff8bb28-490e-3017-909f-3e41c7aa873b",
                                                "text": "Kālī is Śiva's \"other\" wife, as it were, provoking him and encouraging him in his mad, antisocial, often disruptive habits. It is never Kālī who tames Śiva but Śiva who must becalm Kālī."
                                            },
                                            {
                                                "example_id": "c8032a38-e03f-40f7-b805-8c448190f5a4",
                                                "sense_id": "2ff8bb28-490e-3017-909f-3e41c7aa873b",
                                                "text": "To many Hindu Bengalis, Kālī is the most important divinity. Identified with the great Goddess, Devi Bhagavati, she subsumes all other goddesses."
                                            },
                                            {
                                                "example_id": "b9612d64-a1ab-4f53-8ec0-2b7006d47391",
                                                "sense_id": "2ff8bb28-490e-3017-909f-3e41c7aa873b",
                                                "text": "A popular form of Kali worshiped in Calcutta is Adya Shakti Kali, or Kali as primordial power. Adya Shakti Kali is also present in some tantras, especially the Mahanirvana Tantra. Because she devours Kala or Time, she is Kali, the original form of all things, and because she is the origin and devourer of all things, she is called Adya Kali."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "123bd2f3-bd54-3eea-b616-ac7308ed4c3c",
                                        "entry_id": "caca9181-e597-31cf-9c30-d55c5b32f50d",
                                        "glosses": [
                                            "A female given name from Sanskrit used especially in India."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Kali",
                                "target_lang_code": "en",
