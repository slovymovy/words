                "senses": [
                    {
                        "sense_id": "1024e39c-d369-35b4-8168-bc8cd9dae085",
                        "entry_id": "b2b29d48-5419-37a9-834c-ef47e5ad12cd",
                        "glosses": [
                            "ein nicht gültig veröffentlichter (vor allem) zoologischer Artname, der aber später validiert und teilweise als Basis für den neuen wissenschaftlichen Namen genommen wurde"
                        ],
                        "tags": [
                            "Nomenklatur"
                        ],
                        "examples": [
                            {
                                "example_id": "63bf12e2-e2ba-4593-a628-44605c58103a",
                                "sense_id": "1024e39c-d369-35b4-8168-bc8cd9dae085",
                                "text": "„Ein Protonym des wissenschaftlichen Namen ist Rallus carolinus.“"
                            },
                            {
                                "example_id": "009c02a8-d898-4810-b167-67b677120db1",
                                "sense_id": "1024e39c-d369-35b4-8168-bc8cd9dae085",
                                "text": "Der Begriff Protonym wird im \"Index nominum genericorum\" verwendet, der \"Internationale Code der Botanischen Nomenklatur (ICBN)\" verwendet ihn jedoch explizit nicht."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
