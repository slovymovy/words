                "senses": [
                    {
                        "sense_id": "d17687af-f77f-38e9-b247-28fd4f82e938",
                        "entry_id": "a78e8658-724f-3099-bfee-4b7fc5d4ac35",
                        "glosses": [
                            "Refrain ou apostrophe joyeuse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "324449c0-55c3-4ce7-b659-8068efd12e96",
                                "sense_id": "d17687af-f77f-38e9-b247-28fd4f82e938",
                                "text": "Ah ! landeridera, lanlaire, lanturlu, tandis que je faisais tous ces lantiponnages, ce maître hurluberlu lampait au cabaret, ne savait déjà plus pourquoi s’était battu, et bras dessus bras dessous, avec le loup s’enfuit (ah ! le lâche ! le lâche !), fuit devant la brebis !…"
                            }
                        ]
                    },
                    {
                        "sense_id": "c452a889-23c2-3857-ada8-22e77b7514f6",
                        "entry_id": "a78e8658-724f-3099-bfee-4b7fc5d4ac35",
                        "glosses": [
                            "Refus accompagné de mépris, réponse évasive."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb7fce78-f4ba-48ea-bc2d-f5b9dce5af37",
                                "sense_id": "c452a889-23c2-3857-ada8-22e77b7514f6",
                                "text": "Allez au diable ; adieu ! bernique ! tintin !\nIl lui a répondu lanturlu."
                            },
                            {
                                "example_id": "3c08c3ec-a7d6-4139-a3f8-3fc8b75921dd",
                                "sense_id": "c452a889-23c2-3857-ada8-22e77b7514f6",
                                "text": "Le vulgaire dissolu\nTient les mètres en estime :\nIl y mord en vrai goulu !\nBah ! Pour mériter la prime,\nTu lui diras : lanturlu !"
                            }
                        ]
                    },
                    {
                        "sense_id": "8ea25ea9-f96c-33dd-9737-59a574e815ec",
                        "entry_id": "a78e8658-724f-3099-bfee-4b7fc5d4ac35",
                        "glosses": [
                            "Hurluberlu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4fd188b7-3da4-4423-9414-d3d7fe65e559",
                                "sense_id": "8ea25ea9-f96c-33dd-9737-59a574e815ec",
                                "text": "Ah ! voyez donc le lanturlu !"
                            },
                            {
                                "example_id": "63ac3b95-6f80-400d-9f54-336597ea8621",
                                "sense_id": "8ea25ea9-f96c-33dd-9737-59a574e815ec",
                                "text": "Croyez-moi, bande de lanturlus, c’est pas par salacité que je subordonne cette condition signée Cadum à mon acceptation …."
                            }
                        ]
                    },
                    {
                        "sense_id": "b851f546-d18f-3076-8269-5d3f16c7da75",
                        "entry_id": "a78e8658-724f-3099-bfee-4b7fc5d4ac35",
                        "glosses": [
                            "Vignerons du Dijonnais qui se soulevèrent contre le pouvoir royal en 1630."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4fc88f06-97ec-4c50-9218-6c3b566b6b71",
                                "sense_id": "b851f546-d18f-3076-8269-5d3f16c7da75",
                                "text": "Les dernières épreuves que la Bourgogne eut à traverser furent, sous Louis XIII, une révolte des vignerons, qui se réunissaient au refrain, Lanturlu, d’une vieille chanson, ce qui fit désigner cette révolte, qui, d’ailleurs, fut bientôt apaisée, sous le nom de Révolte des Lanturlus."
                            }
                        ]
