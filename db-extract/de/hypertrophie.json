                "senses": [
                    {
                        "sense_id": "8d820f84-696e-39a2-8060-18579da4e75d",
                        "entry_id": "e0e89456-e015-3336-a066-1aea84388f76",
                        "glosses": [
                            "bei vermehrter Beanspruchung auftretende Vergrößerung von Geweben oder Organen durch Vergrößerung der Zellen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95ab0361-efc1-403c-b65f-a8c0174f5a46",
                                "sense_id": "8d820f84-696e-39a2-8060-18579da4e75d",
                                "text": "Eine Hypertrophie des Herzens wünscht sich niemand."
                            },
                            {
                                "example_id": "30eed490-5741-47ae-89e9-773440fc108d",
                                "sense_id": "8d820f84-696e-39a2-8060-18579da4e75d",
                                "text": "Ein Bodybuilder wünscht sich die Hypertrophie der trainierten Muskel."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6539b11e-247f-3a9f-ad3e-b79d12891e7e",
                        "entry_id": "e0e89456-e015-3336-a066-1aea84388f76",
                        "glosses": [
                            "Übermaß, Übersteigertsein"
                        ],
                        "tags": [
                            "formal"
                        ],
                        "examples": [
                            {
                                "example_id": "4984bf83-b3c5-4350-a2d6-d6f325553c5f",
                                "sense_id": "6539b11e-247f-3a9f-ad3e-b79d12891e7e",
                                "text": "Er zeigt eine Hypertrophie seines Selbstbewusstseins."
                            },
                            {
                                "example_id": "878ffbe7-8cd7-4030-83a5-db2743fe95c6",
                                "sense_id": "6539b11e-247f-3a9f-ad3e-b79d12891e7e",
                                "text": "„Und geknäuelte Hypertrophien sehen genau wie Laster aus.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0e828a01-4617-40ba-9a8e-f1d22c7c2c68",
                        "source_entry_id": "e0e89456-e015-3336-a066-1aea84388f76",
                        "source_sense_id": "8d820f84-696e-39a2-8060-18579da4e75d",
                        "target_lang_word": "hypertrophy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hypertrophy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b9876b40-c067-3399-b513-d970a9d12c82",
                                        "entry_id": "09165f38-0583-31c4-aba8-276b68215cb7",
                                        "glosses": [
                                            "An increase in the size of an organ or tissue due to the enlargement of its individual cells."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "216c2339-79e6-44e7-b36f-6f71e50a82a2",
                                                "sense_id": "b9876b40-c067-3399-b513-d970a9d12c82",
                                                "text": "Ectopic chondrocyte hypertrophy has been demonstrated in OA, suggesting that the pathogenetical process involves a recapitulation of endochondral ossification [ 11 – 13 ]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f2f35c4-80cf-37c8-b1c0-e21f389f1175",
                                        "entry_id": "09165f38-0583-31c4-aba8-276b68215cb7",
                                        "glosses": [
                                            "An increase in the size of an organ or tissue due to the enlargement of its individual cells.",
                                            "Increase in muscle size through increased size of individual muscle cells; a result of weightlifting, and other exercise. It differs from muscle hyperplasia, which is the formation of new muscle cells."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "hypertrophy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b8ee591c-cbe4-3193-b0d9-e4261aadbbef",
                                        "entry_id": "d8cfb20f-8a72-3f59-b2a2-fc260d336cf5",
                                        "glosses": [
                                            "Of a tissue or organ, to increase in size."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9df984d4-3efa-315f-afaa-35b3a0bbd25b",
                                        "entry_id": "d8cfb20f-8a72-3f59-b2a2-fc260d336cf5",
                                        "glosses": [
                                            "To enlarge or extend."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "758b487d-3123-4a12-835a-7425e53b5d1b",
                                                "sense_id": "9df984d4-3efa-315f-afaa-35b3a0bbd25b",
                                                "text": "But when text hypertrophies into a riot of contending inscripturations, we lose too much of what matters most in writing."
                                            },
                                            {
                                                "example_id": "ec232f3f-e564-4782-b39b-bb67f086549c",
                                                "sense_id": "9df984d4-3efa-315f-afaa-35b3a0bbd25b",
                                                "text": "Like a well-exercised muscle, 'network' has hypertrophied into a master concept."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9fc3a335-02c6-4e44-b17c-ffa76146e183",
                        "source_entry_id": "e0e89456-e015-3336-a066-1aea84388f76",
                        "source_sense_id": "8d820f84-696e-39a2-8060-18579da4e75d",
                        "target_lang_word": "hypertrophie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hypertrophie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "86c5664a-93cf-3931-b79e-e9e992c3bc11",
                                        "entry_id": "fd967361-8d62-3d96-9a1f-1059ac6313f1",
                                        "glosses": [
                                            "Augmentation du volume d’un organe par l’augmentation du nombre de cellules (hyperplasie) ou par augmentation du volume de chacune des cellules de l’organe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e447fe60-0c1f-4573-ab5e-9fc3a559aa17",
                                                "sense_id": "86c5664a-93cf-3931-b79e-e9e992c3bc11",
                                                "text": "L’hypertrophie thyroïdienne dont est atteint le sujet, et peut-être aussi un certain degré de sthénose de la trachée, consécutive à la trachéotomie, rendirent la chloroformisation très difficile."
                                            },
                                            {
                                                "example_id": "fe22a8a6-d575-41d5-9a3e-8cb938d1c3e6",
                                                "sense_id": "86c5664a-93cf-3931-b79e-e9e992c3bc11",
                                                "text": "Souffrant d’une hypertrophie du cœur, il ne pouvait se coucher, et passait la nuit dans son fauteuil, avec ses livres sur une tablette. Deux heures avant sa mort, il essaya de lire encore. Il était affectueux et bon."
                                            },
                                            {
                                                "example_id": "d6ccbea2-c768-44a5-885d-e4816ce97f36",
                                                "sense_id": "86c5664a-93cf-3931-b79e-e9e992c3bc11",
                                                "text": "Hypertrophie de la mâchoire, du crâne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fd2afa8e-e2df-3e7e-9c3c-975406a93ff8",
                                        "entry_id": "fd967361-8d62-3d96-9a1f-1059ac6313f1",
                                        "glosses": [
                                            "Développement excessif."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e966410-80c7-4a3d-8bd6-a049414f3cb8",
                                                "sense_id": "fd2afa8e-e2df-3e7e-9c3c-975406a93ff8",
                                                "text": "L’hypertrophie du Moi."
                                            },
                                            {
                                                "example_id": "4c114a6d-a519-44a2-95c9-45941bbf05a0",
                                                "sense_id": "fd2afa8e-e2df-3e7e-9c3c-975406a93ff8",
                                                "text": "Les Occidentaux modernes prennent pour l'évidence la seule conception qu'ils connaissent, celle de la société de consommation, fondée sur la suggestion et l'hypertrophie des besoins égoïstes."
                                            }
                                        ]
                                    }
                                ]
                            },
