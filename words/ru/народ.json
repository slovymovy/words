    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8105db12-2927-3e3c-ae74-479d05b7df9a",
                    "sense_definition": "Люди, группа людей или обращение к ним (обычно в разговорной речи).",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В автобусе было полно <w>народа</w>, поэтому нам пришлось стоять всю дорогу.",
                            "target_lang_translations": {
                                "en": "The bus was full of <w>people</w>, so we had to stand the whole way.",
                                "zh": "公交车上全是<w>人</w>，所以我们一路都得站着。"
                            }
                        },
                        {
                            "text": "Привет, <w>народ</w>, какие у нас планы на эти выходные?",
                            "target_lang_translations": {
                                "en": "Hi <w>folks</w>, what are our plans for this weekend?",
                                "zh": "嘿<w>大家</w>，我们这个周末有什么计划？"
                            }
                        }
                    ],
                    "synonyms": [
                        "люди",
                        "толпа",
                        "публика"
                    ],
                    "common_phrases": [
                        "куча народа",
                        "полно народа",
                        "привет народ",
                        "много народа"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "People, a group of people, or a form of address (usually colloquial).",
                        "zh": "指一群人，或在口语中作为对众人的称呼。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "people",
                                "target_lang_sense_clarification": "general plural of person"
                            },
                            {
                                "target_lang_word": "folks",
                                "target_lang_sense_clarification": "colloquial form of address"
                            },
                            {
                                "target_lang_word": "crowd",
                                "target_lang_sense_clarification": "large group of people"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "人",
                                "target_lang_sense_clarification": "指代一群人"
                            },
                            {
                                "target_lang_word": "大家",
                                "target_lang_sense_clarification": "口语中对众人的称呼"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7c190312-56e8-3a6f-952e-020b6b5c1240",
                    "sense_definition": "Совокупность людей, объединённых общностью происхождения, языка, культуры и истории.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "group_ethnic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Каждый <w>народ</w> имеет свои уникальные традиции, песни и праздники.",
                            "target_lang_translations": {
                                "en": "Every <w>people</w> has its own unique traditions, songs, and holidays.",
                                "zh": "每个<w>民族</w>都有其独特的传统、歌曲和节日。"
                            }
                        },
                        {
                            "text": "Дружба <w>народов</w> помогает сохранять мир и понимание между странами.",
                            "target_lang_translations": {
                                "en": "Friendship of <w>peoples</w> helps preserve peace and understanding between countries.",
                                "zh": "<w>民族</w>间的友谊有助于维护各国之间的和平与理解。"
                            }
                        }
                    ],
                    "synonyms": [
                        "нация",
                        "этнос",
                        "племя",
                        "род"
                    ],
                    "common_phrases": [
                        "дружба народов",
                        "традиции народа",
                        "история народа",
                        "малые народы"
                    ],
                    "target_lang_definitions": {
                        "en": "A body of people united by common descent, language, culture, and history.",
                        "zh": "指在血缘、语言、文化和历史上具有共同特征的群体。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "people",
                                "target_lang_sense_clarification": "ethnic group or nation (countable)"
                            },
                            {
                                "target_lang_word": "nation",
                                "target_lang_sense_clarification": "cultural or political community"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "民族",
                                "target_lang_sense_clarification": "指具有共同文化和历史的群体"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "32fca969-5be1-385a-9217-4247c1f3b495",
                    "sense_definition": "Всё население определённой страны или государства.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "group_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Президент выступил с важным обращением, чтобы успокоить <w>народ</w>.",
                            "target_lang_translations": {
                                "en": "The president made an important address to calm the <w>people</w>.",
                                "zh": "总统发表了重要讲话，以安抚<w>人民</w>。"
                            }
                        },
                        {
                            "text": "Депутаты должны принимать законы, которые выражают волю <w>народа</w>.",
                            "target_lang_translations": {
                                "en": "Deputies must pass laws that express the will of the <w>people</w>.",
                                "zh": "议员们应当制定能够表达<w>人民</w>意愿的法律。"
                            }
                        }
                    ],
                    "synonyms": [
                        "население"
                    ],
                    "common_phrases": [
                        "слуга народа",
                        "воля народа",
                        "враг народа",
                        "единство народа"
                    ],
                    "target_lang_definitions": {
                        "en": "The entire population of a specific country or state.",
                        "zh": "指一个国家或地区的全体居民。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "people",
                                "target_lang_sense_clarification": "the citizenry or population"
                            },
                            {
                                "target_lang_word": "public",
                                "target_lang_sense_clarification": "the community as a whole"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "人民",
                                "target_lang_sense_clarification": "指国家公民或全体国民"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3852667d-74f4-34b4-9d42-9e8b5320ea57",
                    "sense_definition": "Простые люди, низшие сословия общества (в отличие от знати и аристократии).",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В девятнадцатом веке интеллигенция стремилась стать ближе к простому <w>народу</w>.",
                            "target_lang_translations": {
                                "en": "In the nineteenth century, the intelligentsia strove to become closer to the common <w>people</w>.",
                                "zh": "在十九世纪，知识分子渴望走近普通<w>百姓</w>。"
                            }
                        },
                        {
                            "text": "Богатая знать жила во дворцах, пока простой <w>народ</w> трудился в полях.",
                            "target_lang_translations": {
                                "en": "The rich nobility lived in palaces while the common <w>people</w> toiled in the fields.",
                                "zh": "富有的贵族住在宫殿里，而普通<w>平民</w>则在田间劳作。"
                            }
                        }
                    ],
                    "synonyms": [
                        "простонародье",
                        "люд"
                    ],
                    "antonyms": [
                        "знать"
                    ],
                    "common_phrases": [
                        "простой народ",
                        "выход из народа",
                        "голос народа"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in historical contexts regarding social classes"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Common people or lower social classes (as distinct from the nobility).",
                        "zh": "指社会中的普通阶层，区别于贵族或统治阶级。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "common people",
                                "target_lang_sense_clarification": "ordinary citizens"
                            },
                            {
                                "target_lang_word": "masses",
                                "target_lang_sense_clarification": "the ordinary populace"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "百姓",
                                "target_lang_sense_clarification": "指普通平民"
                            },
                            {
                                "target_lang_word": "平民",
                                "target_lang_sense_clarification": "指普通阶层"
                            }
                        ]
                    }
                }
            ]
        }
    ]
