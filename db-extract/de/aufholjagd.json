                                "example_id": "ed28f0af-2dbd-4e75-9b07-e9b7cb21a83e",
                                "sense_id": "ee717efe-0609-3d7a-842f-084061c0f46e",
                                "text": "Nach dem frühen 3:0 startete die Gastmannschaft in der zweiten Halbzeit eine unglaubliche Aufholjagd und konnte doch noch mit einem 3:3 und einem Punkt nach Hause fahren."
                            }
