                                        "sense_id": "4ad41d84-c5e6-3be7-a7b6-39cf35da8e4f",
                                        "entry_id": "c6de74c6-51e9-3d46-9adc-d5a6997b9bf8",
                                        "glosses": [
                                            "Une des parties centrales de la queue."
