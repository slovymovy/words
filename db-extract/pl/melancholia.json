                    {
                        "translation_id": "d299f49b-09c7-4877-a73f-8e5aa49cd7f4",
                        "source_entry_id": "23132e1c-31d0-36e1-ac35-03f7eee02040",
                        "source_sense_id": "85a7d299-d95f-3410-af51-7b9ad7d21592",
                        "target_lang_word": "Melancholie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Melancholie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cfc7f51c-b25d-3d00-8f35-e6d8f4c3b735",
                                        "entry_id": "aabf5a2a-b313-321f-be83-0c6670828af7",
                                        "glosses": [
                                            "Zustand der Schwermut oder Depression, psychische Niedergeschlagenheit, große Traurigkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "136f5d97-c843-43dc-9063-489f17b0023c",
                                                "sense_id": "cfc7f51c-b25d-3d00-8f35-e6d8f4c3b735",
                                                "text": "In der Psychologie wird der Begriff Melancholie heute durch den Begriff Depression ersetzt."
                                            },
                                            {
                                                "example_id": "2e2ea189-5ef8-418b-b781-c17f1efe34c4",
                                                "sense_id": "cfc7f51c-b25d-3d00-8f35-e6d8f4c3b735",
                                                "text": "„Der Weltschmerz ist verwandt mit der Schwermut, auch Melancholie genannt.“"
                                            },
                                            {
                                                "example_id": "9442168f-37e9-40d3-984a-71bf7bf19cc4",
                                                "sense_id": "cfc7f51c-b25d-3d00-8f35-e6d8f4c3b735",
                                                "text": "„Trotzdem bleibt in dem Jungen eine Melancholie zurück, die sich mit den Jahren in Bitterkeit verwandelt.“"
                                            },
                                            {
                                                "example_id": "435ba3bb-b7c4-46e6-ada0-d15f60151678",
                                                "sense_id": "cfc7f51c-b25d-3d00-8f35-e6d8f4c3b735",
                                                "text": "„Sie habe ihn um zwanzig Jahre jünger gemacht, behauptete er alle paar Tage, wenn er nicht eben an seinen Melancholien litt.“"
                                            },
                                            {
                                                "example_id": "a074dbdd-5f2c-4750-aa1d-cd4c3c599775",
                                                "sense_id": "cfc7f51c-b25d-3d00-8f35-e6d8f4c3b735",
                                                "text": "„Adas Melancholie hatte Ähnlichkeit mit seiner.“"
                                            },
                                            {
                                                "example_id": "40f271f2-c952-4754-9cb4-dfdd02e497fc",
                                                "sense_id": "cfc7f51c-b25d-3d00-8f35-e6d8f4c3b735",
                                                "text": "„Nach der Abreise des jungen Paares wurde er still und begann über Beklemmungen und Melancholien zu klagen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
