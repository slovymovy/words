                ],
                "translations": [
                    {
                        "translation_id": "495add53-9b8d-4280-b32b-c8b5197988fe",
                        "source_entry_id": "8c81d10d-6ca5-38fc-a030-00bbdc6cc636",
                        "source_sense_id": "070537ef-0968-33c5-b978-38ba1143ea90",
                        "target_lang_word": "ultimately",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ultimately",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ccb01f4c-e8ae-3ffe-b00e-4b721ad6e9b7",
                                        "entry_id": "df4e3910-5a2c-3889-91e1-8646800ad007",
                                        "glosses": [
                                            "Indicating the last item."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "13bdaf22-9a5b-4730-bd53-8d42e7d1333e",
                                                "sense_id": "ccb01f4c-e8ae-3ffe-b00e-4b721ad6e9b7",
                                                "text": "Firstly,… Secondly,… Ultimately,…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "154d52f1-6708-30dd-af6c-5c94952beabd",
                                        "entry_id": "df4e3910-5a2c-3889-91e1-8646800ad007",
                                        "glosses": [
                                            "Indicating the most important action."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "abe4ff92-a87e-4381-b549-9a5a69c158a6",
                                                "sense_id": "154d52f1-6708-30dd-af6c-5c94952beabd",
                                                "text": "Ultimately, he will have to make a decision before the end of the week."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a6656fa-654c-3863-ae9c-50366fdae48f",
                                        "entry_id": "df4e3910-5a2c-3889-91e1-8646800ad007",
                                        "glosses": [
                                            "In the end; finally."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "05d771f8-8960-4075-a983-bb7e9247c058",
                                                "sense_id": "0a6656fa-654c-3863-ae9c-50366fdae48f",
                                                "text": "That Wolves reached half-time on level terms had much to do with the ultimately luckless Hennessey, who was in action in the opening minute to tip away Samir Nasri's shot following a City corner."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bcebd520-92fc-34ce-9acb-8f8df2548769",
                                        "entry_id": "df4e3910-5a2c-3889-91e1-8646800ad007",
                                        "glosses": [
                                            "Used to indicate the etymon at which a given etymological derivation terminates."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "36c619d4-73e1-4be6-8cd8-b8dc2bd983b5",
                                                "sense_id": "bcebd520-92fc-34ce-9acb-8f8df2548769",
                                                "text": "Cognate to Gottscheerish boßər, bàsser. Ultimately cognate to standard High German Wasser."
                                            },
                                            {
                                                "example_id": "0b600faa-80cb-4055-8040-3cac20cc02c8",
                                                "sense_id": "bcebd520-92fc-34ce-9acb-8f8df2548769",
                                                "text": "Shortened from maxiature, ultimately from Latin maximus (\"large\")."
                                            },
                                            {
                                                "example_id": "a27f57c4-3f7f-46af-b970-3959db86c9f4",
                                                "sense_id": "bcebd520-92fc-34ce-9acb-8f8df2548769",
                                                "text": "Ultimately from Latin equus (\"horse\")."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5c2b8e53-20ba-4131-8835-0ff566cd4e33",
                        "source_entry_id": "8c81d10d-6ca5-38fc-a030-00bbdc6cc636",
                        "source_sense_id": "070537ef-0968-33c5-b978-38ba1143ea90",
                        "target_lang_word": "eventually",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eventually",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1b0e8186-5eb7-3dec-a08e-d15da1bc846c",
                                        "entry_id": "0fdf22a8-42e1-315c-83ba-0b30eaccd7c1",
                                        "glosses": [
                                            "In the end; at some later time, especially after a long time, a series of problems, struggles, delays or setbacks."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "61d63c5a-1839-4b76-83fc-e99675f25613",
                                                "sense_id": "1b0e8186-5eb7-3dec-a08e-d15da1bc846c",
                                                "text": "Everyone's true colors will be revealed eventually."
                                            },
                                            {
                                                "example_id": "1f136da1-cd9c-4634-bd0a-fbcea66353fa",
                                                "sense_id": "1b0e8186-5eb7-3dec-a08e-d15da1bc846c",
                                                "text": "She didn't arrive. Eventually, we started without her."
                                            },
                                            {
                                                "example_id": "d13c67cb-ffcf-41b4-a8af-60f0ecb611ed",
                                                "sense_id": "1b0e8186-5eb7-3dec-a08e-d15da1bc846c",
                                                "text": "He hopes eventually to attend nursing school."
                                            },
                                            {
                                                "example_id": "ccf5b733-0dd6-4f74-bbdb-3923972596f3",
                                                "sense_id": "1b0e8186-5eb7-3dec-a08e-d15da1bc846c",
                                                "text": "Eventually, the railway opened on Monday, December 14, 1896, with a universal fare of 1d. collected at the turnstiles, and conditions were immediately chaotic, as many passengers travelled round and round, and refused to leave the cars."
                                            },
                                            {
                                                "example_id": "79ff4c40-c140-484f-80cc-6eb7e54ab7ee",
                                                "sense_id": "1b0e8186-5eb7-3dec-a08e-d15da1bc846c",
                                                "text": "It had taken nine years from the evening that Truman first showed up with a pie plate at her mother's door, but his dogged perseverance eventually won him the hand of his boyhood Sunday school crush."
                                            },
                                            {
                                                "example_id": "a30ee782-8713-4cb2-85ec-aec7529fd1c2",
                                                "sense_id": "1b0e8186-5eb7-3dec-a08e-d15da1bc846c",
                                                "text": "President Volodymyr Zelensky has known the day would come when the idea of another “forever war” became unappealing to NATO, and the world’s largest military alliance eventually sought to wind down its involvement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f6f712c4-5f89-3e0f-8ad8-1cc8663c8a10",
                                        "entry_id": "0fdf22a8-42e1-315c-83ba-0b30eaccd7c1",
                                        "glosses": [
                                            "For some tail; for all terms beyond some term; with only finitely many exceptions."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fda1e907-f13f-4e2e-a3c8-6496bca6d2b5",
                                                "sense_id": "f6f712c4-5f89-3e0f-8ad8-1cc8663c8a10",
                                                "text": "Eventually, all prime numbers are odd."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60c47485-a5f1-34bd-9692-f6df8b9a75e3",
                                        "entry_id": "0fdf22a8-42e1-315c-83ba-0b30eaccd7c1",
                                        "glosses": [
                                            "Possibly, potentially, perhaps."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "proscribed"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d6e224df-8ec8-4d7a-a803-7b833dde4144",
                                                "sense_id": "60c47485-a5f1-34bd-9692-f6df8b9a75e3",
                                                "text": "I will come eventually, but haven't decided yet."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6b415240-03d6-471f-9774-c428179895b4",
                        "source_entry_id": "8c81d10d-6ca5-38fc-a030-00bbdc6cc636",
                        "source_sense_id": "070537ef-0968-33c5-b978-38ba1143ea90",
