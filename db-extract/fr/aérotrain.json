                "senses": [
                    {
                        "sense_id": "dccae82b-4db3-3eed-b003-b01cbc0f4836",
                        "entry_id": "709aee7c-07a8-3255-a92a-5ad58061bfbe",
                        "glosses": [
                            "Véhicule glissant sur un coussin d’air au-dessus d’une voie spéciale en forme de T inversé et propulsé par une turbine, un turboréacteur ou un moteur électrique linéaire, sans contact avec la voie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e49e6ad-0f0e-4bbe-bdad-d287f74b37fe",
                                "sense_id": "dccae82b-4db3-3eed-b003-b01cbc0f4836",
                                "text": "Un aérotrain apparut au sommet de la digue qui lui servait de rail."
                            },
                            {
                                "example_id": "c5c6504d-f857-4b1d-a9aa-b7abb7f909ef",
                                "sense_id": "dccae82b-4db3-3eed-b003-b01cbc0f4836",
                                "text": "Après avoir avalé un comprimé de Lénys pour se calmer, il agrafa sa cape en chantoung vert et sortit de l'aérotrain."
                            },
                            {
                                "example_id": "05f3e028-0ab7-426b-8dd9-f225fec195e4",
                                "sense_id": "dccae82b-4db3-3eed-b003-b01cbc0f4836",
                                "text": "Or les créateurs de l'aérotrain pensent avec raison que, pour être compétitif sur Paris-Lyon , l'engin devrait atteindre 400 km/h, ce qui permettrait de gagner 40 minutes sur le turbotrain."
                            }
                        ]
                    }
                ],
