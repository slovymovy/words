                "translations": [
                    {
                        "translation_id": "97107733-1708-4222-8414-afa0c7407795",
                        "source_entry_id": "5dc50f3f-ad85-308f-92a8-da23dc028649",
                        "source_sense_id": "3dfa4d76-46f0-379c-8558-4e60bdd05aff",
                        "source_sense_description": "sdÜ",
                        "target_lang_word": "Großraumflugzeug",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Großraumflugzeug",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7e063890-3fc5-371c-b62f-622ae4e25d20",
                                        "entry_id": "f626e753-e1b2-3af4-8ec0-bf9ab4647eda",
                                        "glosses": [
                                            "Flugzeug, das über besonders viel Platz für die Aufnahme von Fracht oder Passagieren verfügt"
                                        ],
                                        "tags": [
                                            "Luftfahrt"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "77bf6625-6d94-4c8c-bafa-048d87734431",
                                                "sense_id": "7e063890-3fc5-371c-b62f-622ae4e25d20",
                                                "text": "„Airbus-Chef Fabrice Bregier führt die raren Bestellungen für sein Großraumflugzeug A380 auf eine Fehleinschätzung des Konzerns zurück.“"
                                            },
                                            {
                                                "example_id": "f3920863-4d4d-4d6f-b356-225bd740e512",
                                                "sense_id": "7e063890-3fc5-371c-b62f-622ae4e25d20",
                                                "text": "„Unter den Augen von mehreren tausend Zuschauern auf dem Flughafen Toulouse-Blagnac hob die Kraft der vier gewaltigen Triebwerke das Großraumflugzeug um 10.29 Uhr in die Luft.“"
                                            },
                                            {
                                                "example_id": "f1eecfa5-ecae-42db-8bb4-a09c2aae19e7",
                                                "sense_id": "7e063890-3fc5-371c-b62f-622ae4e25d20",
                                                "text": "„In diesem Jahr soll das Unternehmen noch vier weitere Großraumflugzeuge erhalten, die dann nach Los Angeles und Chicago sowie nach Neu Delhi und Bangalore in Indien fliegen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "685377b7-eb5d-4a29-9516-bf3ff325c690",
                        "source_entry_id": "5dc50f3f-ad85-308f-92a8-da23dc028649",
                        "source_sense_id": "3dfa4d76-46f0-379c-8558-4e60bdd05aff",
                        "source_sense_description": "sdÜ",
                        "target_lang_word": "Airbus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Airbus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9bd3dd0a-39c6-3ed1-95ba-8cb4121c31e2",
                                        "entry_id": "c4a42e6d-1f4a-3a71-ac6b-76a994d87653",
                                        "glosses": [
                                            "großer europäischer Flugzeughersteller"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "69d270f7-cfaa-4c7d-8e00-dc05246e87f0",
                                                "sense_id": "9bd3dd0a-39c6-3ed1-95ba-8cb4121c31e2",
                                                "text": "Das Emirat Dubai will offenbar seine Großbestellungen bei Airbus und Boeing umschichten."
                                            },
                                            {
                                                "example_id": "dbbdb445-6b9a-47c3-a301-9af311698617",
                                                "sense_id": "9bd3dd0a-39c6-3ed1-95ba-8cb4121c31e2",
                                                "text": "„Sie arbeitet bei Airbus, die Rente ist nah.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "eb9bd546-75b9-300a-9697-32ccda1b7db7",
                                        "entry_id": "c4a42e6d-1f4a-3a71-ac6b-76a994d87653",
                                        "glosses": [
                                            "ein einzelnes Flugzeug des Herstellers Airbus^([1])"
                                        ],
                                        "tags": [
                                            "Singular -usses und Plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15bfa4cd-ef6d-48c7-b80d-cf0a00bbb019",
                                                "sense_id": "eb9bd546-75b9-300a-9697-32ccda1b7db7",
                                                "text": "Umgerüstet zum Privatjet ist der Airbus A380 (Superjumbo) heute das größte mobile Statussymbol der Welt."
                                            },
                                            {
                                                "example_id": "ad9e2c3b-aee6-44df-9e99-16a881ef12a2",
                                                "sense_id": "eb9bd546-75b9-300a-9697-32ccda1b7db7",
                                                "text": "Die Blackbox des abgestürzten Airbus konnte bislang nicht gefunden werden."
                                            },
                                            {
                                                "example_id": "4d9f6585-9092-44d4-bbc3-8e1d2fa1465c",
                                                "sense_id": "eb9bd546-75b9-300a-9697-32ccda1b7db7",
                                                "text": "„In einer Zeit, da ein Mittelklassewagen wie der andere aussieht und sich auch moderne Verkehrsflugzeuge im Design nur unwesentlich voneinander unterscheiden, ist der Airbus A 380 eben ein besonderes Fluggerät.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e7d00ae0-ab36-412c-9795-d99572492536",
                        "source_entry_id": "5dc50f3f-ad85-308f-92a8-da23dc028649",
                        "source_sense_id": "2031e8c0-9181-3585-886d-8abd9831ada4",
