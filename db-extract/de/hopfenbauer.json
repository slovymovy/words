                ],
                "senses": [
                    {
                        "sense_id": "5e2feb42-26b2-332a-be54-f0d7cfc67ca0",
                        "entry_id": "8c941b6a-d19c-38c0-b9f1-414dc933b9af",
                        "glosses": [
                            "Landwirt, der seinen Schwerpunkt auf den Anbau sowie die Ernte von Hopfen gelegt hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12e989a2-6b9f-42a4-8af6-559a0e97cc42",
                                "sense_id": "5e2feb42-26b2-332a-be54-f0d7cfc67ca0",
                                "text": "„Drei Hektar, mehr als vier Fußballfelder, so groß ist das Feld, auf dem Hopfenbauer Stephan Fuß (39) jetzt den Draht für seinen Hopfen stecken muss.“"
                            },
                            {
                                "example_id": "86fce13c-494b-45a0-b0c4-3442cf99de2c",
                                "sense_id": "5e2feb42-26b2-332a-be54-f0d7cfc67ca0",
                                "text": "„Ein Hopfenbauer aus der Holledau (Raffael Scherer) soll mit einer Brauereistochter aus dem Oberland (Alexander Bitsch) vermählt werden.“"
                            },
                            {
                                "example_id": "aeae9341-6323-44e1-8da6-417a0b50d202",
                                "sense_id": "5e2feb42-26b2-332a-be54-f0d7cfc67ca0",
                                "text": "„Ein Hopfenbauer aus der Hallertau will wissen, wie es mit den Niederschlägen im nächsten Jahr sein wird, und ein Skilift-Betreiber aus Oberammergau fragt den Starnberger Hobbymeteorologen, wann es denn endlich schneit.“"
                            },
                            {
                                "example_id": "5ac20675-eb13-4231-a9a8-785855f3e62a",
                                "sense_id": "5e2feb42-26b2-332a-be54-f0d7cfc67ca0",
                                "text": "„Ein mühsames Geschäft: ‚Man muss den Wurzelstock freilegen, die Sprossen abschneiden und die Wurzeln wieder mit Erde bedecken‘, sagt Hopfenbauer Konrad Bogenrieder aus Mainburg-Ebrantshausen.“"
                            },
                            {
                                "example_id": "5556df0c-010c-42c3-aa11-5f7ca7618e79",
                                "sense_id": "5e2feb42-26b2-332a-be54-f0d7cfc67ca0",
                                "text": "„Im nördlichen Landkreis Freising suchen Hopfenbauer verzweifelt nach Saisonkräften.“"
                            },
                            {
                                "example_id": "9e71d1db-8793-4a47-b726-434125ff0e6a",
                                "sense_id": "5e2feb42-26b2-332a-be54-f0d7cfc67ca0",
                                "text": "„Die Preise fielen von einem Tiefstand auf den nächsten, viele Hopfenbauer zogen es nach Barths Worten vor, Prämien für die Stilllegung ihrer Felder mit den Kletterpflanzen zu kassieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
