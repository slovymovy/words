                ],
                "senses": [
                    {
                        "sense_id": "e742c8cc-68d3-38d3-8490-357f0dcafcd1",
                        "entry_id": "ee5e5467-d7c7-32e6-bc49-c7be4a8c797e",
                        "glosses": [
                            "(gesellig in und an stehenden und langsam fließenden Binnengewässern des subsaharischen Afrikas lebendes) pflanzenfressendes, nicht wiederkäuendes, zu den Paarhufern und Dickhäutern gehörendes, braunhäutiges Säugetier mit nahezu haarlosem und massigem, plumpem Körper, kurzen, stämmigen Beinen mit Schwimmhäuten an deren Zehen, breitem Kopf mit kleinen Augen und Ohren und einem riesigen Maul mit langen, hauerartigen Eckzähnen (Hippopotamus amphibius)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "235821a5-de98-463b-8c77-69d2ced21705",
                                "sense_id": "e742c8cc-68d3-38d3-8490-357f0dcafcd1",
                                "text": "„Aus einem braunen Weiher gucken Ohren, Glubschaugen und Nüstern eines Flusspferdes (Hippopotamus oder umgangssprachlich Hippo).“"
                            },
                            {
                                "example_id": "a64c88f7-fe50-4300-92a9-3cdc64fdb307",
                                "sense_id": "e742c8cc-68d3-38d3-8490-357f0dcafcd1",
                                "text": "„Das Nilpferd, auch Flusspferd oder Hippopotamus genannt, ist wie das Schwein ein Paarhufer und bildet mit ihm die Unterordnung der Nichtwiederkäuer (Nonruminantia).“"
                            },
                            {
                                "example_id": "48f06918-5c70-4bac-9e51-527353debc92",
                                "sense_id": "e742c8cc-68d3-38d3-8490-357f0dcafcd1",
                                "text": "„Hippos oder Hippopotami oder vulgo Flusspferde haben grundsätzlich nur einen einzigen Zweck im Leben – glücklich zu sein.“"
                            },
                            {
                                "example_id": "bb350046-ae0b-491e-a1d3-b492ad08ebc0",
                                "sense_id": "e742c8cc-68d3-38d3-8490-357f0dcafcd1",
                                "text": "„Am 1. Juli wurde der Sohn nach einer Tragzeit von 245 Tagen geboren — an Land, entgegen sonstiger Gewohnheit eines Hippopotamus.“"
                            },
                            {
                                "example_id": "9a3c0de1-fb8b-484b-b490-fdcf677d8d7a",
                                "sense_id": "e742c8cc-68d3-38d3-8490-357f0dcafcd1",
                                "text": "„Wahrscheinlich wegen ihrer Kopfform würden die Hippopotamus als Pferde bezeichnet, vermutet von Houwald.“"
                            },
                            {
                                "example_id": "9bd4d317-fb43-4189-823f-d6532ee35cbf",
                                "sense_id": "e742c8cc-68d3-38d3-8490-357f0dcafcd1",
                                "text": "„Zwar sehen wir in den darauffolgenden Stunden noch ein halbes Dutzend Giraffen, zwei fröhliche Wildschweinfamilien und einen im Busch verschwindenden Hippopotamus von hinten, doch angesichts der eigentlichen Nicht-Begegnung mit den Elefanten verblassen diese Erlebnisse.“"
                            },
                            {
                                "example_id": "65f5185f-166b-4668-a6d1-cefd39e3f654",
                                "sense_id": "e742c8cc-68d3-38d3-8490-357f0dcafcd1",
                                "text": "„Damit niemand daran zweifelt, klappt der Hippopotamus seine Riesenkiefer so weit auseinander, wie es geht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
