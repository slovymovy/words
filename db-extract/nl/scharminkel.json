                        "sense_id": "ba100810-71a4-3970-b2c0-4d3ab72f0673",
                        "entry_id": "b1ec83cf-00f3-3b45-917b-5006ea5f567a",
                        "glosses": [
                            "ongezond, klein en mager mens of dier"
