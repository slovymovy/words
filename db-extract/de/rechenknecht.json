                    {
                        "sense_id": "4c19d5f8-7ca8-3b3f-ba77-07e312ea1483",
                        "entry_id": "84d333b3-4fcb-360f-8857-58d23aa4f1b5",
                        "glosses": [
                            "ein Rechner oder eine Rechenmaschine"
                        ],
                        "tags": [
                            "humorous"
                        ],
                        "examples": [
                            {
                                "example_id": "8d6293d0-2022-488c-b34d-a0696f03058b",
                                "sense_id": "4c19d5f8-7ca8-3b3f-ba77-07e312ea1483",
                                "text": "Der alte PC ist zu langsam, ein neuer Rechenknecht muss her."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f2b28b2a-94d4-3314-8fa0-c66ee9c9aa74",
                        "entry_id": "84d333b3-4fcb-360f-8857-58d23aa4f1b5",
                        "glosses": [
                            "eine Person, die Ergebnisse zum Eintrag in Tabellenwerke, wie zum Beispiel Logarithmentafeln oder Navigationshilfen, per Hand ausrechnete"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "1391b126-9e19-4c90-aa8c-7762966a5a9b",
                                "sense_id": "f2b28b2a-94d4-3314-8fa0-c66ee9c9aa74",
                                "text": "„Oftmals wurden Logarithmenwerte von einer ganzen Gruppe, von sogenannten Rechenknechten, ausgerechnet.“"
                            },
                            {
                                "example_id": "a70ddca3-446f-4b6e-bba8-bfb98d37cc16",
                                "sense_id": "f2b28b2a-94d4-3314-8fa0-c66ee9c9aa74",
                                "text": "„Ich habe dir viele schöne Lesebücher gegeben, zum Beispiel die Regula Caeci oder die Geliebte des blinden Flötenspielers, und die welsche Praktika oder das italienische Banditenmädchen, und den faulen Rechenknecht in Clairobscür für die Lesewelt, und du willst immer mehr haben;“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
