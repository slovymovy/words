                                        "glosses": [
                                            "Bauform oder Bauwerk mit einem achteckigen Grundriss"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7791839e-228c-4343-b9d3-38045b50c756",
                                                "sense_id": "c4802505-93bc-3ccf-beb0-cd4c33b58813",
                                                "text": "„Auch in Sindelfingen wollte man ein originelles Cafe, in dem Achteckturm des Architekten Josef Paul Kleihues, doch der will damit nichts zu schaffen haben: Es behagt ihm nicht, verständlicherweise. Es befindet sich im Erdgeschoß seines gedrungenen, mit einer Milchglaspyramide gedeckten dreistöckigen Oktogons […].“"
                                            },
                                            {
                                                "example_id": "f417fc54-afb6-4c6b-9a9d-97083f5f4627",
                                                "sense_id": "c4802505-93bc-3ccf-beb0-cd4c33b58813",
                                                "text": "„Das Motiv ist ein Oktogon, das den Diamanten im Ring der Fürstin repräsentiert, umgeben von ihrem Namenszug.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
