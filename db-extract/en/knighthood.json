                    {
                        "translation_id": "37e0c6a4-94ec-43e3-91bd-6d2111d94482",
                        "source_entry_id": "9876c18b-538f-3a63-b641-f0dbc6542c73",
                        "source_sense_description": "an honour whereby one is made into a knight",
                        "target_lang_word": "Ritterlichkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ritterlichkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "64bd2d0f-f85e-31ec-8061-9066632612a5",
                                        "entry_id": "3e502ff0-1278-3478-ab5a-c275dc088e6a",
                                        "glosses": [
                                            "besonderes und höfliches Entgegentreten von einem Mann gegenüber einer Frau"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "887f2459-8696-411a-95a5-281621f08619",
                                                "sense_id": "64bd2d0f-f85e-31ec-8061-9066632612a5",
                                                "text": "Er trat seiner Angebeteten stets mit besonderer Ritterlichkeit entgegen."
                                            },
                                            {
                                                "example_id": "0c340d0c-00b9-4aa3-a26e-ec9761c958b6",
                                                "sense_id": "64bd2d0f-f85e-31ec-8061-9066632612a5",
                                                "text": "„Ich bin gerührt wie ein Kind am Geburtstagstisch, wenn ich den kleinen Gesten der Ritterlichkeit begegne.“"
                                            },
                                            {
                                                "example_id": "202e5c4e-8d1f-4b96-86db-95ff891373ee",
                                                "sense_id": "64bd2d0f-f85e-31ec-8061-9066632612a5",
                                                "text": "„Offenbar hält er Marc die allgemein längst unmodern gewordene Nibelungentreue oder es ist ein Rest der ebenso seltenen Ritterlichkeit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1e286046-4312-41a8-a92d-fa176b4967d4",
                        "source_entry_id": "9876c18b-538f-3a63-b641-f0dbc6542c73",
                        "source_sense_description": "an honour whereby one is made into a knight",
                        "target_lang_word": "Ritterschaft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ritterschaft",
