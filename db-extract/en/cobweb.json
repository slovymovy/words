                "translations": [
                    {
                        "translation_id": "362c4b24-142b-472a-bbe7-1afb94ebda8b",
                        "source_entry_id": "2a30e4e6-1cab-3fc5-a89a-f1f8d02c418f",
                        "source_sense_id": "99fb6a1e-b770-3966-acb2-30393eb1c8ff",
                        "source_sense_description": "Spinnwebe, besonders für alte und staubige",
                        "target_lang_word": "Spinnwebe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Spinnwebe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1fc0ceb6-0bf1-32c5-afb5-991024bd6aa9",
                                        "entry_id": "df52fcd6-878f-3bed-98ec-65a617a1a9f4",
                                        "glosses": [
                                            "netzartiges Gewebe der Spinne aus erstarrtem Körpersekret erzeugt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8bd5bd7c-1059-4aba-82fc-4fc318327716",
                                                "sense_id": "1fc0ceb6-0bf1-32c5-afb5-991024bd6aa9",
                                                "text": "„Die Gesetze sind den Spinnweben gleich, da die kleinen Fliegen und Mücken innen bleiben henken, die Wespen aber und Hornissen hindurchdringen.“"
                                            },
                                            {
                                                "example_id": "c51e04fd-966a-409a-9ecd-24dace42f9f5",
                                                "sense_id": "1fc0ceb6-0bf1-32c5-afb5-991024bd6aa9",
                                                "text": "Bei ihrem Frühjahrsputz entfernte sie mehrere Spinnweben."
                                            },
                                            {
                                                "example_id": "73b9a406-e9b5-4687-a002-22f7fdca8d50",
                                                "sense_id": "1fc0ceb6-0bf1-32c5-afb5-991024bd6aa9",
                                                "text": "„Die Spinnweben im Keller wickelte Oma mit dem Zeigefinger auf, wischte ihn an der Wand ab und setzte sich dann zum Klönen an den gedeckten Tisch unter der Birke.“"
                                            },
                                            {
                                                "example_id": "e426020f-47fe-4cae-a68c-7f6a802a1ee9",
                                                "sense_id": "1fc0ceb6-0bf1-32c5-afb5-991024bd6aa9",
                                                "text": "„In der Mitte des Raums stand ein mit Spinnweben überzogenes Kinderbettchen, das unter dem Gewicht alter, staubverkrusteter Lumpen fast in sich zusammenbrach.“"
                                            },
                                            {
                                                "example_id": "80f7252f-df2a-48a6-b429-3b659b86e0d5",
                                                "sense_id": "1fc0ceb6-0bf1-32c5-afb5-991024bd6aa9",
                                                "text": "„Dort im Tiefgeschoss, zwischen Spinnweben und tausend Litern Alkohol, verborgen vor aller Welt, drehte ich (lebte ich!) meine erste Hollywoodszene: Ich betrat wieder diesen angstfreien Raum, in dem mich blitzartig jede Erinnerung an meine Vergangenheit verließ und ich das tat, was ich in diesem Augnblick für das einzig Richtige hielt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d2390e6a-bbbf-4753-888a-9ca1cbeae55a",
                        "source_entry_id": "2a30e4e6-1cab-3fc5-a89a-f1f8d02c418f",
