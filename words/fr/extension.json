{
    "word_family": [
        "extenseur",
        "extensibilité",
        "extensible",
        "extensif",
        "étendre",
        "étendue"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f58a854d-3c55-3e66-a29e-25fe4c9fe903",
                    "sense_definition": "Action de donner une plus grande dimension, une plus grande surface ou un plus grand champ d'action ; fait de s'agrandir.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "grandissement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La municipalité a approuvé le projet d'<w>extension</w> du réseau de tramway vers la banlieue."
                        },
                        {
                            "text": "Les propriétaires envisagent une <w>extension</w> de leur maison pour créer une chambre supplémentaire."
                        }
                    ],
                    "antonyms": [
                        "limitation",
                        "restriction"
                    ],
                    "common_phrases": [
                        "extension de maison",
                        "extension du réseau",
                        "projet d'extension"
                    ]
                },
                {
                    "sense_id": "4ddd17f3-6dc9-3b73-a3df-b319469970dc",
                    "sense_definition": "Composant logiciel ou module complémentaire qui apporte de nouvelles fonctionnalités à une application ou un navigateur web.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "informatique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "J'ai installé une <w>extension</w> sur mon navigateur pour bloquer les publicités intempestives."
                        },
                        {
                            "text": "Ce logiciel de dessin propose une <w>extension</w> gratuite pour exporter les images en PDF."
                        }
                    ],
                    "synonyms": [
                        "add-on",
                        "greffon",
                        "plug-in"
                    ],
                    "common_phrases": [
                        "extension de navigateur",
                        "installer une extension"
                    ]
                },
                {
                    "sense_id": "1525194f-4929-358c-b110-e0cc068e5bab",
                    "sense_definition": "Suite de caractères ajoutée à la fin d'un nom de fichier pour en indiquer le format informatique.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "informatique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce document texte doit être enregistré avec l'<w>extension</w> appropriée pour être lu correctement."
                        },
                        {
                            "text": "Le système refuse d'ouvrir le fichier car son <w>extension</w> n'est pas reconnue."
                        }
                    ],
                    "common_phrases": [
                        "extension de fichier",
                        "extension du nom"
                    ]
                },
                {
                    "sense_id": "085b4a1a-d4da-3db8-a96f-bcdf19c1af0d",
                    "sense_definition": "Mouvement par lequel une articulation s'ouvre, éloignant deux segments corporels l'un de l'autre.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "corps",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le kinésithérapeute surveille les mouvements de flexion et d'<w>extension</w> du genou blessé."
                        },
                        {
                            "text": "Après son accident, le patient a retrouvé une complète <w>extension</w> du bras."
                        }
                    ],
                    "antonyms": [
                        "contraction"
                    ],
                    "common_phrases": [
                        "flexion et extension",
                        "mouvement d'extension"
                    ]
                },
                {
                    "sense_id": "dac61161-2dfa-3c09-9b03-0da3ca42442e",
                    "sense_definition": "Élargissement du sens d'un terme pour désigner des réalités proches du sens initial.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "linguistique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "C'est par <w>extension</w> que ce mot technique est désormais employé dans le langage courant."
                        },
                        {
                            "text": "Ce nouveau sens n'est qu'une <w>extension</w> métaphorique de l'acception originale."
                        }
                    ],
                    "common_phrases": [
                        "par extension"
                    ]
                },
                {
                    "sense_id": "468fe2c4-d553-3645-b787-e858fa77a4ce",
                    "sense_definition": "Ensemble de tous les objets réels ou concevables auxquels un concept ou un terme s'applique.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "logique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'<w>extension</w> du mot animal englobe tous les êtres vivants dotés de sensibilité."
                        },
                        {
                            "text": "En logique formelle, la compréhension d'une notion varie en sens inverse de son <w>extension</w>."
                        }
                    ],
                    "antonyms": [
                        "compréhension",
                        "intension"
                    ],
                    "common_phrases": [
                        "définition en extension"
                    ]
                }
            ]
        }
    ]
}