                "senses": [
                    {
                        "sense_id": "1ad376fe-807d-3265-a95c-b6e68493460a",
                        "entry_id": "fce224cd-457a-3f7c-9694-0f66a2e2d586",
                        "glosses": [
                            "передвигаясь на транспортном средстве, переместить его внутрь какого-либо сооружения или загородки"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a423b71e-9dad-47ad-a8b6-0b0cc00579f5",
                                "sense_id": "1ad376fe-807d-3265-a95c-b6e68493460a",
                                "text": "Заехать в гараж."
                            },
                            {
                                "example_id": "06f26569-29fd-4edb-847a-695852b55327",
                                "sense_id": "1ad376fe-807d-3265-a95c-b6e68493460a",
                                "text": "Автомобиль заехал за угол и пропал из виду."
                            }
                        ]
                    },
                    {
                        "sense_id": "f7dfd662-87b3-3ad1-ad42-1ad8f58037ec",
                        "entry_id": "fce224cd-457a-3f7c-9694-0f66a2e2d586",
                        "glosses": [
                            "передвигаясь на транспортном средстве, посетить некое место"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04fc5035-f877-4679-a7cb-449c3eee5ecf",
                                "sense_id": "f7dfd662-87b3-3ad1-ad42-1ad8f58037ec",
                                "text": "Заехать к родственникам в гости."
                            },
                            {
                                "example_id": "05780102-2c59-4bf9-96c5-57ea497f0220",
                                "sense_id": "f7dfd662-87b3-3ad1-ad42-1ad8f58037ec",
                                "text": "Заехать на автозаправку."
                            }
                        ]
                    },
                    {
                        "sense_id": "f401c891-20f7-3910-8247-432d470a4b90",
                        "entry_id": "fce224cd-457a-3f7c-9694-0f66a2e2d586",
                        "glosses": [
                            "жарг. то же, что ударить"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a46e9a40-b3df-4834-9b32-9ac0704c5a9c",
                                "sense_id": "f401c891-20f7-3910-8247-432d470a4b90",
                                "text": "И тут он как заедет Вовану в табло!"
                            }
                        ]
                    }
