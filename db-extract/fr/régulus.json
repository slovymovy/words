            {
                "entry_id": "5cb3c172-a952-3e36-87c3-dad4f3a6ad34",
                "word": "Régulus",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "9a9ecd67-2221-3319-98a5-46f6e5951864",
                        "entry_id": "5cb3c172-a952-3e36-87c3-dad4f3a6ad34",
                        "glosses": [
                            "Marcus Atilius Régulus, général romain durant la première guerre punique, qui, prisonnier des Carthaginois qui l'avaient envoyé à Rome pour traiter de la paix, retourna à Carthage, fidèle à la parole qu'il avait donnée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "917f1118-189f-431e-9390-0e62eadb2d11",
                                "sense_id": "9a9ecd67-2221-3319-98a5-46f6e5951864",
                                "text": "— « Milord, lui dis-je, le sentiment humiliant de la captivité absorbe plus que vous ne pouvez croire. » Et je me souviens que je crus prendre, en disant cela, un air de dignité et une contenance de Régulus, propres à lui donner un grand respect pour moi."
                            },
                            {
                                "example_id": "3f9556ce-ca91-4fe4-ade9-90ed0501f617",
                                "sense_id": "9a9ecd67-2221-3319-98a5-46f6e5951864",
                                "text": "Vous pensez si je me suis gêné, pour jouer devant les murs le Régulus romain !"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
