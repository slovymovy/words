                "senses": [
                    {
                        "sense_id": "5dc03e6a-9349-3fd2-8194-c4b2526db4e5",
                        "entry_id": "a66f5e82-1e7d-3a0f-933e-f127bc921cab",
                        "glosses": [
                            "Rendre moins lourd."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "242d68c9-baf3-474f-92f9-28b8897d3dd6",
                                "sense_id": "5dc03e6a-9349-3fd2-8194-c4b2526db4e5",
                                "text": "Il faut désalourdir, décentraliser le système, l’arracher à cette énorme gangue apparemment inébranlable dans laquelle il se fossilise !"
                            },
                            {
                                "example_id": "4b9776db-400c-4062-a7c5-31c06304b840",
                                "sense_id": "5dc03e6a-9349-3fd2-8194-c4b2526db4e5",
                                "text": "Gaston se soumit également au régime végétarien qui avait pour but de purifier et de désalourdir l’organisme afin d’accorder le libre jeu aux forces astrales et spirituelles."
                            }
                        ]
                    }
                ],
