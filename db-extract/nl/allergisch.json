                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9a0bdb5b-588a-3307-8f3c-a56ed1c98781",
                                        "entry_id": "88b9b430-447c-3d42-beef-7c23eddb923b",
                                        "glosses": [
                                            "Se dit d’une personne dont le système immunitaire réagit de façon plutôt vive à la présence d’un corps étranger."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4b338a5-5042-4438-8433-1494b7dac137",
                                                "sense_id": "9a0bdb5b-588a-3307-8f3c-a56ed1c98781",
                                                "text": "Ces intolérances, strictement individuelles, sont considérées par les médecins comme des cas d’« idiosyncrasie anaphylactique » entraînant de graves réactions allergiques."
                                            },
                                            {
                                                "example_id": "afe81079-fe2d-4e86-8bc2-8a06b408995e",
                                                "sense_id": "9a0bdb5b-588a-3307-8f3c-a56ed1c98781",
                                                "text": "Il arrive qu’un animal, peu de temps après avoir reçu un médicament, se mette à respirer difficilement ou présente des gonflements, avec la peau qui devient irritée et rougit. Dans ce cas, l’animal est allergique au médicament qui lui a été donné."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ee9f95a7-a892-3bb0-8c60-ba622ef1575d",
                                        "entry_id": "88b9b430-447c-3d42-beef-7c23eddb923b",
                                        "glosses": [
                                            "Relatif aux allergies."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bdecb4c9-2f38-4cf5-8cc8-dc1b6099bc31",
                                                "sense_id": "ee9f95a7-a892-3bb0-8c60-ba622ef1575d",
                                                "text": "Il devient le grand spécialiste des maladies allergiques et on lui doit la mise au point de nombreux médicaments comme le Phénergan."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d48335b7-0cc6-3d07-92b0-82db19f73ad0",
                                        "entry_id": "88b9b430-447c-3d42-beef-7c23eddb923b",
                                        "glosses": [
                                            "Qui éprouve un fort sentiment d'aversion pour une activité, une chose ou une personne."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "96a7f034-c65e-4579-8331-75dd7d284f40",
                                                "sense_id": "d48335b7-0cc6-3d07-92b0-82db19f73ad0",
                                                "text": "Allergique au jazz, au football, à la publicité."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "allergique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c0f956f0-b8b1-360f-81fe-337814547fbf",
                                        "entry_id": "cca65c96-b5b7-3bde-9ba6-4fa9893345aa",
                                        "glosses": [
                                            "Personne dont le système immunitaire réagit de façon plutôt vive à la présence d’un corps étranger."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd1c4b52-1bf5-4e0b-853b-dafeba809a02",
                                                "sense_id": "c0f956f0-b8b1-360f-81fe-337814547fbf",
                                                "text": "Et, « s’il y a des phobiques ou des allergiques, c’est évidemment cela qui prime », rappelle Arnaud Levy, chargé de la communication de la mairie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
