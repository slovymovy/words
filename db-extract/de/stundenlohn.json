                ],
                "senses": [
                    {
                        "sense_id": "fe7ad048-b7a2-3ebd-9380-519de9ac0d9f",
                        "entry_id": "de112856-0030-3fac-9ead-8ad81ca4f450",
                        "glosses": [
                            "Entgelt, das für eine Arbeitsstunde bezahlt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d0c8d22-f31a-4f85-8302-0282e25e3b99",
                                "sense_id": "fe7ad048-b7a2-3ebd-9380-519de9ac0d9f",
                                "text": "Bei einem Stundenlohn von sieben Euro kann man keine großen Sprünge machen."
                            },
                            {
                                "example_id": "025735fb-e2ae-49cf-8651-cc1e280f2091",
                                "sense_id": "fe7ad048-b7a2-3ebd-9380-519de9ac0d9f",
                                "text": "„Und das alles machen sie für einen Stundenlohn, für den viele sich schämen würden, ihre Putzfrau zu beschäftigen.“"
                            },
                            {
                                "example_id": "f9059cb0-8ba8-45de-a9ae-82dd3e51207b",
                                "sense_id": "fe7ad048-b7a2-3ebd-9380-519de9ac0d9f",
                                "text": "„Seit elf Jahren arbeitet sie Vollzeit im Diner, derzeit beträgt ihr Stundenlohn 4,05 Dollar.“"
                            },
                            {
                                "example_id": "9b478d06-30ca-4e51-b431-f793fb0164e0",
                                "sense_id": "fe7ad048-b7a2-3ebd-9380-519de9ac0d9f",
                                "text": "„Die Notstandsarbeiter schaufelten bei einem Stundenlohn von fünfundsiebzig Pfennigen den Sand in Loren, die dann zu den Baggern geschoben wurden, welche die Lastwagen beluden.“"
                            },
                            {
                                "example_id": "8c44a32e-e391-456f-939b-f20e962425e6",
                                "sense_id": "fe7ad048-b7a2-3ebd-9380-519de9ac0d9f",
                                "text": "„Noch nicht einmal eine Zigarette kann man für den Stundenlohn kaufen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
