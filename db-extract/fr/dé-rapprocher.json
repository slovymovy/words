                ],
                "senses": [
                    {
                        "sense_id": "c8cfde88-1934-3e81-b5ab-46e7064c6237",
                        "entry_id": "a30b5117-0556-3eec-88f0-401d1aa879a9",
                        "glosses": [
                            "Annuler le rapprochement comptable entre des écritures comptables et des écritures bancaires."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4acfa89-a637-44f5-a546-89675f4610d5",
                                "sense_id": "c8cfde88-1934-3e81-b5ab-46e7064c6237",
                                "text": "Vous devez dé-rapprocher manuellement quelques virements dans les comptes affectés."
                            },
                            {
                                "example_id": "74acd382-24cb-4c29-a29d-97216a467622",
                                "sense_id": "c8cfde88-1934-3e81-b5ab-46e7064c6237",
                                "text": "Elle permet, en sélectionnant différentes lignes de données dans chacune des deux grilles, de rapprocher, pré-rapprocher ou dé-rapprocher celles-ci."
                            },
                            {
                                "example_id": "6b79b756-db9e-4c03-b893-6b3780edd040",
                                "sense_id": "c8cfde88-1934-3e81-b5ab-46e7064c6237",
                                "text": "La gestion de rapprochement manuel des mouvements bancaires (GRBMS pour la version Client/Serveur, ou GRBM pour la version RIA) permet de retrouver les mouvements marqués (grâce aux zones mises à jour précédemment) et de les dé-rapprocher (ou \"dé-pré-rapprocher\")."
                            }
                        ]
                    }
                ],
