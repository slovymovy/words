                        ],
                        "form": "rarissimes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d84ddf42-5dc2-34c3-a643-482854e4713a",
                        "entry_id": "00bf308d-4775-3dfb-bf7b-550ba5a61ee0",
                        "glosses": [
                            "Extrêmement rare."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f808c38-3ed4-49e5-a8a1-4d01c05c7185",
                                "sense_id": "d84ddf42-5dc2-34c3-a643-482854e4713a",
                                "text": "Elle publiera chaque année deux volumes de textes, de format grand in-8, et une réimpression phototypographique de pièces rarissimes ou uniques."
                            },
                            {
                                "example_id": "a7275075-40a6-47ce-b53a-3a1b72bb0793",
                                "sense_id": "d84ddf42-5dc2-34c3-a643-482854e4713a",
                                "text": "Ce document témoignage est inédit. Il est rarissime que l’on donne la parole à un agresseur sexuel."
                            },
                            {
                                "example_id": "1992add9-e41c-49dc-9e87-c84504cf1831",
                                "sense_id": "d84ddf42-5dc2-34c3-a643-482854e4713a",
                                "text": "Les protestations des plumes célèbres, des grandes consciences ont été rarissimes."
                            },
                            {
                                "example_id": "9296b973-491b-4008-80b3-000f40cb5d89",
                                "sense_id": "d84ddf42-5dc2-34c3-a643-482854e4713a",
                                "text": "Aussi n’aimaient-ils pas à ce que les rarissimes piroguiers de passage photographiassent leur antiques et vénérables maisons croulantes."
                            },
                            {
                                "example_id": "5d035120-7dee-421b-bd53-aa9cc1be9719",
                                "sense_id": "d84ddf42-5dc2-34c3-a643-482854e4713a",
                                "text": "Depuis cinq ans, le disque vinyle est ainsi devenu l’un des rarissimes cas de technologie obsolète réapparue dans les habitudes de consommation."
                            },
                            {
                                "example_id": "6e4445a8-d054-435d-9ea4-0a80b49850db",
                                "sense_id": "d84ddf42-5dc2-34c3-a643-482854e4713a",
                                "text": "Il est rarissime qu’un ministre ne possède aucun portefeuille."
                            }
                        ]
                    }
                ],
