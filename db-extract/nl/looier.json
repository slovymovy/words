                                            "Beruf"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "035cccba-8772-4fd3-9ec2-e8647b60a87f",
                                                "sense_id": "d30790ce-0732-3693-8ad3-6ce2cbf321ba",
                                                "text": "Obwohl der Gerber tagtäglich Felle gerbt, wurde ihm abends nach dem Kneipenbesuch auch das seinige gegerbt."
                                            }
                                        ],
