                            {
                                "example_id": "dc5b0762-49de-4ae4-8226-7e4f45ed428a",
                                "sense_id": "30109a2a-9b3d-3c1c-920c-e0883032a275",
                                "text": "Het Damrak kreeg nog een aantal bedrijfsresultaten te verwerken. Zo boekte de uitbater van skihallen SnowWorld in de eerste zes maanden van het jaar een winststijging van bijna 12 procent. Het aandeel sloot 8,9 procent hoger. Verder kwamen softwarebedrijf Tie Kinetix (min 8,7 procent) en biotechnologiebedrijf Pharming (min 3,3 procent) met handelsberichten naar buiten."
                            },
                            {
                                "example_id": "a517e1bf-a59f-43dd-9155-f2e1b9e7125f",
                                "sense_id": "30109a2a-9b3d-3c1c-920c-e0883032a275",
                                "text": "IAG ging er tot dusver vanuit dat de operationele winst dit jaar net zo sterk zou toenemen als in 2015, mede dankzij nog lagere brandstofkosten. Op die prognose komt het bedrijf nu terug, hoewel het nog wel een aanzienlijke winststijging voorziet."
                            }
                        ]
