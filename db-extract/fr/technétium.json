        "de-extract.jsonl": [
            {
                "entry_id": "7bde07b3-bc23-3d8c-bd40-a7b01e5682a7",
                "word": "technétium",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "55509b5b-5734-3ae9-876c-dc502e53aacb",
                        "entry_id": "7bde07b3-bc23-3d8c-bd40-a7b01e5682a7",
                        "glosses": [
                            "Technetium"
                        ],
                        "tags": [],
