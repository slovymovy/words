                    }
                ],
                "senses": [
                    {
                        "sense_id": "2170ba8a-3825-3e5d-8aae-27b7a45e2a82",
                        "entry_id": "21d860de-40bf-338a-b172-44fc15d70fd4",
                        "glosses": [
                            "aufgrund eines übermäßigen Zustroms von Informationen dazu unfähig, klar zu denken; durcheinander"
                        ],
                        "tags": [
                            "bayerisch"
                        ],
                        "examples": [
                            {
                                "example_id": "14ade752-9461-4263-8915-d1f0add063f7",
                                "sense_id": "2170ba8a-3825-3e5d-8aae-27b7a45e2a82",
                                "text": "„Dieses Hühnerklein macht mich hirnwirblig.“"
                            },
                            {
                                "example_id": "4cab95a5-ae4c-4a3c-a4da-525775848df0",
                                "sense_id": "2170ba8a-3825-3e5d-8aae-27b7a45e2a82",
                                "text": "Von diesen vielen Angaben wird man ja ganz hirnwirblig!"
                            },
                            {
                                "example_id": "3c0197fe-daa7-4b75-bddc-194c239ebad2",
                                "sense_id": "2170ba8a-3825-3e5d-8aae-27b7a45e2a82",
                                "text": "„Behielt ich ihn bei diesem hirnwirbligen Gerenne über dem Arm?“"
                            },
                            {
                                "example_id": "667eed50-20ce-40f9-b978-e13cd958e974",
                                "sense_id": "2170ba8a-3825-3e5d-8aae-27b7a45e2a82",
                                "text": "„Um jetzt nicht komplett hirnwirblig zu werden hat er sich nach Alternativen umgesehen, und den aufblasbaren Weihnachtsbaum entdeckt.“"
                            },
                            {
                                "example_id": "5f0e496c-5c3f-4163-997e-bf58b371fd30",
                                "sense_id": "2170ba8a-3825-3e5d-8aae-27b7a45e2a82",
                                "text": "„‚Du machst mich ganz hirnwirblig‘, schimpft John Hribar in Memminger Dialekt, ‚ich brauche meine Nerven noch!‘ Jetzt lässt er die Faust auf den Tisch sausen.“"
                            },
                            {
                                "example_id": "3586ff88-6257-4002-8d4f-c0b9dd8bb40d",
                                "sense_id": "2170ba8a-3825-3e5d-8aae-27b7a45e2a82",
                                "text": "„Jeder Stoß ein Franzos, jeder Schuß ein Ruß, jeder Tritt ein Britt! so war es ja auch – eine hirnwirblige Kriegspropaganda – auf die Waggons der durch den Neu-Ulmer Bahnhof donnernden Truppentransporte aufgepinselt.“"
                            }
                        ],
