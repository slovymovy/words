{
    "word_family": [
        "quaintly",
        "quaintness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "35171947-86df-3d1a-aa46-031e539d52fe",
                    "sense_definition": "Pleasingly unusual, especially having an old-fashioned charm.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "charming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We spent our vacation exploring <w>quaint</w> little villages along the coast.",
                            "target_lang_translations": {
                                "it": "Abbiamo trascorso le vacanze esplorando <w>pittoreschi</w> paesini lungo la costa."
                            }
                        },
                        {
                            "text": "The <w>quaint</w> old-fashioned politeness of the staff made our stay very special.",
                            "target_lang_translations": {
                                "it": "La <w>caratteristica</w> cortesia d'altri tempi del personale ha reso il nostro soggiorno davvero speciale."
                            }
                        }
                    ],
                    "synonyms": [
                        "charming",
                        "picturesque"
                    ],
                    "antonyms": [
                        "modern",
                        "ordinary"
                    ],
                    "common_phrases": [
                        "quaint village",
                        "quaint charm"
                    ],
                    "target_lang_definitions": {
                        "it": "Piacevolmente insolito, specialmente se dotato di un fascino d'altri tempi."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "pittoresco",
                                "target_lang_sense_clarification": "Che suscita interesse per la sua originalità o particolarità estetica."
                            },
                            {
                                "target_lang_word": "caratteristico",
                                "target_lang_sense_clarification": "Che possiede qualità tipiche e distintive, spesso riferito a luoghi."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a0401fb7-5bdf-312a-9ea8-008350b60666",
                    "sense_definition": "Strange, odd, or unusual.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "unusual",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He had a <w>quaint</w> habit of talking to his plants every morning.",
                            "target_lang_translations": {
                                "it": "Aveva la <w>bizzarra</w> abitudine di parlare alle sue piante ogni mattina."
                            }
                        },
                        {
                            "text": "The book is filled with <w>quaint</w> stories from a bygone era.",
                            "target_lang_translations": {
                                "it": "Il libro è pieno di <w>curiose</w> storie di un'epoca passata."
                            }
                        }
                    ],
                    "synonyms": [
                        "peculiar",
                        "eccentric"
                    ],
                    "antonyms": [
                        "normal",
                        "conventional"
                    ],
                    "common_phrases": [
                        "quaint habit"
                    ],
                    "target_lang_definitions": {
                        "it": "Strano, bizzarro o insolito."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "bizzarro",
                                "target_lang_sense_clarification": "Che presenta tratti originali, stravaganti o fuori dal comune."
                            },
                            {
                                "target_lang_word": "curioso",
                                "target_lang_sense_clarification": "Che suscita perplessità o interesse perché insolito."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f8601bb7-d7f0-3f33-8c85-4e0b03c57cde",
                    "sense_definition": "Cleverly made or artfully contrived.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "clever",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artisan created a <w>quaint</w> device to open the heavy gate.",
                            "target_lang_translations": {
                                "it": "L'artigiano ha creato un <w>ingegnoso</w> dispositivo per aprire il pesante cancello."
                            }
                        },
                        {
                            "text": "She designed a <w>quaint</w> mechanism that solved the puzzle instantly.",
                            "target_lang_translations": {
                                "it": "Ha progettato un <w>ingegnoso</w> meccanismo che ha risolto l'enigma all'istante."
                            }
                        }
                    ],
                    "synonyms": [
                        "ingenious",
                        "clever"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This sense is largely archaic."
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Realizzato in modo ingegnoso o abilmente architettato."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "ingegnoso",
                                "target_lang_sense_clarification": "Che denota inventiva e abilità nella creazione."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "abc92251-601a-3fb9-8ebf-2155cbc810af",
                    "sense_definition": "Overly discriminating, fastidious, or prim.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "fastidious",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His <w>quaint</w> insistence on perfect etiquette made others feel uncomfortable.",
                            "target_lang_translations": {
                                "it": "La sua <w>schizzinosa</w> insistenza per un'etichetta perfetta metteva gli altri a disagio."
                            }
                        },
                        {
                            "text": "She was too <w>quaint</w> to enjoy the messy, informal party.",
                            "target_lang_translations": {
                                "it": "Era troppo <w>formale</w> per godersi la festa disordinata e informale."
                            }
                        }
                    ],
                    "synonyms": [
                        "fastidious",
                        "prim"
                    ],
                    "antonyms": [
                        "easygoing"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This sense is largely archaic."
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Eccessivamente esigente, schizzinoso o formale."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "schizzinoso",
                                "target_lang_sense_clarification": "Che mostra un'eccessiva selettività o pignoleria."
                            },
                            {
                                "target_lang_word": "formale",
                                "target_lang_sense_clarification": "Che segue rigidamente le convenzioni sociali."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6c94d52d-5f08-392c-88bb-ea23589a0105",
                    "sense_definition": "Cunning or crafty.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "cunning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>quaint</w> politician manipulated the crowd with ease.",
                            "target_lang_translations": {
                                "it": "L'<w>astuto</w> politico manipolava la folla con facilità."
                            }
                        },
                        {
                            "text": "He was a <w>quaint</w> fellow who always had a hidden agenda.",
                            "target_lang_translations": {
                                "it": "Era un tipo <w>scaltro</w> che aveva sempre un secondo fine."
                            }
                        }
                    ],
                    "synonyms": [
                        "cunning",
                        "crafty"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This sense is obsolete."
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Astuto o scaltro."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "astuto",
                                "target_lang_sense_clarification": "Capace di agire con scaltrezza per ottenere un vantaggio."
                            },
                            {
                                "target_lang_word": "scaltro",
                                "target_lang_sense_clarification": "Che dimostra prontezza e malizia nel comportamento."
                            }
                        ]
                    }
                }
            ]
        },
