                                        "glosses": [
                                            "scherenloser Krebs aus der Familie Palinuridae"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fedba8e1-4540-4474-8768-629eaccdc4fc",
                                                "sense_id": "12b56ce4-6a7f-30ec-bc50-33e96a4a3f74",
                                                "text": "Einige Langusten sind beliebte Speisekrebse."
                                            },
                                            {
                                                "example_id": "1f7157e2-c9de-43fb-aa73-f9edee727064",
                                                "sense_id": "12b56ce4-6a7f-30ec-bc50-33e96a4a3f74",
                                                "text": "„Auf dem Tisch stand eine Silberplatte mit zwei halben Langusten und eine Flasche Champagne nature in einem Kühler.“"
