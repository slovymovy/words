                    {
                        "sense_id": "020d3082-0a23-3c84-893a-5bc7e4b10bf3",
                        "entry_id": "f0372466-0d85-338a-9d82-e648095ee7ce",
                        "glosses": [
                            "Ouvrier qui tresse les cannes pour chaises et, plus généralement, qui confectionne les cannages d’ameublement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9754ce21-652f-4e95-9c6c-e8ce8496fd17",
                                "sense_id": "020d3082-0a23-3c84-893a-5bc7e4b10bf3",
                                "text": "[…] ;enfin, il tourna dans les ruelles dont les étrangers disent tant de mal, dans ces ruelles qui ne bouillonnent pas, où l’on ne trouvait que de loin en loin la boutique d’un barbier avec des lys dessinés au-dessus des portes, ou celle d’un chapelier, qui faisait sortir hors de ses portes à lui le chapeau à longs bords d’un cardinal, ou celle d’un canneur de chaises, qui les cannait là, dans la rue."
                            },
                            {
                                "example_id": "c2ecc4db-9d23-46bb-9770-2b66916543a4",
                                "sense_id": "020d3082-0a23-3c84-893a-5bc7e4b10bf3",
                                "text": "Amédée exerçait l’activité de canneur et rempailleur de chaises."
                            }
                        ]
                    }
