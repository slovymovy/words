                "senses": [
                    {
                        "sense_id": "1f9c6b06-4135-3c97-aa7a-b896c27f03f7",
                        "entry_id": "8e914bf9-ddfa-3ae6-9ef6-0f86546189ba",
                        "glosses": [
                            "endearing diminutive of весёлый (vesjólyj, “cheerful, merry; funny”)"
                        ],
                        "tags": [
                            "colloquial",
                            "diminutive",
                            "endearing",
                            "form-of",
                            "no-comparative"
                        ],
                        "examples": [
                            {
                                "example_id": "176576b2-9db4-4579-83bf-be3087884ccc",
                                "sense_id": "1f9c6b06-4135-3c97-aa7a-b896c27f03f7",
                                "text": "А вот куда́ э́то вы у́тром ходи́ли сего́дня, Варва́ра Алексе́евна? Я ещё и в до́лжность не сбира́лся, а вы, уж по́длинно как пта́шка весе́нняя, порхну́ли из ко́мнаты и по двору́ прошли́ така́я весёленькая.",
                                "translation": "Oh, where were you going this morning, Varvara Alexyevna? Before I had begun to get ready for the office, you flew out of your room exactly like a bird of the air and crossed the yard, looking so gay.",
                                "english": "Oh, where were you going this morning, Varvara Alexyevna? Before I had begun to get ready for the office, you flew out of your room exactly like a bird of the air and crossed the yard, looking so gay."
                            }
                        ]
                    }
                ],
