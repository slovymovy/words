                "senses": [
                    {
                        "sense_id": "5f06a741-f26e-382a-85da-7f97d6c4083c",
                        "entry_id": "5fed528f-e2da-3cee-84fb-0b008cb4bdab",
                        "glosses": [
                            "Qui environne, qui est aux environs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6750fd15-11f7-4d41-b67e-d67f08c0bc93",
                                "sense_id": "5f06a741-f26e-382a-85da-7f97d6c4083c",
                                "text": "Au moment de partir, Jasper Hobson, du haut du cap Esquimau, porta un dernier regard sur la mer environnante."
                            },
                            {
                                "example_id": "f962302d-62d2-4cb8-89cd-146a05ce2acf",
                                "sense_id": "5f06a741-f26e-382a-85da-7f97d6c4083c",
                                "text": "Ivanhoé les suivit des yeux jusqu’à ce qu’ils eussent disparu sous les ombres de la forêt environnante, puis il rentra dans le couvent."
                            },
                            {
                                "example_id": "12ac9c97-bc81-485d-8277-521a7f0a2d2f",
                                "sense_id": "5f06a741-f26e-382a-85da-7f97d6c4083c",
                                "text": "Avant de le quitter, le capitaine Romiati alla explorer les campagnes environnantes et ne découvrit rien d'alarmant."
                            },
                            {
                                "example_id": "be60789b-4b3e-494a-a435-117bf1a37554",
                                "sense_id": "5f06a741-f26e-382a-85da-7f97d6c4083c",
                                "text": "Les habitants des villas et des pavillons environnants passèrent rapidement de la curiosité malveillante à l’agression."
                            }
                        ]
                    }
                ],
