                    {
                        "sense_id": "9f72fbf8-dfda-31a0-ba90-5fb288a98a46",
                        "entry_id": "e51e2fb8-760a-30e9-b8aa-434ab0270cdb",
                        "glosses": [
                            "Dinge, die gegessen werden können"
                        ],
                        "tags": [
                            "casual",
                            "humorous"
                        ],
                        "examples": [
                            {
                                "example_id": "c58fe84b-046c-42f3-9959-2a2b0c07b7a2",
                                "sense_id": "9f72fbf8-dfda-31a0-ba90-5fb288a98a46",
                                "text": "„Wie ein Hamster häufte er Fressalien auf Fressalien.“"
                            },
                            {
                                "example_id": "6fbfea2e-3176-469e-a82f-6bcf8750b3d3",
                                "sense_id": "9f72fbf8-dfda-31a0-ba90-5fb288a98a46",
                                "text": "„Die ganzen Fressalien kamen rausgeschossen und flogen mindestens ’n Meter weit aus ihrem Maul in ’n Dreck.“"
                            },
                            {
                                "example_id": "27d662ab-5bc4-4970-88c3-19c0033a1309",
                                "sense_id": "9f72fbf8-dfda-31a0-ba90-5fb288a98a46",
                                "text": "„Ich werfe einen Blick in die Luke drei: Sie ist so sauber, daß auf ihrem Boden ein Picknick veranstaltet werden könnte – ohne Plastikteller, die Fressalien könnten direkt auf den Boden gelegt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0fc38815-17a9-4c62-99ba-ca8dee420da5",
                        "source_entry_id": "e51e2fb8-760a-30e9-b8aa-434ab0270cdb",
                        "source_sense_id": "9f72fbf8-dfda-31a0-ba90-5fb288a98a46",
                        "source_sense_description": "Dinge, die gegessen werden können",
                        "target_lang_word": "chow",
                        "target_lang_code": "en",
