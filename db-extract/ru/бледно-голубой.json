                                ]
                            },
                            {
                                "target_word": "pale",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1f637383-7283-3203-9745-70cf7d46400f",
                                        "entry_id": "3a45eefa-d398-3530-96ee-593fd15c3c02",
                                        "glosses": [
                                            "To enclose with pales, or as if with pales; to encircle or encompass; to fence off."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09e43443-966c-4456-ab26-c1d3e8ae188e",
                                                "sense_id": "1f637383-7283-3203-9745-70cf7d46400f",
                                                "text": "[…] your iſle, which ſtands / As Neptunes Parke, ribb’d, and pal’d in / With Oakes vnſkaleable, and roaring Waters, / With Sands that will not bear your Enemies Boates, / But ſuck them vp to th’ Top-maſt."
                                            }
                                        ]
                                    }
                                ]
