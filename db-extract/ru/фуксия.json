                                    {
                                        "sense_id": "c9b0a212-4fb8-374f-9dab-62250bb1875c",
                                        "entry_id": "1717fbc4-f910-3ed3-a660-c6ec149bffa7",
                                        "glosses": [
                                            "A popular garden plant, of the genus Fuchsia, of the Onagraceae family, shrubs with red, pink or purple flowers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33163527-27e1-4ed9-a224-69ac803dd655",
                                                "sense_id": "c9b0a212-4fb8-374f-9dab-62250bb1875c",
                                                "text": "Drenched were the cold fuchsias, round pearls of dew lay on the flat nasturtium leaves"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f85d96b0-03c8-3268-8bc0-15520e4953d6",
                                        "entry_id": "1717fbc4-f910-3ed3-a660-c6ec149bffa7",
                                        "glosses": [
                                            "A purplish-red colour, the color of fuchsin, an aniline dye."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b109b4e5-a6a2-4989-86d5-da24f53eafa0",
                                                "sense_id": "f85d96b0-03c8-3268-8bc0-15520e4953d6",
                                                "text": "She tilted a hand topped with long rectangular nails in furious fuchsia towards her cheeks and fluttered the fingers, fanning."
                                            }
                                        ]
                                    }
