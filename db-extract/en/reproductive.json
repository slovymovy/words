                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e717e40d-5f02-4257-aa1d-f7c3590fee62",
                                                "sense_id": "44059931-1257-372d-9357-80cd9a2412cb",
                                                "text": "Cet ouvrage présente les connaissances actuelles sur l’écophysiologie du pois protéagineux : développement végétatif et reproducteur, croissance en condition non limitante, nutrition azotée."
                                            },
                                            {
                                                "example_id": "2b3f4fda-34f6-4236-af51-3b976a4caec3",
                                                "sense_id": "44059931-1257-372d-9357-80cd9a2412cb",
                                                "text": "Forces reproductrices."
                                            },
                                            {
                                                "example_id": "0f69cf08-ccea-4c55-9df8-5d3ca83c909d",
                                                "sense_id": "44059931-1257-372d-9357-80cd9a2412cb",
                                                "text": "Animal reproducteur."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "reproducteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "968b9f94-fd4c-37d9-84f3-65df9159dc65",
                                        "entry_id": "56dd892d-adf5-32d5-bdbc-d9b912bdac2e",
                                        "glosses": [
                                            "Animal qui est destiné à la reproduction."
                                        ],
                                        "tags": [
                                            "Élevage"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be160ec2-2d45-488f-824e-64aaec24788b",
                                                "sense_id": "968b9f94-fd4c-37d9-84f3-65df9159dc65",
                                                "text": "Entre 1912 et 1945, le reproducteur est vendu une fois les saillies achevées."
                                            },
                                            {
                                                "example_id": "aa1dcf37-42b7-458f-a497-59099fbed0d0",
                                                "sense_id": "968b9f94-fd4c-37d9-84f3-65df9159dc65",
                                                "text": "Les reproducteurs ont absolument besoin d'eau avant et pendant la ponte ; sans quoi la fécondation n'a pas lieu (et tous les œufs sont clairs)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f77ed3b2-3622-4ba3-a95c-ec02c47fba1a",
                        "source_entry_id": "486a4b90-4009-383e-a470-745f8ed9d347",
                        "source_sense_description": "of or relating to reproduction",
                        "target_lang_word": "reproduktiv",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "reproduktiv",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "de0fd275-7c82-328e-93e5-6c9512fd5a74",
                                        "entry_id": "4fc1e932-a5dd-338d-bbba-17779c33321d",
                                        "glosses": [
                                            "Nachkommen/Kinder schaffend, sich vermehrend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "989ab4df-de1c-4bd9-8c1b-1c2c13d9ad92",
                                                "sense_id": "de0fd275-7c82-328e-93e5-6c9512fd5a74",
                                                "text": "„Im Labor sind zwei Verfahren denkbar, um Lebewesen zu klonen: das therapeutische und das reproduktive Klonen.“"
                                            },
                                            {
                                                "example_id": "0b1fb679-eefd-43b2-85e1-196e52301560",
                                                "sense_id": "de0fd275-7c82-328e-93e5-6c9512fd5a74",
                                                "text": "„Beim reproduktiven Klonen entstehen ganze Lebewesen - wie das Klonschaf Dolly“"
                                            },
                                            {
                                                "example_id": "94a59ce5-ef9b-4b8f-89cf-c9fc643cbda0",
                                                "sense_id": "de0fd275-7c82-328e-93e5-6c9512fd5a74",
                                                "text": "„Sie ist braun, gestreift und höchst reproduktiv: Seit einigen Jahren vermehrt sich die Quagga-Muschel massiv im Bodensee und bereitet nicht nur Biologen Kopfzerbrechen.“"
                                            },
                                            {
                                                "example_id": "0b021c4e-1b16-456a-b90c-7a17822b6a41",
                                                "sense_id": "de0fd275-7c82-328e-93e5-6c9512fd5a74",
                                                "text": "„Die folgende „reproduktive Isolation“ führte nach Vermutung der Forscher schließlich am Ende der Eiszeit dazu, dass Canis dirus genetisch schlecht für die neuen Umweltbedingungen gerüstet war und ausstarb.“"
                                            },
                                            {
                                                "example_id": "e6a1eed0-ebc2-4a66-b3c6-eb7c6a474da8",
                                                "sense_id": "de0fd275-7c82-328e-93e5-6c9512fd5a74",
                                                "text": "„In der Schweiz befinden sich rund zwei Drittel der asylsuchenden Frauen im reproduktiven Alter.“"
                                            },
                                            {
                                                "example_id": "149fcad4-5b9c-40a7-9e75-70c3f2116082",
                                                "sense_id": "de0fd275-7c82-328e-93e5-6c9512fd5a74",
                                                "text": "„Die Anforderungen an den Verhütungsschutz ändern sich je nach Alter und Lebenssituation. Viele Frauen wechseln während ihrer reproduktiven Phase mehrfach die Methode.“"
                                            },
                                            {
                                                "example_id": "98e53511-8ed3-4937-becd-ccf7de0d4de4",
                                                "sense_id": "de0fd275-7c82-328e-93e5-6c9512fd5a74",
                                                "text": "„Indien hat die UNO-Deklaration von 1994 unterzeichnet, die sicherstellt, dass die reproduktiven Rechte der Menschen nicht eingeschränkt werden dürfen.“"
                                            },
                                            {
                                                "example_id": "72a56300-61ea-4760-8ef1-2522243ec117",
                                                "sense_id": "de0fd275-7c82-328e-93e5-6c9512fd5a74",
                                                "text": "„Doch vor allem in Osteuropa »gehen die Rückschritte in Sachen Frauenrechte und vor allem ihrer reproduktiven Rechte Hand in Hand mit Rückschritten in Sachen Rechtsstaatlichkeit und Demokratie«.“"
                                            },
                                            {
                                                "example_id": "cbca5013-adb1-46ef-8524-9c4a24c6c5b4",
                                                "sense_id": "de0fd275-7c82-328e-93e5-6c9512fd5a74",
                                                "text": "„Zwei Wochen nach der Abtreibungs-Entscheidung des Obersten Gerichtshofs hat US-Präsident Joe Biden ein Regierungsdekret unterzeichnet, um »die reproduktiven Rechte zu verteidigen und den Zugang zu sicheren und legalen Schwangerschaftsabbrüchen zu schützen«.“"
                                            },
                                            {
                                                "example_id": "8ce16da8-fcf5-478b-ba8f-7c1ca590cdbf",
                                                "sense_id": "de0fd275-7c82-328e-93e5-6c9512fd5a74",
                                                "text": "„Die Eizellenspende ist allen untersagt. Viele Paare reisen deshalb nach Spanien und nehmen hohe Kosten in Kauf. Ist das gerecht? Wie hoch sollen wir das Recht auf reproduktive Selbstbestimmung gewichten?“"
                                            },
                                            {
                                                "example_id": "9bec3d0e-43d1-4896-ba99-3cb14d59b9f6",
                                                "sense_id": "de0fd275-7c82-328e-93e5-6c9512fd5a74",
                                                "text": "„Die Rechnung ist eindeutig: Ein Kind erhöht die CO2-Bilanz seiner Eltern massiv. Doch kann man das Kinderhaben so aufrechnen? Reproduktive Freiheit ist immerhin ein Menschenrecht.“"
                                            },
                                            {
                                                "example_id": "72aff3ce-d804-4bd7-a349-44b10c7a838d",
                                                "sense_id": "de0fd275-7c82-328e-93e5-6c9512fd5a74",
                                                "text": "„Die Direktion für Entwicklung und Zusammenarbeit (Deza) gab 2013 rund 2,9 Milliarden Franken an Entwicklungshilfe aus. In den Bereich sexuelle und reproduktive Gesundheit flossen 69,2 Millionen – dazu gehört auch die freiwillige Familienplanung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "761cad28-ca8f-38b7-8088-dfcb52f35d87",
                                        "entry_id": "4fc1e932-a5dd-338d-bbba-17779c33321d",
                                        "glosses": [
                                            "etwas nachahmend, nachbildend, nachschaffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93a3d808-5c62-4551-91d6-73157d333273",
                                                "sense_id": "761cad28-ca8f-38b7-8088-dfcb52f35d87",
                                                "text": "„Einfache Probleme können in zweierlei Weise gelöst werden. Erstens durch die korrekte Anwendung bereits bekannter Lösungsstrategien, d.h. durch reproduktives Denken. Dies ist z.B. bei Schulaufgaben der Fall, die sofort bearbeitet werden können, wenn man die Hindernisse überwunden hat, welche die Problemlösung erschwert haben. Zweitens lassen sich Probleme durch produktives Denken lösen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
