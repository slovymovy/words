    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "a26d6434-d90d-3427-88af-92c089395eb0",
                "word": "liripoop",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "f94d0e2a-57c7-4e69-ba58-ed8ac2d97864",
                        "entry_id": "a26d6434-d90d-3427-88af-92c089395eb0",
                        "tags": [
                            "plural"
                        ],
                        "form": "liripoops"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "75271746-216f-3764-a478-91b3e5a47988",
                        "entry_id": "a26d6434-d90d-3427-88af-92c089395eb0",
                        "glosses": [
                            "A pendent part of the old clerical tippet."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "1e99ba6e-fe40-49cf-b415-1a5d79919809",
                                "sense_id": "75271746-216f-3764-a478-91b3e5a47988",
                                "text": "So, so, I have my lerrepoop already."
                            },
                            {
                                "example_id": "93a35c58-8d74-497a-a826-0a7f6ab7b7e5",
                                "sense_id": "75271746-216f-3764-a478-91b3e5a47988",
                                "text": "The hood and liripoop (the long tail or tippet of the hood) was worn by the laity of both sexes as well as by the clergy."
                            }
                        ]
                    },
                    {
                        "sense_id": "c5b80c8d-c217-381b-902f-b5a901a225b1",
                        "entry_id": "a26d6434-d90d-3427-88af-92c089395eb0",
                        "glosses": [
                            "A tippet; a scarf; worn also by doctors, learned men, etc."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "a6b291b3-0335-4ce8-969f-aef311eb6fc8",
                                "sense_id": "c5b80c8d-c217-381b-902f-b5a901a225b1",
                                "text": "MASTER Janotus , with his hair cut round as a dish, his Liripoop on his head , after the old fashion; and having sufficiently antidoted his stomach with kitchen-cordials, and holy water of the cellar, conveyed himself to the lodging of Gargantua, driving before him three red muzzled beadles, and dragging after him five or six artless masters, all thoroughly bedagled with the mire of the streets."
                            },
                            {
                                "example_id": "16547911-2c66-4b96-86e0-093a28f061f3",
                                "sense_id": "c5b80c8d-c217-381b-902f-b5a901a225b1",
                                "text": "Moreover, we forbid all the above persons to use beyond the College any mantles or liripoops of fine linen or woollen, except on the attack of some disease, or on leave obtained from the President or Vice-President, for urgent reason;"
                            },
                            {
                                "example_id": "bac05b98-2b4b-4524-bbe5-5880e1f97ea1",
                                "sense_id": "c5b80c8d-c217-381b-902f-b5a901a225b1",
                                "text": "Male head with bold face: it has a very peculiar hood, with liripoop."
                            },
                            {
                                "example_id": "fbe4eeac-6e69-478a-a767-a4a99fd58a86",
                                "sense_id": "c5b80c8d-c217-381b-902f-b5a901a225b1",
                                "text": "The liripoop lingers in the hat-band, and is used at funerals."
                            },
                            {
                                "example_id": "b242cdca-fda1-4a6f-842a-f0990fefbd94",
                                "sense_id": "c5b80c8d-c217-381b-902f-b5a901a225b1",
                                "text": "The garb of a Doctor of Divinity, as you know, consisteth of a large cope with a liripoop."
                            }
                        ]
                    },
                    {
                        "sense_id": "c4c268aa-2dbd-3fb2-bd8b-a7883b0915aa",
                        "entry_id": "a26d6434-d90d-3427-88af-92c089395eb0",
                        "glosses": [
                            "acuteness; smartness; knowledge."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "22d5063e-e91e-4394-b292-5217078bb922",
                                "sense_id": "c4c268aa-2dbd-3fb2-bd8b-a7883b0915aa",
                                "text": "Heere was a wily wench had her liripoop without book, she was not to seeke in her knackes and shifts: such are all women, each of them hath a cloke for the raine, and can bleare her husbands eies as she list."
                            },
                            {
                                "example_id": "c78040dd-3165-430f-b706-1c1b52a24d72",
                                "sense_id": "c4c268aa-2dbd-3fb2-bd8b-a7883b0915aa",
                                "text": "There's a girl who knows her lirripoop."
                            },
                            {
                                "example_id": "279215ec-078a-4bf0-8491-81622a233ba8",
                                "sense_id": "c4c268aa-2dbd-3fb2-bd8b-a7883b0915aa",
                                "text": "No, I'll be sworn she has her liripoop, too."
                            },
                            {
                                "example_id": "92523e97-6301-4a56-8a7d-2fca8a4c2409",
                                "sense_id": "c4c268aa-2dbd-3fb2-bd8b-a7883b0915aa",
                                "text": "I warrant you, sir, my mistress and I Have practised our liripoop together."
                            }
                        ]
                    },
                    {
                        "sense_id": "0b343ab5-e73e-3bf9-b4fa-49fdeec6a104",
                        "entry_id": "a26d6434-d90d-3427-88af-92c089395eb0",
                        "glosses": [
                            "One's proper business or prescribed role."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "55dc4320-3504-4159-9dcb-1515a7663e4b",
                                "sense_id": "0b343ab5-e73e-3bf9-b4fa-49fdeec6a104",
                                "text": "For seeing you make me your judge, I trow, I shall teach you both your liripoop to know."
                            },
                            {
                                "example_id": "581d86bd-2410-4344-bfd5-c5f9a8766531",
                                "sense_id": "0b343ab5-e73e-3bf9-b4fa-49fdeec6a104",
                                "text": "I will teach thee thy lyrripups."
                            },
                            {
                                "example_id": "6198fea8-a892-41f6-b5b6-1bfa606a6f55",
                                "sense_id": "0b343ab5-e73e-3bf9-b4fa-49fdeec6a104",
                                "text": "'I know my liripoop without coming here to learn it,' said Mandricard as the Duke began to move off."
                            },
                            {
                                "example_id": "feb3b72b-b914-476a-9cad-4d80a74f993b",
                                "sense_id": "0b343ab5-e73e-3bf9-b4fa-49fdeec6a104",
                                "text": "Dickens's own Mrs Lirriper is a stock character, but she breaks out of her mould and refuses to play her prescribed part—her 'liripoop'."
                            }
                        ]
                    },
                    {
                        "sense_id": "ed868cdb-0795-3796-a334-b4cb2bad11c1",
                        "entry_id": "a26d6434-d90d-3427-88af-92c089395eb0",
                        "glosses": [
                            "A silly person."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "1b842aa5-58c9-4351-b64a-7688f32d49f3",
                                "sense_id": "ed868cdb-0795-3796-a334-b4cb2bad11c1",
                                "text": "I thought I would ask him questions fast enough and directly enough to force from him a positive answer of “yes” or “no” —a thing which it is exceedingly difficult to obtain in the piney-woods—but I found he was no liripoop."
                            },
                            {
                                "example_id": "02aa61cd-d5bb-4392-a902-2df3abed29df",
                                "sense_id": "ed868cdb-0795-3796-a334-b4cb2bad11c1",
                                "text": "Jones, however, for his part, is sometimes equally inane in criticising Smith, who holds that millions of Germans have now been killed off, that the copper has all been melted down, and that the occupation of Warsaw is the last desperate resort of the Kaiser—or, rather, of \"the imperial gambler\", to use an effective and stylish expression among liripoops; for he derides Smith as an optimist—as if optimism signified a person who holds absurd or addle-headed opinions directly contrary to the clear truth."
                            },
                            {
                                "example_id": "ef523b0e-5730-440c-90e1-ee589ce4c86d",
                                "sense_id": "ed868cdb-0795-3796-a334-b4cb2bad11c1",
                                "text": "I want to discuss your rakshasa spouse, She's giving me fits, the liripoop souse."
                            },
                            {
                                "example_id": "e1d1af7e-b092-43ec-9c8a-cce2d2a82958",
                                "sense_id": "ed868cdb-0795-3796-a334-b4cb2bad11c1",
                                "text": "Brother Diego stared doltishly around the hall, ogling the rich trappings, and the monarchs dismissed him as the liripoop he was."
                            }
                        ]
                    }
                ],
