    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "1636259b-8743-3a89-bad6-d4b67306c249",
                    "sense_definition": "Испытывающий чувство неудовлетворённости от несбывшихся ожиданий или надежд.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "disappointment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он вернулся домой крайне <w>разочарованный</w> результатами собеседования.",
                            "target_lang_translations": {
                                "en": "He returned home extremely <w>disappointed</w> with the results of the interview."
                            }
                        },
                        {
                            "text": "Её <w>разочарованный</w> взгляд говорил о том, что праздник не удался.",
                            "target_lang_translations": {
                                "en": "Her <w>disappointed</w> look indicated that the party was not a success."
                            }
                        }
                    ],
                    "synonyms": [
                        "расстроенный",
                        "опечаленный"
                    ],
                    "antonyms": [
                        "очарованный",
                        "довольный",
                        "восхищённый"
                    ],
                    "common_phrases": [
                        "разочарованный взгляд",
                        "глубоко разочарованный"
                    ],
                    "target_lang_definitions": {
                        "en": "Feeling dissatisfied due to unfulfilled expectations or hopes."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "disappointed",
                                "target_lang_sense_clarification": "feeling let down or defeated of expectations"
                            },
                            {
                                "target_lang_word": "frustrated",
                                "target_lang_sense_clarification": "feeling annoyed or disappointed because of inability to achieve something"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cee157bb-ca27-31ba-b8c2-8b04f1827321",
                    "sense_definition": "Выражающий пессимизм, утрату веры в людей, жизнь или идеалы.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "disappointment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В его словах звучал <w>разочарованный</w> цинизм человека, повидавшего многое.",
                            "target_lang_translations": {
                                "en": "In his words sounded the <w>disillusioned</w> cynicism of a man who had seen a lot."
                            }
                        },
                        {
                            "text": "Она написала <w>разочарованное</w> письмо о несправедливости этого мира.",
                            "target_lang_translations": {
                                "en": "She wrote a <w>disillusioned</w> letter about the injustice of this world."
                            }
                        }
                    ],
                    "synonyms": [
                        "пессимистичный",
                        "скептический"
                    ],
                    "antonyms": [
                        "оптимистичный",
                        "воодушевлённый"
                    ],
                    "common_phrases": [
                        "разочарованный тон"
                    ],
                    "target_lang_definitions": {
                        "en": "Expressing pessimism, loss of faith in people, life, or ideals."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "disillusioned",
                                "target_lang_sense_clarification": "having lost faith or trust in something formerly regarded as good"
                            },
                            {
                                "target_lang_word": "disappointed",
                                "target_lang_sense_clarification": "expressing or indicating disappointment"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fcbeec10-957a-3566-82ae-fb82883bcb73",
                    "sense_definition": "Причастие прошедшего времени страдательного залога от глагола <w>разочаровать</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Зритель, <w>разочарованный</w> плохой игрой актёров, покинул зал до окончания спектакля.",
                            "target_lang_translations": {
                                "en": "The spectator, <w>disappointed</w> by the poor acting, left the hall before the end of the play."
                            }
                        },
                        {
                            "text": "Ученик, <w>разочарованный</w> низкой оценкой, решил заниматься усерднее.",
                            "target_lang_translations": {
                                "en": "The student, <w>disappointed</w> by the low grade, decided to study harder."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Past passive participle of the verb 'to disappoint'."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "disappointed",
                                "target_lang_sense_clarification": "past participle of disappoint"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}