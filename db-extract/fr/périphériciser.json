                "senses": [
                    {
                        "sense_id": "a96e7f64-5f5f-379b-b063-3d96e86ba796",
                        "entry_id": "d825d5f1-9fb6-3658-b0db-4896e3e357e3",
                        "glosses": [
                            "Donner un caractère périphérique à."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "afb3fa96-eee1-4f58-bd1e-e75a30df489e",
                                "sense_id": "a96e7f64-5f5f-379b-b063-3d96e86ba796",
                                "text": "C'est un mauvais service qui nous est rendu et, en tout cas, je constate qu'une fois de plus les régions de l'Ouest sont « périphéricisées », marginalisées."
                            },
                            {
                                "example_id": "429d6132-1f9c-459f-93bd-73fce7c9bff3",
                                "sense_id": "a96e7f64-5f5f-379b-b063-3d96e86ba796",
                                "text": "Très bien, c'est un point de vue, mais je ne vois pas l'apport pour la Bretagne, qui se retrouvera tout autant voire plus \"périphéricisé\" dans ce grand ensemble."
                            }
                        ]
                    }
