                                                "example_id": "570e0913-9c15-4efe-a787-e586a0cdfb52",
                                                "sense_id": "8df5d738-911e-3ebf-90ea-1ae1cc66ff1f",
                                                "text": "Celle-ci, fille d'un seigneur et grand bourgeois bakinois d’avant l’invasion soviétique, avait pris le plus largement ses distances avec les doctrines du Kremlin, ce qui confère à son œuvre une importance particulière."
                                            },
                                            {
                                                "example_id": "d0f9a443-3b6b-47ae-a2ac-96bbd45ba74b",
                                                "sense_id": "8df5d738-911e-3ebf-90ea-1ae1cc66ff1f",
                                                "text": "Habitué à supporter le soleil tropical, il avait découvert le désagrément d’exposer son crâne dégarni au vent frais de la presqu’île bakinoise."
                                            }
                                        ]
