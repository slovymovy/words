                    {
                        "translation_id": "9a9b8f4b-5994-4afc-ae10-7b648efa7a18",
                        "source_entry_id": "788d76b7-7ffd-3cfc-9c2a-ecbb7e1e5868",
                        "source_sense_id": "fd5da975-5f1e-35c6-af23-983e1adf965d",
                        "source_sense_description": "State or quality of being ancient",
                        "target_lang_word": "starożytność",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "starożytność",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "e2bb58ca-31b2-33de-889a-5c4268151f3b",
                                        "entry_id": "7f991c45-a7fd-3c8c-8b6b-c32281f05495",
                                        "glosses": [
                                            "okres dziejów najstarszych cywilizacji od około 4000 roku p.n.e. do schyłku V wieku n.e."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5bb3231f-851d-44f0-8495-896dac4150b7",
                                                "sense_id": "e2bb58ca-31b2-33de-889a-5c4268151f3b",
                                                "text": "Początek epoki starożytności historycy wyznaczają na 4000 a nawet 5000 lat p.n.e."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "6a7efdc9-1f98-3ec1-9908-a057ebf84116",
                                        "entry_id": "7f991c45-a7fd-3c8c-8b6b-c32281f05495",
                                        "glosses": [
                                            "dawne, zamierzchłe czasy"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "metaphoric"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2e74ee0-5068-441d-9dc5-8c8e14c70fb1",
                                                "sense_id": "6a7efdc9-1f98-3ec1-9908-a057ebf84116",
                                                "text": "O jakim ty zdarzeniu mówisz? Dla mnie to już starożytność."
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    },
                                    {
                                        "sense_id": "b3bb9e8f-cd33-348d-a0f0-ac50bcad0432",
                                        "entry_id": "7f991c45-a7fd-3c8c-8b6b-c32281f05495",
                                        "glosses": [
                                            "obiekt (artefakt) należący do kultury starożytnej lub zabytek z dawnych czasów"
                                        ],
                                        "tags": [
                                            "commonly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07fa85da-e9c9-4c56-b8f5-d90a3938d2c3",
                                                "sense_id": "b3bb9e8f-cd33-348d-a0f0-ac50bcad0432",
                                                "text": "Ów antykwariusz miał u siebie stare bibeloty, szkło i porcelanę, ale handlował też starożytnościami."
                                            }
                                        ],
                                        "sense_index_json": "\"1.3\""
                                    },
                                    {
                                        "sense_id": "fb4466d5-099e-377a-8838-530673b3a2f5",
                                        "entry_id": "7f991c45-a7fd-3c8c-8b6b-c32281f05495",
                                        "glosses": [
                                            "społeczeństwa, ludzie żyjący w epoce starożytnej"
                                        ],
                                        "tags": [
                                            "metaphoric"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f08fd7fc-4f74-47ab-9e40-49972d73bcf1",
                                                "sense_id": "fb4466d5-099e-377a-8838-530673b3a2f5",
                                                "text": "Na te choroby i plagi starożytność nie znała jeszcze leków ani rady."
                                            }
                                        ],
                                        "sense_index_json": "\"1.4\""
                                    },
                                    {
                                        "sense_id": "eccc9eb3-beae-3826-aea8-1f98e4f20b48",
                                        "entry_id": "7f991c45-a7fd-3c8c-8b6b-c32281f05495",
                                        "glosses": [
                                            "dawność istnienia czegoś"
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b98e116-9adf-40ba-9991-ef12e4f9b029",
                                                "sense_id": "eccc9eb3-beae-3826-aea8-1f98e4f20b48",
                                                "text": "Znajomy numizmatyk w pełni poświadczył starożytność tej monety."
                                            }
                                        ],
                                        "sense_index_json": "\"1.5\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0aabcdca-3afe-41db-9011-fb52db22e581",
                        "source_entry_id": "788d76b7-7ffd-3cfc-9c2a-ecbb7e1e5868",
                        "source_sense_id": "fd5da975-5f1e-35c6-af23-983e1adf965d",
                        "source_sense_description": "State or quality of being ancient",
                        "target_lang_word": "дре́вность",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "дре́вность",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "5d225490-0885-3135-a89e-b2d0c66f9de3",
                                        "entry_id": "62dfb6ff-8e33-308a-bfcf-d5aa1a290df2",
                                        "glosses": [
                                            "свойство по значению прилагательного древний"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4d3d231-e62e-4ced-9483-e60489268d36",
                                                "sense_id": "5d225490-0885-3135-a89e-b2d0c66f9de3",
                                                "text": "Древность дворянского рода."
                                            },
                                            {
                                                "example_id": "8317bfa6-1bf3-4b10-8f8c-49ec7128bdf2",
                                                "sense_id": "5d225490-0885-3135-a89e-b2d0c66f9de3",
                                                "text": "Древность рукописи."
                                            },
                                            {
                                                "example_id": "9f7347d0-4607-41f3-9014-de974acc5f8a",
                                                "sense_id": "5d225490-0885-3135-a89e-b2d0c66f9de3",
                                                "text": "[Вожак:] Пришибла её [старушку] старость, одолела её древность."
                                            },
                                            {
                                                "example_id": "7290df9a-a097-4d72-ba79-58cba006ad40",
                                                "sense_id": "5d225490-0885-3135-a89e-b2d0c66f9de3",
                                                "text": "[Маякин] очень любил ставить на вид древность своей породы."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bc4958b9-39d8-31af-8bad-78c7c56604a7",
                                        "entry_id": "62dfb6ff-8e33-308a-bfcf-d5aa1a290df2",
                                        "glosses": [
                                            "очень отдалённые, давние времена, далёкое прошлое"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35d11a6e-04ba-484c-ba55-3d00ae5ead7c",
                                                "sense_id": "bc4958b9-39d8-31af-8bad-78c7c56604a7",
                                                "text": "Седая древность."
                                            },
                                            {
                                                "example_id": "53205133-6d6d-49b2-a003-c580b2028c1f",
                                                "sense_id": "bc4958b9-39d8-31af-8bad-78c7c56604a7",
                                                "text": "В древности."
                                            },
                                            {
                                                "example_id": "ba315833-c04d-415c-80a3-cd8aedbe6910",
                                                "sense_id": "bc4958b9-39d8-31af-8bad-78c7c56604a7",
                                                "text": "Нет сомнений, что время постройки их [укреплений] относится к глубокой древности."
                                            },
                                            {
                                                "example_id": "1e634acb-d5b5-42c7-bfd4-4d646ba1fc47",
                                                "sense_id": "bc4958b9-39d8-31af-8bad-78c7c56604a7",
                                                "text": "— Местность наша от самой древности была безлесная и безводная."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fb2ba65c-45ac-3922-a3c8-16e85a04c168",
                                        "entry_id": "62dfb6ff-8e33-308a-bfcf-d5aa1a290df2",
                                        "glosses": [
                                            "древнегреческий и древнеримский мир, его культура"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f9d9421-f2fb-4fda-a950-8eadc000d55e",
                                                "sense_id": "fb2ba65c-45ac-3922-a3c8-16e85a04c168",
                                                "text": "Чем более читаю Тацита, тем более мирюсь с Тиберием. Он был один из величайших государственных умов древности."
                                            },
                                            {
                                                "example_id": "4991db46-dd93-4705-b6d4-818aab9607a9",
                                                "sense_id": "fb2ba65c-45ac-3922-a3c8-16e85a04c168",
                                                "text": "Идеи Аристотеля разделяла вся древность; с ним соглашались Цицерон и Сенека."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "704dfb07-5213-3533-9cb3-1c435a16d855",
                                        "entry_id": "62dfb6ff-8e33-308a-bfcf-d5aa1a290df2",
                                        "glosses": [
                                            "памятник далёкого прошлого"
                                        ],
                                        "tags": [
                                            "обычно мн. ч."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "047898f2-fc3e-4145-8ef3-12459a30554b",
                                                "sense_id": "704dfb07-5213-3533-9cb3-1c435a16d855",
                                                "text": "Москва гордится своими историческими древностями, памятниками, она — сама историческая древность."
                                            },
                                            {
                                                "example_id": "498cf534-cc8d-46c8-9b99-eab879f59e06",
                                                "sense_id": "704dfb07-5213-3533-9cb3-1c435a16d855",
                                                "text": "Музей древностей."
                                            },
                                            {
                                                "example_id": "43ac07d4-2e5f-4415-a658-a48d2cbf7ad3",
                                                "sense_id": "704dfb07-5213-3533-9cb3-1c435a16d855",
                                                "text": "[В Британском музеуме] мы целое утро осматривали ниневийские древности."
                                            },
                                            {
                                                "example_id": "2a3b1113-280f-4324-8e96-24a6cf0758d4",
                                                "sense_id": "704dfb07-5213-3533-9cb3-1c435a16d855",
                                                "text": "Он заходил иногда к антиквариям и с видом знатока осматривал древности […], покупал какую-нибудь вещь."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
