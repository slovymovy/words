                                "target_senses": [
                                    {
                                        "sense_id": "99ac5a41-63e3-3c60-ae6b-95c437d32d2e",
                                        "entry_id": "2df99cb8-22b3-35ce-b19a-c14dc65a0013",
                                        "glosses": [
                                            "The organ of hearing, consisting of the pinna or auricle, auditory canal, eardrum, malleus, incus, stapes and cochlea."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f043f907-cf59-3717-a95c-4d75a6eda6b4",
                                        "entry_id": "2df99cb8-22b3-35ce-b19a-c14dc65a0013",
                                        "glosses": [
                                            "The external part of the organ of hearing, the auricle."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "913edcc2-61a7-4ee6-8006-c170a8c19c35",
                                                "sense_id": "f043f907-cf59-3717-a95c-4d75a6eda6b4",
                                                "text": "Judge Short had gone to town, and Farrar was off for a three days' cruise up the lake. I was bitterly regretting I had not gone with him when the distant notes of a coach horn reached my ear, and I descried a four-in-hand winding its way up the inn road from the direction of Mohair."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "038cf5fc-3639-37c5-b34b-dddd8cb69da8",
                                        "entry_id": "2df99cb8-22b3-35ce-b19a-c14dc65a0013",
                                        "glosses": [
                                            "A police informant."
                                        ],
                                        "tags": [
                                            "countable",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "98f7e259-eab4-4776-aa18-628818be12cc",
                                                "sense_id": "038cf5fc-3639-37c5-b34b-dddd8cb69da8",
                                                "text": "No I'm not kidding, and if you don't give it to me I'll let it out that you’re an ear."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "915602ea-66f0-3fdd-acde-6974eb035cc9",
                                        "entry_id": "2df99cb8-22b3-35ce-b19a-c14dc65a0013",
                                        "glosses": [
                                            "The sense of hearing; the perception of sounds; skill or good taste in listening to music."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0bd25960-e347-4e3d-966f-3fd01187283e",
                                                "sense_id": "915602ea-66f0-3fdd-acde-6974eb035cc9",
                                                "text": "a good ear for music"
                                            },
                                            {
                                                "example_id": "31fe86af-d76f-4ee7-881a-1b3aca42e22f",
                                                "sense_id": "915602ea-66f0-3fdd-acde-6974eb035cc9",
                                                "text": "songs[…]not all ungrateful to thine ear"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f02dc438-3474-3835-aa9d-bbddb561980a",
                                        "entry_id": "2df99cb8-22b3-35ce-b19a-c14dc65a0013",
                                        "glosses": [
                                            "The privilege of being kindly heard; favour; attention."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "638570b4-5de6-4b46-bde6-d8498e0e03b9",
                                                "sense_id": "f02dc438-3474-3835-aa9d-bbddb561980a",
                                                "text": "Dionysius[…]would give no ear to his suit."
                                            },
                                            {
                                                "example_id": "36255024-df68-4ac1-9c8f-b4867834db3c",
                                                "sense_id": "f02dc438-3474-3835-aa9d-bbddb561980a",
                                                "text": "Friends, Romans, countrymen, lend me your ears."
                                            },
                                            {
                                                "example_id": "fedfed84-ebf5-4150-8a47-2db79f3d598b",
                                                "sense_id": "f02dc438-3474-3835-aa9d-bbddb561980a",
                                                "text": "They don’t know if they’re going to have a job in a week or a month. They don’t know if they can pay the rising prices. Instead of the paradise they expected July 1, their total existence is unsure. That some foreigners get beaten—nobody has an ear for that now."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "12509da6-dc01-34e1-8c7d-a74d857d608d",
                                        "entry_id": "2df99cb8-22b3-35ce-b19a-c14dc65a0013",
                                        "glosses": [
                                            "That which resembles in shape or position the ear of an animal; a prominence or projection on an object, usually for support or attachment; a lug; a handle; a foot-rest or step of a spade or a similar digging tool."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6d66489-9424-4087-88d3-28c661cfedde",
                                                "sense_id": "12509da6-dc01-34e1-8c7d-a74d857d608d",
                                                "text": "the ears of a tub, skillet, or dish; The ears of a boat are outside kneepieces near the bow."
                                            },
                                            {
                                                "example_id": "41ecc17f-92af-4656-b173-4823083b200a",
                                                "sense_id": "12509da6-dc01-34e1-8c7d-a74d857d608d",
                                                "text": "When they got as far as the little valley north of Oppenhagen - where the land-slip took place - he thought he sat between the ears of a bucket; but shortly this vanished also, and it was only then he really came to himself again."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8a0ccaf4-7d91-3068-bf48-5210402f5bc8",
                                        "entry_id": "2df99cb8-22b3-35ce-b19a-c14dc65a0013",
                                        "glosses": [
                                            "An acroterium."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "548ece3f-beac-3346-945e-bc307a1332fe",
                                        "entry_id": "2df99cb8-22b3-35ce-b19a-c14dc65a0013",
                                        "glosses": [
                                            "A crossette."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fedf41d4-755d-3770-b3ca-b045ddd0be3d",
                                        "entry_id": "2df99cb8-22b3-35ce-b19a-c14dc65a0013",
                                        "glosses": [
                                            "A space to the left or right of a publication's front-page title, used for advertising, weather, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28111fd3-4ff8-4170-a882-6df29248266d",
                                                "sense_id": "fedf41d4-755d-3770-b3ca-b045ddd0be3d",
                                                "text": "In journalism, ears flank the title as boxes in the left and right top corners of a publication (generally a newspaper)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e14ffabe-9a97-3d50-a51e-aefb06f8779f",
                                        "entry_id": "2df99cb8-22b3-35ce-b19a-c14dc65a0013",
                                        "glosses": [
                                            "A curled ridge in the crust of a loaf of bread where the dough was slashed before going into the oven and expands during baking."
                                        ],
