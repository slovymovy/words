                                "target_senses": [
                                    {
                                        "sense_id": "1c2e7d67-5691-37ef-918d-8db9d5a60f7c",
                                        "entry_id": "bddba5cf-c43a-3fae-9c33-fc826469723f",
                                        "glosses": [
                                            "Cahier sur lequel l’élève fait d’abord ses exercices et travaux écrits avant de les recopier au propre sur un autre support."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da9805df-48a3-405c-b945-21e5dae11c5d",
                                                "sense_id": "1c2e7d67-5691-37ef-918d-8db9d5a60f7c",
                                                "text": "Chaque élève qui suivra un cours devra avoir un cahier de papier blanc, dit cahier de brouillon, et deux cahiers de papier de musique …."
                                            },
                                            {
                                                "example_id": "bb330094-3a60-41a6-ac26-99e63ce8640d",
                                                "sense_id": "1c2e7d67-5691-37ef-918d-8db9d5a60f7c",
                                                "text": "Le cahier de brouillon est celui sur lequel les enfants rédigent la minute de tous les devoirs. Il est écrit au courant de la plume ; …."
                                            },
                                            {
                                                "example_id": "56c494b4-eaec-4215-a8ae-ceb298ecec1a",
                                                "sense_id": "1c2e7d67-5691-37ef-918d-8db9d5a60f7c",
                                                "text": "Chaque enfant devrait écrire, plusieurs fois, chacun de ces mots sur un cahier de brouillon, puis il y aurait un cahier au net qui serait gardé par les enfants."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
