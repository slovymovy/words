                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b2facbe-7fbf-45bd-9de7-10f7f4e6080f",
                                "sense_id": "a483d937-5981-3cb8-98a9-02b893f44be9",
                                "text": "D’un sourire, ils s’indiquent l’un à l’autre une hérissonne suivie par la file de ses nouveau-nés."
                            },
                            {
                                "example_id": "31bbe110-d81e-4cab-9d11-1049fb30bd50",
                                "sense_id": "a483d937-5981-3cb8-98a9-02b893f44be9",
                                "text": "Après quelques heures de sommeil, la hérissonne ouvre les yeux et lui sourit."
                            }
                        ]
                    },
                    {
                        "sense_id": "9927fd9b-3f4f-3448-b03c-db722e3ac47d",
                        "entry_id": "8e08ef81-6abe-389b-81fe-1275b5b2851e",
                        "glosses": [
                            "Variété de chenille."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb67c40a-d9f3-4a12-9b5d-54eb6553ba15",
                                "sense_id": "9927fd9b-3f4f-3448-b03c-db722e3ac47d",
                                "text": "HÉRISSONNE ou MARTE. (Entom.) Espèce de chenille du bombyce que nous avons décrit."
                            }
                        ]
                    },
                    {
                        "sense_id": "0ce35e30-c955-319c-a1e1-b530ef4d3cc7",
                        "entry_id": "8e08ef81-6abe-389b-81fe-1275b5b2851e",
                        "glosses": [
                            "Variété de fruit ou légume portant des pics."
                        ],
                        "tags": [],
                        "examples": [
