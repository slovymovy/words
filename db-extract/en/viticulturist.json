                        "sense_id": "843a3d9f-bad7-3260-bef5-c5bbe69d7f81",
                        "entry_id": "fcc27944-f0a4-3e4e-93a6-61c7469b5b7a",
                        "glosses": [
                            "A person who grows grapevines."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "554c7e54-3cc7-46ba-981f-90cc535470c2",
                        "source_entry_id": "fcc27944-f0a4-3e4e-93a6-61c7469b5b7a",
                        "source_sense_id": "843a3d9f-bad7-3260-bef5-c5bbe69d7f81",
                        "source_sense_description": "person who grows grapes",
                        "target_lang_word": "vigneron",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vigneron",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "eca4bc9d-8aec-3ed9-a6d1-d53f593928ad",
                                        "entry_id": "52c14fa4-d442-3d79-9f98-1c94fb0b3244",
                                        "glosses": [
                                            "Relatif aux viticulteurs, aux vignobles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df439fc0-6106-40eb-8288-a1abcdec3169",
                                                "sense_id": "eca4bc9d-8aec-3ed9-a6d1-d53f593928ad",
                                                "text": "Quoi qu’il en soit, on peut imaginer que le désastre phylloxérique mit subitement en présence des plus dures nécessités toute une population vigneronne qui avait jusque-là vécu insouciante sur ses coteaux."
                                            },
                                            {
                                                "example_id": "2070798e-a80d-4c80-b188-949007d6fedd",
                                                "sense_id": "eca4bc9d-8aec-3ed9-a6d1-d53f593928ad",
                                                "text": "Celui-ci repose en grande partie sur la cotisation de l’ensemble de la communauté vigneronne."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "vigneron",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "09a8ba1c-0728-3cfd-aaaa-d7e20dc7fd65",
                                        "entry_id": "47821a57-0bf6-3748-a096-c08151e3f5c4",
                                        "glosses": [
                                            "Celui qui cultive la vigne pour en faire du vin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea113310-bf7d-4a83-8fab-ddca8142332c",
                                                "sense_id": "09a8ba1c-0728-3cfd-aaaa-d7e20dc7fd65",
                                                "text": "Il travaillait déjà à la création d’une grande compagnie financière, le Crédit viticole, une caisse de prêt pour les vignerons."
                                            },
                                            {
                                                "example_id": "dca20902-4a24-45dc-9caa-1d70a66b8307",
                                                "sense_id": "09a8ba1c-0728-3cfd-aaaa-d7e20dc7fd65",
                                                "text": "Or, non loin des figuiers, les fils de Bélial\nFrappent le vigneron avec de lourdes pierres ;\nLa cervelle et le sang souillent ce lieu fatal."
                                            },
                                            {
                                                "example_id": "67219ddc-956c-4e41-afbd-e0edb4234329",
                                                "sense_id": "09a8ba1c-0728-3cfd-aaaa-d7e20dc7fd65",
                                                "text": "Il y avait là des vignerons facilement reconnaissables à leur blouse de toile grise, attachée au cou par une agrafe de cuivre."
                                            },
                                            {
                                                "example_id": "b3ec4753-50ed-45e9-b20c-65861e2279d0",
                                                "sense_id": "09a8ba1c-0728-3cfd-aaaa-d7e20dc7fd65",
                                                "text": "Des coteaux d’Arbois, de Poligny et de Salins, descendait, chaque automne, avec les cuves pleines, le beau vin couleur peau d’oignon, jailli des grappes de poulsard, et les vignerons à rouge trogne bénissaient le Seigneur dont le bon soleil gorgeait de vie les pampres vigoureux et emplissait leurs futailles."
                                            },
                                            {
                                                "example_id": "b7904d2b-8bef-402d-880c-7412a3a6c55e",
                                                "sense_id": "09a8ba1c-0728-3cfd-aaaa-d7e20dc7fd65",
                                                "text": "Salut à toi, puisque tu as le succès, puisque tu fais de tes vignerons des multimillionnaires, ô Hérault rouge, ô Hérault vainqueur, source intarissable du vin populaire, métropole de ce pinard démocratique, devenu indispensable aux citoyens conscients, […]."
                                            },
                                            {
                                                "example_id": "6931c40a-d3d6-43ba-a285-a1ab6b8bdbad",
                                                "sense_id": "09a8ba1c-0728-3cfd-aaaa-d7e20dc7fd65",
                                                "text": "Et quand en 1840, notre vin de Moselle ne fut qu’un âpre verjus, nos vignerons, par dérision et par haine du Prussien, donnèrent sarcastiquement à ce vin imbuvable le sobriquet de : Hassenpflug."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b356fc84-9db9-319a-b050-de4debb8ac8d",
                                        "entry_id": "47821a57-0bf6-3748-a096-c08151e3f5c4",
                                        "glosses": [
                                            "Meuble représentant un personnage pratiquant le métier du même nom dans les armoiries. Il n’y a pas de représentation fixée mais il est généralement figuré accompagné d’un pied de vigne et d’un couteau de vigneron. À rapprocher de batteur en grange, bûcheron, faucheur, forgeron, meunier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a477ea0-e180-4980-b088-54b525efe483",
                                                "sense_id": "b356fc84-9db9-319a-b050-de4debb8ac8d",
                                                "text": "Tranché de sinople et d’or, le sinople chargé en chef d’une croisette d’argent et en pointe d’une rose d’or boutonnée de gueules, l’or entant le sinople en chevron et chargé d’un vigneron au naturel, qui est de la commune de Venise du Doubs"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "16fbc7cc-370f-4e18-b349-9f784969ee67",
                        "source_entry_id": "fcc27944-f0a4-3e4e-93a6-61c7469b5b7a",
                        "source_sense_id": "843a3d9f-bad7-3260-bef5-c5bbe69d7f81",
                        "source_sense_description": "person who grows grapes",
                        "target_lang_word": "vigneronne",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vigneronne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8b229420-8c9c-3678-833d-1b30aa5ecd27",
                                        "entry_id": "4a3df706-add4-3935-9af9-9a4aea4d0beb",
                                        "glosses": [
                                            "Femme qui cultive la vigne et vinifie, viticultrice."
                                        ],
                                        "tags": [
                                            "Viticulture"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "73d70d26-f3bd-4dd2-a2c0-74945c1f243d",
                                                "sense_id": "8b229420-8c9c-3678-833d-1b30aa5ecd27",
                                                "text": "« Dans le vin, les femmes ont quelque chose à apporter. Ce n’est pas toujours facile de se faire respecter dans ce milieu. Mais, de plus en plus, il y a des femmes vigneronnes dans le vin naturel. En France, en Italie, en Espagne. Elles font des vins différents, moins rustiques, plus sur la finesse… »"
                                            },
                                            {
                                                "example_id": "b36ba701-7d3e-4a74-86bc-5ec0f034b647",
                                                "sense_id": "8b229420-8c9c-3678-833d-1b30aa5ecd27",
                                                "text": "C’est désormais possible grâce à la campagne « Adopte ta vigne », lancée par Hélène Séguier, vigneronne et caviste toulousaine."
                                            },
                                            {
                                                "example_id": "0fba0614-03e5-472e-8064-b48a575d00e0",
                                                "sense_id": "8b229420-8c9c-3678-833d-1b30aa5ecd27",
                                                "text": "Le vin en conversion bio de Noémie Tanneau, vigneronne à Lussac Saint-Emilion, a été sélectionné pour être dégusté par le roi Charles III lors de sa visite à Bordeaux vendredi"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a7efed0-4b56-333f-8d91-327f10a74cfb",
                                        "entry_id": "4a3df706-add4-3935-9af9-9a4aea4d0beb",
                                        "glosses": [
                                            "Épouse d’un vigneron."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "vigneronne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0f2e5cac-e2b4-326a-9c54-247d9a2e2cf1",
                                        "entry_id": "54dd78bb-a640-302a-a417-4557db6ac4bc",
                                        "glosses": [
                                            "Féminin singulier de vigneron."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "45ce517a-caa4-47a8-bd17-357a541a582c",
                                                "sense_id": "0f2e5cac-e2b4-326a-9c54-247d9a2e2cf1",
                                                "text": "En juillet, Visan honore le vin au cours d’une fête haute en couleurs : portée en procession au son des galoubets et des tambourins, une souche enrubannée, ornée de pampres de vignes, est bénie puis symboliquement brûlée, puis, à coups de masse, le roi, la reine et le lieutenant de la confrérie vigneronne locale, élus du jour, cassent le « marot » (pan de mur, vestige du château), pour “désencaver” les magnums de la cuvée précédente, après une année de vieillissement."
                                            },
                                            {
                                                "example_id": "93066283-213d-4a0d-b4f1-4b1572460a34",
                                                "sense_id": "0f2e5cac-e2b4-326a-9c54-247d9a2e2cf1",
                                                "text": "La fondue vigneronne est une fondue où viande, fruits de mer et légumes sont trempés dans du vin blanc bouillant pour y être cuits avant d’être dégustés."
                                            },
                                            {
                                                "example_id": "27047513-fe1c-4253-9b5e-457cf27fb22b",
                                                "sense_id": "0f2e5cac-e2b4-326a-9c54-247d9a2e2cf1",
                                                "text": "La sauce vigneronne se prépare avec des échalotes finement hachées, du vin rouge, du vinaigre balsamique, des herbes de Provence, et de l’huile d’olive."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "698c3bdd-e701-4702-8873-b1d7de91d86c",
                        "source_entry_id": "fcc27944-f0a4-3e4e-93a6-61c7469b5b7a",
                        "source_sense_id": "843a3d9f-bad7-3260-bef5-c5bbe69d7f81",
                        "source_sense_description": "person who grows grapes",
                        "target_lang_word": "Weinbauer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Weinbauer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1ba962af-5ac6-35a3-a01c-ba8b253b1168",
                                        "entry_id": "92896e25-4f9a-3737-b708-5b78ee3c52a8",
                                        "glosses": [
                                            "Person, die Wein beruflich an- und ausbaut"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a64c782e-d51e-46f3-acb7-54f34c501dd5",
                                                "sense_id": "1ba962af-5ac6-35a3-a01c-ba8b253b1168",
                                                "text": "„Wilhelm Pfälzer war ein angesehener Weinbauer aus der Gegend, großgewachsen, um die Fünfzig, das schüttere Haar über die Glatze nach hinten gekämmt.“"
                                            },
                                            {
                                                "example_id": "82f6945d-d87c-4284-8d77-2c056047fac1",
                                                "sense_id": "1ba962af-5ac6-35a3-a01c-ba8b253b1168",
                                                "text": "„Blut und Wein - erst der Weinbauer dieses Landes ließ sie ganz zusammenfließen.“"
                                            },
                                            {
                                                "example_id": "ff287485-2cef-44ee-97d5-dc0a7b972784",
                                                "sense_id": "1ba962af-5ac6-35a3-a01c-ba8b253b1168",
                                                "text": "„Etwa 6000 Hektar wurden im 16. Jahrhundert von Weinbauern bewirtschaftet, und das Anbaugebiet erstreckte sich bis Wittenberg.“"
                                            },
                                            {
                                                "example_id": "d26c8210-21f8-4f7a-98ef-b3d36d67d4cc",
                                                "sense_id": "1ba962af-5ac6-35a3-a01c-ba8b253b1168",
                                                "text": "„Er sei eben »ein Franzos«, sagten einige in der Wirtschaft, wohlhabende Zecher und Weinbauern mit rot gedrechselten Nasen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fef48d15-f0c9-412f-a9b8-bfbe6af7bc70",
                        "source_entry_id": "fcc27944-f0a4-3e4e-93a6-61c7469b5b7a",
                        "source_sense_id": "843a3d9f-bad7-3260-bef5-c5bbe69d7f81",
