                "senses": [
                    {
                        "sense_id": "4ac01d2e-6c07-38be-90a1-ba90f0fd98a3",
                        "entry_id": "06953ca6-e26b-34f9-a167-0aa7ffad05ad",
                        "glosses": [
                            "Stelle im Sprechtrakt oder Bereich der Zunge, wo ein Laut gebildet wird"
                        ],
                        "tags": [
                            "Phonetik"
                        ],
                        "examples": [
                            {
                                "example_id": "011393e2-0522-4bb9-9c2d-2d3f34add783",
                                "sense_id": "4ac01d2e-6c07-38be-90a1-ba90f0fd98a3",
                                "text": "Der Artikulationsort der Laute [b], [m] und [p] ist bilabial."
                            },
                            {
                                "example_id": "e0479b8e-264a-44af-a946-b1ea83c7a9bd",
                                "sense_id": "4ac01d2e-6c07-38be-90a1-ba90f0fd98a3",
                                "text": "„Grundlegend für die Eigenschaften eines Lautes sind dessen Artikulationsart und dessen Artikulationsort (-stelle).“"
                            },
                            {
                                "example_id": "a4e36c72-dd7c-4806-a5ac-c7d4fc14feef",
                                "sense_id": "4ac01d2e-6c07-38be-90a1-ba90f0fd98a3",
                                "text": "„Die phonetische Klassifikation von Lauten bezieht sich insbesondere auf Artikulationsort und Artikulationsweise.“"
                            },
                            {
                                "example_id": "1858c2ed-1366-48d1-a0f2-cccee1034231",
                                "sense_id": "4ac01d2e-6c07-38be-90a1-ba90f0fd98a3",
                                "text": "„Der nachfolgende Konsonant wird also entsprechend des Artikulationsortes und der -art variiert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
