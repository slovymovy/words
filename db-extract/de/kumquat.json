                        "source_entry_id": "6e2819f1-f372-37bc-9574-ccf7690f7133",
                        "source_sense_id": "c56d2824-ab3d-3c63-b55f-58f960b5d28b",
                        "source_sense_description": "Gattung in der Familie der Rautengewächse",
                        "target_lang_word": "kumquat",
                        "target_lang_code": "fr",
