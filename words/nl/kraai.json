                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>kraai</w> van plezier als ik dat goede nieuws hoor.",
                            "target_lang_translations": {
                                "en": "I <w>crow</w> with pleasure when I hear that good news."
                            }
