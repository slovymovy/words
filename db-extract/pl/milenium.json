                                "target_senses": [
                                    {
                                        "sense_id": "301b59ba-3fb3-3ad9-8a73-cf143d0c0e5a",
                                        "entry_id": "6306f27e-1e0a-37b1-b5f1-9fad95f8dc5a",
                                        "glosses": [
                                            "Zeitabschnitt von tausend Jahren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46915c01-f4d6-4ee2-a99d-7ef0f78f5153",
                                                "sense_id": "301b59ba-3fb3-3ad9-8a73-cf143d0c0e5a",
                                                "text": "Es dauerte mehrere Millennien."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
