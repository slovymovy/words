                "senses": [
                    {
                        "sense_id": "6f65538f-79b9-3064-9b4d-a5509ca5c2b4",
                        "entry_id": "852097f1-2a06-3fa5-b9b8-5743ff1fe69d",
                        "glosses": [
                            "Person ohne bekannten Namen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f6105e3-3b8b-4f95-8aa7-e4980fa8179d",
                                "sense_id": "6f65538f-79b9-3064-9b4d-a5509ca5c2b4",
                                "text": "„Er war einer von Milliarden Namenlosen gewesen, die von berghoch aufgetürmten Konventionen, Gesetzen und Umgangsformen gefesselt und dazu verdammt waren, ausschließlich in der eigenen schäbigen Nische zu leben und auch darin zu sterben.“"
                            },
                            {
                                "example_id": "50e23ddf-4f76-4222-a617-de4ebfdefcbb",
                                "sense_id": "6f65538f-79b9-3064-9b4d-a5509ca5c2b4",
                                "text": "„Sogar auf dem Grab des Namenlosen blühte und wuchs es das ganze Sommerhalbjahr hindurch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
