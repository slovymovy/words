                                        "sense_id": "af34e2af-b378-38ec-87d4-54e6b459b885",
                                        "entry_id": "253b0f8b-486d-38d4-b6d3-5790d1bd29a0",
                                        "glosses": [
                                            "To give birth to (a foal); to bear offspring."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e297f467-b0a3-4508-a33e-6d0cb092706c",
                                                "sense_id": "af34e2af-b378-38ec-87d4-54e6b459b885",
                                                "text": "All the time, our overfraught hearts are beating at a rate that would far outstrip the fastest gallop of the fastest horses ever foaled."
                                            },
                                            {
                                                "example_id": "5b427c82-465f-4892-b1d6-cc5f004e41e6",
                                                "sense_id": "af34e2af-b378-38ec-87d4-54e6b459b885",
                                                "text": "\"Well,\" said John, \"I don't believe there is a better pair of horses in the country, and right grieved I am to part with them, but they are not alike; the black one is the most perfect temper I ever knew; I suppose he has never known a hard word or a blow since he was foaled, and all his pleasure seems to be to do what you wish; […]"
                                            }
                                        ]
                                    }
                                ]
