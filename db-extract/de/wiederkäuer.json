                                "target_senses": [
                                    {
                                        "sense_id": "7cb154b7-03cc-3d74-bae9-36915dc261e7",
                                        "entry_id": "472dea31-a0fc-3b66-a61d-3d58b9f51f4b",
                                        "glosses": [
                                            "Chewing cud."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "40a572cd-c8b6-3e1d-8546-573ea59c5442",
                                        "entry_id": "472dea31-a0fc-3b66-a61d-3d58b9f51f4b",
                                        "glosses": [
                                            "Pondering; ruminative."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a3bd3b3-8ef9-4534-8141-4aa29521cfdf",
                                                "sense_id": "40a572cd-c8b6-3e1d-8546-573ea59c5442",
                                                "text": "G. K. Chesterton\n“I wonder what a paradox is,” remarked the priest in a ruminant manner."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ruminant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "442927a0-7db3-36f3-807d-05d631197897",
                                        "entry_id": "e2a049c9-9954-3ccd-aae0-ee6638cb6853",
                                        "glosses": [
                                            "Any artiodactyl ungulate mammal which chews cud in the suborder Ruminantia, such as a cow or deer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49d610e4-7d30-4de2-8e44-c24762366ac5",
                                                "sense_id": "442927a0-7db3-36f3-807d-05d631197897",
                                                "text": "Flesh behind steel and glass is unprotected\nFrom enemies that whisper to the blood;\nThe scratch forgotten is the scratch infected;\nThe ruminant, reason, chews a poisoned cud."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b3690637-f8f1-406f-bcde-91433c128555",
                        "source_entry_id": "a05b0343-2fb5-3624-9401-aceb5da29621",
                        "source_sense_id": "c72cd341-f7ce-3ccd-b899-d8efc2957161",
                        "source_sense_description": "Zoologie: Säugetier, dessen Magen in vier Abschnitte geteilt ist",
                        "target_lang_word": "ruminant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ruminant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "efd18fe7-1ccd-3262-bab7-9060d1920756",
                                        "entry_id": "9949d60a-4a1e-326f-a848-6467899daf38",
                                        "glosses": [
                                            "Qui rumine."
                                        ],
                                        "tags": [
                                            "Histoire naturelle"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57d6bad9-253e-414e-b110-a5d81f7bbf18",
                                                "sense_id": "efd18fe7-1ccd-3262-bab7-9060d1920756",
                                                "text": "Les bœufs sont des animaux ruminants."
                                            },
                                            {
                                                "example_id": "44342618-34f7-4171-aa20-e2ff57fc9528",
                                                "sense_id": "efd18fe7-1ccd-3262-bab7-9060d1920756",
                                                "text": "Ils me parlent des « bébés ruminants ». Ils ont entre six et douze mois. Ils régurgitent leur lait et le remâchent avant de l’ingurgiter à nouveau, puis ils recommencent, de telle sorte qu’ils ne digèrent pas et souffrent de dénutrition."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ruminant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9db82f24-0827-3665-804c-1958d3bfb145",
                                        "entry_id": "a0f359aa-c8f1-3afa-bf26-25dec1c0ae52",
                                        "glosses": [
                                            "Animal qui rumine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62174fa0-33a1-4ef3-ac9e-d699afc91e68",
                                                "sense_id": "9db82f24-0827-3665-804c-1958d3bfb145",
                                                "text": "Le ruminant apporte à ces microorganismes un milieu de vie favorable (température constante, aliments)."
                                            },
                                            {
                                                "example_id": "89236928-b4d8-42f8-aed0-4c461bfe9514",
                                                "sense_id": "9db82f24-0827-3665-804c-1958d3bfb145",
                                                "text": "Bien que les ruminants soient les mieux armés stomacalement pour digérer la cellulose, il n'arrivent pas à la transformer complétement, […]."
                                            },
                                            {
                                                "example_id": "4c1c546c-b27c-4940-b7d7-6d60596ccaef",
                                                "sense_id": "9db82f24-0827-3665-804c-1958d3bfb145",
                                                "text": "Les bœufs, les buffles, les moutons, et les chèvres sont des ruminants. Leur estomac se compose de quatre poches : le rumen, le réseau, le feuillet et la caillette. (Seule la quatrième poche, la caillette, est comparable à l’estomac des autres animaux). Les ruminants utilisent les autres poches pour la digestion des plantes."
                                            },
                                            {
                                                "example_id": "3b434437-5b4c-4f79-8e57-aaa4087dd039",
                                                "sense_id": "9db82f24-0827-3665-804c-1958d3bfb145",
                                                "text": "Comment surveiller, diagnostiquer et refréner la fièvre Q dans son élevage ? La lutte contre cette zoonose bactérienne très répandue dans les troupeaux de ruminants est encore floue."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ruminant",
                                "target_lang_code": "fr",
                                "target_senses": [
