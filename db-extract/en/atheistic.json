                                        "sense_id": "e047fa75-800c-38e3-9c34-cee5e0b3c0e8",
                                        "entry_id": "1e57fb4d-31e8-3984-8b62-32ed9765171f",
                                        "glosses": [
                                            "die Lehre des Atheismus vertretend, den Atheismus betreffend: Auffassung, dass es keinen Gott gibt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87f3f344-c6f5-49a4-b567-20f0a8183b1d",
                                                "sense_id": "e047fa75-800c-38e3-9c34-cee5e0b3c0e8",
                                                "text": "Sie hat eine atheistische Weltsicht."
                                            },
                                            {
                                                "example_id": "76a70059-a0e5-4151-87b4-9d84a8e5aa45",
                                                "sense_id": "e047fa75-800c-38e3-9c34-cee5e0b3c0e8",
                                                "text": "Laut der Studie ist Ostdeutschland die atheistischste Region der Welt. Ist das eigentlich schlimm?"
                                            },
                                            {
                                                "example_id": "3ca92be6-896c-4dea-8cba-455e1245dd09",
                                                "sense_id": "e047fa75-800c-38e3-9c34-cee5e0b3c0e8",
                                                "text": "Duka weist wie sein Vorgänger Vlk die These zurück, dass Tschechien das atheistischste Land Europas sei."
                                            },
                                            {
                                                "example_id": "eeb9985f-e646-4213-b040-f754070c0c35",
                                                "sense_id": "e047fa75-800c-38e3-9c34-cee5e0b3c0e8",
                                                "text": "Atheistischere Länder sind auch friedlicher. Das ergab eine Auswertung des Global Peace Index 2009."
                                            },
                                            {
                                                "example_id": "35abd9bc-22e7-4ee7-bab8-3cbc744546e4",
                                                "sense_id": "e047fa75-800c-38e3-9c34-cee5e0b3c0e8",
                                                "text": "Der Konflikt fiel zudem in eine Zeit, in der sich die Kirchen ihrer Rolle im wiedervereinten Deutschland, das eine weitaus atheistischere Bevölkerungsstruktur besitzt, nicht sicher waren."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
