                        "form": "das Stückchen"
                    },
                    {
                        "form_id": "257aaf3a-699e-4e6f-8a67-b43f40c90a16",
                        "entry_id": "ddba8ca0-2126-3412-bbc2-56d54f67de76",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Stückchen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3ff2ff25-d46f-3e88-84d1-8c5e76a05ebc",
                        "entry_id": "ddba8ca0-2126-3412-bbc2-56d54f67de76",
                        "glosses": [
                            "kleiner Teil von etwas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51e83887-3f44-44b5-b0f1-8bd95b596adc",
                                "sense_id": "3ff2ff25-d46f-3e88-84d1-8c5e76a05ebc",
                                "text": "Gibst du mir noch ein Stückchen Brot?"
                            },
                            {
                                "example_id": "9fea275a-84b6-4e6b-ad62-20e75b0efa3e",
                                "sense_id": "3ff2ff25-d46f-3e88-84d1-8c5e76a05ebc",
                                "text": "„Ein Stückchen weiter weg, fast so weit, daß er sie gerade eben noch sehen konnte, traten zwei Gestalten auf den Straßenrand; dann drehten sie sich um und kamen, auf dem Rain entlanggehend, auf ihn zu.“"
                            },
                            {
                                "example_id": "bcc195fb-ac3a-47fd-9506-c5d984de4cfe",
                                "sense_id": "3ff2ff25-d46f-3e88-84d1-8c5e76a05ebc",
                                "text": "„Sie streuten kleine Stückchen ihrer Butterbrote auf den Fenstersims und ein Rotkehlchen kam und pickte sie auf.“"
                            },
                            {
                                "example_id": "91668dcf-f3e0-4e24-8f27-9635daf6efa3",
                                "sense_id": "3ff2ff25-d46f-3e88-84d1-8c5e76a05ebc",
                                "text": "„Ich stöberte in den Kellern umher und in den Brandresten der Wohnungen, fand dort ein bißchen Grütze, da ein paar Stückchen Brot, dumpfiges Mehl und Wasser in Wannen oder Eimern und Krügen.“"
                            },
                            {
                                "example_id": "a6b43c75-551f-426a-98ba-aac296616171",
                                "sense_id": "3ff2ff25-d46f-3e88-84d1-8c5e76a05ebc",
                                "text": "„Lange betrachteten die beiden das Stückchen Land, auf das sie der Zufall verschlagen hatte, dennoch kamen sie über ihr weiteres Schicksal zu keinem bestimmten Schluß.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "0b0fd79e-d296-3a9a-8f83-7d877d2e7051",
                        "entry_id": "ddba8ca0-2126-3412-bbc2-56d54f67de76",
                        "glosses": [
                            "kleine, unbestimmte Menge"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9acfdc12-7489-4c83-a363-6089cee034bd",
                                "sense_id": "0b0fd79e-d296-3a9a-8f83-7d877d2e7051",
                                "text": "Möchtest du ein Stückchen Zucker in den Tee?"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "1c745650-e217-382a-8057-578598913f1e",
                        "entry_id": "ddba8ca0-2126-3412-bbc2-56d54f67de76",
                        "glosses": [
                            "süßes Kleingebäck"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9edecf52-9a93-47a7-b818-0c3c408953d9",
                                "sense_id": "1c745650-e217-382a-8057-578598913f1e",
                                "text": "Ich habe mir beim Bäcker ein süßes Stückchen geholt."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "077c73dc-d8e2-41d8-9e46-3f6f945166d4",
                        "source_entry_id": "ddba8ca0-2126-3412-bbc2-56d54f67de76",
                        "source_sense_id": "3ff2ff25-d46f-3e88-84d1-8c5e76a05ebc",
                        "source_sense_description": "kleiner Teil von etwas",
                        "target_lang_word": "morceau",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "morceau",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b6ff78d5-7294-3621-a498-7d162d0c88d9",
                                        "entry_id": "a5232ca2-a6e8-384b-b8c5-6da53b14b468",
                                        "glosses": [
                                            "Portion séparée d’une chose solide qui peut être mangée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e02df5e5-f55c-486c-8975-5f65fec11a23",
                                                "sense_id": "b6ff78d5-7294-3621-a498-7d162d0c88d9",
                                                "text": "Ces considérations nous portaient donc à croire que l’histoire des bouts de corde était le produit de l’imagination de quelque amateur de l’horrible, de ces gens qui ne peuvent voir une hart se balançant à une branche d'arbre sans que leur esprit frappé ne mette un pendu au bout, avec des corbeaux décrivant leur affreuse courbe autour du supplicié pour en choisir les meilleurs morceaux; […]."
                                            },
                                            {
                                                "example_id": "952468d7-e2b0-4e09-a365-54441e9d096c",
                                                "sense_id": "b6ff78d5-7294-3621-a498-7d162d0c88d9",
                                                "text": "Gros, petit, bon morceau. — Morceau délicat, friand."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad37b243-da05-3a63-afe3-13716dc33196",
                                        "entry_id": "a5232ca2-a6e8-384b-b8c5-6da53b14b468",
                                        "glosses": [
                                            "Partie séparée d’un corps solide et continu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2d92daa-6484-41a7-90ab-64d68e3afdb9",
                                                "sense_id": "ad37b243-da05-3a63-afe3-13716dc33196",
                                                "text": "On est alors fort étonné de retrouver les morceaux de bismuth intacts, leur aspect extérieur ne diffère en rien de ce qu’il était avant la chauffe […] Il semble, d’après cela que le bismuth n’a pas fondu […]"
                                            },
                                            {
                                                "example_id": "519752c0-e525-4cde-bde5-bb3596f4ad55",
                                                "sense_id": "ad37b243-da05-3a63-afe3-13716dc33196",
                                                "text": "Un morceau de savon traînait sur le bord de la baignoire en bois."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e8d3bacc-38a4-3630-b261-04fd2157dc80",
                                        "entry_id": "a5232ca2-a6e8-384b-b8c5-6da53b14b468",
                                        "glosses": [
                                            "Portion, une partie non séparée, mais distincte et considérée à part."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78ba2efc-4768-41f8-851b-60f5c2a4edfa",
                                                "sense_id": "e8d3bacc-38a4-3630-b261-04fd2157dc80",
                                                "text": "Il a attrapé un bon morceau de cette succession : Il en a eu une bonne partie."
                                            },
                                            {
                                                "example_id": "9ea933ee-4c4a-4894-a12a-d675ec749bf2",
                                                "sense_id": "e8d3bacc-38a4-3630-b261-04fd2157dc80",
                                                "text": "Morceau de terre."
                                            },
                                            {
                                                "example_id": "4a79f54e-7214-4bce-92d8-221ad586eac5",
                                                "sense_id": "e8d3bacc-38a4-3630-b261-04fd2157dc80",
                                                "text": "Ils s’apercevront, émus,\nQue c’est au hasard des rues,\nSur un de ces fameux bancs,\nQu’ils ont vécu le meilleur morceau de leur amour…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b148416e-601d-3b3a-b577-f957dab0d8b6",
                                        "entry_id": "a5232ca2-a6e8-384b-b8c5-6da53b14b468",
                                        "glosses": [
                                            "Parties, des fragments d’un ouvrage de l’esprit ou d’une œuvre d’art."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97c6aee8-d75f-4f50-badd-b7ac34eab4db",
                                                "sense_id": "b148416e-601d-3b3a-b577-f957dab0d8b6",
                                                "text": "[…] et, d’autre part, elle citait, de mémoire, des morceaux d’une mystique un peu bizarre de la fin du XVIᵉ siècle, Jeanne Chézard de Matel, la fondatrice de l’ordre du Verbe Incarné […]"
                                            },
                                            {
                                                "example_id": "6242b5d6-3ce2-4115-800d-f2bf70763fa6",
                                                "sense_id": "b148416e-601d-3b3a-b577-f957dab0d8b6",
                                                "text": "Un soir, attendant l'heure du dîner, Claire et Marcelle, cédant je suppose à une prière générale, jouèrent quelques morceaux ensemble, la pianiste accompagnant sa sœur violoniste."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "87473baa-9399-3200-b61c-a6f6b8611508",
                                        "entry_id": "a5232ca2-a6e8-384b-b8c5-6da53b14b468",
                                        "glosses": [
                                            "Objet entier, d’un tout considéré par rapport au genre ou à l’espèce dont il fait partie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a565a0d-b519-4f56-a061-570242d7a952",
                                                "sense_id": "87473baa-9399-3200-b61c-a6f6b8611508",
                                                "text": "La colonnade du Louvre est un beau morceau."
                                            },
                                            {
                                                "example_id": "46e76f50-9591-480e-8cd1-63769ea2b43a",
                                                "sense_id": "87473baa-9399-3200-b61c-a6f6b8611508",
                                                "text": "Cette élégie, cette églogue sont de beaux morceaux de poésie."
                                            },
                                            {
                                                "example_id": "426b2fcb-827b-460a-9f95-8128fa7ef9be",
                                                "sense_id": "87473baa-9399-3200-b61c-a6f6b8611508",
                                                "text": "Un morceau d’anthologie."
                                            },
                                            {
                                                "example_id": "7705613e-e7ce-4a5b-b12c-4259c39ed8fc",
                                                "sense_id": "87473baa-9399-3200-b61c-a6f6b8611508",
                                                "text": "Morceau de concours : Morceau choisi pour être exécuté par chacun de ceux qui prennent part à un concours."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c8cc0a97-8bf9-3821-9c92-17f64e666e22",
                                        "entry_id": "a5232ca2-a6e8-384b-b8c5-6da53b14b468",
                                        "glosses": [
                                            "Femme belle et désirable."
                                        ],
                                        "tags": [
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "603b73e6-4f87-48af-abc4-37690efb14b7",
                                                "sense_id": "c8cc0a97-8bf9-3821-9c92-17f64e666e22",
                                                "text": "Samuel alla au théâtre et se mit à étudier la Fanfarlo sur les planches. Il la trouva légère, magnifique, vigoureuse, pleine de goût dans ses accoutrements, et jugea M. de Cosmelly bien heureux de pouvoir se ruiner pour un pareil morceau."
                                            },
                                            {
                                                "example_id": "34dd5aeb-26d9-40e6-beb1-2748123749af",
                                                "sense_id": "c8cc0a97-8bf9-3821-9c92-17f64e666e22",
                                                "text": "« Quel morceau… et elle a l’air facile, en plus !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
