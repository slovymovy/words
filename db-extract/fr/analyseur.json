                "senses": [
                    {
                        "sense_id": "8789a05e-cdb4-3f54-b14c-dca4659d869f",
                        "entry_id": "ec0d2e9c-a2b3-3258-95d3-634bbb328482",
                        "glosses": [
                            "Objet ou chose qui analyse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21cd2d62-07c6-4590-9736-9125a22d682a",
                                "sense_id": "8789a05e-cdb4-3f54-b14c-dca4659d869f",
                                "text": "Il comporte cinq éléments : un système d’introduction de l’échantillon, une source d’ions, un analyseur et un ensemble de détection d’ions."
