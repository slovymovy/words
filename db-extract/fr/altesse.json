        "fr-extract.jsonl": [
            {
                "entry_id": "13a30255-a194-37d6-8492-bf1400565ffa",
                "word": "altesse",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "57d29ff8-e0e8-4a95-8f42-7ff5bd97be01",
                        "entry_id": "13a30255-a194-37d6-8492-bf1400565ffa",
                        "tags": [
                            "plural"
                        ],
                        "form": "altesses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "34d52f3e-e8c5-3f81-a2b1-1467c66c1d83",
                        "entry_id": "13a30255-a194-37d6-8492-bf1400565ffa",
                        "glosses": [
                            "Titre d’honneur qui se donne à différents princes, en parlant et en écrivant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e370dc75-0aea-4d96-8351-1a67dec6ab66",
                                "sense_id": "34d52f3e-e8c5-3f81-a2b1-1467c66c1d83",
                                "text": "Altesse royale, impériale. Altesse sérénissime. Traiter d’altesse."
                            },
                            {
                                "example_id": "76de6139-6ed4-4e3a-bc80-1624a71f68b9",
                                "sense_id": "34d52f3e-e8c5-3f81-a2b1-1467c66c1d83",
                                "text": "– Comment ne serais-je pas pénétrée des bontés de Votre Altesse ?\n– Laisse là ton Altesse, et appelle-moi comme tu m’appelles quelquefois."
                            },
                            {
                                "example_id": "6168ac6e-5be0-43ba-88c4-08e8e50ce185",
                                "sense_id": "34d52f3e-e8c5-3f81-a2b1-1467c66c1d83",
                                "text": "Une altesse royale en visite passant la revue de la milice à lʼAncresse n'eût pas mieux vidé la ville."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "8da75ec6-10d8-3cd6-8f0b-0f2991d74102",
                "word": "altesse",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b4fcfff8-661b-3aeb-8712-5238b255f935",
                        "entry_id": "8da75ec6-10d8-3cd6-8f0b-0f2991d74102",
                        "glosses": [
                            "Cépage donnant du raisin blanc avec lequel ont produit l’AOP Roussette-de-Savoie, une appellation répartie sur quelque 200 hectares. En 2008 il y avait 350 hectares de ce cépage en France."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72cdc4cb-b778-443d-99b5-4f3d55a0b6bd",
                                "sense_id": "b4fcfff8-661b-3aeb-8712-5238b255f935",
                                "text": "Tous des vins issus d'un unique cépage, l’altesse, dont la légende nous conte que les premiers plants auraient été rapportés de Chypre par un croisé, le comte de Mareste. Il serait allé y chercher Anne de Lusignan, fille du roi Janus, qui devait épouser Louis, prince de Savoie, en 1433. Le nom du cépage aurait été donné en hommage à la princesse."
                            },
                            {
                                "example_id": "0ba1a827-73aa-4497-b318-e9f6bd44fc56",
                                "sense_id": "b4fcfff8-661b-3aeb-8712-5238b255f935",
                                "text": "«L’altesse donne des vins longs en bouche, plus riches et gras que la jacquère. Elle mérite d’être gardée au moins un an avant d’être dégustée sur des pois­sons de lac en sauce, des saint-Jacques et même un foie gras», selon Jacques Barlet, vigneron au Cellier de Sordan à Jongieux."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "de423405-551d-46f9-8f59-72376ad55366",
                        "source_entry_id": "8da75ec6-10d8-3cd6-8f0b-0f2991d74102",
                        "source_sense_id": "b4fcfff8-661b-3aeb-8712-5238b255f935",
                        "target_lang_word": "Hoheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hoheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "abad949f-4d5b-3941-8fa6-736d1ecd1c4f",
                                        "entry_id": "30074061-e622-3ee7-b0e0-7d09f0385349",
                                        "glosses": [
                                            "Anrede für Adlige, in der Regel Herzöge"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85b6ac7a-1d9f-40a3-a182-b11ef9511035",
                                                "sense_id": "abad949f-4d5b-3941-8fa6-736d1ecd1c4f",
                                                "text": "„Eure Hoheit, …!“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e8ab8122-f56f-339f-ac71-8f756e99da3d",
                                        "entry_id": "30074061-e622-3ee7-b0e0-7d09f0385349",
                                        "glosses": [
                                            "Souveränität eines Landes über seinen eigenen Bereich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb110d64-6cf8-4fe0-a015-bd498609e73b",
                                                "sense_id": "e8ab8122-f56f-339f-ac71-8f756e99da3d",
                                                "text": "„So zählt es in Deutschland zur Hoheit der Bundesländer, über Fragen von Bildung und Kultur zu entscheiden.“"
                                            },
                                            {
                                                "example_id": "b21b2a44-f163-47a9-ba0a-f2cb3b7ef817",
                                                "sense_id": "e8ab8122-f56f-339f-ac71-8f756e99da3d",
                                                "text": "„Später war es abwechselnd unter der Hoheit der Byzantiner, Karolinger und Venezianer, bis es sich als teilsouveräner Stadtstaat der Habsburgermonarchie anschloss.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "fe2c8c17-6a23-3cd3-a61a-d9b599b19e43",
                                        "entry_id": "30074061-e622-3ee7-b0e0-7d09f0385349",
                                        "glosses": [
                                            "grundlegende (persönliche) Erhabenheit und Würde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca2c28ce-6390-463e-a0c9-7adff6a6aa89",
                                                "sense_id": "fe2c8c17-6a23-3cd3-a61a-d9b599b19e43",
                                                "text": "„Mit Hoheit hörte er ihren Bericht und ihre Schicksale während seiner Abwesenheit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
