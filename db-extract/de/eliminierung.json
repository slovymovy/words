                        "entry_id": "cce47b26-32ad-3d26-9b2e-feeda1121abc",
                        "glosses": [
                            "chemische Reaktion, bei der aus einem Molekül zwei Atome oder Atomgruppen in einem oder zwei Reaktionsschritten abgespalten werden"
                        ],
                        "tags": [
                            "organische Chemie"
                        ],
                        "examples": [
                            {
                                "example_id": "d361d417-6438-4c2b-8029-7e996fc854b5",
                                "sense_id": "5cda051d-e3e9-3995-9a42-f0fffd0458c2",
                                "text": "„Die am häufigsten vorkommende Eliminierung betrifft zwei im Ausgangsmolekül benachbarte, aneinander gebundene Atome, wobei danach eine Doppel- oder Dreifachbindung zwischen diesen entsteht.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
