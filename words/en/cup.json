    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f9a1f631-29bf-348e-9bb6-55283a4f8b2d",
                    "sense_definition": "A concave vessel for drinking, usually made of opaque material and with a handle.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "drinking_vessel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She poured the hot tea into a ceramic <w>cup</w>.",
                            "target_lang_translations": {
                                "ru": "Она налила горячий чай в керамическую <w>чашку</w>."
                            }
                        },
                        {
                            "text": "Please place your <w>coffee</w> <w>cup</w> on the coaster to protect the table.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, поставьте свою <w>чашку</w> кофе на подставку, чтобы защитить стол."
                            }
                        }
                    ],
                    "common_phrases": [
                        "coffee cup",
                        "tea cup",
                        "ceramic cup"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вогнутый сосуд для питья, обычно из непрозрачного материала и с ручкой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чашка",
                                "target_lang_sense_clarification": "сосуд с ручкой"
                            },
                            {
                                "target_lang_word": "кружка",
                                "target_lang_sense_clarification": "большая чашка"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b2959d9e-6f66-3d50-9050-49b0800a3805",
                    "sense_definition": "The amount of liquid or substance contained within a drinking vessel.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "quantity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I drank two <w>cups</w> of water but still felt thirsty after the run.",
                            "target_lang_translations": {
                                "ru": "Я выпил две <w>чашки</w> воды, но все равно чувствовал жажду после пробежки."
                            }
                        },
                        {
                            "text": "Would you like another <w>cup</w> <w>of</w> <w>tea</w> before you leave?",
                            "target_lang_translations": {
                                "ru": "Хотите еще одну <w>чашку</w> чая перед уходом?"
                            }
                        }
                    ],
                    "synonyms": [
                        "cupful"
                    ],
                    "common_phrases": [
                        "cup of tea",
                        "cup of coffee",
                        "full cup"
                    ],
                    "target_lang_definitions": {
                        "ru": "Количество жидкости или вещества, содержащееся в сосуде для питья."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чашка",
                                "target_lang_sense_clarification": "объем содержимого"
                            },
                            {
                                "target_lang_word": "кружка",
                                "target_lang_sense_clarification": "объем содержимого"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dd433a89-129b-31d8-8561-7595e99f82b3",
                    "sense_definition": "A unit of measure used in cooking, often equal to 250 mL or 8 fluid ounces.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "measurement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The recipe requires one <w>cup</w> <w>of</w> <w>sugar</w> and two cups of flour.",
                            "target_lang_translations": {
                                "ru": "Для рецепта требуется одна <w>чашка</w> сахара и две чашки муки."
                            }
                        },
                        {
                            "text": "Add a <w>measuring</w> <w>cup</w> of milk to the mixture and stir well.",
                            "target_lang_translations": {
                                "ru": "Добавьте мерную <w>чашку</w> молока в смесь и хорошо перемешайте."
                            }
                        }
                    ],
                    "common_phrases": [
                        "measuring cup",
                        "cup of sugar",
                        "half a cup"
                    ],
                    "target_lang_definitions": {
                        "ru": "Единица измерения, используемая в кулинарии, часто равная 250 мл."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чашка",
                                "target_lang_sense_clarification": "мера объема"
                            },
                            {
                                "target_lang_word": "стакан",
                                "target_lang_sense_clarification": "кулинарная мера"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a07cdf83-a47c-381a-8535-12bf67896820",
                    "sense_definition": "A trophy in the shape of an oversized vessel awarded to the winner of a competition.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "sports_trophy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The captain held the <w>gold</w> <w>cup</w> high above his head after the victory.",
                            "target_lang_translations": {
                                "ru": "Капитан высоко поднял золотой <w>кубок</w> над головой после победы."
                            }
                        },
                        {
                            "text": "Winning the <w>championship</w> <w>cup</w> was the highlight of his professional career.",
                            "target_lang_translations": {
                                "ru": "Победа в чемпионском <w>кубке</w> стала главным событием в его профессиональной карьере."
                            }
                        }
                    ],
                    "common_phrases": [
                        "gold cup",
                        "championship cup",
                        "winner cup"
                    ],
                    "target_lang_definitions": {
                        "ru": "Трофей в форме большого сосуда, вручаемый победителю соревнований."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кубок",
                                "target_lang_sense_clarification": "спортивный трофей"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bf793de9-25c1-3a4a-a524-215e9b1c56bc",
                    "sense_definition": "A sports competition or tournament for which a trophy is awarded.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "sports_event",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>World</w> <w>Cup</w> is the most widely watched sporting event on the planet.",
                            "target_lang_translations": {
                                "ru": "Чемпионат мира (<w>Кубок</w> мира) — самое просматриваемое спортивное событие на планете."
                            }
                        },
                        {
                            "text": "Our local team is playing in the <w>cup</w> <w>final</w> this weekend.",
                            "target_lang_translations": {
                                "ru": "Наша местная команда играет в финале <w>кубка</w> в эти выходные."
                            }
                        }
                    ],
                    "common_phrases": [
                        "World Cup",
                        "cup final",
                        "cup tie"
                    ],
                    "target_lang_definitions": {
                        "ru": "Спортивное соревнование или турнир, за победу в котором вручается кубок."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кубок",
                                "target_lang_sense_clarification": "турнир"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "29c6941a-5be0-3d20-bb37-2c8cb61eaea5",
                    "sense_definition": "One of the two parts of a brassiere which each cover a breast.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "clothing_part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>bra</w> <w>cup</w> is made of a soft, breathable cotton material.",
                            "target_lang_translations": {
                                "ru": "<w>Чашечка</w> бюстгальтера изготовлена из мягкого дышащего хлопка."
                            }
                        },
                        {
                            "text": "She needed a larger <w>cup</w> <w>size</w> for a more comfortable fit.",
                            "target_lang_translations": {
                                "ru": "Ей нужен был больший размер <w>чашечки</w> для более удобной посадки."
                            }
                        }
                    ],
                    "common_phrases": [
                        "cup size",
                        "bra cup",
                        "padded cup"
                    ],
                    "target_lang_definitions": {
                        "ru": "Одна из двух частей бюстгальтера, закрывающая грудь."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чашечка",
                                "target_lang_sense_clarification": "деталь бюстгальтера"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2460832a-d64b-3108-bca2-90a3a32a385a",
                    "sense_definition": "A rigid concave protective covering for the male genitalia used in contact sports.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "protective_gear",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Players of contact sports are strongly advised to <w>wear</w> a <w>cup</w>.",
                            "target_lang_translations": {
                                "ru": "Игрокам в контактных видах спорта настоятельно рекомендуется носить защитную <w>раковину</w>."
                            }
                        },
                        {
                            "text": "He forgot his <w>protective</w> <w>cup</w> in the locker room before the game.",
                            "target_lang_translations": {
                                "ru": "Он забыл свою защитную <w>чашку</w> в раздевалке перед игрой."
                            }
                        }
                    ],
                    "synonyms": [
                        "box"
                    ],
                    "common_phrases": [
                        "protective cup",
                        "athletic cup",
                        "wear a cup"
                    ],
                    "target_lang_definitions": {
                        "ru": "Жесткое вогнутое защитное приспособление для мужских половых органов, используемое в контактных видах спорта."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "раковина",
                                "target_lang_sense_clarification": "защитное снаряжение"
                            },
                            {
                                "target_lang_word": "защитная чашка",
                                "target_lang_sense_clarification": "спортивная защита"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6aaea091-79be-31bd-bf91-aff2bcc96318",
                    "sense_definition": "A cup-shaped object placed in the target hole in the game of golf.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "golf_equipment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The golf ball rolled slowly across the green and dropped into the <w>cup</w>.",
                            "target_lang_translations": {
                                "ru": "Мяч для гольфа медленно катился по грину и упал в <w>стакан</w> лунки."
                            }
                        },
                        {
                            "text": "He watched as the ball just missed the <w>cup</w> by an inch.",
                            "target_lang_translations": {
                                "ru": "Он смотрел, как мяч пролетел мимо <w>лунки</w> всего на дюйм."
                            }
                        }
                    ],
                    "common_phrases": [
                        "golf cup",
                        "edge of the cup"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чашеобразный предмет, помещаемый в лунку в игре в гольф."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стакан",
                                "target_lang_sense_clarification": "вставка в лунку для гольфа"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a3c73902-4e18-3e11-ac4f-e5a4e9140ec4",
                    "sense_definition": "A flexible concave membrane used to attach objects to surfaces via suction.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "hardware",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>suction</w> <w>cup</w> failed to hold the weight of the heavy mirror.",
                            "target_lang_translations": {
                                "ru": "<w>Присоска</w> не выдержала веса тяжелого зеркала."
                            }
                        },
                        {
                            "text": "Moisten the <w>cup</w> before pressing it against the glass for a better seal.",
                            "target_lang_translations": {
                                "ru": "Смочите <w>присоску</w>, прежде чем прижать ее к стеклу для лучшего сцепления."
                            }
                        }
                    ],
                    "synonyms": [
                        "suction cup"
                    ],
                    "common_phrases": [
                        "suction cup",
                        "rubber cup"
                    ],
                    "target_lang_definitions": {
                        "ru": "Гибкая вогнутая мембрана, используемая для крепления предметов к поверхностям с помощью всасывания."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "присоска",
                                "target_lang_sense_clarification": "вакуумный держатель"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bcb5ddc2-83db-39c6-b60e-ee5e1e8853cf",
                    "sense_definition": "One's portion of blessings or afflictions; that which is allotted to be endured.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "metaphorical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He felt that his <w>cup</w> <w>of</w> <w>sorrow</w> was finally overflowing after the news.",
                            "target_lang_translations": {
                                "ru": "Он почувствовал, что его <w>чаша</w> скорби окончательно переполнилась после этих новостей."
                            }
                        },
                        {
                            "text": "In the garden, he prayed for this <w>bitter</w> <w>cup</w> to pass from him.",
                            "target_lang_translations": {
                                "ru": "В саду он молился, чтобы эта горькая <w>чаша</w> миновала его."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bitter cup",
                        "cup of sorrow",
                        "cup of joy"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "literary or biblical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Доля благословений или страданий; то, что суждено вынести."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чаша",
                                "target_lang_sense_clarification": "участь или судьба"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9fed15e9-5f1d-3afe-a321-3bfbad5d0794",
                    "sense_definition": "To form something, particularly the hands, into the shape of a cup.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "shaping",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If you <w>cup</w> <w>your</w> <w>hands</w>, I can pour some water into them.",
                            "target_lang_translations": {
                                "ru": "Если ты <w>сложишь</w> ладони лодочкой, я смогу налить в них немного воды."
                            }
                        },
                        {
                            "text": "She <w>cupped</w> her hands around her mouth to shout to the workers.",
                            "target_lang_translations": {
                                "ru": "Она <w>приложила</w> ладони ко рту, чтобы крикнуть рабочим."
                            }
                        }
                    ],
                    "common_phrases": [
                        "cup your hands",
                        "cup one's ears"
                    ],
                    "target_lang_definitions": {
                        "ru": "Придавать чему-либо, особенно рукам, форму чаши."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сложить",
                                "target_lang_sense_clarification": "сделать ладони ковшиком"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a79de6c5-c142-3037-ac9d-ad27ffde9f07",
                    "sense_definition": "To hold or support something gently in cupped hands.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "holding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>cupped</w> <w>the</w> <w>bird</w> in his palms to keep it warm.",
                            "target_lang_translations": {
                                "ru": "Он <w>обхватил</w> птицу ладонями, чтобы согреть ее."
                            }
                        },
                        {
                            "text": "The old man <w>cupped</w> the fragile vase as if it were made of ice.",
                            "target_lang_translations": {
                                "ru": "Старик бережно <w>поддерживал</w> хрупкую вазу, словно она была сделана из льда."
                            }
                        }
                    ],
                    "common_phrases": [
                        "cup the chin",
                        "cup the bird"
                    ],
                    "target_lang_definitions": {
                        "ru": "Осторожно держать или поддерживать что-либо в сложенных ладонях."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обхватить",
                                "target_lang_sense_clarification": "бережно держать ладонями"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "a0066787-2da4-3ea3-a62d-f6192820afaa",
                    "sense_definition": "An abbreviation for Cambridge University Press.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "organization",
                    "name_type": "organization_name",
                    "examples": [
                        {
                            "text": "The academic textbook was published by <w>CUP</w> last year.",
                            "target_lang_translations": {
                                "ru": "Академический учебник был опубликован издательством <w>CUP</w> в прошлом году."
                            }
                        },
                        {
                            "text": "Many scholars prefer the rigorous editing standards found at <w>CUP</w>.",
                            "target_lang_translations": {
