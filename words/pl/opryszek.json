{
    "word_family": [
        "opryszkowy"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8a5f808a-b5ea-3471-97d1-a7d671d54977",
                    "sense_definition": "drobny przestępca, chuligan lub bandyta",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "przestępca",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Młody <w>opryszek</w> został zatrzymany przez policję po próbie kradzieży portfela w centrum miasta.",
                            "target_lang_translations": {
                                "ru": "Молодой <w>хулиган</w> был задержан полицией после попытки кражи кошелька в центре города."
                            }
                        },
                        {
                            "text": "W ciemnej uliczce zaczepił nas jakiś <w>opryszek</w> i zażądał oddania wszystkich pieniędzy.",
                            "target_lang_translations": {
                                "ru": "В темном переулке к нам пристал какой-то <w>бандит</w> и потребовал отдать все деньги."
                            }
                        }
                    ],
                    "synonyms": [
                        "bandyta",
                        "bandzior",
                        "oprych",
                        "zbir",
                        "złodziej"
                    ],
                    "target_lang_definitions": {
                        "ru": "мелкий преступник, хулиган или бандит"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хулиган",
                                "target_lang_sense_clarification": "человек, нарушающий общественный порядок"
                            },
                            {
                                "target_lang_word": "бандит",
                                "target_lang_sense_clarification": "преступник, занимающийся грабежами"
                            },
                            {
                                "target_lang_word": "головорез",
                                "target_lang_sense_clarification": "опасный, жестокий преступник"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0e78c0c6-253f-32fb-9309-3722b96c8dff",
                    "sense_definition": "historyczny zbójnik działający w Karpatach",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "przestępca",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Legendarny <w>opryszek</w> ukrywał się w górach przed wojskami cesarskimi przez wiele długich lat.",
                            "target_lang_translations": {
                                "ru": "Легендарный <w>опришок</w> скрывался в горах от императорских войск долгие годы."
                            }
                        },
                        {
                            "text": "W dawnych czasach każdy <w>opryszek</w> był postrzegany przez ludność jako obrońca przed niesprawiedliwością.",
                            "target_lang_translations": {
                                "ru": "В давние времена каждый <w>разбойник</w> воспринимался народом как защитник от несправедливости."
                            }
                        }
                    ],
                    "synonyms": [
                        "zbój",
                        "zbójnik"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "odnosi się do historii Karpat"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "исторический разбойник, действовавший в Карпатах"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "опришок",
                                "target_lang_sense_clarification": "исторический термин для карпатских разбойников"
                            },
                            {
                                "target_lang_word": "разбойник",
                                "target_lang_sense_clarification": "человек, совершающий грабежи"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cfc4232d-b266-30c8-818e-312acd3e43a1",
                    "sense_definition": "urwis lub wesołek",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ten mały <w>opryszek</w> znowu wymyślił jakiś psikus, z którego śmiała się cała nasza rodzina.",
                            "target_lang_translations": {
                                "ru": "Этот маленький <w>озорник</w> снова придумал какую-то шутку, над которой смеялась вся наша семья."
                            }
                        },
                        {
                            "text": "Mimo że był prawdziwym <w>opryszkiem</w>, wszyscy w okolicy darzyli go wielką sympatią.",
                            "target_lang_translations": {
                                "ru": "Несмотря на то, что он был настоящим <w>проказником</w>, все в округе относились к нему с большой симпатией."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "gwara Śląska Cieszyńskiego"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "озорник или весельчак"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "озорник",
                                "target_lang_sense_clarification": "шаловливый ребенок"
                            },
                            {
                                "target_lang_word": "проказник",
                                "target_lang_sense_clarification": "тот, кто любит устраивать шалости"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}