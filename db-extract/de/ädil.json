                    }
                ],
                "senses": [
                    {
                        "sense_id": "2e9a4ee1-318c-3805-b506-9e735468d653",
                        "entry_id": "0b9e3d5b-e734-3329-b30f-edfb2b5d1219",
                        "glosses": [
                            "niedriges Amt in der römischen Ämterlaufbahn, hauptsächlich Polizeibeamter, aber der Aufgabenbereich unterlag über die Jahrhunderte einem Wandel"
                        ],
                        "tags": [
                            "Antike"
                        ],
                        "examples": [
                            {
                                "example_id": "89737f99-0311-410f-a52f-02faf100f370",
                                "sense_id": "2e9a4ee1-318c-3805-b506-9e735468d653",
                                "text": "„Der Großvater des Kaisers Nero – er war als äußerst arrogant verschrien und gehörte als Ädil dem niederen Beamtenstand an – soll einen höher stehenden Zensor zum Ausweichen gezwungen haben. Ein Skandal!“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f8c46d5a-b9f0-4d6f-80b4-d37b08417f5b",
                        "source_entry_id": "0b9e3d5b-e734-3329-b30f-edfb2b5d1219",
                        "source_sense_id": "2e9a4ee1-318c-3805-b506-9e735468d653",
                        "target_lang_word": "aedile",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aedile",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8bc29975-c131-3677-bfcb-696adfe959d4",
                                        "entry_id": "574f6229-b5e5-37ce-b34a-0272ab0e2aae",
                                        "glosses": [
                                            "An elected official who was responsible for the maintenance of public buildings, regulation of festivals, supervision of markets and the supply of grain and water."
                                        ],
                                        "tags": [
                                            "Ancient-Rome",
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec8d7a7e-5e31-4627-aa94-cf4b4a776943",
                                                "sense_id": "8bc29975-c131-3677-bfcb-696adfe959d4",
                                                "text": "Some of these encroachments may have received permission from the town council or the local aediles. A handful of painted notices found on the outside of the Amphitheatre suggest that it was the aediles who authorised the street vendors plying their trade underneath the monument’s arches, and assigned their pitches: ‘By permission of the aediles. Licensed to Caius Aninius Fortunatus’ etc., as the faint and fragmentary Latin seems to say."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "48bdf5f3-1c1f-474d-8cd2-93ee57ea654d",
                        "source_entry_id": "0b9e3d5b-e734-3329-b30f-edfb2b5d1219",
                        "source_sense_id": "2e9a4ee1-318c-3805-b506-9e735468d653",
                        "target_lang_word": "édile",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "édile",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0003540c-e6bd-34e0-93f6-195f674db615",
                                        "entry_id": "d5d73eaf-0776-350d-8bd5-94134b307735",
                                        "glosses": [
                                            "Magistrat romain qui avait inspection sur les édifices publics, sur les jeux, etc."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17441312-e4cb-4fc5-959d-bc8a19f3ace2",
                                                "sense_id": "0003540c-e6bd-34e0-93f6-195f674db615",
                                                "text": "Édile curule."
                                            },
                                            {
                                                "example_id": "7956af3e-6a87-4e41-8c79-2868365d4c4b",
                                                "sense_id": "0003540c-e6bd-34e0-93f6-195f674db615",
                                                "text": "Édile plébéien."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a1e98ac-c23f-3606-b384-3afe8b143d76",
                                        "entry_id": "d5d73eaf-0776-350d-8bd5-94134b307735",
                                        "glosses": [
                                            "Élu municipal des grandes villes contemporaines."
                                        ],
                                        "tags": [
                                            "Administration"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e7b75f31-fc5e-432b-8111-276b60d3a827",
                                                "sense_id": "5a1e98ac-c23f-3606-b384-3afe8b143d76",
                                                "text": "L’édile a travaillé avec le maire du 9ᵉ arrondissement, dès 2011, pour essayer de labelliser les « vrais » salons."
                                            },
                                            {
                                                "example_id": "5ce4d32f-7293-4fc7-b742-81ae241b3329",
                                                "sense_id": "5a1e98ac-c23f-3606-b384-3afe8b143d76",
                                                "text": "Sur la place Abbal, en plus du concepteur Olivier Vichard, on pouvait remarquer la présence de Jean-Luc Moudenc, le premier édile de Toulouse, et Gaëtan Cognard, maire du quartier de la Reynerie."
                                            },
                                            {
                                                "example_id": "91a1f968-31fa-42fc-8076-9a70e4c2b888",
                                                "sense_id": "5a1e98ac-c23f-3606-b384-3afe8b143d76",
                                                "text": "Nos édiles se doutent-ils seulement que certains quartiers de Paris, notamment les boulevards extérieurs, sont aussi dangereux pour le promeneur qui s’y aventure, que la Prairie l’est pour le voyageur blanc ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
