                        "glosses": [
                            "Genre d’herbacées natives du cap de Bonne-Espérance, de la famille des Tecophilaeaceae."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e686b93-8c88-4d38-bf38-e51370a6909b",
                                "sense_id": "d243932a-ce09-3572-9555-be01c8806cf7",
                                "text": "Les cyanelles proviennent toutes de l’Afrique méridionale. La cyanelle du cap porte un bulbe déprimé que les habitans du pays où elle croît mangent quand il est grillé ; ses fleurs sont d’un violet clair ; elle est cultivée au jardin du roi."
                            }
                        ]
                    }
