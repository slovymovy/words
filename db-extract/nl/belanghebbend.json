                                        "entry_id": "0276205b-7a07-3e93-afa7-144c378cee35",
                                        "glosses": [
                                            "Relatif à des intérêts, des enjeux, d’où partial."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72b09219-90bc-4990-81f4-cfe6049045da",
                                                "sense_id": "84f8ffc1-d1a4-3cbc-909d-cbf8808ccdd1",
                                                "text": "Une question intéressée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f194e056-6bc2-317e-9ab8-118ed1508eb3",
                                        "entry_id": "0276205b-7a07-3e93-afa7-144c378cee35",
                                        "glosses": [
                                            "Égoïste, avide."
