                "senses": [
                    {
                        "sense_id": "158f1416-ac6f-3265-a96d-7d3af1938d28",
                        "entry_id": "7a4d2ea2-9975-385c-baf8-31f76beb460d",
                        "glosses": [
                            "verursacht durch Langeweile und Interesselosigkeit"
                        ],
                        "tags": [
                            "von Lustlosigkeit und Melancholie geprägte Gefühlslage"
                        ],
                        "examples": [
                            {
                                "example_id": "4f6415ae-933b-4495-bd71-26f29cf29611",
                                "sense_id": "158f1416-ac6f-3265-a96d-7d3af1938d28",
                                "text": "Unaufhörlich wird aus dem Grund seiner Seele der Ennui aufsteigen, die Schwärze, die Traurigkeit, der Kummer, der Verzicht, die Verzweiflung."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f650e62c-9b15-3112-ac43-1b464c6c7420",
                        "entry_id": "7a4d2ea2-9975-385c-baf8-31f76beb460d",
                        "glosses": [
                            "verursacht durch Missmut, Unzufriedenheit oder Widerwille"
                        ],
                        "tags": [
                            "von Lustlosigkeit und Melancholie geprägte Gefühlslage"
                        ],
                        "examples": [
                            {
                                "example_id": "8c3196dc-dcb7-4c22-9c83-535c4e290686",
                                "sense_id": "f650e62c-9b15-3112-ac43-1b464c6c7420",
                                "text": "„Immer geht es dabei um Fragen nach dem Streben nach Glück, das, wenn es zum Streben nach Erfolg, Anerkennung, materiellem Wohlergehen missrät, mit Unglück, Depression, Ennui entgolten wird.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "086e9f36-cc9e-4a68-97d2-52a12a5f37fb",
