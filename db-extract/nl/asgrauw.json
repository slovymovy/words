                    {
                        "translation_id": "e147822b-82a1-4ebc-a221-e1307084259d",
                        "source_entry_id": "8e7a1cfd-ba47-3a55-a139-e647749317e9",
                        "source_sense_id": "62a94c82-8f29-3f3c-8c25-5f2ec67756e0",
                        "source_sense_description": "de grauwe kleur van as hebbend",
                        "target_lang_word": "ash-colored",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ash-colored",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0f8c9b36-d754-3340-bc9e-2f09c4091459",
                                        "entry_id": "1a4cc04e-b686-3e17-9608-a9793128d516",
                                        "glosses": [
                                            "Of the color of ashes; pale grey."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6b2a64b-483d-40d6-81c6-510ef6fa5f5b",
                                                "sense_id": "0f8c9b36-d754-3340-bc9e-2f09c4091459",
                                                "text": "When the plunderers returned with their prey the ash-colored ants received them as friends, caressed them with their antennæ, offered them food, and taking up their burdens conveyed them to the inner part of the nest. It appeared on farther examination that these ash-colored ants were the slaves of the warlike freebooters, for whom they performed all domestic services, while their masters followed the trade of plunder. Huber somewat incorrectly terms the rufescent ants, Amazons, and the ash-colored species, Negroes."
                                            },
                                            {
                                                "example_id": "f1dba886-588f-4682-a2c1-dbb09a862c0f",
                                                "sense_id": "0f8c9b36-d754-3340-bc9e-2f09c4091459",
                                                "text": "Among these stolen horses were those the Mexicans had captured out of the band of ash-colored ones. If you look carefully, you will see that there are four fine ash-colored animals with the Indians."
                                            },
                                            {
                                                "example_id": "26fc1b5a-8342-4d5a-9ed6-5fce76112a1e",
                                                "sense_id": "0f8c9b36-d754-3340-bc9e-2f09c4091459",
                                                "text": "The ash-colored body on top of the base of the radiating fibers, and called the corpus stratum or optic thalamus (Figure 6c), does not converge to form the afore-mentioned fibers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
