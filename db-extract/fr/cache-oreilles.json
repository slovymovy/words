                ],
                "senses": [
                    {
                        "sense_id": "67ef20d4-3c9d-32af-8ea0-4d8554302bf4",
                        "entry_id": "a1c2f3a6-86f6-3302-bc04-c4b98c90208d",
                        "glosses": [
                            "Protections placées sur les oreilles et reliées par un bandeau, utilisée contre le froid."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fc1dfa6a-2440-466a-a43f-4e1c3d0d8d6b",
                        "source_entry_id": "a1c2f3a6-86f6-3302-bc04-c4b98c90208d",
                        "source_sense_id": "67ef20d4-3c9d-32af-8ea0-4d8554302bf4",
                        "target_lang_word": "Ohrenschützer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ohrenschützer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ad73b023-48c7-315f-ba43-dc9e191cfd15",
                                        "entry_id": "c1082b30-7596-31ec-bb2b-7075d91a6d96",
                                        "glosses": [
                                            "Vorrichtung, die über die Ohren gelegt werden kann, um gegen Kälte, Lärm oder dergleichen zu schützen"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "24f13f29-b58f-3efe-8045-cbc7e324015b",
                                        "entry_id": "c1082b30-7596-31ec-bb2b-7075d91a6d96",
                                        "glosses": [
                                            "Vorrichtung, die über die Ohren gelegt werden kann, um gegen Kälte, Lärm oder dergleichen zu schützen",
                                            "für beide Ohren"
                                        ],
                                        "tags": [
                                            "im Singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "573a5c56-55e4-47ea-9020-6a567f52993a",
                                                "sense_id": "24f13f29-b58f-3efe-8045-cbc7e324015b",
                                                "text": "„›Janni, setz den Ohrenschützer auf.‹ Ich bücke mich zur Beifahrerseite und taste auf dem Boden nach dem Ohrenschützer, den ich Janni gekauft habe.“"
                                            },
                                            {
                                                "example_id": "fbc969d9-5408-49ba-8288-2269f4cfc6a7",
                                                "sense_id": "24f13f29-b58f-3efe-8045-cbc7e324015b",
                                                "text": "„Ich erinnere mich, Reinhold setzte immer nur eine einfache Soldatenmütze auf, zog den Ohrenschützer darüber.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1a\""
                                    },
                                    {
                                        "sense_id": "f89d9220-7183-3853-b3cd-1c125c2b98ad",
                                        "entry_id": "c1082b30-7596-31ec-bb2b-7075d91a6d96",
                                        "glosses": [
                                            "Vorrichtung, die über die Ohren gelegt werden kann, um gegen Kälte, Lärm oder dergleichen zu schützen",
                                            "für ein Ohr"
                                        ],
                                        "tags": [
                                            "im Singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "02532cdb-5544-4509-83b3-31f0c554f5e9",
                                                "sense_id": "f89d9220-7183-3853-b3cd-1c125c2b98ad",
                                                "text": "„Earl hängte seine Jacke neben Jakes an der Garderobe auf, steckte seine Handschuhe in die Jackentasche und stopfte auch noch die Mütze hinein, sodass einer der beiden Ohrenschützer noch zur Hälfte heraus hing.“"
                                            },
                                            {
                                                "example_id": "3ccd966d-6e1b-463a-acf5-ebc07d2a1aa7",
                                                "sense_id": "f89d9220-7183-3853-b3cd-1c125c2b98ad",
                                                "text": "„Er trug einen Plastikmantel und saß, den rechten Ohrenschützer nach hinten verschoben, hielt ein Transistorradio ans freie Ohr, las die Bild-Zeitung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1b\""
                                    },
                                    {
                                        "sense_id": "1573b631-9a72-3fb3-aacc-5446f1c968fb",
                                        "entry_id": "c1082b30-7596-31ec-bb2b-7075d91a6d96",
                                        "glosses": [
                                            "Vorrichtung, die über die Ohren gelegt werden kann, um gegen Kälte, Lärm oder dergleichen zu schützen",
                                            "für beide Ohren, bestehend aus zwei [1b]"
                                        ],
                                        "tags": [
                                            "im Plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "77b76b6b-fd36-4415-8550-d877a44dfae6",
                                                "sense_id": "1573b631-9a72-3fb3-aacc-5446f1c968fb",
                                                "text": "„Bei seinem allerersten Disco-Besuch musste er deshalb riesige Ohrenschützer anlegen, wie sie sonst nur Bauarbeiter tragen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1c\""
                                    },
                                    {
                                        "sense_id": "8362577f-b709-38f3-af6c-b9aa0402d386",
                                        "entry_id": "c1082b30-7596-31ec-bb2b-7075d91a6d96",
                                        "glosses": [
                                            "No glosses available"
                                        ],
                                        "tags": [
                                            "no-gloss"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bcf9d6d7-72aa-4904-87a5-a8e8a7541314",
                                                "sense_id": "8362577f-b709-38f3-af6c-b9aa0402d386",
                                                "text": "„Während wir an sonnigen Septembertagen mit der Gedankenlosigkeit des Massenmenschen im Freien Kaffee trinken, stehen seine Schaufensterpuppen bereits bis an die Knie im Pulverschnee und kämpfen mit Ohrenschützern, schafwollenen Fäustlingen und gewinnendem Lächeln gegen polare Frosteinbrüche.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1a oder 1c\""
                                    },
                                    {
                                        "sense_id": "97800b00-3ffa-301f-bdbc-1ae997ef901c",
                                        "entry_id": "c1082b30-7596-31ec-bb2b-7075d91a6d96",
                                        "glosses": [
                                            "No glosses available"
                                        ],
                                        "tags": [
                                            "no-gloss"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b4b8203-1bb7-46b7-a8e6-621ca35f8929",
                                                "sense_id": "97800b00-3ffa-301f-bdbc-1ae997ef901c",
                                                "text": "„Der Deckel einer weiteren Farbdose ist offen, und in ihr steckt ein Ohrenschützer, dessen Ende herausragt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1a oder 1b\""
                                    }
                                ]
                            }
                        ]
