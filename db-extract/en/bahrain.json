                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bahrayn",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "87c7601b-b926-36c0-844a-a07ae095948c",
                                        "entry_id": "29f8f0aa-087f-35e2-9741-fcfb6abc24b3",
                                        "glosses": [
                                            "Variante de Bahreïn."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa03845c-bc17-4d33-8e32-049a1da6d3fc",
                                                "sense_id": "87c7601b-b926-36c0-844a-a07ae095948c",
                                                "text": "Shadi se voyant abandonné, se jeta promptement dans son tarrankin, & mit à la voile avec tant de diligence ; qu’il échappa à ceux qui avoient été envoyés pour se saisir de lui. Il ne survécut cependant pas long-temps à sa disgrace ; peu après son retour à Bahrayn, il mourut de chagrin, laissant un fils fort jeune, auquel Turan Shah donna les biens de son pere. Shamba, qui s’étoit sauvé à Shiraz, apprenant la mort de son frere, se hâta de se rendre à Bahrayn ; & trouvant l’occasion Favorable, il s’empara de cette isle, & se vengea cruellement de tous ceux qui, dans les derniers troubles, avoient pris le parti de Shadi."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
