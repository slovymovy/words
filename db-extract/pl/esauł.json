                                "target_senses": [
                                    {
                                        "sense_id": "951edcea-33f3-33cc-93c6-597320c847e0",
                                        "entry_id": "8656ffc8-36c9-3af0-a9fd-38ded40df008",
                                        "glosses": [
                                            "истор., воен. в царской армии — казачий офицерский чин, равный ротмистру в кавалерии или капитану в пехоте; также лицо, носившее этот чин"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a733a42c-4026-4b38-9b4f-f8e171596eca",
                                                "sense_id": "951edcea-33f3-33cc-93c6-597320c847e0",
                                                "text": "В это время старый есаул подошёл к двери и назвал его по имени; тот откликнулся."
                                            },
                                            {
                                                "example_id": "d27346e6-55bc-4681-88e6-70a0afe91c37",
                                                "sense_id": "951edcea-33f3-33cc-93c6-597320c847e0",
                                                "text": "При гетмане были чины: есаул, судья, писарь, составлявшие генеральную старшину."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
