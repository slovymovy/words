{
    "word_family": [
        "Groll",
        "grollig"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fb60113d-1821-35b4-8093-986c025a21e1",
                    "sense_definition": "ein tiefes, dumpfes und hallendes Geräusch erzeugen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "geraeusch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In der Ferne <w>grollte</w> der Donner und kündigte ein schweres Unwetter an."
                        },
                        {
                            "text": "Die Erde begann zu beben und tief unter den Füßen der Wanderer <w>grollte</w> es bedrohlich."
                        }
                    ],
                    "synonyms": [
                        "donnern",
                        "dröhnen",
                        "krachen",
                        "poltern",
                        "rumoren",
                        "rumpeln"
                    ],
                    "common_phrases": [
                        "der Donner grollt",
                        "in der Ferne grollen"
                    ]
                },
                {
                    "sense_id": "7e2725df-787e-30cd-82fe-b62a60b4cd91",
                    "sense_definition": "über längere Zeit heimlich oder stumm Zorn und Verbitterung gegen jemanden hegen",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der alte Mann <w>grollte</w> seiner Familie noch viele Jahre nach dem heftigen Streit."
                        },
                        {
                            "text": "Anstatt nach vorne zu schauen, <w>grollte</w> er unaufhörlich mit seinem bitteren Schicksal."
                        }
                    ],
                    "synonyms": [
                        "hadern",
                        "zürnen"
                    ],
                    "antonyms": [
                        "vergeben",
                        "versöhnen",
                        "verzeihen"
                    ],
                    "common_phrases": [
                        "jemandem lange grollen",
                        "mit dem Schicksal grollen"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "86b6af45-1299-3840-a703-9185d480d3bb",
                    "sense_definition": "tiefes, dumpfes und anhaltendes Geräusch, das beispielsweise bei Donner oder Explosionen entsteht",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "geraeusch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Plötzlich riss ein lautes <w>Grollen</w> die Bewohner des kleinen Bergdorfes mitten in der Nacht aus dem Schlaf."
                        },
                        {
                            "text": "Aus der Tiefe des Vulkans drang ein bedrohliches <w>Grollen</w> an die Oberfläche."
                        }
                    ],
                    "common_phrases": [
                        "ein dumpfes Grollen",
                        "ein fernes Grollen"
                    ]
                }
            ]
        }
    ]
}