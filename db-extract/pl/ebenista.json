                ],
                "senses": [
                    {
                        "sense_id": "67b03c1f-8fa7-3633-a062-7eca99ee7370",
                        "entry_id": "62309e34-7d16-32b6-88d6-48e164006c23",
                        "glosses": [
                            "stolarz-artysta, wytwórca mebli artystycznych"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b87130e1-e24c-4411-80bd-0f6110262613",
                                "sense_id": "67b03c1f-8fa7-3633-a062-7eca99ee7370",
                                "text": "Mój wuj jest ebenistą, który produkuje rzeźbione meble na specjalne zamówienia."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "c6babd75-3eb5-3571-bc44-5e4742ef5e5d",
                        "entry_id": "62309e34-7d16-32b6-88d6-48e164006c23",
                        "glosses": [
                            "stolarz wytwarzający w XVI w. we Francji meble skrzyniowe z hebanu, a w czasach baroku i klasycyzmu rzemieślnik o najwyższych umiejętnościach, operujący skomplikowanymi metodami zdobniczymi"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8dafdf4d-a500-413d-91ce-d3869af15534",
                                "sense_id": "c6babd75-3eb5-3571-bc44-5e4742ef5e5d",
                                "text": "Ebeniści stanowili odrębny od stolarzy zawód, a dekretem Ludwika XIV uzyskali prawo założenia pierwszego cechu."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d80603e0-e31a-4327-99f2-fc1acc9b1426",
                        "source_entry_id": "62309e34-7d16-32b6-88d6-48e164006c23",
                        "source_sense_id": "67b03c1f-8fa7-3633-a062-7eca99ee7370",
                        "target_lang_word": "ébéniste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ébéniste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cdb8ff2e-8699-34f7-92c7-c3fea303bb00",
                                        "entry_id": "e8539263-05ef-3579-9499-66f9d9171c18",
                                        "glosses": [
                                            "Ouvrier qui travaille en ébène et autres bois précieux pour en faire des meubles ou qui fait des ouvrages d’ébénisterie et de marqueterie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1fddebe4-a60c-4497-90f2-a34646b6d67b",
                                                "sense_id": "cdb8ff2e-8699-34f7-92c7-c3fea303bb00",
                                                "text": "C'est le bois d'ébène, une des premières essences exotiques utilisées au début du xviiᵉ siècle pour habiller les meubles qui donna son nom au terme ébéniste."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "31953e45-2a22-3546-9bae-5c6eacc76759",
                                        "entry_id": "e8539263-05ef-3579-9499-66f9d9171c18",
                                        "glosses": [
                                            "Menuisier, fabricant ou marchand de meubles de qualité ou de luxe."
                                        ],
                                        "tags": [
                                            "Plus courant"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6834df9f-d8e9-4330-af56-48a10d4fd8e4",
                                                "sense_id": "31953e45-2a22-3546-9bae-5c6eacc76759",
                                                "text": "D’un coup de manivelle, on escamote la bibliothèque, la table de lit ou le prie-Dieu. Une « table mécanique », conçue par le même ébéniste, se transforme en clin d’œil en support d’écriture ou en cabinet de toilette."
                                            },
                                            {
                                                "example_id": "280ee9e4-1fa5-49d2-be5b-d0de666455b9",
                                                "sense_id": "31953e45-2a22-3546-9bae-5c6eacc76759",
                                                "text": "— Camille-Eugène-Marie Dieudonné. Il a vingt-six ans, quand éclate l’affaire Bonnot. De métier, il est ouvrier ébéniste ; d’idées : anarchiste."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
