                        "target_lang_word": "Sattheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "b97e07b8-8767-4301-bd31-ee4fe44c5e2e",
                        "source_entry_id": "deb40e06-1c9c-329d-a00f-1fe2707b65ca",
                        "source_sense_id": "31040c0f-7958-30c3-9d50-3ae391b872ae",
                        "source_sense_description": "state of being perfectly satiated",
                        "target_lang_word": "Sättigung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sättigung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e05a0fd6-ce30-3f1e-8da8-30b27d16b380",
                                        "entry_id": "41e370b2-171b-30bf-aec5-a3644c9d5698",
                                        "glosses": [
                                            "Zustand, satt zu sein, also kein Bedürfnis zur Nahrungsaufnahme zu haben, Vorgang, jemanden satt zu machen"
                                        ],
                                        "tags": [
                                            "oder auch"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c44c9ec-7bf0-4e66-9254-d307bc83db62",
                                                "sense_id": "e05a0fd6-ce30-3f1e-8da8-30b27d16b380",
                                                "text": "Nach dem Essen verspürte ich eine angenehme Sättigung."
                                            },
                                            {
                                                "example_id": "ed209827-e16d-4958-a848-99cfa68cbc60",
                                                "sense_id": "e05a0fd6-ce30-3f1e-8da8-30b27d16b380",
                                                "text": "„Mittlerweile war Abendbrotzeit, die Sättigung der hungrigen Besucher stand.“"
                                            },
                                            {
                                                "example_id": "9c27a49b-1e66-4a62-84bb-f77595dc7784",
                                                "sense_id": "e05a0fd6-ce30-3f1e-8da8-30b27d16b380",
                                                "text": "„Mit seinem Todesruf stimmt Jesus in das messianische Gebet des großen Psalms der Leiden und Hoffnungen Israels ein, das in den Ausblick auf die Sättigung der Armen und die Bekehrung aller Enden der Erde zum Herrn mündet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "cd53ade6-a709-332f-9ff5-368bc56e3bf6",
                                        "entry_id": "41e370b2-171b-30bf-aec5-a3644c9d5698",
                                        "glosses": [
                                            "Zustand, bei dem eine so große Menge oder Anteil von etwas vorhanden ist, dass nicht mehr aufgenommen werden kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83bccbb2-503e-41ef-b790-0017061e3976",
                                                "sense_id": "cd53ade6-a709-332f-9ff5-368bc56e3bf6",
                                                "text": "„In einem Landschaftsbild werden Kontrast und die Sättigung der Farben erhöht.“"
                                            },
                                            {
                                                "example_id": "106e7b62-2304-41aa-81d2-816d9daba715",
                                                "sense_id": "cd53ade6-a709-332f-9ff5-368bc56e3bf6",
                                                "text": "„Das Pulsoxymeter zeigte bereits einen bedrohlichen Abfall der Sättigung des Blutes mit Sauerstoff.“"
                                            },
                                            {
                                                "example_id": "9133eb3d-3a28-4ee2-b6b8-ade10ac619a2",
                                                "sense_id": "cd53ade6-a709-332f-9ff5-368bc56e3bf6",
                                                "text": "„Für jede Temperatur gibt es ein Maximum an aufgenommenem Wasserdampf, das als maximale Sättigung der Luft bezeichnet wird.“"
                                            },
                                            {
                                                "example_id": "c8ae5bdd-24fe-48ae-833c-d4bbd4b71368",
                                                "sense_id": "cd53ade6-a709-332f-9ff5-368bc56e3bf6",
                                                "text": "„Allerdings bemerken die Energieberater/-innen auch eine allmähliche Sättigung des Marktes. Dies bezieht sich z. B. auf das Angebot der Weiterbildungen, von denen bundesweit fast schon zu viele vorhanden sind.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "68ac27a0-a15d-3cfb-9347-42928024ad91",
                                        "entry_id": "41e370b2-171b-30bf-aec5-a3644c9d5698",
                                        "glosses": [
                                            "Bildende Kunst, Farbintensivität"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6cf6ec06-158f-4afe-a1a6-9eaf6bd5d549",
                        "source_entry_id": "deb40e06-1c9c-329d-a00f-1fe2707b65ca",
                        "source_sense_id": "31040c0f-7958-30c3-9d50-3ae391b872ae",
                        "source_sense_description": "state of being perfectly satiated",
                        "target_lang_word": "Befriedigung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Befriedigung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5b6d259d-5f07-33f4-92cb-8a88d048afb7",
                                        "entry_id": "93d3022a-cd04-3e89-89ee-8f41f1765400",
                                        "glosses": [
                                            "Handlung, durch die die Wünsche und Ansprüche des Betreffenden erfüllt sind oder werden und Ergebnis dieser Handlung; Zufriedenstellung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3d9e3d8-4ea9-4683-b309-bf5a1bb72e4c",
                                                "sense_id": "5b6d259d-5f07-33f4-92cb-8a88d048afb7",
                                                "text": "Es geht hier natürlich um die Befriedigung seiner Machtbedürfnisse."
                                            },
                                            {
                                                "example_id": "b5105da3-90f3-49da-a04d-4acd313f99ca",
                                                "sense_id": "5b6d259d-5f07-33f4-92cb-8a88d048afb7",
                                                "text": "Wenn das Bedürfnis nach Liebe und Zuwendung nie einer Befriedigung erfährt, entsteht ein gefährlicher Druck."
                                            },
                                            {
                                                "example_id": "5d0a78e5-091d-4788-b376-b34af3462e4b",
                                                "sense_id": "5b6d259d-5f07-33f4-92cb-8a88d048afb7",
                                                "text": "„Ich fühle die größte Befriedigung, daß diese Begegnung so gut abgelaufen ist, und werde wieder ruhig.“"
                                            },
                                            {
                                                "example_id": "b97b0e08-790c-492b-a4a3-0c6b5af4be87",
                                                "sense_id": "5b6d259d-5f07-33f4-92cb-8a88d048afb7",
                                                "text": "„Und dankbaren Herzens wollen wir daran denken, wie viel nationale Befriedigung uns allen das gemeinsame Sammeln von Briefmarken vermitteln wird.“"
                                            },
                                            {
                                                "example_id": "1f7fa83e-7350-461a-931f-0b4a95190905",
                                                "sense_id": "5b6d259d-5f07-33f4-92cb-8a88d048afb7",
                                                "text": "„Ich überlege, wann mich überhaupt zum letzten Mal irgendetwas mit Befriedigung erfüllt hat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4b45e3c8-b4e6-37aa-9a36-1e053a627abc",
                                        "entry_id": "93d3022a-cd04-3e89-89ee-8f41f1765400",
                                        "glosses": [
                                            "die Erfüllung sexueller Wünsche"
                                        ],
                                        "tags": [
                                            "insbesondere sexuell"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "89c07e39-54bf-4144-9854-2d2e9f925373",
                                                "sense_id": "4b45e3c8-b4e6-37aa-9a36-1e053a627abc",
                                                "text": "„Die orale Befriedigung einer Frau ist wirklich eine Kunst, die nicht jeder beherrscht.“"
                                            },
                                            {
                                                "example_id": "de9af636-92d5-475b-b4d4-0e080f12e180",
                                                "sense_id": "4b45e3c8-b4e6-37aa-9a36-1e053a627abc",
                                                "text": "Im Mittelpunkt dieser Diskussion steht leider immer noch alleine die sexuelle Befriedigung des Mannes."
                                            },
                                            {
                                                "example_id": "99927a63-d894-4863-b90a-b5673c4e1b5b",
                                                "sense_id": "4b45e3c8-b4e6-37aa-9a36-1e053a627abc",
                                                "text": "„Etwas von der kostbaren Nacht mußte ja schließlich auch der Befriedigung des beiderseitigen stürmischen Liebesverlangens vorbehalten bleiben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
