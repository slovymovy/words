                "senses": [
                    {
                        "sense_id": "6a316e50-d1a6-3502-be4b-7d4234fc30f4",
                        "entry_id": "311f7124-0296-3f51-9363-46e02dbde8f3",
                        "glosses": [
                            "in Nordamerika verbreiteter Fisch aus der Ordnung der Welsartigen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f8c5f25-5308-4aab-ae70-2e248a0055df",
                                "sense_id": "6a316e50-d1a6-3502-be4b-7d4234fc30f4",
                                "text": "„Unter dem gleitenden Wasser Geschütze und Lafetten, im Schlick steckende und vor sich hin rostende Schildzapfen, zu Schleim verfaulte Kielboote. Fabelstöre mit fünfeckigen Hornleibern, kupfermünzhelle Karpfen und Katzenwelse mit bleichen und nahtlosen Bäuchen, dicker Schlamm, durchzogen von Glassplittern, Knochen und rostigen Dosen, von Geschirrstücken mit schmutzschwarzen netzartigen Haarrissen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "003c15d5-68f7-4352-98a9-2ae98c156aeb",
                        "source_entry_id": "311f7124-0296-3f51-9363-46e02dbde8f3",
                        "source_sense_id": "6a316e50-d1a6-3502-be4b-7d4234fc30f4",
