                "senses": [
                    {
                        "sense_id": "0ce98984-9c07-377e-86d3-c95e97b27cc1",
                        "entry_id": "ec0bfec3-5171-3ba3-bcb5-9c57d0fa14e9",
                        "glosses": [
                            "Donner un caractère constructif à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43a9c2a6-9cf6-4778-aa34-3fac88be94f2",
                                "sense_id": "0ce98984-9c07-377e-86d3-c95e97b27cc1",
                                "text": "Piaget se contente de prendre à Bourbaki ses structures sans tenter de les « constructiviser », de leur donner une interprétation constructive; c'est là l’approche formaliste ou structuraliste par opposition à l’attitude constructiviste."
                            },
                            {
                                "example_id": "f761c200-46b7-4f2d-b395-13f6a6610afb",
                                "sense_id": "0ce98984-9c07-377e-86d3-c95e97b27cc1",
                                "text": "Je voulais me contenter de ça mais vu que tu veux visiblement un commentaire constructif je vais te constructiviser."
                            }
                        ]
                    }
