                                    {
                                        "sense_id": "775b3583-7d49-3997-be5c-4c6fa8683057",
                                        "entry_id": "de9f6047-6a6b-307e-8bb6-19492b032cb1",
                                        "glosses": [
                                            "Anlage mit der Fähigkeit, durch eine Kabine Personen und Gegenstände vertikal zu befördern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9d970bd-568d-4a3e-a5b9-f6696356dbbc",
                                                "sense_id": "775b3583-7d49-3997-be5c-4c6fa8683057",
                                                "text": "Um in den 12. Stock zu gelangen, müssen Sie den Fahrstuhl nehmen."
                                            },
                                            {
                                                "example_id": "bcdc5fa4-e5d9-4ea4-83ff-2ea8de1ef994",
                                                "sense_id": "775b3583-7d49-3997-be5c-4c6fa8683057",
                                                "text": "„Endlich war der Fahrstuhl da.“"
                                            },
                                            {
                                                "example_id": "96eb0c20-0a2f-45d7-ad15-2fcaec4e2b1d",
                                                "sense_id": "775b3583-7d49-3997-be5c-4c6fa8683057",
                                                "text": "„Im Fahrstuhl sprach ihn ein Mädchen an.“"
                                            },
                                            {
                                                "example_id": "925c1e05-ba4c-4efd-a07b-97c20cf19d59",
                                                "sense_id": "775b3583-7d49-3997-be5c-4c6fa8683057",
                                                "text": "„Es gibt überall im Haus Geländer und Fahrstühle."
                                            },
                                            {
                                                "example_id": "951c5ec7-8e44-433c-9106-b808d605e323",
                                                "sense_id": "775b3583-7d49-3997-be5c-4c6fa8683057",
                                                "text": "„Nach weiteren zwei Stunden stieß ich auf einen Fahrstuhl.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
