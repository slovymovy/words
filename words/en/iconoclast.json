{
    "word_family": [
        "iconoclasm",
        "iconoclastic",
        "iconoclastically"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "703cf888-679d-3199-9bcd-a61da6a8713a",
                    "sense_definition": "A person who attacks or opposes widely accepted beliefs, traditional institutions, or established conventions.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "rebel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "As an <w>iconoclast</w> in the tech world, she consistently challenged prevailing ideas about data privacy."
                        },
                        {
                            "text": "The young artist gained fame as a cultural <w>iconoclast</w> who rejected traditional techniques."
                        }
                    ],
                    "synonyms": [
                        "maverick",
                        "rebel",
                        "nonconformist"
                    ],
                    "common_phrases": [
                        "cultural iconoclast",
                        "fierce iconoclast"
                    ]
                },
                {
                    "sense_id": "5f5c6d10-4d9d-3c60-8260-2c0c8702e5cf",
                    "sense_definition": "A person who destroys religious images, icons, or monuments, historically opposing their veneration.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "During the Reformation, every <w>iconoclast</w> sought to remove statues and stained glass from churches."
                        },
                        {
                            "text": "In the eighth century, an <w>iconoclast</w> would have vigorously opposed the veneration of sacred portraits."
                        }
                    ],
                    "synonyms": [
                        "image-breaker"
                    ],
                    "antonyms": [
                        "iconodule"
                    ]
                },
                {
                    "sense_id": "16d54642-163b-36ba-8d23-e4061ecf7dbb",
                    "sense_definition": "A person who actively opposes religious orthodoxy, established doctrine, or ecclesiastical authority.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He wrote articles attacking church dogma, earning a reputation as an outspoken religious <w>iconoclast</w>."
                        },
                        {
                            "text": "The local priest considered any open <w>iconoclast</w> a genuine threat to community harmony."
                        }
                    ],
                    "synonyms": [
                        "freethinker",
                        "heretic"
                    ],
                    "common_phrases": [
                        "religious iconoclast"
                    ]
                }
            ]
        }
    ]
}