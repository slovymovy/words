                "senses": [
                    {
                        "sense_id": "a5b3048e-f654-3540-8bac-365929a0d00e",
                        "entry_id": "fbb75fb4-af4b-3c05-b219-4f20f5176aba",
                        "glosses": [
                            "dünner, langer Körper aus Polymer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f29b3950-8a35-4830-a22f-5f99d28d190a",
                                "sense_id": "a5b3048e-f654-3540-8bac-365929a0d00e",
                                "text": "„Das Baumaterial ist ein Kunststofffaden, der über eine beheizte Düse geschmolzen und aufgeschichtet wird.“"
                            },
                            {
                                "example_id": "9e12abe5-44a3-4958-befe-6614bffb31d6",
                                "sense_id": "a5b3048e-f654-3540-8bac-365929a0d00e",
                                "text": "„Er drückt das Instrument mit dem elastischen Kunststofffaden hierzu senkrecht mit so viel Kraft auf die Fußsohle, bis der Faden gerade abknickt.“"
                            },
                            {
                                "example_id": "fe2e5a8d-d107-42a7-9aeb-6178e2803923",
                                "sense_id": "a5b3048e-f654-3540-8bac-365929a0d00e",
                                "text": "„Die Rollladenlaufschienen oder auch Rollladenführungsschienen sind mit einer Bürste und Kunststofffaden ausgestattet.“"
                            },
                            {
                                "example_id": "a5faa101-269f-4ad2-9475-0bee745ed544",
                                "sense_id": "a5b3048e-f654-3540-8bac-365929a0d00e",
                                "text": "„Ein Kunststofffaden (zum Beispiel aus Nylon) zwischen Gesamtschirm und Kabelmantel, mit dem auf einfache Weise der Kabelmantel entfernt werden kann: Den Faden mit einer Zange festhalten und im spitzen Winkel zurückziehen.“"
                            },
                            {
                                "example_id": "d0bc4902-58b1-46a6-ade6-4ae960f25327",
                                "sense_id": "a5b3048e-f654-3540-8bac-365929a0d00e",
                                "text": "„Der fertige Fußball besteht aus 32 Waben. Er wird mit einem gewachsten Kunststofffaden zusammengenäht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
