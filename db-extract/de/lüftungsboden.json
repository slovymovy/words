                ],
                "senses": [
                    {
                        "sense_id": "f3657514-fb9a-397d-b9de-4da1eedd0cf9",
                        "entry_id": "cbf9b679-a9f9-35a4-9573-f4fb421c5d06",
                        "glosses": [
                            "spezielle Fläche in, aus oder durch die Luft strömt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0a7d241-ca9b-487c-b74d-ac60e25bc0be",
                                "sense_id": "f3657514-fb9a-397d-b9de-4da1eedd0cf9",
                                "text": "„Die nach der Ernte noch relativ feuchten Hackschnitzel werden dann an zwei Biogasanlagen in Containern mit Lüftungsboden auf einen Restwassergehalt von ca. 10-15 % getrocknet und anschließend an die Endkunden weiterverkauft.“"
                            },
                            {
                                "example_id": "48f85b3f-42f2-4287-8ccc-16af4979cb03",
                                "sense_id": "f3657514-fb9a-397d-b9de-4da1eedd0cf9",
                                "text": "„Weitere Besonderheit: Die Tunnel erhalten teilweise einen Lüftungsboden (Spigot-Rohre).“"
                            },
                            {
                                "example_id": "c4668925-2cf8-4a19-a212-ed883d5e4612",
                                "sense_id": "f3657514-fb9a-397d-b9de-4da1eedd0cf9",
                                "text": "„Mit entscheidend für den Erfolg der gleichmäßigen Belüftung ist, neben der Luftleistung des Ventilators, auch der entsprechende Lüftungsquerschnitt und die richtige Anordnung der Luftschlitze in dem Lüftungsboden“"
                            },
                            {
                                "example_id": "e72adcd9-afb1-44c8-b106-fc4a50e92a2a",
                                "sense_id": "f3657514-fb9a-397d-b9de-4da1eedd0cf9",
                                "text": "„Dieser Boden ist fast baugleich mit dem Segeberger Normalboden, jedoch hat er einen Lüftungsboden, der ebenfalls durch die konische Einlegeplatte, die auch für den Wanderboden passt, verschlossen werden kann.“"
                            },
                            {
                                "example_id": "7fbfdde0-d742-425b-a847-a1c356c165ab",
                                "sense_id": "f3657514-fb9a-397d-b9de-4da1eedd0cf9",
                                "text": "„Nach Räumung des Doppelbodens wird die Holzkonstruktion adaptiert, wenn notwendig brandtechnisch und konstruktiv technisch aufgerüstet, dann der Doppelboden in neuer Konfiguration als Lüftungsboden wieder aufgebaut.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
