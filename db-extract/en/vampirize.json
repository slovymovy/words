                        "translation_id": "10b99a7c-03c5-4279-b9c6-2f7c428474ed",
                        "source_entry_id": "a221010c-4c58-327c-a9a3-dd48cc74003c",
                        "source_sense_description": "to make into a vampire",
                        "target_lang_word": "vampiriser",
