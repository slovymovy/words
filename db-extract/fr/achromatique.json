        "fr-extract.jsonl": [
            {
                "entry_id": "95ed2581-e3cf-37ff-b0bf-fe04175bd2af",
                "word": "achromatique",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b5a321d7-efab-460d-b63d-18e8ae348511",
                        "entry_id": "95ed2581-e3cf-37ff-b0bf-fe04175bd2af",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "achromatiques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "297c7537-c7f5-3222-a1cd-a85bcfdaa8cb",
                        "entry_id": "95ed2581-e3cf-37ff-b0bf-fe04175bd2af",
                        "glosses": [
                            "Qui fait disparaître les irisations produites par certains verres de lunettes."
                        ],
                        "tags": [
                            "Optique"
                        ],
                        "examples": [
                            {
                                "example_id": "691b708a-aefe-498a-94d9-07954d5ae7f8",
                                "sense_id": "297c7537-c7f5-3222-a1cd-a85bcfdaa8cb",
                                "text": "Lunettes achromatiques."
                            },
                            {
                                "example_id": "33f75818-e91b-4efc-b046-7bbe77b61201",
                                "sense_id": "297c7537-c7f5-3222-a1cd-a85bcfdaa8cb",
                                "text": "Après avoir disposé un système de lentilles capable de rendre mon œil achromatique, je n’ai pas trouvé que la netteté de ma vision en fût sensiblement augmentée."
                            }
                        ]
                    },
                    {
                        "sense_id": "de219bf6-90f8-31f6-8e4b-d55a074f9edb",
                        "entry_id": "95ed2581-e3cf-37ff-b0bf-fe04175bd2af",
                        "glosses": [
                            "Sans préjugé."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "d2ec7967-9f60-4bd5-95f9-62b55dd03ef6",
                                "sense_id": "de219bf6-90f8-31f6-8e4b-d55a074f9edb",
                                "text": "Descartes m’avait enseigné que la première condition pour trouver la vérité est de n’avoir aucun parti pris. L’œil complètement achromatique est seul fait pour apercevoir la vérité dans l’ordre philosophique, politique et moral."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b870c7b1-d39f-4510-b538-690bd5e3d28b",
                        "source_entry_id": "95ed2581-e3cf-37ff-b0bf-fe04175bd2af",
                        "target_lang_word": "achromatisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "achromatisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ce4d821c-901d-3eab-97eb-a264e23b9edf",
                                        "entry_id": "beca3471-50fe-38ba-b868-d5cee97e649a",
                                        "glosses": [
                                            "den Effekt unterschiedlicher Brechung von Lichtstrahlen verschiedener Wellenlänge korrigierend"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "085a65cb-5025-40a1-ab42-7401e926e59a",
                                                "sense_id": "ce4d821c-901d-3eab-97eb-a264e23b9edf",
                                                "text": "Achromatische Linsen mit Antireflex-Vergütung erzeugen ein bis zum Rand hin scharfes und kontrastreiches Bild."
                                            },
                                            {
                                                "example_id": "52b9622b-669f-4974-b409-55be94d4d1f1",
                                                "sense_id": "ce4d821c-901d-3eab-97eb-a264e23b9edf",
                                                "text": "Zum Beispiel Adalbert Stifter, in dessen,Feldblumen’ zur idealen Wohnungseinrichtung nicht nur ein achromatisches Fernrohr gehört, sondern sogar ‚Rechen’-, also Logarithmen-Tafeln."
                                            },
                                            {
                                                "example_id": "799fb537-b8c5-40a6-8676-7aa264f9441a",
                                                "sense_id": "ce4d821c-901d-3eab-97eb-a264e23b9edf",
                                                "text": "Linsensysteme, die von beiden Arten der Farbfehler frei sind, bezeichnet man als stabil-achromatisch."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6ade3160-2bab-4aa6-a60f-e99070df37a2",
