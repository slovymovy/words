                        "cross_references": [
                            {
                                "target_word": "vexillologie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f7c3fef5-bf3c-36d9-a099-6ccdbd961e9a",
                                        "entry_id": "ee13bb40-fbe8-37b1-9e7c-b1301ade8d0b",
                                        "glosses": [
                                            "Branche de l’histoire qui étudie les drapeaux, bannières, étendards, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3fa2901-cc7d-4543-a5db-f23850f67115",
                                                "sense_id": "f7c3fef5-bf3c-36d9-a099-6ccdbd961e9a",
                                                "text": "Quoi qu'il en soit, les drapeaux proprement dits n’ont pas encore suscité un tel regain d’intérêt et cette situation explique pourquoi la discipline dont ils font l’objet, la vexillologie, n’a nulle part trouvé de statut scientifique."
                                            },
                                            {
                                                "example_id": "34adee1e-f326-48ef-9b55-07e5f57ed723",
                                                "sense_id": "f7c3fef5-bf3c-36d9-a099-6ccdbd961e9a",
                                                "text": "L’homme de la rue se représente l’amateur de vexillologie forcément âgé et probablement militaire ou ayant un penchant pour tout ce qui touche à l’art militaire. Cette image est fausse et vraie en même temps."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dba25bdf-005f-4143-8916-96e92b646359",
