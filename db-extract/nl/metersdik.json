                        "glosses": [
                            "van iets dat het een dikte heeft van enkele meters; heel erg dik"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e2f69304-bd7e-4792-8c34-b79eaa39f69a",
                                "sense_id": "aca64378-f9ff-363d-aadd-055da0d558c8",
                                "text": "Zo'n 70 mensen moeten Kerstmis noodgedwongen doorbrengen in metersdik ijs bij Antarctica. Hun schip de MV Akademik Shokalskiykan zit gevangen tussen de ijsschotsen. Het duurt zeker twee dagen voordat een ijsbreker te plekke is."
                            },
                            {
                                "example_id": "db5cfda4-80f1-4df3-97c5-73ce49fee3f7",
                                "sense_id": "aca64378-f9ff-363d-aadd-055da0d558c8",
                                "text": "Rijen aan gigantische villa’s, zo groot als vijfsterrenhotels en ommuurd door metersdik beton, flitsen voorbij wanneer we de peperdure wijk Hyde Park passeren."
                            },
                            {
                                "example_id": "f182d160-7fb1-477e-96cf-84f28756b2bb",
                                "sense_id": "aca64378-f9ff-363d-aadd-055da0d558c8",
                                "text": "Nog meer wild hangt verveeld aan de muren van Kasteel Roosendael. Nee, dan de metersdikke muren en gigantische gewelven van de donjon uit de 14e eeuw – daar worden we weer helemaal blij van. Net als van de schattige Bedriegertjes-fonteinen in de tiptop verzorgde tuin."
                            }
                        ]
                    }
