                "senses": [
                    {
                        "sense_id": "8d156e86-5252-3683-b609-6fdf402ea713",
                        "entry_id": "4291bc49-a3b0-3083-af31-87ad0e3352ff",
                        "glosses": [
                            "oberste Kolonialbehörde und wichtigstes Verwaltungsorgan des spanischen Kolonialreichs"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "6e58403f-0e21-4b99-a8bc-5e67872b45b2",
                                "sense_id": "8d156e86-5252-3683-b609-6fdf402ea713",
                                "text": "„Dazu schloss sie Verträge (capitulaciones/asientos) ab, richtete 1503 die Casa de la contratación - eine Behörde zur Organisation des kolonialen Austausches von Waren, Menschen und Schiffen im Monopolhafen Sevilla - sowie 1524 den Indienrat (real y supremo consejo de las Indias) am umherziehenden Hof ein, und erließ eigene Gesetze frü Spanisch-Amerika (derecho indiano).“"
                            },
                            {
                                "example_id": "9a53b2c6-6bb4-4cfe-8ab4-02a2079bc214",
                                "sense_id": "8d156e86-5252-3683-b609-6fdf402ea713",
                                "text": "„Eine Schlüsselrolle dabei sollte der Präsident des Indienrats Juan Rodríguez de Fonseca, Bischof von Burgos und Vertrauter des Gouverneurs, spielen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
