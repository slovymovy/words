                "senses": [
                    {
                        "sense_id": "e12e5f60-9b17-3d32-ac43-ec7b4bf9b352",
                        "entry_id": "01cd50eb-7434-3f06-8ecf-b414d86d43e3",
                        "glosses": [
                            "филос. суждение, противопоставленное тезису"
                        ],
                        "tags": [],
