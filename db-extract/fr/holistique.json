                "forms": [
                    {
                        "form_id": "7681b3d8-b77c-438e-8a9a-4c3a0cb9d6e4",
                        "entry_id": "4185b573-e557-3030-903f-fbb384068e64",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "holistiques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0b4e71ff-53fe-3720-847c-eac63ea837fe",
                        "entry_id": "4185b573-e557-3030-903f-fbb384068e64",
                        "glosses": [
                            "Qui relève de l’holisme, considérant l’objet comme constituant d'un tout."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d694ddd-55e6-4fdd-8cb2-d977d83d70d1",
                                "sense_id": "0b4e71ff-53fe-3720-847c-eac63ea837fe",
                                "text": "[…] Conformément au mode de raisonnement holistique privilégié par les intellectuels français, le déclin est lui-même accepté comme un fait acquis puis expliqué par des concepts plus généraux : la nature humaine, l'économie, la culture ou la race."
                            },
                            {
                                "example_id": "f8052003-87d7-43de-94f5-52b1f4348dc3",
                                "sense_id": "0b4e71ff-53fe-3720-847c-eac63ea837fe",
                                "text": "Le chamanisme, a constaté M. Liogier, a également l’avantage de se présenter comme « une médecine holistique soignant l’esprit et le corps en même temps », et favorisant donc toutes « les pratiques spontanéistes pour se retrouver, s’exprimer, lever ses blocages »."
                            },
                            {
                                "example_id": "9f08148b-472f-4fec-bc85-c5ccf31f89e7",
                                "sense_id": "0b4e71ff-53fe-3720-847c-eac63ea837fe",
                                "text": "En 2008, le cours ECR était un compromis de transition. Il existe maintenant un large consensus pour le faire disparaître et passer à une formation plus holistique."
                            },
                            {
                                "example_id": "2f7a7dee-709d-4ddd-8aa8-e8a1ac71fa00",
                                "sense_id": "0b4e71ff-53fe-3720-847c-eac63ea837fe",
                                "text": "Des normes environnementales à la protection des consommateurs, la Commission a élaboré une stratégie « holistique » pour s’attaquer à la vague d’importations des grandes plateformes de commerce en ligne, selon un projet consulté par Euractiv."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fbaee361-0896-4d54-bb5e-d252b84827ed",
                        "source_entry_id": "4185b573-e557-3030-903f-fbb384068e64",
                        "source_sense_id": "0b4e71ff-53fe-3720-847c-eac63ea837fe",
                        "target_lang_word": "ganzheitlich",
