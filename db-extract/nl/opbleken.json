                        "examples": [
                            {
                                "example_id": "92a951eb-84f3-4d35-8f0d-b7ade7d34bc1",
                                "sense_id": "6b7d12c3-5e2c-3504-9ff2-9d1ad8c18f8d",
                                "text": "Het koraalrif in de wereld is aan het opbleken. Volgens wetenschappers kan tot 38 procent van het koraalrif daardoor worden geraakt. De Amerikaanse en Australische onderzoekers zeggen dat het opbleken een gevolg is van hogere temperaturen in de oceaan. Daardoor zou meer dan 12.000 vierkante kilometer rif verloren kunnen gaan, meldt de krant Brisbane Times."
                            }
                        ]
