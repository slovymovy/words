                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tijdens de vakantie heb ik veel mooie <w>foto's</w> gemaakt.",
                            "target_lang_translations": {
                                "en": "I took many beautiful <w>photos</w> during the vacation.",
                                "ru": "Во время отпуска я сделал много красивых <w>фотографий</w>.",
                                "pl": "Podczas wakacji zrobiłem dużo ładnych <w>zdjęć</w>.",
                                "de": "Im Urlaub habe ich viele schöne <w>Fotos</w> gemacht.",
                                "fr": "Pendant les vacances, j'ai pris beaucoup de belles <w>photos</w>.",
                                "it": "Durante le vacanze ho fatto molte belle <w>foto</w>.",
                                "cs": "Během dovolené jsem pořídil spoustu krásných <w>fotek</w>.",
                                "tr": "Tatil sırasında birçok güzel <w>fotoğraf</w> çektim.",
                                "es": "Durante las vacaciones tomé muchas <w>fotos</w> hermosas."
                            }
                        },
                        {
                            "text": "Op deze oude <w>foto</w> kun je mijn grootouders zien.",
                            "target_lang_translations": {
                                "en": "You can see my grandparents in this old <w>photo</w>.",
                                "ru": "На этой старой <w>фотографии</w> можно увидеть моих бабушку и дедушку.",
                                "pl": "Na tym starym <w>zdjęciu</w> możesz zobaczyć moich dziadków.",
                                "de": "Auf diesem alten <w>Foto</w> kann man meine Großeltern sehen.",
                                "fr": "Sur cette ancienne <w>photo</w>, tu peux voir mes grands-parents.",
                                "it": "In questa vecchia <w>foto</w> puoi vedere i miei nonni.",
                                "cs": "Na této staré <w>fotografii</w> můžete vidět mé prarodiče.",
                                "tr": "Bu eski <w>fotoğrafta</w> büyükanne ve büyükbabamı görebilirsin.",
                                "es": "En esta vieja <w>foto</w> puedes ver a mis abuelos."
                            }
                        }
                    ],
