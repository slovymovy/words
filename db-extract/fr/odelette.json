                    {
                        "sense_id": "38086616-d2d4-35f4-b971-cc9a1b9b5c65",
                        "entry_id": "96edbc43-59f5-3a47-9bbc-f55f15d9269b",
                        "glosses": [
                            "Petite ode du genre gracieux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d32d0ab-25a4-46e6-93ef-baa875222e8c",
                                "sense_id": "38086616-d2d4-35f4-b971-cc9a1b9b5c65",
                                "text": "C’était une odelette amoureuse qu’un amant adressait à la femme qui régnait sur son cœur."
                            },
                            {
                                "example_id": "b79ee036-6e60-4599-9f34-54886a2efe3b",
                                "sense_id": "38086616-d2d4-35f4-b971-cc9a1b9b5c65",
                                "text": "Et, du samedi soir au dimanche matin, il enfouissait sa grosse tête dans la généreuse chevelure mordorée de celle qu’il avait dans la peau, et lui susurrait de odelettes galantes comme si jamais les nuages algériens n’étaient venus voiler le pur soleil de son amour."
                            }
                        ]
                    }
                ],
