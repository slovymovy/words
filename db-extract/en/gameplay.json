                                "target_senses": [
                                    {
                                        "sense_id": "0e46bea6-7132-33ef-9867-0f7ea554715d",
                                        "entry_id": "9d729859-3069-31f8-984e-8db4ec00665b",
                                        "glosses": [
                                            "Ensemble des possibilités d’action offertes au joueur par un jeu vidéo."
                                        ],
                                        "tags": [
                                            "Jeux vidéo"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "63efff07-9fa5-437c-b3ba-400ae25a5371",
                                                "sense_id": "0e46bea6-7132-33ef-9867-0f7ea554715d",
                                                "text": "Il cartonne depuis des années en raison de son excellente jouabilité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "51343a87-60d1-39d6-a469-1430402e1ff7",
                                        "entry_id": "9d729859-3069-31f8-984e-8db4ec00665b",
                                        "glosses": [
                                            "Qualité du jeu appréciée au regard de ces possibilités."
                                        ],
                                        "tags": [
                                            "Jeux vidéo"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e803423-8abe-4678-8026-21df2f1482d5",
                                                "sense_id": "51343a87-60d1-39d6-a469-1430402e1ff7",
                                                "text": "À cela s’ajoute la mauvaise jouabilité, qui rend les combats imprécis et le stylet impraticable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be77a59a-9bea-34bf-bda5-4161cd26d74f",
                                        "entry_id": "9d729859-3069-31f8-984e-8db4ec00665b",
                                        "glosses": [
                                            "Capacité d’un logiciel de jeu à être facilement pratiqué, grâce à l’ergonomie et la maniabilité de ses commandes, et à la fluidité de ses enchaînements."
                                        ],
                                        "tags": [
                                            "Jeux vidéo"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "96af4f02-2090-43f1-9222-2de329028b61",
                                                "sense_id": "be77a59a-9bea-34bf-bda5-4161cd26d74f",
                                                "text": "Comme dans tout jeu, la \"jouabilité\" est la base du plaisir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "91065995-ac9f-3b3c-9203-4b93d7590133",
                                        "entry_id": "9d729859-3069-31f8-984e-8db4ec00665b",
                                        "glosses": [
                                            "Plaisir à jouer."
                                        ],
                                        "tags": [
                                            "Jeux vidéo"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9c1b5b75-5702-44ff-a595-32f791ac7238",
                        "source_entry_id": "5f34d2e3-298b-366c-9b1b-7c93d6765ecd",
                        "source_sense_id": "bd278e0f-31ec-36c8-80a9-b94dfd306add",
                        "source_sense_description": "player's gaming experience",
                        "target_lang_word": "gameplay",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gameplay",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b84726cc-932b-3e6f-919d-982c1b6fd47f",
                                        "entry_id": "19733bf9-cf4a-3d6e-980d-743833feeacc",
                                        "glosses": [
                                            "Expérience vécue du joueur qui joue à un jeu vidéo ou à un jeu de société."
                                        ],
                                        "tags": [
                                            "Anglicism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "577b01fa-f565-4069-856f-3b1c4e60d82f",
                                                "sense_id": "b84726cc-932b-3e6f-919d-982c1b6fd47f",
                                                "text": "Étonnamment, Konami préfère reprendre le gameplay du titre de Namco, en plus détendu et plus fun, plutôt que celui de sa licence phare Contra (1987)."
                                            },
                                            {
                                                "example_id": "da8bf60c-7cde-4109-8161-9b1e04a94367",
                                                "sense_id": "b84726cc-932b-3e6f-919d-982c1b6fd47f",
                                                "text": "La ludologie mise quant à elle sur les mécaniques de gameplay pour faire passer les messages. L'interactivité est riche, mais peut-être s'opère-t-elle au détriment de la qualité de l'interprétation du message."
                                            },
                                            {
                                                "example_id": "c29950e4-4e13-404b-8af8-d2a253721f0c",
                                                "sense_id": "b84726cc-932b-3e6f-919d-982c1b6fd47f",
                                                "text": "Ce qui compte dans un Super Mario, c’est le fun procuré par le gameplay, assure Florent Gorges."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a7fc2a48-acd6-3fd5-86bf-2027a458898b",
                                        "entry_id": "19733bf9-cf4a-3d6e-980d-743833feeacc",
                                        "glosses": [
                                            "Tous les éléments qui donnent le résultat d'un jeu."
                                        ],
                                        "tags": [
                                            "Anglicism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b450a1dc-4288-4171-9ca5-c5640e7fbda7",
                                                "sense_id": "a7fc2a48-acd6-3fd5-86bf-2027a458898b",
                                                "text": "Un bon gameplay !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f7b4f099-c0f1-4d12-96e4-eecc7475e784",
                        "source_entry_id": "5f34d2e3-298b-366c-9b1b-7c93d6765ecd",
                        "source_sense_id": "bd278e0f-31ec-36c8-80a9-b94dfd306add",
                        "source_sense_description": "player's gaming experience",
                        "target_lang_word": "Spielablauf",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Spielablauf",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ac75f835-6cd5-3ce1-9b2b-a6565498f1c5",
                                        "entry_id": "ee7c96e8-b629-3599-b406-49944995fc23",
                                        "glosses": [
                                            "zeitlicher und aktionaler Verlauf eines Spielgeschehens"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "318b4543-f204-44ac-83b9-92e24c383e27",
                                                "sense_id": "ac75f835-6cd5-3ce1-9b2b-a6565498f1c5",
                                                "text": "„Es bestätigt sich auch für das Regelspiel, dass der Spielablauf im wesentlichen nicht durch das Festhalten an einer durchgehenden Gestaltungslinie bedingt ist.“"
                                            },
                                            {
                                                "example_id": "365cd7ee-204d-4948-9f42-d9a1e6e19c6e",
                                                "sense_id": "ac75f835-6cd5-3ce1-9b2b-a6565498f1c5",
                                                "text": "„Meistens gründen sie mit ihrem Master Digitale Medien eigene Start-up-Unternehmen im Bereich Webdesign, kümmern sich um die Visual Effects bei Film- und Werbeproduktionen, erstellen Computersimulationen oder steigen in die lukrative Computerspiel-Branche ein – dort entwickeln und animieren sie die Spielfiguren und programmieren den gesamten Spielablauf.“"
                                            },
                                            {
                                                "example_id": "d558ac31-b0b3-4b9b-8f0b-8d0dece4cd94",
                                                "sense_id": "ac75f835-6cd5-3ce1-9b2b-a6565498f1c5",
                                                "text": "„Wenn wir uns allerdings vor Augen führen, was Spielen alles vom Spielenden verlangt, […] dann wird einsichtig, dass beim Spielen auch Schwierigkeiten entstehen können, dass also nicht jeder Spielablauf unproblematisch ist.“"
                                            },
                                            {
                                                "example_id": "63c5ae0d-968f-4753-b40e-e1a40ab6d912",
                                                "sense_id": "ac75f835-6cd5-3ce1-9b2b-a6565498f1c5",
                                                "text": "„Deshalb sehe ich das nicht als Belastung und auch nicht als unnötigen Test, sagte Labbadia, der in bisher vier intensiven Arbeitstagen viel Wert auf Geschlossenheit, taktische Disziplin, mehr Dynamik und schnelle Spielabläufe gelegt hat.“"
                                            },
                                            {
                                                "example_id": "c51a2cb7-9fcb-46cd-a262-17a411b4bfc7",
                                                "sense_id": "ac75f835-6cd5-3ce1-9b2b-a6565498f1c5",
                                                "text": "„Es ging nur noch um die Sicherheit unserer Spieler, ein regulärer Spielablauf war nicht mehr möglich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
