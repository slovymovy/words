                        "cross_references": [
                            {
                                "target_word": "amulet",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "1301e3b7-c5ec-3c4d-8fe0-8018245ce349",
                                        "entry_id": "2db35b15-1a71-355d-9369-6c1d326482ee",
                                        "glosses": [
                                            "menší předmět, jenž má magicky ochraňovat svého nositele nebo mu jinak pomáhat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc4c4786-8739-4649-b2a8-707855ea515c",
                                                "sense_id": "1301e3b7-c5ec-3c4d-8fe0-8018245ce349",
                                                "text": "Mince s vyobrazením sv. Jiří na koni v boji s drakem (mansfeldský jiřský tolar) byly všeobecně oblíbeným amuletem vojáků, ochraňovaly před zraněním."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "50608d62-7bba-49ef-8f02-d50191244484",
                        "source_entry_id": "f141ed70-fc9c-3d2b-a7ee-c8790fbef44f",
                        "source_sense_id": "8b9e1dfe-3a24-3284-ac69-4b7f8457b15c",
                        "target_lang_word": "amulette",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "amulette",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "77257128-c881-31b4-a882-36758b990942",
                                        "entry_id": "68fc5946-7fba-3875-a6c7-919116e2e7a9",
                                        "glosses": [
                                            "Objet censé protéger par magie, protéger contre des sorts, éviter des malheurs ; généralement, il faut pour cela le porter sur soi."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab98ddea-81bd-4e22-9400-29783920cf44",
                                                "sense_id": "77257128-c881-31b4-a882-36758b990942",
                                                "text": "Parmi les autres véhicules, le pick-up se distinguait du troupeau comme un animal issu des âges préhistoriques fascinant immédiatement les quelques gamins embarqués, yeux grands ouverts, attirés par cette chose ferrailleuse, imposante comme une armure d’iguanodon agrémentée d’amulettes en plastoc."
                                            },
                                            {
                                                "example_id": "8877987d-19c6-40ae-b7b2-f87d57e276ae",
                                                "sense_id": "77257128-c881-31b4-a882-36758b990942",
                                                "text": "Oh ! j'ai toujours sur moi avec mes amulettes la lettre que m'avait apportée le lieutenant Chaâmbi !"
                                            },
                                            {
                                                "example_id": "b875a434-8ef9-4d2d-9634-e25985169811",
                                                "sense_id": "77257128-c881-31b4-a882-36758b990942",
                                                "text": "Son visage était caché par le long voile garni de plaquettes de métal, sa tête serrée dans un foulard rouge bordé d'amulettes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
