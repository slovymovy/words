                    }
                ],
                "senses": [
                    {
                        "sense_id": "967dbea6-229b-330d-8f4d-86e0463ec79b",
                        "entry_id": "072eb5bc-978b-344e-a1ef-706e3a5c1c50",
                        "glosses": [
                            "Construire en commun."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a4737d1-910e-45b4-86ad-e131741b2112",
                                "sense_id": "967dbea6-229b-330d-8f4d-86e0463ec79b",
                                "text": "Co-inventer, co-concevoir, co-construire l’accompagnement en formation"
                            },
                            {
                                "example_id": "7f873232-faf4-4825-af73-689fac608f3f",
                                "sense_id": "967dbea6-229b-330d-8f4d-86e0463ec79b",
                                "text": "Il s'agit par contre de souligner sa difficulté à co-construire une représentation du monde dans l’échange intersubjectif."
                            },
                            {
                                "example_id": "8721abe7-4133-4d2c-8653-1d47094a6543",
                                "sense_id": "967dbea6-229b-330d-8f4d-86e0463ec79b",
                                "text": "Il est indispensable de co-construire et de co-actualiser avec les patients (et proches) et les professionnels de santé hospitaliers et libéraux ces dispositifs et leurs modalités de mise en œuvre."
                            }
                        ]
                    }
