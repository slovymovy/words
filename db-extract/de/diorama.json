                        "source_entry_id": "5839a879-396f-36b9-9e02-d7de0a1e03a9",
                        "source_sense_id": "c560ce9e-cac2-36b9-885f-c58d5dda7b32",
                        "source_sense_description": "stehender Schaukasten, in dem mit Modellfiguren und -landschaften dargestellt werden",
                        "target_lang_word": "diorama",
