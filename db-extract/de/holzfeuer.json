                "senses": [
                    {
                        "sense_id": "0360269f-6a0d-3ab9-a673-5bf6b4f40e1e",
                        "entry_id": "b5b548aa-429f-3808-ae7c-8ca21d03692b",
                        "glosses": [
                            "Feuer, das durch Verbrennen von Holz entfacht wurde und mit diesem unterhalten wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "012318c4-4a7c-43e5-821d-4ccf857f45f1",
                                "sense_id": "0360269f-6a0d-3ab9-a673-5bf6b4f40e1e",
                                "text": "„Der Aprilabend war kalt, und das Holzfeuer war keine Dekoration, sondern eine Notwendigkeit.“"
                            },
                            {
                                "example_id": "dbf0508a-30ca-4c6d-a3d2-d1e8ec98474e",
                                "sense_id": "0360269f-6a0d-3ab9-a673-5bf6b4f40e1e",
                                "text": "„Die Bereitung des Mate für den Gebrauch beschränkt sich in Paraguay im Wesentlichen auf einen mehrtägigen Röstvorgang, welcher durch ein unter den frisch gesammelten Zweigen unterhaltenes Holzfeuer bewirkt wird.“"
                            },
                            {
                                "example_id": "00d7a005-af77-4ad6-bcd7-c529113e6245",
                                "sense_id": "0360269f-6a0d-3ab9-a673-5bf6b4f40e1e",
                                "text": "„Unsere Leute warteten, um ein Holzfeuer hockend, bei den Baracken auf uns.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5d5c5f92-f349-4063-a703-281b8735cd50",
                        "source_entry_id": "b5b548aa-429f-3808-ae7c-8ca21d03692b",
                        "source_sense_id": "0360269f-6a0d-3ab9-a673-5bf6b4f40e1e",
                        "source_sense_description": "Feuer, das durch Verbrennen von Holz entfacht wurde und mit diesem unterhalten wird",
                        "target_lang_word": "bois de chauffage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bois de chauffage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "91783f41-0ba9-3be5-b4f0-b2224f457c99",
                                        "entry_id": "53347ea6-1fa3-31ca-af19-42b49c314a0b",
                                        "glosses": [
                                            "Bois destiné à être brûlé pour le chauffage d’une habitation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4eba00c2-26ac-470e-9bca-048881f6739b",
                                                "sense_id": "91783f41-0ba9-3be5-b4f0-b2224f457c99",
                                                "text": "Il n'était plus exilé dans la petite maison en ruines du Rialto, réduit à transporter du bois de chauffage dans sa gondole rapiécée, en danger perpétuel de pécher seul par la faute des rouées qui ne sont même pas encore filles mais qui coquinent comme si elles l'étaient."
                                            },
                                            {
                                                "example_id": "85c6a464-f862-429d-af89-18e13f0ac986",
                                                "sense_id": "91783f41-0ba9-3be5-b4f0-b2224f457c99",
                                                "text": "Cela peut donc ensuite servir de bois de chauffage, d’agro-carburant ou encore de matériau de construction."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
