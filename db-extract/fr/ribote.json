        "fr-extract.jsonl": [
            {
                "entry_id": "bd511f67-216c-38b8-b866-d84926ae172c",
                "word": "ribote",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "2f95226a-a1c2-4559-9775-3e6edc4e29df",
                        "entry_id": "bd511f67-216c-38b8-b866-d84926ae172c",
                        "tags": [
                            "plural"
                        ],
                        "form": "ribotes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4b288bf3-11b9-3f15-ab26-415d40f317d3",
                        "entry_id": "bd511f67-216c-38b8-b866-d84926ae172c",
                        "glosses": [
                            "Débauche, excès de table ou de boisson."
                        ],
                        "tags": [
                            "colloquial",
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "091b071e-667b-4e53-8fde-f5f77618b017",
                                "sense_id": "4b288bf3-11b9-3f15-ab26-415d40f317d3",
                                "text": "Dehors, le froid, la faim, l’homme en ribote :\n C’est bon. Encore une heure ; après, les maux sans noms !"
                            },
                            {
                                "example_id": "0ff4853a-f1d5-4e9c-91c2-9f399b26a8af",
                                "sense_id": "4b288bf3-11b9-3f15-ab26-415d40f317d3",
                                "text": "Un vigneron de l’endroit, nommé Garrigue, sans doute un descendant de Garrigou, m’a affirmé qu’un soir de Noël, se trouvant un peu en ribote, il s’était perdu dans la montagne du côté de Trinquelage."
                            },
                            {
                                "example_id": "744e4dee-1cdb-40ba-8040-e94a3348cd9a",
                                "sense_id": "4b288bf3-11b9-3f15-ab26-415d40f317d3",
                                "text": "Tout ce monde jouait aux quilles, s’empilait aux tables d’auberge, s’enivrait en de fastueuses ribotes."
                            },
                            {
                                "example_id": "bf7501ac-05dd-4a43-94b5-b01266571905",
                                "sense_id": "4b288bf3-11b9-3f15-ab26-415d40f317d3",
                                "text": "— En ce moment, vous pouvez parler : vous n’êtes pas de force. Si j’avais du vin, je ne dis pas… En ribote, je ne regarde pas toujours qui j’ai devant moi."
                            },
                            {
                                "example_id": "20a7cea4-9628-4306-9f64-40285e5c9e96",
                                "sense_id": "4b288bf3-11b9-3f15-ab26-415d40f317d3",
                                "text": "Il y eut, chez les plus fortunés de ses amis, le festin, le balthazar, la ripaille, la ribote, la bombance, la grande bouffe avec, en point d'orgue, une langouste sauce thermidor à se lécher tous les doigts de la main."
                            },
                            {
                                "example_id": "bc9df8ca-a218-414d-95cf-98fb3347ff1e",
                                "sense_id": "4b288bf3-11b9-3f15-ab26-415d40f317d3",
                                "text": "Ils se tutoyaient, partaient parfois en ribote ensemble et ne s’étaient jamais sauté à la gueule, ni l’un ni l’autre."
                            }
                        ]
                    },
                    {
                        "sense_id": "26d54e91-e40a-39b4-834d-e41fb77eeedf",
                        "entry_id": "bd511f67-216c-38b8-b866-d84926ae172c",
                        "glosses": [
                            "Réunion, fête mondaine avec épouse ou amis dans le monde des officiers de Marine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd25677f-e334-4331-bb99-67f294541ad4",
                                "sense_id": "26d54e91-e40a-39b4-834d-e41fb77eeedf",
                                "text": "Pendant que le reste de l’équipage s’égaillait dans la ville pour faire ribote, Jaromir avait mis Pfefferkorn dans un taxi et l’avait accompagné à l’hôpital le plus proche, où il se fit enregistrer sous un faux nom."
                            }
                        ]
                    },
                    {
                        "sense_id": "ba818659-b959-343f-83c5-0cdfb81dcd2d",
                        "entry_id": "bd511f67-216c-38b8-b866-d84926ae172c",
                        "glosses": [
                            "Sortie des membres d’un carré."
                        ],
                        "tags": [
                            "France"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "479d83b5-4adf-3270-8b99-46496b8ee984",
                        "entry_id": "bd511f67-216c-38b8-b866-d84926ae172c",
                        "glosses": [
                            "Fête de fin de travaux des champs."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "e19a7f93-00f6-43a6-a7dd-ce869d46a61b",
                                "sense_id": "479d83b5-4adf-3270-8b99-46496b8ee984",
                                "text": "ribote, n.f. repas de fin des foins et moissons"
                            }
                        ]
                    }
                ],
