{
    "word_family": [
        "vertrouwen",
        "vertrouwenwekkend",
        "vertrouweling",
        "vertrouwelijk",
        "zelfvertrouwen"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1eb7263c-9228-32b2-aea7-aabe573ee1af",
                    "sense_definition": "iets kostbaars, een taak of een geheim in iemands zorg of bewaring geven omdat je die persoon vertrouwt",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "toevertrouwen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ze <w>vertrouwde</w> haar diepste geheimen <w>toe</w> aan haar beste vriendin.",
                            "target_lang_translations": {
                                "en": "She <w>confided</w> her deepest secrets to her best friend."
                            }
                        },
                        {
                            "text": "Je kunt hem deze belangrijke taak gerust <w>toevertrouwen</w>.",
                            "target_lang_translations": {
                                "en": "You can safely <w>entrust</w> him with this important task."
                            }
                        }
                    ],
                    "synonyms": [
                        "aanvertrouwen"
                    ],
                    "common_phrases": [
                        "geheimen toevertrouwen",
                        "zorg toevertrouwen"
                    ],
                    "target_lang_definitions": {
                        "en": "to give something valuable, a task, or a secret into someone's care or custody because you trust that person"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "confide",
                                "target_lang_sense_clarification": "to share secrets or private matters"
                            },
                            {
                                "target_lang_word": "entrust",
                                "target_lang_sense_clarification": "to give responsibility for something important"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7e274faa-b5ff-3a22-a341-d9bb66ae7c32",
                    "sense_definition": "diensten, kennis of goederen beschikbaar stellen aan een betrouwbaar persoon",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "toevertrouwen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dat lastige karwei kun je wel aan hem <w>toevertrouwen</w>.",
                            "target_lang_translations": {
                                "en": "You can certainly <w>leave</w> that tricky job to him."
                            }
                        },
                        {
                            "text": "Zij hadden hun kinderen aan de zorg van hun buren <w>toevertrouwd</w>.",
                            "target_lang_translations": {
                                "en": "They had <w>entrusted</w> their children to the care of their neighbors."
                            }
                        }
                    ],
                    "synonyms": [
                        "aanvertrouwen"
                    ],
                    "common_phrases": [
                        "karwei toevertrouwen",
                        "goederen toevertrouwen"
                    ],
                    "target_lang_definitions": {
                        "en": "to make services, knowledge, or goods available to a reliable person"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "entrust",
                                "target_lang_sense_clarification": "to put into someone's care or protection"
                            },
                            {
                                "target_lang_word": "commit",
                                "target_lang_sense_clarification": "to hand over for safekeeping"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}