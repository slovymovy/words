                ],
                "senses": [
                    {
                        "sense_id": "6285444a-d87c-3e2f-8cd5-6e4d2132548c",
                        "entry_id": "a9892e91-52fe-330b-98e8-ca3f892842d0",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "531c6eee-65bb-4335-b29d-a83b3ce3683b",
                                "sense_id": "6285444a-d87c-3e2f-8cd5-6e4d2132548c",
                                "text": "Aschenbrenners kamen, sahen und siegten."
                            },
                            {
                                "example_id": "3aa07fe6-e6de-4fed-890c-e14f763a2251",
                                "sense_id": "6285444a-d87c-3e2f-8cd5-6e4d2132548c",
                                "text": "Frau Aschenbrenner ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "4efef4b5-e43a-4f6a-94d8-485625eb93c4",
                                "sense_id": "6285444a-d87c-3e2f-8cd5-6e4d2132548c",
                                "text": "Herr Aschenbrenner wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "ade6740b-3186-4ae9-8594-04ff707e7e96",
                                "sense_id": "6285444a-d87c-3e2f-8cd5-6e4d2132548c",
                                "text": "Die Aschenbrenners fahren heute nach Innsbruck."
                            },
                            {
                                "example_id": "6dd747f7-7d5e-4d55-878b-6908fd444cfd",
                                "sense_id": "6285444a-d87c-3e2f-8cd5-6e4d2132548c",
                                "text": "Der Aschenbrenner trägt nie die Pullover, die die Aschenbrenner ihm strickt."
                            },
                            {
                                "example_id": "cebcc2e5-86b1-4694-8987-9cd80dc31d04",
                                "sense_id": "6285444a-d87c-3e2f-8cd5-6e4d2132548c",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Aschenbrenner kommt, geht der Herr Aschenbrenner.“"
                            },
                            {
                                "example_id": "8ef72634-c32f-4f6c-b43c-c5cbc1a7c3f6",
                                "sense_id": "6285444a-d87c-3e2f-8cd5-6e4d2132548c",
                                "text": "Aschenbrenner kommt und geht."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
