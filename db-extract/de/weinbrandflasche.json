                        "entry_id": "fd6cfa93-7682-319c-8954-c3ca8b8126df",
                        "glosses": [
                            "mit Weinbrand gefüllte Flasche"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fea46812-edeb-4916-b5fb-9fe9fea4ba5b",
                                "sense_id": "63388ed6-119e-3dd0-ae8e-3ffa90b2954e",
                                "text": "„Mit einem Schraubendreher hatte er am 21. Februar 20- mal auf einen Zechkumpanen eingestochen und dann auch noch zwei Weinbrandflaschen auf dem Kopf seines Opfers zertrümmert.“"
                            },
                            {
                                "example_id": "70231ff1-2552-4fca-9503-0a80f32271d8",
                                "sense_id": "63388ed6-119e-3dd0-ae8e-3ffa90b2954e",
                                "text": "„Die Beamten stellten bei dem Fahrer nicht nur eine deutliche Alkoholfahne fest, sondern fanden auch noch eine Weinbrandflasche auf dem Beifahrersitz.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
