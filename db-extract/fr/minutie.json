                                "target_senses": [
                                    {
                                        "sense_id": "0db0adb9-c5f5-38a0-afb9-2ff1a907f4f7",
                                        "entry_id": "4db41c9c-1693-3c46-a513-0e4c89e08906",
                                        "glosses": [
                                            "A minor detail, often of negligible importance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a8fe5bb-282a-453b-9539-bf88f4f75928",
                                                "sense_id": "0db0adb9-c5f5-38a0-afb9-2ff1a907f4f7",
                                                "text": "They spent all their time on minutiae, never making real progress."
                                            },
                                            {
                                                "example_id": "4f1d7fbd-7dff-45be-ba34-c44b9a36acc6",
                                                "sense_id": "0db0adb9-c5f5-38a0-afb9-2ff1a907f4f7",
                                                "text": "I think I can ſee the preciſe and diſtinguiſhing marks of national characters more in theſe nonſenſical minutiæ, than in the moſt important matters of ſtate ; where great men of all nations talk and ſtalk ſo much alike, that I would not give ninepence to chuſe amongſt them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76293bd9-054c-3747-9072-15340d8bdeeb",
                                        "entry_id": "4db41c9c-1693-3c46-a513-0e4c89e08906",
                                        "glosses": [
                                            "Any of the point features on fingerprints used for matching, usually endings and bifurcations of ridges."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
