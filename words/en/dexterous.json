{
    "word_family": [
        "dexterity",
        "dexterously"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "6623599e-958d-3e1d-b365-c13045719c89",
                    "sense_definition": "Skillful and precise in the use of one's hands.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "skill",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The surgeon was incredibly <w>dexterous</w> while performing the delicate operation.",
                            "target_lang_translations": {
                                "es": "El cirujano fue increíblemente <w>diestro</w> al realizar la delicada operación."
                            }
                        },
                        {
                            "text": "She is <w>dexterous</w> with her hands, making beautiful jewelry from tiny beads.",
                            "target_lang_translations": {
                                "es": "Ella es <w>habilidosa</w> con sus manos y elabora hermosas joyas con cuentas diminutas."
                            }
                        }
                    ],
                    "synonyms": [
                        "nimble",
                        "adroit",
                        "deft"
                    ],
                    "antonyms": [
                        "clumsy",
                        "awkward"
                    ],
                    "common_phrases": [
                        "dexterous hands"
                    ],
                    "target_lang_definitions": {
                        "es": "Habilidoso y preciso en el uso de las manos."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "diestro",
                                "target_lang_sense_clarification": "hábil con las manos"
                            },
                            {
                                "target_lang_word": "habilidoso",
                                "target_lang_sense_clarification": "con destreza manual"
                            },
                            {
                                "target_lang_word": "hábil",
                                "target_lang_sense_clarification": "capaz y preciso"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1ddc51a6-8ce5-3423-8f2e-fc9853df3d0a",
                    "sense_definition": "Showing great skill or proficiency in a specific activity or task.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "skill",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He proved to be a <w>dexterous</w> player, mastering the complex game in just one afternoon.",
                            "target_lang_translations": {
                                "es": "Demostró ser un jugador <w>hábil</w>, dominando el complejo juego en solo una tarde."
                            }
                        },
                        {
                            "text": "The artist is <w>dexterous</w> at painting portraits that capture every small detail.",
                            "target_lang_translations": {
                                "es": "El artista es <w>diestro</w> pintando retratos que capturan cada pequeño detalle."
                            }
                        }
                    ],
                    "synonyms": [
                        "proficient",
                        "skilled",
                        "adept"
                    ],
                    "antonyms": [
                        "inept"
                    ],
                    "target_lang_definitions": {
                        "es": "Que muestra gran habilidad, competencia o pericia en una actividad o tarea específica."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "diestro",
                                "target_lang_sense_clarification": "experimentado o competente"
                            },
                            {
                                "target_lang_word": "habilidoso",
                                "target_lang_sense_clarification": "con maña y soltura"
                            },
                            {
                                "target_lang_word": "hábil",
                                "target_lang_sense_clarification": "competente en una tarea"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a85152bd-a6c3-37f0-b627-6abfb9c64fba",
                    "sense_definition": "Moving with agility, flexibility, and grace.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dancer made <w>dexterous</w> movements across the stage during the performance.",
                            "target_lang_translations": {
                                "es": "La bailarina realizó movimientos <w>ágiles</w> por el escenario durante la actuación."
                            }
                        },
                        {
                            "text": "A <w>dexterous</w> cat jumped effortlessly from the fence to the high branch.",
                            "target_lang_translations": {
                                "es": "Un gato <w>ágil</w> saltó sin esfuerzo desde la cerca hasta la rama alta."
                            }
                        }
                    ],
                    "synonyms": [
                        "agile",
                        "lithe",
                        "supple"
                    ],
                    "antonyms": [
                        "stiff",
                        "rigid"
                    ],
                    "target_lang_definitions": {
                        "es": "Que se mueve con agilidad, flexibilidad y gracia."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "ágil",
                                "target_lang_sense_clarification": "que se mueve con facilidad y rapidez"
                            },
                            {
                                "target_lang_word": "diestro",
                                "target_lang_sense_clarification": "que ejecuta movimientos con soltura"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1611a869-de5f-3a66-a291-6ba17d090785",
                    "sense_definition": "Mentally quick, clever, and effective in argumentation or problem-solving.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "intelligence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lawyer was <w>dexterous</w> in her arguments, quickly finding flaws in the opponent's case.",
                            "target_lang_translations": {
                                "es": "La abogada fue muy <w>hábil</w> en sus argumentos, encontrando rápidamente fallas en el caso del oponente."
                            }
                        },
                        {
                            "text": "His <w>dexterous</w> mind allowed him to solve the complex puzzle in seconds.",
                            "target_lang_translations": {
                                "es": "Su mente <w>diestra</w> le permitió resolver el complejo acertijo en cuestión de segundos."
                            }
                        }
                    ],
                    "synonyms": [
                        "sharp",
                        "quick-witted",
                        "astute"
                    ],
                    "antonyms": [
                        "dull",
                        "slow"
                    ],
                    "target_lang_definitions": {
                        "es": "Mentalmente rápido, ingenioso y eficaz para razonar o resolver problemas."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "hábil",
                                "target_lang_sense_clarification": "astuto o inteligente al argumentar"
                            },
                            {
                                "target_lang_word": "diestro",
                                "target_lang_sense_clarification": "perspicaz o ingenioso"
                            },
                            {
                                "target_lang_word": "perspicaz",
                                "target_lang_sense_clarification": "agudo de mente"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}