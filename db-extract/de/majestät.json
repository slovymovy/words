                                        "entry_id": "63a7a0a7-1da7-3a73-81c6-7226dfad608c",
                                        "glosses": [
                                            "The quality of being impressive, great, dignified, powerful, sovereign, or any combination thereof."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ea8ab81-2ba9-48ca-a933-99bd4304a9ca",
                                                "sense_id": "48e22824-d864-36d4-a8c8-61c0af8f7e7f",
                                                "text": "the majesty of the Great Pyramids"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "83c145ba-53bc-4653-8dae-0f9272f0dc8e",
                        "source_entry_id": "9a106aa1-8c0c-3cab-bc83-a80b85b16233",
                        "source_sense_id": "23d721d4-658f-33d0-9511-ff295cff45a4",
                        "source_sense_description": "Titel von Kaisern und Königen",
                        "target_lang_word": "majesté",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "majesté",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "de997a55-5ff3-3404-b173-04f31af2de7b",
                                        "entry_id": "3189fe82-4026-3ac2-b0e8-e17cf2a95c35",
                                        "glosses": [
                                            "Grandeur suprême ; caractère auguste qui imprime le respect."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f93a20c-7050-4398-b531-623de6e9bcb3",
                                                "sense_id": "de997a55-5ff3-3404-b173-04f31af2de7b",
                                                "text": "Ce discours, dans sa partie pathétique, déborde, du reste, de majesté, de douleurs, d’exclamations, d’éplorations sublimes."
                                            },
                                            {
                                                "example_id": "d7e5c95b-0514-4c9e-956a-ec28d81a6cec",
                                                "sense_id": "de997a55-5ff3-3404-b173-04f31af2de7b",
                                                "text": "L’administration romaine était extrêmement dure pour […] tout accusé qui bravait sa majesté."
                                            },
                                            {
                                                "example_id": "6477ceb3-3e0b-413d-95b1-4cc4eaeeaa2c",
                                                "sense_id": "de997a55-5ff3-3404-b173-04f31af2de7b",
                                                "text": "La majesté des lois. — La majesté des peuples souverains."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53530c12-4525-3f0f-832a-e504514af5a0",
                                        "entry_id": "3189fe82-4026-3ac2-b0e8-e17cf2a95c35",
                                        "glosses": [
                                            "Air de grandeur propre à inspirer de l’admiration, du respect."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cf1a82dd-f976-435f-8319-824bc7b622aa",
                                                "sense_id": "53530c12-4525-3f0f-832a-e504514af5a0",
                                                "text": "Pleins d’ennuis aux récits des choses disparues,\nD’un œil morne ils verront sans plaisir ni regrets,\nPar la hache et le feu, sous le soc des charrues,\nTomber la majesté de leurs vieilles forêts."
                                            },
                                            {
                                                "example_id": "5e6ea3a7-29a4-4cc6-b17e-2ca9a7d7e9e7",
                                                "sense_id": "53530c12-4525-3f0f-832a-e504514af5a0",
                                                "text": "[…] ; flétrissez aussi le charlatanisme de ces pseudo-virtuoses qui ont obtenu des succès apocryphes à New-York ou en Californie, et qui, […], viennent défigurer sur nos grandes scènes lyriques des partitions dont elles ridiculisent la majesté par les exagérations de leur style exotique."
                                            },
                                            {
                                                "example_id": "a3e9d375-30d7-422b-a131-29ec35aee8de",
                                                "sense_id": "53530c12-4525-3f0f-832a-e504514af5a0",
                                                "text": "La profusion de détails gracieux ne nuit en rien à l'ensemble qui conserve toute sa majesté."
                                            },
                                            {
                                                "example_id": "72842777-e2ee-42e6-8cde-7a4baabffdfa",
                                                "sense_id": "53530c12-4525-3f0f-832a-e504514af5a0",
                                                "text": "Son corps, son visage, conservaient une sorte de splendeur qui s’éloignait de plus en plus de la grâce féminine pour se rapprocher chaque jour de la majesté."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a1e25c0f-b48d-3947-b3c7-091ad6205994",
                                        "entry_id": "3189fe82-4026-3ac2-b0e8-e17cf2a95c35",
                                        "glosses": [
                                            "Titre que l’on donne aux empereurs, aux rois, aux impératrices, aux reines."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e6c3b12-f230-468a-873e-bd9294bed467",
                                                "sense_id": "a1e25c0f-b48d-3947-b3c7-091ad6205994",
                                                "text": "Votre Majesté, sire, a ordonné."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
