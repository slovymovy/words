                    {
                        "translation_id": "75f4f919-436e-40e6-9562-cbeb3ec479d7",
                        "source_entry_id": "e9d905d6-c65b-3429-97ac-558263f79bfa",
                        "source_sense_description": "регулярная повторяемость",
                        "target_lang_word": "périodicité",
