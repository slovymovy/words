                                "sense_id": "1b9251b0-f642-3f61-b7a5-74112411bfc3",
                                "text": "„Hanke gelang am 17. April 2004 ein kurioses Tor: Er traf aus dem Anstoßkreis im Heimspiel seines Vereins FC Schalke 04 gegen Bayer 04 Leverkusen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
