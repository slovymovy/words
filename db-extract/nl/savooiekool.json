                        "source_sense_id": "cb916199-3fe1-3b68-ac34-c6b3498276dc",
                        "source_sense_description": "en 2. (bladeren van) Brassica oleracea convar. capitata var. sabauda)",
                        "target_lang_word": "chou de Milan",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chou de Milan",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "619a9e29-39c4-379c-aed6-42d6f4259a7d",
                                        "entry_id": "a25a2f3f-7d09-30e8-bd74-1bdcabc9b8ab",
                                        "glosses": [
                                            "Variété de chou pommé (Brassica oleracea var. sabauda), à feuilles vertes gaufrées ou cloquées, résistant bien au froid, et consommé comme légume."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "264b1f05-5431-4704-ae8b-1db2b832807b",
                                                "sense_id": "619a9e29-39c4-379c-aed6-42d6f4259a7d",
                                                "text": "Semer sur les couches, dont la chaleur se passe, du Chou-fleur, Brocolis, Chou pommé, Chou de milan, Chou-d’angleterre à pain de sucre, pour les avancer & replanter au mois de Mars en place."
                                            },
                                            {
                                                "example_id": "16f69032-1a5a-4bb8-b621-30e16d6ef81b",
                                                "sense_id": "619a9e29-39c4-379c-aed6-42d6f4259a7d",
                                                "text": "C’est le chou qui donne le plus de variétés ; on distingue principalement les quatre suivantes : le chou de Milan pointu ; le petit chou de Milan ; le chou de Milan court ; le chou de Milan nain frisé."
                                            },
                                            {
                                                "example_id": "48fd54cc-a6fb-484d-b494-e7bf8b06f824",
                                                "sense_id": "619a9e29-39c4-379c-aed6-42d6f4259a7d",
                                                "text": "Les choux verts (choux de Savoie ou choux de Milan) supportent bien le froid et peuvent être récoltés plus tard."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "748fee45-ce18-492a-a391-cc995453a7e5",
                        "source_entry_id": "f3424ffc-8e99-396e-8cd6-4e700e45ec13",
                        "source_sense_id": "cb916199-3fe1-3b68-ac34-c6b3498276dc",
                        "source_sense_description": "en 2. (bladeren van) Brassica oleracea convar. capitata var. sabauda)",
                        "target_lang_word": "chou de Savoie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chou de Savoie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "283e75d8-52e3-3dc2-bc19-9c4a02fb50a8",
                                        "entry_id": "73f610fb-a575-3379-94eb-878e85584b37",
                                        "glosses": [
                                            "Autre appellation du chou de Milan."
                                        ],
                                        "tags": [
                                            "Belgique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b9134292-a60d-4f2f-b1a5-fca825022058",
                                                "sense_id": "283e75d8-52e3-3dc2-bc19-9c4a02fb50a8",
                                                "text": "Le chou de Milan ou pommé-frisé, ainsi nommé des Français, est généralement connu en Belgique sous le nom de chou de Savoie, et ce n’est pas sans raison, puisque c’est de la Savoie qu’il s’est répandu en Italie, en France, en Allemagne et en Belgique."
                                            },
                                            {
                                                "example_id": "e597c116-65db-4647-baed-a6026fff9c58",
                                                "sense_id": "283e75d8-52e3-3dc2-bc19-9c4a02fb50a8",
                                                "text": "Les choux verts (choux de Savoie ou choux de Milan) supportent bien le froid et peuvent être récoltés plus tard."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
