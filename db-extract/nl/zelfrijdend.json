                            {
                                "example_id": "8fcea4d0-6ce5-4340-93da-cd3d1b41aaea",
                                "sense_id": "ba45674d-18e6-37c6-b728-160e3b0da6b4",
                                "text": "Korten tijd geleden kon een dezer vlijtige werklieden huis en erve koopen uit de opbrengst van eene nieuwe soort van zelfrijdende wagentjes, zeer eenvoudig, doch ongemeen vernuftig in elkander gezet.",
                                "translation": "A short while ago one of these industrious workmen could buy a house and land from the proceeds of a new type of self-driving carts, very simple, though put together with exceptional ingenuity.",
                                "english": "A short while ago one of these industrious workmen could buy a house and land from the proceeds of a new type of self-driving carts, very simple, though put together with exceptional ingenuity."
                            },
                            {
                                "example_id": "6de27a8d-96e6-4377-bf7d-60b447d17070",
                                "sense_id": "ba45674d-18e6-37c6-b728-160e3b0da6b4",
                                "text": "1898 April 6, \"Stadsnieuws\", Rotterdamsch Nieuwsblad (part 1), page 1.\nNaar men ons meedeelt werd gisteren een proefrit gemaakt met een automobile (zelfrijdend rijtuig).",
                                "translation": "As it is reported to us yesterday a test drive was done with an automobile (selfdriving vehicle).",
                                "english": "As it is reported to us yesterday a test drive was done with an automobile (selfdriving vehicle)."
                            }
                        ]
