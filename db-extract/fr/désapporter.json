                "senses": [
                    {
                        "sense_id": "81274ace-9016-3a83-98f8-ea1fa08e5845",
                        "entry_id": "592cca1d-7ad4-3135-af65-2b0f3b179eea",
                        "glosses": [
                            "Emporter, remporter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1004ecee-ff3f-4144-98f0-c2a30783b8aa",
                                "sense_id": "81274ace-9016-3a83-98f8-ea1fa08e5845",
                                "text": "Le vent qui fait claquer les chemises dans les cours apporte et désapporte le souvenir de Dieu."
                            },
                            {
                                "example_id": "13b19fac-0539-4125-a39c-19b2f81bb1f8",
                                "sense_id": "81274ace-9016-3a83-98f8-ea1fa08e5845",
                                "text": "leurs yeux étaient déjà comblés, il n'y avait donc rien à faire et puis pourquoi apporter et encore apporter pour ensuite désapporter."
                            },
                            {
                                "example_id": "bbc912b0-cf1e-4161-a30a-7ca4334cf9c2",
                                "sense_id": "81274ace-9016-3a83-98f8-ea1fa08e5845",
                                "text": "les générations s’apportent et se désapportent."
                            }
                        ]
                    },
                    {
                        "sense_id": "9c9f09a3-9e5a-318d-a761-d34950947ec7",
                        "entry_id": "592cca1d-7ad4-3135-af65-2b0f3b179eea",
                        "glosses": [
                            "Apporter quelque chose de négatif."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18b223c5-4788-4c8c-b449-6456c9864733",
                                "sense_id": "9c9f09a3-9e5a-318d-a761-d34950947ec7",
                                "text": "Il faudrait que je m’en fasse prêter un, car je ne suis pas un utilisateur de flash d’ordre général, mais sous l’eau, en N&B, j’aimerais voir ce que cela peut apporter... Ou \"désapporter\" !!!"
                            }
                        ]
                    }
