                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Музыкальный номер в индийском фильме, часто с участием приглашённой звезды.",
                        "tr": "Hint filmlerinde genellikle konuk bir oyuncunun yer aldığı müzikal performans."
                    },
                    "translations": {
