                "translations": [
                    {
                        "translation_id": "1756be1f-da16-4e22-9a5a-f3fa0fad9c93",
                        "source_entry_id": "f5aaf4fb-b9f9-3b4c-8d57-548c17458367",
                        "target_lang_word": "research",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "research",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4146b1a2-af21-3cb0-91a8-72846d2d1001",
                                        "entry_id": "5750631e-c72b-340f-8627-06db637532f2",
                                        "glosses": [
                                            "Diligent inquiry or examination to seek or revise facts, principles, theories, applications, etc. (that are currently available, or that are familiar to one's self)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "dialectal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "72dee6bc-c9af-4782-9694-0f768a77c987",
                                                "sense_id": "4146b1a2-af21-3cb0-91a8-72846d2d1001",
                                                "text": "In an era when political leaders promise deliverance from decline through America’s purported preeminence in scientific research, the news that science is in deep trouble in the United States has been as unwelcome as a diagnosis of leukemia following the loss of health insurance."
                                            },
                                            {
                                                "example_id": "3d5d98cf-53d0-4875-998b-93caf8c2065f",
                                                "sense_id": "4146b1a2-af21-3cb0-91a8-72846d2d1001",
                                                "text": "The research station that houses Wang and his team is outside Lijiang, a city of about 1.2 million people."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "131c9696-dbd1-300e-8609-f10e9d15b66f",
                                        "entry_id": "5750631e-c72b-340f-8627-06db637532f2",
                                        "glosses": [
                                            "A particular instance or piece of research."
                                        ],
                                        "tags": [
                                            "countable",
                                            "dated"
                                        ],
                                        "examples": [
