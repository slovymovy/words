                                "sense_id": "85c3f057-a171-332a-8a1c-962e61afa06e",
                                "text": "Asterix isst am liebsten Wildschwein zusammen mit seinem Freund Obelix."
                            },
                            {
                                "example_id": "a1728890-d781-4a8e-ab2f-615d0a914e79",
                                "sense_id": "85c3f057-a171-332a-8a1c-962e61afa06e",
                                "text": "„Was ein Hinkelstein ist, das weiß noch jeder, der in seiner Jugend (oder auch später) „Asterix und Obelix“ gelesen hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
