            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3bbc3d17-1ff9-3b9f-b6f1-69becfb75d2a",
                    "sense_definition": "Poursuivre obstinément une tâche ou un effort en y consacrant toute son énergie.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "perseverance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Malgré ses échecs répétés, le jeune chercheur s'<w>acharne</w> à trouver une solution à cette énigme."
                        },
                        {
                            "text": "Les ouvriers s'<w>acharnaient</w> à terminer les travaux avant le début de la saison hivernale."
                        }
                    ],
                    "synonyms": [
                        "s'obstiner",
                        "persévérer"
                    ],
                    "antonyms": [
                        "renoncer",
                        "abandonner"
                    ],
                    "common_phrases": [
                        "s'acharner au travail"
                    ]
                },
                {
                    "sense_id": "56cbdb01-d410-3061-a2f4-9dfd5d9fd578",
                    "sense_definition": "Attaquer, tourmenter ou harceler quelqu'un sans relâche et avec hostilité.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "attaque",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les journalistes continuent de s'<w>acharner</w> sur le ministre malgré ses excuses publiques."
                        },
                        {
                            "text": "Pendant toute la rencontre, les défenseurs s'<w>acharnaient</w> contre le jeune joueur vedette."
                        }
                    ],
                    "synonyms": [
                        "harceler",
                        "pourchasser"
                    ],
                    "antonyms": [
                        "épargner"
                    ],
                    "common_phrases": [
                        "s'acharner sur quelqu'un",
                        "s'acharner contre un rival"
                    ]
                },
                {
                    "sense_id": "ef38da08-e7d0-3a3b-802d-703ed096bc34",
                    "sense_definition": "Exciter avec violence un animal ou une personne contre un adversaire.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "incitation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le maître d'équipage avait réussi à <w>acharner</w> ses chiens contre la bête traquée."
                        },
                        {
                            "text": "Il est dangereux d'<w>acharner</w> ces hommes les uns contre les autres pour une rivalité inutile."
                        }
                    ],
                    "synonyms": [
                        "exciter",
                        "ameuter"
                    ],
                    "antonyms": [
                        "apaiser",
                        "calmer"
                    ],
                    "common_phrases": [
                        "acharner les chiens"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Rare en français contemporain"
                        }
                    ]
                },
                {
                    "sense_id": "ea0b7144-71ca-315a-8dd5-ec59a2dd75d8",
                    "sense_definition": "Donner à des chiens ou des oiseaux de proie le goût de la chair pour la chasse.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "chasse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le fauconnier prenait soin d'<w>acharner</w> son rapace avec des morceaux de viande crue."
                        },
                        {
                            "text": "Autrefois, on devait <w>acharner</w> les jeunes molosses avant de les lancer à la poursuite du gibier."
                        }
                    ],
                    "traits": [
