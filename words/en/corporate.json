{
    "word_family": [
        "corporation",
        "incorporate",
        "incorporation",
        "corporeal",
        "corporatism"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "1c965e5f-741a-3aab-a6b9-7169222133cb",
                    "sense_definition": "Of or relating to a large company or group.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "business_entity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She climbed the <w>corporate</w> ladder very quickly after joining the firm.",
                            "target_lang_translations": {
                                "ru": "Она очень быстро поднялась по <w>корпоративной</w> лестнице после прихода в фирму.",
                                "zh": "她加入公司后，很快就在<w>公司</w>内部晋升了。"
                            }
                        },
                        {
                            "text": "The company has a very strict <w>corporate</w> policy regarding dress code.",
                            "target_lang_translations": {
                                "ru": "В компании действует очень строгая <w>корпоративная</w> политика касательно дресс-кода.",
                                "zh": "公司对于着装规范有非常严格的<w>企业</w>政策。"
                            }
                        }
                    ],
                    "synonyms": [
                        "business",
                        "commercial"
                    ],
                    "antonyms": [
                        "private",
                        "personal"
                    ],
                    "common_phrases": [
                        "corporate culture",
                        "corporate strategy",
                        "corporate identity",
                        "corporate ladder"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к крупной компании или группе компаний.",
                        "zh": "与大公司或企业集团有关的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "корпорати́вный",
                                "target_lang_sense_clarification": "относящийся к корпорации"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "公司",
                                "target_lang_sense_clarification": "指代与公司相关的事务"
                            },
                            {
                                "target_lang_word": "企业",
                                "target_lang_sense_clarification": "指代与企业相关的事务"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "13b43bb4-bd9e-35eb-a861-ac289017dd35",
                    "sense_definition": "Shared by or involving a whole group of people.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "collective_body",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The committee made a <w>corporate</w> decision to delay the project until next year.",
                            "target_lang_translations": {
                                "ru": "Комитет принял <w>коллективное</w> решение отложить проект до следующего года.",
                                "zh": "委员会做出了<w>集体</w>决定，将项目推迟到明年。"
                            }
                        },
                        {
                            "text": "They accepted <w>corporate</w> responsibility for the failure of the mission.",
                            "target_lang_translations": {
                                "ru": "Они приняли на себя <w>коллективную</w> ответственность за провал миссии.",
                                "zh": "他们为任务失败承担了<w>共同</w>责任。"
                            }
                        }
                    ],
                    "synonyms": [
                        "collective",
                        "joint",
                        "communal",
                        "shared"
                    ],
                    "antonyms": [
                        "individual"
                    ],
                    "common_phrases": [
                        "corporate responsibility",
                        "corporate body",
                        "corporate worship"
                    ],
                    "target_lang_definitions": {
                        "ru": "Общий для группы людей или вовлекающий всю группу; совместный.",
                        "zh": "由整个群体共同参与或承担的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "коллекти́вный",
                                "target_lang_sense_clarification": "совместный, групповой"
                            },
                            {
                                "target_lang_word": "о́бщий",
                                "target_lang_sense_clarification": "принадлежащий всем"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "集体",
                                "target_lang_sense_clarification": "指代共同的、团体的"
                            },
                            {
                                "target_lang_word": "共同",
                                "target_lang_sense_clarification": "指代由多人参与的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1cbd56b3-9843-3363-95c9-754c764c99d1",
                    "sense_definition": "Lacking character or individuality; typical of a large corporation.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "style_description",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hotel room felt very <w>corporate</w> and impersonal.",
                            "target_lang_translations": {
                                "ru": "Номер в отеле казался очень <w>казённым</w> и безликим.",
                                "zh": "酒店房间感觉非常<w>刻板</w>，毫无个性。"
                            }
                        },
                        {
                            "text": "I dislike the <w>corporate</w> atmosphere of this coffee shop chain.",
                            "target_lang_translations": {
                                "ru": "Мне не нравится <w>корпоративная</w> атмосфера этой сети кофеен.",
                                "zh": "我不喜欢这家连锁咖啡店那种<w>冷漠</w>的商业氛围。"
                            }
                        }
                    ],
                    "synonyms": [
                        "soulless",
                        "sterile",
                        "impersonal",
                        "bland"
                    ],
                    "antonyms": [
                        "distinctive",
                        "unique"
                    ],
                    "common_phrases": [
                        "corporate look",
                        "corporate feel"
                    ],
                    "target_lang_definitions": {
                        "ru": "Лишенный индивидуальности; типичный для крупной корпорации (часто скучный или формальный).",
                        "zh": "缺乏个性或特征的；具有大公司那种刻板、冷漠风格的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "безли́кий",
                                "target_lang_sense_clarification": "лишенный своеобразия"
                            },
                            {
                                "target_lang_word": "казённый",
                                "target_lang_sense_clarification": "формальный, неуютный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "刻板",
                                "target_lang_sense_clarification": "指缺乏个性、形式化"
                            },
                            {
                                "target_lang_word": "冷漠",
                                "target_lang_sense_clarification": "指缺乏人情味"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "475fe862-e6de-3310-88d2-8e08b7506aab",
                    "sense_definition": "The head office or senior management of a large company.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "business_entity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We need approval from <w>corporate</w> before we can hire any new staff.",
                            "target_lang_translations": {
                                "ru": "Нам нужно одобрение из <w>головного офиса</w>, прежде чем мы сможем нанять новых сотрудников.",
                                "zh": "在招聘新员工之前，我们需要获得<w>总部</w>的批准。"
                            }
                        },
                        {
                            "text": "The directive came straight down from <w>corporate</w> this morning.",
                            "target_lang_translations": {
                                "ru": "Директива поступила сегодня утром прямо от <w>руководства</w>.",
                                "zh": "今天早上，指令直接从<w>公司高层</w>下达。"
                            }
                        }
                    ],
                    "synonyms": [
                        "headquarters",
                        "management",
                        "head office"
                    ],
                    "common_phrases": [
                        "call corporate",
                        "from corporate"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used without an article"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Головной офис или высшее руководство крупной компании.",
                        "zh": "大公司的总部或高层管理部门。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "головно́й о́фис",
                                "target_lang_sense_clarification": "центральное отделение"
                            },
                            {
                                "target_lang_word": "руково́дство",
                                "target_lang_sense_clarification": "начальство компании"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "总部",
                                "target_lang_sense_clarification": "指公司的核心管理机构"
                            },
                            {
                                "target_lang_word": "公司高层",
                                "target_lang_sense_clarification": "指公司的决策管理层"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "acb123c2-ea8c-3db3-a832-7fc139ce84eb",
                    "sense_definition": "A bond issued by a corporation.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "finance_instrument",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Investors are buying <w>corporates</w> to diversify their portfolios.",
                            "target_lang_translations": {
                                "ru": "Инвесторы скупают <w>корпоративные облигации</w> для диверсификации своих портфелей.",
                                "zh": "投资者正在购买<w>公司债券</w>以分散投资组合。"
                            }
                        },
                        {
                            "text": "The market for high-yield <w>corporates</w> has grown significantly recently.",
                            "target_lang_translations": {
                                "ru": "Рынок высокодоходных <w>корпоративных облигаций</w> в последнее время значительно вырос.",
                                "zh": "高收益<w>公司债券</w>市场近期增长显著。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "financial jargon"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Облигация, выпущенная корпорацией.",
                        "zh": "由公司发行的债券。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "корпорати́вная облига́ция",
                                "target_lang_sense_clarification": "финансовый инструмент"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "公司债券",
                                "target_lang_sense_clarification": "金融术语"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}