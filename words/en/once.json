                {
                    "sense_id": "b6f8fb80-dbb0-3a35-82a6-cc8d5e366af2",
                    "sense_definition": "Formerly; during some period in the past, but not now.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "past_time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This beautiful building was <w>once</w> a factory.",
                            "target_lang_translations": {
                                "ru": "Это красивое здание <w>когда-то</w> было фабрикой.",
                                "nl": "Dit prachtige gebouw was <w>ooit</w> een fabriek.",
                                "pl": "Ten piękny budynek był <w>kiedyś</w> fabryką.",
                                "de": "Dieses schöne Gebäude war <w>früher</w> eine Fabrik.",
                                "fr": "Ce beau bâtiment était <w>autrefois</w> une usine.",
                                "it": "Questo bellissimo edificio <w>un tempo</w> era una fabbrica.",
                                "cs": "Tato krásná budova byla <w>kdysi</w> továrnou.",
                                "tr": "Bu güzel bina <w>bir zamanlar</w> bir fabrikaydı.",
                                "es": "Este hermoso edificio fue <w>una vez</w> una fábrica.",
                                "zh": "这座漂亮的建筑<w>曾经</w>是一家工厂。"
                            }
                        },
                        {
                            "text": "He <w>once</w> lived in New York, but he moved away years ago.",
                            "target_lang_translations": {
                                "ru": "Он <w>раньше</w> жил в Нью-Йорке, но уехал много лет назад.",
                                "nl": "Hij woonde <w>vroeger</w> in New York, maar hij is jaren geleden verhuisd.",
                                "pl": "On <w>kiedyś</w> mieszkał w Nowym Jorku, ale wyprowadził się stamtąd lata temu.",
                                "de": "Er hat <w>einst</w> in New York gelebt, ist aber vor Jahren weggezogen.",
                                "fr": "Il a <w>un temps</w> vécu à New York, mais il a déménagé il y a des années.",
                                "it": "<w>Una volta</w> viveva a New York, ma si è trasferito anni fa.",
                                "cs": "<w>Kdysi</w> žil v New Yorku, ale před lety se odstěhoval.",
                                "tr": "O <w>eskiden</w> New York'ta yaşıyordu ama yıllar önce taşındı.",
                                "es": "Él <w>antes</w> vivía en Nueva York, pero se mudó hace años.",
                                "zh": "他<w>曾经</w>住在纽约，但多年前就搬走了。"
                            }
                        }
