{
    "word_family": [
        "view",
        "viewer",
        "viewing",
        "review",
        "reviewer",
        "interview",
        "overview"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d52c7c22-f3d6-3fcd-9a16-18a6abe212d2",
                    "sense_definition": "A facility for viewing and checking a document or photo, or changes to it, before saving or printing it.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "digital_viewing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please check the <w>preview</w> before you click the print button.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, проверьте <w>предварительный просмотр</w>, прежде чем нажать кнопку печати.",
                                "zh": "在点击打印按钮之前，请先检查<w>预览</w>。"
                            }
                        },
                        {
                            "text": "The print <w>preview</w> shows exactly how the document will look on paper.",
                            "target_lang_translations": {
                                "ru": "<w>Предварительный просмотр</w> печати точно показывает, как документ будет выглядеть на бумаге.",
                                "zh": "打印<w>预览</w>准确地显示了文档在纸上的打印效果。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "print preview",
                        "image preview"
                    ],
                    "target_lang_definitions": {
                        "ru": "Функция для просмотра и проверки документа, фотографии или изменений перед сохранением или печатью.",
                        "zh": "在保存或打印文档、照片或更改之前，用于查看和检查的设施。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предварительный просмотр",
                                "target_lang_sense_clarification": "в компьютерных программах"
                            },
                            {
                                "target_lang_word": "предосмотр",
                                "target_lang_sense_clarification": "краткая форма"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "预览",
                                "target_lang_sense_clarification": "计算机软件中的功能"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8e8a62a4-c6c6-3e56-8c01-d9ddf82c5676",
                    "sense_definition": "A short collection of clips edited together to advertise a film, television show, etc.; a trailer.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "media_promotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I saw a <w>preview</w> for the new action movie at the cinema yesterday.",
                            "target_lang_translations": {
                                "ru": "Вчера в кинотеатре я видел <w>трейлер</w> нового боевика.",
                                "zh": "昨天我在电影院看到了那部新动作片的<w>预告片</w>。"
                            }
                        },
                        {
                            "text": "The movie <w>preview</w> was so exciting that I want to see the full film.",
                            "target_lang_translations": {
                                "ru": "<w>Анонс</w> фильма был настолько захватывающим, что я хочу посмотреть его целиком.",
                                "zh": "这部电影的<w>预告片</w>太精彩了，我很想看完整部电影。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "movie preview",
                        "film preview"
                    ],
                    "target_lang_definitions": {
                        "ru": "Короткая подборка кадров, смонтированных для рекламы фильма или телешоу; трейлер.",
                        "zh": "为宣传电影、电视节目等而剪辑在一起的短片；预告片。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "трейлер",
                                "target_lang_sense_clarification": "рекламный ролик фильма"
                            },
                            {
                                "target_lang_word": "анонс",
                                "target_lang_sense_clarification": "краткое представление"
                            },
                            {
                                "target_lang_word": "превью",
                                "target_lang_sense_clarification": "заимствованное слово"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "预告片",
                                "target_lang_sense_clarification": "电影或节目的宣传短片"
                            },
                            {
                                "target_lang_word": "预告",
                                "target_lang_sense_clarification": "简短的介绍"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d99e118f-0182-3af6-bb28-fd8cf79dfb95",
                    "sense_definition": "An advance showing of a film, exhibition, or performance before it is open to the general public.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "media_promotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Critics were invited to an exclusive <w>preview</w> of the art exhibition.",
                            "target_lang_translations": {
                                "ru": "Критики были приглашены на эксклюзивный <w>предпоказ</w> художественной выставки.",
                                "zh": "评论家们受邀参加了艺术展的独家<w>预展</w>。"
                            }
                        },
                        {
                            "text": "The theater held a special <w>preview</w> performance for the local community.",
                            "target_lang_translations": {
                                "ru": "Театр провел специальный <w>предварительный показ</w> для местных жителей.",
                                "zh": "剧院为当地社区举办了一场特别的<w>预演</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "exclusive preview",
                        "special preview"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предварительный показ фильма, выставки или спектакля до официального открытия для широкой публики.",
                        "zh": "在电影、展览或表演正式向公众开放之前的提前展示。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предварительный просмотр",
                                "target_lang_sense_clarification": "показ для критиков или гостей"
                            },
                            {
                                "target_lang_word": "предпоказ",
                                "target_lang_sense_clarification": "закрытый или ранний показ"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "预展",
                                "target_lang_sense_clarification": "展览或艺术品的提前展示"
                            },
                            {
                                "target_lang_word": "试映",
                                "target_lang_sense_clarification": "电影的提前放映"
                            },
                            {
                                "target_lang_word": "预演",
                                "target_lang_sense_clarification": "表演或戏剧的提前排演或展示"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dee4b4a4-de19-3c57-b0cc-1b6be1506c53",
                    "sense_definition": "An experience or glimpse of something in advance of its full occurrence.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "advance_experience",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cold wind today gave us a <w>preview</w> of the harsh winter to come.",
                            "target_lang_translations": {
                                "ru": "Сегодняшний холодный ветер дал нам <w>предвкушение</w> суровой зимы, которая нас ждет.",
                                "zh": "今天寒冷的风让我们<w>预感</w>到了即将到来的严冬。"
                            }
                        },
                        {
                            "text": "The short trip provided a brief <w>preview</w> of what living abroad might be like.",
                            "target_lang_translations": {
                                "ru": "Короткая поездка дала краткое <w>представление</w> о том, каково это — жить за границей.",
                                "zh": "这次短途旅行让我们对国外生活有了<w>初步了解</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "foretaste",
                        "forelook",
                        "foreview"
                    ],
                    "common_phrases": [
                        "brief preview",
                        "quick preview"
                    ],
                    "target_lang_definitions": {
                        "ru": "Возможность увидеть или испытать что-то заранее, до того как это произойдет в полной мере.",
                        "zh": "在某事完全发生之前对其进行的初步体验或了解。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предвкушение",
                                "target_lang_sense_clarification": "ощущение чего-то заранее"
                            },
                            {
                                "target_lang_word": "первое знакомство",
                                "target_lang_sense_clarification": "краткое представление о будущем"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "预示",
                                "target_lang_sense_clarification": "预先显示出某种迹象"
                            },
                            {
                                "target_lang_word": "初步了解",
                                "target_lang_sense_clarification": "对未来的简要认识"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b1884a0a-e6b5-348f-b4c6-d2888bb69e8d",
                    "sense_definition": "To view or display a document, photo, or file before it is finalized, saved, or printed.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "digital_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should <w>preview</w> the file to make sure the formatting is correct.",
                            "target_lang_translations": {
                                "ru": "Вам следует <w>просмотреть</w> файл, чтобы убедиться в правильности форматирования.",
                                "zh": "你应该<w>预览</w>一下文件，以确保格式正确。"
                            }
                        },
                        {
                            "text": "The software allows you to <w>preview</w> changes in real time.",
                            "target_lang_translations": {
                                "ru": "Программное обеспечение позволяет <w>предварительно просматривать</w> изменения в реальном времени.",
                                "zh": "该软件允许你实时<w>预览</w>所做的更改。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "preview changes",
                        "preview the document"
                    ],
                    "target_lang_definitions": {
                        "ru": "Просматривать документ, фото или файл перед окончательным оформлением, сохранением или печатью.",
                        "zh": "在文档、照片或文件最终确定、保存或打印之前进行查看或显示。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "просматривать",
                                "target_lang_sense_clarification": "предварительно"
                            },
                            {
                                "target_lang_word": "делать предварительный просмотр",
                                "target_lang_sense_clarification": "в интерфейсе программы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "预览",
                                "target_lang_sense_clarification": "动词，指查看预览效果"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4bb5dc6f-76ef-3f04-b36b-b09f42b4b48d",
                    "sense_definition": "To show or watch something, or part of it, before it is complete or officially released.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "media_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The director will <w>preview</w> the new footage at the film festival.",
                            "target_lang_translations": {
                                "ru": "Режиссер <w>покажет</w> новые кадры на кинофестивале.",
                                "zh": "导演将在电影节上<w>预展</w>新的拍摄片段。"
                            }
                        },
                        {
                            "text": "They decided to <w>preview</w> the upcoming book by releasing the first chapter online.",
                            "target_lang_translations": {
                                "ru": "Они решили <w>анонсировать</w> выходящую книгу, опубликовав первую главу в интернете.",
                                "zh": "他们决定通过在网上发布第一章来<w>预告</w>即将出版的新书。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "preview the footage",
                        "preview the collection"
                    ],
                    "target_lang_definitions": {
                        "ru": "Показывать или смотреть что-либо до того, как оно будет полностью завершено или официально выпущено.",
                        "zh": "在某事物完成或正式发布之前进行展示或观看。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предварительно показывать",
                                "target_lang_sense_clarification": "о материалах или фильмах"
                            },
                            {
                                "target_lang_word": "анонсировать",
                                "target_lang_sense_clarification": "представлять заранее"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "预展",
                                "target_lang_sense_clarification": "提前展示作品"
                            },
                            {
                                "target_lang_word": "预告",
                                "target_lang_sense_clarification": "提前发布信息"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}