                "senses": [
                    {
                        "sense_id": "046484ce-26a8-368a-9852-a54ad1e8205e",
                        "entry_id": "3b64c4ce-bea5-3eda-aea1-52410b037016",
                        "glosses": [
                            "a male given name, Emil"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a5efae2-28bd-4989-ba0a-f0363042a407",
                                "sense_id": "046484ce-26a8-368a-9852-a54ad1e8205e",
                                "text": "— Эми́ль! — переби́л его́ Са́нин и указа́л глаза́ми на ку́чера, — опо́мнитесь! Эми́ль, пожа́луйста, ступа́йте домо́й! Послу́шайтесь меня́, друг мой! Вы уверя́ете, что лю́бите меня́. Ну, я вас прошу́!",
                                "translation": "'Emil!' Sanin interrupted—and he pointed to the coachman, 'do control yourself! Emil, please, go home! Listen to me, my dear! You say you love me. Well, I beg you!'",
                                "english": "'Emil!' Sanin interrupted—and he pointed to the coachman, 'do control yourself! Emil, please, go home! Listen to me, my dear! You say you love me. Well, I beg you!'"
                            }
                        ]
                    }
