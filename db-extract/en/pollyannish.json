                        "glosses": [
                            "irrepressibly or excessively optimistic; capable of seeing good in anyone"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "852544dc-132d-4c37-82af-a704ec53e4c4",
                                "sense_id": "c97e631c-fe09-3c59-8f60-ca00faf1767f",
                                "text": "[…] what we've been waiting for so long: a positive but never Pollyanish play about gays leading lives which are neither some bizarre caricature taken from heterosexual fantasy nor even more nuclear and apple-pie normal than any straight lives anyone has ever heard of."
                            },
                            {
                                "example_id": "15fd928b-9164-474f-99d5-380b39e73301",
                                "sense_id": "c97e631c-fe09-3c59-8f60-ca00faf1767f",
                                "text": "She insisted: \"Look, the House is not very different from when I was there. You have to have some faith in the governing majority, which I do, because I have a lot of respect for members on both sides of the aisle to do what’s best for the American people. And that is not some pollyannish thing. I know them.\""
                            }
                        ]
                    }
