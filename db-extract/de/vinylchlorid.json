                                "sense_id": "eb04ea0c-7ce9-3cbf-afa6-7d19bc6e466b",
                                "text": "„Ein mit Vinylchlorid beladener Zug ist im US-Bundesstaat Ohio entgleist.“"
                            },
                            {
                                "example_id": "1d83b88b-89b0-46cc-9581-b0f9bf3fff9c",
                                "sense_id": "eb04ea0c-7ce9-3cbf-afa6-7d19bc6e466b",
                                "text": "„Beim Verbrennen von Vinylchlorid entstehen Chlorwasserstoff und Spuren von Phosgen.“"
                            }
                        ],
