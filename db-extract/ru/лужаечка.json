                                    },
                                    {
                                        "sense_id": "1543d7d3-4547-3a4c-bdf2-933b3ddeb9c6",
                                        "entry_id": "3322b890-6b04-3520-977e-789219b1d9f5",
                                        "glosses": [
                                            "A piece of clothing made from lawn."
                                        ],
                                        "tags": [
                                            "countable",
