                "translations": [
                    {
                        "translation_id": "611b2a90-ffd1-4863-a507-8b2a380cb7cd",
                        "source_entry_id": "9fe732a6-96bb-3dd7-8be6-194236c77379",
                        "source_sense_id": "321e9a89-017d-3f95-be83-2ec74aa913b6",
                        "target_lang_word": "sybaritism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sybaritism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ec7ae6bf-97a8-38c9-93ca-fbedf1fda6ba",
                                        "entry_id": "3e42b299-9c6a-3e69-adb8-84fc4e0b3394",
                                        "glosses": [
                                            "luxury, wantonness, voluptuousness, or hedonism"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "291f7c5b-a9f3-441d-8dc2-f0bd026ac2e2",
                                                "sense_id": "ec7ae6bf-97a8-38c9-93ca-fbedf1fda6ba",
                                                "text": "The samurai and others who flocked from the provinces to the capital when all offices were thrown open to talent, took kindly to the sybaritism which had been one of the causes of ruin to those they were supplanting."
                                            },
                                            {
                                                "example_id": "da6badf8-89a9-441a-a7d2-903e238aa2e0",
                                                "sense_id": "ec7ae6bf-97a8-38c9-93ca-fbedf1fda6ba",
                                                "text": "What fiend ever suggested to my landlady the combination of crimson roses and purplish paper? How I hate my environments! Poverty and sybaritism go as ill together as roses and purple paper, but I have always been too much given up to the gratification of the eyes and of the senses."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f1026202-477c-463e-af77-9f98434f8532",
                        "source_entry_id": "9fe732a6-96bb-3dd7-8be6-194236c77379",
                        "source_sense_id": "321e9a89-017d-3f95-be83-2ec74aa913b6",
                        "target_lang_word": "сибаритство",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "сибаритство",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "7050040e-f853-33b3-a4da-190f4d978aec",
                                        "entry_id": "077597fc-c911-3d5b-8a57-d2bdb571d5e8",
                                        "glosses": [
                                            "книжн., презр. поведение, поступки, образ жизни сибарита"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2af8e0dc-2de1-4081-a871-defefc21ff45",
                                                "sense_id": "7050040e-f853-33b3-a4da-190f4d978aec",
                                                "text": "Есть что-то чувственное, что-то унизительное, есть какое-то эгоистическое сибаритство в этом самобоготворении, в этой оргии самолюбия, в этом упоении самонаслаждения, которое в своих действиях так же гибельно для души, как пьянство для силы телесной."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
