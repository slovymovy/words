            "senses": [
                {
                    "sense_id": "dd5192b1-6eec-3bc1-bd52-b18a63da3a21",
                    "sense_definition": "Уменьшительное к <w>ступень</w>; опорная площадка или перекладина лестницы для подъёма или спуска.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "stairs",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мальчик осторожно спустился на одну <w>ступеньку</w> вниз. Больше он ничего не боялся. ",
                            "target_lang_translations": {
                                "en": "The boy carefully stepped down one <w>step</w>. He was not afraid of anything anymore."
                            }
                        },
                        {
                            "text": "Она устало присела на деревянные <w>ступеньки</w> крыльца и вздохнула.",
                            "target_lang_translations": {
                                "en": "She sat down wearily on the wooden <w>steps</w> of the porch and sighed."
                            }
                        }
                    ],
                    "synonyms": [
                        "ступень",
                        "ступёнка"
                    ],
                    "common_phrases": [
                        "деревянная ступенька",
                        "бетонная ступенька",
                        "спускаться по ступенькам",
                        "подниматься по ступенькам"
                    ],
                    "target_lang_definitions": {
                        "en": "Diminutive of step; a flat surface or crosspiece on a staircase or ladder for climbing up or down."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "step",
                                "target_lang_sense_clarification": "on stairs"
                            },
                            {
                                "target_lang_word": "stair",
                                "target_lang_sense_clarification": "single step of a flight of stairs"
                            },
                            {
                                "target_lang_word": "rung",
                                "target_lang_sense_clarification": "horizontal bar on a ladder"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ef6ece99-6ff7-312f-af24-c174cff19334",
                    "sense_definition": "Отдельный этап или фаза в каком-либо процессе, развитии, карьере.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "stage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Эта должность стала важной <w>ступенькой</w> в его профессиональном росте.",
                            "target_lang_translations": {
                                "en": "This position became an important <w>stepping stone</w> in his professional growth."
                            }
                        },
                        {
                            "text": "Каждая новая книга автора воспринималась критиками как очередная <w>ступенька</w> к признанию.",
                            "target_lang_translations": {
                                "en": "Every new book by the author was perceived by critics as another <w>step</w> toward recognition."
                            }
                        }
                    ],
                    "synonyms": [
                        "ступень"
                    ],
                    "common_phrases": [
                        "важная ступенька",
                        "ступенька карьерной лестницы"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "в переносном значении"
                        }
                    ],
                    "target_lang_definitions": {
