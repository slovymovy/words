                "senses": [
                    {
                        "sense_id": "68cc20cd-1331-34e2-9a04-bbbc7ff76e0a",
                        "entry_id": "4233c2b5-eec0-3eca-989f-70bda17967c4",
                        "glosses": [
                            "Schnaps, der in 2-cl- oder 4-cl-Gläsern serviert wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93db6c94-7c41-4a02-92b3-1c1903e75534",
                                "sense_id": "68cc20cd-1331-34e2-9a04-bbbc7ff76e0a",
                                "text": "Er bestellte für seine Kumpel fünf Kurze."
                            },
                            {
                                "example_id": "0c793ca3-24b2-4f6c-b1ee-f96740d758f0",
                                "sense_id": "68cc20cd-1331-34e2-9a04-bbbc7ff76e0a",
                                "text": "„In früheren Zeiten haben Bundschuh und Onkel Uli zusammen mit Müller sonntagsmorgens am Büdchen von Ketti Bier und Kurze getrunken und die Bild am Sonntag gekauft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ee513df0-e0a1-3443-b9b2-301540b85123",
                        "entry_id": "4233c2b5-eec0-3eca-989f-70bda17967c4",
                        "glosses": [
                            "Kurzschluss"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "d9d7d595-a712-48c9-a359-980f6ce3beee",
                                "sense_id": "ee513df0-e0a1-3443-b9b2-301540b85123",
                                "text": "Die Sicherung sprang heraus, als er einen Kurzen gebaut hatte."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "257ec543-b9e3-4e79-9cf1-c3c61a177116",
                        "source_entry_id": "4233c2b5-eec0-3eca-989f-70bda17967c4",
                        "source_sense_id": "68cc20cd-1331-34e2-9a04-bbbc7ff76e0a",
                        "target_lang_word": "shooter",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "shooter",
