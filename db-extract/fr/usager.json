                                        "sense_id": "662e479a-a839-332e-af8a-1ac0059f3f5d",
                                        "entry_id": "b497d6ba-4043-37c9-bca7-ef23f6b09eac",
                                        "glosses": [
                                            "Person, die von etwas Gebrauch macht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4985380-bd6d-46e3-b6b8-db7671f80ce9",
                                                "sense_id": "662e479a-a839-332e-af8a-1ac0059f3f5d",
                                                "text": "Die Nutzer des neuen Internetdienstes sind angesichts der Sicherheitslecks empört."
                                            },
                                            {
                                                "example_id": "607ba434-db8e-4aa3-8fb2-0cd7e269ec61",
                                                "sense_id": "662e479a-a839-332e-af8a-1ac0059f3f5d",
                                                "text": "Ich bin regelmäßiger Nutzer öffentlicher Verkehrsmittel."
                                            },
                                            {
                                                "example_id": "9ba12256-fca5-4522-b786-bf3c185c0259",
                                                "sense_id": "662e479a-a839-332e-af8a-1ac0059f3f5d",
                                                "text": "„Immer wieder werden die Konten von Nutzern gesperrt, die nicht ihren bürgerlichen Namen angegeben haben, sondern ein Pseudonym.“"
                                            },
                                            {
                                                "example_id": "6e564d6a-ad82-43da-81c4-3cb05692b47d",
                                                "sense_id": "662e479a-a839-332e-af8a-1ac0059f3f5d",
                                                "text": "„Das Projekt Paronymwörterbuch profitiert hingegen davon, bereits im Vorfeld zahlreiche Fragen bezüglich seiner Nutzerinnen und Nutzer beantworten und seine Konzeption infolgedessen zielgerichteter vornehmen zu können.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
