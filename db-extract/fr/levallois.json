                    {
                        "sense_id": "a1204ed1-2669-33e9-9a12-6fab96cbdbc7",
                        "entry_id": "2ac9ab3f-51a9-3626-a83a-36cef37033f1",
                        "glosses": [
                            "Nom courant de Levallois-Perret, commune des Hauts-de-Seine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1772265e-e04f-42be-a4a1-50b96d38dead",
                                "sense_id": "a1204ed1-2669-33e9-9a12-6fab96cbdbc7",
                                "text": "Mais c’est bien évidemment la Citroën 2 CV, produite de 1948 à 1990 sur les chaînes de montage de l’usine de Levallois, qui symbolise le plus la volonté de la marque aux chevrons de garantir l’accès du plus grand nombre à l’automobile."
                            },
                            {
                                "example_id": "9f607bc1-732b-462b-902b-5d6c28301a36",
                                "sense_id": "a1204ed1-2669-33e9-9a12-6fab96cbdbc7",
                                "text": "CiviCom a installé son siège à Levallois, sur ce bord de Seine où, jusqu'au siècle dernier, les blanchisseurs lessivaient le linge sale des Parisiens."
                            }
                        ]
                    }
