                    ]
                },
                {
                    "sense_id": "5c040897-f373-3795-bca2-f57687337ca0",
                    "sense_definition": "ein Feuer oder eine Glut aktiv zum Aufhören bringen",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "feuer_licht",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kein weltlicher Herrscher <w>erlöschte</w> damals den kühnen Freiheitsdrang der Menschen."
                        },
                        {
                            "text": "Weder Not noch Leid <w>erlöscht</w> das innere Licht ihrer tiefen Überzeugung."
                        }
                    ],
                    "synonyms": [
                        "löschen",
                        "ersticken"
                    ],
                    "traits": [
