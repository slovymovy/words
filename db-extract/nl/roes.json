                                "target_senses": [
                                    {
                                        "sense_id": "15424e32-b05b-3c60-acd4-c23a93b882fd",
                                        "entry_id": "6ab027b1-af63-3870-a649-54e0d702aeed",
                                        "glosses": [
                                            "A poisoning, as by a spirituous or a narcotic substance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a728b5e5-1114-417b-b909-b80985dc98bc",
                                                "sense_id": "15424e32-b05b-3c60-acd4-c23a93b882fd",
                                                "text": "He suffered acute intoxication from the combined effects of several drugs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "269b69f8-920f-3a2b-aa5b-aa4984d9d553",
                                        "entry_id": "6ab027b1-af63-3870-a649-54e0d702aeed",
                                        "glosses": [
                                            "The state of being intoxicated or drunk."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7a842d2f-d1d7-3d4a-bffe-d550086ab0a9",
                                        "entry_id": "6ab027b1-af63-3870-a649-54e0d702aeed",
                                        "glosses": [
                                            "The act of intoxicating or making drunk."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "41863b71-8243-3336-a9cb-f316d9d9d21c",
                                        "entry_id": "6ab027b1-af63-3870-a649-54e0d702aeed",
                                        "glosses": [
                                            "A high excitement of mind; an elation which rises to enthusiasm, frenzy, or madness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3c5e5d6-3837-426d-a1e6-1ef60b9509e9",
                                                "sense_id": "41863b71-8243-3336-a9cb-f316d9d9d21c",
                                                "text": "Excitement leads to enthusiasm, that moral intoxication, whose effects seem incredible to the sober, while the influence which produces the extravagance appears more extraordinary than the act itself."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "181f600b-e51b-49da-91e3-5fa33bc8aed1",
                        "source_entry_id": "59085e44-2201-3a3d-8ee7-0d34edd6d16a",
                        "source_sense_id": "d3f0861b-728b-3da4-9624-d5580f26d495",
                        "target_lang_word": "enivrement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "enivrement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d6e6921a-07d7-3704-925d-61470057cde0",
                                        "entry_id": "94869fc0-ff11-36aa-991a-ad6b3ee5ba65",
                                        "glosses": [
                                            "État d’une personne qui s’enivre ou action de s’enivrer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2bdd3eb1-2deb-4c83-984c-c8bc8bb270a4",
                                                "sense_id": "d6e6921a-07d7-3704-925d-61470057cde0",
                                                "text": "Au troisième stade, si le buveur y arrivait, c'était l’enivrement complet. L'homme tombait ivre-mort et rien au monde ne pouvait le tirer de son sommeil profond."
                                            },
                                            {
                                                "example_id": "6b57e7bd-be51-49ae-baf6-198383780183",
                                                "sense_id": "d6e6921a-07d7-3704-925d-61470057cde0",
                                                "text": "Un arrivage de bière était annoncé à l’hôtel de Malkinia et une centaine de paysans avaient envahi le rez-de-chaussée dans la fébrile attente des cannettes. Ce n’était pas un bobard, la livraison eut lieu et je fus le témoin, à la chiche lueur des cierges, d’une incroyable séance d’enivrement collectif, chacun sifflant coup sur coup au moins dix bouteilles, jusqu’à tituber ou s’affaler sur place."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6deb76b8-221d-39dd-9321-1510300440f7",
                                        "entry_id": "94869fc0-ff11-36aa-991a-ad6b3ee5ba65",
                                        "glosses": [
                                            "Exaltation, ivresse morale."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79b991ca-674d-4e92-98f4-8a618d580bd7",
                                                "sense_id": "6deb76b8-221d-39dd-9321-1510300440f7",
                                                "text": "— Mais à toi l’on réserve une longue et lente agonie, auprès de laquelle la leur était un enivrement."
                                            },
                                            {
                                                "example_id": "39956b11-23c8-4971-bee4-589c890df656",
                                                "sense_id": "6deb76b8-221d-39dd-9321-1510300440f7",
                                                "text": "Elle conçut alors une pensée virile en dehors des petitesses de la femme, une pensée qui grise pour quelques moments, et dont l’enivrement peut expliquer la clémence …."
                                            },
                                            {
                                                "example_id": "9cad43a9-63af-4456-8bb3-38ccc25ffda7",
                                                "sense_id": "6deb76b8-221d-39dd-9321-1510300440f7",
                                                "text": "Ce n’était que fêtes et enivrements sur la route. De Guiche et Buckingham oubliaient tout."
                                            },
                                            {
                                                "example_id": "b285680c-66a0-471f-849e-b80e9befdd37",
                                                "sense_id": "6deb76b8-221d-39dd-9321-1510300440f7",
                                                "text": "— Madame, dit-il, les souffrances salutaires du souvenir ont leurs charmes, et, dans cet enivrement de la douleur, on trouve parfois un soulagement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
