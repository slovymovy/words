                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f33f63f-8825-4b57-bd9a-0e39c9326dd6",
                                "sense_id": "75c7f6de-245d-349f-8d43-cd208e8af63c",
                                "text": "„Fährt man heute von der Stadt Ramla 15 Kilometer nach Südosten, so stößt man auf einen bizarren Anblick, besonders an Wintertagen, wenn der Stechginster auf den Ebenen im palästinensischen Binnenland grün wird: Auf freiem Feld erstrecken sich lange Schutt- und Steinreihen rund um eine relativ große etwa rechteckige Fläche.“"
                            },
                            {
                                "example_id": "cb4a2431-c416-4bcf-999b-3069ca831fae",
                                "sense_id": "75c7f6de-245d-349f-8d43-cd208e8af63c",
                                "text": "„Er glaubte Schritte und das Rascheln des Stechginsters gehört zu haben, der die Lichtung umstand.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cd94e136-5510-4d99-8585-6ebec19fe041",
                        "source_entry_id": "0ebdcf8e-eed3-383a-ac5f-8d35ec8a2b05",
                        "source_sense_id": "75c7f6de-245d-349f-8d43-cd208e8af63c",
