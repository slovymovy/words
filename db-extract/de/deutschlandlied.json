                "senses": [
                    {
                        "sense_id": "57887456-4ff8-37ce-b906-12dccfbef12c",
                        "entry_id": "908996d5-7f4f-36b3-b5c2-117cfee9ccd6",
                        "glosses": [
                            "Nationalhymne des deutschen Reiches (ab 1922), deren dritte Strophe heute offiziell als Nationalhymne der Bundesrepublik Deutschland dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "094a437d-d7c1-4215-b33f-48bb20ace6c0",
                                "sense_id": "57887456-4ff8-37ce-b906-12dccfbef12c",
                                "text": "„Nach der Marseillaise und dem Deutschlandlied […] erklang die europäische Hymne ‚Ode an die Freude‘.“"
                            },
                            {
                                "example_id": "39b3b6a1-8d8b-463a-85e4-fabea113f361",
                                "sense_id": "57887456-4ff8-37ce-b906-12dccfbef12c",
                                "text": "„In seinem Hotel am Rhein hat er zu vorgerückter Stunde das Deutschlandlied gesungen, was nicht allen gefiel.“"
                            },
                            {
                                "example_id": "d2fc3c9d-9aae-42e9-b705-d040f9ad4042",
                                "sense_id": "57887456-4ff8-37ce-b906-12dccfbef12c",
                                "text": "„Harry, überglücklich wegen der Bilder, sang die amerikanische Nationalhymne, und auch mir ging das Deutschlandlied durch den Sinn.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
