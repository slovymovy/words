    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8b286a7d-e2a9-319c-9069-8fb4618ca588",
                    "sense_definition": "Einen Gegenstand, wie ein Band oder einen Faden, durch eine Öffnung oder einen Hohlraum hindurchziehen.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mechanisch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mit einer Sicherheitsnadel kann man das Gummiband ganz einfach durch den Bund der Hose <w>durchziehen</w>."
                        },
                        {
                            "text": "Der Schneider <w>zieht</w> den reißfesten Faden vorsichtig durch die kleine Öse <w>durch</w>."
                        }
                    ],
                    "antonyms": [
                        "durchschieben"
                    ],
                    "common_phrases": [
                        "ein Band durchziehen",
                        "einen Faden durchziehen"
                    ]
                },
                {
                    "sense_id": "7aea1e62-ea8b-301f-b105-bf20c4bf3a3d",
                    "sense_definition": "Ein Gebiet oder eine Ortschaft auf dem Weg zu einem anderen Ziel durchwandern oder durchqueren.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "bewegung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tausende Zugvögel <w>ziehen</w> im Herbst auf ihrem Weg in den Süden durch dieses Tal <w>durch</w>."
                        },
                        {
                            "text": "Die Wanderer machten keine Rast und <w>zogen</w> zügig durch das gesamte Dorf <w>durch</w>."
                        }
                    ],
                    "synonyms": [
                        "durchqueren",
                        "durchwandern"
                    ],
                    "common_phrases": [
                        "ohne Halt durchziehen"
                    ]
                },
                {
                    "sense_id": "0bb4a494-f87e-3f17-ab70-50515cf991b7",
                    "sense_definition": "Als Leitgedanke, Motiv oder wesentliches Merkmal von Anfang bis Ende durchgängig erkennbar sein.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "abstrakt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Sehnsucht nach Freiheit <w>durchzieht</w> alle Romane und Gedichte dieses berühmten Autors."
                        },
                        {
                            "text": "Ein Gefühl der Unsicherheit <w>durchzog</w> die gesamte politische Debatte des gestrigen Abends."
                        }
                    ],
                    "synonyms": [
                        "durchdringen",
                        "prägen"
                    ]
                },
                {
                    "sense_id": "5c8e1748-db1c-3422-ab7a-f19c22c6ada0",
                    "sense_definition": "Sich netzartig, in Adern oder in Linien durch ein Material, einen Körper oder eine Landschaft erstrecken.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "struktur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mehrere kleine Bäche und Flüsse <w>durchziehen</w> die malerische Landschaft rund um das Gebirge."
                        },
                        {
                            "text": "Die weißen Marmorplatten im Museum sind von feinen grauen Adern dicht <w>durchzogen</w>."
                        }
                    ],
                    "synonyms": [
                        "durchadern"
                    ],
                    "common_phrases": [
                        "von Adern durchzogen"
                    ]
                }
            ]
        }
    ]
