                        "examples": [
                            {
                                "example_id": "b061abe0-60b1-467c-88c3-69dc6b68f050",
                                "sense_id": "6f4588d0-e62a-31b8-88df-e0d64a2ac5fb",
                                "text": "De misoogst van dit jaar heeft de prijzen van graan verhoogd.",
                                "translation": "This year's failed harvest has driven up the prices of grain.",
                                "english": "This year's failed harvest has driven up the prices of grain."
                            },
                            {
                                "example_id": "72416378-483f-48af-93e8-b8fd20cffcdb",
                                "sense_id": "6f4588d0-e62a-31b8-88df-e0d64a2ac5fb",
                                "text": "Door de droogte vrezen de boeren een misoogst.",
                                "translation": "Due to the drought, farmers fear a crop failure.",
                                "english": "Due to the drought, farmers fear a crop failure."
                            },
                            {
                                "example_id": "875f3e86-554c-4bbe-9361-83e31179bc2d",
                                "sense_id": "6f4588d0-e62a-31b8-88df-e0d64a2ac5fb",
                                "text": "Een misoogst kan ernstige gevolgen hebben voor de economie van een land.",
                                "translation": "A crop failure can have serious consequences for a country's economy.",
                                "english": "A crop failure can have serious consequences for a country's economy."
                            }
                        ]
                    }
