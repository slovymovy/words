                "senses": [
                    {
                        "sense_id": "fd3dd185-9bdd-32be-a7e5-fcc936f22bce",
                        "entry_id": "dffc9541-13f6-3d47-89cc-b2edd9a62a7e",
                        "glosses": [
                            "Anzahl der Personen in einer Gruppe die Lesen und Schreiben können; Anteil an der Bevölkerung der alphabetisiert ist."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f22ad81f-6842-43b6-8ce9-182cab064bc8",
                                "sense_id": "fd3dd185-9bdd-32be-a7e5-fcc936f22bce",
                                "text": "Die Alphabetisierungsrate in Deutschland liegt bei ca. 96 Prozent."
                            },
                            {
                                "example_id": "1f69eb70-cc55-4425-83cd-5d4eddf1becc",
                                "sense_id": "fd3dd185-9bdd-32be-a7e5-fcc936f22bce",
                                "text": "„Die rasche Entwicklung von Unternehmen, die Bücher herstellten oder verkauften, trug zu dieser erhöhten Produktion bei, hinzu kam eine höhere Alphabetisierungsrate innerhalb einer Reihe von gesellschaftlichen Gruppen, die ihren sozialen Aufstieg womöglich mithilfe einer »korrekten« und »angemessenen« Sprache in Angriff nahmen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
