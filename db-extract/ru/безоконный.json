                                        ],
                                        "examples": [
                                            {
                                                "example_id": "59ad7471-7363-445c-988f-7ad1052b430b",
                                                "sense_id": "97228596-655d-38aa-b311-c122a71f5fa0",
                                                "text": "Billionaire Charlie Munger’s controversial plans for a massive, windowless dorm at the University of California, Santa Barbara has left many wondering – how is this even possible?"
                                            },
                                            {
                                                "example_id": "b59bfbd7-e55f-4b17-8316-ff2d98f6531a",
                                                "sense_id": "97228596-655d-38aa-b311-c122a71f5fa0",
                                                "text": "\"There are windowless seats / wheelchair spaces at each end of the coach where the (exterior) sliding door slides between the exterior skin and the interior trim. [...] \"My photo is in coach G, the Standard buffet coach, where there's an even longer windowless section.\""
                                            }
