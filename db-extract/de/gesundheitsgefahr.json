                "senses": [
                    {
                        "sense_id": "233fa206-b265-311a-89d7-b7be0d623c4b",
                        "entry_id": "99d55d4c-3c7c-309a-8490-3c4bcb3c59a9",
                        "glosses": [
                            "Risiko (Gefahr) eines Schadens an Körper oder Seele"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad6952f0-11d9-48c3-b78e-51b7f68ae401",
                                "sense_id": "233fa206-b265-311a-89d7-b7be0d623c4b",
                                "text": "„Denn Mieträume, in denen eine Gesundheitsgefahr besteht, erfüllen nicht den vertraglich vereinbarten Zweck.“"
                            },
                            {
                                "example_id": "6d917e8a-c08a-4c4e-a923-f745c9a8f3fe",
                                "sense_id": "233fa206-b265-311a-89d7-b7be0d623c4b",
                                "text": "„Die Unfallversicherungsträger haben mit allen geeigneten Mitteln für die Verhütung von Arbeitsunfällen, Berufskrankheiten und arbeitsbedingten Gesundheitsgefahren und für eine wirksame Erste Hilfe zu sorgen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
