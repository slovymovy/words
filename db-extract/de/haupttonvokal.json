                ],
                "senses": [
                    {
                        "sense_id": "0e4c9783-da27-351b-af9d-02e27dc2c7e3",
                        "entry_id": "6bd94c9c-9c3f-3ef7-b4a0-377aae6ddc9d",
                        "glosses": [
                            "Vokal, der den Hauptakzent eines Wortes trägt"
                        ],
                        "tags": [
                            "speziell Phonetik"
                        ],
                        "examples": [
                            {
                                "example_id": "9056d8c6-c9a3-4829-98a5-24179ac98cfd",
                                "sense_id": "0e4c9783-da27-351b-af9d-02e27dc2c7e3",
                                "text": "„Die Grenzen der jiddischen Dialekte werden nach der Aussprache der Haupttonvokale gezogen."
                            },
                            {
                                "example_id": "2938432a-ac45-455f-95d9-a0d25ec6849d",
                                "sense_id": "0e4c9783-da27-351b-af9d-02e27dc2c7e3",
                                "text": "„Am Wortanfang, vor dem Haupttonvokal und nach /n/ steht dagegen überwiegend Gimel mit Dagesch.“"
                            },
                            {
                                "example_id": "ad6de1cc-eab1-4c6d-9f6c-03d550cc2928",
                                "sense_id": "0e4c9783-da27-351b-af9d-02e27dc2c7e3",
                                "text": "„Das findet sich in den Schonema-Jeschichdn beispielsweise bei kurzen und langen e in endsädzt, ärschdema, mär, gläm, Lähm 'entsetzt, erstmal, mehr, kleben, Leben', wo der Haupttonvokal tiefer realisiert wird als im Standard.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
