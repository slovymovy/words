                                        "sense_id": "8364bdc1-e4de-369e-bb8a-25abf38551e2",
                                        "entry_id": "9851fd24-f442-38b7-a9ef-d1d38198a7a6",
                                        "glosses": [
                                            "im Bereich der (Neu-)Entwicklung von Maschinen, Methoden, Software oder dergleichen tätige Person, oftmals Ingenieur"
                                        ],
                                        "tags": [
                                            "Beruf"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7440804e-b02b-4cbd-88c6-3d08163fe8c7",
                                                "sense_id": "8364bdc1-e4de-369e-bb8a-25abf38551e2",
                                                "text": "Peter arbeitet als Entwickler in einer Softwarefirma."
                                            },
                                            {
                                                "example_id": "6435f4b6-43f7-4517-ad9e-ec924e665248",
                                                "sense_id": "8364bdc1-e4de-369e-bb8a-25abf38551e2",
                                                "text": "„Nicht mehr Hobbyprogrammierer arbeiten an der Software, sondern fest angestellte Entwickler überwiegend großer Firmen wie Microsoft, Google oder IBM.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3fc88bd5-e21a-38f0-81f5-f45a0c115c16",
                                        "entry_id": "9851fd24-f442-38b7-a9ef-d1d38198a7a6",
                                        "glosses": [
                                            "Chemikalienmischung zum Entwickeln „analoger“ Fotos"
                                        ],
                                        "tags": [
                                            "Gegenstand"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd5ba2da-ec21-4176-95bc-6798165879c0",
                                                "sense_id": "3fc88bd5-e21a-38f0-81f5-f45a0c115c16",
                                                "text": "Mit Hilfe des Entwicklers kann Peter das Foto sichtbar machen."
                                            }
