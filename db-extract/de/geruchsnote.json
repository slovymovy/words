                            {
                                "example_id": "55b8ecdf-aba4-4ab2-9653-b7c866ba4f2c",
                                "sense_id": "554d0760-c80c-305e-b7a7-bee3c6e1dbc8",
                                "text": "„Die Geruchsnoten vermischen reife Nuancen von Honigmelone, Vanilleschote, Kamillenblüte und Nougat.“"
                            },
                            {
                                "example_id": "86a744d3-8ab6-4774-98bc-d3c399057663",
                                "sense_id": "554d0760-c80c-305e-b7a7-bee3c6e1dbc8",
                                "text": "„Eigentlich würde man als Geruchsnote eines Fifa-Parfums unter der Amtszeit von Sepp Blatter eher \"modrig, verwesend, käsig, korrupt\" erwarten.“"
                            }
                        ],
