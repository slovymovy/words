                                        "entry_id": "fac195a0-083d-3708-8e9b-7574e63e1dcc",
                                        "glosses": [
                                            "Substanz im pflanzlichen Gewebe, die zum Gelieren dienen kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ec814bd-701b-48c3-9708-5ae99446d1db",
                                                "sense_id": "701ebe3b-e968-31e2-a096-ea19c65cd68e",
                                                "text": "Pektin ist ein hervorragender und preiswerter Entgifter."
                                            }
