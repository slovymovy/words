                                "target_senses": [
                                    {
                                        "sense_id": "2e67da0f-cfae-3d66-81dc-a3b675f36c4c",
                                        "entry_id": "09433775-63c6-3a1f-b7ef-3a8eb0b8fa7c",
                                        "glosses": [
                                            "de eigen lichaamstemperatuur regulerend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa127fe0-483b-4398-8106-174b28f74c63",
                                                "sense_id": "2e67da0f-cfae-3d66-81dc-a3b675f36c4c",
                                                "text": "Warmbloedige dieren hoeven hun lichaamstemperatuur niet te beïnvloeden met hun gedrag."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b33fe5d-091a-3651-a45a-2c0d0f5208ab",
                                        "entry_id": "09433775-63c6-3a1f-b7ef-3a8eb0b8fa7c",
                                        "glosses": [
                                            "emotioneel betrokken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2b2873a-04f0-44cb-92ae-422d9b98732b",
                                                "sense_id": "7b33fe5d-091a-3651-a45a-2c0d0f5208ab",
                                                "text": "Hij is echt een warmbloedige vriend, hij is altijd enorm betrokken als er wat is"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "13966ed1-bf72-3790-a5a0-75f6ba0898dc",
                                        "entry_id": "09433775-63c6-3a1f-b7ef-3a8eb0b8fa7c",
                                        "glosses": [
                                            "temperamentvol."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc264ef9-580f-4b1f-8aff-a756663f4b68",
                                                "sense_id": "13966ed1-bf72-3790-a5a0-75f6ba0898dc",
                                                "text": "Hij is erg warmbloedig, als je het niet met hem eens bent moet je je stilhouden of voorbereiden op een heftige discussie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7d23a920-8e10-41f4-915c-b4cf60284090",
                        "source_entry_id": "d0efb84a-82d6-3b75-acb3-0a560bc799be",
                        "source_sense_description": "zoology: of animal with regulated temperature",
                        "target_lang_word": "homéotherme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "homéotherme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b62ecf43-6db6-3cfc-9c77-71dc98d23420",
                                        "entry_id": "2f9ead46-ad96-3fc0-8b6d-bd5c9dc915de",
                                        "glosses": [
                                            "Dont la température interne est indépendante de celle de l’environnement, en parlant d’un animal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27589a42-c945-41d9-8b5d-a5747009ac64",
                                                "sense_id": "b62ecf43-6db6-3cfc-9c77-71dc98d23420",
                                                "text": "Et ces résultats ne sont pas étonnants, selon les chercheurs, car ils suivent la règle de Bergmann. Ce principe, en zoologie, corrèle la température de l’environnement avec la masse du corps chez les animaux homéothermes – ceux dont la température reste constante."
                                            },
                                            {
                                                "example_id": "be5236b8-cc10-4be7-b48d-5f4f94db49d9",
                                                "sense_id": "b62ecf43-6db6-3cfc-9c77-71dc98d23420",
                                                "text": "Les mammifères sont homéothermes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "homéotherme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "eb95a429-03fd-3cb5-9929-a7c15c9453d6",
                                        "entry_id": "241288ec-6432-3523-999c-a73cc6dc80c7",
                                        "glosses": [
                                            "Animal dont la température interne est indépendante de celle de l’environnement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66282d54-e16b-4261-b29b-704ae60177c9",
                                                "sense_id": "eb95a429-03fd-3cb5-9929-a7c15c9453d6",
                                                "text": "Dans ces conditions, l’homme peut être défini comme un homéotherme, c’est-à-dire comme un individu à sang chaud, plus exactement à température fixe indépendante des conditions ambiantes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d0986664-a75c-47b3-8874-255790c7ef5f",
                        "source_entry_id": "d0efb84a-82d6-3b75-acb3-0a560bc799be",
                        "source_sense_description": "zoology: of animal with regulated temperature",
                        "target_lang_word": "à sang chaud",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "à sang chaud",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "85f95505-9a22-314b-8704-8013e38250e1",
                                        "entry_id": "a2c483bd-8a65-39d2-946e-ba2be97d3f47",
                                        "glosses": [
                                            "Dont la température interne est plus élevée que celle de l’environnement. — Note d’usage : Les zoologistes n’utilisent plus ce terme."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9b5f1038-bc00-42ee-ac88-a9b2870c79ba",
                                                "sense_id": "85f95505-9a22-314b-8704-8013e38250e1",
                                                "text": "Le fluor constitue un bon exemple d'un élément hormétique pour les animaux à sang chaud : la concentration minimale de fluor dans l'eau de boisson et l'alimentation qui leur est nécessaire étant à peine quelques dizaines de fois plus faible que celle à partir de laquelle cet élément provoque l'apparition de symptômes d'intoxication."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2b45a861-7121-4fd0-82bc-5542616c06ae",
                        "source_entry_id": "d0efb84a-82d6-3b75-acb3-0a560bc799be",
                        "source_sense_description": "zoology: of animal with regulated temperature",
                        "target_lang_word": "warmblütig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "warmblütig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7cd32cac-4cbc-3cca-9f68-6328eea0f51f",
                                        "entry_id": "e4c9b2ef-b53f-347b-b1ea-200dc64534b1",
                                        "glosses": [
                                            "die Körpertemperatur annähernd konstant haltend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4f5e252-41f0-4e95-9203-5859d66a5a3b",
                                                "sense_id": "7cd32cac-4cbc-3cca-9f68-6328eea0f51f",
                                                "text": "Die warmblütigen Vögel haben meistens eine höhere Körpertemperatur als Säugetiere."
                                            },
                                            {
                                                "example_id": "06bd7579-b5a2-4331-8886-a9307e936cf9",
                                                "sense_id": "7cd32cac-4cbc-3cca-9f68-6328eea0f51f",
                                                "text": "[Pythons] „ernähren sich üblicherweise von warmblütigen Tieren, das heißt von Vögeln und Säugetieren.“"
                                            },
                                            {
                                                "example_id": "b320d6cf-85eb-4d50-94c8-6f7d6ad73668",
                                                "sense_id": "7cd32cac-4cbc-3cca-9f68-6328eea0f51f",
                                                "text": "[Toxoplasma gondii:] „Dieser einzellige Parasit aus der Familie der Protozoen kann sich prinzipiell in allen warmblütigen Tieren durch Teilung vermehren – auch im Menschen.“"
                                            },
                                            {
                                                "example_id": "65d0e467-19e6-4a44-831f-e34f116951bb",
                                                "sense_id": "7cd32cac-4cbc-3cca-9f68-6328eea0f51f",
                                                "text": "[Leptospira:] „Die Bakterien vermehren sich in warmblütigen Tieren, insbesondere in Ratten, Mäusen, Schweinen, Hunden, Katzen, Pferden, Schafen, Ziegen und Rindern.“"
                                            },
                                            {
                                                "example_id": "19c9f206-cb3a-4fa9-854f-e8ea3fd9454f",
                                                "sense_id": "7cd32cac-4cbc-3cca-9f68-6328eea0f51f",
                                                "text": "„Im gleichen Jahr erließen sie auch ein Tierschutzgesetz, das unter anderem festlegte, dass warmblütige Tiere nicht mehr ohne Betäubung geschlachtet werden durften.“"
                                            },
                                            {
                                                "example_id": "e82b83d0-bd6d-479a-883a-9efdbb65a049",
                                                "sense_id": "7cd32cac-4cbc-3cca-9f68-6328eea0f51f",
                                                "text": "„Die Richter waren aber der Meinung, dass das Töten warmblütiger Tiere ohne vorherige Betäubung nicht qualvoller sei als die üblichen Schlachtmethoden.“"
                                            },
                                            {
                                                "example_id": "7bc36144-c63c-4a6e-8b0d-c55269b62869",
                                                "sense_id": "7cd32cac-4cbc-3cca-9f68-6328eea0f51f",
                                                "text": "„Auf warmblütige Lebewesen wirkt Blausäure schon in geringer Dosis tödlich (1/22 der Dosis für Wirbellose).“"
                                            },
                                            {
                                                "example_id": "84d5c613-8c1c-47d2-aa71-0b2a1f70cf74",
                                                "sense_id": "7cd32cac-4cbc-3cca-9f68-6328eea0f51f",
                                                "text": "[…] „Fische erhalten kaum das gleiche Maß an Mitgefühl und konkretem Tierschutz wie die warmblütigen Wirbeltiere.“"
                                            },
                                            {
                                                "example_id": "d9b623dc-4d32-4efd-b7af-9ed86cca9903",
                                                "sense_id": "7cd32cac-4cbc-3cca-9f68-6328eea0f51f",
                                                "text": "[Das Gefieder] „schützt den warmblütigen Vogelkörper vor Abkühlung, seine Flügel- und Schwanzfedern dienen der Fortbewegung.“"
                                            },
                                            {
                                                "example_id": "50a9ea03-600e-4828-9554-05063d626d8c",
                                                "sense_id": "7cd32cac-4cbc-3cca-9f68-6328eea0f51f",
                                                "text": "„»Wie können diese warmblütigen Haie – was schon sehr ungewöhnlich bei Kiemenatmern ist – in Gebieten überwintern, wo die Wassertemperatur nur 2 Grad Celsius beträgt?«“"
                                            },
                                            {
                                                "example_id": "f86ff6ee-ad25-4086-bc95-80c5882240ea",
                                                "sense_id": "7cd32cac-4cbc-3cca-9f68-6328eea0f51f",
                                                "text": "„Es ist möglich, dass einige Dinosaurier warmblütig waren, andere aber nicht.“"
                                            },
                                            {
                                                "example_id": "f3dcdcba-123a-4e11-85a5-4fea11bc5337",
                                                "sense_id": "7cd32cac-4cbc-3cca-9f68-6328eea0f51f",
                                                "text": "[Dinosaurier:] „Die Urzeitechsen waren weder kaltblütig wie Reptilien noch warmblütig wie heutige Säuger. Die Wahrheit lag wohl in der Mitte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f7ab737b-e8ae-3cdc-8e7c-360c7b3e5188",
                                        "entry_id": "e4c9b2ef-b53f-347b-b1ea-200dc64534b1",
                                        "glosses": [
                                            "ein Warmblüter, also eine aus Voll- und Kaltblütern gekreuzte Pferderasse, seiend; die Bedeutung bezieht sich auf das Temperament der Pferde und hat nichts mit Bedeutung [1] zu tun"
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
