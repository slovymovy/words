                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "50aa85b2-31c8-49aa-a0ac-b92a7d5a04b3",
                                "sense_id": "e5195499-fd08-3863-abd3-7660e6e0efdb",
                                "text": "Rap bitches tell their team: \"Make em like Barbie\" / Had to come off IG so they can't stalk me"
                            },
                            {
                                "example_id": "7b7406f2-10cb-4fa3-92ae-a06212f8f838",
                                "sense_id": "e5195499-fd08-3863-abd3-7660e6e0efdb",
                                "text": "One day I was lurkin' on IG, thirsty, full of the purple"
                            },
                            {
                                "example_id": "e36c7aa1-4a5d-43ef-a567-ecead6d1710d",
                                "sense_id": "e5195499-fd08-3863-abd3-7660e6e0efdb",
                                "text": "Face ID on me, white programmer so they don’t see it’s me / Got fans on me, IG story, know where I be"
                            },
                            {
                                "example_id": "dd3c119f-86b2-4efb-9d82-3fb120ac8449",
                                "sense_id": "e5195499-fd08-3863-abd3-7660e6e0efdb",
                                "text": "Nice, clean, nigga did me dirtier than laundry / Took a scroll through his IG / Just to get a DM from his wifey (What the fuck?)"
                            }
                        ]
                    },
