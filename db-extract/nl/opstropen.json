                                        "sense_id": "d4f5cc21-b59b-3102-8e94-09a2a73c7c00",
                                        "entry_id": "05699e7d-da5a-3e77-bf6c-c17407bd9bc5",
                                        "glosses": [
                                            "To make something into a particular shape, especially cylindrical or fold-like."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0861947-0388-4cbb-a29f-de904d044b18",
                                                "sense_id": "d4f5cc21-b59b-3102-8e94-09a2a73c7c00",
                                                "text": "The shopkeeper had to roll up the poster to make it easier to carry."
                                            },
                                            {
                                                "example_id": "adad7bec-8846-46f7-8cdf-8fde9fa657b8",
                                                "sense_id": "d4f5cc21-b59b-3102-8e94-09a2a73c7c00",
                                                "text": "When they told you not to fold, spindle, or mutilate a punchcard, the spindling referred to rolling it up."
                                            },
                                            {
                                                "example_id": "83346459-2ed6-46c5-9c03-df104136d366",
                                                "sense_id": "d4f5cc21-b59b-3102-8e94-09a2a73c7c00",
                                                "text": "He rolled up his shirt sleeves."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e5d08eaf-1b56-3111-b793-320eb5552763",
                                        "entry_id": "05699e7d-da5a-3e77-bf6c-c17407bd9bc5",
                                        "glosses": [
                                            "To make something into a particular shape, especially cylindrical or fold-like.",
                                            "To pack up into a bundle or bindle."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c1e69ed6-7d87-3c4d-b668-69e0f7c17633",
                                        "entry_id": "05699e7d-da5a-3e77-bf6c-c17407bd9bc5",
                                        "glosses": [
                                            "To make something into a particular shape, especially cylindrical or fold-like.",
                                            "To create a cigar or cigarette, or a joint."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4debeae9-c333-4720-8017-736d90c37690",
                                                "sense_id": "c1e69ed6-7d87-3c4d-b668-69e0f7c17633",
                                                "text": "The audacity of that man rolling up in court was astounding."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a8ef0935-5df9-3ae6-b204-c9c862fb9b4b",
                                        "entry_id": "05699e7d-da5a-3e77-bf6c-c17407bd9bc5",
                                        "glosses": [
                                            "To raise (a car window, rolling door, or rolling security barrier)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb9b5e5d-c318-4cc2-938e-111cf027d5ca",
                                                "sense_id": "a8ef0935-5df9-3ae6-b204-c9c862fb9b4b",
                                                "text": "The shopkeeper had to roll up the security barrier to open the shop."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dad0f051-163b-34dc-a8e8-01bf8a0903cd",
                                        "entry_id": "05699e7d-da5a-3e77-bf6c-c17407bd9bc5",
                                        "glosses": [
                                            "To roll the dice necessary to create a character for a game, especially a role-playing game."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b5de9e85-034d-35ea-91ed-7d14ddba4b37",
                                        "entry_id": "05699e7d-da5a-3e77-bf6c-c17407bd9bc5",
                                        "glosses": [
                                            "To arrive by vehicle, usually by car."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "826ce914-1128-4ec7-b510-941d8355a79b",
                                                "sense_id": "b5de9e85-034d-35ea-91ed-7d14ddba4b37",
                                                "text": "We thought Jim would be late for the wedding, but then we saw him roll up in front of the church in his Mercedes."
                                            },
                                            {
                                                "example_id": "949544a5-7e7d-4a8c-9926-5296d244bf79",
                                                "sense_id": "b5de9e85-034d-35ea-91ed-7d14ddba4b37",
                                                "text": "Don't be rolling up to my door without calling ahead."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "roll up",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c329d584-262a-3be4-8a2a-4af0ee3bc734",
                                        "entry_id": "aaeb63f3-0027-3bf9-88aa-809d2e4d331d",
