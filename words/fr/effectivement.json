            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "b8239568-a075-390b-90ef-5d34398c026d",
                    "sense_definition": "En réalité ; conformément à ce qui a été dit, supposé ou prévu.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "confirmation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le train est <w>effectivement</w> arrivé avec quelques minutes de retard ce matin."
                        },
                        {
                            "text": "Comme nous le pensions, ce projet demande <w>effectivement</w> beaucoup plus de travail."
                        }
                    ],
                    "synonyms": [
                        "en effet"
                    ]
                },
                {
                    "sense_id": "1629de3a-58bb-32fe-995d-f71b686cd3a0",
                    "sense_definition": "Exprime l'assentiment ou l'accord pour confirmer une remarque ou répondre affirmativement.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "confirmation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "— Vous aviez raison sur ce point. — <w>Effectivement</w>, la situation est délicate."
                        },
                        {
                            "text": "— C'est votre voiture garée devant ? — <w>Effectivement</w>, je vais la déplacer tout de suite."
                        }
                    ],
                    "synonyms": [
                        "en effet"
                    ]
                },
                {
                    "sense_id": "4732dc43-afb9-3628-9d32-754013e8ebda",
                    "sense_definition": "De manière concrète et tangible, de façon à produire un effet réel.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "application",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ces nouvelles règles doivent être <w>effectivement</w> appliquées dès la semaine prochaine."
                        },
                        {
                            "text": "Pour résoudre cette crise, le gouvernement doit agir <w>effectivement</w> sur le terrain."
                        }
                    ],
                    "synonyms": [
                        "de facto"
                    ]
                }
            ]
        }
    ]
