                    }
                ],
                "translations": [
                    {
                        "translation_id": "f2d279ee-9607-442f-bf7b-8bd305a9ca72",
                        "source_entry_id": "8075a023-06bd-36cc-83e7-4ab734c70c04",
                        "target_lang_word": "humane",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "humane",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d380e8ca-50d6-37e8-8f8e-72cee71676d2",
                                        "entry_id": "2e7183ab-bcd8-3993-b11d-5861d1d23188",
                                        "glosses": [
                                            "Having or showing concern for the pain or suffering of another; compassionate."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09674560-8fec-4678-8cf3-18cc7c99941a",
                                                "sense_id": "d380e8ca-50d6-37e8-8f8e-72cee71676d2",
                                                "text": "It is no longer considered humane to perform vivisection on research animals."
                                            },
                                            {
                                                "example_id": "d0305956-1c30-4a12-92b7-078597795cca",
                                                "sense_id": "d380e8ca-50d6-37e8-8f8e-72cee71676d2",
                                                "text": "As methods of execution go, beheading is more humane than drawing and quartering."
                                            },
                                            {
                                                "example_id": "363be5d7-85a1-4d1c-a14f-18ba6d0c4341",
                                                "sense_id": "d380e8ca-50d6-37e8-8f8e-72cee71676d2",
                                                "text": "The unfortunate thing about Bando, said Arthur, is that it is no longer to be obtained in this unfortunate country. I understand that inferior products, such as Ostreine and Spanish Flies, may still be wheedled out of some of the humaner chemists, up and down the city, in the ten minutes or a quarter of an hour immediately following their midday meal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "284c0d7d-577f-3d8d-9bf2-973ee4a794b8",
                                        "entry_id": "2e7183ab-bcd8-3993-b11d-5861d1d23188",
                                        "glosses": [
                                            "Pertaining to branches of learning concerned with human affairs or the humanities, especially classical literature or rhetoric."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "792a08e6-d605-47cc-a173-7792c6e418d5",
                                                "sense_id": "284c0d7d-577f-3d8d-9bf2-973ee4a794b8",
                                                "text": "many divine precepts to counterpoise our hearts, special antidotes both in scriptures and humane authors, which who so will observe, shall purchase much ease and quietness unto himself."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a9af8a6-76fb-3842-8d20-067e37af7cfc",
                                        "entry_id": "2e7183ab-bcd8-3993-b11d-5861d1d23188",
                                        "glosses": [
                                            "Obsolete spelling of human."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b8a3ea0d-d33f-479c-a5eb-5f6b39435510",
                                                "sense_id": "9a9af8a6-76fb-3842-8d20-067e37af7cfc",
                                                "text": "[N]o attempt is made to call in God to their reſcue, as if he vvere an idle unconcern'd ſpectator of humane affairs, or ſo inconſiderable an ally, as not to be vvorth the care of engaging him on their ſide."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6689b79e-68c3-4432-be75-444dbe8f388e",
                        "source_entry_id": "8075a023-06bd-36cc-83e7-4ab734c70c04",
                        "target_lang_word": "humain",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "humain",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cb2e5876-4033-3381-bed2-c67c952a1faf",
                                        "entry_id": "a6485836-c145-3014-ac6f-950ec3bd5d36",
                                        "glosses": [
                                            "Relatif à l’espèce humaine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3b9b143-6f2d-42e5-aa93-62cacfa7a4a4",
                                                "sense_id": "cb2e5876-4033-3381-bed2-c67c952a1faf",
                                                "text": "Lorsque l’on ne peut faire autrement que d’affronter le mauvais temps, les forces humaines se décuplent et l’esprit devient plus clairvoyant."
                                            },
                                            {
                                                "example_id": "8a866fe6-6289-42b6-8ec1-5bf47af73202",
                                                "sense_id": "cb2e5876-4033-3381-bed2-c67c952a1faf",
                                                "text": "Aucune forme humaine ne surgit entre les halliers, aucun bruit humain ne m’arrive. Partout le silence et partout la solitude !"
                                            },
                                            {
                                                "example_id": "78817ae6-161d-466d-ad5b-8973e25bb648",
                                                "sense_id": "cb2e5876-4033-3381-bed2-c67c952a1faf",
                                                "text": "– « Tu es si humain ! » lui disait parfois ma mère, avec un accent d’indéfinissable suspicion.\nElle ajoutait, pour ne le point trop blesser :\n– « Oui, tu comprends, tu étends la main pour savoir s’il pleut. »"
                                            },
                                            {
                                                "example_id": "54c7703b-3dff-4249-8dc8-dd8a0acad558",
                                                "sense_id": "cb2e5876-4033-3381-bed2-c67c952a1faf",
                                                "text": "La justice, en tant qu’elle veut l’inviolabilité de la personne humaine par le seul fait qu’elle est humaine, ne saurait considérer l’homme que dans l’abstrait."
                                            },
                                            {
                                                "example_id": "daf4fe5d-480f-44ec-b721-5485f6cf0024",
                                                "sense_id": "cb2e5876-4033-3381-bed2-c67c952a1faf",
                                                "text": "Elle se passa les doigts sur les paupières, les yeux reprirent une expression humaine comme si elle revenait d’une pâmoison."
                                            },
                                            {
                                                "example_id": "401e0e63-7321-42b5-a1d2-d2dac891c677",
                                                "sense_id": "cb2e5876-4033-3381-bed2-c67c952a1faf",
                                                "text": "Ne revenez plus, monsieur, autrement vous tueriez aussi la mère, car la puissance de Dieu est infinie, mais la nature humaine a ses limites."
                                            },
                                            {
                                                "example_id": "91297f77-111b-4be0-a0b8-fe588b962a40",
                                                "sense_id": "cb2e5876-4033-3381-bed2-c67c952a1faf",
                                                "text": "Confucius était un moraliste qui se méfiait de l’intelligence ; le terre à terre des relations humaines lui plaisait mieux que la spéculation ondoyante."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bd3b7a11-573a-377b-bda3-f93a969fb104",
                                        "entry_id": "a6485836-c145-3014-ac6f-950ec3bd5d36",
                                        "glosses": [
                                            "Qui ressemble au comportement et aux manières de l’espèce humaine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "22c11616-9e34-4900-b256-aeebc041f29c",
                                                "sense_id": "bd3b7a11-573a-377b-bda3-f93a969fb104",
                                                "text": "Je vais errer sur le chemin où les crapauds lents voyagent vers l’éteule, entre les chardons, avec des mouvements humains."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "669b8b8a-116c-3ae1-9cff-1ac51b07e219",
                                        "entry_id": "a6485836-c145-3014-ac6f-950ec3bd5d36",
                                        "glosses": [
                                            "Qui est sensible à la pitié, secourable, bienfaisant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1991aef2-f742-4668-b61a-1f2080139d58",
                                                "sense_id": "669b8b8a-116c-3ae1-9cff-1ac51b07e219",
                                                "text": "Cet homme est très humain et fort sensible aux misères d’autrui."
                                            },
                                            {
                                                "example_id": "f1cb0ae3-bd70-40aa-9572-dff67333dfda",
                                                "sense_id": "669b8b8a-116c-3ae1-9cff-1ac51b07e219",
                                                "text": "Je ne connais pas de cœur plus humain."
                                            },
                                            {
                                                "example_id": "df2294d1-23fb-47a6-b802-da2dbb05575f",
                                                "sense_id": "669b8b8a-116c-3ae1-9cff-1ac51b07e219",
                                                "text": "Avoir, montrer des sentiments humains."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "humain",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cbaaf986-63a0-340e-947c-5e0e59a0580c",
                                        "entry_id": "5b072f49-9634-3f03-8ec8-a9512ef32f29",
                                        "glosses": [
                                            "Être vivant qui fait partie de l’espèce humaine."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "94de2cd5-5755-3e44-840f-a8fe088da7e0",
                                        "entry_id": "5b072f49-9634-3f03-8ec8-a9512ef32f29",
                                        "glosses": [
                                            "L’humanité dans son ensemble."
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd4d8882-23c8-4953-bfdd-1fe740d803a3",
                                                "sense_id": "94de2cd5-5755-3e44-840f-a8fe088da7e0",
                                                "text": "J’étais un animal traqué, je ne comprenais plus rien aux humains."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "51ac0f15-5a6b-3502-b0bb-d8443de3f3cd",
                                        "entry_id": "5b072f49-9634-3f03-8ec8-a9512ef32f29",
                                        "glosses": [
                                            "Nature humaine, relation sociale."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "54a8c377-4315-4a22-9114-e4a82225b89a",
                                                "sense_id": "51ac0f15-5a6b-3502-b0bb-d8443de3f3cd",
                                                "text": "Mais ils se sont rendu compte qu’il fallait aussi de la proximité. La MSAP permet de remettre un peu d’humain dans la chaîne."
                                            }
                                        ]
                                    }
