                                                "example_id": "df8cd92c-5d9f-4a47-a625-8c515ba53c1d",
                                                "sense_id": "28d8e66e-949c-3e2a-90ae-82de57e1c7a8",
                                                "text": "„Auf elterlichen Wunsch pilgerte er schließlich nach Rom, um vom Papst Dispens zu erlangen.“"
                                            },
