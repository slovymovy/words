                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "métempsychose",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fd38b754-a8f8-3cde-b68e-a3bb42d07d36",
                                        "entry_id": "a780d81f-da4d-35df-92b5-13f4d3f4dbc9",
                                        "glosses": [
                                            "Variante orthographique de métempsycose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41a9eda5-0a64-49d1-bad3-1d58b9a3780f",
                                                "sense_id": "fd38b754-a8f8-3cde-b68e-a3bb42d07d36",
                                                "text": "Les progrès de la civilisation , ai-je dit, ont perfectionné la métempsychose, en la bornant au retour des âmes dans des corps humains, résultat qui la transforme en une sorte de palingénésie ou seconde naissance, image imparfaite de la palingénésie véritable, de la grande palingénésie qui doit s'opérer à la destruction du monde."
                                            },
                                            {
                                                "example_id": "91d645f3-411b-4b9a-b8ee-6fb7e0013601",
                                                "sense_id": "fd38b754-a8f8-3cde-b68e-a3bb42d07d36",
                                                "text": "Le bouddhisme crée une chaîne entre les vivants avec sa théorie de la métempsychose et du karma."
                                            },
                                            {
                                                "example_id": "f52a4d08-2541-4de6-b83b-0c0056705cd4",
                                                "sense_id": "fd38b754-a8f8-3cde-b68e-a3bb42d07d36",
                                                "text": "La légende raconte même que le prince croyait à la métempsychose et voulait revenir sur terre réincarné en cheval."
                                            }
                                        ]
                                    }
                                ]
                            },
