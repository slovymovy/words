                    }
                ],
                "translations": [
                    {
                        "translation_id": "c533ae5b-ca32-45a3-9a48-d92c1fc9146f",
                        "source_entry_id": "1ab8831f-b465-396b-9397-9ac9650976aa",
                        "source_sense_id": "dbc7c61a-610d-3e57-a9e8-da5d70d32e80",
                        "source_sense_description": "type of musical piece",
                        "target_lang_word": "árie",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "árie",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "6facfcae-4695-3859-9c3b-c03bf82aa8c0",
                                        "entry_id": "2e0ea125-a1c7-3910-9509-f1ef3bde674b",
                                        "glosses": [
                                            "sólová vokální skladba s hudebním doprovodem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d4f4366-c0c1-460b-bd2c-88367a4eaaf9",
                                                "sense_id": "6facfcae-4695-3859-9c3b-c03bf82aa8c0",
                                                "text": "„Aj hle,“ zvolá doktor, „árie z ‚Prodané nevěsty‘!“ — a rozveselen zpívá nápěv a ohlíží se po tobolce."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "429d0087-5baa-40f0-bef6-fe4212d12917",
                        "source_entry_id": "1ab8831f-b465-396b-9397-9ac9650976aa",
                        "source_sense_id": "dbc7c61a-610d-3e57-a9e8-da5d70d32e80",
                        "source_sense_description": "type of musical piece",
                        "target_lang_word": "aria",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aria",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c76124e6-a4d8-370f-98bb-53f6ad39b0a4",
                                        "entry_id": "d32b3591-f0ea-3817-92bd-36c374c442b1",
                                        "glosses": [
                                            "Air de musique, mélodie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68fb5e3f-cd0e-4d1f-b6e2-d5f07adf6759",
                                                "sense_id": "c76124e6-a4d8-370f-98bb-53f6ad39b0a4",
                                                "text": "– « À ce moment-là, dès l'offertoire », reprit M. de Charlus qui pour d'autres raisons mais de la même manière que les bons orateurs à la Chambre, ne répondait jamais à une interruption et feignait de ne pas l'avoir entendue, « ce serait ravissant de voir notre jeune ami palestrinisant et exécutant même une aria de Bach. »"
                                            },
                                            {
                                                "example_id": "927172d6-1c2c-4991-a801-3486b2a87c38",
                                                "sense_id": "c76124e6-a4d8-370f-98bb-53f6ad39b0a4",
                                                "text": "Seule la première aria a été composée pour Aloysia, et encore faut-il voir de près en quelles circonstances."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "50ed57ed-2b65-3aac-a6e2-39078c093ea4",
                                        "entry_id": "d32b3591-f0ea-3817-92bd-36c374c442b1",
                                        "glosses": [
                                            "Incantation chantée permettant de lancer un sort magique dans la littérature fantastique."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "aria",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5f3ce0bc-f6e9-38ec-911f-2a35a19762c6",
                                        "entry_id": "2bfdf04b-c78f-3e80-95ef-dd0a45ad3400",
                                        "glosses": [
                                            "Amoncèlement d’objets gênants."
                                        ],
                                        "tags": [
                                            "Désuet sauf au Canada"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4663bdf4-cf18-48da-ba9f-4742f7b67e68",
                                                "sense_id": "5f3ce0bc-f6e9-38ec-911f-2a35a19762c6",
                                                "text": "Pourvu que l’autre locataire n’arrive pas emménager juste au moment où M. Schaunard déménagera! ça me ferait un aria dans mes escaliers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b58dc49c-edde-307b-abbb-f4765cf085fc",
                                        "entry_id": "2bfdf04b-c78f-3e80-95ef-dd0a45ad3400",
                                        "glosses": [
                                            "Embarras."
                                        ],
                                        "tags": [
                                            "Désuet sauf au Canada"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d4360e1-6372-4b45-b78f-1542c36283ed",
                                                "sense_id": "b58dc49c-edde-307b-abbb-f4765cf085fc",
                                                "text": "Il n’y a pas la moitié des élèves qui déjeunent à l’école, Soupçonne-t-on pourquoi ? Parce que c’est trop d’aria d’aménager le panier, c’est-à-dire d’y mettre un chiffon de serviette, un morceau de pain et une bouteille bouchée. Même des indigents qui ont la cantine gratuite n’en font pas profiter leurs enfants ! c’est trop d’aria."
                                            },
                                            {
                                                "example_id": "ca687ea5-d835-4e75-b0df-759fbe2f9438",
                                                "sense_id": "b58dc49c-edde-307b-abbb-f4765cf085fc",
                                                "text": "Sa sœur ne vient la voir qu’en cachette de son mari : avec ça que… Et lui, quand il en parle, c’est toujours un tas d’arias, et des airs de mépris bien ridicules."
                                            },
                                            {
                                                "example_id": "47897c41-7461-48b5-970d-2f69870b923b",
                                                "sense_id": "b58dc49c-edde-307b-abbb-f4765cf085fc",
                                                "text": "D’un coup, il est tombé. On me l’a ramené dans un taxi, mort. Vous parlez d’un aria ! Un vrai malheur ! Sans blague !"
                                            },
                                            {
                                                "example_id": "dddfb7da-3395-4de4-824d-4703f036d3d2",
                                                "sense_id": "b58dc49c-edde-307b-abbb-f4765cf085fc",
                                                "text": "Mais, comme dit Pauline, c’est « tout un aria » pour moi, que d’aborder une salle de théâtre ou de cinéma. L’impotence rend timide."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d4cc32d9-7a14-4fae-80bd-c186a22d8788",
                        "source_entry_id": "1ab8831f-b465-396b-9397-9ac9650976aa",
                        "source_sense_id": "dbc7c61a-610d-3e57-a9e8-da5d70d32e80",
                        "source_sense_description": "type of musical piece",
                        "target_lang_word": "Arie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Arie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b1e29878-042c-3deb-858f-eba3339030ec",
                                        "entry_id": "bd9fd323-d23e-38de-aed3-8bf47288c141",
                                        "glosses": [
                                            "solistisch vorgetragenes Gesangsstück, das üblicherweise von einem Orchester begleitet wird"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "382fcc83-c1fa-4a16-97ca-f74f80803d4a",
                                                "sense_id": "b1e29878-042c-3deb-858f-eba3339030ec",
                                                "text": "In der Regel ist eine Arie Teil eines größeren Werkes wie einer Oper, einer Kantate oder eines Oratoriums."
                                            },
                                            {
                                                "example_id": "c7856749-ba2e-4101-acb7-1ca6de6ee559",
                                                "sense_id": "b1e29878-042c-3deb-858f-eba3339030ec",
                                                "text": "„Bald fühlte sie sich versucht, selbst auf die Bühne zu stürzen und die Arie zu singen, welche die Sängerin gerade vortrug, bald hatte sie Lust, einem unweit von ihr sitzenden alten Herrn mit dem Fächer auf den Kopf zu tippen oder sich zu Hélène hinüberzubeugen und sie zu kitzeln.“"
                                            },
                                            {
                                                "example_id": "830d995c-ee4e-4cf6-b9d0-87509f043846",
                                                "sense_id": "b1e29878-042c-3deb-858f-eba3339030ec",
                                                "text": "„Sie dankte ihm für die Partitur und bat ihn, ihr noch einige andere Arien zu besorgen.“"
                                            },
                                            {
                                                "example_id": "797ba34c-85de-44c2-bc1c-6db3727bbff4",
                                                "sense_id": "b1e29878-042c-3deb-858f-eba3339030ec",
                                                "text": "„Ein Sänger singt bei einem Agenten eine Arie vor.“"
                                            },
                                            {
                                                "example_id": "c12055ea-ecdc-465a-9ef3-8abcd94df5a5",
                                                "sense_id": "b1e29878-042c-3deb-858f-eba3339030ec",
                                                "text": "„Weitere Gedanken zu Arie und Rezitativ folgen, denn auf die ist Wielands Singspielkonzept eingeschränkt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
