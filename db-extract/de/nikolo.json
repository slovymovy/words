                "senses": [
                    {
                        "sense_id": "658fd72f-c7ff-3f36-84dd-7af53daf3778",
                        "entry_id": "dfbf65e6-3670-37f5-b810-22ac28c1718d",
                        "glosses": [
                            "Figur des Weihnachtsbrauchtums nach dem Vorbild des heiligen Nikolaus, an deren Existenz die Kinder glauben sollen; sie trägt eine große Mütze und ein langes Gewand und füllt in der Nacht zum 6. Dezember den Kindern Süßigkeiten in die Schuhe oder bringt ihnen andere Geschenke"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "a914b9bd-8d45-4e58-89b4-1bd7c155bfb3",
                                "sense_id": "658fd72f-c7ff-3f36-84dd-7af53daf3778",
                                "text": "Putz deine Schuhe, morgen kommt der Nikolo!"
                            },
                            {
                                "example_id": "b78d0d69-fa96-4682-b3e6-5f70e1522fe0",
                                "sense_id": "658fd72f-c7ff-3f36-84dd-7af53daf3778",
                                "text": "Guck mal! Meine neue Kette! Hab ich vom Nikolo geschenkt bekommen!"
                            },
                            {
                                "example_id": "9590d721-a343-4a99-bb9d-3ce6a5b0a30f",
                                "sense_id": "658fd72f-c7ff-3f36-84dd-7af53daf3778",
                                "text": "Glaubst du noch an den Nikolo?"
                            },
                            {
                                "example_id": "ac795e5e-1273-4539-ad56-08a082bec6aa",
                                "sense_id": "658fd72f-c7ff-3f36-84dd-7af53daf3778",
                                "text": "Gustav untersucht die Unterschiede der Darstellung des Nikolos in der Werbung von 20 europäischen Staaten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "17cb4d82-0ded-3de4-8e8b-9bb1fa9d028d",
                        "entry_id": "dfbf65e6-3670-37f5-b810-22ac28c1718d",
                        "glosses": [
                            "Person, die sich als Nikolo^([1]) verkleidet hat und am 6. Dezember die Kinder beschenkt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89286c31-281e-4f97-922b-fe3042a21f4d",
                                "sense_id": "17cb4d82-0ded-3de4-8e8b-9bb1fa9d028d",
                                "text": "Im Einkaufszentrum liefen heute viele Nikolos umher, die an die Kinder Süßigkeiten verteilten."
                            },
                            {
                                "example_id": "52e9acee-8dee-4589-b599-d02db2f1cfd6",
                                "sense_id": "17cb4d82-0ded-3de4-8e8b-9bb1fa9d028d",
                                "text": "„In NÖ und in Vorarlberg wiederum kommen je nach Alter und entsprechender Vorbereitung der Kinder aus der Gemeinde bekannte Personen als Nikolo verkleidet in die Gruppe.“"
                            },
                            {
                                "example_id": "ea5ab3bf-3da1-4d10-83e7-860d31efaaf3",
                                "sense_id": "17cb4d82-0ded-3de4-8e8b-9bb1fa9d028d",
                                "text": "„Markus Komar aus Edling besucht als Nikolo verkleidet zahlreiche Kinder in der Gemeinde Eberndorf."
                            },
                            {
                                "example_id": "30207dab-6f88-4e18-bc3c-cef36876de46",
                                "sense_id": "17cb4d82-0ded-3de4-8e8b-9bb1fa9d028d",
                                "text": "„Christian Oberthaler, der als Nikolo verkleidet die Ansprache hielt, versteht die Aufregung nicht."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
