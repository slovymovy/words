                        "glosses": [
                            "Antibabypille, die nur wenig Gestagen und kein Östrogen enthält und nicht den Eisprung verhindert, sondern nur den Schleim im Gebärmutterhals verdickt"
                        ],
                        "tags": [],
                        "examples": [
