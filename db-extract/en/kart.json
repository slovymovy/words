                    {
                        "sense_id": "335c57e8-4c87-3dee-9ee1-deb2cad86d56",
                        "entry_id": "1acf88fc-bcf5-32c2-a6b1-33402dd7e97f",
                        "glosses": [
                            "A go-cart."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "81edfc62-4d4e-38ff-9a64-80d0daf2c895",
                        "entry_id": "1acf88fc-bcf5-32c2-a6b1-33402dd7e97f",
                        "glosses": [
                            "A subgenre of racing game with cartoonish characters, unrealistic physics and a focus on battling with power-ups and weapons."
                        ],
                        "tags": [
                            "attributive"
                        ],
                        "examples": [
                            {
                                "example_id": "49cc3828-3862-40a7-a10a-b23faa74ebe6",
                                "sense_id": "81edfc62-4d4e-38ff-9a64-80d0daf2c895",
                                "text": "For our kart racer , we will start by investigating common elements in similar games that we will need to bring to life"
                            },
                            {
                                "example_id": "12b89e27-c6fe-4099-b6ae-b48e1350f9c0",
                                "sense_id": "81edfc62-4d4e-38ff-9a64-80d0daf2c895",
                                "text": "As there have been many kart games since Mario Kart. Before Mario Kart racing games were generally the same. This new style caught like fire."
                            },
                            {
                                "example_id": "6e26e7e4-f375-4f2d-9c4f-f361c5637290",
                                "sense_id": "81edfc62-4d4e-38ff-9a64-80d0daf2c895",
                                "text": "However, the tracks in a kart racing game tend to be a little bit wackier than your average racer and this was no different – loop-de-loops, racing upside down, and right-angle corners were all commonplace."
                            }
                        ]
                    },
                    {
                        "sense_id": "2e24f6f1-7b7f-3fae-b6b1-030af2f33e07",
                        "entry_id": "1acf88fc-bcf5-32c2-a6b1-33402dd7e97f",
                        "glosses": [
                            "A subgenre of racing game with cartoonish characters, unrealistic physics and a focus on battling with power-ups and weapons.",
                            "A vehicle in such a game."
                        ],
