                ],
                "senses": [
                    {
                        "sense_id": "3fb4f19a-6ba7-3cfa-a9b7-375d79a85a59",
                        "entry_id": "5324a693-9ec0-33ad-9189-461024b4553c",
                        "glosses": [
                            "To woo or court in a better, more successful or more assiduous manner."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "a99a22d7-0aac-40fd-bd70-ea5c63685d38",
                                "sense_id": "3fb4f19a-6ba7-3cfa-a9b7-375d79a85a59",
                                "text": "I came of a very robust family; I'll agree now to outcourt any two girls in this town if you give me likely material—a-hem!"
                            },
                            {
                                "example_id": "fae7c1fc-377a-409e-a492-e6561e675d63",
                                "sense_id": "3fb4f19a-6ba7-3cfa-a9b7-375d79a85a59",
                                "text": "I knew from the beginning that I would have to move fast to keep Minnie to myself. Kansas City was full of rakehell bachelors, all of whom I had to outcourt."
                            },
                            {
                                "example_id": "bde3bc29-fb3f-4e64-bc3c-9ffe461cf7d4",
                                "sense_id": "3fb4f19a-6ba7-3cfa-a9b7-375d79a85a59",
                                "text": "Any American can outcourt any weakling Englishman."
                            },
                            {
                                "example_id": "251f13d5-7004-4e08-9e7c-27e597345841",
                                "sense_id": "3fb4f19a-6ba7-3cfa-a9b7-375d79a85a59",
                                "text": "It shows the peahens that the peacock is strong. And it shows other males that this peacock can outstrut, outfly, outcourt, and generally outcompete them."
                            }
                        ]
                    }
                ],
