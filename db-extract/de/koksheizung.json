                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc8b035f-2484-4092-b892-4553dffcfed8",
                                "sense_id": "41ddd4a3-e02c-37d3-813b-9ebf68bb1ac3",
                                "text": "Koksheizungen sind heutzutage weit weniger verbreitet als früher."
                            },
                            {
                                "example_id": "dac19d31-c915-4f9f-8e77-bb87b3cbb09a",
                                "sense_id": "41ddd4a3-e02c-37d3-813b-9ebf68bb1ac3",
                                "text": "Wir hatten früher eine Koksheizung in unserem Haus."
                            },
                            {
                                "example_id": "6d3fa0b1-8ae7-4ccc-b572-412939fac5bc",
                                "sense_id": "41ddd4a3-e02c-37d3-813b-9ebf68bb1ac3",
                                "text": "„In der Wohnung des Mieters befand sich eine alte Koksheizung sowie eine vom Vermieter geleaste Ölheizung.“"
                            }
                        ],
