                                "sense_id": "6a0ac257-1b63-3695-8052-5b026f2897e5",
                                "text": "the urgency of a demand"
                            },
                            {
                                "example_id": "5ac5301d-29f4-4f81-b960-44b7c34d99b9",
                                "sense_id": "6a0ac257-1b63-3695-8052-5b026f2897e5",
                                "text": "Arsenal lacked urgency and inspiration until shortly before half-time, Wheater's block denying Van Persie from close range before Walcott drilled wide."
                            }
                        ]
                    },
                    {
                        "sense_id": "7b34f724-3176-3175-93da-172190fcebdd",
                        "entry_id": "05511cb5-cfe1-3c06-a6a7-40b620c97753",
