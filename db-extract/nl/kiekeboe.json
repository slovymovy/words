                        "sense_id": "d5032ea4-22f2-367d-accc-cde6a6d735c2",
                        "entry_id": "c33e7d8f-13a2-3cd7-a621-59f181321c1d",
                        "glosses": [
                            "iets verborgen houden zodat het onverwacht zichtbaar wordt"
