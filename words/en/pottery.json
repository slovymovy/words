{
    "word_family": [
        "pot",
        "potter"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7793249c-0034-3f71-a442-3c90b2add885",
                    "sense_definition": "Objects made out of baked clay, such as bowls, plates, and vases.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The museum displays ancient <w>pottery</w> found in the region.",
                            "target_lang_translations": {
                                "ru": "В музее выставлена древняя <w>керамика</w>, найденная в этом регионе.",
                                "tr": "Müze, bölgede bulunan antik <w>çömlekleri</w> sergiliyor."
                            }
                        },
                        {
                            "text": "She bought a beautiful piece of <w>pottery</w> at the market.",
                            "target_lang_translations": {
                                "ru": "Она купила красивое <w>гончарное изделие</w> на рынке.",
                                "tr": "Pazardan güzel bir <w>seramik eşya</w> satın aldı."
                            }
                        }
                    ],
                    "synonyms": [
                        "ceramics",
                        "earthenware",
                        "crockery"
                    ],
                    "common_phrases": [
                        "piece of pottery",
                        "ancient pottery",
                        "handmade pottery"
                    ],
                    "target_lang_definitions": {
                        "ru": "Изделия из обожженной глины, такие как миски, тарелки и вазы",
                        "tr": "Kâse, tabak ve vazo gibi pişmiş kilden yapılmış eşyalar."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кера́мика",
                                "target_lang_sense_clarification": "собирательное название изделий"
                            },
                            {
                                "target_lang_word": "гонча́рные изде́лия",
                                "target_lang_sense_clarification": "предметы быта из глины"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "çömlek",
                                "target_lang_sense_clarification": "toprak kap veya eşya"
                            },
                            {
                                "target_lang_word": "seramik",
                                "target_lang_sense_clarification": "pişmiş kilden eşyaların genel adı"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f68596a9-a8b8-3772-9951-bf54dde9fbac",
                    "sense_definition": "The art or craft of making objects from clay.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He decided to take a <w>pottery</w> class to learn how to make bowls.",
                            "target_lang_translations": {
                                "ru": "Он решил пойти на курсы <w>гончарного дела</w>, чтобы научиться делать миски.",
                                "tr": "Kâse yapmayı öğrenmek için bir <w>çömlekçilik</w> kursuna katılmaya karar verdi."
                            }
                        },
                        {
                            "text": "Making <w>pottery</w> requires patience and steady hands.",
                            "target_lang_translations": {
                                "ru": "Занятие <w>гончарным делом</w> требует терпения и твердой руки.",
                                "tr": "<w>Çömlek yapmak</w> sabır ve titiz eller gerektirir."
                            }
                        }
                    ],
                    "synonyms": [
                        "ceramics"
                    ],
                    "common_phrases": [
                        "pottery class",
                        "pottery wheel",
                        "learn pottery"
                    ],
                    "target_lang_definitions": {
                        "ru": "Искусство или ремесло изготовления предметов из глины",
                        "tr": "Kilden eşya yapma sanatı veya zanaatı."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гонча́рное де́ло",
                                "target_lang_sense_clarification": "ремесло"
                            },
                            {
                                "target_lang_word": "кера́мика",
                                "target_lang_sense_clarification": "искусство"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "çömlekçilik",
                                "target_lang_sense_clarification": "çömlek yapma zanaatı"
                            },
                            {
                                "target_lang_word": "seramik sanatı",
                                "target_lang_sense_clarification": "kilden obje üretme sanatı"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ad8a199a-f089-376d-831d-7ea69199e67a",
                    "sense_definition": "A factory or workshop where clay objects are made.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We visited a traditional <w>pottery</w> to watch the artisans at work.",
                            "target_lang_translations": {
                                "ru": "Мы посетили традиционную <w>гончарню</w>, чтобы понаблюдать за работой мастеров.",
                                "tr": "Zanaatkarları iş başında izlemek için geleneksel bir <w>çömlekçi atölyesini</w> ziyaret ettik."
                            }
                        },
                        {
                            "text": "The old <w>pottery</w> has been converted into a museum.",
                            "target_lang_translations": {
                                "ru": "Старая <w>гончарная мастерская</w> была переоборудована в музей.",
                                "tr": "Eski <w>çömlekathane</w> bir müzeye dönüştürüldü."
                            }
                        }
                    ],
                    "common_phrases": [
                        "visit a pottery",
                        "local pottery"
                    ],
                    "target_lang_definitions": {
                        "ru": "Завод или мастерская, где изготавливаются глиняные изделия",
                        "tr": "Kil eşyaların üretildiği fabrika veya atölye."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гонча́рная мастерска́я",
                                "target_lang_sense_clarification": "место производства"
                            },
                            {
                                "target_lang_word": "гонча́рня",
                                "target_lang_sense_clarification": "традиционная мастерская"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "çömlekçi atölyesi",
                                "target_lang_sense_clarification": "çömlek üretilen imalathane"
                            },
                            {
                                "target_lang_word": "çömlekathane",
                                "target_lang_sense_clarification": "çömlek üretim yeri"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}