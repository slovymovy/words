                ],
                "translations": [
                    {
                        "translation_id": "f9b8af40-d016-47ae-9a73-0dea81253629",
                        "source_entry_id": "3eac4594-0f76-33d0-b223-47ad18cea4d0",
                        "source_sense_id": "225b2a4d-716d-36cf-92be-65699fa281cd",
                        "target_lang_word": "Taliban",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Taliban",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "30d4b871-2ccb-33e7-a7da-62a2462f3d8a",
                                        "entry_id": "773b8a4d-4ae2-3a03-97ca-21049cae02bd",
                                        "glosses": [
                                            "A Deobandi Islamist and largely Pashtun religious political movement founded in Afghanistan in 1994 by mullah Mohammad Omar, which has governed the country from 1996 to 2001 and since 2021."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Taliban",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "83c9f9d3-05e9-3392-9ddf-47e18fe3a296",
                                        "entry_id": "f1b4ecbf-d538-3224-93c8-1c801b1f3a3b",
                                        "glosses": [
                                            "A Taliban militia."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7e5831b-6df0-4868-ac74-c049ff59d7dc",
                                                "sense_id": "83c9f9d3-05e9-3392-9ddf-47e18fe3a296",
                                                "text": "We will deal with the Afghan Taliban through dialogue. And we will handle the Pakistani Taliban with bullets."
                                            },
                                            {
                                                "example_id": "32ebcebe-7f2e-4e46-8062-437dc41ef977",
                                                "sense_id": "83c9f9d3-05e9-3392-9ddf-47e18fe3a296",
                                                "text": "Not everyone accepts the premise of a complete rupture between the two Talibans."
                                            },
                                            {
                                                "example_id": "cac352cf-2d6f-4b90-afd1-d5e33d336c9f",
                                                "sense_id": "83c9f9d3-05e9-3392-9ddf-47e18fe3a296",
                                                "text": "The Pakistani Taliban, an offspring of the Afghan Taliban, are led by veterans of the fighting in Afghanistan who come from the border regions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d2bf9a52-6c75-37f8-9a1c-67097d98da1e",
                                        "entry_id": "f1b4ecbf-d538-3224-93c8-1c801b1f3a3b",
                                        "glosses": [
                                            "A member of the Taliban movement or its militia; a Talib."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "17ec1e91-679c-4faf-b2b4-28bfd23feaea",
                        "source_entry_id": "3eac4594-0f76-33d0-b223-47ad18cea4d0",
                        "source_sense_id": "225b2a4d-716d-36cf-92be-65699fa281cd",
                        "target_lang_word": "talibanský",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "aadc2073-79eb-47a9-891a-16df7a7bbf44",
                        "source_entry_id": "3eac4594-0f76-33d0-b223-47ad18cea4d0",
                        "source_sense_id": "225b2a4d-716d-36cf-92be-65699fa281cd",
                        "target_lang_word": "taliban",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "taliban",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cc971f67-09c5-3ce7-befb-1b6775129f5f",
                                        "entry_id": "4329037d-9aeb-31cd-916d-00f308c5f4ba",
                                        "glosses": [
                                            "En rapport avec les fondamentalistes sunnites."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "677ed122-8570-4dac-9e24-0011836ff66c",
                                                "sense_id": "cc971f67-09c5-3ce7-befb-1b6775129f5f",
                                                "text": "Le mouvement taliban."
                                            },
                                            {
                                                "example_id": "e0e6c0da-885f-456e-a7e3-8912b901601e",
                                                "sense_id": "cc971f67-09c5-3ce7-befb-1b6775129f5f",
                                                "text": "Sous le précédent régime taliban, jeux, musique, photographie et télévision étaient interdits. Les voleurs avaient les mains coupées, les meurtriers étaient exécutés en public et les homosexuels tués."
                                            },
                                            {
                                                "example_id": "04d8d9bf-4e6a-4e82-b41d-b5ccd2785d71",
                                                "sense_id": "cc971f67-09c5-3ce7-befb-1b6775129f5f",
                                                "text": "Les troupes talibanes sont entrées dans Kaboul."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "taliban",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e170a1bf-68af-30f5-85e7-340c68a826e5",
                                        "entry_id": "f908906b-6ad0-37c5-95a8-c6e0fb2f73c4",
                                        "glosses": [
                                            "Militant fondamentaliste sunnite."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "209a7562-ea02-49a3-99aa-4754e9a25454",
                                                "sense_id": "e170a1bf-68af-30f5-85e7-340c68a826e5",
                                                "text": "Aujourd’hui sans travail, elle se demande quel avenir elle va pouvoir offrir à ses deux petites filles face à l’acharnement des talibans. « Elles ne pourront pas aller à l’école après l’âge de 12 ans et je refuse de les marier avant leur majorité. Elles n’ont aucun avenir ici », se désespère-t-elle avant de condamner le silence de la communauté internationale face aux violations des droits humains perpétrées par les talibans."
                                            },
                                            {
                                                "example_id": "fb81bccf-5f2a-4929-9a82-01ea2cffd123",
                                                "sense_id": "e170a1bf-68af-30f5-85e7-340c68a826e5",
                                                "text": "Depuis qu’ils ont repris le pouvoir en août 2021, les talibans ont promulgué une centaine de décrets restreignant les droits des femmes, notamment en interdisant l’enseignement secondaire et supérieur ainsi que l’emploi dans les ONG. L’accès aux espaces publics tels que les parcs, les salles de sport, les salons de beauté et les restaurants leur est également proscrit."
                                            },
                                            {
                                                "example_id": "50709e03-3f5f-4c6e-83f6-451a0c01a75a",
                                                "sense_id": "e170a1bf-68af-30f5-85e7-340c68a826e5",
                                                "text": "Dans les dernières années avant la chute de Kaboul, on entendait certains diplomates affirmer \"on est là pour travailler avec l’Afghanistan, pas avec un régime\" ou encore \"les talibans ont changé\". Je n’ai jamais cru au concept de \"taliban modéré\"."
                                            },
                                            {
                                                "example_id": "83c17c8b-a9fa-4a2c-81fe-8f0efa63af28",
                                                "sense_id": "e170a1bf-68af-30f5-85e7-340c68a826e5",
                                                "text": "— […] Quant au puits, il s’est asséché. (Il baissa la voix.) J’ai réclamé je ne sais combien de fois des fonds aux talibans pour en creuser un nouveau, mais ils se contentent de jouer avec leur chapelet en me soutenant qu’il n’y a pas d’argent. Pas d’argent ! Ils se droguent à l’héroïne et osent prétendre ensuite qu’ils ne peuvent pas nous payer un puits."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "875b1bd9-a8ea-429f-a094-b7f1e1018f17",
                        "source_entry_id": "3eac4594-0f76-33d0-b223-47ad18cea4d0",
                        "source_sense_id": "225b2a4d-716d-36cf-92be-65699fa281cd",
                        "target_lang_word": "talibán",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "talibán",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "7b397a78-e376-3883-8593-eadca13e83f6",
                                        "entry_id": "a21a6bba-14e3-3302-8287-c4653e2f5e89",
                                        "glosses": [
                                            "Propio de, relativo o perteneciente a un grupo armado, fundamentalista religioso y nacionalista afgano, que gobernó Afganistán hacia fines de la década de 1990 y mantiene actividad insurgente en el país desde entonces."
                                        ],
                                        "tags": [
                                            "noun"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ee458c5-6cbc-4123-9037-4e1d7d00316c",
                                                "sense_id": "7b397a78-e376-3883-8593-eadca13e83f6",
                                                "text": "Además de contener la violencia en Karachi, el Gobierno afronta la insurgencia talibana y la tarea de reconstruir las zonas devastadas por las inundaciones de agosto, que causaron daños por 9.700 millones de dólares."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1db9abeb-a897-331a-8157-7403ff46ea12",
                                        "entry_id": "a21a6bba-14e3-3302-8287-c4653e2f5e89",
                                        "glosses": [
                                            "Por analogía con el integrismo de este grupo, de creencias radicales e intransigentes."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "derogatory"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
