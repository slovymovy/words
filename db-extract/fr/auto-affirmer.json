                            {
                                "example_id": "b637e43e-5b1c-4b10-95b2-e4bcad9c6b0b",
                                "sense_id": "9eabd40f-4f50-3977-8943-f68e3b2b72d8",
                                "text": "C'est à lui d'incarner cette peur dont l'Etat sécuritaire a besoin pour s'auto-affirmer."
