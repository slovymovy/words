                        {
                            "trait_type": "colloquial",
                            "comment": "Informal shortening of quadruplet"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Один из четырех детей, родившихся одновременно у одной матери (четверняшка).",
                        "zh": "四胞胎中的一个。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "четверняшка",
                                "target_lang_sense_clarification": "один из четырех близнецов"
