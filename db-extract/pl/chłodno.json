                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "01dcf61c-c82b-3ede-9af9-f2ac3f57a87e",
                        "entry_id": "82aab7aa-c8b1-3359-bf58-d8bcda737792",
                        "glosses": [
                            "w sposób pozbawiony serdeczności"
                        ],
