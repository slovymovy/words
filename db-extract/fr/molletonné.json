                                        "examples": [
                                            {
                                                "example_id": "76e9253e-b3ee-42da-bb99-decfadac3930",
                                                "sense_id": "e2119a4c-7a84-3713-96d3-58f4b9910466",
                                                "text": "The Sun ſhall change, the Moon to change ſhall ceaſe; / The Gaits to clim-----the Sheep to yield the Fleece, / Ere ought by me be either ſaid or done, / Shall do thee Wrang, I ſwear by all aboon."
                                            },
                                            {
                                                "example_id": "bb7b323c-ba99-40f7-8c08-9a855e580afd",
                                                "sense_id": "e2119a4c-7a84-3713-96d3-58f4b9910466",
                                                "text": "Wool became the substitute for money. […] In all the middle periods of British history, the fleece was the expression and the measure of national prosperity or calamity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44e029ba-86b6-34c3-8e49-d0d4cad4ad01",
