            {
                "entry_id": "d39c96f5-2670-3947-a168-588dcd61839f",
                "word": "Sybaritisch",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b6e9c8c5-d40b-315c-a144-83b68546bc6f",
                        "entry_id": "d39c96f5-2670-3947-a168-588dcd61839f",
                        "glosses": [
                            "afkomstig uit of betrekking hebbend op de stad Sybaris, in de oudheid een zeer welvarende Griekse kolonie bij het tegenwoordige Sibari in Italië"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3c7114a-5f94-466d-a672-93aa64d9a2a4",
                                "sense_id": "b6e9c8c5-d40b-315c-a144-83b68546bc6f",
                                "text": "Toen ik had laten rondstrooien, dat ik onder de neus der Krotoniërs een aardig Sybaritisch meisje had weggekaapt, scheelde het weinig, of men had mij gevierd als de grootste held van allemaal, en het kostte mij toen enkel nog een bezoek bij de archont, en bij de oudste priester en priesteres van Zeus en Athene, om voor Orseïs toestemming te verkrijgen in Temesa te blijven wonen, en voor mij om met haar te trouwen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "68c4330c-cc67-44b1-ad34-e585336c2f96",
                        "source_entry_id": "d39c96f5-2670-3947-a168-588dcd61839f",
                        "source_sense_id": "b6e9c8c5-d40b-315c-a144-83b68546bc6f",
                        "source_sense_description": "afkomstig uit of betrekking hebbend op de stad Sybaris",
                        "target_lang_word": "sybaritique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
