                    "frequency": "Middle",
                    "semantic_group_id": "communaute",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je considère mes collègues de longue date comme de véritables <w>frères</w>."
                        },
                        {
                            "text": "Les deux soldats combattaient côte à côte comme des <w>frères</w> d'armes."
