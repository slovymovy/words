                        "glosses": [
                            "Qui peut se dessécher."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17934631-df73-42c5-a351-7a09f9a839eb",
                                "sense_id": "3bdac6af-43f2-3c56-acd7-1533c41eb839",
                                "text": "Quand la surabondance du suc muqueux distend fortement les vaisseaux des arbres (car on ne remarque pas le même phénomène dans les plantes herbacées), alors ces vaisseaux se rompent et le mucilage plus ou moins épais, visqueux, collant, sort en gouttes promptement desséchables à l’air."
                            },
                            {
                                "example_id": "96cf1274-fb33-4e24-b6c6-9af634e5250c",
                                "sense_id": "3bdac6af-43f2-3c56-acd7-1533c41eb839",
                                "text": "Cette succession indique que le sol, relativement profond dans la forêt, forme une couche de plus en plus fine et de plus en plus facilement desséchable à mesure que l’on s’approche d’ici."
                            }
                        ]
                    },
                    {
                        "sense_id": "d8d2e544-fdb3-3f2a-a72d-1a95f98953d2",
                        "entry_id": "ac779ea8-d73f-3fcd-94ac-41f2dde19e0e",
                        "glosses": [
                            "Que l’on peut assécher."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "11a18f72-7886-42f3-ad02-82ad675b4aba",
                                "sense_id": "d8d2e544-fdb3-3f2a-a72d-1a95f98953d2",
                                "text": "Une grande partie de terres basses dans les rivières de Kaw, d’Ouanari et d’Approuague, fut arpentée, nivelée et reconnue desséchable."
                            }
                        ]
                    }
