                                                "example_id": "275b27c1-8f7b-4191-bc01-ef7be1a088e4",
                                                "sense_id": "1a25cbf6-d12a-3a70-a3be-1708ea81e404",
                                                "text": "Eerst deden we de afwas, daarna gingen we televisie kijken."
                                            },
                                            {
                                                "example_id": "66e6f121-0f70-424c-bfa2-8eb4b4e8472a",
                                                "sense_id": "1a25cbf6-d12a-3a70-a3be-1708ea81e404",
                                                "text": "Ook daarna bleef hij tot op hoge leeftijd actief: hij hield lezingen en sprak geregeld op televisie over nog altijd dezelfde thema's: milieuvervuiling, vreemdelingenhaat, hebzucht."
                                            },
                                            {
                                                "example_id": "7cec6307-f473-4484-930d-ac8dce603985",
                                                "sense_id": "1a25cbf6-d12a-3a70-a3be-1708ea81e404",
                                                "text": "De voorbereidingen konden beginnen. Het engste van alleen op pad gaan is de definitieve beslissing om het ook echt te gaan doen. Daarna valt gek genoeg alles best mee."
                                            }
