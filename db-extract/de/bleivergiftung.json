                                                "example_id": "a6d96e15-c2a5-488e-aa2d-7e8cd2a1c948",
                                                "sense_id": "eee0948b-87d8-32f0-ade3-6d1e1494a787",
                                                "text": "UNICEF: 800 miljoen kinderen hebben loodvergiftiging, 60.000 in Nederland."
                                            },
                                            {
                                                "example_id": "35bcef5a-786f-43dc-9e22-51915de01364",
                                                "sense_id": "eee0948b-87d8-32f0-ade3-6d1e1494a787",
                                                "text": "De belangrijkste bron voor lood in het lichaam was tot voor kort het lood dat door de toevoeging van tetra-ethyllood aan benzine als antiklopmiddel in de atmosfeer terechtkwam waarop werd gewezen door de geochemicus Clair Patterson.\nTweede vaak voorkomende reden van loodvergiftiging is het gebruik van lood in waterleidingen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
