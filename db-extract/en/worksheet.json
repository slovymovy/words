                "senses": [
                    {
                        "sense_id": "ab8ad8c4-9201-345b-8590-a85d561eec8d",
                        "entry_id": "3e9c2deb-eb72-3e3b-af2d-73f6f3898f8d",
                        "glosses": [
                            "Formulaire d’exercices, par exemple de calcul."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db50f7d0-44d9-4ae9-a602-b844d1a46b1e",
                                "sense_id": "ab8ad8c4-9201-345b-8590-a85d561eec8d",
                                "text": "The school received complaints from parents who found the pupils' homework worksheet too hard.",
                                "translation": "L’école a reçu des plaintes de parents qui ont trouvé trop difficile la feuille d’exercices des élèves pour leur devoirs."
                            }
                        ]
                    },
                    {
                        "sense_id": "7e7dc606-1401-356a-ae85-9f4965b63228",
                        "entry_id": "3e9c2deb-eb72-3e3b-af2d-73f6f3898f8d",
                        "glosses": [
                            "Tableau de calcul en comptabilité, ou feuille de calcul d’un logiciel de type tableur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4a69811-ba03-44d6-a9a3-9d5e95dd277e",
                                "sense_id": "7e7dc606-1401-356a-ae85-9f4965b63228",
                                "text": "Workbooks created by modern spreadsheet application may consist of several worksheets, and also include macros.",
                                "translation": "Les classeurs crées par les tableurs modernes peuvent comprendre plusieurs feuilles de calcul et inclure des macros."
                            }
                        ]
                    }
                ],
