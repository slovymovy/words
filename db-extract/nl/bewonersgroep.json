                        "examples": [
                            {
                                "example_id": "edaaa610-31b0-4e0e-8dfd-c49ecff96304",
                                "sense_id": "27e672fc-3005-3f3f-980a-141ba26845b1",
                                "text": "De bezwaarmakers vonden sloop van het huidige gebouw niet nodig. Ze vinden ook dat de beoogde nieuwe locatie, dicht bij de snelweg A1, geen geschikte omgeving is voor de bijzondere bewonersgroep."
                            },
                            {
                                "example_id": "039504e9-fa6d-4734-a86b-52c101987bb2",
                                "sense_id": "27e672fc-3005-3f3f-980a-141ba26845b1",
                                "text": "Asielzoekers uit Syrië, Afghanistan, maar ook uit Sudan, Somalië en Nigeria hebben er onderdak gevonden. Een lokale bewonersgroep van het eiland heeft de gemeente ervan overtuigd dat een opvangcentrum nodig was, en beheert het nu onofficieel."
                            },
                            {
                                "example_id": "79da82f0-81d0-41f9-8aa9-aee303d6830f",
                                "sense_id": "27e672fc-3005-3f3f-980a-141ba26845b1",
                                "text": "\"De straat heeft van oudsher een actieve bewonersgroep\", zegt Goncalves. Ook hij is verbijsterd."
                            }
                        ]
                    }
