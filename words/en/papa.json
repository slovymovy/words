{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ae2eeb29-11ad-3719-8dce-3fa3e5a4f85c",
                    "sense_definition": "A familiar or old-fashioned term of address for one's father.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "family_member",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My <w>papa</w> taught me how to ride a bicycle in the park.",
                            "target_lang_translations": {
                                "ru": "Мой <w>папа</w> научил меня кататься на велосипеде в парке.",
                                "zh": "我<w>爸爸</w>在公园里教我骑自行车。"
                            }
                        },
                        {
                            "text": "The little girl ran to her <w>papa</w> when she felt scared.",
                            "target_lang_translations": {
                                "ru": "Маленькая девочка побежала к своему <w>папе</w>, когда испугалась.",
                                "zh": "小女孩感到害怕时跑向了她的<w>爸爸</w>。"
                            }
                        },
                        {
                            "text": "Everyone in the family knows that <w>papa</w> bear is protective of his cubs.",
                            "target_lang_translations": {
                                "ru": "Все в семье знают, что <w>папа</w>-медведь защищает своих медвежат.",
                                "zh": "家里人都知道<w>爸爸</w>熊会保护他的幼崽。"
                            }
                        }
                    ],
                    "synonyms": [
                        "dad",
                        "daddy",
                        "father",
                        "pa",
                        "pop"
                    ],
                    "antonyms": [
                        "mama",
                        "mom",
                        "mommy",
                        "mother"
                    ],
                    "common_phrases": [
                        "papa bear"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "familiar term"
                        },
                        {
                            "trait_type": "dated",
                            "comment": "in some regions"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Знакомое или старомодное обращение к отцу",
                        "zh": "对父亲的一种亲昵或老式的称呼。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "папа",
                                "target_lang_sense_clarification": "основное значение"
                            },
                            {
                                "target_lang_word": "папочка",
                                "target_lang_sense_clarification": "ласковое обращение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "爸爸",
                                "target_lang_sense_clarification": "对父亲的常用称呼"
                            },
                            {
                                "target_lang_word": "爹地",
                                "target_lang_sense_clarification": "较亲昵的称呼"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a5e68ad7-c839-3a4d-b757-8d89936db62c",
                    "sense_definition": "A pet name or affectionate nickname for one's grandfather.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "family_member",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We visit <w>Papa</w> Joe every Sunday for lunch.",
                            "target_lang_translations": {
                                "ru": "Мы навещаем <w>дедушку</w> Джо каждое воскресенье на обед.",
                                "zh": "我们每周日都去和<w>爷爷</w>乔一起吃午饭。"
                            }
                        },
                        {
                            "text": "Her <w>papa</w> tells the most interesting stories about the old days.",
                            "target_lang_translations": {
                                "ru": "Её <w>дедушка</w> рассказывает самые интересные истории о былых временах.",
                                "zh": "她<w>爷爷</w>讲起过去的事情总是特别有趣。"
                            }
                        }
                    ],
                    "synonyms": [
                        "grandpa",
                        "granddad",
                        "gramps"
                    ],
                    "antonyms": [
                        "grandma",
                        "nana"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "pet name"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ласковое прозвище для дедушки",
                        "zh": "对祖父的爱称或昵称。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дедушка",
                                "target_lang_sense_clarification": "общее значение"
                            },
                            {
                                "target_lang_word": "деда",
                                "target_lang_sense_clarification": "разговорное, детское"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "爷爷",
                                "target_lang_sense_clarification": "对祖父的常用称呼"
                            },
                            {
                                "target_lang_word": "爷爷",
                                "target_lang_sense_clarification": "口语爱称"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ac75e97e-0323-3993-b0ef-27870e42fcaf",
                    "sense_definition": "The word assigned to the letter P in the NATO phonetic alphabet.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please spell your code clearly, using <w>Papa</w> for the letter P.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, произнесите ваш код четко, используя <w>Папа</w> для буквы P.",
                                "zh": "请清楚地拼读你的代码，用<w>Papa</w>来代表字母P。"
                            }
                        },
                        {
                            "text": "The pilot confirmed his location using the call sign Oscar <w>Papa</w>.",
                            "target_lang_translations": {
                                "ru": "Пилот подтвердил свое местоположение, используя позывной Оскар <w>Папа</w>.",
                                "zh": "飞行员使用呼号“奥斯卡 <w>Papa</w>”确认了他的位置。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Слово, обозначающее букву P в фонетическом алфавите НАТО",
                        "zh": "北约音标字母中代表字母P的单词。"
                    },
                    "translations": {
