                ],
                "senses": [
                    {
                        "sense_id": "a5342fac-8f08-32dc-ae01-ff021068a534",
                        "entry_id": "1c6ec1dc-1414-398d-bfa3-f02d5361fe5c",
                        "glosses": [
                            "Variante de réexposer."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "9279b6ba-5b0b-4b0e-a551-a0efd1b7e97e",
                                "sense_id": "a5342fac-8f08-32dc-ae01-ff021068a534",
                                "text": "Finalement, il suffit pour le cinéaste de savoir ré-exposer le matériau initial, de lui apporter les modifications nécessaires à la lumière subjective de sa personnalité et du temps."
                            },
                            {
                                "example_id": "eb9f3956-39f6-4282-b5a2-aab3920aa1a7",
                                "sense_id": "a5342fac-8f08-32dc-ae01-ff021068a534",
                                "text": "C’est pourquoi son écriture procède de la répétition, du re-dire, qui n’est qu’un infime déplacement par rapport au déjà dit, mais qui est avant tout le mouvement même de reprendre ce qui est à dire, de le ré-exposer."
                            },
                            {
                                "example_id": "20af357f-1062-4775-9700-84aac199be07",
                                "sense_id": "a5342fac-8f08-32dc-ae01-ff021068a534",
                                "text": "En travaillant en groupe, un individu est souvent « ré-exposé à des choses qu’il a pu oublier, ce qui stimule ensuite sa mémoire »."
                            }
                        ]
                    }
                ],
