                    {
                        "translation_id": "54e06c2f-e9d2-46f8-add6-5d6be0f98992",
                        "source_entry_id": "faa9d47a-827b-38b6-bde7-098bbaaec947",
                        "source_sense_description": "распыление жидкости или порошкообразной массы",
                        "target_lang_word": "pulvérisation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pulvérisation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1d014a91-e07f-30df-a825-b3d615f39d29",
                                        "entry_id": "c7200832-e459-3c15-bdcb-4e96b58c46d3",
                                        "glosses": [
                                            "Action de pulvériser ou résultat de cette action."
                                        ],
                                        "tags": [
                                            "Didactique"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "54454057-f591-3ba5-954f-4eba10a9ed2f",
                                        "entry_id": "c7200832-e459-3c15-bdcb-4e96b58c46d3",
                                        "glosses": [
                                            "Action de réduire en miettes ou en poudre."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a57aa42-e41b-43fc-bdb0-f03d23f46327",
                                                "sense_id": "54454057-f591-3ba5-954f-4eba10a9ed2f",
                                                "text": "Si une partie de la propriété édulcorante du sucre lui est enlevée pendant la pulvérisation, elle lui est rendue pendant sa transformation en sirop"
                                            },
                                            {
                                                "example_id": "cb81063f-061c-4bf0-a884-254c91c22ba4",
                                                "sense_id": "54454057-f591-3ba5-954f-4eba10a9ed2f",
                                                "text": "Dans les jardins, le rôle de la herse appartient au râteau, et son importance y est d'autant plus grande qu'il s’agit d'obtenir une pulvérisation et une régularisation plus parfaite du sol."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9712af4b-384e-336f-b75e-7710fab68ff8",
                                        "entry_id": "c7200832-e459-3c15-bdcb-4e96b58c46d3",
                                        "glosses": [
                                            "Érosion par bombardement ionique ou atomique et éjection résultante d’atomes, phénomène aussi appliqué industriellement à la déposition de couches minces."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "note": "Souvent, il s’agit de pulvérisation cathodique",
                                        "examples": [
                                            {
                                                "example_id": "11aab972-7b7f-42b6-b513-d715b9c17bab",
                                                "sense_id": "9712af4b-384e-336f-b75e-7710fab68ff8",
                                                "text": "La durée de vie des tubes fluorescents («néons») est limitée par la pulvérisation de leurs deux filaments."
                                            },
                                            {
                                                "example_id": "01af0593-7b23-45d6-8d32-9f4215a6270f",
                                                "sense_id": "9712af4b-384e-336f-b75e-7710fab68ff8",
                                                "text": "La pulvérisation de couches minces est largement utilisée dans l’industrie des semiconducteurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "996f53c9-5a99-3e19-8ba5-c118628d4e4a",
                                        "entry_id": "c7200832-e459-3c15-bdcb-4e96b58c46d3",
                                        "glosses": [
                                            "Action de couvrir une plante ou son feuillage d'une bouillie phytosanitaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b31a1642-fdd4-446d-9fc4-447d596e74c2",
                                                "sense_id": "996f53c9-5a99-3e19-8ba5-c118628d4e4a",
                                                "text": "En vue de la destruction des larves néonates avant leur pénétration dans le fruit, Bohm avec le zeidane ⁽²⁾ et Fisher au moyen du parathion ⁽¹⁰⁾ conseillaient deux pulvérisations espacées de 15 jours environ."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
