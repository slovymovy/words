{
    "word_family": [
        "toddler"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8296230e-23ae-3e44-8111-f27befa9dfc4",
                    "sense_definition": "To walk unsteadily with short, uncertain steps, like a small child learning to walk.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young child began to <w>toddle</w> across the living room towards her mother.",
                            "target_lang_translations": {
                                "tr": "Küçük çocuk oturma odasında annesine doğru <w>paytak paytak yürümeye</w> başladı."
                            }
                        },
                        {
                            "text": "Look at how fast she can <w>toddle</w> around the garden now!",
                            "target_lang_translations": {
                                "tr": "Şimdi bahçede ne kadar hızlı <w>taytay yürüyebildiğine</w> bak!"
                            }
                        }
                    ],
                    "synonyms": [
                        "totter"
                    ],
                    "target_lang_definitions": {
                        "tr": "Küçük bir çocuğun yürümeyi öğrenirken yaptığı gibi, kısa ve kararsız adımlarla dengesizce yürümek."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "paytak paytak yürümek",
                                "target_lang_sense_clarification": "çocuklar veya ördekler gibi sarsılarak yürümek"
                            },
                            {
                                "target_lang_word": "taytay yürümek",
                                "target_lang_sense_clarification": "yeni yürümeye başlayan çocukların yürümesi"
                            },
                            {
                                "target_lang_word": "sendeleyerek yürümek",
                                "target_lang_sense_clarification": "dengesiz adımlar atmak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "afc2f219-ba0a-3cb1-80fb-0b901c92e368",
                    "sense_definition": "To walk or travel in a casual, relaxed, or carefree manner.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There he was, just <w>toddling</w> along the quiet country lane.",
                            "target_lang_translations": {
                                "tr": "İşte oradaydı, sessiz köy yolunda öylece <w>gezinip duruyordu</w>."
                            }
                        },
                        {
                            "text": "After lunch, we decided to <w>toddle</w> off to the local museum.",
                            "target_lang_translations": {
                                "tr": "Öğle yemeğinden sonra yerel müzeye doğru <w>yollanmaya</w> karar verdik."
                            }
                        }
                    ],
                    "common_phrases": [
                        "toddle off",
                        "toddle along"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used informally to describe walking casually or leaving"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Rahat, gamsız veya ağırdan alan bir şekilde yürümek veya seyahat etmek."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "ağırdan alarak yürümek",
                                "target_lang_sense_clarification": "rahat ve acelesiz yürümek"
                            },
                            {
                                "target_lang_word": "gezinmek",
                                "target_lang_sense_clarification": "keyfi olarak dolaşmak"
                            },
                            {
                                "target_lang_word": "yavaşça gitmek",
                                "target_lang_sense_clarification": "gayriresmi olarak bir yere doğru yollanmak"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2d724075-8ab7-3f09-a971-1ef97abc4d1f",
                    "sense_definition": "A leisurely, carefree walk or short stroll.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am going to take a quick <w>toddle</w> down to the shop for milk.",
                            "target_lang_translations": {
                                "tr": "Süt almak için dükkana doğru hızlıca bir <w>tur atacağım</w>."
                            }
                        },
                        {
                            "text": "They went for a pleasant <w>toddle</w> along the beach after dinner.",
                            "target_lang_translations": {
                                "tr": "Akşam yemeğinden sonra sahilde hoş bir <w>yürüyüşe</w> çıktılar."
                            }
                        }
                    ],
                    "common_phrases": [
                        "take a toddle"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal noun usage for a casual walk"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Aheste, rahat bir yürüyüş veya kısa bir gezinti."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "kısa yürüyüş",
                                "target_lang_sense_clarification": "rahat ve kısa gezinti"
                            },
                            {
                                "target_lang_word": "tur",
                                "target_lang_sense_clarification": "kısa mesafe gezinme"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}