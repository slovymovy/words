                "senses": [
                    {
                        "sense_id": "fdef5289-a2e9-3331-b9eb-9786deeb08b8",
                        "entry_id": "de6c6f67-1c57-3282-9380-6f76b1379703",
                        "glosses": [
                            "von 1950 bis 1953 dauernder bewaffneter Konflikt zwischen dem kommunistischen Nordkorea und dem von UN-Truppen und den USA unterstützten Südkorea"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "14bfac29-168d-4eb5-9e4c-244633f26e52",
                                "sense_id": "fdef5289-a2e9-3331-b9eb-9786deeb08b8",
                                "text": "„60 Jahre nach dem Ende der Kampfhandlungen im Koreakrieg herrscht immer noch Kriegszustand.“"
                            },
                            {
                                "example_id": "cf5af0e3-f765-464f-9b9a-df298f58affd",
                                "sense_id": "fdef5289-a2e9-3331-b9eb-9786deeb08b8",
                                "text": "„Dieser war im Koreakrieg nach den Bombardements als vermisst gemeldet worden, in Wirklichkeit aber nach Südkorea geflohen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
