                "senses": [
                    {
                        "sense_id": "52e9b79a-e44b-3dc9-ba1c-a80d38a275ad",
                        "entry_id": "b459db45-2a34-36f1-9aba-20b91dbc7fea",
                        "glosses": [
                            "Mettre en lumière une partie d’un texte à l’aide de caractères gras."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "22b2b87e-3934-4b8e-bf90-bcc3d22de44d",
                                "sense_id": "52e9b79a-e44b-3dc9-ba1c-a80d38a275ad",
                                "text": "Votre réponse est dans les mots que j’ai grassé dans votre message : méconnaissance du handicap dans sa généralité et des personnes dans leurs spécificités…"
                            },
                            {
                                "example_id": "3a0935e9-b610-484a-9999-040bbe0d615a",
                                "sense_id": "52e9b79a-e44b-3dc9-ba1c-a80d38a275ad",
                                "text": "On souhaite disposer d’une liste de liens. Lors d’un clic sur un lien de cette liste, l’encart correspondant doit s’afficher pour illustrer davantage son sens. Eventuellement, lorsque l’on reclique sur ce même lien, le visiteur est transporté sur la page en question.\nJ’ai grassé les mots importants de ce besoin. Vous le verrez par la suite, ils vont régir le comportement du script."
                            }
                        ]
                    }
