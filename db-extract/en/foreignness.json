                        "target_lang_word": "extranéité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "extranéité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f9a48423-0100-3da7-8f09-52c789f42e43",
                                        "entry_id": "e0c577f0-ba03-37dd-a628-8d0e56568bd1",
                                        "glosses": [
                                            "Qualité d’étranger."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0fc3b9ed-f7c1-40fe-a544-51abe6c0ec53",
                                                "sense_id": "f9a48423-0100-3da7-8f09-52c789f42e43",
                                                "text": "Les forces surnaturelles, magiques, se révèlent être des forces étonnamment moïques. Les forces du colon sont infiniment rapetissées, frappées d’extranéité. On n’a plus vraiment à lutter contre elles puisque aussi bien ce qui compte c’est l’effrayante adversité des structures mythiques. Tout se résout, on le voit, en affrontement permanent sur le plan phantasmatique."
                                            },
                                            {
                                                "example_id": "6e963169-1f51-4e0a-bd17-a989d1492ab8",
                                                "sense_id": "f9a48423-0100-3da7-8f09-52c789f42e43",
                                                "text": "Vu du côté des colonisés, l’extranéité de l’État se traduisait par une gouvernance arbitraire et aliénante."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "936bd4da-1649-434d-a071-9243dfc76e6d",
                        "source_entry_id": "9fff3832-850b-3eb0-84bc-df938746a200",
                        "source_sense_description": "quality of being, appearing, or being perceived as foreign",
                        "target_lang_word": "Fremdheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fremdheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8a467e28-d7cd-3f3d-9161-f4a8affe5b97",
                                        "entry_id": "b47f407a-c1fc-3295-b0fc-fc4f6e7b4c0e",
                                        "glosses": [
                                            "Zustand mangelnder Vertrautheit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f5ba132-5b29-4d64-9f61-15d4515bbe15",
                                                "sense_id": "8a467e28-d7cd-3f3d-9161-f4a8affe5b97",
                                                "text": "„Am nächsten Tag schlenderten wir nach allen Richtungen durch die breiten, geraden, ebenen Straßen und genossen den Reiz der Fremdheit einer Stadt von fünfzehntausend Einwohnern, in der keine Herumlungerer zu sehen waren und in der es weder Trunkenbolde oder Rabauken gab.“"
                                            },
                                            {
                                                "example_id": "76eec6bd-fa62-4471-aa3e-2c7763405872",
                                                "sense_id": "8a467e28-d7cd-3f3d-9161-f4a8affe5b97",
                                                "text": "„Andererseits bewahren etwa Angloromanismen ihre Fremdheit in erster Linie deshalb, weil sie fremden Wortbildungsmustern folgen (…).“"
                                            },
                                            {
                                                "example_id": "135298c0-853e-40b8-aefc-d4101e60d337",
                                                "sense_id": "8a467e28-d7cd-3f3d-9161-f4a8affe5b97",
                                                "text": "„Die Fremdheit von Prinz Dido wird hier so inszeniert, wie das Publikum sie gerne hätte.“"
                                            },
                                            {
                                                "example_id": "4050ffe0-ef5b-4cb9-b2d8-e23fd49d326f",
                                                "sense_id": "8a467e28-d7cd-3f3d-9161-f4a8affe5b97",
                                                "text": "„Die anfängliche Fremdheit war schnell verflogen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
