                                "target_lang_sense_clarification": "not ruined, especially of nature or landscapes"
                            },
                            {
                                "target_lang_word": "virgin",
                                "target_lang_sense_clarification": "as of forests or land, untouched by human activity"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8671c2f6-4670-37ff-b415-975fdf8fb4e8",
                    "sense_definition": "Nog niet seksueel ervaren; maagdelijk.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "staat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In oude verhalen werd de draak vaak getemd door een <w>ongerepte</w> maagd.",
                            "target_lang_translations": {
                                "en": "In old stories, the dragon was often tamed by a <w>virginal</w> maiden."
