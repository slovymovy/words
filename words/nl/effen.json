                    "sense_id": "da7280f1-168e-386f-b17e-54f56f10024c",
                    "sense_definition": "met slechts één kleur, zonder patroon of versiering",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "uiterlijk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik draag vandaag een <w>effen</w> blauw overhemd naar mijn werk.",
