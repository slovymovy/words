                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "65d0d37d-4fad-4c07-bd6d-c892eb02a716",
                        "entry_id": "0c0cb13e-9673-31b8-a963-54d342f82705",
                        "tags": [
                            "singular",
