            "senses": [
                {
                    "sense_id": "cdd56f9c-b6d9-359b-9500-8e1f4d8bbe4c",
                    "sense_definition": "Dormir d'un sommeil léger ou incomplet ; être à demi endormi.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "sommeil",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le grand-père <w>sommeillait</w> tranquillement dans son fauteuil après le déjeuner."
                        },
                        {
                            "text": "Pendant le long voyage, il préférait <w>sommeiller</w> plutôt que de dormir profondément."
                        }
                    ],
                    "synonyms": [
                        "somnoler"
                    ],
                    "common_phrases": [
                        "sommeiller d'un œil"
                    ]
                },
                {
                    "sense_id": "db1ee9f5-6dc7-33de-91f1-e80af4911af7",
                    "sense_definition": "Être temporairement inactif, latent ou en repos, en parlant d'une chose ou d'une faculté.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "inactivite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Un véritable esprit créatif <w>sommeille</w> en chacun de ces jeunes élèves."
                        },
                        {
                            "text": "Pendant tout l'hiver, la nature <w>sommeille</w> paisiblement sous la neige."
                        }
                    ],
                    "common_phrases": [
                        "qui sommeille en"
                    ]
                },
                {
                    "sense_id": "a6aa2b9c-84ee-3831-b51a-59ba00e85117",
                    "sense_definition": "Dormir, reposer dans le calme et l'immobilité.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sommeil",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Au milieu de la nuit, le village entier <w>sommeille</w> dans un grand silence."
                        },
                        {
                            "text": "Elle aimait lire tard le soir, à l'heure où tout <w>sommeille</w> déjà."
                        }
                    ],
                    "common_phrases": [
                        "quand tout sommeille"
                    ]
                }
            ]
        }
