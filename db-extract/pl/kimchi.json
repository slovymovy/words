                                                "sense_id": "e7b65cc0-6f70-3fe9-ae31-79680e2b13cb",
                                                "text": "„Im Sommer fand man überall Schalen von Wassermelonen, verfaulten Salat oder Kimchi, die Gestank verbreiteten und ein Heer von Fliegen anzogen.“"
                                            },
                                            {
                                                "example_id": "5f109a1b-030a-4520-8867-eeb24e4419f1",
                                                "sense_id": "e7b65cc0-6f70-3fe9-ae31-79680e2b13cb",
                                                "text": "„In der letzten Oktoberwoche hob er mit einer Spitzhacke die Löcher für die Tonkrüge mit Kimchi aus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
