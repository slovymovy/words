                "senses": [
                    {
                        "sense_id": "ab7b2622-de38-3f7e-9844-0f3a28191221",
                        "entry_id": "d030c9d7-53a4-302a-bce7-488d5cda7f16",
                        "glosses": [
                            "wat men als zijn aandeel [4] geeft tot een gemeenschappelijk doel"
                        ],
                        "tags": [
                            "maatschappij"
                        ],
                        "examples": [
                            {
                                "example_id": "f4d0011e-2ce3-483c-a037-7a4cfb537d89",
                                "sense_id": "ab7b2622-de38-3f7e-9844-0f3a28191221",
                                "text": "Zijn bijdrage aan de les is zeer beperkt, want meestal komt hij te laat en zit hij daarna te spelen met zijn telefoon."
                            },
                            {
                                "example_id": "3247554c-eca0-479b-bf76-d7260358b395",
                                "sense_id": "ab7b2622-de38-3f7e-9844-0f3a28191221",
                                "text": "Een schone lucht levert een aanzienlijke bijdrage aan de volksgezondheid."
                            },
                            {
                                "example_id": "79bbc23b-5b51-42cf-9ec5-8bfa3874e22a",
                                "sense_id": "ab7b2622-de38-3f7e-9844-0f3a28191221",
                                "text": "Wiggers krijgt de koninklijke onderscheiding voor \"zijn inzet voor het innovatieve en inclusieve karakter van de dansproducties, zijn bijdrage aan het voor een breed publiek toegankelijk maken van moderne dans en het betrekken van de regio bij het dansgezelschap\", aldus een verklaring van het Koninklijk Huis."
                            },
                            {
                                "example_id": "bf829b0e-104c-45f7-b842-c205fabc1a83",
                                "sense_id": "ab7b2622-de38-3f7e-9844-0f3a28191221",
                                "text": "Het was een bescheiden bijdrage aan de strijd tegen de Verenigde Staten maar het was beter dan helemaal niets doen."
                            }
                        ]
                    },
                    {
                        "sense_id": "f651815a-4846-3986-a996-bb5a0c65b41e",
                        "entry_id": "d030c9d7-53a4-302a-bce7-488d5cda7f16",
