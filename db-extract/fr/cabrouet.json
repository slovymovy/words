                            {
                                "example_id": "1f43fa2c-33a2-4408-812b-d39ce18e9f1c",
                                "sense_id": "815ec90a-4668-3422-84e2-f79cb1b5b85f",
                                "text": "Pour répondre à un désir de l’Office français du travail, j’ai étudié, avec la collaboration de M. Mestre, Inspecteur du travail, la fatigue résultant du transport de fardeaux avec le cabrouet ou diable."
                            },
                            {
                                "example_id": "c514942f-45d6-4640-bf74-c1b14ab649d2",
                                "sense_id": "815ec90a-4668-3422-84e2-f79cb1b5b85f",
                                "text": "On dit encore qu’ils causent tellement vite, que tu peux ouvrir tout large le pavillon de ton oreille, tu ne comprends rien à rien, à croire qu’ils auraient monté chaque parole sur les quatre roues d’un cabrouet à toute course."
                            },
                            {
                                "example_id": "15a53849-e81d-4043-be5e-79d754e8bf7b",
                                "sense_id": "815ec90a-4668-3422-84e2-f79cb1b5b85f",
                                "text": "Réquisitionnons un cabrouet ! dit l’agent voyer."
                            }
                        ]
                    },
