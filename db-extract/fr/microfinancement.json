                    {
                        "sense_id": "6c4e6811-20e2-3327-8cd5-e5fd6b5face4",
                        "entry_id": "0071b94b-730c-3256-9c2f-7887c262a3ad",
                        "glosses": [
                            "Financement à petite échelle, à ceux qui sont exclus du système financier classique ou formel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae87d125-a0ad-4679-8102-f752a68b5f1d",
                                "sense_id": "6c4e6811-20e2-3327-8cd5-e5fd6b5face4",
                                "text": "[La Banque européenne pour la reconstruction et le développement] est maintenant un acteur incontournable dans des domaines aussi variés que la conception de projets, le prêt et le microfinancement, l’investissement en capital et les efforts en vue de coordonner et de réunir des fonds internationaux pour des programmes de développement à long terme."
                            },
                            {
                                "example_id": "d77b6c8d-cfc8-42df-9100-b41ee8028f90",
                                "sense_id": "6c4e6811-20e2-3327-8cd5-e5fd6b5face4",
                                "text": "Cibler les femmes améliore la contribution du microfinancement à la création d’emplois et à la réduction de la pauvreté pour diverses raisons."
                            },
                            {
                                "example_id": "f6e962e5-16db-4a8d-8d80-ccc1a26ba604",
                                "sense_id": "6c4e6811-20e2-3327-8cd5-e5fd6b5face4",
                                "text": "Le microfinancement de Muhammad Yunus [économiste bangladais, Nobel de la paix 2006 pour avoir créé la première institution de microcrédit, la Grameen Bank] a aidé, mais sans cliniques, sans routes et avec une malaria galopante, le microfinancement est insuffisant."
                            }
                        ]
                    }
