                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cce2de7e-314a-4f02-9ec9-ca8109ec263e",
                                "sense_id": "4389e81c-1db6-3c4d-af53-068870dd34c4",
                                "text": "L’enrayement de la pandémie de la grippe aviaire."
                            },
                            {
                                "example_id": "8ffaa07a-6428-40df-8eea-8d55045b9e53",
                                "sense_id": "4389e81c-1db6-3c4d-af53-068870dd34c4",
                                "text": "Les groupements disparaissent le plus souvent par suite d’un processus d’enrayement qui succède au processus d’excitation dans le système nerveux des membres du groupe."
                            }
                        ]
                    },
                    {
                        "sense_id": "96553b9c-d82c-34b8-97da-323410198517",
                        "entry_id": "aec5908c-17dc-3971-a816-90a95fe98d49",
                        "glosses": [
                            "Grippage, arrêt dû à un mauvais fonctionnement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7fc8e932-c5ae-4c3c-89cd-9a9c7721be9b",
                                "sense_id": "96553b9c-d82c-34b8-97da-323410198517",
                                "text": "Le fusil-mitrailleur Cauchat n'était pas très facile à armer et était victime d'un enrayement fréquent."
                            }
                        ]
