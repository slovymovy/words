                        "source_entry_id": "14e9e6cf-2fb9-33b8-8732-6612e1bd13b5",
                        "source_sense_id": "fe2dab96-24eb-3d97-b6da-d5e760e84077",
                        "target_lang_word": "fioriture",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fioriture",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b314d871-8119-323a-a007-7343bdf7e523",
                                        "entry_id": "15348b3e-9a8d-3b4f-a9c7-87bd10339d4a",
                                        "glosses": [
                                            "Trait composé de gammes diatoniques ou chromatiques, trait en tierces ascendantes ou descendantes, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "350e2b73-2c09-46a8-ab7e-16bd0d15679f",
                                                "sense_id": "b314d871-8119-323a-a007-7343bdf7e523",
                                                "text": "Sa voix avait gagné en force et en étendue, et les fioritures infinies du chant italien brodaient de leurs gazouillements d'oiseau les phrases sévères d'un récitatif pompeux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6dd4eab9-bf18-36f6-808d-e3d0e40d62ad",
                                        "entry_id": "15348b3e-9a8d-3b4f-a9c7-87bd10339d4a",
                                        "glosses": [
                                            "Surabondance d’ornements dans le style et d’un excès d’inutile virtuosité."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "60fd340b-e35d-4b81-ae6d-821bad52ab54",
                                                "sense_id": "6dd4eab9-bf18-36f6-808d-e3d0e40d62ad",
                                                "text": "Il adore le paradoxe, il touche au sérieux, au burlesque, et je ne saurais vous dire avec quel art, quel tact, quel goût infini il parcourût avec cette femme dont il ne savait ps le nom, toutes les gammes vulgaires et toutes les fioritures élégantes de la conversation de chaque jour."
                                            },
                                            {
                                                "example_id": "0e309053-6707-41dd-931b-e2e70c46c55d",
                                                "sense_id": "6dd4eab9-bf18-36f6-808d-e3d0e40d62ad",
                                                "text": "Les demeures des paysans frappaient les regards : de belles izbas en bois, sans ornement ajourés et autres fioritures, mais admirablement charpentées."
                                            },
                                            {
                                                "example_id": "fd807ae1-f6b5-45a3-a302-8d6cdd6cf22d",
                                                "sense_id": "6dd4eab9-bf18-36f6-808d-e3d0e40d62ad",
                                                "text": "Tous les matins, le planton de classe inscrivait dans un angle du tableau noir le nombre de jours qui séparaient encore les élèves du départ en permission, et Pouliquen eut l’honneur de dessiner l’énorme zéro garni de fioritures que tous guettaient avec impatience."
                                            },
                                            {
                                                "example_id": "f974f557-f49d-4e56-b53b-e0a9c2e75866",
                                                "sense_id": "6dd4eab9-bf18-36f6-808d-e3d0e40d62ad",
                                                "text": "Plutôt que d'avoir des obsèques manquant de fioritures\nJ'aimerais mieux, tout compte fait, me passer de sépulture."
                                            }
                                        ]
                                    }
                                ]
                            },
