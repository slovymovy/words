                        "entry_id": "aaec89f8-b115-3d09-9f09-13a073390b8d",
                        "glosses": [
                            "The quality of being interchangeable."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "526262ff-5400-4f0f-ad07-ae6c292b0421",
                                "sense_id": "d1baacbc-2ce7-3b8f-b965-fc93ddc5c6ec",
                                "text": "We were similar in many ways, Daniel and I. Almost interchangeable, I’d go so far as to say, and in a way the game seemed to depend on that interchangeability, on the possibility of proximity of experience."
                            }
                        ]
                    }
                ],
