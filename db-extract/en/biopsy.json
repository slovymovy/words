                    {
                        "translation_id": "4e4225b3-e63e-49c2-bd61-55a74fae853a",
                        "source_entry_id": "a5383ec7-39a4-30c8-9713-c33df9eed10b",
                        "source_sense_id": "f3a79e9f-d3f9-3b4a-aca9-4ca16eaea203",
