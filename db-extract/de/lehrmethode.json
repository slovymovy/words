                "senses": [
                    {
                        "sense_id": "42d74594-9e49-36e5-8d09-8b032a337e26",
                        "entry_id": "6778f1f9-3912-396b-81e5-aecc2361f747",
                        "glosses": [
                            "Art und Weise, wie jemand unterrichtet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff35945b-f9c7-484f-9ef5-6a08048de198",
                                "sense_id": "42d74594-9e49-36e5-8d09-8b032a337e26",
                                "text": "„Die aus Manchester mitgezogene Kinderfrau bewirkt bei der Mutter eine Änderung der Lehrmethode.“"
                            },
                            {
                                "example_id": "c60ea394-4afe-4e7f-b40f-c31a1f40043e",
                                "sense_id": "42d74594-9e49-36e5-8d09-8b032a337e26",
                                "text": "„Seine Lehrmethode, die er auch theoretisch seinen Schülern bisweilen erläuterte, bestand nicht darin, Philosophie als lernbare Materie zu übermitteln, sondern zu philosophieren und zu dieser Tätigkeit eine Anleitung zu geben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
