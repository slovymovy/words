                                    },
                                    {
                                        "sense_id": "d63387fa-e4c3-3308-8c86-b4f61c5862f0",
                                        "entry_id": "c3168fb9-59a3-36c9-b03c-45b311cbcbd8",
                                        "glosses": [
                                            "Synonyme de mélampyre des champs (Melampyrum arvense)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71ccaf8d-f45a-4b9a-b6d7-225cccff127f",
                                                "sense_id": "d63387fa-e4c3-3308-8c86-b4f61c5862f0",
                                                "text": "La Mélampyre des champs, autrement appelée blé de vache, rougeole, queue de renard , queue de loup, rougette, herbe rouge, rouge-herbe, cornette, mahon, qui est annuelle, souvent très rameuse , rougeâtre , haute d’un pied ; ses feuilles sont sessiles, lancéolées et très longues ; ses fleurs rougeâtres, tachetées de jaune, et les bractées dentées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8deb3872-96dc-3876-964b-18ab79c57a35",
                                        "entry_id": "c3168fb9-59a3-36c9-b03c-45b311cbcbd8",
                                        "glosses": [
                                            "Synonyme de trèfle à feuilles étroites."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "525365e3-62db-3f6f-ab13-916c4752fca9",
                                        "entry_id": "c3168fb9-59a3-36c9-b03c-45b311cbcbd8",
                                        "glosses": [
                                            "Prêle des champs (Equisetum arvense)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c382634-7b67-4830-a0fa-e7dd1cee319c",
                                                "sense_id": "525365e3-62db-3f6f-ab13-916c4752fca9",
                                                "text": "Pour obtenir cette craie en poudre très-fine, on la frotte sur des tiges de prêle ou queue de renard : ensuite on la tamise à travers un tamis de soie à tambour, dont l’intérieur est garni de quatre toiles de soie qui se succèdent par autant de degrés de finesse dans leur tissu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a70ff9d5-8c6d-3949-8281-588574893eed",
                                        "entry_id": "c3168fb9-59a3-36c9-b03c-45b311cbcbd8",
                                        "glosses": [
                                            "Comportement du développement dans l’eau des racines d’une plante de façon très allongée et très divisée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f36d6218-5f65-4b63-a925-cfbaf2541d18",
                                                "sense_id": "a70ff9d5-8c6d-3949-8281-588574893eed",
                                                "text": "Des racines en queue-de-renard."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "06c78a1c-e0d7-3c6d-8246-9df22b991638",
                                        "entry_id": "c3168fb9-59a3-36c9-b03c-45b311cbcbd8",
                                        "glosses": [
                                            "Trace de vomissure."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "063243c1-f7dd-30e0-b6d1-5edf629f0c1b",
                                        "entry_id": "c3168fb9-59a3-36c9-b03c-45b311cbcbd8",
                                        "glosses": [
                                            "Conduit du four sidérurgique selon le procédé catalan, pour évacuer le laitier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ce0f170-cd32-4446-b3e0-99df1a887360",
                                                "sense_id": "063243c1-f7dd-30e0-b6d1-5edf629f0c1b",
                                                "text": "Pour écouler le laitier, qui s’accumulait à la partie supérieure (étant plus léger que le fer), le fondeur avait ménagé, à hauteur convenable, un conduit appelé queue de renard, d’où le nom de renardière ou goupillière, donné à ce genre de four qui permettait d’obtenir directement le fer à partir du minerai et sans passer par la fonte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dfadfa18-e211-3135-9d19-e5a3c62f4915",
                                        "entry_id": "c3168fb9-59a3-36c9-b03c-45b311cbcbd8",
                                        "glosses": [
                                            "Longue traînasse de racines qui entrent dans les tuyaux de conduite et les engorgent, et qu’on en retire au moyen d’une sonde à tire-bourre."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    }
                                ]
