    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ac64af0f-1c15-3d58-a19b-4d78e4afca67",
                    "sense_definition": "To resolve differences or bring about a settlement between conflicting parties.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "conflict_resolution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The international organization was asked to <w>mediate</w> the ongoing border dispute."
                        },
                        {
                            "text": "Both sides agreed to let a neutral third party <w>mediate</w> their disagreement."
                        }
                    ],
                    "synonyms": [
                        "arbitrate",
                        "reconcile",
                        "intercede"
                    ],
                    "common_phrases": [
                        "mediate a dispute",
                        "mediate a conflict"
                    ]
                },
                {
                    "sense_id": "abc8d659-d05d-3adf-97f5-87b95f34e8a3",
                    "sense_definition": "To intervene between conflicting parties in order to help them reach an agreement.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "conflict_resolution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He offered to <w>mediate</w> between the two friends who had stopped speaking."
                        },
                        {
                            "text": "It is often difficult to <w>mediate</w> between family members during a crisis."
                        }
                    ],
                    "synonyms": [
                        "intervene",
                        "negotiate"
                    ],
                    "common_phrases": [
                        "mediate between parties"
                    ]
                },
                {
                    "sense_id": "a639bade-f4d2-3b07-94b6-844ed36026bc",
                    "sense_definition": "To act as an intermediary agent that conveys or facilitates something.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Modern technology has <w>mediated</w> the way we interact with our friends daily."
                        },
                        {
                            "text": "The teacher <w>mediated</w> the complex information to make it easier for students."
                        }
                    ],
                    "synonyms": [
                        "facilitate",
                        "convey"
                    ]
                },
                {
                    "sense_id": "5da6770a-2d9c-3836-ae8f-c0d585223bec",
