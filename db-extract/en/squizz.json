                    {
                        "sense_id": "a374bd90-5abe-3e15-9f80-4a30ba6645ee",
                        "entry_id": "cc8497e8-dbe7-3537-b6d5-b9b9f2346c4a",
                        "glosses": [
                            "To look, to examine."
                        ],
                        "tags": [
                            "Commonwealth",
                            "Ireland",
                            "West-Country",
                            "colloquial",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "e8b6d6ce-143c-41a9-a55b-2c1beddc6408",
                                "sense_id": "a374bd90-5abe-3e15-9f80-4a30ba6645ee",
                                "text": "“That′s just according to how you bring them up, Jane,” Betsy replied ; “if they′d had porridge from the first, they′d have eaten it fast enough ; and it isn′t good to allow children to be squizzing (looking) into their food and picking it over.”"
                            },
                            {
                                "example_id": "715daed6-0685-4140-8247-0e012accb563",
                                "sense_id": "a374bd90-5abe-3e15-9f80-4a30ba6645ee",
                                "text": "He liked to see them laughing, enjoying themselves, squizzing at the antics of whitefellers in party mood."
                            },
                            {
                                "example_id": "f5cbfa1f-0ec3-4af5-8045-b1817b5badb3",
                                "sense_id": "a374bd90-5abe-3e15-9f80-4a30ba6645ee",
                                "text": "1999, Lindsay Charman-Love, Top Hat and Taiaha, Huia Short Stories 3, Huia Publishers, New Zealand, page 44,\nOthers were off at the shops getting ice blocks or squizzing at the boats down at the wharf."
                            },
                            {
                                "example_id": "e97912c0-e70c-4e27-bbe5-cec99870e08d",
                                "sense_id": "a374bd90-5abe-3e15-9f80-4a30ba6645ee",
                                "text": "2010, Linzy Harris, Perdita, Paragon Publishing, UK, page 79,\nShe presented me with a bag, and when I squizzed inside I saw it contained five boxes of cigarettes."
                            }
                        ]
                    }
