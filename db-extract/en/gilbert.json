                    {
                        "translation_id": "ebb845d4-405b-4ca9-8b0e-2ddf1c9a89d7",
                        "source_entry_id": "7152a8f2-75c3-3ebf-8854-491ab09deda7",
                        "source_sense_description": "male given name",
                        "target_lang_word": "Gilbert",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gilbert",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "42f4d11a-8ba9-30e0-a3f9-52e20bb5a74c",
                                        "entry_id": "64aea70c-c259-36e7-98d1-99909baea081",
                                        "glosses": [
                                            "Nom de famille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a366596-507a-45f1-ba01-cbb06cc8a467",
                                                "sense_id": "42f4d11a-8ba9-30e0-a3f9-52e20bb5a74c",
                                                "text": "Démare est le premier à réaliser le doublé depuis Philippe Gilbert, en 2008 et 2009."
                                            },
                                            {
                                                "example_id": "af3f991b-5208-4df0-a0ea-5830438e2ab3",
                                                "sense_id": "42f4d11a-8ba9-30e0-a3f9-52e20bb5a74c",
                                                "text": "Les neuf autres (Powless, Alaphilippe, Kwiatkowski, Mollema, Adam Yates, Valverde, Gallopin, Sanchez et Gilbert) avaient tous la Grande Boucle dans les jambes."
                                            },
                                            {
                                                "example_id": "de23328a-bf60-431f-b481-b342bb4d96c6",
                                                "sense_id": "42f4d11a-8ba9-30e0-a3f9-52e20bb5a74c",
                                                "text": "Mais comme le dit Pierre Gilbert, cofondateur de Sator (une entreprise spécialisée dans les formations à la transition écologique), « les emplois verts de demain seront pour beaucoup les emplois traditionnels d’aujourd’hui »."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Gilbert",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "846095f3-ad43-3736-8e2d-e343b71a349f",
                                        "entry_id": "5d68820b-5783-38fd-a224-06f3c88b05c5",
                                        "glosses": [
                                            "Prénom masculin français."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "204032ec-0ba9-43fa-bd8d-6e7de9d64aad",
                                                "sense_id": "846095f3-ad43-3736-8e2d-e343b71a349f",
                                                "text": "Au fond de ses poches sautillent des pièces de monnaie qui paieront le café et le croissant pour Gilbert."
                                            },
                                            {
                                                "example_id": "b4676fda-4119-45b3-85c1-1a77e277686c",
                                                "sense_id": "846095f3-ad43-3736-8e2d-e343b71a349f",
                                                "text": "Mardi, 20 ans de prison ont été requis contre le général Gilbert Diendéré, l'un des chefs de l’armée lors du putsch de 1987 et principal accusé présent."
                                            },
                                            {
                                                "example_id": "244ff797-1460-49cf-8b37-afc64f3d305a",
                                                "sense_id": "846095f3-ad43-3736-8e2d-e343b71a349f",
                                                "text": "Gilbert continua la mise en place de son bar pour le service de midi, des effluves aromatiques filtraient déjà par la porte battante de la cuisine où Rosa, une femme plantureuse de corps et d’esprit, préparait avec une volubile énergie nourricière une gibelotte."
                                            },
                                            {
                                                "example_id": "9efe6400-16f5-4e3f-9d64-14bf8c279e34",
                                                "sense_id": "846095f3-ad43-3736-8e2d-e343b71a349f",
                                                "text": "Gilbert Bécaud, compositeur et chanteur français."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
