                },
                {
                    "sense_id": "372fbbd9-8bcb-3ef8-9475-9b62607ab28b",
                    "sense_definition": "Передняя панель кузова автомобиля, к которой крепятся фары и радиатор.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "auto_part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "При аварии пострадал бампер и погнулся <w>телевизор</w>.",
                            "target_lang_translations": {
                                "en": "In the accident, the bumper was damaged and the <w>radiator support</w> was bent.",
                                "nl": "Bij het ongeluk raakte de bumper beschadigd en was de <w>radiateursteun</w> verbogen."
                            }
                        },
                        {
                            "text": "Механик сказал, что нужно менять <w>телевизор</w> целиком.",
                            "target_lang_translations": {
                                "en": "The mechanic said that the whole <w>radiator support</w> needs to be replaced.",
                                "nl": "De monteur zei dat de hele <w>radiateursteun</w> vervangen moet worden."
                            }
                        }
                    ],
                    "traits": [
