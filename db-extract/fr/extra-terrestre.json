                            "feminine"
                        ],
                        "form": "extra-terrestres"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e2dd17a9-bfc0-3636-bc48-8fe8f6d95655",
                        "entry_id": "e88a1c03-9044-3c4c-b505-c84a248d5fd1",
                        "glosses": [
                            "Variante orthographique de extraterrestre."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "e61df9b4-1eb2-4490-840c-847fbfbbe1a5",
                                "sense_id": "e2dd17a9-bfc0-3636-bc48-8fe8f6d95655",
                                "text": "La vérité fut lente à pénétrer mon esprit troublé par une enquête qui se heurtait à chaque instant à des événements qu’à première vue on pouvait juger extra-terrestres, et, plus d’une fois, je fus tout près d’abandonner une besogne où je m’exténuais à poursuivre, — sans la saisir jamais, — une vaine image."
                            },
                            {
                                "example_id": "3d153ab6-d153-4fb8-8c74-0e2eccfeca5f",
                                "sense_id": "e2dd17a9-bfc0-3636-bc48-8fe8f6d95655",
                                "text": "Il est des impressions, des sentiments, — vagues, indéfinissables, — qui sont comme des souvenirs ou des intuitions de choses extra-terrestres ; on les éprouve plus nettement, on se sent plus près de l’objet de ces conceptions mystérieuses, dans le rêve que dans la veille…"
                            }
                        ]
                    }
                ],
