                "translations": [
                    {
                        "translation_id": "e69a1597-b752-4590-bb2f-4d749b008a66",
                        "source_entry_id": "338e89bb-b6e6-317a-9ecd-360fca1c41d7",
                        "source_sense_id": "1a52ad23-0e28-3834-a87f-c3aaa0467ec2",
                        "target_lang_word": "carborundum",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "carborundum",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "debacc7c-cb09-3ae1-a583-46b99b5a91bd",
                                        "entry_id": "de1d4d3d-5ecc-333b-8e2f-9f88a396bf10",
                                        "glosses": [
                                            "Crystals of silicon carbide used as an abrasive."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d19b80c-99ef-4ec0-a00a-a6b50c157424",
                                                "sense_id": "debacc7c-cb09-3ae1-a583-46b99b5a91bd",
                                                "text": "There is no doubt that such a button — properly prepared under great pressure — of carborundum, especially of powder of the best quality, will withstand the effect of the bombardment fully as well as anything we know."
                                            },
                                            {
                                                "example_id": "df327deb-115b-481b-a82b-2fcfdf6b1fad",
                                                "sense_id": "debacc7c-cb09-3ae1-a583-46b99b5a91bd",
                                                "text": "This can most readily be done by use of carborundum marking. The procedure involves successive marking of the same mat with layers of carborundum at least twice."
                                            },
                                            {
                                                "example_id": "f8650e05-1670-4320-a668-326621421f60",
                                                "sense_id": "debacc7c-cb09-3ae1-a583-46b99b5a91bd",
                                                "text": "At the same times, samples were taken to determine that the carborundum treatment did increase the amount of wear of the mandibles compared with insects on the diet without carborundum powder."
                                            },
                                            {
                                                "example_id": "9e46be43-830c-4aed-a42d-552d72042ff2",
                                                "sense_id": "debacc7c-cb09-3ae1-a583-46b99b5a91bd",
                                                "text": "Print made by combining carborundum—a carbon and silicon compound customarily used for polishing by abrasion—with synthetic resin or varnish (see also Prints, §III, 5)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
