                                        "glosses": [
                                            "действие по значению гл. изречь"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9ea65b58-58dd-3792-a0e1-743ce5bf3dd3",
                                        "entry_id": "922f7ae4-1c8c-357c-a5ce-1117111cd2e0",
                                        "glosses": [
                                            "результат такого действия; глубокая мысль, суждение, выраженные с предельной лаконичностью и в отточенной форме; афоризм"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "345a4342-531c-4507-b490-d9f941d21318",
                                                "sense_id": "9ea65b58-58dd-3792-a0e1-743ce5bf3dd3",
                                                "text": "ибо в этом случае справедливо изречение: «один сеет, а другой жнет»."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ec96305c-e710-4731-a9e5-3c1dc6551844",
                        "source_entry_id": "354e72a5-0f60-33f3-a16e-d021ade17bfb",
                        "source_sense_description": "authoritative statement",
                        "target_lang_word": "сенте́нция",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "сенте́нция",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "bb749b1d-b831-31d7-8154-8c984502b197",
                                        "entry_id": "f3a327f8-8ed7-3529-bedd-7f1772246289",
                                        "glosses": [
                                            "книжн. нравоучительное изречение"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ee3aed0-714a-415a-8cc0-20525477a70f",
                                                "sense_id": "bb749b1d-b831-31d7-8154-8c984502b197",
                                                "text": "Каждая глава состояла из коротеньких, изящных, порою очень тонких сентенций, и некоторые из них были деликатно отмечены пером, красными чернилами."
                                            },
                                            {
                                                "example_id": "e349ce8e-0356-4df7-b85b-c5c028466de9",
                                                "sense_id": "bb749b1d-b831-31d7-8154-8c984502b197",
                                                "text": "Накрой же кто его на этом ковшике любимою его сентенциею: «всё суета сует», у него тотчас готова оговорка: ведь надобно ж было испытать, какова водица, чтобы описать её свойства!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
