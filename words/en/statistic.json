{
    "word_family": [
        "statistical",
        "statistically",
        "statistician",
        "statistics",
        "statist"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "cc74e304-c4c1-348d-9d5a-516acfbbbe4b",
                    "sense_definition": "A single piece of data or an item of information from a study or survey.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "data_point",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The most interesting <w>statistic</w> in the report shows that more people are working from home.",
                            "target_lang_translations": {
                                "ru": "Самый интересный <w>статистический показатель</w> в отчете показывает, что все больше людей работают из дома."
                            }
                        },
                        {
                            "text": "Every <w>statistic</w> collected during the census helps the government plan for the future.",
                            "target_lang_translations": {
                                "ru": "Каждый <w>статистический факт</w>, собранный во время переписи, помогает правительству планировать будущее."
                            }
                        }
                    ],
                    "common_phrases": [
                        "interesting statistic",
                        "vital statistic",
                        "official statistic"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отдельный показатель или единица информации из исследования или опроса."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "статистический показатель",
                                "target_lang_sense_clarification": "конкретное числовое значение"
                            },
                            {
                                "target_lang_word": "статистический данные",
                                "target_lang_sense_clarification": "единица данных"
                            },
                            {
                                "target_lang_word": "факт",
                                "target_lang_sense_clarification": "подтвержденная цифра"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dceaedd1-5670-300f-b4e8-d3dbc8d9c543",
                    "sense_definition": "A numerical value, such as a mean or standard deviation, calculated from a sample of data to describe a specific characteristic.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mathematical_value",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The researcher calculated a summary <w>statistic</w> to represent the average age of the participants.",
                            "target_lang_translations": {
                                "ru": "Исследователь рассчитал обобщающий <w>показатель</w>, чтобы представить средний возраст участников."
                            }
                        },
                        {
                            "text": "A single <w>statistic</w> like the median can sometimes be more useful than the mean.",
                            "target_lang_translations": {
                                "ru": "Один <w>статистический параметр</w>, такой как медиана, иногда может быть полезнее, чем среднее значение."
                            }
                        }
                    ],
                    "common_phrases": [
                        "summary statistic",
                        "test statistic",
                        "descriptive statistic"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Числовое значение (например, среднее или стандартное отклонение), рассчитанное на основе выборки данных."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "статистика",
                                "target_lang_sense_clarification": "математическая величина"
                            },
                            {
                                "target_lang_word": "параметр",
                                "target_lang_sense_clarification": "характеристика выборки"
                            },
                            {
                                "target_lang_word": "показатель",
                                "target_lang_sense_clarification": "результат вычисления"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "27da59ae-3d99-3e74-b35e-a26fb30680a6",
                    "sense_definition": "A person or an event that is treated merely as a number or a piece of data, often implying a lack of human concern.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "dehumanized_data",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The victim's family refused to let him become just another <w>statistic</w> in the city's crime records.",
                            "target_lang_translations": {
                                "ru": "Семья жертвы отказалась позволить ему стать просто еще одной <w>единицей статистики</w> в городских криминальных сводках."
                            }
                        },
                        {
                            "text": "By dying from an overdose, he became just another <w>statistic</w> in the national health crisis.",
                            "target_lang_translations": {
                                "ru": "Умерев от передозировки, он стал просто очередной <w>цифрой</w> в национальном кризисе здравоохранения."
                            }
                        }
                    ],
                    "synonyms": [
                        "reduced to item of information"
                    ],
                    "common_phrases": [
                        "just another statistic",
                        "become a statistic"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек или событие, рассматриваемые лишь как цифра в отчете, часто с оттенком безразличия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "единица статистики",
                                "target_lang_sense_clarification": "обезличенный объект"
                            },
                            {
                                "target_lang_word": "цифра",
                                "target_lang_sense_clarification": "в переносном смысле о человеке"
                            },
                            {
                                "target_lang_word": "статистическая единица",
                                "target_lang_sense_clarification": "формальный термин"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "7ddf9d07-8990-3d1d-9b24-4e292159d194",
                    "sense_definition": "An alternative form of <w>statistical</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The researcher used a <w>statistic</w> model to analyze the growth patterns of the local population.",
                            "target_lang_translations": {
                                "ru": "Исследователь использовал <w>статистическую</w> модель для анализа моделей роста местного населения."
                            }
                        },
                        {
                            "text": "Some older texts use the <w>statistic</w> method rather than the modern term statistical.",
                            "target_lang_translations": {
                                "ru": "В некоторых старых текстах используется термин «<w>статистический</w> метод» вместо современного прилагательного."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Устаревшая или редкая форма прилагательного «статистический»."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "статистический",
                                "target_lang_sense_clarification": "относящийся к статистике"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d5a59abd-98e5-3be7-acb4-62d700f2f6c5",
                    "sense_definition": "To analyze, describe, or organize information using statistics.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "statistical_analysis",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The data was carefully <w>statisticked</w> to ensure that every variable was accounted for in the final report.",
                            "target_lang_translations": {
                                "ru": "Данные были тщательно <w>статистически обработаны</w>, чтобы гарантировать учет каждой переменной в итоговом отчете."
                            }
                        },
                        {
                            "text": "When you get us all neatly docketed and <w>statisticked</w>, where will you put me?",
                            "target_lang_translations": {
                                "ru": "Когда вы нас всех аккуратно зарегистрируете и <w>подсчитаете для статистики</w>, куда вы меня денете?"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used humorously or critically"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Анализировать или организовывать информацию с помощью методов статистики."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подсчитывать статистику",
                                "target_lang_sense_clarification": "обрабатывать данные"
                            },
                            {
                                "target_lang_word": "статистически обрабатывать",
                                "target_lang_sense_clarification": "проводить анализ"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7a63f3ed-88db-3bd6-8500-a3c38475296f",
                    "sense_definition": "To cite, calculate, or engage in the act of producing statistics.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "statistical_analysis",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spent the entire afternoon <w>statisticking</w> about the economic decline of the region.",
                            "target_lang_translations": {
                                "ru": "Он провел весь день, <w>сыпля цифрами</w> об экономическом упадке региона."
                            }
                        },
                        {
                            "text": "When a fellow quits <w>statisticking</w> for a while, they say, \"Oh, haven't you one more statistic?\"",
                            "target_lang_translations": {
                                "ru": "Когда парень на время перестает <w>заниматься статистикой</w>, говорят: «О, неужели у тебя нет еще одной цифры?»"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Приводить статистические данные или заниматься их вычислением (разговорно)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сыпать цифрами",
                                "target_lang_sense_clarification": "приводить много данных"
                            },
                            {
                                "target_lang_word": "заниматься статистикой",
                                "target_lang_sense_clarification": "вычислять показатели"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}