                                        "sense_id": "8647a6a4-db67-3bc6-9a48-14d50740ef40",
                                        "entry_id": "dd697d86-48f1-39c0-ab23-8a3561fa8746",
                                        "glosses": [
                                            "Ablehnung und unangenehme Gefühle hervorrufend"
                                        ],
                                        "tags": [
                                            "gehoben"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "45c792a2-2292-47b8-aec8-c6cbd9a0d520",
                                                "sense_id": "8647a6a4-db67-3bc6-9a48-14d50740ef40",
                                                "text": "Fleisch zu essen ist meiner Schwester zuwider."
                                            },
                                            {
                                                "example_id": "ccd7c579-f5e1-4b8e-9c29-14c64cd336e8",
                                                "sense_id": "8647a6a4-db67-3bc6-9a48-14d50740ef40",
                                                "text": "„Da hatte sie der Ernst noch näher an sich gezogen und ihr zugeflüstert, ab jetzt würden sie niemanden mehr einladen, der ihr zuwider sei.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "zuwider",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e5746d12-734c-3b7f-b9bf-56dd5ba4213e",
                                        "entry_id": "c86be1ff-4044-3909-8d36-581708a2768b",
                                        "glosses": [
                                            "einer Sache (Geschmack, Regel, Wesen) entgegen"
                                        ],
                                        "tags": [
                                            "literary",
                                            "with-dative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "35a3daea-3010-471f-9317-ef2ec542b25f",
                                                "sense_id": "e5746d12-734c-3b7f-b9bf-56dd5ba4213e",
                                                "text": "Er hat dem Gesetz zuwider im Wald seinen Müll entsorgt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2bb0850d-509c-460b-8e3a-7f663279f23d",
                        "source_entry_id": "f01c56da-de35-379b-af57-c2d41434a24f",
                        "source_sense_description": "резко противореча, не соответствуя",
                        "target_lang_word": "contrairement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "contrairement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2610933e-0458-3b99-a3cf-674ed50d7bd4",
                                        "entry_id": "7da86a81-d785-3948-8b48-03bbe2584062",
                                        "glosses": [
                                            "En opposition."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a6dd9d6-833b-41e9-be22-a5e81a80b02a",
                                                "sense_id": "2610933e-0458-3b99-a3cf-674ed50d7bd4",
                                                "text": "[…] ; mais, contrairement à toutes les idées reçues, Durtal ne pensait pas que le mépris de l’argent impliquât nécessairement la folie […]."
                                            },
                                            {
                                                "example_id": "955bdd4e-28fc-43c5-be26-2c33411ab84a",
                                                "sense_id": "2610933e-0458-3b99-a3cf-674ed50d7bd4",
                                                "text": "Or les écheveaux à numéroter à Tourcoing sont généralement d'un dévidage difficile, contrairement à ce qui se passe à Roubaix."
                                            },
                                            {
                                                "example_id": "5d00cec7-47a1-4600-8bcd-9f234e990bd2",
                                                "sense_id": "2610933e-0458-3b99-a3cf-674ed50d7bd4",
                                                "text": "Dès qu’il fut descendu de voiture, celui-ci, contrairement à toutes ses habitudes, ne monta pas directement à sa chambre, il entra dans le salon et s’y promena, le visage à l’orage, très agité, très nerveux, s’impatientant de ce qu'on ne servît pas."
                                            },
                                            {
                                                "example_id": "b46dcaed-3351-40af-a6b4-fe5722a38dc2",
                                                "sense_id": "2610933e-0458-3b99-a3cf-674ed50d7bd4",
                                                "text": "Contrairement aux vieilles sagas scandinaves où bouillonne le sang des Vikings, Le Kalevala est un récit plutôt pacifique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
