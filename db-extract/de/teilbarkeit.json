                "senses": [
                    {
                        "sense_id": "d31a9b02-1523-393e-b922-6b9d5156c95f",
                        "entry_id": "59a3389f-c5d3-32ba-88f2-7b43f48a7a45",
                        "glosses": [
                            "die Eigenschaft einer Zahl, durch eine andere teilbar zu sein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc4fcbb4-2bfa-487b-976c-953c9b764572",
                                "sense_id": "d31a9b02-1523-393e-b922-6b9d5156c95f",
                                "text": "„Für die Teilbarkeit einer Zahl durch 3 oder 9 kann stellvertretend ihre Quersumme herangezogen werden: Eine dezimal dargestellte Zahl n ist genau dann durch 3 bzw. 9 teilbar, wenn ihre Quersumme q(n) ohne Rest durch 3 bzw. 9 teilbar ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
