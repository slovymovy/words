        "fr-extract.jsonl": [
            {
                "entry_id": "63ca17a6-e835-3a17-bb52-650a6add1c83",
                "word": "hématome",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "aeb28ad4-94f3-43d3-a7b5-79c8f8b76ff1",
                        "entry_id": "63ca17a6-e835-3a17-bb52-650a6add1c83",
                        "tags": [
                            "plural"
                        ],
                        "form": "hématomes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "86dbeb9d-06b6-39c0-b3ba-ca1589cf79db",
                        "entry_id": "63ca17a6-e835-3a17-bb52-650a6add1c83",
                        "glosses": [
                            "Poche de sang apparaissant généralement suite à une hémorragie, ou à la suite d’un choc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5820543-ea2e-4b1a-bc47-ec42aa6db5ea",
                                "sense_id": "86dbeb9d-06b6-39c0-b3ba-ca1589cf79db",
                                "text": "Malgré sa fureur, décuplée par la tension subie depuis vingt-quatre heures, il n’y parvint pas et gagna dans l’aventure un hématome de la taille d’une orange."
                            },
                            {
                                "example_id": "4ac1e7e8-a3e6-43b5-879e-f328d462e3c1",
                                "sense_id": "86dbeb9d-06b6-39c0-b3ba-ca1589cf79db",
                                "text": "Si, lors d'un mouvement brutal du pénis en érection, vous ressentez une vive douleur, et perdez votre érection instantanément alors qu'un hématome apparaît, vous avez une fracture du pénis. Il faut vous rendre aux urgences."
                            },
                            {
                                "example_id": "1af9a0d7-55ad-4752-b603-d1994b219cce",
                                "sense_id": "86dbeb9d-06b6-39c0-b3ba-ca1589cf79db",
                                "text": "Le LBD provoque des fractures, des hématomes et des contusions (pulmonaires, osseuses, cérébrales). Il arrache des joues et éborgne. Il a occasionné des comas de quelques jours à un mois."
                            },
                            {
                                "example_id": "c9e6a2a9-69e7-4888-80d6-77f871bc337b",
                                "sense_id": "86dbeb9d-06b6-39c0-b3ba-ca1589cf79db",
                                "text": "Par chance, Joanna et l'autre conducteur s'en sortent avec des entorses cervicales et des hématomes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "50ec7910-3df2-4c90-8c21-3bcfe325138e",
                        "source_entry_id": "63ca17a6-e835-3a17-bb52-650a6add1c83",
                        "source_sense_id": "86dbeb9d-06b6-39c0-b3ba-ca1589cf79db",
                        "target_lang_word": "Hämatom",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hämatom",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "14348531-ec36-36b8-bb24-5de7c314048f",
                                        "entry_id": "ddcd4e6b-0042-3bb5-8d75-7a0939328d3f",
                                        "glosses": [
                                            "Stelle unter der Haut, an der sich durch Verletzung der hautnahen Blutgefäße Blut ansammelt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6da3a045-4a61-4a9b-b7b1-0e0fc5c94bab",
                                                "sense_id": "14348531-ec36-36b8-bb24-5de7c314048f",
                                                "text": "„Der 35-jährige Ukrainer war am Freitag in einen Massensturz verwickelt und hatte sich dabei ein großes Hämatom am Rücken zugezogen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2f80cd27-2d51-46c4-84f2-7c651da7fa84",
                        "source_entry_id": "63ca17a6-e835-3a17-bb52-650a6add1c83",
                        "source_sense_id": "86dbeb9d-06b6-39c0-b3ba-ca1589cf79db",
                        "target_lang_word": "hematoma",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hematoma",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3609e055-770b-3821-b7bf-da14bde69eac",
                                        "entry_id": "7ab0b43c-224a-39c6-8119-77b8a1fa4357",
                                        "glosses": [
                                            "A swelling of blood, usually clotted, which forms as a result of broken blood vessels."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce9bafb7-7256-4773-99ba-ac6116e4ee16",
                                                "sense_id": "3609e055-770b-3821-b7bf-da14bde69eac",
                                                "text": "The so-called Danlos or Ehlers-Danlos syndrome consists of three symptoms: (1) pronounced fragility of the skin and its blood vessels, with breaking, splitting and the formation of hematomas and pseudotumors subsequent to the slightest trauma (dermatorrhexis-fragilitas cutis), (2) a more or less pronounced hyperlaxity and hyperelasticity of the skin (dermatochalasis-laxitas cutis) and (3) more or less pronounced hyperlaxity or hyperflexibility of the joints (arthrochalasis-laxitas articularis)."
                                            },
                                            {
                                                "example_id": "9a63b0de-df3f-46c5-8a24-d4f1685862b2",
                                                "sense_id": "3609e055-770b-3821-b7bf-da14bde69eac",
                                                "text": "In 30 years as an expert witness, I have seen total plexus paralysis in three patients after needle angiography with intraaxillary hematoma not followed by surgical repair."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b3413175-a44b-45c6-881b-a034dac72333",
                        "source_entry_id": "63ca17a6-e835-3a17-bb52-650a6add1c83",
                        "source_sense_id": "86dbeb9d-06b6-39c0-b3ba-ca1589cf79db",
                        "target_lang_word": "bruise",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bruise",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "123798cc-d79d-3b5f-b74d-76a8f98e3fe3",
                                        "entry_id": "45cf9f0c-3a76-3680-864c-9d0e917ad8a7",
                                        "glosses": [
                                            "To strike (a person), originally with something flat or heavy, but now specifically in such a way as to discolour the skin without breaking it; to contuse."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06be5bf7-d099-47df-bee0-b55586859ca3",
                                                "sense_id": "123798cc-d79d-3b5f-b74d-76a8f98e3fe3",
                                                "text": "It is as I have spoken: the testing first, next the bruising, and in the last bout the breaking and killing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "885549ec-24d8-3af6-9189-a9f5e9d9a7ae",
                                        "entry_id": "45cf9f0c-3a76-3680-864c-9d0e917ad8a7",
                                        "glosses": [
                                            "To damage the skin of (fruit or vegetables), in an analogous way."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5439d270-48eb-3e47-a0fe-c31ed93cda89",
                                        "entry_id": "45cf9f0c-3a76-3680-864c-9d0e917ad8a7",
                                        "glosses": [
                                            "Of fruit or vegetables, to gain bruises through being handled roughly."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d2898ba-fef0-4d85-b2b6-ebb0adf3f856",
                                                "sense_id": "5439d270-48eb-3e47-a0fe-c31ed93cda89",
                                                "text": "Bananas bruise easily."
