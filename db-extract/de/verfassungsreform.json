                "senses": [
                    {
                        "sense_id": "52acb918-cb1f-3156-a302-3ddb3de06119",
                        "entry_id": "3415c637-2026-3673-a52c-0de0d6b88bee",
                        "glosses": [
                            "Reform/Überarbeitung einer Verfassung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b81246c4-276b-49a4-9475-9f80d79203f6",
                                "sense_id": "52acb918-cb1f-3156-a302-3ddb3de06119",
                                "text": "„Die sogenannten «Extremisten» wollten die Agitation verschärfen, während die «Gemäßigten» ihre Hoffnungen auf die britischen Liberalen setzten, die 1906 einen Wahlsieg errangen und mit dem Philosophen John Morley, einem Schüler John Stuart Mills, einen Indienminister stellten, den die indischen Nationalliberalen verehrten und von dem sie eine gute Verfassungsreform erwarteten.“"
                            },
                            {
                                "example_id": "bf645cba-3e78-4d2f-b96f-acf4ef1a6a88",
                                "sense_id": "52acb918-cb1f-3156-a302-3ddb3de06119",
                                "text": "„Die später im Laufe der Beschäftigung mit den Ereignissen der Französischen Revolution deutlich werdende Abneigung gegen die Idee, Verfassungsreformen als Heil- oder doch wenigstens Kalmierungsmittel in sozialen und politischen Krisen anzusehen, deutet sich im »Goldnen Spiegel« schon an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
