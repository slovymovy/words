                                                "sense_id": "9ae1bc5b-1ae7-371b-988b-f8c0b1d92cdc",
                                                "text": "Die ganze Nacht hindurch zechten die Schulabsolventen auf dem Dorfanger."
                                            },
                                            {
                                                "example_id": "a5671922-00ee-4ad9-86e7-2841749302dd",
                                                "sense_id": "9ae1bc5b-1ae7-371b-988b-f8c0b1d92cdc",
                                                "text": "„Wir zechten in dem traulichen Einjährigenkasino, und er ging reizend auf meine begeisterte Stimmung ein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
