                                "target_senses": [
                                    {
                                        "sense_id": "c50acf3c-7004-3a72-aea8-6eede0e62a5a",
                                        "entry_id": "3816bfa9-6344-3845-b7dc-a34bc5d6815e",
                                        "glosses": [
                                            "A male peafowl, especially Pavo cristatus, notable for its brilliant iridescently ocellated tail."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0dd8ead3-54f4-4c2d-a9a2-89f6a1df98e1",
                                                "sense_id": "c50acf3c-7004-3a72-aea8-6eede0e62a5a",
                                                "text": "The ſpring diſplaying her elegant taſte, the proud walk of the gold-feathered pheaſant, the light tread of the ſmall-hoofed hind, and the dancing of the ſtar-trained peacock, infuſed joy into the ſoul of the ſpectator of the aſtoniſhing works of the Creator."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "16c14203-f4e3-3874-8432-3448d59875c9",
                                        "entry_id": "3816bfa9-6344-3845-b7dc-a34bc5d6815e",
                                        "glosses": [
                                            "A peafowl (of the genus Pavo or Afropavo), either male or female."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "86b8911f-21d4-3a69-ae33-83976e10c9d6",
                                        "entry_id": "3816bfa9-6344-3845-b7dc-a34bc5d6815e",
                                        "glosses": [
                                            "A pompous or vainglorious person [from the 14th c.]."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "46c88476-a4c2-3b30-89c1-1118f72624ba",
                                        "entry_id": "3816bfa9-6344-3845-b7dc-a34bc5d6815e",
                                        "glosses": [
                                            "Any of various Asian species of papilionid butterflies of the genus Papilio."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "peacock",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "30890adb-d857-373a-9a8d-1cd18957f0e3",
                                        "entry_id": "bf71842a-ccbf-3898-858b-394260d2abea",
                                        "glosses": [
                                            "To strut about proudly or haughtily."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c6f0ad60-b117-4674-a1e7-bc3cf734ae87",
                                                "sense_id": "30890adb-d857-373a-9a8d-1cd18957f0e3",
                                                "text": "A routine border-check in upstate New York had turned into a back-room interrogation, and I was worried, because the three friends I was traveling with didn’t respond to authority well. I could almost hear the wry grins cracking their faces as the officers peacocked. “Is U.S. Customs a joke to you?” one officer asked. My friend Alex said, “No law against smiling, sir.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a0e0570e-3c2b-3c0a-a039-836fb72adee4",
                                        "entry_id": "bf71842a-ccbf-3898-858b-394260d2abea",
                                        "glosses": [
                                            "To engage in peacocking, ostentatious dress or behaviour to impress women."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    }
                                ]
