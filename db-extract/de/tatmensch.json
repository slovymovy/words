                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53ca3cfd-4a7e-4f00-b4c4-280d15c9efc2",
                                "sense_id": "276aceba-ae92-35ea-b89b-f08a890e21da",
                                "text": "„Als Tatmensch war ich eine Null, aber als einer, der gerührt Worte verschenkte, war ich passabel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
