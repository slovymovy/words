                    {
                        "sense_id": "f448f05d-71a5-3525-ab2d-a4325dd64018",
                        "entry_id": "7dd2434f-e78a-3084-b39c-d1b9c982d5a1",
                        "glosses": [
                            "Synonym von fuck"
                        ],
                        "tags": [
