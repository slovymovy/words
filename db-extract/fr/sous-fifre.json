                                    {
                                        "sense_id": "33eab044-a9bb-38f2-aaf3-cc395c86aed8",
                                        "entry_id": "5fc61861-209c-301d-90b0-850e4673631f",
                                        "glosses": [
                                            "A loyal servant of another, usually a more powerful being."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "56f4a1c7-32e1-41e1-9c1e-74a3bfef7cc6",
                                                "sense_id": "33eab044-a9bb-38f2-aaf3-cc395c86aed8",
                                                "text": "The archvillain deployed his minions to simultaneously rob every bank in the city."
                                            },
                                            {
                                                "example_id": "2ba5a471-ee7e-407d-b61b-c96f57e09773",
                                                "sense_id": "33eab044-a9bb-38f2-aaf3-cc395c86aed8",
                                                "text": "In the past two years, NASA’s Kepler Space Telescope has located nearly 3,000 exoplanet candidates ranging from sub-Earth-sized minions to gas giants that dwarf our own Jupiter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60171db5-df4a-33aa-a9b5-e371b2d88ae4",
                                        "entry_id": "5fc61861-209c-301d-90b0-850e4673631f",
                                        "glosses": [
                                            "A sycophantic follower."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8d441e08-aa12-31d4-a5f5-6bedd6736222",
                                        "entry_id": "5fc61861-209c-301d-90b0-850e4673631f",
                                        "glosses": [
                                            "The size of type between nonpareil and brevier, standardized as 7-point."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fe751ec3-f2d5-3f59-ba79-2a5890aa6ce6",
                                        "entry_id": "5fc61861-209c-301d-90b0-850e4673631f",
                                        "glosses": [
                                            "A loved one; one highly esteemed and favoured."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f7c92fea-839a-4bec-96f6-63d69704be70",
                                                "sense_id": "fe751ec3-f2d5-3f59-ba79-2a5890aa6ce6",
                                                "text": "God's disciple and his dearest minion"
                                            },
                                            {
                                                "example_id": "7be4cabb-f240-4780-8a11-85771e667e70",
                                                "sense_id": "fe751ec3-f2d5-3f59-ba79-2a5890aa6ce6",
                                                "text": "Is this the Athenian minion whom the world / Voiced so regardfully?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "18932802-f3c3-338c-8a63-879054674070",
                                        "entry_id": "5fc61861-209c-301d-90b0-850e4673631f",
                                        "glosses": [
                                            "An ancient form of ordnance with a calibre of about three inches."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1fa53485-281f-4213-8c11-2545ea1784db",
                                                "sense_id": "18932802-f3c3-338c-8a63-879054674070",
                                                "text": "Gun. My Cannons rung like Bells. Here's to my Mistress, The dainty sweet brass Minion: split their Fore-mast, She never fail'd."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60dea762-52b3-3310-9bd6-edbe107fb399",
                                        "entry_id": "5fc61861-209c-301d-90b0-850e4673631f",
                                        "glosses": [
                                            "Obsolete form of minium."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b605e74-6575-4cbc-a07f-b023e1fdea7f",
                                                "sense_id": "60dea762-52b3-3310-9bd6-edbe107fb399",
                                                "text": "Of philosophers and scholars priscae sapientiae dictatores, I have already spoken in general terms, those superintendents of wit and learning, men above men, those refined men, minions of the muses."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "minion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
