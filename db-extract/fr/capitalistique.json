                                "target_senses": [
                                    {
                                        "sense_id": "c1edddea-6a4f-3f2d-b98c-83a54e0427d1",
                                        "entry_id": "dc2bf8d9-854a-32c3-ba57-2e3a4a02aee7",
                                        "glosses": [
                                            "Of or pertaining to capitalism or to capitalists."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "119403dc-e127-4d06-9566-dd8bb7e9e3ef",
                                                "sense_id": "c1edddea-6a4f-3f2d-b98c-83a54e0427d1",
                                                "text": "This gloomy view of the capitalistic production system envisioned ceaseless warfare among the major powers."
                                            },
                                            {
                                                "example_id": "338dd219-b629-420c-9818-07d178e32d4e",
                                                "sense_id": "c1edddea-6a4f-3f2d-b98c-83a54e0427d1",
                                                "text": "In other words, the workers will overthrow the capitalistic class and establish a so-called dictatorship of the proletariat, which will finally become a classless society."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d0a65bbc-98e6-355a-9ac3-1246339c846e",
                                        "entry_id": "dc2bf8d9-854a-32c3-ba57-2e3a4a02aee7",
                                        "glosses": [
                                            "Organised on a capitalist basis."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
