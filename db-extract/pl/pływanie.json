                ],
                "senses": [
                    {
                        "sense_id": "e82e422a-65ae-3bed-94f9-2ee56624b577",
                        "entry_id": "7d43d6f4-324a-3fa5-9554-78352eefcbea",
                        "glosses": [
                            "rzecz. odczas. od pływać"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c872bea8-2c92-45a8-9530-1b53f3c4c68e",
                                "sense_id": "e82e422a-65ae-3bed-94f9-2ee56624b577",
                                "text": "Kiedy miałem sześć lat, pływanie stało się moją życiową pasją."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "0f7f86ee-83d0-3554-a070-ccad18d211eb",
                        "entry_id": "7d43d6f4-324a-3fa5-9554-78352eefcbea",
                        "glosses": [
                            "sport pływacki, zawody pływackie, zob. pływactwo"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47a8b106-5dbf-4536-9958-2f3062efdd70",
                                "sense_id": "0f7f86ee-83d0-3554-a070-ccad18d211eb",
                                "text": "Pobił swój życiowy rekord w pływaniu stylem dowolnym na 100 m."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b86edf8a-8549-4ecd-a275-5a2d853f41fb",
                        "source_entry_id": "7d43d6f4-324a-3fa5-9554-78352eefcbea",
                        "source_sense_id": "e82e422a-65ae-3bed-94f9-2ee56624b577",
                        "target_lang_word": "swimming",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "swimming",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2c8dcdf0-c7de-3542-ad6f-4b0f24d6dea3",
                                        "entry_id": "5e62b99e-6219-3fef-a434-70fe4d4418ef",
                                        "glosses": [
                                            "The act or art of sustaining and propelling the body in water."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a994ff5-87d8-40dd-8433-4f8a92682fa0",
                                                "sense_id": "2c8dcdf0-c7de-3542-ad6f-4b0f24d6dea3",
                                                "text": "He did a brilliant swim last summer."
                                            },
                                            {
                                                "example_id": "82310438-7ea0-41ce-b468-5b5a2735bd13",
                                                "sense_id": "2c8dcdf0-c7de-3542-ad6f-4b0f24d6dea3",
                                                "text": "The daring adventures of the American people in their scalings of the Alps and the Rocky mountains and in their swimmings across the Niagara rapids […]"
                                            },
                                            {
                                                "example_id": "d8975de3-20ce-454a-a18f-fc60cd1e1352",
                                                "sense_id": "2c8dcdf0-c7de-3542-ad6f-4b0f24d6dea3",
                                                "text": "Though we don’t all reach nirvana when we swim, swimming may well be that last refuge from connectivity — and, for some, the only way to find the solitary self."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "swimming",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "472e46db-8f8a-3c1e-bf19-633a40bd8a1e",
                                        "entry_id": "75573a33-00c3-3c9b-912e-dc4780ad5226",
                                        "glosses": [
                                            "The state of being dizzy or in vertigo."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "45f381de-28e9-4e67-89b5-4c357b87f264",
                                                "sense_id": "472e46db-8f8a-3c1e-bf19-633a40bd8a1e",
                                                "text": "Then I take my pipe of Tabacco, sitting close by a warme fire, the space of halfe an houre and more, vntill the giddinesse and swimming in my head be past, and the medicine also haue done it feate : then I vse to gargle my mouth with a cuppe of beere, well warmed with a toste."
                                            },
                                            {
                                                "example_id": "604115fe-9d48-403b-a2c8-d25972b33590",
                                                "sense_id": "472e46db-8f8a-3c1e-bf19-633a40bd8a1e",
                                                "text": "But when the worms are killed with the aforesaid medicines, you must driue them out without delay : for there proceedeth a vicious exhalation from them, which both destroyeth appetite, and hurteth digestion, and being lifted vpward, it causeth swimmings, and other euils."
                                            },
                                            {
                                                "example_id": "d81b4312-f00d-450c-bd26-3f562f88eeb5",
                                                "sense_id": "472e46db-8f8a-3c1e-bf19-633a40bd8a1e",
                                                "text": "[The Speedwell] doth also wonderfully helpe the memory, and to ease all turnings and swimmings, and other paines of the head, and as it is sayd helpeth women to become fruitfull, that were barren[.]"
                                            },
                                            {
                                                "example_id": "826201dc-bba4-4d83-ab15-e8dd6612cee8",
                                                "sense_id": "472e46db-8f8a-3c1e-bf19-633a40bd8a1e",
                                                "text": "Swimmings of the head and intestinal pains seemed the prelude of dissolution."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "swimming",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "26fc9e4a-3788-37e2-96a4-c5d76b1db92a",
