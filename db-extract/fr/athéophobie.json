                        "glosses": [
                            "Discrimination contre les athées."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c1b8e2f-b346-48b2-8a08-6a61935117ad",
                                "sense_id": "826d2bdd-d40a-3372-ba7f-475a19e71633",
                                "text": "Une conséquence de l’athéophobie, c’est le mythe de la supériorité morale des croyants vis-à-vis des incroyants. C'est le sucre qui enrobe la pilule empoisonnée des croyances irrationnelles, les rendant plus faciles à avaler."
                            }
                        ]
                    }
