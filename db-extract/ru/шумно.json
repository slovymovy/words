        "ru-extract.jsonl": [
            {
                "entry_id": "f850e214-afdf-3b73-a615-9cd8fc8cec62",
                "word": "шумно",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "66d607da-084c-3e71-9c85-d3bbbdc68420",
                        "entry_id": "f850e214-afdf-3b73-a615-9cd8fc8cec62",
                        "glosses": [
                            "создавая шум"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa6c2dfb-fd24-415b-8281-64f1c028b583",
                                "sense_id": "66d607da-084c-3e71-9c85-d3bbbdc68420",
                                "text": "Чарли окунулся и мгновенно выскочил, шу́мно отряхиваясь."
                            }
                        ]
                    },
                    {
                        "sense_id": "3a2d2465-45d3-320c-80b3-282cecc48384",
                        "entry_id": "f850e214-afdf-3b73-a615-9cd8fc8cec62",
                        "glosses": [
                            "то же, что оживлённо, будучи наполненным шумом"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c48f8a57-d3d8-4e5c-82cb-af09575b3528",
                                "sense_id": "3a2d2465-45d3-320c-80b3-282cecc48384",
                                "text": "Шу́мно проводили с играми и песнями долгие святочные вечера, собравшись в просторной избе или на горе с салазками и подмороженными скамейками."
                            },
                            {
                                "example_id": "9ce620cb-30f0-4b86-b986-8cede6f97910",
                                "sense_id": "3a2d2465-45d3-320c-80b3-282cecc48384",
                                "text": "За этим столом человек пять мужчин шу́мно играют в «подкидного дурака»."
                            }
                        ]
                    },
                    {
                        "sense_id": "84da7679-1497-332a-a3e1-f32264bbec46",
                        "entry_id": "f850e214-afdf-3b73-a615-9cd8fc8cec62",
                        "glosses": [
                            "перен. создавая сенсацию, привлекая внимание"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "509113de-b479-4372-9fce-b51da04169e7",
                                "sense_id": "84da7679-1497-332a-a3e1-f32264bbec46",
                                "text": "Докладчик с непроспанными глазами шу́мно восхищается этой любовью и пересказывает два блистательных сюжета из претендента."
                            },
                            {
                                "example_id": "b8f9619b-b3d8-4c7e-ae5f-55ad2ae543e1",
                                "sense_id": "84da7679-1497-332a-a3e1-f32264bbec46",
                                "text": "Этот день считают днём рождения воздушно-десантных войск и всегда шу́мно отмечают."
                            }
                        ]
                    },
                    {
                        "sense_id": "5bce9f08-efd3-3ff4-9665-eb11f42e09e3",
                        "entry_id": "f850e214-afdf-3b73-a615-9cd8fc8cec62",
                        "glosses": [
                            "предик., безл. с шумом, обилием звуков"
                        ],
                        "tags": [
                            "об окружающей обстановке"
                        ],
                        "examples": [
                            {
                                "example_id": "42326970-a6e1-4c89-a9d4-668077bd9a34",
                                "sense_id": "5bce9f08-efd3-3ff4-9665-eb11f42e09e3",
                                "text": "Было по-праздничному шу́мно, зачитывались правительственные телеграммы, был разыгран капустник."
                            }
                        ]
                    },
                    {
                        "sense_id": "a4e75d34-fe57-3f68-9a03-eaf1f93de70b",
                        "entry_id": "f850e214-afdf-3b73-a615-9cd8fc8cec62",
                        "glosses": [
                            "предик., безл."
                        ],
                        "tags": [
                            "об ощущении шума"
                        ],
                        "examples": [
                            {
                                "example_id": "0f984fc4-63a0-497a-a519-54a262633a64",
                                "sense_id": "a4e75d34-fe57-3f68-9a03-eaf1f93de70b",
                                "text": "Здесь было много людей, шу́мно, дорого, мучительно жарко, невыносимо."
                            },
                            {
                                "example_id": "6ab19caa-12d2-4dda-a76e-7a7aaa77aec1",
                                "sense_id": "a4e75d34-fe57-3f68-9a03-eaf1f93de70b",
                                "text": "Без директора, но еще труднее: шу́мно, много пешего народу, машины со всех сторон."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "94a9292d-9751-49b3-b7d0-43d01b63fb8c",
                        "source_entry_id": "f850e214-afdf-3b73-a615-9cd8fc8cec62",
                        "target_lang_word": "noisy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "noisy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "77d8f1b9-874f-319a-b762-f1271eafd4a3",
                                        "entry_id": "fcf05cd7-e945-302d-87e3-8832ba8e1f55",
                                        "glosses": [
                                            "Making a noise, especially a loud unpleasant sound"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90472896-3bd0-4ff2-92e8-ca5e201cce2b",
                                                "sense_id": "77d8f1b9-874f-319a-b762-f1271eafd4a3",
                                                "text": "the noisy crowd."
                                            },
                                            {
                                                "example_id": "6225a339-eb63-48d8-9733-59590f01ca2a",
                                                "sense_id": "77d8f1b9-874f-319a-b762-f1271eafd4a3",
                                                "text": "For obvious reasons the percussion is normally arranged along the back of the platform, whether centrally or to one side, and sometimes also in two tiers, the heavy, noisier instruments behind, and the pitched, agile instruments such as vibraphone, marimba, etc. in front. An outstanding exception, however, exists in Roberto Gerhard's Epithalamion where the composer expressly desired that the all-important kitchen department be spread out in front of the strings and hence nearest the audience."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "057a6cbe-f79d-34c7-b272-e0209464f39c",
                                        "entry_id": "fcf05cd7-e945-302d-87e3-8832ba8e1f55",
                                        "glosses": [
                                            "Full of noise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6cd673a9-c9b0-4f01-98ec-2c310b01be75",
                                                "sense_id": "057a6cbe-f79d-34c7-b272-e0209464f39c",
                                                "text": "a noisy bar"
                                            },
                                            {
                                                "example_id": "9e28cad3-e0d1-4674-bdba-2eb42ce5572d",
                                                "sense_id": "057a6cbe-f79d-34c7-b272-e0209464f39c",
                                                "text": "This market is the noisiest and swarmiest centre of noisy and swarming Florence, and I always like to pass through it on that account."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3709d33b-1e1b-3a7f-9087-d0dbdc210ac7",
                                        "entry_id": "fcf05cd7-e945-302d-87e3-8832ba8e1f55",
                                        "glosses": [
                                            "Unpleasant-looking and causing unwanted attention"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c5d5a09-0a94-46d3-9270-afb05570ae41",
                                                "sense_id": "3709d33b-1e1b-3a7f-9087-d0dbdc210ac7",
                                                "text": "noisy clothes"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f105ebd4-bf82-3ca5-bda4-470f7d9d0e78",
                                        "entry_id": "fcf05cd7-e945-302d-87e3-8832ba8e1f55",
                                        "glosses": [
                                            "Accompanied by or introducing random fluctuations that obscure the real signal or data"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e78183c2-9ab3-4696-bf08-de505874e425",
                                                "sense_id": "f105ebd4-bf82-3ca5-bda4-470f7d9d0e78",
                                                "text": "Looked at more carefully, and over a longer time period, the relationship between the economy and the incumbent’s performance is positive, but noisy. “The incumbent wins when the economy is good” is a useful, weak prior, but not an iron law, and one that historically has had many exceptions."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
