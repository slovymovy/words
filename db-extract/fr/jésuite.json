                                        "entry_id": "86f3f947-1ebc-3e1c-b5a8-b55aa1a7c5f3",
                                        "glosses": [
                                            "członek zakonu katolickiego noszącego oficjalną nazwę Towarzystwa Jezusowego"
                                        ],
                                        "tags": [],
