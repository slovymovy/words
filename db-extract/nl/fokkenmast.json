                                            "Seemannssprache"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a00a33a7-8c1e-44c9-9e41-bc007d65fe12",
                                                "sense_id": "d25d60fe-f759-33b3-90dc-72c33f220fdd",
                                                "text": "„Die Besanmasten waren längst verschwunden, die Großmasten in vierzig Fuß Höhe abgebrochen, die Fockmasten zwar mehr oder weniger intakt, aber ihrer Wanten beraubt.“"
                                            },
                                            {
                                                "example_id": "66dfed06-8458-4757-a4cd-6f64c08f8064",
                                                "sense_id": "d25d60fe-f759-33b3-90dc-72c33f220fdd",
                                                "text": "„Die Matrosen holten das Hauptmarssegel und das Großsegel ein, sodass nur noch die Segel des Fockmastes die Diligent vorantrieben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
