                "senses": [
                    {
                        "sense_id": "d9ee538a-415a-33d7-8812-67edfb326167",
                        "entry_id": "a13885ac-4825-33fd-b639-10f0c81c224c",
                        "glosses": [
                            "S’effectuer, se réaliser, passer, selon le modèle aristotélicien, de la puissance à l'acte."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c3197c6-8217-42f3-8fcc-948f2b54441b",
                                "sense_id": "d9ee538a-415a-33d7-8812-67edfb326167",
                                "text": "Un sacrement est toujours un geste, un signe ou une parole; il effectue ce qu'il signifie, non parce que le signe prescrit la valeur, mais parce qu'il signifie la valeur qui s'effectue, ou s’actue, d'elle-même."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "09835ed4-a7a2-44f4-8a34-a3161439f471",
                        "source_entry_id": "a13885ac-4825-33fd-b639-10f0c81c224c",
                        "source_sense_id": "d9ee538a-415a-33d7-8812-67edfb326167",
                        "target_lang_word": "actuate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "actuate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "acd7f0bb-3b10-3d65-8fbb-0bd69eac4d70",
                                        "entry_id": "01f2be40-d976-3ae7-8c6e-8369e7bc05c1",
                                        "glosses": [
                                            "To activate, or to put into motion; to animate."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea382ace-3959-42c1-bbb4-4bc8a1e4116b",
                                                "sense_id": "acd7f0bb-3b10-3d65-8fbb-0bd69eac4d70",
                                                "text": "Wings, which others were contriving to actuate by the perpetual motion."
                                            },
                                            {
                                                "example_id": "e80473c8-d876-46e1-a8ab-d8576e8e538f",
                                                "sense_id": "acd7f0bb-3b10-3d65-8fbb-0bd69eac4d70",
                                                "text": "I walk always with my right hand closed round the india-rubber ball which I have in my trouser pocket. The pressing of this ball actuates a detonator inside the flask I carry in my pocket. It's the principle of the pneumatic instantaneous shutter for a camera lens."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5868577a-956c-3bf2-bdfc-14162552ffb0",
                                        "entry_id": "01f2be40-d976-3ae7-8c6e-8369e7bc05c1",
                                        "glosses": [
                                            "To incite to action; to motivate."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94383d42-c4e6-4b91-8a6d-aa301725f169",
                                                "sense_id": "5868577a-956c-3bf2-bdfc-14162552ffb0",
                                                "text": "1748, David Hume, Enquiries concerning the human understanding and concerning the principles of moral, 2. ed., London, Oxford University Press, 1973. § 11.\nA man in a fit of anger, is actuated in a very different manner from one who only thinks of that emotion."
                                            },
                                            {
                                                "example_id": "46329cab-0616-47d8-8520-fe1386b3c6ac",
                                                "sense_id": "5868577a-956c-3bf2-bdfc-14162552ffb0",
                                                "text": "Men of the greatest abilities are most fired with ambition; and, on the contrary, mean and narrow minds are the least actuated by it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
