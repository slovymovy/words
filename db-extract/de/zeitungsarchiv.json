                            {
                                "example_id": "7f1a0a7c-b3ef-45dc-8696-71797438117a",
                                "sense_id": "5616fa2b-b129-317b-b2b8-f5fe63b79571",
                                "text": "„Ich hatte den Auftrag, das Zeitungsarchiv nach Informationen über den Hundezüchter und seine Tierhandlung mit dem eigenartigen Namen »Afrikanischer Zwinger« zu durchforsten.“"
                            },
                            {
                                "example_id": "7384cebe-d467-4d56-b66c-5e374d8348ba",
                                "sense_id": "5616fa2b-b129-317b-b2b8-f5fe63b79571",
                                "text": "„Dann rief sie eine Website auf, auf der man in Zeitungsarchiven stöbern konnte, und suchte nach Elisabets Vater.“"
                            }
                        ],
