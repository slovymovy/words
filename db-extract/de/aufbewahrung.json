                                                "sense_id": "b13aa181-e018-3303-a954-901171181b53",
                                                "text": "Le rangement de ses livres lui prit beaucoup de temps."
                                            },
                                            {
                                                "example_id": "b3185681-93cd-4540-a6b7-a62cfdb3cc24",
                                                "sense_id": "b13aa181-e018-3303-a954-901171181b53",
                                                "text": "In fine, le rangement doit être pris en charge par les élèves !"
                                            },
                                            {
                                                "example_id": "f73f9574-5566-4a64-852a-2de6d7fa4535",
                                                "sense_id": "b13aa181-e018-3303-a954-901171181b53",
                                                "text": "Il passe sa vie à faire des rangements."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "354657dd-ea75-337f-9a1e-50999c41aeca",
                                        "entry_id": "91f76df9-13f9-3acb-8e5c-224650e182fd",
                                        "glosses": [
                                            "Endroit où l’on peut ranger les objets. Lorsqu'il est fermé par une porte c'est un placard."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23d30342-9232-446b-9a63-04208162fea3",
                                                "sense_id": "354657dd-ea75-337f-9a1e-50999c41aeca",
                                                "text": "Je n'ai pas assez de rangement pour mettre mes affaires."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "17a8f9dd-7bea-370d-a426-32aee9cd89fb",
                                        "entry_id": "91f76df9-13f9-3acb-8e5c-224650e182fd",
                                        "glosses": [
                                            "Disposition d’éléments selon certains critères particuliers."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
