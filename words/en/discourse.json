{
    "word_family": [
        "discoursive",
        "discourser",
        "interdiscourse"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "06d30a14-fe4e-32a5-bae9-01d039e66722",
                    "sense_definition": "A formal lengthy exposition of some subject, either spoken or written.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "formal_communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The professor delivered a long <w>discourse</w> on the history of economic theory.",
                            "target_lang_translations": {
                                "ru": "Профессор выступил с длинным <w>докладом</w> по истории экономической теории."
                            }
                        },
                        {
                            "text": "His latest <w>discourse</w> on duty was published in a prestigious academic journal.",
                            "target_lang_translations": {
                                "ru": "Его последний <w>трактат</w> о долге был опубликован в престижном академическом журнале."
                            }
                        }
                    ],
                    "synonyms": [
                        "dissertation",
                        "lecture",
                        "sermon",
                        "study",
                        "treatise"
                    ],
                    "common_phrases": [
                        "academic discourse",
                        "lengthy discourse",
                        "written discourse"
                    ],
                    "target_lang_definitions": {
                        "ru": "Формальное пространное изложение какой-либо темы в устной или письменной форме."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "доклад",
                                "target_lang_sense_clarification": "публичное сообщение"
                            },
                            {
                                "target_lang_word": "лекция",
                                "target_lang_sense_clarification": "устное изложение темы"
                            },
                            {
                                "target_lang_word": "трактат",
                                "target_lang_sense_clarification": "научное сочинение"
                            },
                            {
                                "target_lang_word": "рассуждение",
                                "target_lang_sense_clarification": "логическое изложение мыслей"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4297b586-4d17-31e8-af2c-75bd2597933a",
                    "sense_definition": "An institutionalized way of thinking or a social boundary defining what can be said about a specific topic.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "sociological_concept",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The prevailing political <w>discourse</w> often ignores the needs of marginalized communities.",
                            "target_lang_translations": {
                                "ru": "Господствующий политический <w>дискурс</w> часто игнорирует нужды маргинализированных групп."
                            }
                        },
                        {
                            "text": "Criminological <w>discourse</w> in the early twentieth century was heavily influenced by biology.",
                            "target_lang_translations": {
                                "ru": "Криминологический <w>дискурс</w> в начале двадцатого века находился под сильным влиянием биологии."
                            }
                        }
                    ],
                    "synonyms": [
                        "norm",
                        "Overton window"
                    ],
                    "common_phrases": [
                        "political discourse",
                        "public discourse",
                        "social discourse"
                    ],
                    "target_lang_definitions": {
                        "ru": "Институционализированный способ мышления или социальные границы, определяющие, что может быть сказано по конкретной теме."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дискурс",
                                "target_lang_sense_clarification": "социологический термин"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "731d3a0d-8b52-30a4-91b5-af0117ba8e5b",
                    "sense_definition": "Verbal exchange or conversation between people.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "conversation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They were interrupted during their amorous <w>discourse</w> by a sudden knock at the door.",
                            "target_lang_translations": {
                                "ru": "Их любовную <w>беседу</w> прервал внезапный стук в дверь."
                            }
                        },
                        {
                            "text": "The <w>discourse</w> of the guests in the next room was loud and distracting.",
                            "target_lang_translations": {
                                "ru": "<w>Разговор</w> гостей в соседней комнате был громким и отвлекал."
                            }
                        }
                    ],
                    "synonyms": [
                        "conversation",
                        "discussion",
                        "talk",
                        "debate"
                    ],
                    "common_phrases": [
                        "amorous discourse",
                        "civil discourse"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вербальный обмен мнениями или разговор между людьми."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "беседа",
                                "target_lang_sense_clarification": "продолжительный разговор"
                            },
                            {
                                "target_lang_word": "разговор",
                                "target_lang_sense_clarification": "обмен словами"
                            },
                            {
                                "target_lang_word": "дискурс",
                                "target_lang_sense_clarification": "устар. книжн. беседа"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "263f321c-84d5-30ec-bcf3-b055b229bb00",
                    "sense_definition": "Lengthy, often heated debate over controversial subject matter, particularly within online communities or activism.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "internet_culture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The latest internet <w>discourse</w> involves a heated debate about the ethics of artificial intelligence.",
                            "target_lang_translations": {
                                "ru": "Последний интернет-<w>дискурс</w> включает в себя жаркие споры об этике искусственного интеллекта."
                            }
                        },
                        {
                            "text": "She decided to log off social media to avoid the toxic <w>discourse</w> surrounding the movie.",
                            "target_lang_translations": {
                                "ru": "Она решила выйти из соцсетей, чтобы избежать токсичных <w>обсуждений</w> вокруг фильма."
                            }
                        }
                    ],
                    "synonyms": [
                        "debate"
                    ],
                    "common_phrases": [
                        "internet discourse",
                        "online discourse"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in internet and activist spaces"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Длительные, часто ожесточенные дебаты по спорным вопросам, особенно в онлайн-сообществах или активистской среде."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дискуссия",
                                "target_lang_sense_clarification": "обсуждение спорного вопроса"
                            },
                            {
                                "target_lang_word": "дебаты",
                                "target_lang_sense_clarification": "публичный спор"
                            },
                            {
                                "target_lang_word": "дискурс",
                                "target_lang_sense_clarification": "в контексте интернет-обсуждений"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "baa9f1c4-fe06-3884-b1b8-37e148b245e9",
                    "sense_definition": "The capacity for rational expression or the exercise of reason.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "reasoning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Human beings are unique in their capacity for such large <w>discourse</w> and logic.",
                            "target_lang_translations": {
                                "ru": "Человеческие существа уникальны в своей способности к столь обширному <w>рассуждению</w> и логике."
                            }
                        },
                        {
                            "text": "The philosopher argued that <w>discourse</w> is the primary tool of natural reason.",
                            "target_lang_translations": {
                                "ru": "Философ утверждал, что <w>рассуждение</w> является основным инструментом естественного разума."
                            }
                        }
                    ],
                    "synonyms": [
                        "ratiocination"
                    ],
                    "common_phrases": [
                        "natural discourse"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "referring to the faculty of reason"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Способность к рациональному выражению мыслей или осуществление разумной деятельности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разумность",
                                "target_lang_sense_clarification": "способность мыслить"
                            },
                            {
                                "target_lang_word": "рациональность",
                                "target_lang_sense_clarification": "рассудочность"
                            },
                            {
                                "target_lang_word": "рассудок",
                                "target_lang_sense_clarification": "способность рассуждать"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "430d34bd-5e24-3d70-934b-347cfe13066e",
                    "sense_definition": "To write or speak formally and at length about a particular subject.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "formal_speech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The guest speaker <w>discoursed</w> at length on the importance of renewable energy.",
                            "target_lang_translations": {
                                "ru": "Приглашенный спикер долго <w>рассуждал</w> о важности возобновляемых источников энергии."
                            }
                        },
                        {
                            "text": "He spent the entire evening <w>discoursing</w> on his favorite philosophical theories.",
                            "target_lang_translations": {
                                "ru": "Он провел весь вечер, <w>разглагольствуя</w> о своих любимых философских теориях."
                            }
                        }
                    ],
                    "common_phrases": [
                        "discourse at length",
                        "discourse upon"
                    ],
                    "target_lang_definitions": {
                        "ru": "Формально и подробно писать или говорить на определенную тему."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рассуждать",
                                "target_lang_sense_clarification": "логически излагать мысли"
                            },
                            {
                                "target_lang_word": "разглагольствовать",
                                "target_lang_sense_clarification": "говорить пространно"
                            },
                            {
                                "target_lang_word": "излагать",
                                "target_lang_sense_clarification": "описывать тему"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "97452398-abb5-34e0-8d05-5f280f214d71",
                    "sense_definition": "To engage in discussion or conversation; to converse with others.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "conversation_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They sat in the garden for hours, <w>discoursing</w> about their shared childhood memories.",
                            "target_lang_translations": {
                                "ru": "Они часами сидели в саду, <w>беседуя</w> об общих детских воспоминаниях."
                            }
                        },
                        {
                            "text": "It is a pleasure to <w>discourse</w> with someone who shares my interests.",
                            "target_lang_translations": {
                                "ru": "Одно удовольствие <w>разговаривать</w> с тем, кто разделяет мои интересы."
                            }
                        }
                    ],
                    "synonyms": [
                        "converse",
                        "talk"
                    ],
                    "common_phrases": [
                        "discourse with"
                    ],
                    "target_lang_definitions": {
                        "ru": "Участвовать в обсуждении или беседе; разговаривать с другими."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "беседовать",
                                "target_lang_sense_clarification": "вести разговор"
                            },
                            {
                                "target_lang_word": "разговаривать",
                                "target_lang_sense_clarification": "общаться вербально"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dc0f2e95-cc35-3a1d-a7ae-e7232699f40a",
                    "sense_definition": "To produce or emit musical sounds.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "music_production",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The orchestra <w>discoursed</w> sweet music that filled the entire ballroom.",
                            "target_lang_translations": {
                                "ru": "Оркестр <w>источал</w> нежную музыку, наполнившую весь бальный зал."
                            }
                        },
                        {
                            "text": "He picked up the flute and began to <w>discourse</w> a hauntingly beautiful melody.",
                            "target_lang_translations": {
                                "ru": "Он взял флейту и начал <w>выводить</w> пугающе красивую мелодию."
                            }
                        }
                    ],
                    "common_phrases": [
                        "discourse music",
                        "discourse sweet sounds"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in literary contexts for music"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Издавать или воспроизводить музыкальные звуки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "извлекать",
                                "target_lang_sense_clarification": "о звуках музыки"
                            },
                            {
                                "target_lang_word": "издавать",
                                "target_lang_sense_clarification": "о звуках"
                            },
                            {
                                "target_lang_word": "лить",
                                "target_lang_sense_clarification": "перен. о мелодии"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}