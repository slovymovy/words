                        "glosses": [
                            "In an arbitrary manner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dfad2fe4-079a-419f-86e4-f373165a6539",
                                "sense_id": "88523780-717d-327b-ba76-91db914ae5b0",
                                "text": "The winner was chosen arbitrarily."
                            },
                            {
                                "example_id": "b4b62446-8ccc-4a99-8728-81fad66198aa",
                                "sense_id": "88523780-717d-327b-ba76-91db914ae5b0",
                                "text": "From these remarks it will be seen that I look at the term species, as one arbitrarily given for the sake of convenience to a set of individuals closely resembling each other, and that it does not essentially differ from the term variety, which is given to less distinct and more fluctuating forms. The term variety, again, in comparison with mere individual differences, is also applied arbitrarily, and for mere convenience sake."
                            },
                            {
                                "example_id": "fce9703b-6993-4779-90cc-6ae561ff4a37",
                                "sense_id": "88523780-717d-327b-ba76-91db914ae5b0",
                                "text": "Studies of the viable blood cells with phase contrast microscopy showed peculiar cells that had numerous short villi and were arbitrarily called “hairy cells.”"
                            },
                            {
                                "example_id": "da01fb60-b769-46d5-8729-c2ae5d238e63",
                                "sense_id": "88523780-717d-327b-ba76-91db914ae5b0",
                                "text": "The number or classes or potential offerers of satellite services should not be [limited] arbitrarily."
                            }
                        ]
                    },
                    {
                        "sense_id": "ba530953-a8e5-3d9f-a14e-2c55f088f641",
                        "entry_id": "2cfa2687-66aa-3193-aac0-82a335a59e3c",
