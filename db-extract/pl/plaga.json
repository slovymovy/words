                "senses": [
                    {
                        "sense_id": "f888e2ab-45a1-3136-a6bf-99a142d36710",
                        "entry_id": "4f20d9e8-be28-39ac-9180-f435ec11d612",
                        "glosses": [
                            "masowe, groźne zjawisko, szerzące się i trudne do opanowania"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "7f951449-251c-3f7a-b925-f815bf96efd8",
                        "entry_id": "4f20d9e8-be28-39ac-9180-f435ec11d612",
                        "glosses": [
                            "coś dokuczliwego i trudnego do opanowania"
                        ],
                        "tags": [
                            "metaphoric"
                        ],
                        "examples": [
                            {
                                "example_id": "2889fbd4-7f65-4a38-a5a4-a3ae594ddfb6",
                                "sense_id": "7f951449-251c-3f7a-b925-f815bf96efd8",
                                "text": "Wzrasta niestety ilość rozwodów, które (…) stają się już plagą naszych czasów"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a3f60947-2cc0-45a4-8649-7d40b25cadd5",
                        "source_entry_id": "4f20d9e8-be28-39ac-9180-f435ec11d612",
                        "source_sense_id": "f888e2ab-45a1-3136-a6bf-99a142d36710",
                        "target_lang_word": "plague",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "plague",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e62d76f1-9e1f-38b7-921c-cc64ff13d809",
                                        "entry_id": "ada3e5d0-d157-398a-9eba-3e1da097f0b4",
                                        "glosses": [
                                            "The bubonic plague, the pestilent disease caused by the virulent bacterium Yersinia pestis."
                                        ],
                                        "tags": [
                                            "capitalized",
                                            "countable",
                                            "often",
                                            "sometimes",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc68321e-fa8f-457f-9b56-b603e0060b84",
                                                "sense_id": "e62d76f1-9e1f-38b7-921c-cc64ff13d809",
                                                "text": "It was about the beginning of September, 1664, that I, among the rest of my neighbours, heard in ordinary discourse that the plague was returned again in Holland[…] It mattered not from whence it came; but all agreed it was come into Holland again."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e8ffe924-c204-357f-b89f-04041418ad82",
                                        "entry_id": "ada3e5d0-d157-398a-9eba-3e1da097f0b4",
                                        "glosses": [
                                            "An epidemic or pandemic caused by any pestilence, but specifically by the above disease."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a181740a-a7c8-4eef-861d-7f45de1d32bd",
                                                "sense_id": "e8ffe924-c204-357f-b89f-04041418ad82",
                                                "text": "Great plagues, such as the bubonic plague or smallpox or syphilis or influenza, can happen again."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94554d67-fca6-3f2d-95ee-1038f6bff35d",
                                        "entry_id": "ada3e5d0-d157-398a-9eba-3e1da097f0b4",
                                        "glosses": [
                                            "A widespread affliction, calamity, or destructive influx, especially when seen as divine retribution."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2e5ea27a-edfb-4509-8a4a-cbdbe011f98e",
                                                "sense_id": "94554d67-fca6-3f2d-95ee-1038f6bff35d",
                                                "text": "Ten Biblical plagues over Egypt, ranging from locusts to the death of the crown prince, finally forced Pharaoh to let Moses's people go."
                                            },
                                            {
                                                "example_id": "b317992a-897b-43e0-a44b-46de1b0085d3",
                                                "sense_id": "94554d67-fca6-3f2d-95ee-1038f6bff35d",
                                                "text": "A plague a both the Houſes, I am sped: / Is he gone and hath nothing?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "efbdda65-b9e9-32e6-9bfb-3889306482a8",
                                        "entry_id": "ada3e5d0-d157-398a-9eba-3e1da097f0b4",
                                        "glosses": [
                                            "A grave nuisance, whatever greatly irritates."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "46156c27-15dd-4986-966d-086005751a87",
                                                "sense_id": "efbdda65-b9e9-32e6-9bfb-3889306482a8",
                                                "text": "Bart is an utter plague; his pranks never cease."
                                            },
                                            {
                                                "example_id": "3398d5b7-de19-441b-8791-782e45878953",
                                                "sense_id": "efbdda65-b9e9-32e6-9bfb-3889306482a8",
                                                "text": "This is the first time a President has attended this dinner in six years. It's understandable- we had a horrible plague, followed by two years of COVID!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56b7678d-2196-3288-abae-18744a844b34",
                                        "entry_id": "ada3e5d0-d157-398a-9eba-3e1da097f0b4",
                                        "glosses": [
                                            "A group of common grackles."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "plague",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e216c44a-7d05-3c1c-b260-dabc67607fba",
                                        "entry_id": "af833aeb-88c8-3759-95b5-417062ed9f66",
                                        "glosses": [
                                            "To harass, pester or annoy someone persistently or incessantly."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e002d400-9d13-43b8-8c9b-3b33f473c026",
                                                "sense_id": "e216c44a-7d05-3c1c-b260-dabc67607fba",
                                                "text": "\"Moreover,\" replied Congreve, \"it was a sort of flattery to the duke. It showed that she valued the power of plaguing him more than her own fairest ornament. Flattery is the real secret by which a woman keeps her lover.\""
                                            },
                                            {
                                                "example_id": "ea3a5f4f-ab77-4fb9-bc43-35d94e49feab",
                                                "sense_id": "e216c44a-7d05-3c1c-b260-dabc67607fba",
                                                "text": "[W]hat we have here, they believe, are two members of gangs that have been plaguing Islington for more than a year. They snatch smartphones from pedestrians, then sell the items on the black market."
                                            },
                                            {
                                                "example_id": "51269603-bd76-4651-aad7-b5fd547e8d58",
                                                "sense_id": "e216c44a-7d05-3c1c-b260-dabc67607fba",
                                                "text": "Just as Mr. Clinton began a comeback with a down-home plea for forgiveness, Mrs. Clinton now seems determined to prove, perhaps to the point of overcompensation, that she will not repeat the mistakes that plagued her 2008 campaign."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d86f9f66-bf5f-343d-80fb-8254fc3e9d6f",
                                        "entry_id": "af833aeb-88c8-3759-95b5-417062ed9f66",
                                        "glosses": [
                                            "To afflict with a disease or other calamity."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d219f543-d57f-468f-8296-b7fadbbfd2a6",
                                                "sense_id": "d86f9f66-bf5f-343d-80fb-8254fc3e9d6f",
                                                "text": "Natural catastrophes plagued the colonists till they abandoned the pestilent marshland."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "acf9a825-b6fa-440b-a686-3d3707117fe8",
                        "source_entry_id": "4f20d9e8-be28-39ac-9180-f435ec11d612",
                        "source_sense_id": "f888e2ab-45a1-3136-a6bf-99a142d36710",
                        "target_lang_word": "Plage",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Plage",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e60c5dbf-301c-3ecf-b8bf-500231542ad5",
                                        "entry_id": "5f51f434-6b20-36e4-8f46-ca09bcae564e",
                                        "glosses": [
                                            "eine (übernatürliche) Bestrafung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eaae6c73-e5b4-4063-9af7-690e0c6e40a7",
                                                "sense_id": "e60c5dbf-301c-3ecf-b8bf-500231542ad5",
                                                "text": "Die Plage Gottes soll euch heimsuchen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8d324280-4540-3ac3-aba6-f58a07140734",
                                        "entry_id": "5f51f434-6b20-36e4-8f46-ca09bcae564e",
                                        "glosses": [
                                            "ein (natürlicher) Umstand im Sinne von ^([1])"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89b11b60-6847-4f59-a142-cab7b55f3808",
                                                "sense_id": "8d324280-4540-3ac3-aba6-f58a07140734",
                                                "text": "Es ist schon eine Plage mit den Mücken, überall wird man gestochen."
                                            },
                                            {
                                                "example_id": "ab342a7b-cdd0-4a1e-a9ad-4a4ef8d53e73",
                                                "sense_id": "8d324280-4540-3ac3-aba6-f58a07140734",
                                                "text": "„Die Christen führten diese Plagen auf ihre Sünden zurück.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "76bde1fa-bdb7-3f64-9a15-be76c428c1d9",
                                        "entry_id": "5f51f434-6b20-36e4-8f46-ca09bcae564e",
                                        "glosses": [
                                            "eine schwerwiegende Last"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a965ccc5-2ccc-4b34-b11f-a3fb2c7edd40",
                                                "sense_id": "76bde1fa-bdb7-3f64-9a15-be76c428c1d9",
                                                "text": "Er trägt seine Plage mit Würde."
                                            },
                                            {
                                                "example_id": "239a0cb3-dcfb-437f-82c8-ac50ab6ed570",
                                                "sense_id": "76bde1fa-bdb7-3f64-9a15-be76c428c1d9",
                                                "text": "„Das Bettlertum war schon im elften Jahrhundert in Deutschland zu einer bitteren und gefährlichen Plage angewachsen.“"
                                            },
                                            {
                                                "example_id": "36c936a8-04d9-4c7b-9dc4-652623b001ab",
                                                "sense_id": "76bde1fa-bdb7-3f64-9a15-be76c428c1d9",
                                                "text": "„Lernen gilt also nicht als Plage, sondern macht vom ägyptischen Standpunkt aus gesehen glücklich.“"
                                            },
                                            {
                                                "example_id": "9c43d6a0-bd88-4bfc-90de-da45e66730e5",
                                                "sense_id": "76bde1fa-bdb7-3f64-9a15-be76c428c1d9",
                                                "text": "„Kurz danach war sie eingeschlafen, endlich, denn eine ihrer Plagen in diesem harten Frühjahr war gewesen, daß sie im Schlaf keine Ruhe hatte finden können.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "29258179-bdc9-448e-bc2f-f8ff04239e22",
                        "source_entry_id": "4f20d9e8-be28-39ac-9180-f435ec11d612",
                        "source_sense_id": "7f951449-251c-3f7a-b925-f815bf96efd8",
                        "target_lang_word": "Plage",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Plage",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e60c5dbf-301c-3ecf-b8bf-500231542ad5",
                                        "entry_id": "5f51f434-6b20-36e4-8f46-ca09bcae564e",
                                        "glosses": [
                                            "eine (übernatürliche) Bestrafung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eaae6c73-e5b4-4063-9af7-690e0c6e40a7",
                                                "sense_id": "e60c5dbf-301c-3ecf-b8bf-500231542ad5",
                                                "text": "Die Plage Gottes soll euch heimsuchen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8d324280-4540-3ac3-aba6-f58a07140734",
                                        "entry_id": "5f51f434-6b20-36e4-8f46-ca09bcae564e",
                                        "glosses": [
                                            "ein (natürlicher) Umstand im Sinne von ^([1])"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89b11b60-6847-4f59-a142-cab7b55f3808",
                                                "sense_id": "8d324280-4540-3ac3-aba6-f58a07140734",
                                                "text": "Es ist schon eine Plage mit den Mücken, überall wird man gestochen."
                                            },
                                            {
                                                "example_id": "ab342a7b-cdd0-4a1e-a9ad-4a4ef8d53e73",
                                                "sense_id": "8d324280-4540-3ac3-aba6-f58a07140734",
                                                "text": "„Die Christen führten diese Plagen auf ihre Sünden zurück.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "76bde1fa-bdb7-3f64-9a15-be76c428c1d9",
                                        "entry_id": "5f51f434-6b20-36e4-8f46-ca09bcae564e",
                                        "glosses": [
                                            "eine schwerwiegende Last"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a965ccc5-2ccc-4b34-b11f-a3fb2c7edd40",
                                                "sense_id": "76bde1fa-bdb7-3f64-9a15-be76c428c1d9",
                                                "text": "Er trägt seine Plage mit Würde."
                                            },
                                            {
                                                "example_id": "239a0cb3-dcfb-437f-82c8-ac50ab6ed570",
                                                "sense_id": "76bde1fa-bdb7-3f64-9a15-be76c428c1d9",
                                                "text": "„Das Bettlertum war schon im elften Jahrhundert in Deutschland zu einer bitteren und gefährlichen Plage angewachsen.“"
                                            },
                                            {
                                                "example_id": "36c936a8-04d9-4c7b-9dc4-652623b001ab",
                                                "sense_id": "76bde1fa-bdb7-3f64-9a15-be76c428c1d9",
                                                "text": "„Lernen gilt also nicht als Plage, sondern macht vom ägyptischen Standpunkt aus gesehen glücklich.“"
                                            },
                                            {
                                                "example_id": "9c43d6a0-bd88-4bfc-90de-da45e66730e5",
                                                "sense_id": "76bde1fa-bdb7-3f64-9a15-be76c428c1d9",
                                                "text": "„Kurz danach war sie eingeschlafen, endlich, denn eine ihrer Plagen in diesem harten Frühjahr war gewesen, daß sie im Schlaf keine Ruhe hatte finden können.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
