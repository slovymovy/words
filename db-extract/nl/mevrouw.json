                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e2abea9b-9e73-433e-91ef-d7448bf4d111",
                                                "sense_id": "56670433-e5b1-3e21-bc68-71454bb128c2",
                                                "text": "To protest the sandwich chain’s use of azodicarbonamide in its bread, Ms. Hari posted a video of herself chewing another item in which the chemical is found: a yoga mat."
                                            }
                                        ]
                                    }
                                ]
