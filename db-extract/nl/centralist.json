                "senses": [
                    {
                        "sense_id": "7c4d995f-8f18-3c55-8543-84a2808a00ef",
                        "entry_id": "199cf364-262a-3ff7-80f8-44df18ed72e3",
                        "glosses": [
                            "iemand de werkt op de meldkamer van de hulpdiensten"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "df977212-d3b9-45f7-ae64-02262b2c4d1d",
                                "sense_id": "7c4d995f-8f18-3c55-8543-84a2808a00ef",
                                "text": "Aan de voet van de vulkaan belden ze het alarmnummer. De centralist zei dat een ambulance minstens een uur nodig had om in de buurt te komen van het gebied, dat verder niet als risicovol bekend staat."
                            },
                            {
                                "example_id": "64dfbf09-b498-4584-b261-67f26e55eae9",
                                "sense_id": "7c4d995f-8f18-3c55-8543-84a2808a00ef",
                                "text": "De beroepsvereniging voor verpleegkundigen wijt dit aan een computersysteem in de meldkamer dat 'al bij een bloedende vinger' een wagen met sirenes stuurt. V&VN wil dat de centralisten meer ruimte krijgen om door te vragen wanneer iemand 112 belt."
                            },
                            {
                                "example_id": "7b287708-c610-4271-8d8b-53c8b03318ad",
                                "sense_id": "7c4d995f-8f18-3c55-8543-84a2808a00ef",
                                "text": "Drie fietsendieven die donderdagavond in Dordrecht op de hielen werden gezeten door de politie zijn uiteindelijk opgepakt dankzij een alerte centralist."
                            }
                        ]
                    }
