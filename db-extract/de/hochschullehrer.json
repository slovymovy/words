                ],
                "senses": [
                    {
                        "sense_id": "68f70048-7ebe-3d5c-b30b-be1b7bf01380",
                        "entry_id": "87822375-24f3-3754-abc0-ddd32476f407",
                        "glosses": [
                            "Person, die an einer Hochschule unterrichtet und forscht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97d6f811-d7e5-440a-9b40-59f9c134e8be",
                                "sense_id": "68f70048-7ebe-3d5c-b30b-be1b7bf01380",
                                "text": "Letztes Jahr nahm er eine Stelle als Hochschullehrer an einer angesehenen Universität an."
                            },
                            {
                                "example_id": "ebe0dd0e-c5bd-4823-b27d-9d412691029f",
                                "sense_id": "68f70048-7ebe-3d5c-b30b-be1b7bf01380",
                                "text": "„Als Jurist und Hochschullehrer verfügte Steinberg über eine für seine Zeit beachtliche Büchersammlung.“"
                            },
                            {
                                "example_id": "f247c4eb-6197-47d2-9a75-e189b916c4e6",
                                "sense_id": "68f70048-7ebe-3d5c-b30b-be1b7bf01380",
                                "text": "„Für diese Trennung hatten sich übrigens gerade die deutschen Hochschullehrer stark gemacht.“"
                            },
                            {
                                "example_id": "a23a270c-3ad7-47db-8f9d-7a764dcb8997",
                                "sense_id": "68f70048-7ebe-3d5c-b30b-be1b7bf01380",
                                "text": "„Ich berichte im folgenden aus der Perspektive des Hochschullehrers in Erinnerung an die Vorgänge der damaligen Jahre.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
