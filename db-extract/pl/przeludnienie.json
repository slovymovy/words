                                        "entry_id": "a6d5f09b-a146-3a02-8b88-a4a27c14bb76",
                                        "glosses": [
                                            "ülkede, bölgede, evde belirli bir anda yaşayanların oluşturduğu toplam sayı, popülasyon"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2e3ef00-6aa2-42dc-aa20-7ef1ce7780a0",
                                                "sense_id": "d830fb85-f289-346c-9b75-18ba3f0f67e3",
                                                "text": "Yedi nüfuslu haneye. Üç buçuk tayın yetecek."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d65927b-8621-3e20-85e0-ce711cfe67ba",
                                        "entry_id": "a6d5f09b-a146-3a02-8b88-a4a27c14bb76",
