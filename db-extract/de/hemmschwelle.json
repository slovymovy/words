                "senses": [
                    {
                        "sense_id": "3b931142-a002-38f0-93d8-c36eed4fa5c8",
                        "entry_id": "4e55269f-b2aa-3be2-82b6-c4d06dc9dff1",
                        "glosses": [
                            "Gêne, embarras de faire ce qui pourrait déranger, être mal vu, ou aller contre la propre timidité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d2e3dc8-964f-4a61-a1a4-447963373ad2",
                                "sense_id": "3b931142-a002-38f0-93d8-c36eed4fa5c8",
                                "text": "Drogen setzen die Hemmschwelle herab, sich frei auszudrücken.",
                                "translation": "Les drogues diminuent la gêne de s'exprimer librement."
                            },
                            {
                                "example_id": "6a5394b3-41e4-4a16-a247-ad2f78fbe79e",
                                "sense_id": "3b931142-a002-38f0-93d8-c36eed4fa5c8",
                                "text": "Er überwand seine Hemmschwelle und bat um Hilfe.",
                                "translation": "Il surmonta sa gêne et demanda de l'aide."
                            }
                        ]
                    }
                ],
