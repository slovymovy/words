                "senses": [
                    {
                        "sense_id": "1a971983-e305-34f6-a554-62cdb3a0d386",
                        "entry_id": "1dfa63e4-fbc8-387e-a9e5-2e0deddf721c",
                        "glosses": [
                            "de macht krijgen of pakken van een andere partij"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f12cf04-ae0d-4783-acb3-23d683f221c8",
                                "sense_id": "1a971983-e305-34f6-a554-62cdb3a0d386",
                                "text": "Op de tonen van het Europese volkslied, Ode an die Freude, stapte Emmanuel Macron gisteravond aan het Louvre naar de tribune om zijn overwinningstoespraak te houden. De Europese leiders reageerden niet toevallig opgelucht op zijn zege. Na de Brexit en de verkiezing van Donald Trump in de Verenigde Staten bestond een reële angst voor een machtsovername door een extreemrechtse partij in Europa."
                            },
                            {
                                "example_id": "603c0615-2570-434f-ac3a-cb9f1150774c",
                                "sense_id": "1a971983-e305-34f6-a554-62cdb3a0d386",
                                "text": "Het is de eerste keer sinds de machtsovername door het leger in mei 2014, dat de inwoners van Thailand naar de stembus gingen. Ze stemden in een referendum over de grondwet die de militaire junta opstelde."
                            },
                            {
                                "example_id": "99de5a13-bf63-431f-86b9-53fdae09be03",
                                "sense_id": "1a971983-e305-34f6-a554-62cdb3a0d386",
                                "text": "En hij had hopelijk zowel geamuseerd als humoristisch verteld over de gevreesde sociaaldemocratische machtsovername in Saltsjôbaden."
                            }
                        ]
                    }
                ],
