                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cat chased three <w>mice</w> across the kitchen floor.",
                            "target_lang_translations": {
                                "ru": "Кошка погналась за тремя <w>мышами</w> по кухонному полу.",
                                "zh": "猫在厨房地板上追逐三只<w>老鼠</w>。",
                                "nl": "De kat joeg drie <w>muizen</w> over de keukenvloer.",
                                "pl": "Kot gonił trzy <w>myszy</w> po podłodze w kuchni.",
                                "de": "Die Katze jagte drei <w>Mäuse</w> über den Küchenboden.",
                                "fr": "Le chat a poursuivi trois <w>souris</w> sur le sol de la cuisine.",
                                "it": "Il gatto ha inseguito tre <w>topi</w> sul pavimento della cucina.",
                                "cs": "Kočka honila tři <w>myši</w> po podlaze v kuchyni.",
                                "tr": "Kedi, mutfak zemininde üç <w>fareyi</w> kovaladı.",
                                "es": "El gato persiguió a tres <w>ratones</w> por el suelo de la cocina."
                            }
                        },
                        {
                            "text": "Field <w>mice</w> often hide in the tall grass to avoid predators.",
                            "target_lang_translations": {
                                "ru": "Полевые <w>мыши</w> часто прячутся в высокой траве, спасаясь от хищников.",
                                "zh": "田<w>鼠</w>经常躲在高草丛中以躲避捕食者。",
                                "nl": "<w>Veldmuizen</w> verstoppen zich vaak in het hoge gras om roofdieren te vermijden.",
                                "pl": "Polne <w>myszy</w> często chowają się w wysokiej trawie, aby uniknąć drapieżników.",
                                "de": "<w>Feldmäuse</w> verstecken sich oft im hohen Gras, um Raubtieren zu entgehen.",
                                "fr": "Les <w>souris</w> des champs se cachent souvent dans les hautes herbes pour éviter les prédateurs.",
                                "it": "I <w>topi</w> di campagna si nascondono spesso nell'erba alta per evitare i predatori.",
                                "cs": "Polní <w>myši</w> se často schovávají ve vysoké trávě, aby se vyhnuly predátorům.",
                                "tr": "Tarla <w>fareleri</w>, avcılardan kaçınmak için genellikle uzun otların arasına saklanır.",
                                "es": "Los <w>ratones</w> de campo a menudo se esconden en la hierba alta para evitar a los depredadores."
                            }
                        }
