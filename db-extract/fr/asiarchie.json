                ],
                "senses": [
                    {
                        "sense_id": "c1a086fa-3439-3bf4-8b9a-cb27a8dfa74c",
                        "entry_id": "3eb915f3-44c7-3666-b8fd-56987ef1ad90",
                        "glosses": [
                            "Dignité d'asiarque."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "789a8bf0-9279-42ef-881c-d8c53f52a6d0",
                                "sense_id": "c1a086fa-3439-3bf4-8b9a-cb27a8dfa74c",
                                "text": "Ti. Claudius Aristio, princeps Ephesiorum, descendant d’une famille de magistrats attestée depuis le premier siècle av. J.-C., a effectué une brillante carrière de magistrat et d’évergète, et trois fois il a assumé l’asiarchie."
                            }
                        ]
                    },
                    {
                        "sense_id": "08e07606-24c3-3f11-85bd-e5fa9c614ee4",
                        "entry_id": "3eb915f3-44c7-3666-b8fd-56987ef1ad90",
                        "glosses": [
                            "Temps pendant lequel l’asiarque exerçait sa dignité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83ba68a2-8a2a-4822-9b23-6e486d574ee3",
                                "sense_id": "08e07606-24c3-3f11-85bd-e5fa9c614ee4",
                                "text": "… mais Iulianus II peut difficilement l’avoir exercée avant 178, qui constitue un terminus post pour l’asiarchie de son père."
                            },
                            {
                                "example_id": "f396ecc7-b504-492b-b6e9-cfde8a0bd94a",
                                "sense_id": "08e07606-24c3-3f11-85bd-e5fa9c614ee4",
                                "text": "Le monument honorifique date de l’asiarchie de Lollianus, à la fin du règne de Caracalla."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
