                                        "glosses": [
                                            "A composer, conductor, or performer of music; specifically, a person who sings and/or plays a musical instrument as a hobby, occupation, or profession."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd2e5298-b16b-447e-8410-34852befdd2d",
                                                "sense_id": "4baede47-1029-3dd6-8475-4f82afd6555f",
                                                "text": "Jenny is a talented musician, playing the cello, saxophone, piano and guitar."
                                            },
                                            {
                                                "example_id": "8cfc3887-5d48-4c31-bc32-58286de699df",
                                                "sense_id": "4baede47-1029-3dd6-8475-4f82afd6555f",
                                                "text": "He joined Little Jewford and other musicians — all with outlandish stage names, like Wichita Culpepper and Sky Cap Adams — to form Kinky Friedman and the Texas Jewboys in 1973."
                                            },
                                            {
                                                "example_id": "8c2eaf6e-625c-4d91-b0d3-216ac4cb4121",
                                                "sense_id": "4baede47-1029-3dd6-8475-4f82afd6555f",
                                                "text": "Mr. Smith, a flesh-and-blood musician, produced A.I.-generated music and played it billions of times using bots he had programmed, according to the indictment."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
