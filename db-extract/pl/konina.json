                        ]
                    },
                    {
                        "translation_id": "ed60e3b9-55ec-419f-85ce-207154fc532c",
                        "source_entry_id": "6e155812-f67b-32fa-9b8b-58fc778eab78",
                        "source_sense_id": "63058966-21c2-3f33-8f69-2b6f07217086",
                        "target_lang_word": "konina",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "konina",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "ed2415c2-7fab-362b-839c-ca6d02aa3c71",
                                        "entry_id": "1ded3d39-ed2a-3675-9f15-e1eb7994ed9b",
                                        "glosses": [
                                            "koňské maso"
                                        ],
                                        "tags": [
                                            "v obecném jazyce"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a18bd31-a568-46c6-9803-ce5c9b67d9c7",
                                                "sense_id": "ed2415c2-7fab-362b-839c-ca6d02aa3c71",
                                                "text": "Konina má vysoký obsah bílkovin a nízký obsah tuku."
                                            },
                                            {
                                                "example_id": "4a627705-013c-4dc1-bb0b-03e9ddf71f2f",
                                                "sense_id": "ed2415c2-7fab-362b-839c-ca6d02aa3c71",
                                                "text": "Ale pan Fajst se porád na mě díval, jestli si nemyslím: „Pan Fajst vepřovou zblajz, pak koupil koninu pro celou rodinu.“"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7be996c8-17cc-332e-9c24-33ba4766f7ef",
                                        "entry_id": "1ded3d39-ed2a-3675-9f15-e1eb7994ed9b",
                                        "glosses": [
                                            "koňská kůže"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74094c0c-059f-454b-a84e-058f8ffde5cf",
                                                "sense_id": "7be996c8-17cc-332e-9c24-33ba4766f7ef",
                                                "text": "Nejčastěji používané přírodní materiály s ideálními vlastnostmi pro výrobu obuvi jsou hověziny, vepřovice, koziny, koniny, teletiny nebo reptilie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d0723548-0132-32d3-a002-34d0adc7db4e",
                                        "entry_id": "1ded3d39-ed2a-3675-9f15-e1eb7994ed9b",
                                        "glosses": [
                                            "hloupost, nesmysl"
                                        ],
                                        "tags": [
                                            "expressively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6576476f-0614-42e2-ab99-0b27b10b11db",
                                                "sense_id": "d0723548-0132-32d3-a002-34d0adc7db4e",
                                                "text": "Nedělej koniny!"
                                            },
                                            {
                                                "example_id": "e4c770df-13c6-4665-a31f-35913653b5c4",
                                                "sense_id": "d0723548-0132-32d3-a002-34d0adc7db4e",
                                                "text": "„Myslí se, že existuje nějaká nezákonná stanice, která se baví tím, že v úterý a v pátek smazává hovory. Konina, že? Soukromá stanice, která by jen tak pro švandu posílala nejmíň sto kilowattů do vzduchu! Fi!“"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bf347abd-5b2e-4255-bb86-e85604f42e9b",
                        "source_entry_id": "6e155812-f67b-32fa-9b8b-58fc778eab78",
                        "source_sense_id": "63058966-21c2-3f33-8f69-2b6f07217086",
                        "target_lang_word": "Pferdefleisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pferdefleisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4f96f9f6-4d88-3132-a0f6-45f965557bb4",
                                        "entry_id": "11de20a2-693f-39ff-ac42-9bd5fa0f82a4",
                                        "glosses": [
                                            "zum Verzehr geeignetes Muskelgewebe von Pferden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b547e002-0263-4737-bbd7-cf36b04105da",
                                                "sense_id": "4f96f9f6-4d88-3132-a0f6-45f965557bb4",
                                                "text": "Rheinischer Sauerbraten wird traditionell aus Pferdefleisch gemacht."
                                            },
                                            {
                                                "example_id": "987b87ec-a577-412e-90b9-ccd4486fe688",
                                                "sense_id": "4f96f9f6-4d88-3132-a0f6-45f965557bb4",
                                                "text": "„Der europaweite Skandal um falsch ausgezeichnetes Pferdefleisch in Fertigprodukten nimmt immer größere Dimensionen an, zugleich hat eine Debatte um politische Konsequenzen begonnen.“"
                                            },
                                            {
                                                "example_id": "867b1fa2-236e-4ad9-8f25-c9d3810fc499",
                                                "sense_id": "4f96f9f6-4d88-3132-a0f6-45f965557bb4",
                                                "text": "„Wir Kinder liebten das ach so gesunde Pferdefleisch über alles.“"
                                            },
                                            {
                                                "example_id": "55d0ea21-1667-4abf-ac3e-d00f388856bc",
                                                "sense_id": "4f96f9f6-4d88-3132-a0f6-45f965557bb4",
                                                "text": "„Selbstverständlich gibt es kein Stück Pferdefleisch bei Tisch; bestes Schweinefleisch dampft in den Schüsseln, und ein riesiger Kalbsbraten steht aufgeschnitten vor uns.“"
                                            },
                                            {
                                                "example_id": "32a0815a-5084-4536-b13c-13642ee72dc8",
                                                "sense_id": "4f96f9f6-4d88-3132-a0f6-45f965557bb4",
                                                "text": "„Der andere ist ein Kenner von Pferdefleisch.“"
                                            },
                                            {
                                                "example_id": "7e14e20d-2b88-4afb-9b41-018fcd82192b",
                                                "sense_id": "4f96f9f6-4d88-3132-a0f6-45f965557bb4",
                                                "text": "„Schade um das gute Pferdefleisch, sagte Henry.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
