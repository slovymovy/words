                        {
                            "text": "They <w>appareled</w> the vessel with new sails and rigging.",
                            "target_lang_translations": {
                                "ru": "Они <w>оснастили</w> судно новыми парусами и такелажем.",
                                "de": "Sie <w>trugelten</w> das Schiff mit neuen Segeln und neuem Tauwerk <w>auf</w>."
                            }
                        }
