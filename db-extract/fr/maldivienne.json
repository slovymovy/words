                        "sense_id": "c9d705a6-bae3-33b4-856a-5bf91b734326",
                        "entry_id": "88cb63c5-61a9-3953-b0e1-dd455c0e87c6",
                        "glosses": [
                            "Habitante ou originaire des Maldives."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0083d3b9-0b83-49cc-9240-45ddeff48487",
                                "sense_id": "c9d705a6-bae3-33b4-856a-5bf91b734326",
                                "text": "Les Maldiviennes jouissent d’une liberté personnelle tout à fait exceptionnelle dans une société imprégnée par un islamisme exclusif."
                            },
                            {
                                "example_id": "a35f0d13-09f0-4b4f-a948-7043e2d93960",
                                "sense_id": "c9d705a6-bae3-33b4-856a-5bf91b734326",
                                "text": "Dans l’imprimé de Pyrard, la sélection obéit à la visée ethnologique de l’énoncé, telle la description des rites amoureux des Maldiviennes."
                            }
                        ]
                    }
