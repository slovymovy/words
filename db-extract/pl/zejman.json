                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "acb2f988-9d5b-4db2-b7ec-8369b7ce5c0e",
                        "source_entry_id": "3889a05b-6693-3f54-95b4-445d92117e4e",
                        "source_sense_id": "7381ec64-d53f-3c2a-9aff-860515d2554d",
                        "target_lang_word": "Seemann",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Seemann",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "96e69835-dbc2-3b64-8e4d-f106a57dd9ce",
                                        "entry_id": "1cb37177-506f-3a44-a678-c702c867a5bc",
                                        "glosses": [
                                            "eine in der Seeschifffahrt tätige Person"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b3cccb9-74f8-4ffa-afae-01c74dc3caec",
                                                "sense_id": "96e69835-dbc2-3b64-8e4d-f106a57dd9ce",
                                                "text": "„Ein Seemann kann einen guten Trunk hundert Meilen weit auf See erschnuppern.“"
                                            },
                                            {
                                                "example_id": "8c988a7f-42b3-4e24-af56-52181fed47f6",
                                                "sense_id": "96e69835-dbc2-3b64-8e4d-f106a57dd9ce",
                                                "text": "„Sie könnte glatt ein gut gesponnenes Seemannsgarn aus einer Hafenkneipe sein, das ein Seemann mit allen Details erzählt, damit seine Zuhörer möglichst eine weitere Runde spendieren, um auch noch den Rest zu hören.“"
                                            },
                                            {
                                                "example_id": "595bdfb8-b24e-4e01-b279-f444f064c167",
                                                "sense_id": "96e69835-dbc2-3b64-8e4d-f106a57dd9ce",
                                                "text": "„Außer diesem nahmen mehrere sehr vorzügliche Seemänner und der Geograph Beautems-Beaupré, so wie der Naturforscher La Billardière, hieran [der Expedition] Theil.“"
                                            },
                                            {
                                                "example_id": "a51dff19-db7f-4ce3-81cb-cd4376a81e2a",
                                                "sense_id": "96e69835-dbc2-3b64-8e4d-f106a57dd9ce",
                                                "text": "„Als ächte Seemänner (welche Menschenklasse vielleicht unter allen die sorgloseste ist) gaben sie ihre Bemühungen alsbald auf und trieben sich aufs Neue auf dem Lande umher.“"
                                            },
                                            {
                                                "example_id": "4959c0a4-c2df-44f1-883e-90ab153cca67",
                                                "sense_id": "96e69835-dbc2-3b64-8e4d-f106a57dd9ce",
                                                "text": "„Anlässe fur Riots gab es viele: ›Impressment Riots‹ (Antworten auf die Zwangsrekrutierung von Seemännern für die englische Marine) waren in den 40er Jahren des 18. Jahrhunderts in Boston und in den 60er Jahren am ganzen Küstenstreifen von Maine bis Virginia zu beobachten, bis die britische Marineführung von dieser Praxis schließlich abließ.“"
                                            },
                                            {
                                                "example_id": "f5f12685-c4f9-4726-9e7f-78595cb7fd09",
                                                "sense_id": "96e69835-dbc2-3b64-8e4d-f106a57dd9ce",
                                                "text": "„Zu seinen [Nathan Söderbloms] untergeordneten Pflichten gehörte auch die Seelsorge für die Seemänner in den Häfen von Calais und Dunkerque.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
