                ],
                "senses": [
                    {
                        "sense_id": "0b3c15ff-ebe8-38e5-9465-2b47574d2acc",
                        "entry_id": "3cd42518-09b4-3e22-8f29-24317224b5b7",
                        "glosses": [
                            "snel, vlug"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "377f6007-2e9d-472e-938d-a865579cdf04",
                                "sense_id": "0b3c15ff-ebe8-38e5-9465-2b47574d2acc",
                                "text": "Sorry, maar dat rappe tempo kan ik niet bijhouden."
                            },
                            {
                                "example_id": "218b0c90-3812-45f7-9eed-38d90e401183",
                                "sense_id": "0b3c15ff-ebe8-38e5-9465-2b47574d2acc",
                                "text": "Mevrouw Maillard had maar één zoon en ze had veel bewondering voor directeuren. Dus zag ze Albert al als directeur van een bank, en reken maar dat ze meteen enthousiast was en ervan overtuigd was dat hij zich 'met zijn intelligentie' rap naar de top zou opwerken."
                            },
                            {
                                "example_id": "ade172a2-33c1-4950-a1be-b9333d1999c9",
                                "sense_id": "0b3c15ff-ebe8-38e5-9465-2b47574d2acc",
                                "text": "Lufthansa haalt de superjumbo A380 weer van stal in de zomer van 2023, meldt de Duitse luchtvaartmaatschappij maandag. Als gevolg van de coronacrisis leek de rol van de superjumbo uitgespeeld, maar door het rappe herstel van de luchtvaart hebben meerdere airlines aangekondigd het grote vliegtuig weer van stal te halen."
                            }
                        ]
                    },
                    {
                        "sense_id": "c38b5f21-07f9-3453-a580-d564305815cb",
                        "entry_id": "3cd42518-09b4-3e22-8f29-24317224b5b7",
                        "glosses": [
                            "niet goed vast, niet goed sluitend"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "e9a85eb2-00b2-42ed-89aa-aa1fced74218",
                                "sense_id": "c38b5f21-07f9-3453-a580-d564305815cb",
                                "text": "Mijn linkerklomp is rap."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e8772a12-89d0-4d38-bc71-10f2e48792fa",
                        "source_entry_id": "3cd42518-09b4-3e22-8f29-24317224b5b7",
                        "source_sense_id": "0b3c15ff-ebe8-38e5-9465-2b47574d2acc",
                        "source_sense_description": "snel, vlug",
                        "target_lang_word": "rasch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rasch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e15cf530-eade-3813-8559-036ac26a5d23",
                                        "entry_id": "ff22d8fb-6d29-37a6-b93e-f009b2437d67",
                                        "glosses": [
                                            "in einem zügigen Tempo, oftmals auch mit einem schnellen Beginn und ohne viel Aufwand zu treiben oder groß nachzudenken, eventuell auch unerwartet und plötzlich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "010a0f15-4251-43f7-b1a4-167980e81ae9",
                                                "sense_id": "e15cf530-eade-3813-8559-036ac26a5d23",
                                                "text": "Zieh' Dich rasch um, der Ball beginnt bereits in einer halben Stunde."
                                            },
                                            {
                                                "example_id": "b1a2ccba-c380-45a7-acf0-c5528043e419",
                                                "sense_id": "e15cf530-eade-3813-8559-036ac26a5d23",
                                                "text": "Zur Rettung unseres Unternehmens muss eine rasche Entscheidung getroffen werden."
                                            },
                                            {
                                                "example_id": "9b44c8a7-2255-47eb-8b6f-a6567d0e7ddb",
                                                "sense_id": "e15cf530-eade-3813-8559-036ac26a5d23",
                                                "text": "Kannst du mal rasch über die Abrechnung schauen?"
                                            },
                                            {
                                                "example_id": "34a22cc1-17ce-4676-ae25-557af395cc54",
                                                "sense_id": "e15cf530-eade-3813-8559-036ac26a5d23",
                                                "text": "Er ist nur rasch einen Happen Essen gegangen."
                                            },
                                            {
                                                "example_id": "5bf886e0-d596-40d3-96d5-795776cc39bd",
                                                "sense_id": "e15cf530-eade-3813-8559-036ac26a5d23",
                                                "text": "„Eine rasche Eroberung der ganzen Stadt sei nicht in Sicht, sagte [John] Dorrian [Sprecher des US-Militärs in Bagdad].“"
                                            },
                                            {
                                                "example_id": "a52825ff-08e6-437c-93a4-560f7a9d4b6b",
                                                "sense_id": "e15cf530-eade-3813-8559-036ac26a5d23",
                                                "text": "„Der Tabakkonsum breitete sich vom 17. Jahrhundert an rasch aus, wozu auch Kriege beitrugen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
