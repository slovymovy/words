                    "sense_id": "0beb5507-de24-3c88-b4f0-6ffff62a129f",
                    "sense_definition": "Modèle de perfection suprême ou but ultime vers lequel on oriente ses aspirations.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Depuis son plus jeune âge, elle s'efforce d'atteindre son <w>idéal</w> de justice à travers son métier d'avocate."
                        },
                        {
                            "text": "Il refuse tout compromis et continue de poursuivre son <w>idéal</w> malgré les nombreuses déceptions de la vie."
                        }
                    ],
                    "synonyms": [
