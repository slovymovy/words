    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "1d4298ae-a975-384e-9c48-39e8224c153f",
                "word": "aplomb",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "992c9db8-a904-4058-ab5c-23b3e39b2d56",
                        "entry_id": "1d4298ae-a975-384e-9c48-39e8224c153f",
                        "tags": [
                            "plural"
                        ],
