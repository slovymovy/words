            {
                "entry_id": "20469c6c-c5fe-331d-834a-e4185a43d123",
                "word": "blindelings",
                "pos": "adv",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "0954c12c-3163-3ac2-af45-8ce3ee8eae29",
                        "entry_id": "20469c6c-c5fe-331d-834a-e4185a43d123",
                        "glosses": [
                            "zonder te zien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1ba200e-dcae-4956-81a0-36445ace0d0a",
                                "sense_id": "0954c12c-3163-3ac2-af45-8ce3ee8eae29",
                                "text": "Hij moest blindelings zijn weg zien te vinden in de donkere gang."
                            },
                            {
                                "example_id": "d476d5f2-b181-4e19-a8ca-f614f2728218",
                                "sense_id": "0954c12c-3163-3ac2-af45-8ce3ee8eae29",
                                "text": "Hij wist de weg zo goed dat hij blindelings de weg kon vinden."
                            },
                            {
                                "example_id": "637b8b0b-d486-4b1c-96ad-01645955e9da",
                                "sense_id": "0954c12c-3163-3ac2-af45-8ce3ee8eae29",
                                "text": "Aangezien ze dagelijks met mensen werkte, ging ze blindelings op haar gevoel af."
                            }
                        ]
                    },
                    {
                        "sense_id": "0d97f535-cb5e-3b3d-8b3e-679d4e11cf7c",
                        "entry_id": "20469c6c-c5fe-331d-834a-e4185a43d123",
                        "glosses": [
                            "in het wilde weg, zonder overleg, op goed geluk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc9274c1-ea20-4f88-8a74-9a1e27b27a1e",
                                "sense_id": "0d97f535-cb5e-3b3d-8b3e-679d4e11cf7c",
                                "text": "Hij probeerde door blindelings op een paar knoppen de drukken de lift weer in beweging te krijgen."
                            }
                        ]
                    },
                    {
                        "sense_id": "83013022-1195-3805-9808-8a3748a02544",
                        "entry_id": "20469c6c-c5fe-331d-834a-e4185a43d123",
                        "glosses": [
                            "zonder zich een eigen oordeel te vormen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66e44763-2c9d-4a49-86fb-5ac3bf1fa71f",
                                "sense_id": "83013022-1195-3805-9808-8a3748a02544",
                                "text": "Hij volgde blindelings zijn partijleider."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c8577485-d01f-4714-b10e-e5da7601af7e",
                        "source_entry_id": "20469c6c-c5fe-331d-834a-e4185a43d123",
                        "target_lang_word": "aveuglément",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aveuglément",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "54dcaabb-6c7f-39eb-9fa4-2c53ecd8dc15",
                                        "entry_id": "06748e19-7c90-310c-9cda-e91cfc90ab33",
                                        "glosses": [
                                            "En aveugle, sans réflexion ni examen."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6685280-aa02-44a4-982a-5db00ea7e68e",
                                                "sense_id": "54dcaabb-6c7f-39eb-9fa4-2c53ecd8dc15",
                                                "text": "Ô juges malheureux, qui dans nos faibles mains Tenons aveuglément le glaive et la balance."
                                            },
                                            {
                                                "example_id": "f36325df-e42a-4ddd-a6fc-e2b78f28df21",
                                                "sense_id": "54dcaabb-6c7f-39eb-9fa4-2c53ecd8dc15",
                                                "text": "Il aime aveuglément sa patrie et son père."
                                            },
                                            {
                                                "example_id": "fc785f86-4266-4d17-9556-d647b14700a5",
                                                "sense_id": "54dcaabb-6c7f-39eb-9fa4-2c53ecd8dc15",
                                                "text": "Car, puisque la fortune aveuglément dispose De tout…"
                                            },
                                            {
                                                "example_id": "d355f511-21f7-43c4-87fa-9e4dac3cde52",
                                                "sense_id": "54dcaabb-6c7f-39eb-9fa4-2c53ecd8dc15",
                                                "text": "Puis tous s’étaient engagés à paraître ne rien savoir vis-à-vis de leur chef et à lui obéir aveuglément comme par le passé."
                                            },
                                            {
                                                "example_id": "e8d84a90-0d8d-4191-bf5b-bfef41c187cc",
                                                "sense_id": "54dcaabb-6c7f-39eb-9fa4-2c53ecd8dc15",
                                                "text": "Heureusement tous les cossons n’étaient pas partis. Il y a des cépages peu hâtifs qui prudemment n’ont pas « débourré » — et, chose remarquable, ce ne sont pas ceux dits « du pays » qu'on s'obstine, aveuglément, à recommander."
                                            },
                                            {
                                                "example_id": "0368a924-9ad3-40ee-a164-f34d3a7b9525",
                                                "sense_id": "54dcaabb-6c7f-39eb-9fa4-2c53ecd8dc15",
                                                "text": "Dans une démocratie, aucun homme sensé ne veut renoncer à son droit à exercer son jugement personnel ; sachant son chef de même nature que lui, il ne peut lui faire aveuglément confiance ; par conséquent, il veut diriger lui-même."
                                            },
                                            {
                                                "example_id": "481febde-9155-4089-aacd-72213d70a7f7",
                                                "sense_id": "54dcaabb-6c7f-39eb-9fa4-2c53ecd8dc15",
                                                "text": "N’accusons pas aveuglément le naturel des habitants de l’île la plus célèbre du monde."
                                            },
                                            {
                                                "example_id": "f7f1d15b-1257-49c9-8356-afedb7f65671",
                                                "sense_id": "54dcaabb-6c7f-39eb-9fa4-2c53ecd8dc15",
                                                "text": "L’âme, de son dessein jusque-là possédée, s’attache aveuglément à sa première idée."
                                            },
                                            {
                                                "example_id": "ea4c2a9f-cbbd-4a73-a6b0-d7fc5365246b",
                                                "sense_id": "54dcaabb-6c7f-39eb-9fa4-2c53ecd8dc15",
                                                "text": "Suivons aveuglément ma triste destinée."
                                            },
                                            {
                                                "example_id": "363a9238-3a3f-4719-be44-5fca3939988a",
                                                "sense_id": "54dcaabb-6c7f-39eb-9fa4-2c53ecd8dc15",
                                                "text": "J’accepte aveuglément cette gloire avec joie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ce664c88-36c2-49d6-be22-6cbf63c77f3f",
                        "source_entry_id": "20469c6c-c5fe-331d-834a-e4185a43d123",
