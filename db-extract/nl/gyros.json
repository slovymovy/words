                        "glosses": [
                            "een traditioneel Grieks (fastfood)gerecht bestaande uit aan een grote spies gegrild varkensvlees, in reepjes gesneden en gekruid afgeleid van het Turkse döner kebab"
                        ],
                        "tags": [],
