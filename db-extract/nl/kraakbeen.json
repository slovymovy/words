                                        "glosses": [
                                            "elastisches, aber dennoch festes Gewebe des Körpers"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3486ac6-cf22-46f6-a007-f31e030f57bf",
                                                "sense_id": "2f73fbb5-42c8-30f8-9448-ce55fa3ee538",
                                                "text": "Knorpel bilden in einem Gelenk die Verbindung zwischen Knochen."
                                            },
                                            {
                                                "example_id": "6f380479-977e-430d-8ad5-e784067e136b",
                                                "sense_id": "2f73fbb5-42c8-30f8-9448-ce55fa3ee538",
                                                "text": "Die Ohrmuschel besteht aus Knorpel."
