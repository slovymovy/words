                "senses": [
                    {
                        "sense_id": "769296a2-eae6-370d-8ee0-1a77a6ef140a",
                        "entry_id": "08a305c5-6abf-3fe0-9b07-d088ecae90b6",
                        "glosses": [
                            "Verein, dessen Mitglieder sich zur gemeinsamen Ausübung des Rudersports treffen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3708a5b-8dfd-499f-afad-aaf5d0f3ff96",
                                "sense_id": "769296a2-eae6-370d-8ee0-1a77a6ef140a",
                                "text": "„Zwar ruderten beide - Jonke bei Wiking Spittal am Millstätter See, Zerbst beim Ruderverein Villach von 1881 am Ossiacher See -, aber nur Jonke kam trotz des späten Beginns mit 18 Jahren relativ schnell zum Leistungssport und also ins Heeresleistungszentrum Blattgasse nach Wien.“"
                            },
                            {
                                "example_id": "b294e41c-eb30-4a14-be4d-4d8d668a9bce",
                                "sense_id": "769296a2-eae6-370d-8ee0-1a77a6ef140a",
                                "text": "„Eigentlich hat Stephan Schad den Kampf längst verloren. Seit einer Mitgliederversammlung Ende September ist es beschlossene Sache, dass sich der Ruderverein, in dem er sich engagiert, zum Jahresende auflösen wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
