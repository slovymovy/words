                        "entry_id": "17dde207-eb57-3c31-b94e-91f9d328348f",
                        "glosses": [
                            "Langue chinoise principalement parlée dans une grande partie de la province du Zhejiang, la municipalité de Shanghai, le sud de la province du Jiangsu. Le code ISO 639-3 : wuu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f896ccc-9389-4c33-9c1d-ba847e759370",
                                "sense_id": "da473440-f375-315d-bc38-67eb25174ea4",
                                "text": "Ainsi prend forme, dans la métropole en pleine croissance, une nouvelle variété de wu : le shanghaïen."
                            }
                        ]
                    }
                ],
