            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8ce152ef-9972-3c61-a48b-61a84679b0c7",
                    "sense_definition": "jemandem oder einer Sache durch übernatürliche oder magische Kräfte Unheil wünschen oder einen Fluch auferlegen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "magischer_fluch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die böse Zauberin <w>verfluchte</w> das gesamte Schloss zu einem hundertjährigen Schlaf."
                        },
                        {
                            "text": "Im Märchen wurde der unhöfliche Prinz von einer Fee <w>verflucht</w> und musste als Biest in seinem Schloss leben."
                        }
                    ],
                    "synonyms": [
                        "verwünschen",
                        "behexen"
                    ],
                    "antonyms": [
                        "segnen"
                    ],
                    "common_phrases": [
                        "einen Ort verfluchen"
                    ]
                },
                {
                    "sense_id": "ddd2a877-7015-3468-b0ac-68c9cdc8d65c",
                    "sense_definition": "voller Ärger oder Zorn heftig über jemanden oder etwas schimpfen und Unheil herbeiwünschen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "wut_ausdruecken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Als der Motor plötzlich ausging, <w>verfluchte</w> der Fahrer seine eigene Unachtsamkeit."
                        },
                        {
                            "text": "Nach dem heftigen Streit <w>verfluchte</w> sie den Tag, an dem sie in diese Stadt gezogen war."
                        }
                    ],
                    "synonyms": [
                        "verdammen",
                        "verwünschen"
                    ],
                    "antonyms": [
                        "loben",
                        "preisen"
                    ],
                    "common_phrases": [
                        "den Tag verfluchen",
                        "sein Schicksal verfluchen"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
