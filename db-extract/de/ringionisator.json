                "senses": [
                    {
                        "sense_id": "3f428bb7-34aa-3af0-ab26-65272e770358",
                        "entry_id": "70d800a4-5aa6-3508-86fc-1a6754864bf9",
                        "glosses": [
                            "Ionisator zur Entladung von kleinsten Flächen und Bauteilen. Antistatik und Entladungsprozess an kleinsten Bauteilen im Montagevorgang"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab30f01f-947f-4709-9268-a0ac85c00b77",
                                "sense_id": "3f428bb7-34aa-3af0-ab26-65272e770358",
                                "text": "„Der HAUG Ringionisator ist ein hochwirksames Fertigungshilfsmittel, das zur Entladung und Abreinigung von Oberflächen – insbesondere von nichtleitenden Materialien – dient.“"
                            },
                            {
                                "example_id": "15dd7a64-e8c8-46f8-91d2-f82f9ad464aa",
                                "sense_id": "3f428bb7-34aa-3af0-ab26-65272e770358",
                                "text": "„Der 912 Ringionisator wird vom Meech 904 AC-Netzteil angetrieben und ist für alle Anwendungen geeignet, bei denen 360° Elektrostatik-Kontrolle erforderlich ist.“"
                            },
                            {
                                "example_id": "5d02d6e6-7cd6-427f-829b-ee477b41f1d8",
                                "sense_id": "3f428bb7-34aa-3af0-ab26-65272e770358",
                                "text": "„Nach anschließendem Positionieren des Objektträgers in der Messkammer wurde diese verschlossen, der Ringionisator eingeschaltet und für ein bis zwei Minuten der RBG1000 in Betrieb genommen und Staub in die Messkammer eingeblasen.“"
                            },
                            {
                                "example_id": "defb85c0-5ece-4ee0-9b34-4160d3bf7a61",
                                "sense_id": "3f428bb7-34aa-3af0-ab26-65272e770358",
                                "text": "„Die Spitzen dieser Ringionisatoren sind jede für sich kapazitiv mit der Hochspannung gekoppelt und somit berührungssicher.“"
                            },
                            {
                                "example_id": "8ecb981c-a088-4e7c-89f8-c4a0d5acabe5",
                                "sense_id": "3f428bb7-34aa-3af0-ab26-65272e770358",
                                "text": "„An das Netzteil können alle Ionisatoren, wie Ionisationsstäbe, Ringionisatoren etc. angeschlossen werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
