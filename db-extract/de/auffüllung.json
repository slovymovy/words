                        ],
                        "form": "die Auffüllungen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e4655195-5754-3075-b8ec-dbd490cdab99",
                        "entry_id": "a337f579-85fc-3805-8bde-fe7323bc84e7",
                        "glosses": [
                            "Vorgang/Prozess, in dem eine Substanz in einen leeren/nicht ausreichend befüllten Behälter/Hohlraum gegeben wird, bis dieser (erneut) voll oder „voll genug“ ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10695a80-6303-4d62-a40d-47b68f34a9de",
                                "sense_id": "e4655195-5754-3075-b8ec-dbd490cdab99",
                                "text": "„Eine vorherige Auffüllung des Gelenkspaltes mit Kontrastmittel und eine Plazierung der Zugangswege […] waren bisher bei keinem unserer Patienten erforderlich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "5d3390df-02e3-36ad-a927-55e858466095",
                        "entry_id": "a337f579-85fc-3805-8bde-fe7323bc84e7",
                        "glosses": [
                            "Hinzufügen einer bestimmten Menge, um gewünschten Stand (wieder) zu erreichen"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "b1be1014-acf3-4399-a73c-a4e4207efea1",
                                "sense_id": "5d3390df-02e3-36ad-a927-55e858466095",
                                "text": "„Um etwas zu verschlüsseln, das nicht genau 128 Bit umfasst, müssen wir […] eine Auffüllung (Padding) […] verwenden.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "a0399288-62bc-3d28-96bb-b2538d6bbe9a",
                        "entry_id": "a337f579-85fc-3805-8bde-fe7323bc84e7",
                        "glosses": [
                            "Angleichen einer Vertiefung an normales (Boden-)Niveau, indem Erde oder Ähnliches darin aufgehäuft wird"
                        ],
                        "tags": [
                            "Erdarbeiten",
                            "Bau",
                            "Infrastruktur"
                        ],
                        "examples": [
                            {
                                "example_id": "fa442360-b0dd-44a7-89f8-839130c2d177",
                                "sense_id": "a0399288-62bc-3d28-96bb-b2538d6bbe9a",
                                "text": "„Auf moorigen oder anmoorigen Böden dürfen grundsätzlich keine Auffüllungen durchgeführt werden.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "3a1d014c-fc51-36e2-8529-afb93ca818a2",
                        "entry_id": "a337f579-85fc-3805-8bde-fe7323bc84e7",
                        "glosses": [
                            "das, was zugegeben/eingegossen/ergänzt wird/wurde; was die Sache „voll(ständig)“/„ausreichend“/„wie gewünscht“ macht"
                        ],
                        "tags": [
                            "zu Bedeutungen [1–3]"
                        ],
                        "examples": [
                            {
                                "example_id": "9b7b57d6-e627-429e-8583-92368ab62f7e",
                                "sense_id": "3a1d014c-fc51-36e2-8529-afb93ca818a2",
                                "text": "„Unterhalb der Auffüllungen steht bis zur maximalen Endteufe von 6 m gewachsener Sand an.“"
                            }
                        ],
                        "sense_index_json": "\"4\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f0ca9b30-7e69-4197-90fd-c438d4ac5335",
                        "source_entry_id": "a337f579-85fc-3805-8bde-fe7323bc84e7",
                        "source_sense_id": "e4655195-5754-3075-b8ec-dbd490cdab99",
                        "source_sense_description": "Vorgang/Aktion des Vollmachens",
                        "target_lang_word": "remplissage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "remplissage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cd9731b7-3205-30dd-9a16-8cac97690e63",
                                        "entry_id": "0ab2ca0f-7fa8-33f7-b67b-63d26d5aace4",
                                        "glosses": [
                                            "Action de remplir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b423bfc-f800-49b9-8e72-43dedd3921d2",
                                                "sense_id": "cd9731b7-3205-30dd-9a16-8cac97690e63",
                                                "text": "Déjà, les enquêtes menées un jour de semaine de septembre 2008 au départ de la gare de Paris Lyon ont révélé des taux de remplissage des trains pouvant atteindre 105%."
                                            },
                                            {
                                                "example_id": "d0cb3869-1382-4559-8150-db551191583e",
                                                "sense_id": "cd9731b7-3205-30dd-9a16-8cac97690e63",
                                                "text": "L’évacuation et le remplissage d’une écluse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "de4cd10f-6264-32a0-bb78-cf776eaf1cb9",
                                        "entry_id": "0ab2ca0f-7fa8-33f7-b67b-63d26d5aace4",
                                        "glosses": [
                                            "Ouvrage que fait une ouvrière en fil (nommée remplisseuse), en remplissant du point, de la dentelle."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0310b4b4-05da-357d-a20d-96af1c5dcd68",
                                        "entry_id": "0ab2ca0f-7fa8-33f7-b67b-63d26d5aace4",
                                        "glosses": [
                                            "Tout ce qu’on met d’inutile pour en augmenter le développement ou, au théâtre, pour gagner du temps, au sujet d'ouvrages de l’esprit."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d125b34b-24fd-4401-92bd-93fe5a9cb2e9",
                                                "sense_id": "0310b4b4-05da-357d-a20d-96af1c5dcd68",
                                                "text": "Il y a dans ce livre des passages entiers qui ne sont que remplissage."
                                            },
                                            {
                                                "example_id": "985fd29d-1ec8-49b7-a49a-c75e0bd544db",
                                                "sense_id": "0310b4b4-05da-357d-a20d-96af1c5dcd68",
                                                "text": "Il y a trop de scènes de remplissage dans cette tragédie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e9eb6a39-b9a6-3739-a375-58bad9413368",
                                        "entry_id": "0ab2ca0f-7fa8-33f7-b67b-63d26d5aace4",
                                        "glosses": [
                                            "Opération qui consiste à insérer des nucléotides dans une région simple brin d’un ADN pour la rendre entièrement double brin."
                                        ],
                                        "tags": [
                                            "Génétique"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "03a699a3-b384-321c-a049-31bbd0f1e126",
                                        "entry_id": "0ab2ca0f-7fa8-33f7-b67b-63d26d5aace4",
                                        "glosses": [
                                            "Accumulation de matériaux divers dans les sites archéologiques, contenant ou non des vestiges archéologiques, et dont l’analyse des couches permet de découvrir l’histoire du site."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cad3d932-9021-4371-941f-0c580d6cea7e",
                                                "sense_id": "03a699a3-b384-321c-a049-31bbd0f1e126",
                                                "text": "Les remplissages de grottes résultent de divers processus de sédimentation, d’altération, de remaniement et d’érosion qui se traduisent par des accumulations complexes de différents types de dépôts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "87a67334-1392-3bbe-ba3f-606a45efda9c",
                                        "entry_id": "0ab2ca0f-7fa8-33f7-b67b-63d26d5aace4",
                                        "glosses": [
                                            "Modelage inverse de l’abattage, consistant à combler l’espace existant entre les arêtes des gradins."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f4ebf95a-e715-44a2-ae97-a021d3e432e9",
                        "source_entry_id": "a337f579-85fc-3805-8bde-fe7323bc84e7",
