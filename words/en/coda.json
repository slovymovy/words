{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1e75f266-babd-3321-9b90-405fbf4846ed",
                    "sense_definition": "A concluding musical section that brings a movement or piece to a formal close.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "music_ending",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The orchestra played a dramatic <w>coda</w> that left the audience cheering.",
                            "target_lang_translations": {
                                "zh": "管弦乐团演奏了极具戏剧性的<w>尾声</w>，引得全场观众欢呼。"
                            }
                        },
                        {
                            "text": "In the final movement, the piano leads into an energetic <w>coda</w> before the silence.",
                            "target_lang_translations": {
                                "zh": "在末乐章中，钢琴在归于沉寂前引出了一段充满活力的<w>结尾乐段</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "finale"
                    ],
                    "common_phrases": [
                        "dramatic coda",
                        "final coda"
                    ],
                    "target_lang_definitions": {
                        "zh": "（乐章或乐曲的）尾声，尾部"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "尾声",
                                "target_lang_sense_clarification": "音乐乐章或乐曲的结束部分"
                            },
                            {
                                "target_lang_word": "结尾乐段",
                                "target_lang_sense_clarification": "乐曲的正式收尾乐段"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7f1e2218-e2dc-3ebf-ae15-8d7e6943882f",
                    "sense_definition": "The concluding event, final portion, or tail end of something.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "general_conclusion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The quiet dinner served as a fitting <w>coda</w> to an eventful week of celebrations.",
                            "target_lang_translations": {
                                "zh": "这顿安静的晚餐为热热闹闹持续了一周的庆祝活动画上了恰如其分的<w>尾声</w>。"
                            }
                        },
                        {
                            "text": "His speech provided an emotional <w>coda</w> to a long and distinguished political career.",
                            "target_lang_translations": {
                                "zh": "他的演讲为自己漫长而卓越的政治生涯添上了一段深情的<w>终曲</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "finale"
                    ],
                    "common_phrases": [
                        "fitting coda"
                    ],
                    "target_lang_definitions": {
                        "zh": "（事件、时期等的）结尾，收尾部分，结局"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "尾声",
                                "target_lang_sense_clarification": "事物或事件的收尾部分"
                            },
                            {
                                "target_lang_word": "终曲",
                                "target_lang_sense_clarification": "比喻事情发展的最后阶段或结局"
                            },
                            {
                                "target_lang_word": "结尾",
                                "target_lang_sense_clarification": "终结、结束的部分"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "11194a33-8b63-3ccc-95c9-d4bec8c0a342",
                    "sense_definition": "The final consonant or group of consonants occurring after the vowel nucleus in a syllable.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "linguistics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In English phonology, words can have several consonants in the syllable <w>coda</w>.",
                            "target_lang_translations": {
                                "zh": "在英语音系学中，单词的音节<w>韵尾</w>可以包含多个辅音。"
                            }
                        },
                        {
                            "text": "The word cat contains a single consonant in its <w>coda</w>.",
                            "target_lang_translations": {
                                "zh": "单词 cat 的<w>韵尾</w>仅包含一个辅音。"
                            }
                        }
                    ],
                    "synonyms": [
                        "auslaut"
                    ],
                    "antonyms": [
                        "onset",
                        "anlaut"
                    ],
                    "common_phrases": [
                        "syllable coda"
                    ],
                    "target_lang_definitions": {
                        "zh": "（语言学中音节核后的）音节尾，韵尾辅音"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "韵尾",
                                "target_lang_sense_clarification": "音节中位于核元音后的辅音部分"
                            },
                            {
                                "target_lang_word": "音节尾",
                                "target_lang_sense_clarification": "音节的收尾辅音部分"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4da3c643-7ae9-3191-a516-e13c9a167d73",
                    "sense_definition": "The gradual return of a seismogram to baseline following an earthquake or other seismic event.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "geology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Seismologists measured the earthquake duration by analyzing the decay of the <w>coda</w>.",
                            "target_lang_translations": {
                                "zh": "地震学家通过分析<w>尾波</w>的衰减来测定地震的持续时间。"
                            }
                        },
                        {
                            "text": "Subsurface rock structures can alter the shape of a seismic <w>coda</w>.",
                            "target_lang_translations": {
                                "zh": "地下岩石构造会改变地震<w>尾波</w>的形态。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "seismic coda",
                        "coda wave"
                    ],
                    "target_lang_definitions": {
                        "zh": "（地震记录仪上的）尾波"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "尾波",
                                "target_lang_sense_clarification": "地震波记录图后部的衰减波"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5b4b2244-3460-3410-b0ae-14471547fb76",
                    "sense_definition": "A distinctive pattern or series of clicks used by sperm whales for communication.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "bioacoustics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Researchers identified distinct dialects based on the specific <w>coda</w> produced by each clan.",
                            "target_lang_translations": {
                                "zh": "研究人员根据各抹香鲸家族发出的特定<w>咔嗒声组</w>识别出了不同的方言。"
                            }
                        },
                        {
                            "text": "Each whale repeated a rhythmic <w>coda</w> while diving alongside other members of the pod.",
                            "target_lang_translations": {
                                "zh": "每头鲸鱼在与群体中其他成员一同下潜时，都会重复发出有节奏的<w>咔嗒声组</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "（抹香鲸用于交流的）咔嗒声序列，尾音模式"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "咔嗒声组",
                                "target_lang_sense_clarification": "抹香鲸通讯用的特征性规律咔嗒声序列"
                            },
                            {
                                "target_lang_word": "尾声",
                                "target_lang_sense_clarification": "鲸类生物声学中的叫声特征序列"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8d1a3ab6-47e4-331e-8977-b4359fd8f869",
                    "sense_definition": "A hearing person whose parents are deaf.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Growing up as a <w>coda</w>, she learned sign language before she could even speak English.",
                            "target_lang_translations": {
                                "zh": "作为一名<w>聋人子女</w>长大，她在学会说英语之前就先学会了手语。"
                            }
                        },
                        {
                            "text": "Many individuals who identify as a <w>coda</w> work professionally as sign language interpreters.",
                            "target_lang_translations": {
                                "zh": "许多身为<w>聋人子女</w>的人选择从事手语翻译的职业。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "聋人家庭听常子女（父母为听障人士但听力正常的人）"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "聋人子女",
                                "target_lang_sense_clarification": "父母是聋人而自身听力正常的人"
                            },
                            {
                                "target_lang_word": "听常子女",
                                "target_lang_sense_clarification": "聋哑家庭中听力健全的后代"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c137e3e9-60d0-3d86-8564-76933834fb2b",
                    "sense_definition": "Alternative spelling of <w>CODA</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The organization offers resources and community support to every young <w>coda</w> across the country.",
                            "target_lang_translations": {
                                "zh": "该机构为全国每一位年轻的<w>聋人子女</w>提供资源与社群支持。"
                            }
                        },
                        {
                            "text": "He shared his personal experiences of being a <w>coda</w> in a bilingual household.",
                            "target_lang_translations": {
                                "zh": "他分享了自己在双语家庭中作为一名<w>聋人子女</w>的亲身经历。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "alternative spelling"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "CODA（聋人家庭听常子女）的另一种书写形式"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "聋人子女",
                                "target_lang_sense_clarification": "父母为聋人的健全子女"
                            },
                            {
                                "target_lang_word": "听常子女",
                                "target_lang_sense_clarification": "聋哑家庭中听力正常的子女"
                            }
                        ]
                    }
                }
            ]
        }
    ]
