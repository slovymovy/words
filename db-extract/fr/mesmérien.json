                        "glosses": [
                            "Relatif à Mesmer ou au mesmérisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75718a60-a3a2-4c10-bd30-51824c4363a1",
                                "sense_id": "e00fd600-dacf-3c21-84ba-3991aea613d1",
                                "text": "La même explication peut sʼappliquer à lʼétablissement du rapport mesmérien avec un assistant quelconque, qui joint ses mains à celles de l’opérateur et du somnambule."
                            },
                            {
                                "example_id": "b5abee63-c10f-4cab-993b-7e5fd8bfdd2d",
                                "sense_id": "e00fd600-dacf-3c21-84ba-3991aea613d1",
                                "text": "Enfin, ces potions tartrisées, ces boissons laxatives, adjuvant indispensable de la médecine mesmérienne, que les grandes dames habituées de la place Vendôme avalaient avec une répugnance si naturelle, ne seront plus invoquées que comme un souvenir ignoble."
                            }
                        ]
                    }
