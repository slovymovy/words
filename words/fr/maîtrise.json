                    ]
                },
                {
                    "sense_id": "ae7f71b6-68c1-35f7-aad9-7019120b212b",
                    "sense_definition": "Diplôme universitaire de l'enseignement supérieur sanctionnant quatre années d'études après le baccalauréat.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "diplome",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a rédigé un mémoire brillant pour valider sa <w>maîtrise</w> de lettres modernes."
                        },
                        {
                            "text": "Après l'obtention de sa <w>maîtrise</w>, il a décidé de préparer les concours d'enseignement."
                        }
                    ],
                    "common_phrases": [
