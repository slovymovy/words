                "senses": [
                    {
                        "sense_id": "5bf29799-a4ed-3a72-9741-e1395fcad78a",
                        "entry_id": "f8ac71b6-db89-3683-beaf-62ef578897e0",
                        "glosses": [
                            "Ensemble d’activités ayant pour but de multiplier les contacts professionnels."
                        ],
                        "tags": [
                            "Travail"
                        ],
                        "examples": [
                            {
                                "example_id": "11a42e38-271a-4317-8140-cff6cd52d358",
                                "sense_id": "5bf29799-a4ed-3a72-9741-e1395fcad78a",
                                "text": "Ce colloque représentera une excellente occasion de réseautage."
                            },
                            {
                                "example_id": "cd20456c-a3f9-42b8-a6ae-8170e41b114a",
                                "sense_id": "5bf29799-a4ed-3a72-9741-e1395fcad78a",
                                "text": "Quand on se lance en affaires, le réseautage est une activité absolument essentielle."
                            },
                            {
                                "example_id": "8db1e163-77a8-4b4b-9020-8df9490cdb61",
                                "sense_id": "5bf29799-a4ed-3a72-9741-e1395fcad78a",
                                "text": "« C’est très important pour nous d’être présents puisque ça nous permet de tisser des liens avec d’autres organismes, de faire du réseautage. […] »"
                            },
                            {
                                "example_id": "903cf4e3-9f14-4f06-b90e-a836c5065ee8",
                                "sense_id": "5bf29799-a4ed-3a72-9741-e1395fcad78a",
                                "text": "Il note aussi que plusieurs participants utilisent le rendez-vous comme structure de réseautage. « Les Australiens viennent par exemple ici pour rencontrer des Européens », […]."
                            },
                            {
                                "example_id": "abcb06f4-431b-4772-bf76-6c2fb1e9c02f",
                                "sense_id": "5bf29799-a4ed-3a72-9741-e1395fcad78a",
                                "text": "Son quotidien ne semble être fait que de « business meeting », réseautages internationaux et entretiens téléphoniques en cinq langues différentes qu’elle maîtrise."
                            }
                        ]
                    }
                ],
