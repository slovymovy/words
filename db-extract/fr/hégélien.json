                                        "sense_id": "d24d6d5e-5d43-386d-80ef-775b79a84f2f",
                                        "entry_id": "8ab905c1-aff9-33bb-85a4-610ddaf67a05",
                                        "glosses": [
                                            "den Hegelianismus betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fbaeecf7-dffd-478b-baca-6fec9474c087",
                                                "sense_id": "d24d6d5e-5d43-386d-80ef-775b79a84f2f",
                                                "text": "„Im Text dieses Absatzes wurde der hegelianische Charakter des Marxismus erwähnt; ich gebe nun hier eine Liste wichtiger Ansichten, die der Marxismus vom Hegelianismus übernimmt.“"
                                            }
                                        ],
