                "senses": [
                    {
                        "sense_id": "ea4ff74f-f77a-3aab-b1fa-d567edd74ab3",
                        "entry_id": "6fafce91-7276-329d-b79c-b6fd47c65398",
                        "glosses": [
                            "transportables Gerät zur sicheren Aufbewahrung von Pflanzen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "399f77a4-6725-45cf-b981-ebaa95879315",
                                "sense_id": "ea4ff74f-f77a-3aab-b1fa-d567edd74ab3",
                                "text": "„Wann immer Bonpland eine Pflanze abschnitt, mußte er sie herumzeigen. Meist kam sie so abgegriffen zurück, daß er sie nicht mehr in die Botanisiertrommel zu legen brauchte.“"
                            },
                            {
                                "example_id": "a9684a1b-c377-4fee-9aa8-bf41b821e1ef",
                                "sense_id": "ea4ff74f-f77a-3aab-b1fa-d567edd74ab3",
                                "text": "„Optiker Cunert trug gern grüne Hüte mit einer Feder, zog mit der Botanisiertrommel hinaus in Wald und Feld und pries mit Vorliebe sein besonderes Verhältnis zur Natur vor fremden Ohren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
