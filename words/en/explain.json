{
    "word_family": [
        "explanation",
        "explanatory",
        "explainable",
        "unexplainable",
        "self-explanatory"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7fc445bf-fcee-3ceb-a916-b2f9478180b1",
                    "sense_definition": "To make something clear or easy to understand by giving more details or information.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "clarification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher will <w>explain</w> the rules of the game to the students.",
                            "target_lang_translations": {
                                "ru": "Учитель <w>объяснит</w> правила игры ученикам."
                            }
                        },
                        {
                            "text": "Can you <w>explain</w> the meaning of this word to me?",
                            "target_lang_translations": {
                                "ru": "Можете ли вы <w>объяснить</w> мне значение этого слова?"
                            }
                        }
                    ],
                    "synonyms": [
                        "clarify",
                        "describe",
                        "illustrate",
                        "elucidate"
                    ],
                    "antonyms": [
                        "obscure"
                    ],
                    "common_phrases": [
                        "explain the meaning",
                        "explain the rules",
                        "explain in detail"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделать что-либо ясным или простым для понимания, предоставляя больше деталей или информации."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "объяснять",
                                "target_lang_sense_clarification": "делать ясным, понятным"
                            },
                            {
                                "target_lang_word": "разъяснять",
                                "target_lang_sense_clarification": "давать подробные пояснения"
                            },
                            {
                                "target_lang_word": "растолковывать",
                                "target_lang_sense_clarification": "подробно и доходчиво объяснять"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e8c47708-73d2-3bb8-b353-c567eec57c92",
                    "sense_definition": "To give a reason or justification for an action, event, or situation.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "justification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He had to <w>explain</w> his absence from the meeting to his boss.",
                            "target_lang_translations": {
                                "ru": "Ему пришлось <w>объяснить</w> начальнику своё отсутствие на собрании."
                            }
                        },
                        {
                            "text": "It is difficult to <w>explain</w> the reason why the project failed.",
                            "target_lang_translations": {
                                "ru": "Трудно <w>объяснить</w> причину, по которой проект провалился."
                            }
                        }
                    ],
                    "synonyms": [
                        "justify"
                    ],
                    "common_phrases": [
                        "explain the reason",
                        "explain his absence",
                        "explain the cause"
                    ],
                    "target_lang_definitions": {
                        "ru": "Привести причину или обоснование действия, события или ситуации."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "объяснять",
                                "target_lang_sense_clarification": "находить причины или основания"
                            },
                            {
                                "target_lang_word": "оправдывать",
                                "target_lang_sense_clarification": "приводить доводы в защиту или обоснование"
                            },
                            {
                                "target_lang_word": "обосновывать",
                                "target_lang_sense_clarification": "подтверждать фактами или доводами"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "46c94989-b5f9-397b-a6a7-58bbb709752e",
                    "sense_definition": "To unfold, open up, or make visible, such as a leaf or flower bud.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "unfolding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the warmth of the spring sun, the chestnut tree began to <w>explain</w> its leaves.",
                            "target_lang_translations": {
                                "ru": "В тепле весеннего солнца каштан начал <w>раскрывать</w> свои листья."
                            }
                        },
                        {
                            "text": "The poet watched as the flowers started to <w>explain</w> their petals to the morning light.",
                            "target_lang_translations": {
                                "ru": "Поэт наблюдал, как цветы начали <w>раскрывать</w> свои лепестки навстречу утреннему свету."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in older botanical or literary contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Раскрываться, распускаться или становиться видимым (о листьях или бутонах цветов)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "раскрывать",
                                "target_lang_sense_clarification": "о листьях или лепестках (архаичное/поэтическое)"
                            },
                            {
                                "target_lang_word": "распускать",
                                "target_lang_sense_clarification": "давать почки или листья"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}