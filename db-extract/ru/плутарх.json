                "senses": [
                    {
                        "sense_id": "4c5c2a52-ac3f-3ebe-a021-7d1df186e90f",
                        "entry_id": "e7172a20-a9a1-30fd-9293-69e162d7ba8a",
                        "glosses": [
                            "древнегреческое мужское имя"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8084243d-d48a-4642-b688-63193d6be14c",
                                "sense_id": "4c5c2a52-ac3f-3ebe-a021-7d1df186e90f",
                                "text": "Одно из первых упоминаний об этом древнем культе историки обнаружили у Плутарха. Он пишет, что в 67 г. до н. э. митраизм исповедовали киликийские пираты, которые грабили корабли и прибрежные поселения по всей акватории Средиземного моря."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "232e11b1-49cf-419c-91ff-dd36ca44cc97",
                        "source_entry_id": "e7172a20-a9a1-30fd-9293-69e162d7ba8a",
                        "source_sense_id": "4c5c2a52-ac3f-3ebe-a021-7d1df186e90f",
                        "target_lang_word": "Plutarch",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Plutarch",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "79a44f3f-1999-3851-8c53-2559292d0aa4",
                                        "entry_id": "28f6399c-3b5a-3307-9f9e-cfc8f0f15412",
                                        "glosses": [
                                            "The classical historian and essayist Lucius Mestrius Plutarchus (46-120 C.E.). Often used as a byword for a biographer, to suggest that the writer is especially skilled or has other attributes associated with Plutarch."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fdb24bfc-967c-4e73-9200-c88b3984281f",
                                                "sense_id": "79a44f3f-1999-3851-8c53-2559292d0aa4",
                                                "text": "I am indebted to […]those masterly pen and ink portraits of many of our deceased ministers drawn by the lamented Professor Stoever, in the Evangelical Review, whom I designated some years ago as the Plutarch of the Lutheran Church of America."
                                            },
                                            {
                                                "example_id": "97afc3c7-91bc-4f07-9764-74965b371334",
                                                "sense_id": "79a44f3f-1999-3851-8c53-2559292d0aa4",
                                                "text": "Some day a Plutarch, without a Plutarch's prejudice will arise, and with malice toward none but charity for all, he will write the life of the statesman, Gladstone."
                                            },
                                            {
                                                "example_id": "cc901118-0bf7-4fff-a108-dca5570c2e21",
                                                "sense_id": "79a44f3f-1999-3851-8c53-2559292d0aa4",
                                                "text": "I must in candor admit that the Plutarch of piracy is sometimes more edifying than entertaining."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Plutarch",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fc013988-3f4d-3280-ad6d-e9abb76343c7",
                                        "entry_id": "944f2057-0bfb-33c2-ae0c-7e59eef6f863",
                                        "glosses": [
                                            "Any specific edition of a work by Plutarch, often specifically Plutarch's Lives"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ea66575-8f63-43a2-b879-17381a8e650e",
                                                "sense_id": "fc013988-3f4d-3280-ad6d-e9abb76343c7",
                                                "text": "Both these English Plutarchs are here, two folios printed at London in 1657, and they once belonged to William Penn, the founder of Pennsylvania, and have his book-plates."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
