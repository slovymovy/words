                                        "examples": [
                                            {
                                                "example_id": "182aa519-bf38-451f-b42a-a174e5b86913",
                                                "sense_id": "95eabf6b-f934-365e-9c50-9917592fb15b",
                                                "text": "Historycznie Tutsi byli związani z rwandyjską klasą rządzącą, ale zdarzało się, że z powodu ubóstwa Tutsi stawał się Hutu"
                                            },
                                            {
                                                "example_id": "ed2235e0-9625-407f-938e-3b89c368bbae",
                                                "sense_id": "95eabf6b-f934-365e-9c50-9917592fb15b",
                                                "text": "Wkrótce zakończyć się mają ONZ-owskie rokowania pokojowe pomiędzy rebeliantami Tutsi i rządem będącym w rękach Hutu"
