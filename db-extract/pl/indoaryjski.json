                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "indo-aryen",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9bd2e1ce-3632-3200-a0e4-125b90ebd281",
                                        "entry_id": "606eeeca-1f55-3321-bad8-8402d86bbe35",
                                        "glosses": [
                                            "Se dit des langues indo-européennes parlées en Inde."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ceb82ab-fe7a-46e9-9846-b54cbfea95b4",
                                                "sense_id": "9bd2e1ce-3632-3200-a0e4-125b90ebd281",
                                                "text": "Le sanskrit est une langue indo-aryenne."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7fc501e3-4e8d-4307-b5cc-86f8140812f5",
                        "source_entry_id": "7394c09b-50b9-366a-9d5e-1a60dffbf494",
                        "source_sense_id": "20febe01-b486-34ca-ac78-6bf21f2a3e5c",
                        "target_lang_word": "индоарийский",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "индоарийский",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "0bd81d25-0f85-3a50-9478-53d31c885e59",
                                        "entry_id": "fab22107-bfbc-3b1d-9ec9-9eb5e39c99e8",
                                        "glosses": [
                                            "лингв. относящийся к индийской ветви индоиранской группы индоевропейской языковой семьи"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "291f3b7e-819b-459d-a089-144f9004dd8c",
                                                "sense_id": "0bd81d25-0f85-3a50-9478-53d31c885e59",
                                                "text": "Следовательно, утверждения лингвистов об иранском или индоарийском происхождении этнонима русь приобретают надёжную историческую подоснову."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7104a8ab-e6e7-33bd-a3c7-4d4f489d9f5e",
                                        "entry_id": "fab22107-bfbc-3b1d-9ec9-9eb5e39c99e8",
                                        "glosses": [
                                            "этногр. связанный, соотносящийся с индоарийцами — группой народов, принадлежащих к индоевропейской (прежде всего индоиранской) языковой общности"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "302e827a-b8e0-41d0-9316-98a9136ee062",
                                                "sense_id": "7104a8ab-e6e7-33bd-a3c7-4d4f489d9f5e",
                                                "text": "Заметную часть населения Бутана составляют индоарийские народы, населяющие преимущественно районы южного пояса страны: это ассамцы (170 тыс., или 13,4%), бенгальцы (прибл. 10 тыс., или 0,8%), бихарцы (прибл. 10 тыс., или 0,8%), хиндиязычные индийцы (прибл. 10 тыс., или 0,8%) и непальцы (прибл. 10 тыс., или 0,8%)."
                                            },
                                            {
                                                "example_id": "d83e7f9e-6437-4b19-bde8-b939e625f683",
                                                "sense_id": "7104a8ab-e6e7-33bd-a3c7-4d4f489d9f5e",
                                                "text": "Похоже, это мнение разделяется Институтом истории Академии наук Республики Узбекистан, где убеждены в том, что «древнейшие тюрки» жили в Средней Азии еще до «индоарийского завоевания»."
                                            },
                                            {
                                                "example_id": "409be119-9621-4407-be8c-103aa182079d",
                                                "sense_id": "7104a8ab-e6e7-33bd-a3c7-4d4f489d9f5e",
                                                "text": "Все погребения названной группы, как правило, совершаются в крупных, центральных, семантически значимых камерах и интерпретируются как захоронения воинов-колесничих или кшатриев в индоарийской традиции."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
