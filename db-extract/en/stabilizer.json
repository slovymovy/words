                    {
                        "translation_id": "3daef704-365f-4455-add7-45b2b9c4c1cd",
                        "source_entry_id": "28c42e69-9dd8-399c-a9c9-40d9f9003d4e",
                        "source_sense_description": "substance added to something in order to stabilize it",
                        "target_lang_word": "stabilisateur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stabilisateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "061afc44-12ea-3755-a528-5c58ded7ff02",
                                        "entry_id": "d07bed8a-6d7a-3774-bda6-2df53edd6e4b",
                                        "glosses": [
                                            "Ce qui rend stable, qui stabilise, qui assure la stabilité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f8b8310-31dc-4d3e-9ff8-6a22ab23cfd0",
                                                "sense_id": "061afc44-12ea-3755-a528-5c58ded7ff02",
                                                "text": "C'est la « contrepartie » pour que l'Allemagne joue son rôle « d'ancre stabilisatrice » au sein de la zone."
                                            },
                                            {
                                                "example_id": "6c612216-8c78-4bbd-ad4e-98e005a6121a",
                                                "sense_id": "061afc44-12ea-3755-a528-5c58ded7ff02",
                                                "text": "Un élément stabilisateur."
                                            },
                                            {
                                                "example_id": "f9e6256a-f6e7-43bb-86f4-4483ec90d8f9",
                                                "sense_id": "061afc44-12ea-3755-a528-5c58ded7ff02",
                                                "text": "Elle a une influence stabilisatrice."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff87006d-0e5a-346e-8247-aa6ad4506f86",
                                        "entry_id": "d07bed8a-6d7a-3774-bda6-2df53edd6e4b",
                                        "glosses": [
                                            "Qualifie un arbre trapu, conservé sur pied pour son bon ancrage qui augmente sa résistance — et par là celle du peuplement — aux coups de vent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b506adeb-a83b-4c59-a764-8a2f90c2d2cb",
                                                "sense_id": "ff87006d-0e5a-346e-8247-aa6ad4506f86",
                                                "text": "Les tiges les plus grosses sont les plus stables, mais aussi les plus médiocres alors que souvent les tiges plus petites sont de belle qualité. On peut ainsi travailler au profit de ces dernières tout en conservant des arbres stabilisateurs, en récoltant les arbres dits intermédiaires, qui concurrencent par le bas les couronnes des beaux arbres de place, et qui dominent les régénérations et empêchent le \"sprinter\" de s’élancer dans l’étage supérieur."
                                            },
                                            {
                                                "example_id": "f57ffb1c-6827-4fee-b5a9-8ad635b738bd",
                                                "sense_id": "ff87006d-0e5a-346e-8247-aa6ad4506f86",
                                                "text": "Récolte progressive des gros bois et très gros bois, au profit des arbres codominants ou dominés les mieux conformés. Lorsque le peuplement est trop dense, abaisser graduellement le capital en s’appuyant sur les stabilisateurs."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "stabilisateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "41199dcd-9a46-328b-9623-2c4fedbf2748",
                                        "entry_id": "f8eccb0d-2abd-30b3-b6d2-3f48247a2058",
                                        "glosses": [
                                            "Dispositif qui stabilise un objet. Mécanisme, système, dispositif servant à améliorer la stabilité d'un engin, la tenue d'un véhicule, la permanence d'un fonctionnement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd1d10a7-0f17-4193-bb7a-7da99ba75ccc",
                                                "sense_id": "41199dcd-9a46-328b-9623-2c4fedbf2748",
                                                "text": "L'empennage est constitué d'un stabilisateur et d'une dérive."
                                            },
                                            {
                                                "example_id": "f7e4c731-1a01-4545-925a-750334bbb57b",
                                                "sense_id": "41199dcd-9a46-328b-9623-2c4fedbf2748",
                                                "text": "Ils sont assis sur le banc vert, devant le bâtiment du téléphérique, et leur fils roule à bicyclette à travers le rond-point. Une bicyclette avec stabilisateur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a49038c4-9d1b-3cd7-ab36-f679e09cedb3",
                                        "entry_id": "f8eccb0d-2abd-30b3-b6d2-3f48247a2058",
                                        "glosses": [
                                            "Dispositif permettant de stabiliser la prise de vue."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "62121895-4c7d-3ec4-ac5e-d7e2a541dc69",
                                        "entry_id": "f8eccb0d-2abd-30b3-b6d2-3f48247a2058",
                                        "glosses": [
                                            "Harnais doté d’un équipement servant à stabiliser la caméra."
                                        ],
                                        "tags": [
                                            "Audiovisuel"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "185de63a-9a7f-4df6-a224-a582a8102c62",
                                                "sense_id": "62121895-4c7d-3ec4-ac5e-d7e2a541dc69",
                                                "text": "Vous serez surpris qu'un stabilisateur de caméra puisse vous donner tant de performance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f72eeca3-2166-38c6-8e67-53dc2c156b52",
                                        "entry_id": "f8eccb0d-2abd-30b3-b6d2-3f48247a2058",
                                        "glosses": [
                                            "Pour une loi de composition externe d’un groupe, ensemble des éléments du groupe qui laissent un point donné fixe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d894ad12-c6a7-4245-a04b-d6fad8209f39",
                                                "sense_id": "f72eeca3-2166-38c6-8e67-53dc2c156b52",
                                                "text": "La preuve du théorème de Lagrange consiste à réaliser tout sous-groupe H d'un groupe fini G comme un stabilisateur pour une action de G."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ee580a3-3fad-3e77-8faa-8b4b098d248b",
                                        "entry_id": "f8eccb0d-2abd-30b3-b6d2-3f48247a2058",
                                        "glosses": [
                                            "Arbre stabilisateur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2693e80c-b8d4-4d9e-9dcc-1945750110b5",
                                                "sense_id": "1ee580a3-3fad-3e77-8faa-8b4b098d248b",
                                                "text": "Chaque arbre, ou chaque cépée, est un cas particulier dont il convient de valoriser les potentialités (producteur d’argent, éducateur, stabilisateur…), d’améliorer la vitalité."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
