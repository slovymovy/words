            {
                "entry_id": "2c3c81ce-4934-35f7-aa68-6be4710b56ee",
                "word": "centralisme",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "37eeb2c8-e828-488a-9b26-c3d0fcf498fd",
                        "entry_id": "2c3c81ce-4934-35f7-aa68-6be4710b56ee",
                        "tags": [
                            "plural"
                        ],
                        "form": "centralismes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "cba4a217-fa8c-3c1d-8a5a-276afe9c4405",
                        "entry_id": "2c3c81ce-4934-35f7-aa68-6be4710b56ee",
                        "glosses": [
                            "Doctrine qui prône la prééminence du centre sur la périphérie."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "1ffd478e-8d10-366f-995d-c94dbc8237c3",
                        "entry_id": "2c3c81ce-4934-35f7-aa68-6be4710b56ee",
                        "glosses": [
                            "Forme d’organisation d’un État où les décisions sont prises au centre (capitale, assemblée, parlement) d’un pays dont les sous-ensembles (régions, départements, provinces, localités, etc.) sont dépendantes financièrement et décisionnellement du niveau national et qui sont quant à eux de simples relais ascendants de l’information (ou de votes) d’une organisation générale descendante."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "16aae819-369d-4abf-814d-76fe4b48965e",
                                "sense_id": "1ffd478e-8d10-366f-995d-c94dbc8237c3",
                                "text": "Le centralisme représente ainsi le mal absolu à tel point qu'en 1939, Gonzague de Reynold place sur le même plan nazisme et Révolution française, dont les Anschluss avaient été l'annexion de l’évêché de Bâle, de la Valteline et de Genève."
                            },
                            {
                                "example_id": "b17432ea-d7f7-4f8b-8abd-1f061dfd2260",
                                "sense_id": "1ffd478e-8d10-366f-995d-c94dbc8237c3",
                                "text": "Ils défendent de nouvelles pratiques de l’urbanisme, s’appuyant sur des principes de travail collectif, de pluridisciplinarité des équipes et de participation des habitants, sur fond de dénonciation du centralisme bureaucratique et technocratique, ou encore des méfaits de l’économie libérale."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "134e5b7b-31fe-47a5-b8ef-13cb003fd2b9",
                        "source_entry_id": "2c3c81ce-4934-35f7-aa68-6be4710b56ee",
                        "target_lang_word": "Zentralismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zentralismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d5c17ca3-e471-30d4-8947-8e258d013be2",
                                        "entry_id": "5c4bb7b9-46de-3357-b232-2a1fa12bb26c",
                                        "glosses": [
                                            "politisches System, bei dem alle wichtigen Entscheidungen in einem Zentrum, in der Regel in der Hauptstadt, gefällt werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20925148-8930-4372-9b8a-bd8e0504b7b7",
                                                "sense_id": "d5c17ca3-e471-30d4-8947-8e258d013be2",
                                                "text": "„Den Föderalismus hatte er durch Zentralismus ersetzt, mit einem mächtigen Präsidenten an der Spitze.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
