                "senses": [
                    {
                        "sense_id": "6f846d11-c7be-3f74-a873-86dc18ebf918",
                        "entry_id": "cb427cc1-ec77-3a07-9e87-e1f91127454b",
                        "glosses": [
                            "поступить, наняться на работу; принять на себя какие-либо обязанности"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "975c0d84-ebae-44af-ab93-5d8dac9fc702",
                                "sense_id": "6f846d11-c7be-3f74-a873-86dc18ebf918",
                                "text": "С горя тот завербовался на корабль, уходивший в дальнее плавание."
                            },
                            {
                                "example_id": "b2a8d00f-c30e-4b8f-b93a-d31cad2cd940",
                                "sense_id": "6f846d11-c7be-3f74-a873-86dc18ebf918",
                                "text": "Я могу на Север завербоваться."
                            },
                            {
                                "example_id": "3f9050aa-7548-4021-a8ad-0dcc3cf2e7a4",
                                "sense_id": "6f846d11-c7be-3f74-a873-86dc18ebf918",
                                "text": "Лишь десятая часть пленных завербовалась во власовские части, в полицейские подразделения, в рабочие батальоны, в отряды «добровольных» помощников вермахта."
                            },
                            {
                                "example_id": "917335bf-b6d0-40cc-9c84-0c9878b1f253",
                                "sense_id": "6f846d11-c7be-3f74-a873-86dc18ebf918",
                                "text": "Я, может, пойду и завербуюсь в армию!"
                            }
                        ]
                    }
                ],
