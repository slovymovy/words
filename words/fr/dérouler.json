                    "frequency": "High",
                    "semantic_group_id": "etendre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a fallu <w>dérouler</w> le tapis rouge avant l'arrivée officielle du président."
                        },
                        {
                            "text": "Les ouvriers doivent <w>dérouler</w> un câble électrique le long du couloir."
