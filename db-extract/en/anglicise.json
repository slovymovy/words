                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "a2fc4e26-9fe1-48c8-b4a4-2ff09ccf5a78",
                                "sense_id": "c8483664-868d-3596-ab06-d50791fb2d96",
                                "text": "Someone who is translating into English a German novel, the hero of which is named Heinrich, will leave the name as it is; he will not Anglicize it into Henry."
                            },
                            {
                                "example_id": "a307d8be-58d6-4c63-8d47-6e7b546b38ca",
                                "sense_id": "c8483664-868d-3596-ab06-d50791fb2d96",
                                "text": "Other users of non-anglo descent have also alleged Lensa whitened their skin and anglicised their features, a common complaint of image-editing software on platforms like TikTok."
                            }
                        ]
                    },
