                "senses": [
                    {
                        "sense_id": "3584ea6d-6c9b-3e11-983c-f59823dcc560",
                        "entry_id": "6bf2a81a-6dc4-30a7-9d52-bb5d63c59294",
                        "glosses": [
                            "зоол. крупная змея семейства удавов, обитающая в тропической Америке"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28488e87-c419-4ae3-9653-e5f759604b41",
                                "sense_id": "3584ea6d-6c9b-3e11-983c-f59823dcc560",
                                "text": "Он обовьёт, как боа констриктор, ошеломлённого врага своего, и кости административного произвола жалобно захрустят на его могучих зубах."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3a90c70c-1eb5-4302-b92a-debe4b524838",
                        "source_entry_id": "6bf2a81a-6dc4-30a7-9d52-bb5d63c59294",
                        "source_sense_id": "3584ea6d-6c9b-3e11-983c-f59823dcc560",
                        "target_lang_word": "boa",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "boa",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "58c37591-b998-3f2a-835c-cfd145d9d934",
                                        "entry_id": "f8aae147-d142-3dad-97f9-a0f5a7070987",
                                        "glosses": [
                                            "Any of a group of large American snakes, of the genus Boa, subfamily Boinae, or family Boidae, including the boa constrictor and the emperor boa of Mexico."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2465163f-bf54-3d30-b98c-c82050fccc4d",
                                        "entry_id": "f8aae147-d142-3dad-97f9-a0f5a7070987",
                                        "glosses": [
                                            "A type of long scarf; typically made from synthetic or real feathers (or occasionally fur), and usually worn by being draped across the shoulders with the ends hanging low, sometimes also with a loop around the neck."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a53a5f35-edfe-4ec1-b76b-a81efdd0a16a",
                                                "sense_id": "2465163f-bf54-3d30-b98c-c82050fccc4d",
                                                "text": "Do not take up your boa as if it were the rope with which you meant to hang yourself; nor wrap your shawl round you as if it were your shroud."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e8d9602e-4946-4c3b-9998-5741b4213d74",
                        "source_entry_id": "6bf2a81a-6dc4-30a7-9d52-bb5d63c59294",
                        "source_sense_id": "3584ea6d-6c9b-3e11-983c-f59823dcc560",
