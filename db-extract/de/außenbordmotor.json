                "senses": [
                    {
                        "sense_id": "a9876709-abe9-3ba3-93ac-fcc0a9f61875",
                        "entry_id": "7123ce40-b15e-3a55-bc74-9c6456bb09dd",
                        "glosses": [
                            "„Schiffsmotor, bei dem Motor, Kraftübertragung, Getriebe und Propeller in einer konstruktiven Einheit verbunden sind“, der mit Handgriffen einfach vom Boot angebaut und abgebaut werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c04f84f1-64b2-4107-9cbd-6a2f095b1f6a",
                                "sense_id": "a9876709-abe9-3ba3-93ac-fcc0a9f61875",
                                "text": "„Trotzdem überredet sie ihr Mann, eine kleine Tour über die Elbe im Beiboot mit Außenbordmotor zu machen.“"
                            },
                            {
                                "example_id": "2bf60442-5db5-4f54-9ba7-798b0540e364",
                                "sense_id": "a9876709-abe9-3ba3-93ac-fcc0a9f61875",
                                "text": "„Sie hörten einen Außenbordmotor im Creek.“"
                            },
                            {
                                "example_id": "9da5387c-4210-424a-b77a-2853f53e1c77",
                                "sense_id": "a9876709-abe9-3ba3-93ac-fcc0a9f61875",
                                "text": "„Er zeigte auf ein solides Gummiboot mit Außenbordmotor.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
