                                    {
                                        "sense_id": "d8ea4315-7b11-335e-8e22-f790d63499e5",
                                        "entry_id": "83c14997-7c6d-37df-a7c3-cac7e87702c6",
                                        "glosses": [
                                            "weibliche Person, die unter Zwang ihre Heimat verlassen musste"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba8aa751-8ee1-4220-9d2e-5b518789e26f",
                                                "sense_id": "d8ea4315-7b11-335e-8e22-f790d63499e5",
                                                "text": "Als Vertriebene hatte sie es zunächst nicht leicht, einen Arbeitsplatz zu finden."
                                            },
                                            {
                                                "example_id": "8f12c830-1f8a-458f-af2b-2f9a8c4bdae7",
                                                "sense_id": "d8ea4315-7b11-335e-8e22-f790d63499e5",
                                                "text": "Im neuen Deutschland mussten nach dem letzten Krieg viele Millionen Vertriebene aus den östlichen Vertreibungsgebieten aufgenommen und integriert werden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
