                                "example_id": "4e42246f-dbc6-44aa-a314-bd09edfd064b",
                                "sense_id": "367f9eb4-fc06-3172-b169-04be922ccb1b",
                                "text": "The commandos abseiled down from the helicopter and stormed the enemy location.",
                                "translation": "Die Kommandos seilten sich vom Hubschrauber ab und stürmten die feindliche Stellung."
                            }
                        ],
                        "sense_index_json": "\"1\""
