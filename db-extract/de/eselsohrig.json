                ],
                "senses": [
                    {
                        "sense_id": "7fde055f-259f-3cec-a1fa-fd3555e79545",
                        "entry_id": "6654458b-82d2-3e8c-afaf-ad69f55d2aff",
                        "glosses": [
                            "viele abgeknickte Seiten habend, sehr oft durchgeblättert worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e2145a31-0aaf-49d3-badf-84f9afed3005",
                                "sense_id": "7fde055f-259f-3cec-a1fa-fd3555e79545",
                                "text": "„Sie hatte schon immer gern in seinen Büchern geschmökert, vor allem in denen, die er während des Krieges auf seinem Zerstörer dabeihatte: Shakespeares Gesammelte Werke, Macchiavellis Fürst, Freuds Traumdeutung, ein eselsohriges Exemplar des Ulysses von James Joyce und die Gesamtausgabe der Gedichte von T. S. Eliot.“"
                            },
                            {
                                "example_id": "a91cec7b-4e80-4538-82c4-2f698a217201",
                                "sense_id": "7fde055f-259f-3cec-a1fa-fd3555e79545",
                                "text": "„Suttree bewunderte sie mit ihren feurigen Augen und den eselsohrigen Bibeln, Gottes Marktschreier, hinausgezogen in die Welt wie einst die Propheten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
