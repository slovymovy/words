                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4732713a-72a0-432a-a7c8-71417c58ead4",
                        "source_entry_id": "4f6bad3a-9bef-3df0-a110-eb7dbdf161dd",
                        "target_lang_word": "cosmonaute",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cosmonaute",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1df82912-2c77-3438-a465-0e9d2b5c7fd0",
                                        "entry_id": "647532c5-9ce7-39d0-90dc-1ec3da7909f1",
                                        "glosses": [
                                            "Membre de l’équipage d'une fusée ou d’un engin spatial soviétique ou russe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0a5c015-5e20-4143-ba8a-7f5ab8451616",
                                                "sense_id": "1df82912-2c77-3438-a465-0e9d2b5c7fd0",
                                                "text": "Ceci prit une forme particulièrement concrète, le 12 avril 1961, avec le vol de Iouri Gagarine au cours duquel le peuple russe put entendre le premier cosmonaute chanter dans sa nacelle une mélodie écrite par Chostakovitch sur une poésie de Dolmatovsky, La patrie écoute."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9990a2c9-4d15-3815-80b0-a868af4d8b0e",
                                        "entry_id": "647532c5-9ce7-39d0-90dc-1ec3da7909f1",
                                        "glosses": [
                                            "Spationaute."
                                        ],
                                        "tags": [
                                            "Plus généralement"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e1338715-9adf-4e8e-a5cf-fa8df874d848",
                                                "sense_id": "9990a2c9-4d15-3815-80b0-a868af4d8b0e",
                                                "text": "Jinn connaissait bien d’autres tours, considérés comme le comble de l’art par les cosmonautes à voile."
                                            }
                                        ]
                                    }
                                ]
                            },
