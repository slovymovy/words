                        "entry_id": "400ef0a5-0955-32f9-886b-d651125b2f84",
                        "glosses": [
                            "Petit treuil d’une charrette sur lequel s’enroule une corde servant à assujettir le chargement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12a69df7-2cc5-4484-87c6-afb44a3b0a72",
                                "sense_id": "0bb8f48e-90e1-3bc2-87c9-309a92b96891",
                                "text": "Cette corde solide était tendue au moyen d’un treuil à tavelle, le « pouliot », qui se trouvait à l’arrière de la voiture."
                            },
                            {
                                "example_id": "9acb3ea4-84a1-4fb3-b2b5-5d7b671b2f77",
                                "sense_id": "0bb8f48e-90e1-3bc2-87c9-309a92b96891",
                                "text": "Le chargement terminé, une corde enroulée autour d’un treuil serré au pouliot maintenait le foin."
                            }
                        ]
                    },
                    {
                        "sense_id": "e2b9708b-9ffe-3aa1-837e-e73bb6d8b0ad",
                        "entry_id": "400ef0a5-0955-32f9-886b-d651125b2f84",
                        "glosses": [
                            "Rouet de poulie fixé sur le plat-bord d'un bateau."
                        ],
