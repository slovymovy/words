                "senses": [
                    {
                        "sense_id": "36bdeb60-83ec-33ac-aed4-51d68eac9f28",
                        "entry_id": "71b7d647-3bf1-38ef-9eb2-42f3daa4f851",
                        "glosses": [
                            "das Für-gut-Halten, ein freies Urteil (egal ob Geschmacksurteil oder sachlich begründet)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "498a4a9c-a287-40fc-b701-ffb36aef2462",
                                "sense_id": "36bdeb60-83ec-33ac-aed4-51d68eac9f28",
                                "text": "Das Wort wird nur noch in der folgenden Redewendung gebraucht: nach Gutdünken."
                            },
                            {
                                "example_id": "e9fb2b27-32e9-4e56-a1bc-260e0ab44d8b",
                                "sense_id": "36bdeb60-83ec-33ac-aed4-51d68eac9f28",
                                "text": "„Diese schüttelten den Kopf über den ungewöhnlichen Vorschlag, überließen jedoch ihrem Häuptling, nach Gutdünken zu handeln.“"
                            },
                            {
                                "example_id": "a7946718-71fb-46c3-b6ae-49d676d31a1b",
                                "sense_id": "36bdeb60-83ec-33ac-aed4-51d68eac9f28",
                                "text": "„Kaum jemand hatte erwartet, dass diese Regierung fünf Jahre durchhalten würde, da Mugabes Machtfülle so groß war, dass er nach Gutdünken zu einem ihm genehmen Zeitpunkt das Parlament hätte auflösen und Neuwahlen ausschreiben können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a4c7ed91-533a-4b45-9b41-6409b0215d16",
                        "source_entry_id": "71b7d647-3bf1-38ef-9eb2-42f3daa4f851",
                        "source_sense_id": "36bdeb60-83ec-33ac-aed4-51d68eac9f28",
                        "source_sense_description": "das Für-gut-Halten, ein freies Urteil (egal ob Geschmacksurteil oder sachlich begründet)",
                        "target_lang_word": "discretion",
                        "target_lang_code": "en",
