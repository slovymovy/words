                "senses": [
                    {
                        "sense_id": "1471089b-e6ff-3ec1-9346-4163a45dae79",
                        "entry_id": "b87a5702-0cc3-371c-9ce1-dcf31aaec087",
                        "glosses": [
                            "Meestal gebruikt voor diabetes mellitus: een stofwisselingsziekte waarbij het lichaam geen of te weinig insuline produceert en de patiënt dus zelf de hoeveelheid glucose in zijn/haar bloed moet controleren oftewel regelen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "387fad4c-dec6-4481-9039-9d6901aa9902",
                                "sense_id": "1471089b-e6ff-3ec1-9346-4163a45dae79",
                                "text": "De WHO spreekt over een “diabetesepidemie met grote gezondheids- en sociaal-economische gevolgen”, met name in ontwikkelingslanden. Alleen in 2012 vielen volgens de WHO al 1,5 miljoen doden als gevolg van diabetes."
                            }
                        ]
                    },
                    {
                        "sense_id": "9c002deb-a131-355b-87ea-7e5ad2574975",
                        "entry_id": "b87a5702-0cc3-371c-9ce1-dcf31aaec087",
                        "glosses": [
                            "diabetes insipidus: een aandoening waarbij door een tekort van of ongevoeligheid voor het antidiuretisch hormoon een te grote urineproductie ontstaat."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e2c31ccf-1426-4ee1-a28c-054a6d8af4f1",
                                "sense_id": "9c002deb-a131-355b-87ea-7e5ad2574975",
                                "text": "Vroeger, als een patiënt grote hoeveelheden urine ging produceren, moest de dokter zijn vinger in de urine steken en proeven. Was de urine zoet, dan had men suikerziekte (diabetes mellitus is zoete vloed). Had de urine geen zoete smaak, dan sprak men van diabetes insipidus (is smakeloze vloed) en dan was er wat mis met de nieren of de hersenen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "414c23bb-b8aa-4392-a0eb-24e464dd1009",
                        "source_entry_id": "b87a5702-0cc3-371c-9ce1-dcf31aaec087",
                        "source_sense_id": "1471089b-e6ff-3ec1-9346-4163a45dae79",
                        "source_sense_description": "stofwisselingsziekte waarbij het lichaam geen of te weinig insuline produceert",
                        "target_lang_word": "Diabetes",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Diabetes",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b1993934-93d7-3425-ae6d-9f3cd5935664",
                                        "entry_id": "3a5e3167-0fa7-30f7-a29d-49bd73aaa2a4",
                                        "glosses": [
                                            "Diabetes mellitus: Stoffwechselerkrankung, charakterisiert durch verminderte beziehungsweise fehlende Bildung von Insulin sowie durch vermehrte Urinausscheidung und gesteigertes Durstgefühl, die unbehandelt schnell zum Tode führt; Autoimmunerkrankung (sogenannter Diabetes mellitus Typ 1 oder Typ-1-Diabetes oder juveniler Diabetes)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4040cd7-0803-47de-bc3f-19ab2b0b26e3",
                                                "sense_id": "b1993934-93d7-3425-ae6d-9f3cd5935664",
                                                "text": "Diabetes muss behandelt werden."
                                            },
                                            {
                                                "example_id": "4340237f-4afd-4a70-be10-3d3d83ae8479",
                                                "sense_id": "b1993934-93d7-3425-ae6d-9f3cd5935664",
                                                "text": "„Er hat schwere Rückenprobleme, doch auch Diabetes und eine Reihe kleinerer Diagnosen lassen ihn kaum noch aufstehen.“"
                                            },
                                            {
                                                "example_id": "86275bbb-129f-4d48-a520-ae8c85e77ec4",
                                                "sense_id": "b1993934-93d7-3425-ae6d-9f3cd5935664",
                                                "text": "„Viele waren an Diabetes oder Herzversagen, an Gallensteinen oder Krebs gestorben.“"
                                            },
                                            {
                                                "example_id": "599bdc4c-4b57-4d24-b5ff-090f040a00bc",
                                                "sense_id": "b1993934-93d7-3425-ae6d-9f3cd5935664",
                                                "text": "„Jetzt litt sie an Diabetes und bewohnte ein riesiges Haus.“"
                                            },
                                            {
                                                "example_id": "67d8a788-4a39-4253-8bc3-a5111563fc04",
                                                "sense_id": "b1993934-93d7-3425-ae6d-9f3cd5935664",
                                                "text": "„Er war bereits seit einigen Jahren an Diabetes erkrankt und wurde nachmittags gelegentlich von heftigen Müdigkeitsattacken heimgesucht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2cde110c-651b-3699-b00a-cf5a92917b60",
                                        "entry_id": "3a5e3167-0fa7-30f7-a29d-49bd73aaa2a4",
                                        "glosses": [
                                            "Diabetes mellitus: Stoffwechselerkrankung, bei der eine gesteigerte Unempfindlichkeit gegenüber Insulin besteht (sogenannter Diabetes mellitus Typ 2 oder Typ-2-Diabetes oder Altersdiabetes)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "327d01c2-c8e6-437b-b5e7-e89c2eea2b7d",
                                                "sense_id": "2cde110c-651b-3699-b00a-cf5a92917b60",
                                                "text": "Diabetes muss behandelt werden."
                                            },
                                            {
                                                "example_id": "d5a9f5d3-60d3-4f23-9e09-f916638926a1",
                                                "sense_id": "2cde110c-651b-3699-b00a-cf5a92917b60",
                                                "text": "„Er hat schwere Rückenprobleme, doch auch Diabetes und eine Reihe kleinerer Diagnosen lassen ihn kaum noch aufstehen.“"
                                            },
                                            {
                                                "example_id": "a7cd0e71-93d4-4c0b-8c9c-0482db6d2d53",
                                                "sense_id": "2cde110c-651b-3699-b00a-cf5a92917b60",
                                                "text": "„Viele waren an Diabetes oder Herzversagen, an Gallensteinen oder Krebs gestorben.“"
                                            },
                                            {
                                                "example_id": "01234c1d-995a-41c4-b192-783ec83ed295",
                                                "sense_id": "2cde110c-651b-3699-b00a-cf5a92917b60",
                                                "text": "„Jetzt litt sie an Diabetes und bewohnte ein riesiges Haus.“"
                                            },
                                            {
                                                "example_id": "53a99e60-6a13-4835-a12b-3f1e837ad1e8",
                                                "sense_id": "2cde110c-651b-3699-b00a-cf5a92917b60",
                                                "text": "„Er war bereits seit einigen Jahren an Diabetes erkrankt und wurde nachmittags gelegentlich von heftigen Müdigkeitsattacken heimgesucht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5af99ddd-80a8-3d94-872b-1b7334bd2174",
                                        "entry_id": "3a5e3167-0fa7-30f7-a29d-49bd73aaa2a4",
                                        "glosses": [
                                            "Diabetes insipidus: Erkrankung, die durch vermehrte Urinausscheidung und gesteigertes Durstgefühl charakterisiert ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9c6c1b8-ac1a-40ee-a1f8-379162455461",
                                                "sense_id": "5af99ddd-80a8-3d94-872b-1b7334bd2174",
                                                "text": "Bei einem Drittel aller Diabetes-insipidus-Fälle ist die Ursache nicht bekannt."
