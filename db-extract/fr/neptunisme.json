                "entry_id": "02baaddf-987b-3e6c-b2c7-c42c05953233",
                "word": "neptunisme",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "51b548d9-b332-450a-93bf-7b807b15d470",
                        "entry_id": "02baaddf-987b-3e6c-b2c7-c42c05953233",
                        "tags": [
                            "plural"
                        ],
                        "form": "neptunismes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "887e2cd4-2db4-34fe-979f-0052cabe2543",
                        "entry_id": "02baaddf-987b-3e6c-b2c7-c42c05953233",
                        "glosses": [
                            "Théorie obsolète selon laquelle la croûte terrestre a été formée par précipitation de sédiments d’un océan qui recouvrait toute la surface de la planète."
                        ],
                        "tags": [
                            "Histoire des sciences"
                        ],
                        "examples": [
                            {
                                "example_id": "08d8248f-d2fc-4ec0-b93f-b6f8c9a09214",
                                "sense_id": "887e2cd4-2db4-34fe-979f-0052cabe2543",
                                "text": "L'uniformitarisme ou actualisme est un des principes de base de la géologie moderne, il a remplacé le neptunisme et le plutonisme qui se sont affrontés au cours du XIXe siècle."
                            },
                            {
                                "example_id": "373209fc-3b1e-4ce3-b7f2-db69071ac648",
                                "sense_id": "887e2cd4-2db4-34fe-979f-0052cabe2543",
                                "text": "Or, pour un partisan du neptunisme, les roches sédimentaires s’étaient forcément formées après le granite, en le recouvrant au fond d’un océan primordial."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a3c3a497-0306-4a71-a63b-026418ad4c31",
                        "source_entry_id": "02baaddf-987b-3e6c-b2c7-c42c05953233",
                        "source_sense_id": "887e2cd4-2db4-34fe-979f-0052cabe2543",
                        "target_lang_word": "Neptunismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Neptunismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "646ddebd-ddc1-327b-8147-4f98284c4a88",
                                        "entry_id": "ac14c63a-0a46-336d-ab6e-39d137fa5756",
                                        "glosses": [
                                            "veraltete geologische Anschauung, wonach alle Gesteine Sedimentgesteine seien, das heißt sich aus Wasser der Ozeane abgelagert haben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc85cb66-6457-40f1-a273-f1c48c518b02",
                                                "sense_id": "646ddebd-ddc1-327b-8147-4f98284c4a88",
                                                "text": "„Das Feuer der Vulkane komme keineswegs von tief innen, es werde genährt von brennenden Kohlelagern, der Erdkern sei aus hartem Stein. Diese Lehre nannte sich Neptunismus und wurde von beiden Kirchen und Johann Wolfgang von Goethe verfochten.“"
                                            },
                                            {
                                                "example_id": "f6343681-0909-4c8d-8d09-6b71dfde9840",
                                                "sense_id": "646ddebd-ddc1-327b-8147-4f98284c4a88",
                                                "text": "„Bouvard neigte dem Neptunismus zu; Pécuchet dagegen war Plutonist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
