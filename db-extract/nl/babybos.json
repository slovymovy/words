                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac35b38c-1fd7-4e82-b554-9ed79894f98f",
                                "sense_id": "838b4681-3497-353b-8b09-3f77780b0a54",
                                "text": "De gemeente gaat vijfhonderd essen in het Babybos in de wijk Eschmarke vervangen. De essen zijn getroffen door een schimmelinfectie."
                            },
                            {
                                "example_id": "5db57356-3518-48a2-ac45-00d9002ec7f3",
                                "sense_id": "838b4681-3497-353b-8b09-3f77780b0a54",
                                "text": "Het babybos in het Schollebos in Capelle heeft plek voor driehonderd boompjes voor pasgeboren Capellenaartjes. Helaas, het loopt nog geen storm. Nu, vijf jaar later, staan er welgeteld vijftien boompjes."
                            }
