                    },
                    {
                        "sense_id": "5627aa63-ee3e-30f2-aa80-fe190a8de028",
                        "entry_id": "18884b85-18b8-3aa6-8db5-2d3fca1a7f94",
                        "glosses": [
                            "tussen succes en falen in; een grijs gebied"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "29f7871f-5bf2-4820-b66c-2578d17bd3b5",
                                "sense_id": "5627aa63-ee3e-30f2-aa80-fe190a8de028",
                                "text": "Enkele jaren geleden gaf niemand nog een cent voor de Nederlandse waterpoloploeg. Waar de vrouwen schitterden met het olympisch goud van 2008, vertoefden de mannen voornamelijk in de schemerzone."
                            },
                            {
                                "example_id": "37bdeff5-6b0a-4a79-8fbd-6e03d5daa1e2",
                                "sense_id": "5627aa63-ee3e-30f2-aa80-fe190a8de028",
                                "text": "Notts County achtte Morgan niet goed genoeg voor professioneel voetbal. Morgan had in de schemerzone van de samenleving kunnen verdwijnen, maar in plaats daarvan ging hij nog harder trainen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "39c00fdb-80e1-4f1d-9a10-78eb1e6028c6",
                        "source_entry_id": "18884b85-18b8-3aa6-8db5-2d3fca1a7f94",
                        "source_sense_id": "af7dfde2-eded-3f56-8d89-139a77918a3c",
                        "source_sense_description": "gebied tussen licht en donker in",
                        "target_lang_word": "twilight zone",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "twilight zone",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c764b5f1-c8e5-3e73-b444-e74c9700d6d2",
                                        "entry_id": "87485118-e50e-321b-9124-583f4cbc5895",
                                        "glosses": [
                                            "A moving line that divides the daylit side and the dark night side of a planetary body."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7b668259-2abb-3d08-8096-97e7c0773ece",
                                        "entry_id": "87485118-e50e-321b-9124-583f4cbc5895",
                                        "glosses": [
                                            "A region or context located in between others and therefore not subject to their norms."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5213bdb5-d3f2-4673-a627-22e9e8dc726e",
                                                "sense_id": "7b668259-2abb-3d08-8096-97e7c0773ece",
                                                "text": "As to this right, therefore, the people have expressly created a twilight zone, in which neither nation nor state can act."
                                            },
                                            {
                                                "example_id": "85aaf7bb-c8e9-4372-8605-e361ef84748e",
                                                "sense_id": "7b668259-2abb-3d08-8096-97e7c0773ece",
                                                "text": "They were interesting because they represented a sort of twilight zone separating the \"old days\" from modern times."
                                            },
                                            {
                                                "example_id": "5d58f852-d5ca-46a7-bb95-ac5f3866fc5d",
                                                "sense_id": "7b668259-2abb-3d08-8096-97e7c0773ece",
                                                "text": "...the classification scheme related to goods which lay in a \"twilight zone\" between consumer goods and equipment or between inventory and farm products."
                                            },
                                            {
                                                "example_id": "da1c1ac1-e4e4-4801-b7bf-7835ca408747",
                                                "sense_id": "7b668259-2abb-3d08-8096-97e7c0773ece",
                                                "text": "But is there not a twilight zone over which both Church and State put forth claims?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "861f00e5-5277-3319-8faa-ec9b3201f348",
                                        "entry_id": "87485118-e50e-321b-9124-583f4cbc5895",
                                        "glosses": [
                                            "A deteriorating area surrounding a central business district."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91f95f0e-a10c-418b-b618-8b0b88b635fc",
                                                "sense_id": "861f00e5-5277-3319-8faa-ec9b3201f348",
                                                "text": "Geographically speaking, the twilight zone encompasses those areas that lie between the central business district and the first ring of suburban shopping centers, many of which are comparatively obsolete."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8ca24378-900d-383c-9312-ae88af0cd151",
                                        "entry_id": "87485118-e50e-321b-9124-583f4cbc5895",
                                        "glosses": [
                                            "Synonym of mesopelagic zone (“The part of the ocean where there is very minimal light, located below the photic epipelagic zone but above the aphotic bathypelagic zone.”)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "twilight zone",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "368b2810-5452-34bf-a760-9c1be633a010",
                                        "entry_id": "8e67f19d-cb6f-3f85-a5a9-98f490bf757d",
                                        "glosses": [
                                            "To put or place into an indeterminate position; to be in an ambiguous, undetermined, or improper context."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5f32e57-015c-4546-b92e-8889679cfcc9",
                                                "sense_id": "368b2810-5452-34bf-a760-9c1be633a010",
                                                "text": "Sometimes I think she's really a gym teacher twilight-zoned into the corridors of government. I'm always surprised to see that it's a gold, clipless Cross pen she's carrying and not a gym whistle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fde223ad-640d-3bc1-8b05-4002959a7e21",
                                        "entry_id": "8e67f19d-cb6f-3f85-a5a9-98f490bf757d",
                                        "glosses": [
                                            "To cause to daydream or zone out; to cause to lose attention to one's surroundings."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5bca88c-2cd6-409e-afda-5d602b9cde3d",
                                                "sense_id": "fde223ad-640d-3bc1-8b05-4002959a7e21",
                                                "text": "\"I've been distant and into myself all night,\" I said. \"The kids say I get twilight zoned.\""
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "twilight zone",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "101e7279-babc-3a53-bd99-a436ab34e379",
                                        "entry_id": "4d45e13f-9d8d-3ee8-bdf8-a48614526bf0",
                                        "glosses": [
                                            "A region in which surreal, supernatural, or fantastic events occur."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "322e59a8-a609-46ac-a3f9-1e3917a8c6a2",
                                                "sense_id": "101e7279-babc-3a53-bd99-a436ab34e379",
                                                "text": "Oh, I can't talk right now, Duke. I'm in the twilight zone."
                                            },
                                            {
                                                "example_id": "0fd173f8-203c-4567-a73b-bed3c1457882",
                                                "sense_id": "101e7279-babc-3a53-bd99-a436ab34e379",
                                                "text": "Ground controllers were uncertain for some agonizing hours what had happened to the spacecraft [...] \"We have entered the twilight zone,\" dead-panned one jaded engineer."
                                            },
                                            {
                                                "example_id": "4e1d4a74-142c-406b-898d-7860b297f9e3",
                                                "sense_id": "101e7279-babc-3a53-bd99-a436ab34e379",
                                                "text": "Suddenly, to her astonishment and mine, it turned black and blue! I wondered if we'd just entered the twilight zone."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "twilight zone",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b32192df-040f-3b83-8a4f-55abaaffc703",
                                        "entry_id": "bd0c9743-9b1c-3485-868f-2fd2afb924d8",
                                        "glosses": [
                                            "To experience or perceive something bizarre or fantastic."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fadaa27c-c1f1-4536-937d-0ab1312dcbd8",
                                                "sense_id": "b32192df-040f-3b83-8a4f-55abaaffc703",
                                                "text": "Then a gnome like white haired lady, bent like a human question mark, lurched toward me and asked if I was the mailman. [...] I was Twilight Zoning."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "812ab331-dc40-30fb-969d-ac60a2bd0287",
                                        "entry_id": "bd0c9743-9b1c-3485-868f-2fd2afb924d8",
                                        "glosses": [
                                            "To behave or occur in a confusing or unexpected manner."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4aa0aec5-a32a-4893-935e-b57463234569",
                                                "sense_id": "812ab331-dc40-30fb-969d-ac60a2bd0287",
                                                "text": "The service is likely from a bad twilight zone episode. [...] I did get what I required but I had to ask lots of questions as the communication was Twilight Zoning often."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
