                        "tags": [],
                        "examples": [
                            {
                                "example_id": "512fc491-d7a4-43ab-9a9d-ea894bc9ca2d",
                                "sense_id": "cd25efbf-0782-31e3-a9ec-e3a95c686de0",
                                "text": "Der Säulenschaft kann aus einem einzigen Stein, also einem Monolithen, oder aus mehreren Stücken, den sogenannten Säulentrommeln, bestehen."
                            },
                            {
                                "example_id": "bb40d561-ee27-4fd8-a6e0-3f24edecd1c3",
                                "sense_id": "cd25efbf-0782-31e3-a9ec-e3a95c686de0",
                                "text": "\"Klassische Säulenschäfte sind glatt oder durch eine Kannelierung geschmückt. Aufwendigere Dekorationen finden sich bei ägyptischen, romanischen oder gotischen Säulen.\""
                            }
                        ],
