                        "translation_id": "1904d446-ea74-4756-9577-a147a8fcb9ba",
                        "source_entry_id": "3b2c1735-35c1-3cfb-8da5-a8ef5469e308",
                        "source_sense_id": "c62804e1-0d04-3bc1-ad50-1c1fb659742e",
                        "target_lang_word": "Cyrillic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Cyrillic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3dde6cbb-0427-33ff-883c-fb4c782355fb",
                                        "entry_id": "a09b57ed-b268-3443-bcd2-e99c23f0f637",
                                        "glosses": [
                                            "Denoting an alphabet devised for writing the Old Church Slavonic liturgical language, and its adaptations used for several languages of Eastern Europe and Asia; of or relating to this writing system."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Cyrillic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8488d555-6e7f-3abe-82b0-c66741ea761d",
                                        "entry_id": "92324c2b-d649-333a-9271-bf6bfc3b00b8",
                                        "glosses": [
                                            "The Cyrillic alphabet or writing system."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c63682c-20d0-4067-8272-697a3035c62b",
                                                "sense_id": "8488d555-6e7f-3abe-82b0-c66741ea761d",
                                                "text": "Russian is typically written in Cyrillic."
                                            },
                                            {
                                                "example_id": "ec3002e5-0fae-46f6-839e-71a742a404d0",
                                                "sense_id": "8488d555-6e7f-3abe-82b0-c66741ea761d",
                                                "text": "Hidden behind a Cyrillic veil of mystery, it’s one of the harder languages to master, so much so that even many Russians speak it incorrectly."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "25f809d0-5e23-4ad3-b2d2-5b46f07e3229",
                        "source_entry_id": "3b2c1735-35c1-3cfb-8da5-a8ef5469e308",
                        "source_sense_id": "c62804e1-0d04-3bc1-ad50-1c1fb659742e",
                        "target_lang_word": "cirílico",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cirílico",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "7c1f56bb-8ae8-3e06-a1c5-aaea9dd1f8b2",
                                        "entry_id": "9c2576f2-1c48-306c-8954-f5b715ace0dd",
                                        "glosses": [
                                            "Relativo al alfabeto ruso y a otros idiomas, instituido en el siglo X. Se fundamenta en el alfabeto griego, con caracteres del alfabeto glagolítico relativos a fonemas eslavos."
                                        ],
                                        "tags": [
                                            "noun"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c4f42ab8-2dc4-445a-9654-4b78b920bd8b",
                        "source_entry_id": "3b2c1735-35c1-3cfb-8da5-a8ef5469e308",
                        "source_sense_id": "c62804e1-0d04-3bc1-ad50-1c1fb659742e",
                        "target_lang_word": "kyrillisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kyrillisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3c33b689-80bb-36e7-9fb2-fbb8b54905ed",
                                        "entry_id": "57b456b6-98b1-39ce-81bc-c34cc1e90743",
                                        "glosses": [
                                            "in der Form an die griechische Unziale angelehnt und ursprünglich zur Verschriftlichung des Altkirchenslawischen entwickelt"
                                        ],
                                        "tags": [
                                            "Sprachwissenschaft",
                                            "von Schriftzeichen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "97eb43f9-4b72-4631-9e0f-4d492b6656e8",
                                                "sense_id": "3c33b689-80bb-36e7-9fb2-fbb8b54905ed",
                                                "text": "„П“ ist ein kyrillisches Schriftzeichen (Buchstabe) und entspricht in lateinischer Schrift dem „P“."
                                            },
                                            {
                                                "example_id": "9ad631af-3203-4178-9504-77ffc0648625",
                                                "sense_id": "3c33b689-80bb-36e7-9fb2-fbb8b54905ed",
                                                "text": "„Bulgarisch, Russisch und Serbisch sind eng verwandt, werden aber aus historischen Gründen mit kyrillischen Buchstaben verschriftlicht.“"
                                            },
                                            {
                                                "example_id": "e66b58ce-12c5-468b-b59a-bafcb61689dd",
                                                "sense_id": "3c33b689-80bb-36e7-9fb2-fbb8b54905ed",
                                                "text": "„Es ist nicht zu ändern, die nächste halbe Stunde stehe ich wieder an der zugigen Durchfahrt und male fein säuberlich kyrillische Buchstaben in die kleinen, dafür vorgesehenen Felder.“"
                                            },
                                            {
                                                "example_id": "55f427d4-6da6-4e28-855f-d7a018cb75e6",
                                                "sense_id": "3c33b689-80bb-36e7-9fb2-fbb8b54905ed",
                                                "text": "„Allein das kyrillische Alphabet, das in Bulgarien die Wegweiser und Ortschaften zur vollkommenen Unkenntlichkeit verschlüsselte, war eine Herausforderung für sich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d380fb9b-9b72-416e-817b-5753e98ddab9",
                        "source_entry_id": "3b2c1735-35c1-3cfb-8da5-a8ef5469e308",
                        "source_sense_id": "c62804e1-0d04-3bc1-ad50-1c1fb659742e",
                        "target_lang_word": "кириллический",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "кириллический",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "71364c86-b444-3b94-9c69-fbab90162ea9",
                                        "entry_id": "85633a57-f6ec-3592-af04-fbe4a05ae190",
                                        "glosses": [
                                            "связанный, соотносящийся по значению с существительным кириллица"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4dd9960c-6afd-40f1-962a-3266ce98d4cc",
                                                "sense_id": "71364c86-b444-3b94-9c69-fbab90162ea9",
                                                "text": "А таким образом возникает вопрос, именно какие буквы изобре́л Кирилл, так называемые ли кириллические или глаголические?"
                                            },
                                            {
                                                "example_id": "12860b99-3bbe-4f7c-9947-6c6a8eb54d88",
                                                "sense_id": "71364c86-b444-3b94-9c69-fbab90162ea9",
                                                "text": "Как знак алфавита, э представляет собой старославянское (древнеболгарское) кириллическое е, обращенное в другую сторону (отсюда и название буквы: э «оборотное») и очень похожее на соответствующий кириллическому е глаголический знак."
                                            },
                                            {
                                                "example_id": "335b3625-db2a-4cc8-829a-f01cc60756d6",
                                                "sense_id": "71364c86-b444-3b94-9c69-fbab90162ea9",
                                                "text": "В пользу старшинства глаголицы свидетельствуют и черты языка глаголических памятников: в этих памятниках представлены архаические пласты первооригиналов более значительно, чем в памятниках кириллических, как отмечено было выше."
                                            },
                                            {
                                                "example_id": "e1cfc0d4-1a09-405c-98e6-4f624d656ce1",
                                                "sense_id": "71364c86-b444-3b94-9c69-fbab90162ea9",
                                                "text": "В ряде случаев кириллические имена папок или страниц допустимы… О возможности регистрации кириллических доменных имён мы поговорим отдельно…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "79240c79-e055-491a-b175-e1097a59b536",
                        "source_entry_id": "3b2c1735-35c1-3cfb-8da5-a8ef5469e308",
