                                                "example_id": "4239cb9c-3740-45bc-909a-7e5ecccd18f9",
                                                "sense_id": "487eb125-c57c-3f9f-8824-4f5562429224",
                                                "text": "Ja, es waren wirklich erschreckende Nachrichten, die uns da aus Australien an diesem Weihnachtstag erreichten."
                                            },
                                            {
                                                "example_id": "98f7d312-b3d1-4e7c-989d-6523ae214bc0",
