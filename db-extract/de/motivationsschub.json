                ],
                "senses": [
                    {
                        "sense_id": "55730c63-e31e-3365-9cae-5b52639a3c40",
                        "entry_id": "e1a690c6-c67c-3092-8c2c-764cd8edffe0",
                        "glosses": [
                            "durch einen Impuls ausgelöster plötzlicher Anstieg der Motivation"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af6fddeb-504c-4078-b0d2-f1c1b319a191",
                                "sense_id": "55730c63-e31e-3365-9cae-5b52639a3c40",
                                "text": "„Das hat mich richtig gefreut und mir einen enormen Motivationsschub gegeben.“"
                            },
                            {
                                "example_id": "df2cd31d-f7c3-43a4-90c2-3d4fab0a3862",
                                "sense_id": "55730c63-e31e-3365-9cae-5b52639a3c40",
                                "text": "„Schließlich spornt das Erreichte zu noch mehr Leistung an und wirkt wie ein Motivationsschub für die Bewältigung der anstehenden Aufgaben.“"
                            },
                            {
                                "example_id": "be97f125-5a28-43d9-a9df-a7b8491dea5c",
                                "sense_id": "55730c63-e31e-3365-9cae-5b52639a3c40",
                                "text": "„Neben dem sozialen Aspekt des gemeinsamen Essens, [sic!] sorgt ein gesundes Mittagessen für einen regelrechten Motivationsschub und erhöhte Produktivität in Deinem Team.“"
                            },
                            {
                                "example_id": "51d3108c-a4a7-4832-a66c-a71df87b1765",
                                "sense_id": "55730c63-e31e-3365-9cae-5b52639a3c40",
                                "text": "„Mit deiner Lieblingsmusik und deinen Lieblingsserien sorgst du für einen dauerhaften Motivationsschub und nutzt dein Tablet als Trainingsunterstützung, um deine Ziele mit Freude und Leichtigkeit zu erreichen.“"
                            },
                            {
                                "example_id": "626a3230-e25b-4e08-82cc-9ec3b5022ed3",
                                "sense_id": "55730c63-e31e-3365-9cae-5b52639a3c40",
                                "text": "„Wer einen Motivationsschub braucht [sic!] sollte dringend dieses Buch lesen!“"
                            },
                            {
                                "example_id": "ae6cd4d4-2593-4a3a-a57e-1f6b8b126e64",
                                "sense_id": "55730c63-e31e-3365-9cae-5b52639a3c40",
                                "text": "„Ich habe gemerkt, wie das unserem Team einen Motivationsschub gab.“"
                            },
                            {
                                "example_id": "5a0ba24d-6eb3-4437-9d7c-eb5ef6d0115c",
                                "sense_id": "55730c63-e31e-3365-9cae-5b52639a3c40",
                                "text": "„Einen Motivationsschub gab es durch den eindeutigen 7:2 Sieg über die Erfurter Black Dragons am vergangenen Wochenende.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "02fbde8e-138a-3385-b114-886f43052f0d",
                        "entry_id": "e1a690c6-c67c-3092-8c2c-764cd8edffe0",
                        "glosses": [
                            "etwas, das diesen plötzlichen Anstieg der Motivation ([1]) auslöst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "03add307-8dde-4f25-bee4-323aed415838",
                                "sense_id": "02fbde8e-138a-3385-b114-886f43052f0d",
                                "text": "„Erfolgsgeschichten von anderen können ein wichtiger Motivationsschub sein, um das eigene Ziel von 10 Kilo Gewichtsabnahme zu erreichen.“"
                            },
                            {
                                "example_id": "09084868-2c64-4956-8d8f-4778e0783b04",
                                "sense_id": "02fbde8e-138a-3385-b114-886f43052f0d",
                                "text": "„Der Tritt ist ein externer Motivationsschub.“"
                            },
                            {
                                "example_id": "5bd1b7b9-ac8c-4ff8-9a29-db28f149c45a",
                                "sense_id": "02fbde8e-138a-3385-b114-886f43052f0d",
                                "text": "„Sie sind wie kleine Motivationsschübe, die uns die Kraft geben, weiterzumachen, die uns die Energie geben, weiterzukämpfen, die uns den Mut geben, weiterzulieben.“"
                            },
                            {
                                "example_id": "7eb89d1e-895d-4365-828f-30ba0ebcddc5",
                                "sense_id": "02fbde8e-138a-3385-b114-886f43052f0d",
                                "text": "„Und dazu zählt selbstverständlich auch der süße Motivationsschub (= Keks) zum Nachmittagskaffee🙂“"
                            },
                            {
                                "example_id": "539d27c7-9e95-44da-96a9-969b689a36bb",
                                "sense_id": "02fbde8e-138a-3385-b114-886f43052f0d",
                                "text": "„Es war für mich ein riesiger Motivationsschub und ich habe das Gefühl, jetzt richtig durchstarten zu können.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
