                                "example_id": "bbb244c1-b5e7-4160-8753-21c40be6fb23",
                                "sense_id": "cf923069-1122-3e80-9b71-639a9fdf8ce7",
                                "text": "BP (BP) revealed plans in August to slash its oil production by 40% and pour billions of dollars into clean energy as it attempts to deliver net-zero emission by 2050. […] The moves could make BP (BP) more appealing to ESG investors, at least compared with US oil companies."
                            }
                        ]
