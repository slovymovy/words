                                "it": "I vecchi vestiti da palestra <w>puzzano</w> di sudore dopo un lungo allenamento.",
                                "tr": "Uzun bir antrenmandan sonra eski spor kıyafetleri ter <w>kokuyor</w>.",
                                "ru": "Старая спортивная одежда после долгой тренировки <w>воняет</w> потом."
                            }
                        },
                        {
                            "text": "The garbage bins <w>reek</w> in the summer heat.",
                            "target_lang_translations": {
                                "cs": "Popelnice v letním horku <w>páchne</w>.",
                                "zh": "夏日炎炎，垃圾桶<w>散发着恶臭</w>。",
                                "es": "Los cubos de basura <w>hieden</w> con el calor del verano.",
                                "nl": "De vuilnisbakken <w>stinken</w> in de zomerhitte.",
                                "pl": "W letnim upale kosze na śmieci <w>śmierdzą</w>.",
                                "de": "Die Mülltonnen <w>stinken</w> in der Sommerhitze.",
                                "fr": "Les poubelles <w>empestent</w> sous la chaleur estivale.",
                                "it": "I bidoni della spazzatura <w>puzzano</w> con il caldo estivo.",
                                "tr": "Yaz sıcağında çöp kutuları <w>pis kokuyor</w>.",
                                "ru": "Мусорные баки <w>воняют</w> на летней жаре."
                            }
                        }
