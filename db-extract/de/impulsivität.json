                "senses": [
                    {
                        "sense_id": "5d4fb64e-bd22-3f6d-98cc-1c5026a7195c",
                        "entry_id": "e636145c-1482-363f-bc73-5b3afd99cad0",
                        "glosses": [
                            "Eigenschaft/Haltung/Handlungsweise, die in deutlichem Maße ungebremstes, spontanes (impulsives) Verhalten zeigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7734da6c-f9df-468b-a5bf-b77baff0420f",
                                "sense_id": "5d4fb64e-bd22-3f6d-98cc-1c5026a7195c",
                                "text": "„Die Produktion kreativer Produkte benötigt Impulsivität aber auch Kontrolliertheit, Idealismus aber auch Realismus und vor allem ein hohes Maß an Neugierde und Weltoffenheit, sowie ein hohes Maß an Anpassungsfähigkeit.“"
                            },
                            {
                                "example_id": "924ccad1-f9eb-45ad-8ea5-8c7829ab7511",
                                "sense_id": "5d4fb64e-bd22-3f6d-98cc-1c5026a7195c",
                                "text": "„Erhöhte Impulsivität ist auch ohne das Vorliegen einer ADHS ein Risikofaktor für die Entwicklung aggressiv-dissozialer Verhaltensweisen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2c2c6c79-f2e3-403f-b5d2-73e8c872c0fb",
                        "source_entry_id": "e636145c-1482-363f-bc73-5b3afd99cad0",
                        "source_sense_id": "5d4fb64e-bd22-3f6d-98cc-1c5026a7195c",
                        "target_lang_word": "impetuosity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "impetuosity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2f0b237e-212b-365e-a4d4-f14f4f4a7f32",
                                        "entry_id": "ce279708-3f2d-3c4a-9c49-eaca61e00d28",
                                        "glosses": [
                                            "The quality of making rash or arbitrary decisions, especially in an impulsive or forceful manner."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f253b39-34c4-46eb-a606-c9563c548c79",
                                                "sense_id": "2f0b237e-212b-365e-a4d4-f14f4f4a7f32",
                                                "text": "She had however another motive, beside her obedience, to accompany the old gentleman in the chase; for by her presence she hoped in some measure to restrain his impetuosity, and to prevent him from so frequently exposing his neck to the utmost hazard."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "74afd29a-c336-3c08-9c78-65111c7b084c",
                                        "entry_id": "ce279708-3f2d-3c4a-9c49-eaca61e00d28",
                                        "glosses": [
                                            "The condition or quality of being impetuous, impatient; fury; violence."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4cd00061-676b-48c3-a694-ef1be0b16f9f",
                                                "sense_id": "74afd29a-c336-3c08-9c78-65111c7b084c",
                                                "text": "Again his lordship began his long and deliberate perusal, while Henrietta watched the slow motion of his eyes with a degree of impetuosity she could scarcely repress."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
