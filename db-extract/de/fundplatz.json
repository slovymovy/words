                "senses": [
                    {
                        "sense_id": "ba251fae-e88d-38cf-a755-af5e4bcb9c6b",
                        "entry_id": "6ce66292-9daf-380b-8607-98da2b12bd1f",
                        "glosses": [
                            "Ort, Stelle, wo etwas Bestimmtes gefunden worden ist, ein (vor allem archäologischer) Fund gemacht wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16d0a964-d82e-49e2-bcac-b09808ef2040",
                                "sense_id": "ba251fae-e88d-38cf-a755-af5e4bcb9c6b",
                                "text": "„Verglichen mit anderen Mittelmeerländern liegen in Israel sehr viele Fundplätze auf sehr engem Raum […] Etwa 35 000 Fundorte verteilen sich auf 22 145 Quadratkilometer.“"
                            },
                            {
                                "example_id": "9583084a-d7da-4246-9f11-4091231b1fe9",
                                "sense_id": "ba251fae-e88d-38cf-a755-af5e4bcb9c6b",
                                "text": "„Die Menschen lebten so dicht beieinander, dass die Vorburg nach der Brandkatastrophe heute einer der reichsten keltischen Fundplätze ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
