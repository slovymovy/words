                "senses": [
                    {
                        "sense_id": "b11ecc15-96be-3487-8789-caaf45c9db38",
                        "entry_id": "d610cd16-dd65-3473-8403-acc05206f560",
                        "glosses": [
                            "Projekt, das eine Planung oder ein Konzept in die Realität überführt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "575da701-46ba-400a-a30c-d0220e21df45",
                                "sense_id": "b11ecc15-96be-3487-8789-caaf45c9db38",
                                "text": "„Das Rahmenkonzept und die wichtigsten Realisierungsprojekte wurden sehr frühzeitig höheren Führungskräften und dem Wirtschaftsausschuß vorgestellt, in dem auch der Betriebsrat vertreten ist.“"
                            },
                            {
                                "example_id": "6cf38d53-8979-4c87-a63c-086d619f7c39",
                                "sense_id": "b11ecc15-96be-3487-8789-caaf45c9db38",
                                "text": "„Scheer schlägt weiter vor, den globalen CIM-Begriff in typische CIM-Teilketten aufzulösen, das heißt Teilbereiche des Unternehmens, die sich dann in konkreten Realisierungsprojekten operationalisieren lassen.“"
                            },
                            {
                                "example_id": "5b59df0a-8193-4f72-a313-cc09a5deb3fe",
                                "sense_id": "b11ecc15-96be-3487-8789-caaf45c9db38",
                                "text": "„Trotz dieses hohen Nutzenpotentials einer solchen Planungsmethode sind gegenwärtig noch keine konkreten Realisierungsprojekte in dieser Richtung gestartet worden.“"
                            },
                            {
                                "example_id": "42f7c424-d45c-444a-b862-64eecdb70b45",
                                "sense_id": "b11ecc15-96be-3487-8789-caaf45c9db38",
                                "text": "„Dies reicht von Entwicklungs-Mitarbeit in Ihren Projekten bis hin zur Festpreis-Übernahme eines Realisierungsprojekts.“"
                            },
                            {
                                "example_id": "11fb88b8-3d3e-45cf-8879-0c6130bfa11a",
                                "sense_id": "b11ecc15-96be-3487-8789-caaf45c9db38",
                                "text": "„Zusammen mit dem Ingenieurbüro Sing und dem bifa Umweltinstitut startete die Gemeinde im Herbst 2018 ein einzigartiges Realisierungsprojekt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
