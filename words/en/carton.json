                },
                {
                    "sense_id": "c642e41a-206d-3baa-bcfb-7c323126126b",
                    "sense_definition": "A kind of thin pasteboard or heavy paperboard.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "material",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist used sheets of stiff <w>carton</w> to construct the miniature architectural model.",
                            "target_lang_translations": {
