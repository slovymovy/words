                    {
                        "translation_id": "308e7061-a2e0-4110-8c0a-233d79a7014d",
                        "source_entry_id": "ad959dae-7974-3278-8f87-cbd7e95e2144",
                        "source_sense_description": "vigor, energy",
                        "target_lang_word": "Tatkraft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tatkraft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7ce44212-12e5-3a36-9a64-74b8409cdda2",
                                        "entry_id": "bf72f1ca-5f53-3503-ba38-47f24f31f1a5",
                                        "glosses": [
                                            "Bereitschaft und Fähigkeit zu handeln"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e174894-7150-49a8-af4f-cfdbf81ec26b",
                                                "sense_id": "7ce44212-12e5-3a36-9a64-74b8409cdda2",
                                                "text": "„Dank ihrer Tatkraft und Energie, die sich ihren Reisegefährten mitteilten, waren sie gegen Ende der zweiten Reisewoche nicht mehr weit von Jaroslawl.“"
                                            },
                                            {
                                                "example_id": "9b3d7315-26bb-4529-be43-a2829410c582",
                                                "sense_id": "7ce44212-12e5-3a36-9a64-74b8409cdda2",
                                                "text": "„Er trifft den Nerv einer Gesellschaft, die des tristen Alltags überdrüssig ist und sich nach Männlichkeit und Tatkraft sehnt.“"
                                            },
                                            {
                                                "example_id": "3a243f76-45e3-4e97-9666-74a33a57286f",
                                                "sense_id": "7ce44212-12e5-3a36-9a64-74b8409cdda2",
                                                "text": "„Das war der Tag, an dem die Tatkraft nach Uppsalir kam.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9ceb5436-d89b-4985-80f6-b5d2ee71068f",
                        "source_entry_id": "ad959dae-7974-3278-8f87-cbd7e95e2144",
                        "source_sense_description": "vigor, energy",
                        "target_lang_word": "Energie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Energie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b14d04ff-ae27-389a-9f8d-8f765d2bd05d",
                                        "entry_id": "95e8297d-a4e1-3d2a-9b4f-96391a578eb3",
                                        "glosses": [
                                            "sowohl äußerlich erkennbare Phänomene (wie etwa Leistungsvermögen, Handlungskraft) als auch innere Vorgänge (Motivation, Gefühle und so weiter)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2454754-c201-4aa2-9a43-adb41f6004b2",
                                                "sense_id": "b14d04ff-ae27-389a-9f8d-8f765d2bd05d",
                                                "text": "Ich schöpfe meine Energie aus der Natur auf Bergen und gebe diese nach Möglichkeit an andere Menschen weiter."
                                            },
                                            {
                                                "example_id": "1e2b53b0-69a7-49e7-9486-72fd4248905f",
                                                "sense_id": "b14d04ff-ae27-389a-9f8d-8f765d2bd05d",
                                                "text": "„Und wer ernsthaft damit anfängt, wird erst mal unglaublich viel Geld, Mühe und Kraft hineinstecken müssen und keine Energie mehr übrig haben, sich nebenher gegen Nörgler und Bremser zu behaupten.“"
                                            },
                                            {
                                                "example_id": "7c352a34-a395-436a-b3c2-5b2b517b1077",
                                                "sense_id": "b14d04ff-ae27-389a-9f8d-8f765d2bd05d",
                                                "text": "„Sie war die Energie, die es brauchte, um aus dem Chaos aus Lauten, Lichtern, Farben und Bildern etwas zusammenzusetzen, Sinn zu erzeugen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "38d305ff-25ea-321b-9ee5-fa25c2308ea7",
                                        "entry_id": "95e8297d-a4e1-3d2a-9b4f-96391a578eb3",
                                        "glosses": [
                                            "körperliches Arbeitsvermögen eines Menschen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2203d433-7b4a-43b2-bf31-354855b9905f",
                                                "sense_id": "38d305ff-25ea-321b-9ee5-fa25c2308ea7",
                                                "text": "Schwere körperliche Arbeit setzt voraus, dass man genügend Energie dazu hat."
                                            },
                                            {
                                                "example_id": "9d129909-f0ee-413a-9e1a-fa65246fdeec",
                                                "sense_id": "38d305ff-25ea-321b-9ee5-fa25c2308ea7",
                                                "text": "„Und Honecker war es auch, der 1952 die Einführung des Schießunterrichts, des Fallschirmspringens und des Motorfliegens bei der FDJ verkündete; der Popularisierung der Wiederbewaffnung bei der Jugend widmete er danach seine ganze Energie.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "4db25dd8-f1d6-3a2d-93dd-a32638f3c240",
                                        "entry_id": "95e8297d-a4e1-3d2a-9b4f-96391a578eb3",
                                        "glosses": [
                                            "physikalische Größe: Maß für die Fähigkeit eines Objektes, Arbeit zu verrichten"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "98de40d3-9e16-429b-8076-f77f682a0dd8",
                                                "sense_id": "4db25dd8-f1d6-3a2d-93dd-a32638f3c240",
                                                "text": "Die kinetische Energie eines Körpers ist proportional zu seiner Masse und dem Quadrat seiner Geschwindigkeit."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "9311814a-43c4-33ec-93eb-77a2d8119fbd",
                                        "entry_id": "95e8297d-a4e1-3d2a-9b4f-96391a578eb3",
                                        "glosses": [
                                            "ungeschaffene, von Gott ausgehende, aber auch zu Gott gehörende Energie, Wirksamkeit Gottes in dieser Welt"
                                        ],
                                        "tags": [
                                            "Theologie",
                                            "orthodox",
                                            "Mystik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "45ee1e0c-56bb-4142-a713-b4a461f08dea",
                                                "sense_id": "9311814a-43c4-33ec-93eb-77a2d8119fbd",
                                                "text": "„Und weil der Palamismus (d. h., die reale Unterscheidung zwischen dem Wesen und den Energien Gottes) ein wesentlicher Aspekt der orthodoxen Gotteslehre ist, bedeutet das Konsequenzen für alle Teilgebiete der orthodoxen Dogmatik.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3583f0a2-5f8e-43cf-81c4-e1e3970c0be2",
                        "source_entry_id": "ad959dae-7974-3278-8f87-cbd7e95e2144",
