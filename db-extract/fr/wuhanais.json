                "senses": [
                    {
                        "sense_id": "50dc838f-7327-3e07-bccf-df18c544273d",
                        "entry_id": "887d22a4-ff1c-37de-9886-e729b4aa60a8",
                        "glosses": [
                            "habitant ou personne originaire de Wuhan, ville chinoise de la province de Hubei."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "470b39a3-bc43-45b6-b001-bc45cae977e9",
                                "sense_id": "50dc838f-7327-3e07-bccf-df18c544273d",
                                "text": "Pour les Wuhanais, la vie – en apparence seulement – suit son train presque normal."
                            },
                            {
                                "example_id": "288ad87e-b385-4b5a-a28c-452ca2e64779",
                                "sense_id": "50dc838f-7327-3e07-bccf-df18c544273d",
                                "text": "Dorénavant, seule la ville de Wuhan (11 millions d’habitants) est encore confinée jusqu’au 8 avril, date de la levée des dernières mesures. Outre les Wuhanais, les seules personnes encore soumises à un confinement sont les voyageurs revenant de l’étranger qui doivent s’isoler pendant quatorze jours."
                            }
                        ]
                    }
                ],
