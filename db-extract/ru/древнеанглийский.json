                            "plural",
                            "prepositional"
                        ],
                        "form": "древнеангли́йских"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "55948a99-8216-3ff4-8817-c0d3225cfa50",
                        "entry_id": "63f29c2b-cafe-3567-ab6b-bdb805d25580",
                        "glosses": [
                            "лингв. относящийся к языку англосаксов, распространённому в Англии с середины V до середины XII века"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85edbc6a-b622-4355-9b01-3d009f3216bc",
                                "sense_id": "55948a99-8216-3ff4-8817-c0d3225cfa50",
                                "text": "древнеанглийская литература"
                            },
                            {
                                "example_id": "1f212fed-8168-4b80-962e-a365f495d844",
                                "sense_id": "55948a99-8216-3ff4-8817-c0d3225cfa50",
                                "text": "Например, для современного англичанина (не лингвиста) древнеанглийский текст X века ― это уже просто иностранный язык."
                            }
                        ]
                    },
                    {
                        "sense_id": "2c19ed86-8a99-33a2-91a2-b12829e251f7",
                        "entry_id": "63f29c2b-cafe-3567-ab6b-bdb805d25580",
                        "glosses": [
                            "истор. относящийся к Англии периода раннего средневековья"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "760077a4-4375-41dd-ae87-efad218dc95e",
                                "sense_id": "2c19ed86-8a99-33a2-91a2-b12829e251f7",
                                "text": "Россия вон обрела наконец действительно всеобщее избирательное право, но поскольку она доросла много если до конституционной монархии древнеанглийского образца, то законотворчеством у нас занимаются преимущественно лоботрясы и чудаки."
                            }
                        ]
                    },
                    {
                        "sense_id": "b7ea2062-58c9-39eb-b12a-8bdc8f5b0bbb",
                        "entry_id": "63f29c2b-cafe-3567-ab6b-bdb805d25580",
                        "glosses": [
                            "субстантивир., лингв. то же, что древнеанглийский язык; язык англосаксов, распространённый в Англии с середины V до середины XII века, впоследствии развившийся в среднеанглийский язык; предок современного английского языка"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "096c4b41-cdc9-49bf-8b9c-0e8c557b17fc",
                                "sense_id": "b7ea2062-58c9-39eb-b12a-8bdc8f5b0bbb",
                                "text": "Он рассказал несчастному историю мифологического воина и царя Беовульфа (что в переводе с древнеанглийского означает «пчелиный волк», то есть медведь) и принес из кладовки зачитанный им эпос, в поисках которого сосед обошел все аптеки города."
                            }
                        ]
                    }
                ],
                "translations": [
