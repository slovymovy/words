                                                "sense_id": "866c2eb6-6969-3544-b78b-67691141b84a",
                                                "text": "Von den fünf Walnüssen ist eine taub."
                                            }
                                        ],
                                        "sense_index_json": "\"7\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "97fd7124-60af-4e6e-ae5c-f9d797ad5a0a",
                        "source_entry_id": "53defab1-2c21-3a23-a968-d10e7588c220",
