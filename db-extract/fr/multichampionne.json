                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f062750f-e2ef-4b01-bfab-a829f22bb314",
                                "sense_id": "27d23ce9-2c28-3536-8eb5-f0833b48c762",
                                "text": "Il faut dire que cette multichampionne a le surf dans le sang, car elle a été initiée par son père dès l’âge de 4 ans."
                            },
                            {
                                "example_id": "3501c1a2-6988-44b2-8fc8-7cb412aebb0a",
                                "sense_id": "27d23ce9-2c28-3536-8eb5-f0833b48c762",
                                "text": "Pas de chance, le keum, t’as affaire à une multichampionne de France et d’Europe de boxe anglaise !"
                            },
                            {
                                "example_id": "c889b4b2-a626-46f6-98c8-0414d2b33bc0",
                                "sense_id": "27d23ce9-2c28-3536-8eb5-f0833b48c762",
                                "text": "À 28 ans, la multichampionne du monde Marie Bochet a annoncé qu’elle ne participera pas aux prochains Jeux paralympiques d’hiver."
                            }
                        ]
                    }
