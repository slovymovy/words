                "senses": [
                    {
                        "sense_id": "e2371d81-e007-3dd8-a1a6-f78cbf27670b",
                        "entry_id": "a69f52b7-249c-3f6d-b537-9c2a07e7475e",
                        "glosses": [
                            "jednostka organizacyjna lotnictwa wojskowego, składająca się z kilku lub kilkunastu, rzadziej kilkudziesięciu samolotów"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "054c7030-6c78-420f-9fd6-22e7dfb02467",
                                "sense_id": "e2371d81-e007-3dd8-a1a6-f78cbf27670b",
                                "text": "Wreszcie znalazłem go, wcale nie w świetnym uniformie admirała eskadry lewantyńskiej, w jakiej wypłynął był na okręcie flagowym „Le Cid“ z Tulonu owego roku, gdy miał objąć tron meksykański, ani też w zielonym fraku generała kawalerii, który tak chętnie nosił w swych dniach ostatnich."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "9471ee1d-b3ab-3d5d-b007-b1d4a360f1a9",
                        "entry_id": "a69f52b7-249c-3f6d-b537-9c2a07e7475e",
                        "glosses": [
                            "zespół okrętów jednego lub zbliżonego rodzaju dowodzony przez jednego dowódcę"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
