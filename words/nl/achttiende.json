                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "fraction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Iedereen krijgt precies een <w>achttiende</w> deel van de grote verjaardagstaart.",
