    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a6d3ffed-27a5-3e78-8bef-3eae45b4d34b",
                    "sense_definition": "Present participle and gerund of <w>emerge</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sun was <w>emerging</w> from behind the dark clouds.",
                            "target_lang_translations": {
                                "ru": "Солнце <w>выходило</w> из-за темных туч.",
                                "nl": "De zon kwam <w>tevoorschijn</w> van achter de donkere wolken.",
                                "zh": "太阳正从乌云背后<w>显露</w>出来。"
                            }
                        },
                        {
                            "text": "New evidence is <w>emerging</w> from the ongoing investigation.",
                            "target_lang_translations": {
                                "ru": "В ходе текущего расследования <w>появляются</w> новые улики.",
                                "nl": "Er <w>komen</w> nieuwe bewijzen naar voren uit het lopende onderzoek.",
                                "zh": "随着调查的深入，新的证据正在<w>浮现</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "appearing",
                        "arising",
                        "surfacing",
                        "materializing"
                    ],
                    "antonyms": [
                        "disappearing",
                        "vanishing",
                        "fading"
                    ],
                    "common_phrases": [
                        "emerging from",
                        "emerging as"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени от глагола emerge (появляться, возникать, выходить).",
                        "nl": "Tegenwoordig deelwoord en gerundium van 'emerge' (tevoorschijn komen, ontstaan, opduiken).",
                        "zh": "动词 emerge 的现在分词或动名词，指显露、浮现或出现。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "появляющийся",
                                "target_lang_sense_clarification": "становящийся видимым или известным"
                            },
                            {
                                "target_lang_word": "выходящий",
                                "target_lang_sense_clarification": "физически появляющийся откуда-либо"
                            },
                            {
                                "target_lang_word": "возникающий",
                                "target_lang_sense_clarification": "зарождающийся или начинающий существовать"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "tevoorschijn komend",
                                "target_lang_sense_clarification": "fysiek zichtbaar worden vanuit een verborgen positie"
                            },
                            {
                                "target_lang_word": "opkomend",
                                "target_lang_sense_clarification": "beginnend te verschijnen of zich te manifesteren"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "显露",
                                "target_lang_sense_clarification": "从遮蔽物后出现"
                            },
                            {
                                "target_lang_word": "浮现",
                                "target_lang_sense_clarification": "从隐蔽处或模糊状态中显现"
                            },
                            {
                                "target_lang_word": "出现",
                                "target_lang_sense_clarification": "开始被看见或被发现"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "1e83ece9-5a45-3fee-900c-7f6ba829205a",
                    "sense_definition": "Becoming apparent, prominent, established, or widely known.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many investors are looking for opportunities in <w>emerging</w> markets.",
                            "target_lang_translations": {
                                "ru": "Многие инвесторы ищут возможности на <w>развивающихся</w> рынках.",
                                "nl": "Veel investeerders zoeken naar kansen in <w>opkomende</w> markten.",
                                "zh": "许多投资者正在<w>新兴</w>市场寻找机会。"
                            }
                        },
                        {
                            "text": "She is an <w>emerging</w> artist who has just opened her first gallery show.",
                            "target_lang_translations": {
                                "ru": "Она — <w>восходящая</w> художница, которая только что открыла свою первую выставку в галерее.",
                                "nl": "Zij is een <w>opkomend</w> kunstenaar die zojuist haar eerste galerie-expositie heeft geopend.",
                                "zh": "她是一位<w>崭露头角</w>的艺术家，刚刚举办了她的首次画廊展览。"
                            }
                        }
                    ],
                    "synonyms": [
                        "rising",
                        "developing",
                        "budding",
                        "up-and-coming",
                        "growing"
                    ],
                    "antonyms": [
                        "declining",
                        "fading",
                        "established"
                    ],
                    "common_phrases": [
                        "emerging market",
                        "emerging economy",
                        "emerging technology",
                        "emerging artist"
                    ],
                    "target_lang_definitions": {
                        "ru": "Становящийся заметным, важным, утвердившимся или широко известным; набирающий силу.",
                        "nl": "Zichtbaar, prominent, gevestigd of algemeen bekend wordend.",
                        "zh": "形容词，指正在发展、兴起或逐渐为人所知的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "развивающийся",
                                "target_lang_sense_clarification": "о рынках, экономике или странах"
                            },
                            {
                                "target_lang_word": "восходящий",
                                "target_lang_sense_clarification": "о талантах, звездах или трендах"
                            },
                            {
                                "target_lang_word": "возникающий",
                                "target_lang_sense_clarification": "только начинающий появляться или формироваться"
                            },
                            {
                                "target_lang_word": "растущий",
                                "target_lang_sense_clarification": "увеличивающийся в размерах или влиянии"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "opkomend",
                                "target_lang_sense_clarification": "in ontwikkeling zijnd, zoals bij markten of talent"
                            },
                            {
                                "target_lang_word": "ontluikend",
                                "target_lang_sense_clarification": "beginnend te groeien of zich te tonen"
                            },
                            {
                                "target_lang_word": "in opkomst",
                                "target_lang_sense_clarification": "groeiend in belang of populariteit"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "新兴",
                                "target_lang_sense_clarification": "指市场、技术或产业"
                            },
                            {
                                "target_lang_word": "发展中",
                                "target_lang_sense_clarification": "指经济或国家"
                            },
                            {
                                "target_lang_word": "崭露头角",
                                "target_lang_sense_clarification": "指人才或艺术家"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "644d5aa5-6ac4-3234-94ed-5482b05c0606",
                    "sense_definition": "The act or process of coming into view or existence.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scientist recorded the seasonal <w>emergings</w> of the rare insects.",
                            "target_lang_translations": {
                                "ru": "Ученый фиксировал сезонные <w>появления</w> редких насекомых.",
                                "nl": "De wetenschapper registreerde het seizoensgebonden <w>tevoorschijn komen</w> van de zeldzame insecten.",
                                "zh": "科学家记录了这些稀有昆虫的季节性<w>出现</w>。"
                            }
                        },
                        {
                            "text": "We observed the sudden <w>emergings</w> of new islands from the volcanic sea.",
                            "target_lang_translations": {
                                "ru": "Мы наблюдали внезапные <w>возникновения</w> новых островов в вулканическом море.",
                                "nl": "Wij observeerden het plotselinge <w>ontstaan</w> van nieuwe eilanden uit de vulkanische zee.",
                                "zh": "我们观察到火山海域中新岛屿的突然<w>产生</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "emergence",
                        "appearance",
                        "arrival"
                    ],
                    "antonyms": [
                        "disappearance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие или процесс появления в поле зрения или начала существования.",
                        "nl": "De handeling of het proces van het in het zicht komen of het ontstaan.",
                        "zh": "名词，指显露或产生的过程。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "появление",
                                "target_lang_sense_clarification": "процесс выхода в поле зрения"
                            },
                            {
                                "target_lang_word": "возникновение",
                                "target_lang_sense_clarification": "начало существования"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "het tevoorschijn komen",
                                "target_lang_sense_clarification": "het proces van zichtbaar worden"
                            },
                            {
                                "target_lang_word": "het ontstaan",
                                "target_lang_sense_clarification": "het begin van het bestaan"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "出现",
                                "target_lang_sense_clarification": "事物进入视野的过程"
                            },
                            {
                                "target_lang_word": "产生",
                                "target_lang_sense_clarification": "事物开始存在的过程"
                            }
                        ]
                    }
                }
            ]
        }
    ]
