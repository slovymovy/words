                ],
                "senses": [
                    {
                        "sense_id": "936e07e7-efcd-3ec2-842d-f0e6ccb3b5d0",
                        "entry_id": "b1769348-727b-39b5-8efb-4f533f174370",
                        "glosses": [
                            "synonym of tausend (“thousand”), almost exclusively used of money: grand"
                        ],
                        "tags": [
                            "colloquial",
                            "feminine",
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "49217a6c-e6c1-4f75-895c-8b33922405ab",
                                "sense_id": "936e07e7-efcd-3ec2-842d-f0e6ccb3b5d0",
                                "text": "Der Wagen ist höchstens noch fünf Mille wert.",
                                "translation": "The car is worth five grand tops as of now.",
                                "english": "The car is worth five grand tops as of now."
                            },
                            {
                                "example_id": "8363f1d7-40a2-40d8-9424-cd5529684f32",
                                "sense_id": "936e07e7-efcd-3ec2-842d-f0e6ccb3b5d0",
                                "text": "Eines Tages wurde die Tür zu meinem Arbeitszimmer aufgerissen und herein stürmte der mir nur flüchtig bekannte Impresario Herr Fritz Schieber und rief statt jeder weiteren Begrüßung: »Wollen Sie viertausend^([sic]) Mille verdienen?«"
                            },
                            {
                                "example_id": "0d283179-2ac1-47bd-90c4-e41eee50928f",
                                "sense_id": "936e07e7-efcd-3ec2-842d-f0e6ccb3b5d0",
                                "text": "Es ist immer noch, immer noch die selbe Show im Jahr / Zwei Mille Mille",
                                "translation": "It is still, still the same show in the year / two thousand thousand",
                                "english": "It is still, still the same show in the year / two thousand thousand"
                            },
                            {
                                "example_id": "2a58ca8d-c3b2-4aa6-861b-f39380598bc6",
                                "sense_id": "936e07e7-efcd-3ec2-842d-f0e6ccb3b5d0",
                                "text": "Also gut: Wer hierher kommt für zwei Mille am Tag pro Person, der hat es nötig. Andererseits: Was soll schlecht sein an Basisarbeit für einen Homo erectus, der sich—endlich—darauf besinnt, dass er seines eigenen Glückes Schmied ist?"
                            }
                        ]
                    },
                    {
                        "sense_id": "8ad944bc-e664-3f11-bf90-2f75da6d4bb6",
                        "entry_id": "b1769348-727b-39b5-8efb-4f533f174370",
                        "glosses": [
                            "synonym of Million (“million”)"
                        ],
                        "tags": [
                            "feminine",
                            "proscribed",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "0b6e2f40-4742-4069-a967-b9c03f1922bc",
                                "sense_id": "8ad944bc-e664-3f11-bf90-2f75da6d4bb6",
                                "text": "Du, was ist das Stundenhotel wert? — Ich weiß nicht. Wenn’s keiner checkt, vielleicht drei Mille.",
                                "translation": "So, what is the motel worth? — I don’t know. If nobody finds out [about the underground line to be built under it], maybe three million.",
                                "english": "So, what is the motel worth? — I don’t know. If nobody finds out [about the underground line to be built under it], maybe three million."
                            }
                        ]
                    }
