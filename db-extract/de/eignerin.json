                            {
                                "example_id": "8714d530-369a-4591-9b50-2d1447eb7ca1",
                                "sense_id": "2295b1e2-0e21-3a69-a322-cb96a650d14c",
                                "text": "Marianne ist Eignerin einer Baufirma."
                            },
                            {
                                "example_id": "feca7153-6408-41d4-89e4-bd45ebc254c3",
                                "sense_id": "2295b1e2-0e21-3a69-a322-cb96a650d14c",
                                "text": "„Zwischen den vergoldeten Stücken taucht plötzlich das Weiß eines Gesichtes auf, die Eignerin, bleich wie eine Trauernde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
