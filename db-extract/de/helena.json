                                            {
                                                "example_id": "bb577bc6-580c-49c8-873c-42898452d785",
                                                "sense_id": "80c47664-5864-3f55-94a3-05ef50136f47",
                                                "text": "And how doth my cousin, your bedfellow? and your fairest daughter and mine, my god-daughter Ellen?"
                                            },
                                            {
                                                "example_id": "65397aae-1c10-469a-8d7d-5d261d45a3eb",
                                                "sense_id": "80c47664-5864-3f55-94a3-05ef50136f47",
                                                "text": "\"Is her name Ellen or Helen, Miss Viner? I thought - \"\nMiss Viner closed her eyes.\n\"I can sound my h's, dear, as well as anyone, but Helen is not a suitable name for a servant. I don't know what the mothers in the lower classes are coming to nowadays.\""
                                            },
                                            {
                                                "example_id": "0244cbbc-554d-45a1-bf62-7a7b5943d663",
                                                "sense_id": "80c47664-5864-3f55-94a3-05ef50136f47",
                                                "text": "Ellen Page gives a star-making performance as a 16-year-old live wire who decides to go through with her pregnancy and seeks acceptably well-adjusted, wealthy, punk-rock loving parents for the unborn baby."
                                            }
                                        ]
