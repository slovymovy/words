{
    "word_family": [
        "thronging"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3da7b991-602b-302d-9022-60c34e32aad8",
                    "sense_definition": "A large, densely packed crowd of people.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A <w>throng</w> of fans waited outside the hotel to see the singer. ",
                            "target_lang_translations": {
                                "it": "Una <w>folla</w> di fan aspettava fuori dall'hotel per vedere il cantante."
                            }
                        },
                        {
                            "text": "He pushed his way through a large <w>throng</w> of tourists.",
                            "target_lang_translations": {
                                "it": "Si è fatto strada attraverso una grande <w>calca</w> di turisti."
                            }
                        }
                    ],
                    "synonyms": [
                        "crowd",
                        "multitude"
                    ],
                    "common_phrases": [
                        "large throng"
                    ],
                    "target_lang_definitions": {
                        "it": "Una grande folla di persone densamente stipate."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "folla",
                                "target_lang_sense_clarification": "termine generico per un grande gruppo di persone"
                            },
                            {
                                "target_lang_word": "calca",
                                "target_lang_sense_clarification": "folla densa e stretta"
                            },
                            {
                                "target_lang_word": "ressa",
                                "target_lang_sense_clarification": "folla che spinge o si accalca"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8cd3f219-7970-36cc-b7ac-bf4a31d98bd7",
                    "sense_definition": "A large number or collection of things.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A <w>throng</w> of thoughts flooded her mind as she waited. ",
                            "target_lang_translations": {
                                "it": "Una <w>moltitudine</w> di pensieri le ha inondato la mente mentre aspettava."
                            }
                        },
                        {
                            "text": "We heard a <w>throng</w> of buzzing insects in the trees.",
                            "target_lang_translations": {
                                "it": "Abbiamo sentito un <w>sciame</w> di insetti ronzanti tra gli alberi."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Un gran numero o una collezione di cose."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "moltitudine",
                                "target_lang_sense_clarification": "gran numero di cose o persone"
                            },
                            {
                                "target_lang_word": "quantità",
                                "target_lang_sense_clarification": "riferito a un gran numero di elementi"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6d2a16ea-4637-3ccc-b6b8-97fd1d7dd225",
                    "sense_definition": "To fill or occupy a place in large numbers.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Thousands of shoppers <w>thronged</w> the street on Saturday. ",
                            "target_lang_translations": {
                                "it": "Migliaia di acquirenti hanno <w>affollato</w> la strada sabato."
                            }
                        },
                        {
                            "text": "Visitors <w>throng</w> the city streets during the summer festival.",
                            "target_lang_translations": {
                                "it": "I visitatori <w>gremiscono</w> le strade della città durante il festival estivo."
                            }
                        }
                    ],
                    "common_phrases": [
                        "throng the streets"
                    ],
                    "target_lang_definitions": {
                        "it": "Riempire o occupare un luogo in gran numero."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "affollare",
                                "target_lang_sense_clarification": "riempire un luogo di persone"
                            },
                            {
                                "target_lang_word": "gremire",
                                "target_lang_sense_clarification": "riempire completamente uno spazio"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4912344c-9e43-389f-be88-6650478a9625",
                    "sense_definition": "To gather or flock together in a crowd.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "People <w>thronged</w> into the hall to hear the speaker. ",
                            "target_lang_translations": {
                                "it": "La gente è <w>affluita</w> nella sala per ascoltare l'oratore."
                            }
                        },
                        {
                            "text": "Crowds <w>thronged</w> to see the new exhibit at the museum.",
                            "target_lang_translations": {
                                "it": "Le folle sono <w>accorse</w> per vedere la nuova mostra al museo."
                            }
                        }
                    ],
                    "common_phrases": [
                        "throng into"
                    ],
                    "target_lang_definitions": {
                        "it": "Radunarsi o affluire insieme in una folla."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "accorrere",
                                "target_lang_sense_clarification": "andare in massa verso un luogo"
                            },
                            {
                                "target_lang_word": "affluire",
                                "target_lang_sense_clarification": "arrivare in gran numero"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "70653e08-a576-361c-87b2-37a255e60638",
                    "sense_definition": "To crowd around or press against someone closely.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Reporters <w>thronged</w> the actor as he left the courtroom. ",
                            "target_lang_translations": {
                                "it": "I giornalisti hanno <w>accerchiato</w> l'attore mentre usciva dall'aula di tribunale."
                            }
                        },
                        {
                            "text": "Eager admirers <w>thronged</w> the artist after the show.",
                            "target_lang_translations": {
                                "it": "Gli ammiratori entusiasti si sono <w>stretti attorno</w> all'artista dopo lo spettacolo."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Affollarsi attorno o premere contro qualcuno da vicino."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "accerchiare",
                                "target_lang_sense_clarification": "circondare qualcuno da vicino"
                            },
                            {
                                "target_lang_word": "stringersi attorno",
                                "target_lang_sense_clarification": "avvicinarsi molto a qualcuno in gruppo"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "badaea8a-d094-37b0-b3ec-886989352026",
                    "sense_definition": "Filled with people or things; crowded.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The village square was <w>throng</w> with local vendors. ",
                            "target_lang_translations": {
                                "it": "La piazza del villaggio era <w>gremita</w> di venditori locali."
                            }
                        },
                        {
                            "text": "We walked along a <w>throng</w> avenue lined with shops.",
                            "target_lang_translations": {
                                "it": "Abbiamo camminato lungo un viale <w>affollato</w> fiancheggiato da negozi."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "archaic usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Pieno di persone o cose; affollato."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "affollato",
                                "target_lang_sense_clarification": "pieno di gente"
                            },
                            {
                                "target_lang_word": "gremito",
                                "target_lang_sense_clarification": "pieno zeppo di persone"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "82a598cc-cef1-37e9-848d-f27aa334b0f6",
                    "sense_definition": "Busy or preoccupied with activity.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager was <w>throng</w> with work all morning. ",
                            "target_lang_translations": {
                                "it": "Il manager è stato <w>impegnato</w> con il lavoro per tutta la mattina."
                            }
                        },
                        {
                            "text": "He was too <w>throng</w> with business to take a break.",
                            "target_lang_translations": {
                                "it": "Era troppo <w>affaccendato</w> con gli affari per prendersi una pausa."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "dialectal or regional usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Occupato o preso da attività."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "impegnato",
                                "target_lang_sense_clarification": "occupato con del lavoro"
                            },
                            {
                                "target_lang_word": "affaccendato",
                                "target_lang_sense_clarification": "molto occupato in varie attività"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}