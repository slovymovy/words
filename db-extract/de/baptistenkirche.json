                "senses": [
                    {
                        "sense_id": "05d9c9b3-dda3-3d7f-809f-e929a852661b",
                        "entry_id": "cbb2dcd7-0e0e-369f-a4a0-6fda5370abf9",
                        "glosses": [
                            "Gotteshaus der evangelischen Glaubensgemeinschaft der Baptisten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9fa022e-1e08-487e-9838-cb5f3b69e8cf",
                                "sense_id": "05d9c9b3-dda3-3d7f-809f-e929a852661b",
                                "text": "„Dann kam die großartige Erste Baptistenkirche aus dem Jahre 1775, die mit ihrem unübertroffenen Kirchturm von Gibbs fürstlich wirkte, der über den georgianischen Dächern und Kuppeln schwebte.“"
                            },
                            {
                                "example_id": "e50d2a61-626a-4216-82d5-5c01cbb5973e",
                                "sense_id": "05d9c9b3-dda3-3d7f-809f-e929a852661b",
                                "text": "„Am Dienstag, am Tag, nachdem sie den alten Säufer aufgescheucht hatten, fährt Edgerton zu einer aus roten Backsteinen errichteten Baptistenkirche in der oberen Park Avenue.“"
                            },
                            {
                                "example_id": "0e81ccad-e478-437c-99a8-5ee42c482160",
                                "sense_id": "05d9c9b3-dda3-3d7f-809f-e929a852661b",
                                "text": "„Roger Williams hatte die Baptistenkirche in Rhode Island - die erste in Amerika - 1638 gegründet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
