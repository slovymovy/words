                                "target_senses": [
                                    {
                                        "sense_id": "ad5f1aa8-f633-31e2-8380-2704f1fa5584",
                                        "entry_id": "c10a511e-f52f-3253-8ea4-af4aaaf3a26d",
                                        "glosses": [
                                            "děj, spočívající v tom, že někdo střílí (ze zbraně)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6fded1dc-5e38-494f-a6cf-91a621cb29a8",
                                                "sense_id": "ad5f1aa8-f633-31e2-8380-2704f1fa5584",
                                                "text": "Zde byli zástupci Československa seznámeni s důkazy, jež vyvracely verzi Pohraniční služby (PS). Němečtí vyšetřovatelé zdůraznili, že na německé straně hranic nalezli stopy po přítomnosti vojáků PS, jako například zásobník, obvazový balíček a obal od obvazu, ale zejména stopy po střelbě, tedy vstřely do stromů a do posedu a větší množství vystřílených nábojnic z různých zbraní československé výroby, které svědčí o tom, že českoslovenští pohraničníci vedli pronásledování a střelbu na německém území."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "36a2917b-a9dd-3068-900b-6cba275c8d37",
                                        "entry_id": "c10a511e-f52f-3253-8ea4-af4aaaf3a26d",
                                        "glosses": [
                                            "prudké odehrávání míče resp. puku směrem k brance s cílem skórovat"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
