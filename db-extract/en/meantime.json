                ],
                "senses": [
                    {
                        "sense_id": "8e7776da-d551-30b1-9caa-d4f2644ab33f",
                        "entry_id": "5f400e2e-895f-3503-ba4e-7e08eebe8cfe",
                        "glosses": [
                            "The time spent waiting for another event; time in between."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "b8fca768-b586-4db2-a618-82791db35d51",
                                "sense_id": "8e7776da-d551-30b1-9caa-d4f2644ab33f",
                                "text": "We'll come back asap; just wait here for the meantime."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "569ebc3a-bcdb-4cd0-8e9d-0587bc3d7cf3",
                        "source_entry_id": "5f400e2e-895f-3503-ba4e-7e08eebe8cfe",
                        "source_sense_id": "8e7776da-d551-30b1-9caa-d4f2644ab33f",
                        "source_sense_description": "time in between",
                        "target_lang_word": "ondertussen",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ondertussen",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "24cc7890-1fb2-340e-a91f-c81aa5a8df73",
                                        "entry_id": "57845c53-5915-3758-9d99-3818f0be08d6",
                                        "glosses": [
                                            "in de tussentijd"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28f1dbe7-ec1d-4adf-8436-245bd36b7543",
                                                "sense_id": "24cc7890-1fb2-340e-a91f-c81aa5a8df73",
                                                "text": "Er is ondertussen veel tijd verloren gegaan."
                                            },
                                            {
                                                "example_id": "09db31bf-6db1-4fdd-a870-a0db50db0fd2",
                                                "sense_id": "24cc7890-1fb2-340e-a91f-c81aa5a8df73",
                                                "text": "Het was ondertussen geheel donker geworden."
                                            },
                                            {
                                                "example_id": "c19c8d07-ed07-423c-af5d-ba758a7efcc8",
                                                "sense_id": "24cc7890-1fb2-340e-a91f-c81aa5a8df73",
                                                "text": "De Franse traditie ziet er heel anders uit, zoals de Britse trendwatcher Stephen Bayley opmerkte. Je rijdt op je gemak over een met platanen omzoomde tweebaansweg, in een comfortabele auto, bij voorkeur een Citroën DS. Ondertussen zoekt je passagier in de Michelingids een restaurant waar je goed en uitgebreid kunt lunchen."
                                            },
                                            {
                                                "example_id": "782a877e-5949-4b6a-b7ff-4397645dfc65",
                                                "sense_id": "24cc7890-1fb2-340e-a91f-c81aa5a8df73",
                                                "text": "In veel winkels zijn ondertussen lege schappen te vinden. Vooral versproducten als zuivel, vlees, fruit en eieren zijn nog moeilijk te krijgen. Dat komt enerzijds doordat de blokkades het onmogelijk maken om de producten aan te vullen en anderzijds doordat de producten die nog beschikbaar zijn bederven en dus weggegooid moeten worden."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d40058a3-73ea-4312-b189-d1d070edc81c",
                        "source_entry_id": "5f400e2e-895f-3503-ba4e-7e08eebe8cfe",
                        "source_sense_id": "8e7776da-d551-30b1-9caa-d4f2644ab33f",
                        "source_sense_description": "time in between",
                        "target_lang_word": "pendant ce temps",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pendant ce temps",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4d8552b2-6ea0-38ef-889d-83a1ad6aacbd",
                                        "entry_id": "80f379f1-b799-307a-ada6-75c9f1d07946",
                                        "glosses": [
                                            "En même temps (période) mais dans un autre lieu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02db8bbd-a664-4a1b-b794-06ac7559c953",
                                                "sense_id": "4d8552b2-6ea0-38ef-889d-83a1ad6aacbd",
                                                "text": "Pendant ce temps, dans la cité géante, le mouvement insurrectionnel échappait à tout contrôle."
                                            },
                                            {
                                                "example_id": "1d7be79a-abb8-473a-bc26-83e7a19ae34a",
                                                "sense_id": "4d8552b2-6ea0-38ef-889d-83a1ad6aacbd",
                                                "text": "Écoute, je comprends que tu adores ce clebs et les chevaux et tout le truc qui va autour, mais pendant ce temps-là tu vois pas ce qui se passe vraiment, le monde change et toi tu es larguée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2b5b03ca-8aec-47f1-973d-a2a20bd8f03b",
                        "source_entry_id": "5f400e2e-895f-3503-ba4e-7e08eebe8cfe",
                        "source_sense_id": "8e7776da-d551-30b1-9caa-d4f2644ab33f",
                        "source_sense_description": "time in between",
                        "target_lang_word": "en attendant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "en attendant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d972b252-5911-3b61-bac6-f452bd9dc5a6",
                                        "entry_id": "42c88035-a5aa-3ac7-a558-8f765c82f125",
                                        "glosses": [
                                            "Jusqu’à tel moment, jusqu’à tel temps, déterminé par ce qui précède."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cbae3f2b-007e-44ce-8d01-4098e40c0b68",
                                                "sense_id": "d972b252-5911-3b61-bac6-f452bd9dc5a6",
                                                "text": "D'abord réservées aux scientifiques, les Pyrénées ont ensuite accueilli un tourisme prudent en attendant les pyrénéistes, ivres de conquêtes."
                                            },
                                            {
                                                "example_id": "4188593d-5750-40e0-bd4b-35f7bc58c0a0",
                                                "sense_id": "d972b252-5911-3b61-bac6-f452bd9dc5a6",
                                                "text": "Je vais, en attendant, copier cette lettre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e5d786db-48b0-3345-b3d3-db1a0212a439",
                                        "entry_id": "42c88035-a5aa-3ac7-a558-8f765c82f125",
                                        "glosses": [
                                            "Sans prendre quelque chose en compte, en l'excluant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b868ba26-98e7-4aee-a26b-c11ebed414fe",
                                                "sense_id": "e5d786db-48b0-3345-b3d3-db1a0212a439",
                                                "text": "Ils cherchent avec courage mais en attendant il n'ont toujours rien trouvé."
                                            },
                                            {
                                                "example_id": "72ca53a4-4c63-4272-b704-7de81c11f8b2",
                                                "sense_id": "e5d786db-48b0-3345-b3d3-db1a0212a439",
                                                "text": "En attendant, viens boire une bonne bière !"
                                            },
                                            {
                                                "example_id": "32198c77-c2c9-4525-a455-cd5e35f65a8c",
                                                "sense_id": "e5d786db-48b0-3345-b3d3-db1a0212a439",
                                                "text": "En attendant, l’expertocratie est le gouvernement des experts, — ceux qui savent."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
