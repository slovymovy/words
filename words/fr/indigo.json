                    ]
                },
                {
                    "sense_id": "7ad584a1-e83a-3d59-aa59-786be8163de8",
                    "sense_definition": "Substance tinctoriale d'un bleu profond, extraite de certaines plantes ou obtenue par synthèse chimique.",
