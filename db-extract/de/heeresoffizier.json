                "senses": [
                    {
                        "sense_id": "76060ba6-4112-3576-a6d1-dbf7bfe6a3b8",
                        "entry_id": "56f14529-addd-34bc-9576-8d5e3973ec8d",
                        "glosses": [
                            "Offizier des Heeres"
