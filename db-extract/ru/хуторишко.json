                        "tags": [],
                        "examples": [
                            {
                                "example_id": "88910ead-b098-4817-8208-7b2d6e1976a2",
                                "sense_id": "f3ce7f95-1e6e-310c-a1b8-e71a8e88017f",
                                "text": "Я тоже хочу продать домишко и поеду куда-нибудь, куплю себе хуторишко над Днепром."
                            },
                            {
                                "example_id": "d199c4a2-0fcb-4559-9c43-fd10807ae2b1",
                                "sense_id": "f3ce7f95-1e6e-310c-a1b8-e71a8e88017f",
                                "text": "На этот раз Чапаев ошибся: гонимые казаки и не вздумали цепляться в хуторишке, они постреляли только для острастки и дали тёку, не оказав сопротивленья."
                            }
                        ]
                    }
