                    }
                ],
                "translations": [
                    {
                        "translation_id": "c97fc833-0ad6-4fd8-84c4-ec920a94c23b",
                        "source_entry_id": "357dab41-3d4b-3131-ae56-f1e515528040",
                        "source_sense_id": "2c3a4ec4-cec3-3945-9a44-a26e2458aa6e",
                        "target_lang_word": "Gottesdienst",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gottesdienst",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ce397ccd-3b2d-3812-96b2-d32b723a9a15",
                                        "entry_id": "50870324-5560-3030-ae31-eb71325a2954",
                                        "glosses": [
                                            "Zusammenkunft von Gläubigen, wobei nach einer Liturgie Gott zu Ehren gebetet und/oder gefeiert wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc36ec4f-93af-4491-a35b-16287bcf155a",
                                                "sense_id": "ce397ccd-3b2d-3812-96b2-d32b723a9a15",
                                                "text": "In einem evangelischen oder auch katholischen Gottesdienst wird meist auch eine Predigt gehalten."
                                            },
                                            {
                                                "example_id": "4e86ebad-454c-48d2-a61a-7f513f9baee6",
                                                "sense_id": "ce397ccd-3b2d-3812-96b2-d32b723a9a15",
                                                "text": "„Der Gottesdienst war fast vorbei, und der Pfarrer hatte den Gläubigen bereits den Segen gespendet.“"
                                            },
                                            {
                                                "example_id": "e8a836be-b9bc-4570-b480-75b180100916",
                                                "sense_id": "ce397ccd-3b2d-3812-96b2-d32b723a9a15",
                                                "text": "„Am Konversenchor hinter dem Lettner versammelten sich die Laienbrüder, Konversen und Donaten jeweils getrennt in ihrem eigenen Chorgestühl, um am Gottesdienst und dem gemeinsamen Gesang teilzunehmen.“"
                                            },
                                            {
                                                "example_id": "cd849fb0-1c48-4ce0-b95c-6576d798a8e1",
                                                "sense_id": "ce397ccd-3b2d-3812-96b2-d32b723a9a15",
                                                "text": "„Öfters war Gottesdienst in der Kirche von Chailly.“"
                                            },
                                            {
                                                "example_id": "b059ced9-97f6-4b6c-ab35-08d0f77c953e",
                                                "sense_id": "ce397ccd-3b2d-3812-96b2-d32b723a9a15",
                                                "text": "„Die Bedeutung des Wortes Gottesdienst ging mir auf.“"
                                            },
                                            {
                                                "example_id": "11b1fd28-3186-4d21-ad52-01e912fbc0ab",
                                                "sense_id": "ce397ccd-3b2d-3812-96b2-d32b723a9a15",
                                                "text": "„Die Moschee bietet die Möglichkeit, sich dort zu den fünf obligatorischen Gebeten pro Tag und zum Freitagsgottesdienst zu treffen. Geleitet werden diese Gebete und Gottesdienste von einem Imam.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
