        "nl-extract.jsonl": [
            {
                "entry_id": "d2599744-7b19-3337-a831-228611d640a9",
                "word": "demonstratief",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "2701c0cd-d055-3b4f-949b-8cb34fecd0b7",
                        "entry_id": "d2599744-7b19-3337-a831-228611d640a9",
                        "glosses": [
                            "erop gericht om de aandacht te trekken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e2f8969-3638-4be6-8aa1-4bed7bfc021b",
                                "sense_id": "2701c0cd-d055-3b4f-949b-8cb34fecd0b7",
                                "text": "Hij keerde demonstratief zijn rug naar de rechtsorde. Daar keek niemand van op. Van te voren had hij laten weten: „Ik als gelovige laat mij leiden door de richtlijnen die Allah mij geeft. Ik heb niets te maken met wereldlijke wetten.”"
                            },
                            {
                                "example_id": "694e7105-4f70-4424-9ba7-f3ffb556a634",
                                "sense_id": "2701c0cd-d055-3b4f-949b-8cb34fecd0b7",
                                "text": "'Hoe laat?' Martina keek demonstratief op haar klokje."
                            }
                        ]
                    },
                    {
                        "sense_id": "7105abe5-c51c-3dd2-ab2f-92c270862358",
                        "entry_id": "d2599744-7b19-3337-a831-228611d640a9",
                        "glosses": [
                            "aanwijzend"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "61797ed9-f55d-440f-a821-6f82ff285e5e",
                        "source_entry_id": "d2599744-7b19-3337-a831-228611d640a9",
                        "target_lang_word": "démonstratif",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "démonstratif",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c44bf21c-1c25-37b5-bc77-9f44482af06f",
                                        "entry_id": "b7148c03-3fee-3f09-9d21-7849b283d919",
                                        "glosses": [
                                            "Qui démontre, qui sert à démontrer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6209118-7b30-4ed5-8b04-ea643dae72bb",
                                                "sense_id": "c44bf21c-1c25-37b5-bc77-9f44482af06f",
                                                "text": "L’opérativité philosophique défactualise, et elle défactualise si bien qu’elle fait surgir à elle seule tout un monde – celui des enchaînements démonstratifs – où il n’y a plus de défaillance, de fatigue, de maladie, de mort."
                                            },
                                            {
                                                "example_id": "1874bb40-ad9b-4413-87fc-d279bcf62f03",
                                                "sense_id": "c44bf21c-1c25-37b5-bc77-9f44482af06f",
                                                "text": "Il était inventeur et mécanicien. Il tirait un crayon de sa poche et faisait des figures démonstratives sur les dessins de mon père désolé. Il lui gâtait ainsi deux ou trois études par semaine…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b1a33fd5-a83e-3352-8035-e1fa96784c15",
                                        "entry_id": "b7148c03-3fee-3f09-9d21-7849b283d919",
                                        "glosses": [
                                            "Qui a pour objet la louange ou le blâme de tel ou tel personnage dans un discours d’apparat, dans une oraison funèbre, etc."
                                        ],
                                        "tags": [
                                            "rhetoric"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b907958c-bee2-4fc2-a7a7-cf901c13b452",
                                                "sense_id": "b1a33fd5-a83e-3352-8035-e1fa96784c15",
                                                "text": "Genre démonstratif."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e9109ce-1745-3a14-9638-99d6072551b9",
                                        "entry_id": "b7148c03-3fee-3f09-9d21-7849b283d919",
                                        "glosses": [
                                            "Qui sert à montrer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bfdee21a-4f61-4d2a-9495-7768f54c4c0f",
                                                "sense_id": "0e9109ce-1745-3a14-9638-99d6072551b9",
                                                "text": "Adjectif démonstratif : (Grammaire) Qui sert à montrer la personne ou la chose désignée par le nom que détermine cet adjectif. → voir Adjectifs démonstratifs en français"
                                            },
                                            {
                                                "example_id": "4b888568-3e9a-4e25-ae4c-ec289b908486",
                                                "sense_id": "0e9109ce-1745-3a14-9638-99d6072551b9",
                                                "text": "Pronom démonstratif : (Grammaire) Qui sert à insister sur la personne ou sur la chose en question. → voir Pronoms démonstratifs en français"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e13831e-7c4b-392b-8d8e-778f672f3004",
                                        "entry_id": "b7148c03-3fee-3f09-9d21-7849b283d919",
                                        "glosses": [
                                            "Qui donne des signes extérieurs d’affection, de bienveillance, d’intérêt, de zèle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe0e1cc3-f44b-490e-a247-204a8a1ffab6",
                                                "sense_id": "3e13831e-7c4b-392b-8d8e-778f672f3004",
                                                "text": "Cet homme n’est pas démonstratif, mais on peut compter sur lui."
                                            },
                                            {
                                                "example_id": "74a367cf-11d3-4394-a266-7e68244fe3ce",
                                                "sense_id": "3e13831e-7c4b-392b-8d8e-778f672f3004",
                                                "text": "Elle est peu démonstrative, mais son cœur est excellent."
                                            }
                                        ]
                                    }
                                ]
                            },
