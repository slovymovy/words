                    "target_lang_definitions": {
                        "ru": "Пустое место в документе или бланке, которое нужно заполнить.",
                        "zh": "指文件或表格中需要填写的空白处。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пропуск",
                                "target_lang_sense_clarification": "в тексте"
                            },
                            {
                                "target_lang_word": "пробел",
                                "target_lang_sense_clarification": "пустое место"
                            },
                            {
                                "target_lang_word": "пустое место",
                                "target_lang_sense_clarification": "для заполнения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "空格",
                                "target_lang_sense_clarification": "指填空处"
                            },
                            {
                                "target_lang_word": "空白处",
                                "target_lang_sense_clarification": "指留白的地方"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a79335be-f4a5-3550-83b0-57c3d6376b10",
                    "sense_definition": "A cartridge containing gunpowder but no bullet.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ammunition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gun was loaded with <w>blanks</w> for the movie scene.",
                            "target_lang_translations": {
                                "ru": "Для сцены в кино пистолет был заряжен <w>холостыми</w>.",
                                "zh": "为了拍摄电影场景，枪里装的是<w>空包弹</w>。"
                            }
                        },
                        {
                            "text": "He fired two <w>blanks</w> into the air to start the race.",
                            "target_lang_translations": {
                                "ru": "Он выстрелил двумя <w>холостыми</w> в воздух, чтобы начать гонку.",
                                "zh": "他向空中鸣放两发<w>空包弹</w>以开始比赛。"
                            }
                        }
                    ],
                    "synonyms": [
