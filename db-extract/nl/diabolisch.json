                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bcc1e5bb-9b7a-478c-a285-068dd40088df",
                                                "sense_id": "0fcff4bb-95ee-3653-aa5f-0e8c0bd15099",
                                                "text": "Die diabolische Geschichte erweckt bei mir völliges Entsetzen."
                                            },
                                            {
                                                "example_id": "2e3230b6-6130-47ad-a3be-3ed23e3e4601",
                                                "sense_id": "0fcff4bb-95ee-3653-aa5f-0e8c0bd15099",
                                                "text": "„Ein Russe, Pavel Chekov, steuerte das Schiff - und ein diabolisch aussehender, gefühlsarmer Vulkanier war der wichtigste Berater des Captains.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aff550b0-6a8b-4b1d-8c3b-805390619708",
                        "source_entry_id": "bf1a29c1-94f1-3413-b9a9-48b934afc889",
                        "source_sense_id": "f5805779-87a4-3abf-8765-4b3af3aad098",
                        "target_lang_word": "diabolic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
