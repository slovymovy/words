                    {
                        "translation_id": "ee58ee73-7054-42d5-a26e-f134bbaeb6d4",
                        "source_entry_id": "5a21805b-7a13-3579-b380-b59610b1be01",
                        "source_sense_id": "ab40aaec-b562-33e8-8467-a0cba63b62a1",
                        "source_sense_description": "Luftfahrt: Clearance, Freigabe",
                        "target_lang_word": "Clearance",
