                    {
                        "translation_id": "b78574ad-14b4-412c-b14a-f8ce7ae68a42",
                        "source_entry_id": "a637121b-2925-315d-b5f1-d744733c432a",
                        "source_sense_description": "meagre allowance of money or wages",
                        "target_lang_word": "Hungerlohn",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hungerlohn",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "baec712e-883f-3d4c-b8d6-4e6a3d1518d6",
                                        "entry_id": "99f7a409-ff47-3daf-8558-493faaef2c44",
                                        "glosses": [
                                            "äußerst geringer Lohn"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1a97fd1-3e15-4a24-92e9-15488ba2e117",
                                                "sense_id": "baec712e-883f-3d4c-b8d6-4e6a3d1518d6",
                                                "text": "Er erhielt für seine Tätigkeit nur einen Hungerlohn."
                                            },
                                            {
                                                "example_id": "3d0c9bc5-472e-44c5-a634-178676afe463",
                                                "sense_id": "baec712e-883f-3d4c-b8d6-4e6a3d1518d6",
                                                "text": "„Und auch das ließ sich leicht bewerkstelligen, denn auf einer armen Insel gibt es natürlich jede Menge Arme, die bereit sind, für einen Hungerlohn zu schuften.“"
                                            },
                                            {
                                                "example_id": "28213e73-f3d0-42dc-b0f2-db3ec2a71deb",
                                                "sense_id": "baec712e-883f-3d4c-b8d6-4e6a3d1518d6",
                                                "text": "„Sie träumt davon, irgendwann ihr eigenes Hotel zu eröffnen und nicht mehr auf den Hungerlohn angewiesen zu sein, den ihr der Hotelbesitzer zahlt.“"
                                            },
                                            {
                                                "example_id": "8ecb92e0-f649-41f9-a5f3-0690e940ba21",
                                                "sense_id": "baec712e-883f-3d4c-b8d6-4e6a3d1518d6",
                                                "text": "„Er bekommt einen Hungerlohn, aber wenigstens wird er bezahlt.“"
                                            },
                                            {
                                                "example_id": "6cfb19eb-1cdb-4d05-b6e0-296dfc9be3f7",
                                                "sense_id": "baec712e-883f-3d4c-b8d6-4e6a3d1518d6",
                                                "text": "„Aber er hatte ja auch Vorteile davon: Er bekam billige Arbeitskräfte, wurde bekocht und konnte sein Personal mit einem Hungerlohn abspeisen.“"
                                            },
                                            {
                                                "example_id": "ebec3024-64e5-4670-a92f-38d913556756",
                                                "sense_id": "baec712e-883f-3d4c-b8d6-4e6a3d1518d6",
                                                "text": "„Tägliche Arbeitszeiten von 14 Stunden für einen Hungerlohn waren keine Seltenheit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
