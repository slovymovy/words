    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1b6966ce-6a1a-324d-9234-b85e95597f30",
                    "sense_definition": "Passage d'un texte ou propos rapporté fidèlement et textuellement.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "texte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le professeur a commencé sa leçon par une <w>citation</w> célèbre de Victor Hugo."
                        },
                        {
                            "text": "N'oubliez pas d'indiquer l'auteur entre parenthèses après chaque <w>citation</w>."
                        }
                    ],
                    "synonyms": [
                        "extrait"
                    ],
                    "common_phrases": [
                        "citation célèbre",
                        "courte citation"
                    ]
                },
                {
                    "sense_id": "0a06a6de-8a4f-3f2f-9e3d-4221754183d1",
                    "sense_definition": "Acte officiel par lequel une personne est sommée de comparaître devant un tribunal.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "droit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le témoin a reçu une <w>citation</w> à comparaître pour l'audience de demain matin."
                        },
                        {
                            "text": "L'huissier est venu lui remettre une <w>citation</w> en justice à son domicile."
                        }
                    ],
                    "synonyms": [
                        "assignation",
                        "convocation"
                    ],
                    "common_phrases": [
                        "citation à comparaître",
                        "citation directe"
                    ]
                },
                {
                    "sense_id": "6d106a33-1166-36c9-8d76-cbd97fca672c",
                    "sense_definition": "Action de citer ou de reproduire les termes exacts d'un auteur ou d'une personne.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "texte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La <w>citation</w> d'extraits d'œuvres protégées est autorisée sous certaines conditions légales strictes."
                        },
                        {
                            "text": "Il a fait une <w>citation</w> maladroite des propos du ministre lors de la réunion."
                        }
                    ],
                    "common_phrases": [
                        "droit de citation"
                    ]
                },
                {
                    "sense_id": "db975cde-283f-3df6-a70f-131a94523cf2",
                    "sense_definition": "Distinction militaire honorifique récompensant une action d'éclat au combat.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "militaire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce soldat courageux a reçu une <w>citation</w> à l'ordre de l'armée pour sa bravoure."
                        },
                        {
                            "text": "Le général a lu la <w>citation</w> devant tout le régiment réuni pour la cérémonie."
                        }
                    ],
                    "common_phrases": [
                        "citation à l'ordre"
                    ]
                }
            ]
        }
    ]
