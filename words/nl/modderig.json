                    "frequency": "Middle",
                    "semantic_group_id": "toestand",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij loopt met zijn <w>modderige</w> laarzen door het pas schoongemaakte huis.",
                            "target_lang_translations": {
                                "fr": "Il marche avec ses bottes <w>boueuses</w> dans la maison qui vient d'être nettoyée."
                            }
                        },
                        {
                            "text": "Trek je <w>modderige</w> schoenen uit voordat je naar binnen stapt.",
                            "target_lang_translations": {
