                "forms": [],
                "senses": [
                    {
                        "sense_id": "6e82e1d3-9449-31a0-8ed1-ec1aa0fca5af",
                        "entry_id": "611cc186-8f53-38b8-8217-a7629defb8db",
                        "glosses": [
                            "pisemne zapytanie kierowane do członka rządu przez parlamentarzystę"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf7a6e9a-80df-43b6-96fb-74c1e997c890",
                                "sense_id": "6e82e1d3-9449-31a0-8ed1-ec1aa0fca5af",
                                "text": "Cezary Miżejewski (PPS) jest inicjatorem interpelacji do ministra sprawiedliwości w sprawie delegalizacji organizacji neofaszystowskich i skrajnej prawicy w Polsce."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3b2946eb-bc5e-4322-bf76-32751992db4e",
                        "source_entry_id": "611cc186-8f53-38b8-8217-a7629defb8db",
                        "source_sense_id": "6e82e1d3-9449-31a0-8ed1-ec1aa0fca5af",
                        "target_lang_word": "interpellation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "interpellation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dd91150c-a1b2-3a72-ba2d-fb70aaf21fa0",
                                        "entry_id": "e76dc84e-1fae-376c-868e-3f17d751cc0d",
                                        "glosses": [
                                            "The act of interpellating (questioning); the period in which government officials are questioned about and explain an act, a policy or a point raised during a debate."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac8054e3-91aa-4617-a759-404c242c6a05",
                                                "sense_id": "dd91150c-a1b2-3a72-ba2d-fb70aaf21fa0",
                                                "text": "While the petition was circulating, a Progressive deputy asked the Minister of the Interior what the Prussian government intended to do about it. The interpellation was intended to elicit a condemnation, but the minister’s pro forma reply that the government did not intend to abrogate Jewish rights was seen by the petitioners as an encouraging sign."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a01eede9-316f-33ef-8e59-b1797db087a8",
                                        "entry_id": "e76dc84e-1fae-376c-868e-3f17d751cc0d",
                                        "glosses": [
                                            "The act of interpellating: the act of identification."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2d8c54eb-783a-3d27-8d53-da571a1ab669",
                                        "entry_id": "e76dc84e-1fae-376c-868e-3f17d751cc0d",
                                        "glosses": [
                                            "The act of interpelling: interruption."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d538face-70a2-4821-9e5b-01307605b548",
                        "source_entry_id": "611cc186-8f53-38b8-8217-a7629defb8db",
