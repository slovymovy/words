                    },
                    {
                        "translation_id": "334c95fd-39ea-412d-b611-b1b6719bf49f",
                        "source_entry_id": "fe4891b8-17c6-3c00-a379-519dff28083e",
                        "source_sense_id": "866ea2f9-418d-3ed7-ba1a-b5bd0a0c477e",
                        "target_lang_word": "parapet",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "parapet",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "062c38a9-ec9f-3419-9550-02abc75b4c96",
                                        "entry_id": "5caf6ed3-6e70-3a60-87ca-36749a8ec176",
                                        "glosses": [
                                            "Massif de terre ou de maçonnerie qui surmonte un rempart ou une tranchée et qui les protège contre le feu de l’ennemi."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42110bbc-e8ec-486e-a0b2-e902431e125a",
                                                "sense_id": "062c38a9-ec9f-3419-9550-02abc75b4c96",
                                                "text": "Derrière ces abattis, j'élève un parapet avec une banquette & un fossé en avant. Je place, derrière ce parapet, des compagnies de Chasseurs & l’Infanterie des Troupes Légères."
                                            },
                                            {
                                                "example_id": "adbd5653-34cd-40a6-a9f2-b809a9c2ad99",
                                                "sense_id": "062c38a9-ec9f-3419-9550-02abc75b4c96",
                                                "text": "Les meurtrières pratiquées dans les merlons de pierre restaient démasquées dans leur partie inférieure et permettaient aux arbalétriers postés au dedans du parapet sur ce chemin de ronde de lancer des traits sur les assaillants."
                                            },
                                            {
                                                "example_id": "878d9f70-04e1-45ee-8c8c-87d5b0bbd3b0",
                                                "sense_id": "062c38a9-ec9f-3419-9550-02abc75b4c96",
                                                "text": "Les Boches préparaient un « sale » coup, et Luc, de quart au périscope, avait donné l’alerte à sa tranchée. Presque aussitôt le bacchanal se déchaîne : les obus pleuvent, les parapets sautent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "206859bb-8f7b-3199-8eb3-c98f2976942e",
                                        "entry_id": "5caf6ed3-6e70-3a60-87ca-36749a8ec176",
                                        "glosses": [
                                            "Muret à hauteur d’appui, élevé sur le bord d’une terrasse, sur les côtés d’un pont, le long d’un quai, etc., pour servir de garde-fou."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7a7aa33-3659-4b23-a5db-df38a0cc56c0",
                                                "sense_id": "206859bb-8f7b-3199-8eb3-c98f2976942e",
                                                "text": "Ce n’était qu’un balcon isolé, garanti comme à l’ordinaire par un parapet, avec des embrasures près desquelles quelques archers pouvaient se placer pour défendre la tourelle."
                                            },
                                            {
                                                "example_id": "732b79df-b93c-44b8-bc0b-f1a623fbc826",
                                                "sense_id": "206859bb-8f7b-3199-8eb3-c98f2976942e",
                                                "text": "L’eau sombre, au bas du parapet, s’étalait silencieuse avec le reflet immobile des lumières."
                                            },
                                            {
                                                "example_id": "ef537706-a70e-439b-8472-1403c2733ab4",
                                                "sense_id": "206859bb-8f7b-3199-8eb3-c98f2976942e",
                                                "text": "Les premiers soirs, je ne franchissais pas la Seine. Je m’accoudais aux parapets des ponts – ces parapets que j’aime à cause de Baudelaire et de Maurice de Guérin qui s’y sont accoudés, mais aussi tant de personnages inventés !"
                                            },
                                            {
                                                "example_id": "8646e999-f9e0-40f2-8dce-4da2f81935e8",
                                                "sense_id": "206859bb-8f7b-3199-8eb3-c98f2976942e",
                                                "text": "On a bordé le chemin d’un parapet pour prévenir les malheurs : cela faisait que je pouvais contempler au fond et gagner des vertiges tout à mon aise ; car ce qu’il y a de plaisant dans mon goût pour les lieux escarpés, est qu’ils me font tourner la tête ; et j’aime beaucoup ce tournoiement, pourvu que je sois en sûreté."
                                            },
                                            {
                                                "example_id": "d4a150ee-700b-4362-87ed-a1035a77c621",
                                                "sense_id": "206859bb-8f7b-3199-8eb3-c98f2976942e",
                                                "text": "Je regrette l'Europe aux anciens parapets."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "06def732-f1ec-33ef-a4bc-637eba7f13a8",
                                        "entry_id": "5caf6ed3-6e70-3a60-87ca-36749a8ec176",
                                        "glosses": [
                                            "Garde-fou, protection."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "86508198-9a7d-4f66-a2c2-60e3818916e4",
                                                "sense_id": "06def732-f1ec-33ef-a4bc-637eba7f13a8",
                                                "text": "Qu’il s'agisse de morale ou de politique, du théâtre classique ou de la métaphysique orthodoxe, il est l’ennemi-né de tous les parapets et de toutes les lois."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
