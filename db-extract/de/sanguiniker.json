                ],
                "senses": [
                    {
                        "sense_id": "24afe8aa-7eae-3f90-b3af-56646f83c89b",
                        "entry_id": "e539376b-5936-3729-bcf0-5da709244945",
                        "glosses": [
                            "ein lebhafter und leichtblütiger Mensch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27ed163c-fe22-4950-8874-133cfdb4f011",
                                "sense_id": "24afe8aa-7eae-3f90-b3af-56646f83c89b",
                                "text": "Ständig ist dieser Sanguiniker am Träumen."
                            },
                            {
                                "example_id": "36f48ad5-232f-4137-8835-bb348a4ff9b2",
                                "sense_id": "24afe8aa-7eae-3f90-b3af-56646f83c89b",
                                "text": "„Er war ein ungefähr vierzigjähriger Mann von mittlerer Größe und Figur, nur die rötliche Gesichtsfarbe verriet den ausgeprägten Sanguiniker.“"
                            },
                            {
                                "example_id": "ce21bb74-4145-4039-9565-7f0fbd6e2ea5",
                                "sense_id": "24afe8aa-7eae-3f90-b3af-56646f83c89b",
                                "text": "„Wenn das, dann war er aber ein Sanguiniker der labilen Bauart.“"
                            },
                            {
                                "example_id": "d79d5b0b-13eb-42c0-b8a7-15eb6ee9e49d",
                                "sense_id": "24afe8aa-7eae-3f90-b3af-56646f83c89b",
                                "text": "„Der Sanguiniker Mirabeau lebt aus dem vollen, er ist ein Nichtsnutz, aber gesund an Temperament und immer natürlich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
