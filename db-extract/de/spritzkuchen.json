                "senses": [
                    {
                        "sense_id": "e009144a-2758-3a76-ab82-508504731c63",
                        "entry_id": "e52fbb27-7fa9-3063-b565-a48757b96a38",
                        "glosses": [
                            "pastry made of choux pastry and formed as a ring (similar to doughnuts) with a pastry bag (see photo) that is fried (and generally has a sugar icing)"
                        ],
                        "tags": [
                            "masculine",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "297630e3-7fa9-4333-a5a3-23b039787e5d",
                                "sense_id": "e009144a-2758-3a76-ab82-508504731c63",
                                "text": "Dann wurde Karussell gefahren, Eis, gebrannte Mandeln und Spritzkuchen gegessen und wieder Karussell gefahren, schlecht wurde ihnen dabei nie.",
                                "translation": "Then they rode on a merry-go-round, ate ice cream, candied almonds and Spritzkuchen and rode again on a merry-go-round, they never felt sick.",
                                "english": "Then they rode on a merry-go-round, ate ice cream, candied almonds and Spritzkuchen and rode again on a merry-go-round, they never felt sick."
                            }
                        ]
                    }
