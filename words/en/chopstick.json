    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f4a3bd1c-6b94-3db6-925d-43a7309ba8a5",
                    "sense_definition": "An East Asian eating utensil, usually used as a pair and held in one hand to grip pieces of food.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "eating_utensils",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She struggled to eat her noodles with <w>chopsticks</w> at the restaurant.",
                            "target_lang_translations": {
                                "ru": "В ресторане ей с трудом удавалось есть лапшу <w>палочками</w>."
                            }
                        },
                        {
                            "text": "The waiter brought a pair of wooden <w>chopsticks</w> along with the sushi platter.",
                            "target_lang_translations": {
                                "ru": "Официант принес пару деревянных <w>палочек</w> вместе с ассорти суши."
                            }
                        }
                    ],
                    "common_phrases": [
                        "pair of chopsticks",
                        "use chopsticks",
                        "wooden chopsticks"
                    ],
                    "target_lang_definitions": {
                        "ru": "Восточноазиатский столовый прибор, обычно используемый в паре и удерживаемый одной рукой для захвата кусочков пищи."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "палочка для еды",
                                "target_lang_sense_clarification": "один столовый прибор"
                            },
                            {
                                "target_lang_word": "китайские палочки",
                                "target_lang_sense_clarification": "пара палочек для еды"
                            },
                            {
                                "target_lang_word": "палочка",
                                "target_lang_sense_clarification": "в контексте еды"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b4011f46-8359-36c9-ac7d-20cb933dbd6a",
                    "sense_definition": "A long straight stick forming part of various fishing tackle arrangements.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "fishing_gear",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fisherman attached a <w>chopstick</w> to the line to keep the hooks separated.",
                            "target_lang_translations": {
                                "ru": "Рыбак прикрепил к леске <w>отвод</w>, чтобы крючки не сходились друг с другом."
                            }
                        },
                        {
                            "text": "This traditional rig uses a metal <w>chopstick</w> to prevent the bait from tangling.",
                            "target_lang_translations": {
                                "ru": "В этой традиционной оснастке используется металлический <w>отвод</w> для предотвращения запутывания приманки."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Primarily used in specific angling contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Длинный прямой стержень или отвод, используемый в различных рыболовных оснастках для предотвращения запутывания поводков."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отвод",
                                "target_lang_sense_clarification": "в рыболовной оснастке"
                            },
                            {
                                "target_lang_word": "коромысло",
                                "target_lang_sense_clarification": "рыболовное приспособление"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8795058a-8e81-3dd2-8946-7379017922fd",
                    "sense_definition": "An offensive slang term for an Asian person.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The movie depicted historical prejudice, with characters using terms like <w>chopstick</w> as a slur.",
                            "target_lang_translations": {
                                "ru": "В фильме были показаны исторические предрассудки: персонажи использовали такие слова, как <w>палочка</w>, в качестве оскорбления."
                            }
                        },
                        {
                            "text": "He was reprimanded for using the word <w>chopstick</w> in a derogatory manner.",
                            "target_lang_translations": {
                                "ru": "Ему сделали выговор за использование слова <w>палочка</w> в уничижительном смысле."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "highly offensive ethnic slur"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Оскорбительное сленговое обозначение человека азиатского происхождения."
                    },
                    "translations": {
                        "ru": []
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "804176ef-0645-399b-a093-9c9e17968dd6",
                    "sense_definition": "To pick up food, or eat, using chopsticks.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He carefully <w>chopsticked</w> the last piece of dim sum from the steamer basket.",
                            "target_lang_translations": {
                                "ru": "Он аккуратно <w>вытащил палочками</w> последний кусочек димсама из бамбуковой пароварки."
                            }
                        },
                        {
                            "text": "Instead of using a fork, she preferred to <w>chopstick</w> her rice.",
                            "target_lang_translations": {
                                "ru": "Вместо вилки она предпочитала <w>есть</w> рис <w>палочками</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Verbal use of the noun is informal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Брать еду или есть с помощью палочек для еды."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "есть палочками",
                                "target_lang_sense_clarification": "процесс употребления пищи"
                            },
                            {
                                "target_lang_word": "цеплять палочками",
                                "target_lang_sense_clarification": "брать еду палочками"
                            }
