                "senses": [
                    {
                        "sense_id": "b8511535-c59f-374b-aa96-dc072b15c1fa",
                        "entry_id": "b1237b68-d04c-33f9-90eb-4d4ab1706eb0",
                        "glosses": [
                            "oberstes beschlussfassendes Gremium einer Organisation"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a6c2927-26d8-47b5-a628-a0d6f0b47356",
                                "sense_id": "b8511535-c59f-374b-aa96-dc072b15c1fa",
                                "text": "„In den folgenden Sitzungen des Lenkungsausschusses sahen Frankreichs EVG-Diplomaten bald ein, daß sie mit Taschenspielertricks nun nicht mehr weiterkamen.“"
                            },
                            {
                                "example_id": "7b136f5e-83ba-4336-b0eb-eae91c0c5a53",
                                "sense_id": "b8511535-c59f-374b-aa96-dc072b15c1fa",
                                "text": "„Der Lenkungsausschuß hält eine jährliche ordentliche Tagung ab, deren Zeit und Ort vom Ausschuß bestimmt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
