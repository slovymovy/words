                                        "examples": [
                                            {
                                                "example_id": "8407bf47-ce38-4780-813c-a322970d0411",
                                                "sense_id": "e5d90ac7-0d49-3484-9d23-edd1bcb1fad7",
                                                "text": "Jorts are confusing. Do you want to wear jeans or shorts? Our guess is that what you're really saying is that you'd like to wear a longish, slouchy pair of shorts and not look too buttoned-up."
                                            },
                                            {
                                                "example_id": "1fcafe17-9208-4538-aca1-deea8c2690b4",
                                                "sense_id": "e5d90ac7-0d49-3484-9d23-edd1bcb1fad7",
                                                "text": "Although some feel that jorts include any manner of denim short regardless of length, others describe jorts as strictly of the knee-length, baggy variety."
                                            },
                                            {
                                                "example_id": "3997c198-b111-4b99-824b-9cb48ea9e72a",
                                                "sense_id": "e5d90ac7-0d49-3484-9d23-edd1bcb1fad7",
                                                "text": "Your dad wore jorts before you did and he's got the short frayed denim to prove it."
                                            },
                                            {
                                                "example_id": "e079e965-8302-41d1-84ef-ba44216b79cf",
                                                "sense_id": "e5d90ac7-0d49-3484-9d23-edd1bcb1fad7",
                                                "text": "They wore jorts and crop tops; or strappy, S&M-influenced getups; or pajamas emblazoned with cartoons."
                                            }
                                        ]
                                    }
