                        "sense_id": "70f76a49-c688-3b6c-8d3f-d30a1a6a709f",
                        "entry_id": "9d653b8d-e1d1-36e9-a22d-a13404500bee",
                        "glosses": [
                            "Chromoprotéine photoréceptrice jouant un rôle essentiel dans la photomorphogenèse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2fbf1d0-e941-427f-a866-228de5e907be",
                                "sense_id": "70f76a49-c688-3b6c-8d3f-d30a1a6a709f",
                                "text": "L’on voit donc la possibilité, à la suite de l'intervention d’un phytochrome d’obtenir la synthèse d’enzymes clefs dans les synthèses de substances induisant la floraison."
                            },
                            {
                                "example_id": "1b01f4ce-389c-4a6b-bc63-e5da3c9f0015",
                                "sense_id": "70f76a49-c688-3b6c-8d3f-d30a1a6a709f",
                                "text": "La chlorophylle absorbe la lumière rouge, mais elle n'est pas un récepteur semblable au phytochrome : elle transfère de l’énergie, alors que le phytochrome transfère de l’information."
                            }
                        ]
                    }
                ],
