                        "sense_id": "436848bc-ce4a-3fa6-92f1-6a41825049ed",
                        "entry_id": "84d77c59-f0d9-3d67-a8cc-4c65939ef74b",
                        "glosses": [
                            "Het fenomeen dat productieprocessen worden gedaan door (geprogrammeerde) machines."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "540193ed-d35e-47ac-b757-9dfe7bf873ba",
                                "sense_id": "436848bc-ce4a-3fa6-92f1-6a41825049ed",
                                "text": "De automatisering wint terrein en maakt ons leven eenvoudiger. Maar dat is niet het hele verhaal."
                            }
                        ]
                    },
                    {
                        "sense_id": "0754203b-d1e0-3d74-b5b9-006a8a6d356a",
                        "entry_id": "84d77c59-f0d9-3d67-a8cc-4c65939ef74b",
                        "glosses": [
                            "bedrijven die werkzaam zijn in het leveren en onderhouden van geprogrammeerde machines"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9afb9142-178e-46bc-8aaa-bb4a2af6d841",
                                "sense_id": "0754203b-d1e0-3d74-b5b9-006a8a6d356a",
                                "text": "Het bedrijf is werkzaam in de agrarische automatisering."
                            }
                        ]
                    }
                ],
