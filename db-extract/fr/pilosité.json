                        "translation_id": "b6001f68-786a-45b2-a07b-8fe560e8bc4e",
                        "source_entry_id": "93dbcfcf-9f11-3a98-a2eb-52e9cc02db75",
                        "source_sense_description": "Présence de poil, aspect pileux",
                        "target_lang_word": "hairiness",
