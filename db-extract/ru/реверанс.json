                "senses": [
                    {
                        "sense_id": "7a65be90-aec8-30e1-9bc6-cfd1359e5eb6",
                        "entry_id": "194dd2d1-5453-37ed-aeca-f5c9e082bd8c",
                        "glosses": [
                            "истор. старинная форма женского приветствия в виде глубокого поклона с лёгким приседанием"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "b3dece4e-5062-3fc3-9fdb-bb1778cc2601",
                        "entry_id": "194dd2d1-5453-37ed-aeca-f5c9e082bd8c",
                        "glosses": [
                            "перен. проявление подобострастия, почтительности"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8c3ec7a7-f6ea-4d6e-bbbb-5c59456613fb",
                        "source_entry_id": "194dd2d1-5453-37ed-aeca-f5c9e082bd8c",
                        "target_lang_word": "curtsey",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "curtsey",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bed31b69-4f5a-304f-920c-65cd84cb29fc",
                                        "entry_id": "1a240e8e-f4e9-355d-9d56-f77d46b6c4b0",
                                        "glosses": [
                                            "A small bow, generally performed by a woman or a girl, where she crosses the shin of one leg behind the calf of her other leg and briefly bends her knees to lower her body in deference."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da8138d4-74c6-4137-b321-49a74ab4068e",
                                                "sense_id": "bed31b69-4f5a-304f-920c-65cd84cb29fc",
                                                "text": "I refused to make so much as a curtsey for the passing nobles, as I am a staunch egalitarian."
                                            },
                                            {
                                                "example_id": "55e5b846-d0a2-4dd1-a580-469183a1239d",
                                                "sense_id": "bed31b69-4f5a-304f-920c-65cd84cb29fc",
                                                "text": "Wid. I take my leaue with many thouſand thankes. / Rich. The Match is made, ſhee ſeales it with a Curſie."
                                            },
                                            {
                                                "example_id": "1ad137df-79bd-4672-9e61-d90299abd2b7",
                                                "sense_id": "bed31b69-4f5a-304f-920c-65cd84cb29fc",
                                                "text": "[I]t was her favorite amusement to array herself in the faded brocades, and parade up and down before the long mirror, making stately courtesies, and sweeping her train about, with a rustle which delighted her ears."
                                            },
                                            {
                                                "example_id": "247b1209-8afa-42c1-921a-358a251facdf",
                                                "sense_id": "bed31b69-4f5a-304f-920c-65cd84cb29fc",
                                                "text": "No caps were touched, no curtseys bobbed."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "curtsey",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0cd37c7d-22bb-3931-aa36-dedc87f97c67",
                                        "entry_id": "1f3c5680-731b-34dd-8a11-28b164771154",
                                        "glosses": [
                                            "To make a curtsey."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b9f5fe9-b9af-4a19-8245-1090b94b4ce5",
                                                "sense_id": "0cd37c7d-22bb-3931-aa36-dedc87f97c67",
                                                "text": "The hotel's staff never curtsied, nodded, or bowed to the owner as she passed, as they were staunch egalitarians."
                                            },
                                            {
                                                "example_id": "1bfa825d-dbab-45ff-8f1c-031895d2cd01",
                                                "sense_id": "0cd37c7d-22bb-3931-aa36-dedc87f97c67",
                                                "text": "\"I’m sure you’ll excuse me, sir,\" said Mrs Varden, rising and curtseying."
                                            },
                                            {
                                                "example_id": "4476b519-dde4-47c6-aa1c-9bf9391e951b",
                                                "sense_id": "0cd37c7d-22bb-3931-aa36-dedc87f97c67",
                                                "text": "On the other hand, Mrs. Ladbrook was standing in skull-cap and front, with her turban in her hand, curtsying and smiling blandly[…]"
                                            },
                                            {
                                                "example_id": "1482045d-7caf-4828-aae5-3b86af14bf53",
                                                "sense_id": "0cd37c7d-22bb-3931-aa36-dedc87f97c67",
                                                "text": "'I be as nothing in the eyes of my lord,' and she curtseyed towards him[…]"
                                            },
                                            {
                                                "example_id": "ee43ad1c-5586-441e-821f-c61adc9f05dd",
                                                "sense_id": "0cd37c7d-22bb-3931-aa36-dedc87f97c67",
                                                "text": "1890, James Russell Lowell, Address in Publications of the Modern Language Association of America\nBut DANTE was a great genius, and language curtseys to its natural Kings."
                                            },
                                            {
                                                "example_id": "56b58e94-c23e-4478-9364-df366b188b53",
                                                "sense_id": "0cd37c7d-22bb-3931-aa36-dedc87f97c67",
                                                "text": "1903, W.E.B. DuBois, The Souls of Black Folk\nHe curtsied low, and then bowed almost to the ground, with an imperturbable gravity that seemed almost suspicious."
                                            },
                                            {
                                                "example_id": "208e53aa-988e-4448-a7db-398b5f7fc85b",
                                                "sense_id": "0cd37c7d-22bb-3931-aa36-dedc87f97c67",
                                                "text": "1908, Caroline Crawford, Folk Dances and Games\nThe gentleman bows and the lady curtesys (measure eight)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3bb20928-af8f-4831-9cba-6e7d01ea8ba3",
                        "source_entry_id": "194dd2d1-5453-37ed-aeca-f5c9e082bd8c",
                        "target_lang_word": "reverencia",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "reverencia",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "49def792-395c-3395-83ef-0e183edbeaa9",
                                        "entry_id": "78050bd2-f41f-3513-9560-868d29484d82",
                                        "glosses": [
                                            "Respeto o veneración que tiene una persona hacia otra."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f27a6b3-932b-42e8-8556-95057a0c7c44",
                                                "sense_id": "49def792-395c-3395-83ef-0e183edbeaa9",
                                                "text": "«Los desconcertantes resultados de las complicadas operaciones de su oficio, en las que había de ganar o perder la reverencia de su pueblo, les harían ser circunspectos y tercos, en dedicación exclusiva y excluyente, dependiendo de los demás para sus necesidades vitales»."
                                            },
                                            {
                                                "example_id": "ca2dfe52-00c4-453d-9052-fcd449620817",
                                                "sense_id": "49def792-395c-3395-83ef-0e183edbeaa9",
                                                "text": "«Un feto humano, sin más sentimientos que una ameba, goza de una reverencia y una protección legal que excede en gran medida a la que se le concede a un chimpancé adulto»."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ab781fc9-9650-34f0-bcd6-8234cc6b3795",
                                        "entry_id": "78050bd2-f41f-3513-9560-868d29484d82",
                                        "glosses": [
                                            "Inclinación del cuerpo en señal de respeto o veneración."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c8a92f5-d22b-468c-997a-e78cdfcb38bf",
                                                "sense_id": "ab781fc9-9650-34f0-bcd6-8234cc6b3795",
                                                "text": "«Si posees un cochecito de poco precio, guíalo tú misma. Y si el hijo de la portera se ofrece para ser tu chófer, no pretendas que te haga una reverencia ni que se quede con una mano en la empuñadura y la gorra en la otra»."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "a5393edc-2d38-3bb4-8f61-417699cdf20c",
                                        "entry_id": "78050bd2-f41f-3513-9560-868d29484d82",
                                        "glosses": [
                                            "Tratamiento que se da a los religiosos condecorados."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
                            {
                                "target_word": "reverencia",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "3349a3df-f5ce-3d45-8fc1-bf8270532bee",
                                        "entry_id": "c701c428-b073-31c0-8e94-5161eecb32c1",
                                        "glosses": [
                                            "Tercera persona del singular (él, ella, ello; usted, 2.ª persona) del presente de indicativo de reverenciar."
                                        ],
