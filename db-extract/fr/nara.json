            {
                "entry_id": "95a69981-9c2a-3d29-8163-b09eb33e411c",
                "word": "Nara",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "36af0e8e-8f6f-36a1-ac28-2a32f7e89d78",
                        "entry_id": "95a69981-9c2a-3d29-8163-b09eb33e411c",
                        "glosses": [
                            "Ville du Japon situé dans la région du Kansaï au Sud-Ouest de l’île de Honshu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d5ce1bc-964e-477b-98fb-810e216b3581",
                                "sense_id": "36af0e8e-8f6f-36a1-ac28-2a32f7e89d78",
                                "text": "Shinzo Abe, 67 ans, était en train de tenir un discours en fin de matinée lors d’un meeting électoral organisé sur un carrefour près d’une gare à Nara (ouest du Japon) avant des élections sénatoriales demain dans le pays."
                            }
                        ]
                    },
                    {
                        "sense_id": "7240d710-bf03-3fd2-9691-86e9917eac37",
                        "entry_id": "95a69981-9c2a-3d29-8163-b09eb33e411c",
                        "glosses": [
                            "Préfecture dont le chef-lieu est la précédente."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "066ac5fc-9b1e-4625-9b93-57a1bea6fb28",
                                "sense_id": "7240d710-bf03-3fd2-9691-86e9917eac37",
                                "text": "Shinzo Abe a été transféré en urgence dans un hôpital du département de Nara, à Kashihara, où il est arrivé à 12 h 20 en état « d’arrêt cardio-respiratoire », a déclaré lors d’une conférence de presse Hidetada Fukushima, professeur en médecine d’urgence de l’établissement."
                            }
                        ]
                    },
                    {
                        "sense_id": "369b663c-b414-3718-94a7-ccbf51f0a4f5",
                        "entry_id": "95a69981-9c2a-3d29-8163-b09eb33e411c",
                        "glosses": [
                            "Période historique s’étalant de l’an 710 à l’an 784 où la capitale impériale du Japon se situait dans cette ville."
                        ],
                        "tags": [
                            "metonymically"
                        ],
                        "examples": [
                            {
                                "example_id": "805fa405-a7bf-4683-87e0-fb2fbfe0430e",
                                "sense_id": "369b663c-b414-3718-94a7-ccbf51f0a4f5",
                                "text": "Certes à l’époque de Nara, vers 710, il existe des textes médicaux concernant les pratiques sexuelles et des « images des positions », osokuzu no e."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1984ced4-04df-4208-bcfe-f2754d3f8eb3",
                        "source_entry_id": "95a69981-9c2a-3d29-8163-b09eb33e411c",
                        "source_sense_id": "36af0e8e-8f6f-36a1-ac28-2a32f7e89d78",
