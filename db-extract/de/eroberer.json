                    {
                        "form_id": "fffbf14d-f026-45f1-be71-6959eb0031a0",
                        "entry_id": "da8ab03d-fb9b-3807-a11e-e3f8e5b8c699",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "den Eroberer"
                    },
                    {
                        "form_id": "fd2e4254-fbc5-4ac7-9724-1ca6f2a5f2a2",
                        "entry_id": "da8ab03d-fb9b-3807-a11e-e3f8e5b8c699",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Eroberer"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6b55aca8-f47a-3560-b8d1-5d354118190e",
                        "entry_id": "da8ab03d-fb9b-3807-a11e-e3f8e5b8c699",
                        "glosses": [
                            "Person, die ein Gebiet, das ihr nicht gehört, in eigene Gewalt bringt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b00a63e5-39d1-4578-8add-5f7c0c623df2",
                                "sense_id": "6b55aca8-f47a-3560-b8d1-5d354118190e",
                                "text": "„Vor allem aber wunderte sich der Eroberer, dass die Gesellschaft der Mexica von Kultur und Ordnung durchdrungen war, obwohl sie nicht von Christen geleitet wurde.“"
                            },
                            {
                                "example_id": "65fd4bd4-0bd9-4f52-a45d-ffbf0d333ff3",
                                "sense_id": "6b55aca8-f47a-3560-b8d1-5d354118190e",
                                "text": "„Die Eroberer verkünden eine neue Religion, den Islam, und verbreiten mit dem Koran eine neue Gesellschaftsordnung.“"
                            },
                            {
                                "example_id": "86f0542e-17c6-45fb-b469-6d36f7dbc151",
                                "sense_id": "6b55aca8-f47a-3560-b8d1-5d354118190e",
                                "text": "„Aber mit seinem neuen Heer konnte Augustus das Imperium Romanum an vielen Stellen erweitern, ja sogar zu Roms größtem Eroberer werden und gleichzeitig den Frieden auch der gefährdeten Grenzgebiete schützen.“"
                            },
                            {
                                "example_id": "efd35ad0-2c47-45f1-a743-cca2a470ddf6",
                                "sense_id": "6b55aca8-f47a-3560-b8d1-5d354118190e",
                                "text": "„Die Tabakpflanze, die in Süd- und Mittelamerika bereits vor unserer Zeitrechnung angepflanzt und zu religiösen sowie medizinischen Zwecken verwendet wurde, kam durch die spanischen Eroberer nach Europa.“"
                            },
                            {
                                "example_id": "3325f6f8-3fa4-48fa-8cc5-84c6490dff0c",
                                "sense_id": "6b55aca8-f47a-3560-b8d1-5d354118190e",
                                "text": "„Auch in Nordamerika, so Smithers, bestraften die Eroberer Two-Spirits mit drakonischen Mitteln.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "03c35c16-232e-4696-934c-396216fc2f55",
                        "source_entry_id": "da8ab03d-fb9b-3807-a11e-e3f8e5b8c699",
                        "source_sense_id": "6b55aca8-f47a-3560-b8d1-5d354118190e",
                        "source_sense_description": "Person, die ein Gebiet, das ihr nicht gehört, in eigene Gewalt bringt",
                        "target_lang_word": "conqueror",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "conqueror",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "19cf2dd5-183b-3e89-b9f3-f9e8c5a1971d",
                                        "entry_id": "d4933801-bd0d-39a2-8f0c-2315c08a60f0",
                                        "glosses": [
                                            "Someone who conquers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "953f3ae8-b434-4f36-ba92-aceded105589",
                                                "sense_id": "19cf2dd5-183b-3e89-b9f3-f9e8c5a1971d",
                                                "text": "They were conquerors, and for that you want only brute force - nothing to boast of, when you have it, since your strength is just an accident arising from the weakness of others."
                                            },
                                            {
                                                "example_id": "48b4c6d4-37d9-48da-be13-d832bd3ba5d2",
                                                "sense_id": "19cf2dd5-183b-3e89-b9f3-f9e8c5a1971d",
                                                "text": "Croatia, England's World Cup semi-final conquerors in Moscow in July, looked set to inflict their curse once more and relegate Gareth Southgate's side from the elite group when Andrej Kramaric's twisting finish put them ahead via a deflection off Eric Dier after 57 minutes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "665f3c7c-8c2e-4e27-884c-4552492c318a",
                        "source_entry_id": "da8ab03d-fb9b-3807-a11e-e3f8e5b8c699",
                        "source_sense_id": "6b55aca8-f47a-3560-b8d1-5d354118190e",
                        "source_sense_description": "Person, die ein Gebiet, das ihr nicht gehört, in eigene Gewalt bringt",
                        "target_lang_word": "conquérant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "conquérant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f8554e38-d7a2-3758-9e8d-7e4918a5bb39",
                                        "entry_id": "15ba7602-3064-3205-ad46-6427fd62ec35",
                                        "glosses": [
                                            "Celui qui a acquis par les armes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a45f33c8-c15d-4ed1-b804-fc1b2a002e88",
                                                "sense_id": "f8554e38-d7a2-3758-9e8d-7e4918a5bb39",
                                                "text": "Alexandre fut un grand conquérant. - Guillaume le Conquérant. - Zénobie fut une illustre conquérante."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aee89a8f-86aa-3db5-9187-78a56e65e589",
                                        "entry_id": "15ba7602-3064-3205-ad46-6427fd62ec35",
                                        "glosses": [
                                            "Celui qui a subjugué par le charme."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "464410a5-e89f-408a-8e83-677f15e537f9",
                                                "sense_id": "aee89a8f-86aa-3db5-9187-78a56e65e589",
                                                "text": "Il oublie le reste, la démarche, la grâce, […], ces hanches qui font bouger l’espace, je n’ai pas vraiment vu son visage mais il ne saurait être que celui d’une conquérante, d’une vainqueresse."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "conquérant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9ed12ff8-1a62-334f-99d5-6debd3f3aa99",
                                        "entry_id": "b40d9926-9a5e-3d05-865e-18b340a99e2e",
                                        "glosses": [
                                            "Qui a conquis par les armes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3cae071-7b98-4ee1-abf9-73ae7b662a3d",
                                                "sense_id": "9ed12ff8-1a62-334f-99d5-6debd3f3aa99",
                                                "text": "C'est ce qui permit à une minorité conquérante, politiquement et socialement dominante, de populations surtout chrétiennes, païennes et zoroastriennes, de consolider l'Islam et de soumettre rapidement les mondes sémitiques et iranien."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e8010cc5-e12b-33c4-a78b-9f36171878a0",
                                        "entry_id": "b40d9926-9a5e-3d05-865e-18b340a99e2e",
                                        "glosses": [
                                            "Qualifie ce qui appartient à ceux qui ont conquis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7851ea3a-8c51-4e6f-be79-1522f7635e84",
                                                "sense_id": "e8010cc5-e12b-33c4-a78b-9f36171878a0",
                                                "text": "L’aide tient tête à un flot envahissant de jeunes gens résolus, en chapeaux melons et cravates conquérantes, qui brandissent des carnets de notes ou soulèvent des appareils photographiques."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "conquérant",
