                                        "sense_id": "a182ea16-4ebc-3804-9699-dc71dab73c87",
                                        "entry_id": "5a7df919-6ecb-38c3-88d6-fd6d0fea11d7",
                                        "glosses": [
                                            "A disrespectful levity or pertness especially in respect to grave or sacred matters."
                                        ],
                                        "tags": [
