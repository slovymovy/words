    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "07b871f1-bcd7-3946-b53c-297d3aa8a714",
                    "sense_definition": "Personne qui participe à la réalisation d'une infraction ou d'une action blâmable menée par autrui.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "infraction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La police a rapidement identifié et arrêté le <w>complice</w> de ce braquage audacieux."
                        },
                        {
                            "text": "L'accusé a formellement refusé de révéler l'identité de ses <w>complices</w> durant le procès."
                        }
                    ],
                    "synonyms": [
                        "acolyte",
                        "comparse",
                        "compère"
                    ],
                    "common_phrases": [
                        "complice du crime",
                        "complice de meurtre"
                    ]
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a33f7b02-5415-316f-9811-3847de0d4857",
                    "sense_definition": "Qui exprime ou partage une connivence intime et chaleureuse.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "connivence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les deux amis ont échangé un regard <w>complice</w> avant d'éclater de rire ensemble."
                        },
                        {
                            "text": "Elle lui a adressé un sourire <w>complice</w> pour l'encourager à monter sur scène."
                        }
                    ],
                    "common_phrases": [
                        "regard complice",
                        "sourire complice",
                        "clin d'œil complice"
                    ]
                },
                {
                    "sense_id": "b3339e54-6573-36ed-8aaa-40d628a451b2",
                    "sense_definition": "Qui participe à une infraction ou à un acte répréhensible commis par un autre.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "infraction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet employé de banque s'est retrouvé <w>complice</w> du détournement de fonds sans le vouloir."
                        },
                        {
                            "text": "La justice a déclaré plusieurs ministres <w>complices</w> de cette sombre affaire de corruption."
                        }
                    ],
                    "synonyms": [
                        "mêlé"
                    ],
                    "common_phrases": [
                        "être complice de"
                    ]
                },
                {
                    "sense_id": "cc401e26-e637-3deb-b952-dae96d35fcb2",
                    "sense_definition": "Qui prend part à une action ou y prête son appui, parfois de manière tacite.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "connivence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En fermant les yeux sur ces abus, nous devenons <w>complices</w> d'un système injuste."
                        },
                        {
                            "text": "Son silence <w>complice</w> a permis à la rumeur de se propager très rapidement."
                        }
                    ],
                    "common_phrases": [
                        "silence complice",
                        "se rendre complice"
                    ]
                }
            ]
        }
    ]
