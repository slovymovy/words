            },
            {
                "entry_id": "2b71af16-cc20-3ded-b258-ef65a536e52c",
                "word": "porterage",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "29d45b6d-e854-3a03-8ceb-e4587b5094b6",
                        "entry_id": "2b71af16-cc20-3ded-b258-ef65a536e52c",
                        "glosses": [
                            "The occupation of, or services provided by, a porter (“person in control of the entrance to a building”)."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "566ca60e-d7a0-4952-ba15-bd9e8b5f7e1a",
                                "sense_id": "29d45b6d-e854-3a03-8ceb-e4587b5094b6",
                                "text": "In rules of Porterage untaught, / Simplicity, not vvorth a groat, / For years had kept the Temple door; / Full on his breaſt a glaſs he vvore, / Thro' vvhich his boſom open lay / To ev'ry one vvho paſs'd that vvay."
                            },
                            {
                                "example_id": "442f7e03-15aa-4d10-97c7-1b852e9af044",
                                "sense_id": "29d45b6d-e854-3a03-8ceb-e4587b5094b6",
                                "text": "There is an underground parking space for each flat, a 24-hour porterage service and careful security arrangements."
                            },
                            {
                                "example_id": "5c67c91d-500e-4a26-b7a7-f5b1fd5611dd",
                                "sense_id": "29d45b6d-e854-3a03-8ceb-e4587b5094b6",
                                "text": "A good-sized drawing-room and dining-room and two double bedrooms – you won't need more. Twenty-four-hour porterage and a modern security system."
                            },
                            {
                                "example_id": "217429cb-05f5-4764-983f-3577e1c2d9c5",
                                "sense_id": "29d45b6d-e854-3a03-8ceb-e4587b5094b6",
                                "text": "There is a strong demand for studio or one- and two-bedroom apartments with private underground parking and twenty-four hour porterage by young single professionals and executives and working couples with minimal domestic lifestyles."
                            }
                        ]
                    }
