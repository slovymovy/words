                                        "sense_id": "5f69a888-14c3-30a4-a4f5-5cb851324286",
                                        "entry_id": "ec3aff21-1893-3e32-bd50-bcc2b4e66e86",
                                        "glosses": [
                                            "счётная единица, равная десяти; десять однородных объектов"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69994518-33e8-44ad-91aa-f751873d13fa",
                                                "sense_id": "5f69a888-14c3-30a4-a4f5-5cb851324286",
                                                "text": "Надо купить два десятка яиц."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fef71892-2294-3030-adee-f72388851c98",
                                        "entry_id": "ec3aff21-1893-3e32-bd50-bcc2b4e66e86",
                                        "glosses": [
