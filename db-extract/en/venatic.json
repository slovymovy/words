                        "glosses": [
                            "Of, pertaining to or involved in hunting."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f19e4674-6a62-48e8-80d6-c3dcbc6e57ad",
                                "sense_id": "3c0cdeb0-1288-380d-b5c1-0027df307317",
                                "text": "[…] consequently, Lost-withiel, as a compound name, would signify the tented encampment of the stranger, an epithet fairly applicable to the first settlers in that locality, who doubtless migrated thither over-sea, and like most venatic tribes without settled residence, dwelt in tents."
                            },
                            {
                                "example_id": "b79ae74f-c235-46dc-a453-9db34dda5150",
                                "sense_id": "3c0cdeb0-1288-380d-b5c1-0027df307317",
                                "text": "Not gyved with connubial relations, I entered upon my migration entirely isolated, with the exception of a canine quadruped whose mordacious, latrant, lusorious, and venatic qualities, are without parity."
                            },
                            {
                                "example_id": "0b19fc0b-82f6-4708-b26e-f5454c0f96a4",
                                "sense_id": "3c0cdeb0-1288-380d-b5c1-0027df307317",
                                "text": "This is the hunter's \"venatic lore\" linked to the domain of belief and making believe […]"
                            },
                            {
                                "example_id": "d84e2ffd-6661-4bed-8274-128ab19668f0",
                                "sense_id": "3c0cdeb0-1288-380d-b5c1-0027df307317",
                                "text": "Races belonging to a scarcely lower civilization than the Aztecs, certainly far more advanced than the venatic tribes of the North and East, must have occupied at some remote time and for a lengthy period, a considerable portion of the Mississippi Basin"
                            }
                        ]
                    }
