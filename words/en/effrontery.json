{
    "word_family": [
        "effront"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d6b82e40-b39c-372b-9d52-cd395564b080",
                    "sense_definition": "A quality of being insolent and shamelessly bold.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "audacity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She had the <w>effrontery</w> to ask for a raise after missing so many deadlines.",
                            "target_lang_translations": {
                                "es": "Tuvo la <w>desfachatez</w> de pedir un aumento después de no cumplir con tantos plazos."
                            }
                        },
                        {
                            "text": "The politician showed incredible <w>effrontery</w> by lying directly to the public during the debate.",
                            "target_lang_translations": {
                                "es": "El político mostró un increíble <w>descaro</w> al mentirle directamente al público durante el debate."
                            }
                        }
                    ],
                    "synonyms": [
                        "audacity",
                        "impudence",
                        "nerve",
                        "temerity"
                    ],
                    "antonyms": [
                        "humility",
                        "modesty"
                    ],
                    "common_phrases": [
                        "have the effrontery"
                    ],
                    "target_lang_definitions": {
                        "es": "Cualidad de ser insolente, descarado o mostrar una audacia sin vergüenza."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "descaro",
                                "target_lang_sense_clarification": "falta de respeto o pudor"
                            },
                            {
                                "target_lang_word": "desfachatez",
                                "target_lang_sense_clarification": "audacia irrespetuosa o insolencia"
                            },
                            {
                                "target_lang_word": "desvergüenza",
                                "target_lang_sense_clarification": "carencia de vergüenza o decoro"
                            },
                            {
                                "target_lang_word": "insolencia",
                                "target_lang_sense_clarification": "atrevimiento o falta de respeto"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8da981c8-bf7e-3535-b02d-dd06d86d6db3",
                    "sense_definition": "A specific instance or act of insolent and shameless behavior.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "audacity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His rude comment was a clear <w>effrontery</w> that offended everyone in the room.",
                            "target_lang_translations": {
                                "es": "Su grosero comentario fue una clara <w>insolencia</w> que ofendió a todos en la sala."
                            }
                        },
                        {
                            "text": "The manager considered the employee's public criticism of the company an <w>effrontery</w> that could not be ignored.",
                            "target_lang_translations": {
                                "es": "El gerente consideró que las críticas públicas del empleado hacia la empresa eran una <w>afrenta</w> que no podía ignorarse."
                            }
                        }
                    ],
                    "synonyms": [
                        "insult",
                        "affront"
                    ],
                    "target_lang_definitions": {
                        "es": "Acto o muestra concreta de insolencia, falta de respeto o atrevimiento desvergonzado."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "descaro",
                                "target_lang_sense_clarification": "acto de insolencia o atrevimiento"
                            },
                            {
                                "target_lang_word": "desfachatez",
                                "target_lang_sense_clarification": "hecho o dicho desvergonzado"
                            },
                            {
                                "target_lang_word": "insolencia",
                                "target_lang_sense_clarification": "acto ofensivo o irrespetuoso"
                            },
                            {
                                "target_lang_word": "afrenta",
                                "target_lang_sense_clarification": "hecho que ofende o ultraja"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}