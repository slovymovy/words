                                        "entry_id": "d5cec670-6fb0-34cf-ada9-a545336ae2e7",
                                        "glosses": [
                                            "vyzí klih (želatina získaná z měchýřů velké ryby vyzy velké)"
                                        ],
                                        "tags": [],
