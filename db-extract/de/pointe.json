                                "target_senses": [
                                    {
                                        "sense_id": "a394f9b8-bcdf-3f66-97cf-0ec9305c3e47",
                                        "entry_id": "bd309806-8d70-3a86-896d-1043ded77db8",
                                        "glosses": [
                                            "Alternative spelling of punch line."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c37cbab-6244-4e5c-b856-09105b6d8f7d",
                                                "sense_id": "a394f9b8-bcdf-3f66-97cf-0ec9305c3e47",
                                                "text": "Arguably, without Jones, Monty Python’s Flying Circus (1969-74) would not have revolutionised British TV comedy. He was key in developing the show’s distinctively trippy, stream-of-consciousness format, where each surreal set-up (the Lumberjack Song, the upper-class twit of the year show, the dead parrot, or the fish-slapping dance) flowed into the next, unpunctuated by punchlines."
                                            }
                                        ]
                                    }
