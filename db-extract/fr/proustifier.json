                ],
                "senses": [
                    {
                        "sense_id": "ea3f0cd8-5d02-31fe-a9cf-f9c0bc6f2bb6",
                        "entry_id": "6009468a-bd73-3107-8e7b-bbe2974ba297",
                        "glosses": [
                            "S’exprimer de façon alambiquée, en faisant des manières."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "301b4473-2f3a-4884-a348-7b3eff137ae0",
                                "sense_id": "ea3f0cd8-5d02-31fe-a9cf-f9c0bc6f2bb6",
                                "text": "Mais ne dirait-on pas que je proustifie à mon tour ?"
                            },
                            {
                                "example_id": "800b774d-a78d-4037-837f-abea972e04d0",
                                "sense_id": "ea3f0cd8-5d02-31fe-a9cf-f9c0bc6f2bb6",
                                "text": "Il devint de bon ton, dans une certaine société, de proustifier; bonne manière de réhabiliter cette société qu’il avait flagellée."
                            },
                            {
                                "example_id": "30bd6f99-bdf0-4d83-956d-7bd1703c3000",
                                "sense_id": "ea3f0cd8-5d02-31fe-a9cf-f9c0bc6f2bb6",
                                "text": "Tous ceux qui proustifient dès l’exergue, ceux qui pavoisent à tout bout de chapitre, style macaronique, tournures melliflues à brassées, quelques plumitifs marmiteux, salmigondis de malebouche en guise de tête de gondole, tous éteint rapidement éradiqués."
                            }
                        ]
                    },
                    {
                        "sense_id": "4f7ed573-2942-3569-8951-a1c689f66108",
                        "entry_id": "6009468a-bd73-3107-8e7b-bbe2974ba297",
                        "glosses": [
                            "Donner à quelque chose ou à quelqu’un un caractère rappelant Marcel Proust."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "123b1c15-0625-40b2-a737-4a12b6fb7217",
                                "sense_id": "4f7ed573-2942-3569-8951-a1c689f66108",
                                "text": "On dit tout… le pour le contre… en sociologues proustifiés… l’envers vaut l’endroit… les gamelles savantes manquent jamais de rata !…"
                            }
                        ]
                    }
                ],
