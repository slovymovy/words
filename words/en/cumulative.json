{
    "word_family": [
        "accumulate",
        "accumulation",
        "accumulative",
        "cumulate",
        "cumulation",
        "cumulatively"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "7960ce13-66e0-3923-ac1a-0bc03a04ea5f",
                    "sense_definition": "Increasing or growing by accumulation or successive additions, incorporating all data up to the present.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "accumulation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>cumulative</w> effect of these small changes will be significant over time.",
                            "target_lang_translations": {
                                "ru": "<w>Совокупный</w> эффект этих небольших изменений станет значительным со временем."
                            }
                        },
                        {
                            "text": "The report shows the <w>cumulative</w> total of all sales since the beginning of the year.",
                            "target_lang_translations": {
                                "ru": "В отчете указана <w>кумулятивная</w> сумма всех продаж с начала года."
                            }
                        }
                    ],
                    "synonyms": [
                        "accumulative",
                        "collective",
                        "aggregate"
                    ],
                    "antonyms": [
                        "individual",
                        "subtractive"
                    ],
                    "common_phrases": [
                        "cumulative effect",
                        "cumulative total",
                        "cumulative impact"
                    ],
                    "target_lang_definitions": {
                        "ru": "Увеличивающийся или растущий путем накопления или последовательных добавлений, включающий все данные до настоящего момента."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "совокупный",
                                "target_lang_sense_clarification": "общий итог, накопленный за период"
                            },
                            {
                                "target_lang_word": "кумулятивный",
                                "target_lang_sense_clarification": "нарастающий, усиливающийся за счет сложения"
                            },
                            {
                                "target_lang_word": "накопленный",
                                "target_lang_sense_clarification": "собранный в течение времени"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "19e5da1c-153e-3ec1-9486-120e6c7ec84f",
                    "sense_definition": "Relating to shares or dividends that must be paid in full, including any past payments that were missed, before other dividends.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Investors prefer <w>cumulative</w> preferred stock because it guarantees that missed dividends will be paid later.",
                            "target_lang_translations": {
                                "ru": "Инвесторы предпочитают <w>кумулятивные</w> привилегированные акции, так как это гарантирует выплату пропущенных дивидендов позже."
                            }
                        },
                        {
                            "text": "The company must pay all <w>cumulative</w> dividends before any common shareholders receive a cent.",
                            "target_lang_translations": {
                                "ru": "Компания должна выплатить все <w>накопленные</w> дивиденды, прежде чем обычные акционеры получат хоть цент."
                            }
                        }
                    ],
                    "antonyms": [
                        "non-cumulative"
                    ],
                    "common_phrases": [
                        "cumulative preferred stock",
                        "cumulative dividend"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "business and finance context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к акциям или дивидендам, которые должны быть выплачены полностью, включая любые пропущенные прошлые платежи, прежде других дивидендов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кумулятивный",
                                "target_lang_sense_clarification": "о привилегированных акциях и дивидендах"
                            },
                            {
                                "target_lang_word": "накопительный",
                                "target_lang_sense_clarification": "подразумевающий накопление невыплаченных сумм"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "91e74029-9177-3ebc-9a19-167edee77742",
                    "sense_definition": "Describing evidence or testimony that repeats or reinforces what has already been established by other evidence.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "legal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The judge ruled that the additional witness testimony was merely <w>cumulative</w> and therefore unnecessary.",
                            "target_lang_translations": {
                                "ru": "Судья постановил, что дополнительные показания свидетелей были лишь <w>повторными</w> и, следовательно, ненужными."
                            }
                        },
                        {
                            "text": "The defense objected to the <w>cumulative</w> evidence, arguing it would only waste the court's time.",
                            "target_lang_translations": {
                                "ru": "Защита возразила против <w>дублирующих</w> доказательств, утверждая, что это лишь пустая трата времени суда."
                            }
                        }
                    ],
                    "synonyms": [
                        "repetitive",
                        "redundant"
                    ],
                    "common_phrases": [
                        "cumulative evidence",
                        "cumulative testimony"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "legal context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Описывающий доказательства или свидетельские показания, которые повторяют или подкрепляют то, что уже было установлено другими доказательствами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дополнительный",
                                "target_lang_sense_clarification": "подкрепляющий уже имеющиеся факты"
                            },
                            {
                                "target_lang_word": "повторный",
                                "target_lang_sense_clarification": "дублирующий уже представленные доказательства"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}