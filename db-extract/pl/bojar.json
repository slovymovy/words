                ],
                "senses": [
                    {
                        "sense_id": "3922c875-685f-3f69-beb8-fc015d5b3002",
                        "entry_id": "8212abf9-be20-3afa-b66d-06b157fa08e9",
                        "glosses": [
                            "w dawnej Bułgarii, Rosji i Rusi Kijowskiej członek klasy najbardziej znaczących w państwie feudałów"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "de3dad80-fa19-4fbb-a8b3-16b5460fb7d6",
                        "source_entry_id": "8212abf9-be20-3afa-b66d-06b157fa08e9",
                        "source_sense_id": "3922c875-685f-3f69-beb8-fc015d5b3002",
                        "target_lang_word": "boyar",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "boyar",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0542ea84-fbe2-3e39-90ed-3bf830743836",
                                        "entry_id": "0a12f2e2-6cd0-3527-b8c1-afd89fb4455b",
                                        "glosses": [
                                            "A member of a rank of aristocracy (second only to princes) in Russia, Ukraine, Belarus, Bulgaria, North Macedonia, Serbia and Romania."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57b2ac95-43e7-4841-8271-1bccd9f9c824",
                                                "sense_id": "0542ea84-fbe2-3e39-90ed-3bf830743836",
                                                "text": "Boris had abdicated in 889, leaving the throne to his son Vladimir, who had immediately identified himself with the boyar aristocracy which Boris had done his utmost to crush."
                                            },
                                            {
                                                "example_id": "6fddcf9f-bbf1-48d6-9790-72be8dd4a800",
                                                "sense_id": "0542ea84-fbe2-3e39-90ed-3bf830743836",
                                                "text": "A long series of wars was fought in the sixteenth century to keep Polish influence at bay in the West Russian lands, and prevent it from seducing Muscovy's restless boyars, the warrior-barons whose independence the grand dukes were determined to crush."
                                            },
                                            {
                                                "example_id": "6a847a8e-451f-4057-b790-13ea36d51b54",
                                                "sense_id": "0542ea84-fbe2-3e39-90ed-3bf830743836",
                                                "text": "some of his family looked to Orthodox Christianity to sustain them, and not only many of his boyars but most of his subjects were Orthodox Christians."
                                            },
                                            {
                                                "example_id": "1801cd90-bff0-4527-900e-cf90e52d88b8",
                                                "sense_id": "0542ea84-fbe2-3e39-90ed-3bf830743836",
                                                "text": "To understand Russia, you have to dive deep into its history — boyars and czars, Pushkin and Pasternak, Stalin and Stalingrad."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8bd945a9-e72b-45c3-aa55-d5a03e0c247c",
                        "source_entry_id": "8212abf9-be20-3afa-b66d-06b157fa08e9",
                        "source_sense_id": "3922c875-685f-3f69-beb8-fc015d5b3002",
                        "target_lang_word": "bojar",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "e7a1b349-5e94-42e7-ac26-a3124f828cd2",
                        "source_entry_id": "8212abf9-be20-3afa-b66d-06b157fa08e9",
                        "source_sense_id": "3922c875-685f-3f69-beb8-fc015d5b3002",
                        "target_lang_word": "боярин",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "боярин",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "a029bd12-0356-3477-a4df-5e0b756b583c",
                                        "entry_id": "f7c6dbb7-63b9-319f-bc37-362619ac1f37",
                                        "glosses": [
                                            "истор. крупный землевладелец, представитель высшего сословия феодалов в Древней Руси и в Московском государстве (до реформ Петра I в начале XVIII века)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33d1d7aa-e8e2-41aa-a37f-f94de971f8cd",
                                                "sense_id": "a029bd12-0356-3477-a4df-5e0b756b583c",
                                                "text": "Того ж времяни дан указ боярину князю Борису Голицыну, велено набирать драгунския полки, которые начал той же зимы и набрал 10 полков числом в каждом по 1000 человек."
                                            },
                                            {
                                                "example_id": "67f9c1a1-a8e4-45e6-8609-94f1324d654e",
                                                "sense_id": "a029bd12-0356-3477-a4df-5e0b756b583c",
                                                "text": "Бояре, дети боярские и приказные люди в приказных службах и поместьях владычествовали над народом, обогащались за счет народа; боярство стремилось приобрести перевес над земством."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4658eead-c460-3682-98b3-42b5d64dcf95",
                                        "entry_id": "f7c6dbb7-63b9-319f-bc37-362619ac1f37",
                                        "glosses": [
                                            "истор. высший чин служилых людей, членов Думы в Московском государстве (XV–XVII вв.); лицо, имевшее такой чин"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4baaac00-b16e-4155-9c55-2c155b8175f1",
                                                "sense_id": "4658eead-c460-3682-98b3-42b5d64dcf95",
                                                "text": "В престольном граде славного русского царства, в Москве белокаменной, жил боярин Матвей Андреев, человек богатый, умный, верный слуга царский и, по обычаю русских, великий хлебосол."
                                            },
                                            {
                                                "example_id": "577fb266-0d80-4be7-a8cf-0269ca8aaf1f",
                                                "sense_id": "4658eead-c460-3682-98b3-42b5d64dcf95",
                                                "text": "Подбежали бояре и дворяне, // Старика взашей затолкали."
                                            },
                                            {
                                                "example_id": "5e8d7ffc-b78c-4262-9440-385e084f5614",
                                                "sense_id": "4658eead-c460-3682-98b3-42b5d64dcf95",
                                                "text": "Пахом сказал: светлейшему // Вельможному боярину, // Министру государеву, // А Пров сказал: царю…"
                                            },
                                            {
                                                "example_id": "01dd5145-48e4-4447-90fd-56ff6093c4ad",
                                                "sense_id": "4658eead-c460-3682-98b3-42b5d64dcf95",
                                                "text": "Зови бояр. Бояр было семеро. Рюрик знал их по службе в городе, где его дружина поддерживала порядок."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a88a9db8-c76e-36e5-a145-fa4fda2d92a8",
                                        "entry_id": "f7c6dbb7-63b9-319f-bc37-362619ac1f37",
                                        "glosses": [
                                            "устар. истор. помещик; барин"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
