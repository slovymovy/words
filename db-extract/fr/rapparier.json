                        "entry_id": "f2864bdf-40d4-3edb-aea0-db3e26d70abb",
                        "glosses": [
                            "Ajouter un, pour faire une paire, en parlant des animaux domestiques qu’on a par paires."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "5db2dc22-5913-4c9a-9353-2953182d7315",
                                "sense_id": "6b30a71b-8f77-3268-8c29-1d42350b113c",
                                "text": "Je voudrais rapparier ce pigeon, dont j’ai perdu la femelle."
                            },
                            {
                                "example_id": "c9a8e006-1ad7-4caa-86a5-6a2374ca3d53",
                                "sense_id": "6b30a71b-8f77-3268-8c29-1d42350b113c",
                                "text": "Rapparier un bœuf, un cheval pour refaire un attelage."
                            }
                        ]
                    }
