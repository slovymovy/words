                    {
                        "translation_id": "5f5d4854-4248-4e82-a160-f42030aedf7b",
                        "source_entry_id": "36b0b351-b49a-38a0-acb6-90a28b131aaa",
                        "source_sense_id": "be6659da-17d9-31d6-98a4-de9a5b9d9328",
                        "source_sense_description": "Exekutive: ein dem Strafvollzug dienendes Gebäude",
                        "target_lang_word": "zakład karny",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zakład karny",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "8bc3ec4b-a97d-3d83-a269-48f0382704ef",
                                        "entry_id": "603a846e-8574-37fe-8998-c72d22f59527",
                                        "glosses": [
                                            "miejsce, w którym osoby skazane prawomocnym wyrokiem sądu odbywają karę pozbawienia wolności"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d937bc5-f0db-4b37-8f4a-fbfafd8dc746",
                                                "sense_id": "8bc3ec4b-a97d-3d83-a269-48f0382704ef",
                                                "text": "Zakład Karny z Raciborza bierze udział w programie ekologicznej fundacji Silesia z Katowic. — Pozyskaliśmy 1500 zł na sadzonki. Pieniędzy starczy na wstępny etap odnowy przywięziennego parku – informuje Aleksandra Szlachetko z Działu Kwatermistrzowskiego placówki."
                                            },
                                            {
                                                "example_id": "3f98bce0-a882-4f0e-baef-6d07423922b7",
                                                "sense_id": "8bc3ec4b-a97d-3d83-a269-48f0382704ef",
                                                "text": "W zakładzie karnym w Sieradzu jeden ze strażników zabarykadował się i ostrzelał radiowóz, którym policjanci przyjechali do więzienia."
                                            },
                                            {
                                                "example_id": "c0b3e706-262a-4d23-8809-0a8041bf6ed0",
                                                "sense_id": "8bc3ec4b-a97d-3d83-a269-48f0382704ef",
                                                "text": "Jak informuje sędzia Łyś, w przypadku pozytywnego rozpatrzenia sprawy dla byłego posła, decyzja o możliwości opuszczenia zakładu karnego wydawana jest natychmiastowo."
                                            },
                                            {
                                                "example_id": "bcffe588-476d-41ac-b700-3a32e245e269",
                                                "sense_id": "8bc3ec4b-a97d-3d83-a269-48f0382704ef",
                                                "text": "Ważnym czynnikiem kryminogennym są częste u recydywistów zaburzenia osobowości i daleko posunięte nieprzystosowanie społeczne, które potęguje długi pobyt w zakładach karnych."
                                            },
                                            {
                                                "example_id": "99ac9db0-917d-45f2-9aa5-9adb540a351b",
                                                "sense_id": "8bc3ec4b-a97d-3d83-a269-48f0382704ef",
                                                "text": "Kiedy więzienna brama przemyskiego Zakładu Karnego zatrzaskiwała się za nim, już wiedział, że na długie 25 lat."
