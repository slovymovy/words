                "senses": [
                    {
                        "sense_id": "1e579dc9-d084-3ccf-ad98-47003312d49b",
                        "entry_id": "07d89689-366a-318a-9ad9-1b11725854cc",
                        "glosses": [
                            "Qui excite, qui aiguillonne l’esprit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0dbc320c-04e7-49c2-9b51-8f1f917e1186",
                                "sense_id": "1e579dc9-d084-3ccf-ad98-47003312d49b",
                                "text": "L’émulation est un stimulant qu’il faut employer à propos et avec précaution."
                            },
                            {
                                "example_id": "9f7b5da8-ae63-41e0-adc0-5ffe157df238",
                                "sense_id": "1e579dc9-d084-3ccf-ad98-47003312d49b",
                                "text": "Il est assez porté à agir de la sorte, il n’a pas besoin de stimulants."
                            }
                        ]
                    },
                    {
                        "sense_id": "64af943e-8d8d-31df-8763-07c1e52c5a4d",
                        "entry_id": "07d89689-366a-318a-9ad9-1b11725854cc",
                        "glosses": [
                            "Ce qui est propre à exciter les fonctions organiques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3db8b17f-389e-493c-99c2-618afd827221",
                                "sense_id": "64af943e-8d8d-31df-8763-07c1e52c5a4d",
                                "text": "Il fournit également des glucides, dont certains, spécifiques à certaines espèces (shiitake et pleurotes), sont reconnus pour leur action stimulante du système immunitaire."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1b724233-9c1c-46d4-853c-7498f95c2285",
                        "source_entry_id": "07d89689-366a-318a-9ad9-1b11725854cc",
                        "target_lang_word": "stimulating",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stimulating",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c701e005-a1ca-3082-9ad5-b340c026b2c4",
                                        "entry_id": "d89116d0-4f95-3da0-9686-6ccdca3eb703",
                                        "glosses": [
                                            "Having a manner that stimulates; serving to stimulate."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca8281ca-f543-4b4f-bec5-4dba7001ec56",
                                                "sense_id": "c701e005-a1ca-3082-9ad5-b340c026b2c4",
                                                "text": "Chestnuts, soaked in muscadel, then boiled, along with satyrion, pistachio nuts, pine kernels, cubebs, cinnamon, rocket seed and sugar. Compounded together, these ingredient form a stimulating electuary."
                                            },
                                            {
                                                "example_id": "105d3caf-c349-42f4-9bb7-3f7aef6d01b3",
                                                "sense_id": "c701e005-a1ca-3082-9ad5-b340c026b2c4",
                                                "text": "Jeeves: Foreign travel often liberates emotions best kept in check, sir. The air of North America is notoriously stimulating in this regard, as witness the regrettable behavior of its inhabitants in 1776.\nB. Wooster: Hm? What happened in 1776, Jeeves?\nJeeves: I prefer not to dwell on it, if it's convenient to you, sir."
                                            }
                                        ]
                                    }
                                ]
                            },
