                },
                {
                    "sense_id": "5e993301-c254-30e4-bf75-7e7d1d942268",
                    "sense_definition": "geheel onafhankelijk en met onbeperkte macht, vaak gezegd van een vorst",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "macht",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In dat land is een <w>absolute</w> koning aan de macht die alles beslist.",
                            "target_lang_translations": {
                                "en": "In that country, an <w>absolute</w> king is in power who decides everything.",
                                "ru": "В той стране у власти стоит <w>абсолютный</w> монарх, который решает всё."
                            }
                        },
                        {
                            "text": "De <w>absolute</w> monarchie verdween in de meeste Europese landen na de revoluties.",
                            "target_lang_translations": {
                                "en": "The <w>absolute</w> monarchy disappeared in most European countries after the revolutions.",
                                "ru": "<w>Абсолютная</w> монархия исчезла в большинстве европейских стран после революций."
                            }
                        }
