                ],
                "senses": [
                    {
                        "sense_id": "c46f6d4c-ea93-36fd-b39d-f478d3b0eb57",
                        "entry_id": "76dcba66-b90b-37bd-9b76-614f9569ef23",
                        "glosses": [
                            "netzunabhängige bei Bedarf zuschaltbare optische Ausleuchtung und Erhellung eines Raumes oder Objektes mit Kunstlicht, um die Arbeiten bei Netzausfall weiter führen zu können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ec387f3-1d64-43cc-a913-74e6e65465e1",
                                "sense_id": "c46f6d4c-ea93-36fd-b39d-f478d3b0eb57",
                                "text": "„Während die Sicherheitsbeleuchtung ausschliesslich dem sicheren Verlassen eines Raumes dient, stellt die Ersatzbeleuchtung sicher, dass die Arbeiten bei Netzausfall noch während einer gewissen Zeit in gewohntem Rahmen weitergeführt werden können.“"
                            },
                            {
                                "example_id": "6c1528cf-6b06-4d21-a4aa-24972e591a3c",
                                "sense_id": "c46f6d4c-ea93-36fd-b39d-f478d3b0eb57",
                                "text": "„Damit jedoch in Krankenhäusern, Sicherheitszentren und anderen sensiblen Sektoren der Betrieb aufrechterhalten werden kann, muss zusätzlich eine Ersatzbeleuchtung vorhanden sein.“"
                            },
                            {
                                "example_id": "e4b8a313-9bd3-4837-b94c-ce65456e15ef",
                                "sense_id": "c46f6d4c-ea93-36fd-b39d-f478d3b0eb57",
                                "text": "„Eine Ersatzbeleuchtung wird beispielsweise aus betriebswirtschaftlichen Gründen installiert, um einen Produktionsausfall zu vermeiden, wenn die allgemeine künstliche Beleuchtung ausfällt. Soll eine Ersatzbeleuchtung Aufgaben der Notbeleuchtung übernehmen, muss sie alle Anforderungen von DIN EN 1838 erfüllen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
