                                "target_senses": [
                                    {
                                        "sense_id": "19ca433a-1dac-3330-9438-c22c7153c95e",
                                        "entry_id": "49679591-85f9-322b-80e6-83202bfd07ca",
                                        "glosses": [
                                            "een zakvormig net aan een beugel met een stok"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26e58027-498b-412e-a4a8-e89dc7eccc5f",
                                                "sense_id": "19ca433a-1dac-3330-9438-c22c7153c95e",
                                                "text": "Als deskundige op het gebied van foraminiferen (eencellige diertjes met een kalkskelet) heeft Brummer al heel wat vaartochten meegemaakt, en zodoende al heel wat meeliftende vogels gezien. Nu is hij aan boord om de planktonsamenstelling op verschillende dieptes te bekijken: materiaal van 1.200 en 3.000 meter diep, uit de sedimentvallen, maar ook van 200 meter diep (verzameld met een overmaats schepnet) en van de oppervlakte."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7d278ee1-7037-4324-ba3d-4c914470a2b5",
                        "source_entry_id": "f75ff9ac-c08d-33ce-917c-48fc94e14219",
                        "source_sense_description": "Filet de pêche",
                        "target_lang_word": "сачок",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "сачок",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "321496fd-93ea-3d0e-ad8f-6834cb50a08e",
                                        "entry_id": "15857d22-1882-3ca2-bbaa-bcb4d73bb6c8",
                                        "glosses": [
                                            "конусообразная сетка на обруче с рукоятью, служащая для ловли рыб, насекомых и т. п."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "afb1eca7-3010-47f2-b4b5-d618b0d6b253",
                                                "sense_id": "321496fd-93ea-3d0e-ad8f-6834cb50a08e",
                                                "text": "Молодые люди были вооружены удочками, сачками, банками с червями и прочими рыболовными принадлежностями."
                                            },
                                            {
                                                "example_id": "d835db99-c7a9-4ad7-bd21-375a273fd808",
                                                "sense_id": "321496fd-93ea-3d0e-ad8f-6834cb50a08e",
                                                "text": "Сейчас беру сачок, норы все мне в известности, подведешь сачок к выходу, пугнёшь – готово."
                                            },
                                            {
                                                "example_id": "bc4ec7ec-f0c3-43a5-a376-a0e652c9964f",
                                                "sense_id": "321496fd-93ea-3d0e-ad8f-6834cb50a08e",
                                                "text": "В руках Женька держал сачок для ловли бабочек, он его все стремился нести на плече, как винтовку, но почему-то не мог поднять, хотя в руках сачок казался очень лёгким."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "сачок",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "f52dee81-56d2-3dd0-aa50-bc81b5047f41",
