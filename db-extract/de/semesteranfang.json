                ],
                "senses": [
                    {
                        "sense_id": "74b46929-05b8-3631-ab0a-ef13c26ec8f9",
                        "entry_id": "350abe57-2135-3482-8ea1-dc6b648b6212",
                        "glosses": [
                            "Beginn eines Semesters"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7123422-6718-4135-8e6b-d4aa73333523",
                                "sense_id": "74b46929-05b8-3631-ab0a-ef13c26ec8f9",
                                "text": "„Du kannst die verbleibende Zeit bis zum Semesteranfang nutzen, für uns ein Nest einzurichten.“"
                            },
                            {
                                "example_id": "9e767c4a-7046-4755-8da1-3c867091a426",
                                "sense_id": "74b46929-05b8-3631-ab0a-ef13c26ec8f9",
                                "text": "„Und da sie nur bis zum Ende der Ferien für das Projekt gebraucht würden, könnten sie mich auch wieder rechtzeitig zum Semesteranfang nach Leshan mitnehmen.“"
                            },
                            {
                                "example_id": "1922b809-d2a6-4c47-96fe-fa66184b330a",
                                "sense_id": "74b46929-05b8-3631-ab0a-ef13c26ec8f9",
                                "text": "„Auf jeden Fall hatte Ada schon ihre Sprachprüfung abgeschlossen, und sie wartete noch auf Semesteranfang.“"
                            },
                            {
                                "example_id": "0222b100-366e-40d5-8ef5-223f0f125e01",
                                "sense_id": "74b46929-05b8-3631-ab0a-ef13c26ec8f9",
                                "text": "„An einer Universität wurden sämtliche 400 Erstsemester des Studiengangs zum Semesteranfang und zum Semesterende gefragt, welches von den vier Modulen sie am meisten interessiert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
