                    {
                        "translation_id": "e0e8b317-bf84-4088-88ec-92d60a411c10",
                        "source_entry_id": "9fea4fc2-06aa-3e0b-8a20-d2eb30566aa0",
                        "target_lang_word": "accouchement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "accouchement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1bff441c-ad73-3fed-a89c-d6b77e7ff08e",
                                        "entry_id": "ed0a9be2-a14c-3c71-8181-d90bac19e0a5",
                                        "glosses": [
                                            "Action d’accoucher."
                                        ],
                                        "tags": [
                                            "Reproduction"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "13c96f76-8ca4-4a8e-865d-884b3f56bf22",
                                                "sense_id": "1bff441c-ad73-3fed-a89c-d6b77e7ff08e",
                                                "text": "Dans la mythologie hawaïenne, Haumea est la déesse de l’accouchement et de la fertilité. Avant la création de la Terre, Haumea vivait dans un verger sur les arbres duquel poussaient tous les animaux et les plantes, […]."
                                            },
                                            {
                                                "example_id": "a88bb6f6-9251-4517-8ecd-762b68462beb",
                                                "sense_id": "1bff441c-ad73-3fed-a89c-d6b77e7ff08e",
                                                "text": "Accouchement difficile, laborieux."
                                            },
                                            {
                                                "example_id": "3a7df3af-4278-4121-9a7e-3c7dfae74575",
                                                "sense_id": "1bff441c-ad73-3fed-a89c-d6b77e7ff08e",
                                                "text": "Le travail de l’accouchement."
                                            },
                                            {
                                                "example_id": "3df2e82e-b5bc-493e-b342-90914db838b2",
                                                "sense_id": "1bff441c-ad73-3fed-a89c-d6b77e7ff08e",
                                                "text": "On l’entendit dire à l’un de ses beaux-frères qu’en somme l’accouchement est le service commandé des femmes : Fernande était morte au champ d’honneur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "12a09779-12b8-36f1-9168-7cc9560bd40f",
                                        "entry_id": "ed0a9be2-a14c-3c71-8181-d90bac19e0a5",
                                        "glosses": [
                                            "Action d’aider une femme à accoucher."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4491866-b064-433b-89a0-525cd2272d4d",
                                                "sense_id": "12a09779-12b8-36f1-9168-7cc9560bd40f",
                                                "text": "Pratiquer un accouchement."
                                            },
                                            {
                                                "example_id": "b87ee28a-d5bc-48b8-b512-87e46906cfba",
                                                "sense_id": "12a09779-12b8-36f1-9168-7cc9560bd40f",
                                                "text": "Ce chirurgien connaît bien la bonne méthode des accouchements."
                                            },
                                            {
                                                "example_id": "a8ee933b-dede-4148-8828-91d658cf0f65",
                                                "sense_id": "12a09779-12b8-36f1-9168-7cc9560bd40f",
                                                "text": "Faire un cours d’accouchement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e0220e5-ebd0-3301-b70b-68b7f49e2796",
                                        "entry_id": "ed0a9be2-a14c-3c71-8181-d90bac19e0a5",
                                        "glosses": [
                                            "Acte par lequel une femme se délivre ou bien et délivrée du produit de la conception, c'est-à-dire le fœtus et les annexes, pendant une époque où le fœtus est viable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b345496-5c1a-42c0-8475-c608ea3d4ed9",
                                                "sense_id": "6e0220e5-ebd0-3301-b70b-68b7f49e2796",
                                                "text": "Chaque accouchement est différent mais sur le plan physiologique, tous suivent trois étapes bien définies : le travail (dilatation du col de l'utérus et engagement du bébé), l'expulsion (la sortie du bébé) et la délivrance (expulsion du placenta)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c762e052-2bb4-3594-9d6e-63c0e466e7ac",
                                        "entry_id": "ed0a9be2-a14c-3c71-8181-d90bac19e0a5",
                                        "glosses": [
                                            "Mise en place, réalisation."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa8e0085-de1e-4691-85d1-dfe4b6b165b3",
                                                "sense_id": "c762e052-2bb4-3594-9d6e-63c0e466e7ac",
                                                "text": "L’accouchement de cet ouvrage a été laborieux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
