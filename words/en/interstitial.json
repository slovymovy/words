{
    "word_family": [
        "interstice"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a0106b71-938e-3cde-9db9-c13b9a6ec118",
                    "sense_definition": "Relating to or situated in the small spaces between things.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "spatial",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The body's cells are surrounded by <w>interstitial</w> fluid.",
                            "target_lang_translations": {
                                "zh": "人体细胞被<w>间质</w>液包围着。"
                            }
                        },
                        {
                            "text": "The author explores the <w>interstitial</w> spaces between different cultures.",
                            "target_lang_translations": {
                                "zh": "作者探索了不同文化之间的<w>中间</w>地带。"
                            }
                        }
                    ],
                    "synonyms": [
                        "intervening"
                    ],
                    "common_phrases": [
                        "interstitial fluid"
                    ],
                    "target_lang_definitions": {
                        "zh": "指位于事物之间的小空隙中的，或与这些空隙有关的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "间质的",
                                "target_lang_sense_clarification": "用于生物学或医学语境，指组织或细胞之间的。"
                            },
                            {
                                "target_lang_word": "中间的",
                                "target_lang_sense_clarification": "指处于事物之间或空隙之中的。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "bd958021-1336-3eea-a015-850311679b9d",
                    "sense_definition": "A web page, often containing an advertisement, that appears between two content pages.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "digital",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The website showed an <w>interstitial</w> before loading the main article.",
                            "target_lang_translations": {
                                "zh": "该网站在加载主文章前显示了一个<w>插页广告</w>。"
                            }
                        },
                        {
                            "text": "Users often find it annoying when an <w>interstitial</w> blocks their navigation.",
                            "target_lang_translations": {
                                "zh": "用户通常会觉得<w>插页广告</w>阻碍了他们的浏览体验，令人烦恼。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指在两个网页内容之间出现的页面，通常包含广告。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "插页广告",
                                "target_lang_sense_clarification": "互联网术语，指在网页跳转间隙弹出的广告页面。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8894f506-d2fd-3f92-b475-ed9c73905266",
                    "sense_definition": "An atom or particle occupying a space between the regular positions in a crystal lattice.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "scientific",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The presence of an <w>interstitial</w> can significantly alter the material's electrical properties.",
                            "target_lang_translations": {
                                "zh": "<w>间隙原子</w>的存在会显著改变材料的电学性质。"
                            }
                        },
                        {
                            "text": "Scientists studied how the <w>interstitial</w> moves through the crystal structure.",
                            "target_lang_translations": {
                                "zh": "科学家们研究了<w>间隙原子</w>如何在晶体结构中移动。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指占据晶格中正常位置之间空隙的原子或粒子。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "间隙原子",
                                "target_lang_sense_clarification": "材料科学术语，指位于晶体结构间隙中的原子。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}