                            {
                                "example_id": "4bfd4563-c2a7-4828-afba-48ef96d75ca0",
                                "sense_id": "133e5e02-66a7-33ec-904f-768f3236d962",
                                "text": "„Bis heute spielt das Ölgeschäft eine tragende Rolle in Nigerias Wirtschaft.“"
                            },
                            {
                                "example_id": "16287530-14e0-49a2-a673-2e5a5ad6c662",
                                "sense_id": "133e5e02-66a7-33ec-904f-768f3236d962",
                                "text": "„Die Neuankömmlinge, die das blühende Ölgeschäft hierhergelockt hatte, wussten natürlich nichts von solchen Dingen, und die Indianer und die alten Pioniere hatten schlicht Angst, wenn ich davon anfing.“"
                            }
                        ],
