        "fr-extract.jsonl": [
            {
                "entry_id": "2513d3a1-5b38-3803-9359-91c51be86016",
                "word": "bathyscaphe",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "74b84387-2f9b-4f62-bf00-c02ce8fd1cee",
                        "entry_id": "2513d3a1-5b38-3803-9359-91c51be86016",
                        "tags": [
                            "plural"
                        ],
                        "form": "bathyscaphes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "aaee7373-0690-3f29-b6f8-c2083cacab21",
                        "entry_id": "2513d3a1-5b38-3803-9359-91c51be86016",
                        "glosses": [
                            "Sous-marin d’exploration abyssale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a281fd5d-2ce3-4e3f-af7b-b4dd72cc137a",
                                "sense_id": "aaee7373-0690-3f29-b6f8-c2083cacab21",
                                "text": "On m'a souvent demandé pourquoi après le ballon stratosphérique, j'ai voulu construire le bathyscaphe, le sous-marin pour grandes profondeurs."
                            },
                            {
                                "example_id": "45085e1a-f47e-46b0-9a53-caf2bfd9d764",
                                "sense_id": "aaee7373-0690-3f29-b6f8-c2083cacab21",
                                "text": "Louis regardait les gens glisser le long des vitres comme des ombres sous-marines le long des parois d'un bathyscaphe, et l'embouteillage, au carrefour."
                            },
                            {
                                "example_id": "010b9429-68a8-4276-8962-2a8294390430",
                                "sense_id": "aaee7373-0690-3f29-b6f8-c2083cacab21",
                                "text": "bathyscaphe : Engin de plongée à grande profondeur, autonome et habité."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0fff59f4-4864-4001-ad83-41cd29db6bbd",
                        "source_entry_id": "2513d3a1-5b38-3803-9359-91c51be86016",
                        "source_sense_id": "aaee7373-0690-3f29-b6f8-c2083cacab21",
                        "target_lang_word": "Bathyskaph",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "a15e60d4-4d8d-4618-a9a0-1441fb618a36",
                        "source_entry_id": "2513d3a1-5b38-3803-9359-91c51be86016",
                        "source_sense_id": "aaee7373-0690-3f29-b6f8-c2083cacab21",
                        "target_lang_word": "Bathyscaph",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "614d300f-45f2-47de-8df6-a49b7b8d014d",
                        "source_entry_id": "2513d3a1-5b38-3803-9359-91c51be86016",
                        "source_sense_id": "aaee7373-0690-3f29-b6f8-c2083cacab21",
                        "target_lang_word": "bathyscaphe",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bathyscaphe",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ad3eef8e-159f-3bdf-81a9-620aaa8d6ace",
                                        "entry_id": "813126ae-f565-3818-b193-ae558cdc0a87",
                                        "glosses": [
                                            "A self-propelled deep-sea diving submersible for exploring the ocean depths, consisting of a crew cabin similar to a bathysphere suspended below a float filled with a buoyant liquid such as petrol."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "391ad78a-dd0d-497f-b6da-022d46a33a8c",
                                                "sense_id": "ad3eef8e-159f-3bdf-81a9-620aaa8d6ace",
                                                "text": "The fact that the bathyscaphes are self-propelled makes it possible to use them to study the ocean microstructure in the horizontal, although the experiment should include temporal changes, which can be achieved either by using associated buoy stations or using a second suspended bathyscaphe."
                                            },
                                            {
                                                "example_id": "23f61591-8ed1-4d46-a2c5-e7f7034d4b43",
                                                "sense_id": "ad3eef8e-159f-3bdf-81a9-620aaa8d6ace",
                                                "text": "It's ironic that when Piccard built his first bathyscaphe in the 1940s people assumed the revolutionary design had evolved from his famous stratospheric balloon. In fact, the reverse was true. In fact, Piccard's prototype bathyscaphe FNRS-2 (named for the Belgian national research foundation), which underwent sea trials in the Atlantic off Senegal in 1948, did possess all the attributes of a clumsy underwater balloon."
                                            },
                                            {
                                                "example_id": "7d1b4539-456a-4ed1-9c22-e58828c2597b",
                                                "sense_id": "ad3eef8e-159f-3bdf-81a9-620aaa8d6ace",
                                                "text": "After World War II, engineers built specialized submarines called bathyscaphes to survive the intense pressures of the deep ocean. A pioneer in bathyscaphes was the Swiss-born Belgian physicist Auguste Piccard (1884–1962), who had set the world altitude record in a balloon in 1932. Having turned his attention to the sea, Piccard and his son, Jacques Piccard (1922– ), built a bathyscaphe called the Trieste after World War II."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c542a906-b1ba-4957-ace0-356025ebd5d5",
                        "source_entry_id": "2513d3a1-5b38-3803-9359-91c51be86016",
                        "source_sense_id": "aaee7373-0690-3f29-b6f8-c2083cacab21",
                        "target_lang_word": "batiscafo",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "batiscafo",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "1b857901-89c2-324f-b8a0-b9a6520d4551",
                                        "entry_id": "3f516c42-49f4-3084-88a9-973a417ec74e",
                                        "glosses": [
                                            "Embarcación sumergible destinada a la exploración de los profundidades marinas, soportando la enorme presión del agua."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2794f74f-a186-41ea-8677-ff32ebaa7ccd",
                                                "sense_id": "1b857901-89c2-324f-b8a0-b9a6520d4551",
                                                "text": "«El batiscafo francés no detecta pérdidas en su primera inmersión»."
                                            },
                                            {
                                                "example_id": "82d02e59-76f3-46b1-b8bc-8964b5b87fd5",
                                                "sense_id": "1b857901-89c2-324f-b8a0-b9a6520d4551",
                                                "text": "«“En estos momentos, está atado a cables de remolque y nuestros barcos se encargan al mismo tiempo de levantar y remolcar el batiscafo hacia aguas menos profundas”, dijo el comandante jefe de la Flota del Pacífico rusa, almirante Viktor Fiodorov, a la televisión Rossia»."
                                            },
                                            {
                                                "example_id": "e76061f1-474f-45a9-bdf3-4732a985fcfa",
                                                "sense_id": "1b857901-89c2-324f-b8a0-b9a6520d4551",
                                                "text": "«El batiscafo se movía pesadamente, pero Fuencisla Carreter lo desplazaba a grandes trancos con la fogosidad de un hércules»."
                                            },
                                            {
                                                "example_id": "0e2fb11b-09ab-4019-9739-e1f427dd0751",
                                                "sense_id": "1b857901-89c2-324f-b8a0-b9a6520d4551",
                                                "text": "«El auto traspasó al fin las abiertas puertas de hierro del Palacio de las Dueñas y pareció que el batiscafo ascendía a lo largo de una pared vertical que no era sino el terrazo que rodeaba los jardines recibiendo de plano la caída amarilla de los rayos del sol»."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2bbe8401-9e31-4d03-8a20-8065429d3bf5",
                        "source_entry_id": "2513d3a1-5b38-3803-9359-91c51be86016",
                        "source_sense_id": "aaee7373-0690-3f29-b6f8-c2083cacab21",
                        "target_lang_word": "βαθυσκάφος",
                        "target_lang_code": "el",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "βαθυσκάφος",
                                "target_lang_code": "el",
                                "target_senses": [
                                    {
                                        "sense_id": "607b9633-65aa-31f1-b77e-5973de439fe6",
                                        "entry_id": "2788d01d-ac46-33fd-8f25-92968ea36b8a",
                                        "glosses": [
                                            "ειδικής κατασκευής αυτοπροωθούμενο υποβρύχιο σκάφος, που επιτρέπει την παρατήρηση και εξερεύνηση στα μεγάλα βάθη των ωκεανών, αποτελούμενο από μια σφαιρική καμπίνα για το πλήρωμα (παρόμοια με τη βαθύσφαιρα), η οποία αιωρείται κάτω από έναν πλωτήρα γεμάτο με κάποιο ελαφρύ και μη συμπιεζόμενο υγρό, συνήθως βενζίνη"
                                        ],
                                        "tags": [
                                            "ναυτικός όρος"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18183f2a-5024-4f33-9b3a-1f307275a522",
                                                "sense_id": "607b9633-65aa-31f1-b77e-5973de439fe6",
                                                "text": "※ Βαθυσκάφος. Παρόμοιο με τη βαθύσφαιρα, αλλά με ρυθμιστή πλευστότητας που του επιτρέπει να κανονίζει αυτόνομα το ρυθμό ανόδου/καθόδου χωρίς σύνδεση με σκάφος επιφάνειας μέσω καλωδίου.",
                                                "translation": "«Κατάδυση με διάφορα σκάφη. Βαθυσκάφος», στην «Προσωπική Ιστοσελίδα του (καθηγητή) Γ. Κυπραίου», Πανεπιστήμιο Πελοποννήσου (Σχολή Επιστημών Ανθρώπινης κίνησης και ποιότητας ζωής)· πρόσβαση: 2023-07-06."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
