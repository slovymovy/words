                                        "entry_id": "e3af6c09-c969-3d53-98d1-2aace7077850",
                                        "glosses": [
                                            "ta ścianka cegły, która ma najmniejszą powierzchnię"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0f19482-87fd-4dbe-9ea6-cf6afb4e7862",
                                                "sense_id": "0c460ee3-9e1d-3e7d-b9cb-7325157b07cc",
                                                "text": "Tak zwane wiązanie krakowskie, to cegły układane na przemian: wozówka i główka."
                                            }
