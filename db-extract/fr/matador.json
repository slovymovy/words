        "fr-extract.jsonl": [
            {
                "entry_id": "09472088-2dcf-3975-b8bc-2e09af112ea4",
                "word": "matador",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "3be92654-9b23-4691-bd4c-1415c90304c6",
                        "entry_id": "09472088-2dcf-3975-b8bc-2e09af112ea4",
                        "tags": [
                            "plural"
                        ],
                        "form": "matadors"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "13158a2c-acda-360a-a32f-e66eb66035b2",
                        "entry_id": "09472088-2dcf-3975-b8bc-2e09af112ea4",
                        "glosses": [
                            "Celui qui, dans les corridas, met l’animal à mort."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0e2afed-ac1b-46bd-b627-5fd35ec9616d",
                                "sense_id": "13158a2c-acda-360a-a32f-e66eb66035b2",
                                "text": "Un cholo ! un matador ! un homme qui boit de l’eau-de-vie et qui mange des oignons crus !"
                            },
                            {
                                "example_id": "f1d5ce42-e1a1-4d84-8e37-37b553fb973b",
                                "sense_id": "13158a2c-acda-360a-a32f-e66eb66035b2",
                                "text": "On n’emploie guère en Espagne le mot matador pour désigner celui qui tue le taureau, on l’appelle espada (épée), ce qui est plus noble et a plus de caractère ; l’on ne dit pas non plus toreador, mais bien torero. Je donne, en passant, cet utile renseignement à ceux qui font de la couleur locale dans les romances et dans les opéras-comiques."
                            },
                            {
                                "example_id": "ef5bb5c2-4feb-4ba7-a834-eb81e4cd046c",
                                "sense_id": "13158a2c-acda-360a-a32f-e66eb66035b2",
                                "text": "Après s'être vanté d'avoir travaillé à éteindre les lampions célestes par un geste magnifique, il se donne les allures d'un matador aux pieds duquel va tomber le taureau furieux."
                            },
                            {
                                "example_id": "fc6f1336-d6ea-4d98-9a6a-87fb7329b001",
                                "sense_id": "13158a2c-acda-360a-a32f-e66eb66035b2",
                                "text": "Jusqu’alors, et depuis plus de deux mois, l’arène était restée désespérément vide, malgré la mobilisation des alguazils, picadors et autres matadors, l’arsenal accumulé aussi des piques, des banderilles et même du poignard de fer."
                            },
                            {
                                "example_id": "83dfc30c-ff1c-405d-a47c-5b715460fb90",
                                "sense_id": "13158a2c-acda-360a-a32f-e66eb66035b2",
                                "text": "Le matador qui tire du danger couru l’occasion d’être plus brillant que jamais et montre toute la qualité de son style à l’instant qu’il est le plus menacé : voilà ce qui m’émerveillait, voilà ce que je voudrais être."
                            }
                        ]
                    },
                    {
                        "sense_id": "d255f1f3-7117-314c-91c4-615f4bbc4454",
                        "entry_id": "09472088-2dcf-3975-b8bc-2e09af112ea4",
                        "glosses": [
                            "Dans le jeu de l’hombre, désigne les cartes supérieures."
                        ],
                        "tags": [
                            "Cartes à jouer"
                        ],
                        "examples": [
                            {
                                "example_id": "cdc4a353-5d60-4681-af62-21135ff30c83",
                                "sense_id": "d255f1f3-7117-314c-91c4-615f4bbc4454",
                                "text": "Spadille, manille et baste sont les trois premiers matadors."
                            }
                        ]
                    },
                    {
                        "sense_id": "713ed85e-5317-3fdf-825c-f3d1ef374e26",
                        "entry_id": "09472088-2dcf-3975-b8bc-2e09af112ea4",
                        "glosses": [
                            "Jeu de dominos où l’on doit toujours faire sept."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "696f57ea-e12e-37a9-9e2b-fdf078ab61dd",
                        "entry_id": "09472088-2dcf-3975-b8bc-2e09af112ea4",
                        "glosses": [
                            "Outil utilisé en abattoir pour étourdir les animaux avant la mise à mort par saignée."
                        ],
                        "tags": [
                            "Boucherie"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "af97bb4e-73e6-4d2d-a0d7-eb68ebfc5745",
                        "source_entry_id": "09472088-2dcf-3975-b8bc-2e09af112ea4",
                        "source_sense_description": "Tauromachie",
                        "target_lang_word": "matador",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "matador",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ce81bfd2-3006-3705-862e-bffbd5f7dd61",
                                        "entry_id": "2fc1b77a-c779-3b0b-877d-c4b1ac8b38ec",
                                        "glosses": [
                                            "The person whose aim is to kill the bull in a bullfight."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0eac7af-58a9-4188-9e05-d3ca5474bd42",
                                                "sense_id": "ce81bfd2-3006-3705-862e-bffbd5f7dd61",
                                                "text": "[…] few of these boys know how to fight alone, and hardly any without a knife or a gun. They are not to be equated with matadors or boxers or Hemingway heroes. They are dangerous pack hounds who will not even expose themselves singly in the outfield."
                                            },
                                            {
                                                "example_id": "20746eb8-c90b-465d-91cf-ee07160cde41",
                                                "sense_id": "ce81bfd2-3006-3705-862e-bffbd5f7dd61",
                                                "text": "The second is La Macarena, named after an Arabian princess, and she was preferred by another great matador, Joselito, and to see her leave her parish church of San Gil at one in the morning of Good Friday or return later in the day is held by many Sevillanos to be the most important thing that can happen during Holy Week."
                                            },
                                            {
                                                "example_id": "d422e92f-bbdc-46a8-bef8-a013e257a97a",
                                                "sense_id": "ce81bfd2-3006-3705-862e-bffbd5f7dd61",
                                                "text": "Hemingway's subject for the epilogue was the mano a mano (or hand-to-hand, a duel) between Spain's two leading matadors, Luis Miguel Dominguin and his brother-in-law, Antonio Ordonez."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "72b05021-bade-352d-84d2-6713f2a4db5c",
                                        "entry_id": "2fc1b77a-c779-3b0b-877d-c4b1ac8b38ec",
                                        "glosses": [
                                            "A certain game of dominoes in which four dominoes (the 4-3, 5-2, 6-1, and double blank), called matadors, may be played at any time in any way."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f7e70982-bf5d-3d1e-8ff5-c42e90f1f914",
                                        "entry_id": "2fc1b77a-c779-3b0b-877d-c4b1ac8b38ec",
                                        "glosses": [
                                            "The jack of clubs, or any other trump held in sequence with it, in the game of skat."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "58665c24-7e0a-399e-bb7d-d790a1c6cca1",
                                        "entry_id": "2fc1b77a-c779-3b0b-877d-c4b1ac8b38ec",
                                        "glosses": [
                                            "One of the three chief cards in ombre and quadrille."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
