                "senses": [
                    {
                        "sense_id": "331c6eb3-bdc5-3936-9039-0e88a3db7ad6",
                        "entry_id": "43044f81-c45a-3c15-864c-b79f79b552eb",
                        "glosses": [
                            "Mitglied einer Säugetierfamilie aus der Ordnung der Chiroptera (Fledertiere oder Fledermäuse im weiteren Sinne, die hauptsächlich in den tropischen und subtropischen Regionen der alten Welt vorkommen)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52602828-5ea9-4373-8c5d-8cccdd055240",
                                "sense_id": "331c6eb3-bdc5-3936-9039-0e88a3db7ad6",
                                "text": "Die Flughunde bilden die einzige Familie aus der Unterordnung der Megachiroptera und stehen somit den Microchiroptera, den eigentlichen Fledermäusen, systematisch gegenüber."
                            },
                            {
                                "example_id": "d2d6dfcf-2396-449f-ae7b-a6dbebfd3271",
                                "sense_id": "331c6eb3-bdc5-3936-9039-0e88a3db7ad6",
                                "text": "„Während Kourou das Huhn schlachtete – es schien ohnehin mehr tot als lebendig –, schoss Kaba mit seiner Steinschleuder acht Flughunde, die sich nicht schnell genug von ihrem Schlafbaum schwingen konnten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
