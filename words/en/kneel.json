{
    "word_family": [
        "knee",
        "kneecap"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b5a03a6e-50a1-33ee-8a29-e12b04e53014",
                    "sense_definition": "To rest on one's bent knees or move into such a position.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "posture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The knight had to <w>kneel</w> before the king to receive his honor.",
                            "target_lang_translations": {
                                "zh": "骑士必须在国王面前<w>跪</w>下以接受封赏。"
                            }
                        },
                        {
                            "text": "She was <w>kneeling</w> on the floor to look for her lost earring.",
                            "target_lang_translations": {
                                "zh": "她正<w>跪</w>在地板上寻找丢失的耳环。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "kneel down"
                    ],
                    "target_lang_definitions": {
                        "zh": "双膝着地或处于双膝着地的姿势。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "跪",
                                "target_lang_sense_clarification": "指双膝着地，最常用的动词。"
                            },
                            {
                                "target_lang_word": "跪下",
                                "target_lang_sense_clarification": "指从站立或坐姿变为双膝着地的动作。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "32927735-f0fb-391d-a3c3-4de18a3882df",
                    "sense_definition": "To rest on one's knees, often used reflexively or in a literary context.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "posture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The weary traveler <w>knelt</w> himself down by the stream to drink.",
                            "target_lang_translations": {
                                "zh": "疲惫的旅行者在溪边<w>跪</w>下喝水。"
                            }
                        },
                        {
                            "text": "He <w>knelt</w> down to pray in the quiet chapel.",
                            "target_lang_translations": {
                                "zh": "他在安静的小礼拜堂里<w>跪</w>下祈祷。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "knelt down"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Often used in older literary or religious texts."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "双膝着地，常用于祈祷或文学语境。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "跪拜",
                                "target_lang_sense_clarification": "指跪下并叩头，常用于宗教或礼仪场合。"
                            },
                            {
                                "target_lang_word": "跪地",
                                "target_lang_sense_clarification": "强调双膝着地的状态，多见于书面语。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d2878aff-4c16-33ef-8f1a-ea45ce1a6c9b",
                    "sense_definition": "To lower the floor of a vehicle so that the entrance is level with the pavement for easier access.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "vehicle_function",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bus driver will <w>kneel</w> the vehicle to help the elderly passenger board.",
                            "target_lang_translations": {
                                "zh": "公交车司机将<w>降低底盘</w>以帮助老年乘客上车。"
                            }
                        },
                        {
                            "text": "Modern city buses are designed to <w>kneel</w> at every stop.",
                            "target_lang_translations": {
                                "zh": "现代城市公交车被设计为在每一站都能<w>降低底盘</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指公交车等车辆降低底盘，使车门与路面齐平以便乘客上下。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "降低底盘",
                                "target_lang_sense_clarification": "描述车辆为了方便乘客上下而采取的机械动作。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ef5435f2-6e93-31df-ab20-31166b864ac2",
                    "sense_definition": "To force or cause someone or something to assume a kneeling position.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "posture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The guard <w>knelt</w> the prisoner down before the judge.",
                            "target_lang_translations": {
                                "zh": "守卫强迫囚犯在法官面前<w>跪</w>下。"
                            }
                        },
                        {
                            "text": "She carefully <w>knelt</w> the doll to fit it inside the small box.",
                            "target_lang_translations": {
                                "zh": "她小心地让玩偶<w>跪</w>着，以便把它装进小盒子里。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "强迫或使某人或某物处于跪姿。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "使……跪下",
                                "target_lang_sense_clarification": "指通过外力迫使对象进入跪姿。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}