                            {
                                "example_id": "0e62c09a-5e32-4496-a6ac-73aefac5a0ea",
                                "sense_id": "8e7254c5-5f2d-3fef-be6d-8bb3ee434d7a",
                                "text": "Den ganzen Sommer blühen die Strohblumen."
                            },
                            {
                                "example_id": "29e481c8-c850-4028-ad41-b4dcd5b66e24",
                                "sense_id": "8e7254c5-5f2d-3fef-be6d-8bb3ee434d7a",
                                "text": "Immer häufiger werden Strohblumen im Blumenkasten gehalten."
                            }
