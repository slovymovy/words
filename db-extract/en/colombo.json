                                    {
                                        "sense_id": "4eeb202b-ef78-342b-a728-3a181835a4d5",
                                        "entry_id": "884d0e4e-80fb-39ec-9e1c-cf84a357cf0b",
                                        "glosses": [
                                            "Ville du Sri Lanka, ancienne capitale officielle et capitale économique de ce pays."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36adac50-f6ef-43ed-bc1a-0aa72117276e",
                                                "sense_id": "4eeb202b-ef78-342b-a728-3a181835a4d5",
                                                "text": "Hier après-midi, Anastasia m’a donné un plaisir extrême. Aucune masseuse de Bangkok, aucun michetonneur de Manille ou de Colombo n’aurait pu m’en donner davantage."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c57680f4-d920-420b-be4e-081158c70bc4",
                        "source_entry_id": "55788454-da1a-3eba-81ac-a43067e4af34",
                        "source_sense_id": "5afb00ac-1c12-32d4-bc88-7bea033a5d10",
                        "source_sense_description": "capital of Sri Lanka",
                        "target_lang_word": "Colombo",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Colombo",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "835ac2a3-72b7-307d-ada1-fbbd4834dd50",
                                        "entry_id": "d3828871-1baa-3b9c-98cb-3492a32f22f7",
                                        "glosses": [
                                            "de facto Hauptstadt von Sri Lanka"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf7245e3-cae6-4c51-aa60-9893f821ea89",
                                                "sense_id": "835ac2a3-72b7-307d-ada1-fbbd4834dd50",
                                                "text": "„Colombo ist seit dem 5. Jahrhundert als Hafenstadt bekannt, die unter anderem römischen, arabischen und chinesischen Händlern als Station diente.“"
                                            },
                                            {
                                                "example_id": "a122b317-bc4e-4a81-a727-bd745a673e4b",
                                                "sense_id": "835ac2a3-72b7-307d-ada1-fbbd4834dd50",
                                                "text": "„Im 16. Jahrhundert nahmen die Portugiesen einige Küstengebiete Sri Lankas, unter anderem Colombo und seinen Hafen, in Besitz.“"
                                            },
                                            {
                                                "example_id": "1229ca80-fc31-4902-91dd-c0cede7c4fee",
                                                "sense_id": "835ac2a3-72b7-307d-ada1-fbbd4834dd50",
                                                "text": "„In Sri Lankas Hauptstadt Colombo hat am Mittwoch eine Regierungskommission ihre Arbeit aufgenommen, die sich mit den letzten Jahren des Bürgerkriegs gegen die Rebellen der Befreiungstiger für Tamil Eelam (LTTE) befasst.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
