                "senses": [
                    {
                        "sense_id": "3bfd963c-5003-3cdb-a8e9-9647163ef4fb",
                        "entry_id": "57a4408a-331e-345b-91c1-1aa07103bbb3",
                        "glosses": [
                            "„Stäbchen, das beim Abbrennen einen wohlriechenden Rauch erzeugt“"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3432abeb-844e-4ebf-b0dc-72a65651a51d",
                                "sense_id": "3bfd963c-5003-3cdb-a8e9-9647163ef4fb",
                                "text": "„Am Morgen von Khao Pansaa besuchen die buddhistischen Gläubigen die Tempel und bringen den Mönchen Nahrungsmittel, Dinge des täglichen Bedarfs, Geld, die traditionellen Kerzen und Räucherstäbchen, Kleidungsstücke und andere zeremonielle Gegenstände.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "49bb8d56-72ef-4c80-88d7-7f301d95656c",
                        "source_entry_id": "57a4408a-331e-345b-91c1-1aa07103bbb3",
                        "source_sense_id": "3bfd963c-5003-3cdb-a8e9-9647163ef4fb",
                        "target_lang_word": "joss stick",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "joss stick",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "873685cb-c426-354f-8fec-3e9631774554",
                                        "entry_id": "b7acc30f-b2c3-37a5-bff3-68769fb0935b",
                                        "glosses": [
                                            "A stick of incense, especially (Taoism, Buddhism, etc.) those burned as an offering before a Chinese shrine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd4e676d-3a16-43ba-987a-eeb2b1e942d9",
                                                "sense_id": "873685cb-c426-354f-8fec-3e9631774554",
                                                "text": "For instance, Hawkins, Lewis, Hankin and Sengupta all cover the word agarbatti, an incense stick or joss stick, but there is no way of knowing when this term was first used in Indian English, nor whether it is now current or obsolete."
                                            }
                                        ]
                                    }
                                ]
