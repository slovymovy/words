                "senses": [
                    {
                        "sense_id": "f75082af-c315-35f9-be61-ea5c818a346c",
                        "entry_id": "e752c5df-d05c-34d2-b3a4-c267a752c494",
                        "glosses": [
                            "Mettre aux normes des hôtels Le Méridien."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76c98a23-33fc-43c9-8a9e-e996747e0c5f",
                                "sense_id": "f75082af-c315-35f9-be61-ea5c818a346c",
                                "text": "Aux côtés de deux autres unités du groupe (Les Mérinides et Le Berbère Palace), «La Tour Hassan», rouvert et «méridianisé» depuis une dizaine de jours, constituera le fer de lance du nouveau concept « Palaces et traditions» lancé l'an dernier par la chaîne KTH."
                            },
                            {
                                "example_id": "5534557f-bdc3-4683-8f1d-c6d3edfdae68",
                                "sense_id": "f75082af-c315-35f9-be61-ea5c818a346c",
                                "text": "Afin de méridianiser l'hôtel, le groupe a dépêché une équipe, qui est restée six mois sur place pour former tout le personnel aux normes de la chaîne française."
                            },
                            {
                                "example_id": "281bac5d-9744-40d8-bfe9-c49b0e508249",
                                "sense_id": "f75082af-c315-35f9-be61-ea5c818a346c",
                                "text": "Puis, à la direction Le Méridien de Fès, où j'ai eu le plaisir de «méridianiser» les Mérinides de Fès."
                            },
                            {
                                "example_id": "49d7405a-c3ba-4dd9-944b-0f3e22481c01",
                                "sense_id": "f75082af-c315-35f9-be61-ea5c818a346c",
                                "text": "Après avoir méridianisé Les Mérinides, j'ai dû dé-méridianiser La Tour Hassan…"
                            }
                        ]
                    }
                ],
