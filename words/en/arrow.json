{
    "word_family": [
        "arrowhead",
        "arrowy",
        "broadarrow"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e2ecdb39-b082-375c-8e31-e0ad701b453a",
                    "sense_definition": "A weapon consisting of a thin, straight stick with a sharp point at one end and feathers at the other, designed to be shot from a bow.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "projectile_weapon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The archer pulled back the string and released the <w>arrow</w> at the target.",
                            "target_lang_translations": {
                                "ru": "Лучник натянул тетиву и выпустил <w>стрелу</w> в цель.",
                                "zh": "弓箭手拉开弓弦，朝靶子射出一支<w>箭</w>。"
                            }
                        },
                        {
                            "text": "In the museum, we saw a medieval bow and <w>arrow</w> used in ancient battles.",
                            "target_lang_translations": {
                                "ru": "В музее мы видели средневековый лук и <w>стрелу</w>, использовавшиеся в древних битвах.",
                                "zh": "在博物馆里，我们看到了古代战争中使用的中世纪弓和<w>箭</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "bow and arrow",
                        "shoot an arrow",
                        "straight as an arrow"
                    ],
                    "target_lang_definitions": {
                        "ru": "Оружие, состоящее из тонкого прямого стержня с острым наконечником с одной стороны и оперением с другой, предназначенное для стрельбы из лука.",
                        "zh": "一种武器，由细长笔直的杆身、一端的尖头和另一端的羽翎组成，用弓射出。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стрела",
                                "target_lang_sense_clarification": "оружие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "箭",
                                "target_lang_sense_clarification": "从弓射出的武器"
                            },
                            {
                                "target_lang_word": "矢",
                                "target_lang_sense_clarification": "书面语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e1b2fe83-cb21-32fe-ad41-c1b050183d11",
                    "sense_definition": "A mark or sign that looks like an arrow, used to indicate direction or position.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "symbol_direction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please follow the green <w>arrow</w> to find the emergency exit.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, следуйте за зеленой <w>стрелкой</w>, чтобы найти запасной выход.",
                                "zh": "请顺着绿色<w>箭头</w>走，找到紧急出口。"
                            }
                        },
                        {
                            "text": "The <w>arrow</w> on the compass always points towards the north.",
                            "target_lang_translations": {
                                "ru": "<w>Стрелка</w> компаса всегда указывает на север.",
                                "zh": "罗盘上的<w>箭头</w>总是指向北方。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "follow the arrow",
                        "green arrow",
                        "red arrow"
                    ],
                    "target_lang_definitions": {
                        "ru": "Знак или символ в форме стрелы, используемый для указания направления или положения.",
                        "zh": "一种看起来像箭的记号或符号，用来表示方向或位置。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стрелка",
                                "target_lang_sense_clarification": "указатель"
                            },
                            {
                                "target_lang_word": "стрела",
                                "target_lang_sense_clarification": "символ"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "箭头",
                                "target_lang_sense_clarification": "表示方向或位置的标记"
                            },
                            {
                                "target_lang_word": "箭形符号",
                                "target_lang_sense_clarification": "较书面，强调符号本身"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aedeb05f-94ef-35a0-bdb3-59bad2c09a75",
                    "sense_definition": "A line connecting two nodes in a graph that has a specific direction.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "math_graph",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In this diagram, each <w>arrow</w> represents the flow of data from one process to another.",
                            "target_lang_translations": {
                                "ru": "На этой диаграмме каждая <w>стрелка</w> обозначает поток данных от одного процесса к другому.",
                                "zh": "在这张图中，每个<w>箭头</w>都表示数据从一个过程流向另一个过程。"
                            }
                        },
                        {
                            "text": "The mathematician drew a directed edge, or <w>arrow</w>, to connect the two vertices.",
                            "target_lang_translations": {
                                "ru": "Математик нарисовал ориентированное ребро, или <w>стрелку</w>, чтобы соединить две вершины.",
                                "zh": "这位数学家画了一条有向边，也就是一条<w>弧</w>，来连接这两个顶点。"
                            }
                        }
                    ],
                    "synonyms": [
                        "directed edge",
                        "arc"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "mathematics"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Линия, соединяющая два узла графа и имеющая определенное направление.",
                        "zh": "在图中连接两个节点并具有特定方向的线。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стрелка",
                                "target_lang_sense_clarification": "в диаграммах"
                            },
                            {
                                "target_lang_word": "дуга",
                                "target_lang_sense_clarification": "математический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "弧",
                                "target_lang_sense_clarification": "图论术语"
                            },
                            {
                                "target_lang_word": "有向边",
                                "target_lang_sense_clarification": "图论术语，强调有方向的边"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "227aa1ce-c2b9-3263-ba8e-59ff68e45b6f",
                    "sense_definition": "To move very quickly and directly towards a specific place.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "move_swiftly",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The jet <w>arrowed</w> through the clouds, leaving a white trail behind it.",
                            "target_lang_translations": {
                                "ru": "Реактивный самолет <w>устремился</w> сквозь облака, оставляя за собой белый след.",
                                "zh": "喷气式飞机<w>飞驰</w>穿过云层，身后留下一道白色尾迹。"
                            }
                        },
                        {
                            "text": "A startled bird <w>arrowed</w> up into the sky when we approached the tree.",
                            "target_lang_translations": {
                                "ru": "Испуганная птица <w>взвилась</w> в небо, когда мы подошли к дереву.",
                                "zh": "当我们靠近那棵树时，一只受惊的鸟猛地<w>直冲</w>天空。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Двигаться очень быстро и прямо в определенном направлении.",
                        "zh": "非常迅速而笔直地朝某个地方移动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лететь стрелой",
                                "target_lang_sense_clarification": "образно"
                            },
                            {
                                "target_lang_word": "устремляться",
                                "target_lang_sense_clarification": "быстро двигаться"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "飞驰",
                                "target_lang_sense_clarification": "快速前进"
                            },
                            {
                                "target_lang_word": "直冲",
                                "target_lang_sense_clarification": "朝某处迅猛前进"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c41c844a-e044-3c4b-afa5-b4863a6e5df1",
                    "sense_definition": "To navigate through text or a menu on a computer screen using the arrow keys.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "computing_nav",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You need to <w>arrow</w> down to the bottom of the document to sign it.",
                            "target_lang_translations": {
                                "ru": "Вам нужно <w>пролистать</w> вниз до конца документа, чтобы подписать его.",
                                "zh": "你需要<w>用方向键向下移动</w>到文档底部，然后签名。"
                            }
                        },
                        {
                            "text": "Simply <w>arrow</w> left or right to scroll through the different pictures.",
                            "target_lang_translations": {
                                "ru": "Просто <w>нажимайте стрелки</w> влево или вправо, чтобы пролистать разные фотографии.",
                                "zh": "只要<w>用方向键左右移动</w>，就可以浏览不同的图片。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "arrow down",
                        "arrow over"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "computing"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Перемещаться по тексту или меню на экране компьютера с помощью клавиш со стрелками.",
                        "zh": "用键盘上的方向键在电脑屏幕上的文本或菜单中移动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перемещаться стрелками",
                                "target_lang_sense_clarification": "навигация"
                            },
                            {
                                "target_lang_word": "листать",
                                "target_lang_sense_clarification": "прокручивать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "用方向键移动",
                                "target_lang_sense_clarification": "用键盘方向键进行导航"
                            },
                            {
                                "target_lang_word": "用方向键浏览",
                                "target_lang_sense_clarification": "在屏幕内容中用方向键浏览"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cef071e1-8031-3c98-a99b-983e007afaaf",
                    "sense_definition": "To assign someone an undesirable task or responsibility.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "slang_assign",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I was hoping to leave early, but my boss decided to <w>arrow</w> me to finish the report.",
                            "target_lang_translations": {
                                "ru": "Я надеялся уйти пораньше, но босс решил <w>напрячь</w> меня закончить отчет.",
                                "zh": "我本来想早点走，但老板决定把完成报告这件事<w>甩给</w>我。"
                            }
                        },
                        {
                            "text": "Don't let them <w>arrow</w> you into organizing the holiday party again.",
                            "target_lang_translations": {
                                "ru": "Не дай им снова <w>повесить</w> на тебя организацию праздничной вечеринки.",
                                "zh": "别让他们又把组织节日派对的事<w>甩给</w>你。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Singapore"
                        },
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Поручить кому-либо нежелательную задачу или ответственность.",
                        "zh": "把令人不快的任务或责任交给某人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "напрячь",
                                "target_lang_sense_clarification": "сленг"
                            },
                            {
                                "target_lang_word": "повесить",
                                "target_lang_sense_clarification": "задачу"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "甩给",
                                "target_lang_sense_clarification": "口语，指把麻烦事推给别人"
                            },
                            {
                                "target_lang_word": "硬塞给",
                                "target_lang_sense_clarification": "指把不想做的任务硬交给别人"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "0f6e9a20-a81a-31d6-9e2f-1b11edd22283",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "proper_name",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Arrow</w> was known for his contributions to economics.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Эрроу</w> был известен своим вкладом в экономику.",
                                "zh": "<w>艾罗</w>先生因其对经济学的贡献而闻名。"
                            }
                        },
                        {
                            "text": "We met a family with the last name <w>Arrow</w> during our trip.",
                            "target_lang_translations": {
                                "ru": "Во время нашей поездки мы встретили семью с фамилией <w>Эрроу</w>.",
                                "zh": "旅行期间，我们遇到了一户姓<w>艾罗</w>的人家。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия.",
                        "zh": "一个姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Эрроу",
                                "target_lang_sense_clarification": "имя собственное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "艾罗",
                                "target_lang_sense_clarification": "姓氏音译"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2b04339e-cfeb-30d0-9937-da20b3037446",
                    "sense_definition": "A river in England that flows into the River Avon.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "proper_name_geo",
                    "name_type": "geographical_feature",
                    "examples": [
                        {
                            "text": "The River <w>Arrow</w> winds through the countryside of Warwickshire.",
                            "target_lang_translations": {
                                "ru": "Река <w>Эрроу</w> петляет по сельской местности Уорикшира.",
                                "zh": "<w>艾罗河</w>蜿蜒流过沃里克郡的乡间。"
                            }
                        },
                        {
                            "text": "Local fishermen often visit the banks of the <w>Arrow</w> in the summer.",
                            "target_lang_translations": {
                                "ru": "Местные рыбаки часто посещают берега <w>Эрроу</w> летом.",
                                "zh": "当地渔民夏天常常来到<w>艾罗河</w>河岸。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Река в Англии, впадающая в реку Эйвон.",
                        "zh": "英格兰的一条河流，注入埃文河。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Эрроу",
                                "target_lang_sense_clarification": "география"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "艾罗河",
                                "target_lang_sense_clarification": "英国河流名"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "article",
            "senses": [
                {
                    "sense_id": "6d891515-60b6-3815-8dee-24d9c49f7a9f",
                    "sense_definition": "A dialectal contraction of the phrase 'ever a'.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "dialect_contraction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I don't believe there is <w>arrow</w> servant in the house who saw what happened.",
                            "target_lang_translations": {
                                "ru": "Я не верю, что в доме есть <w>хоть один</w> слуга, который видел, что произошло.",
                                "zh": "我不相信屋里有<w>哪怕一个</w>仆人看见了发生的事。"
                            }
                        },
                        {
                            "text": "Have you got <w>arrow</w> penny to spare for a traveler?",
                            "target_lang_translations": {
                                "ru": "У тебя не найдется <w>хоть</w> пенни для путешественника?",
                                "zh": "你有哪怕一便士可以施舍给一位旅行者吗？"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Диалектное сокращение фразы 'ever a' (хоть какой-нибудь).",
                        "zh": "方言中 ever a 的缩略形式，表示“哪怕一个”或“任何一个”。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хоть какой-то",
                                "target_lang_sense_clarification": "значение"
                            },
                            {
                                "target_lang_word": "какой-либо",
                                "target_lang_sense_clarification": "значение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "哪怕一个",
                                "target_lang_sense_clarification": "表示“甚至一个也……”"
                            },
                            {
                                "target_lang_word": "任何一个",
                                "target_lang_sense_clarification": "表示“任何一个”"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}