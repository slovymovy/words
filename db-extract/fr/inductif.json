                                "example_id": "dffa92c5-4d43-4d87-9509-0f4d91ef81e8",
                                "sense_id": "5d472a1f-a8ee-3173-b7e0-85fc9a94073d",
                                "text": "Raisonnement inductif."
                            },
                            {
                                "example_id": "e391336d-41ca-4533-9ea4-04d2db0f60e0",
                                "sense_id": "5d472a1f-a8ee-3173-b7e0-85fc9a94073d",
                                "text": "Méthode inductive."
                            }
                        ]
