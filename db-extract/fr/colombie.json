            {
                "entry_id": "4389a0db-c6e3-394d-a870-ae18f207c974",
                "word": "Colombie",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "a1d5825a-858f-3b77-a51e-0e222439e162",
                        "entry_id": "4389a0db-c6e3-394d-a870-ae18f207c974",
                        "glosses": [
                            "Pays d’Amérique du Sud, bordé par la mer des Caraïbes au nord, le Venezuela à l’est, le Brésil au sud-est, le Pérou au sud, l’Équateur au sud-ouest, le Pacifique Nord à l’ouest, et le Panama au nord-ouest, et dont la capitale est Bogotá."
                        ],
                        "tags": [
                            "Pays"
                        ],
                        "examples": [
                            {
                                "example_id": "2be42d03-847c-496f-bf18-775b135c88f1",
                                "sense_id": "a1d5825a-858f-3b77-a51e-0e222439e162",
                                "text": "À Bogota, à Barranquilla, à Cali, dans les endroits les plus reculés de la Colombie, des hommes armés surgissaient, bloquaient avec leur voiture volée les camionnettes de transports de fonds qui, en quelques secondes, changeaient de bord !"
                            },
                            {
                                "example_id": "f1341d0f-f2af-406a-b25a-ba3c59f6eb98",
                                "sense_id": "a1d5825a-858f-3b77-a51e-0e222439e162",
                                "text": "Leur entraîneur disait encore ce matin que la Colombie exporterait bientôt plus de puzzlistes que de café !"
                            },
                            {
                                "example_id": "bc12a47a-4b2b-4c9f-ba5e-217c48480bf1",
                                "sense_id": "a1d5825a-858f-3b77-a51e-0e222439e162",
                                "text": "Chez les hommes, un autre membre du pôle rochelais, Laszlo Godde, s’est qualifié hier avec la France, face à la Colombie (2-1) pour les quarts de finale par équipes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e4124202-7fd9-464e-8b35-4f50b480ddf7",
                        "source_entry_id": "4389a0db-c6e3-394d-a870-ae18f207c974",
                        "source_sense_id": "a1d5825a-858f-3b77-a51e-0e222439e162",
                        "target_lang_word": "Kolumbien",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kolumbien",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a5a3635d-feb1-3a80-9144-278902bf02ea",
                                        "entry_id": "7f847b33-8b86-34ed-8174-c02da82f8d26",
                                        "glosses": [
                                            "Staat in Südamerika"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04170ce3-fd45-4b4b-97f7-c6e5df787f8a",
                                                "sense_id": "a5a3635d-feb1-3a80-9144-278902bf02ea",
                                                "text": "Bogotá ist die Hauptstadt von Kolumbien."
                                            },
                                            {
                                                "example_id": "4de06d3b-5c12-45b3-82e6-44c47f472050",
                                                "sense_id": "a5a3635d-feb1-3a80-9144-278902bf02ea",
                                                "text": "Kolumbiens Wirtschaft wächst trotz der Unruhen kontinuierlich und stellt damit in Südamerika den größten Wachstumsmarkt nach Chile dar."
                                            },
                                            {
                                                "example_id": "bcaaefb1-14b6-4a26-a0cd-013cc215ff43",
                                                "sense_id": "a5a3635d-feb1-3a80-9144-278902bf02ea",
                                                "text": "Die westliche Hälfte Kolumbiens wird von den Anden dominiert[.]"
                                            },
                                            {
                                                "example_id": "a90c995c-3222-4a39-8219-c33498d5f4cb",
                                                "sense_id": "a5a3635d-feb1-3a80-9144-278902bf02ea",
                                                "text": "„Nun war es eben dieser verlorene Sohn, der ihnen sein Haus in Kolumbien öffnete.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
