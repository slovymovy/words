                        "cross_references": [
                            {
                                "target_word": "지다",
                                "target_lang_code": "ko",
                                "target_senses": [
                                    {
                                        "sense_id": "02ca97cd-6ae4-38ba-a1d8-e836ca1ef16b",
                                        "entry_id": "e2d4d564-7e75-3b2f-b134-f02473806bd8",
                                        "glosses": [
                                            "해나 달이 기울어 보이지 않게 되다."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fdf84a41-e3fe-4801-b82f-f35c79465b1e",
                                                "sense_id": "02ca97cd-6ae4-38ba-a1d8-e836ca1ef16b",
                                                "text": "바닷가에서 해 지는 광경을 보면서 추억을 더듬다."
                                            },
                                            {
                                                "example_id": "c6f2451c-152b-4e1f-84e3-0bbefe2e32d2",
                                                "sense_id": "02ca97cd-6ae4-38ba-a1d8-e836ca1ef16b",
                                                "text": "이미 달은 서산에 졌는데 동녘 하늘에서 해가 솟지 않는다."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1aef9463-887d-3001-97dc-0cb1a1a3d79e",
                                        "entry_id": "e2d4d564-7e75-3b2f-b134-f02473806bd8",
                                        "glosses": [
                                            "묻었거나 붙어 있던 것을 닦이거나 씻어 없어지다."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61c2738b-697f-4ad6-8b3d-91177f2c4c9e",
                                                "sense_id": "1aef9463-887d-3001-97dc-0cb1a1a3d79e",
                                                "text": "와이셔처에 얼룩이 졌다."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "12867997-5d0d-3cff-81e7-b85533f922fc",
                                        "entry_id": "e2d4d564-7e75-3b2f-b134-f02473806bd8",
                                        "glosses": [
                                            "시합이나 내기에서 얻은 점수가 상대보다 적거나 또는 힘에서 눌리다."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "646109d0-c554-4108-aec0-b19c36d02818",
                                                "sense_id": "12867997-5d0d-3cff-81e7-b85533f922fc",
                                                "text": "한국 축구팀이 준결승에서 안타깝게도 지고 말았다."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8d6d7cba-6cb7-3561-ac4f-0435c7ac738d",
                                        "entry_id": "e2d4d564-7e75-3b2f-b134-f02473806bd8",
                                        "glosses": [
                                            "무엇이 이러저러하게 되다."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9f087f9-c4b4-4050-8cbe-d8d3bdca17ee",
                                                "sense_id": "8d6d7cba-6cb7-3561-ac4f-0435c7ac738d",
                                                "text": "커피를 쏟아서 바지에 얼룩이 졌다."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bb101781-12d7-307d-8f7c-871ef2cf4553",
                                        "entry_id": "e2d4d564-7e75-3b2f-b134-f02473806bd8",
                                        "glosses": [
                                            "무엇을 등이나 몸의 한 부위 또는 도구 위에 얹어 받다. (비유) 무엇의 책임을 넘겨 받다."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7fc63efe-51ff-476d-9ecb-317c3a001eed",
                                                "sense_id": "bb101781-12d7-307d-8f7c-871ef2cf4553",
                                                "text": "등에 배낭을 지고 구보를 하다."
                                            },
                                            {
                                                "example_id": "171b8840-7983-4e0a-9563-cf8a07c1391b",
                                                "sense_id": "bb101781-12d7-307d-8f7c-871ef2cf4553",
                                                "text": "자기가 한 행위에 대해서는 스스로 책임을 지는 것이 어른된 도리이다."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "지다",
                                "target_lang_code": "ko",
                                "target_senses": [
                                    {
                                        "sense_id": "d52e0556-656f-32d2-a8e8-116f8d39f397",
                                        "entry_id": "f21fb110-7565-30c7-8c05-1d305c2d14b1",
                                        "glosses": [
                                            "(동사 뒤에서 '-어지다' 구성으로 쓰여) 남의 힘에 의하여 앞말이 뜻하는 행동을 입음을 나타내는 말."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d76fa05-7de0-4562-b3d5-c5f96cc731fc",
                                                "sense_id": "d52e0556-656f-32d2-a8e8-116f8d39f397",
                                                "text": "이 건물은 예술적인 아름다움이 보태어졌다."
                                            },
                                            {
                                                "example_id": "c1c1b3a4-3bc0-431a-8042-3e6bd4529c45",
                                                "sense_id": "d52e0556-656f-32d2-a8e8-116f8d39f397",
                                                "text": "약속 시간이 1시간 늦춰졌다."
                                            },
                                            {
                                                "example_id": "ff61f283-8a3f-407f-9cf1-4dab47d4480c",
                                                "sense_id": "d52e0556-656f-32d2-a8e8-116f8d39f397",
                                                "text": "새로운 말이 만들어지다."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "41330e28-31c9-39c3-bbb0-fcd48c3f1afe",
                                        "entry_id": "f21fb110-7565-30c7-8c05-1d305c2d14b1",
                                        "glosses": [
                                            "(동사 뒤에서 '-어지다' 구성으로 쓰여) 앞말이 뜻하는 대로 하게 됨을 나타내는 말."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eeee9388-a7bf-4e47-bc62-1c0d356f4d81",
                                                "sense_id": "41330e28-31c9-39c3-bbb0-fcd48c3f1afe",
                                                "text": "그 사람의 말이 사실인 것처럼 믿어진다."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "028a90fb-f64a-348e-9d93-498269545fd3",
                                        "entry_id": "f21fb110-7565-30c7-8c05-1d305c2d14b1",
                                        "glosses": [
                                            "(형용사 뒤에서 '-어지다' 구성으로 쓰여) 앞말이 뜻하는 상태로 됨을 나타내는 말."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e43e7784-71b1-44b4-8302-305c0d370156",
                                                "sense_id": "028a90fb-f64a-348e-9d93-498269545fd3",
                                                "text": "마음이 따뜻해지다."
                                            },
                                            {
                                                "example_id": "2b15eacf-d8c8-46bc-889b-e32e8f340f50",
                                                "sense_id": "028a90fb-f64a-348e-9d93-498269545fd3",
                                                "text": "얼굴이 고와지다."
                                            },
                                            {
                                                "example_id": "00172720-a615-458b-80f2-424b85634e36",
                                                "sense_id": "028a90fb-f64a-348e-9d93-498269545fd3",
                                                "text": "방이 깨끗해지다."
                                            },
                                            {
                                                "example_id": "7b1c8d13-72de-41dc-a5ce-edefcf58293b",
                                                "sense_id": "028a90fb-f64a-348e-9d93-498269545fd3",
                                                "text": "생각을 바꾸니 마음이 평화로워졌다."
                                            }
                                        ]
                                    }
                                ]
                            },
