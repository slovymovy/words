    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "83b1c702-31e3-33a9-a6a8-d5bf2e510bc7",
                    "sense_definition": "To write something down quickly or make a brief note of it.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please wait a moment while I <w>jot</w> down your phone number."
                        },
                        {
                            "text": "She took out a small notebook to <w>jot</w> down the main ideas from the lecture."
                        }
                    ],
                    "common_phrases": [
                        "jot down"
                    ]
                },
                {
                    "sense_id": "bc07ffec-6989-38aa-bc5a-7eb31fa42e9a",
                    "sense_definition": "To jerk or jolt something; to jog.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden movement seemed to <w>jot</w> the frame out of place."
                        },
                        {
                            "text": "A rough path would <w>jot</w> the cart repeatedly along the road."
                        }
                    ],
                    "synonyms": [
                        "bump"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rare or obsolete usage meaning to jerk or jolt."
                        }
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c8b432c9-2e04-3ded-ba9c-5861306a4221",
                    "sense_definition": "A tiny or smallest amount; a bit or whit (usually used in negative statements).",
