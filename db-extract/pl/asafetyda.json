                "senses": [
                    {
                        "sense_id": "90ce4cdc-d863-34fa-bb39-3a05ea38368a",
                        "entry_id": "8a5c9256-9d9f-3cb2-b7b2-611b58ecd0c4",
                        "glosses": [
                            "indyjska substancja przyprawowa i lecznicza, gumożywica wydzielana z kłączy zapaliczki cuchnącej, Ferula assa-foetida L., zamiennik cebuli i czosnku"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a08d4815-9738-4376-bb69-0e61915e10cb",
                                "sense_id": "90ce4cdc-d863-34fa-bb39-3a05ea38368a",
                                "text": "Podano wołowinę po angielsku z sosem z cebuli, szalotek, asafetydy, czosnku i goździków."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5b2ef5d1-f035-4617-b39c-437d66999350",
                        "source_entry_id": "8a5c9256-9d9f-3cb2-b7b2-611b58ecd0c4",
                        "source_sense_id": "90ce4cdc-d863-34fa-bb39-3a05ea38368a",
                        "target_lang_word": "assafoetida",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "assafoetida",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b9a9bdb1-976d-3f45-b05a-4e9b1f708d71",
                                        "entry_id": "9ed97f44-4429-3e0b-a756-8559026c4525",
                                        "glosses": [
                                            "Alternative spelling of asafoetida."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae7030d7-e99e-401a-8d3c-ce96eab8e3c9",
                                                "sense_id": "b9a9bdb1-976d-3f45-b05a-4e9b1f708d71",
                                                "text": "The smell, too, is often perverted—Parosmia. The author was formerly acquainted with a lady, who scented her snuff with the tincture of assafœtida."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ea8b612c-9807-4e47-b2d8-38ccb98cfa5a",
                        "source_entry_id": "8a5c9256-9d9f-3cb2-b7b2-611b58ecd0c4",
                        "source_sense_id": "90ce4cdc-d863-34fa-bb39-3a05ea38368a",
                        "target_lang_word": "asafoetida",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "asafoetida",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e05588dc-c55a-3a4d-9251-b916f3e85048",
                                        "entry_id": "6aa24c7e-bf32-3ca1-bf6b-16b280bf8b24",
                                        "glosses": [
                                            "A resinous gum from the stem and roots of Ferula species such as Ferula foetida and Ferula assa-foetida, having a strong, unpleasant smell, with culinary and medical uses."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "354ff7f3-60ab-42e2-8791-294decdee3a7",
                                                "sense_id": "e05588dc-c55a-3a4d-9251-b916f3e85048",
                                                "text": "The letter she sent me stank of assafoetida or devil’s dung. I was charmed."
                                            },
                                            {
                                                "example_id": "ec911fc6-f7c9-49ce-94f7-c1931c34a14a",
                                                "sense_id": "e05588dc-c55a-3a4d-9251-b916f3e85048",
                                                "text": "Nigh Whormoot are Duzgun, Laztan-De, and other Townes, where is got the best Assa-Fætida through all the Orient: the tree is like our brier in height, the leaves resemble Fig leaves, the root the Radish: the vertue had need be much, it stincks so odiously."
                                            },
                                            {
                                                "example_id": "d04c5353-d230-4042-a20c-9c5a9c1b6d87",
                                                "sense_id": "e05588dc-c55a-3a4d-9251-b916f3e85048",
                                                "text": "CHEWING-BALLS, a kind of balls made of aſafœtida, liver of antimony, bay-wood, juniper-wood, and pellitory of Spain; which being dried in the ſun, and wrapped in a linen-cloth, are tied to the bit of the bridle for the horſe to chew: they create an appetite; and it is ſaid, that balls of Venice treacle may be uſed in the ſame manner with good ſucceſs."
                                            },
                                            {
                                                "example_id": "64550731-8aff-4284-be78-d2374655307f",
                                                "sense_id": "e05588dc-c55a-3a4d-9251-b916f3e85048",
                                                "text": "The smell, too, is often perverted—Parosmia. The author was formerly acquainted with a lady, who scented her snuff with the tincture of assafœtida."
                                            },
                                            {
                                                "example_id": "4ca318c9-ad4d-4304-bf53-0ccf4f61c04e",
                                                "sense_id": "e05588dc-c55a-3a4d-9251-b916f3e85048",
                                                "text": "half-a-dozen huge bread pills, dipped in a solution of aloes or cinnamon water, flavoured with assafœtida, which in the case of the dyspeptic rich often suffice [...]."
                                            },
                                            {
                                                "example_id": "09d787a2-8227-4d88-9b9c-8b414d83aca8",
                                                "sense_id": "e05588dc-c55a-3a4d-9251-b916f3e85048",
                                                "text": "For black magic, assafœtida, garlic, dragon's blood, sulphur, and such-like vile-smelling concoctions were used."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
