                "senses": [
                    {
                        "sense_id": "c461a322-f107-398c-b3de-718c3f05bd30",
                        "entry_id": "84f83fff-1dd4-3929-8a9a-2d1aee03f00d",
                        "glosses": [
                            "Faire perdre son caractère apocalyptique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb9167bd-b429-42d5-a6c3-6f6f15369ed2",
                                "sense_id": "c461a322-f107-398c-b3de-718c3f05bd30",
                                "text": "Désapocalyptiser, c’est comprendre qu’après tout, ce n’était pas la fin du monde, juste le début d’un autre monde, peut-être vivable, ou meilleur."
                            },
                            {
                                "example_id": "27822beb-1842-47ed-9f04-6af5ac8fe0e6",
                                "sense_id": "c461a322-f107-398c-b3de-718c3f05bd30",
                                "text": "Il réagit ainsi contre une tendance à « désapocalyptiser » l’eschatologie de l’Apôtre et à considérer le règne présent du Christ et son Église d’une manière qui les détache trop du triomphe à venir de Dieu sur toute la création."
                            }
                        ]
                    }
                ],
