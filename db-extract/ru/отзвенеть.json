                "senses": [
                    {
                        "sense_id": "e838bf8f-dc6e-3686-a341-358e7a9dddb7",
                        "entry_id": "db88297b-bfc6-3bab-8044-4b4714ec2f69",
                        "glosses": [
                            "прекратить звенеть"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fef895a0-cf4e-47df-8507-c762750d5c55",
                                "sense_id": "e838bf8f-dc6e-3686-a341-358e7a9dddb7",
                                "text": "После большой перемены, когда уже отзвенел звонок на уроки, он возвращался из уборной в класс."
                            }
                        ]
                    },
                    {
                        "sense_id": "5639eaaa-6d61-3c57-bd24-ec3ab44a8183",
                        "entry_id": "db88297b-bfc6-3bab-8044-4b4714ec2f69",
                        "glosses": [
                            "прозвенеть в течение некоторого времени"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3bd44f1-92cb-47e9-a9df-bffb32a080d0",
                                "sense_id": "5639eaaa-6d61-3c57-bd24-ec3ab44a8183",
                                "text": "Отзвенел звонок на перемену, потом на второй урок, ― никто с места не двинулся."
                            }
                        ]
                    }
