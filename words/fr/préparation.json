            "senses": [
                {
                    "sense_id": "3a01b135-3668-30aa-afa0-fe79c6d53827",
                    "sense_definition": "Action de préparer ou de se préparer à une activité, un événement ou un projet.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "action_preparer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La <w>préparation</w> de ce grand voyage a pris plusieurs semaines à toute la famille."
                        },
                        {
                            "text": "Il a réussi son examen grâce à une bonne <w>préparation</w> tout au long de l'année."
                        }
                    ],
                    "synonyms": [
                        "organisation",
                        "élaboration"
                    ],
                    "antonyms": [
                        "improvisation"
                    ],
                    "common_phrases": [
