                            }
                        },
                        {
                            "text": "He spotted a <w>nope</w> resting on the branch of the oak tree.",
                            "target_lang_translations": {
                                "ru": "Он заметил <w>снегиря</w>, сидящего на ветке дуба.",
                                "zh": "他发现一只<w>灰雀</w>停在橡树枝上。"
                            }
                        }
