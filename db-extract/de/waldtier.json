                "senses": [
                    {
                        "sense_id": "3fb90e11-bc7e-306b-b29d-eaacecba6ba2",
                        "entry_id": "543aaee3-8af2-30af-a56d-5ed6e9b78b1f",
                        "glosses": [
                            "Tier, das vornehmlich oder ausschließlich im Wald lebt/vorkommt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f63d6b5-d8e7-42fd-8820-5b18485f7bbb",
                                "sense_id": "3fb90e11-bc7e-306b-b29d-eaacecba6ba2",
                                "text": "„Das Reh, so lehren uns Kreuzworträtsel, ist ein scheues Waldtier.“"
                            },
                            {
                                "example_id": "7dd63169-7ebd-4db2-8863-3e08be275999",
                                "sense_id": "3fb90e11-bc7e-306b-b29d-eaacecba6ba2",
                                "text": "„Sie fand sich im Dickicht des Waldes zurecht, sie befehligte alle Waldtiere.“"
                            },
                            {
                                "example_id": "ed518e9b-f902-4bb6-80d0-eb463e266a52",
                                "sense_id": "3fb90e11-bc7e-306b-b29d-eaacecba6ba2",
                                "text": "„Als er älter wurde, fing er gelegentlich Waldtiere – Eichhörnchen und Opossums, manchmal auch Vögel – und steckte sie in Käfige oder band sie im Hof an einen Pfosten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
