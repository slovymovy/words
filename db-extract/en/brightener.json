                                "example_id": "1e7b643f-a1fe-4612-9efe-7ade894b16a0",
                                "sense_id": "4f89ae71-7610-323e-bc8e-a66bf3f85628",
                                "text": "Chirol's own advice was simple: get the Russian agreement signed. March, month of change, brightener of days and moods, brought that action notably closer."
                            }
                        ]
                    },
