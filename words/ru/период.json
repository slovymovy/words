                            }
                        },
                        {
                            "text": "Наименьший положительный <w>период</w> этой функции равен двум пи.",
                            "target_lang_translations": {
                                "en": "The smallest positive <w>period</w> of this function equals two pi.",
                                "zh": "该函数的最小正<w>周期</w>为二派。"
                            }
                        }
