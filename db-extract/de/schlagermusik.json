                "senses": [
                    {
                        "sense_id": "314a86a3-01b5-37e8-b88d-06ba204a471a",
                        "entry_id": "dc93ca1f-1c81-38dc-8431-9a0abb27402f",
                        "glosses": [
                            "erfolgreiche, viel gehörte, leichte Unterhaltungsmusik"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "570c5f7a-0241-416e-b7f9-25006baffd0d",
                                "sense_id": "314a86a3-01b5-37e8-b88d-06ba204a471a",
                                "text": "„Während der Augustiner-Pater geduldig vor der Kerze in seinem Bulli hockt, ziehen aus dem benachbarten Festzelt Schlagermusik und der Geruch von Obstplunder herüber.“"
                            },
                            {
                                "example_id": "58e233a8-025b-441e-a1ec-faa6ce0666f7",
                                "sense_id": "314a86a3-01b5-37e8-b88d-06ba204a471a",
                                "text": "„Das alte Zielka war nicht wiederzuerkennen: blitzend prustende Kaffeemaschinen, Schlagermusik aus dem Lautsprecher, surrende Ventilatoren und weich gepolsterte Sitze.“"
                            },
                            {
                                "example_id": "77e80cfc-b39a-440c-b1c9-30bd0312b4e4",
                                "sense_id": "314a86a3-01b5-37e8-b88d-06ba204a471a",
                                "text": "„Es erklang Musik, türkische Schlagermusik.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
