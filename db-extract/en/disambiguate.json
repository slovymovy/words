                "senses": [
                    {
                        "sense_id": "0422b901-876d-3bcb-a1ac-e9a148737bb9",
                        "entry_id": "59c970b5-4edd-3fc8-b0d6-37825db7e76e",
                        "glosses": [
                            "To remove ambiguities from; to make less ambiguous; to clarify or specify which of multiple possibilities applies – e.g., possible meanings of an ambiguous statement – or to invite or require this."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "56ca0b8c-5c23-30fc-bed0-869d2d31c1cb",
                        "entry_id": "59c970b5-4edd-3fc8-b0d6-37825db7e76e",
                        "glosses": [
                            "To distinguish one word or lexical unit (from a different one which has a similar form)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "980f31c5-d282-4eb3-8ada-4b782b51ec9b",
                                "sense_id": "56ca0b8c-5c23-30fc-bed0-869d2d31c1cb",
                                "text": "When necessary, the Greek spelling is disambiguated by an appended phonetic transcription."
                            },
                            {
                                "example_id": "9657cc43-5253-4db9-bf33-c5ffe636395b",
                                "sense_id": "56ca0b8c-5c23-30fc-bed0-869d2d31c1cb",
                                "text": "The dictionary's traditional “readers” have largely survived this transition, too. They find earlier and better uses of terms which computers can't (in the jargon) disambiguate—distinguish from other similar uses."
                            }
                        ]
                    }
                ],
