                        "form_id": "005c0360-6f12-42cd-b0c2-5723e551d3a4",
                        "entry_id": "befb396e-1f30-3027-9d26-459c8841c7a9",
                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "заку́тавшись"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "feb0a8dd-e09a-3512-9f1f-f827c357d47c",
                        "entry_id": "befb396e-1f30-3027-9d26-459c8841c7a9",
                        "glosses": [
                            "завернуться во что-либо, хорошо укрываться чем-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1862e6e-3f84-4a3c-82cb-56bb82a4697a",
                                "sense_id": "feb0a8dd-e09a-3512-9f1f-f827c357d47c",
                                "text": "Джинн снова закутался в своё облако и помчался через пустыню."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9b0f1ce4-67ea-4a6b-8367-72fa92c44999",
                        "source_entry_id": "befb396e-1f30-3027-9d26-459c8841c7a9",
                        "source_sense_id": "feb0a8dd-e09a-3512-9f1f-f827c357d47c",
                        "target_lang_word": "einigeln",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "einigeln",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "69b1b4bd-df02-31f0-9893-c8fc7c9c8822",
                                        "entry_id": "e5b92859-9ecd-355c-abd4-ecc342af25e1",
                                        "glosses": [
                                            "sich nach Art eines Igels einrollen, zusammenrollen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e50b705b-53fe-4b1d-ad5d-3b4c9e2036df",
                                                "sense_id": "69b1b4bd-df02-31f0-9893-c8fc7c9c8822",
                                                "text": "Sina igelt sich zur Winterszeit gern den ganzen Tag mit einer Wolldecke in ihrem Ohrensessel ein und verschlingt ein Buch nach dem anderen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d80663c8-f984-33a0-a5e6-c496d8ed0e4d",
                                        "entry_id": "e5b92859-9ecd-355c-abd4-ecc342af25e1",
                                        "glosses": [
                                            "sich von anderen zurückziehen, sich völlig abschotten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33ec10fa-945d-4934-8175-a4b0f10f1f7b",
                                                "sense_id": "d80663c8-f984-33a0-a5e6-c496d8ed0e4d",
                                                "text": "Mein Neffe hat sich während der Anfertigung seiner Doktorarbeit drei Monate lang in seinem Arbeitszimmer eingeigelt und auf eine zündende Idee gewartet."
                                            },
                                            {
                                                "example_id": "56a22159-b859-4ea1-ac95-9c984ed07156",
                                                "sense_id": "d80663c8-f984-33a0-a5e6-c496d8ed0e4d",
                                                "text": "„Er igelte sich in der prächtigen Wiener Hofburg ein und präsentierte sich dem Volk erst kurz vor dem Urnengang – allerdings nur in homöopathischen Dosen.“"
                                            },
                                            {
                                                "example_id": "d39d3b99-a777-4d5c-9bc4-7423f9acc185",
                                                "sense_id": "d80663c8-f984-33a0-a5e6-c496d8ed0e4d",
                                                "text": "„Experten warnen allerdings vor weiteren Provokationen des Nordens, denn das Regime igelte sich umgehend ein.“"
                                            },
                                            {
                                                "example_id": "3b7e4f96-3b3f-4f68-ad67-90d87f7fdeed",
                                                "sense_id": "d80663c8-f984-33a0-a5e6-c496d8ed0e4d",
                                                "text": "„Bei Gegenwind igle er sich ein und bespreche sich nur noch mit seinen engsten Vertrauten, klagen die Kritiker.“"
                                            },
                                            {
                                                "example_id": "50d61e1d-19dd-45b6-be7a-5653b6793be6",
                                                "sense_id": "d80663c8-f984-33a0-a5e6-c496d8ed0e4d",
                                                "text": "„Wir sind froh, dass ihr da seid, macht mit, igelt euch nicht ein, wir setzen auf euch.“"
                                            },
                                            {
                                                "example_id": "8aa40ed4-cc7f-45cf-a702-2558937a3856",
                                                "sense_id": "d80663c8-f984-33a0-a5e6-c496d8ed0e4d",
                                                "text": "„Während man sich im Rathaus bereits Gedanken um die imagefördernde Vermarktung des Raubtiernachwuchses machte, igelten sich die Zooverantwortlichen ein“."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "96d3ddad-0865-3585-8f63-39360def8fa6",
                                        "entry_id": "e5b92859-9ecd-355c-abd4-ecc342af25e1",
                                        "glosses": [
                                            "eine Abwehrstellung einnehmen, durch die eine Verteidigung nach allen Seiten möglich ist"
                                        ],
                                        "tags": [
                                            "auch in Bezug auf Fußballspiele"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc9aefc8-49eb-46ab-a81c-9a3175eda01a",
                                                "sense_id": "96d3ddad-0865-3585-8f63-39360def8fa6",
                                                "text": "„Die folgenden Wochen waren bestimmt von der Entscheidung darüber, ob die in jeder Hinsicht stark abgekämpften Truppen einen Ausbruchsversuch wagen oder sich in Erwartung einer Entsatzoffensive von außen im Kessel einigeln sollten.“"
                                            },
                                            {
                                                "example_id": "78c4301a-df33-4c2d-805c-0f7dd0da2ae0",
                                                "sense_id": "96d3ddad-0865-3585-8f63-39360def8fa6",
                                                "text": "„Doch schließlich konnten die amerikanischen Truppen ihre Verteidigung organisieren und sich in Stützpunkten einigeln.“"
                                            },
                                            {
                                                "example_id": "2c0a4c9c-8c67-4ce2-9479-39a54acd317d",
                                                "sense_id": "96d3ddad-0865-3585-8f63-39360def8fa6",
                                                "text": "„Juventus suchte den schnellen Coup, aber Arsenal schloss die Räume, ohne sich einzuigeln, und die Turiner Angreifer, auch das eine Folge der latenten Müdigkeit, liefen mal um mal ins Abseits und verwarfen die Hände.“"
                                            },
                                            {
                                                "example_id": "39682e7f-dc53-4195-9384-a8ab7f26fdfb",
                                                "sense_id": "96d3ddad-0865-3585-8f63-39360def8fa6",
                                                "text": "„Die Holländer zeigten sich bestens vorbereitet auf den Sturmlauf der gastgebenden Gunners, igelten sich ein, verteidigten konzentriert und schlugen notfalls den Ball aus dem Strafraum, damit ihm ein Kollege hinterherwieseln möge.“"
                                            },
                                            {
                                                "example_id": "593338fc-1bcf-4427-a4c4-b2eeb22cb309",
                                                "sense_id": "96d3ddad-0865-3585-8f63-39360def8fa6",
                                                "text": "„Allein der FC Bayern war gewillt zu spielen, Dortmund igelte sich in der eigenen Hälfte ein, konnte aber gegnerische Möglichkeiten nicht verhindern.“"
                                            },
                                            {
                                                "example_id": "cb699867-e456-4fb9-9b8e-913df7902667",
                                                "sense_id": "96d3ddad-0865-3585-8f63-39360def8fa6",
                                                "text": "„Hamburg igelte sich ein, Schalke vergab seine Chancen.“"
                                            },
                                            {
                                                "example_id": "2516ae5e-7018-4b20-8124-052a47e8a0c1",
                                                "sense_id": "96d3ddad-0865-3585-8f63-39360def8fa6",
                                                "text": "„Die Generalprobe für das Heimspiel am Donnerstag gegen Werder Bremen glückte dennoch. Weil die Austria munter auf das 2:0 spielte, sich nach der Führung nicht einigelte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
