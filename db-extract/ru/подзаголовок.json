                                "target_senses": [
                                    {
                                        "sense_id": "7007a885-7830-30e3-a4cb-05697a9db822",
                                        "entry_id": "3db48e52-e85d-3b8a-8816-c3d74f481515",
                                        "glosses": [
                                            "A heading below or after a title."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "981ae609-d555-39a3-ae2c-4bd70d553e71",
                                        "entry_id": "3db48e52-e85d-3b8a-8816-c3d74f481515",
                                        "glosses": [
                                            "Textual versions of the dialogue in films (and similar media such as television or video games), usually displayed at the bottom of the screen."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9faf790-8328-41a0-b7af-08ba25e3f885",
                                                "sense_id": "981ae609-d555-39a3-ae2c-4bd70d553e71",
                                                "text": "Careful viewers have long observed that in the movies, one can not only watch but read cigarettes like subtitles — translating the action on the screen into another language which the camera registers but rarely foregrounds, a part of the thickness of the medium which is almost never brought into focus. […] The cigarette in the scene serves as a subtext, a mute caption or subtitle, sometimes accompanying, sometimes contradicting or diverting the explicit premise of the action or the open meaning of signs."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "subtitle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f39bbb69-da99-3fe3-826c-e1bc397836fd",
                                        "entry_id": "09568505-de73-3b0f-a76e-344cd3d88971",
                                        "glosses": [
                                            "To create subtitles for the dialogue in a film."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1e912dc5-31c5-4bfd-b423-c1019b5646ce",
                        "source_entry_id": "df5cb3e8-c131-3691-8256-578a14b2769b",
                        "source_sense_id": "746f47a6-3702-3047-95cb-12ad76b8f70a",
                        "target_lang_word": "subheading",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "subheading",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fd605aba-b36c-3166-908a-fac7d2d4837e",
                                        "entry_id": "75616b36-d297-3d89-a674-2f5d07520965",
                                        "glosses": [
                                            "Any of the headings under which each of the main divisions of a subject may be subdivided."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2906e3f3-f724-4c35-aaff-6ac03be6067b",
                                                "sense_id": "fd605aba-b36c-3166-908a-fac7d2d4837e",
                                                "text": "And puritans give much the same warning in a manner suggesting that though the eating of rich foods is not among the seven deadly sins, it is at least a bona fide subheading under the general category of gluttony."
                                            },
                                            {
                                                "example_id": "d1ca1879-a301-414e-b6ca-46bc289e5213",
                                                "sense_id": "fd605aba-b36c-3166-908a-fac7d2d4837e",
                                                "text": "Most subheadings don’t do much to enhance a document. The whistle-blower’s subheadings do what the best subheadings do: They structure the complaint and provide a clear outline of what the document contains: […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23635b87-dcce-3b91-98b0-77efccd1af87",
                                        "entry_id": "75616b36-d297-3d89-a674-2f5d07520965",
                                        "glosses": [
                                            "A heading or caption subordinate to a main headline, heading, or title especially when inserted as a divider between sections (as of a newspaper or periodical article or story or text of a book)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
