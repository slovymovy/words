                "senses": [
                    {
                        "sense_id": "5d006dc4-569b-36d6-8a3a-f2b22df46519",
                        "entry_id": "8313c9a5-5b25-3c66-81cd-bea7512c7e87",
                        "glosses": [
                            "helemaal verlaten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "801b8d96-c676-44c3-a3e2-4b97c42fd357",
                                "sense_id": "5d006dc4-569b-36d6-8a3a-f2b22df46519",
                                "text": "Maar er verscheen niemand, het was doodstil. De straten waren uitgestorven. Behalve een stokoude en dove Lilakuit die mompelend in zichzelf door het Olielaantje liep kwamen ze niemand tegen."
                            },
                            {
                                "example_id": "f1623ad1-a564-4321-bc97-11d46524b823",
                                "sense_id": "5d006dc4-569b-36d6-8a3a-f2b22df46519",
                                "text": "Het was even wennen om helemaal alleen door de uitgestorven woestijn te lopen, maar toch raakte ik geleidelijk in een ritme."
                            },
                            {
                                "example_id": "9bc44f9b-9003-456b-a319-36ee3afd8288",
                                "sense_id": "5d006dc4-569b-36d6-8a3a-f2b22df46519",
                                "text": "Onderzoeken van eerder dit jaar beweerden dat de uitgestorven mensachtige Homo naledi zijn doden begroef en rotskunst maakte. Andere onderzoekers zeggen nu dat daar geen bewijs voor is."
                            }
                        ]
                    }
                ],
