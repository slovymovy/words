                                    {
                                        "sense_id": "e7f5d7d3-ecb4-37e6-9499-6956a1fe07ad",
                                        "entry_id": "94f8c8b9-0620-3712-9786-6fd23eae23cc",
                                        "glosses": [
                                            "Pferd mit einer Widerristhöhe unter 148 cm"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f96dcac2-4fd0-4a83-b026-5b4e07b71c65",
                                                "sense_id": "e7f5d7d3-ecb4-37e6-9499-6956a1fe07ad",
                                                "text": "Auf dem Reiterhof gibt es auch Ponys."
                                            },
                                            {
                                                "example_id": "f3abd1c5-2266-4d27-aea4-545ed7264354",
                                                "sense_id": "e7f5d7d3-ecb4-37e6-9499-6956a1fe07ad",
                                                "text": "„Caesar führte Mrs. Daytons Pferd vor, Adele aber lenkte das kleine, muntere Pony an einen liegenden Baumstamm und sprang leicht und sicher in den Sattel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Pony",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a665f688-80be-3e37-ab48-453a5ac9abac",
                                        "entry_id": "b1e529d0-c332-3ecb-8415-4394147fda3d",
                                        "glosses": [
                                            "längere vordere Kopfhaare über der Stirn des Kopfes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b94c92c1-172f-4749-8f31-5f1445209ea8",
                                                "sense_id": "a665f688-80be-3e37-ab48-453a5ac9abac",
                                                "text": "Den Pony hätte man ruhig kürzer schneiden können."
                                            },
                                            {
                                                "example_id": "72b6b51b-6d78-4b31-b922-ece6a7488c0a",
                                                "sense_id": "a665f688-80be-3e37-ab48-453a5ac9abac",
                                                "text": "„Efe rückt sich die Perücke zurecht, zieht sie so weit in die Stirn, dass der Pony fast ihre Augenbrauen bedeckt.“"
                                            },
                                            {
                                                "example_id": "b2bd3de5-de8c-41ab-b8e5-a4802e222e36",
                                                "sense_id": "a665f688-80be-3e37-ab48-453a5ac9abac",
                                                "text": "„Ola lächelte mich an, fragte, ob alles in Ordnung sei, ich nickte und zupfte ein bisschen an meinem Pony herum.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
