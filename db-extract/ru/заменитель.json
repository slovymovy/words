                "senses": [
                    {
                        "sense_id": "5e6b2c63-32a2-31c4-86cd-44012e49f50f",
                        "entry_id": "85eb19c5-45ee-3b68-a4a5-e466c4038a18",
                        "glosses": [
                            "материал или продукт, используемый вместо другого, обычно более дорогого и качественного"
                        ],
                        "tags": [],
