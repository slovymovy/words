                    }
                ],
                "senses": [
                    {
                        "sense_id": "cb57ed86-39ce-36b4-b09e-5f4379ba1fb0",
                        "entry_id": "6959c5b4-b356-3e48-b0c7-5601b841b5f1",
                        "glosses": [
                            "plotselinge aandoening van de hersenen ten gevolge van te felle zonneschijn of te grote hitte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85912c9f-7198-4daa-ac4d-17fc376f5387",
                                "sense_id": "cb57ed86-39ce-36b4-b09e-5f4379ba1fb0",
                                "text": "Een zonnesteek oplopen."
                            },
                            {
                                "example_id": "af859968-34a5-4691-936b-6ff843e5cc89",
                                "sense_id": "cb57ed86-39ce-36b4-b09e-5f4379ba1fb0",
                                "text": "Twee jaar eerder was er op dit stuk trail nog een 19-jarige jongen overleden aan de gevolgen van een zonnesteek."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0215fc37-ec31-4491-aadf-34a9158590ee",
                        "source_entry_id": "6959c5b4-b356-3e48-b0c7-5601b841b5f1",
                        "source_sense_id": "cb57ed86-39ce-36b4-b09e-5f4379ba1fb0",
                        "source_sense_description": "plotselinge aandoening van de hersenen ten gevolge van te felle zonneschijn of te grote hitte",
                        "target_lang_word": "Sonnenstich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sonnenstich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5795bb24-d6f6-31da-a999-46daa16062b8",
                                        "entry_id": "fa57a8ef-0128-3499-8152-8a081bbf73b7",
                                        "glosses": [
                                            "eine sehr ernsthafte Gesundheitsstörung, die durch lang andauernde direkte Sonneneinstrahlung auf den Kopf und Nackenbereich entsteht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bfe017ca-714b-4a0a-b810-5d72d5a2a668",
                                                "sense_id": "5795bb24-d6f6-31da-a999-46daa16062b8",
                                                "text": "\"Der Sonnenstich äußert sich durch Schwindel, Übelkeit, die zum Erbrechen führen kann, und Nackenschmerzen bis hin zu Nackensteifigkeit (Meningismus).\""
                                            },
                                            {
                                                "example_id": "4e5ab88d-dd97-4380-8e9c-50736a827675",
                                                "sense_id": "5795bb24-d6f6-31da-a999-46daa16062b8",
                                                "text": "„Mittags mußte man im Schatten liegen, wenn man sich keinen Sonnenbrand holen wollte oder einen Hitzschlag oder einen Sonnenstich.“"
                                            },
                                            {
                                                "example_id": "0ae46d57-1338-41ad-993b-dc350035c294",
                                                "sense_id": "5795bb24-d6f6-31da-a999-46daa16062b8",
                                                "text": "„Das Argument mit dem Sonnenstich und anschließender Krankschreibung über mehrere Wochen hinweg brauchten sie gar nicht mehr anzubringen.“"
                                            },
                                            {
                                                "example_id": "519cace3-a76f-4b15-860f-441b42a92206",
                                                "sense_id": "5795bb24-d6f6-31da-a999-46daa16062b8",
                                                "text": "„Geografen hielten ihn für verrückt, vom Sonnenstich verwirrt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c87dc482-ddaf-4c8a-9bf6-c5f5dc20353e",
                        "source_entry_id": "6959c5b4-b356-3e48-b0c7-5601b841b5f1",
                        "source_sense_id": "cb57ed86-39ce-36b4-b09e-5f4379ba1fb0",
                        "source_sense_description": "plotselinge aandoening van de hersenen ten gevolge van te felle zonneschijn of te grote hitte",
                        "target_lang_word": "sunstroke",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sunstroke",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9007ba8b-399e-385d-b83c-4622c23edcb3",
                                        "entry_id": "06231a5f-7ac9-3963-b497-9c54cb6721aa",
                                        "glosses": [
                                            "Heat stroke caused by an excessive exposure to the sun's rays."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7603650e-8aa1-4ec4-a1f7-139dbc8ae568",
                                                "sense_id": "9007ba8b-399e-385d-b83c-4622c23edcb3",
                                                "text": "But, however this may be, the grounds upon which I base my belief that \"chill\" in the one case, and \"heat\" in the other, is the most common exciting cause of these maladies, respectively, are furnished by the fact that malarious fevers are found to prevail with a periodicity corresponding with that of the annual seasons of greatest change in the weather elements, namely, the spring and autumn, and moreover, with a periodicity corresponding, at least in the Punjab, for which province the statistics have been tabulated, with the triennial cycles of rainfall -- a peculiarity in which they coincide with cholera -- whilst sun-fever or sunstroke is found to prevail with a periodicity corresponding with the season of highest temperature."
                                            },
                                            {
                                                "example_id": "0a1bccf9-36b2-44a5-8f92-ab8233b6b537",
                                                "sense_id": "9007ba8b-399e-385d-b83c-4622c23edcb3",
                                                "text": "Idiopathic non-septic periencephalitis may be produced by profound grief, protracted anxiety, especially when accompanied by great overwork, partial starvation combined with the gnawing anxiety of deep poverty, and also, it is affirmed, by sunstroke."
                                            },
                                            {
                                                "example_id": "b349afa7-9315-4668-900d-348585b572d4",
                                                "sense_id": "9007ba8b-399e-385d-b83c-4622c23edcb3",
                                                "text": "Later came midsummer, with the stifling heat, when the dingy killing beds of Durham’s became a very purgatory; one time, in a single day, three men fell dead from sunstroke."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "64a03426-e709-4efb-b0e1-85f1e40406f1",
                        "source_entry_id": "6959c5b4-b356-3e48-b0c7-5601b841b5f1",
