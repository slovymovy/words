                ],
                "senses": [
                    {
                        "sense_id": "1e75cb11-e0e1-3aad-84e1-64d4a1cdd336",
                        "entry_id": "2a039f4c-7d23-35f1-aed1-eb2d2c78c1ea",
                        "glosses": [
                            "многосторонний (как правило, международный) договор; соглашение (обычно между государствами) по какому-либо специальному вопросу"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c47f392e-3b27-4121-b1cc-652532238374",
                                "sense_id": "1e75cb11-e0e1-3aad-84e1-64d4a1cdd336",
                                "text": "Многосторонние конвенции, как правило, разрабатываются и принимаются в рамках международных организаций, таких как ООН и Совет Европы."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3ffcb083-2c2d-4e55-a867-7392a99f1e01",
                        "source_entry_id": "2a039f4c-7d23-35f1-aed1-eb2d2c78c1ea",
                        "source_sense_id": "1e75cb11-e0e1-3aad-84e1-64d4a1cdd336",
                        "target_lang_word": "convention",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "convention",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "82afcdb9-1e23-31ad-a411-798d28c3d652",
                                        "entry_id": "f1e6f476-1939-3e95-8f05-24bdec07646a",
                                        "glosses": [
                                            "A meeting or gathering."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d244f79a-f081-47f2-8013-7b7be8e9085a",
                                                "sense_id": "82afcdb9-1e23-31ad-a411-798d28c3d652",
                                                "text": "The convention was held in Geneva."
                                            },
                                            {
                                                "example_id": "6c34f806-827a-416c-a28e-66d8f8ecb405",
                                                "sense_id": "82afcdb9-1e23-31ad-a411-798d28c3d652",
                                                "text": "The CEF and the legal advocacy groups that have been responsible for its tremendous success over the past ten years are determined to \"Knock down all doors, all the barriers, to all 65,000 public elementary schools in America and take the Gospel to this open mission field now! Not later, now!\" in the words of a keynote speaker at the CEF's national convention in 2010."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2969ed54-185b-3167-9080-431696635162",
                                        "entry_id": "f1e6f476-1939-3e95-8f05-24bdec07646a",
                                        "glosses": [
                                            "A formal deliberative assembly of mandated delegates."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9dbdee1e-6526-4b32-bd84-67ad79f26a1c",
                                                "sense_id": "2969ed54-185b-3167-9080-431696635162",
                                                "text": "The EU installed an inter-institutional Convention to draft a European constitution."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "683787d3-702c-39b1-8f65-9cbae5d8818c",
                                        "entry_id": "f1e6f476-1939-3e95-8f05-24bdec07646a",
                                        "glosses": [
                                            "The convening of a formal meeting."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5f71d6cc-cabd-37fe-823d-288e81c3fcc9",
                                        "entry_id": "f1e6f476-1939-3e95-8f05-24bdec07646a",
                                        "glosses": [
                                            "A formal agreement, contract, rule, or pact."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fe5fda17-5dfe-3977-9712-8a179c01d019",
                                        "entry_id": "f1e6f476-1939-3e95-8f05-24bdec07646a",
                                        "glosses": [
                                            "A treaty or supplement to such."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ada51223-45a5-4b65-b2a4-38c46e30b029",
                                                "sense_id": "fe5fda17-5dfe-3977-9712-8a179c01d019",
                                                "text": "The Vienna convention at the Vienna Congress (1814-15) standardized most of diplomatic conduct for generations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "496b17ef-8560-34b6-a0f7-f059180afb89",
                                        "entry_id": "f1e6f476-1939-3e95-8f05-24bdec07646a",
                                        "glosses": [
                                            "A practice or procedure widely observed in a group, especially to facilitate social interaction; a custom."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1415d901-c56f-4058-bb8b-dffdc99b91d4",
                                                "sense_id": "496b17ef-8560-34b6-a0f7-f059180afb89",
                                                "text": "Table seatings are generally determined by tacit convention, not binding formal protocol."
                                            },
                                            {
                                                "example_id": "e835b568-7b6f-4a12-8a9e-de5949f9bb77",
                                                "sense_id": "496b17ef-8560-34b6-a0f7-f059180afb89",
                                                "text": "The convention of driving on the right is reinforced by law."
                                            },
                                            {
                                                "example_id": "fe3f56b1-60c8-4719-9465-f1615e3f2bf1",
                                                "sense_id": "496b17ef-8560-34b6-a0f7-f059180afb89",
                                                "text": "In order to account for this, we might propose to make the Prepositional Phrase an optional constituent of the Verb Phrase: this we could do by re-\n placing rule (28) (ii) by rule (40) below:\n(40) VP → V AP (PP)\n(Note that a constituent in parentheses is, by convention, taken to be\n optional.)"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
