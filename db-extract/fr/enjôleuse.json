                        "examples": [
                            {
                                "example_id": "ec4c7c16-5835-44ee-95af-c47a1042c0d5",
                                "sense_id": "f2007b6e-e746-30ba-b4ac-4aef0ccec611",
                                "text": "Ne commencez pas, vous non plus, à pleurnicher, je ne connais que trop bien cette larme enjôleuse qui vous vient perloter au coin des yeux."
                            },
                            {
                                "example_id": "f51b8ed7-af7b-443c-953f-cda52fcfda0b",
                                "sense_id": "f2007b6e-e746-30ba-b4ac-4aef0ccec611",
                                "text": "— Chez tes amis ?\n— Chez nos amis, répliqua Marylène, enjôleuse (elle se dit qu’elle venait d’être enjôleuse)."
                            }
                        ]
                    }
