                "senses": [
                    {
                        "sense_id": "a8782610-e38c-3e2d-9746-c9a0c5201f41",
                        "entry_id": "bbdf87ab-b8cd-3592-99fb-5f8826380daa",
                        "glosses": [
                            "eine Handlung oder Tätigkeit, die zufällig oder grundlos beziehungsweise ohne Zielsetzung (willkürlich) vollzogen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f866253e-0261-453a-91ea-e7def9f558a7",
                                "sense_id": "a8782610-e38c-3e2d-9746-c9a0c5201f41",
                                "text": "Er deutete dessen Vorgehen als klare Willkürmaßnahme."
                            },
                            {
                                "example_id": "cd38308a-3552-432e-92b8-8ea68f3acb44",
                                "sense_id": "a8782610-e38c-3e2d-9746-c9a0c5201f41",
                                "text": "Ob es eine Willkürmaßnahme war, muss der Richter entscheiden."
                            },
                            {
                                "example_id": "ba19dcf3-9ac7-43a6-95ed-7924e7225478",
                                "sense_id": "a8782610-e38c-3e2d-9746-c9a0c5201f41",
                                "text": "„Wer in einer Weise, die geeignet ist, den öffentlichen Frieden zu stören, … zu Gewalt- oder Willkürmaßnahmen auffordert …, wird mit Freiheitsstrafe von drei Monaten bis zu fünf Jahren bestraft.“"
                            }
                        ],
