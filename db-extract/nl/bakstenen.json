                                                "sense_id": "2999fb5e-7805-3dc0-b909-88b81f4baecc",
                                                "text": "The two of clubs was a complete brick on the river."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52f57889-6f69-3b1c-a88d-e70a266b33c1",
                                        "entry_id": "c94adb48-94c5-35fe-9797-17adfc2543d8",
