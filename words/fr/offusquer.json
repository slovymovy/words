    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "44dc9755-c52f-3ef7-ae48-b80592a3cc29",
                    "sense_definition": "Blesser quelqu'un dans sa fierté, ses principes ou sa sensibilité en lui déplaisant.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "affect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ses propos irrespectueux risquent d'<w>offusquer</w> les membres les plus âgés de notre assemblée."
                        },
                        {
                            "text": "Cette remarque déplacée a fini par <w>offusquer</w> toute la famille réunie pour le dîner."
                        }
                    ],
                    "common_phrases": [
                        "offusquer la pudeur",
                        "offusquer les convenances"
                    ]
                },
                {
                    "sense_id": "3c203a39-11c8-39a0-8c8a-9527f57ca9af",
                    "sense_definition": "Se formaliser, éprouver du dépit ou se sentir blessé face à un acte ou une parole.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "affect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a tendance à s'<w>offusquer</w> pour un rien dès que quelqu'un exprime un avis différent."
                        },
                        {
                            "text": "Les voisins ont semblé s'<w>offusquer</w> du bruit provoqué par les travaux tardifs."
                        }
                    ],
                    "common_phrases": [
                        "s'offusquer pour un rien"
                    ]
                },
                {
                    "sense_id": "2c4d1b66-9929-3cce-ba84-c6bc9b24ef1d",
                    "sense_definition": "Empêcher d'être vu en faisant obstacle à la vue.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "vision",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Un épais rideau d'arbres vient <w>offusquer</w> la vue magnifique sur la vallée depuis le balcon."
                        },
                        {
                            "text": "Ces nouvelles constructions risquent d'<w>offusquer</w> la façade historique de la vieille ville."
                        }
                    ],
                    "synonyms": [
                        "cacher"
                    ],
                    "common_phrases": [
                        "offusquer la vue"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "usage littéraire et vieilli"
                        }
                    ]
                },
                {
                    "sense_id": "7811fb3d-f301-3578-9ab6-dee113b17724",
                    "sense_definition": "Empêcher de voir distinctement ou troubler les facultés de perception ou de raisonnement.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "vision",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La fumée dense de l'incendie <w>offusquait</w> le regard des pompiers au cœur du sinistre."
                        },
                        {
                            "text": "Une vive colère semblait <w>offusquer</w> la raison du jeune homme au point d'altérer son jugement."
                        }
                    ],
                    "synonyms": [
                        "troubler"
                    ],
                    "common_phrases": [
                        "offusquer la raison"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "usage littéraire et vieilli"
                        }
                    ]
                }
            ]
        }
    ]
