                        "entry_id": "2495afab-7976-3b6a-8bb4-8a0d0936c708",
                        "glosses": [
                            "wat in te ruime mate aanwezig is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47f100ea-2112-4ade-ab45-8ca2732480fa",
                                "sense_id": "3fcbb120-aa90-30c5-be91-2f2aaf8bcb06",
                                "text": "De overtollig goederen zullen worden gedumpt."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6bc30aed-f81c-4cb3-acdd-0ea6d43153b3",
                        "source_entry_id": "2495afab-7976-3b6a-8bb4-8a0d0936c708",
                        "source_sense_id": "3fcbb120-aa90-30c5-be91-2f2aaf8bcb06",
                        "source_sense_description": "wat in te ruime mate aanwezig is",
                        "target_lang_word": "überflüssig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "überflüssig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a81f8bfa-1eac-3e36-a3a1-000f374b7abc",
                                        "entry_id": "57421a3c-218a-37b2-acd4-98c02042cbf2",
                                        "glosses": [
                                            "nicht nötig, über das notwendige Maß hinaus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7b2753c-c6f5-4112-b84c-ba6459d8f16e",
                                                "sense_id": "a81f8bfa-1eac-3e36-a3a1-000f374b7abc",
                                                "text": "Deine Kommentare finde ich überflüssig."
                                            },
                                            {
                                                "example_id": "802364c2-b57b-485b-842c-e827f2dc6c2f",
                                                "sense_id": "a81f8bfa-1eac-3e36-a3a1-000f374b7abc",
                                                "text": "„Bei Prolaktinomen zeigt eine medikamentöse Therapie oft Erfolg und eine Operation ist überflüssig.“"
                                            },
                                            {
                                                "example_id": "b564eb12-24c7-451a-b54b-b01546f4bb26",
                                                "sense_id": "a81f8bfa-1eac-3e36-a3a1-000f374b7abc",
                                                "text": "„Ausgangspunkt ist dabei die Frage, ob der Erste Weltkrieg im Grunde überflüssig war.“"
                                            },
                                            {
                                                "example_id": "edd61bf1-1cd4-4421-b06e-bda3420c232e",
                                                "sense_id": "a81f8bfa-1eac-3e36-a3a1-000f374b7abc",
                                                "text": "„Die riesige Wärmepumpe soll einen wesentlichen Teil dazu beitragen, das alte Kohlekraftwerk in der Stadt überflüssig zu machen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b15e5a15-c492-4727-91ba-d13374964b5d",
                        "source_entry_id": "2495afab-7976-3b6a-8bb4-8a0d0936c708",
                        "source_sense_id": "3fcbb120-aa90-30c5-be91-2f2aaf8bcb06",
                        "source_sense_description": "wat in te ruime mate aanwezig is",
                        "target_lang_word": "redundant",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "redundant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6e666250-63d9-38e1-a977-d52d5ccafe8d",
                                        "entry_id": "afa00582-84c7-3502-ba36-4465b86ed0e5",
                                        "glosses": [
                                            "Superfluous; exceeding what is necessary, no longer needed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b269985e-d035-4e8a-bd33-548c0c4e1f4e",
                                                "sense_id": "6e666250-63d9-38e1-a977-d52d5ccafe8d",
                                                "text": "It is allowed, that Senates and great Councils are often troubled with redundant, ebullient, and other peccant Humours, with many Diſeaſes of the Head and more of the Heart; […]"
                                            },
                                            {
                                                "example_id": "b170f0bf-9d7f-4e5f-926e-9539f96aa817",
                                                "sense_id": "6e666250-63d9-38e1-a977-d52d5ccafe8d",
                                                "text": "In the living state, the body is observed to receive aliment; to assimilate a part; to evacuate what is redundant or useless; […]"
                                            },
                                            {
                                                "example_id": "49aebc92-5c47-4716-9d3c-c41b0791d367",
                                                "sense_id": "6e666250-63d9-38e1-a977-d52d5ccafe8d",
                                                "text": "A key driver has been the approval of a new housing and employment development called Fawley Waterside, with 1,500 homes planned on the site of a redundant power station on the edge of Southampton Water."
                                            },
                                            {
                                                "example_id": "56cd5a4f-1c3b-4aaa-8d23-d31ba71534ce",
                                                "sense_id": "6e666250-63d9-38e1-a977-d52d5ccafe8d",
                                                "text": "Two entrants shared this award for their work on two quite different stations, but with the same purpose of bringing a redundant station building back into use for the benefit of the community, with the added result of conserving an historic building."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ca3e228-cb5a-3481-a425-0a29dd911d54",
                                        "entry_id": "afa00582-84c7-3502-ba36-4465b86ed0e5",
                                        "glosses": [
                                            "Repetitive or needlessly wordy."
                                        ],
                                        "tags": [
                                            "of words"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "98b30eed-fc5f-3032-8c7f-db349ec9e3c1",
                                        "entry_id": "afa00582-84c7-3502-ba36-4465b86ed0e5",
                                        "glosses": [
                                            "Dismissed from employment because no longer needed."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "British",
                                            "Ireland",
                                            "New-Zealand"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51be796d-ce58-427f-ab03-88d881331eee",
                                                "sense_id": "98b30eed-fc5f-3032-8c7f-db349ec9e3c1",
                                                "text": "Four employees were made redundant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e945cdda-d2fb-3ddc-a0b6-86de8f828cdf",
                                        "entry_id": "afa00582-84c7-3502-ba36-4465b86ed0e5",
                                        "glosses": [
                                            "Duplicating or able to duplicate the function of another component of a system, providing backup in the event the other component fails."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c827dde0-d222-4fa2-bc6a-d70825a58c86",
                                                "sense_id": "e945cdda-d2fb-3ddc-a0b6-86de8f828cdf",
                                                "text": "The two lines are mainly used for redundant and therefore fault-tolerant message transmission, but they can also transmit different messages."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11f24c9b-583c-346f-965c-d40331d78301",
                                        "entry_id": "afa00582-84c7-3502-ba36-4465b86ed0e5",
                                        "glosses": [
                                            "Containing duplicate pathways to send a message."
                                        ],
                                        "tags": [
                                            "of topology"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0d6561c3-7196-4eab-a5ad-eb8dd748c078",
                        "source_entry_id": "2495afab-7976-3b6a-8bb4-8a0d0936c708",
                        "source_sense_id": "3fcbb120-aa90-30c5-be91-2f2aaf8bcb06",
                        "source_sense_description": "wat in te ruime mate aanwezig is",
                        "target_lang_word": "superfluous",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "superfluous",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4913de38-778a-3e25-a37c-5ee8282c39c4",
                                        "entry_id": "0d4a640d-b010-30a1-9949-2e95d86eff2b",
                                        "glosses": [
                                            "In excess of what is required or sufficient."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77362d98-2f9e-44e6-9adf-eb10b1229484",
                                                "sense_id": "4913de38-778a-3e25-a37c-5ee8282c39c4",
                                                "text": "With a full rain suit, carrying an umbrella may be superfluous."
                                            },
                                            {
                                                "example_id": "35ad54e6-a8c0-48a7-a66b-d7855c96647e",
                                                "sense_id": "4913de38-778a-3e25-a37c-5ee8282c39c4",
                                                "text": "Then I began to play in timid fashion, venturing only twenty or thirty gulden at a time. Meanwhile, I observed and took notes. It seemed to me that calculation was superfluous, and by no means possessed of the importance which certain other players attached to it, even though they sat with ruled papers in their hands, whereon they set down the coups, calculated the chances, reckoned, staked, and—lost exactly as we more simple mortals did who played without any reckoning at all."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
