{
    "word_family": [
        "enlightenment",
        "enlightening",
        "enlightened"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "56df39b1-59d7-3dd4-ab1b-fb66384c0628",
                    "sense_definition": "To give someone greater knowledge, understanding, or insight about a subject.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "instruction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The professor hoped the lecture would <w>enlighten</w> students on the complexities of the issue.",
                            "target_lang_translations": {
                                "es": "El profesor esperaba que la conferencia <w>ilustrara</w> a los estudiantes sobre las complejidades del tema."
                            }
                        },
                        {
                            "text": "If you know why the decision was made, please <w>enlighten</w> me.",
                            "target_lang_translations": {
                                "es": "Si sabes por qué se tomó la decisión, por favor, <w>ilumíname</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "edify",
                        "inform",
                        "clarify",
                        "explain"
                    ],
                    "common_phrases": [
                        "enlighten me"
                    ],
                    "target_lang_definitions": {
                        "es": "Aportar a alguien mayor conocimiento, comprensión o entendimiento sobre un tema."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "ilustrar",
                                "target_lang_sense_clarification": "instruir o dar luz al entendimiento de alguien"
                            },
                            {
                                "target_lang_word": "iluminar",
                                "target_lang_sense_clarification": "hacer comprender o abrir la mente"
                            },
                            {
                                "target_lang_word": "esclarecer",
                                "target_lang_sense_clarification": "aclarar un asunto o despejar dudas"
                            },
                            {
                                "target_lang_word": "informar",
                                "target_lang_sense_clarification": "poner al corriente o enterar a alguien de algo"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "81f6277a-7b27-37c0-83ea-431c46519ba3",
                    "sense_definition": "To shed light upon something; to illuminate.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "illumination",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The morning sun began to <w>enlighten</w> the dark valley below.",
                            "target_lang_translations": {
                                "es": "El sol de la mañana comenzó a <w>iluminar</w> el oscuro valle situado abajo."
                            }
                        },
                        {
                            "text": "A sudden flash of lightning briefly <w>enlightened</w> the entire room.",
                            "target_lang_translations": {
                                "es": "Un repentino relámpago <w>alumbró</w> brevemente toda la habitación."
                            }
                        }
                    ],
                    "synonyms": [
                        "illuminate",
                        "illumine"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used rarely in modern English for physical illumination."
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Proyectar luz sobre algo; alumbrar físicamente."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "iluminar",
                                "target_lang_sense_clarification": "dar luz a un espacio o cosa"
                            },
                            {
                                "target_lang_word": "alumbrar",
                                "target_lang_sense_clarification": "llenar de luz y claridad"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}