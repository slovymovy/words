{
    "word_family": [
        "plea",
        "pleader",
        "pleading",
        "pleadingly"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "054bc841-e71d-31aa-af15-460096aecda3",
                    "sense_definition": "To make a formal statement in a court of law as to whether one is guilty or innocent of a charge.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "legal_proceedings",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The defendant decided to <w>plead</w> not guilty to all charges brought against him.",
                            "target_lang_translations": {
                                "ru": "Подсудимый решил <w>не признавать</w> себя виновным по всем предъявленным ему обвинениям."
                            }
                        },
                        {
                            "text": "After consulting with his lawyer, he chose to <w>plead</w> guilty to the lesser offense.",
                            "target_lang_translations": {
                                "ru": "После консультации с адвокатом он решил <w>признать</w> вину в менее тяжком преступлении."
                            }
                        }
                    ],
                    "common_phrases": [
                        "plead guilty",
                        "plead not guilty",
                        "plead the fifth"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "legal context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделать официальное заявление в суде о признании или непризнании своей вины."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "признавать",
                                "target_lang_sense_clarification": "вину или невиновность в суде"
                            },
                            {
                                "target_lang_word": "заявлять",
                                "target_lang_sense_clarification": "о своей позиции в суде"
                            },
                            {
                                "target_lang_word": "выступать с заявлением",
                                "target_lang_sense_clarification": "о виновности или невиновности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d6664967-7fdd-3830-a925-9761f76e7a95",
                    "sense_definition": "To beg or ask for something in a very serious and emotional way.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "emotional_request",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The child began to <w>plead</w> for mercy when he realized he was in trouble.",
                            "target_lang_translations": {
                                "ru": "Ребенок начал <w>умолять</w> о пощаде, когда понял, что попал в беду."
                            }
                        },
                        {
                            "text": "She had to <w>plead</w> with him to stay because she was afraid to be alone.",
                            "target_lang_translations": {
                                "ru": "Ей пришлось <w>умолять</w> его остаться, потому что она боялась оставаться одна."
                            }
                        }
                    ],
                    "synonyms": [
                        "beg",
                        "entreat",
                        "appeal"
                    ],
                    "common_phrases": [
                        "plead for mercy",
                        "plead with someone"
                    ],
                    "target_lang_definitions": {
                        "ru": "Умолять или просить о чем-то очень серьезно и эмоционально."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "умолять",
                                "target_lang_sense_clarification": "очень сильно просить"
                            },
                            {
                                "target_lang_word": "взывать",
                                "target_lang_sense_clarification": "к кому-либо с просьбой"
                            },
                            {
                                "target_lang_word": "просить",
                                "target_lang_sense_clarification": "настойчиво и эмоционально"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "174a29e1-0937-3deb-9e81-2f9341cd4684",
                    "sense_definition": "To give a specific reason or excuse for why something cannot be done or why one is not responsible.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "excuse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He decided to <w>plead</w> ignorance of the rules to avoid paying the fine.",
                            "target_lang_translations": {
                                "ru": "Он решил <w>сослаться</w> на незнание правил, чтобы избежать уплаты штрафа."
                            }
                        },
                        {
                            "text": "The mayor had to <w>plead</w> poverty when asked why the city could not afford the new park.",
                            "target_lang_translations": {
                                "ru": "Мэру пришлось <w>сослаться</w> на бедность, когда его спросили, почему город не может позволить себе новый парк."
                            }
                        }
                    ],
                    "synonyms": [
                        "allege",
                        "claim"
                    ],
                    "common_phrases": [
                        "plead ignorance",
                        "plead poverty",
                        "plead insanity"
                    ],
                    "target_lang_definitions": {
                        "ru": "Приводить конкретную причину или оправдание того, почему что-то не может быть сделано или почему человек не несет ответственности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ссылаться",
                                "target_lang_sense_clarification": "на причину или оправдание"
                            },
                            {
                                "target_lang_word": "оправдываться",
                                "target_lang_sense_clarification": "приводя доводы"
                            },
                            {
                                "target_lang_word": "выставлять в качестве оправдания",
                                "target_lang_sense_clarification": "какое-либо обстоятельство"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}