                        "examples": [
                            {
                                "example_id": "68a25ab5-0dbc-43ca-ae2a-fb52810fcb67",
                                "sense_id": "1462bdad-e297-3a48-b100-58c25f91515e",
                                "text": "„Von den Anden her senkt sich, dem Auge unmerkbar, der Boden sanft, aber ununterbrochen nach dem Atlantischen Ozean hin, und die zahlreichen Wasserläufe, die in den himmelansteigenden Höhenzügen der Kordilleren ihren Ursprung haben, nehmen den Weg nach Osten.“"
                            }
                        ],
