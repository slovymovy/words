                        "ru": [
                            {
                                "target_lang_word": "скучный",
                                "target_lang_sense_clarification": "неинтересный, вызывающий тоску"
                            },
                            {
                                "target_lang_word": "глупый",
                                "target_lang_sense_clarification": "недалекий, бестолковый"
                            },
                            {
                                "target_lang_word": "занудный",
                                "target_lang_sense_clarification": "раздражающе скучный"
                            }
                        ]
                    }
                }
            ]
        },
        {
