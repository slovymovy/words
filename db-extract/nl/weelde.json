        "nl-extract.jsonl": [
            {
                "entry_id": "d5cc79b5-c679-3233-b785-d79a7f55c221",
                "word": "weelde",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "10726ae3-525f-3db5-9da1-a0308b6be1c3",
                        "entry_id": "d5cc79b5-c679-3233-b785-d79a7f55c221",
                        "glosses": [
                            "omstandigheden van overvloed waar men in leeft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7313b963-576e-43e7-a197-2c327e7b3fd9",
                                "sense_id": "10726ae3-525f-3db5-9da1-a0308b6be1c3",
                                "text": "Aan het Franse hof heerste grote weelde, terwijl het volk hongerde."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "be6afbee-4349-4ec4-9bf2-2c4ee84f1483",
                        "source_entry_id": "d5cc79b5-c679-3233-b785-d79a7f55c221",
                        "source_sense_id": "10726ae3-525f-3db5-9da1-a0308b6be1c3",
                        "source_sense_description": "omstandigheden van overvloed waar men in leeft",
                        "target_lang_word": "riches",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "riches",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0becdb27-19ef-3eae-8927-52e7c090dbac",
                                        "entry_id": "d5dac955-7244-35f8-af87-b192c153bced",
                                        "glosses": [
                                            "Money, goods, wealth, treasure."
                                        ],
                                        "tags": [
                                            "plural",
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4f86c3d0-4233-486d-af7b-77754d87c2c8",
                                                "sense_id": "0becdb27-19ef-3eae-8927-52e7c090dbac",
                                                "text": "Cal.[…]Sometimes a thouſand twangling Inſtruments\n Will hum about mine eares ; and ſometime voices,\n That if I then had wak'd after long ſleepe,\n Will make me ſleepe againe, and then in dreaming,\n The clouds methought would open, and ſhew riches\n Ready to drop vpon me, that when I wak'd\n I cri'de to dreame againe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d02cedf-0da3-3b97-b985-abe64977bbd0",
                                        "entry_id": "d5dac955-7244-35f8-af87-b192c153bced",
                                        "glosses": [
                                            "An abundance of anything desirable."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "plural",
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d296289a-dec1-4b28-95db-2f6c54bcd046",
                                                "sense_id": "1d02cedf-0da3-3b97-b985-abe64977bbd0",
                                                "text": "You will enjoy the riches of this forest."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "riches",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "394edb0a-c96d-3690-8c3d-6cf0e56bea35",
                                        "entry_id": "ed33f914-3d83-3d09-9f30-b16e984c5cdf",
                                        "glosses": [
                                            "Rich people."
                                        ],
                                        "tags": [
                                            "nonstandard",
                                            "plural",
                                            "plural-only",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10ff4b65-4d7c-4561-b9c6-f520bc647814",
                                                "sense_id": "394edb0a-c96d-3690-8c3d-6cf0e56bea35",
                                                "text": "Mr. Chander Lall Mookerji wrote to me thus: “The youngs and the olds, the highs and the lows, the riches and the poors, all join together in praising Your Honour’s magnanimity.”"
                                            },
                                            {
                                                "example_id": "f8e75d03-9f21-4149-acd5-e9542d1456dd",
                                                "sense_id": "394edb0a-c96d-3690-8c3d-6cf0e56bea35",
                                                "text": "In Antiquity has also existed social conflicts between the poor men and the riches."
                                            },
                                            {
                                                "example_id": "385f4a4e-6eae-4783-86e5-0e1254b7d7af",
                                                "sense_id": "394edb0a-c96d-3690-8c3d-6cf0e56bea35",
                                                "text": "[…] South America used to be a heaven for the riches and the hell for the poors and it's true."
                                            },
                                            {
                                                "example_id": "7faf306b-1c83-4366-8144-e6e62a90864f",
                                                "sense_id": "394edb0a-c96d-3690-8c3d-6cf0e56bea35",
                                                "text": "She slips her rosary out of her purse, works her fingers over the beads, and continues chanting her list of deads. It’s one of her many lists. And one of her many quirks. She’s list obsessed. The deads, the gays, the riches, the poors, the outs, the down-and-outs. […] And, after my sister, Opal committed suicide, she dipped deeper into the buggy pot. […] After Dad passed, our long-distance phone conversations took on all kinds of new eccentricities. […] The deads were not going to be disregarded, according to Mom."
                                            },
                                            {
                                                "example_id": "cd1cd8ba-f1f1-43ec-91b2-ec0d53a64c7f",
                                                "sense_id": "394edb0a-c96d-3690-8c3d-6cf0e56bea35",
                                                "text": "They live in the forest, steal from the riches and help the poors."
                                            },
                                            {
                                                "example_id": "cf719c7b-449d-434c-a7a6-e946b7bd6e4e",
                                                "sense_id": "394edb0a-c96d-3690-8c3d-6cf0e56bea35",
                                                "text": "The riches have money not happiness / The poors are happy but penniless"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8bb2cc99-8db7-40cc-9a25-b535e82326d5",
                        "source_entry_id": "d5cc79b5-c679-3233-b785-d79a7f55c221",
                        "source_sense_id": "10726ae3-525f-3db5-9da1-a0308b6be1c3",
                        "source_sense_description": "omstandigheden van overvloed waar men in leeft",
                        "target_lang_word": "wealth",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wealth",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "01eddd62-cab6-308f-8f79-7bc56293aa1a",
                                        "entry_id": "2904040a-c3db-37e2-bb03-592a699f48d4",
                                        "glosses": [
                                            "Riches; a great amount of valuable assets or material possessions."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67efbc9a-dda3-40a8-857f-3d38685d82f0",
                                                "sense_id": "01eddd62-cab6-308f-8f79-7bc56293aa1a",
                                                "text": "Money talks, but true wealth whispers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "18f0718d-8422-343a-acf3-ae387052f490",
                                        "entry_id": "2904040a-c3db-37e2-bb03-592a699f48d4",
                                        "glosses": [
                                            "A great amount; an abundance or plenty."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4fdfb138-a80e-43df-9fc2-2fe7dba721b1",
                                                "sense_id": "18f0718d-8422-343a-acf3-ae387052f490",
                                                "text": "She brings a wealth of knowledge to the project."
                                            },
                                            {
                                                "example_id": "067a698b-dcb9-456e-a8ed-a615d796e4f6",
                                                "sense_id": "18f0718d-8422-343a-acf3-ae387052f490",
                                                "text": "There is a wealth of carved wood inside: from pulpit to pews, screens to lectern, and a large medieval chest made from a hollowed-out log of bog-oak with a massive lid."
                                            },
                                            {
                                                "example_id": "dba36105-6ddc-408a-ade8-6a109593e6e5",
                                                "sense_id": "18f0718d-8422-343a-acf3-ae387052f490",
                                                "text": "Beyond its aim to bring patients the most effective treatments faster, the service is expected to generate a wealth of data on the interplay between DNA, health and lifestyles, which will become a powerful tool for research into cancer and other diseases."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6420886a-7a50-394a-9346-a072619589c4",
                                        "entry_id": "2904040a-c3db-37e2-bb03-592a699f48d4",
                                        "glosses": [
                                            "Prosperity; well-being; happiness."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "580f3bf7-53bd-4a7f-af5f-06501575f3ea",
                                                "sense_id": "6420886a-7a50-394a-9346-a072619589c4",
                                                "text": "I once did lend my body for his wealth, / Which, but for him that had your husband's ring, / Had quite miscarried: […]"
                                            },
                                            {
                                                "example_id": "7d3f7b61-56e7-4f80-8786-1f6c8114e242",
                                                "sense_id": "6420886a-7a50-394a-9346-a072619589c4",
                                                "text": "Let no man seek his own, but every man another's wealth."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
