                    {
                        "translation_id": "b7a9f3bc-69e4-4956-8f63-b894b68abc99",
                        "source_entry_id": "ea6efe15-98ef-3634-a4b5-ca01fe2e3a3f",
                        "source_sense_description": "remote control",
                        "target_lang_word": "Fernbedienung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fernbedienung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "551ff51f-9cec-3509-9a0b-0a696eb85dd3",
                                        "entry_id": "9875f9b4-baf7-3b5f-b253-47fb3cf1f1b8",
                                        "glosses": [
                                            "elektrische Schalteinheit zum Bedienen elektrischer Geräte aus der Entfernung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1d8119a-b00a-402e-9900-c86197674ce1",
                                                "sense_id": "551ff51f-9cec-3509-9a0b-0a696eb85dd3",
                                                "text": "Gib mir mal die Fernbedienung! Ich möchte umschalten."
                                            },
                                            {
                                                "example_id": "694dd154-4454-4b60-90fe-c0fc2c91bf3b",
                                                "sense_id": "551ff51f-9cec-3509-9a0b-0a696eb85dd3",
                                                "text": "Wo sind die Batterien für die Fernbedienung?"
                                            },
                                            {
                                                "example_id": "61524365-7c31-459b-9b7b-0c95feb5fbfc",
                                                "sense_id": "551ff51f-9cec-3509-9a0b-0a696eb85dd3",
                                                "text": "„Die Fernbedienung war kaputtgegangen, infolgedessen blieb der Fernseher schwarz.“"
                                            },
                                            {
                                                "example_id": "0a22b437-1a49-4097-bc09-650652df90d1",
                                                "sense_id": "551ff51f-9cec-3509-9a0b-0a696eb85dd3",
                                                "text": "„Daniel fingerte an einer Fernbedienung herum, ein leises Motorgeräusch setzte ein, und ein riesiger Flachbildschirm mit gebogenem Display fuhr auf geheimnisvolle Weise langsam aus einem Sideboard empor.“"
                                            },
                                            {
                                                "example_id": "dd2a2c7d-9053-4945-a9ee-fa4e1f72e901",
                                                "sense_id": "551ff51f-9cec-3509-9a0b-0a696eb85dd3",
                                                "text": "„Allan zeigte dem Polizeichef, wie die Fernbedienung funktionierte, und erläuterte detailliert, wie das Ergebnis aussehen würde, wenn das Ding hochging.“"
                                            },
                                            {
                                                "example_id": "cb5882a2-a715-42c5-9fd8-5645f1d12fd0",
                                                "sense_id": "551ff51f-9cec-3509-9a0b-0a696eb85dd3",
                                                "text": "„Maman-Bozorg übergab mir die Fernbedienung und sang mit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f8a56214-ae0f-4f77-a38c-85e0dab7c928",
                        "source_entry_id": "ea6efe15-98ef-3634-a4b5-ca01fe2e3a3f",
