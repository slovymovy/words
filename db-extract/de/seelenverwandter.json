                                        "examples": [
                                            {
                                                "example_id": "29fb3ccc-fbe2-42af-896b-d7ce34cbff82",
                                                "sense_id": "fecde609-3886-3df8-a976-8d354b96b02c",
                                                "text": "Finding your wonderful soulmate is very similar to the process of sowing a seed and nurturing it into a beautiful blossoming plant."
                                            },
                                            {
                                                "example_id": "d6056c7a-b73a-4127-b594-3ab556a8e8bc",
                                                "sense_id": "fecde609-3886-3df8-a976-8d354b96b02c",
                                                "text": "I'm all over the place, I can't sit in one place / I'm not ashamed at all / Still findin' myself, let alone a soulmate, I'm just sayin'"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f054d9c4-af54-49b1-bde6-558ce020fa31",
                        "source_entry_id": "7f21921f-675b-36ff-9c63-bbfaf44c7eb9",
                        "source_sense_id": "65823f16-cd01-3a5d-9d01-762004dcbf5c",
                        "source_sense_description": "Person, zu der man eine besonders starke Bindung hat",
                        "target_lang_word": "âme sœur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "âme sœur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "702930e1-ca87-31e1-a4e6-7000b162fda9",
                                        "entry_id": "8688c2a9-0ed8-344f-ba22-1facd0c3b079",
                                        "glosses": [
                                            "Personne qui semble être faite pour convenir à une autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "257033c7-5147-429b-8151-f7403a972191",
                                                "sense_id": "702930e1-ca87-31e1-a4e6-7000b162fda9",
                                                "text": "On croit trouver une âme sœur\nEt l’on récolte une vestale\nQui vient vous faire la morale\nDans un hôtel sans ascenseur."
                                            },
                                            {
                                                "example_id": "0f795082-3bea-49ee-a042-8a554cc8da4c",
                                                "sense_id": "702930e1-ca87-31e1-a4e6-7000b162fda9",
                                                "text": "Elle ne voyait en lui ni son destin ni son âme sœur."
                                            },
                                            {
                                                "example_id": "58f1b10e-af11-4b39-9e4c-945caa81c1f2",
                                                "sense_id": "702930e1-ca87-31e1-a4e6-7000b162fda9",
                                                "text": "Promenades bucoliques par temps clair ou sous la pluie battante. Confidences entre âmes sœurs qui s’allient. Et puis se désunissent."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e4e1782e-babf-4200-a382-945c1c7ac577",
                        "source_entry_id": "7f21921f-675b-36ff-9c63-bbfaf44c7eb9",
                        "source_sense_id": "65823f16-cd01-3a5d-9d01-762004dcbf5c",
