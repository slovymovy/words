                        "glosses": [
                            "A student (or a former student) of a college"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a976b98-b837-49fb-8573-b19d18327de8",
                                "sense_id": "7fde0da7-5b57-3081-9dbe-b5776053c2be",
                                "text": "She then remembered that her own early bearing towards him had been haughty, and indifferent; that she had sneered at the young collegian's shyness; and now thought with \"the late remorse of love,\" how unlike to this had been Ethel's gentle kindness."
                            }
                        ]
