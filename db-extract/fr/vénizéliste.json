            {
                "entry_id": "d1be082a-040d-3aa8-9f9a-df7c1b84876f",
                "word": "vénizéliste",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "23333cfc-2f19-49fd-b810-2a1d13561353",
