                ],
                "senses": [
                    {
                        "sense_id": "a2ce58ba-8eeb-3b77-9cba-0b8f0120286f",
                        "entry_id": "b5228684-f375-3511-b0f1-a0a4de8c5a3f",
                        "glosses": [
                            "osoba, która wierzy w teorie spiskowe, zjawiska paranormalne, pseudonaukowe teorie"
                        ],
                        "tags": [
                            "colloquial",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "4e7575fc-fa33-41a8-b3f9-292c69bc719a",
                                "sense_id": "a2ce58ba-8eeb-3b77-9cba-0b8f0120286f",
                                "text": "Rośnie w siłę cały ruch negacjonistów pandemii, zwanych też antycovidowcami, foliarzami czy wręcz covidiotami"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "84a4d3cd-bb1e-42aa-adf0-f7d140d809d1",
                        "source_entry_id": "b5228684-f375-3511-b0f1-a0a4de8c5a3f",
                        "source_sense_id": "a2ce58ba-8eeb-3b77-9cba-0b8f0120286f",
                        "target_lang_word": "tinfoil hatter",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tinfoil hatter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d98d25ab-3ade-34cc-be82-84ba44cc11aa",
                                        "entry_id": "163ada52-2d06-3a5c-944b-5d5fa5427884",
                                        "glosses": [
                                            "A person who believes in or propagates conspiracy theories; a conspiracy theorist."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dfaa63cd-da87-425b-982e-b73eb427c57c",
                                                "sense_id": "d98d25ab-3ade-34cc-be82-84ba44cc11aa",
                                                "text": "The Washington State Dental Association is backing his $300,000 pro-fluoride campaign. Danelle Weaver and her friends, meanwhile, have raised less than $10,000. But they are undaunted. \"People think we are tinfoil hatters,\" says Weaver, \"but we're just average families who take the time to research and want what's best for our children.\""
                                            },
                                            {
                                                "example_id": "effacf9b-2bcf-4150-a8a9-9572027a0714",
                                                "sense_id": "d98d25ab-3ade-34cc-be82-84ba44cc11aa",
                                                "text": "We then tell the public and get laughed at and called crazy tinfoil hatters and then it happens just as we said it would."
                                            },
                                            {
                                                "example_id": "130a17e3-8029-45a9-988a-afd48981b15a",
                                                "sense_id": "d98d25ab-3ade-34cc-be82-84ba44cc11aa",
                                                "text": "She doesn't know whom to believe, but she agrees with the tinfoil hatters about one thing: Something is weird here."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4927e3dd-67ba-4640-a5a5-132cf447be64",
                        "source_entry_id": "b5228684-f375-3511-b0f1-a0a4de8c5a3f",
                        "source_sense_id": "a2ce58ba-8eeb-3b77-9cba-0b8f0120286f",
                        "target_lang_word": "conspiracy theorist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "conspiracy theorist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f7bc9a1e-8f1f-3406-8ca6-9dfe8f3496cc",
                                        "entry_id": "ee2392f4-1938-39bd-b16d-21f495d13de6",
                                        "glosses": [
                                            "One who believes in, follows, or advances a conspiracy theory."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f8c16d6e-72ec-4ad4-add9-9cbaf4903357",
                                                "sense_id": "f7bc9a1e-8f1f-3406-8ca6-9dfe8f3496cc",
                                                "text": "Mike's a conspiracy theorist; he thinks NASA faked the moon landings."
                                            },
                                            {
                                                "example_id": "9addbafe-bcee-4d25-945e-f27034d8fcd5",
                                                "sense_id": "f7bc9a1e-8f1f-3406-8ca6-9dfe8f3496cc",
                                                "text": "And you may have noticed that those who are too quick to shout 'conspiracy theorist' are equally swift, when consequences for authority and consensus impend, to look serious and say 'It's more complicated than that.' These have become standard damage-control reflexes."
                                            },
                                            {
                                                "example_id": "3a39a1dc-8fb4-455f-a67f-d8b19f8775cb",
                                                "sense_id": "f7bc9a1e-8f1f-3406-8ca6-9dfe8f3496cc",
                                                "text": "“Robert F. Kennedy, Jr. is not an environmentalist. He is a dangerous conspiracy theorist and science denier whose agenda would be a disaster for our communities and the planet,” the letter reads."
                                            },
                                            {
                                                "example_id": "7bfe3737-5fb3-408b-bb61-a9d3859eabdb",
                                                "sense_id": "f7bc9a1e-8f1f-3406-8ca6-9dfe8f3496cc",
                                                "text": "Rep. Marjorie Taylor Greene (R-Ga.), one of the most notorious conspiracy theorists and MAGA diehards in Congress, told The New York Times that the DOJ’s memo is “a full reversal on what was all said beforehand, and people are just not willing to accept it.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c588d52d-0713-4202-a889-b217958b1e7d",
                        "source_entry_id": "b5228684-f375-3511-b0f1-a0a4de8c5a3f",
