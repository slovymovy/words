                                ]
                            },
                            {
                                "target_word": "great",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "765d3c66-8e9f-3edf-832c-a9d30c728fd0",
                                        "entry_id": "b75660ea-5e56-37b9-8a0a-512f004a7f96",
                                        "glosses": [
                                            "A person of major significance, accomplishment or acclaim."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f1bd270-268d-4684-bd3c-587d529434d8",
                                                "sense_id": "765d3c66-8e9f-3edf-832c-a9d30c728fd0",
                                                "text": "Newton and Einstein are two of the greats of the history of science."
                                            },
                                            {
                                                "example_id": "1027d6f9-9d14-4328-9382-dac6df0b07d8",
                                                "sense_id": "765d3c66-8e9f-3edf-832c-a9d30c728fd0",
                                                "text": "Sadio Mané wasted a glorious chance in the first half and, late on, Mohamed Salah turned his shot against a post after a goal-line clearance had spun his way. That, in a nutshell, perhaps sums up the difference between Messi and the players on the next rung below – the ones who can be described as great footballers without necessarily being football greats."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d8d18f6-5ce7-3133-88b2-683c87bfa3b2",
                                        "entry_id": "b75660ea-5e56-37b9-8a0a-512f004a7f96",
                                        "glosses": [
                                            "The main division in a pipe organ, usually the loudest division."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "715cfdf2-8f17-3aef-bcfd-37b760abb913",
