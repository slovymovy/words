                            {
                                "example_id": "bbfdb7f8-5cd6-4f9f-8d09-904cd896f423",
                                "sense_id": "11a80b1c-d65e-3231-b227-3ad12025278e",
                                "text": "Zondag: Bonnie Raitt, Sonny Rollins, Miguel, Ben Harper & Charlie Musselwhite blues set, Kurt Rosenwinkel Quartet, Doug Hammond Quintet, Robert Glasper Experiment with Lionel Loueke, Chris Dave and the Drumhedz, Colin Stetson, Hermeto Pascoal, Tim Wes, Zapp4"
                            },
                            {
                                "example_id": "f14744d1-ee35-40c3-ab6b-715a1c969a5d",
                                "sense_id": "11a80b1c-d65e-3231-b227-3ad12025278e",
                                "text": "Maar optreden bij K3 zoekt K3 is anders. Met het Meijer Quintet bracht de goedlachse jongedame vooral klassieke muziek ten gehore. Dat ligt haar. Klaasje is naast het K3-avontuur eveneens bezig met het studeren van dwarsfluit op het conservatorium."
                            }
                        ]
