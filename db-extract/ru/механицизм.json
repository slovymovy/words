                        "cross_references": [
                            {
                                "target_word": "mechanisme",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "48cacb27-807d-3e4c-86cf-c0f9e6c4c12f",
                                        "entry_id": "bdfd54f9-da41-370c-8d55-ac254c4bcd1f",
                                        "glosses": [
                                            "een constructie van onderling beweegbaar aan elkaar verbonden delen, machinerie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "384de1b8-bc42-4757-977a-3f073a188486",
                                                "sense_id": "48cacb27-807d-3e4c-86cf-c0f9e6c4c12f",
                                                "text": "Een aan een mechanisme opgelegde beweging wordt omgezet in een verlangde, van het mechanisme af te nemen beweging."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e85b5c57-5d1d-39ce-8b24-3c126cad57ca",
                                        "entry_id": "bdfd54f9-da41-370c-8d55-ac254c4bcd1f",
                                        "glosses": [
                                            "de manier waarop een reactie verloopt op moleculair, atomair en elektronisch niveau"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7883ad60-fa85-4960-9fe1-c2f16863bf68",
                                                "sense_id": "e85b5c57-5d1d-39ce-8b24-3c126cad57ca",
                                                "text": "Is het mechanisme van deze reactie een nucleofiele of een elektrofiele substitutie?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "185b4417-5567-343a-a88e-0eb4bc04c95d",
                                        "entry_id": "bdfd54f9-da41-370c-8d55-ac254c4bcd1f",
                                        "glosses": [
                                            "een extreme vorm van determinisme waarbij men elk stoffelijk en biologisch gebeuren probeert te verklaren door plaatselijke, materiële beweging"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2586d27e-defc-323d-a48f-0048dc8e9943",
                                        "entry_id": "bdfd54f9-da41-370c-8d55-ac254c4bcd1f",
                                        "glosses": [
                                            "berustend op een wetmatige samenhang"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c8d8e010-2d46-4cce-afc8-78e913d98185",
                                                "sense_id": "2586d27e-defc-323d-a48f-0048dc8e9943",
                                                "text": "\"Bij institutioneel racisme gaat het typisch om ingebakken, structurele mechanismen\", voegt Nationaal Coördinator tegen Discriminatie en Racisme (NCDR) Rabin Baldewsingh toe."
                                            }
                                        ]
                                    },
