                ],
                "senses": [
                    {
                        "sense_id": "ce29a5c2-a86b-3fe7-baa9-14c26fb77ddd",
                        "entry_id": "41fee775-cdd5-3236-af73-62ca906646af",
                        "glosses": [
                            "in der Vorstellung der Nationalsozialisten ein zu schaffendes Deutschland, das alle Deutschen miteinschließt"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "ba7de66c-76bc-4d3f-89ff-25ba54b9fa76",
                                "sense_id": "ce29a5c2-a86b-3fe7-baa9-14c26fb77ddd",
                                "text": "Das Ziel war Großdeutschland."
                            },
                            {
                                "example_id": "268cac78-c07a-4779-b1a7-20a108584fb1",
                                "sense_id": "ce29a5c2-a86b-3fe7-baa9-14c26fb77ddd",
                                "text": "„An allen Parteitagen war sie mit Tannengrün und Eichenlaub bekränzt gewesen, und Schimmel, der Direktor, hatte glühende Reden vor ihr gehalten über Rache, Großdeutschland und die kommende Vergeltung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "223b1068-1ce9-3895-984b-0667c6ded664",
                        "entry_id": "41fee775-cdd5-3236-af73-62ca906646af",
                        "glosses": [
                            "Bezeichnung der Nationalsozialisten für das Deutsche Reich nach dem Anschluss Österreichs im Jahr 1938"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "7c7177a9-47c8-4c9e-9daa-656b1aa25875",
                                "sense_id": "223b1068-1ce9-3895-984b-0667c6ded664",
                                "text": "„Das kommt davon, wenn du mit Großdeutschland durch Europa gezogen bist; dann schleifen sich die Dialekte ab.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "c9b694eb-ea05-3142-8a24-c4f431133007",
                        "entry_id": "41fee775-cdd5-3236-af73-62ca906646af",
                        "glosses": [
                            "Bezeichnung für das wiedervereinigte Deutschland, wenn es als wirtschaftlich bedrohend für andere Länder empfunden wird"
                        ],
                        "tags": [
                            "wertend"
                        ],
                        "examples": [
                            {
                                "example_id": "2cc97b2a-1d96-415a-9100-f1fa926b8f8b",
                                "sense_id": "c9b694eb-ea05-3142-8a24-c4f431133007",
                                "text": "Großdeutschland stellt auch heute wieder eine wirtschaftliche Bedrohung dar, der wir angemessen begegnen müssen."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
