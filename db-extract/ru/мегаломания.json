                                "target_senses": [
                                    {
                                        "sense_id": "5339c543-2409-3fc5-88f2-31d9a89afcb9",
                                        "entry_id": "05bfd710-f01c-3c7b-99cb-2064ec754be1",
                                        "glosses": [
                                            "Trastorno mental, o estado mórbido de la psique, caracterizado por fantasías de omnipotencia."
                                        ],
                                        "tags": [
                                            "enfermedades"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "21c72ea4-7a20-3cd8-9b1d-993f2010d0fd",
                                        "entry_id": "05bfd710-f01c-3c7b-99cb-2064ec754be1",
                                        "glosses": [
                                            "Manía o delirio de grandezas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18f455d6-2088-4007-97cc-40c6a66bf510",
                                                "sense_id": "21c72ea4-7a20-3cd8-9b1d-993f2010d0fd",
                                                "text": "Guarde por el contrario, esta prevención: que, aun en el caso de que la buena suerte le levante y aun parezca conducirle al colmo, deponga pretensiones y no se deje arrebatar por sobre sus posibilidades; que, en lo material, la bella medianía es más segura que la megalomanía."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2827692e-5ca5-4f03-9beb-7d9c315ef5fe",
                        "source_entry_id": "95e5ee69-cf09-30a0-ba60-85125304855a",
                        "target_lang_word": "mégalomanie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mégalomanie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "67f16fa3-dba3-3aa5-a194-8ec65e2d9d6d",
                                        "entry_id": "04d772e2-0324-33d2-b3e9-c4142f0385d0",
                                        "glosses": [
                                            "Manie qui consiste soit en un désir insatiable de gloire, de grandeur, soit dans l’illusion qu’on les possède."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ba6151b-fa7e-4bb2-8b95-3dbf2a83d524",
                                                "sense_id": "67f16fa3-dba3-3aa5-a194-8ec65e2d9d6d",
                                                "text": "Une faiblesse, cependant : son ambition démesurée, qui tourne à la mégalomanie. Il se rêve à la Chambre, au gouvernement."
                                            },
                                            {
                                                "example_id": "a0d463d1-8e99-4b66-a592-a33815831446",
                                                "sense_id": "67f16fa3-dba3-3aa5-a194-8ec65e2d9d6d",
                                                "text": "La mégalomanie, quezaco ? Elle consiste en une surestimation de ses capacités qui se traduit par un désir immodéré de puissance et un amour exclusif ou excessif de soi."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
