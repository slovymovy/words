                                "target_senses": [
                                    {
                                        "sense_id": "6754e0b0-10e1-3fd0-8b23-4941df4275af",
                                        "entry_id": "efde1891-a65f-326e-8eba-af18706550ba",
                                        "glosses": [
                                            "Psychotic, psychopathic, or (broadly) otherwise insane."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e9d026f1-b365-46e8-a11a-116d3ab38f84",
                                                "sense_id": "6754e0b0-10e1-3fd0-8b23-4941df4275af",
                                                "text": "That psycho jawn had snuck a pistol into the gym while we was practicing and started shooting shit up like she was some kinda hot female action hero."
                                            },
                                            {
                                                "example_id": "8fad6462-ec0e-41fd-9b2c-cff1027fe1f6",
                                                "sense_id": "6754e0b0-10e1-3fd0-8b23-4941df4275af",
                                                "text": "Oh, she's sweet but a psycho / A little bit psycho / At night she's screamin' / \"I'm-ma-ma-ma out my mind\""
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "psycho",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b82c1289-0bd0-39b3-946a-b2fa30fde9f6",
                                        "entry_id": "13257af3-fa81-3ce6-816b-2dbd4970b947",
                                        "glosses": [
                                            "A person who is psychotic, psychopathic, or (broadly) otherwise insane."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c27908c-8325-4cf0-b395-5700e5320369",
                                                "sense_id": "b82c1289-0bd0-39b3-946a-b2fa30fde9f6",
                                                "text": "The loony bin up on the hill is full of psychos."
                                            },
                                            {
                                                "example_id": "d62ec186-a023-4caf-85ec-51a1f2c4af9c",
                                                "sense_id": "b82c1289-0bd0-39b3-946a-b2fa30fde9f6",
                                                "text": "Oh, she's hot but a psycho / So left but she's right, though / At night she's screamin' / \"I'm-ma-ma-ma out my mind\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f6a644b-4c77-3b7e-b9ba-c89c72973e42",
                                        "entry_id": "13257af3-fa81-3ce6-816b-2dbd4970b947",
                                        "glosses": [
                                            "A person who acts in a bizarre or dangerous manner."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "derogatory",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0dce82fa-a9c6-43f8-84b1-07777cb4c361",
                                                "sense_id": "1f6a644b-4c77-3b7e-b9ba-c89c72973e42",
                                                "text": "She complained that he was a psycho for driving at such a high speed in heavy traffic."
                                            }
                                        ]
                                    }
