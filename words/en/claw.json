{
    "word_family": [
        "clawed",
        "clawless",
        "clawlike",
        "declaw"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5c2c4e30-56ab-32eb-adea-218ba1936892",
                    "sense_definition": "a curved, pointed, horny projection on each digit of the foot of a mammal, reptile, or bird",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "animal_anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The eagle used its sharp <w>claws</w> to catch the fish from the lake.",
                            "target_lang_translations": {
                                "ru": "Орел использовал свои острые <w>когти</w>, чтобы поймать рыбу в озере."
                            }
                        },
                        {
                            "text": "Be careful because the cat might extend its <w>claws</w> if it feels threatened.",
                            "target_lang_translations": {
                                "ru": "Будь осторожен, потому что кошка может выпустить <w>когти</w>, если почувствует угрозу."
                            }
                        }
                    ],
                    "synonyms": [
                        "talon",
                        "nail"
                    ],
                    "common_phrases": [
                        "sharp claws",
                        "retractable claws"
                    ],
                    "target_lang_definitions": {
                        "ru": "изогнутый, заостренный роговой вырост на пальце ноги млекопитающего, рептилии или птицы"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "коготь",
                                "target_lang_sense_clarification": "роговое образование на пальцах животных"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f380ddb7-b5a5-3bcc-bb38-79df0b926886",
                    "sense_definition": "the pincer of a crustacean or other arthropod",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "animal_anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The crab snapped its large <w>claw</w> at the curious seagull.",
                            "target_lang_translations": {
                                "ru": "Краб щелкнул своей большой <w>клешней</w> в сторону любопытной чайки."
                            }
                        },
                        {
                            "text": "We ordered a plate of steamed lobster <w>claws</w> for dinner.",
                            "target_lang_translations": {
                                "ru": "На ужин мы заказали тарелку приготовленных на пару <w>клешней</w> лобстера."
                            }
                        }
                    ],
                    "synonyms": [
                        "pincer",
                        "chela"
                    ],
                    "common_phrases": [
                        "lobster claw",
                        "crab claw"
                    ],
                    "target_lang_definitions": {
                        "ru": "клешня ракообразного или другого членистоногого"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "клешня",
                                "target_lang_sense_clarification": "хватательный орган ракообразных"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d144a2a3-b2cc-35d5-82fb-103907a30ddf",
                    "sense_definition": "a mechanical device resembling a claw, used for gripping or lifting",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "tools",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The arcade game features a metal <w>claw</w> that tries to grab stuffed animals.",
                            "target_lang_translations": {
                                "ru": "В игровом автомате есть металлический <w>захват</w>, который пытается вытащить мягкие игрушки."
                            }
                        },
                        {
                            "text": "The construction crane used a massive <w>claw</w> to move the scrap metal.",
                            "target_lang_translations": {
                                "ru": "Строительный кран использовал массивный <w>захват</w> для перемещения металлолома."
                            }
                        }
                    ],
                    "synonyms": [
                        "grasper",
                        "gripper",
                        "grabber"
                    ],
                    "common_phrases": [
                        "claw machine",
                        "mechanical claw"
                    ],
                    "target_lang_definitions": {
                        "ru": "механическое устройство, напоминающее коготь, используемое для захвата или подъема"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "захват",
                                "target_lang_sense_clarification": "механическое приспособление"
                            },
                            {
                                "target_lang_word": "клешня",
                                "target_lang_sense_clarification": "разговорное о механизме игрового автомата"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d9bd177c-df25-383f-916d-277881256dbf",
                    "sense_definition": "a human fingernail, particularly one extending well beyond the fingertip",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "human_anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She painted her long <w>claws</w> with a bright red polish for the party.",
                            "target_lang_translations": {
                                "ru": "Для вечеринки она накрасила свои длинные <w>когти</w> ярко-красным лаком."
                            }
                        },
                        {
                            "text": "Stop digging your <w>claws</w> into my arm; it really hurts!",
                            "target_lang_translations": {
                                "ru": "Перестань впиваться <w>ногтями</w> мне в руку, это очень больно!"
                            }
                        }
                    ],
                    "synonyms": [
                        "fingernail",
                        "nail"
                    ],
                    "common_phrases": [
                        "dig in one's claws"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used humorously or critically"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "человеческий ноготь, особенно сильно выступающий за кончик пальца"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "когти",
                                "target_lang_sense_clarification": "иронично о длинных ногтях"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "39108e0b-29ac-3268-8c3b-7fb2a90389f9",
                    "sense_definition": "an animal foot equipped with claws",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "animal_anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The beast left the print of a heavy <w>claw</w> in the soft mud.",
                            "target_lang_translations": {
                                "ru": "Зверь оставил отпечаток тяжелой <w>лапы</w> в мягкой грязи."
                            }
                        },
                        {
                            "text": "The owl gripped the branch tightly with its powerful <w>claw</w>.",
                            "target_lang_translations": {
                                "ru": "Сова крепко вцепилась в ветку своей мощной <w>лапой</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "paw",
                        "foot"
                    ],
                    "target_lang_definitions": {
                        "ru": "лапа животного, снабженная когтями"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лапа",
                                "target_lang_sense_clarification": "конечность животного с когтями"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0254a729-c10a-3e0d-8372-e9366ac1809f",
                    "sense_definition": "a slender appendage or process, formed like a claw, such as the base of petals of the pink",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "botany",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The botanist noted the narrow <w>claw</w> at the base of each flower petal.",
                            "target_lang_translations": {
                                "ru": "Ботаник отметил узкий <w>ноготок</w> у основания каждого лепестка цветка."
                            }
                        },
                        {
                            "text": "In some species, the <w>claw</w> is very short and barely visible to the naked eye.",
                            "target_lang_translations": {
                                "ru": "У некоторых видов <w>ноготок</w> очень короткий и едва заметен невооруженным глазом."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical botanical term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "тонкий придаток или отросток в форме когтя, например, основание лепестков гвоздики"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ноготок",
                                "target_lang_sense_clarification": "ботанический термин, суженная часть лепестка"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "257452d4-db8d-308c-b5d5-ae46f6ed7e8d",
                    "sense_definition": "to scratch or to tear at something using hands or claws",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physical_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The trapped animal began to <w>claw</w> at the cage door in desperation.",
                            "target_lang_translations": {
                                "ru": "Попавшее в ловушку животное в отчаянии начало <w>скрести</w> дверь клетки."
                            }
                        },
                        {
                            "text": "She tried to <w>claw</w> her way out of the debris after the landslide.",
                            "target_lang_translations": {
                                "ru": "Она пыталась <w>выбраться</w>, разгребая руками обломки после оползня."
                            }
                        }
                    ],
                    "synonyms": [
                        "scratch",
                        "tear",
                        "lacerate",
                        "scrape"
                    ],
                    "common_phrases": [
                        "claw at",
                        "claw one's way"
                    ],
                    "target_lang_definitions": {
                        "ru": "царапать или рвать что-либо руками или когтями"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "царапать",
                                "target_lang_sense_clarification": "повреждать поверхность"
                            },
                            {
                                "target_lang_word": "раздирать",
                                "target_lang_sense_clarification": "рвать когтями"
                            },
                            {
                                "target_lang_word": "скрести",
                                "target_lang_sense_clarification": "усиленно царапать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cfe45c1e-6bdf-32be-8ff8-824160c1d3d9",
                    "sense_definition": "to use the claws or hands to seize or grip something",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hawk managed to <w>claw</w> the rabbit before it could reach its burrow.",
                            "target_lang_translations": {
                                "ru": "Ястребу удалось <w>схватить</w> кролика до того, как тот успел добежать до норы."
                            }
                        },
                        {
                            "text": "He reached out to <w>claw</w> the ledge as he started to slip down the slope.",
                            "target_lang_translations": {
                                "ru": "Он протянул руку, чтобы <w>вцепиться</w> в выступ, когда начал соскальзывать по склону."
                            }
                        }
                    ],
                    "synonyms": [
                        "clutch",
                        "grasp",
                        "seize"
                    ],
                    "target_lang_definitions": {
                        "ru": "использовать когти или руки, чтобы схватить или удержать что-либо"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вцепиться",
                                "target_lang_sense_clarification": "крепко схватить когтями или пальцами"
                            },
                            {
                                "target_lang_word": "схватить",
                                "target_lang_sense_clarification": "резко зажать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e403d9de-06f5-3384-9721-0dd2b4b0e541",
                    "sense_definition": "to move or pull something using one's fingertips or a reaching motion",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The goalkeeper managed to <w>claw</w> away the ball just before it crossed the line.",
                            "target_lang_translations": {
                                "ru": "Вратарю удалось <w>выбить</w> мяч кончиками пальцев прямо перед тем, как он пересек линию."
                            }
                        },
                        {
                            "text": "He had to <w>claw</w> back the curtains to see what was happening outside.",
                            "target_lang_translations": {
                                "ru": "Ему пришлось <w>отдернуть</w> шторы, чтобы увидеть, что происходит снаружи."
                            }
                        }
                    ],
                    "common_phrases": [
                        "claw away",
                        "claw back"
                    ],
                    "target_lang_definitions": {
                        "ru": "двигать или тянуть что-либо кончиками пальцев или загребающим движением"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выгребать",
                                "target_lang_sense_clarification": "доставать или отбивать пальцами"
                            },
                            {
                                "target_lang_word": "оттаскивать",
                                "target_lang_sense_clarification": "тянуть на себя пальцами"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f8d55162-88af-314a-8496-32952b2322df",
                    "sense_definition": "to use the claws or hands to climb a surface",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cat began to <w>claw</w> up the tree to escape the barking dog.",
                            "target_lang_translations": {
                                "ru": "Кошка начала <w>карабкаться</w> вверх по дереву, спасаясь от лающей собаки."
                            }
                        },
                        {
                            "text": "The mountain climber had to <w>claw</w> his way up the icy rock face.",
                            "target_lang_translations": {
                                "ru": "Альпинисту пришлось буквально <w>вгрызаться</w> в ледяную скалу, чтобы подняться наверх."
                            }
                        }
                    ],
                    "synonyms": [
                        "clamber",
                        "scramble"
                    ],
                    "common_phrases": [
                        "claw up"
                    ],
                    "target_lang_definitions": {
                        "ru": "использовать когти или руки для подъема по поверхности"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "карабкаться",
                                "target_lang_sense_clarification": "взбираться, цепляясь когтями или руками"
                            },
                            {
                                "target_lang_word": "взбираться",
                                "target_lang_sense_clarification": "подниматься вверх"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f5655e97-eb10-35e1-b08c-9dd8600e44dd",
                    "sense_definition": "to flatter or humor someone; to court or fawn on",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "social_interaction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He would <w>claw</w> no man in his humour just to gain a temporary advantage.",
                            "target_lang_translations": {
                                "ru": "Он не стал бы никому <w>льстить</w>, потакая прихотям, ради временной выгоды."
                            }
                        },
                        {
                            "text": "The courtiers would constantly <w>claw</w> and flatter the king to stay in his favor.",
                            "target_lang_translations": {
                                "ru": "Придворные постоянно <w>заискивали</w> и льстили королю, чтобы оставаться в его милости."
                            }
                        }
                    ],
                    "synonyms": [
                        "flatter",
                        "fawn",
                        "court"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in older literature"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "льстить кому-либо или угождать; заискивать или лебезить"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лебезить",
                                "target_lang_sense_clarification": "льстиво угождать"
                            },
                            {
                                "target_lang_word": "подлизываться",
                                "target_lang_sense_clarification": "заискивать перед кем-то"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "e73e0521-713f-31f6-817e-58f47a931f4e",
                    "sense_definition": "a surname of Navajo origin",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The local history book mentions a family named <w>Claw</w> living in the valley.",
                            "target_lang_translations": {
                                "ru": "В книге по местной истории упоминается семья по фамилии <w>Кло</w>, жившая в долине."
                            }
                        },
                        {
                            "text": "Mr. <w>Claw</w> was known for his beautiful traditional Navajo weaving.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Кло</w> был известен своим прекрасным традиционным ткачеством навахо."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Navajo origin"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "фамилия навахо"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Кло",
                                "target_lang_sense_clarification": "транскрипция фамилии"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}