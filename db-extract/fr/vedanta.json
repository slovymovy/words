                        "examples": [
                            {
                                "example_id": "45701bf1-6580-433c-b0bc-8ef4aab81f19",
                                "sense_id": "9f31bd9f-4d2b-3d8d-9b14-1d14f4bc4cb7",
                                "text": "On présente très souvent le yoga en référence au Vedanta. Le Vedanta est une démarche non duelle. Il pointe directement vers le silence."
                            },
                            {
                                "example_id": "e374008d-35ea-421a-b2c6-2adcdc996dd4",
                                "sense_id": "9f31bd9f-4d2b-3d8d-9b14-1d14f4bc4cb7",
                                "text": "Tout ce qu’il raconte se trouve déjà dans le vedanta, dans le soufisme, et même, sans aller plus loin, dans Guénon."
                            }
                        ]
