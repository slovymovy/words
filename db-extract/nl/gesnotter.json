                "senses": [
                    {
                        "sense_id": "0991a3ec-1894-307c-94b7-9d5a9f6f12d3",
                        "entry_id": "cb420b66-212a-3f7a-bf03-bee700737df6",
                        "glosses": [
                            "het snuiven van de neus bij een neusverkoudheid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b966834-dd04-4d59-be2d-87471ef7338b",
                                "sense_id": "0991a3ec-1894-307c-94b7-9d5a9f6f12d3",
                                "text": "Tijdens de griepepidemie is het overal een gesnotter en gehoest van jewelste."
                            }
                        ]
                    },
                    {
                        "sense_id": "ff485f30-b118-3d18-be8f-17eca967e078",
                        "entry_id": "cb420b66-212a-3f7a-bf03-bee700737df6",
                        "glosses": [
                            "het gehuil waarbij de tranen die in de neus komen zorgen voor het snuiven van de neus"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b465fcb-00c9-4f98-80ec-9fb5339ae8ce",
                                "sense_id": "ff485f30-b118-3d18-be8f-17eca967e078",
                                "text": "Hou toch eens op met dat gehuil en gesnotter probeer alles toch eens van de positieve kant te bekijken."
                            },
                            {
                                "example_id": "818a1b02-ca1a-44d2-8363-2a1364984f71",
                                "sense_id": "ff485f30-b118-3d18-be8f-17eca967e078",
                                "text": "Voor gevoelens is in het literatuuronderwijs geen plaats. Sterker nog: literatuurcritici uiten zich hierover nogal eens geringschattend. Van der Bolt citeert NRC Handelsblad-recensent Arnold Heumakers die zegt: \"Ik heb niets tegen ontroering en geslik, gesnotter en gesnif onder de leeslamp. Maar als hoogste literaire criterium is ontroering toch iets dat ik vooral associeer met de puberteit. Voor wie pas begint te lezen, naïef en onervaren, zijn boeken die de tranen doen vloeien de beste. Er loopt een vochtig pad van `Alleen op de wereld' naar de echte literatuur. Daarna worden echte criteria belangrijker.\""
                            }
                        ]
                    }
