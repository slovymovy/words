    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3eea1edb-885a-3ec7-afde-bfe74987c02b",
                    "sense_definition": "Qui est susceptible de changer, de varier ou d'évoluer selon les circonstances.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "changement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le temps est très <w>variable</w> dans cette région au début du printemps."
                        },
                        {
                            "text": "Ils ont choisi un prêt immobilier avec un taux <w>variable</w> pour leur maison."
                        }
                    ],
                    "synonyms": [
                        "changeant"
                    ],
                    "antonyms": [
                        "constant",
                        "stable",
                        "régulier",
                        "invariable"
                    ],
                    "common_phrases": [
                        "taux variable",
                        "temps variable",
                        "géométrie variable"
                    ]
                },
                {
                    "sense_id": "ec744858-043b-3b22-8e8c-bb5ab79fbb88",
                    "sense_definition": "Qui est différent ou divers d'un élément à l'autre au sein d'un même ensemble.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "diversite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les résultats obtenus sont d'une qualité très <w>variable</w> selon les groupes."
                        },
                        {
                            "text": "Les employés ont des horaires de travail de durée <w>variable</w> selon les saisons."
                        }
                    ],
                    "antonyms": [
                        "constant",
                        "régulier"
                    ],
                    "common_phrases": [
