                "senses": [
                    {
                        "sense_id": "d419647a-cb05-3080-99b9-ae29b4cb3373",
                        "entry_id": "c04a6e34-21bd-3058-8069-47fac320feb7",
                        "glosses": [
                            "Gerät zur Bestimmung der Temperatur"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e02ac569-3141-40ab-b080-1f7a4057ff19",
                                "sense_id": "d419647a-cb05-3080-99b9-ae29b4cb3373",
                                "text": "„Die im täglichen Leben meist benutzten Temperaturmesser sind die Flüssigkeitsthermometer, wobei Quecksilber die gebräuchlichste Thermometersubstanz geblieben ist.“"
                            },
                            {
                                "example_id": "9b9a0ebe-eaaa-4e98-89a8-c3b3cd107337",
                                "sense_id": "d419647a-cb05-3080-99b9-ae29b4cb3373",
                                "text": "„Pyrometer werden Temperaturmesser, gleich welcher Art, genannt, wenn sie für besonders hohe Temperaturen bestimmt sind.“"
                            },
                            {
                                "example_id": "e736690d-accc-4178-8002-1dadc559424e",
                                "sense_id": "d419647a-cb05-3080-99b9-ae29b4cb3373",
                                "text": "„Eine solche, wie die beschriebene Vorrichtung, ist also ein Temperaturmesser, den wir unter dem etwas unrichtigen und jedenfalls ungenauen Namen Thermometer, d. h. Wärmemesser kennen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
