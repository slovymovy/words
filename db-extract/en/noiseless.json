                        ],
                        "form": "more noiseless"
                    },
                    {
                        "form_id": "4ba9d7ce-eda7-497d-bc8e-dc2c14cb083b",
                        "entry_id": "6a2e9659-704e-35ba-b1fc-6576c9857edb",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most noiseless"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "24c58ced-7424-303d-a66f-6dfbf5cb5c03",
                        "entry_id": "6a2e9659-704e-35ba-b1fc-6576c9857edb",
                        "glosses": [
                            "Producing no noise; without noise."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b6165c3d-21b1-423c-b36b-a58a859b25d6",
                                "sense_id": "24c58ced-7424-303d-a66f-6dfbf5cb5c03",
                                "text": "The movements of the cat were noiseless as it approached the mousehole."
                            },
                            {
                                "example_id": "0d1e8301-ce1e-4323-8559-adedd4167889",
                                "sense_id": "24c58ced-7424-303d-a66f-6dfbf5cb5c03",
                                "text": "For by the hearth the children sit\n⁠Cold in that atmosphere of Death,\n⁠And scarce endure to draw the breath,\nOr like to noiseless phantoms flit:\nBut open converse is there none, […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "47a74073-a385-32a9-9d5d-be68c2755c38",
                        "entry_id": "6a2e9659-704e-35ba-b1fc-6576c9857edb",
                        "glosses": [
                            "Containing no noise."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1fb7c27-2bba-4071-bfd5-6f5d3b889afb",
                                "sense_id": "47a74073-a385-32a9-9d5d-be68c2755c38",
                                "text": "The core idea of the Nostega paradign is basically camouflaging messages by embedding them in a form of noiseless data by employing either altered authenticated data or legitimate untraceable data, as shown in Section 1.3."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8ddbc8ee-a98a-4247-913b-3983528babec",
                        "source_entry_id": "6a2e9659-704e-35ba-b1fc-6576c9857edb",
                        "source_sense_description": "silent",
                        "target_lang_word": "silencieux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "silencieux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d3d07cee-7481-31dd-9a8d-a268ec5d7623",
                                        "entry_id": "8cc9affe-4354-30e7-8e66-6011b3570236",
                                        "glosses": [
                                            "Qui garde le silence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cdbb2136-1c3a-4cc9-8d19-4eb9d70fec7f",
                                                "sense_id": "d3d07cee-7481-31dd-9a8d-a268ec5d7623",
                                                "text": "Ils devinrent silencieux comme deux joueurs qui se défient l’un de l’autre."
                                            },
                                            {
                                                "example_id": "0ebc13cd-5647-452f-b5a4-3b89d145b41a",
                                                "sense_id": "d3d07cee-7481-31dd-9a8d-a268ec5d7623",
                                                "text": "L’un était […] probablement silencieux par ordre ; l’autre, gêné de trouver Mikkelsen et Münck parlant sa langue, était d’une loquacité un peu déconcertante."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "84909b52-e063-3a3d-a58e-b9887c5440d1",
                                        "entry_id": "8cc9affe-4354-30e7-8e66-6011b3570236",
                                        "glosses": [
                                            "Que l’on exprime par le silence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "053b3770-5c46-46e0-a229-1fe2ef824acd",
                                                "sense_id": "84909b52-e063-3a3d-a58e-b9887c5440d1",
                                                "text": "Une douleur silencieuse."
                                            },
                                            {
                                                "example_id": "dbd121b4-6537-49f2-8a0c-e7b360663dc8",
                                                "sense_id": "84909b52-e063-3a3d-a58e-b9887c5440d1",
                                                "text": "Une colère silencieuse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b5d9d3b6-64d9-3c38-84df-4819800e2032",
                                        "entry_id": "8cc9affe-4354-30e7-8e66-6011b3570236",
                                        "glosses": [
                                            "Qualifie une personne qui parle peu, qui garde habituellement le silence."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "34ab3730-9960-3798-b359-4fd7d2ebaf63",
                                        "entry_id": "8cc9affe-4354-30e7-8e66-6011b3570236",
                                        "glosses": [
                                            "Qualifie les choses qui ne font pas de bruit, ou en font peu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8afd7bb2-659c-4894-9fc2-bf56dda9b0ad",
                                                "sense_id": "34ab3730-9960-3798-b359-4fd7d2ebaf63",
                                                "text": "Ils nous dévisagèrent tous du même coup d’œil et sans paraître reconnaître Bob qui, sobrement, distribuait de silencieuses poignées de main, retombèrent dans leurs réflexions."
                                            },
                                            {
                                                "example_id": "32e83f8f-800c-4716-9827-772248d9da7e",
                                                "sense_id": "34ab3730-9960-3798-b359-4fd7d2ebaf63",
                                                "text": "Un leurre avec billes est souvent attractif, mais il arrive aussi que le même modèle, silencieux cette fois, devienne alors plus prenant."
                                            },
                                            {
                                                "example_id": "8fd829ab-c223-4eb3-979a-6dae4742d5de",
                                                "sense_id": "34ab3730-9960-3798-b359-4fd7d2ebaf63",
                                                "text": "Ce moteur est très silencieux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f6cfbe58-1a50-36c1-8d27-17e4c07226c3",
                                        "entry_id": "8cc9affe-4354-30e7-8e66-6011b3570236",
                                        "glosses": [
                                            "Qualifie les lieux où l’on n’entend pas de bruit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2de37bea-c57e-4355-850c-564a60f40004",
                                                "sense_id": "f6cfbe58-1a50-36c1-8d27-17e4c07226c3",
                                                "text": "Les nuages cessaient de ressembler à des cimes neigeuses ; ils devenaient immatériels et révélaient dans leur contexture un tourbillonnement immense et silencieux."
                                            },
                                            {
                                                "example_id": "16146062-bd03-4855-bd1a-eb27035612a6",
                                                "sense_id": "f6cfbe58-1a50-36c1-8d27-17e4c07226c3",
                                                "text": "Les garçons revenus du service militaire ont trouvé de plus en plus ennuyeuses les soirées du Causse enténébré et silencieux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b63571b-ce27-3ee4-985e-6079e4592278",
                                        "entry_id": "8cc9affe-4354-30e7-8e66-6011b3570236",
                                        "glosses": [
                                            "Dont on ne parle pas ; qui n’est peu ou pas connu."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3c3b6ad-ce68-443b-a74d-3502e99e467d",
                                                "sense_id": "7b63571b-ce27-3ee4-985e-6079e4592278",
                                                "text": "En 2020, San Francisco – qui possède le taux de mortalité par Covid-19 le plus faible de toutes les grandes villes américaines – a perdu deux personnes par jour, en moyenne, à cause de la drogue. Une épidémie « silencieuse », terrée dans les contre-allées du centre-ville et les chambres d’hôtel pour indigents."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "silencieux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "aba4718c-260a-3c6a-afb9-6983e80d43f8",
                                        "entry_id": "419d4295-8ef1-3f2a-b040-68fccb06fb75",
                                        "glosses": [
                                            "Dispositif qui, dans un moteur à explosion, sert à amortir le bruit provenant de l’expulsion des gaz brûlés."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bc42a57c-af07-3c3f-9ea6-fe2b8cb10c4f",
                                        "entry_id": "419d4295-8ef1-3f2a-b040-68fccb06fb75",
                                        "glosses": [
                                            "Dispositif électronique qui réduit ou supprime automatiquement le signal de sortie d’un récepteur de radiodiffusion sonore ou d’un syntoniseur, en particulier pendant les réglages d’accord."
                                        ],
                                        "tags": [
                                            "Acoustique",
                                            "Audiovisuel"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c6c85f34-732b-3f27-b0e8-cc38c5624453",
                                        "entry_id": "419d4295-8ef1-3f2a-b040-68fccb06fb75",
                                        "glosses": [
                                            "Dispositif destiné à réduire le bruit du coup de feu d’un pistolet."
                                        ],
                                        "tags": [
                                            "Armement"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ba3c9d2-6e42-41e5-b5e4-97be853f71d6",
                                                "sense_id": "c6c85f34-732b-3f27-b0e8-cc38c5624453",
                                                "text": "Six coups en une seconde, au P226 avec silencieux, les vagues ont couvert le bruit de toute façon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1fb7e4da-c4dd-31ef-a2b6-da6542e9c485",
                                        "entry_id": "419d4295-8ef1-3f2a-b040-68fccb06fb75",
                                        "glosses": [
                                            "Arme à feu équipée d’un silencieux."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab34a90c-7b85-4b2d-a49d-e99c87a710b4",
                                                "sense_id": "1fb7e4da-c4dd-31ef-a2b6-da6542e9c485",
                                                "text": "Un Croate, les larmes aux yeux, remarqua l’écusson brodé orné d’un tigre. Hors de lui, il décocha un coup de pied aux deux cadavres. John fit signe à Marcelius, que ce geste choqua, de ne pas s’en mêler. L’Anglais s’en voulut de n’avoir pas achevé le Serbe d’un coup de silencieux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d7449285-044b-3539-a89c-7697176d5cce",
                                        "entry_id": "419d4295-8ef1-3f2a-b040-68fccb06fb75",
                                        "glosses": [
                                            "Pet silencieux."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ded9e48-d7c5-45ba-98a7-026a0d24092f",
                                                "sense_id": "d7449285-044b-3539-a89c-7697176d5cce",
                                                "text": "Lâcher un silencieux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "30a01270-df82-4989-a453-eea3dbafb793",
                        "source_entry_id": "6a2e9659-704e-35ba-b1fc-6576c9857edb",
                        "source_sense_description": "silent",
                        "target_lang_word": "geräuschlos",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "geräuschlos",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4b6e62c9-3bab-3d38-937f-db2359e90292",
                                        "entry_id": "16399adc-da76-31f4-b28c-dccbbb8f56eb",
                                        "glosses": [
                                            "ohne ein Geräusch abzugeben, lautlos, unhörbar"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71ecedee-1d6b-4c64-84b3-89cd8b90c11d",
                                                "sense_id": "4b6e62c9-3bab-3d38-937f-db2359e90292",
                                                "text": "Das Elektroauto näherte sich geräuschlos."
                                            },
                                            {
                                                "example_id": "cb64e666-94d7-451b-af62-a01a57c27260",
                                                "sense_id": "4b6e62c9-3bab-3d38-937f-db2359e90292",
                                                "text": "„Die nagelneue Flyline am Rittisberg ist eine Mischung von Waldachterbahn und Flying-Fox, mit der Besucher nahezu geräuschlos zwischen den Baumkronen durch den Fichtenwald schweben können.“"
                                            },
                                            {
                                                "example_id": "38bf0ea7-c72c-4e54-93ec-0ed1d922c07c",
                                                "sense_id": "4b6e62c9-3bab-3d38-937f-db2359e90292",
                                                "text": "„Die neuen Antriebstechnik funktioniert, als habe Opel nie andere Autos gebaut: nahezu geräuschlos, vibrationsfrei und ohne andere Auffälligkeiten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
