                "senses": [
                    {
                        "sense_id": "dac597c6-a3ca-3479-89c9-94af3e418044",
                        "entry_id": "ecb936fa-21f7-34e4-a16e-221de0b794fb",
                        "glosses": [
                            "Bauwerk aus Backstein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3576d2d8-4b40-43d4-b8d9-a824101707f1",
                                "sense_id": "dac597c6-a3ca-3479-89c9-94af3e418044",
                                "text": "„Auch über dem schönen roten Backsteingebäude mit weißem Stuck an den Fenstern, vor dem wir schließlich zum Stehen kamen, hing am Bogenvorbau des Eingangstors eine Flagge mit dem stolzen Namen des Auktionshauses.“"
                            },
                            {
                                "example_id": "59c36aa9-dc05-4c08-b12b-9a790912ff62",
                                "sense_id": "dac597c6-a3ca-3479-89c9-94af3e418044",
                                "text": "„Es war ein sechsstöckiges Backsteingebäude auf einem Grundstück, das nur aus Kies und Schotter bestand.“"
                            },
                            {
                                "example_id": "de7a502e-3149-40de-8337-ba62b15eefbe",
                                "sense_id": "dac597c6-a3ca-3479-89c9-94af3e418044",
                                "text": "„Harris nickt, dann geht er mit Roger Nolan zum Eingang des roten Backsteingebäudes.“"
                            },
                            {
                                "example_id": "d70207b6-4ef0-41ce-bd52-278f9d3e671a",
                                "sense_id": "dac597c6-a3ca-3479-89c9-94af3e418044",
                                "text": "„Zwei Backsteingebäude sind zu sehen, Scheunen vermutlich, die überraschend gepflegt wirken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
