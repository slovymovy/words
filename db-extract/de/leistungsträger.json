                        "entry_id": "5b551ae6-a3bd-36c9-9789-f1e5a67ac21c",
                        "glosses": [
                            "Person, die besonders zu einem gemeinsamen Erfolg beiträgt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "deeb44e5-6799-4eab-ab5a-0df5778b85b1",
                                "sense_id": "a4bcb110-4bc1-371a-bd9b-4ca456b8810a",
                                "text": "„Die Zeiten, da Manager, Unternehmensberater und andere Leistungsträger auf ihren Geschäftsreisen nur die edelsten Herbergen buchten, sind lange vorbei.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
