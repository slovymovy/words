                ],
                "senses": [
                    {
                        "sense_id": "0102ab77-0824-3acd-bd20-a17ba9bceded",
                        "entry_id": "1ae512ab-be7a-3649-8486-e7e78b28b9f5",
                        "glosses": [
                            "Hauptraum einer Kirche/mittleres Kirchenschiff in der Längsachse"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0fdf64d3-b95f-4584-bf6d-3107ef718d34",
                                "sense_id": "0102ab77-0824-3acd-bd20-a17ba9bceded",
                                "text": "„Erst einige Zeit später hätten die Christen begonnen, andere Kirchen zu bauen, Kirchen mit einem Altar in der Mitte und einer großen Kuppel darüber, oder Kirchen in Kreuzform mit einem großen Hauptschiff und einem Querschiff.“"
                            },
                            {
                                "example_id": "8704371f-f8e8-45fc-a735-3b96377bcf60",
                                "sense_id": "0102ab77-0824-3acd-bd20-a17ba9bceded",
                                "text": "„Der Innenraum des gesamten Hauptschiffes war bei einer Breite von etwa acht Metern circa fünfundvierzig Meter lang; die Seitenschiffe hatten jeweils die Breite von drei Metern und mit den Säulen des Hauptschiffes betrug die Kirchenbreite etwa fünfzehn Meter.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6a8ab9c3-66d3-4406-aae3-7a6f602364a6",
                        "source_entry_id": "1ae512ab-be7a-3649-8486-e7e78b28b9f5",
                        "source_sense_id": "0102ab77-0824-3acd-bd20-a17ba9bceded",
                        "source_sense_description": "Hauptraum einer Kirche/mittleres Kirchenschiff in der Längsachse",
                        "target_lang_word": "nave",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nave",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c2060c53-16d4-363d-b066-1e027d74bec0",
                                        "entry_id": "2afe06c4-e560-329d-9aee-b94006e0fcc6",
                                        "glosses": [
                                            "The middle or body of a church, extending from the transepts to the principal entrances."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d05a95fb-f446-4194-8189-af1e60eab018",
                                                "sense_id": "c2060c53-16d4-363d-b066-1e027d74bec0",
                                                "text": "Then everybody once more knelt, and soon the blessing was pronounced. The choir and the clergy trooped out slowly, […], down the nave to the western door. […] At a seemingly immense distance the surpliced group stopped to say the last prayer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6c8142f1-2b19-3e83-affa-a5df015e3dd7",
                                        "entry_id": "2afe06c4-e560-329d-9aee-b94006e0fcc6",
                                        "glosses": [
                                            "The ground-level middle cavity of a barn."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "nave",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f43a2dd8-5ce5-33d5-8693-507c87cb1cd6",
                                        "entry_id": "935b1cdd-dfdf-385d-9e1d-dfdac9c19922",
                                        "glosses": [
                                            "A hub of a wheel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "22570d32-7dc6-49c4-8d36-2348a1f194d7",
                                                "sense_id": "f43a2dd8-5ce5-33d5-8693-507c87cb1cd6",
                                                "text": "'Out, out, thou strumpet Fortune! All you gods,\nIn general synod take away her power;\nBreak all the spokes and fellies from her wheel,\nAnd bowl the round nave down the hill of heaven[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c43983e2-fe3f-3518-82d8-694e8a015746",
                                        "entry_id": "935b1cdd-dfdf-385d-9e1d-dfdac9c19922",
                                        "glosses": [
                                            "The navel."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0aa3b706-6996-4c63-a160-5f24804e2819",
                                                "sense_id": "c43983e2-fe3f-3518-82d8-694e8a015746",
                                                "text": "Till he faced the slave; / Which ne'er shook hands, nor bade farewell to him, / Till he unseam'd him from the nave to the chaps, / And fix'd his head upon our battlements"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
