                    {
                        "form_id": "03a93048-2912-4742-b730-dd17c4cf7f7e",
                        "entry_id": "4719a509-54ef-3117-9f48-afc5d5429b0f",
                        "tags": [],
                        "form": "Yekke"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a133d7bf-425b-3419-9150-222445ee7de5",
                        "entry_id": "4719a509-54ef-3117-9f48-afc5d5429b0f",
                        "glosses": [
                            "Juif ashkénaze germanophone, originaire de l’Europe de l’Ouest."
                        ],
                        "tags": [
                            "Par plaisanterie"
                        ],
                        "examples": [
                            {
                                "example_id": "30f3a848-4297-4476-8023-c863a654a3c3",
                                "sense_id": "a133d7bf-425b-3419-9150-222445ee7de5",
                                "text": "Et à bien y regarder, un yekke, un litvak et un sfard ont peu de choses en commun. Bien sûr, il est de plus en plus difficile de rencontrer des incarnations authentiques de ces profils si typiques, tant les croisements sont multiples."
                            },
                            {
                                "example_id": "1b9a9310-1cc0-4740-ac6c-8a376ea9b4f8",
                                "sense_id": "a133d7bf-425b-3419-9150-222445ee7de5",
                                "text": "Mon père était d’origine yekke, et maman une yekke à titre honorifique. Là où mon père vivait dans le désordre le plus total, elle devenait une femme hyperorganisée."
                            },
                            {
                                "example_id": "dbdbf3ba-7ca6-4bae-a41e-8a64ae04bf78",
                                "sense_id": "a133d7bf-425b-3419-9150-222445ee7de5",
                                "text": "Après quelques jours passés à Tel-Aviv dans un petit hôtel « le San Remo » en face de la mer tenu par des yekkes, des juifs allemands, comme lui, chez qui il se sentait en famille, il louait une voiture avec chauffeur et se rendait à Jérusalem."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b590c282-5457-4030-8746-36bc0ceb16d3",
                        "source_entry_id": "4719a509-54ef-3117-9f48-afc5d5429b0f",
                        "source_sense_id": "a133d7bf-425b-3419-9150-222445ee7de5",
                        "target_lang_word": "Jecke",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Jecke",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a83af6e9-2aa7-3ed9-bfea-c999e61d6416",
                                        "entry_id": "dd5db8a8-acd1-3c80-914b-b68ce3b0b205",
                                        "glosses": [
                                            "Jude, der aus einem deutschsprachigen Land stammt und nach Palästina/Israel ausgewandert ist"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d8c71c4a-2cc4-4d64-849c-e00b8de5b8f5",
                                                "sense_id": "a83af6e9-2aa7-3ed9-bfea-c999e61d6416",
                                                "text": "„Auch gab es unter den Jeckes, also jenen aus Deutschland stammenden Juden, die sprachlich und kulturell ihrer einstigen Heimat verbunden geblieben waren, so manche, die sich bereitwillig auf einen Dialog mit diesen Besuchern einließen.“"
                                            },
                                            {
                                                "example_id": "b989b198-5453-4496-b5a1-ce66fe8156fa",
                                                "sense_id": "a83af6e9-2aa7-3ed9-bfea-c999e61d6416",
                                                "text": "„Da Du-nour keine Jeckin war und daher nie erleben konnte, welche Sprache Jeckes verwenden, wenn sie ganz unter sich sind, ging sie davon aus, dass Jeckes immer bewusst hebräische Begriffe einfließen lassen beziehungsweise Code-Switching praktizieren, um ihr jeckisches Deutsch vom Deutsch der heutigen Deutschen abzugrenzen.“"
                                            },
                                            {
                                                "example_id": "df3a335e-2b51-4be3-b0c7-c4a4310bc27c",
                                                "sense_id": "a83af6e9-2aa7-3ed9-bfea-c999e61d6416",
                                                "text": "„In Schwajim konnte man auf den ersten Blick das Zimmer eines Ostjuden vom Zimmer eines Jecken unterscheiden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
