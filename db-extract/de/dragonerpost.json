                "senses": [
                    {
                        "sense_id": "da608480-83cc-3b23-8d5a-739f88d43f8c",
                        "entry_id": "206c9da8-804d-3232-b6b3-9df01afa3dcf",
                        "glosses": [
                            "veraltet: Beförderung der Post anfänglich durch Dragoner"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c94ee06-dc95-4254-933a-f9267988f4a7",
                                "sense_id": "da608480-83cc-3b23-8d5a-739f88d43f8c",
                                "text": "„Die brandenburgische Dragonerpost war eine rein militärische Institution, die ganz überwiegend Regierungsdokumente und Diplomatenpost beförderte.“"
                            },
                            {
                                "example_id": "cee1aec7-60a0-400c-8b16-6dcf72433827",
                                "sense_id": "da608480-83cc-3b23-8d5a-739f88d43f8c",
                                "text": "„Ab 1616 existiert bereits eine Reitpost nach Königsberg, später auch Dragonerpost genannt.“"
                            },
                            {
                                "example_id": "2918cb62-08f7-40a3-948e-0d4ba8da80b5",
                                "sense_id": "da608480-83cc-3b23-8d5a-739f88d43f8c",
                                "text": "„Mit Edikt vom 14. April 1649 wird ein Postkurs eingerichtet, der von Kleve über Berlin, Danzig, die Frische Nehrung, Pillau, die Kurische Nehrung bis nach Memel führt, die sogenannte Reit- oder Dragonerpost.“"
                            },
                            {
                                "example_id": "a34999e1-728a-4eae-8b96-4bc9b8cb0f21",
                                "sense_id": "da608480-83cc-3b23-8d5a-739f88d43f8c",
                                "text": "„ Um 1785 fuhr zweimal wöchentlich eine Gesandtschaftspost die Poststrecke Berlin-Elsterwerda-Dresden-Wien, der sich später eine Dragonerpost und im 18. Jahrhundert eine Fahr- und Schnellpost zugesellte.“"
                            }
                        ],
