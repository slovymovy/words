                "senses": [
                    {
                        "sense_id": "9a4f39fb-7a30-3077-bb94-65712c7f61c6",
                        "entry_id": "9b8b3e06-7201-3c0a-b2b3-88b595902b50",
                        "glosses": [
                            "Donner un caractère employable à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ffcf4d4d-82e4-4922-96b7-5812c275466a",
                                "sense_id": "9a4f39fb-7a30-3077-bb94-65712c7f61c6",
                                "text": "Comment l'OCP veut «employabiliser» plus de 32.000 jeunes."
                            },
                            {
                                "example_id": "b22ddde3-dfd3-4746-b9e5-3b5913247d98",
                                "sense_id": "9a4f39fb-7a30-3077-bb94-65712c7f61c6",
                                "text": "Employabiliser un homme, ce n'est pas en faire un robot ou, comme dirait Descartes, un automate, une poupée agissante, un homme feint qui ne se remue que par un ressort ;"
                            },
                            {
                                "example_id": "ed579eea-a94f-41c9-a477-5825fdf895db",
                                "sense_id": "9a4f39fb-7a30-3077-bb94-65712c7f61c6",
                                "text": "Et elles existent telles quelles parce que les employeurs en ont décidé ainsi. A chaque précaire de s'« employabiliser », ou de se faire radier."
                            }
                        ]
                    }
