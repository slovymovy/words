                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bubon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ded3145c-9c7e-3522-90aa-d8d4f1f48229",
                                        "entry_id": "ef682b38-6276-3bd4-99b0-0fe5d4fa4df9",
                                        "glosses": [
                                            "Tumeur inflammatoire qui a son siège dans les glandes lymphatiques sous-cutanées et qui se forme plus particulièrement aux glandes de l’aine, de l’aisselle ou du cou."
                                        ],
                                        "tags": [
                                            "Nosologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "89d8d89d-0194-429f-b2b2-8bfca5a61a38",
                                                "sense_id": "ded3145c-9c7e-3522-90aa-d8d4f1f48229",
                                                "text": "– Il s’agit d’une fièvre à caractère typhoïde, mais accompagnée de bubons et de vomissements."
                                            },
                                            {
                                                "example_id": "f6df806e-eb04-43aa-893e-5cd356e2e593",
                                                "sense_id": "ded3145c-9c7e-3522-90aa-d8d4f1f48229",
                                                "text": "Bubon chancrelleux."
                                            },
                                            {
                                                "example_id": "fb3d529e-13ea-46fa-9e7f-18aa25898b3b",
                                                "sense_id": "ded3145c-9c7e-3522-90aa-d8d4f1f48229",
                                                "text": "Ce qui me blesse les yeux, quant à moi, vocifère Coselli, ce qui me blesse les yeux, c'est votre louche nombril, votre ombilic obscène, la peau de tambour moisie de votre bedaine, votre exhibitionnisme sénile, Géronte de la galonnaille, Ratapoil de fête nationale, bubon du chancre militaire."
                                            },
                                            {
                                                "example_id": "f77e5657-4f00-418c-8223-6dd1ae5eb4dc",
                                                "sense_id": "ded3145c-9c7e-3522-90aa-d8d4f1f48229",
                                                "text": "J’ai le claque-merde qui r’foule,\nEt du pelage dans les esgourdes,\nDes bubons sur les boules…"
                                            }
                                        ]
                                    }
                                ]
                            },
