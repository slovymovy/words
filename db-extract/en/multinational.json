                                        "glosses": [
                                            "Relatif à plus de deux nations."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "275780bc-b41c-4505-91a8-069b95a870af",
                                                "sense_id": "10a9bdc2-93ab-3a66-a55b-43d303dc781a",
                                                "text": "La victoire de l’Entente envers les Pouvoirs Centraux représenta la dernière phase dans la désintégration des empires multinationaux européens et euro-asiatiques (Autriche-Hongrie, Empire Ottoman, Empire Tsariste) et aboutit à des traités de paix qui changèrent dramatiquement les frontières de l’Europe centrale et Orientale."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
