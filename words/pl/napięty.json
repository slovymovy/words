    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b08b953c-f2e8-32bf-81b6-4c4d001bab99",
                    "sense_definition": "taki, który został mocno naciągnięty, pozbawiony luzu",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fizyczne",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Lina była tak mocno <w>napięta</w>, że w każdej chwili mogła pęknąć.",
                            "target_lang_translations": {
                                "fr": "La corde était si fort <w>tendue</w> qu'elle pouvait se rompre à tout moment."
                            }
                        },
                        {
                            "text": "Przez zbyt mocno <w>napięty</w> sznur żagiel nie chciał się rozwinąć.",
                            "target_lang_translations": {
                                "fr": "À cause de la corde trop <w>tendue</w>, la voile ne voulait pas se déployer."
                            }
                        }
                    ],
                    "common_phrases": [
                        "napięta lina",
                        "napięte mięśnie"
                    ],
                    "target_lang_definitions": {
                        "fr": "qui est fortement tiré, raidi ou dépourvu de mou"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "tendu",
                                "target_lang_sense_clarification": "corde, muscle, tissu"
                            },
                            {
                                "target_lang_word": "serré",
                                "target_lang_sense_clarification": "fortement attaché ou étiré"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c95cd895-74ef-3218-9798-93eb88983dc2",
                    "sense_definition": "o harmonogramie lub czasie: wypełniony wieloma zadaniami i trudny do zrealizowania",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "czas",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mam dzisiaj wyjątkowo <w>napięty</w> grafik i nie zdążę zjeść obiadu.",
                            "target_lang_translations": {
                                "fr": "J'ai un emploi du temps particulièrement <w>chargé</w> aujourd'hui et je n'aurai pas le temps de déjeuner."
                            }
                        },
                        {
                            "text": "Przez ten <w>napięty</w> plan zajęć nie mieliśmy nawet chwili na odpoczynek.",
                            "target_lang_translations": {
                                "fr": "En raison de ce planning <w>serré</w>, nous n'avons même pas eu un instant pour nous reposer."
                            }
                        }
                    ],
                    "common_phrases": [
                        "napięty grafik",
                        "napięty plan",
                        "napięty harmonogram"
                    ],
                    "target_lang_definitions": {
                        "fr": "en parlant d'un emploi du temps : très chargé et laissant peu de répit"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "chargé",
                                "target_lang_sense_clarification": "emploi du temps, programme"
                            },
                            {
                                "target_lang_word": "serré",
                                "target_lang_sense_clarification": "planning, délais"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ac3f0173-a834-376c-be2e-043130a4a030",
                    "sense_definition": "odczuwający silny stres lub zdenerwowanie",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emocje",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Przed egzaminem dyplomowym byłem bardzo <w>napięty</w> i nie mogłem spać.",
                            "target_lang_translations": {
                                "fr": "Avant l'examen de fin d'études, j'étais très <w>tendu</w> et je ne pouvais pas dormir."
                            }
                        },
                        {
                            "text": "Jej <w>napięty</w> wyraz twarzy zdradzał ogromny niepokój.",
                            "target_lang_translations": {
                                "fr": "Son expression <w>crispée</w> trahissait une grande inquiétude."
                            }
                        }
                    ],
                    "synonyms": [
                        "nerwowy",
                        "podminowany",
                        "spięty"
                    ],
                    "common_phrases": [
                        "napięty wyraz twarzy"
                    ],
                    "target_lang_definitions": {
                        "fr": "qui ressent un fort stress, de l'énervement ou de l'anxiété"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "tendu",
                                "target_lang_sense_clarification": "personne, expression du visage"
                            },
                            {
                                "target_lang_word": "crispé",
                                "target_lang_sense_clarification": "par le stress ou l'anxiété"
                            },
                            {
                                "target_lang_word": "nerveux",
                                "target_lang_sense_clarification": "agité ou inquiet"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "844bb606-38b2-30ba-8882-1dfbe4031eac",
                    "sense_definition": "pełen wrogości, konfliktów lub niepewności; grożący kłótnią lub starciem",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "relacje",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W pokoju panowała <w>napięta</w> atmosfera po burzliwej rozmowie dyrektorów.",
                            "target_lang_translations": {
                                "fr": "Une atmosphère <w>tendue</w> régnait dans la pièce après l'échange houleux entre les directeurs."
                            }
                        },
                        {
                            "text": "Między sąsiednimi państwami od wielu lat panują bardzo <w>napięte</w> stosunki dyplomatyczne.",
                            "target_lang_translations": {
                                "fr": "Entre les pays voisins règnent depuis de nombreuses années des relations diplomatiques très <w>tendues</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "nerwowy"
                    ],
                    "common_phrases": [
                        "napięta atmosfera",
                        "napięta sytuacja",
                        "napięte stosunki"
                    ],
                    "target_lang_definitions": {
                        "fr": "caractérisé par des conflits, de l'hostilité ou un risque d'affrontement"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "tendu",
                                "target_lang_sense_clarification": "atmosphère, relations, situation"
                            },
                            {
                                "target_lang_word": "houleux",
                                "target_lang_sense_clarification": "ambiance conflictuelle"
                            }
                        ]
                    }
                }
            ]
        },
