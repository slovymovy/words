                "senses": [
                    {
                        "sense_id": "173f083b-d756-3208-b8f2-a4ab121bbcc8",
                        "entry_id": "cb3b364a-0ddf-3e24-89be-bb79929fc5a7",
                        "glosses": [
                            "The process or state of disembodying."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "5b18b4b8-5342-4a0e-8446-e8d85a09b6a8",
                                "sense_id": "173f083b-d756-3208-b8f2-a4ab121bbcc8",
                                "text": "His way of ignoring people whose presence inconvenienced him actually gave them, if they were sensitive to it, a feeling of invisibility, of nonexistence. Archer, as the three strolled back through the park, was aware of this odd sense of disembodiment; […]"
                            },
                            {
                                "example_id": "01c40a8d-a79a-48c4-bf4c-ea7ea6f1a504",
                                "sense_id": "173f083b-d756-3208-b8f2-a4ab121bbcc8",
                                "text": "Those groggy, stumbling beats, for a start (K has long been infamous on the US rave scene as an anti-dance drug, a chemical that killed rave energy), not to mention wonky's combination of intense physicality (that w-w-w-wobbly bass) with a sensation of disembodiment."
                            },
                            {
                                "example_id": "ba42b162-541f-40f0-8683-fc17931603f4",
                                "sense_id": "173f083b-d756-3208-b8f2-a4ab121bbcc8",
                                "text": "[…] is giving military analysts an opportunity to review the mixed history of a weapon that has long been associated with low-cost war, a sense of disembodiment from conflict, and for inflicting a high number of civilian casualties."
                            }
                        ]
                    },
                    {
                        "sense_id": "e55de8e4-4698-3d96-836f-68431ca5b1a9",
                        "entry_id": "cb3b364a-0ddf-3e24-89be-bb79929fc5a7",
                        "glosses": [
                            "A soul, spirit, or consciousness that has been disembodied, or which otherwise lacks a physical form."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cd500db0-7d5b-4151-bb8d-4b6b3b75b912",
                        "source_entry_id": "cb3b364a-0ddf-3e24-89be-bb79929fc5a7",
                        "source_sense_description": "spirit that lacks a physical form",
                        "target_lang_word": "Entkörperlichung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Entkörperlichung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b19a9805-a808-37f0-9720-3097ede0b046",
                                        "entry_id": "f3a54208-f1f7-32fb-8ce9-6dd6959ca5df",
                                        "glosses": [
                                            "Ausblendung der räumlichen/dreidimensionalen Existenz in Form des Körpers; Verschwinden derjenigen Aspekte, die mit dem Körperlichen/real Existierenden zu tun haben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64d2281e-4faf-4f36-bdcd-d405851e33b3",
                                                "sense_id": "b19a9805-a808-37f0-9720-3097ede0b046",
                                                "text": "„Auf eine zentrale Leerstelle verweisen zudem jene Einwände, die eine Entkörperlichung des Alters monieren.“"
                                            },
                                            {
                                                "example_id": "bbf46a17-0e1f-4738-b701-df78fa012817",
                                                "sense_id": "b19a9805-a808-37f0-9720-3097ede0b046",
                                                "text": "„Der Prozess der Entkörperlichung metaphysischer Wesen war ein Annäherungsprozess, der – wie eine konvergierende Zahlenfolge – einem Grenzwert zustrebte.“"
                                            },
                                            {
                                                "example_id": "7408cfdd-442b-4457-b8c3-24074f9f5acc",
                                                "sense_id": "b19a9805-a808-37f0-9720-3097ede0b046",
                                                "text": "„Die meisten von uns hatten irgendwann Erfahrungen, die in einem gewissen Maß eine Entkörperlichung unseres Selbst verursachten.“"
                                            },
                                            {
                                                "example_id": "e5dbb8a0-bd97-4b2e-9c15-222da484e087",
                                                "sense_id": "b19a9805-a808-37f0-9720-3097ede0b046",
                                                "text": "„Die Entkörperlichung des Menschen ist ein langsamer Vorgang, der längst nicht abgeschlossen ist und beide Geschlechter betrifft.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
