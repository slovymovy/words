                    "frequency": "Low",
                    "semantic_group_id": "vehicle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wealthy gentleman drove through the town in his open <w>phaeton</w>.",
                            "target_lang_translations": {
                                "de": "Der wohlhabende Herr fuhr in seinem offenen <w>Phaeton</w> durch die Stadt."
                            }
                        },
                        {
                            "text": "They decided to ride a <w>phaeton</w> along the country road during the sunny afternoon.",
                            "target_lang_translations": {
                                "de": "Sie beschlossen, an dem sonnigen Nachmittag in einem <w>Phaeton</w> die Landstraße entlangzufahren."
                            }
