                                        "glosses": [
                                            "Brin mince en coton ou synthétique destiné à l’hygiène buccodentaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10709dd1-5c38-4c68-969a-eb966d945ec8",
                                                "sense_id": "f63f62f7-bc3e-3a10-9672-747d441d98c7",
                                                "text": "En passant le fil dentaire entre les dents, un nettoyage plus direct de la surface qui se trouve sous la gencive et entre chacune des dents est possible."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "011ba0ae-d133-3890-a95f-c924d08841c6",
