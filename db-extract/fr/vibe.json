                                    {
                                        "sense_id": "bef8e0f0-af28-3481-93e7-708f08971655",
                                        "entry_id": "4fc3cbf0-d200-3274-a600-c097dd4955f2",
                                        "glosses": [
                                            "To get along; to hit it off."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a2251f4a-a653-4f15-93bb-21250272ea8c",
                                                "sense_id": "bef8e0f0-af28-3481-93e7-708f08971655",
                                                "text": "Sam started out being someone I totally vibed with on every level."
                                            },
                                            {
                                                "example_id": "4ad7fa0f-520a-46b4-b7af-ebcd65404d75",
                                                "sense_id": "bef8e0f0-af28-3481-93e7-708f08971655",
                                                "text": "Nervous and shaky but feigning confidence, I completed the interview with ease and even managed to vibe with the country cutie."
                                            },
                                            {
                                                "example_id": "424ac312-c1da-4ac5-8e11-6f21930f4ee3",
                                                "sense_id": "bef8e0f0-af28-3481-93e7-708f08971655",
                                                "text": "It was odd, because there was always one person I didn't vibe with in every office I spent time in, sometimes multiple people like in the case with Amazon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5fbe297b-bf30-3d6b-a961-1e851b64187e",
                                        "entry_id": "4fc3cbf0-d200-3274-a600-c097dd4955f2",
                                        "glosses": [
                                            "To feel in agreement with; to appreciate or enjoy."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9d55a3de-54d2-4559-92e7-6e7af17b6767",
                                                "sense_id": "5fbe297b-bf30-3d6b-a961-1e851b64187e",
                                                "text": "Nia was glad she'd let Rico bring her to the club as she vibed with the fusion of Latin sounds and American hip-hop."
                                            },
                                            {
                                                "example_id": "1756bd8e-7923-4b31-8276-e69e285a4b98",
                                                "sense_id": "5fbe297b-bf30-3d6b-a961-1e851b64187e",
                                                "text": "He was quoting scriptures and stuff from the bible to me and I actually was vibing it, but I know I'm not down with the whole church thing […]"
                                            }
