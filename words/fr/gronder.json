                },
                {
                    "sense_id": "be149c02-72f4-3aee-9e5e-93a7f5167bc6",
                    "sense_definition": "Émettre un son sourd, menaçant et continu, en parlant d'un animal ou d'éléments naturels.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "bruit_sourd",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Au loin, le tonnerre commence à <w>gronder</w> derrière les montagnes sombres.",
                            "target_lang_translations": {
                                "en": "In the distance, thunder begins to <w>rumble</w> behind the dark mountains.",
                                "de": "In der Ferne beginnt der Donner hinter den dunklen Bergen zu <w>grollen</w>.",
                                "es": "A lo lejos, el trueno empieza a <w>retumbar</w> tras las montañas oscuras.",
                                "zh": "远处，雷声开始在黑压压的群山后面<w>轰鸣</w>。",
                                "ru": "Вдали, за тёмными горами, начинает <w>громыхать</w> гром."
                            }
                        },
                        {
                            "text": "Le chien s'est mis à <w>gronder</w> dès qu'un inconnu a franchi le portail.",
                            "target_lang_translations": {
                                "en": "The dog began to <w>growl</w> as soon as a stranger came through the gate.",
                                "de": "Der Hund fing an zu <w>knurren</w>, sobald ein Fremder das Tor passiert hatte.",
                                "es": "El perro se puso a <w>gruñir</w> en cuanto un desconocido cruzó el portón.",
                                "zh": "陌生人一走进大门，狗就开始<w>低吼</w>起来。",
                                "ru": "Собака начала <w>рычать</w>, как только незнакомец прошёл через ворота."
                            }
                        }
                    ],
                    "synonyms": [
                        "tonner"
                    ],
                    "common_phrases": [
                        "orage qui gronde"
                    ],
                    "target_lang_definitions": {
                        "en": "To make a low, continuous, threatening sound, said of animals or natural forces.",
                        "de": "Ein tiefes, anhaltendes und bedrohlich klingendes Geräusch von sich geben, etwa bei Tieren oder Naturgewalten.",
                        "es": "Emitir un sonido grave, amenazante y continuo, propio de animales o fenómenos naturales.",
                        "zh": "发出低沉、持续而令人感到威胁的声音，多指动物或雷声等自然现象。",
                        "ru": "Издавать низкий, продолжительный и угрожающий звук, о животных или явлениях природы."
                    },
                    "translations": {
