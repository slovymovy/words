        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f63fa906-597a-3bdc-9fcd-677ba797352f",
                    "sense_definition": "To shorten or abridge the duration of something.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "shorten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The speaker decided to <w>curtail</w> her speech when the audience started to look bored."
                        },
                        {
                            "text": "Heavy rain forced the organizers to <w>curtail</w> the outdoor concert."
                        }
                    ],
                    "synonyms": [
                        "abbreviate",
                        "shorten"
                    ],
                    "common_phrases": [
                        "curtail a speech",
                        "curtail a visit"
                    ]
                },
                {
