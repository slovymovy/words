                "senses": [
                    {
                        "sense_id": "5281b950-d5c1-341b-8ea1-00fcbe627b3d",
                        "entry_id": "2d4f14d1-451d-3d19-be1f-b079a8636f4a",
                        "glosses": [
                            "Donner un caractère autochtone à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "931f11cf-dd02-4e96-9f82-d6cd7a06fece",
                                "sense_id": "5281b950-d5c1-341b-8ea1-00fcbe627b3d",
                                "text": "Déjà, il a « autochtonisé » La Fontaine."
                            },
                            {
                                "example_id": "bca0a972-430f-4894-8efb-db777ad91212",
                                "sense_id": "5281b950-d5c1-341b-8ea1-00fcbe627b3d",
                                "text": "Autochtoniser l’État et la société."
                            },
                            {
                                "example_id": "9ba0d4b0-6885-4c18-8bf6-4b645defa67b",
                                "sense_id": "5281b950-d5c1-341b-8ea1-00fcbe627b3d",
                                "text": "La gestion de cette situation complexe, dans le cadre légal et démocratique et l’espace de droit qu’offrent les espaces nationaux européens et où l’intérêt communautaire, l’intérêt national et l’appréciation d’événements politiques internationaux s’imbriquent a plutôt permis à l’islam européen de “s’autochtoniser” progressivement, mais sûrement, en se moulant dans les formes d’expression politiques occidentales."
                            }
                        ]
                    }
