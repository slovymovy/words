                "senses": [
                    {
                        "sense_id": "77b2a764-dde1-39fc-805d-e2a3bf4fbbf7",
                        "entry_id": "52c73bc9-e5f4-3efb-bf00-8562948179de",
                        "glosses": [
                            "Mal édifier, donner le mauvais exemple."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "d59c2106-6720-487d-8658-691941ca4aad",
                                "sense_id": "77b2a764-dde1-39fc-805d-e2a3bf4fbbf7",
                                "text": "Qu’un ministre de la religion vienne à malédifier par quelque défaut : on jugera que tous les autres lui ressemblent."
                            },
                            {
                                "example_id": "0779dd70-93b6-4747-a949-1573e44a1840",
                                "sense_id": "77b2a764-dde1-39fc-805d-e2a3bf4fbbf7",
                                "text": "Mais, dit-on, c’est une foiblesse d’esprit que de se malédifier, en voyant une personne habillée en Amazone ;"
                            }
                        ]
                    }
