                },
                {
                    "sense_id": "c97e4e19-dbbd-3fea-84de-f989f8683775",
                    "sense_definition": "zyskiwać, dostrzegać lub odzyskiwać stan psychiczny, wartość lub sens",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "finding_abstract",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Po wielu trudnych miesiącach wreszcie <w>odnajduję</w> spokój w codziennym życiu.",
                            "target_lang_translations": {
                                "en": "After many difficult months, I am finally <w>finding</w> peace in everyday life."
                            }
                        },
                        {
                            "text": "Wielu artystów <w>odnajduje</w> sens istnienia dopiero w twórczości.",
                            "target_lang_translations": {
                                "en": "Many artists <w>find</w> the meaning of existence only in creativity."
                            }
                        }
                    ],
                    "common_phrases": [
                        "odnajdywać spokój",
                        "odnajdywać sens",
                        "odnajdywać szczęście"
                    ],
                    "target_lang_definitions": {
                        "en": "to gain, perceive, or regain a mental state, value, or meaning"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "find",
                                "target_lang_sense_clarification": "such as peace, purpose, or happiness"
                            },
                            {
                                "target_lang_word": "rediscover",
                                "target_lang_sense_clarification": "to regain a lost feeling or perspective"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a35e2747-4be6-30fa-991c-b7d526d4e119",
                    "sense_definition": "ustalać położenie kogoś lub czegoś w wyniku poszukiwań lub obserwacji",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "finding_physical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Radar bez trudu <w>odnajduje</w> zagubione na morzu małe łodzie.",
                            "target_lang_translations": {
                                "en": "The radar easily <w>locates</w> small boats lost at sea."
                            }
                        },
                        {
                            "text": "Ratownicy powoli <w>odnajdują</w> turystów, którzy zeszli ze szlaku w gęstej mgle.",
                            "target_lang_translations": {
                                "en": "Rescuers are slowly <w>finding</w> the hikers who strayed from the trail in dense fog."
                            }
                        }
                    ],
                    "synonyms": [
                        "namierzać",
                        "lokalizować"
                    ],
                    "common_phrases": [
                        "odnajdywać drogę"
                    ],
                    "target_lang_definitions": {
                        "en": "to locate or determine the position of someone or something through search or tracking"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "locate",
