                                        "sense_id": "38926599-f156-31ab-bfab-31970a4ff239",
                                        "entry_id": "dd21ecf3-d576-327b-98c3-f729855d2803",
                                        "glosses": [
                                            "город в Греции, административный центр области (периферии) Центральная Македония"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "806644d8-1f61-4634-8cec-085b5921f6c4",
                                                "sense_id": "38926599-f156-31ab-bfab-31970a4ff239",
                                                "text": "Греция пока считалась нейтральной, а древние Салоники поминались на Руси как родина Кирилла и Мефодия, наших славянских первоучителей."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5e7806bb-a3a8-44c8-96b9-f722ec21f3e8",
                        "source_entry_id": "93320183-9128-3b7d-9e3e-388b61ebce06",
                        "target_lang_word": "Солунь",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Солунь",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "bd6c5a10-0aa8-3081-9071-92e682fb29fe",
                                        "entry_id": "3bda05fe-6155-3172-b5b1-21f71270d01e",
                                        "glosses": [
                                            "истор. старое русское название греческого города Салоники"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f68c3f46-482a-4c6c-a413-cd1eedff0500",
                                                "sense_id": "bd6c5a10-0aa8-3081-9071-92e682fb29fe",
                                                "text": "Итак, убоясь и рассуждая, что идет с преизбранным воинством, которое от Иустиниана императора против короля Тотилы и против готов послано, предприятый путь к Солуню прекратили и, не смея больше выступить в поле, перешли все иллирические горы и без опасности вступили в Далмацию."
                                            },
                                            {
                                                "example_id": "abb28644-fb3b-4eaa-9c75-6bae85bd4d67",
                                                "sense_id": "bd6c5a10-0aa8-3081-9071-92e682fb29fe",
                                                "text": "Прочие же части государства, как напр., Пелопоннес, Солунь, некоторые отдельные города во Фракии, находились в управлении его братьев в виде отдельных княжеств, почти совершенно независимых уделов."
                                            },
                                            {
                                                "example_id": "64cca15a-34a0-4f8f-8442-97d53e1e90ea",
                                                "sense_id": "bd6c5a10-0aa8-3081-9071-92e682fb29fe",
                                                "text": "Кирилл принял за основу для этого литературного языка говор солунских славян, по-видимому, только потому, что сам был родом из Солуни и практически владел именно этим говором."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d0226b4b-0956-4278-b117-54aa92b6759b",
                        "source_entry_id": "93320183-9128-3b7d-9e3e-388b61ebce06",
