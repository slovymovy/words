                        "examples": [
                            {
                                "example_id": "a6d61932-907d-460c-88de-a55b2f4f5f09",
                                "sense_id": "62f67b12-f101-363a-9e3b-2bbd3a1df58c",
                                "text": "De pasgeboren baby werd dinsdag ontdekt in een afvoerpijp onder een hurktoilet in de gedeelde wc-ruimte van een flat. De brandweer sneed de rioolpijp los en bracht de buis met de baby erin naar het ziekenhuis."
                            },
                            {
                                "example_id": "85648ae0-840f-4e6c-87d0-13337865ac88",
                                "sense_id": "62f67b12-f101-363a-9e3b-2bbd3a1df58c",
                                "text": "\"Hij draagt een paarse overall, hij slaapt op een houten vlonder, hij moet zijn behoefte doen op een hurktoilet zonder wc papier\", zegt Linda. \"Toen hij één telefoontje mocht plegen, belde hij me met handboeien om.\""
                            }
