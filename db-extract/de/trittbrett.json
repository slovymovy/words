                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "treeplank",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "4744adde-d979-3693-86e8-b0e6e7156b72",
                                        "entry_id": "3e3b5737-c40b-3fc0-99ed-4656a05805ab",
                                        "glosses": [
                                            "houten of metalen plank aan de zijkant van een auto, bus, tram of trein die passagiers gebruiken bij het in- en uitstappen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b02db9d-8c14-4273-a05c-68889edf83f7",
                                                "sense_id": "4744adde-d979-3693-86e8-b0e6e7156b72",
                                                "text": "Pas op bij uitstappen! Soms ligt het perron een centimeter of 80 lager dan de treeplank, waardoor er een heuse klauterpartij nodig is bij het in- en uitstappen."
                                            },
                                            {
                                                "example_id": "022b4e96-579b-403b-b2f6-df110823b18d",
                                                "sense_id": "4744adde-d979-3693-86e8-b0e6e7156b72",
                                                "text": "Connexxion heeft alle honderd bussen uitgerust met een rolstroelvriendelijke treeplank. De uitklapare plank is dankzij een gasveer in een handomdraai klaar voor gebruik. Tot dusver was de reiziger in een rolstoel afhankelijk van de goedwillendheid van chauffeur of passagiers."
                                            },
                                            {
                                                "example_id": "151e2bfc-1b71-473c-82d0-c5bcc44436a1",
                                                "sense_id": "4744adde-d979-3693-86e8-b0e6e7156b72",
                                                "text": "Een krap bij kas zittende Nederlander heeft geprobeerd om op de treeplank van een locomotief terug te reizen van Berlijn naar Amsterdam. Politiewoordvoerder Martin Ackert uit Hannover vertelt aan AD.nl dat de 'verstekeling' zich goed voorbereid had op de illegale rit."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
