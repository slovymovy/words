                                "target_lang_sense_clarification": "погода, климат"
                            },
                            {
                                "target_lang_word": "теплеть",
                                "target_lang_sense_clarification": "температура после холодов"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "milder werden",
                                "target_lang_sense_clarification": "Wetter nach Kälteperiode"
                            },
                            {
                                "target_lang_word": "sich mildern",
                                "target_lang_sense_clarification": "Frost, Kälte, Witterung"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "templarse",
                                "target_lang_sense_clarification": "clima tras un periodo frío"
                            },
                            {
                                "target_lang_word": "suavizarse",
                                "target_lang_sense_clarification": "clima o temperatura"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "回暖",
                                "target_lang_sense_clarification": "寒冷后气温回升"
                            },
                            {
                                "target_lang_word": "转暖",
                                "target_lang_sense_clarification": "天气或气温由冷转暖"
                            }
                        ]
