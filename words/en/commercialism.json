{
    "word_family": [
        "commerce",
        "commercial",
        "commercialist",
        "commercialize",
        "commercialization",
        "commercially"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "efa4af8d-09b6-3bed-9490-c88f8bf8f468",
                    "sense_definition": "An excessive focus on making profit, often at the expense of artistic, cultural, or moral values.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "commercialism_concept",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many people complain about the rampant <w>commercialism</w> surrounding the Christmas holidays.",
                            "target_lang_translations": {
                                "tr": "Birçok insan, Noel tatilini saran aşırı <w>ticarileşmeden</w> şikâyet ediyor."
                            }
                        },
                        {
                            "text": "The band refused to sign with a major label to avoid gross <w>commercialism</w>.",
                            "target_lang_translations": {
                                "tr": "Grup, aşırı <w>ticari zihniyetten</w> kaçınmak için büyük bir plak şirketiyle anlaşma imzalamayı reddetti."
                            }
                        }
                    ],
                    "synonyms": [
                        "mercenariness",
                        "materialism"
                    ],
                    "common_phrases": [
                        "rampant commercialism",
                        "crass commercialism",
                        "gross commercialism"
                    ],
                    "target_lang_definitions": {
                        "tr": "Sanatsal, kültürel veya ahlaki değerler pahasına, aşırı kâr ve kazanç odaklı olma durumu."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "ticarileşme",
                                "target_lang_sense_clarification": "her şeyin kâr amacıyla alınıp satılır hale gelmesi"
                            },
                            {
                                "target_lang_word": "ticari zihniyet",
                                "target_lang_sense_clarification": "her şeye yalnızca para ve kazanç gözüyle bakma tutumu"
                            },
                            {
                                "target_lang_word": "maddecilik",
                                "target_lang_sense_clarification": "kâr ve maddi çıkar odaklılık"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b6618031-819f-3c4b-85bc-17c8a2c7ad2e",
                    "sense_definition": "The practices, principles, and methods associated with commerce and business.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "commercialism_concept",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rapid expansion of global <w>commercialism</w> transformed the local economy.",
                            "target_lang_translations": {
                                "tr": "Küresel <w>ticaretçiliğin</w> hızlı genişlemesi yerel ekonomiyi dönüştürdü."
                            }
                        },
                        {
                            "text": "He studied the principles of modern <w>commercialism</w> during his business degree.",
                            "target_lang_translations": {
                                "tr": "İşletme eğitimi sırasında modern <w>ticaret sisteminin</w> ilkelerini inceledi."
                            }
                        }
                    ],
                    "synonyms": [
                        "business",
                        "mercantilism"
                    ],
                    "common_phrases": [
                        "modern commercialism",
                        "global commercialism"
                    ],
                    "target_lang_definitions": {
                        "tr": "Ticaret ve iş dünyası ile ilişkili ilke, yöntem ve uygulamaların tümü."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "ticaretçilik",
                                "target_lang_sense_clarification": "ticari ilkeler ve yöntemler bütünü"
                            },
                            {
                                "target_lang_word": "ticaret sistemi",
                                "target_lang_sense_clarification": "iş ve ticaret dünyasının işleyişi"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}