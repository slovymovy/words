{
    "word_family": [
        "сад",
        "сидеть",
        "сиденье",
        "сидячий",
        "посадка",
        "осадка"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bbeaf027-b2cd-31e7-8c5e-622bbb9f0a8e",
                    "sense_definition": "Опускаться на стул или другую опору, принимая положение сидя.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "position",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Гость вежливо попросил разрешения <w>садиться</w> на свободный стул.",
                            "target_lang_translations": {
                                "en": "The guest politely asked for permission to <w>sit down</w> on the empty chair."
                            }
                        },
                        {
                            "text": "Усталый путник решил <w>садиться</w> на скамейку в парке.",
                            "target_lang_translations": {
                                "en": "The tired traveler decided to <w>sit down</w> on a park bench."
                            }
                        }
                    ],
                    "antonyms": [
                        "вставать",
                        "подниматься"
                    ],
                    "common_phrases": [
                        "садиться на стул",
                        "садиться за стол"
                    ],
                    "target_lang_definitions": {
                        "en": "To lower oneself onto a chair or other support, assuming a sitting position."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sit down",
                                "target_lang_sense_clarification": "To assume a sitting position from a standing position."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ca04d47c-bf91-3a37-b48f-762229cf0c0b",
                    "sense_definition": "Заходить в транспортное средство для поездки.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "transport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Пассажиры начинают <w>садиться</w> в поезд за десять минут до отправления.",
                            "target_lang_translations": {
                                "en": "Passengers begin to <w>board</w> the train ten minutes before departure."
                            }
                        },
                        {
                            "text": "Нам нужно быстрее <w>садиться</w> в автобус, чтобы не опоздать.",
                            "target_lang_translations": {
                                "en": "We need to <w>get on</w> the bus faster so we don't miss it."
                            }
                        }
                    ],
                    "antonyms": [
                        "выходить"
                    ],
                    "common_phrases": [
                        "садиться в автобус",
                        "садиться на поезд"
                    ],
                    "target_lang_definitions": {
                        "en": "To enter a vehicle for the purpose of traveling."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "board",
                                "target_lang_sense_clarification": "To step or climb onto a ship, aircraft, or train."
                            },
                            {
                                "target_lang_word": "get on",
                                "target_lang_sense_clarification": "To board or mount a vehicle."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a893bf5c-dc37-3a3c-82e1-c83e6ede2908",
                    "sense_definition": "Приземляться, заканчивать полёт, опускаясь на землю.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "flight",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Пилот начал <w>садиться</w> на взлетную полосу в сложных погодных условиях.",
                            "target_lang_translations": {
                                "en": "The pilot began to <w>land</w> on the runway in difficult weather conditions."
                            }
                        },
                        {
                            "text": "Самолет должен <w>садиться</w> в аэропорту через полчаса.",
                            "target_lang_translations": {
                                "en": "The plane is scheduled to <w>land</w> at the airport in half an hour."
                            }
                        }
                    ],
                    "antonyms": [
                        "подниматься"
                    ],
                    "common_phrases": [
                        "садиться на землю"
                    ],
                    "target_lang_definitions": {
                        "en": "To land, to finish a flight by descending to the ground."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "land",
                                "target_lang_sense_clarification": "To descend to a surface, especially from the air."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c71fe6ed-87eb-3ebc-b816-9d2eb301002c",
                    "sense_definition": "О небесных телах: заходить, уходить за горизонт.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "nature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Летом солнце начинает <w>садиться</w> очень поздно вечером.",
                            "target_lang_translations": {
                                "en": "In the summer, the sun begins to <w>set</w> very late in the evening."
                            }
                        },
                        {
                            "text": "Мы наблюдали, как ярко-красное солнце медленно <w>садится</w> за горизонт.",
                            "target_lang_translations": {
                                "en": "We watched as the bright red sun slowly <w>set</w> below the horizon."
                            }
                        }
                    ],
                    "antonyms": [
                        "подниматься"
                    ],
                    "common_phrases": [
                        "солнце садится"
                    ],
                    "target_lang_definitions": {
                        "en": "Regarding celestial bodies: to set, to disappear below the horizon."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "set",
                                "target_lang_sense_clarification": "To go down below the horizon."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f0abf91e-3ab3-300b-866f-f94ba6b5ac37",
                    "sense_definition": "Терять силу, мощность или заряд.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "decline",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мой телефон начал <w>садиться</w> в самый неподходящий момент.",
                            "target_lang_translations": {
                                "en": "My phone started to <w>run down</w> at the most inconvenient moment."
                            }
                        },
                        {
                            "text": "От долгого крика голос певца стал <w>садиться</w>.",
                            "target_lang_translations": {
                                "en": "From shouting for so long, the singer's voice began to <w>drain</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "батарейка садится",
                        "голос садится"
                    ],
                    "target_lang_definitions": {
                        "en": "To lose strength, power, or charge."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "drain",
                                "target_lang_sense_clarification": "To deplete of energy or resources."
                            },
                            {
                                "target_lang_word": "run down",
                                "target_lang_sense_clarification": "To lose power or charge (of a battery)."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "36237816-51d5-35bc-8e11-b45886e753f5",
                    "sense_definition": "Приниматься за какое-либо длительное дело или занятие.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "work",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Студенту пора <w>садиться</w> за учебники перед важным экзаменом.",
                            "target_lang_translations": {
                                "en": "It is time for the student to <w>sit down to</w> their textbooks before an important exam."
                            }
                        },
                        {
                            "text": "Писатель решил <w>садиться</w> за новую книгу сразу после отпуска.",
                            "target_lang_translations": {
                                "en": "The writer decided to <w>get down to</w> a new book right after their vacation."
                            }
                        }
                    ],
                    "common_phrases": [
                        "садиться за работу",
                        "садиться за уроки"
                    ],
                    "target_lang_definitions": {
                        "en": "To begin a long-term task or activity."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sit down to",
                                "target_lang_sense_clarification": "To begin a task, often involving sitting."
                            },
                            {
                                "target_lang_word": "get down to",
                                "target_lang_sense_clarification": "To start doing something seriously."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "19166356-8b19-380c-9060-1cb0ee2892ca",
                    "sense_definition": "Получать наказание в виде лишения свободы.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "law",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Преступник знал, что за такое ограбление ему придется <w>садиться</w> в тюрьму.",
                            "target_lang_translations": {
                                "en": "The criminal knew that for such a robbery, he would have to <w>go to prison</w>."
                            }
                        },
                        {
                            "text": "Многие мошенники боятся <w>садиться</w> за свои незаконные действия.",
                            "target_lang_translations": {
                                "en": "Many scammers are afraid of <w>being jailed</w> for their illegal actions."
                            }
                        }
                    ],
                    "common_phrases": [
                        "садиться в тюрьму"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорный стиль"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To receive a punishment of imprisonment."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "go to prison",
                                "target_lang_sense_clarification": "To be sent to jail as a punishment."
                            },
                            {
                                "target_lang_word": "be jailed",
                                "target_lang_sense_clarification": "To be put into prison."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}