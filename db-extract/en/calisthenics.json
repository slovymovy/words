                        ]
                    },
                    {
                        "translation_id": "ec0ee6f2-7515-4708-a721-6159d0fa57d2",
                        "source_entry_id": "02b95967-d63e-3b3e-8e45-2dc2dbd4cb0f",
                        "source_sense_description": "type of exercise",
                        "target_lang_word": "ворка́ут",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ворка́ут",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "687529e8-4e6f-363a-a226-68a5362ccac8",
                                        "entry_id": "492aea34-1e4e-3e84-ba84-014148c3ef79",
                                        "glosses": [
                                            "любительский вид спорта, разновидность гимнастики, включающая в себя выполнение различных упражнений на уличных спортивных площадках"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "737d3a17-0f1c-4f90-a105-3aaa81bb74fd",
                                                "sense_id": "687529e8-4e6f-363a-a226-68a5362ccac8",
                                                "text": "В шахтинском посёлке Артёма состоялось открытие первой в городе площадки для воркаута — места для занятия физической подготовкой на открытом воздухе, где в качестве снарядов и тренажёров используются брусья и перекладины. Этот вид спорта в последнее время становится всё популярнее в молодёжной среде."
                                            },
                                            {
                                                "example_id": "50908a00-f6e2-4b8d-8e53-5dc53b897e48",
                                                "sense_id": "687529e8-4e6f-363a-a226-68a5362ccac8",
                                                "text": "Призёр российских соревнований по воркауту и постоянный судья областных Евгений Кровяков уверен, что каждому по силам заниматься спортом и постепенно развиваться. Сам он вот уже четвёртый год выделывает немыслимые трюки на перекладине, называя это своеобразной гимнастикой."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63819e95-ca0f-3d17-a96b-bb8c7fc1a278",
                                        "entry_id": "492aea34-1e4e-3e84-ba84-014148c3ef79",
                                        "glosses": [
                                            "спортивная площадка для занятий такой гимнастикой"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa4c24aa-efb7-403d-828d-38d28bf64450",
                                                "sense_id": "63819e95-ca0f-3d17-a96b-bb8c7fc1a278",
                                                "text": "В этом году в округе построено семь скверов, в пяти из них расположены воркауты."
                                            },
                                            {
                                                "example_id": "eb31a3d6-1890-4f6f-badc-657d6880c819",
                                                "sense_id": "63819e95-ca0f-3d17-a96b-bb8c7fc1a278",
                                                "text": "Мы решили спросить горожан, нужны ли им подобные комплексы и где, по мнению людей, лучше их разместить. Глазовчане положительно высказались за воркауты."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "560b02b3-5b1b-4294-8f53-0ce7805aba11",
                        "source_entry_id": "02b95967-d63e-3b3e-8e45-2dc2dbd4cb0f",
