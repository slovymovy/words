                            {
                                "example_id": "34905f63-515c-4a0d-9dcf-90e747a974c4",
                                "sense_id": "d7b94959-4427-3ddb-9e5c-57da8e1f8455",
                                "text": "Paleozoik dzieli się na sześć okresów: kambr, ordowik, sylur, dewon, karbon i perm."
                            }
