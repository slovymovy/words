            {
                "entry_id": "d80b2159-1fa5-3990-b301-f3149490f24c",
                "word": "Plaisance",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "4205f48c-aae8-3e6a-b662-6f1c775727e4",
                        "entry_id": "d80b2159-1fa5-3990-b301-f3149490f24c",
                        "glosses": [
                            "Commune et ville de la région d’Émilie-Romagne en Italie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c625eeda-0e92-4102-ba77-dcd5143bee08",
                                "sense_id": "4205f48c-aae8-3e6a-b662-6f1c775727e4",
                                "text": "Entre Gênes et Milan, sur le fleuve Pô, il y a Plaisance. Piacenza."
                            },
                            {
                                "example_id": "0abf6dd2-00c3-4d8b-b55a-a87b7980c573",
                                "sense_id": "4205f48c-aae8-3e6a-b662-6f1c775727e4",
                                "text": "Avant l’Unité, elle se partageait entre le duché de Parme (incluant Plaisance), le duché de Modène (incluant Reggio) et les États de l’Église, dont faisaient partie Bologne, Ferrare et la Romagne (où se situe Ravenne, Forli et Rimini)."
                            }
                        ]
                    },
                    {
                        "sense_id": "074ab268-969d-3cde-a5fd-a283a0988e9d",
                        "entry_id": "d80b2159-1fa5-3990-b301-f3149490f24c",
                        "glosses": [
                            "Province autour de cette ville."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9599fe2d-848c-42b2-8f23-f85729edc730",
                        "source_entry_id": "d80b2159-1fa5-3990-b301-f3149490f24c",
