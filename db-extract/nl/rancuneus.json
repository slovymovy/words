                                        "entry_id": "994fede7-b3c7-3e73-878b-401878612643",
                                        "glosses": [
                                            "Filled with, or showing, spite; having a desire to annoy or harm."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fed78d1d-2614-4b0a-963c-bb441165fa2d",
                                                "sense_id": "08140a3c-088c-3df2-b05d-87ae818a3bcf",
                                                "text": "It's not like you killed someone\nIt's not like you drove a spiteful spear into his side\nTalk to Jesus Christ as if he knows the reasons why\nHe did it all for you"
