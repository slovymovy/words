                        "sense_id": "b6790f71-5146-3108-82e5-8579a0d3b3b6",
                        "entry_id": "c89b6b7a-dd57-300d-9bd2-00054e0c7116",
                        "glosses": [
                            "zeker van wat te doen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e29397c5-5d16-4a9a-a9d4-9459d38b57a6",
                                "sense_id": "b6790f71-5146-3108-82e5-8579a0d3b3b6",
                                "text": "Hij gaf vastberaden de presentatie aan het bestuur."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "014058f1-d691-44de-8e81-b7e70e22454e",
                        "source_entry_id": "c89b6b7a-dd57-300d-9bd2-00054e0c7116",
                        "source_sense_id": "b6790f71-5146-3108-82e5-8579a0d3b3b6",
                        "source_sense_description": "zeker van wat te doen",
                        "target_lang_word": "resolutely",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "resolutely",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bf48b113-e407-3244-a1f2-e898b98a9786",
                                        "entry_id": "01a53203-5a34-3f65-ba1e-0c7df7bedf7f",
                                        "glosses": [
                                            "In a determined, unyielding manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb761ead-f610-46a4-a93e-b82cdebf81e5",
                                                "sense_id": "bf48b113-e407-3244-a1f2-e898b98a9786",
                                                "text": "We must resolutely fight against the increasing radical leftist threat targeting our society!"
                                            },
                                            {
                                                "example_id": "386219a6-59b5-4c20-88dd-7aab8c7699ec",
                                                "sense_id": "bf48b113-e407-3244-a1f2-e898b98a9786",
                                                "text": "Dorcas, faithful to her “young gentlemen,” denied strenuously that it could have been John’s voice she heard, and resolutely declared, in the teeth of everything, that it was Mr. Inglethorp who had been in the boudoir with her mistress."
                                            },
                                            {
                                                "example_id": "f47ac979-b296-4a97-b18f-55a738aa5568",
                                                "sense_id": "bf48b113-e407-3244-a1f2-e898b98a9786",
                                                "text": "It was applied methodically, carefully, resolutely, as in the fashion of a Satin-bird with charcoal, desiccated wood or blue from laundry-bags."
                                            },
                                            {
                                                "example_id": "974fa1af-d48e-4871-9110-6444bcd15ced",
                                                "sense_id": "bf48b113-e407-3244-a1f2-e898b98a9786",
                                                "text": "Long before Shap platform showed up around a corner and the two arms on the gradient post drooped in both directions at once, Duchess of Buccleuch's amiable throbbing purr at the stack [funnel, chimney] had become a fierce freight-engine bark, as she resolutely dragged at her enormous load."
                                            },
                                            {
                                                "example_id": "8a5302c0-8ce2-4fea-b23d-1e69d1ab22d9",
                                                "sense_id": "bf48b113-e407-3244-a1f2-e898b98a9786",
                                                "text": "It was no less than Valencia deserved after dominating possession in the final 20 minutes although Chelsea defended resolutely and restricted the Spanish side to shooting from long range."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "227354b7-51d0-491b-80c7-c73cfece2326",
                        "source_entry_id": "c89b6b7a-dd57-300d-9bd2-00054e0c7116",
                        "source_sense_id": "b6790f71-5146-3108-82e5-8579a0d3b3b6",
                        "source_sense_description": "zeker van wat te doen",
                        "target_lang_word": "determinedly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "determinedly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "279fad06-9250-347d-8d77-f265f20b8b30",
                                        "entry_id": "e1051025-480f-3230-81f8-e8b7d6bc744a",
                                        "glosses": [
                                            "In a determined manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1407e2f4-d8d7-42be-8c98-6d8568835c96",
                                                "sense_id": "279fad06-9250-347d-8d77-f265f20b8b30",
                                                "text": "where closeness, when it does manage to show itself, usually falls victim to outside forces that seem determinedly hostile to any manifestation of happiness."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
