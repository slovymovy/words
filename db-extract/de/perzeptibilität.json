                "senses": [
                    {
                        "sense_id": "23970f46-1346-3f6d-a0ad-77eaf54d6090",
                        "entry_id": "29662b4a-193f-3624-8508-5822ae4f0d99",
                        "glosses": [
                            "Eigenschaft, so, dass es durch die Sinne wahrnehmbar (perzeptibel) ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be1594fd-be6d-4061-807d-4cea091fcbb1",
                                "sense_id": "23970f46-1346-3f6d-a0ad-77eaf54d6090",
                                "text": "„Aus Perspektive der Perzeptionsforschung lässt sich nun fragen, welche Auswirkungen der Ausfall des Stimmtons auf die Perzeptibilität einer geflüsterten Äußerung hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "57701389-e7f7-356d-978e-4ed7e193ae09",
                        "entry_id": "29662b4a-193f-3624-8508-5822ae4f0d99",
                        "glosses": [
                            "Eigenschaft des Menschen, sinnlich wahrnehmen (perzipieren) zu können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b42f2262-2180-4862-9ad2-caba79ee81ac",
                                "sense_id": "57701389-e7f7-356d-978e-4ed7e193ae09",
                                "text": "„Auf Grund der beschränkten Perzeptibilität der handelnden Systemelemente können diese bei ihren Aktionen stets nur ein begrenztes Maß an Beziehungen berücksichtigen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
