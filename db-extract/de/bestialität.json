                "senses": [
                    {
                        "sense_id": "17bd9e47-02ee-3c2b-b61e-6db5d4ef995f",
                        "entry_id": "390fece1-eaae-3d9d-a188-44f6560eba94",
                        "glosses": [
                            "rohes, brutales Verhalten eines Menschen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84ec288f-5c68-460d-979c-17db023e01db",
                                "sense_id": "17bd9e47-02ee-3c2b-b61e-6db5d4ef995f",
                                "text": "Menschen können Bestialität zeigen."
                            },
                            {
                                "example_id": "ed17a2d3-cfbe-4eef-a4dc-0cebb3cacebf",
                                "sense_id": "17bd9e47-02ee-3c2b-b61e-6db5d4ef995f",
                                "text": "„Er sagte, die Welt sei hart, und für die menschliche Bestialität gebe es keine Grenzen.“"
                            },
                            {
                                "example_id": "8735506f-da18-4f0c-bafa-2dcbf09a3fd1",
                                "sense_id": "17bd9e47-02ee-3c2b-b61e-6db5d4ef995f",
                                "text": "„So exemplifiziert de Sade, etwas summarisch formuliert, die populäre Maxime »Zurück zur Natur« auf seine Weise und inszeniert jene infernalische Welt, in der es, mit versetzten moralischen Vorzeichen, trotz aller Bestialität ganz logisch zugeht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1ff546b7-7ab0-4b15-8707-8f510b4e18c8",
                        "source_entry_id": "390fece1-eaae-3d9d-a188-44f6560eba94",
                        "source_sense_id": "17bd9e47-02ee-3c2b-b61e-6db5d4ef995f",
                        "source_sense_description": "rohes, brutales Verhalten eines Menschen",
                        "target_lang_word": "bestiality",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bestiality",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "990ffdf3-8db2-345f-8ff3-670f02c6a779",
                                        "entry_id": "6404ec87-4a62-3d8f-9474-999a61861a51",
                                        "glosses": [
                                            "Sexual activity between a human and another animal species."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f018527-59a1-4cf8-b6b1-f343ae1d8f88",
                                                "sense_id": "990ffdf3-8db2-345f-8ff3-670f02c6a779",
                                                "text": "Less common, but still frequent, are erect penises, more complete female nudes, copulations, and even scenes of bestiality."
                                            },
                                            {
                                                "example_id": "aa366e62-3aee-43d8-8f46-68ed59df8c3f",
                                                "sense_id": "990ffdf3-8db2-345f-8ff3-670f02c6a779",
                                                "text": "Second, the romance option brings up a unique issue: having sex with an alien. It’s somewhat difficult to say what the Christian should think on this issue because, well, the Bible doesn’t talk about aliens. Probably because they don’t exist (sorry to burst your bubble). Would this be considered bestiality? Or is it not bestiality since they are also beings capable of rational and ethical thought and self-reflection unlike usual animals?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f1bde644-1ef0-38c4-af79-9913dc900f53",
                                        "entry_id": "6404ec87-4a62-3d8f-9474-999a61861a51",
                                        "glosses": [
                                            "Bestial nature, savagery, inhumanity, like (or akin to) an animal's."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db8e7356-06b2-4623-9c9e-ce090d5c502d",
                                                "sense_id": "f1bde644-1ef0-38c4-af79-9913dc900f53",
                                                "text": "the pitiful inadequacy of the reforms and the bestiality of the white society"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "994d078b-a53f-377b-8294-6a62e6093772",
