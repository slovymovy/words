                        "entry_id": "fbd0299d-569f-38fa-bd80-fea0b04e24d0",
                        "glosses": [
                            "Du point de vue français et suisse : en Allemagne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5094b37-e166-426f-9789-5725756dd719",
                                "sense_id": "56e28e44-d042-304b-b6a5-686c7b2234a7",
                                "text": "Enfin, en dépit de la prédominance du répertoire allemand, les fonctionnaires d’outre-Rhin ainsi que les militaires de la garnison stationnée à Strasbourg ne compensent guère l'absence de la bourgeoisie alsacienne francophile."
                            },
                            {
                                "example_id": "13e13917-b485-4a99-bd2a-11251a11a790",
                                "sense_id": "56e28e44-d042-304b-b6a5-686c7b2234a7",
                                "text": "Simon Fritz, commandant en charge d’une partie des 65 pompiers arrivés d’outre-Rhin, et son équipe sont positionnés sur la D3 entre Saint-Magne et Belin-Béliet."
                            },
                            {
                                "example_id": "18d706b1-6880-4d3e-9f4c-5defd81cb26b",
                                "sense_id": "56e28e44-d042-304b-b6a5-686c7b2234a7",
                                "text": "C’est Alstom, entreprise française, qui a conçu depuis ses bureaux d’études de Tarbes les trains à hydrogène « Coradia iLint » assemblés outre-Rhin à Salzgitter."
                            }
                        ]
                    }
