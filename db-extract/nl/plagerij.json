                            {
                                "target_word": "teasing",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d64ef308-aab7-3902-bc11-91c90424db80",
                                        "entry_id": "8a7a4b7e-03ec-39b8-b69c-fd4b0b6982be",
                                        "glosses": [
                                            "The act of harassing someone playfully or maliciously, especially by ridicule; provoking someone with persistent annoyances; making fun of, making light of someone."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f1bd4c93-ee3c-47bf-863c-f9e54e08db68",
                                                "sense_id": "d64ef308-aab7-3902-bc11-91c90424db80",
                                                "text": "Teasing can be seen as a kind of workplace abuse."
                                            },
                                            {
                                                "example_id": "148aeedd-d36d-4636-be4c-76759ae199cd",
                                                "sense_id": "d64ef308-aab7-3902-bc11-91c90424db80",
                                                "text": "The gentle teasing between siblings filled the house with laughter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cd8931dc-8dc3-3a3d-87d9-18b9f26fbe3e",
                                        "entry_id": "8a7a4b7e-03ec-39b8-b69c-fd4b0b6982be",
                                        "glosses": [
                                            "The act of removing tangles from one's hair with a comb."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d20e2dd5-91fb-4e4f-92af-ec1a54b2a31e",
                                                "sense_id": "cd8931dc-8dc3-3a3d-87d9-18b9f26fbe3e",
                                                "text": "The teasing of her curls took nearly an hour with the fine-tooth comb."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "teasing",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0505f9b8-cda9-3f41-984b-450c34a197dd",
                                        "entry_id": "ed4f8cde-8982-3b57-8830-522a627db0ab",
                                        "glosses": [
                                            "Playfully vexing, especially by ridicule."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "813b775e-5817-4977-840d-330fef46b024",
                                                "sense_id": "0505f9b8-cda9-3f41-984b-450c34a197dd",
                                                "text": "The children exchanged teasing remarks during recess."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "28ee1c4c-a6de-3e3c-8a45-3d7573bf5586",
                                        "entry_id": "ed4f8cde-8982-3b57-8830-522a627db0ab",
                                        "glosses": [
                                            "Arousing sexual desire without intending to satisfy it."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3c4d098-d504-43b6-96a6-284f492d974d",
                                                "sense_id": "28ee1c4c-a6de-3e3c-8a45-3d7573bf5586",
                                                "text": "The actress gave him a teasing glance before walking away."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "38001d5b-4f12-3d39-b0ed-a255ede763ac",
                                        "entry_id": "ed4f8cde-8982-3b57-8830-522a627db0ab",
                                        "glosses": [
                                            "Causing irritation or annoyance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce866e51-6bc1-46d4-8118-c7f923235322",
                                                "sense_id": "38001d5b-4f12-3d39-b0ed-a255ede763ac",
                                                "text": "The teasing itch from the mosquito bite drove her crazy."
                                            }
                                        ]
