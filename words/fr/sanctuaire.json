{
    "word_family": [
        "sanctuariser",
        "sanctuarisation"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6605c783-8138-3c2a-b92a-30b3c5bf9b79",
                    "sense_definition": "Édifice ou lieu consacré à l'exercice d'un culte religieux ou à des pèlerinages.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "culte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De nombreux pèlerins se rendent chaque année dans ce célèbre <w>sanctuaire</w> pour prier."
                        },
                        {
                            "text": "L'accès à ce petit <w>sanctuaire</w> de montagne se fait par un sentier escarpé."
                        }
                    ],
                    "synonyms": [
                        "temple",
                        "lieu saint"
                    ],
                    "common_phrases": [
                        "sanctuaire religieux",
                        "visiter un sanctuaire"
                    ]
                },
                {
                    "sense_id": "68108a62-5f26-3f0c-aebd-5f7a8fe93c3a",
                    "sense_definition": "Lieu de calme ou de sécurité où l'on se trouve à l'abri du monde extérieur, des menaces ou des importuns.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "protection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sa chambre d'étudiant était devenue un véritable <w>sanctuaire</w> où personne ne le dérangeait."
                        },
                        {
                            "text": "Cette réserve naturelle a été créée comme un <w>sanctuaire</w> pour les oiseaux migrateurs."
                        }
                    ],
                    "synonyms": [
                        "refuge",
                        "havre de paix",
                        "asile"
                    ],
                    "common_phrases": [
                        "sanctuaire de paix",
                        "sanctuaire marin"
                    ]
                },
                {
                    "sense_id": "72e39baa-be61-3494-8563-4433b83731ba",
                    "sense_definition": "Partie d'une église chrétienne où est situé le maître-autel et réservée aux ministres du culte.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "culte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Seuls le prêtre et ses assistants avaient le droit de pénétrer dans le <w>sanctuaire</w>."
                        },
                        {
                            "text": "Une lampe rouge restait allumée jour et nuit au fond du <w>sanctuaire</w>."
                        }
                    ],
                    "synonyms": [
                        "chœur"
                    ],
                    "antonyms": [
                        "nef"
                    ],
                    "common_phrases": [
                        "sanctuaire de l'église"
                    ]
                },
                {
                    "sense_id": "b6135c1d-54de-33c0-8dff-8385e926d492",
                    "sense_definition": "Lieu hautement respecté où s'exerce une activité intellectuelle, artistique, civique ou morale.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "institution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette prestigieuse bibliothèque est considérée par les chercheurs comme un <w>sanctuaire</w> du savoir."
                        },
                        {
                            "text": "Les citoyens souhaitent que l'école demeure un <w>sanctuaire</w> préservé des débats partisans."
                        }
                    ],
                    "synonyms": [
                        "temple",
                        "bastion"
                    ],
                    "common_phrases": [
                        "sanctuaire du savoir"
                    ]
                },
                {
                    "sense_id": "8c257e5f-66fe-3163-aa8b-5a07143365c6",
                    "sense_definition": "Partie la plus sacrée d'un temple antique, interdite aux fidèles ordinaires et réservée aux initiés.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "culte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La prêtresse rendait ses oracles depuis le fond obscur du <w>sanctuaire</w>."
                        },
                        {
                            "text": "Les profanes ne devaient sous aucun prétexte franchir le seuil de ce <w>sanctuaire</w>."
                        }
                    ],
                    "synonyms": [
                        "adyton",
                        "naos"
                    ],
                    "common_phrases": [
                        "sanctuaire du temple"
                    ]
                },
                {
                    "sense_id": "42f2d38d-9e06-3164-91e6-7e2db9aefb40",
                    "sense_definition": "Lieu inviolable accordant l'immunité juridique ou le droit d'asile contre l'autorité publique.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "protection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Au Moyen Âge, un fugitif pouvait réclamer le droit de <w>sanctuaire</w> auprès de l'évêque."
                        },
                        {
                            "text": "Les soldats royaux durent s'arrêter car le couvent constituait un <w>sanctuaire</w> inviolable."
                        }
                    ],
                    "synonyms": [
                        "asile",
                        "immunité"
                    ],
                    "common_phrases": [
                        "droit de sanctuaire"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "au sens de privilège juridique historique"
                        }
                    ]
                }
            ]
        }
    ]
}