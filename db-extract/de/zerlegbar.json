                        "examples": [
                            {
                                "example_id": "33d60072-57f5-4cdc-a7a8-7b39de2b7604",
                                "sense_id": "3ec39138-83d6-3404-b6e8-28cca1086483",
                                "text": "„Wichtige Kriterien waren die einfache Montage und der Transport, weswegen die Möbel komplett zerlegbar waren.“"
                            },
                            {
                                "example_id": "719d22b5-d7e3-4c70-a028-f6b1fc268067",
                                "sense_id": "3ec39138-83d6-3404-b6e8-28cca1086483",
                                "text": "„Es handelt sich um eine zerlegbare und leicht versetzbare Ausführung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
