                                                "sense_id": "dde8126f-4b43-3b0d-9719-0d6c9ac7e119",
                                                "text": "Als erste Zarzuela gilt \"El jardín de Falerina\" des spanischen Hofdichters und Dramatikers Pedro Calderón de la Barca."
                                            },
                                            {
                                                "example_id": "90c728cb-bd09-4250-98c0-c84f7858241b",
                                                "sense_id": "dde8126f-4b43-3b0d-9719-0d6c9ac7e119",
                                                "text": "Placido Domingo hat wunderbar den Gutsbesitzer \"Don Vidal Hernando\" in der Zarzuela \"Luisa Fernanda\" von Federico Moreno Torroba gesungen."
                                            }
                                        ],
