                    "frequency": "Low",
                    "semantic_group_id": "apparence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ils formaient un couple <w>officiel</w> pour les médias mais vivaient en réalité séparément."
                        },
                        {
                            "text": "La trêve n'était qu'un accord <w>officiel</w> que personne ne respectait sur le terrain."
                        }
                    ],
                    "synonyms": [
                        "apparent"
                    ],
                    "common_phrases": [
                        "couple officiel"
