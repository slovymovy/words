                                                "sense_id": "f008a672-1544-35a0-936f-389e942c404a",
                                                "text": "Overaged and lecherous lushes at office parties profaning the text, music, and meaning of Christmas carols."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "41c305a9-6afa-34ee-b690-53922f7fb02a",
                                        "entry_id": "de0dc229-1729-3d40-9abb-a782e122c73f",
                                        "glosses": [
                                            "Intoxicating liquor."
                                        ],
                                        "tags": [
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "abf67d88-c92b-4aaa-98f8-0c4b90105242",
                                                "sense_id": "41c305a9-6afa-34ee-b690-53922f7fb02a",
                                                "text": "I took my flogging like a stone. If I had sung, some of the convicts would have given me some lush with a locust in it (laudanum hocussing), and when I was asleep would have given me a crack on the head that would have laid me straight."
                                            },
                                            {
                                                "example_id": "2853108c-64c6-4d80-9fdf-ae149b107038",
                                                "sense_id": "41c305a9-6afa-34ee-b690-53922f7fb02a",
                                                "text": "If your care comes, in the liquor sink it, / Pass along the lush — I'm the boy can drink it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "080ff434-e3ca-38bc-ae23-8984acd1169c",
                                        "entry_id": "de0dc229-1729-3d40-9abb-a782e122c73f",
                                        "glosses": [
                                            "A person who enjoys talking about themselves."
                                        ],
                                        "tags": [
                                            "Hawaii",
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5f581dc0-9db9-4247-8871-ab24bf0351a5",
                                                "sense_id": "080ff434-e3ca-38bc-ae23-8984acd1169c",
                                                "text": "Am I humble or am I a lush?"
                                            }
                                        ]
                                    }
                                ]
