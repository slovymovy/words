                                "example_id": "d4ea8051-8e60-495c-93ad-c68afc070057",
                                "sense_id": "291ed5ea-c9ce-3679-9a34-0cbc34204126",
                                "text": "„Mein Umzug von Mitte nach Charlottenburg hat meine Sozialkontakte rapide gesenkt.“"
                            },
                            {
                                "example_id": "6993beba-7ed5-471b-ae62-cac02714292b",
                                "sense_id": "291ed5ea-c9ce-3679-9a34-0cbc34204126",
                                "text": "„Der Mensch als einsamer Wolf ist eine Ausnahme, ein Leben mit vielen Sozialkontakten die wünschenswerte Regel.“"
                            },
                            {
                                "example_id": "d33b52b0-fa67-46f7-90a1-92264d28ac22",
                                "sense_id": "291ed5ea-c9ce-3679-9a34-0cbc34204126",
                                "text": "„Gepflegte Fingernägel sind die Eintrittskarte zum befriedigenden Sozialkontakt.“"
                            }
