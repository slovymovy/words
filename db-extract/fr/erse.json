                            {
                                "example_id": "10038d8e-cd64-4954-af85-6ef553cbf10a",
                                "sense_id": "5b88413a-f9f7-35ce-8d1d-f4e0fdb64347",
                                "text": "Dialecte erse, poésies erses."
                            },
                            {
                                "example_id": "c89e9bf2-4558-46c0-9b24-ebc9b194abd6",
                                "sense_id": "5b88413a-f9f7-35ce-8d1d-f4e0fdb64347",
                                "text": "Les anciens poèmes erses nous apprennent, en effet, que les rites druidiques existaient parmi les Scandinaves."
                            }
                        ]
                    },
