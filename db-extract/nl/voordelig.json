                                "target_senses": [
                                    {
                                        "sense_id": "0291f430-39ff-3a43-9897-cc875f0ee18f",
                                        "entry_id": "00a965a4-9cd2-3a40-8aed-21014497d065",
                                        "glosses": [
                                            "Being of advantage, beneficial."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34cc8600-c615-41ea-8284-930f8cd253c7",
                                                "sense_id": "0291f430-39ff-3a43-9897-cc875f0ee18f",
                                                "text": "Jim took up an advantageous position and shepherded them out in a bunch through the doorway: [...]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c1407fc7-5e3d-4cdf-8bb3-d7c1b5f2dbd7",
                        "source_entry_id": "028f2f56-6b3e-3ffb-9f94-35a6fbacdfd5",
                        "source_sense_id": "6eebab34-74df-339b-8e5e-a9fa69cc5a4d",
                        "source_sense_description": "een voordeel gevend, met name geldelijk",
                        "target_lang_word": "avantageux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "avantageux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9bf18fae-a06f-3804-8608-fc4e84b67a6f",
                                        "entry_id": "a79dd1dc-95a0-3774-a985-516a19c2c956",
                                        "glosses": [
                                            "Qui apporte ou qui produit de l’avantage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "497bab4b-8173-4b1a-b8dd-563a04b301fc",
                                                "sense_id": "9bf18fae-a06f-3804-8608-fc4e84b67a6f",
                                                "text": "Si néanmoins les enfans trouvent , que la communauté ne leur soit pas avantageuse , ils y peuvent renoncer , comme le peuvent leurs heritiers en cas de décès."
                                            },
                                            {
                                                "example_id": "49358404-960d-4ce6-94df-9679766ff2c8",
                                                "sense_id": "9bf18fae-a06f-3804-8608-fc4e84b67a6f",
                                                "text": "Si les engrais verts donnent de fort bons résultats dans les sols infertiles et épuisés, à plus forte raison sont-ils avantageux dans les sols fertiles et riches."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a1e172f-0c08-39b1-9f7a-fb473583a3c4",
                                        "entry_id": "a79dd1dc-95a0-3774-a985-516a19c2c956",
                                        "glosses": [
                                            "Qui est à l’avantage de quelqu’un, qui est en sa faveur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a5c5199-4e80-436d-baa2-06a50e4c3dd5",
                                                "sense_id": "4a1e172f-0c08-39b1-9f7a-fb473583a3c4",
                                                "text": "Avoir une opinion, une idée avantageuse de quelqu’un. — Il m’a parlé de vous d’une manière très avantageuse. — Mettre, présenter quelque chose sous un jour avantageux."
                                            },
                                            {
                                                "example_id": "3541542d-e17d-46ba-9568-7e98b0d34821",
                                                "sense_id": "4a1e172f-0c08-39b1-9f7a-fb473583a3c4",
                                                "text": "Il faut que je vous dise la chance qu’elle a eue, avec son plus jeune, un petit garçon très ordinaire à première vue, pareil à n’importe lequel, enfin pas avantageux du tout."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "daba6355-4b95-387b-91b2-ec85530b0a84",
                                        "entry_id": "a79dd1dc-95a0-3774-a985-516a19c2c956",
                                        "glosses": [
                                            "Qui sied, en parlant des vêtements."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0fa0cbe-886d-4209-b25d-6e1ae7b3d8cc",
                                                "sense_id": "daba6355-4b95-387b-91b2-ec85530b0a84",
                                                "text": "Il allait, tête haute, serré dans un complet avantageux, la cravate impeccable, le chapeau désinvolte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "96d060f1-e5cc-31e5-9f83-c36543669ce2",
                                        "entry_id": "a79dd1dc-95a0-3774-a985-516a19c2c956",
                                        "glosses": [
                                            "Qualifie une taille élevée, avec un port noble."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "19783017-c29a-32c8-a645-622c738a77fe",
                                        "entry_id": "a79dd1dc-95a0-3774-a985-516a19c2c956",
                                        "glosses": [
                                            "Qui se croit et veut se faire croire supérieur aux autres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8b60139-72fa-44a7-a0d7-e9764df08181",
                                                "sense_id": "19783017-c29a-32c8-a645-622c738a77fe",
                                                "text": "C’est un homme avantageux en paroles."
                                            },
                                            {
                                                "example_id": "91804c06-7211-4e78-86cb-2f41bbb6d648",
                                                "sense_id": "19783017-c29a-32c8-a645-622c738a77fe",
                                                "text": "Avoir, prendre un ton, un air avantageux."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "avantageux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "be00396d-4b6b-3a02-87a7-38793a24aca5",
                                        "entry_id": "64a6df00-6608-375d-8bfe-aa30dcdd91d7",
                                        "glosses": [
                                            "Celui, celle qui se croit et veut se faire croire supérieur aux autres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97a9e8da-361c-4afe-937f-566d3b910bb3",
                                                "sense_id": "be00396d-4b6b-3a02-87a7-38793a24aca5",
                                                "text": "Quelques donzelles se pâmaient devant un parterre de sémillants garçons qui jouaient les avantageux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
