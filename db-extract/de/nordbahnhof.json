                "senses": [
                    {
                        "sense_id": "2535fbb7-3939-3d3f-aa3f-fe5f9cdd0409",
                        "entry_id": "b0caeb7c-fe57-3c4f-a8e8-634cacc69d25",
                        "glosses": [
                            "Bahnhof, der im Norden von etwas (einer Stadt, Land oder dergleichen) liegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bab2f781-52cc-4d77-9146-45b217b522bc",
                                "sense_id": "2535fbb7-3939-3d3f-aa3f-fe5f9cdd0409",
                                "text": "„Im Nordbahnhof gibt es nur einen einzigen riesigen Saal mit zwei großen Bildschirmen.“"
                            },
                            {
                                "example_id": "5c6c30c2-51e0-4642-a56c-f93a65f021aa",
                                "sense_id": "2535fbb7-3939-3d3f-aa3f-fe5f9cdd0409",
                                "text": "„Vom Nordbahnhof fuhren einst Züge nach Brünn, Krakau und Lemberg ab.“"
                            },
                            {
                                "example_id": "b3a34d25-a391-4964-9ce8-4cbcc9e613b3",
                                "sense_id": "2535fbb7-3939-3d3f-aa3f-fe5f9cdd0409",
                                "text": "„Dutzende Hochgeschwindigkeitszüge pendeln täglich zwischen dem Futianoder dem Nordbahnhof in Shenzhen und dem Bahnhof West Kowloon in Hongkong.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
