                "senses": [
                    {
                        "sense_id": "28f1abfc-8a7d-371f-9fc6-400e4a8afeee",
                        "entry_id": "1531b38c-2ff0-3d0d-8bf3-9d5910a8a224",
                        "glosses": [
                            "Lokalanästhetikum, ein Arzneistoff zur lokalen Betäubung bei kleineren Operationen wie zum Beispiel Zahnextraktionen, auch zur Behandlung von Herzrhythmusstörungen verwendet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e83aab3-b859-4c27-a05e-81351cb68174",
                                "sense_id": "28f1abfc-8a7d-371f-9fc6-400e4a8afeee",
                                "text": "Bevor sie den Splitter herausoperierte, betäubte sie die Wunde mit Lidocain."
                            },
                            {
                                "example_id": "161e498f-669d-4134-8ebc-e49114436173",
                                "sense_id": "28f1abfc-8a7d-371f-9fc6-400e4a8afeee",
                                "text": "Der Notarzt verabreichte einige Milligramm Lidocain."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
