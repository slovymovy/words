                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bc39fb63-1f8b-3ff1-ba68-01ad33940f6c",
                                        "entry_id": "e583a426-dd78-338e-a699-e1e755b900ab",
