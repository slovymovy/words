            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8b90ef8f-b0ad-3aad-a94c-fb1f31536b67",
                    "sense_definition": "Безмятежное, уравновешенное состояние души, отсутствие тревоги, сомнения или волнения.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "mental_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он старался сохранять <w>спокойствие</w> даже в самой сложной ситуации.",
                            "target_lang_translations": {
                                "en": "He tried to maintain his <w>composure</w> even in the most difficult situation.",
                                "zh": "即使在最困难的情况下，他也努力保持<w>冷静</w>。"
                            }
                        },
                        {
                            "text": "Лицо её выражало глубокое <w>спокойствие</w> и уверенность.",
                            "target_lang_translations": {
                                "en": "Her face expressed deep <w>calm</w> and confidence.",
                                "zh": "她的脸上流露出深沉的<w>平静</w>与自信。"
                            }
                        }
                    ],
                    "synonyms": [
                        "безмятежность",
                        "покой"
                    ],
                    "antonyms": [
                        "волнение",
                        "тревога",
                        "возбуждение",
                        "ярость",
                        "трепет"
                    ],
                    "common_phrases": [
                        "сохранять спокойствие",
                        "душевное спокойствие",
                        "олимпийское спокойствие",
                        "полное спокойствие"
                    ],
                    "target_lang_definitions": {
                        "en": "A serene, balanced state of mind; freedom from anxiety, doubt, or agitation.",
                        "zh": "指内心平静、平衡的状态，没有焦虑、怀疑或激动。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "calm",
                                "target_lang_sense_clarification": "general mental state"
                            },
                            {
                                "target_lang_word": "composure",
                                "target_lang_sense_clarification": "self-control, especially under stress"
                            },
                            {
                                "target_lang_word": "peace of mind",
                                "target_lang_sense_clarification": "inner spiritual balance"
                            },
                            {
                                "target_lang_word": "calmness",
                                "target_lang_sense_clarification": "state of being calm"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "冷静",
                                "target_lang_sense_clarification": "指在压力下保持镇定和自控"
                            },
                            {
                                "target_lang_word": "平静",
                                "target_lang_sense_clarification": "指内心安宁、没有波澜的状态"
                            },
                            {
                                "target_lang_word": "安宁",
                                "target_lang_sense_clarification": "指精神上的安稳与和谐"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8fef5318-82ce-313b-9755-726c10e89a3b",
                    "sense_definition": "Отсутствие шума, движения и суеты; тишина и покой в окружающей обстановке.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "environment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В лесу царило удивительное <w>спокойствие</w>, нарушаемое только пением птиц.",
                            "target_lang_translations": {
                                "en": "An amazing <w>tranquillity</w> reigned in the forest, broken only by the singing of birds.",
                                "zh": "森林里一片奇妙的<w>宁静</w>，只有鸟儿的歌声打破了这份寂静。"
                            }
                        },
                        {
                            "text": "Мы наслаждались красотой и <w>спокойствием</w> этого тихого места.",
                            "target_lang_translations": {
                                "en": "We enjoyed the beauty and <w>peace</w> of this quiet place.",
                                "zh": "我们享受着这个安静地方的美丽与<w>安宁</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "покой",
                        "неподвижность"
                    ],
                    "antonyms": [
                        "буря"
                    ],
                    "common_phrases": [
                        "нарушать спокойствие",
                        "мёртвое спокойствие",
                        "вечное спокойствие"
                    ],
                    "target_lang_definitions": {
                        "en": "Absence of noise, movement, or bustle; silence and stillness in the environment.",
                        "zh": "指环境安静、没有噪音、运动或喧嚣。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "tranquillity",
                                "target_lang_sense_clarification": "peacefulness of a place or atmosphere"
                            },
                            {
                                "target_lang_word": "quiet",
                                "target_lang_sense_clarification": "absence of noise"
                            },
                            {
                                "target_lang_word": "calm",
                                "target_lang_sense_clarification": "absence of wind or disturbance"
                            },
                            {
                                "target_lang_word": "peace",
                                "target_lang_sense_clarification": "freedom from disturbance"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "宁静",
                                "target_lang_sense_clarification": "指环境的寂静与安详"
                            },
                            {
                                "target_lang_word": "安静",
                                "target_lang_sense_clarification": "指没有噪音或吵闹"
                            },
                            {
                                "target_lang_word": "寂静",
                                "target_lang_sense_clarification": "指非常安静，几乎没有声音"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7629e1ea-186d-3c98-82b4-a34a48da5bb3",
                    "sense_definition": "Соблюдение общественного порядка, отсутствие правонарушений и беспорядков.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "social_order",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Полиция обеспечивает <w>спокойствие</w> и безопасность на улицах города.",
                            "target_lang_translations": {
                                "en": "The police ensure <w>peace</w> and safety on the city streets.",
                                "zh": "警察负责维护城市街道的<w>治安</w>与安全。"
                            }
                        },
                        {
                            "text": "За нарушение общественного <w>спокойствия</w> предусмотрен денежный штраф.",
                            "target_lang_translations": {
                                "en": "A fine is provided for disturbing the public <w>peace</w>.",
                                "zh": "扰乱公共<w>秩序</w>者将被处以罚款。"
                            }
                        }
                    ],
                    "synonyms": [
                        "порядок",
                        "правопорядок"
                    ],
                    "antonyms": [
                        "беспорядки"
                    ],
                    "common_phrases": [
                        "общественное спокойствие",
                        "охрана спокойствия"
                    ],
                    "target_lang_definitions": {
                        "en": "The maintenance of public order and absence of civil disturbance or offenses.",
                        "zh": "指维护公共秩序，没有骚乱或违法行为。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "peace",
                                "target_lang_sense_clarification": "public order and security"
                            },
                            {
                                "target_lang_word": "order",
                                "target_lang_sense_clarification": "compliance with laws"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "治安",
                                "target_lang_sense_clarification": "指社会秩序和安全"
                            },
                            {
                                "target_lang_word": "秩序",
                                "target_lang_sense_clarification": "指遵守法律和规则的状态"
                            }
                        ]
                    }
                }
            ]
