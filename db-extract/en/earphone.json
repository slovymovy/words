                    {
                        "translation_id": "5dfb6e38-dabf-4141-ac8c-cdc8bf78324a",
                        "source_entry_id": "a8cb7a4b-60ec-3228-8e7c-ff93fe941ed4",
                        "source_sense_id": "310f93c4-94da-37f0-b7a8-d849fc911787",
                        "source_sense_description": "sound device held near the ear",
                        "target_lang_word": "écouteur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "écouteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d36455ec-f4c4-3580-a3b2-4284b141a999",
                                        "entry_id": "6586b1f9-45e7-3226-a43f-9c9e64190281",
                                        "glosses": [
                                            "Personne qui a l’habitude d’écouter, par une curiosité indiscrète, ce qu’on ne veut pas lui faire connaître."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad99a015-84d5-4bf0-a7d5-5da7b71c3b3c",
                                                "sense_id": "d36455ec-f4c4-3580-a3b2-4284b141a999",
                                                "text": "Écouteur malgré moi, je voulus m’en aller, tout au moins faire quelque mouvement qui leur signalât ma présence ; mais quoi ? tousser ? crier : je suis là ! je vous entends !… et ce fut bien plutôt la gêne et la timidité, que la curiosité d’en entendre davantage, qui me tinrent coi."
                                            },
                                            {
                                                "example_id": "a921e71f-0f48-4509-af21-2a75deeb2070",
                                                "sense_id": "d36455ec-f4c4-3580-a3b2-4284b141a999",
                                                "text": "Mais l’écouteur en avait entendu suffisamment pour que les oreilles lui en brûlassent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "88e080b5-817c-3d82-a513-8d9bb28179f4",
                                        "entry_id": "6586b1f9-45e7-3226-a43f-9c9e64190281",
                                        "glosses": [
                                            "Appareil qui permet d’écouter une communication, un enregistrement, de la musique, etc. Ce terme est généralement utilisé au pluriel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a702946-9f7e-452b-a126-9822174214a5",
                                                "sense_id": "88e080b5-817c-3d82-a513-8d9bb28179f4",
                                                "text": "Petit bémol : ces écouteurs ne sont pas multipoints."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bdddcd0f-798a-4f64-bcfd-b6137c72d93a",
                        "source_entry_id": "a8cb7a4b-60ec-3228-8e7c-ff93fe941ed4",
