                ],
                "senses": [
                    {
                        "sense_id": "9a175367-2f05-37b4-8c3e-03bb7c54ce9e",
                        "entry_id": "4312359b-82dc-318a-af97-f70a40d3ac64",
                        "glosses": [
                            "Action de rétorquer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29d39fe4-9f67-441d-8b90-11d57aa97d17",
                                "sense_id": "9a175367-2f05-37b4-8c3e-03bb7c54ce9e",
                                "text": "Cet argument est sujet à rétorsion."
                            },
                            {
                                "example_id": "f42751d0-9217-4e23-98bb-e33431d828c0",
                                "sense_id": "9a175367-2f05-37b4-8c3e-03bb7c54ce9e",
                                "text": "La rétorsion de l’argument consiste à prendre l’argument de l’adversaire pour démontrer le contraire de ce qu’il veut prouver."
                            }
                        ]
                    },
                    {
                        "sense_id": "94ceeae8-4196-3c4c-8a86-a50635dedd06",
                        "entry_id": "4312359b-82dc-318a-af97-f70a40d3ac64",
                        "glosses": [
                            "Action de coercition licite, prise par un État à l'encontre d'un autre État, en réponse à une mesure de même nature."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "42313ed6-7e60-4e2b-b28f-cae983c7edbc",
                                "sense_id": "94ceeae8-4196-3c4c-8a86-a50635dedd06",
                                "text": "Mesures de rétorsion."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e6b68eb8-ec44-417a-9b58-5f12ffbe9183",
                        "source_entry_id": "4312359b-82dc-318a-af97-f70a40d3ac64",
                        "source_sense_description": "Action de rétorquer",
                        "target_lang_word": "Retorsion",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Retorsion",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0dd78916-7909-3451-b362-811d36c92710",
                                        "entry_id": "8853019f-4df5-3960-b148-37b38f45efcf",
                                        "glosses": [
                                            "Vergeltung für einen unfreundlichen Akt eines Staates mit rechtlich erlaubten Mitteln"
                                        ],
                                        "tags": [
                                            "Völkerrecht"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ab309a9-5b91-4ae6-9787-d5c6761fadc6",
                                                "sense_id": "0dd78916-7909-3451-b362-811d36c92710",
                                                "text": "„Horn gehörte damals zu den „Nationalgardisten“ – nach den russischen Winterjacken „Pufajkások“ (Steppjackenbrigaden) genannt – bzw. bis Juni 1957 zur „Revolutionären Ordnungswache“, die für Retorsionen zuständig war.“"
                                            },
                                            {
                                                "example_id": "676a0ce3-7789-4336-a8ce-b5ddcd5378b1",
                                                "sense_id": "0dd78916-7909-3451-b362-811d36c92710",
                                                "text": "‚List forderte: „1. Daß die Zölle und Mauten im Innern Deutschlands aufgehoben, dagegen aber 2. ein auf dem Grundsatz der Retorsion beruhendes Zollsystem gegen fremde Nationen aufgestellt werden möchte, bis auch sie den Grundsatz der europäischen Handelsfreiheit anerkennen.\"‘"
                                            },
                                            {
                                                "example_id": "f863e350-8130-4133-9c3b-87ee92b685b7",
                                                "sense_id": "0dd78916-7909-3451-b362-811d36c92710",
                                                "text": "‚Treuhänder Franz Rösch: „Ich halte nichts von gegenseitigen Retorsionen. Wir könnten die Annahme von Aufträgen durch DDR-Betriebe einfach verbieten. Nur würde sich dies als Bumerang erweisen: Unsere Anlagen und Maschinenlieferungen in die DDR würden erheblich leiden.\"‘"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "16ef1350-5178-3e5c-9aee-dff5b4e7c71a",
                                        "entry_id": "8853019f-4df5-3960-b148-37b38f45efcf",
                                        "glosses": [
                                            "unmittelbare Erwiderung auf eine Beleidigung, wobei das Gericht für beide Kontrahenten von einer Strafe absehen kann"
                                        ],
                                        "tags": [
                                            "deutsches",
                                            "Strafrecht"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bba75a05-a31c-4e8a-b326-cfcf5214c6f8",
                                                "sense_id": "16ef1350-5178-3e5c-9aee-dff5b4e7c71a",
                                                "text": "Im deutschen Strafrecht ist die Retorsion noch in § 199 Strafgesetzbuch berücksichtigt."
                                            },
                                            {
                                                "example_id": "b0dc2a1a-827b-4060-a42a-f7a36955b272",
                                                "sense_id": "16ef1350-5178-3e5c-9aee-dff5b4e7c71a",
                                                "text": "„Mithin konnte Krönlein, da er das Schelten nicht erwidern durfte - Retorsion wird in Sachsen nicht verstattet -, weiter nichts beschließen, als den Injurianten umzubessern.“"
                                            },
                                            {
                                                "example_id": "f5705db7-afb5-49ad-ae21-8f56d98454e4",
                                                "sense_id": "16ef1350-5178-3e5c-9aee-dff5b4e7c71a",
                                                "text": "„Wenn für Absicht, findet dann das Recht der Retorsion statt, so dass der Mitreisende ermächtigt ist, auch seinerseits dem Gegenüber inhaltsvoll auf den Fuss zu treten, ohne pardon zu sagen?“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "fa28db05-992e-3f25-bca6-cb4e0efdae74",
                                        "entry_id": "8853019f-4df5-3960-b148-37b38f45efcf",
                                        "glosses": [
                                            "eine besondere Form der Argumentation, wenn der Inhalt einer Aussage mit dem Vollzug der Aussage im Widerspruch steht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8ab99f6-ad17-431b-a6f2-4bf0f8eeae8a",
                                                "sense_id": "fa28db05-992e-3f25-bca6-cb4e0efdae74",
                                                "text": "Eine Retorsion liegt vor, wenn der Zweifler an der Existenz von Wahrheit mit seiner Aussage \"Es gibt keine Wahrheit!\" implizit für sich Wahrheit beansprucht."
                                            },
                                            {
                                                "example_id": "3a7e9e10-65de-457b-8383-861ef4d1fe7c",
                                                "sense_id": "fa28db05-992e-3f25-bca6-cb4e0efdae74",
                                                "text": "Mit Hilfe der Retorsion kann man nicht das Gegenteil beweisen, sondern nur die Existenzmöglichkeit des Bezweifelten."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c40f4a2e-8db4-4011-8bc0-dd05969520ce",
                        "source_entry_id": "4312359b-82dc-318a-af97-f70a40d3ac64",
                        "source_sense_description": "Action de rétorquer",
                        "target_lang_word": "Zurückweisung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zurückweisung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c95ced03-4dd7-362e-b68c-275ad194a3b1",
                                        "entry_id": "cb1c04ef-83ca-315f-8f5f-d7ce545b73f7",
                                        "glosses": [
                                            "Handlung, etwas, das jemand von einem möchte, abzulehnen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a47edf15-c934-4f3e-aebe-716fa0a6eef5",
                                                "sense_id": "c95ced03-4dd7-362e-b68c-275ad194a3b1",
                                                "text": "„Trotz dieser Zurückweisung wollte Janosch weiterhin Maler werden.“"
                                            },
                                            {
                                                "example_id": "c5eebf1c-5de8-4c35-a563-38f200f27fe4",
                                                "sense_id": "c95ced03-4dd7-362e-b68c-275ad194a3b1",
                                                "text": "„Er bewies dem Kaiser, dass eine solche Zurückweisung nicht durchzuhalten war.“"
                                            },
                                            {
                                                "example_id": "3ec5987f-24b1-4be7-8b10-7c3f29581967",
                                                "sense_id": "c95ced03-4dd7-362e-b68c-275ad194a3b1",
                                                "text": "Er erklärte ihr seine Liebe, ihre Zurückweisung traf ihn sehr."
                                            },
                                            {
                                                "example_id": "0a65b3e9-2311-453a-ab58-ced7b66e1a81",
                                                "sense_id": "c95ced03-4dd7-362e-b68c-275ad194a3b1",
                                                "text": "„Tagelang kämpfte sie mit Frieds Zurückweisung und dem Gefühl der Verlassenheit, aber nach und nach war da auch etwas Neues.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5ce481bb-c19b-3f34-89c8-1894013d0e07",
                                        "entry_id": "cb1c04ef-83ca-315f-8f5f-d7ce545b73f7",
                                        "glosses": [
                                            "Handlung, eine Behauptung als falsch/unwahr zu erklären"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e7f27a3-ab38-4c6c-8d5f-bd15944afab0",
                                                "sense_id": "5ce481bb-c19b-3f34-89c8-1894013d0e07",
                                                "text": "„So ist etwa in den neueren Ausgaben seines verbreitetsten Werkes „Aufstand der Massen“ (1930) ein „Prolog für Franzosen“ und ein auf der Höhe des Bürgerkrieges geschriebener Epilog für Engländer“ enthalten, der eine Rechtfertigung Spaniens, des ganzen Spanien, gegenüber den leichtfertigen Urteilen unwissender Ausländer und den Greuelgeschichten verbitterter Emigranten darstellt und nebenbei eine leidenschaftliche Zurückweisung der Behauptung, daß er, Ortega, zu irgendeiner Zeit, in Spanien oder im Exil, an seinem Volke irregeworden sei.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "0d2ba9ab-5f28-3fa3-bf2d-5ab2e1ec34ff",
                                        "entry_id": "cb1c04ef-83ca-315f-8f5f-d7ce545b73f7",
                                        "glosses": [
                                            "formale/rechtliche Ablehnung von Anträgen (beispielsweise eines Asylantrages), Klagen (vor Gericht), Verfahren (beispielsweise von einer Ausländerbehörde) oder des Einlass von Personen an einer Grenze"
                                        ],
                                        "tags": [
                                            "Behörden",
                                            "Gerichte"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c08087f-ba65-464d-b73d-48ef64355a60",
                                                "sense_id": "0d2ba9ab-5f28-3fa3-bf2d-5ab2e1ec34ff",
                                                "text": "Die Zurückweisung an der Grenze erfolgte aufgrund fehlender Papiere."
                                            },
                                            {
                                                "example_id": "78d6fa1b-ea2a-4058-a6ef-7a5830e1f8dc",
                                                "sense_id": "0d2ba9ab-5f28-3fa3-bf2d-5ab2e1ec34ff",
                                                "text": "„Erstmals hat ein Gericht die Zurückweisung von Asylbewerbern an den Grenzen für rechtswidrig erklärt.“"
                                            },
                                            {
                                                "example_id": "24a8126f-bb10-4270-ab7c-fe9998291975",
                                                "sense_id": "0d2ba9ab-5f28-3fa3-bf2d-5ab2e1ec34ff",
                                                "text": "„Im Koalitionsvertrag heißt es, dass Zurückweisungen […] von Asylbewerbern \"in Abstimmung mit unseren europäischen Nachbarn\" vorgenommen würden.“"
                                            },
                                            {
                                                "example_id": "d51fd593-b275-4c26-9388-5b04c903f758",
                                                "sense_id": "0d2ba9ab-5f28-3fa3-bf2d-5ab2e1ec34ff",
                                                "text": "„Der Rechtswissenschaftler der Uni Konstanz, Thym, sagte im Deutschlandfunk,die Bundesregierung könne beispielsweise versuchen, die Zurückweisungen durch eine besondere Überlastung bei der Integration zu begründen.“"
                                            },
                                            {
                                                "example_id": "74721899-f150-45d9-9de2-5e0f9d53c904",
                                                "sense_id": "0d2ba9ab-5f28-3fa3-bf2d-5ab2e1ec34ff",
                                                "text": "„[…] die Zurückweisung von Asylsuchenden an den internen EU-Grenzen, zum Beispiel in Deutschland, [soll] erleichtert werden.“"
                                            },
                                            {
                                                "example_id": "fb8133a7-9f42-4b37-84b8-0b439a93287a",
                                                "sense_id": "0d2ba9ab-5f28-3fa3-bf2d-5ab2e1ec34ff",
                                                "text": "Die Zurückweisung der Klage wurde mit Formfehlern begründet."
                                            },
                                            {
                                                "example_id": "bc1e76e8-1882-4559-afa2-3ae791591399",
                                                "sense_id": "0d2ba9ab-5f28-3fa3-bf2d-5ab2e1ec34ff",
                                                "text": "„Der Prozess endete am 19. Juni 1914 mit der Zurückweisung der Klage.“"
                                            },
                                            {
                                                "example_id": "d1f29f9f-57ee-4553-87bc-e1b66e3a6294",
                                                "sense_id": "0d2ba9ab-5f28-3fa3-bf2d-5ab2e1ec34ff",
                                                "text": "„Anders als der Generalanwalt Anthony Collins, der im Oktober eine Zurückweisung der Klage gefordert hatte, hält Cox die Vertragsverletzungsklage für begründet, […].“"
                                            },
                                            {
                                                "example_id": "0781a052-f7f0-42ee-8af2-10e57796acb2",
                                                "sense_id": "0d2ba9ab-5f28-3fa3-bf2d-5ab2e1ec34ff",
                                                "text": "„Bedient sich der Antragsteller nicht dieser Formblätter, so liegt ein Verfahrensmangel vor, der zur Zurückweisung des Antrags führt (Artikel 11 Abs. 1 Ziff. a) EuMahnVO).“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "67fda100-9f97-4c76-813d-1d3c8511d1a3",
