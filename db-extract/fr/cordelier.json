                "senses": [
                    {
                        "sense_id": "04febbb7-46e4-3d73-a655-64b8c9d32fb9",
                        "entry_id": "ef9bb86a-f119-33a7-86c4-9cd6f2e9a2df",
                        "glosses": [
                            "Franciscain."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23028729-c93e-4dfb-9573-c770b11fce70",
                                "sense_id": "04febbb7-46e4-3d73-a655-64b8c9d32fb9",
                                "text": "Un religieux cordelier."
                            },
                            {
                                "example_id": "efbd23d0-c7a9-4847-b05f-79509924e941",
                                "sense_id": "04febbb7-46e4-3d73-a655-64b8c9d32fb9",
                                "text": "– L’abbé Thevet, commenta Quintin, religieux de l’ordre des cordeliers et cosmographe du roi."
                            }
                        ]
                    },
                    {
                        "sense_id": "d24db64e-b638-3dcf-bb3b-c6b47a57468f",
                        "entry_id": "ef9bb86a-f119-33a7-86c4-9cd6f2e9a2df",
                        "glosses": [
                            "Relatif au club révolutionnaire des Cordeliers."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5d7a9ba-2385-4d32-996f-be512ae9423a",
                                "sense_id": "d24db64e-b638-3dcf-bb3b-c6b47a57468f",
                                "text": "L’unité cordelière, supposée conjurer la déliaison des individus, est autoritaire et étatiste, imposée d’en haut et identique pour tous."
                            }
                        ]
                    }
                ],
