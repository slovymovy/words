        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "35cb403a-6baf-3e68-baf0-228bb89f2e37",
                "word": "afterlight",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "232e135b-1af1-34c5-9daa-a01c403d8e19",
                        "entry_id": "35cb403a-6baf-3e68-baf0-228bb89f2e37",
                        "glosses": [
                            "Light that follows something, especially the dim light in the sky after the sun has fully set."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "8b67f369-4337-4706-8e86-e646b8a04ccf",
                                "sense_id": "232e135b-1af1-34c5-9daa-a01c403d8e19",
                                "text": "The sun had set some time since, but the landscape was still clear in the mellow afterlight."
                            },
                            {
                                "example_id": "9164777a-4640-4390-b49e-8488c4dd93fd",
                                "sense_id": "232e135b-1af1-34c5-9daa-a01c403d8e19",
                                "text": "1949, Dorothy L. Sayers (translator), The Divine Comedy of Dante Alighieri Cantica 1: Hell, Penguin, Canto 16, p. 170,\nSo may thy soul these many years abide / Housed in thy body, and the after-light / Of fame shine long behind thee,"
                            },
                            {
                                "example_id": "00c59197-5267-4ac9-ac12-1ec887cf0264",
                                "sense_id": "232e135b-1af1-34c5-9daa-a01c403d8e19",
                                "text": "For years they saw each other in full daylight only on Sundays. The rest of the time they spoke or touched or ate in darkness. Predawn darkness and the afterlight of sunset."
                            },
                            {
                                "example_id": "dff78e2d-60ce-42df-8cc8-3312836a4d21",
                                "sense_id": "232e135b-1af1-34c5-9daa-a01c403d8e19",
                                "text": "the simplifying afterlight of metaphor"
                            }
                        ]
                    }
                ],
                "translations": [],
