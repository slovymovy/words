                    },
                    {
                        "translation_id": "9e263c66-ea96-4573-a89e-3e5bf2184ef9",
                        "source_entry_id": "977d101b-8440-33ee-8450-38dca073cbe2",
                        "source_sense_id": "a737f9c6-f80c-31d8-9209-b59cb9a51987",
                        "target_lang_word": "thermodynamique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "thermodynamique",
