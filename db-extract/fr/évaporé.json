                "senses": [
                    {
                        "sense_id": "a081d3b8-1b2a-37c5-84db-b5214061934d",
                        "entry_id": "4b843a78-3143-3e15-a396-8e3d400eff0e",
                        "glosses": [
                            "Personnage qui montre de la légèreté, une certaine légèreté, qui se dissipe."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "49002c4a-9fae-4171-9434-0fbd6e4cf84c",
                                "sense_id": "a081d3b8-1b2a-37c5-84db-b5214061934d",
                                "text": "C’est une évaporée."
                            },
                            {
                                "example_id": "eba27c4e-8822-4043-9974-ea8bd1c75d80",
                                "sense_id": "a081d3b8-1b2a-37c5-84db-b5214061934d",
                                "text": "Un évaporé lui apparaît dont le cerveau se nourrit au jour le jour comme l’estomac, de sorte que la matière lui entrant le matin par les oreilles et lui sortant le soir par le bout de la langue, il reste vide perpétuellement."
                            },
                            {
                                "example_id": "ac0f5a31-5466-4260-a07a-85c9abcaca67",
                                "sense_id": "a081d3b8-1b2a-37c5-84db-b5214061934d",
                                "text": "VARNEY. - Aussi, monsieur Alasco, quelle idée d'aller présenter un philtre soporifique à une jeune fille évaporée qui aurait peur d'un verre d'eau !"
                            }
                        ]
                    }
