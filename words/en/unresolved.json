                    ],
                    "target_lang_definitions": {
                        "ru": "прошедшее время и причастие прошедшего времени от глагола unresolve (лишать решение силы, возвращать к состоянию неопределённости)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вновь сделать нерешённым",
                                "target_lang_sense_clarification": "вернуть вопрос или спор в состояние неопределённости"
                            },
                            {
                                "target_lang_word": "свести на нет решение",
                                "target_lang_sense_clarification": "аннулировать ранее достигнутую договорённость"
                            }
                        ]
                    }
                }
            ]
        }
