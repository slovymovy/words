                ],
                "senses": [
                    {
                        "sense_id": "7efde47a-d668-3601-9e9c-7e7f3906e0a4",
                        "entry_id": "5dd56e3a-b7ce-34e0-91da-e83d744c149a",
                        "glosses": [
                            "Verzicht auf Erhebung an sich fälliger finanzieller Abgaben oder eines Teils davon"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c82854ce-2801-42ce-8957-1d1aeaff3bdc",
                                "sense_id": "7efde47a-d668-3601-9e9c-7e7f3906e0a4",
                                "text": "„Auch die Verbraucherschutzorganisation Foodwatch kritisiert die versprochenen Steuergeschenke und prangert gleichzeitig Parteispenden von Gastro-Unternehmen oder der Fastfood-Kette Mc Donalds an die CDU an.“"
                            },
                            {
                                "example_id": "30271b02-6df4-41bd-b3ad-d92084a3c684",
                                "sense_id": "7efde47a-d668-3601-9e9c-7e7f3906e0a4",
                                "text": "„Die Politik half mit Steuergeschenken; die Nordbank vergab üppige Darlehen.“"
                            },
                            {
                                "example_id": "2dd7c732-1a42-4957-a328-6a2e178b5059",
                                "sense_id": "7efde47a-d668-3601-9e9c-7e7f3906e0a4",
                                "text": "„Union und SPD planen Steuergeschenke für Unternehmen. Arbeitnehmer und insbesondere Geringverdiener gehen dagegen wohl weitgehend leer aus.“"
                            },
                            {
                                "example_id": "998612e4-c7f6-40e8-987c-51bb5e7caa74",
                                "sense_id": "7efde47a-d668-3601-9e9c-7e7f3906e0a4",
                                "text": "[Schlagzeile:] „Ausnahme vom EU-Emissionshandel – Koalition plant weiteres Steuergeschenk für Landwirte“"
                            },
                            {
                                "example_id": "d927ba17-5af6-41ce-8cc6-f268a73db813",
                                "sense_id": "7efde47a-d668-3601-9e9c-7e7f3906e0a4",
                                "text": "„Er fürchtet, am 3. April die Parlamentswahl zu verlieren. Deshalb will der Premier mit Steuergeschenken punkten.“"
                            },
                            {
                                "example_id": "897b29e0-1351-45fc-8dfd-f6664956bd9b",
                                "sense_id": "7efde47a-d668-3601-9e9c-7e7f3906e0a4",
                                "text": "[Schlagzeile:] „Halbe Milliarde Überschuss - Zuger Steuergeschenke – ein Steuerparadies wird paradiesischer“"
                            },
                            {
                                "example_id": "41e8cc48-8373-4037-86b4-5fc6c5368dce",
                                "sense_id": "7efde47a-d668-3601-9e9c-7e7f3906e0a4",
                                "text": "„In der Steuerpolitik wehrt sich die SP gegen «Steuergeschenke an die Reichen» und strebt mit ihrer Forderung nach einer schweizweiten Harmonisierung der Steuersätze nach einer vermehrten Umverteilung von oben nach unten.“"
                            },
                            {
                                "example_id": "8f80df9f-0fb3-4b45-ae58-4ca5621c0cea",
                                "sense_id": "7efde47a-d668-3601-9e9c-7e7f3906e0a4",
                                "text": "„Südkorea hat weltweit die niedrigste Geburtenrate – und der Staat ist verzweifelt. Seit über 20 Jahren schon sollen diverse Steuergeschenke den Frauen die Ehe schmackhaft machen. Aber es klappt nicht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
