                "senses": [
                    {
                        "sense_id": "b0a153a5-1f66-3af9-98ee-8a3131692141",
                        "entry_id": "9aa5bda1-c33b-3a00-a620-8a2f8e962690",
                        "glosses": [
                            "Prendre du poids, prendre une apparence plus grosse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "950e583c-56ed-4f5b-90bc-6a6789d19b2d",
                                "sense_id": "b0a153a5-1f66-3af9-98ee-8a3131692141",
                                "text": "Les dernières semaines, quand elle se mis à grossir rapidement, elle se réjouit qu'André fût loin d'elle, craignant qu'il ne la trouvât enlaidie: l'ovale de son visage s'était empâté un peu, donnant une maturité plus chaude à sa beauté."
                            },
                            {
                                "example_id": "726019d0-d831-4d17-8619-7ccb8a4da632",
                                "sense_id": "b0a153a5-1f66-3af9-98ee-8a3131692141",
                                "text": "Elhamy, de son côté, changeait. Il prenait de l'embonpoint; ses traits s'empâtaient quelque peu."
                            },
                            {
                                "example_id": "0405e539-390a-4721-849c-7fa542fd636d",
                                "sense_id": "b0a153a5-1f66-3af9-98ee-8a3131692141",
                                "text": "Le docteur voudrait bien y croire, il voudrait se masquer l'insoutenable réalité : qu'il est seul, sans acquis, sans passé, avec une intelligence qui s'empâte, un corps qui se défait."
                            }
                        ]
                    }
