                "senses": [
                    {
                        "sense_id": "b5e59c59-e7e0-3014-98a7-69b2371aa85a",
                        "entry_id": "32c2187f-5dbd-33a2-9a51-133d65043ac6",
                        "glosses": [
                            "durch ein Ereignis oder einen Umstand verursachte Beeinträchtigung einer Maschine, eines Motors; Beschädigung oder Defekt einer Maschine"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aea4a817-a37b-48e7-879b-7de7cd7d22f6",
                                "sense_id": "b5e59c59-e7e0-3014-98a7-69b2371aa85a",
                                "text": "„Auch Schnellzüge blieben zuweilen liegen, wenn sie einen Maschinendefekt hatten.“"
                            },
                            {
                                "example_id": "6820e828-795c-4048-a1a2-529232d43c20",
                                "sense_id": "b5e59c59-e7e0-3014-98a7-69b2371aa85a",
                                "text": "„Ich fuhr also hin und gleich mit dem leeren Zug zurück, unterwegs hatte ich einen kleinen Maschinendefekt.“"
                            },
                            {
                                "example_id": "69aca776-03dd-4cfa-9322-6c3b251662a3",
                                "sense_id": "b5e59c59-e7e0-3014-98a7-69b2371aa85a",
                                "text": "„Vorübergehend trieben wir steuerunfähig; wir hatten die Feuer gelöscht, um einen Maschinendefekt zu beseitigen.“"
                            },
                            {
                                "example_id": "36d9b6bb-c93a-48c0-803e-48d01e6ac369",
                                "sense_id": "b5e59c59-e7e0-3014-98a7-69b2371aa85a",
                                "text": "„Es war nichts Ungewöhnliches zu erkennen – einen Maschinendefekt hätte ich im Übrigen längst bemerken müssen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
