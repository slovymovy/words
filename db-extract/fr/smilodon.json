                                        "glosses": [
                                            "Any member of the extinct genus Smilodon, the saber-toothed tigers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6939975-0989-46db-b9db-215e62ed4fe2",
                                                "sense_id": "c043952d-a5ca-3b11-b122-9563c7d2048f",
                                                "text": "From the sound of the smilodon’s roar, I knew he was far off."
                                            }
