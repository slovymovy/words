                ],
                "senses": [
                    {
                        "sense_id": "9a1457f4-8fa0-3de0-8b97-77c002ac69ab",
                        "entry_id": "12d5adae-7779-34c5-8785-ca5a67f784a9",
                        "glosses": [
                            "het kaartspel spelen waarbij schoppenboer zwartepiet heet en de meeste strafpunten oplevert"
                        ],
                        "tags": [
                            "unergative"
                        ],
                        "examples": [
                            {
                                "example_id": "45b1edab-2922-41e9-805a-3a0675a3ffee",
                                "sense_id": "9a1457f4-8fa0-3de0-8b97-77c002ac69ab",
                                "text": "Toen ze aan het zwartepieten waren, vergaten ze even de tijd."
                            },
                            {
                                "example_id": "e1823ac7-f49b-4917-9dde-530c36a53fc3",
                                "sense_id": "9a1457f4-8fa0-3de0-8b97-77c002ac69ab",
                                "text": "Wat heeft de godsdienstige overtuiging te maken met het spel! Weldra verwachten wij nu dat, dit voetspoor volgende, moravische broeders een broeder zullen vragen om mede scheepje te zeilen of te zwarte-pieten; en een christelijk afgescheidene onder het kruis een ander van dezelfde geloofsovertuiging bidt om met hem cricquet te spelen."
                            }
                        ]
                    },
                    {
                        "sense_id": "ce689e93-6ec9-331b-a6ef-0607ce5e4b84",
                        "entry_id": "12d5adae-7779-34c5-8785-ca5a67f784a9",
                        "glosses": [
                            "voortdurend elkaar de schuld proberen te geven"
                        ],
                        "tags": [
                            "figuratively",
                            "unergative"
                        ],
                        "examples": [
                            {
                                "example_id": "0bb482b9-a0e4-4e4a-92aa-9a48849f039a",
                                "sense_id": "ce689e93-6ec9-331b-a6ef-0607ce5e4b84",
                                "text": "Zit toch niet telkens te zwartepieten, jullie twee!"
                            }
                        ]
                    }
                ],
