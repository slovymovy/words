                        "entry_id": "a84b67bf-8a2e-3c7d-9c3b-0f8ab0afac08",
                        "glosses": [
                            "laatste muziekuitvoering die iemand geeft als hij ergens weggaat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ae17cfa-2f6c-4552-84f1-9b1dd15fd75d",
                                "sense_id": "e7d018cd-605b-3dd2-94f0-4b92a6d3b896",
                                "text": "Het orkest ging op 27 augustus 2005 van start. Dirigent van het allereerste uur was Frans Brüggen. Vanmiddag bij het afscheidsconcert stond hij opnieuw voor de Radio Kamer Filharmonie. Samen met Masaaki Suzuki dirigeerde Brüggen het 60-man tellende orkest tijdens het slotoptreden."
                            },
                            {
                                "example_id": "ea24a265-af19-4a97-ab9e-99b37f74b9fb",
                                "sense_id": "e7d018cd-605b-3dd2-94f0-4b92a6d3b896",
                                "text": "Rot was tientallen jaren geleden aanwezig bij het afscheidsconcert van Wham!, vertelt hij. \"We gingen met een aantal fans met een bus van de Hitkrant naar Londen. Ik had er natuurlijk helemaal niet bij stilgestaan dat die hele busreis alleen maar nummers van Wham! gedraaid zouden worden, dus ik werd helemaal gek.\""
                            }
                        ]
                    }
