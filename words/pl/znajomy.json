                    "sense_definition": "Mężczyzna lub chłopak, którego się zna i utrzymuje z nim relacje, zwykle mniej bliskie niż z przyjacielem",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
