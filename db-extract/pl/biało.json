                                "sense_id": "4adc4460-59d3-38bc-b0f9-a391ca8dc529",
                                "text": "Sala jadalna miała bagiety srebrne i była malowana na biało"
                            },
                            {
                                "example_id": "f5203434-530f-47e2-b586-e091e29640ef",
                                "sense_id": "4adc4460-59d3-38bc-b0f9-a391ca8dc529",
                                "text": "Spadł śnieg, zrobiło się biało i jakoś tak świątecznie."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
