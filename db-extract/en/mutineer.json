                        "target_lang_word": "mutin",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mutin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "704dbb0d-4968-3098-b656-343876a7f657",
                                        "entry_id": "9a6d74a9-5f74-3d9d-8960-273dc3df0c9b",
                                        "glosses": [
                                            "Espiègle, badin, moqueur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da7cfdd4-c487-4bd5-984f-79827ace5775",
                                                "sense_id": "704dbb0d-4968-3098-b656-343876a7f657",
                                                "text": "La vie et la jeunesse étalaient leurs trésors sur ce visage mutin."
                                            },
                                            {
                                                "example_id": "3deec970-5b29-49f1-8010-6cf94cbf5b51",
                                                "sense_id": "704dbb0d-4968-3098-b656-343876a7f657",
                                                "text": "La seconde personne était une jeune fille ou plutôt une enfant de quinze ans, à la mine mutine et éveillée, au nez retroussé et au regard hardi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "00e16b9b-025a-333f-83a9-b46fbcdcf663",
                                        "entry_id": "9a6d74a9-5f74-3d9d-8960-273dc3df0c9b",
                                        "glosses": [
                                            "Qui est séditieux, révolté, qui participe à une mutinerie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "badfffc5-483d-47a8-9440-cb02d7157400",
                                                "sense_id": "00e16b9b-025a-333f-83a9-b46fbcdcf663",
                                                "text": "Arrivé rue des Cuirassiers les soldats firent entendre raison aux mutins […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "mutin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "23a6d794-2c20-3ad5-be25-fa3e5194bbef",
                                        "entry_id": "53bfcee5-e66c-3964-8ce0-661fb2d0f3e3",
                                        "glosses": [
                                            "Celui qui est espiègle, badin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eef176d8-98e0-43c9-8fc5-34056e8ccb07",
                                                "sense_id": "23a6d794-2c20-3ad5-be25-fa3e5194bbef",
                                                "text": "Faire le mutin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6bd4a2d6-3f05-31f3-a84c-8fde03b0b0ec",
                                        "entry_id": "53bfcee5-e66c-3964-8ce0-661fb2d0f3e3",
                                        "glosses": [
                                            "Celui qui participe à une mutinerie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0bb415d0-f252-4f82-89df-59ee388c6d2f",
                                                "sense_id": "6bd4a2d6-3f05-31f3-a84c-8fde03b0b0ec",
                                                "text": "Les mutins durent se soumettre."
                                            },
                                            {
                                                "example_id": "0e579541-97cd-4f34-acab-ade38f38f141",
                                                "sense_id": "6bd4a2d6-3f05-31f3-a84c-8fde03b0b0ec",
                                                "text": "Comme un mutin mis aux fers, je restais immobile, et même l’arrivée d’un boulet rouge n'aurait pu parvenir à me faire avancer ou reculer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
