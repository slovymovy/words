{
    "word_family": [
        "spammer"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ba4cd701-ad64-3a06-b5d1-68406e953f0d",
                    "sense_definition": "Unsolicited bulk electronic messages.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "internet_junk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please check your <w>spam</w> folder if you do not see the email in your inbox.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, проверьте папку <w>спам</w>, если вы не видите письма во входящих.",
                                "zh": "如果你在收件箱里没看到邮件，请检查一下你的<w>垃圾邮件</w>文件夹。"
                            }
                        },
                        {
                            "text": "I receive far too much <w>spam</w> advertising products I do not need.",
                            "target_lang_translations": {
                                "ru": "Я получаю слишком много <w>спама</w> с рекламой товаров, которые мне не нужны.",
                                "zh": "我收到了太多推销我不需要的产品的<w>垃圾邮件</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "junk mail",
                        "junk email"
                    ],
                    "antonyms": [
                        "ham"
                    ],
                    "common_phrases": [
                        "spam folder",
                        "spam filter",
                        "mark as spam",
                        "email spam"
                    ],
                    "target_lang_definitions": {
                        "ru": "Массовая рассылка нежелательных электронных сообщений.",
                        "zh": "未经请求的大量电子信息。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спам",
                                "target_lang_sense_clarification": "компьютерный сленг"
                            },
                            {
                                "target_lang_word": "нежелательная почта",
                                "target_lang_sense_clarification": "официальный термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "垃圾邮件",
                                "target_lang_sense_clarification": "指电子邮箱中收到的无用信息"
                            },
                            {
                                "target_lang_word": "垃圾信息",
                                "target_lang_sense_clarification": "泛指各类网络垃圾内容"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "667fa9aa-ff95-35b1-97dd-8bd0e91ab8e7",
                    "sense_definition": "A type of tinned meat made mainly from ham.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "meat_product",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "During the camping trip, we ate fried <w>spam</w> and eggs for breakfast.",
                            "target_lang_translations": {
                                "ru": "В походе мы ели на завтрак жареный <w>спам</w> с яйцами.",
                                "zh": "露营时，我们早餐吃了煎<w>午餐肉</w>配鸡蛋。"
                            }
                        },
                        {
                            "text": "He made a simple sandwich using a slice of <w>spam</w>.",
                            "target_lang_translations": {
                                "ru": "Он сделал простой бутерброд с ломтиком <w>спама</w>.",
                                "zh": "他用一片<w>午餐肉</w>做了一个简单的三明治。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "tin of spam",
                        "fried spam"
                    ],
                    "target_lang_definitions": {
                        "ru": "Разновидность мясных консервов, изготовленных в основном из ветчины.",
                        "zh": "一种主要由猪肉制成的罐装肉类产品。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "консервированная ветчина",
                                "target_lang_sense_clarification": "описание продукта"
                            },
                            {
                                "target_lang_word": "спам",
                                "target_lang_sense_clarification": "название продукта, ставшее нарицательным"
                            },
                            {
                                "target_lang_word": "тушёнка",
                                "target_lang_sense_clarification": "культурный аналог (мясные консервы)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "午餐肉",
                                "target_lang_sense_clarification": "常见的罐装肉类食品"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "acc6f90b-ff6e-3a35-bae5-6f9be4008e2b",
                    "sense_definition": "To send unsolicited electronic messages.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "internet_junk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hackers often <w>spam</w> users with links to malicious websites.",
                            "target_lang_translations": {
                                "ru": "Хакеры часто <w>спамят</w> пользователям ссылками на вредоносные сайты.",
                                "zh": "黑客经常向用户<w>滥发</w>带有恶意网站链接的信息。"
                            }
                        },
                        {
                            "text": "Please do not <w>spam</w> the group chat with unnecessary messages.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, не <w>спамь</w> в групповой чат ненужными сообщениями.",
                                "zh": "请不要在群聊里<w>刷</w>屏发送无用的消息。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "spam the inbox",
                        "stop spamming"
                    ],
                    "target_lang_definitions": {
                        "ru": "Рассылать нежелательные электронные сообщения.",
                        "zh": "发送未经请求的电子信息。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спамить",
                                "target_lang_sense_clarification": "компьютерный сленг"
                            },
                            {
                                "target_lang_word": "рассылать спам",
                                "target_lang_sense_clarification": "действие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "发送垃圾邮件",
                                "target_lang_sense_clarification": "指发送垃圾信息的行为"
                            },
                            {
                                "target_lang_word": "滥发",
                                "target_lang_sense_clarification": "指无节制地发送信息"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cba35d3c-2dff-3176-a46d-af0c02fdbe52",
                    "sense_definition": "To do something rapidly and repeatedly.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "repetitive_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You need to <w>spam</w> the attack key to defeat the enemy quickly.",
                            "target_lang_translations": {
                                "ru": "Тебе нужно <w>спамить</w> кнопку атаки, чтобы быстро победить врага.",
                                "zh": "你需要<w>狂按</w>攻击键才能快速击败敌人。"
                            }
                        },
                        {
                            "text": "The player was disqualified for <w>spamming</w> the same move over and over.",
                            "target_lang_translations": {
                                "ru": "Игрока дисквалифицировали за то, что он <w>спамил</w> один и тот же прием снова и снова.",
                                "zh": "该玩家因不断<w>刷</w>同一个招式而被取消了比赛资格。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "spam buttons",
                        "spam attacks"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "often used in gaming contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Делать что-то быстро и многократно (обычно в видеоиграх).",
                        "zh": "快速且重复地执行某项操作（通常用于电子游戏）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спамить",
                                "target_lang_sense_clarification": "игровой сленг"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "狂按",
                                "target_lang_sense_clarification": "指在游戏中快速重复点击按键"
                            },
                            {
                                "target_lang_word": "刷",
                                "target_lang_sense_clarification": "指重复使用同一技能或动作"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "61e87d83-473e-396e-865c-eb78383b691e",
                    "sense_definition": "A brand of tinned meat product.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "meat_product",
                    "name_type": "brand_or_product_name",
                    "examples": [
                        {
                            "text": "My grandmother always keeps a can of <w>SPAM</w> in the cupboard.",
                            "target_lang_translations": {
                                "ru": "Моя бабушка всегда держит в шкафу банку <w>SPAM</w>.",
                                "zh": "我奶奶总是在橱柜里放一罐<w>世棒</w>午餐肉。"
                            }
                        },
                        {
                            "text": "Soldiers were issued <w>SPAM</w> as part of their rations during the war.",
                            "target_lang_translations": {
                                "ru": "Во время войны солдатам выдавали <w>SPAM</w> как часть пайка.",
                                "zh": "战争期间，士兵们的配给中包含<w>世棒</w>午餐肉。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Бренд мясных консервов.",
                        "zh": "一种罐装肉类产品的品牌名称。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "SPAM",
                                "target_lang_sense_clarification": "торговая марка"
                            },
                            {
                                "target_lang_word": "Спам",
                                "target_lang_sense_clarification": "транслитерация бренда"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "世棒",
                                "target_lang_sense_clarification": "SPAM午餐肉的官方中文译名"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}