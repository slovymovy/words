                        "examples": [
                            {
                                "example_id": "41b7f225-296d-4062-a3e9-fe89c42fefa2",
                                "sense_id": "b3fee9af-9933-3f66-bbd7-f112b92f3b8e",
                                "text": "Zu beachten ist, daß die diachronen Sprachperioden des Niederländischen um 100 bis 150 Jahre nach den deutschen Perioden zu datieren sind: dem Stand des Althochdeutschen von 750–1050 entspricht das Altniederfränkische (nicht vor 900), dem Mittelhochdeutschen (1050–1350) das Mittelniederländische (ab 1200)."
                            },
                            {
                                "example_id": "1669d646-e57d-4a8f-8c2d-7996b3b133a9",
                                "sense_id": "b3fee9af-9933-3f66-bbd7-f112b92f3b8e",
                                "text": "Altniederfränkisch (auch: Altniederländisch) Bez. [= Bezeichnung] für die vom Beginn der Überlieferung (9. Jh. [= neuntes Jahrhundert]) bis ins 12. Jh. [= zwölfte Jahrhundert] nur spärl. [= spärlich] belegte Frühstufe des ↗ Niederländischen. Zusammen mit dem Altsächsischen wird das A. auch i. w. S. als Altniederdeutsch bezeichnet.\n Altniederländisch ↗ Altniederfränkisch"
                            }
                        ]
                    }
