{
    "word_family": [
        "complex"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8594542f-30db-33ae-bfd9-26e14bd83357",
                    "sense_definition": "The natural color, texture, and appearance of the skin on a person's face.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She has a very clear and healthy <w>complexion</w>.",
                            "target_lang_translations": {
                                "cs": "Má velmi čistou a zdravou <w>pleť</w>."
                            }
                        },
                        {
                            "text": "The cold winter air made his <w>complexion</w> look pale.",
                            "target_lang_translations": {
                                "cs": "Studený zimní vzduch způsobil, že jeho <w>pleť</w> vypadala bledě."
                            }
                        }
                    ],
                    "synonyms": [
                        "skin"
                    ],
                    "common_phrases": [
                        "clear complexion",
                        "pale complexion"
                    ],
                    "target_lang_definitions": {
                        "cs": "Přirozená barva, textura a vzhled kůže na obličeji."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "pleť",
                                "target_lang_sense_clarification": "vzhled a stav kůže na obličeji"
                            },
                            {
                                "target_lang_word": "barva pleti",
                                "target_lang_sense_clarification": "odkazuje specificky na odstín pokožky"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "93604e96-174e-3136-b3ed-51809ce95e96",
                    "sense_definition": "The general character or outward appearance of a situation or event.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new evidence completely changed the <w>complexion</w> of the investigation.",
                            "target_lang_translations": {
                                "cs": "Nové důkazy zcela změnily <w>ráz</w> vyšetřování."
                            }
                        },
                        {
                            "text": "The sudden goal changed the whole <w>complexion</w> of the game.",
                            "target_lang_translations": {
                                "cs": "Náhlý gól změnil celou <w>podobu</w> zápasu."
                            }
                        }
                    ],
                    "synonyms": [
                        "nature",
                        "character"
                    ],
                    "common_phrases": [
                        "change the complexion"
                    ],
                    "target_lang_definitions": {
                        "cs": "Celkový charakter nebo vnější podoba situace či události."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "ráz",
                                "target_lang_sense_clarification": "celkový charakter nebo povaha situace"
                            },
                            {
                                "target_lang_word": "podoba",
                                "target_lang_sense_clarification": "způsob, jakým se věc jeví nebo vyvíjí"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "98d716e3-e288-3bc6-a6bb-978d3932ef0c",
                    "sense_definition": "A person's general attitude, outlook, or point of view.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "attitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The committee has a very conservative <w>complexion</w>.",
                            "target_lang_translations": {
                                "cs": "Výbor má velmi konzervativní <w>zaměření</w>."
                            }
                        },
                        {
                            "text": "His political <w>complexion</w> shifted after he moved to the city.",
                            "target_lang_translations": {
                                "cs": "Jeho politická <w>orientace</w> se změnila poté, co se přestěhoval do města."
                            }
                        }
                    ],
                    "synonyms": [
                        "outlook",
                        "disposition"
                    ],
                    "target_lang_definitions": {
                        "cs": "Osobní postoj, názor nebo úhel pohledu."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "zaměření",
                                "target_lang_sense_clarification": "ideové nebo politické směřování"
                            },
                            {
                                "target_lang_word": "orientace",
                                "target_lang_sense_clarification": "názorové ukotvení jednotlivce či skupiny"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f16fd568-af97-3488-a838-1dde56a875c0",
                    "sense_definition": "A person's physical temperament or constitution, historically believed to be determined by the balance of bodily humors.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "attitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ancient doctors believed that a person's <w>complexion</w> was determined by their internal balance.",
                            "target_lang_translations": {
                                "cs": "Antičtí lékaři věřili, že <w>temperament</w> člověka je určen jeho vnitřní rovnováhou."
                            }
                        },
                        {
                            "text": "He was described as having a melancholic <w>complexion</w>.",
                            "target_lang_translations": {
                                "cs": "Byl popisován jako člověk s melancholickou <w>konstitucí</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "temperament",
                        "constitution"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Refers to historical medical theory."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Fyzický temperament nebo konstituce, historicky spojováno s rovnováhou tělesných šťáv."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "temperament",
                                "target_lang_sense_clarification": "vrozená povaha a psychické založení"
                            },
                            {
                                "target_lang_word": "konstituce",
                                "target_lang_sense_clarification": "tělesné a duševní založení člověka"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "af3700ac-bd8d-3346-b557-1f059b603148",
                    "sense_definition": "A specific arrangement or configuration of components within a system.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "arrangement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The statistical <w>complexion</w> of the data set was analyzed by the researchers.",
                            "target_lang_translations": {
                                "cs": "Statistické <w>složení</w> datového souboru bylo analyzováno výzkumníky."
                            }
                        },
                        {
                            "text": "The mathematical <w>complexion</w> of the model was quite complex.",
                            "target_lang_translations": {
                                "cs": "Matematická <w>konfigurace</w> modelu byla poměrně složitá."
                            }
                        }
                    ],
                    "synonyms": [
                        "configuration",
                        "arrangement"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Used in specific scientific or technical contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Specifické uspořádání nebo konfigurace komponent v systému."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "složení",
                                "target_lang_sense_clarification": "způsob, jakým je něco sestaveno"
                            },
                            {
                                "target_lang_word": "konfigurace",
                                "target_lang_sense_clarification": "technické uspořádání prvků"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f6214e6b-6eb2-3248-9942-d52e0de9389c",
                    "sense_definition": "To give a specific color or appearance to something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The author <w>complexioned</w> her characters with vivid descriptions of their surroundings.",
                            "target_lang_translations": {
                                "cs": "Autorka <w>zabarvila</w> své postavy živými popisy jejich okolí."
                            }
                        },
                        {
                            "text": "The sunset <w>complexioned</w> the sky in shades of orange and purple.",
                            "target_lang_translations": {
                                "cs": "Západ slunce <w>zabarvil</w> oblohu do odstínů oranžové a fialové."
                            }
                        }
                    ],
                    "synonyms": [
                        "color",
                        "tint"
                    ],
                    "target_lang_definitions": {
                        "cs": "Dodat něčemu specifickou barvu nebo vzhled."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "zabarvit",
                                "target_lang_sense_clarification": "dodat odstín nebo charakter"
                            },
                            {
                                "target_lang_word": "dodat ráz",
                                "target_lang_sense_clarification": "ovlivnit celkový vzhled či vyznění"
                            }
                        ]
                    }
                }
            ]
        }
    ]
