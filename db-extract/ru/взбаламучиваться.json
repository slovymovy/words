                "senses": [
                    {
                        "sense_id": "4610b303-42c7-3a0b-a1b8-babb76923a37",
                        "entry_id": "4d70335e-6fad-3c96-9cc1-4189fa569718",
                        "glosses": [
                            "разг. покрываться рябью, волнами; становиться мутным (о воде)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07441ece-1181-449e-94b0-a7dafaa98ede",
                                "sense_id": "4610b303-42c7-3a0b-a1b8-babb76923a37",
                                "text": "Вода вблизи катеров клокотала, взбаламучивалась, и чайки, крича, шарахались над мачтами."
                            },
                            {
                                "example_id": "8276ea79-741d-45a9-afee-93e64fd74009",
                                "sense_id": "4610b303-42c7-3a0b-a1b8-babb76923a37",
                                "text": "Среди белорусского народа, особенно в северных поветах, распространено поверье, что ровно в полночь, как запоёт петух, лес начинает шуметь, а вода в озёрах взбаламучивается."
                            }
                        ]
                    }
