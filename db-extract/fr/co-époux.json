                    {
                        "sense_id": "795bbbdb-fb64-30b6-9eac-0119b0d3bd3d",
                        "entry_id": "31a4efe6-fd7b-3e65-b484-5e628d76d9f7",
                        "glosses": [
                            "Autre époux dans un mariage polyandre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d198661-8f0c-45ed-a12c-a95199f4c1c9",
                                "sense_id": "795bbbdb-fb64-30b6-9eac-0119b0d3bd3d",
                                "text": "Comme la polyandrie est inconnue des Daza, aucun terme ne désigne, pour un homme, le co-époux."
                            },
                            {
                                "example_id": "34eb56e9-1956-4afb-9394-63dfab49f2d2",
                                "sense_id": "795bbbdb-fb64-30b6-9eac-0119b0d3bd3d",
                                "text": "De la même manière, puisqu’un frère et une sœur sont une seule personne, leurs femme et mari respectifs sont également co-époux."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "388d7c0c-53bf-4672-97f6-731ad03333e2",
                        "source_entry_id": "31a4efe6-fd7b-3e65-b484-5e628d76d9f7",
