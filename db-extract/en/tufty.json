    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "92ed3abb-e21c-35fa-bd6d-37cbcbfcd3cd",
                "word": "tufty",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "a2a0c0b6-4216-4cf3-ba42-68b8381801db",
                        "entry_id": "92ed3abb-e21c-35fa-bd6d-37cbcbfcd3cd",
                        "tags": [
                            "comparative"
                        ],
                        "form": "tuftier"
                    },
                    {
                        "form_id": "2324a26a-c176-41c0-b0e3-ee71758957ca",
                        "entry_id": "92ed3abb-e21c-35fa-bd6d-37cbcbfcd3cd",
                        "tags": [
                            "superlative"
                        ],
                        "form": "tuftiest"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "42ee8c51-d5ae-304b-93fd-922220ad08f0",
                        "entry_id": "92ed3abb-e21c-35fa-bd6d-37cbcbfcd3cd",
                        "glosses": [
                            "Having the form of or resembling a tuft (“a bunch of grass, hair, etc., held together at the base”)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4950778d-e027-49e2-81a9-95e8fa62cb9f",
                                "sense_id": "42ee8c51-d5ae-304b-93fd-922220ad08f0",
                                "text": "There was a bed of nothing but mignonette and another of nothing but pansies—borders of double and single daisies and all kinds of little tufty plants she had never seen before."
                            },
                            {
                                "example_id": "95416ed3-cf49-46ec-936a-2f174e652ae4",
                                "sense_id": "42ee8c51-d5ae-304b-93fd-922220ad08f0",
                                "text": "Here he stood for a moment looking up and down the narrow road and the heavy snowflakes covered his shoulders and his tufty, ill-kempt hair."
                            },
                            {
                                "example_id": "221a53f8-fff5-4477-bac2-efcec141fa36",
                                "sense_id": "42ee8c51-d5ae-304b-93fd-922220ad08f0",
                                "text": "In recent years Nelson has grown a mustache, a tufty brown smudge not much wider than his nose."
                            }
                        ]
                    },
                    {
                        "sense_id": "667d1956-9aad-3141-8ab4-36b9474a430b",
                        "entry_id": "92ed3abb-e21c-35fa-bd6d-37cbcbfcd3cd",
                        "glosses": [
                            "Covered in or having many tufts."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ed22df3-0648-4a0c-8216-6b535e978d08",
                                "sense_id": "667d1956-9aad-3141-8ab4-36b9474a430b",
                                "text": "Witneſs, thou best Anâna, thou the pride / Of vegetable life, beyond whate’er / The poets imaged in the golden age: / Quick let me strip thee of thy tufty coat, / Spread thy ambroſial ſtores, and feaſt with Jove!"
                            },
                            {
                                "example_id": "4c5b12b7-cb3a-432e-aa8b-7b95fb2437ec",
                                "sense_id": "667d1956-9aad-3141-8ab4-36b9474a430b",
                                "text": "In and out of the tufts they went, with their eyes dilating; wishing to be out of harm, if conscience were but satisfied. And of this tufty flaggy ground, pocked with bogs and boglets, one especial nature is that it will not hold impressions."
                            }
                        ]
                    },
                    {
                        "sense_id": "40079eda-263c-3e39-9534-0d2ad4981910",
                        "entry_id": "92ed3abb-e21c-35fa-bd6d-37cbcbfcd3cd",
                        "glosses": [
                            "Covered in or having many tufts.",
                            "Covered with tufts (“small clumps of bushes or trees”)."
                        ],
                        "tags": [
                            "obsolete",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "7921ecc3-b789-4dd3-af84-6054ed73337e",
                                "sense_id": "40079eda-263c-3e39-9534-0d2ad4981910",
                                "text": "The Sylvans that about the neighbouring vvoods did dvvell, / Both in the tufty Frith and in the moſſy Fell, / Forſook their gloomy Bovvres, and vvandred farre abroad, / Expeld their quiet fears, and place of their abode, […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "d2b0b80d-bc14-3fbf-bb2e-20bc92affb8f",
                        "entry_id": "92ed3abb-e21c-35fa-bd6d-37cbcbfcd3cd",
                        "glosses": [
                            "Growing in tufts."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2698fbe5-ec65-4e46-abf0-fb29c04b90d5",
                                "sense_id": "d2b0b80d-bc14-3fbf-bb2e-20bc92affb8f",
                                "text": "If you haue ſeene at foot of ſome braue hill, / Tvvo Springs ariſe, and delicately trill, / In gentle chidings through an humble dale, / (VVhere tufty Daizies nod at euery gale) […]"
                            }
                        ]
                    }
                ],
