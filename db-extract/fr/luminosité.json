        "fr-extract.jsonl": [
            {
                "entry_id": "f97d2b5c-b450-34cb-b9d5-4db85e2da14f",
                "word": "luminosité",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "83656b5d-d264-49d7-a914-645db3f9f7f9",
                        "entry_id": "f97d2b5c-b450-34cb-b9d5-4db85e2da14f",
                        "tags": [
                            "plural"
                        ],
                        "form": "luminosités"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "29f37e3b-aee7-356f-8d5e-ee6b9d55559d",
                        "entry_id": "f97d2b5c-b450-34cb-b9d5-4db85e2da14f",
                        "glosses": [
                            "Qualité de ce qui est lumineux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4eae170-1981-4418-96df-cd3e9426fb8d",
                                "sense_id": "29f37e3b-aee7-356f-8d5e-ee6b9d55559d",
                                "text": "Les paramètres numériques de dérawtisation (luminosité, facteur de contraste, saturation des teintes, netteté, accentuation, filtres, etc.) ont été testés comparativement, avant leur sélection définitive."
                            }
                        ]
                    },
                    {
                        "sense_id": "0853025e-e74c-31bd-9f0f-7b682186fe18",
                        "entry_id": "f97d2b5c-b450-34cb-b9d5-4db85e2da14f",
                        "glosses": [
                            "Énergie rayonnée par unité de temps par un astre, mesurée en watt, en erg par seconde ou en luminosité solaire."
                        ],
                        "tags": [],
                        "note": "à ne pas confondre avec l’intensité lumineuse",
                        "examples": []
                    },
                    {
                        "sense_id": "7d69a1f2-4be4-350c-af45-33f13526d4a8",
                        "entry_id": "f97d2b5c-b450-34cb-b9d5-4db85e2da14f",
                        "glosses": [
                            "Taux d’évènements qu’un détecteur est susceptible d’enregistrer."
                        ],
                        "tags": [
                            "physical"
                        ],
                        "examples": [
                            {
                                "example_id": "9ca827e0-058a-4632-810a-3dccfac6ff4c",
                                "sense_id": "7d69a1f2-4be4-350c-af45-33f13526d4a8",
                                "text": "Le nombre de collisions qui se produisent lors d’une réaction particulière entre particules élémentaires est alors simplement l’intégrale de la luminosité multipliée par la section efficace (exprimée en cm²) pour cette réaction, ce qui donne une expression de sa probabilité."
                            }
                        ]
                    },
                    {
                        "sense_id": "9b36a1bf-e067-3613-83bd-8591d9884597",
                        "entry_id": "f97d2b5c-b450-34cb-b9d5-4db85e2da14f",
                        "glosses": [
                            "Caractère d’une couleur qui produit sur l’œil une sensation lumineuse de niveau élevé. Note : le terme clarté est employé pour un objet coloré et le terme luminosité pour une source de lumière."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "57122352-6159-4f92-b46d-798ec5be4599",
                        "source_entry_id": "f97d2b5c-b450-34cb-b9d5-4db85e2da14f",
                        "target_lang_word": "luminosity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "luminosity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "85962a4a-ab73-3bf2-9159-409db78092c6",
                                        "entry_id": "a34151c5-1f32-38d3-82c2-262f5645ef12",
                                        "glosses": [
                                            "the state of being luminous, or a luminous object; brilliance or radiance"
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "08621518-7f8a-344b-a6d9-dea9e381c9a4",
                                        "entry_id": "a34151c5-1f32-38d3-82c2-262f5645ef12",
                                        "glosses": [
                                            "the ratio of luminous flux to radiant flux at the same wavelength; the luminosity factor"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "444edf01-d860-3f54-9f04-d5100024b10e",
                                        "entry_id": "a34151c5-1f32-38d3-82c2-262f5645ef12",
                                        "glosses": [
                                            "The rate at which a star radiates energy in all directions."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ace6c75d-b8bd-4f29-b208-d83e04520753",
                                                "sense_id": "444edf01-d860-3f54-9f04-d5100024b10e",
                                                "text": "We recognize the same pattern as in the left panel, with dM stars being much less frequent flarers than dMe stars of similar luminosity."
                                            },
                                            {
                                                "example_id": "8db37e63-8f5b-4bb0-9fcd-fbc59c624a23",
                                                "sense_id": "444edf01-d860-3f54-9f04-d5100024b10e",
                                                "text": "We derive rotation periods, photometric activity indices, flaring energies, mass loss rates, gyrochronological ages, X-ray luminosities and consider implications for the planetary magnetospheres and habitability."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
