                "senses": [
                    {
                        "sense_id": "75996bd0-65ee-3fac-bd16-47c0dbc9c223",
                        "entry_id": "87497a0b-7ee5-318b-9a23-5ef160905a57",
                        "glosses": [
                            "Donner un caractère entrepreneurial à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75a0f1b5-c54b-418c-b54d-efb44401ddc4",
                                "sense_id": "75996bd0-65ee-3fac-bd16-47c0dbc9c223",
                                "text": "Pour cela, on l'adore, qu'il s'agisse du chef, cadre sup bien entrepreneurialisé, ou de la gentille collègue avec qui pourrait naître une idylle (idylle qui aura d'ailleurs le dernier mot...)."
                            },
                            {
                                "example_id": "d188ace7-a132-4eab-b829-b4ccc2d880cd",
                                "sense_id": "75996bd0-65ee-3fac-bd16-47c0dbc9c223",
                                "text": "Ce projet fait partie du processus visant à « entrepreneurialiser » le système collégial, c’est-à-dire à montrer aux professeurs comment offrir des cours davantage axés sur l’entrepreneurship et à gérer le campus d’une manière entrepreneuriale."
                            },
                            {
                                "example_id": "e56290f7-d72f-47f2-b5c0-297db1f0b965",
                                "sense_id": "75996bd0-65ee-3fac-bd16-47c0dbc9c223",
                                "text": "Et les \"Larzac\" eux-mêmes sont entrepreneurialisés, zadés, tourismisés."
                            }
                        ]
                    }
