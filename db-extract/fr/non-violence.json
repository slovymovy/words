                "forms": [
                    {
                        "form_id": "fe95955d-9c9c-4548-bd4f-b967dac431ef",
                        "entry_id": "7ec8af20-d426-3fba-9343-64c3ce8eb3e9",
                        "tags": [
                            "plural"
                        ],
                        "form": "non-violences"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9e2d93d7-7dac-3132-a3e2-956e544f5788",
                        "entry_id": "7ec8af20-d426-3fba-9343-64c3ce8eb3e9",
                        "glosses": [
                            "Philosophie et pratique politique qui rejette le recours à la violence comme solution aux conflits."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7b16e56-257e-4d8d-80fb-d2262dd83183",
                                "sense_id": "9e2d93d7-7dac-3132-a3e2-956e544f5788",
                                "text": "Peu de chefs religieux bénéficient d’une réputation aussi enviable que celle de Tenzin Gyasto, […]. Ses discours font toujours appel à la compassion et à la non-violence pour trouver des solutions pacifiques aux conflits mondiaux, incluant celui qui l’oppose à la Chine. Cela lui vaudra d’ailleurs le prix Nobel de la paix en 1989."
                            },
                            {
                                "example_id": "2d2bdb0e-7639-4efe-99e5-b4b42aab6e17",
                                "sense_id": "9e2d93d7-7dac-3132-a3e2-956e544f5788",
                                "text": "Les pratiques « musclées » des « Zadistes » et leur hostilité à l’égard des médias tranchent avec la non-violence des militants du Larzac et pourraient à un moment donné, leur valoir moins de sympathie dans l’opinion."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c0f80963-153e-4c61-8bee-6f387a23dccb",
                        "source_entry_id": "7ec8af20-d426-3fba-9343-64c3ce8eb3e9",
                        "source_sense_id": "9e2d93d7-7dac-3132-a3e2-956e544f5788",
                        "target_lang_word": "nonviolence",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nonviolence",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c2ea711b-98af-31fb-b8c3-fb3eee967419",
                                        "entry_id": "8b0c9d2d-5615-3ea4-b1c5-c5bd11519c1d",
                                        "glosses": [
                                            "A philosophy that rejects the use of violence, and instead seeks to bring about change through peaceful responses even to violent acts."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f7da441-61db-4a46-8e50-ed96f2d7da6a",
                                                "sense_id": "c2ea711b-98af-31fb-b8c3-fb3eee967419",
                                                "text": "From this theological perspective, the spectrum of violences has to give way to a spectrum of nonviolences."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
