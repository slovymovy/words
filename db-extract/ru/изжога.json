                        "cross_references": []
                    },
                    {
                        "translation_id": "179b5b41-8c3c-4584-b263-8abb48bf3f4e",
                        "source_entry_id": "6cebfa69-0524-368a-8991-21d72b2e4897",
                        "target_lang_word": "Sodbrennen",
