                        "sense_id": "6d609e8f-626d-357a-97a9-2761905ec56d",
                        "entry_id": "c0b87404-73eb-3635-9041-61d6d1717010",
                        "glosses": [
                            "Rüpelhaftigkeit, Tollpatschigkeit, Dummheit, Einfalt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fde88129-1397-4f7f-8188-ee340b4796a2",
                                "sense_id": "6d609e8f-626d-357a-97a9-2761905ec56d",
                                "text": "\"Or did the swan give you the secret gift of oafishness?\""
                            }
                        ],
