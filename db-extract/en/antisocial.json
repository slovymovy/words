                    {
                        "sense_id": "77d18ba7-ad78-3ca5-b941-89e7c102a15f",
                        "entry_id": "032c77d3-936a-3e47-b648-cdfccd9dbb2e",
                        "glosses": [
                            "Opposed to social order or the principles of society; hostile toward society."
                        ],
                        "tags": [],
