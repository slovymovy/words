                ],
                "senses": [
                    {
                        "sense_id": "a835d674-814b-3459-9d14-19810e4a15e7",
                        "entry_id": "1c41d5c5-318d-3ec2-8315-5ba81e971b2e",
                        "glosses": [
                            "Strecke, die von Händlern benutzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa0ced66-81a8-4ea3-a609-77f066ec57ca",
                                "sense_id": "a835d674-814b-3459-9d14-19810e4a15e7",
                                "text": "„Für das aufblühende Haithabu ist das Danewerk lebenswichtig, denn es schützt den Handelsweg zwischen beiden Meeren.“"
                            },
                            {
                                "example_id": "0e195bea-9f97-4e31-9e89-9e4e79ffa4aa",
                                "sense_id": "a835d674-814b-3459-9d14-19810e4a15e7",
                                "text": "„Als die Franzosen erkannten, dass nicht der Mekong, sondern der Rote Fluss den Handelsweg nach China öffnete, verlagerte sich ihr Interesse nach Norden.“"
                            },
                            {
                                "example_id": "79bce5b7-4575-46ad-a795-301421adef48",
                                "sense_id": "a835d674-814b-3459-9d14-19810e4a15e7",
                                "text": "„Bagamoyo war Anfang und Ende großer Handelswege und Karawanenstraßen.“"
                            },
                            {
                                "example_id": "6d1ccde2-18e9-4c94-89f6-636b7afc088c",
                                "sense_id": "a835d674-814b-3459-9d14-19810e4a15e7",
                                "text": "„Auf der Karte sind Flüsse, Städte, Straßen und Handelswege dargestellt, und das auf dem gesamten Gebiet von Britannien bis Indien.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
