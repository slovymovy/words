                        "sense_id": "1f19e755-68db-33df-a4b6-da8a72b783b3",
                        "entry_id": "7e965b42-f985-3df2-8b6d-2ec6e85b56e5",
                        "glosses": [
                            "Petit fragment de plante cultivé dans un milieu de culture pour multiplier la plante d’origine à l’identique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be2f749c-fbcd-4167-bfbc-5f714d2e8052",
                                "sense_id": "1f19e755-68db-33df-a4b6-da8a72b783b3",
                                "text": "Des pépins, graines ou microboutures qui, entre ses doigts d’or, deviennent arbres aux fruits orange, verts, rouges ou roses."
                            },
                            {
                                "example_id": "976db42a-5c2c-4c3f-9f9f-efce8ba92698",
                                "sense_id": "1f19e755-68db-33df-a4b6-da8a72b783b3",
                                "text": "La multiplication des microboutures au cours des subcultures est caractérisée par une évolution de l’état physiologique qui dépend de l’âge, des réserves nutritives et du milieu de culture."
                            },
                            {
                                "example_id": "401fd5c0-16cf-4b64-912f-a1b7ff8d6281",
                                "sense_id": "1f19e755-68db-33df-a4b6-da8a72b783b3",
                                "text": "La capacité d’enracinement in vitro de microboutures du porte-greffe de pommier M9 (Jork 9) a été notablement augmentée en fendant la partie basale (2 mm)."
                            }
                        ]
                    }
