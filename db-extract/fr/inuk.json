                    {
                        "sense_id": "87531a0e-e49c-394d-bc68-8ec86204c707",
                        "entry_id": "66cc35c2-34ee-3334-9ae7-6a37cee5f074",
                        "glosses": [
                            "Individu inuit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f375c81-2196-41b1-816c-4047995549aa",
                                "sense_id": "87531a0e-e49c-394d-bc68-8ec86204c707",
                                "text": "Ensemble ils s’étaient rendu jusqu'au bord de cette rivière découverte par l’Inuk."
                            },
                            {
                                "example_id": "f5d5f8c1-8660-4ef0-937a-200df5465d99",
                                "sense_id": "87531a0e-e49c-394d-bc68-8ec86204c707",
                                "text": "Il n’a pas appris à vivre avec les autres, il est donc maladroit, peu chaleureux, ce qui le singularise, et ce n’est pas une bonne chose pour un Inuk."
                            },
                            {
                                "example_id": "64c2acc7-b69c-4e3f-9af6-e8bceea2d6d6",
                                "sense_id": "87531a0e-e49c-394d-bc68-8ec86204c707",
                                "text": "En juillet, l’Inuk Mary Simon est devenue la première gouverneure générale autochtone du Canada."
                            }
                        ]
                    }
