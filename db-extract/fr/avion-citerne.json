                "translations": [
                    {
                        "translation_id": "ac734ee1-eb40-4e4e-8072-8d4805e31391",
                        "source_entry_id": "28629fb9-5ee7-3e36-bc3b-58590cbddb67",
                        "source_sense_id": "2b30f5d2-e1e6-360e-b10e-97d9729ca244",
                        "source_sense_description": "Luftfahrt: Tankflugzeug",
                        "target_lang_word": "Tankflugzeug",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tankflugzeug",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5edde347-6f58-34b5-94b0-0fec18001241",
                                        "entry_id": "6bbab390-6381-3822-9a39-9920b1d5eefc",
                                        "glosses": [
                                            "Flugzeug, das andere Flugzeuge während des Flugs mit Treibstoff versorgen kann"
                                        ],
                                        "tags": [
                                            "Luftfahrt"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7154a32b-0197-4622-a600-b9ab7d1b142d",
                                                "sense_id": "5edde347-6f58-34b5-94b0-0fec18001241",
                                                "text": "„Bei dem sogenannten Probe-and-drogue-System wird vom Tankflugzeug ein flexibler Schlauch mit einem kleinen Bremsschirm am Ende abgelassen.“"
                                            },
                                            {
                                                "example_id": "06debb19-6950-4813-9984-2c1e4422be8d",
                                                "sense_id": "5edde347-6f58-34b5-94b0-0fec18001241",
                                                "text": "„Für Airbus ist es ein Debakel: Der erhoffte Milliardendeal mit dem Pentagon ist geplatzt, die Europäer werden keine Tankflugzeuge liefern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "12a60382-df8e-40ed-9739-54dbf8b77720",
                        "source_entry_id": "28629fb9-5ee7-3e36-bc3b-58590cbddb67",
                        "source_sense_id": "25f39f2d-ac84-3a95-8606-809946507d64",
                        "source_sense_description": "regional (Kanada), Luftfahrt: Löschflugzeug",
                        "target_lang_word": "Löschflugzeug",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Löschflugzeug",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cfacbf35-01d5-3aa1-93f3-c8ef6ca17f3f",
                                        "entry_id": "e5b053e1-2960-318c-bbae-377f10211f7a",
                                        "glosses": [
                                            "Flugzeug, das speziell für die Bekämpfung von Bränden ausgerüstet ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7aabff2f-cc1a-4707-8e67-49d4cfc1161d",
                                                "sense_id": "cfacbf35-01d5-3aa1-93f3-c8ef6ca17f3f",
                                                "text": "Erst durch den Einsatz der Löschflugzeuge konnte der Waldbrand unter Kontrolle gebracht werden."
                                            },
                                            {
                                                "example_id": "5e4c6f3a-5e65-4157-9665-6800a1953235",
                                                "sense_id": "cfacbf35-01d5-3aa1-93f3-c8ef6ca17f3f",
                                                "text": "„Es sind spezielle Löschflugzeuge, die im Flug aus Seen oder aus dem Meer durch Saugstutzen ihren Leib mit 5 Tonnen Wasser füllen.“"
                                            },
                                            {
                                                "example_id": "3a5948bf-112c-4265-be4b-f38c51d54e4f",
                                                "sense_id": "cfacbf35-01d5-3aa1-93f3-c8ef6ca17f3f",
                                                "text": "„Hoffnungslos überaltet ist obendrein die kleine Luftflotte der Löschflugzeuge – zu Beginn der Saison waren elf von 23 Maschinen nicht einsatzbereit, weil das Geld für Ersatzteile fehlte.“"
                                            },
                                            {
                                                "example_id": "67f2172e-3327-4586-a139-1a17b55c5413",
                                                "sense_id": "cfacbf35-01d5-3aa1-93f3-c8ef6ca17f3f",
                                                "text": "„Dort gingen rund 1700 Feuerwehrleute, unterstützt von Löschflugzeugen, gegen die Wand der Flammen vor, die sich teilweise auf einer Länge von rund zehn Kilometern durch die Wälder frißt.“"
                                            },
                                            {
                                                "example_id": "b3fbaa89-b3cf-4be8-b786-78b40483c91c",
                                                "sense_id": "cfacbf35-01d5-3aa1-93f3-c8ef6ca17f3f",
                                                "text": "„Zu den bereits im Einsatz befindlichen 50 Löschflugzeugen und Hubschraubern kamen nach Angaben der kalifornischen Forstbehörde weitere 26 Maschinen hinzu.“"
                                            },
                                            {
                                                "example_id": "1954f541-14b7-47fe-b087-4b6df5c6677b",
                                                "sense_id": "cfacbf35-01d5-3aa1-93f3-c8ef6ca17f3f",
                                                "text": "„Zuletzt kamen fünf Insassen eines Löschflugzeugs ums Leben, das über einem brennenden Wald abstürzte.“"
                                            },
                                            {
                                                "example_id": "aff0eb3c-9b76-4687-946c-8f44ca58cf60",
                                                "sense_id": "cfacbf35-01d5-3aa1-93f3-c8ef6ca17f3f",
                                                "text": "„Einen üblen Scherz hat sich der Pilot eines Löschflugzeuges vor der Küste Sardiniens erlaubt: Er goss über einer Schiffsprozession fast fünf Tonnen Wasser aus.“"
                                            },
                                            {
                                                "example_id": "9391f802-b04c-4282-8cf9-66cd0efab005",
                                                "sense_id": "cfacbf35-01d5-3aa1-93f3-c8ef6ca17f3f",
                                                "text": "„Ein Löschflugzeug hat am Dienstag rund eine Tonne Parfüm über Berlin verbreitet.“"
                                            },
                                            {
                                                "example_id": "0a620e20-3e85-4171-b1aa-9426f6ff13ca",
                                                "sense_id": "cfacbf35-01d5-3aa1-93f3-c8ef6ca17f3f",
                                                "text": "„Am Montag beobachtete der Pilot eines Löschflugzeuges auf einem Waldweg nordöstlich Athens einen Mann, der aus einem Lieferwagen Propangasbehälter ins Unterholz warf.“"
                                            },
                                            {
                                                "example_id": "38e41354-dc15-424c-8d83-696e3e76db40",
                                                "sense_id": "cfacbf35-01d5-3aa1-93f3-c8ef6ca17f3f",
                                                "text": "„Im Wald wird ein Toter im Tauchanzug gefunden (wie kann das sein?), ein Löschflugzeug hat ihn beim Tanken auf einem See eingesogen und ihn dann abgeworfen im Waldbrandgebiet.“"
                                            },
                                            {
                                                "example_id": "6d7a5452-c09d-4160-a302-6627448b3f40",
                                                "sense_id": "cfacbf35-01d5-3aa1-93f3-c8ef6ca17f3f",
                                                "text": "„Beim Absturz eines Löschflugzeugs an der Ostküste nahe der Hafenstadt Volos kamen zwei Piloten der Luftwaffe ums Leben.“"
                                            },
                                            {
                                                "example_id": "701fd5c1-94f6-4fff-a637-27a3d8519164",
                                                "sense_id": "cfacbf35-01d5-3aa1-93f3-c8ef6ca17f3f",
                                                "text": "„Erst ganze zwei Stunden später wurde nach Auskunft des Fluglehrers das erste Löschflugzeug auf den Weg geschickt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
