                        "examples": [
                            {
                                "example_id": "3416bc19-e56e-40ac-92d3-a1abafa570d5",
                                "sense_id": "101fdf14-96f0-3f88-a645-14a7d3e0c6a6",
                                "text": "„Siebzig Jahre nach Hitlers Tod laufen die Urheberrechte für »Mein Kampf« aus. Anfang 2016 soll eine kommentierte Version der Hetzschrift erscheinen.“"
                            },
                            {
                                "example_id": "b652e32d-cca8-4fbe-9d52-91a414bd8246",
                                "sense_id": "101fdf14-96f0-3f88-a645-14a7d3e0c6a6",
                                "text": "„Obschon Orwell seinen Roman 1984 nicht als Angriff auf den Sozialismus angelegt hatte, wertete ihn die DDR als staatsfeindliche Hetzschrift und verhängte hohe Zuchthausstrafen für die Lektüre und den Verleih […].“"
                            }
                        ],
