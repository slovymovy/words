                },
                {
                    "sense_id": "d929402f-9c2a-337b-a4d9-039e6ff0a005",
                    "sense_definition": "Avec beaucoup d'efforts et de peine, au prix d'un travail pénible.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les ouvriers doivent travailler <w>durement</w> pour terminer le chantier à temps.",
                            "target_lang_translations": {
                                "en": "The workers have to work <w>hard</w> to finish the building site on time.",
                                "ru": "Рабочим приходится <w>тяжело</w> работать, чтобы закончить стройку вовремя.",
                                "de": "Die Arbeiter müssen <w>hart</w> arbeiten, um die Baustelle rechtzeitig fertigzustellen.",
                                "es": "Los obreros deben trabajar <w>duro</w> para terminar la obra a tiempo.",
                                "zh": "工人们必须在工地上<w>艰苦</w>工作，才能按时完工。"
                            }
                        },
                        {
                            "text": "Elle a enfin acheté cette maison grâce à l'argent qu'elle avait <w>durement</w> gagné.",
                            "target_lang_translations": {
                                "en": "She finally bought this house with money she had earned the <w>hard</w> way.",
                                "ru": "Она наконец купила этот дом на деньги, которые она <w>тяжело</w> заработала.",
                                "de": "Sie hat dieses Haus endlich mit dem Geld gekauft, das sie <w>hart</w> verdient hatte.",
                                "es": "Por fin compró esta casa con el dinero que había ganado <w>duramente</w>.",
                                "zh": "她靠着自己<w>辛苦</w>挣来的钱，终于买下了这套房子。"
                            }
                        }
                    ],
