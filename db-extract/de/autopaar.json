                "senses": [
                    {
                        "sense_id": "28f61128-7c8b-3887-93ab-1e4e176c3a47",
                        "entry_id": "1c86ef89-cb31-3ed7-8a88-679a8b77b5bd",
                        "glosses": [
                            "Gesamtheit zweier physisch oder zweckdienlich miteinander verbundener Kraftfahrzeuge"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26b75d15-c499-4d68-84a3-16bae641ff31",
                                "sense_id": "28f61128-7c8b-3887-93ab-1e4e176c3a47",
                                "text": "„Das Autopaar, von dem ein Wagen den anderen anschleppt, gehört morgens zum gewohnten Straßenbild.“"
                            },
                            {
                                "example_id": "fd9adb64-48fd-4296-8d5d-f0e5f0b12894",
                                "sense_id": "28f61128-7c8b-3887-93ab-1e4e176c3a47",
                                "text": "„Das Autopaar unterschied sich erheblich, passte aber trotzdem irgendwie zusammen.“"
                            },
                            {
                                "example_id": "95689695-fc8b-4ad8-a68e-6b40d891f41e",
                                "sense_id": "28f61128-7c8b-3887-93ab-1e4e176c3a47",
                                "text": "„Er schaut zwischen jedes Autopaar.“"
                            },
                            {
                                "example_id": "43a6635c-12cf-44f2-9af4-4ab09a2343b1",
                                "sense_id": "28f61128-7c8b-3887-93ab-1e4e176c3a47",
                                "text": "„Auf dem Parkplatz eines hochgelegenen Parkes angekommen, hält das Autopaar an, Halm, unfähig auszusteigen, fiebert dem nun Kommenden entgegen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
