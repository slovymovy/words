                "senses": [
                    {
                        "sense_id": "a9f5b8f0-b4e9-3ff3-8b54-eca6c4ce4a90",
                        "entry_id": "9d5e23e2-45b5-393d-b35a-bf3ee82131ac",
                        "glosses": [
                            "Luddite"
                        ],
                        "tags": [
                            "masculine",
