                        "target_lang_word": "upstairs",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "upstairs",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a7aad76e-5ac2-3cb0-848f-d4fdd2695629",
                                        "entry_id": "882887b7-15c7-38cf-965e-6280b57a52ee",
                                        "glosses": [
                                            "Located on a higher floor or level of a building."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "831f821b-9b28-4df0-9e5a-2d3d0c5f5ad3",
                                                "sense_id": "a7aad76e-5ac2-3cb0-848f-d4fdd2695629",
                                                "text": "We rent out the upstairs bedroom to a student."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6280cb51-3244-3476-b1e1-beb7731c29e6",
                                        "entry_id": "882887b7-15c7-38cf-965e-6280b57a52ee",
                                        "glosses": [
                                            "Pertaining to a pitched ball that is high, and usually outside the strike zone."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dbef1e91-c3ce-4739-a4f2-875dc5e96644",
                                                "sense_id": "6280cb51-3244-3476-b1e1-beb7731c29e6",
                                                "text": "That fastball was upstairs for a ball."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "upstairs",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ef14a84e-38d5-39cc-b7e0-767593a1c36f",
                                        "entry_id": "380bb418-f629-31c8-8ceb-7c1b0d697b57",
                                        "glosses": [
                                            "Up the stairs; on or to a higher floor or level."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9fbba952-cb49-44f7-9cfd-2d48643ca382",
                                                "sense_id": "ef14a84e-38d5-39cc-b7e0-767593a1c36f",
                                                "text": "I’ll take my shoes and put them away the next time I go upstairs."
                                            },
                                            {
                                                "example_id": "211380fb-1a0c-49e6-967e-cadf9f470347",
                                                "sense_id": "ef14a84e-38d5-39cc-b7e0-767593a1c36f",
                                                "text": "I hate the people who live upstairs, and I especially hate their piano."
                                            },
                                            {
                                                "example_id": "1d8b123a-ce09-4750-bf3f-a0096fdec919",
                                                "sense_id": "ef14a84e-38d5-39cc-b7e0-767593a1c36f",
                                                "text": "The woman upstairs told the people outside to stop reveling."
                                            },
                                            {
                                                "example_id": "8595e7e8-c958-42fd-a8e0-2f53375066e0",
                                                "sense_id": "ef14a84e-38d5-39cc-b7e0-767593a1c36f",
                                                "text": "There was more dancing and singing up stairs, more wit and conversation below; all were at liberty, and all stayed late; and all talked so much of the happiness they had enjoyed, that Lady Anne felt herself exceedingly tempted to give another party before the season finally closed."
                                            },
                                            {
                                                "example_id": "8fdc6c9a-903b-4def-8e99-fb3ca158fc79",
                                                "sense_id": "ef14a84e-38d5-39cc-b7e0-767593a1c36f",
                                                "text": "In a large bedroom upstairs, the window of which was thickly curtained with a great woollen shawl lately discarded by the landlady, Mrs. Rolliver, were gathered on this evening nearly a dozen persons, all seeking vinous bliss; […]"
                                            },
                                            {
                                                "example_id": "555d7ed2-b9ef-40e3-98c1-4383b142b030",
                                                "sense_id": "ef14a84e-38d5-39cc-b7e0-767593a1c36f",
                                                "text": "Marsha, let’s go upstairs!"
                                            },
                                            {
                                                "example_id": "ca02d1c7-81b6-4755-95de-d76fe5810a8f",
                                                "sense_id": "ef14a84e-38d5-39cc-b7e0-767593a1c36f",
                                                "text": "On arrival at Birmingham New Street, I make my way upstairs to the mezzanine to get shots of an almost deserted concourse, polka-dotted with social distancing circles like some strange board-game."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08a4580f-7bb3-33d1-bbaa-f146233abf44",
                                        "entry_id": "380bb418-f629-31c8-8ceb-7c1b0d697b57",
                                        "glosses": [
                                            "In the brain or mind."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f426839f-b224-4658-b8b0-bb976992a87f",
                                                "sense_id": "08a4580f-7bb3-33d1-bbaa-f146233abf44",
                                                "text": "After Joe did a hula dance on the kitchen table, his friends wondered if he didn’t have a lot going on upstairs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "600b7929-baec-3808-9955-7bcfcc3b55fe",
                                        "entry_id": "380bb418-f629-31c8-8ceb-7c1b0d697b57",
                                        "glosses": [
                                            "In heaven, especially with regard to where a deity might be found."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
