    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "3ccf36f4-a83c-3d33-99d3-9ca4957184c5",
                "word": "bangtail",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "bd4f7832-9d81-442f-b6b7-2ba6d55baa04",
                        "entry_id": "3ccf36f4-a83c-3d33-99d3-9ca4957184c5",
                        "tags": [
                            "plural"
                        ],
                        "form": "bangtails"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "61ef9929-482f-3386-acab-b39c2b5217d7",
                        "entry_id": "3ccf36f4-a83c-3d33-99d3-9ca4957184c5",
                        "glosses": [
                            "The tail of a horse or cow, allowed to grow out and then trimmed horizontally so as to form a tassel; a horse or cow having such a tail."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d287fb5d-bcf9-4a68-8d59-7931ca82fe2e",
                                "sense_id": "61ef9929-482f-3386-acab-b39c2b5217d7",
                                "text": "1851, Turning Out a Bagman: A Legend of Brighton Downs, in Charles Dickens, William Harrison Ainsworth, Albert Smith Bentley's Miscellany, Volume XXIX, page 259,\nTwo lean, ewe-necked, clipt chestnuts, tucked up in the ribs, with hard work and bad feeding, but with such flowing bang-tails as at once stamped them in the eyes of our friends as “ out-and-out ” thorough-breds—were led up and down by John. […] The bang-tails, no doubt, supposing themselves out for their usual “airing,” put themselves in the regular side-long position, and struck at once into a sort of hectic canter ; a particular movement, peculiar to Brighton bang-tails, and adapted to the most innocent equestrian."
                            },
                            {
                                "example_id": "c8f9a47a-007b-452e-b33e-96b02494b75e",
                                "sense_id": "61ef9929-482f-3386-acab-b39c2b5217d7",
                                "text": "1903, Tom Collins (Joseph Furphy), Such Is Life: Being Certain Extracts from the Diary of Tom Collins, 2004, page 68,\n\"And did you see a dark chestnut horse; bang tail; star and snip; white hind feet; saddle and bridle on?\" I asked."
                            },
                            {
                                "example_id": "c344d4ca-52a4-4a1e-9561-045aa133c0f4",
                                "sense_id": "61ef9929-482f-3386-acab-b39c2b5217d7",
                                "text": "Lennan held the black horse — a bizarre little beast, all fire and whipcord, with a skin like satin, liquid eyes, very straight hocks, and a thin bangtail reaching down to them."
                            },
                            {
                                "example_id": "96d8c512-82c4-4835-8092-2b1b79bbffac",
                                "sense_id": "61ef9929-482f-3386-acab-b39c2b5217d7",
                                "text": "Once we get the herd we can set up relays to keep the bangtails movin' as we go."
                            }
                        ]
                    },
                    {
                        "sense_id": "e5233190-0c5c-3788-b5a8-b3a9e06fdd56",
                        "entry_id": "3ccf36f4-a83c-3d33-99d3-9ca4957184c5",
                        "glosses": [
                            "A racehorse."
                        ],
                        "tags": [
                            "US"
                        ],
                        "examples": [
                            {
                                "example_id": "dfca73e5-6056-4a84-898c-e79d7a8825cd",
                                "sense_id": "e5233190-0c5c-3788-b5a8-b3a9e06fdd56",
                                "text": "“Eddie!” whinnied Daley, the distraught worshipper of the bang-tails. “Eddie! Phar Lap is dead!”"
                            },
                            {
                                "example_id": "ddcdb0a0-0d67-4722-b46f-149194400224",
                                "sense_id": "e5233190-0c5c-3788-b5a8-b3a9e06fdd56",
                                "text": "Americans bet $5,000,000,000 a year on the galloping bangtails."
                            },
                            {
                                "example_id": "3495cd71-a1f2-41f3-bfa0-28c2b656ecb4",
                                "sense_id": "e5233190-0c5c-3788-b5a8-b3a9e06fdd56",
                                "text": "If you happen to be out on the far east side between April 23 and September 5, with $10 burning a hole in your pocket, hie yourself out to River Downs Race Track, 6301 Kellogg Avenue, and bet on the bangtails."
                            },
                            {
                                "example_id": "31d94ec5-f444-4a63-9efb-fdb2c0a3b0dd",
                                "sense_id": "e5233190-0c5c-3788-b5a8-b3a9e06fdd56",
                                "text": "I was ridin' the horses then, you understand, and maybe known to take a flutter or two on the bangtails while I was about it."
                            }
                        ]
                    },
                    {
                        "sense_id": "3f1600bf-ac02-3e7b-8b4b-55588b218e01",
