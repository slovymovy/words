                                "target_senses": [
                                    {
                                        "sense_id": "e620c1f1-5871-3eb6-98dd-bcf56328db23",
                                        "entry_id": "1191b56b-be2b-36d9-a09b-9a35f71457ae",
                                        "glosses": [
                                            "Any garment worn underneath others, especially one worn next to the skin; an item of underwear."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fafdbdec-eb51-486a-83a1-1727dbdfb33f",
                                                "sense_id": "e620c1f1-5871-3eb6-98dd-bcf56328db23",
                                                "text": "Richard DeLongpre: Are you okay, my boy angel?\nAllen Gregory DeLongpre: I have a broken heart. And undergarments filled with my own unruly waste."
                                            },
                                            {
                                                "example_id": "842a0b79-9065-41d3-9a6a-05fe0af8b1fa",
                                                "sense_id": "e620c1f1-5871-3eb6-98dd-bcf56328db23",
                                                "text": "In the Victorian Era, exposing your shirtfront in public was considered improper, as shirts were viewed as undergarments. Waistcoats concealed this and helped [to] tame oversized, billowy shirts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f2a86691-965a-39c3-afd7-8a928d57a63e",
                                        "entry_id": "1191b56b-be2b-36d9-a09b-9a35f71457ae",
                                        "glosses": [
                                            "Temple garments worn by the followers of the Church of Jesus Christ of Latter-day Saints."
                                        ],
