            {
                "entry_id": "c8409fbb-bbdb-3b58-ba3c-ddf25cbbe111",
                "word": "headstall",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "fd41ecb9-6ebb-48b8-8c11-7f00b8d20ed6",
                        "entry_id": "c8409fbb-bbdb-3b58-ba3c-ddf25cbbe111",
                        "tags": [
                            "plural"
                        ],
                        "form": "headstalls"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d5c199c4-b99a-38b0-8f0c-74b91fd2f0aa",
                        "entry_id": "c8409fbb-bbdb-3b58-ba3c-ddf25cbbe111",
                        "glosses": [
                            "The part of a bridle that fits over a horse's head and supports other elements."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec8bcaec-4fec-4317-94c7-005c6c60a2d3",
                                "sense_id": "d5c199c4-b99a-38b0-8f0c-74b91fd2f0aa",
                                "text": "Why, Petruchio is coming […] his horse hipp’d […] with a half-cheek’d bit, and a head-stall of sheep’s leather which, being restrained to keep him from stumbling, hath been often burst, and now repaired with knots […]"
                            },
                            {
                                "example_id": "96e16caf-206e-4fea-8462-ba3db0c0215d",
                                "sense_id": "d5c199c4-b99a-38b0-8f0c-74b91fd2f0aa",
                                "text": "Another, that would seeme to have more wit, / Him by the bright embrodered hed-stall tooke […]."
                            },
                            {
                                "example_id": "f82bb78e-e2a4-4750-8b80-b8eee6cdf2e3",
                                "sense_id": "d5c199c4-b99a-38b0-8f0c-74b91fd2f0aa",
                                "text": "He turned back, slipped the bit in Dox’s mouth, and laced the big flop ears into the headstall."
                            },
                            {
                                "example_id": "a04e4cde-cce2-4b59-8bed-b6acd463959d",
                                "sense_id": "d5c199c4-b99a-38b0-8f0c-74b91fd2f0aa",
                                "text": "Then the smith Ilmarinen / the everlasting craftsman / out of steel formed a bridle / forged a headstall [translating päitset] of iron […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "04b47eb6-f8c7-3afe-886a-5f694a5d1b78",
                        "entry_id": "c8409fbb-bbdb-3b58-ba3c-ddf25cbbe111",
                        "glosses": [
                            "A phorbeia."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a08fd937-71b5-4f3a-9afd-84fc073c18b0",
