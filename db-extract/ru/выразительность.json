                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "76d6a063-e029-30a7-a3b9-78eb659575c2",
                                        "entry_id": "f6760577-9d05-360f-8c56-c0ebbeb54b95",
