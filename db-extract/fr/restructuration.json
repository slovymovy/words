                    {
                        "sense_id": "c021395c-da88-3438-9d39-650aaafd9179",
                        "entry_id": "0cf95d31-e606-3140-845b-3219e984721e",
                        "glosses": [
                            "Modification de la structure.",
                            "D'un crédit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4d68de8-2ceb-4811-97d6-044261147fa4",
                                "sense_id": "c021395c-da88-3438-9d39-650aaafd9179",
                                "text": "Une restructuration classique peut prendre différentes formes en pratique : décote sur la valeur faciale des obligations, baisse des taux d'intérêt, allongement de la maturité, conversion en un autre actif."
                            },
                            {
                                "example_id": "6eb9d979-25d0-4377-8a95-b47541657835",
                                "sense_id": "c021395c-da88-3438-9d39-650aaafd9179",
                                "text": "Un accord de restructuration de dette a échoué, a annoncé le gouvernement ghanéen ce lundi 15 avril. Un coup dur pour cet ancien champion économique du continent, en défaut de paiement depuis 2022."
                            }
                        ]
                    },
                    {
                        "sense_id": "8e002202-1695-3371-aea8-4b5d9bf23f99",
                        "entry_id": "0cf95d31-e606-3140-845b-3219e984721e",
                        "glosses": [
                            "Modification de la structure.",
                            "Réorganisation d’une entreprise avec maintien d’effectif, embauche ou licenciement."
                        ],
                        "tags": [
                            "Gestion d'entreprise"
                        ],
                        "examples": [
                            {
                                "example_id": "ac2e9f0f-13eb-4ce5-bc1d-a7dd667b0c1b",
                                "sense_id": "8e002202-1695-3371-aea8-4b5d9bf23f99",
                                "text": "La restructuration comprend aussi une délocalisation des moyens de production ou de distribution, des changements dans la structure de l'entreprise …"
                            }
                        ]
                    }
