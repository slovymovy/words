                        "sense_id": "feee47db-c4cf-3ba6-a9c9-2576e41553da",
                        "entry_id": "e5cadd78-d090-398b-8d76-86fb936a1138",
                        "glosses": [
                            "Colonel allemand."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0803643f-102f-4181-ba25-00cbca0f6588",
                                "sense_id": "feee47db-c4cf-3ba6-a9c9-2576e41553da",
                                "text": "Je sais bien qu’en Allemagne, un régiment voit à sa tête tantôt un oberst, tantôt un oberst-lieutenant, tantòt un major."
                            },
                            {
                                "example_id": "c6db79fe-33d7-4e60-9dd7-3da65e934e6d",
                                "sense_id": "feee47db-c4cf-3ba6-a9c9-2576e41553da",
                                "text": "L’Oberst qui commandait notre secteur de guerre a mis à profit ces données pour faire aménager à l’extrémité du souterrain, au niveau des eaux de la rivière mais à l’intérieur même du pont, une sorte de petit port clandestin, en pente inclinée, bien abrité, bien muré."
                            },
                            {
                                "example_id": "547dfe35-cc38-4c77-9e14-a0f7df67daea",
                                "sense_id": "feee47db-c4cf-3ba6-a9c9-2576e41553da",
                                "text": "– J’ai vu un Oberst, dit Fanard. Il est resté plus d’une heure au musée, devant la vitrine des coiffes."
                            }
                        ]
                    }
