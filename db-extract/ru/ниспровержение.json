                "senses": [
                    {
                        "sense_id": "93f42fad-131f-31ee-b0fb-af15599cc079",
                        "entry_id": "828a58fb-76da-3c63-88f3-963d349b066f",
                        "glosses": [
                            "действие по значению гл. ниспровергать, ниспровергнуть"
                        ],
                        "tags": [],
