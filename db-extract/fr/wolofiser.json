                ],
                "senses": [
                    {
                        "sense_id": "bc9e1340-6b78-3dd9-a363-752c86ca7a75",
                        "entry_id": "ab509556-9135-3d45-b972-1c1339ef72dc",
                        "glosses": [
                            "Donner un caractère wolof à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87fa5fe3-63f4-41a8-a3df-c4a435038aee",
                                "sense_id": "bc9e1340-6b78-3dd9-a363-752c86ca7a75",
                                "text": "Ils ont une ambition commune, celle de wolofiser cette technologie vitale pour toute société du 21 iéme siècle ."
                            },
                            {
                                "example_id": "5cecb289-b626-49d3-a5e0-913c8c81ce45",
                                "sense_id": "bc9e1340-6b78-3dd9-a363-752c86ca7a75",
                                "text": "Dans les années 60, la plupart des œuvres de Sembène portent un titre bilingue dans un français wolofisé ou simplement en wolof."
                            },
                            {
                                "example_id": "989c34e7-6f32-4f47-8056-49f572db0da2",
                                "sense_id": "bc9e1340-6b78-3dd9-a363-752c86ca7a75",
                                "text": "Donner le sentiment qu'on va \"w o l o f i s e r\" le Sénégal est dangereux."
                            },
                            {
                                "example_id": "34538163-4d4a-41a5-9e30-ab38913e13e4",
                                "sense_id": "bc9e1340-6b78-3dd9-a363-752c86ca7a75",
                                "text": "Il est également conseillé et souhaitable d’assimiler l’emprunt aux règles morphologique françaises, ainsi le mot « shampouineur » prend place du mot « shampooineur » ou le mot « ouolofiser » prend place du mot « wolofiser »."
                            }
                        ]
                    }
