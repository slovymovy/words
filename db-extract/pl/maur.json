                                        "entry_id": "0f6a1ce7-3a09-3185-9590-1fbc5618ef8c",
                                        "glosses": [
                                            "Habitant de l’ancienne Maurétanie, région du nord de l’Afrique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c81ab58d-3c86-47b2-a014-4dea580b0484",
                                                "sense_id": "d965f135-a040-3a9f-93fa-73038ccd3e2f",
                                                "text": "Ce fut en 713 que finit ce royaume ; les Maures d’Espagne devinrent alors possesseurs de la Septimanie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "432627fd-81bf-3474-aed5-e8ae57afa20a",
                                        "entry_id": "0f6a1ce7-3a09-3185-9590-1fbc5618ef8c",
                                        "glosses": [
                                            "Noir d'origine musulmane."
