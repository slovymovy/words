                                            "The entity to whom a lease is given, or who takes an estate by lease."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "471953e4-3a1b-3aa0-927e-e30cd6f1b1ba",
                                        "entry_id": "71171ea1-e971-35a9-8c0a-9baed17d99ac",
                                        "glosses": [
                                            "Someone who is allowed to use a house, building, land etc. for a period of time in return for payment to the owner."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "lessee",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d2029ac0-fb87-34c8-87c1-271bab79d7ff",
                                        "entry_id": "c2291ca4-1ed2-3fe7-b774-41920e11b78d",
                                        "glosses": [
                                            "Pronunciation spelling of let's see."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "pronunciation-spelling"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b06ec00-07f8-429a-816c-fba47e47233f",
                                                "sense_id": "d2029ac0-fb87-34c8-87c1-271bab79d7ff",
                                                "text": "Lessee now, who else does the old master know?"
                                            },
                                            {
                                                "example_id": "f6759f24-e33d-4395-9327-ff919c7492cf",
                                                "sense_id": "d2029ac0-fb87-34c8-87c1-271bab79d7ff",
                                                "text": "Huh? My name? Lessee... I just came outta that egg, so I guess I don'thave a name yet."
                                            }
                                        ]
