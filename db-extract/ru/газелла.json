                                "target_senses": [
                                    {
                                        "sense_id": "aa696405-b67e-3a57-b081-85d720022ff6",
                                        "entry_id": "8f9af960-7380-347e-8f23-03a7218f7ad8",
                                        "glosses": [
                                            "Dans la poésie turque et persane, court poème lyrique de forme rigoureuse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60a5c8ab-33fe-4202-866d-595acea6c6fa",
                                                "sense_id": "aa696405-b67e-3a57-b081-85d720022ff6",
                                                "text": "– Je me rappelle un ghazel persan où un amant célèbre la finesse de la peau de sa maîtresse. \"Quand elle boit du vin rouge, dit-il, on le voit passer le long de sa gorge.\""
                                            },
                                            {
                                                "example_id": "ca3aa695-b98d-459d-84a4-0ab5e5da2ae0",
                                                "sense_id": "aa696405-b67e-3a57-b081-85d720022ff6",
                                                "text": "Il est possible que la popularité du ghazel arabe de quatorze vers ait contribué au succès rapide de cette forme d'égale dimension."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
