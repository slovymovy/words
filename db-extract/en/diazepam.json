                                        "glosses": [
                                            "Composé chimique de formule brute C₁₆H₁₃ClN₂O, utilisé en pharmacologie pour ses propriétés anxiolytiques et anticonvulsivantes."
                                        ],
                                        "tags": [
                                            "Médicament"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "05dbddec-0816-450c-9f4a-02fcc72a62fb",
                                                "sense_id": "331594ea-107b-35c3-b3b5-b61d386dc166",
                                                "text": "Nous avons observé une hypotension due au diazépam chez 14 de nos 33 malades traités (42,4 p. 100 des cas)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
