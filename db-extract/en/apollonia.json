                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "edecc9d2-275f-4a5c-95f7-a41fc7b44182",
                                                "sense_id": "a2d4ff53-a758-38a6-b88c-935cdd47e3cf",
                                                "text": "Sainte Apolline, ou Apollonie, d'Alexandrie."
                                            },
                                            {
                                                "example_id": "a78b2cd8-1b21-4718-ba4f-910c33d6cab1",
                                                "sense_id": "a2d4ff53-a758-38a6-b88c-935cdd47e3cf",
                                                "text": "Il y a aussi ma cousine Apollonie ; on l’appelle la Polonie.\nC’est comme ça qu’ils ont baptisé leur fille, ces paysans !"
                                            },
                                            {
                                                "example_id": "d48306b5-b0fe-4c44-993f-125ad15b8934",
                                                "sense_id": "a2d4ff53-a758-38a6-b88c-935cdd47e3cf",
                                                "text": "Elle s’appelait Apollonie Sabatier, ou chez Baudelaire, qui en était fou, la Présidente."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Apollonie",
                                "target_lang_code": "fr",
                                "target_senses": [
