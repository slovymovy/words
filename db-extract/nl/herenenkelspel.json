                            {
                                "example_id": "ab3b552e-564a-4fb5-8b82-f0922273721d",
                                "sense_id": "15fe0ba6-229d-3fb6-b239-8d35a17c19b9",
                                "text": "Elke wedstrijd telt vijf partijen: een herenenkelspel, een damesenkelspel, een herendubbel, een gemengd dubbelspel en een 'legends dubbelspel'. Elke partij wordt gespeeld over één set met een no-add-systeem (op deuce is het volgende punt beslissend)."
                            }
                        ]
                    },
