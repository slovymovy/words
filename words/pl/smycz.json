    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a062e782-0c0f-376c-b997-f0d59e79e9c3",
                    "sense_definition": "pasek z rączką i karabińczykiem, służący do prowadzenia psa lub innego zwierzęcia domowego",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Przed wyjściem na spacer zawsze zapinam psu czerwoną <w>smycz</w>.",
                            "target_lang_translations": {
                                "ru": "Перед выходом на прогулку я всегда пристёгиваю собаке красный <w>поводок</w>."
                            }
                        },
                        {
                            "text": "W tym parku miejskim właściciele muszą trzymać swoje psy na <w>smyczy</w>.",
                            "target_lang_translations": {
                                "ru": "В этом городском парке владельцы обязаны держать своих собак на <w>поводке</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "na smyczy",
                        "pies na smyczy",
                        "spuścić ze smyczy"
                    ],
                    "target_lang_definitions": {
                        "ru": "ремень с ручкой и карабином, служащий для выгула собаки или другого домашнего животного"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поводок",
                                "target_lang_sense_clarification": "для выгула животных"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f6c46a5f-e656-3bf9-9432-719c4c543e9d",
                    "sense_definition": "taśma lub sznurek noszony na szyi albo nadgarstku, służący do przypinania kluczy, telefonu lub identyfikatora",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Podczas konferencji każdy uczestnik dostał identyfikator zawieszony na kolorowej <w>smyczy</w>.",
                            "target_lang_translations": {
                                "ru": "Во время конференции каждый участник получил бейдж, висящий на разноцветной <w>ленте</w>."
                            }
                        },
                        {
                            "text": "Przypiąłem klucze do <w>smyczy</w>, żeby nie zgubić ich podczas biegania po lesie.",
                            "target_lang_translations": {
                                "ru": "Я прикрепил ключи к <w>ремешку</w>, чтобы не потерять их во время пробежки по лесу."
                            }
                        }
                    ],
                    "common_phrases": [
                        "smycz na klucze",
                        "smycz reklamowa"
                    ],
                    "target_lang_definitions": {
                        "ru": "лента или шнурок на шею или запястье, предназначенный для крепления ключей, телефона или бейджа"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шнурок",
                                "target_lang_sense_clarification": "для бейджа, ключей или телефона"
                            },
                            {
                                "target_lang_word": "лента",
                                "target_lang_sense_clarification": "ланъярд, лента для бейджа"
                            },
                            {
                                "target_lang_word": "ремешок",
                                "target_lang_sense_clarification": "для ключей или бейджа"
                            },
                            {
                                "target_lang_word": "ланъярд",
                                "target_lang_sense_clarification": "лента для бейджа или ключей"
                            }
                        ]
                    }
                }
            ]
        },
        {
