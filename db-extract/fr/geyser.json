                        "glosses": [
                            "Source d’eau chaude qui jaillit par intermittence."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b6b28a49-0c30-4fa8-8539-bd6f203af005",
                                "sense_id": "fc74437b-fff5-3c33-883a-11fb2b2df1cd",
                                "text": "à moins que cet écueil ne fût soumis aux expansions intermittentes d’un geyser"
                            },
                            {
                                "example_id": "442c4d8e-5fbd-48aa-bae3-1cfc6f7ef37a",
                                "sense_id": "fc74437b-fff5-3c33-883a-11fb2b2df1cd",
                                "text": "Les geysers de Californie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aff383bc-c64c-4491-b40f-c929ea7e4c49",
                        "source_entry_id": "226ee255-8c61-3d8b-935f-3518a421405d",
                        "source_sense_id": "fc74437b-fff5-3c33-883a-11fb2b2df1cd",
                        "source_sense_description": "(Géologie) Source d’eau chaude qui jaillit par intermittence",
                        "target_lang_word": "Geysir",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Geysir",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b8068f60-fe68-3f03-8c2e-393c85d0ae21",
                                        "entry_id": "7bf7964e-2a3d-3ca7-ad27-043af1894087",
                                        "glosses": [
                                            "eine Art von heißer, durch Vulkanismus hervorgerufener Wasserquelle, die ihr Wasser periodisch oder auch episodisch ausstößt; der Wasserstrahl oder Wasserschwall kann dabei beispielsweise als Fontäne, Dampfsäule oder auch auf andere Art austreten"
                                        ],
                                        "tags": [
                                            "Vulkanismus",
                                            "Tektonik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8fc0f4d2-02af-4cd8-bd80-b21c2a29e831",
                                                "sense_id": "b8068f60-fe68-3f03-8c2e-393c85d0ae21",
                                                "text": "Der Old Faithful Geysir (der alte treue Geysir) im Yellowstone-Nationalpark speit stündlich etwa 5 Minuten lang."
                                            },
                                            {
                                                "example_id": "f4a3ee8b-c617-4608-92a5-dbcaa1692f2b",
                                                "sense_id": "b8068f60-fe68-3f03-8c2e-393c85d0ae21",
                                                "text": "„Wir werden auf unserem Drehkreis immer näher an das andere Boot herangetragen, schon treffen die Wellenberge, die von unserem Bug wie von einem Schneepflug zur Seite geworfen werden, mit taumelnden Dwarsseen zusammen, Wasserfetzen schießen senkrecht hoch, wie aus einem Geysir geschleudert.“"
                                            },
                                            {
                                                "example_id": "46639944-3758-4300-939f-0e51cbe1673b",
                                                "sense_id": "b8068f60-fe68-3f03-8c2e-393c85d0ae21",
                                                "text": "„Der Goldene Zirkel, das ist erstens der Große Geysir, der berühmte, gelegen im Geothermalgebiet Haukadalur, von dem alle anderen Geysire der Welt ihren Namen übernommen haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "26aed8fe-8c67-43a8-9089-abbcbba6317e",
                        "source_entry_id": "226ee255-8c61-3d8b-935f-3518a421405d",
                        "source_sense_id": "fc74437b-fff5-3c33-883a-11fb2b2df1cd",
