                        "examples": [
                            {
                                "example_id": "defb5265-c287-46d8-a9ec-6fcd0a43fff5",
                                "sense_id": "7c731170-3a82-32f9-8894-bf2173686477",
                                "text": "„Ich klaue aus einer Grabnische ein paar Plastikrosen, um nicht mit leeren Händen dazustehen.“"
                            },
                            {
                                "example_id": "1816d990-3df4-4a23-8837-1f0a397cbf0b",
                                "sense_id": "7c731170-3a82-32f9-8894-bf2173686477",
                                "text": "„Kellnerinnen zogen geschickt ihre Bahnen, jeder hing über den Brüsten eine gelbe Plastikrose am dünnen T-Shirt-Stoff.“"
                            },
                            {
                                "example_id": "1ac21e58-bbd2-4568-8a5b-29f47a61ead7",
                                "sense_id": "7c731170-3a82-32f9-8894-bf2173686477",
                                "text": "„Sträuße aus Plastikrosen stecken in der Erde.“"
                            }
                        ],
