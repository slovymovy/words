                                            },
                                            {
                                                "example_id": "0f9c0a01-dc19-4b01-ae7c-6be63d4243d5",
                                                "sense_id": "59ecf184-8023-35f0-9a0e-d2546ec78427",
                                                "text": "Employees can claim reimbursement for travel expenses."
                                            },
                                            {
                                                "example_id": "e4fce7bb-e5b0-4f2b-8535-0b9891e6d1eb",
                                                "sense_id": "59ecf184-8023-35f0-9a0e-d2546ec78427",
