                "senses": [
                    {
                        "sense_id": "06fa0f95-e42a-3d9b-ac1a-6d96c6af3c69",
                        "entry_id": "40c7ecdb-b647-3fd7-be3a-db4fced45547",
                        "glosses": [
                            "to show, to appear, to peep out"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29d5656d-4205-4623-b579-d23cf17fe20d",
                                "sense_id": "06fa0f95-e42a-3d9b-ac1a-6d96c6af3c69",
                                "text": "со́лнце прогляну́ло",
                                "translation": "the sun appeared [peeped out]",
                                "english": "the sun appeared [peeped out]"
                            },
                            {
                                "example_id": "804f83b3-73f6-4a1a-b627-cee4fdff8cf8",
                                "sense_id": "06fa0f95-e42a-3d9b-ac1a-6d96c6af3c69",
                                "text": "луна́ прогляну́ла и́з-за туч",
                                "translation": "the moon showed [peeped out] from behind the clouds",
                                "english": "the moon showed [peeped out] from behind the clouds"
                            },
                            {
                                "example_id": "20ddea8e-e6b6-490d-b54b-f41d16344453",
                                "sense_id": "06fa0f95-e42a-3d9b-ac1a-6d96c6af3c69",
                                "text": "То́лько к ве́черу на одно́ мгнове́ние прогляну́ло со́лнце и како́й-то заблу́дший луч, ве́рно из любопы́тства, загляну́л и в мою́ ко́мнату.",
                                "translation": "Only towards evening the sun peeped out, and a stray sunbeam probably from curiosity glanced into my room.",
                                "english": "Only towards evening the sun peeped out, and a stray sunbeam probably from curiosity glanced into my room."
                            }
                        ]
                    },
