                        "glosses": [
                            "To determine the fate of something in advance."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "6d06a1df-5203-49ab-8dbf-80e99da5f3c0",
                                "sense_id": "5d75802d-ba8d-3bb2-b51c-060ca882ba5d",
                                "text": "A child! If here the heart turns sick with rath\nTo see a little one from birth defiled,\nOr lame or blind, as preordained to languish\nThrough youthless life"
                            }
                        ]
                    }
