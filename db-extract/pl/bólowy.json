                                        "entry_id": "7b67cae0-0b65-334c-89ef-c43043ae9ecd",
                                        "glosses": [
                                            "книжн. связанный с болью"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7096a9d-aa58-48ff-8839-90ea40333bcc",
                                                "sense_id": "6fc7fbfb-7153-397e-af81-2022bc4a330e",
                                                "text": "Болевой шок."
                                            },
                                            {
                                                "example_id": "1d5ea45e-be6a-4451-9591-818c0d1a2083",
                                                "sense_id": "6fc7fbfb-7153-397e-af81-2022bc4a330e",
                                                "text": "Болевой приём."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a51a9c3d-fd88-3ff0-9186-3a445defb8eb",
                                        "entry_id": "7b67cae0-0b65-334c-89ef-c43043ae9ecd",
                                        "glosses": [
                                            "книжн. вызванный болью или вызывающий боль"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01004d5c-c576-4351-8458-ffd800d49641",
                                                "sense_id": "a51a9c3d-fd88-3ff0-9186-3a445defb8eb",
                                                "text": "По ощущению это напоминает укол ― но не острый, не сильный, потому что кожа не протыкается и болевое ощущение возникает вроде бы вовне."
                                            },
                                            {
                                                "example_id": "ea5be5e4-85bb-4d85-bcb1-2dd448a473ce",
                                                "sense_id": "a51a9c3d-fd88-3ff0-9186-3a445defb8eb",
                                                "text": "Найти болевые точки ― нос, уши, над веком, ― точно ударить."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "589f401f-dc11-38e1-9355-7257a04cb316",
                                        "entry_id": "7b67cae0-0b65-334c-89ef-c43043ae9ecd",
                                        "glosses": [
                                            "острый, злободневный"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
