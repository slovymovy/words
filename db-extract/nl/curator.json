                                        "sense_id": "cc5b9e78-9114-3871-9642-4d164abc5bcd",
                                        "entry_id": "e69e008a-fc1b-3c88-b0f1-8b891cccee03",
                                        "glosses": [
                                            "Agrégateur Web, outil ou personne qui compile, valide et commente, sur une page dédiée, des informations Web concernant un sujet particulier."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1cf5e598-f7ac-3797-b694-ffcf833081d1",
                                        "entry_id": "e69e008a-fc1b-3c88-b0f1-8b891cccee03",
                                        "glosses": [
                                            "Celui qui est chargé de la gestion scientifique et technique des collections animales d'un zoo ou d'un aquarium."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70f8be44-dc59-4dcd-b8d5-f2fe7dea6669",
                                                "sense_id": "1cf5e598-f7ac-3797-b694-ffcf833081d1",
                                                "text": "S'occuper des animaux et de leur santé au quotidien dans un parc zoologique est le rôle des soigneurs et des soigneuses. Ils travaillent en équipe avec leurs collègues spécialisés : vétérinaire, curateur, registraire."
                                            },
                                            {
                                                "example_id": "74858fc0-3b04-43b4-a335-ff30f3375122",
                                                "sense_id": "1cf5e598-f7ac-3797-b694-ffcf833081d1",
                                                "text": "Les curateurs, ou conservateurs, sont chargés du choix des espèces, de l'organisation des groupes sociaux dans chaque espèce, de la conception des installations animalières, de la coordination des élevages avec les autres zoos, de l'organisation des recherches éventuelles, de la tenue des registres animaliers, de la transmission des données recueillies…"
                                            },
                                            {
                                                "example_id": "8312de83-c7a2-43e8-93b7-fe0dcabdcf38",
                                                "sense_id": "1cf5e598-f7ac-3797-b694-ffcf833081d1",
                                                "text": "Dans un parc animalier il existe de nombreux métiers : soigneurs et vétérinaires pour s’occuper des animaux au quotidien, curateurs et registraires pour gérer les populations, commerciaux pour promouvoir le site, jardiniers pour l’entretien de la végétation, comptables, médiateurs, scientifiques, directeur, etc."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
