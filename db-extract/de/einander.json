                                        "examples": [
                                            {
                                                "example_id": "d9b29172-b215-4a8f-a7c9-8520fd090e7c",
                                                "sense_id": "9aaf5b73-7773-3098-ad2a-c3b2aa3bb4b7",
                                                "text": "Друг другу, вижу, мы чужие… // Опомнись, дочь моя! Мария, // Беги, пади к его ногам"
                                            },
