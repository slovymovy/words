{
    "word_family": [
        "direct",
        "direction",
        "director",
        "directness",
        "indirect"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "e345b9af-2d7e-32f1-bd05-fb5a768d6950",
                    "sense_definition": "In a straight line or course without stopping or changing direction.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He drove <w>directly</w> to the office and did not stop at the petrol station.",
                            "target_lang_translations": {
                                "ru": "Он поехал <w>прямо</w> в офис и не стал заезжать на заправку."
                            }
                        },
                        {
                            "text": "The flight will go <w>directly</w> to London without any layovers in other cities.",
                            "target_lang_translations": {
                                "ru": "Рейс полетит <w>напрямую</w> в Лондон без пересадок в других городах."
                            }
                        }
                    ],
                    "synonyms": [
                        "straightwise",
                        "straight"
                    ],
                    "antonyms": [
                        "circuitously",
                        "indirectly"
                    ],
                    "common_phrases": [
                        "go directly to",
                        "drive directly home"
                    ],
                    "target_lang_definitions": {
                        "ru": "По прямой линии или курсу, без остановок или изменения направления."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прямо",
                                "target_lang_sense_clarification": "по кратчайшему пути"
                            },
                            {
                                "target_lang_word": "напрямую",
                                "target_lang_sense_clarification": "без промежуточных остановок"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7aecef3f-5a7c-3549-88ff-ee53fc09127a",
                    "sense_definition": "Exactly in a specified position or at the shortest possible distance.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "position",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pharmacy is <w>directly</w> across the street from the hospital entrance.",
                            "target_lang_translations": {
                                "ru": "Аптека находится <w>прямо</w> через дорогу от входа в больницу."
                            }
                        },
                        {
                            "text": "The sun was <w>directly</w> overhead at noon, making the day very hot.",
                            "target_lang_translations": {
                                "ru": "В полдень солнце было <w>прямо</w> над головой, из-за чего день был очень жарким."
                            }
                        }
                    ],
                    "synonyms": [
                        "exactly",
                        "precisely",
                        "dead",
                        "right"
                    ],
                    "common_phrases": [
                        "directly across from",
                        "directly overhead",
                        "directly behind"
                    ],
                    "target_lang_definitions": {
                        "ru": "Точно в указанном месте или на кратчайшем расстоянии."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прямо",
                                "target_lang_sense_clarification": "точно в определенном месте"
                            },
                            {
                                "target_lang_word": "как раз",
                                "target_lang_sense_clarification": "именно там"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e27c3979-3a65-38d3-b6d4-f756c87dd533",
                    "sense_definition": "Without anything intervening; by direct means rather than through someone or something else.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "manner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should speak <w>directly</w> to the manager if you have a serious complaint.",
                            "target_lang_translations": {
                                "ru": "Вам следует поговорить <w>напрямую</w> с менеджером, если у вас есть серьезная жалоба."
                            }
                        },
                        {
                            "text": "The new law will <w>directly</w> affect how small businesses pay their taxes.",
                            "target_lang_translations": {
                                "ru": "Новый закон <w>непосредственно</w> повлияет на то, как малый бизнес платит налоги."
                            }
                        }
                    ],
                    "antonyms": [
                        "indirectly"
                    ],
                    "common_phrases": [
                        "speak directly to",
                        "directly affected by"
                    ],
                    "target_lang_definitions": {
                        "ru": "Без посредников; непосредственным образом, а не через кого-то или что-то другое."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "напрямую",
                                "target_lang_sense_clarification": "без посредников"
                            },
                            {
                                "target_lang_word": "непосредственно",
                                "target_lang_sense_clarification": "без промежуточных звеньев"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d86a7c33-a9ab-3784-ace5-4c2d3959ae84",
                    "sense_definition": "In a clear and plain way, without avoiding the topic or being ambiguous.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am going to tell her <w>directly</w> that I cannot attend the wedding.",
                            "target_lang_translations": {
                                "ru": "Я собираюсь сказать ей <w>прямо</w>, что не смогу прийти на свадьбу."
                            }
                        },
                        {
                            "text": "The journalist <w>directly</w> challenged the politician about his previous voting record.",
                            "target_lang_translations": {
                                "ru": "Журналист <w>без обиняков</w> расспросил политика о его прошлых результатах голосования."
                            }
                        }
                    ],
                    "synonyms": [
                        "bluntly",
                        "clearly",
                        "unambiguously",
                        "explicitly"
                    ],
                    "common_phrases": [
                        "answer directly",
                        "address directly"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ясно и просто, не избегая темы и не допуская двусмысленности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прямо",
                                "target_lang_sense_clarification": "открыто и ясно"
                            },
                            {
                                "target_lang_word": "без обиняков",
                                "target_lang_sense_clarification": "не прибегая к намекам"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e33b9b50-b993-3b82-bc12-9056327e7f2b",
                    "sense_definition": "In an honest and straightforward manner.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He told me <w>directly</w> that he had made a mistake and was sorry.",
                            "target_lang_translations": {
                                "ru": "Он <w>откровенно</w> сказал мне, что совершил ошибку и сожалеет об этом."
                            }
                        },
                        {
                            "text": "Please deal <w>directly</w> with the issue instead of making excuses.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, займитесь <w>непосредственно</w> проблемой, а не ищите оправдания."
                            }
                        }
                    ],
                    "synonyms": [
                        "frankly",
                        "truthfully"
                    ],
                    "common_phrases": [
                        "deal directly with"
                    ],
                    "target_lang_definitions": {
                        "ru": "Честным и прямолинейным образом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "откровенно",
                                "target_lang_sense_clarification": "искренне и честно"
                            },
                            {
                                "target_lang_word": "честно",
                                "target_lang_sense_clarification": "без обмана"
                            },
                            {
                                "target_lang_word": "прямо",
                                "target_lang_sense_clarification": "начистоту"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9088f90e-ec6c-3f9b-a43c-c48d0ab96449",
                    "sense_definition": "At once; without any delay.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor will be with you <w>directly</w> after he finishes this consultation.",
                            "target_lang_translations": {
                                "ru": "Врач примет вас <w>сразу</w> после того, как закончит эту консультацию."
                            }
                        },
                        {
                            "text": "Please come here <w>directly</w> so we can start the meeting on time.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, приходите сюда <w>тотчас</w>, чтобы мы могли начать собрание вовремя."
                            }
                        }
                    ],
                    "synonyms": [
                        "immediately",
                        "forthwith",
                        "now"
                    ],
                    "antonyms": [
                        "later"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тотчас; без какой-либо задержки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сразу",
                                "target_lang_sense_clarification": "немедленно"
                            },
                            {
                                "target_lang_word": "тотчас",
                                "target_lang_sense_clarification": "в тот же момент"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ebd98181-be35-34b8-ae68-42a265687d6e",
                    "sense_definition": "In a short time; very soon.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We will go to the store <w>directly</w>, but first I need to finish sweeping.",
                            "target_lang_translations": {
                                "ru": "Мы <w>скоро</w> пойдем в магазин, но сначала мне нужно закончить подметать."
                            }
                        },
                        {
                            "text": "The results of the test will be made available <w>directly</w>.",
                            "target_lang_translations": {
                                "ru": "Результаты теста будут доступны <w>вскоре</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "soon",
                        "shortly",
                        "presently"
                    ],
                    "antonyms": [
                        "later"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "often used in older literature"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "В скором времени; очень скоро."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скоро",
                                "target_lang_sense_clarification": "через короткое время"
                            },
                            {
                                "target_lang_word": "вскоре",
                                "target_lang_sense_clarification": "в ближайшем будущем"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "conjunction",
            "senses": [
                {
                    "sense_id": "2eea0f68-efab-31a3-b84a-0d780511d5f2",
                    "sense_definition": "At the same time that; as soon as.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "conjunction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He promised that he would contact her <w>directly</w> he got back from his trip.",
                            "target_lang_translations": {
                                "ru": "Он пообещал, что свяжется с ней, <w>как только</w> вернется из поездки."
                            }
                        },
                        {
                            "text": "The game will begin <w>directly</w> the referee blows the whistle.",
                            "target_lang_translations": {
                                "ru": "Игра начнется, <w>как только</w> судья даст свисток."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "chiefly British"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "В то же время, когда; как только."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "как только",
                                "target_lang_sense_clarification": "сразу после того как"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}