    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "ddc9e81c-6996-37f8-b72b-41daa6c8553d",
                "word": "kalgi",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "4f18b1a6-c2fd-46d4-a713-b3ba3882471e",
                        "entry_id": "ddc9e81c-6996-37f8-b72b-41daa6c8553d",
                        "tags": [
                            "plural"
                        ],
                        "form": "kalgis"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c0f20e1b-0549-30c4-8fc6-357d94b3e334",
                        "entry_id": "ddc9e81c-6996-37f8-b72b-41daa6c8553d",
                        "glosses": [
                            "A black heron feather that is worn on a turban as a symbol of nobility."
                        ],
                        "tags": [
                            "India",
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "3beccfc6-1b87-465a-b529-2b01bf9a85bc",
                                "sense_id": "c0f20e1b-0549-30c4-8fc6-357d94b3e334",
                                "text": "The herons of Kashmir were the main source of supply of feathers which were in great demand for plumes (Kalgis) worn by the Sikh Ministers, Officers of high ranks and other men of importance."
                            },
                            {
                                "example_id": "ed55011e-adeb-410d-92ad-d4366c819c0f",
                                "sense_id": "c0f20e1b-0549-30c4-8fc6-357d94b3e334",
                                "text": "But on turban they painted peacock feathers in place of kalgi and sometimes half bloomed lotus with all the decoration of jewellery and pearls."
                            },
                            {
                                "example_id": "42c10558-8af7-42be-ab7e-476d2a8a6ecc",
                                "sense_id": "c0f20e1b-0549-30c4-8fc6-357d94b3e334",
                                "text": "[…] Singh during the founding of the Khalsa in 1699 show him dressed like royalty of the times: a round turban with a plume or kalgi, a cummerbund (kamar kassa), carrying a silver arrow, stirring the Amrit with a double-edged sword."
                            },
                            {
                                "example_id": "5b2f5647-8deb-474d-8507-24ffaedd6df5",
                                "sense_id": "c0f20e1b-0549-30c4-8fc6-357d94b3e334",
                                "text": "Ranjit Singh is seen in this image wearing a highly decorated turban with three kalgis or plumes and several different jewels and ornaments."
                            }
                        ]
                    },
                    {
                        "sense_id": "723b6295-78c9-306c-8901-bc3450086b0c",
                        "entry_id": "ddc9e81c-6996-37f8-b72b-41daa6c8553d",
                        "glosses": [
                            "An ornament worn on the front of a turban as a symbol of status."
                        ],
                        "tags": [
                            "India",
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "9ae4625d-c95d-4702-9588-7ea777db46c1",
                                "sense_id": "723b6295-78c9-306c-8901-bc3450086b0c",
                                "text": "When the question of kalgi and its whereabouts arose, Archer candidly stated that he could not find any kalgi with Lady Broun Lindsay , a descendant of Lord Dalhousie from whom the weapons of Guru Gobind Singh were acquired and nor was it in the Victoria and Albert Museum."
                            },
                            {
                                "example_id": "238a9363-f008-4ae2-8419-86c189b05cfd",
                                "sense_id": "723b6295-78c9-306c-8901-bc3450086b0c",
                                "text": "Shah Jahan's aesthetics transformed the heron's feather into the extravagantly jewelled kalgi."
                            },
                            {
                                "example_id": "a8eb6454-f243-4b9a-91ff-f8b50691658e",
                                "sense_id": "723b6295-78c9-306c-8901-bc3450086b0c",
                                "text": "An embassy to the governor of the French settlement at Isle de France (Mauritius) in 1798 took kalgis and sarpeches' (turban ornaments) , jewelled rings and earrings described as 'the invention of the khodadad sarkar' ( the 'God-Given Ruler, or Overseer' )."
                            },
                            {
                                "example_id": "494ef312-a5ad-465c-9e67-cd0383890d8b",
                                "sense_id": "723b6295-78c9-306c-8901-bc3450086b0c",
                                "text": "'Please, with your own hands, Mai ji, give us the kalgi of the Sarkar, it shall adorn the Kanwar's head, it shall be a blessing for his life, a charm for his rule.' 'There is nothing in the kalgi,' said the angry Rani, 'it is all in the will of the Almighty.'"
                            },
                            {
                                "example_id": "8f3e1d53-b68c-4b7e-b516-dbc3302e5c12",
                                "sense_id": "723b6295-78c9-306c-8901-bc3450086b0c",
                                "text": "In some cases, before leaving the house his sister might have adorned his turban with a kalgi ( draped beads with a central decoration), but again this is cultural and not religious, and must be removed before his bride joins him."
                            },
                            {
                                "example_id": "94c4ee0a-6c79-4e00-a974-11a3eb7d5bd3",
                                "sense_id": "723b6295-78c9-306c-8901-bc3450086b0c",
                                "text": "Only Guru Sahib is our sovereign and we thus do not wear a kalgi as we are His servants."
                            }
                        ]
                    },
                    {
                        "sense_id": "8097e6be-e1d7-376b-9c29-d698ba96a616",
                        "entry_id": "ddc9e81c-6996-37f8-b72b-41daa6c8553d",
                        "glosses": [
                            "A competitive style of lavani."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "ba5763b0-b0d6-4508-9630-71c52f9dcdab",
                                "sense_id": "8097e6be-e1d7-376b-9c29-d698ba96a616",
                                "text": "The Kalgi- group represented the female element in nature and the Tura the male."
                            },
                            {
                                "example_id": "bedd073c-d6de-4fea-9a63-d61fb3b56a63",
                                "sense_id": "8097e6be-e1d7-376b-9c29-d698ba96a616",
                                "text": "Abdul latif of Aligarh city is an accomplished singer of kalgi school and Habb Khan, Yunus Khan and Wahid of Aligarh city belong to the turra school ."
                            },
                            {
                                "example_id": "d7f8307a-afb4-465a-a139-469c69e57f0a",
                                "sense_id": "8097e6be-e1d7-376b-9c29-d698ba96a616",
                                "text": "They make them just enough knowledgeable to be able to fight either on the side of kalgi or on tura after learning lavni songs for one or the other ."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "0309102c-02df-3f34-a448-160133e263aa",
                "word": "kalgi",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "cf5d42ae-e39a-4e1a-ada5-8efef2adc431",
