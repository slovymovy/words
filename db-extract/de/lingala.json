                "senses": [
                    {
                        "sense_id": "659c01ae-b3ef-3c8f-b927-eb89932713bc",
                        "entry_id": "893dbf30-58fe-34f1-8242-7231386b850e",
                        "glosses": [
                            "vorwiegend in der Demokratischen Republik Kongo und der Republik Kongo gesprochene Sprache"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c0c934c-5e90-4e60-9546-aed295e96b38",
                                "sense_id": "659c01ae-b3ef-3c8f-b927-eb89932713bc",
                                "text": "„Französisch ist Amtssprache, daneben sind in der Verfassung der Republik Kongo die Verkehrssprachen Lingala und Kituba als nationale Verkehrssprachen anerkannt.“"
                            },
                            {
                                "example_id": "114f5475-741a-46b0-bd78-1f8e9c0765e0",
                                "sense_id": "659c01ae-b3ef-3c8f-b927-eb89932713bc",
                                "text": "„Grundsätzlich – vor allem in nicht schulischen Kontexten – betont sie immer wieder, dass Lingala ihre ‚Muttersprache‘ oder auch ‚Heimatsprache‘ sei.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
