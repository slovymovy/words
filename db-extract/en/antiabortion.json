                        "entry_id": "71a8e698-ce3a-3476-bcae-b3efc1db4fd8",
                        "glosses": [
                            "Opposed to the practice or legalization of abortion."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b81fa85b-00cf-4abd-8d8a-d9d991a67a60",
                                "sense_id": "956b8624-048c-3e78-b83b-1d685ff0ba78",
                                "text": "Antiabortion activists pointed out that immigrant families, many of them Catholic, were larger and would soon outpopulate native-born white Yankees and threaten their political power."
                            },
                            {
                                "example_id": "0e8a1fa7-499a-4182-b61b-aeacf2a5190c",
                                "sense_id": "956b8624-048c-3e78-b83b-1d685ff0ba78",
                                "text": "The news reporters tell us that conservatives are antiabortion, anti–gun control, antidiversity, antienvironment, antieverything."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0ec4ec3e-5447-46e0-894c-03dc4cf67da7",
