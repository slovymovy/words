                "translations": [
                    {
                        "translation_id": "0e6b2424-404e-489b-8dae-c2c282326936",
                        "source_entry_id": "34514f55-3647-3652-849d-b09e43975220",
                        "source_sense_description": "port city in Andalusia, Spain",
                        "target_lang_word": "Cadix",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Cadix",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d02ec92c-4ef5-342a-b6dc-166aa6503af3",
                                        "entry_id": "56309885-9f8e-35fc-8fcd-7e175745ad2c",
                                        "glosses": [
                                            "Commune et ville portuaire d’Espagne, chef-lieu de la province du même nom."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1c90af8-5b8b-44d5-973c-f78d591166cd",
                                                "sense_id": "d02ec92c-4ef5-342a-b6dc-166aa6503af3",
                                                "text": "Byron a merveilleusement caractérisé la physionomie de Cadix en une seule touche :\n« Brillante Cadix, qui t’élèves vers le ciel du milieu du bleu foncé de la mer. »"
                                            },
                                            {
                                                "example_id": "77464cbc-814a-4a1c-b794-ef5e5409a077",
                                                "sense_id": "d02ec92c-4ef5-342a-b6dc-166aa6503af3",
                                                "text": "En 1585, des escadres anglaises avaient attaqué, sans déclaration de guerre, Saint-Domingue et Carthagène. Une année plus tard, Drake insulta Lisbonne et détruisit, à Cadix, une flotte entière de navires de transport."
                                            },
                                            {
                                                "example_id": "5f515fc8-eeb3-4686-85b4-28d5b5ddb675",
                                                "sense_id": "d02ec92c-4ef5-342a-b6dc-166aa6503af3",
                                                "text": "L’exploitation des registres paroissiaux de Jerez de la Frontera, ville espagnole située en Andalousie près du port de Cadix, démontre notamment l’exubérance de la vie sous l’Ancien Régime, mais aussi l’omniprésence de la mort."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9751d8de-eff0-3457-b0e2-befa87b431c4",
                                        "entry_id": "56309885-9f8e-35fc-8fcd-7e175745ad2c",
                                        "glosses": [
                                            "Province d’Espagne située dans la communauté autonome d’Andalousie."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Cadix",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1a207b38-aa24-3d95-924a-b0f25cc450c2",
                                        "entry_id": "a90826bd-22f6-36b0-bb20-0030717ced08",
