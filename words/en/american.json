                            }
                        },
                        {
                            "text": "She is a proud <w>American</w> who loves her country.",
                            "target_lang_translations": {
                                "ru": "Она гордая <w>американка</w>, которая любит свою страну.",
                                "zh": "她是一位热爱祖国的自豪的<w>美国人</w>。"
                            }
