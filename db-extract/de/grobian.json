                                "target_senses": [
                                    {
                                        "sense_id": "4545a38d-970b-3dfb-98d7-a5de8ee4ea31",
                                        "entry_id": "f95dc807-922b-3345-aa9f-99c71dec31df",
                                        "glosses": [
                                            "A scoundrel, rascal, or unprincipled, deceitful, brutal and unreliable person."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "279382b7-c0c7-4a5e-aacc-b7d1dfe047f9",
                                                "sense_id": "4545a38d-970b-3dfb-98d7-a5de8ee4ea31",
                                                "text": "What wilt thou on thy death-bed play the Ruffian?"
                                            },
                                            {
                                                "example_id": "51aa71ce-118e-49d0-91fc-67739bd28e10",
                                                "sense_id": "4545a38d-970b-3dfb-98d7-a5de8ee4ea31",
                                                "text": "It was at Count Siloszech's. He'd heard her sing in the streets, with a tall, black-bearded ruffian, who accompanied her on a guitar, and a little fiddling gypsy fellow. She was a handsome woman, with hair down to her knees, but stupid as an owl."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bd1dc2ad-4586-3ce4-ad7f-6e731220364c",
                                        "entry_id": "f95dc807-922b-3345-aa9f-99c71dec31df",
                                        "glosses": [
                                            "A pimp; a pander."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a2ae5664-df69-3aed-a68c-ef72176cf456",
                                        "entry_id": "f95dc807-922b-3345-aa9f-99c71dec31df",
                                        "glosses": [
                                            "A lover; a paramour."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "35432afe-e715-4ea1-969c-53ec781f55e2",
                                                "sense_id": "a2ae5664-df69-3aed-a68c-ef72176cf456",
                                                "text": "He [her husband] is no sooner abroad than she is instantly at home, revelling with her ruffians."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ruffian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "edc701d8-2f18-36be-95cc-a1e5dd89a214",
                                        "entry_id": "c64ef0f8-d29c-391a-a809-f49b69729c62",
                                        "glosses": [
                                            "To play the ruffian; to rage; to raise tumult."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29d16ff9-ddc8-4403-a089-092126f7c899",
                                                "sense_id": "edc701d8-2f18-36be-95cc-a1e5dd89a214",
                                                "text": "Methinks the wind does speak aloud at land; A fuller blast ne'er shook our battlements. If it hath ruffianed so upon the sea."
                                            }
