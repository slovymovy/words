                "senses": [
                    {
                        "sense_id": "e7ecb288-751c-3d30-aeea-6a90d9f9ace8",
                        "entry_id": "5d382bc5-bb2f-3662-b4fa-cd6f0ed6eea5",
                        "glosses": [
                            "Something which or someone who takes a person's life, particularly men; a lethal hazard that affects mostly men or is specific to a primarily male trade."
                        ],
                        "tags": [
                            "idiomatic"
                        ],
                        "examples": [
                            {
                                "example_id": "c15c2262-614a-46c1-941e-d749d09dcc23",
                                "sense_id": "e7ecb288-751c-3d30-aeea-6a90d9f9ace8",
                                "text": "O, it grieves my soul, / That I must draw this metal from my side / To be a widow-maker!"
                            },
                            {
                                "example_id": "4f7b4a62-091d-4f7c-a3d2-ab973a17bd45",
                                "sense_id": "e7ecb288-751c-3d30-aeea-6a90d9f9ace8",
                                "text": "What is a woman that you forsake her, / And the hearth-fire and the home-acre, / To go with the old grey Widow-maker?"
                            },
                            {
                                "example_id": "6247a34e-fdf6-4253-b247-05dbc09b7d82",
                                "sense_id": "e7ecb288-751c-3d30-aeea-6a90d9f9ace8",
                                "text": "Finally, jobs that are 'widow-makers' should be rethought and restructured. In the heyday of the great sailing ships, around 1850, just before the coming of steam, every shipping company had a widow-maker on its hands once in a while. ... One typical 'widow-maker' has been the job of international vice-president in the large American company."
                            }
                        ]
                    },
