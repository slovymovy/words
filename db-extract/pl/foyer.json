                                            "UK"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fc5373c1-1e89-4def-bb1b-a4562d9b9866",
                        "source_entry_id": "4b0066ee-be24-3f2e-b4fa-965fe829c41d",
