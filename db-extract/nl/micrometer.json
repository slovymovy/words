                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a8172d8-b6d5-434a-9276-780dab8df7e5",
                                                "sense_id": "329a191f-0ead-3e6b-9069-48b85f8184c8",
                                                "text": "Il y a un million de micromètres dans un mètre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7984608f-d142-3db6-a0b7-65a0e3d72613",
                                        "entry_id": "96b255ff-8c48-364a-9506-8804e6aa7a69",
                                        "glosses": [
                                            "Appareil qui sert à mesurer avec une très grande précision de petites distances et de petites grandeurs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68ec65d9-3481-4c48-a9bd-2cf5fb7cb8bd",
                                                "sense_id": "7984608f-d142-3db6-a0b7-65a0e3d72613",
                                                "text": "Le diamètre a été mesuré à l’aide d’un microscope muni d’un micromètre oculaire qui avait été comparé préalablement à un micromètre étalon placé dans l’objectif."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
