                                "target_senses": [
                                    {
                                        "sense_id": "7adce665-e9f1-331f-b6ce-120e3f4dc3da",
                                        "entry_id": "5c5c9ec3-f1c6-3cb3-bdf5-98815cd4f80a",
                                        "glosses": [
                                            "A claim or aspiration to a particular status or quality."
                                        ],
