                            },
                            {
                                "target_word": "joystick",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "11bb1be1-9b76-3c99-9795-abe9dd7ce5f6",
                                        "entry_id": "3406530b-d316-3491-b92b-b42e17445df6",
                                        "glosses": [
                                            "To manoeuvre by means of a joystick (sense 1)."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f0da9245-3448-4f6d-951e-30c0b43edf04",
                                                "sense_id": "11bb1be1-9b76-3c99-9795-abe9dd7ce5f6",
                                                "text": "Marketing your home isn't as difficult as joysticking a Mars rover through a crater, despite what many people believe."
                                            },
                                            {
                                                "example_id": "d1510b27-5e5a-4979-bce0-aa44eacb4a7a",
                                                "sense_id": "11bb1be1-9b76-3c99-9795-abe9dd7ce5f6",
                                                "text": "Therefore, part of the errors in the localization results is due to the problem of joysticking the robot exactly onto the marked positions."
                                            },
                                            {
                                                "example_id": "e693d011-7f83-45f2-9b67-4bff6ab893ea",
                                                "sense_id": "11bb1be1-9b76-3c99-9795-abe9dd7ce5f6",
                                                "text": "It can run in autonomous mode or be manually joysticked using a radio controller."
                                            }
                                        ]
                                    }
