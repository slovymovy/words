                {
                    "sense_id": "fdb8d63e-e2ef-3caf-9e9a-fd1b9d86a2bd",
                    "sense_definition": "To become pink or red in color; to flush.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her cheeks <w>rosed</w> with embarrassment when he spoke to her.",
                            "target_lang_translations": {
                                "ru": "Ее щеки <w>порозовели</w> от смущения, когда он заговорил с ней.",
                                "zh": "当他跟她说话时，她的脸颊因尴尬而<w>泛红</w>。"
                            }
                        },
                        {
                            "text": "The first light of dawn <w>rosed</w> the eastern horizon.",
                            "target_lang_translations": {
                                "ru": "Первый свет зари <w>окрасил в розовый цвет</w> восточный горизонт.",
                                "zh": "黎明的第一道曙光把东方地平线<w>染红</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "blush",
                        "flush",
                        "redden"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Становиться розовым или красным; заливаться румянцем.",
                        "zh": "变得呈粉红色或红色；脸红。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "порозоветь",
                                "target_lang_sense_clarification": "изменить цвет"
                            },
                            {
                                "target_lang_word": "заалеть",
                                "target_lang_sense_clarification": "покраснеть"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "泛红",
