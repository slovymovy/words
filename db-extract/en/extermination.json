                "forms": [],
                "senses": [
                    {
                        "sense_id": "5c29d545-17b2-3c58-a3fe-0d05be0fd920",
                        "entry_id": "18adeab4-1b2d-3010-a097-2347ecbdfacc",
                        "glosses": [
                            "Ausrottung, Vernichtung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2180795d-b4bb-4cf1-90f4-f01edf1d3ab2",
                                "sense_id": "5c29d545-17b2-3c58-a3fe-0d05be0fd920",
                                "text": "We must stop the extermination of forest areas.",
                                "translation": "Wir müssen die Vernichtung von Waldflächen stoppen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3d4ba4b0-d01f-4b04-8197-99c29665d296",
                        "source_entry_id": "18adeab4-1b2d-3010-a097-2347ecbdfacc",
                        "source_sense_id": "5c29d545-17b2-3c58-a3fe-0d05be0fd920",
                        "source_sense_description": "Ausrottung, Vernichtung",
                        "target_lang_word": "Ausrottung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ausrottung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4dc1b84b-e30c-3ee4-8330-c02fbfac27ff",
                                        "entry_id": "dfa9da4d-068a-3adc-a76b-bcf2e6092740",
                                        "glosses": [
                                            "komplette Tötung einer Gruppe oder Art"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91532438-add6-47d5-b7c7-c44f6960a44d",
                                                "sense_id": "4dc1b84b-e30c-3ee4-8330-c02fbfac27ff",
                                                "text": "Überfischung kann zur Ausrottung von Fischarten führen."
                                            },
                                            {
                                                "example_id": "c4b79fa2-3144-42bf-93e3-8797e35f9d58",
                                                "sense_id": "4dc1b84b-e30c-3ee4-8330-c02fbfac27ff",
                                                "text": "„Der Trieb zur Ausrottung mochte sich zu allen Zeiten an Gewalt entsprochen haben – monologisierte der Uralte –, aber daß die Menschen hierzu ihre Erfindungen und Konstruktionen einsetzten, berühre ihn absonderlich.“"
                                            },
                                            {
                                                "example_id": "ac9f642c-83d8-4373-8c3a-66322d5f441f",
                                                "sense_id": "4dc1b84b-e30c-3ee4-8330-c02fbfac27ff",
                                                "text": "„Seine prägenden Kriegseindrücke gewann er in der Türkei: Er sah, wie die Türken unter dem Deckmantel des Weltkrieges ein internes Problem klammheimlich lösten: die Vertreibung und Ausrottung der Armenier.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6930bfa2-4a42-4393-8346-9872e752b81b",
                        "source_entry_id": "18adeab4-1b2d-3010-a097-2347ecbdfacc",
                        "source_sense_id": "5c29d545-17b2-3c58-a3fe-0d05be0fd920",
                        "source_sense_description": "Ausrottung, Vernichtung",
                        "target_lang_word": "Vernichtung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vernichtung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "16bfaa79-904f-3eb9-a22a-6193283e6f37",
                                        "entry_id": "d1461e85-6a2a-37e8-a169-d4c1887009c5",
                                        "glosses": [
                                            "Vorgang oder Ergebnis eines Prozesses, der etwas ganz und gar zerstört, so dass der ursprüngliche Zustand (Gegenstand) kaum noch oder gar nicht mehr erkennbar ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cea59e89-af74-465f-91d5-e59d40d1c4c7",
                                                "sense_id": "16bfaa79-904f-3eb9-a22a-6193283e6f37",
                                                "text": "Im Krieg geht es oft um die Vernichtung des Gegners."
                                            },
                                            {
                                                "example_id": "b317e6f1-28ec-4cd4-9c66-163962c3180f",
                                                "sense_id": "16bfaa79-904f-3eb9-a22a-6193283e6f37",
                                                "text": "„Der vollständigen Vernichtung waren die Herero nur durch wirtschaftliche Überlegungen entgangen.“"
                                            },
                                            {
                                                "example_id": "111b42f2-522d-4dad-84ad-6d9fc45a328f",
                                                "sense_id": "16bfaa79-904f-3eb9-a22a-6193283e6f37",
                                                "text": "„Bis zum heutigen Tag wurden im Worms 77 Stolpersteine im öffentlichen Raum verlegt, die an Deportation, Vertreibung und Vernichtung jüdischer Menschen durch die Nationalsozialisten erinnern.“"
                                            },
                                            {
                                                "example_id": "6a54b262-684a-47e8-912e-3138758c0edb",
                                                "sense_id": "16bfaa79-904f-3eb9-a22a-6193283e6f37",
                                                "text": "„Dafür hatte sich nach der Vernichtung der bodenständigen russischen Lebensordnung, wie Pierre unbewusst fühlte, in dieser verwüsteten russischen Mutterzelle eine neue, ganz anders geartete, aber fest gefügte Lebensordnung, nämlich die französische, erhoben.“"
                                            },
                                            {
                                                "example_id": "8974d4f4-910d-4a50-b3b3-f2a18303d3e9",
                                                "sense_id": "16bfaa79-904f-3eb9-a22a-6193283e6f37",
                                                "text": "„Es lief somit auf die Vertreibung und sogar Vernichtung der angestammten Bevölkerung Russlands, der Ukraine und Weißrusslands hinaus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "da4c7263-84cf-45a7-b1d5-5ea1d8723022",
                        "source_entry_id": "18adeab4-1b2d-3010-a097-2347ecbdfacc",
