                        ],
                        "form": "die Tulpenmanie"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "dd3e4f84-942c-3c70-80b2-7c8839c4c028",
                        "entry_id": "4ea8d68f-b7a2-3b97-a40f-e8d6e2a13973",
                        "glosses": [
                            "übersteigerte Erwartung in das Steigen der Tulpenpreise im Holland des 17. Jahrhunderts"
                        ],
                        "tags": [
                            "Wirtschaftsgeschichte"
                        ],
                        "examples": [
                            {
                                "example_id": "83620a56-42b1-430a-a992-9b440ddf44f5",
                                "sense_id": "dd3e4f84-942c-3c70-80b2-7c8839c4c028",
                                "text": "Die Tulpenmanie: Was heute eine Allerweltsblume ist, war im 17. Jahrhundert eine exotische Gartenpretiose."
                            },
                            {
                                "example_id": "65b7965d-1f28-4ee1-8b16-97f8cc86f71e",
                                "sense_id": "dd3e4f84-942c-3c70-80b2-7c8839c4c028",
                                "text": "Und der Handel mit Tulpen wurde immer lukrativer. Der Anfang der Tulpenmanie. Ihre reale wirtschaftliche Grundlage war die Nachfrage der Tulpenliebhaber, der Connaisseure. Doch bald entdeckten Geschäftemacher die Gewinnmöglichkeiten."
                            },
                            {
                                "example_id": "0f6a7c70-ad7d-4309-bdbb-a35ac3f527d9",
                                "sense_id": "dd3e4f84-942c-3c70-80b2-7c8839c4c028",
                                "text": "Da war etwa die Tulpenmanie im Holland des 17. Jahrhunderts. Eine Handvoll Spekulanten in Haarlem trieben den Preis von Tulpenzwiebeln 1636 in schwindelerregende Höhen."
                            },
                            {
                                "example_id": "86f956b3-38be-4c6a-91e2-3fd7ebf5c300",
                                "sense_id": "dd3e4f84-942c-3c70-80b2-7c8839c4c028",
                                "text": "Die teuerste Tulpenzwiebel kostete damals 5200 Gulden. Die Folgen der Tulpenmanie waren katastrophal, Parallelen zur heutigen Finanzkrise liegen nahe."
                            },
                            {
                                "example_id": "bf7abdcd-d20c-4db9-a71b-f58cd4f6c231",
                                "sense_id": "dd3e4f84-942c-3c70-80b2-7c8839c4c028",
                                "text": "Die Historie bietet Beispiele: Das Goldene Zeitalter der niederländischen Wirtschaft wurde durch das Ende der Tulpenmanie der 1630er Jahre kaum berührt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e5cfedce-3c3a-41f6-ac04-8cc2d22c80ff",
                        "source_entry_id": "4ea8d68f-b7a2-3b97-a40f-e8d6e2a13973",
                        "source_sense_id": "dd3e4f84-942c-3c70-80b2-7c8839c4c028",
