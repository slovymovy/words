                ],
                "senses": [
                    {
                        "sense_id": "6a9452c1-f103-3f08-995f-a489cb5fa2e2",
                        "entry_id": "a356c9b6-f112-3913-8646-982e23c863fa",
                        "glosses": [
                            "Verbindung aus mehreren Makromolekülen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32514da1-a3f6-4d27-86cd-598e396a3c4a",
                                "sense_id": "6a9452c1-f103-3f08-995f-a489cb5fa2e2",
                                "text": "„Julia Kehr forscht an der Aufklärung der Struktur und Funktion von Proteinen und Makromolekülkomplexen in den Langstreckentransportsystemen und ihrer Funktion bei der systemischen Signalweiterleitung bei abiotischem Stress und Infektionen.“"
                            },
                            {
                                "example_id": "3ca3d80f-b201-41db-9e98-966e2c84be0d",
                                "sense_id": "6a9452c1-f103-3f08-995f-a489cb5fa2e2",
                                "text": "„Der Mureinsacculus der meisten Bakterien ist ein Makromolekülkomplex mit einem Gerüst aus langen Heteropolysaccharidketten, die über kurze Peptidketten miteinander vernetzt sind.“"
                            },
                            {
                                "example_id": "3380b233-0783-4b58-ad73-add2f8e801d9",
                                "sense_id": "6a9452c1-f103-3f08-995f-a489cb5fa2e2",
                                "text": "„In alkalischem Medium bildet das Cr einen Makromolekülkomplex, der überhaupt nicht resorbiert wird.“"
                            },
                            {
                                "example_id": "cf859878-8cb1-45ba-ae16-3c285bbc009a",
                                "sense_id": "6a9452c1-f103-3f08-995f-a489cb5fa2e2",
                                "text": "„Ihr Proteinkern beträgt etwa 20–25% des Gesamtgewichtes des Makromolekülkomplexes und ist im Falle des Chondroitinsulfates mit 60–70 Polysaccharidketten verbunden.“"
                            },
                            {
                                "example_id": "4cdca01f-5d09-47a6-937b-eaa124134882",
                                "sense_id": "6a9452c1-f103-3f08-995f-a489cb5fa2e2",
                                "text": "„Dieser Zellkern enthält Ihre Chromosomen, 46 Makromolekülkomplexe, von denen jedes bis zu 300 Millionen Paare von Nukleinsäuren enthält, die den genetischen Code darstellen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
