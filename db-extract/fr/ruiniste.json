                        "entry_id": "5b92fe91-f075-342b-be12-234a5ea219f5",
                        "glosses": [
                            "Qui est un ruiniste, une ruiniste ; qui se rapporte à l’art ou à l’inspiration des ruinistes."
                        ],
                        "tags": [
                            "Peinture"
                        ],
                        "examples": [
                            {
                                "example_id": "9a43d052-3848-4deb-8af6-dafa38c4b540",
                                "sense_id": "a3b788ed-ed8b-3880-9c7b-6586bc9e5756",
                                "text": "Piranesi a fasciné nos peintres ruinistes : Hubert Robert collectionnait ses estampes."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "39d4c3be-2dd2-3a03-b32a-67c670e53665",
                "word": "ruiniste",
                "pos": "noun",
