                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d7861ea6-2ea7-418d-a6f0-38d7e96cb615",
                                "sense_id": "97721807-4269-35b6-bdab-83ddf490da12",
                                "text": "Afgelopen weekend lekte 50.000 liter ruwe olie uit een pijpleiding in zee. De olielaag op de toeristische stranden van het eiland Koh Samet is grotendeels weggehaald. Maar volgens de Thaise minister van Energie duurt het nog jaren voor de stranden weer in hun oude staat zijn hersteld."
                            }
                        ]
                    },
