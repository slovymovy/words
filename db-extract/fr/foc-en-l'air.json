                    {
                        "sense_id": "e06cfa86-9857-34a7-9469-3fca766381ac",
                        "entry_id": "f5f70c0c-e903-359d-beaf-0c3404725cd3",
                        "glosses": [
                            "Foc établi sur la draille de petit foc. — (http://www.seadict.com/fr/fr/foc%20en%20l'air)"
                        ],
