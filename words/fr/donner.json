    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cb9e0b86-8630-3653-b544-d20fefe17e20",
                    "sense_definition": "Transférer la possession d'une chose à quelqu'un gratuitement ou lui remettre quelque chose en main.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "transfert",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pour son anniversaire, sa grand-mère lui a <w>donné</w> une belle montre en argent."
                        },
                        {
                            "text": "Tu peux me <w>donner</w> le sel qui est posé au bout de la table ?"
                        }
                    ],
                    "synonyms": [
                        "offrir"
                    ],
                    "antonyms": [
                        "garder",
                        "retenir",
                        "vendre"
                    ],
                    "common_phrases": [
                        "donner un cadeau",
                        "donner de argent"
                    ]
                },
                {
                    "sense_id": "6a1e795a-ea9e-32b0-8530-66b158528dd5",
                    "sense_definition": "Communiquer ou faire connaître une idée, un renseignement ou une réponse.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le professeur nous <w>donne</w> les explications nécessaires pour réussir l'examen de français."
                        },
                        {
                            "text": "Chaque participant peut <w>donner</w> son avis librement pendant cette réunion importante."
                        }
                    ],
                    "synonyms": [
                        "fournir"
                    ],
                    "common_phrases": [
                        "donner son avis",
                        "donner une réponse",
                        "donner des explications"
                    ]
                },
                {
                    "sense_id": "d093f1b0-030b-3e5e-b04f-6d9a85794460",
                    "sense_definition": "Provoquer ou faire naître une émotion, une sensation ou une impression chez quelqu'un.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "effet",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La bonne odeur du pain chaud me <w>donne</w> faim tous les matins."
                        },
                        {
                            "text": "Ce grand voyage à travers les montagnes lui a <w>donné</w> envie de repartir."
                        }
                    ],
                    "common_phrases": [
                        "donner envie",
                        "donner faim",
                        "donner impression"
                    ]
                },
                {
                    "sense_id": "8cf59252-456f-3bd1-a87f-073f51ab9e20",
                    "sense_definition": "Porter ou appliquer une action physique sur quelqu'un ou quelque chose.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "action_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Avant de partir à l'école, la mère <w>donne</w> un baiser tendre à son fils."
                        },
                        {
                            "text": "Il a accidentellement <w>donné</w> un coup de pied dans la table basse du salon."
                        }
                    ],
                    "common_phrases": [
                        "donner un coup",
                        "donner un baiser"
                    ]
                },
                {
                    "sense_id": "0f96667b-d3c4-32a2-ae50-fd67011969e8",
                    "sense_definition": "Avoir une vue ou une issue directe sur un lieu déterminé.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "orientation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les fenêtres de ma nouvelle chambre <w>donnent</w> sur un grand parc fleuri."
                        },
                        {
                            "text": "Cette porte dérobée <w>donne</w> directement dans une cour intérieure très calme."
                        }
                    ],
                    "common_phrases": [
                        "donner sur la rue",
                        "donner sur le jardin"
                    ]
                },
                {
                    "sense_id": "3a47daaa-84a5-307a-b21a-bcea7e967ded",
                    "sense_definition": "Produire des fruits, une récolte ou apporter un résultat naturel ou matériel.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "production",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce vieux pommier dans le verger <w>donne</w> beaucoup de fruits chaque automne."
                        },
                        {
                            "text": "Malgré la sécheresse persistante, la vigne a bien <w>donné</w> cette année."
                        }
                    ],
                    "synonyms": [
                        "fournir"
                    ],
                    "common_phrases": [
                        "donner des fruits"
                    ]
                },
                {
                    "sense_id": "6a2b493e-00ce-3e92-9f6e-819fe208df00",
                    "sense_definition": "Organiser et offrir une réception, un spectacle ou un repas pour des invités.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "reception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nos voisins vont <w>donner</w> une grande fête dans leur jardin pour le solstice d'été."
                        },
                        {
                            "text": "Cet orchestre prestigieux <w>donne</w> un concert exceptionnel à la salle des fêtes ce soir."
                        }
                    ],
                    "synonyms": [
                        "offrir"
                    ],
                    "common_phrases": [
                        "donner une fête",
                        "donner un concert",
                        "donner un dîner"
                    ]
                },
                {
                    "sense_id": "cd9671ea-7ef2-3eb7-8ad4-a62ec7c77077",
                    "sense_definition": "Accorder ou octroyer du temps, un délai ou une autorisation à quelqu'un.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "concession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur a accepté de nous <w>donner</w> un délai supplémentaire pour terminer le projet."
                        },
                        {
                            "text": "Le juge lui <w>donne</w> la permission exceptionnelle de rendre visite à sa famille."
                        }
                    ],
                    "synonyms": [
                        "céder"
                    ],
                    "antonyms": [
                        "retenir"
                    ],
                    "common_phrases": [
                        "donner du temps",
                        "donner une permission"
                    ]
                },
                {
                    "sense_id": "52020a34-587b-3bfa-937f-753585fc9c96",
                    "sense_definition": "Dénoncer ou trahir un complice ou une personne auprès de la police ou d'ennemis.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "trahison",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sous la pression des enquêteurs, le suspect a fini par <w>donner</w> tous ses complices."
                        },
                        {
                            "text": "Dans ce milieu dangereux, personne ne pardonne à celui qui a <w>donné</w> un ami."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "registre familier et argotique"
                        }
                    ]
                }
            ]
        }
    ]
}