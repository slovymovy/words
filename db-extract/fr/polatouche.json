                "senses": [
                    {
                        "sense_id": "f02eddc2-46c7-37c6-908a-7b46eb892381",
                        "entry_id": "bf877fba-c221-3921-a152-628b91ca36ee",
                        "glosses": [
                            "Nom vulgaire de divers rongeurs de la famille des sciuridés, qui possèdent tous une excroissance de peau située entre les pattes antérieures et postérieures, leur permettant de planer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed94bdcf-71b8-4d51-bd5b-779101aae945",
                                "sense_id": "f02eddc2-46c7-37c6-908a-7b46eb892381",
                                "text": "Le plus long vol plané de polatouche jamais observé est de 40 mètres !"
                            },
                            {
                                "example_id": "cfe1fbda-169f-4ff0-ace0-79241a3ef741",
                                "sense_id": "f02eddc2-46c7-37c6-908a-7b46eb892381",
                                "text": "Je dors dans le jardin.\nC’est amusant de voir planer\nles polatouches."
                            },
                            {
                                "example_id": "f2a8776e-c39d-4faa-9ea3-e8d295f1d3ed",
                                "sense_id": "f02eddc2-46c7-37c6-908a-7b46eb892381",
                                "text": "Chez les rongeurs, le loir est devenu l’icône de la paresse, ce qui est parfaitement injuste …. Cet animal d’Europe et d’Asie méridionale … ressemble à s’y méprendre à l’écureuil et au polatouche, un écureuil volant d’Amérique du Nord qui plane d’arbre en arbre."
                            }
                        ]
                    }
                ],
