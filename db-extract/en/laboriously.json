    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "2f962c82-c42c-3f32-8eae-7001d86aacc5",
                "word": "laboriously",
                "pos": "adv",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "034517e1-4161-32a8-a146-a21090cc1834",
                        "entry_id": "2f962c82-c42c-3f32-8eae-7001d86aacc5",
                        "glosses": [
                            "With great expenditure of effort, in a manner requiring much labor."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "152ea313-52f0-403e-913d-f89e3e6e2d8f",
                                "sense_id": "034517e1-4161-32a8-a146-a21090cc1834",
                                "text": "The heavy man laboriously climbed the steep mountain, pulling himself up inch by inch."
                            },
                            {
                                "example_id": "b97b1153-e82d-48f8-b616-f33022989311",
                                "sense_id": "034517e1-4161-32a8-a146-a21090cc1834",
                                "text": "At the far end of the houses the head gardener stood waiting for his mistress, and he gave her strips of bass to tie up her nosegay. This she did slowly and laboriously, with knuckly old fingers that shook."
                            },
                            {
                                "example_id": "c3dfd41e-a0cd-4a36-a77a-ad6fafe2ea4a",
                                "sense_id": "034517e1-4161-32a8-a146-a21090cc1834",
                                "text": "For many years the coal measures on the shores of Lough Allen were worked only in the most primitive fashion, and the coal was transported laboriously in the inevitable ass carts of the Irish peasant."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "476a527c-f1ed-4057-babe-4def682e1478",
                        "source_entry_id": "2f962c82-c42c-3f32-8eae-7001d86aacc5",
                        "source_sense_id": "034517e1-4161-32a8-a146-a21090cc1834",
                        "source_sense_description": "with great expenditure of effort",
                        "target_lang_word": "pracně",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "f69c370c-196d-4c96-ab1c-b4f7093137d2",
                        "source_entry_id": "2f962c82-c42c-3f32-8eae-7001d86aacc5",
                        "source_sense_id": "034517e1-4161-32a8-a146-a21090cc1834",
                        "source_sense_description": "with great expenditure of effort",
                        "target_lang_word": "laborieusement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "laborieusement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "497ed65f-e2e8-39ea-807b-6046d14f6519",
                                        "entry_id": "029192b4-75a2-3bef-bfa4-2cb128416a95",
                                        "glosses": [
                                            "D’une manière laborieuse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26ea0665-0e42-43c3-b8d6-927284f07ac7",
                                                "sense_id": "497ed65f-e2e8-39ea-807b-6046d14f6519",
                                                "text": "Je tremble d’avoir laborieusement fortifié des préjugés ; il [le jeune Huron] n'écoute que la simple nature."
                                            },
                                            {
                                                "example_id": "e9f6c435-44e1-4127-8bdd-a6982114483c",
                                                "sense_id": "497ed65f-e2e8-39ea-807b-6046d14f6519",
                                                "text": "Pàtsa s'avance en traînant les pieds, prend la craie et commence, laborieusement, à tracer : « Il n'ai pas a l'école passe qu'il a la pécole. »\nÉclat de rire général dans la classe. Le maître a du mal à retenir un sourire."
                                            },
                                            {
                                                "example_id": "c751f732-ee46-470b-be63-4b103ee357b1",
                                                "sense_id": "497ed65f-e2e8-39ea-807b-6046d14f6519",
                                                "text": "Tout le monde se servit, même Tauno, qui se leva laborieusement du canapé et prit toute une poignée de grignoteries dans le sachet d’Irma."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c88946ba-cdaf-306a-b3f5-16487e9a79fa",
                                        "entry_id": "029192b4-75a2-3bef-bfa4-2cb128416a95",
                                        "glosses": [
                                            "En travaillant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4da8a32-3db7-45ca-b1f3-5bcfcbf8ee49",
                                                "sense_id": "c88946ba-cdaf-306a-b3f5-16487e9a79fa",
                                                "text": "S'il [un homme de talent] est de bon commerce, il leur [aux jeunes gens] est une leçon utile : il leur apprend qu’on peut vivre gaiement et laborieusement, avoir des vues sérieuses sans renoncer aux plaisirs honnêtes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
