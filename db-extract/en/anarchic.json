                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "066c5db6-2e80-39b5-a330-01ab94a03ad7",
                                        "entry_id": "ebc5f49a-ec94-32b8-984a-05e1405853a9",
                                        "glosses": [
                                            "eine politische oder philosophische Überzeugung für die Abwesenheit einer Herrschaft oder einen Zustand ohne Gesetze, wofür für die Durchsetzung dieses Zustandes auch Gewalt ein akzeptables Mittel ist; herrschaftslos"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5bd97a8d-c02d-415c-b8aa-883c367ca8e1",
                                                "sense_id": "066c5db6-2e80-39b5-a330-01ab94a03ad7",
                                                "text": "„In meinem Traum bin ich ein anarchistischer Theaterdirektor. Mit Anarchie meine ich nicht das Chaos. Sondern: Dass kein Mensch Macht über andere Menschen hat.“"
                                            },
                                            {
                                                "example_id": "92289e2e-685e-4104-a854-047c32599926",
                                                "sense_id": "066c5db6-2e80-39b5-a330-01ab94a03ad7",
                                                "text": "[Die Zeitschrift] 'pardon' wird zum Kultblatt der 68er-Bewegung und jüngeren Intelligenz. Absurd, anarchistisch und geistreich verbindet die Zeitschrift Politik mit Witz und Information mit Satire. Für die konservativen Jahre der Adenauer-Ära ist das etwas völlig Neues."
                                            },
                                            {
                                                "example_id": "21cfedf6-1c97-4788-80da-a671a174d628",
                                                "sense_id": "066c5db6-2e80-39b5-a330-01ab94a03ad7",
                                                "text": "Zu heikel erschienen den Zensoren die Aussagen des Films [\"Spur der Steine\" von Frank Beyer], zu anarchistisch und antisozialistisch die Grundtendenz."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eefaa0a4-3e64-4129-8bda-5817990e8ae8",
                        "source_entry_id": "f36fc75f-1656-347c-af4f-acbdb4f453a8",
                        "source_sense_description": "relating to anarchy",
                        "target_lang_word": "anarchiczny",
