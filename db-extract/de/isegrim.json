                "senses": [
                    {
                        "sense_id": "06708b00-f630-3fc4-8e50-b33f0c3a2b9c",
                        "entry_id": "2728d43b-767c-3c18-9843-00aa5e736b42",
                        "glosses": [
                            "Eigenname des Wolfes in der Fabel „Reineke Fuchs“ und anderen Erzählungen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b860b86-eda5-4c07-8208-71278c1b833e",
                                "sense_id": "06708b00-f630-3fc4-8e50-b33f0c3a2b9c",
                                "text": "„Muß ich nach Rom, so laufen Weib und Kind Gefahr an Leben und Leib; Denn Isegrim schont ihrer nicht, Wenn er sie in die Klauen kricht;“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a7a46ef9-4731-3c93-a933-ef20de158c8e",
                        "entry_id": "2728d43b-767c-3c18-9843-00aa5e736b42",
                        "glosses": [
                            "Säugetier der Art Canis lupus"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "c6bda246-85ee-4316-a797-3b7c329c7a33",
                                "sense_id": "a7a46ef9-4731-3c93-a933-ef20de158c8e",
                                "text": "„Der umstrittenste Rückkehrer ist und bleibt der Wolf. Isegrim ist inzwischen bis an die Stadtgrenze Dahlen-Oschatz vorgedrungen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "0a3d76e3-c450-35e7-9d8b-e57fbff73bf8",
                        "entry_id": "2728d43b-767c-3c18-9843-00aa5e736b42",
                        "glosses": [
                            "mürrische, übellaunige, abweisende Person"
                        ],
                        "tags": [
                            "derogatory",
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "8bad6e48-76dd-42c4-83c3-fe41b1559bcc",
                                "sense_id": "0a3d76e3-c450-35e7-9d8b-e57fbff73bf8",
                                "text": "„Du bist 'n richtiger Isegrim.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
