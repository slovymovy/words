                                "target_senses": [
                                    {
                                        "sense_id": "e90a5cc9-d147-3432-9927-205e82bae68c",
                                        "entry_id": "11ac89ce-2a66-38f5-961c-86bb77ad2ebd",
                                        "glosses": [
                                            "A standard by which something is evaluated or measured."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09e05fd3-fd18-4395-9458-983b90d19f09",
                                                "sense_id": "e90a5cc9-d147-3432-9927-205e82bae68c",
                                                "text": "Near-synonym: criterion"
                                            },
                                            {
                                                "example_id": "d412d833-39f1-4648-9567-be9c27c2f1be",
                                                "sense_id": "e90a5cc9-d147-3432-9927-205e82bae68c",
                                                "text": "Is the pope Catholic? Forgive the posing of a question that is usually rhetorical, the absolute benchmark of certainty, and traditionally regarded as even more settled than the one pertaining to the lavatorial arrangements of bears."
                                            },
                                            {
                                                "example_id": "da2ea9f3-983f-4b45-b980-0da32d599616",
                                                "sense_id": "e90a5cc9-d147-3432-9927-205e82bae68c",
                                                "text": "In a press release, CARB expanded on their decision. \"The LCFS reduces air pollution and greenhouse gas emissions by setting a declining carbon intensity target for transportation fuels used in California; producers that don't meet established benchmarks buy credits from those that do. This system has generated $4 billion in annual private sector investment toward a cleaner transportation sector.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "496bdfbf-ffd1-3d1a-99da-6089088501d4",
                                        "entry_id": "11ac89ce-2a66-38f5-961c-86bb77ad2ebd",
                                        "glosses": [
                                            "A surveyor's mark made on some stationary object and shown on a map; used as a reference point."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3658f0f3-275f-48c1-9988-0ce72837d749",
                                                "sense_id": "496bdfbf-ffd1-3d1a-99da-6089088501d4",
                                                "text": "Near-synonym: datum"
                                            }
                                        ]
                                    },
                                    {
