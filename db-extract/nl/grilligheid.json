                        "examples": [
                            {
                                "example_id": "e5438497-106e-4b6f-9e35-d0f3754e92d2",
                                "sense_id": "6d855b0b-8511-3abf-be45-ea036cfbd12d",
                                "text": "Hij zei het met een scheve knik van het hoofd, niet van harte, alsof hij de gast diens grilligheid verweet."
                            },
                            {
                                "example_id": "4e12d41f-fe6f-418b-8acd-151ceef5811a",
                                "sense_id": "6d855b0b-8511-3abf-be45-ea036cfbd12d",
                                "text": "Maar hier en daar gloort ook een sprankje hoop. De Nederlander Jeroen Ketting is niet voor één gat te vangen. Hij woont en onderneemt al 26 jaar in Rusland en kent de grilligheid van de Russische economie. Hij is oprichter en mede-eigenaar van Lighthouse Technology, dat westerse apparatuur importeert en verkoopt aan Russische productiebedrijven."
                            }
                        ]
                    }
