                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "peacefully",
                                "target_lang_sense_clarification": "in a quiet or calm manner"
                            },
                            {
                                "target_lang_word": "tranquilly",
                                "target_lang_sense_clarification": "in a serene way"
                            }
                        ]
                    }
                }
            ]
        }
    ]
