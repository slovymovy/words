                "senses": [
                    {
                        "sense_id": "20051d16-fc83-3c2b-8b1a-1bd8d69ed868",
                        "entry_id": "8e2991eb-ffa8-37e2-80b5-989661605170",
                        "glosses": [
                            "Tat, Handlung, Aktion im Zuge der Teilnahme an einem Krieg"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "64461ce3-edc6-46bb-9e98-bc52460270a9",
                                "sense_id": "20051d16-fc83-3c2b-8b1a-1bd8d69ed868",
                                "text": "„Russische und ausländische Kollegen Babitzkijs werten das als bisher schärfste Drohung der Militärs gegen unliebsame Augenzeugen ihrer Kriegstaten.“"
                            },
                            {
                                "example_id": "0a556d2a-9d71-42f5-a89d-61e97207a35b",
                                "sense_id": "20051d16-fc83-3c2b-8b1a-1bd8d69ed868",
                                "text": "„Mit einem Mitchell-Flugzeug stürzte der mit dem Rang eines Kommandeurs der Ehrenlegion ausgezeichnete Offizier am Nordrand der Wüste Sahara, dem Schauplatz seiner bekanntesten Kriegstat, in einem Sandsturm ab.“"
                            },
                            {
                                "example_id": "62f36631-93c4-4165-b117-88ae231a5c85",
                                "sense_id": "20051d16-fc83-3c2b-8b1a-1bd8d69ed868",
                                "text": "„Er erzählte ausführlich von seinen Kriegstaten und unterrichtete Wied-Neuwied in seiner Sprache.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
