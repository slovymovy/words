                        "examples": [
                            {
                                "example_id": "a9563a3c-d9d9-41d8-85e4-5868ef90b62d",
                                "sense_id": "0b5bd2ec-0baa-3463-914c-6e07fd8455b6",
                                "text": "Je veux du fil nylon épais, l’ultracostaud, celui pour aller à la pêche au gros."
                            },
                            {
                                "example_id": "846a5d2c-af24-4ca9-aec1-280e2ce05a16",
                                "sense_id": "0b5bd2ec-0baa-3463-914c-6e07fd8455b6",
                                "text": "Un p’tit sachet d'écrous, une débroussailleuse, du désherbant ultracostaud ?"
                            },
                            {
                                "example_id": "ca7440f5-f16b-4bbe-a6ff-844ad81c62f3",
                                "sense_id": "0b5bd2ec-0baa-3463-914c-6e07fd8455b6",
                                "text": "C’est l’une des prouesses réalisées par des chercheurs de l’université Stanford, qui ont mis au point des minirobots ultracostauds."
                            },
                            {
                                "example_id": "bb37494e-4d59-4c42-881c-b78a0cd5b3ae",
                                "sense_id": "0b5bd2ec-0baa-3463-914c-6e07fd8455b6",
                                "text": "Petite, mais ultracostaude : elle contient 17 % de protéines, soit plus que n’importe quelle céréale."
                            }
                        ]
                    }
