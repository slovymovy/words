{
    "word_family": [
        "ratage",
        "raté",
        "inratable"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a7bfd719-0f9b-3a14-8ab8-5e3e816819d1",
                    "sense_definition": "Manquer un moyen de transport, un rendez-vous ou un événement auquel on devait participer.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "manquer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dépêche-toi un peu si tu ne veux pas <w>rater</w> le train de huit heures."
                        },
                        {
                            "text": "Elle s'est réveillée trop tard ce matin et a fini par <w>rater</w> son cours."
                        }
                    ],
                    "synonyms": [
                        "manquer",
                        "louper"
                    ],
                    "antonyms": [
                        "attraper"
                    ],
                    "common_phrases": [
                        "rater le train",
                        "rater le bus",
                        "rater le coche"
                    ]
                },
                {
                    "sense_id": "cc4d7f94-c339-3564-ae2a-a13ee2b9e86c",
                    "sense_definition": "Échouer dans une entreprise, ne pas réussir un examen, une tâche ou une recette.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "echouer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Paul a peur de <w>rater</w> son examen de conduite pour la deuxième fois consécutive."
                        },
                        {
                            "text": "J'ai complètement <w>raté</w> cette recette de gâteau en oubliant la levure."
                        }
                    ],
                    "synonyms": [
                        "échouer",
                        "louper"
                    ],
                    "antonyms": [
                        "réussir"
                    ],
                    "common_phrases": [
                        "rater son coup",
                        "rater un examen"
                    ]
                },
                {
                    "sense_id": "b716f05d-c16c-3841-8361-768900ad0400",
                    "sense_definition": "Ne pas atteindre ou frapper ce que l'on visait, comme une cible ou un but.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "viser",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'attaquant a tiré de toutes ses forces mais a réussi à <w>rater</w> la cage vide."
                        },
                        {
                            "text": "Le chasseur a ajusté sa carabine mais a malheureusement <w>raté</w> sa cible."
                        }
                    ],
                    "synonyms": [
                        "manquer"
                    ],
                    "antonyms": [
                        "toucher",
                        "atteindre"
                    ],
                    "common_phrases": [
                        "rater la cible"
                    ]
                },
                {
                    "sense_id": "7be9ec62-d1fe-3b23-b8b4-ea6b0cce81e1",
                    "sense_definition": "En parlant d'une arme à feu ou d'un moteur, ne pas fonctionner au moment du déclenchement.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "mecanisme",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le garde a voulu tirer en l'air mais le vieux fusil a <w>raté</w> sans bruit."
                        },
                        {
                            "text": "L'inspecteur a appuyé sur la détente mais le pistolet a subitement <w>raté</w>."
                        }
                    ]
                }
            ]
        }
    ]
}