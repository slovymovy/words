                ],
                "senses": [
                    {
                        "sense_id": "0d856492-2d55-35c5-8796-b47bf889ddab",
                        "entry_id": "22dacccd-c03c-3436-a269-90bf760b4d73",
                        "glosses": [
                            "относяшийся к обозу"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7712f2f4-3215-40bb-b1d0-2b5483d4abbb",
                                "sense_id": "0d856492-2d55-35c5-8796-b47bf889ddab",
                                "text": "Давид оставил свою ношу обозному сторожу и побежал в ряды."
                            },
                            {
                                "example_id": "d9801266-8d05-4a1f-9b81-73febb8cd7b3",
                                "sense_id": "0d856492-2d55-35c5-8796-b47bf889ddab",
                                "text": "Лошадей в германской армии много, правда, это обозные лошади, а не кавалерийские."
                            }
                        ]
                    },
                    {
                        "sense_id": "0998ec64-f9a5-3bad-a7fa-080fa0634190",
                        "entry_id": "22dacccd-c03c-3436-a269-90bf760b4d73",
                        "glosses": [
                            "устар. связанный с принадлежностями конного транспорта или с их производством"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92aaa46c-3838-401e-b687-31badef419ce",
                                "sense_id": "0998ec64-f9a5-3bad-a7fa-080fa0634190",
                                "text": "В городе было два завода: обозный и металлоизделий."
                            }
                        ]
                    },
                    {
                        "sense_id": "201dcfdf-d27a-3abe-92a0-27bd0f8a3ca1",
                        "entry_id": "22dacccd-c03c-3436-a269-90bf760b4d73",
                        "glosses": [
                            "субстантивир. военнослужащий обоза"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c83d429a-90f8-48fa-9381-305fb1865003",
                                "sense_id": "201dcfdf-d27a-3abe-92a0-27bd0f8a3ca1",
                                "text": "Они не ходят возле саней, подергивая вожжами, как это делают полковые обозные."
                            }
                        ]
                    }
