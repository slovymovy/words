                "senses": [
                    {
                        "sense_id": "c4d2b636-87bb-3625-bd92-91339249363f",
                        "entry_id": "d7d471fa-8cfe-3842-a0bd-482f90ff39fa",
                        "glosses": [
                            "Kot, der von einem Vogel stammt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc8d1a13-8741-4b7f-b1d0-759ce09c717e",
                                "sense_id": "c4d2b636-87bb-3625-bd92-91339249363f",
                                "text": "„Im Sommer gibt es viele Gefahren für den Autolack: Nicht nur Baumharz und Vogelkot sollten schnell entfernt werden, sondern auch die Hinterlassenschaften von Blattläusen.“"
                            },
                            {
                                "example_id": "cb1666ca-8eb4-4ff6-9417-49e42a361f8c",
                                "sense_id": "c4d2b636-87bb-3625-bd92-91339249363f",
                                "text": "„Sie lächelte, beugte sich vor, wischte den Vogelkot vom Grabkreuz ihrer Mutter, und es kam ein Name zum Vorschein: Aldís.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
