                    {
                        "translation_id": "dc6817fa-5539-4c49-a4a6-8a3a26ff0d6c",
                        "source_entry_id": "cd0590c5-6e8c-361e-afe5-94d1347fe6ee",
                        "target_lang_word": "gantline",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gantline",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4766a12b-d415-3bb9-bc68-8d1237a8bfa8",
                                        "entry_id": "06c2a1b9-353a-3ff5-912c-884af1f799ef",
                                        "glosses": [
                                            "A line rigged to a mast, used to hoist rigging."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21c8ec69-3959-4777-a71c-8c785d83c83d",
                                                "sense_id": "4766a12b-d415-3bb9-bc68-8d1237a8bfa8",
                                                "text": "A moment later, I saw the man's head appear over the top. He had the tail-block slung round his neck, and the end of the gantline over his shoulder."
                                            },
                                            {
                                                "example_id": "82ba0923-7920-4c42-945c-d078f4b68753",
                                                "sense_id": "4766a12b-d415-3bb9-bc68-8d1237a8bfa8",
                                                "text": "He drew deep breath; a gantline swayed aloft\nA lower topsail, hard with rope and leather,\nSuch as men's frozen fingers fight with oft\nBelow the Ramirez in Cape Hom weather."
                                            },
                                            {
                                                "example_id": "36c53d90-b506-40c7-aa95-981107ca9869",
                                                "sense_id": "4766a12b-d415-3bb9-bc68-8d1237a8bfa8",
                                                "text": "“Now then — to the main topsail now! Tally on to that gantline. Don't stand about there!”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
