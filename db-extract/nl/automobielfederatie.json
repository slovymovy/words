                        "examples": [
                            {
                                "example_id": "2c221e01-be4c-4871-8639-8d2ce23ed49f",
                                "sense_id": "e03034b2-14b4-3e92-bd95-c2ca25c81c2d",
                                "text": "Het wegduwen van Esteban Ocon na de Grand Prix van Brazilië heeft Max Verstappen een taakstraf opgeleverd. De Nederlandse coureur moet zich binnen zes maanden twee dagen inzetten voor de internationale automobielfederatie FIA."
                            },
                            {
                                "example_id": "ccbc70e2-35d7-4fce-ac8a-453f55c6745f",
                                "sense_id": "e03034b2-14b4-3e92-bd95-c2ca25c81c2d",
                                "text": "Nog een race in Abu Dhabi en dan zit de Formule 1-loopbaan van Felipe Massa als coureur erop. Hij neemt echter geen afscheid van de koningsklasse van de autosport. Volgend jaar neemt de Braziliaan namens zijn land zitting in de World Motor Sport Council, het belangrijkste bestuursorgaan binnen de internationale automobielfederatie FIA."
                            }
                        ]
