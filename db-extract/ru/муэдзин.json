                "translations": [
                    {
                        "translation_id": "5981f472-9b95-4e14-9454-70ae10c73474",
                        "source_entry_id": "412c5f9c-e36e-3e23-9e72-87910f21e63d",
                        "source_sense_id": "7a264bb0-0de8-3320-91c2-d92fb50b0437",
                        "source_sense_description": "Religion; Islam: Muezzin",
                        "target_lang_word": "Muezzin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Muezzin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f3378203-de67-308a-b4f6-2b8b8afc3a67",
                                        "entry_id": "cd8e87e5-23f6-30c4-b64e-d9c0c33efba4",
                                        "glosses": [
                                            "Person im Islam, die zum Gebet ruft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f325c14e-ae88-433d-9e5a-462b44857a5f",
                                                "sense_id": "f3378203-de67-308a-b4f6-2b8b8afc3a67",
                                                "text": "„Wenn ein Mensch in meinem Dorf stirbt, ruft der Muezzin in der Moschee die Dorfbewohner durch einen Lautsprecher dazu auf, an der Beerdigung und der Trauerfeier teilzunehmen.“"
                                            },
                                            {
                                                "example_id": "e52ee760-b60f-4fc9-824b-f978a646f36b",
                                                "sense_id": "f3378203-de67-308a-b4f6-2b8b8afc3a67",
                                                "text": "„Der Muezzin donnerte aus dem Radio, und danach wurden zwei Gebote des Islam besprochen.“"
                                            },
                                            {
                                                "example_id": "1c06c8e4-d6fe-433d-9b5b-078fa2cf09b3",
                                                "sense_id": "f3378203-de67-308a-b4f6-2b8b8afc3a67",
                                                "text": "„In den Satzpausen knackten die Lautsprecher; es gab eine laute Rückkopplung, und der Muezzin verstummte.“"
                                            },
                                            {
                                                "example_id": "7a5fb00b-3105-47ac-95b4-112f0c5d50fe",
                                                "sense_id": "f3378203-de67-308a-b4f6-2b8b8afc3a67",
                                                "text": "„Von Land her wird die Stimme des Muezzins herangetragen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
