            {
                "entry_id": "7dfeb44b-4c7a-38cf-a6db-9d85849f6e63",
                "word": "nebeneinander",
                "pos": "adv",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e0a84adc-3ed8-3829-8160-83b7027879a3",
                        "entry_id": "7dfeb44b-4c7a-38cf-a6db-9d85849f6e63",
                        "glosses": [
                            "in unmittelbarer Nähe und gleicher Orientierung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4146782-10d5-4abe-bb50-9931e91cfd5b",
                                "sense_id": "e0a84adc-3ed8-3829-8160-83b7027879a3",
                                "text": "„Jeweils drei Blöcke liegen parallel nebeneinander und bilden so quer zur Weißenböckstraße ausgerichtete Gruppen.“"
                            },
                            {
                                "example_id": "d4af14f5-82aa-4d8a-b897-bbc0aa957e2c",
                                "sense_id": "e0a84adc-3ed8-3829-8160-83b7027879a3",
                                "text": "„Die gesamte Breite der Brücke nahmen sie ein, marschierten nebeneinander.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e82376ef-648e-32d3-94de-211647de599b",
                        "entry_id": "7dfeb44b-4c7a-38cf-a6db-9d85849f6e63",
                        "glosses": [
                            "zur gleichen Zeit tätig oder auch nur vorhanden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6cbd28f2-29dd-47d0-9f02-bdd8861e727c",
                                "sense_id": "e82376ef-648e-32d3-94de-211647de599b",
                                "text": "„Nach diesem Entwurf soll die Heilung der Zweitehe offenbar sogar mit Rückwirkung eintreten, so daß auch nach Scheidung der Erstehe eine Zeitlang zwei Ehen nebeneinander gültig bestanden hätten.“"
                            },
                            {
                                "example_id": "0adc2f6a-858f-44a8-84c4-afaf4e2ac995",
                                "sense_id": "e82376ef-648e-32d3-94de-211647de599b",
                                "text": "„An die Stelle der nebeneinander agierenden Einnehmerämter trat Anfang des 15. Jahrhunderts eine straffe Zentralisation, in deren Folge nahezu alle Einnahmen und Ausgaben der Stadt (Beamtenbesoldung, Kanzleierfordernisse und so weiter) durch die Kasse des Kammeramts (Kämmerer) flossen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "52bc33c8-25bc-4011-9754-f3a94c51e963",
                        "source_entry_id": "7dfeb44b-4c7a-38cf-a6db-9d85849f6e63",
                        "source_sense_id": "e0a84adc-3ed8-3829-8160-83b7027879a3",
