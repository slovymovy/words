                    {
                        "sense_id": "9e663873-2ddb-356d-be92-2f0a239acd50",
                        "entry_id": "755b7843-738a-3c5d-a5d0-c5bbe145b1de",
                        "glosses": [
                            "właściciel lub dzierżawca farmy w krajach anglosaskich"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96db0eb0-2dc1-43b2-9c72-00cedca888f9",
                                "sense_id": "9e663873-2ddb-356d-be92-2f0a239acd50",
                                "text": "Farmerzy poddali uprawie jałowe ziemie Australii."
                            },
                            {
                                "example_id": "e2452a08-85f8-4e09-a135-c4fb258da662",
                                "sense_id": "9e663873-2ddb-356d-be92-2f0a239acd50",
                                "text": "Udział organizacji pozarządowych (społeczności lokalnych, farmerów, konsumentów) w procesie wdrażania przepisów unijnych dotyczących ochrony praw zwierząt oraz przestrzegania standardów środowiskowych jest niewystarczający."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
