                                        "glosses": [
                                            "Wettrennen, das mit Pferden ausgetragen wird"
                                        ],
                                        "tags": [
                                            "Pferdesport"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "76338bec-def7-4698-be3b-cf5d7c24d7fa",
                                                "sense_id": "ea89c0df-db15-3612-ad04-fd68f67e8bd7",
                                                "text": "„Auf der indonesischen Insel Lombok wird jährlich das \"Bau Nyale\"-Fest mit Stockkämpfen und Pferderennen gefeiert.“"
                                            },
                                            {
                                                "example_id": "2688480b-aa79-48d2-b22e-88bbacaa18cd",
                                                "sense_id": "ea89c0df-db15-3612-ad04-fd68f67e8bd7",
                                                "text": "„Dummerweise landete ich am Nachmittag bei den Pferderennen, und am Abend betrank ich mich.“"
                                            },
                                            {
                                                "example_id": "d12700b9-a62f-4b34-82ac-c8059b241ffa",
                                                "sense_id": "ea89c0df-db15-3612-ad04-fd68f67e8bd7",
                                                "text": "„Sie suchten Trost beim Pferderennen, beim Boxkampf und am Tresen.“"
                                            },
                                            {
                                                "example_id": "e9a58357-e17d-4dad-95fe-5f61d6055f39",
                                                "sense_id": "ea89c0df-db15-3612-ad04-fd68f67e8bd7",
                                                "text": "„Die Soldaten unterhielten sich mit allerlei Spielchen, veranstalteten Ringkämpfe und Pferderennen oder kletterten auf Bäume, um Ausschau zu halten.“"
                                            }
                                        ],
