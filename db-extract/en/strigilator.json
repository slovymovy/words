                "senses": [
                    {
                        "sense_id": "270929b5-a954-330b-98a8-c13ded40bdaf",
                        "entry_id": "0322a012-dc3c-3be9-92a9-3f03614e34e8",
                        "glosses": [
                            "Any of various myrmecophiles that feed on the oily secretions on the bodies of ants."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae309c1c-797b-44cf-94c7-c4d94fafb51b",
                                "sense_id": "270929b5-a954-330b-98a8-c13ded40bdaf",
                                "text": "These little crickets belong to a group of Synoeketes which Wheeler has called Strigilators. They lick the surfaces of ants and seem to feed very largely, if not exclusively, on the cutaneous secretions and the thin coating of saliva with which ants cover one another."
                            },
                            {
                                "example_id": "3a4d0305-ff17-4cc8-8eac-0bceb475380e",
                                "sense_id": "270929b5-a954-330b-98a8-c13ded40bdaf",
                                "text": "The Myrmecophila are true strigilators. They are perpetually licking the oily secretions on the bodies and limbs of their ants, which they caress the while with their antennæ."
                            },
                            {
                                "example_id": "c7e7ce3b-b34e-419e-ac97-e494f19d71dc",
                                "sense_id": "270929b5-a954-330b-98a8-c13ded40bdaf",
                                "text": "Synoëketes — guests unnoticed or tolerated because the ants are unable to deal effectively with them. They are mostly harmless scavengers or nuisances or strigilators and are classified by Wheeler as being: a. Neutrals — scavengers that are not mimetic: mites; collembolens; staphylinid, trichopterygid, chrysomelid, and scarabæid beetles; phorid and syrphid flies; and caterpillars of certain microlepidopterans."
                            }
                        ]
                    }
