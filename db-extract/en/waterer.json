                                    {
                                        "sense_id": "3d885327-fd10-3cd2-8a05-921939302d84",
                                        "entry_id": "d6783a56-cb7c-37d3-9172-28894b128c56",
                                        "glosses": [
                                            "Oberflächengewässer oder künstliche Vorrichtung, an der (Nutz-)Tiere ihren Durst löschen können"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "518a5656-814e-4962-aeab-71bf2dd4b669",
                                                "sense_id": "3d885327-fd10-3cd2-8a05-921939302d84",
                                                "text": "Der Hirte führte die Herde zur Tränke."
                                            },
                                            {
                                                "example_id": "0b106fb5-5974-45aa-a8b5-99177bbd2ae4",
                                                "sense_id": "3d885327-fd10-3cd2-8a05-921939302d84",
                                                "text": "„Zwei der Tiere hatten eine eigene Tränke, zwei Tiere haben sich eine Tränke geteilt.“"
                                            },
                                            {
                                                "example_id": "78e32b08-fbfe-4508-9426-0163cf0decc1",
                                                "sense_id": "3d885327-fd10-3cd2-8a05-921939302d84",
                                                "text": "„Zuvor hatten wir das Vieh zur Tränke an einen Kratersee getrieben, an dem sich auch Zebras, Gnus, Antilopen und Gazellen labten.“"
                                            },
                                            {
                                                "example_id": "e0200da5-88a9-4a71-9f9e-d8130fb255ff",
                                                "sense_id": "3d885327-fd10-3cd2-8a05-921939302d84",
                                                "text": "„Martin kümmerte sich um die Tiere, führte sie zur Tränke und requirierte Heu aus verlassenen Schobern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
