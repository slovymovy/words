{
    "word_family": [
        "uniformité",
        "uniformiser",
        "uniformisation",
        "uniformément"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "03f72046-0af7-379d-9607-a0c1c8e69d2b",
                    "sense_definition": "Vêtement réglementaire dont la forme et la couleur sont identiques pour tous les membres d'une institution, d'un groupe ou d'une profession.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "vetement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les élèves de cette école privée doivent porter un <w>uniforme</w> strict tous les jours."
                        },
                        {
                            "text": "Le pompier a rapidement enfilé son <w>uniforme</w> avant de monter dans le camion."
                        }
                    ],
                    "synonyms": [
                        "tenue",
                        "habit"
                    ],
                    "common_phrases": [
                        "porter un uniforme",
                        "uniforme scolaire",
                        "uniforme militaire"
                    ]
                },
                {
                    "sense_id": "95011fe8-85bc-304c-a0c3-8d56da4bd705",
                    "sense_definition": "Par métonymie, personne qui porte cet habit, en particulier un soldat ou un militaire.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "personne",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Lors de la cérémonie officielle, plusieurs <w>uniformes</w> se tenaient impeccablement alignés devant le monument."
                        },
                        {
                            "text": "Le public applaudissait avec enthousiasme le défilé des <w>uniformes</w> dans l'avenue principale."
                        }
                    ],
                    "synonyms": [
                        "militaire",
                        "soldat"
                    ]
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "af662eee-1b65-3451-80d9-c83cfa337260",
                    "sense_definition": "Qui présente partout et toujours la même forme, sans variation ni changement visible.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La façade du bâtiment est peinte d'un gris <w>uniforme</w> qui manque un peu de gaieté."
                        },
                        {
                            "text": "Le conférencier s'exprimait d'une voix très <w>uniforme</w>, ce qui endormait une partie de la salle."
                        }
                    ],
                    "synonyms": [
                        "homogène",
                        "régulier",
                        "constant"
                    ],
                    "antonyms": [
                        "hétérogène",
                        "varié",
                        "disparate"
                    ],
                    "common_phrases": [
                        "couleur uniforme",
                        "mouvement uniforme",
                        "rythme uniforme"
                    ]
                },
                {
                    "sense_id": "5f04cea5-444f-3636-a617-ff5bb32f5c1b",
                    "sense_definition": "En mathématiques et probabilités, se dit d'une loi pour laquelle chaque éventualité a la même probabilité de réalisation.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Avec un dé parfaitement équilibré, le lancer suit une loi <w>uniforme</w> discrète entre un et six."
                        },
                        {
                            "text": "On suppose que la variable aléatoire continue est distribuée selon une densité <w>uniforme</w> sur cet intervalle."
                        }
                    ],
                    "synonyms": [
                        "équiprobable"
                    ],
                    "common_phrases": [
                        "loi uniforme",
                        "distribution uniforme"
                    ]
                }
            ]
        }
    ]
}