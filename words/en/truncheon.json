                        },
                        {
                            "trait_type": "dated",
                            "comment": "found in historical bawdy literature"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Een penis (plat of schertsend taalgebruik)."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "knuppel",
                                "target_lang_sense_clarification": "straattaal of schertsend voor penis"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d7544868-b771-3eab-a66b-996c7a85cc61",
                    "sense_definition": "To strike or beat someone with a truncheon.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "weapon_club",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The guards were ordered to <w>truncheon</w> any prisoners who refused to move.",
                            "target_lang_translations": {
                                "nl": "De bewakers kregen het bevel om elke gevangene die weigerde te bewegen te <w>knuppelen</w>."
                            }
                        },
                        {
                            "text": "Several witnesses reported that the police began to <w>truncheon</w> protestors without warning.",
                            "target_lang_translations": {
                                "nl": "Verschillende getuigen meldden dat de politie zonder waarschuwing demonstranten begon <w>neer te slaan</w>."
                            }
