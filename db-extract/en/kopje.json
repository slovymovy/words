                "senses": [
                    {
                        "sense_id": "b5624955-a634-346e-b05c-c92506a85a7a",
                        "entry_id": "3211c6c4-3e73-38f3-93b5-88e2f2ea8e69",
                        "glosses": [
                            "A small hill or mound, especially on the African veld."
                        ],
                        "tags": [
                            "South-Africa"
                        ],
                        "examples": [
                            {
                                "example_id": "76056e40-b7cd-41e4-9b08-7a42c3555e8c",
                                "sense_id": "b5624955-a634-346e-b05c-c92506a85a7a",
                                "text": "It was nearly noon when he reached the great bowlder at the top of which terminated the secret passage to the pits beneath the city. Like a cat he scaled the precipitous sides of the frowning granite kopje."
                            },
                            {
                                "example_id": "94e224c7-2b41-43ee-8c13-42e107f5b202",
                                "sense_id": "b5624955-a634-346e-b05c-c92506a85a7a",
                                "text": "In one spot only was the solemn monotony of the plain broken. Near the center a small solitary “kopje” rose. Alone it lay there, a heap of round ironstones piled one upon the other, as over some giant’s grave."
                            },
                            {
                                "example_id": "0280226e-42a8-4055-a720-254d2b3be96e",
                                "sense_id": "b5624955-a634-346e-b05c-c92506a85a7a",
                                "text": "We selected a lichenous kopje perhaps fifteen yards away, and landed neatly on its summit one after the other."
                            },
                            {
                                "example_id": "e0c39124-4460-4a5e-8a39-03e2bd438ac9",
                                "sense_id": "b5624955-a634-346e-b05c-c92506a85a7a",
                                "text": "Martha looked over a mile or so of bush to a strip of pink ploughed land; […] and then, ridge after ridge, fold after fold, the bush stretched to a line of blue kopjes."
                            },
                            {
                                "example_id": "2cfe09f4-8ba0-49e1-a0dd-acdc41ebcd72",
                                "sense_id": "b5624955-a634-346e-b05c-c92506a85a7a",
                                "text": "On the koppie behind the village, the unsightly red-and-white skeleton of an FM tower."
                            }
                        ]
                    }
                ],
