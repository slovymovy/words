            {
                "entry_id": "ab08872d-369e-3b4d-a780-85b864537554",
                "word": "haro",
                "pos": "intj",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "94b5e019-55d3-3361-9761-eef64e6b61a2",
                        "entry_id": "ab08872d-369e-3b4d-a780-85b864537554",
                        "glosses": [
                            "Cri de victime pour attirer l’attention, appel au secours."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "3451d119-f78a-4888-905f-d6893cf397e6",
                                "sense_id": "94b5e019-55d3-3361-9761-eef64e6b61a2",
                                "text": "Haro, haro, le grand et le mineur !"
                            }
                        ]
                    },
                    {
                        "sense_id": "6a5dfabe-1dd5-39eb-8f96-d04bfe78a8b6",
                        "entry_id": "ab08872d-369e-3b4d-a780-85b864537554",
                        "glosses": [
                            "Cri des chasseurs pour exciter les chiens de chasse."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "c42fd93f-03ef-345a-87f9-b2568899d913",
                        "entry_id": "ab08872d-369e-3b4d-a780-85b864537554",
                        "glosses": [
                            "Clameur pour refuser, renier, rejeter, quelque chose ou quelqu’un."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "83e335fe-ae6e-42d8-9f97-f7c9d012476c",
                                "sense_id": "c42fd93f-03ef-345a-87f9-b2568899d913",
                                "text": "À ces mots, on cria haro sur le baudet."
                            },
                            {
                                "example_id": "535a5b33-fa43-4e81-a570-ce41b3ec90a2",
                                "sense_id": "c42fd93f-03ef-345a-87f9-b2568899d913",
                                "text": "Haro sur l’huile de palme, accusée de contribuer à la déforestation et d’être nocive pour nos artères."
                            },
                            {
                                "example_id": "8e5c9456-c909-45e4-9161-a6c9c2b2320c",
                                "sense_id": "c42fd93f-03ef-345a-87f9-b2568899d913",
                                "text": "Je les guérirais de leur malheur en leur montrant celui de Villon dans son cachot et celui de l’âne sur lequel, depuis le début du monde, les puissants crient « haro !… »"
                            },
                            {
                                "example_id": "a8762f04-1e5c-4181-9139-c9c7d8711ef8",
                                "sense_id": "c42fd93f-03ef-345a-87f9-b2568899d913",
                                "text": "Dès qu'on évoque le rôle de l'interprétation analogique dans une argumentation ou une invention scientifiques, on entend aussitôt crier haro sur la métaphore."
                            }
                        ]
                    }
                ],
