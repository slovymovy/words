                                    {
                                        "sense_id": "314a0c97-c132-3df0-a0cc-3dd6e5253507",
                                        "entry_id": "d0b03073-6616-36de-89e5-39c060716921",
                                        "glosses": [
                                            "Any of a wide variety of articles, usually made of fabrics, animal hair, animal skin, or some combination thereof, used to cover the human body for warmth, to preserve modesty, or for fashion."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f54d2d1e-98a2-4f22-baec-b74e1119d82a",
                                                "sense_id": "314a0c97-c132-3df0-a0cc-3dd6e5253507",
                                                "text": "Marco runs a clothing brand."
                                            },
                                            {
                                                "example_id": "c4045202-6742-43f7-b84e-164c0c445155",
                                                "sense_id": "314a0c97-c132-3df0-a0cc-3dd6e5253507",
                                                "text": "You should wear warm clothing when it is cold outside."
                                            },
                                            {
                                                "example_id": "fe1adcb9-1977-452d-a15b-a29bce353163",
                                                "sense_id": "314a0c97-c132-3df0-a0cc-3dd6e5253507",
                                                "text": "All but two pieces of clothing came out of the washing machine stained."
                                            },
                                            {
                                                "example_id": "c114b5fb-7817-4491-a523-f7ddc3e3a7e3",
                                                "sense_id": "314a0c97-c132-3df0-a0cc-3dd6e5253507",
                                                "text": "A poncho is an item of clothing used by many people in Latin America."
                                            },
                                            {
                                                "example_id": "5bdb9eb7-2893-4a7c-8376-8611e7741266",
                                                "sense_id": "314a0c97-c132-3df0-a0cc-3dd6e5253507",
                                                "text": "A shirt is an article of clothing that covers the torso and arms."
                                            },
                                            {
                                                "example_id": "f29afba6-4ff0-4bd3-bff4-9ec96c2f4c27",
                                                "sense_id": "314a0c97-c132-3df0-a0cc-3dd6e5253507",
                                                "text": "From others he ſhall ſtand in need of nothing, / Yet on his Brothers ſhall depend for Cloathing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0068d63-04b0-3035-8d67-a16b39c52ed7",
                                        "entry_id": "d0b03073-6616-36de-89e5-39c060716921",
                                        "glosses": [
                                            "An act or instance of putting clothes on."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f8f8811d-a30e-4417-ba3a-8a017dae20e2",
                                                "sense_id": "e0068d63-04b0-3035-8d67-a16b39c52ed7",
                                                "text": "The clothing and unclothing of the idols was of special significance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db2f2cb2-478d-382a-8805-de1ba37d3be5",
                                        "entry_id": "d0b03073-6616-36de-89e5-39c060716921",
                                        "glosses": [
                                            "The art or process of making cloth."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "407784eb-7f09-456e-b07b-a67fe3844a4b",
                                                "sense_id": "db2f2cb2-478d-382a-8805-de1ba37d3be5",
                                                "text": "[M]any of the poor diſtreſſed People, being bereft of their Habitation, came into England, vvhere the King, in Compaſſion of their Condition, and alſo, conſidering that they might be beneficial to his Subjects, by instructing them in the Art of Cloathing, firſt placed them about Carliſle in the North, and after removed them into South-VVales, vvhere their Poſterity hath ever ſince remained."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c3b504bd-0443-3dfc-a62a-55fa99b16a93",
                                        "entry_id": "d0b03073-6616-36de-89e5-39c060716921",
                                        "glosses": [
                                            "A covering of non-conducting material on the outside of a boiler, or steam chamber, to prevent radiation of heat."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
