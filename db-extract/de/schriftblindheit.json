                        "sense_id": "9d3fbcb0-3d34-30ce-bb21-9d00ea4c6f23",
                        "entry_id": "45126dc6-5197-3848-b383-e33486f6004d",
                        "glosses": [
                            "Verlust der zuvor vorhandenen Fähigkeit zu lesen trotz erhaltener Sehfähigkeit"
                        ],
                        "tags": [
                            "Sprachstörung"
                        ],
                        "examples": [
                            {
                                "example_id": "8ecd1846-f3f9-4453-948a-8b0076beb3fd",
                                "sense_id": "9d3fbcb0-3d34-30ce-bb21-9d00ea4c6f23",
                                "text": "„Neurologen nennen es Alexie ohne Agraphie und meinen damit, dass Engel zwar noch schreiben, aber nicht lesen konnte: Schriftblindheit.“"
                            },
                            {
                                "example_id": "9e08d874-9706-46c2-85eb-2f2c7f3da7d5",
                                "sense_id": "9d3fbcb0-3d34-30ce-bb21-9d00ea4c6f23",
                                "text": "„Die Schriftblindheit entsteht bei Schädigungen des Gehirngewebes in einem bestimmten Bezirk der Sehrinde des Hinterhauptslappens. Die Betroffenen können gehörte Texte niederschreiben, aber keine Texte abschreiben.“"
                            }
                        ],
