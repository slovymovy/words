                            {
                                "example_id": "afe6b37a-b1af-49a8-a3f7-74039718dad6",
                                "sense_id": "197f25bf-5048-3e9d-8cd0-1651f485bba6",
                                "text": "Om onduidelijke reden geraakte de chauffeur omstreeks 6.30u met zijn wegreus naast de baan en belandde hij in de gracht. De vrachtwagenchauffeur bleef ongedeerd, maar zijn vrachtwagen liep wat schade op."
                            },
                            {
                                "example_id": "c3b47011-801d-4bf8-bcfc-eced37cd8bb6",
                                "sense_id": "197f25bf-5048-3e9d-8cd0-1651f485bba6",
                                "text": "Dit is de wegreus \"Octopus\", een nieuw produkt van de Leylandfabrieken. Dit is een 24-tons wagen (met aanhangwagen: 32 ton) voor bijzonder wegvervoer."
                            }
                        ]
                    },
                    {
                        "sense_id": "6b402e5f-e6c8-3f91-8e17-39e933974766",
                        "entry_id": "2d53ea2d-e453-32ec-b3f1-e26b14432d62",
                        "glosses": [
                            "wielrenner die buitengewoon succesvol is in wedstrijden op gewone straten en wegen worden verreden"
                        ],
                        "tags": [
