            {
                "entry_id": "30cf2616-eaa0-39fa-b2b6-5b7e21f9e2c2",
                "word": "Gille",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "5a58bb50-7e79-34d6-a785-ee8c05945f24",
                        "entry_id": "30cf2616-eaa0-39fa-b2b6-5b7e21f9e2c2",
                        "glosses": [
                            "Nom de famille."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "933059e4-c72f-4ae3-87a3-8d7991c98516",
                                "sense_id": "5a58bb50-7e79-34d6-a785-ee8c05945f24",
                                "text": "Après des éditions 2019 et 2021 décevantes, les Bleus « visent la victoire », selon Guillaume Gille, le sélectionneur."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "515d8421-5877-3c08-b170-4dcf3856fdde",
