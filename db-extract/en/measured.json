                                ]
                            },
                            {
                                "target_word": "afgemeten",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "a75218a5-ad0e-3184-915a-0a3da24933e5",
                                        "entry_id": "8ac4b5b1-c323-3f4b-8214-548d4460c796",
                                        "glosses": [
                                            "niet meer dan het hoogst noodzakelijke"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "59f90a01-bfb9-4d02-8183-e2803a341c83",
                                                "sense_id": "a75218a5-ad0e-3184-915a-0a3da24933e5",
                                                "text": "De eerste die ik sinds lange tijd sprak, afgezien van de weinige afgemeten woorden die ik aan het begin en het einde van de rit had gewisseld met mijn norse taxichauffeur, was een magere, donkere jongen in het nostalgische rode uniform van een piccolo."
                                            },
                                            {
                                                "example_id": "581eb786-f439-4a98-a267-0851dc9ed853",
                                                "sense_id": "a75218a5-ad0e-3184-915a-0a3da24933e5",
                                                "text": "Toen ze weer iets zei, was haar toon afgemeten. 'Nou, dan moeten we maar eens zien wat je zoal kunt. Er ligt veel werk op je te wachten,'— ze knikte naar de stapel was — 'dus je kunt maar beter meteen beginnen.'"
                                            },
                                            {
                                                "example_id": "b093c234-a2cc-4c4a-85c1-95f397ad909a",
                                                "sense_id": "a75218a5-ad0e-3184-915a-0a3da24933e5",
                                                "text": "'Ik luisterde naar het ritme van haar stem: afgemeten en omfloerst; hij klonk niet helemaal Engels, hoewel er genoeg accent van een tochtige kostschool in doorklonk."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "357916e1-1815-49f4-a841-5469cdf6ec15",
