                "senses": [
                    {
                        "sense_id": "a547f1c7-e1e5-39b1-8873-52ebcee4819c",
                        "entry_id": "7313a865-8629-3700-a9e9-ef07cd7b25f4",
                        "glosses": [
                            "Person, die eine andere Person, unabhängig davon, ob diese tatsächlich schuldig ist, (oftmals anonym) anzeigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc802542-d70b-481e-bb8a-29020d79ddf0",
                                "sense_id": "a547f1c7-e1e5-39b1-8873-52ebcee4819c",
                                "text": "„Später lernte er ihn als ungemein gefälligen, liebenswürdigen Kameraden kennen, noch später aber wurde er als Denunziant, der seine Unglücksgenossen geringfügiger Vorteile halber verriet, entlarvt.“"
                            },
                            {
                                "example_id": "dee3af51-abab-4d69-b513-25df2fe76a41",
                                "sense_id": "a547f1c7-e1e5-39b1-8873-52ebcee4819c",
                                "text": "„Blockwarte hatten den Ruf, Spitzel und Denunzianten zu sein, deshalb war meine Mutter immer darauf bedacht, die von ihr versteckten Juden gut zu verbergen, bevor wir in den Bunker gingen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
