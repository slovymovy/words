                "senses": [
                    {
                        "sense_id": "d094b2ca-9e10-3b91-899c-01ecec685439",
                        "entry_id": "a63daac7-6b88-30e7-8f44-122485cbfb7d",
                        "glosses": [
                            "door hete gassen aangedreven turbine"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "800a48ca-b356-4ab7-ad0b-c286cbe692c0",
                                "sense_id": "d094b2ca-9e10-3b91-899c-01ecec685439",
                                "text": "Een projectleider en een collega uitten bij de interne ombudsman van het bedrijf het vermoeden dat er wettelijke regels waren geschonden bij een aanbesteding. Die betrof de bouw van een gasturbine in een Europese stad. Met het project waren honderden miljoenen euro's gemoeid."
                            },
                            {
                                "example_id": "b61ebcbd-35c8-4a29-8b3a-d78cdc81e2b4",
                                "sense_id": "d094b2ca-9e10-3b91-899c-01ecec685439",
                                "text": "Drie medewerkers van het bedrijf kregen vorig jaar al taakstraffen en grotendeels voorwaardelijke celstraffen. Zij wisten volgens de rechter van het verbod op de export van gasturbines naar Iran. Via onder meer Duitsland, Saudi-Arabië, Bahrein en Dubai \"omzeilden ze welbewust nationale en internationale\" wetgeving."
                            },
                            {
                                "example_id": "c08ba409-8bc0-4548-9907-aee13fbb0590",
                                "sense_id": "d094b2ca-9e10-3b91-899c-01ecec685439",
                                "text": "Het bedrijf wil samen met een vliegtuigbouwer de EVTOL verder ontwikkelen. Voor de motor van de vliegende taxi heeft Rolls-Royce zijn eigen M250 gasturbine gebruikt. Daarmee wordt stroom opgewekt om \"op geluidsarme wijze\" zes elektrische propellers aan te drijven."
                            }
                        ]
                    }
