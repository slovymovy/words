                                "target_senses": [
                                    {
                                        "sense_id": "a0ac676b-811d-3065-934a-fbe142650317",
                                        "entry_id": "7c23c401-805d-30e0-a639-5aacc8ba1a74",
                                        "glosses": [
                                            "von einer Person: freundlich, Streit vermeidend, die Wünsche anderer gerne erfüllend; auch: sich viel gefallen lassend"
                                        ],
                                        "tags": [],
