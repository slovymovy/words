        "fr-extract.jsonl": [
            {
                "entry_id": "9c1d02b1-a1ef-3d4e-9289-c6dd0c20aed2",
                "word": "gantelet",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "ce896ead-b6b7-4a83-abc2-c708902f8c47",
                        "entry_id": "9c1d02b1-a1ef-3d4e-9289-c6dd0c20aed2",
                        "tags": [
                            "plural"
                        ],
                        "form": "gantelets"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "91698e20-7353-3a24-9027-173fc8d4a440",
                        "entry_id": "9c1d02b1-a1ef-3d4e-9289-c6dd0c20aed2",
                        "glosses": [
                            "Sorte de gant couvert de lames de fer par le dehors de la main, qui faisait autrefois partie de l’armure d’un homme armé de toutes pièces."
                        ],
                        "tags": [
                            "Armurerie"
                        ],
                        "examples": [
                            {
                                "example_id": "756df840-a89d-4bdb-9f56-0d05fcb775d6",
                                "sense_id": "91698e20-7353-3a24-9027-173fc8d4a440",
                                "text": "Du fond du caveau, le roi d'armes appela le premier héraut, qui descendit, portant les éperons; puis le second, qui descendit, portant les gantelets."
                            },
                            {
                                "example_id": "00fc92f4-734e-4367-9397-d87de86dc51f",
                                "sense_id": "91698e20-7353-3a24-9027-173fc8d4a440",
                                "text": "Ce vêtement cachait une chose qui, de prime abord, paraissait jurer avec sa forme, à savoir une cotte de mailles de fer avec des manches et des gantelets du même métal, curieusement plissés et entrelacés."
                            },
                            {
                                "example_id": "d027d80b-99ce-43eb-82b7-3d2afedc24a7",
                                "sense_id": "91698e20-7353-3a24-9027-173fc8d4a440",
                                "text": "Deux pages étaient derrière lui : l’un portait ses gantelets, l’autre son casque, et le capitaine de ses gardes était à son côté."
                            }
                        ]
                    },
                    {
                        "sense_id": "4d6ff71d-5eaa-36a3-a0ce-16b5a8981a37",
                        "entry_id": "9c1d02b1-a1ef-3d4e-9289-c6dd0c20aed2",
                        "glosses": [
                            "Sorte de bandage qui enveloppe la main et les doigts comme un gant."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "43b22c53-d61f-3c6d-a6d8-72ff0ae92c3b",
                        "entry_id": "9c1d02b1-a1ef-3d4e-9289-c6dd0c20aed2",
                        "glosses": [
                            "Morceau de cuir dont certains artisans, tels que les bourreliers et les relieurs, se couvrent la paume de la main, quand ils travaillent."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "9b591a8c-653d-3ff7-8307-093c8ffde8c3",
                        "entry_id": "9c1d02b1-a1ef-3d4e-9289-c6dd0c20aed2",
                        "glosses": [
                            "Meuble représentant un gant d’armure dans les armoiries. Il est généralement représenté en main dextre (droite) jusqu’au poignet, vue de dessus. À rapprocher de gant, main, dextrochère et senestrochère."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75e62c81-d1da-4e09-b6b5-0b4cfa6b9dc7",
                                "sense_id": "9b591a8c-653d-3ff7-8307-093c8ffde8c3",
                                "text": "De gueules à trois gantelets d’argent, qui est de la commune de Vendel d’Ille-et-Vilaine → voir illustration « armoiries avec 3 »"
                            }
                        ]
                    },
                    {
                        "sense_id": "c5d9741a-2ec9-3d93-a959-fb85114e3051",
                        "entry_id": "9c1d02b1-a1ef-3d4e-9289-c6dd0c20aed2",
                        "glosses": [
                            "Gant de protection porté par le fauconnier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09540a0d-6e24-41ff-9cda-79b03c7d383c",
                                "sense_id": "c5d9741a-2ec9-3d93-a959-fb85114e3051",
                                "text": "Le faucon ne tardait pas à descendre en déchirant quelque oiseau, et revenait se poser sur le gantelet, les deux ailes frémissantes."
                            }
                        ]
                    }
                ],
