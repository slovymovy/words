                "senses": [
                    {
                        "sense_id": "bba1a30d-1f42-3db0-826b-b87750ee7658",
                        "entry_id": "45088be4-6a8d-354c-ad45-2376a6b472d5",
                        "glosses": [
                            "Appalled, annoyed, exhausted or disgusted."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2deffde5-3acc-41e5-aa64-d0ba6993535f",
                                "sense_id": "bba1a30d-1f42-3db0-826b-b87750ee7658",
                                "text": "He was flabbergasted at how much weight he had gained."
                            },
                            {
                                "example_id": "ed032f2d-bc03-40d9-8c64-a905b702f909",
                                "sense_id": "bba1a30d-1f42-3db0-826b-b87750ee7658",
                                "text": "Maxwell made a lunge at his flabbergasted guest, who ducked just in time to escape the great hands reaching for him."
                            },
                            {
                                "example_id": "c783ed44-e583-4c6e-ad5b-bcaeee870305",
                                "sense_id": "bba1a30d-1f42-3db0-826b-b87750ee7658",
                                "text": "From behind her paper, she was flabbergasted to see a neatly dressed man helping himself to her cookies."
                            },
                            {
                                "example_id": "74992d56-23dc-47a5-8cef-fabd43166301",
                                "sense_id": "bba1a30d-1f42-3db0-826b-b87750ee7658",
                                "text": "On his first encounter with tailgating in 2006, he was flabbergasted at the way rival fans mixed peaceably together at the parties. A Chicago Bears fan, he was warmly welcomed into a group of Arizona Cardinals fans and fed. \"I was shocked and slightly worried. I thought they were going to poison me. It was just so odd.\""
                            }
                        ]
                    },
