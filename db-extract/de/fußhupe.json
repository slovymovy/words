                "senses": [
                    {
                        "sense_id": "79dc9ab1-27f2-3371-873b-5e0d43455e38",
                        "entry_id": "a121c9f4-51ef-31b1-9666-87d72674a267",
                        "glosses": [
                            "kleiner Hund"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "37d52c7e-8ae4-4e6c-b04d-d000d9c43745",
                                "sense_id": "79dc9ab1-27f2-3371-873b-5e0d43455e38",
                                "text": "Warum schaffen sich eigentlich weibliche magersüchtige B-Promis eine Fußhupe an, um die sich dann eine Assistentin kümmern darf?"
                            },
                            {
                                "example_id": "3d2504fa-df1e-4f49-a66e-3919cd1f9557",
                                "sense_id": "79dc9ab1-27f2-3371-873b-5e0d43455e38",
                                "text": "„Ich wäre doch nie im Leben mitgekommen, hätte ich gewusst, dass du mich auf eine Geburtstagsparty für so eine Fußhupe schleppst.“"
                            },
                            {
                                "example_id": "702de358-8d68-45f3-8d0c-ea5a817005df",
                                "sense_id": "79dc9ab1-27f2-3371-873b-5e0d43455e38",
                                "text": "„Und überall, wo sie ist, ist auch diese kleine Fußhupe dabei, Larious, den man schon an seinem lauten Atmen erkennt.“"
                            },
                            {
                                "example_id": "f41bc376-7ab9-4981-a101-c3930c6ad93c",
                                "sense_id": "79dc9ab1-27f2-3371-873b-5e0d43455e38",
                                "text": "„Diese essgestörte fette Kröte, der neunmalkluge Brillenwurm und die Blonde mit der kranken Fußhupe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
