                            {
                                "example_id": "c6849fbe-b8a2-4816-b517-dd1e9d9dc7f6",
                                "sense_id": "73300fbe-39a9-3b5a-90d1-a786b47719a0",
                                "text": "Take that a step further for Millennials and Zs by crafting an e-mail subject header that does the same but with even fewer characters; […]"
                            },
                            {
                                "example_id": "3022ba70-95b4-4478-b729-fc4fae446406",
                                "sense_id": "73300fbe-39a9-3b5a-90d1-a786b47719a0",
                                "text": "The current progressive movement—and certainly the Millennials and Zs—understand that the Hyde Amendment is discriminatory […]"
                            },
                            {
                                "example_id": "90e8646f-d484-4ea3-88a6-7acee5069e5f",
                                "sense_id": "73300fbe-39a9-3b5a-90d1-a786b47719a0",
                                "text": "The current global pandemic is almost certainly a formative moment for younger Millennials and Zs as they navigate through similar challenges."
                            }
                        ]
                    },
