                                    {
                                        "sense_id": "b18bb835-e107-31c5-8d8b-62d0dd25f162",
                                        "entry_id": "fbb2ba7f-3195-3d97-9ddc-a8dfa4ddd5c5",
                                        "glosses": [
                                            "Any of a large group of structurally similar hydrated double silicate minerals, containing various combinations of sodium, calcium, magnesium, iron, and aluminium."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4396fe80-930b-45db-aed4-64e33f765817",
                                                "sense_id": "b18bb835-e107-31c5-8d8b-62d0dd25f162",
                                                "text": "Remember when we could see the mountain's peak?\nThe sparkle off the amphibole."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7b5fc37d-1b22-4f52-a9d2-474a0805e0f8",
                        "source_entry_id": "db0223b1-4daa-3665-9ad3-5103c2ac5715",
                        "source_sense_id": "4ac912f9-955d-3165-a7f3-74350d67fbdc",
                        "source_sense_description": "gesteinsbildendes Mineral von verschiedener chemischer Zusammensetzung und Farbe",
                        "target_lang_word": "amphibole",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "amphibole",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cd42d492-6cdd-3712-ba23-d37c7ff0e8e0",
                                        "entry_id": "f7681efe-e12c-3229-9041-c9343c501681",
                                        "glosses": [
                                            "Minéral (silicate de fer, de calcium ou de magnésium) cristallisé en système orthorhombique et monoclinique en prisme très allongé, avec un clivage typique selon les faces du prisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b46363f-110a-4cbb-9e10-d27b0b6eb1bf",
                                                "sense_id": "cd42d492-6cdd-3712-ba23-d37c7ff0e8e0",
                                                "text": "En lame mince cette roche est caractérisée par des agrégats de clinopyroxènes, des amphiboles vert pâle à incolores et des amas pseudorectangulaires d’andésine ; le grain est grossier."
                                            },
                                            {
                                                "example_id": "83a2659e-7f1a-4d38-a6c4-9e5b7a25e7c3",
                                                "sense_id": "cd42d492-6cdd-3712-ba23-d37c7ff0e8e0",
                                                "text": "La présence d’amphibole permet d’expliquer les teneurs élevées en alcalins et faibles en silice et les faibles températures de fusion. Ces liquides sont des témoins des interactions entre les basaltes magnésiens d’arc et les cumulats crustaux à amphibole."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
