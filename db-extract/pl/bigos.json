                                "target_senses": [
                                    {
                                        "sense_id": "65eab203-0d10-38e0-8244-064fd0613443",
                                        "entry_id": "96bb5c6a-d633-338d-8f45-f8daa669dc6d",
                                        "glosses": [
                                            "variantenreiches Eintopfgericht aus den Hauptzutaten Kraut (Sauerkraut, Weißkohl), Speck und verschiedenen Fleischsorten; polnisches Nationalgericht"
                                        ],
                                        "tags": [
                                            "polnische Küche"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5177997a-0e1d-4385-bcdb-2a17ddb3d9d0",
                                                "sense_id": "65eab203-0d10-38e0-8244-064fd0613443",
                                                "text": "„Immer wenn es kalt wird, überfällt mich Heißhunger auf Bigos, das ich einmal in einem Danziger Hotel gegessen habe […]. Man wirft ins Kraut, was Mutter und Großmutter schon reinwarfen und was sonst noch so da ist.“"
                                            }
                                        ],
