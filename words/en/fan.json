{
    "word_family": [
        "fanner",
        "fanning",
        "fanlight",
        "fantail",
        "fanwise",
        "fan-shaped"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "79ac9298-8882-3c83-94ac-2c2730e3d5b1",
                    "sense_definition": "An electrical or mechanical device for moving air, used for cooling people, machinery, etc.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "cooling_device",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He didn't switch on the <w>fan</w> because the temperature was 15 degrees Celsius.",
                            "target_lang_translations": {
                                "ru": "Он не включил <w>вентилятор</w>, потому что температура была 15 градусов по Цельсию."
                            }
                        },
                        {
                            "text": "The computer <w>fan</w> is making a very loud noise today.",
                            "target_lang_translations": {
                                "ru": "Компьютерный <w>вентилятор</w> сегодня очень сильно шумит."
                            }
                        }
                    ],
                    "common_phrases": [
                        "electric fan",
                        "ceiling fan",
                        "cooling fan"
                    ],
                    "target_lang_definitions": {
                        "ru": "Электрическое или механическое устройство для перемещения воздуха, используемое для охлаждения людей, оборудования и т. д."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вентиля́тор",
                                "target_lang_sense_clarification": "электрическое устройство"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4cceeb72-b062-3c1d-bc5a-c1ee9fd2057e",
                    "sense_definition": "A person who is fond of something or someone, especially an admirer of a performer or aficionado of a sport.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "admirer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am a big <w>fan</w> of libraries and spend every weekend there.",
                            "target_lang_translations": {
                                "ru": "Я большой <w>любитель</w> библиотек и провожу там каждые выходные."
                            }
                        },
                        {
                            "text": "The football <w>fans</w> cheered loudly when their team scored a goal.",
                            "target_lang_translations": {
                                "ru": "Футбольные <w>болельщики</w> громко ликовали, когда их команда забила гол."
                            }
                        }
                    ],
                    "synonyms": [
                        "admirer",
                        "aficionado",
                        "enthusiast",
                        "devotee",
                        "rooter"
                    ],
                    "antonyms": [
                        "hater"
                    ],
                    "common_phrases": [
                        "big fan",
                        "sports fan",
                        "football fan"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который чем-то или кем-то увлекается, особенно поклонник артиста или любитель спорта."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фана́т",
                                "target_lang_sense_clarification": "страстный поклонник"
                            },
                            {
                                "target_lang_word": "боле́льщик",
                                "target_lang_sense_clarification": "любитель спорта"
                            },
                            {
                                "target_lang_word": "покло́нник",
                                "target_lang_sense_clarification": "почитатель таланта"
                            },
                            {
                                "target_lang_word": "люби́тель",
                                "target_lang_sense_clarification": "человек со склонностью к чему-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "58e8b7f0-4b13-301b-9685-893d72bda65b",
                    "sense_definition": "A hand-held device consisting of concertinaed material that may be opened out and waved back and forth to move air.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "cooling_device",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She used a paper <w>fan</w> to keep cool during the outdoor wedding.",
                            "target_lang_translations": {
                                "ru": "Она использовала бумажный <w>веер</w>, чтобы спастись от жары во время свадьбы на открытом воздухе."
                            }
                        },
                        {
                            "text": "The dancer held a beautiful silk <w>fan</w> in her right hand.",
                            "target_lang_translations": {
                                "ru": "Танцовщица держала в правой руке красивый шелковый <w>веер</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "hand fan",
                        "paper fan",
                        "folding fan"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ручное устройство из складного материала, которое разворачивается и используется для обмахивания."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ве́ер",
                                "target_lang_sense_clarification": "ручное опахало"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "82178458-85cf-348b-8c99-0fd3aa2f2418",
                    "sense_definition": "Anything resembling a hand-held fan in shape, such as a peacock’s tail.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "shape",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The peacock opened its tail into a magnificent <w>fan</w> of feathers.",
                            "target_lang_translations": {
                                "ru": "Павлин распустил хвост, превратив его в великолепный <w>веер</w> из перьев."
                            }
                        },
                        {
                            "text": "The delta formed a wide <w>fan</w> where the river met the sea.",
                            "target_lang_translations": {
                                "ru": "Дельта образовала широкий <w>веер</w> в месте впадения реки в море."
                            }
                        }
                    ],
                    "common_phrases": [
                        "alluvial fan"
                    ],
                    "target_lang_definitions": {
                        "ru": "Что-либо, напоминающее по форме ручной веер, например, хвост павлина."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ве́ер",
                                "target_lang_sense_clarification": "форма полукруга"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "14bc9cf3-08ef-3bf2-87a9-d4c6a6f50de6",
                    "sense_definition": "An instrument for winnowing grain, used to separate the chaff from the wheat.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "agriculture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer used a traditional <w>fan</w> to clean the harvested grain.",
                            "target_lang_translations": {
                                "ru": "Фермер использовал традиционную <w>веялку</w>, чтобы очистить собранное зерно."
                            }
                        },
                        {
                            "text": "Ancient tools like the winnowing <w>fan</w> are rarely seen in modern farming.",
                            "target_lang_translations": {
                                "ru": "Такие древние инструменты, как <w>веялка</w> для зерна, редко встречаются в современном сельском хозяйстве."
                            }
                        }
                    ],
                    "common_phrases": [
                        "winnowing fan"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "primarily used in historical or agricultural contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Инструмент для веяния зерна, используемый для отделения шелухи от пшеницы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ве́ялка",
                                "target_lang_sense_clarification": "сельскохозяйственное орудие"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6ae6dc79-bb06-3fe0-ad59-f220afc5851a",
                    "sense_definition": "To blow air on something by means of a fan or by waving something back and forth.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "air_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She began <w>fanning</w> herself with a magazine to escape the heat.",
                            "target_lang_translations": {
                                "ru": "Она начала <w>обмахиваться</w> журналом, чтобы спастись от жары."
                            }
                        },
                        {
                            "text": "The gentle breeze continued <w>fanning</w> the curtains throughout the afternoon.",
                            "target_lang_translations": {
                                "ru": "Легкий ветерок продолжал <w>колыхать</w> шторы в течение всего дня."
                            }
                        }
                    ],
                    "common_phrases": [
                        "fan yourself"
                    ],
                    "target_lang_definitions": {
                        "ru": "Направлять поток воздуха на что-либо с помощью вентилятора или помахивая чем-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обма́хивать",
                                "target_lang_sense_clarification": "веером или газетой"
                            },
                            {
                                "target_lang_word": "обдува́ть",
                                "target_lang_sense_clarification": "потоком воздуха"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d29e5412-eb7c-38f0-b9e4-312d1fb90e81",
                    "sense_definition": "To move or spread in multiple directions from one point, in the shape of a hand-held fan.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police officers started to <w>fan</w> out across the park to search for clues.",
                            "target_lang_translations": {
                                "ru": "Полицейские начали <w>рассредоточиваться</w> по парку в поисках улик."
                            }
                        },
                        {
                            "text": "The search party will <w>fan</w> out to cover more ground quickly.",
                            "target_lang_translations": {
                                "ru": "Поисковая группа <w>разойдется веером</w>, чтобы быстрее охватить большую территорию."
                            }
                        }
                    ],
                    "common_phrases": [
                        "fan out"
                    ],
                    "target_lang_definitions": {
                        "ru": "Двигаться или распространяться в разных направлениях из одной точки в форме веера."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рассредото́чиваться",
                                "target_lang_sense_clarification": "расходиться в разные стороны"
                            },
                            {
                                "target_lang_word": "расходи́ться ве́ером",
                                "target_lang_sense_clarification": "двигаться из одной точки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "505d866a-f04b-376e-ac23-c6eb0c1fb22f",
                    "sense_definition": "To invigorate or strengthen a feeling or situation, like flames when air is blown on them.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "metaphorical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His controversial comments served only to <w>fan</w> the flames of the protest.",
                            "target_lang_translations": {
                                "ru": "Его неоднозначные комментарии послужили лишь тому, чтобы сильнее <w>раздуть</w> пламя протеста."
                            }
                        },
                        {
                            "text": "The news reports helped <w>fan</w> the public's anger regarding the new tax.",
                            "target_lang_translations": {
                                "ru": "Сообщения в новостях помогли <w>разжечь</w> гнев общественности по поводу нового налога."
                            }
                        }
                    ],
                    "common_phrases": [
                        "fan the flames"
                    ],
                    "target_lang_definitions": {
                        "ru": "Оживлять или усиливать чувство или ситуацию, подобно тому как раздувают пламя."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "раздува́ть",
                                "target_lang_sense_clarification": "усиливать чувства или пламя"
                            },
                            {
                                "target_lang_word": "разжигать",
                                "target_lang_sense_clarification": "провоцировать гнев или протест"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "a09c078d-3a84-3a46-bd1f-db613c17e032",
                    "sense_definition": "A common surname of Mandarin Chinese origin.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "surname",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Fan</w> is the lead architect for the new skyscraper project.",
                            "target_lang_translations": {
                                "ru": "Господин <w>Фань</w> является ведущим архитектором проекта нового небоскреба."
                            }
                        },
                        {
                            "text": "The book was written by a famous historian named <w>Fan</w>.",
                            "target_lang_translations": {
                                "ru": "Книга была написана известным историком по фамилии <w>Фань</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Mandarin Chinese surname"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Распространенная фамилия китайского происхождения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Фань",
                                "target_lang_sense_clarification": "китайская фамилия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8f9e65f4-14ba-35d8-88c5-1ff1bcaf5b50",
                    "sense_definition": "A county located in Puyang, Henan, China.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "location",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "The agricultural output of <w>Fan</w> County has increased significantly this year.",
                            "target_lang_translations": {
                                "ru": "Сельскохозяйственное производство уезда <w>Фаньсянь</w> в этом году значительно выросло."
                            }
                        },
                        {
                            "text": "He traveled to <w>Fan</w> County to visit his relatives during the festival.",
                            "target_lang_translations": {
                                "ru": "Он поехал в уезд <w>Фаньсянь</w>, чтобы навестить своих родственников во время праздника."
                            }
                        }
                    ],
                    "synonyms": [
                        "Fanxian"
                    ],
                    "common_phrases": [
                        "Fan County"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "refers to a specific location in China"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Уезд, расположенный в городском округе Пуян, провинция Хэнань, Китай."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Фаньсянь",
                                "target_lang_sense_clarification": "географическое название"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5b60b8b3-4365-3423-8684-092adc195929",
                    "sense_definition": "A diminutive or short form of the female given name <w>Frances</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "nickname",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Everyone in the family called her <w>Fan</w> instead of her full name.",
                            "target_lang_translations": {
                                "ru": "Все в семье называли ее <w>Фэн</w> вместо ее полного имени."
                            }
                        },
                        {
                            "text": "Listen, <w>Fan</w>, you need to be more careful when walking home.",
                            "target_lang_translations": {
                                "ru": "Послушай, <w>Фэн</w>, тебе нужно быть осторожнее, когда идешь домой."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used as a nickname"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Уменьшительная или краткая форма женского имени Фрэнсис."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Фэн",
                                "target_lang_sense_clarification": "уменьшительное имя"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}