                            },
                            {
                                "target_lang_word": "исключать",
                                "target_lang_sense_clarification": "из команды или организации"
                            },
                            {
                                "target_lang_word": "вышвыривать",
                                "target_lang_sense_clarification": "грубо выгонять (разг.)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "踢出",
                                "target_lang_sense_clarification": "强迫离开"
                            },
                            {
                                "target_lang_word": "开除",
                                "target_lang_sense_clarification": "从组织中除名"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fa2822dc-1d51-3e0d-a3bc-60f6c75caec9",
                    "sense_definition": "To stop doing something harmful; to free oneself of an addiction.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I still smoke, but I am trying to <w>kick</w> the habit.",
                            "target_lang_translations": {
                                "ru": "Я все еще курю, но пытаюсь <w>бросить</w> эту привычку.",
                                "zh": "我还在抽烟，但我正努力<w>戒掉</w>这个习惯。"
                            }
                        },
                        {
                            "text": "He finally <w>kicked</w> his addiction to sugar.",
                            "target_lang_translations": {
                                "ru": "Он наконец <w>поборол</w> свою зависимость от сахара.",
                                "zh": "他终于<w>戒掉</w>了对糖的依赖。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "kick the habit",
                        "kick an addiction"
                    ],
                    "target_lang_definitions": {
                        "ru": "Перестать делать что-то вредное; избавиться от зависимости.",
                        "zh": "停止做某件有害的事情；摆脱某种瘾。"
                    },
                    "translations": {
