                "senses": [
                    {
                        "sense_id": "68ff9be0-ff8d-32f4-8ff8-d63f93140b15",
                        "entry_id": "5923c50c-4dd5-3bea-bc6d-0f0c3dfbd830",
                        "glosses": [
