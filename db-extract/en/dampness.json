    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "41631f65-5677-360a-9253-58673f3378a7",
                "word": "dampness",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "10ed4353-09de-4318-a596-fe47bfac06f9",
                        "entry_id": "41631f65-5677-360a-9253-58673f3378a7",
                        "tags": [
                            "plural"
                        ],
                        "form": "dampnesses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f3d3397b-6022-3076-807d-d0bc437f454c",
                        "entry_id": "41631f65-5677-360a-9253-58673f3378a7",
                        "glosses": [
                            "Moderate humidity; moisture; moistness; the state or quality of being damp."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "d2f28eb0-f2ba-45f4-b5bb-cc3485f122fe",
                                "sense_id": "f3d3397b-6022-3076-807d-d0bc437f454c",
                                "text": "With 3,600 h.p. underfoot, acceleration was reasonably brisk, but the flickering wheel-slip indicator light showed the prudence of not putting full power through the traction motors while there were traces of early-morning dampness on the rails."
                            },
                            {
                                "example_id": "3e89868e-f84f-4607-b089-af1714a364a8",
                                "sense_id": "f3d3397b-6022-3076-807d-d0bc437f454c",
                                "text": "They hadn't reckoned with the attendant personality disorders, which the coldness, the darkness, the dampness, the crampedness and the loneliness were doing nothing to decrease."
                            }
                        ]
                    },
                    {
                        "sense_id": "a2debdf0-8656-313e-a022-e24e21eb434c",
                        "entry_id": "41631f65-5677-360a-9253-58673f3378a7",
                        "glosses": [
                            "The degree to which something is damp or moist."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "46f35001-6621-489b-b268-3e4fe0f1b8fb",
                                "sense_id": "a2debdf0-8656-313e-a022-e24e21eb434c",
                                "text": "The dampness in the writing paper caused the ink to spread and smudge."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "53cf7077-a5b7-4bb3-a51d-008ff9ea1724",
                        "source_entry_id": "41631f65-5677-360a-9253-58673f3378a7",
