                "senses": [
                    {
                        "sense_id": "c864e61b-4337-364b-966f-e50e2c4233d6",
                        "entry_id": "19eccd3a-7072-3279-8c88-1567c080b53f",
                        "glosses": [
                            "iemand die als enige de macht in een land in handen heeft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8dab4340-3d28-433c-b891-c0a81a5a995f",
                                "sense_id": "c864e61b-4337-364b-966f-e50e2c4233d6",
                                "text": "Er heerste een euforische stemming na het vertrek van de gehate dictator."
                            },
                            {
                                "example_id": "1a9018f5-0a8c-444a-821b-e991bc1e0d36",
                                "sense_id": "c864e61b-4337-364b-966f-e50e2c4233d6",
                                "text": "Veel kritische noten zijn er tijdens de ‘Het Team’ daarom niet te verwachten. Maar dat de Russische realityshow unieke tv op gaat leveren, staat bij voorbaat vast. De Tsjetsjeense bergen zijn adembenemend, en de bevolking is kleurrijk - ‘woest’ zeggen ze in Rusland. Kadyrov is een charismatische dictator, een gedrongen worstelaar in vreemde kostuums, met een steeds langer wordende rossige baard. Presentator Kortsjevnikov is de wat onhandige schoonzoon aan zijn zijde. Als hij van vermoeidheid struikelt over zijn eigen benen, vangt Kadyrov hem op. „Staan!”"
                            }
                        ]
                    },
                    {
                        "sense_id": "fb558ac7-6baf-30b6-935b-7bbcfc49fefd",
                        "entry_id": "19eccd3a-7072-3279-8c88-1567c080b53f",
                        "glosses": [
                            "heerszuchtig persoon"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f3a5acd-696e-4558-9516-90c169a6c2bf",
                                "sense_id": "fb558ac7-6baf-30b6-935b-7bbcfc49fefd",
                                "text": "Slave City is een artistieke dictatuur. Als je dat beseft is ineens ook het machtsvraagstuk opgelost: de grote dictator, die aan alle touwtjes trekt is Van Lieshout zelf. Maar zelf blijft hij dus buiten beeld."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fc211ba5-eb2c-42e4-ba71-c3c60f5023b7",
                        "source_entry_id": "19eccd3a-7072-3279-8c88-1567c080b53f",
                        "source_sense_id": "c864e61b-4337-364b-966f-e50e2c4233d6",
                        "source_sense_description": "iemand die als enige de macht in een land in handen heeft",
                        "target_lang_word": "Diktator",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Diktator",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ede18aad-2f3d-345c-acc9-7eafd4d745a4",
                                        "entry_id": "2305f68a-4c16-36e9-8445-5cdfe5068a4b",
                                        "glosses": [
                                            "Herrscher mit uneingeschränkter Machtfülle"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5693a4c-9835-42b8-a1f0-96d73d2ca299",
                                                "sense_id": "ede18aad-2f3d-345c-acc9-7eafd4d745a4",
                                                "text": "Nordkorea wird nach wie vor von einem Diktator beherrscht."
                                            },
                                            {
                                                "example_id": "f101ae37-3c74-4894-bb81-490870cea0bd",
                                                "sense_id": "ede18aad-2f3d-345c-acc9-7eafd4d745a4",
                                                "text": "„Immer wieder erhält sie Morddrohungen, weil sie Russland als Terrorstaat bezeichnete und Putin als Diktator.“"
                                            },
                                            {
                                                "example_id": "c5144df0-11c3-4f0d-b054-492f377e1487",
                                                "sense_id": "ede18aad-2f3d-345c-acc9-7eafd4d745a4",
                                                "text": "„Als sich die Führer der arabischen Welt vorigen Mittwoch im ägyptischen Scharm-al-Scheich trafen, fehlte Tunesiens Diktator Ben Ali zum ersten Mal in dieser Runde.“"
                                            },
                                            {
                                                "example_id": "37f3c287-8439-4750-aac4-0fe7bac764b2",
                                                "sense_id": "ede18aad-2f3d-345c-acc9-7eafd4d745a4",
                                                "text": "„Mit dem Partisanenführer Tito, der bereits große Teile Jugoslawiens beherrschte, hatte der sowjetische Diktator verabredet, daß die Rote Armee zu ihm und dann gemeinsam weiter westwärts durchstoßen werde.“"
                                            },
                                            {
                                                "example_id": "47bcc5d6-e362-4c93-81bb-84baa8477295",
                                                "sense_id": "ede18aad-2f3d-345c-acc9-7eafd4d745a4",
                                                "text": "„Alle nachfolgenden Diktatoren Venezuelas beriefen sich auf ihn, und er ist bis heute ein Heros der weißen Elite, aus der er stammte, und auch das Idol der Armen.“"
                                            },
                                            {
                                                "example_id": "1b921a74-1fb1-442d-bb4b-c5a32da1d6c7",
                                                "sense_id": "ede18aad-2f3d-345c-acc9-7eafd4d745a4",
                                                "text": "„Oft wandten sich die Gespräche dem Schicksal von Frankreich in einem sich nahezu täglich wandelnden Europa zu, mit einem Krieg in Spanien und einem Diktator in Deutschland, dessen Versprechungen nicht mehr wert waren als Toilettenpapier, wie Gide sich ausdrückte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4cb3ef9a-3c5b-48f0-92c1-cf06259efa59",
                        "source_entry_id": "19eccd3a-7072-3279-8c88-1567c080b53f",
                        "source_sense_id": "c864e61b-4337-364b-966f-e50e2c4233d6",
                        "source_sense_description": "iemand die als enige de macht in een land in handen heeft",
                        "target_lang_word": "dictator",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dictator",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a111264b-8924-3503-a434-fc045e135185",
                                        "entry_id": "2c23cae3-1e76-3750-9a76-46b79f213c46",
                                        "glosses": [
                                            "A totalitarian leader of a country, nation, or government."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61ce7ddd-d6f6-4bc2-a950-95ae924056ab",
                                                "sense_id": "a111264b-8924-3503-a434-fc045e135185",
                                                "text": "The Dominicans had lived for thirty years under the iron-fisted rule of dictator Leonidas Trujillo. During those years, which ended with Trujillo's assassination in 1961, those who opposed Trujillo had three choices: to go into exile, to go underground, or to remain quiet. Most Dominicans had chosen the third course."
                                            },
                                            {
                                                "example_id": "10c2eeaf-88db-4f27-a3c0-90385fedc556",
                                                "sense_id": "a111264b-8924-3503-a434-fc045e135185",
                                                "text": "Dictator, noun : someone who doesn't let American CEOs dictate how their country is run"
                                            },
                                            {
                                                "example_id": "cc49cdae-b511-408a-8c18-d2ff483cfd4d",
                                                "sense_id": "a111264b-8924-3503-a434-fc045e135185",
                                                "text": "\"The reason why Xi Jinping got very upset in terms of when I shot that balloon down with two box cars full of spy equipment in it was he didn't know it was there,\" Biden said.\n\"That's a great embarrassment for dictators. When they didn't know what happened. That wasn't supposed to be going where it was. It was blown off course,\" Biden said."
                                            },
                                            {
                                                "example_id": "fac3a33a-6b94-44c9-9d90-6283ac7ff85a",
                                                "sense_id": "a111264b-8924-3503-a434-fc045e135185",
                                                "text": "A monument to Soviet dictator Josef Stalin erected in Moscow's metro is stirring debate, with some Russians welcoming it as a historical tribute, but others saying it's a mistake to commemorate someone who presided over so much suffering."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf05568b-2935-3adb-ba89-3810c4046464",
                                        "entry_id": "2c23cae3-1e76-3750-9a76-46b79f213c46",
                                        "glosses": [
                                            "A magistrate without colleague in republican Ancient Rome, who held full executive authority for a term granted by the Senate, typically to conduct a war."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "768355f0-9d06-34a1-9d83-d1971e739f24",
                                        "entry_id": "2c23cae3-1e76-3750-9a76-46b79f213c46",
                                        "glosses": [
                                            "A tyrannical boss or authority figure."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "74766711-4123-31c4-9b3b-0e96345cb938",
                                        "entry_id": "2c23cae3-1e76-3750-9a76-46b79f213c46",
