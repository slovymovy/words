                "senses": [
                    {
                        "sense_id": "65641b60-4955-3a63-9208-36390e6317f4",
                        "entry_id": "f7a1bc2e-d7a5-32d7-864c-60fa0b29a511",
                        "glosses": [
                            "Vertreter einer der artenreichsten und am weitesten verbreiteten Gruppen pflanzenfressender Dinosaurier, dessen Körperbau sich durch einen massiven Rumpf, einem langen Hals und Schwanz sowie durch einen verhältnismäßig kleinen Kopf auszeichnet"
                        ],
                        "tags": [
                            "Paläontologie"
                        ],
                        "examples": [
                            {
                                "example_id": "28b7be25-cb09-42e8-9ac5-720bdf8a7096",
                                "sense_id": "65641b60-4955-3a63-9208-36390e6317f4",
                                "text": "„Sauropoden haben charakteristisch lange Hälse und Schwänze und gehören zu den größten Tieren, die jemals gelebt haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9113375c-63e3-4b6c-b5ea-d1f6c55331e6",
                        "source_entry_id": "f7a1bc2e-d7a5-32d7-864c-60fa0b29a511",
                        "source_sense_id": "65641b60-4955-3a63-9208-36390e6317f4",
                        "source_sense_description": "Vertreter einer der artenreichsten und am weitesten verbreiteten Gruppen pflanzenfressender Dinosaurier",
                        "target_lang_word": "sauropod",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sauropod",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4936eaa2-09f4-3a03-88c6-f9cd9594e822",
                                        "entry_id": "3a2c5f17-3e96-3f2b-8a10-d5ba1d2566b3",
                                        "glosses": [
                                            "A member of the Sauropoda suborder of dinosaurs"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6bb1d8f-7efe-4d35-8b21-20b48126068b",
                                                "sense_id": "4936eaa2-09f4-3a03-88c6-f9cd9594e822",
                                                "text": "His most memorable work is an illustrated compendium of dinosaurian copulatory positions - a sort of reptilian Kama Sutra - that includes a “leg over” manoeuvre by the sauropods, the largest dinosaurs of all - that many consider highly dubious."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7bf8a393-4958-4862-b085-a15fabdb4669",
                        "source_entry_id": "f7a1bc2e-d7a5-32d7-864c-60fa0b29a511",
                        "source_sense_id": "65641b60-4955-3a63-9208-36390e6317f4",
                        "source_sense_description": "Vertreter einer der artenreichsten und am weitesten verbreiteten Gruppen pflanzenfressender Dinosaurier",
                        "target_lang_word": "sauropode",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sauropode",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "197a3c98-f10a-3cb3-a6e5-b79813a5bf3e",
                                        "entry_id": "89f6240b-7765-3e97-85c3-a6c9f817f7b0",
                                        "glosses": [
                                            "Membre de la super-famille de dinosaures quadrupèdes et herbivores, appartenant au sous-ordre des sauropodomorphes et ayant vécu entre le Jurassique moyen et le Crétacé supérieur sur l'ensemble de la planète."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2a9aae3-aabb-4b60-a75a-645a523d6024",
                                                "sense_id": "197a3c98-f10a-3cb3-a6e5-b79813a5bf3e",
                                                "text": "… Pour eux, dénicher un sauropode ayant traversé les âges reviendrait à remettre en cause la théorie évolutionniste de Darwin."
                                            },
                                            {
                                                "example_id": "084a0b04-2ba5-4aa3-b377-758a75e5ae5c",
                                                "sense_id": "197a3c98-f10a-3cb3-a6e5-b79813a5bf3e",
                                                "text": "Une nouvelle espèce de sauropode, le bajadasaurus pronuspinax, a été découverte en Argentine et permettra aux scientifiques d'en savoir plus sur les fonctions défensives de leur long cou."
                                            },
                                            {
                                                "example_id": "4240b2b5-6fee-4a02-849b-f4bc7908239d",
                                                "sense_id": "197a3c98-f10a-3cb3-a6e5-b79813a5bf3e",
                                                "text": "Ils chassaient vraisemblablement des sauropodes vivant à la même époque, dont des restes ont été découverts sur le site de fouilles."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
