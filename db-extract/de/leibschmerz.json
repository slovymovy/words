                ],
                "senses": [
                    {
                        "sense_id": "9e2e4baa-2ee0-3f0b-a73a-a1f1daea6ddb",
                        "entry_id": "f6896948-db8d-323e-9250-6b3f6c2f2444",
                        "glosses": [
                            "Schmerz(en) im Leib"
                        ],
                        "tags": [
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "a2492e0e-5646-4a91-b988-8430b5be08f8",
                                "sense_id": "9e2e4baa-2ee0-3f0b-a73a-a1f1daea6ddb",
                                "text": "„An diesem Morgen hatten Mutter und ich »frei«, denn Großmutter hatte Leibschmerzen.“"
                            },
                            {
                                "example_id": "50814cc9-3be6-4214-ad69-a4b48c351467",
                                "sense_id": "9e2e4baa-2ee0-3f0b-a73a-a1f1daea6ddb",
                                "text": "„Hartnäckige Verstopfung zusammen mit sehr heftigen Leibschmerzen kommt auch bei Bleivergiftung vor.“"
                            },
                            {
                                "example_id": "c719b041-f8fe-4429-b452-d9001756ae77",
                                "sense_id": "9e2e4baa-2ee0-3f0b-a73a-a1f1daea6ddb",
                                "text": "„Während des Essens darf man die Beine nicht kreuzen; man bekommt sonst Leibschmerzen.“"
                            },
                            {
                                "example_id": "23e2f229-f398-47eb-abc2-63090a1eb744",
                                "sense_id": "9e2e4baa-2ee0-3f0b-a73a-a1f1daea6ddb",
                                "text": "„Ich bekam Leibschmerzen, die immer schlimmer wurden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
