                {
                    "sense_id": "1053143c-9c15-3c64-a472-bdb634165d25",
                    "sense_definition": "het geven van het ene voorwerp in ruil voor een ander",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "uitwisseling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik deed een <w>ruil</w> met mijn vriend en kreeg zijn fiets in ruil voor mijn skateboard.",
                            "target_lang_translations": {
                                "ru": "Я совершил <w>обмен</w> с другом и получил его велосипед в обмен на свой скейтборд."
                            }
                        },
                        {
                            "text": "Op de markt kun je vaak een goede <w>ruil</w> doen.",
                            "target_lang_translations": {
                                "ru": "На рынке часто можно совершить выгодный <w>обмен</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "uitwisseling",
                        "wissel"
                    ],
                    "common_phrases": [
                        "in ruil voor"
                    ],
                    "target_lang_definitions": {
                        "ru": "процесс передачи одного предмета взамен другого"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обмен",
                                "target_lang_sense_clarification": "процесс взаимной передачи предметов"
                            },
                            {
                                "target_lang_word": "бартер",
                                "target_lang_sense_clarification": "прямой товарообмен без использования денег"
                            }
                        ]
                    }
                }
            ]
        },
