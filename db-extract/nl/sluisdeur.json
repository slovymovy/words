                "senses": [
                    {
                        "sense_id": "6e4c9a84-77b6-3154-9657-db618da01a79",
                        "entry_id": "88042a7a-aa25-303f-866b-91df222668bf",
                        "glosses": [
                            "het bewegende deel van de sluis."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0f1b7f6-a600-4d6c-8bdb-22512c241a38",
                                "sense_id": "6e4c9a84-77b6-3154-9657-db618da01a79",
                                "text": "De sluisdeur gaat open bij gelijke waterstand aan beide zijden."
                            },
                            {
                                "example_id": "a0eebb3e-53a1-4b3f-b109-a979953958ae",
                                "sense_id": "6e4c9a84-77b6-3154-9657-db618da01a79",
                                "text": "De creatieve Fries bedacht een oplossing: hij bouwde een muur die naar binnen kon draaien. Het idee bedacht hij tijdens een boottochtje, vertelt De Vries donderdag aan Omrop Fryslân. „Op een gegeven moment voeren wij met de boot langs de sluizen van Stavoren. Ik zag die dikke sluisdeuren daar draaien en dacht: verdikkie, als die deuren kunnen draaien, dan kan de muur van het huis ook draaien!”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "89a719f1-136e-4080-8aa6-87215d0ac781",
                        "source_entry_id": "88042a7a-aa25-303f-866b-91df222668bf",
                        "source_sense_id": "6e4c9a84-77b6-3154-9657-db618da01a79",
                        "target_lang_word": "Schleusentor",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schleusentor",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "470e29b9-7555-362c-9ba3-29e0033bef75",
                                        "entry_id": "02aeb100-eeb6-3188-87c4-a931c7bf4ecf",
                                        "glosses": [
                                            "Tor einer Schleuse; vordere oder hintere Absperrung einer Schleuse"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60bd5e96-8b36-48dc-be10-f22980f3aecd",
                                                "sense_id": "470e29b9-7555-362c-9ba3-29e0033bef75",
                                                "text": "„Die gewaltige Explosion zerstörte das Schleusentor endgültig und riss immer noch an die 300 Menschen in den Tod, Zivilisten und einfache Soldaten.“"
                                            },
                                            {
                                                "example_id": "dee21454-a4a9-4dab-9b73-b65cd710f5ac",
                                                "sense_id": "470e29b9-7555-362c-9ba3-29e0033bef75",
                                                "text": "„Und dann hat es geregnet, und zwar gleich auf einmal ganz stark und überall, wie bei der Schleuse, als das Schleusentor runter ging und das Wasser herein strömte.“"
                                            },
                                            {
                                                "example_id": "9484f3ed-da7d-4550-83c9-ba227c14a261",
                                                "sense_id": "470e29b9-7555-362c-9ba3-29e0033bef75",
                                                "text": "„Die Schleusentore öffneten sich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7d298c8a-483f-47ce-af0f-0fe4604457dd",
                        "source_entry_id": "88042a7a-aa25-303f-866b-91df222668bf",
