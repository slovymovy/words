                        "glosses": [
                            "Enlever les aiguilles (d’un arbre)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b3b9bad-4ba5-47fc-b596-35ec51866d3b",
                                "sense_id": "228d6553-e34a-3a28-a191-0fb7016989e3",
                                "text": "Faut-il désaiguiller tout l'arbre impérativement, ou bien ne faire que la partie gardée dans le projet ?"
                            },
                            {
                                "example_id": "d9bf540f-b169-4af6-a1b0-6eb81a12aee5",
                                "sense_id": "228d6553-e34a-3a28-a191-0fb7016989e3",
                                "text": "Par contre je crois toujours que c'est une erreur de désaiguiller en hiver."
                            },
                            {
                                "example_id": "5300374f-4c95-40c6-8aca-1e9f8857741a",
                                "sense_id": "228d6553-e34a-3a28-a191-0fb7016989e3",
                                "text": "Pince à désaiguiller à crochets longueur 210mm en acier forgé main."
