                                "target_senses": [
                                    {
                                        "sense_id": "ec6b0e37-3ea8-3c29-92b2-8204ec6c7de8",
                                        "entry_id": "0c73cbb7-b4b9-3715-b8bb-c233e7de39f1",
                                        "glosses": [
                                            "frei aus vorhandenen Möglichkeiten auswählbar oder nach eigenem Gutdünken bei etwas vorgehend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45954e3b-5aa8-42c2-a1af-c3b30df3faef",
                                                "sense_id": "ec6b0e37-3ea8-3c29-92b2-8204ec6c7de8",
                                                "text": "Sie dürfen ein beliebiges Buch lesen."
                                            },
                                            {
                                                "example_id": "f2a1ff7c-9eac-4d0a-ba8f-af02bb5701ed",
                                                "sense_id": "ec6b0e37-3ea8-3c29-92b2-8204ec6c7de8",
                                                "text": "„[…] sie werden generös und traktieren einander und werfen sich lachend die schwersten Insulten an den Kopf; sie lassen Weib und Tochter mit den beliebigsten Nächsten charmieren und gestatten sich dasselbe angesichts ihrer kichernden Gesponsin mit Hausiermamsells und Blumenmädels.“"
                                            },
                                            {
                                                "example_id": "a82db5eb-31d8-4329-8c99-58bc0688ed1d",
                                                "sense_id": "ec6b0e37-3ea8-3c29-92b2-8204ec6c7de8",
                                                "text": "„Denn einen noch künstlicheren, noch weltloseren, noch beliebigeren Film als den von Chen gibt es auf der diesjährigen Berlinale nicht.“"
                                            },
                                            {
                                                "example_id": "3a213f02-ac78-4b39-a550-b083c9681861",
                                                "sense_id": "ec6b0e37-3ea8-3c29-92b2-8204ec6c7de8",
                                                "text": "„Nun ist ja alles Üble jederzeit möglich bei einem, der schon einmal das Üble getan hat, und seine neuerliche Erwartung ist jederzeit angebracht, und es ist jederzeit angebracht, beim beliebigsten, geringsten Anlaß die Anamnese zu zitieren, denn der beliebigste, geringste Anlaß wird monströs dadurch, daß es das Monströse einmal überhaupt gab – egal ob bereut, berichtigt, verachtet, sogar getilgt – nur nichts tilgen, bloß nicht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
