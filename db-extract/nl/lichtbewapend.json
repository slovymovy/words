                        "examples": [
                            {
                                "example_id": "d8aa86ef-a507-4406-83ac-0b0ac41a6009",
                                "sense_id": "717ac3dd-c7ca-32a5-bbf4-735807623a1b",
                                "text": "Ze waren in feite te lichtbewapend voor een moeilijke operatie als het veroveren van een brug."
                            },
                            {
                                "example_id": "56917716-164c-441e-97bb-f9d421778d33",
                                "sense_id": "717ac3dd-c7ca-32a5-bbf4-735807623a1b",
                                "text": "De rebellen zeggen dat ze het gevechtsvliegtuig vanmiddag hebben neergehaald. Hoe ze dat hebben gedaan is niet duidelijk. Over het algemeen zijn de opstandelingen lichtbewapend. Volgens de Syrische staatstelevisie is het toestel als gevolg van technische problemen neergestort en wist de piloot op tijd zijn schietstoel te gebruiken."
                            },
                            {
                                "example_id": "2bfcd733-db5d-49ee-9e39-116430dacfa3",
                                "sense_id": "717ac3dd-c7ca-32a5-bbf4-735807623a1b",
                                "text": "Alle 107 aanwezige parlementariërs in het 120 zetels tellende parlement stemden voor drie wetsontwerpen waarmee de huidige 4000 man sterke veiligheidsdienst in het land wordt uitgebouwd tot een lichtbewapend leger. De etnische Serviërs in het parlement boycotten de stemming."
                            }
