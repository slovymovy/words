                ],
                "senses": [
                    {
                        "sense_id": "7bfd8fce-4075-337f-99fa-0cc2f53bda9c",
                        "entry_id": "6735953d-9e5c-3138-8ae6-258c2947ef38",
                        "glosses": [
                            "ein Bauteil einer Entrahmungszentrifuge, das den Rahm auffängt und über eine Öffnung abfließen lässt"
                        ],
                        "tags": [
                            "Milchwirtschaft",
                            "veraltet (ca. 1880-1930)"
                        ],
                        "examples": [
                            {
                                "example_id": "920c0f17-78f0-4c79-8914-a989647db68c",
                                "sense_id": "7bfd8fce-4075-337f-99fa-0cc2f53bda9c",
                                "text": "„Magermilch- und Rahmdeckel sind mit Ab[f]lußöffnungen versehen, aus denen die Flüssigkeiten in darunter befindliche Sammelgefäße gelangen.“"
                            },
                            {
                                "example_id": "2813fa90-8edc-45c0-98a9-121fa4c79f5f",
                                "sense_id": "7bfd8fce-4075-337f-99fa-0cc2f53bda9c",
                                "text": "„In den Fällen, wo es sich ausschließlich um Reinigungszwecke handelt, wird bei den Alpha-Seperatoren der Rahmdeckel der betreffenden Marke durch erwähnten Reinigungsring ersetzt, wodurch sich die Trennungserzeugnisse hernach wieder innig vermengen.“"
                            },
                            {
                                "example_id": "58c05f37-d0c7-4e02-b527-2ee68ab19809",
                                "sense_id": "7bfd8fce-4075-337f-99fa-0cc2f53bda9c",
                                "text": "„Es könnte dies [Rahm zur Magermilch gelangen] geschehen, wenn die beiden Hähnchen, durch welche die Magermilch abfließt, nicht vollständig dicht in ihren Muttern sitzen, oder es könnte wohl auch Rahm beim Überschwabben unter den Rahmdeckel, also zur Magermilch gelangen.“"
                            },
                            {
                                "example_id": "604b9d5e-ac90-4760-9d26-e9766c832db5",
                                "sense_id": "7bfd8fce-4075-337f-99fa-0cc2f53bda9c",
                                "text": "„B₁ ist der oberste Deckel, B₂ der Rahmdeckel, B₃ der Magermilchdeckel mit den entsprechenden Ausflußröhren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
