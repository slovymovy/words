                "forms": [
                    {
                        "form_id": "36f70122-b85d-46dd-a6ec-faa606685cab",
                        "entry_id": "712cd423-b19e-3c32-a371-69f66be94244",
                        "tags": [
                            "plural"
                        ],
                        "form": "septuples"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "49659e9b-2198-3cbc-97b5-16c3c533778f",
                        "entry_id": "712cd423-b19e-3c32-a371-69f66be94244",
                        "glosses": [
                            "Qui vaut sept fois une quantité donnée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2183e7ed-af05-459e-b04f-51697d810b2a",
                                "sense_id": "49659e9b-2198-3cbc-97b5-16c3c533778f",
                                "text": "Quatorze est septuple de deux."
                            },
                            {
                                "example_id": "9d4372d9-3e9f-4468-8ce4-227c3b25f675",
                                "sense_id": "49659e9b-2198-3cbc-97b5-16c3c533778f",
                                "text": "Une valeur septuple."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8bf83c6e-0881-4ea4-be3d-88481a974a0e",
                        "source_entry_id": "712cd423-b19e-3c32-a371-69f66be94244",
                        "source_sense_id": "49659e9b-2198-3cbc-97b5-16c3c533778f",
                        "target_lang_word": "septuple",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "septuple",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0e7379ff-78e5-3eb8-bc4e-84001ed736c7",
                                        "entry_id": "76a66f63-2c14-3299-8555-cefca09e1103",
                                        "glosses": [
                                            "Seven times as much; sevenfold."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb409108-a84b-435a-971b-515a60a54cb8",
                                                "sense_id": "0e7379ff-78e5-3eb8-bc4e-84001ed736c7",
                                                "text": "[Japan] will not remember our American and English missionaries as she remembers even now those great Chinese priests who once educated her youth. And she will not preserve relics of our sojourn, carefully wrapped in septuple coverings of silk, and packed way in dainty whitewood boxes, because we had no new lesson of beauty to teach her,—nothing by which to appeal to her emotions."
                                            },
                                            {
                                                "example_id": "579f05f5-50c0-4e24-84cc-91184b0adda0",
                                                "sense_id": "0e7379ff-78e5-3eb8-bc4e-84001ed736c7",
                                                "text": "He is woozy with cold and a septuple whisky […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "septuple",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "985bf0c6-653f-3ecd-ba39-4bfb07d4f725",
                                        "entry_id": "239e6af8-f4d6-30a6-9050-75e57641fdb9",
                                        "glosses": [
                                            "To multiply by seven."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "63407867-860f-488e-b929-d6bd15003ebb",
                                                "sense_id": "985bf0c6-653f-3ecd-ba39-4bfb07d4f725",
                                                "text": "[…] hee is rid of the Deuill. Now he that is quit of so bad a Guest, shall septuple his owne woes by his re-entertainment."
                                            },
                                            {
                                                "example_id": "c6daf9af-71d4-4215-b4b3-dd7c4ea47b6e",
                                                "sense_id": "985bf0c6-653f-3ecd-ba39-4bfb07d4f725",
                                                "text": "The intensity of solar radiation is nearly seven times greater on Mercury than on the earth, and on Uranus 330 times less; the proportion between the two extremes being that of upwards of 2000 to one. Let any one figure to himself the condition of our globe, were the sun to be septupled, to say nothing of the greater ratio!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b03ebc1d-f58c-37f9-88cb-f4f4538696b2",
                                        "entry_id": "239e6af8-f4d6-30a6-9050-75e57641fdb9",
                                        "glosses": [
                                            "To increase by a factor of seven."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "257aa138-836c-49f4-bef6-729ecbd403e9",
                                                "sense_id": "b03ebc1d-f58c-37f9-88cb-f4f4538696b2",
                                                "text": "[…] Levi Strauss had caught a wave. Between 1962 and 1970, its sales and net profits grew fivefold and between 1970 and 1977 its sales again quintupled while profits almost septupled."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "septuple",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "94ba073c-ab74-3d99-a559-86b275267201",
                                        "entry_id": "bbaf5987-2fb2-3422-ab9e-5fb2cb18d5b4",
                                        "glosses": [
                                            "A set of seven."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "355828ca-9f5c-4004-82ab-fbaf6556cad5",
                                                "sense_id": "94ba073c-ab74-3d99-a559-86b275267201",
                                                "text": "If we suppose the limited region of Central Asia, where man existed, to have been deluged, and pairs and septuples of the most common animals in that region only to have been kept alive in the ark, the entire account will harmonize with natural history."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69afb0aa-0464-3337-843d-2415c8c96286",
                                        "entry_id": "bbaf5987-2fb2-3422-ab9e-5fb2cb18d5b4",
                                        "glosses": [
                                            "A sevenfold measure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1e2623e-8254-499e-bf63-ce97778e950f",
                                                "sense_id": "69afb0aa-0464-3337-843d-2415c8c96286",
                                                "text": "Frozen, the vodka poured like heavy glass. A septuple? Why not."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6bd1a377-2255-49c7-a240-ce0c10d45b49",
                        "source_entry_id": "712cd423-b19e-3c32-a371-69f66be94244",
