                    {
                        "sense_id": "1e7b1824-1d58-3e6d-915a-0410f3221297",
                        "entry_id": "f5ebc17e-1d6d-38ff-b7a3-15e4c88ea6c4",
                        "glosses": [
                            "haggard, cadaverous, emaciated or gaunt"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "26b3e4dd-f2c8-3deb-9872-ff5af54a0b58",
                        "entry_id": "f5ebc17e-1d6d-38ff-b7a3-15e4c88ea6c4",
                        "glosses": [
                            "barebones, lacking elaboration"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8987aa59-368a-4728-8949-912df6f53f12",
                                "sense_id": "26b3e4dd-f2c8-3deb-9872-ff5af54a0b58",
                                "text": "On the whole, Sidney Morris has given us sketchy characters that need more fine tuning than this production […] could give it. Only Holmberg seemed to dig deeply within himself to create a complete character from Morris' skeletal outline."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "529e6dbb-0922-4186-ad11-7e27e4ccaefc",
                        "source_entry_id": "f5ebc17e-1d6d-38ff-b7a3-15e4c88ea6c4",
                        "source_sense_description": "of, or relating to the skeleton",
                        "target_lang_word": "kosterní",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kosterní",
