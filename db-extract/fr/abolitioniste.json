                "senses": [
                    {
                        "sense_id": "27d3c013-34be-3faa-a60d-dd72125eb251",
                        "entry_id": "34e7ad0b-6de0-3665-adfc-6f30afee14aa",
                        "glosses": [
                            "Variante orthographique de abolitionniste."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "fefb166f-caa7-448e-9440-0ed9de9ac3b9",
                                "sense_id": "27d3c013-34be-3faa-a60d-dd72125eb251",
                                "text": "On déteste bien plus un abolitioniste aux colonies que nous ne détestons en France un possesseur d’esclaves, on l’exècre."
                            },
                            {
                                "example_id": "2dde3053-07b5-4aa7-a233-1851979fe020",
                                "sense_id": "27d3c013-34be-3faa-a60d-dd72125eb251",
                                "text": "Un abolitioniste décidé du Brésil M. Abilio Borges, est en ce moment à Paris, et nous allons préparer ensemble une adresse à l’Empereur de ce pays ; je vous demande la permission d’y mettre vos noms ou de l’envoyer à votre signature."
                            },
                            {
                                "example_id": "d88d8a01-c06d-442f-8e21-abf6fa37ca72",
                                "sense_id": "27d3c013-34be-3faa-a60d-dd72125eb251",
                                "text": "Elle avait appris qu’une abolitioniste visitait Brown dans sa prison."
                            },
                            {
                                "example_id": "752ec004-3d5c-4c21-b922-b87b346c1310",
                                "sense_id": "27d3c013-34be-3faa-a60d-dd72125eb251",
                                "text": "Monsieur Victor Schoelcher a lui aussi été un abolitioniste et a été enterré au Panthéon."
                            }
                        ]
                    }
                ],
