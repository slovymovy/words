                                                "text": "seismic activity"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0beeded1-29a6-3d86-8f0b-93d4e7b7548d",
                                        "entry_id": "2d89a0bd-ace4-3af1-ad56-0152b13bb04c",
                                        "glosses": [
                                            "Subject to earthquakes."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "02cb3cc0-b472-40a8-87d0-554f31461b57",
