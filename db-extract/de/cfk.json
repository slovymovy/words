                        "examples": [
                            {
                                "example_id": "bdd9dbc3-351f-43bc-abb8-c95359857ccc",
                                "sense_id": "95d91b82-ce51-31ea-9bef-c7ba2a7b4818",
                                "text": "Ein Ansatz zum Erlangen von mehr Marktanteilen sind innovative Technologien zum Reduzieren der Flugzeugherstell- und Betriebskosten. In diesem Umfeld erleben Hochleistungsfaserverbundstrukturen aus CFK zurzeit einen weltweiten Aufschwung."
                            },
                            {
                                "example_id": "4e21512c-a1ce-42da-99bd-9b6bf9b734ea",
                                "sense_id": "95d91b82-ce51-31ea-9bef-c7ba2a7b4818",
                                "text": "CFK ist ein Verbund von Kohlefasern mit Kunstharzen."
                            },
                            {
                                "example_id": "a645efdb-5e27-4226-b163-41fc9ec0fc48",
                                "sense_id": "95d91b82-ce51-31ea-9bef-c7ba2a7b4818",
                                "text": "CFK ist die Abkürzung für carbonfaserverstärkter Kunststoff (engl.: carbon fibre reinforced plastics). Es hat eine hohe Festigkeit und Steifigkeit bei – im Vergleich zu metallischen Werkstoffen – geringer Masse und kann nicht korrodieren."
                            }
                        ]
                    }
