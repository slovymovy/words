                "senses": [
                    {
                        "sense_id": "c11e63db-9cd2-3791-a953-0b72d99acd5e",
                        "entry_id": "bfe9f318-afd8-38d0-857f-87fdc63d3e0e",
                        "glosses": [
                            "ein Stollen, der mit seiner Seige zehn Lachter tief in ein Gebäude einkommt. In diesem Falle bekommt er das Erbe, das ist eine Art von Eigentumsrecht, über die nahe liegenden Grubengebäude"
                        ],
                        "tags": [
                            "Bergbau"
                        ],
                        "examples": [
                            {
                                "example_id": "c7655438-8e86-41f8-be8d-c50b75b64c29",
                                "sense_id": "c11e63db-9cd2-3791-a953-0b72d99acd5e",
                                "text": "„Der bergrechtliche Begriff des Erbstollens beschreibt den Umstand, dass der Besitzer dieses Stollens das Recht hatte, von allen Bergwerken, deren Wasser er ableitete, als Abgabe eine sogenannte Erbstollengebühr zu erheben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
