                            {
                                "example_id": "be65b9bb-4b3c-49e0-b4b6-2e5b7ba5a18c",
                                "sense_id": "2969873b-73e0-3448-b949-8a142f43f9ed",
                                "text": "De beeldscherpte is zo groot dat je met de ruimtetelescoop een boek zou kunnen lezen op een afstand van een kilometer."
                            },
