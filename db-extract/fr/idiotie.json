                    {
                        "translation_id": "eb90d651-b77a-4635-b368-3fcae0a16e08",
                        "source_entry_id": "0ace5885-342a-3128-83a3-ae8ba35b21cf",
                        "target_lang_word": "白痴",
                        "target_lang_code": "zh",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "白痴",
                                "target_lang_code": "zh",
                                "target_senses": [
                                    {
                                        "sense_id": "ed733a68-864a-3303-8f8f-fe5164671569",
                                        "entry_id": "98998b4b-a419-3da3-969c-585498c43963",
                                        "glosses": [
                                            "缺少智慧或言行愚蠢、不合情理；亦指這樣的人"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4968e14e-9787-48eb-8996-1ce59d3b6b3f",
                                                "sense_id": "ed733a68-864a-3303-8f8f-fe5164671569",
                                                "text": "我竟然做這樣的事，真是白痴。"
                                            },
                                            {
                                                "example_id": "1b95f85a-76fd-4312-814f-df9bc977c9ea",
                                                "sense_id": "ed733a68-864a-3303-8f8f-fe5164671569",
                                                "text": "我竟然做这样的事，真是白痴。"
                                            },
                                            {
                                                "example_id": "f460b1cb-7cd8-425c-be9e-3116679b5cf8",
                                                "sense_id": "ed733a68-864a-3303-8f8f-fe5164671569",
                                                "text": "梁武帝捨身佛寺，群臣以錢一億萬奉贖，表請還宮，三請乃許。此非白癡，即兒戲耳。"
                                            },
                                            {
                                                "example_id": "a5f06006-fb51-42b0-b572-1535c08998a5",
                                                "sense_id": "ed733a68-864a-3303-8f8f-fe5164671569",
                                                "text": "梁武帝舍身佛寺，群臣以钱一亿万奉赎，表请还宫，三请乃许。此非白痴，即儿戏耳。"
                                            },
                                            {
                                                "example_id": "4a026df9-fb76-43ea-bba6-a58544cdf9ea",
                                                "sense_id": "ed733a68-864a-3303-8f8f-fe5164671569",
                                                "text": "我寧可做一個麻木、白痴、渾噩的人，一生在安樂、卑怯、依賴的環境中過活。"
                                            },
                                            {
                                                "example_id": "89264f2f-294c-4d6c-baac-e9efb68f54c8",
                                                "sense_id": "ed733a68-864a-3303-8f8f-fe5164671569",
                                                "text": "我宁可做一个麻木、白痴、浑噩的人，一生在安乐、卑怯、依赖的环境中过活。"
                                            },
                                            {
                                                "example_id": "d002bc48-6b2c-4fd1-96b6-94372b95a13c",
                                                "sense_id": "ed733a68-864a-3303-8f8f-fe5164671569",
                                                "text": "他是個白痴，無父無母，寄在一個遠親的籬下，為人看羊，斫柴，做些零碎的事情。"
                                            },
                                            {
                                                "example_id": "281657c4-6930-4d03-8577-f59fc0513b56",
                                                "sense_id": "ed733a68-864a-3303-8f8f-fe5164671569",
                                                "text": "他是个白痴，无父无母，寄在一个远亲的篱下，为人看羊，斫柴，做些零碎的事情。"
                                            },
                                            {
                                                "example_id": "08003be5-07d8-4978-b807-bd19e641e04c",
                                                "sense_id": "ed733a68-864a-3303-8f8f-fe5164671569",
                                                "text": "那個兒子後來成了一個白痴。"
                                            },
                                            {
                                                "example_id": "9ac17808-2406-4fa7-8a0e-4abff56c9370",
                                                "sense_id": "ed733a68-864a-3303-8f8f-fe5164671569",
                                                "text": "那个儿子后来成了一个白痴。"
                                            }
                                        ]
                                    },
