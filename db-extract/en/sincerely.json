                        "entry_id": "42bebf1d-356e-3730-bc3e-4a6f5241f091",
                        "glosses": [
                            "In a sincere or earnest manner; honestly."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96a141cc-479f-4042-9ac3-108f94b1194d",
                                "sense_id": "d15d750b-d3b6-38bf-90be-09657b0aa57d",
                                "text": "I sincerely hope they make it home safely."
                            }
                        ]
                    },
                    {
                        "sense_id": "a3c33a4b-87cc-3bfb-ad15-6eda138ae2c3",
                        "entry_id": "42bebf1d-356e-3730-bc3e-4a6f5241f091",
                        "glosses": [
                            "A conventional formula for ending a letter, used when the salutation addresses the person for whom the letter is intended by his or her name."
                        ],
                        "tags": [
                            "US"
                        ],
                        "examples": [
                            {
                                "example_id": "99ddf67e-3377-4c42-8793-f536d8d8b316",
                                "sense_id": "a3c33a4b-87cc-3bfb-ad15-6eda138ae2c3",
                                "text": "Please consider the proposal carefully and let me know what you decide.\nSincerely,\nFred"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "29811661-bad1-41ff-9d6e-d35157eb7d0d",
