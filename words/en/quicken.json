    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "561563cf-b900-31c1-8883-cf2ffeef05b1",
                    "sense_definition": "To make something faster or more rapid; to accelerate.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "speed",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The runner decided to <w>quicken</w> his pace as he approached the final lap of the race.",
                            "target_lang_translations": {
                                "ru": "Бегун решил <w>ускорить</w> темп, приближаясь к последнему кругу дистанции."
                            }
                        },
                        {
                            "text": "She had to <w>quicken</w> her steps to catch the bus before it pulled away from the station.",
                            "target_lang_translations": {
                                "ru": "Ей пришлось <w>ускорить</w> шаг, чтобы успеть на автобус, пока он не отъехал от остановки."
                            }
                        }
                    ],
                    "synonyms": [
                        "accelerate",
                        "hasten",
                        "speed up",
                        "step up",
                        "hurry"
                    ],
                    "antonyms": [
                        "slow",
                        "decelerate",
                        "slacken"
                    ],
                    "common_phrases": [
                        "quicken the pace",
                        "quicken her steps",
                        "quicken the pulse"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделать что-либо более быстрым или стремительным; ускорить."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ускорить",
                                "target_lang_sense_clarification": "сделать более быстрым"
                            },
                            {
                                "target_lang_word": "ускорять",
                                "target_lang_sense_clarification": "процесс увеличения скорости"
                            },
                            {
                                "target_lang_word": "прибавить",
                                "target_lang_sense_clarification": "о шаге или темпе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "999a9458-172d-3bed-9f83-57316b290b30",
                    "sense_definition": "To become faster or more rapid.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "speed",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My heartbeat began to <w>quicken</w> when I heard the mysterious noise coming from the basement.",
                            "target_lang_translations": {
                                "ru": "Мое сердцебиение начало <w>учащаться</w>, когда я услышал таинственный шум из подвала."
                            }
                        },
                        {
                            "text": "As the music reached its climax, the tempo of the dance started to <w>quicken</w> noticeably.",
                            "target_lang_translations": {
                                "ru": "Когда музыка достигла кульминации, темп танца начал заметно <w>ускоряться</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "accelerate",
                        "pick up speed",
                        "speed up"
                    ],
                    "antonyms": [
                        "slow down"
                    ],
                    "common_phrases": [
                        "heartbeat quickened",
                        "pulse quickened"
                    ],
                    "target_lang_definitions": {
                        "ru": "Стать более быстрым или стремительным."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ускориться",
                                "target_lang_sense_clarification": "начать двигаться быстрее"
