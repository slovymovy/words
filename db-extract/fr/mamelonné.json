                    {
                        "sense_id": "a04ba412-2255-350d-8f9e-47210475278c",
                        "entry_id": "9aecba62-87e0-32a1-b385-01462d36ec06",
                        "glosses": [
                            "Qui est couvert de mamelons, qui a des proéminences rappelant la forme d’un mamelon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d661ba91-cb77-46e0-9cc7-7f0ae7143bdf",
                                "sense_id": "a04ba412-2255-350d-8f9e-47210475278c",
                                "text": "Prismatique et cylindroïde, gris-bleuâtre, cristaux entièrement recouverts de plomb phosphaté brun mamelonné ; Poullaouen, département des Côtes-du-Nord."
                            },
                            {
                                "example_id": "0c9c03bd-d7b6-4b91-95f8-c7dac3a06a7b",
                                "sense_id": "a04ba412-2255-350d-8f9e-47210475278c",
                                "text": "Il aura fallu des années pour que cet asperitas (du latin « âpreté », « brutalité ») soit officiellement distingué de ses cousins undulatus (« ondulé ») et mammatus (« mamelonné »)."
                            }
                        ]
                    }
