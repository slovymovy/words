                "senses": [
                    {
                        "sense_id": "c1c2b5c9-56e3-33b6-ac24-406a3b838b91",
                        "entry_id": "0724af19-d45b-3aea-8050-5b7052a55993",
                        "glosses": [
                            "vorübergehende Unterbrechung der Kampfhandlungen im Krieg"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5cd119b-5154-48ff-beaa-49b548cf25d4",
                                "sense_id": "c1c2b5c9-56e3-33b6-ac24-406a3b838b91",
                                "text": "„Das Leben auf dem Schloß nahm während der Kriegspausen seinen gewöhnlichen Gang.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aaf11543-4d4c-4bd0-a07d-6482023c2e3c",
                        "source_entry_id": "0724af19-d45b-3aea-8050-5b7052a55993",
                        "source_sense_id": "c1c2b5c9-56e3-33b6-ac24-406a3b838b91",
                        "source_sense_description": "vorübergehende Unterbrechung der Kampfhandlungen im Krieg",
                        "target_lang_word": "trêve",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trêve",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e81828ab-1331-3d29-ac4c-d4193764c9b2",
                                        "entry_id": "f04b5d4b-5710-3207-8e20-73ad33437856",
                                        "glosses": [
                                            "Suspension de l’usage des armes, cessation de tout acte d’hostilité pour un certain temps, par convention faite entre deux États, entre deux partis qui sont en guerre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf567288-c431-4ae8-a8d3-93cb629dbd70",
                                                "sense_id": "e81828ab-1331-3d29-ac4c-d4193764c9b2",
                                                "text": "Le Roi a une entrevue à Nice avec le Pape Paul III, qui ménage une trêve de dix ans entre les Puissances belligérantes."
                                            },
                                            {
                                                "example_id": "2f78bbf1-c1c2-409a-a71e-d72e02d226ea",
                                                "sense_id": "e81828ab-1331-3d29-ac4c-d4193764c9b2",
                                                "text": "J’ai peu de choses importantes à vous apprendre, […], si ce n’est la nouvelle déjà confirmée d’une trêve entre les croisés et Saladin."
                                            },
                                            {
                                                "example_id": "0386492b-3b77-4a60-bcaa-ed2e1011b3fb",
                                                "sense_id": "e81828ab-1331-3d29-ac4c-d4193764c9b2",
                                                "text": "Cette trêve boiteuse fut définitivement rompue par l’assassinat (car il n’y a pas d’autre mot pour un tel acte) du Wetterhorn, au-dessus de Union Square […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4fcc79f4-5476-3eb4-962f-8b1954489294",
                                        "entry_id": "f04b5d4b-5710-3207-8e20-73ad33437856",
                                        "glosses": [
                                            "Toute suspension d’hostilités entre adversaires."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "adc94cb8-4bd8-3681-9617-7b22fa850d68",
                                        "entry_id": "f04b5d4b-5710-3207-8e20-73ad33437856",
                                        "glosses": [
                                            "Relâche."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cbd31942-bab4-4f8d-8a37-e49fa0373240",
                                                "sense_id": "adc94cb8-4bd8-3681-9617-7b22fa850d68",
                                                "text": "Soyez les apôtres de ma Cause, cause sacrée, qui est celle de la défaite noble et fière, défaite temporaire... Faites le plus possible de prosélytes ; travaillez-y sans trêve ni relâche..."
                                            },
                                            {
                                                "example_id": "0c95815c-bf58-4b23-bf8e-c0b6a378b514",
                                                "sense_id": "adc94cb8-4bd8-3681-9617-7b22fa850d68",
                                                "text": "un bombardement sans cesse ni trêve"
                                            },
                                            {
                                                "example_id": "025890bf-c93a-40ac-a9d6-82fa14cbc92b",
                                                "sense_id": "adc94cb8-4bd8-3681-9617-7b22fa850d68",
                                                "text": "Catherine remarqua que les regards d’Isabelle allaient sans trêve de l’une à l’autre porte, comme anxieux."
                                            },
                                            {
                                                "example_id": "abecd780-e9e5-4025-bfd4-37ffb047d6e1",
                                                "sense_id": "adc94cb8-4bd8-3681-9617-7b22fa850d68",
                                                "text": "Nos gouvernements ne résistent pas à la tentation de l’infantilisation qui devient exaspérante. Nous aurons droit à une trêve de Noël supervisée par des experts de la Santé publique. Ottawa nous dit même à quel volume mettre la musique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b26f5e7b-d630-3b51-85da-e0b50efe086b",
                                        "entry_id": "f04b5d4b-5710-3207-8e20-73ad33437856",
                                        "glosses": [
                                            "Cesser quelque chose ; cesser de parler de quelque chose."
                                        ],
                                        "tags": [
                                            "ellipsis",
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f4d5ac0-6fa8-47cb-8b43-fefbc640d658",
                                                "sense_id": "b26f5e7b-d630-3b51-85da-e0b50efe086b",
                                                "text": "Trêve de balivernes."
                                            },
                                            {
                                                "example_id": "36cfb392-b2bd-4b5d-a29e-f5c81b3c13b9",
                                                "sense_id": "b26f5e7b-d630-3b51-85da-e0b50efe086b",
                                                "text": "Trêve du passé, revenons à notre saison estivale."
                                            },
                                            {
                                                "example_id": "2e0099c0-f75e-4c58-9f84-a0710136b178",
                                                "sense_id": "b26f5e7b-d630-3b51-85da-e0b50efe086b",
                                                "text": "– Bon, trêve de bavardages. On passe à l’action. Après tout, ce bled n’est qu’un nid infesté d’ennemis, ni plus ni moins."
                                            },
                                            {
                                                "example_id": "ee88e0b2-8823-4dc5-bce0-c7b8d74817e6",
                                                "sense_id": "b26f5e7b-d630-3b51-85da-e0b50efe086b",
                                                "text": "Trêve de cérémonie."
                                            },
                                            {
                                                "example_id": "b8d9fe91-72a8-444f-817b-87cc35b88ac7",
                                                "sense_id": "b26f5e7b-d630-3b51-85da-e0b50efe086b",
                                                "text": "trêve de compliments."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
