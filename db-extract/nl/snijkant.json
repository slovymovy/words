                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "edge",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e28ad263-b756-39bb-b070-0c1cc4fbad40",
                                        "entry_id": "5fd51baa-7179-371b-ab36-ed6c93d64827",
                                        "glosses": [
                                            "The boundary line of a surface."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8f8d37ef-4e41-34ad-afa9-68ba2dce724b",
                                        "entry_id": "5fd51baa-7179-371b-ab36-ed6c93d64827",
                                        "glosses": [
                                            "A one-dimensional face of a polytope. In particular, the joining line between two vertices of a polygon; the place where two faces of a polyhedron meet."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "493c2fed-84e1-322b-9035-90663b76d61e",
                                        "entry_id": "5fd51baa-7179-371b-ab36-ed6c93d64827",
                                        "glosses": [
                                            "An advantage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83a805c0-5950-4ed8-b22b-abe503965bfd",
                                                "sense_id": "493c2fed-84e1-322b-9035-90663b76d61e",
                                                "text": "I have the edge on him."
                                            },
                                            {
                                                "example_id": "270c236d-aeeb-40d1-8d9a-42a80eca6db2",
                                                "sense_id": "493c2fed-84e1-322b-9035-90663b76d61e",
                                                "text": "It’s no secret that the United States may be losing its edge in civilian aviation. Nowhere is this more apparent than with small unmanned aircraft, those tiny flying robots that promise to transform agriculture, forestry, pipeline monitoring, filmmaking, and more."
                                            },
                                            {
                                                "example_id": "6b4a408d-fab0-45b5-840a-a3ca5caea137",
                                                "sense_id": "493c2fed-84e1-322b-9035-90663b76d61e",
                                                "text": "Thitinan said Yingluck's decision to skip the verdict hearing will have \"emboldened\" the military government. \"They would not have wanted to put her in jail, in this scenario, (but her not showing up today) puts her on the back foot and gives them an edge.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "16ec9a5b-1d56-3323-875b-71ea1081f772",
                                        "entry_id": "5fd51baa-7179-371b-ab36-ed6c93d64827",
                                        "glosses": [
                                            "The thin cutting side of the blade of an instrument, such as an ax, knife, sword, or scythe; that which cuts as an edge does, or wounds deeply, etc."
                                        ],
                                        "tags": [
                                            "also",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ada424b-eab1-4f1f-84bd-f3e8ab35c41a",
                                                "sense_id": "16ec9a5b-1d56-3323-875b-71ea1081f772",
                                                "text": "No, 'tis slander; / Whose edge is sharper than the sword;"
                                            },
                                            {
                                                "example_id": "99a4f65a-d2d7-4297-a7cc-15ea00d3b2b4",
                                                "sense_id": "16ec9a5b-1d56-3323-875b-71ea1081f772",
                                                "text": "And to the angel of the church in Pergamos write; These things saith he which hath the sharp sword with two edges:"
                                            },
                                            {
                                                "example_id": "9c272f32-ee01-4402-bac7-67dc9cb70ee6",
                                                "sense_id": "16ec9a5b-1d56-3323-875b-71ea1081f772",
                                                "text": "Unlike a lot of the south of France, which, he said, “can be expensive, and a little too overdone and chi-chi for my tastes”, Marseille “has just the right amount of edge while being surrounded by incredibly stunning landscapes[…].”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af13b3f3-47c7-3e43-8d6c-b2f1f17de08a",
                                        "entry_id": "5fd51baa-7179-371b-ab36-ed6c93d64827",
                                        "glosses": [
                                            "A sharp terminating border; a margin; a brink; an extreme verge."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3960a7d-fff1-4315-8fc6-473e460ec410",
                                                "sense_id": "af13b3f3-47c7-3e43-8d6c-b2f1f17de08a",
                                                "text": "The cup is right on the edge of the table."
                                            },
                                            {
                                                "example_id": "1dce0591-82dc-49ff-ab92-cc9b846c3f85",
                                                "sense_id": "af13b3f3-47c7-3e43-8d6c-b2f1f17de08a",
                                                "text": "He is standing on the edge of a precipice."
                                            },
                                            {
                                                "example_id": "7ac4ef71-97a3-4912-9898-4324a95ce5c3",
                                                "sense_id": "af13b3f3-47c7-3e43-8d6c-b2f1f17de08a",
                                                "text": "Here by, upon the edge of yonder coppice; / A stand, where you may make the fairest shoot."
                                            },
                                            {
                                                "example_id": "4254b7d3-c623-43df-a4c4-33b7d6f8bdb3",
                                                "sense_id": "af13b3f3-47c7-3e43-8d6c-b2f1f17de08a",
                                                "text": "In worst extremes, and on the perilous edge / Of battle when it rag'd, in all assaults"
                                            },
                                            {
                                                "example_id": "9034dfd2-b98b-4fca-9b78-df8749924ce6",
                                                "sense_id": "af13b3f3-47c7-3e43-8d6c-b2f1f17de08a",
                                                "text": "they never wanted the pretext, and seldom the will, to harass and pursue, even to the very edge of destruction, any of their less powerful neighbours"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a701dbca-f572-3f9d-afb4-3e6cc629ad7c",
                                        "entry_id": "5fd51baa-7179-371b-ab36-ed6c93d64827",
                                        "glosses": [
                                            "Sharpness; readiness or fitness to cut; keenness; intenseness of desire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0fa253b6-d439-471a-9702-3ac61cb7ca48",
                                                "sense_id": "a701dbca-f572-3f9d-afb4-3e6cc629ad7c",
                                                "text": "Death and persecution lose all the ill that they can have, if we do not set an edge upon them by our fears and by our vices."
                                            },
                                            {
                                                "example_id": "4f8d2785-8c4e-4e70-979d-b792a5dfaaba",
                                                "sense_id": "a701dbca-f572-3f9d-afb4-3e6cc629ad7c",
                                                "text": "we are to turn the full edge of our indignation upon the accursed instrument, which had so well nigh occasioned his utter falling away."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4eb32933-304e-3802-a511-c09381c67440",
                                        "entry_id": "5fd51baa-7179-371b-ab36-ed6c93d64827",
                                        "glosses": [
                                            "The border or part adjacent to the line of division; the beginning or early part (of a period of time)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e710f71-b0a6-44db-a2c1-20652df239c5",
                                                "sense_id": "4eb32933-304e-3802-a511-c09381c67440",
                                                "text": "in the edge of evening"
                                            },
                                            {
                                                "example_id": "ad2bb584-1152-47a9-a520-1bdde5387b12",
                                                "sense_id": "4eb32933-304e-3802-a511-c09381c67440",
                                                "text": "supposing that the new general, unacquainted with his army, and on the edge of winter, would not hastily oppose them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f4476147-7301-3141-87b4-f54dcd7da91f",
                                        "entry_id": "5fd51baa-7179-371b-ab36-ed6c93d64827",
                                        "glosses": [
                                            "A shot where the ball comes off the edge of the bat, often unintentionally."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46fd06f1-a04b-41d9-af72-e46828b33e78",
                                                "sense_id": "f4476147-7301-3141-87b4-f54dcd7da91f",
                                                "text": "2004 March 29, R. Bharat Rao Short report: Ind-Pak T1D2 Session 1 in rec.sports.cricket, Usenet\nFinally another edge for 4, this time dropped by the keeper"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "13724819-3566-3acc-9e6f-2ea7e50868bb",
                                        "entry_id": "5fd51baa-7179-371b-ab36-ed6c93d64827",
                                        "glosses": [
                                            "A connected pair of vertices in a graph."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6f6232bf-fc14-39a2-bd9b-6651168f9e56",
                                        "entry_id": "5fd51baa-7179-371b-ab36-ed6c93d64827",
                                        "glosses": [
                                            "A level of sexual arousal that is maintained just short of reaching the point of inevitability, or climax."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "63faad9b-b8fa-31c4-9af8-0c99064b10a8",
                                        "entry_id": "5fd51baa-7179-371b-ab36-ed6c93d64827",
                                        "glosses": [
                                            "The point of data production in an organization (the focus of edge computing), as opposed to the cloud."
                                        ],
                                        "tags": [
                                            "attributive",
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "01fe5999-5d75-4bd1-b9b5-085a786e4ca1",
                                                "sense_id": "63faad9b-b8fa-31c4-9af8-0c99064b10a8",
                                                "text": "Remember that edge computing refers to data that is processed on edge devices before the result goes to its destination, which could be on a public or private cloud."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "edge",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d55814ab-a57c-3b8b-bdea-241b540ef26a",
                                        "entry_id": "3bc69d2f-b912-3632-9330-9c43a5affe13",
                                        "glosses": [
                                            "To move an object slowly and carefully in a particular direction."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1adcafa8-511a-45ed-a354-929691f43c97",
                                                "sense_id": "d55814ab-a57c-3b8b-bdea-241b540ef26a",
                                                "text": "He edged the book across the table."
                                            },
                                            {
                                                "example_id": "09f9ec00-4830-4a4c-a135-8412bb14ba55",
                                                "sense_id": "d55814ab-a57c-3b8b-bdea-241b540ef26a",
                                                "text": "The muggers edged her into an alley and demanded money."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7f77ca72-badf-37de-9e29-734fc21b5687",
                                        "entry_id": "3bc69d2f-b912-3632-9330-9c43a5affe13",
                                        "glosses": [
                                            "To move slowly and carefully in a particular direction."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5083b828-6f23-4869-a3c5-ed25076c4b3e",
                                                "sense_id": "7f77ca72-badf-37de-9e29-734fc21b5687",
                                                "text": "He edged away from her."
                                            },
                                            {
                                                "example_id": "4e010086-4cca-4888-b830-a6a3240c6285",
                                                "sense_id": "7f77ca72-badf-37de-9e29-734fc21b5687",
                                                "text": "Carroll has been edging slowly towards full fitness after his expensive arrival from Newcastle United and his partnership with £23m Luis Suarez showed rich promise as Liverpool controlled affairs from start to finish."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "806931b3-bfe4-3137-bfde-3e29640c98b3",
                                        "entry_id": "3bc69d2f-b912-3632-9330-9c43a5affe13",
                                        "glosses": [
                                            "To win by a small margin."
                                        ],
                                        "tags": [],
                                        "examples": []
