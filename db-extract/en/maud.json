                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac42c84d-f03d-4228-b071-a3b080ea4768",
                                                "sense_id": "2369ab75-3aaf-3958-aaab-095ecb70e5de",
                                                "text": "Maud au lit était une nymphe fantasque, une fée ravissante ; il n’a jamais débrouillé l’écheveau compliqué des rapports entre elle et Rolf."
                                            },
                                            {
                                                "example_id": "50092fdc-b6e5-4ac5-b490-d401331f595d",
                                                "sense_id": "2369ab75-3aaf-3958-aaab-095ecb70e5de",
                                                "text": "Maud Guilbeau, Aytrésienne depuis cinq ans, n’a pas raté une seule édition des Francofolies."
                                            },
                                            {
                                                "example_id": "8beb5582-7e34-4edd-9c43-49db35d7d999",
                                                "sense_id": "2369ab75-3aaf-3958-aaab-095ecb70e5de",
                                                "text": "Maud Berroneau et son collègue Xavier Gautron, service civique déjà bien rodé à l’herpétologie, la libèrent de cette prison provisoire."
                                            },
                                            {
                                                "example_id": "577487d5-6037-462d-8145-d84d0d0ab1d9",
                                                "sense_id": "2369ab75-3aaf-3958-aaab-095ecb70e5de",
                                                "text": "Le cancer, un vrai « phénomène de société » ? À regarder les chiffres en face, les mots de Maud Gouy, co-commissaire de l’exposition « Cancers », jusqu’au 8 août 2023 à la Cité des sciences, ne sont pas exagérés."
                                            }
                                        ]
                                    }
                                ]
