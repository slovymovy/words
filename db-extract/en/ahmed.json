                                    {
                                        "sense_id": "b19ad5d2-cee6-3383-b5cc-4c0008bc5a9f",
                                        "entry_id": "275abe7b-4b61-3440-999c-a79fd8dd18d4",
                                        "glosses": [
                                            "Prénom masculin arabe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28d9516f-b280-46e5-844d-dfb47131a500",
                                                "sense_id": "b19ad5d2-cee6-3383-b5cc-4c0008bc5a9f",
                                                "text": "Un faux maillot PSG de l’époque Canal+ sur les épaules, Ahmed se balade avec un ami vêtu d’une dishdasha, un habit traditionnel de la péninsule Arabique."
                                            },
                                            {
                                                "example_id": "8665db1b-e3fb-49d5-b23e-3ad1655c4fb4",
                                                "sense_id": "b19ad5d2-cee6-3383-b5cc-4c0008bc5a9f",
                                                "text": "Toute l’équipe a adoré le projet, explique Victor Guyot, l’un des cinq membres de l’équipe gagnante, qui se compose de Mikaël Vallenet, d’Ahmed Abouelleil-Sayed, de Maxime Prémont et de Nolann Sabre."
                                            },
                                            {
                                                "example_id": "b3ead3fd-90f6-494c-bbe2-78160542d872",
                                                "sense_id": "b19ad5d2-cee6-3383-b5cc-4c0008bc5a9f",
                                                "text": "Il y a, tout d’abord, Notre tout petit petit mariage avec Ahmed Sylla, puis Chasse gardée avec Olivier Bourdon, Thierry Lhermitte et Hakim Jemili."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Ahmed",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "034fd826-c661-33c5-86a5-31e20e72fdb9",
                                        "entry_id": "d18f0a8c-cb7b-3015-a841-b373ba4685f2",
                                        "glosses": [
                                            "Nom de famille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee513d11-325e-4b88-82e2-8833a180cd51",
                                                "sense_id": "034fd826-c661-33c5-86a5-31e20e72fdb9",
                                                "text": "Allison Williams et Riz Ahmed ont annoncé, mardi, les nommés aux Oscars 2023."
                                            },
                                            {
                                                "example_id": "68a9e0a2-918c-47fd-8154-1228b632efae",
                                                "sense_id": "034fd826-c661-33c5-86a5-31e20e72fdb9",
                                                "text": "Dos à dos à la pause avec des essais d’Arnaud Erbinartegaray (24e) et Stéphane Ahmed (40e+1), les Basques ont fait la différence en seconde mi-temps, proftant d’un carton jaune de Baptiste Pesenti."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
