                "forms": [],
                "senses": [
                    {
                        "sense_id": "151bdd6e-fa5e-38ba-9c4f-c1c0bd7ffacd",
                        "entry_id": "c86a402d-d4ef-31e7-9e71-ce4e6d050923",
                        "glosses": [
                            "Antinomie, Unvereinbarkeit mit oder von Gesetzen, Widerstreit der Gesetze (Kant), Paradoxie"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7b810cea-0ab9-4868-8f0b-020c32947bac",
                        "source_entry_id": "c86a402d-d4ef-31e7-9e71-ce4e6d050923",
                        "source_sense_id": "151bdd6e-fa5e-38ba-9c4f-c1c0bd7ffacd",
                        "source_sense_description": "Antinomie, Unvereinbarkeit mit oder von Gesetzen, Paradoxie",
                        "target_lang_word": "Antinomie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Antinomie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "82f399ac-db16-3033-8313-381ccc81fbd5",
                                        "entry_id": "4c613ae8-858d-3daf-8165-e6ea3a19e6f6",
                                        "glosses": [
                                            "unlösbare Gegensätzlichkeit einer logischen Aussage"
                                        ],
                                        "tags": [
                                            "Dialektik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "349a0293-41f0-474c-b163-0749b5598546",
                                                "sense_id": "82f399ac-db16-3033-8313-381ccc81fbd5",
                                                "text": "„Wenn von einer Antinomie oder einem antinomischen Verhältnis die Rede ist, dann meint man normalerweise einen Gegensatz, einen Widerspruch. Es hat sich eingebürgert, unter Antinomie eine Antithese zu verstehen, bzw. ein Verhältnis von zwei Dingen, die einander ausschließen.“"
                                            },
                                            {
                                                "example_id": "110bdf55-8671-4417-86f6-2ef52d088465",
                                                "sense_id": "82f399ac-db16-3033-8313-381ccc81fbd5",
                                                "text": "„Die Übertragung des vorgestellten Problemkreises auf klassische Paradoxien, wie sie bereits in der Antike bekannt waren, liegt auf der Hand. Als Beispiel sei die Antinomie des Barbiers angeführt.“"
                                            },
                                            {
                                                "example_id": "4961b2b2-18c4-46b2-891d-3af61301a8de",
                                                "sense_id": "82f399ac-db16-3033-8313-381ccc81fbd5",
                                                "text": "„Der Begriff der Antinomie läßt sich bis zu Plutarch und Quintilian zurückverfolgen, hat aber erst bei Kant seine philosophisch relevante Ausprägung gewonnen.“"
                                            },
                                            {
                                                "example_id": "3dfb75c7-017c-4cc2-9e55-35dc60894e8f",
                                                "sense_id": "82f399ac-db16-3033-8313-381ccc81fbd5",
                                                "text": "„Der anspruchsvolle Grenzgänger am Scheideweg von Leben und Tod lebt in krassen Antinomien, die dem Durchschnittsbürger sein Verständnis erschweren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bef016b6-bdd6-4652-b23a-9e805ed25199",
                        "source_entry_id": "c86a402d-d4ef-31e7-9e71-ce4e6d050923",
