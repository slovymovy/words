                ],
                "senses": [
                    {
                        "sense_id": "3de0a091-7e4b-3820-aef0-3133c4b47c1b",
                        "entry_id": "cc159313-c498-3cf1-8346-e4582e46df9c",
                        "glosses": [
                            "Communiquer par Skype."
                        ],
                        "tags": [
                            "neologism"
                        ],
                        "examples": [
                            {
                                "example_id": "c7b694d1-96f8-45a8-9a8f-4238ba344fc7",
                                "sense_id": "3de0a091-7e4b-3820-aef0-3133c4b47c1b",
                                "text": "Nous skypons une fois par week-end, et échangeons des mails de temps à autre."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b26fa0db-c897-4b82-ada3-ebd3938961db",
                        "source_entry_id": "cc159313-c498-3cf1-8346-e4582e46df9c",
                        "source_sense_id": "3de0a091-7e4b-3820-aef0-3133c4b47c1b",
                        "target_lang_word": "skypen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "skypen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ecc7ceba-ae8d-3d15-9332-5a0b0f9f00ec",
                                        "entry_id": "88f16aef-d212-3ab6-b527-0205974ee306",
                                        "glosses": [
                                            "mit der Software Skype über das Internet telefonieren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f76c853-c051-47f9-a907-3b644cf0c33b",
                                                "sense_id": "ecc7ceba-ae8d-3d15-9332-5a0b0f9f00ec",
                                                "text": "Als mein Freund im Ausland war, haben wir fast jeden Tag geskypt."
                                            },
                                            {
                                                "example_id": "9dd6b0e4-9204-43a3-af25-c7dbe4e372b7",
                                                "sense_id": "ecc7ceba-ae8d-3d15-9332-5a0b0f9f00ec",
                                                "text": "„Manche Internetfirmen schreiben Sprachgeschichte: Wer googelt, der sucht. Twittern heißt, eine Kurznachricht an jedermann zu senden. Und skypen bedeutet für Millionen von Menschen, kostenlose Gespräche über den Computer statt über das Festnetztelefon zu führen.“"
                                            },
                                            {
                                                "example_id": "79ce08d8-e13c-4c61-a7ec-3035102fc47b",
                                                "sense_id": "ecc7ceba-ae8d-3d15-9332-5a0b0f9f00ec",
                                                "text": "„Ständig klingelte es bei einem der Syrer in der Tasche, und er skypte mit der Heimat.“"
                                            },
                                            {
                                                "example_id": "da60677a-8713-4407-8c57-1215b428370e",
                                                "sense_id": "ecc7ceba-ae8d-3d15-9332-5a0b0f9f00ec",
                                                "text": "„Heute Morgen hat Steinsiek mit einem Bekannten geskypt, der in Venedig festsitzt.“"
                                            },
                                            {
                                                "example_id": "2bce9266-b4c4-4e20-ae26-c2e8c8fa4f8d",
                                                "sense_id": "ecc7ceba-ae8d-3d15-9332-5a0b0f9f00ec",
                                                "text": "„Wenn Kristina in Deutschland ist, skypt sie mehrmals die Woche mit ihrer Enkelin.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3f335ce5-173b-4b85-966d-35747cb8dea2",
                        "source_entry_id": "cc159313-c498-3cf1-8346-e4582e46df9c",
                        "source_sense_id": "3de0a091-7e4b-3820-aef0-3133c4b47c1b",
                        "target_lang_word": "skype",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "skype",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "47d534a0-d2e9-3c69-9352-0911c49cf461",
                                        "entry_id": "45d4c9f5-a7ba-30f6-9dcb-b8dcd3932ec9",
                                        "glosses": [
                                            "To make (a telephone call) using Skype software."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d572b49c-a6f0-3c56-8d0c-09767da63445",
                                        "entry_id": "45d4c9f5-a7ba-30f6-9dcb-b8dcd3932ec9",
                                        "glosses": [
                                            "To send (a message or file) with Skype."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5e820b45-15a0-3ce9-bf00-bc91d3522a80",
                                        "entry_id": "45d4c9f5-a7ba-30f6-9dcb-b8dcd3932ec9",
                                        "glosses": [
                                            "To contact (a person) via Skype."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "58562cf5-0145-4722-b7d8-ee6415909291",
                                                "sense_id": "5e820b45-15a0-3ce9-bf00-bc91d3522a80",
                                                "text": "I'll skype you tomorrow. We can skype for a couple of hours."
                                            },
                                            {
                                                "example_id": "c0d1da53-05f2-4cb6-b178-c0fd064eb641",
                                                "sense_id": "5e820b45-15a0-3ce9-bf00-bc91d3522a80",
                                                "text": "While spatial mobility does cause discontinuity in social relationships and result in losing the support system from their home country (Rangaswamy 2000), yet the social ties of our participants have not dissolved as they have been able to maintain supportive networks in India through physical visits, e-mails, ‘skypeing’ to contacts in foreign places."
                                            },
                                            {
                                                "example_id": "43b4e8c8-98ab-4fba-a8cd-3a5f53053c73",
                                                "sense_id": "5e820b45-15a0-3ce9-bf00-bc91d3522a80",
                                                "text": "‘Where’s 007? He invited too?’ ‘He’s skypeing his mum. He’ll meet us down there.’"
                                            },
                                            {
                                                "example_id": "0f209117-225e-485c-b1de-691f9ad935b6",
                                                "sense_id": "5e820b45-15a0-3ce9-bf00-bc91d3522a80",
                                                "text": "And so Andy went home, still on a caffeine high, feeling excited about life as a graduate student, and instead of skypeing with Anja or going for a beer, he went online and read up on some of the relevant particle physics."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
