                    {
                        "sense_id": "e7c70beb-f44f-38c6-91d7-4d2af249c195",
                        "entry_id": "717fe2ec-530d-3f85-b165-5fe90a7642d0",
                        "glosses": [
                            "A type of bowed spike fiddle having two strings, originating in China as part of the huqin family of string instruments."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00e9fd05-4126-4412-82c0-3c56caae3e50",
                                "sense_id": "e7c70beb-f44f-38c6-91d7-4d2af249c195",
                                "text": "A rugged, handsome woman who can plant five fields in the time it takes others to plant one, Lu reveals her inner self by playing sweet music on the ehru ^([sic]) in a deserted factory site."
                            },
                            {
                                "example_id": "e2e188a0-5fb4-4573-8ed2-30dcce12673c",
                                "sense_id": "e7c70beb-f44f-38c6-91d7-4d2af249c195",
                                "text": "Searches on Craigslist turned up no ads for erhus, wanted or offered, though there was a posting for an instrument found on the Lower East Side (the owner must identify the instrument)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "341c22a8-764b-485c-b96f-bedfe9b19906",
                        "source_entry_id": "717fe2ec-530d-3f85-b165-5fe90a7642d0",
                        "source_sense_id": "e7c70beb-f44f-38c6-91d7-4d2af249c195",
                        "source_sense_description": "Chinese fiddle",
                        "target_lang_word": "erhu",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "erhu",
