                },
                {
                    "sense_id": "6bcd4012-bf7a-3570-bb7d-f7a7ef16d6a8",
                    "sense_definition": "A notebook or personal collection in which quotations, poems, and ideas are recorded.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "notebook",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The poet carefully transcribed her favorite verses into a leather-bound <w>commonplace</w>.",
