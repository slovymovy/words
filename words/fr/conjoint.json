                    "semantic_group_id": "partenaire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mon <w>conjoint</w> et moi avons décidé d'acheter un appartement ensemble."
                        },
                        {
                            "text": "Elle a accompagné son <w>conjoint</w> à une réception professionnelle hier soir."
                        }
                    ],
                    "synonyms": [
                        "époux",
                        "partenaire",
                        "concubin"
                    ],
                    "common_phrases": [
                        "conjoint survivant",
                        "conjoint de fait"
