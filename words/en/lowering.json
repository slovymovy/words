    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "10d686b2-f512-35de-a640-65d63eaf9c9a",
                    "sense_definition": "Present participle of <w>lower</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "action_reduce",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The shop is <w>lowering</w> its prices for the summer sale.",
                            "target_lang_translations": {
                                "ru": "Магазин <w>снижает</w> цены к летней распродаже.",
                                "nl": "De winkel is de prijzen aan het <w>verlagen</w> voor de zomeruitverkoop."
                            }
                        },
                        {
                            "text": "He is carefully <w>lowering</w> the heavy box onto the floor.",
                            "target_lang_translations": {
                                "ru": "Он осторожно <w>опускает</w> тяжелую коробку на пол.",
                                "nl": "Hij is voorzichtig de zware doos aan het <w>neerlaten</w> op de vloer."
                            }
                        }
                    ],
                    "common_phrases": [
                        "lowering the price",
                        "lowering the volume",
                        "lowering the risk"
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени от глагола lower (опускать, снижать), обозначающее действие в процессе.",
                        "nl": "Tegenwoordig deelwoord van 'lower' (verlagen, neerlaten), dat een actie in uitvoering aangeeft."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "снижающий",
                                "target_lang_sense_clarification": "уменьшающий количество или уровень"
                            },
                            {
                                "target_lang_word": "опускающий",
                                "target_lang_sense_clarification": "перемещающий вниз"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "verlagend",
                                "target_lang_sense_clarification": "het verminderen van een niveau of prijs"
                            },
                            {
                                "target_lang_word": "neerlatend",
                                "target_lang_sense_clarification": "het fysiek naar beneden brengen van een object"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8eb8f2b7-2032-339a-8f07-5b8dfff53068",
                    "sense_definition": "The act or process of moving something down or reducing the amount, level, or intensity of something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "action_reduce",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>lowering</w> of the flag at sunset is a traditional ceremony.",
                            "target_lang_translations": {
                                "ru": "<w>Спуск</w> флага на закате — это традиционная церемония.",
                                "nl": "Het <w>neerhalen</w> van de vlag bij zonsondergang is een traditionele ceremonie."
                            }
                        },
                        {
                            "text": "Doctors recommended a <w>lowering</w> of his daily salt intake.",
                            "target_lang_translations": {
                                "ru": "Врачи рекомендовали <w>снижение</w> его суточного потребления соли.",
                                "nl": "Artsen adviseerden een <w>verlaging</w> van zijn dagelijkse zoutinname."
                            }
