                "senses": [
                    {
                        "sense_id": "0bb39658-e082-3286-a0cd-952ecf463385",
                        "entry_id": "89801157-6057-392b-a5b0-f28bd13dd4dd",
                        "glosses": [
                            "Qui sert à conserver, à ne pas laisser altérer."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "b126ee88-c2c1-3c00-98e5-adc8425fca5f",
                        "entry_id": "89801157-6057-392b-a5b0-f28bd13dd4dd",
                        "glosses": [
                            "Qui permet de couvrir un domaine plus étendu que le strict nécessaire."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "2a3f3170-ab61-3ac8-986f-fe035d74e746",
                        "entry_id": "89801157-6057-392b-a5b0-f28bd13dd4dd",
                        "glosses": [
                            "Qualifie un champ de vecteurs dont la circulation sur tout contour fermé est nulle."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "e6e2038c-90b2-34ff-90db-252912239c5c",
                        "entry_id": "89801157-6057-392b-a5b0-f28bd13dd4dd",
                        "glosses": [
                            "Se dit d’un procédé de calcul ou d’une démarche fondés sur des hypothèses qui majorent les effets des phénomènes pouvant altérer les performances d’un matériau, d’un équipement ou d’une installation et affecter la sûreté nucléaire ou la radioprotection."
                        ],
                        "tags": [
                            "Sécurité nucléaire"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "46113769-ee7b-47a0-8512-bdd3ec5582b0",
                        "source_entry_id": "89801157-6057-392b-a5b0-f28bd13dd4dd",
                        "source_sense_id": "0bb39658-e082-3286-a0cd-952ecf463385",
                        "target_lang_word": "conservative",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "conservative",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "27263316-065e-36bc-bb88-7d4b3e0feecd",
                                        "entry_id": "02f869b6-a2f4-30af-b08e-4cd45305dc97",
                                        "glosses": [
                                            "A person who favors maintenance of the status quo."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f08f2b7e-59b3-4ea6-8b41-6458abbb3b05",
                                                "sense_id": "27263316-065e-36bc-bb88-7d4b3e0feecd",
                                                "text": "During the late 1950s and throughout the 1960s, this commitment brought him into frequent critical confrontation with entrenched forms of conservative thinking (in academic areas from history and social science to the more abstract domains of ethical and political philosophy),[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69b9f94a-b0a7-36d7-827c-5629bb3d30f1",
                                        "entry_id": "02f869b6-a2f4-30af-b08e-4cd45305dc97",
                                        "glosses": [
                                            "One who seeks to promote or preserve traditional values or institutions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3f81456-a50e-468e-886d-f6a7f0ad491d",
                                                "sense_id": "69b9f94a-b0a7-36d7-827c-5629bb3d30f1",
                                                "text": "If there’s a down side to the film, it’s that “Soros” probably doesn’t devote enough time to the way its subject has become a favorite bogeyman to conservatives that paint him as the guiding hand behind grassroots campaigns by those intent on discrediting them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c89215eb-6ff5-3d5f-af2c-f8088b499973",
                                        "entry_id": "02f869b6-a2f4-30af-b08e-4cd45305dc97",
                                        "glosses": [
                                            "One who seeks to promote traditions in a particular domain (e.g. a fiscal conservative or a social conservative)."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US",
                                            "especially"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "conservative",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5dc15c5e-0a67-30f4-b29b-9105d003cfb8",
                                        "entry_id": "3d34e25c-363e-3b6d-bf96-c1d0b8a77d30",
                                        "glosses": [
                                            "Cautious, moderate."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb99a160-1783-49d5-8121-fdca02c53f11",
                                                "sense_id": "5dc15c5e-0a67-30f4-b29b-9105d003cfb8",
                                                "text": "The chef added a conservative amount of salt to the dish."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a345c6d8-031f-3d83-a82f-c1833ef33862",
                                        "entry_id": "3d34e25c-363e-3b6d-bf96-c1d0b8a77d30",
                                        "glosses": [
                                            "Tending to resist change or innovation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01e038e7-2e3d-4b0b-ae85-fe328a16e9e5",
                                                "sense_id": "a345c6d8-031f-3d83-a82f-c1833ef33862",
                                                "text": "The curriculum committee at this university is extremely conservative."
                                            },
                                            {
                                                "example_id": "6d5961e4-7ad4-488c-b4ea-c2acea2e2074",
                                                "sense_id": "a345c6d8-031f-3d83-a82f-c1833ef33862",
                                                "text": "In spite of the vague evidence, I think that we may conclude that ME ǭ, like ME ę̄, had two pronunciations during the sixteenth and seventeenth centuries, a more advanced pronunciation with close [oː], and a more conservative one with the ‘intermediate vowel’ [ɔː] […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "caacead7-db54-37b9-8add-8dd3698f432a",
                                        "entry_id": "3d34e25c-363e-3b6d-bf96-c1d0b8a77d30",
                                        "glosses": [
                                            "Based on pessimistic assumptions, and on the low side."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b173b804-f649-4675-80a0-031f113b3f21",
                                                "sense_id": "caacead7-db54-37b9-8add-8dd3698f432a",
                                                "text": "At a conservative estimate, growth may even be negative next year."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b57b316c-e0aa-36a4-9c1e-44e5becfba32",
                                        "entry_id": "3d34e25c-363e-3b6d-bf96-c1d0b8a77d30",
                                        "glosses": [
                                            "Supporting some combination of fiscal, political or social conservatism."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6a5b8392-67d4-4614-bfb1-db6094a71cfb",
                                                "sense_id": "b57b316c-e0aa-36a4-9c1e-44e5becfba32",
                                                "text": "Newspapers in \"capitalist\" ownership, universities presided over by \"reactionary\" governing bodies, broadcasting systems owned by conservative governments have all been known to influence public opinion in the direction of socialism, because this was the conviction of the personnel."
                                            },
                                            {
                                                "example_id": "75e5a51f-b7b7-4cab-b81c-b4623b4461dd",
                                                "sense_id": "b57b316c-e0aa-36a4-9c1e-44e5becfba32",
                                                "text": "George Soros remains a favorite target of conservative conspiracy theorists, seeing his corrupting influence behind every liberal movement and within every nook and cranny."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e6fdecc0-ef09-342b-9637-27efb7abfa70",
                                        "entry_id": "3d34e25c-363e-3b6d-bf96-c1d0b8a77d30",
                                        "glosses": [
                                            "Relating to the Conservative Party."
                                        ],
                                        "tags": [
                                            "British"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b977a985-57bc-4fb4-97ae-93e739ea14ea",
                                                "sense_id": "e6fdecc0-ef09-342b-9637-27efb7abfa70",
                                                "text": "We have always been conscientiously attached to what is called the Tory, and which might with more propriety be called the Conservative, party."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4c83bbcf-2913-3262-8873-cf7b656c5676",
                                        "entry_id": "3d34e25c-363e-3b6d-bf96-c1d0b8a77d30",
                                        "glosses": [
                                            "Neither creating nor destroying a given quantity."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "96e3176d-ac43-3548-93f1-e75fc12a6344",
                                        "entry_id": "3d34e25c-363e-3b6d-bf96-c1d0b8a77d30",
                                        "glosses": [
                                            "Having power to preserve in a safe or entire state, or from loss, waste, or injury; preservative."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4509fd95-ed2d-4514-a679-9c99bf08b465",
                                                "sense_id": "96e3176d-ac43-3548-93f1-e75fc12a6344",
                                                "text": "Without the conservative organs, the body would receive no nourishment; and without nourishment, it would soon decay and perish."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "714973ea-664b-3f35-96dd-0c848a155ea5",
                                        "entry_id": "3d34e25c-363e-3b6d-bf96-c1d0b8a77d30",
                                        "glosses": [
                                            "Relating to Conservative Judaism."
                                        ],
                                        "tags": [
                                            "Judaism"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f71500eb-0570-3760-ab6e-c678bede5f49",
                                        "entry_id": "3d34e25c-363e-3b6d-bf96-c1d0b8a77d30",
                                        "glosses": [
                                            "Conventional, traditional, and moderate in style and appearance; not extreme, excessive, faddish, or intense."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3a2a1e8d-66bc-358e-a4b4-6303cb1c9651",
                                        "entry_id": "3d34e25c-363e-3b6d-bf96-c1d0b8a77d30",
                                        "glosses": [
                                            "Not including any operation or intervention (said of a treatment, see conservative treatment)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9900a770-b5d8-4fc3-ad51-d811b748f5b3",
                                                "sense_id": "3a2a1e8d-66bc-358e-a4b4-6303cb1c9651",
                                                "text": "Operative treatment should be reserved for those patients in whom conservative treatment has failed and who are motivated with regard to sports."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "13639235-0569-3f4f-a5cb-80d6ad50ed04",
                                        "entry_id": "3d34e25c-363e-3b6d-bf96-c1d0b8a77d30",
                                        "glosses": [
                                            "Having few changes relative to an older form, especially in comparison to related varieties."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81065367-71e1-466a-bf4d-8519a76a0691",
                                                "sense_id": "13639235-0569-3f4f-a5cb-80d6ad50ed04",
                                                "text": "While innovative in its verbal system, Sardinian is the most conservative Romance language in its vocabulary and phonology."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f3c69f5-04a9-3fc4-a2e1-eb080884c03d",
                                        "entry_id": "3d34e25c-363e-3b6d-bf96-c1d0b8a77d30",
                                        "glosses": [
                                            "That is the gradient of a function."
                                        ],
                                        "tags": [
                                            "of field"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
