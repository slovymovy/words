                                        "sense_id": "c67c8cb5-4432-3b70-a8df-6d925bfc3155",
                                        "entry_id": "0d4f5624-bf27-3fba-8c6d-0341bbe6c205",
                                        "glosses": [
                                            "een geestelijke stroming die het zich uit de drukke wereld terugtrekken in stilte predikt"
