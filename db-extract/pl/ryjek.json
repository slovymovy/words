                        ],
                        "examples": [
                            {
                                "example_id": "4b104a5e-78d5-4cc7-961f-c7bcca8abd68",
                                "sense_id": "56f7dccb-9851-3828-a6b4-4743854edc14",
                                "text": "W chlewiku mieszka świnka / i trąca ryjkiem drzwi. / Gdy niosą jej jedzenie / to ona: kwi, kwi, kwi!"
                            }
                        ],
