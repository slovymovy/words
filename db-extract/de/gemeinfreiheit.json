                        "glosses": [
                            "Freiheit von jeglichem Urheberrecht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e54c723-ad6f-496a-aee7-5a64c0055afc",
                                "sense_id": "b63b3f93-dc3e-3266-aec6-c1e00004f222",
                                "text": "Die Gemeinfreiheit ist in verschiedenen Ländern unterschiedlich geregelt."
