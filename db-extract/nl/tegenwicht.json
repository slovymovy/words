                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "45feaea6-3f4c-36b0-a080-486b73898085",
                                        "entry_id": "fa2eabe8-443c-3eab-99d3-1969d3094438",
                                        "glosses": [
                                            "A weight sufficient to balance another, for example in the opposite end of scales; an equal weight."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3a5b3b26-b1dd-30da-9c2e-9d014351873c",
                                        "entry_id": "fa2eabe8-443c-3eab-99d3-1969d3094438",
                                        "glosses": [
                                            "An effect of equal power or force acting in opposition; a force sufficient to balance another force or influence"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96fa6e16-8b2f-4f12-beab-4b145cdadf4c",
                                                "sense_id": "3a5b3b26-b1dd-30da-9c2e-9d014351873c",
                                                "text": "This necessary counterpoise, the affectionate and simple-minded will readily conceive, would arise to Louisa from the absence of those \"dear familiar faces\" which had hitherto constituted her world."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fd0b8226-065f-3c6d-848f-d81a28772079",
                                        "entry_id": "fa2eabe8-443c-3eab-99d3-1969d3094438",
                                        "glosses": [
                                            "The relation of two weights or forces which balance each other; equilibrium"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "counterpoise",
