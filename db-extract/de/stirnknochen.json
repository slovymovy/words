                "senses": [
                    {
                        "sense_id": "5aff4243-a11e-31ee-a877-931dcc042d06",
                        "entry_id": "ebd721a8-e311-3be2-89f6-0c704899b2a7",
                        "glosses": [
                            "Knochen als Teil der Stirn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7b14d36-37fc-4303-b1b5-e771a8107237",
                                "sense_id": "5aff4243-a11e-31ee-a877-931dcc042d06",
                                "text": "„Abdul Salaam erkannte, dass es sich um eine Schaufel handelte, gerade, als sie seinen älteren Cousin im Gesicht traf. Ein dröhnender Schlag hallte durch das Bachbett. Schwerer Stahl traf auf einen harten Stirnknochen.“"
                            },
                            {
                                "example_id": "a4728588-a2b2-4be4-a468-13290fb1033b",
                                "sense_id": "5aff4243-a11e-31ee-a877-931dcc042d06",
                                "text": "„Sie versuchten, den anderen mit Armen und Beinen zu umklammern, und benutzten ihre Ellbogen und Stirnknochen als Waffen, wenn ihre Arme und Beine sich gegenseitig lahmlegten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
