                            {
                                "example_id": "71960e80-83d5-40b5-8d91-bd8fc54600e7",
                                "sense_id": "b705544e-0853-37af-a486-7d5be900c1e7",
                                "text": "„Auch treibt sich da ein gewisses keltisches Element herum zwischen den Anoraks und Fellmützen - lange Nasen - häufiger dabei in den Gesichtern von Frauen.“"
                            },
                            {
                                "example_id": "c2dfb5af-74e4-4920-b278-ae6aa4dbc952",
                                "sense_id": "b705544e-0853-37af-a486-7d5be900c1e7",
                                "text": "„Sie beneidete Hörđur um seine Fellmütze, die alle seine Haare sorgfältig zusammenhielt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
