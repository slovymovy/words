{
    "word_family": [
        "serenader"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a55612d4-be10-33b6-8d1a-04df1a1ac147",
                    "sense_definition": "A musical performance or love song sung or played directly to someone, especially outdoors under a window at night.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "music",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He stood beneath her bedroom window and sang a romantic <w>serenade</w>.",
                            "target_lang_translations": {
                                "zh": "他站在她卧室的窗下，唱起了一首浪漫的<w>小夜曲</w>。"
                            }
                        },
                        {
                            "text": "She was deeply touched when he offered a midnight <w>serenade</w> outside her balcony.",
                            "target_lang_translations": {
                                "zh": "当他在她的阳台外献上一曲午夜<w>小夜曲</w>时，她深受感动。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "midnight serenade",
                        "romantic serenade"
                    ],
                    "target_lang_definitions": {
                        "zh": "（尤指夜晚在心上人窗外为其单独演唱或演奏的）小夜曲，情歌"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "小夜曲",
                                "target_lang_sense_clarification": "向心上人表达爱慕之情的歌曲"
                            },
                            {
                                "target_lang_word": "情歌",
                                "target_lang_sense_clarification": "抒发爱意的歌曲"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d37919af-fcc2-3009-a6af-a928e9c5cc3a",
                    "sense_definition": "An instrumental classical musical composition in several movements, light in character.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "music",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The orchestra performed an elegant string <w>serenade</w> by Mozart during the evening concert.",
                            "target_lang_translations": {
                                "zh": "在晚间音乐会上，管弦乐团演奏了莫扎特一首优雅的弦乐<w>小夜曲</w>。"
                            }
                        },
                        {
                            "text": "The composer wrote a lovely chamber <w>serenade</w> for winds and strings.",
                            "target_lang_translations": {
                                "zh": "作曲家为管乐与弦乐谱写了一首优美的室内乐<w>小夜曲</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "string serenade"
                    ],
                    "target_lang_definitions": {
                        "zh": "（古典音乐中的）小夜曲（通常为多乐章、风格轻快明朗的器乐曲）"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "小夜曲",
                                "target_lang_sense_clarification": "古典器乐曲体裁"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0d91814a-5fcc-341e-8805-08ef3e74f761",
                    "sense_definition": "To sing or play a piece of music to someone, usually as a romantic or complimentary gesture.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "music",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The musician decided to <w>serenade</w> her with an acoustic guitar.",
                            "target_lang_translations": {
                                "zh": "这位音乐家决定用原声吉他为她<w>唱情歌</w>。"
                            }
                        },
                        {
                            "text": "Guests gathered in the courtyard while the band began to <w>serenade</w> the newlyweds.",
                            "target_lang_translations": {
                                "zh": "宾客们聚集在庭院里，乐队开始为新婚夫妇<w>奏乐致意</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "为（某人）唱情歌，为（某人）奏乐致意"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "唱小夜曲",
                                "target_lang_sense_clarification": "为某人演唱抒情曲"
                            },
                            {
                                "target_lang_word": "为……唱情歌",
                                "target_lang_sense_clarification": "表达爱意地演唱"
                            },
                            {
                                "target_lang_word": "奏乐致意",
                                "target_lang_sense_clarification": "演奏乐曲表达敬意或赞颂"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}