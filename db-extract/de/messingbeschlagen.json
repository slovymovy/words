                ],
                "senses": [
                    {
                        "sense_id": "0b3ae43f-bafa-33ae-93fa-0d62ec2cefc9",
                        "entry_id": "8334ef41-cf31-340b-84bb-7fb10e2aa276",
                        "glosses": [
                            "mit Messing beschlagen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81351ffc-6ae3-4c5a-adec-d3b9c2a3f144",
                                "sense_id": "0b3ae43f-bafa-33ae-93fa-0d62ec2cefc9",
                                "text": "„Das gespenstische Gefühl der Verwirrtheit verging und Sir Roderick begab sich an die Untersuchung der messingbeschlagenen Bücher.“"
                            },
                            {
                                "example_id": "4aace95b-722d-458c-b4cb-fb749c7fda2f",
                                "sense_id": "0b3ae43f-bafa-33ae-93fa-0d62ec2cefc9",
                                "text": "„Die harte, stolze Haltung der Männer und ihre mörderischen Messer, die sie in messingbeschlagenen Scheiden an ihren Gürteln trugen, hätten auch den glühendsten Verehrer ihrer Damenwelt entmutigt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
