                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aoryst",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "6cd2a951-afff-3702-bdd5-9513d372577d",
                                        "entry_id": "7adb68d8-f192-3413-8e48-b5d9fe38d1f8",
                                        "glosses": [
                                            "czas gramatyczny, mający różne znaczenia w zależności od języka, np. w językach indoeuropejskich to czas przeszły, w językach ałtajskich – teraźniejszo-przyszły"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e904288-8143-4c9a-92d2-ed28911991c9",
                                                "sense_id": "6cd2a951-afff-3702-bdd5-9513d372577d",
                                                "text": "W językach łużyckich formy aorystu tworzy się jedynie od czasowników dokonanych, zaś formy imperfectum tylko od czasowników niedokonanych."
                                            },
                                            {
                                                "example_id": "d1f8ce41-5a84-455d-b60b-63adff40445e",
                                                "sense_id": "6cd2a951-afff-3702-bdd5-9513d372577d",
                                                "text": "W języku tureckim aoryst służy przede wszystkim do wyrażania czynności ogólnych, powtarzających się oraz mogących nastąpić w bardzo bliskiej przyszłości."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ccf2bce7-c385-48ac-adeb-383654250bb7",
                        "source_entry_id": "cda9a9bf-a8af-33a0-ad43-2ff83cd13987",
                        "source_sense_id": "d9ee6fcc-6110-3646-b41d-b526144fa165",
                        "source_sense_description": "Verbflexion, die eine abgeschlossene Handlung oder einen abgeschlossenen Prozess darstellt",
                        "target_lang_word": "аорист",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "аорист",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "db43480a-a96b-3731-83e6-857c8d09a07a",
                                        "entry_id": "3dee0bd3-f7ef-3445-aeeb-6e3821a2e151",
                                        "glosses": [
                                            "лингв. видо-временная форма глагола в индоевропейских языках (греческом, старославянском, древнерусском, современных южнославянских), обозначавшая недлительное действие, полностью отнесённое к прошлому, без указания на его развитие (в противоположность имперфекту) или полноту совершения, предел (в противоположность перфекту)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a4414c7-1288-4a25-a9cd-f932ee25470d",
                                                "sense_id": "db43480a-a96b-3731-83e6-857c8d09a07a",
                                                "text": "Я говорил про пять гласных звуков, два типа склонения прилагательных, тоническое ударение и вытеснение аориста и имперфекта сложным прошедшим временем ― перфектом."
                                            },
                                            {
                                                "example_id": "2cf3c18e-e5e9-4f00-ac9a-84f13f0d5b76",
                                                "sense_id": "db43480a-a96b-3731-83e6-857c8d09a07a",
                                                "text": "Объяснить, что такое глагольная форма «аорист» (именно так значилось в билете) для меня было равносильно решению теоремы Ферма переростком оборо́вшим четыре действия арифметики."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
