                                            {
                                                "example_id": "13ea8b14-a3c3-444e-bcc7-418b41136a9d",
                                                "sense_id": "c919644a-a32c-3e8c-b881-a2f949e5f069",
                                                "text": "Rozmaitość religijna Orientu, istnienie rozwiniętych systemów filozoficznych, takich jak hinduizm, buddyzm, dżinizm, taoizm czy konfucjanizm, sprawiało, że przed chrześcijańskim misjonarzem pojawiał się problem umiejętnego dialogu"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3c274129-6ce3-448f-bf68-f01167eeed32",
                        "source_entry_id": "755bc752-39b2-3a30-852e-4900f631148d",
                        "source_sense_description": "religion and philosophy",
