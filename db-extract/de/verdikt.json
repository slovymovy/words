                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Verdikte"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1b7aa9a2-89f3-301f-86c2-d2f3967f0535",
                        "entry_id": "566ba5c8-5767-323d-a455-d0d34ebf3755",
                        "glosses": [
                            "Urteil, Urteilsspruch"
                        ],
                        "tags": [
                            "früher"
                        ],
                        "examples": [
                            {
                                "example_id": "1ece3971-e5b2-4f3a-9c95-0cf89b203c45",
                                "sense_id": "1b7aa9a2-89f3-301f-86c2-d2f3967f0535",
                                "text": "Die Geschworenen waren wegen eines Mangels ihres Verdiktes zurückgesendet und schrieben ihr verbessertes Verdikt unmittelbar unter das erste."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "744392d0-fb61-30de-9df2-1a429e209487",
                        "entry_id": "566ba5c8-5767-323d-a455-d0d34ebf3755",
                        "glosses": [
                            "stark negative Beurteilung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8167a614-302f-44b4-9579-5dcf2aa0ca12",
                                "sense_id": "744392d0-fb61-30de-9df2-1a429e209487",
                                "text": "Kritiker sehen den Richterspruch als politisches Verdikt."
                            },
                            {
                                "example_id": "4f02f25a-eabf-4ded-ae35-691239659425",
                                "sense_id": "744392d0-fb61-30de-9df2-1a429e209487",
                                "text": "„Für einen Mann wie Hannibal, der sich laut Livius […] durch seine Areligiosität auszeichnete […], war die zustande gebrachte Aktionsgemeinschaft eine erstaunliche Leistung. Am livianischen Verdikt lässt sich noch die Ratlosigkeit der Römer erkennen über das mittelmeerumspannende Gewitter, das sich über der Stadt am Tiber zusammenbraute.“"
                            },
                            {
                                "example_id": "11232de7-e1c0-41ee-990c-345456c1c28a",
                                "sense_id": "744392d0-fb61-30de-9df2-1a429e209487",
                                "text": "\"Das Verdikt \"Antisemitismus\" ist geläufig\""
                            },
                            {
                                "example_id": "f6c2fbd1-18ae-4bed-926e-afce019030af",
                                "sense_id": "744392d0-fb61-30de-9df2-1a429e209487",
                                "text": "„Ohne diese Schlüsselworte wurde jedes Argument mit einem Verdikt aus ebendiesem Vokabelschatz abgeschmettert.“"
                            },
                            {
                                "example_id": "8a295097-7a4e-474d-8f46-eb44da31f377",
                                "sense_id": "744392d0-fb61-30de-9df2-1a429e209487",
                                "text": "„Ein ähnliches Verdikt traf ihn nach der Machtübernahme der Nazis in Hamburg.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4d4e72d0-908e-4eec-a5aa-7d21b6efb925",
                        "source_entry_id": "566ba5c8-5767-323d-a455-d0d34ebf3755",
                        "source_sense_id": "1b7aa9a2-89f3-301f-86c2-d2f3967f0535",
                        "source_sense_description": "früher: Urteil, Urteilsspruch",
                        "target_lang_word": "verdict",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verdict",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1a54d9b1-f4de-344f-b7c4-fd40f5a466b1",
                                        "entry_id": "cfcac4e9-095d-3bc8-9bdd-897e7abef19d",
                                        "glosses": [
                                            "A decision on an issue of fact in a civil or criminal case or an inquest."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e80c5063-062d-4f24-9534-12e5e8d17d64",
                                                "sense_id": "1a54d9b1-f4de-344f-b7c4-fd40f5a466b1",
                                                "text": "The jury returned a “not guilty” verdict."
                                            },
                                            {
                                                "example_id": "f1635dab-d44a-4053-bbdd-0340611a2ff2",
                                                "sense_id": "1a54d9b1-f4de-344f-b7c4-fd40f5a466b1",
                                                "text": "Such a scandal as the prosecution of a brother for forgery—with a verdict of guilty—is a most truly horrible, deplorable, fatal thing. It takes the respectability out of a family perhaps at a critical moment, when the family is just assuming the robes of respectability: […] it is a black spot which all the soaps ever advertised could never wash off."
                                            },
                                            {
                                                "example_id": "f06bf05e-2199-4dcf-ae0b-d189f947372a",
                                                "sense_id": "1a54d9b1-f4de-344f-b7c4-fd40f5a466b1",
                                                "text": "When his body was retrieved, it was apparent that he had not raised his hands to cover his face. Had he suffered some sort of fit or seizure? The coroner’s verdict was accidental death."
                                            },
                                            {
                                                "example_id": "3b774a8f-3c2f-48fa-bd6c-76b54e5c820a",
                                                "sense_id": "1a54d9b1-f4de-344f-b7c4-fd40f5a466b1",
                                                "text": "The Supreme Court said Monday that unanimous jury verdicts are required in state criminal trials for serious offenses, handing a victory to criminal defendants including petitioner Evangelisto Ramos, who was convicted of murder in Louisiana on a 10-2 vote. […] “We took this case to decide whether the Sixth Amendment right to a jury trial – as incorporated against the States by way of the Fourteenth Amendment – requires a unanimous verdict to convict a defendant of a serious offense,” Gorsuch wrote."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "691cbe5f-dfa3-3bba-9ad0-92e6656d9d29",
                                        "entry_id": "cfcac4e9-095d-3bc8-9bdd-897e7abef19d",
                                        "glosses": [
                                            "An opinion or judgement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "707e5cb5-8cd8-421d-b0ee-f5e06c0bf8ba",
                                                "sense_id": "691cbe5f-dfa3-3bba-9ad0-92e6656d9d29",
                                                "text": "a “not out” verdict from the umpire"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9a1a7b8c-e937-4444-9b4d-d8c2416e3e43",
                        "source_entry_id": "566ba5c8-5767-323d-a455-d0d34ebf3755",
                        "source_sense_id": "1b7aa9a2-89f3-301f-86c2-d2f3967f0535",
                        "source_sense_description": "früher: Urteil, Urteilsspruch",
                        "target_lang_word": "verdict",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verdict",
