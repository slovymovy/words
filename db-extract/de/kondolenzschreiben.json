                "senses": [
                    {
                        "sense_id": "23930344-b52b-3bea-9e09-fc2fece2ea31",
                        "entry_id": "7d6c9599-c54c-33fc-83ab-dab70b4d41f7",
                        "glosses": [
                            "versandter Text, der die Anteilnahme an einem Todesfall ausdrückt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57fbdb1f-1dad-4e4b-8a7f-604549ab7a94",
                                "sense_id": "23930344-b52b-3bea-9e09-fc2fece2ea31",
                                "text": "„Laut Schriftsatz handelt es sich dabei um eine schriftliche Erklärung des Beschwerdeführers sowie um mehrere Kondolenzschreiben diverser Militärs.“"
                            },
                            {
                                "example_id": "742e6034-3e39-4ac7-9c80-80229caa85bd",
                                "sense_id": "23930344-b52b-3bea-9e09-fc2fece2ea31",
                                "text": "„Das [Ansehen] äußerte sich unter anderem darin, dass der damalige Oberbürgermeister Stephan Birner aus Anlass des Todes von Ignaz Neuburger 1928 ein Kondolenzschreiben an die Hinterbliebenen richtete.“"
                            }
                        ],
