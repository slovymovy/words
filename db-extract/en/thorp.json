                "senses": [
                    {
                        "sense_id": "d52ab1b4-2c6d-3b91-98cf-984d57bbf92a",
                        "entry_id": "6843ff86-8782-36ae-8cef-201d28ef071b",
                        "glosses": [
                            "A group of houses standing together in the country; a hamlet; a village."
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "2d6dc38c-7568-41b4-a4a8-1cb3fbfd7ee9",
                                "sense_id": "d52ab1b4-2c6d-3b91-98cf-984d57bbf92a",
                                "text": "Within a little thorp I staid."
                            },
                            {
                                "example_id": "4262256c-4cef-4c81-857a-246c61fad6ae",
                                "sense_id": "d52ab1b4-2c6d-3b91-98cf-984d57bbf92a",
                                "text": "A plague upon the people fell, / A famine after laid them low, / Then thorpe and byre arose in fire, / For on them brake the sudden foe; […]"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1a8493ee-9c6c-413b-b6f6-c9d13db929f7",
                        "source_entry_id": "6843ff86-8782-36ae-8cef-201d28ef071b",
                        "source_sense_id": "d52ab1b4-2c6d-3b91-98cf-984d57bbf92a",
                        "source_sense_description": "hamlet, village",
                        "target_lang_word": "dorp",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dorp",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "ee6d9003-bdfb-3718-b383-0df4eaf60ee1",
                                        "entry_id": "cf0ec9a3-8c30-3842-97e6-1c5afa6ceeb4",
                                        "glosses": [
                                            "kleine, permanente nederzetting"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f510a14-f2cd-417c-8104-85af1df2af2e",
                                                "sense_id": "ee6d9003-bdfb-3718-b383-0df4eaf60ee1",
                                                "text": "Van de wereldbevolking woont een steeds kleiner deel in dorpen."
                                            },
                                            {
                                                "example_id": "374eb540-2a9c-4073-ae2e-54ff4d7e9640",
                                                "sense_id": "ee6d9003-bdfb-3718-b383-0df4eaf60ee1",
                                                "text": "Vooral de secundaire informatie van Guthook was voor mij van groot belang. Alle relevante informatie over de trail werd aangegeven, zoals geschikte slaapplaatsen, wegen, dorpen en alle waterbronnen."
                                            },
                                            {
                                                "example_id": "38634334-f09b-4a25-aaae-9ae22d8015ea",
                                                "sense_id": "ee6d9003-bdfb-3718-b383-0df4eaf60ee1",
                                                "text": "Zo is het ook met die straathoek aan het Lodewijk Napoleonplein. Het plein is onderdeel van het Rooie Dorp, de oostelijke arbeiderswijk waar Muskee is opgegroeid. We zijn er gek genoeg niet geweest op de omzwervingen door zijn leven, maar hij heeft er des te meer over verteld."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e1c71ab5-74b2-486c-ae36-6ce2ce3f2563",
                        "source_entry_id": "6843ff86-8782-36ae-8cef-201d28ef071b",
                        "source_sense_id": "d52ab1b4-2c6d-3b91-98cf-984d57bbf92a",
                        "source_sense_description": "hamlet, village",
                        "target_lang_word": "hameau",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hameau",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d8d02397-01ce-3447-8c6e-7cb16a06d42d",
                                        "entry_id": "d2cb1608-7a3b-31df-b265-1b7dddba5808",
                                        "glosses": [
                                            "En milieu rural, groupe d’habitations à l’écart d’une commune, à laquelle il est rattaché administrativement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01ab75b2-49d7-4e9c-96a1-69010e4ccdba",
                                                "sense_id": "d8d02397-01ce-3447-8c6e-7cb16a06d42d",
                                                "text": "On déserte surtout les endroits inaccessibles […] Il faut donc s’attacher à les rendre d’un abord plus facile en multipliant partout, entre les villages et les hameaux, les petites routes."
                                            },
                                            {
                                                "example_id": "ade946c1-beb6-40cf-85aa-5b0d850fc0b8",
                                                "sense_id": "d8d02397-01ce-3447-8c6e-7cb16a06d42d",
                                                "text": "Au terme d’un ancien chemin usé jusqu’à l’enrochement […] le hameau des Vieux Marais dérobe sa dizaine de masures à ras du sol, à l’orée de la Fagne."
                                            },
                                            {
                                                "example_id": "097c711d-57ea-44e3-af46-1c95d222bf54",
                                                "sense_id": "d8d02397-01ce-3447-8c6e-7cb16a06d42d",
                                                "text": "Les jours lui sont comptés et, après, il ira s’encagnarder dans son hameau, à l'abri des vents mauvais et en dehors de toute civilisation."
                                            },
                                            {
                                                "example_id": "713bf310-2f6b-4eb0-81d1-626c442cf2f4",
                                                "sense_id": "d8d02397-01ce-3447-8c6e-7cb16a06d42d",
                                                "text": "De même, pour le département de Seine-et-Marne, le dictionnaire topographique paru en 1954 permet de relever les noms de 87 localités disparues : 4 seulement sont données pour paroisses ou villages ; les autres sont des hameaux ou encore des écarts de 3 ou 4 maisons."
                                            },
                                            {
                                                "example_id": "7c81a579-90ae-44d3-b666-30227e01b184",
                                                "sense_id": "d8d02397-01ce-3447-8c6e-7cb16a06d42d",
                                                "text": "— Nous possédons ici même, en plein Paris, un hameau à peu près inconnu malgré son nom illustre, et qui est la Butte."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2c229ba6-9262-4ca6-aca1-c638d3a99168",
                        "source_entry_id": "6843ff86-8782-36ae-8cef-201d28ef071b",
                        "source_sense_id": "d52ab1b4-2c6d-3b91-98cf-984d57bbf92a",
                        "source_sense_description": "hamlet, village",
                        "target_lang_word": "village",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "village",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "24b6ec0d-1801-3ca8-97f0-90455f7cecf2",
                                        "entry_id": "2ba52dd3-8e37-3b3b-a394-59e261be0477",
                                        "glosses": [
                                            "Groupe d’habitations rurales."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb387c66-ef2b-4084-b53b-158f54254338",
                                                "sense_id": "24b6ec0d-1801-3ca8-97f0-90455f7cecf2",
                                                "text": "En un village de trois cents habitants, où il y avait autrefois cinq cabarets, il y en a quinze maintenant, et tous font leurs affaires. Plus de règlement, plus de police."
                                            },
                                            {
                                                "example_id": "22befa09-6a27-44c6-a9fa-63172fb1794c",
                                                "sense_id": "24b6ec0d-1801-3ca8-97f0-90455f7cecf2",
                                                "text": "Le village de Ngarumaova était composé d’une seule rue, autour de laquelle étaient bâties des cases dont j’ai parlé, la plupart construites en tôle ondulée."
                                            },
                                            {
                                                "example_id": "c040b8f5-1156-46ee-a928-decdf0c2e06c",
                                                "sense_id": "24b6ec0d-1801-3ca8-97f0-90455f7cecf2",
                                                "text": "Dans dix ans, parmi les vestiges de Beaumat, les souffles du vent, les croassements des corbeaux et la chute des pierres retentiront seuls ; nulle oreille humaine ne les entendra et la cloche du village elle-même se taira, fatiguée de tinter seulement pour les morts."
                                            },
                                            {
                                                "example_id": "9ab8937b-e009-49ac-bd5f-2ec5bd21c78a",
                                                "sense_id": "24b6ec0d-1801-3ca8-97f0-90455f7cecf2",
                                                "text": "Retourner au village, vivre avec nouveau parmi les racontars des femmes, écouter tout le jour les piaulements des dindes et des poulets, les bêlements des moutons, cela l’attirait peu."
                                            },
                                            {
                                                "example_id": "524da01c-eeb4-41ee-ab1a-90f3a8add26d",
                                                "sense_id": "24b6ec0d-1801-3ca8-97f0-90455f7cecf2",
                                                "text": "En Dalécarlie, comme en Norwége et comme dans toute la Scandinavie septentrionale, point de village : au lieu de s'agglomérer, les habitations se dispersent, s'isolent, s'égrènent sur d'immenses étendues de prairies et de forêts. … Dans nos campagnes, les maisons se pressent, se pelotonnent à l'ombre du clocher, comme sous une aile protectrice. En Suède, elles ont l'air de se fuir. Chaque famille vit isolée dans sa ferme."
                                            },
                                            {
                                                "example_id": "23219319-d649-4b59-ba85-d09fa2d75f0b",
                                                "sense_id": "24b6ec0d-1801-3ca8-97f0-90455f7cecf2",
                                                "text": "Dans le cadre de cette recherche, nous définissons les villages comme les communes appartenant à des agglomérations de moins de 2 000 habitants, les bourgs comme celles appartenant à des agglomérations comprises entre 2 000 et 100 000 habitants, les banlieues comme les communes secondaires des agglomérations de plus de 100 000 habitants, et les métropoles comme les communes principales des agglomérations de plus de 100 000 habitants."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7cc58157-a11e-3929-9a80-268be620fb2c",
                                        "entry_id": "2ba52dd3-8e37-3b3b-a394-59e261be0477",
                                        "glosses": [
                                            "Hameau, groupement d'habitations et bâtiments ruraux distincts du bourg."
                                        ],
                                        "tags": [
                                            "Régionalisme"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0bc9471d-db8e-4fa1-8db8-c91d015d519b",
                                                "sense_id": "7cc58157-a11e-3929-9a80-268be620fb2c",
                                                "text": "En Limousin, le « village » des habitants est le « hameau » des administrateurs et le « village » des administrateurs est le « bourg » des habitants."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e86f1ddb-ff91-3a36-8ff8-06cfdb9c755d",
                                        "entry_id": "2ba52dd3-8e37-3b3b-a394-59e261be0477",
                                        "glosses": [
                                            "Ensemble des habitants d’un village."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "743c3c45-87bb-44f1-80f0-981e1f334ab2",
                                                "sense_id": "e86f1ddb-ff91-3a36-8ff8-06cfdb9c755d",
                                                "text": "Le village eut vite fait de l’adopter, car il était très serviable et prenait sa tâche à cœur."
                                            },
                                            {
                                                "example_id": "9bcc314b-dc55-4122-908c-3ca7242a1b47",
                                                "sense_id": "e86f1ddb-ff91-3a36-8ff8-06cfdb9c755d",
                                                "text": "L’enterrement de mon père fut suivi de tout le village suivant la coutume et il y vint des gens des environs, à des lieues à la ronde."
                                            },
                                            {
                                                "example_id": "2338f80f-2938-4a49-a6b6-89360c25f3ac",
                                                "sense_id": "e86f1ddb-ff91-3a36-8ff8-06cfdb9c755d",
                                                "text": "Et tout le village bientôt, à des degrés variant selon la constitution et la force de résistance de chacun, fut en proie à des malaises étranges, symptômes inexplicables d’empoisonnement."
                                            },
                                            {
                                                "example_id": "baadf3f0-8e6e-449c-bfed-d4c315027283",
                                                "sense_id": "e86f1ddb-ff91-3a36-8ff8-06cfdb9c755d",
                                                "text": "les réformes de Henry II, en affaiblissant les nobles, les avaient rapprochés de leurs tenants. Entre le manoir et le village, les conflits devenaient plus rares."
                                            },
                                            {
                                                "example_id": "1739732e-8320-4f32-a54f-49fcb81a2de8",
                                                "sense_id": "e86f1ddb-ff91-3a36-8ff8-06cfdb9c755d",
                                                "text": "Le village se réunissait, c'était la cuisson des gâteaux fait maison. Toutes sortes tourtières, tartes, biscuits, couronnes, du pain il y avait au moins pour un mois."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e575a101-2f17-3a83-8f6f-b359313291db",
                                        "entry_id": "2ba52dd3-8e37-3b3b-a394-59e261be0477",
                                        "glosses": [
                                            "Partie significative des habitants d’un village."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f1177659-6641-4ad1-ac10-6d8a2e2ae280",
                                                "sense_id": "e575a101-2f17-3a83-8f6f-b359313291db",
                                                "text": "Le village entier partit le lendemain dans une trentaine de pirogues, nous laissant seuls avec les femmes et les enfants dans les maisons abandonnées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "10983e30-2e82-356a-8614-51990830edb6",
                                        "entry_id": "2ba52dd3-8e37-3b3b-a394-59e261be0477",
                                        "glosses": [
                                            "Vin d'un terroir plus restreint et plus qualitatif que d'autres vins de l'appellation correspondante."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f5a08a4-e86c-4955-a031-ec82bfb86c4f",
                                                "sense_id": "10983e30-2e82-356a-8614-51990830edb6",
                                                "text": "Le village, ou villages, répond à des normes plus précises : anjou villages […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fda9353c-6cdd-4cf5-aa39-0b9c51e293d5",
                        "source_entry_id": "6843ff86-8782-36ae-8cef-201d28ef071b",
                        "source_sense_id": "d52ab1b4-2c6d-3b91-98cf-984d57bbf92a",
                        "source_sense_description": "hamlet, village",
                        "target_lang_word": "Dorf",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dorf",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b4162bb8-1068-3fb7-8a53-476852a0c81e",
                                        "entry_id": "db8bcfc2-af12-32b4-899f-f4cf8d2028af",
                                        "glosses": [
                                            "kleine Siedlung, ländlicher Wohnort"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64673f9d-2cfa-40b6-98ac-6d19cf3c0cce",
                                                "sense_id": "b4162bb8-1068-3fb7-8a53-476852a0c81e",
                                                "text": "Im Zentrum des Dorfes steht die Kirche."
                                            },
                                            {
                                                "example_id": "ecfc2f46-0ccf-488c-a2bc-bbd32bd14805",
                                                "sense_id": "b4162bb8-1068-3fb7-8a53-476852a0c81e",
                                                "text": "„Sie waren Ackerbauern und Viehzüchter, die verstreut auf Gehöften oder in kleinen Dörfern wohnten.“"
                                            },
                                            {
                                                "example_id": "aa0a3fae-48cd-4a79-be6f-2d8ad0baca2d",
                                                "sense_id": "b4162bb8-1068-3fb7-8a53-476852a0c81e",
                                                "text": "„Bei jedem Dorf werden wir von bettelnden Kindern umringt.“"
                                            },
                                            {
                                                "example_id": "5193a8d3-b951-4cb9-9230-f2c7053312b9",
                                                "sense_id": "b4162bb8-1068-3fb7-8a53-476852a0c81e",
                                                "text": "„Die Dörfer der Südpfalz, durch die wir jetzt fahren, sind miteinander verbunden und eingefasst in die Landschaft der Weinberge und des Pfälzer Waldes.“"
                                            },
                                            {
                                                "example_id": "9d816e1c-4064-48a2-921f-40708e646552",
                                                "sense_id": "b4162bb8-1068-3fb7-8a53-476852a0c81e",
                                                "text": "„Als ich weiterfuhr, durch zahlreiche kleine Ortschaften und Dörfer, wiederholten sich Szenen wie diese ungefähr alle fünf Minuten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "171f0110-459d-378a-a093-9bad9f664a46",
                                        "entry_id": "db8bcfc2-af12-32b4-899f-f4cf8d2028af",
                                        "glosses": [
                                            "die gesamte Einwohnerschaft eines Dorfes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23ac60aa-f172-4d8c-a827-c1f36afec225",
                                                "sense_id": "171f0110-459d-378a-a093-9bad9f664a46",
                                                "text": "Das halbe Dorf war gekommen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
