                                        "glosses": [
                                            "A prefecture-level city of Sichuan, China."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f05704a7-5a94-43d5-8432-24325beaffeb",
                                                "sense_id": "aa4f9e64-0bbc-380f-b713-bc27bc95621a",
                                                "text": "Actually we would spend the first year or so in the smaller town of Leshan, a hundred miles south of Chengtu, learning the Szechuan dialect and the culture of the local people."
                                            },
                                            {
                                                "example_id": "a4cdde40-1e30-4fef-9387-1a202a6543f8",
                                                "sense_id": "aa4f9e64-0bbc-380f-b713-bc27bc95621a",
                                                "text": "The outbreak, found in Leshan, Sichuan province, on a truck transporting 111 pigs from other provinces, has killed 7 of the herd, according to a statement published on the website of the Ministry of Agriculture and Rural Affairs."
                                            }
                                        ]
                                    }
                                ]
                            }
