                                    },
                                    {
                                        "sense_id": "5d9ecde6-1059-3168-bcf2-377fb3d95940",
                                        "entry_id": "0bf0ba52-9448-3570-a8f2-1cdee73677ed",
                                        "glosses": [
                                            "Ellipsis of bipolar disorder."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e4d15eb-b633-4281-989e-77df971b929e",
                                                "sense_id": "5d9ecde6-1059-3168-bcf2-377fb3d95940",
                                                "text": "[R]ecent meta-analyses have shown asthma, obesity, migraine and head injury are associated with bipolar."
                                            }
