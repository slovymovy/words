                        "glosses": [
                            "A long rattan cane used for corporal punishment."
                        ],
                        "tags": [
                            "Malaysia",
                            "Singapore"
                        ],
                        "examples": [
                            {
                                "example_id": "2f279bb4-59e5-4732-92a3-91176725a694",
                                "sense_id": "b071b480-d725-34e9-9468-4738aae9a13c",
                                "text": "Two boys, aged 14 and 11, were each sentenced to three strokes of the light rotan at Kluang for stealing duck eggs from Loh Wee Seng."
                            },
                            {
                                "example_id": "0c1085d2-2063-4fbe-94e0-5b2231bf11ec",
                                "sense_id": "b071b480-d725-34e9-9468-4738aae9a13c",
                                "text": "Zaimi Bin Rassak, 20, was yesterday jailed for two years with two strokes of the rotan after he was found guilty of trafficking in 32 rolls of cannabis in Queens Crescent on June 24 at 1 a.m."
                            },
                            {
                                "example_id": "e304a18d-4614-4778-9c46-a9af14366f3a",
                                "sense_id": "b071b480-d725-34e9-9468-4738aae9a13c",
                                "text": "Khushwant Singh, 38-year-old on the run for five years, put behind bars for six years and two months; gets six strokes of the rotan."
                            }
                        ]
                    }
                ],
