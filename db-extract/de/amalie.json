                    },
                    {
                        "translation_id": "8bbbc880-6128-4ba6-a280-e0fc967d048b",
                        "source_entry_id": "f067a77e-d0ff-314f-bc60-493a63e74f76",
                        "source_sense_id": "89ff2349-0375-3a0c-9aa6-cafbf3121012",
                        "source_sense_description": "weiblicher Vorname",
                        "target_lang_word": "Emily",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Emily",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cb78fed9-ffc5-3892-84cd-9c7e80044a0d",
                                        "entry_id": "d4302808-c701-3edb-b8a0-74c14517124a",
                                        "glosses": [
                                            "A female given name from Latin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2143c47f-1faf-468c-94e8-d03c3215c263",
                                                "sense_id": "cb78fed9-ffc5-3892-84cd-9c7e80044a0d",
                                                "text": "1380s-1390s, Geoffrey Chaucer, The Canterbury Tales: The Knight's Tale\nI am thy mortal foe, and it am I\nThat so hot loveth Emily the bright,\nThat I would die here present in her sight."
                                            },
                                            {
                                                "example_id": "7a0365c5-e934-4593-9f6b-69fe69d11428",
                                                "sense_id": "cb78fed9-ffc5-3892-84cd-9c7e80044a0d",
                                                "text": "People will please their fancies, and every lady has her favourite names. I myself have several, and they are mostly short and simple. - - - Emily, in which all womanly sweetness seems bound up - perhaps this is the effect of association of ideas - I have known so many charming Emilys"
                                            },
                                            {
                                                "example_id": "6b82a160-2ca3-4ed3-b423-54698169bd31",
                                                "sense_id": "cb78fed9-ffc5-3892-84cd-9c7e80044a0d",
                                                "text": "This may have accounted for Emma's Christian name, for it had seemed to Beatrix unfair to call her daughter Emily, a name associated with her grandmother's servants rather than the author of The Wuthering Heights, so Emma had been chosen, perhaps with the hope that some of the qualities possessed by the heroine of the novel might be perpetuated."
                                            },
                                            {
                                                "example_id": "713fb3a1-2471-43a7-8af3-55986f475bca",
                                                "sense_id": "cb78fed9-ffc5-3892-84cd-9c7e80044a0d",
                                                "text": "Emily. Em-il-y, three syllables, like a knock on the door of destiny. Such an odd, old-fashioned name, compared to those Kylies and Traceys and Jades — names that reeked of Impulse and grease and stood out in gaudy neon colours — whilst hers was that muted, dusky pink, like bubblegum, like roses —"
                                            },
                                            {
                                                "example_id": "efd10cc5-e7ae-4dbb-8e2c-602fa8fce3cc",
                                                "sense_id": "cb78fed9-ffc5-3892-84cd-9c7e80044a0d",
                                                "text": "Emily Sisson set a new record for an American woman when she finished second at the Bank of America Chicago Marathon Sunday."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e81a9dbb-e650-4dbd-b2af-29b7a5f7302f",
                        "source_entry_id": "f067a77e-d0ff-314f-bc60-493a63e74f76",
                        "source_sense_id": "89ff2349-0375-3a0c-9aa6-cafbf3121012",
                        "source_sense_description": "weiblicher Vorname",
                        "target_lang_word": "Amélie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Amélie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f341828f-d06a-3191-9678-7570f6687ea4",
                                        "entry_id": "998aa8dd-7057-3135-9a34-2ff292039305",
                                        "glosses": [
                                            "Prénom féminin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7dbc5a6-8eb0-40d4-900f-265ce722a9c0",
                                                "sense_id": "f341828f-d06a-3191-9678-7570f6687ea4",
                                                "text": "Elle se révolta. Elle n’admettait pas qu’Amélie Pouilly souffrît par le fait d’un Bergeret."
                                            },
                                            {
                                                "example_id": "43d1d11f-89c4-450d-8f92-c0cd5db920b4",
                                                "sense_id": "f341828f-d06a-3191-9678-7570f6687ea4",
                                                "text": "Nous avions à ce moment une servante qui s’appelait Amélie, nous disions « la Mélie » ; elle avait une figure d’homme, une large bouche et les dents cariées ; elle était laide et avait, depuis plusieurs années, coiffé sainte Catherine."
                                            },
                                            {
                                                "example_id": "aed316e7-66de-4e0e-8c8d-ab4c3c5ae225",
                                                "sense_id": "f341828f-d06a-3191-9678-7570f6687ea4",
                                                "text": "Bonne tante Amélie, oui, archi-bonne !"
                                            },
                                            {
                                                "example_id": "2821b3dd-cba6-46a9-b7b0-2bf44b855a98",
                                                "sense_id": "f341828f-d06a-3191-9678-7570f6687ea4",
                                                "text": "« Pour serrer les prix, nous misons sur la vente directe dans notre shop à Paris ou en ligne, et sur l’utilisation au maximum de pièces standards du marché dont la fiabilité a été approuvée », explique Amélie Guicheney, l’une des créatrices."
                                            },
                                            {
                                                "example_id": "cdd70644-227d-4964-8496-d792c406c5ef",
                                                "sense_id": "f341828f-d06a-3191-9678-7570f6687ea4",
                                                "text": "La maire de Pleyben, Amélie Caro, se dit ravie de l'arrivée d’Eurofins dans sa commune."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Amélie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fd6333f9-986f-347b-af74-208775a0fdf3",
                                        "entry_id": "ecde6aa4-7f30-3c41-85d9-d8875196b31a",
                                        "glosses": [
                                            "Nom d’un astéroïde, découvert en 1922 par Josep Comas i Solá^([*])."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
