                                                "sense_id": "319b6c72-bd7e-3e54-a956-13516a191000",
                                                "text": "Eens was dat een rijke stad."
                                            },
                                            {
                                                "example_id": "4ae1bea4-c184-4041-97fb-271357670ee2",
                                                "sense_id": "319b6c72-bd7e-3e54-a956-13516a191000",
                                                "text": "Er was eens lang geleden in een ver land een mooi prinsesje met een sneeuwwitte huid."
                                            },
                                            {
                                                "example_id": "aeaf4105-ae18-4c5d-832b-68980fc46ba3",
                                                "sense_id": "319b6c72-bd7e-3e54-a956-13516a191000",
                                                "text": "Eens zal hij daar spijt van krijgen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f6d72a9e-563e-373c-8988-6a5d41583097",
                                        "entry_id": "1a212a50-2eae-3716-9922-4874660265f5",
                                        "glosses": [
                                            "als stopwoordje zonder echte betekenis"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c774c32-c7cb-452d-9108-b617764fd50f",
                                                "sense_id": "f6d72a9e-563e-373c-8988-6a5d41583097",
                                                "text": "De zinnen (Ik zal je wat moois laten horen.) en (Ik zal je eens wat moois laten horen.) hebben geen verschillende betekenis."
                                            },
                                            {
                                                "example_id": "f439a88d-ea1c-4cea-8aa8-455b249e48b4",
                                                "sense_id": "f6d72a9e-563e-373c-8988-6a5d41583097",
                                                "text": "Ik zou nou toch nog maar wel eens even goed nadenken!"
                                            }
                                        ]
                                    }
                                ]
                            },
