                                "target_senses": [
                                    {
                                        "sense_id": "5f4fb8eb-490d-3bbe-97a3-c859005b5dec",
                                        "entry_id": "9f299584-1a29-3cc7-8a75-8ed029e49d77",
                                        "glosses": [
                                            "eilandengebied tussen Zuidoost-Azië en Australië"
                                        ],
                                        "tags": [
                                            "toponymic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec46509f-2857-4997-ac78-7932473debd7",
                                                "sense_id": "5f4fb8eb-490d-3bbe-97a3-c859005b5dec",
                                                "text": "Wij woonden duizend jaar lang in Nusantara."
                                            },
                                            {
                                                "example_id": "14ac5aec-7b45-43d0-8a01-ade7063044a7",
                                                "sense_id": "5f4fb8eb-490d-3bbe-97a3-c859005b5dec",
                                                "text": "Het tijdschrift moest op Indonesië gericht zijn, met andere woorden een Indonesië-centrisch standpunt innemen. Als naam werd op voorstel van Soejitno Nusantara gekozen, hetgeen eilandenrijk betekent, de oudste aanduiding voor Indonesië."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b569ae9-de4c-32f7-a9d2-724ec1a1fc21",
                                        "entry_id": "9f299584-1a29-3cc7-8a75-8ed029e49d77",
                                        "glosses": [
                                            "endoniem voor de Republiek Indonesië"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9da5397d-7194-4d39-856c-74feb18273fc",
                                                "sense_id": "1b569ae9-de4c-32f7-a9d2-724ec1a1fc21",
                                                "text": "„Deutschland” is een endoniem voor de Bondsrepubliek Duitsland, „Nihon” is een endoniem voor Japan, terwijl „Nusantara” een endoniem voor Indonesië is."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "24328296-f12f-37be-8c5e-b8b2ec21f95d",
                                        "entry_id": "9f299584-1a29-3cc7-8a75-8ed029e49d77",
                                        "glosses": [
                                            "nieuw te bouwen hoofdstad van de Republiek Indonesië"
                                        ],
                                        "tags": [
                                            "toponymic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7fa16c49-0858-4f51-840b-fcdd5cce8396",
                                                "sense_id": "24328296-f12f-37be-8c5e-b8b2ec21f95d",
                                                "text": "De hoofdstad van Indonesië wordt Nusantara, gelegen aan de oostkust van het eiland Kalimantan."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "25dbd70d-efa2-3094-bfeb-2b25a08d37e2",
                                        "entry_id": "9f299584-1a29-3cc7-8a75-8ed029e49d77",
                                        "glosses": [
                                            "invloedssfeer van het rijk Majapahit, overeenkomend met het huidige Indonesië en verschillende Zuidoost-Aziatische landen"
                                        ],
                                        "tags": [
                                            "toponymic"
                                        ],
                                        "examples": []
                                    }
