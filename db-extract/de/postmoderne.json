                        "entry_id": "2bc790c8-3cca-3b94-ba54-ba5dcd5d5fb2",
                        "glosses": [
                            "Sammelbegriff für gegenwärtige Entwicklungen und Stilrichtungen in Kunst und Gesellschaft, die über die der Moderne hinausgehen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6757b11-1ace-4796-909f-62a71c784bb1",
                                "sense_id": "f6aee5f6-a91b-306f-aa2a-fbbbf0bba091",
                                "text": "Die Entwicklungen der Postmoderne sind für Traditionalisten oft schwer verständlich."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0aa81c41-3d93-4318-bc06-262d4565c032",
                        "source_entry_id": "2bc790c8-3cca-3b94-ba54-ba5dcd5d5fb2",
                        "source_sense_id": "f6aee5f6-a91b-306f-aa2a-fbbbf0bba091",
                        "target_lang_word": "后现代主义",
