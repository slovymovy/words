                                "target_senses": [
                                    {
                                        "sense_id": "524abd35-bd93-332b-966c-7a2da639ffac",
                                        "entry_id": "c75c46dc-8935-3746-8a05-438c26237abc",
                                        "glosses": [
                                            "Saint à qui une église est consacrée ou sous la protection de qui sont placés une communauté, une confrérie, une ville, un pays."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38cae945-770a-494e-b5f9-d7c1e7ac393f",
                                                "sense_id": "524abd35-bd93-332b-966c-7a2da639ffac",
                                                "text": "Je compris alors que les saints patrons venaient de nous renier jusqu’au Jugement dernier et que désormais le malheur était devenu notre destinée."
                                            }
                                        ]
