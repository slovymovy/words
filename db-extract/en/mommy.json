                "senses": [
                    {
                        "sense_id": "7fb98d17-25a3-3292-a000-6edc1abd5ae2",
                        "entry_id": "0494f0e2-006a-363a-8a84-12c3c9cbc3a4",
                        "glosses": [
                            "Mother."
                        ],
                        "tags": [
                            "Canada",
                            "US",
                            "childish",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "a4d3b17c-0ff9-44c3-af56-c09ac17736ec",
                                "sense_id": "7fb98d17-25a3-3292-a000-6edc1abd5ae2",
                                "text": "The only bad-karma-reducing sposie on the market is a new line of biodegradable (meaning here \"useless\") sposie that won't last through the lightest of baby pees and will force you to change baby approximately once every thirty seconds, thereby completely undoing any so-called karma reduction. Only bad mommies use sposies."
                            },
                            {
                                "example_id": "4740bb8a-b9a6-4874-a52f-4adb74b94e75",
                                "sense_id": "7fb98d17-25a3-3292-a000-6edc1abd5ae2",
                                "text": "They will never part even though in mommy's heart she wishes daddy would leave forever. One grief-some January 25 mommy rested never to return for her and daddy went on a walk. “Where is mommy”, said baby but daddy couldn't talk."
                            }
                        ]
                    },
