                "senses": [
                    {
                        "sense_id": "ce93ee8d-a257-30e2-920b-03e72c607b63",
                        "entry_id": "cd95b9c2-fd9c-353a-828a-2286564bdd12",
                        "glosses": [
                            "To make wavy; to crimp."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7716f7a5-7170-4993-9501-198dd3103b1f",
                                "sense_id": "ce93ee8d-a257-30e2-920b-03e72c607b63",
                                "text": "On the back of a chair beside the bed sits perched above the discarded chip hat something apparently precious and taken from the opened bundle on the floor: a flat white cambric hat, its fronts and sides goffered into little flutes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "28f94c74-fb9d-4122-b80c-4905e8c0d8ea",
                        "source_entry_id": "cd95b9c2-fd9c-353a-828a-2286564bdd12",
                        "source_sense_id": "ce93ee8d-a257-30e2-920b-03e72c607b63",
                        "source_sense_description": "To make wavy; to crimp",
                        "target_lang_word": "karbować",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "karbować",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "8689a6fb-87ed-33a7-a9b1-4137399615c3",
                                        "entry_id": "927700ae-185f-3cae-9818-a94e5ccdcf80",
                                        "glosses": [
                                            "robić na czym karby"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a5a5a0f6-596b-4e9c-9237-c85e738dd1b3",
                                                "sense_id": "8689a6fb-87ed-33a7-a9b1-4137399615c3",
                                                "text": "Murzyni z dalekich zakątków Afryki karbowali na kijach swoje znaki oddając w ten sposób swój głos za pokojem."
                                            },
                                            {
                                                "example_id": "df871589-9987-44dd-8807-981f64aed1ab",
                                                "sense_id": "8689a6fb-87ed-33a7-a9b1-4137399615c3",
                                                "text": "Owóż, gdy śniegi spadły, obliczano żubry w ten sposób, że każdy młodszy leśnik karbował na kiju wedle śladów wszystkie sztuki, które weszły do jego ostępu lub z niego wyszły."
                                            },
                                            {
                                                "example_id": "56ca488e-cb28-4bf8-b714-012ad74927e0",
                                                "sense_id": "8689a6fb-87ed-33a7-a9b1-4137399615c3",
                                                "text": "Po jednej stronie kija karbowano pieniężną wartość materyałów (sic!) [materiałów] wydanych na kredyt, po drugiej sumy na ten dług uiszczone[,] [a u końca kija wisiała kartka, na której było wypisane nazwisko klienta.] Taka[ ]to była ówczesna książkowość [księgowość] kupiecka, [praktykowana w całej Europie przez wiele wieków, a z której się później wywiązała buchhalterya (sic!) [buchalteria] podwójna, używana dzisiaj powszechnie.]"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
