                                        "entry_id": "c61cdccb-7c6e-343d-ac92-40aa0c7be169",
                                        "glosses": [
                                            "The act of repelling or the condition of being repelled."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d5432840-5f54-3a29-b659-aca08f77c7ac",
                                        "entry_id": "c61cdccb-7c6e-343d-ac92-40aa0c7be169",
                                        "glosses": [
                                            "An extreme dislike of something, or hostility to something."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "315e5f68-0b98-41fc-9541-255928e96283",
                                                "sense_id": "d5432840-5f54-3a29-b659-aca08f77c7ac",
                                                "text": "All this was extraordinarily distasteful to Churchill. It was ugly, gross. Never before had he felt such repulsion when the vicar displayed his characteristic bluntness or coarseness of speech. In the present connexion[…] such talk had been distressingly out of place."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c5b3d2ed-16bd-3a82-8ab4-8db7a40d01ab",
                                        "entry_id": "c61cdccb-7c6e-343d-ac92-40aa0c7be169",
                                        "glosses": [
                                            "The repulsive force acting between bodies of the same electric charge or magnetic polarity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4546419a-262a-4d8b-88ee-75928a449680",
                        "source_entry_id": "e53b583d-d856-33ca-aa08-4fed0d6fd4ca",
                        "source_sense_id": "c0b11110-7b21-394a-a63c-678b87bad6f0",
                        "source_sense_description": "een kracht die twee voorwerpen zich van elkaar doet verwijderen.",
                        "target_lang_word": "répulsion",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
