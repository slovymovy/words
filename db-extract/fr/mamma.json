                "senses": [
                    {
                        "sense_id": "b5dd99b9-cec7-35fc-9dc1-8a6767be3fab",
                        "entry_id": "d684ce75-048c-333e-bf84-b95789896ceb",
                        "glosses": [
                            "Mère, maman, italienne, ou corse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5209210a-64c6-4cac-9671-a41b8fc6e239",
                                "sense_id": "b5dd99b9-cec7-35fc-9dc1-8a6767be3fab",
                                "text": "Elle va mourir, la mamma"
                            },
                            {
                                "example_id": "0c9841e5-b70e-41e2-be27-97653f58f103",
                                "sense_id": "b5dd99b9-cec7-35fc-9dc1-8a6767be3fab",
                                "text": "Tu n’es pas bavard et c’est dommage. Pour toi, bien sûr, et pour ta mamma."
                            },
                            {
                                "example_id": "6248370e-4c06-4409-bd1d-533ed34942c9",
                                "sense_id": "b5dd99b9-cec7-35fc-9dc1-8a6767be3fab",
                                "text": "– Il faut prier, dit la mamma."
                            },
                            {
                                "example_id": "76de1f8e-44b4-4b3d-a9e7-006a18eb3d5c",
                                "sense_id": "b5dd99b9-cec7-35fc-9dc1-8a6767be3fab",
                                "text": "Dans vingt ans, si elle ne se surveille pas, ce sera une plantureuse mamma aux cheveux couleur de nuit comme les Incas dont elle doit aussi tenir et aux yeux mystérieusement bleus."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "f709fdd4-9878-31c7-bfb3-982f404bf10d",
                "word": "mamma",
