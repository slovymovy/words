                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "19f80aa5-6eb6-4878-a90d-eecf8669d11c",
                        "source_entry_id": "401dfa21-ccdd-3b16-82e7-368e85d18151",
                        "source_sense_id": "67433c7b-f95f-3d1c-974e-34c8c9e04515",
                        "target_lang_word": "Eishockeyspieler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Eishockeyspieler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7882724e-7e4f-3da9-a02f-115c7a73520e",
                                        "entry_id": "8df5174c-5c80-3acb-a1cc-984541e478d1",
                                        "glosses": [
                                            "Person, die die Sportart Eishockey ausübt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61edde10-b947-4e38-89e5-171caa739f5c",
                                                "sense_id": "7882724e-7e4f-3da9-a02f-115c7a73520e",
                                                "text": "„Die tschechischen Eishockeyspieler sind derzeit die besten in der Welt.“"
                                            },
                                            {
                                                "example_id": "23706227-f0cb-45e0-8961-b1827aa4435d",
                                                "sense_id": "7882724e-7e4f-3da9-a02f-115c7a73520e",
                                                "text": "„Fußballer ziehen sich immer den linken vor dem rechten Schuh an, Eishockeyspieler rasieren sich während der siegreichen Playoff-Zeit nicht und manch ein Turner küsst vor seiner Kür den Holm.“"
                                            },
                                            {
                                                "example_id": "f3326647-a872-44a0-91d7-bbde8aa63dbf",
                                                "sense_id": "7882724e-7e4f-3da9-a02f-115c7a73520e",
                                                "text": "„In Kanada halten sich während der Sommermonate viele Eishockeyspieler mit Lacrosse fit.“"
                                            },
                                            {
                                                "example_id": "55094e9b-7ccb-48ea-ae9a-b17343ee7626",
                                                "sense_id": "7882724e-7e4f-3da9-a02f-115c7a73520e",
                                                "text": "„Der plötzliche Tod des tschechischen Eishockeyspielers Jaroslav Hauer am Wochenende während eines Regionalspiels im deutschen Straubingen ist laut Nachrichtenagentur ctk auf ein akutes Herzversagen zurückzuführen.“"
                                            },
                                            {
                                                "example_id": "7f8fe7a7-c64f-4e6d-8d15-824b8b94c963",
                                                "sense_id": "7882724e-7e4f-3da9-a02f-115c7a73520e",
                                                "text": "„Der tschechische Staatspräsident Vaclav Havel hat den tschechischen Eishockeyspielern gleich nach ihrem Sieg im dramatischen Finalspiel ein Glückwunschtelegramm übermittelt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
