                "senses": [
                    {
                        "sense_id": "06036e1b-bcec-3d4e-870f-367e29bb7fb8",
                        "entry_id": "ef006d0d-e5fd-3889-b82f-3fcd1017dd24",
                        "glosses": [
                            "Juron marquant une vive humeur nuancée d’indignation."
                        ],
                        "tags": [
                            "dated",
                            "euphemism"
                        ],
                        "examples": [
                            {
                                "example_id": "961b46f0-394c-4274-996c-304b952f1680",
                                "sense_id": "06036e1b-bcec-3d4e-870f-367e29bb7fb8",
                                "text": "« Qu’allais-tu faire à la fontaine, corbleu, Marion ? » est le type même de la complainte du mari trompé."
                            },
                            {
                                "example_id": "83c2638b-8f41-4bc6-ae7f-161fc9c9da90",
                                "sense_id": "06036e1b-bcec-3d4e-870f-367e29bb7fb8",
                                "text": "— Corbleu, je suis plus votre ami que vous ne pensez, car dès la première rencontre, j’aurais pu, en disant un mot au cardinal, vous faire couper le cou."
                            },
                            {
                                "example_id": "22eb0b24-8937-40a0-8d92-e0e96ff54b86",
                                "sense_id": "06036e1b-bcec-3d4e-870f-367e29bb7fb8",
                                "text": "— Et corbleu ! monsieur, à qui parlez-vous ? Puis-je rien comprendre à ce régime nouveau sous lequel vit la France ?"
                            },
                            {
                                "example_id": "6d651228-a8af-4e48-ab6f-d35feb3595a5",
                                "sense_id": "06036e1b-bcec-3d4e-870f-367e29bb7fb8",
                                "text": "Corbleu ! qu’est-ce que c’est que ça ?"
                            },
                            {
                                "example_id": "484d5a81-ba96-4a2c-8311-774c700fa676",
                                "sense_id": "06036e1b-bcec-3d4e-870f-367e29bb7fb8",
                                "text": "Je suis chez moi, j’y reste, et resterai, corbleu, si longtemps que je peux."
                            },
                            {
                                "example_id": "ee3a053d-c340-4685-b0c5-7d021e7856e3",
                                "sense_id": "06036e1b-bcec-3d4e-870f-367e29bb7fb8",
                                "text": "« La jolie fille… corbleu ! — Oui… mais le vieux n’a pas l’air tendre, » fit un autre."
                            }
                        ]
                    }
                ],
