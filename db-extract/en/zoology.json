                                                "example_id": "33a80910-6eaf-4cd3-97b6-7638b4ff08ac",
                                                "sense_id": "9b72493d-5d4a-3320-8e26-467d005f2783",
                                                "text": "„Kennzeichnend für diese einzigartige Naturlandschaft sind die zahlreichen Bäche, Flüsse, Stauseen sowie die großflächigen Laubwälder mit ihrer seltenen Flora und Fauna.“"
                                            },
                                            {
                                                "example_id": "da6b5e4f-515c-41f8-b48d-d93b78642cd5",
                                                "sense_id": "9b72493d-5d4a-3320-8e26-467d005f2783",
                                                "text": "„Dabei stimmt das nicht, in Island ist nur alles viel kleiner als anderswo, auch die Flora und Fauna.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
