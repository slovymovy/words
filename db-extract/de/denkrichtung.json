                "senses": [
                    {
                        "sense_id": "6c04423f-5c6c-3ca6-b4a6-f0d5df10499c",
                        "entry_id": "1f488d35-8e13-3f64-82f0-936da606aa15",
                        "glosses": [
                            "Ausrichtung, Ziel eines Gedankens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "390e8b86-b33b-4a3a-8291-ccbed057f2e7",
                                "sense_id": "6c04423f-5c6c-3ca6-b4a6-f0d5df10499c",
                                "text": "„Die andere Denkrichtung stellt die verkäuferische Kompetenz in den Vordergrund.“"
                            },
                            {
                                "example_id": "999bcbe8-8b49-4e94-8d0e-8d703767924b",
                                "sense_id": "6c04423f-5c6c-3ca6-b4a6-f0d5df10499c",
                                "text": "„Nicht nur in seinem Fach bleiben, sondern über den Tellerrand blicken und mit Kollegen aus anderen Fächern arbeiten, auch das hat Tradition in Karlsruhe. Oberstes Ziel sei dabei immer ‚die Offenheit für andere Denkrichtungen‘, betont der Geschäftsführer des DFG-Zentrums, Christian Röthig.“"
                            },
                            {
                                "example_id": "3f513cbf-8b08-48e2-bb77-36a1aeff90ae",
                                "sense_id": "6c04423f-5c6c-3ca6-b4a6-f0d5df10499c",
                                "text": "„Eigentlich bezeichnet dieser Begriff eine historische Denkrichtung, die angesichts der Weltwirtschaftskrise der späten zwanziger und frühen dreißiger Jahre des vergangenen Jahrhunderts nicht etwa weniger, sondern mehr staatliche Rahmensetzung forderte, um die Funktionsfähigkeit der Wirtschaft zu verbessern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
