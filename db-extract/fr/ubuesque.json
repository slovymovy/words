                ],
                "senses": [
                    {
                        "sense_id": "dbc4bdef-af0c-38dc-9f72-c73306367af4",
                        "entry_id": "fa05ebeb-9cd7-301a-ab82-ebbf9d94d56b",
                        "glosses": [
                            "D’un comique grotesque et démesuré, poussé jusqu’à l’absurde."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af969524-77bb-4afc-8eb5-c32f7c3918d6",
                                "sense_id": "dbc4bdef-af0c-38dc-9f72-c73306367af4",
                                "text": "Un roi ubuesque avec sa cour et son palais baroque construit en dehors d’Erevan, dans lequel, raconte-t-on, il avait fait venir deux lions qui ont fini par dépérir."
                            },
                            {
                                "example_id": "e7548097-b748-47b4-be57-82e47ad0ea6a",
                                "sense_id": "dbc4bdef-af0c-38dc-9f72-c73306367af4",
                                "text": "Mais tous font état d’un système d’une complexité inouïe. Dans les faits, sa mise en œuvre se révèle coûteuse, incertaine, voire même ubuesque."
                            },
                            {
                                "example_id": "74df588d-1c6f-469d-a138-4c9219e62ac3",
                                "sense_id": "dbc4bdef-af0c-38dc-9f72-c73306367af4",
                                "text": "La décision initiale de Radio-­Canada de censurer un épisode d’une série-culte est complètement ridicule. Misère ! On parle ici d’une série ubuesque, où les lits sont verticaux et les vidanges sont sacrées !"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f4bcff19-b793-43f4-8d0a-4b2778cac93d",
                        "source_entry_id": "fa05ebeb-9cd7-301a-ab82-ebbf9d94d56b",
                        "source_sense_id": "dbc4bdef-af0c-38dc-9f72-c73306367af4",
                        "target_lang_word": "absurd",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "absurd",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cf143fd3-8348-362a-9d28-f192dccd6719",
                                        "entry_id": "308b684a-ed00-3872-b03f-652769f1e121",
                                        "glosses": [
                                            "widersinnig, dem gesunden Menschenverstand widersprechend, abwegig, sinnlos"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c390d369-1069-4900-b79b-cf3575be97ff",
                                                "sense_id": "cf143fd3-8348-362a-9d28-f192dccd6719",
                                                "text": "Die Vorschläge scheinen mir allesamt vollkommen absurd zu sein."
                                            },
                                            {
                                                "example_id": "57205d17-07aa-4df8-ab0e-04ebe47b9549",
                                                "sense_id": "cf143fd3-8348-362a-9d28-f192dccd6719",
                                                "text": "„Es ist absurd, dass – obwohl wir um den Klimawandel wissen – der Markt für SUVs boomt und die Autos immer größer werden. Es ist absurd, dass so viele Flugzeuge in der Luft sind wie noch nie und es billiger ist, von Berlin nach München zu fliegen als mit dem Zug zu fahren.“"
                                            },
                                            {
                                                "example_id": "643a0327-95da-4950-83bb-87e4c332e035",
                                                "sense_id": "cf143fd3-8348-362a-9d28-f192dccd6719",
                                                "text": "„Dieser Roman ist eigentlich kein Roman, sondern ein überbordendes Märchen, eine absurde Jetset-Story, eine dick aufgetragene Sinnsuche, die in Österreich beginnt und auf dem Mount Everest endet, wo hoch oben auf dem Gipfel die Erkenntnis liegt oder die Verzweiflung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "043ec3ff-2caa-47c7-a600-e03a383c51a9",
                        "source_entry_id": "fa05ebeb-9cd7-301a-ab82-ebbf9d94d56b",
                        "source_sense_id": "dbc4bdef-af0c-38dc-9f72-c73306367af4",
                        "target_lang_word": "grotesk",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grotesk",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "907e928c-e9f3-37d1-945b-08f0af9335df",
                                        "entry_id": "55c2dcdb-32e6-3f77-957b-f74b18981991",
                                        "glosses": [
                                            "absonderliche und fantastische Wirkung durch Übersteigerung nach sich ziehend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9608eb92-f17c-4e32-8baa-2b36a680a33e",
                                                "sense_id": "907e928c-e9f3-37d1-945b-08f0af9335df",
                                                "text": "„Damals hatte Stefan seine Eltern besucht, die ihm wie unsagbar traurige, groteske Gestalten einer verlorenen Welt erschienen.“"
                                            },
                                            {
                                                "example_id": "3b9d2391-b0be-440c-acad-a89e413c5ece",
                                                "sense_id": "907e928c-e9f3-37d1-945b-08f0af9335df",
                                                "text": "„Mir brachten sie die fürchterlichste Qual – anderen werden sie vielleicht nicht mehr scheinen als groteske Zufälligkeiten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
