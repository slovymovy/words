                                "target_senses": [
                                    {
                                        "sense_id": "5edc976c-ae46-380f-a9ed-b86f245407c1",
                                        "entry_id": "994d8d89-78ce-3b00-ac1f-50865760453d",
                                        "glosses": [
                                            "Prénom féminin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4778bcb8-ddb4-4158-b435-2fb2a1b607d0",
                                                "sense_id": "5edc976c-ae46-380f-a9ed-b86f245407c1",
                                                "text": "Après plus de sept ans dans le prêt-à-porter, la Clodoaldienne Patricia Chiche a choisi de s’installer dans ce quartier qu’elle affectionne particulièrement."
                                            },
                                            {
                                                "example_id": "2e79ef74-b649-46cf-a3ff-0454a7021156",
                                                "sense_id": "5edc976c-ae46-380f-a9ed-b86f245407c1",
                                                "text": "Le cercle des écrivains propose une heure de lectures sur le thème de la mer par Josette Bouvet Le Meur et Patricia Guillemain."
                                            },
                                            {
                                                "example_id": "0b2ebf43-f021-4da7-8621-612b943be3f7",
                                                "sense_id": "5edc976c-ae46-380f-a9ed-b86f245407c1",
                                                "text": "Il est dirigé par Ulrich Gicquel qui sera aidé par Patricia Argouach et Dorian Degorge."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
