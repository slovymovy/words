                "senses": [
                    {
                        "sense_id": "3c222d4c-e2bc-3987-ab35-8bb04abe01f8",
                        "entry_id": "49216549-eaff-318b-9b7c-70e365d96218",
                        "glosses": [
                            "größtes, wichtigstes Tor einer Anlage/eines Gebäudes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3d85028-61ab-4f1f-8285-9035cbb9bb46",
                                "sense_id": "3c222d4c-e2bc-3987-ab35-8bb04abe01f8",
                                "text": "„Als die Frauen bei Sonnenuntergang mit ihren Gästen zum Haupttore gegangen waren und diese sich in ihren Sänften entfernt hatten, hielten sie sich noch eine kurze Zeit am Portal auf.“"
                            },
                            {
                                "example_id": "85c836d2-bccf-438c-914d-5bfaf8a0df64",
                                "sense_id": "3c222d4c-e2bc-3987-ab35-8bb04abe01f8",
                                "text": "„Anfang des 21. Jahrhunderts stieß man bei Grabungen (Leiter: Thoms Krekel) südwestlich des Haupttores auf eine Bastion mit kleiner Toröffnung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
