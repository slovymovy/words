                            }
                        },
                        {
                            "text": "He cleaned the small cut by <w>dabbing</w> it with antiseptic liquid.",
                            "target_lang_translations": {
                                "nl": "Hij maakte het kleine sneetje schoon door het te <w>deppen</w> met ontsmettingsmiddel."
                            }
                        }
                    ],
                    "common_phrases": [
