                        "satter Sound",
                        "typischer Sound"
                    ]
                },
                {
                    "sense_id": "ab4da4f2-f99d-3aa1-879c-d3ffe1255b47",
                    "sense_definition": "Akustisches Signal, digitaler Ton oder Geräusch, etwa bei elektronischen Geräten oder Medien.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "signal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sobald eine neue Nachricht eintrifft, spielt das Smartphone einen kurzen <w>Sound</w> ab."
                        },
                        {
                            "text": "In diesem Computerspiel wurden viele verschiedene <w>Sounds</w> für Schritte und Schüsse aufgenommen."
