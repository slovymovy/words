                "entry_id": "ad3ab529-b54a-3248-90a4-dc089e6010e2",
                "word": "gastrointestinal",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "67257d60-1792-3b0c-bb9b-7bbebd3cd7c9",
                        "entry_id": "ad3ab529-b54a-3248-90a4-dc089e6010e2",
                        "glosses": [
                            "Of or pertaining to the stomach and intestines, and thus to digestion."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "4a9de403-339b-46dd-bdf0-f54cf0a06fbe",
                                "sense_id": "67257d60-1792-3b0c-bb9b-7bbebd3cd7c9",
                                "text": "Avian pox viruses (Poxviridae), are chordopoxviruses that infect domestic and wild game birds including hawks, seagulls, parrots, canaries, pigeons, hawks and fowl, causing cutaneous, respiratory and gastrointestinal lesions in their host [17 ]."
                            },
                            {
                                "example_id": "d453fdb3-342b-4f2b-9c16-d10aad61cea5",
                                "sense_id": "67257d60-1792-3b0c-bb9b-7bbebd3cd7c9",
                                "text": "She has always struggled with her gastrointestinal health, and when she started to have symptoms similar to those of colorectal cancer, she called her primary care physician, who referred her to a gastroenterologist, who ordered a colonoscopy. She did not have cancer."
                            }
                        ]
                    }
                ],
