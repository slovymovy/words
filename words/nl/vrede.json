                {
                    "sense_id": "a4b82707-f5f6-37e9-ac9d-1fc80e1e33d0",
                    "sense_definition": "De toestand waarin er geen oorlog of gewapend conflict is.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "absence_of_war",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De twee landen leven al jaren in <w>vrede</w> met elkaar.",
                            "target_lang_translations": {
                                "en": "The two countries have lived in <w>peace</w> with each other for years.",
                                "ru": "Две страны уже много лет живут в <w>мире</w> друг с другом.",
                                "pl": "Oba kraje od lat żyją ze sobą w <w>pokoju</w>.",
                                "de": "Die beiden Länder leben seit Jahren in <w>Frieden</w> miteinander.",
                                "fr": "Les deux pays vivent en <w>paix</w> l'un avec l'autre depuis des années.",
                                "it": "I due paesi vivono in <w>pace</w> tra loro da anni.",
                                "cs": "Obě země spolu již léta žijí v <w>míru</w>.",
                                "tr": "İki ülke yıllardır birbiriyle <w>barış</w> içinde yaşıyor.",
                                "es": "Los dos países llevan años viviendo en <w>paz</w> el uno con el otro."
                            }
                        },
                        {
                            "text": "Het is voor de regering moeilijk om de <w>vrede</w> te bewaren.",
                            "target_lang_translations": {
                                "en": "It is difficult for the government to keep the <w>peace</w>.",
                                "ru": "Правительству трудно сохранять <w>мир</w>.",
                                "pl": "Rządowi trudno jest utrzymać <w>pokój</w>.",
                                "de": "Es ist für die Regierung schwierig, den <w>Frieden</w> zu bewahren.",
                                "fr": "Il est difficile pour le gouvernement de maintenir la <w>paix</w>.",
                                "it": "È difficile per il governo mantenere la <w>pace</w>.",
                                "cs": "Pro vládu je těžké udržet <w>mír</w>.",
                                "tr": "Hükümet için <w>barışı</w> korumak zor.",
                                "es": "Es difícil para el gobierno mantener la <w>paz</w>."
                            }
                        }
                    ],
                    "antonyms": [
                        "oorlog",
                        "conflict"
                    ],
                    "common_phrases": [
                        "vrede sluiten",
                        "in vrede leven",
                        "vrede op aarde"
                    ],
                    "target_lang_definitions": {
                        "en": "The state in which there is no war or armed conflict.",
                        "ru": "Состояние, при котором нет войны или вооруженного конфликта.",
                        "pl": "Stan, w którym nie ma wojny ani konfliktu zbrojnego.",
                        "de": "Der Zustand, in dem kein Krieg oder bewaffneter Konflikt herrscht.",
                        "fr": "L'état dans lequel il n'y a pas de guerre ou de conflit armé.",
                        "it": "La condizione in cui non vi è guerra o conflitto armato.",
                        "cs": "Stav, ve kterém není válka nebo ozbrojený konflikt.",
                        "tr": "Savaşın veya silahlı çatışmanın olmadığı durum.",
                        "es": "El estado en el que no hay guerra ni conflicto armado."
                    },
