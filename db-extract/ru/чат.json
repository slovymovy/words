                                            {
                                                "example_id": "8f77a206-3eaa-4082-a9ec-eabd20d2f1c3",
                                                "sense_id": "0581a586-a9d3-3883-b3f7-6147ee6d9f44",
                                                "text": "\"Type yes in (the) chat if you can hear me.\""
                                            },
                                            {
                                                "example_id": "7db83a9d-c9af-45ac-a102-310eee82c5b8",
                                                "sense_id": "0581a586-a9d3-3883-b3f7-6147ee6d9f44",
                                                "text": "While there are chats for various interest groups (games, Internet, sports), you can also […]"
