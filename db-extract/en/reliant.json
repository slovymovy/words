                                        "glosses": [
                                            "nicht ohne etwas oder jemanden zurechtkommend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e59129f2-a01b-41eb-a293-cba6869dda2f",
                                                "sense_id": "7ead9994-4d2a-3822-9c3a-0b261bb56289",
                                                "text": "Eine Million Menschen sind von internationalen Lebensmittelhilfen abhängig."
                                            },
                                            {
                                                "example_id": "7c3818db-d6fd-485b-9b77-9ee3803799a9",
                                                "sense_id": "7ead9994-4d2a-3822-9c3a-0b261bb56289",
                                                "text": "„[…] Die Finanzindustrie war vom billigen Geld [Anmerkung: der US-Notenbank FED] abhängig geworden und verlangte wie ein Suchtkranker nach weiteren Injektionen.“"
                                            },
                                            {
                                                "example_id": "eaff36e2-b1b6-4936-937f-6dac98a39661",
                                                "sense_id": "7ead9994-4d2a-3822-9c3a-0b261bb56289",
                                                "text": "[Schlagzeile:] „Die Welt ist noch jahrzehntelang abhängig vom Öl“"
                                            },
                                            {
                                                "example_id": "5427cc71-9ccb-400a-88d5-6f15efe4f5d6",
                                                "sense_id": "7ead9994-4d2a-3822-9c3a-0b261bb56289",
                                                "text": "„Im vergangenen Jahr 2021 stieg der Anteil der deutschen Gasimporte aus Russland dann auf fast 60 Prozent. Das Land machte sich damit extrem von Russland abhängig.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "69722e8a-4a51-39a9-bc14-268275c3e310",
                                        "entry_id": "9e85c2d5-062f-347e-8ecb-95a4d89a9dc2",
                                        "glosses": [
                                            "nicht eigenständig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8bcbdf5e-2fd4-40a2-a4d2-8896e3a23c82",
                                                "sense_id": "69722e8a-4a51-39a9-bc14-268275c3e310",
                                                "text": "Sie ist von ihrem Mann so abhängig, dass sie ohne ihn außer Hause nichts erledigen kann."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "fa503fb8-d89f-3f28-a295-9ac06ba22a29",
                                        "entry_id": "9e85c2d5-062f-347e-8ecb-95a4d89a9dc2",
                                        "glosses": [
                                            "nach etwas süchtig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e95b9ce-abfb-456e-aae8-3cd1eca7b5a2",
                                                "sense_id": "fa503fb8-d89f-3f28-a295-9ac06ba22a29",
                                                "text": "Ich war jahrelang abhängig, doch nun bin ich auf Entzug."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "6442c432-d9eb-35d6-b676-4f0c7806af1b",
                                        "entry_id": "9e85c2d5-062f-347e-8ecb-95a4d89a9dc2",
