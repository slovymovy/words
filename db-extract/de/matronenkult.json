                "senses": [
                    {
                        "sense_id": "8c366199-e788-3d95-b426-5876a3d9c2e6",
                        "entry_id": "ab6ceb41-dfbe-3c91-a5df-895e53b2329d",
                        "glosses": [
                            "Kult der Dreimütter; heilige drei Frauen in ihrer Dreifaltigkeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5671e98a-6ba0-452a-a02f-1a0d64a934d2",
                                "sense_id": "8c366199-e788-3d95-b426-5876a3d9c2e6",
                                "text": "„Besonders reizvoll ist es zu sehen, wie sich das in spätrömischer und frühfränkischer Zeit in unserer Heimat sich ausbreitende Christentum zum Matronenkult verhielt.“"
                            },
                            {
                                "example_id": "c13500eb-8160-4a0e-b538-af0270db1505",
                                "sense_id": "8c366199-e788-3d95-b426-5876a3d9c2e6",
                                "text": "„So wie dieser Platz noch heute als ein Ort von besonderer Kraft erfahren wird, wussten schon die hier stationierten Römer diese alte Kultstätte zu würdigen, indem sie den Matronenkult aus vorrömischer Zeit übernahmen.“"
                            },
                            {
                                "example_id": "2ec81f39-9cea-4fe5-ac32-afa9a80248af",
                                "sense_id": "8c366199-e788-3d95-b426-5876a3d9c2e6",
                                "text": "„Im Matronenkult kommt für die Verehrung von Muttergottheiten auch der Begriff Matres und Matrae vor.“"
                            },
                            {
                                "example_id": "333506f0-143d-48b4-b0ab-cf9377cbc805",
                                "sense_id": "8c366199-e788-3d95-b426-5876a3d9c2e6",
                                "text": "„Niedergermanien ist die Provinz der Matronenkulte, und die Dominanz dieser Göttinnen läßt sich auch an den Verhältnissen im römischen Bonn wiedererkennen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
