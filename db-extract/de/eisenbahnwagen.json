                "senses": [
                    {
                        "sense_id": "da02ec52-e504-3c17-8ca9-83d9ca5e0939",
                        "entry_id": "0ed7ec91-a53e-3b32-bc64-5cd091103e0d",
                        "glosses": [
                            "ein Schienenfahrzeug ohne eigenen Antrieb"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73db0e74-805f-4892-9cc7-44b5e8cda165",
                                "sense_id": "da02ec52-e504-3c17-8ca9-83d9ca5e0939",
                                "text": "Der Eisenbahnwagen ist sauber und bequem."
                            },
                            {
                                "example_id": "6e5c84b7-5dfa-40e8-a035-2ba6d5868381",
                                "sense_id": "da02ec52-e504-3c17-8ca9-83d9ca5e0939",
                                "text": "„Sie setzten mich auf meine Trage und dann in einen niedrigen Eisenbahnwagen mit vielen kleinen Fenstern.“"
                            },
                            {
                                "example_id": "a309249c-7f40-4863-9632-d61ea2845b43",
                                "sense_id": "da02ec52-e504-3c17-8ca9-83d9ca5e0939",
                                "text": "„Immer und überall in der Welt macht man doch in einem Eisenbahnwagen dieselben Erfahrungen.“"
                            },
                            {
                                "example_id": "af131790-b783-4168-9abd-87771821b469",
                                "sense_id": "da02ec52-e504-3c17-8ca9-83d9ca5e0939",
                                "text": "„Die »Seehunde« wurden auf Eisenbahnwagen verladen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
