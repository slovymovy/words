                    }
                ],
                "senses": [
                    {
                        "sense_id": "d4f81976-1fe1-38d6-ac53-43da7413010c",
                        "entry_id": "46804760-77e7-36a9-b673-93579d5cdc19",
                        "glosses": [
                            "Fait de fignoler, de rendre parfait quelque chose en soignant les détails."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "46ab2162-93f0-4008-a2da-01e2280f6ac1",
                                "sense_id": "d4f81976-1fe1-38d6-ac53-43da7413010c",
                                "text": "Pas d’amour sur l’arçon de la selle, pas de rapides contacts de poulailler, mais pas non plus de ces fignolages d’alcôve de nos pères, pas de figures de patinage sous les glaces du baldaquin, pas de ces séries au billard qui n’amusent plus que les vieux messieurs quand ils en ont encore les moyens."
                            },
                            {
                                "example_id": "62e344e7-078a-4ba1-9733-bff4c7d53a4c",
                                "sense_id": "d4f81976-1fe1-38d6-ac53-43da7413010c",
                                "text": "J’achoppai à tous les travaux pratiques et le fignolage ne fut jamais mon fort."
                            },
                            {
                                "example_id": "428f81e6-13e8-4f56-8c9f-4ee03c610e79",
                                "sense_id": "d4f81976-1fe1-38d6-ac53-43da7413010c",
                                "text": "La conception de tout cela, sa mise en place, son fignolage, embrasait le Maître et ses fidèles serviteurs, ses fervents."
                            },
                            {
                                "example_id": "25fbeb6f-ebd3-4abf-91e5-8e0efb5d3416",
                                "sense_id": "d4f81976-1fe1-38d6-ac53-43da7413010c",
                                "text": "Aussi, ne manqua-t-il jamais d’illustrateurs qui mirent le fignolage de leurs traits au diapason du fignolage des mots."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
