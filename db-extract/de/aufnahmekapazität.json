                ],
                "senses": [
                    {
                        "sense_id": "f2c2cfb6-6092-3a08-809f-5f795702f58b",
                        "entry_id": "c550ab69-165e-39c0-a6da-f77117c92bdf",
                        "glosses": [
                            "Fähigkeit und Umfang der Möglichkeit zur Integration"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6d1588e-676f-4919-9b2a-467be7c71cf5",
                                "sense_id": "f2c2cfb6-6092-3a08-809f-5f795702f58b",
                                "text": "„Diese [Schelllackplatten] besaßen nur eine begrenzte Aufnahmekapazität von ca. 4 Minuten, so dass eine Zusammenstellung von Titeln aus einem Album (Steckalbum) mehrerer solcher Platten bestand.“"
                            },
                            {
                                "example_id": "4aba76db-6d86-4a2d-9520-d830d99b23c4",
                                "sense_id": "f2c2cfb6-6092-3a08-809f-5f795702f58b",
                                "text": "„Deshalb hängt auch die Aufnahmekapazität für das Treibhausgas Kohlenstoffdioxid entscheidend von ihrer biologischen und kalkbildenden Aktivität ab.“"
                            },
                            {
                                "example_id": "0612128d-0195-4567-9ce0-8df9b96a9453",
                                "sense_id": "f2c2cfb6-6092-3a08-809f-5f795702f58b",
                                "text": "„Die Verbandsgemeinde Herrstein richtete 1995 schließlich einen zweigruppigen Kindergarten mit einer Aufnahmekapazität von 50 Kindern im Alter von drei bis sechs Jahren ein, der ebenfalls für den Nachwuchs der Nachbarortschaften Berschweiler, Griebelschied und Sonnschied offensteht.“"
                            },
                            {
                                "example_id": "b4f82753-abc4-483d-9ae2-793a2fefd94e",
                                "sense_id": "f2c2cfb6-6092-3a08-809f-5f795702f58b",
                                "text": "„Wird dabei die Aufnahmekapazität einer der beiden Hochschulen überschritten, entscheidet über die Zuteilung an eine der beiden Hochschulen das Ergebnis des 1. Abschnittes der Ärztlichen Prüfung (leistungsgesteuertes Optionsverfahren).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
