                "senses": [
                    {
                        "sense_id": "71f29a63-fc27-3994-b388-03ce6f4a8993",
                        "entry_id": "797f426a-699c-3651-bbd1-591fbeeadf21",
                        "glosses": [
                            "Kommunikationsnetz zur Abwicklung von Telefonaten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0f644d3-80a8-4c4a-8fe8-84f61f17a482",
                                "sense_id": "71f29a63-fc27-3994-b388-03ce6f4a8993",
                                "text": "„Die Putschisten hatten den Flughafen geschlossen, das Telefonnetz der Stadt lahmgelegt, die Zentrale des Polizeihauptquartiers gestürmt, den Regierungssender besetzt und die Zentren der politischen Macht angegriffen.“"
                            },
                            {
                                "example_id": "4c31aa35-ab9e-48ea-b580-7af6da6c642f",
                                "sense_id": "71f29a63-fc27-3994-b388-03ce6f4a8993",
                                "text": "„Sämtliche Telefonnetze in die Türkei werden wie jedes Jahr zusammenbrechen, und man wird kurz nach Mitternacht glücklich einschlafen, weil doch noch eine Verbindung zustande gekommen ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
