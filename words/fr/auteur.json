    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d41d1055-d64c-3d5f-922f-1f3ada6a91bd",
                    "sense_definition": "Personne qui a écrit ou composé un livre, un texte ou une œuvre artistique.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "creation_artistique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "J'ai lu tous les romans de cet <w>auteur</w> avec un immense plaisir."
                        },
                        {
                            "text": "L'<w>auteur</w> de ce livre policier a reçu une belle récompense littéraire."
                        }
                    ],
                    "synonyms": [
                        "auteure",
                        "autrice"
                    ],
                    "common_phrases": [
                        "droits d'auteur",
                        "nom de l'auteur"
                    ]
                },
                {
                    "sense_id": "4aae43c7-114c-33fb-9f00-ed3e07951811",
                    "sense_definition": "Personne responsable d'un acte, en particulier d'un méfait ou d'une infraction.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "responsable",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La police cherche activement l'<w>auteur</w> du vol commis hier dans le centre commercial."
                        },
                        {
                            "text": "Les enquêteurs ont enfin découvert qui était l'<w>auteur</w> de cette mauvaise blague."
                        }
                    ],
                    "common_phrases": [
                        "auteur des faits",
                        "auteur du crime"
                    ]
                },
                {
                    "sense_id": "fb92c0ee-bcc0-30b9-ba58-93ef018ac8f3",
                    "sense_definition": "Personne qui est à l'origine d'un projet, d'un concept ou d'une découverte.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "inventeur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet ingénieur est l'<w>auteur</w> d'une innovation majeure dans le secteur médical."
                        },
                        {
                            "text": "Elle est la principale <w>auteur</w> de cette proposition de loi ambitieuse."
                        }
                    ],
                    "common_phrases": [
                        "auteur d'un projet",
                        "auteur d'une découverte"
                    ]
                },
                {
                    "sense_id": "3aabf676-cfb8-3da0-a99b-4a16d00732bf",
                    "sense_definition": "Ensemble des textes ou pensée d'un écrivain, pris comme objet d'étude.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "creation_artistique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pendant toute l'année scolaire, nous étudierons cet <w>auteur</w> classique en classe de français."
                        },
                        {
                            "text": "Il aime citer cet <w>auteur</w> pour appuyer chacun de ses arguments historiques."
                        }
                    ],
                    "common_phrases": [
                        "citer un auteur",
                        "étudier un auteur"
                    ]
                },
                {
                    "sense_id": "9831dd7f-a80a-3104-a7b5-e7b8fb06e688",
                    "sense_definition": "Titulaire légal des droits de propriété intellectuelle sur une création originale.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "droit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La loi protège l'<w>auteur</w> contre toute utilisation commerciale non autorisée de son travail."
                        },
                        {
                            "text": "Un contrat spécifique garantit à l'<w>auteur</w> un pourcentage sur chaque vente réalisée."
                        }
                    ],
                    "common_phrases": [
                        "société des auteurs"
                    ]
                }
            ]
        }
    ]
