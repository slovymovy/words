                                "target_senses": [
                                    {
                                        "sense_id": "52fa65f6-0bad-318d-b411-de41226dd38f",
                                        "entry_id": "4555b6d5-a072-32b0-9709-922b4748a4bc",
                                        "glosses": [
                                            "Variante de Iraq."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f6032f57-3312-4f48-98ce-73279fa7a9eb",
                                                "sense_id": "52fa65f6-0bad-318d-b411-de41226dd38f",
                                                "text": "C’est surtout la Turquie d’Asie qui fournit les meilleures laines, et principalement la province de l’Irak."
                                            },
                                            {
                                                "example_id": "7e03615d-e0c2-4779-896b-691384739fe7",
                                                "sense_id": "52fa65f6-0bad-318d-b411-de41226dd38f",
                                                "text": "Un anneau composé de soluble dans la pyridine pour 64 % en poids, de silice (sable, diatomées, foraminifères) pour 18 % et de sulfate de calcium pour 12 %, et datant de 3500 avant J. C. a été découvert à Ur en Irak du Sud."
                                            },
                                            {
                                                "example_id": "40b9dab5-0744-4042-83c7-39b6f2f38d4f",
                                                "sense_id": "52fa65f6-0bad-318d-b411-de41226dd38f",
                                                "text": "Si j'ai tant insisté sur les inconséquences de la politique américaine en Irak depuis 1990, c'est qu'elles ont créé les conditions d'une guerre de religion entre chiites et sunnites, dont nous ne pouvons aujourd'hui prévoir l'issue, sinon qu'elle aura d'immenses répercutions […]."
                                            },
                                            {
                                                "example_id": "76318d14-7242-4c8e-9907-5538be4c29f8",
                                                "sense_id": "52fa65f6-0bad-318d-b411-de41226dd38f",
                                                "text": "Le chef des 1,3 milliard de catholiques du monde s’est ainsi entretenu pendant près d'une heure avec le grand ayatollah Sistani, référence religieuse de la plupart des 200 millions de chiites d'Irak et d'ailleurs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d694d344-3d78-460f-a8e6-9de1b59529de",
                        "source_entry_id": "ec676728-7bcd-3883-b69a-bb968ab128e7",
                        "source_sense_description": "country",
                        "target_lang_word": "Irak",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Irak",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e9947344-08ae-3125-a013-65fc4984a277",
                                        "entry_id": "48572b51-8bbf-3027-a2ea-0c517cbadaf3",
                                        "glosses": [
                                            "Staat in Vorderasien"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "112f8540-28b8-441e-a1ae-ef368becbde3",
                                                "sense_id": "e9947344-08ae-3125-a013-65fc4984a277",
                                                "text": "Im Irak leben über 25 Millionen Menschen."
                                            },
                                            {
                                                "example_id": "35b5a624-17a1-46a7-b5f0-ebb8821c64d8",
                                                "sense_id": "e9947344-08ae-3125-a013-65fc4984a277",
                                                "text": "Mosul ist die zweitgrößte Stadt Iraks."
                                            },
                                            {
                                                "example_id": "9c29b5b9-3d9b-430c-ad3d-ea9dda971676",
                                                "sense_id": "e9947344-08ae-3125-a013-65fc4984a277",
                                                "text": "„Im Nordosten hat der Irak Anteil an den schroffen und verkarsteten Ketten des Taurus und des Sagrosgebirges, im Süden und Südwesten an der syrisch-arabischen Wüste.“"
                                            },
                                            {
                                                "example_id": "cbf4ca99-5deb-4a31-b734-03ed399449ab",
                                                "sense_id": "e9947344-08ae-3125-a013-65fc4984a277",
                                                "text": "„Da im Irak unterschiedliche Niederschlagsverhältnisse herrschen, gibt es ebenfalls unterschiedliche Vegetationsarten. Im Nordirak gibt es Strauchvegetation und vereinzelte Waldbestände.“"
                                            },
                                            {
                                                "example_id": "c5448070-7f1a-4579-9f01-ea93ae0e7112",
                                                "sense_id": "e9947344-08ae-3125-a013-65fc4984a277",
                                                "text": "„Angesichts des Stillstands bei der Regierungsbildung im Irak hat der UN-Sicherheitsrat Fortschritte in Bagdad angemahnt.“"
                                            },
                                            {
                                                "example_id": "4ea3bbf7-2683-4886-9fad-38b782c43094",
                                                "sense_id": "e9947344-08ae-3125-a013-65fc4984a277",
                                                "text": "„Die verstärkten Anschläge im Irak stellen nach den Worten von US-Präsident Barack Obama nicht die Abzugspläne für die US-Kampftruppen bis Ende August infrage.“"
                                            },
                                            {
                                                "example_id": "ca060bb8-b94a-481e-b9bb-bc6488bf576e",
                                                "sense_id": "e9947344-08ae-3125-a013-65fc4984a277",
                                                "text": "„Auch mit ſeinem Halbbruder Mohammed mußte er hernach theilen h); dieſer behielt Aderbidſchan und ihm ſelbst blieb nur die Herrſchaft des Oſtens und die Oberlehnsherrſchaft über beide Irak.“ (1821)"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
