                ],
                "translations": [
                    {
                        "translation_id": "45f98fd7-4589-48e5-bc28-fb47269ae83f",
                        "source_entry_id": "9d40f398-0d22-3b72-98e5-1e19f49c379b",
                        "source_sense_id": "67c72d11-f677-31ee-9b71-cfa3afa3a798",
