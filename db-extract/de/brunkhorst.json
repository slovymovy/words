                "senses": [
                    {
                        "sense_id": "f1a234b1-7256-30d1-b9bb-154108dd40f1",
                        "entry_id": "4abc6816-2d49-3e1c-bbab-cf2fa5ede06d",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05c39c4c-3efc-431b-9f59-2a7565ac36ab",
                                "sense_id": "f1a234b1-7256-30d1-b9bb-154108dd40f1",
                                "text": "Frau Brunkhorst ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "dc0e2e5c-3f2f-4cfd-bfe7-225dccfd2e5d",
                                "sense_id": "f1a234b1-7256-30d1-b9bb-154108dd40f1",
                                "text": "Herr Brunkhorst wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "b3441ef5-7eae-45fb-bfa3-7662cfa3aa25",
                                "sense_id": "f1a234b1-7256-30d1-b9bb-154108dd40f1",
                                "text": "Die Brunkhorsts fahren heute nach Rotterdam."
                            },
                            {
                                "example_id": "179ce92c-3a82-47b2-82b3-dca279abac45",
                                "sense_id": "f1a234b1-7256-30d1-b9bb-154108dd40f1",
                                "text": "Der Brunkhorst trägt nie die Pullover, die die Brunkhorst ihm strickt."
                            },
                            {
                                "example_id": "df723c06-bc1d-4bf8-809c-b5c4a29a9fbc",
                                "sense_id": "f1a234b1-7256-30d1-b9bb-154108dd40f1",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Brunkhorst kommt, geht der Herr Brunkhorst.“"
                            },
                            {
                                "example_id": "62348717-745c-42dc-867b-55c5640026be",
                                "sense_id": "f1a234b1-7256-30d1-b9bb-154108dd40f1",
                                "text": "Brunkhorst kommt und geht."
                            },
                            {
                                "example_id": "a210bac2-b90d-42f0-b152-e01bd8a00b2f",
                                "sense_id": "f1a234b1-7256-30d1-b9bb-154108dd40f1",
                                "text": "Brunkhorsts kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
