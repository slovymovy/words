                "senses": [
                    {
                        "sense_id": "5947ef27-22d9-31a1-865a-0efd4144ef0a",
                        "entry_id": "e8a8ee2c-af9c-32a6-b581-f927ac1f5404",
                        "glosses": [
                            "Laid."
                        ],
                        "tags": [
                            "rare",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "37fb740e-970f-4b98-bcb7-b8ff4a9e6be6",
                                "sense_id": "5947ef27-22d9-31a1-865a-0efd4144ef0a",
                                "text": "On se montrait les gens connus : Naquet, pareil à une araignée de water-closet, carabosse et chevelu."
                            },
                            {
                                "example_id": "8245485c-9af2-4a0e-a43f-1fed4dfa8f21",
                                "sense_id": "5947ef27-22d9-31a1-865a-0efd4144ef0a",
                                "text": "Une fleur de douleur qui faisait carabosse à la place du sang."
                            },
                            {
                                "example_id": "d2274858-04c1-4ed6-ac32-cb5a0d74bacc",
                                "sense_id": "5947ef27-22d9-31a1-865a-0efd4144ef0a",
                                "text": "Contrairement à la tradition qui représente les pipelettes sous des traits carabosses, c’est une aimable dame, jeune et tuberculeuse, qui nous ouvre."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "d9cb29b3-7237-392e-ba95-9f9715a19321",
                "word": "Carabosse",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "48867d2f-496b-34bf-9438-7d28deec542b",
                        "entry_id": "d9cb29b3-7237-392e-ba95-9f9715a19321",
                        "glosses": [
                            "Sorcière ou fée, très vieille, très laide et très méchante."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ecb404de-09d5-4953-ba5d-ef1a6cb37852",
                                "sense_id": "48867d2f-496b-34bf-9438-7d28deec542b",
                                "text": "La fée Carabosse."
                            },
                            {
                                "example_id": "ee49efb6-6c1c-4d67-a175-baf3c366e447",
                                "sense_id": "48867d2f-496b-34bf-9438-7d28deec542b",
                                "text": "La grand-mère, comme une vieille fée Carabosse, la regardait avec ses yeux pointus."
                            },
                            {
                                "example_id": "eff66ecb-3597-4921-b0a5-5b6380c3456a",
                                "sense_id": "48867d2f-496b-34bf-9438-7d28deec542b",
                                "text": "La seconde nommée Noubosse\nEst un bel arc-en-ciel joyeux\nLes dieux s’en servent à leurs noces\nElle a tué trente Bé-Rieux\nEt fut douée par Carabosse."
                            },
                            {
                                "example_id": "d9bdaac4-eba3-4979-a2dd-919b9d319e68",
                                "sense_id": "48867d2f-496b-34bf-9438-7d28deec542b",
                                "text": "Avant Blanche-Neige, avant le Chat Botté, avant les sept nains et la fée Carabosse, ils vinrent se ranger autour de moi et ne me quittèrent plus jamais."
                            }
                        ]
                    }
                ],
