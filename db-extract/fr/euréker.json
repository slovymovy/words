                        "entry_id": "98e9289d-8e59-36af-884b-8cd4b4368f12",
                        "glosses": [
                            "Découvrir de façon subite la solution à un problème difficile."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6733c738-6fd8-4e77-a577-f5652291c55d",
                                "sense_id": "d286b704-b7c2-3370-a616-ade2f583870e",
                                "text": "Archimède n'aurait pas euréké ça."
                            },
                            {
                                "example_id": "7eabf482-5169-43bf-8446-ebb7b0973c55",
                                "sense_id": "d286b704-b7c2-3370-a616-ade2f583870e",
                                "text": "Le savant... eh bien! il a « euréké »."
                            },
                            {
                                "example_id": "02a5e9cf-e101-4cb4-98c4-ecb048b7d144",
                                "sense_id": "d286b704-b7c2-3370-a616-ade2f583870e",
                                "text": "On doit donc poser carrément la question: comment un homme intelligent, ayant passé huit ans sous le célèbre arbre Bo à réfléchir à ce sujet, peut-il n'avoir euréké qu'une telle incohérence ?"
                            }
                        ]
