                "senses": [
                    {
                        "sense_id": "758940ed-4c1f-3dca-92df-cbb6d0a32ebb",
                        "entry_id": "70482c98-0913-3ab8-af41-990b44804d85",
                        "glosses": [
                            "10. Hirnnerv; Nerv, der an der Regulation der Tätigkeit fast aller inneren Organe beteiligt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5663154-9a9a-4e7f-a4d6-360b3a8137d4",
                                "sense_id": "758940ed-4c1f-3dca-92df-cbb6d0a32ebb",
                                "text": "Bush hatte sich beim Fernsehen an einer Brezel verschluckt. Das Gebäck hatte daraufhin offenbar den Vagusnerv stimuliert, was den Herzschlag verlangsamt haben könnte."
                            },
                            {
                                "example_id": "55a8235d-b6b1-44d0-bcaf-1899959e70b4",
                                "sense_id": "758940ed-4c1f-3dca-92df-cbb6d0a32ebb",
                                "text": "Bei einer Vagotomie wird der Vagusnerv durchtrennt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c4721f76-e728-49e4-86c7-f8a7548c01ce",
                        "source_entry_id": "70482c98-0913-3ab8-af41-990b44804d85",
