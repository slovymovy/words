                        "entry_id": "6c9152b1-a93a-3e5a-b322-31b4a6968470",
                        "glosses": [
                            "eine Reduzierung von etwas; etwas von halber Größe des Ursächlichen, Ursprünglichen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b853a95a-57f0-4f42-9bc9-bd5fca9fc8c0",
                                "sense_id": "2b6f10e0-951f-3186-ba89-175378d72845",
                                "text": "Der Schutzwall hat eine Halbierung der Dicke nötig, damit die Kosten gesenkt werden können."
                            },
                            {
                                "example_id": "05e8e08c-e37e-4342-8f0e-c2b28fd0e36b",
                                "sense_id": "2b6f10e0-951f-3186-ba89-175378d72845",
                                "text": "Eine Halbierung meines Gehaltes könnte mich zum Gehen überreden."
                            }
