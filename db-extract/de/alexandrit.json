                                "target_senses": [
                                    {
                                        "sense_id": "3634b4a6-0c72-3d29-83e7-a83bf898582a",
                                        "entry_id": "297419b3-2012-3ddc-9dc2-a33f32e1c169",
                                        "glosses": [
                                            "A form of chrysoberyl that displays a colour change dependent upon the light source, along with strong pleochroism."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a2b932e5-b5ca-438f-abc9-c84f0d7a4485",
                                                "sense_id": "3634b4a6-0c72-3d29-83e7-a83bf898582a",
                                                "text": "[…] the body of each high seat was a single jewel of monstrous size: the left-hand seat a black opal, asparkle with steel-blue fire, the next a fire-opal, as it were a burning coal, the third seat an alexandrite, purple like wine by night but deep sea-green by day."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "59889fa6-7a63-4f0b-acba-0b45935e7704",
                        "source_entry_id": "85894c61-f50b-326d-9d87-6ca9d8e468f7",
                        "source_sense_id": "6b019bb4-2f84-306d-be06-c29a31679ed5",
