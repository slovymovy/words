                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d3960fd-5941-40b9-8520-86c2bbca24ef",
                                                "sense_id": "6c61bb65-ca81-3714-8c79-7b06c4e4af47",
                                                "text": "Dans certains moments de grand trouble, rien ne nous rassure tant qu’un peu de prévu, de tout ce qui nous rattache à ce que nous savons déjà de la vie, avec certitude."
                                            }
                                        ]
                                    }
                                ]
                            },
