                    "frequency": "Low",
                    "semantic_group_id": "attraction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was <w>infatuate</w> with the idea of moving to a foreign country."
                        },
                        {
                            "text": "The <w>infatuate</w> teenager spent all his time writing poems about his crush."
                        }
                    ],
                    "synonyms": [
