                "senses": [
                    {
                        "sense_id": "d6b88a6f-e272-3256-bb12-3bc417492cc0",
                        "entry_id": "3999b8c0-9abd-32fc-a49d-3b8148276e69",
                        "glosses": [
                            "трением удалять что-то с какой-то поверхности"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd88739d-80cc-454e-89cd-64994152bdf9",
                                "sense_id": "d6b88a6f-e272-3256-bb12-3bc417492cc0",
                                "text": "Учитель стирает надписи с доски."
                            }
                        ]
                    },
                    {
                        "sense_id": "13166bbf-d69c-3dfc-8acc-b885d41bed2d",
                        "entry_id": "3999b8c0-9abd-32fc-a49d-3b8148276e69",
                        "glosses": [
                            "с помощью трения мыть одежду или ткани в воде или чистящем растворе"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c1b9ab0e-3b42-422a-ae75-5315ff8e275d",
                                "sense_id": "13166bbf-d69c-3dfc-8acc-b885d41bed2d",
                                "text": "Стирать бельё."
                            }
                        ]
                    },
                    {
                        "sense_id": "b59fb299-7039-3c38-8bbc-f0e610b0d658",
                        "entry_id": "3999b8c0-9abd-32fc-a49d-3b8148276e69",
                        "glosses": [
                            "трением повреждать кожу"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fadfe153-61eb-40e9-a3f2-eb96a1245b1f",
                                "sense_id": "b59fb299-7039-3c38-8bbc-f0e610b0d658",
                                "text": "Эти ботинки быстро стирают ногу."
                            }
                        ]
                    },
                    {
                        "sense_id": "aaec1023-9216-334e-bb02-e5d3447c3550",
                        "entry_id": "3999b8c0-9abd-32fc-a49d-3b8148276e69",
                        "glosses": [
                            "трением измельчать какой-либо объект"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5e2443e-0d00-45e9-83d1-bddbb3229f17",
                                "sense_id": "aaec1023-9216-334e-bb02-e5d3447c3550",
                                "text": "Стирать в пыль."
                            },
                            {
                                "example_id": "1620b09b-0e21-42c4-bb4a-f9e3ebb8b786",
                                "sense_id": "aaec1023-9216-334e-bb02-e5d3447c3550",
                                "text": "Стирать в порошок."
                            }
                        ]
                    },
                    {
                        "sense_id": "8e5b909e-5a83-3076-8dab-470562b45085",
                        "entry_id": "3999b8c0-9abd-32fc-a49d-3b8148276e69",
                        "glosses": [
                            "перен. удалять какую-либо информацию из места, где она содержится"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a92e7db2-f318-43be-976f-0296ecfde334",
                                "sense_id": "8e5b909e-5a83-3076-8dab-470562b45085",
                                "text": "Время стирает эти эпизоды из памяти."
                            },
                            {
                                "example_id": "decebe09-8c60-47d8-bb69-b1c6fe52d0cd",
                                "sense_id": "8e5b909e-5a83-3076-8dab-470562b45085",
                                "text": "Стирать временные файлы."
                            }
                        ]
                    }
