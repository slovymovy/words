                "senses": [
                    {
                        "sense_id": "aa0fd46c-954f-3ef9-a154-3d6340639b6a",
                        "entry_id": "e54a83c8-780a-3f5a-9126-dc7ae6cfe3b8",
                        "glosses": [
                            "Enlever son caractère transcendantal à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48867abf-fd2b-4981-bba7-b518a5fd7c34",
                                "sense_id": "aa0fd46c-954f-3ef9-a154-3d6340639b6a",
                                "text": "Les contenus pratiques — les règles, les façons de mettre en œuvre, les fins — sont bien plutôt pour eux donnés factuellement dans le monde ou dans la nature de l’agent, d’une manière qui invite à détranscendantaliser la liberté."
                            },
                            {
                                "example_id": "34a38804-e5e4-4bd9-a3b1-6e3566499291",
                                "sense_id": "aa0fd46c-954f-3ef9-a154-3d6340639b6a",
                                "text": "Aussi propose-t-il de détranscendantaliser et de procéduraliser l’autonomie."
                            }
                        ]
                    }
