                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il <w>mime</w> un oiseau qui s'envole pour amuser son petit frère."
