                ],
                "senses": [
                    {
                        "sense_id": "fffc4fec-057f-3e02-8306-943f1790dfab",
                        "entry_id": "322d3834-1248-3e10-af15-f0a00c6bdc40",
                        "glosses": [
                            "A lexicographer or linguist who specializes in etymology (the origins of words)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7182b2fb-db7d-4a38-a7de-47f9760d03a6",
                                "sense_id": "fffc4fec-057f-3e02-8306-943f1790dfab",
                                "text": "This was the first time that James had met with one of the bogus etymologists common at that period, who believed that the derivation of a word could be solved by finding any foreign word that sounded something like it."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "069952b6-7f99-4fdc-bff4-d873318c1426",
                        "source_entry_id": "322d3834-1248-3e10-af15-f0a00c6bdc40",
                        "source_sense_id": "fffc4fec-057f-3e02-8306-943f1790dfab",
                        "source_sense_description": "person who specializes in etymology",
                        "target_lang_word": "etymolog",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "etymolog",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "e3ac82ba-b4a7-3b4b-9167-a3f6f2e774a1",
                                        "entry_id": "3c11943b-ec64-3c70-9c65-c8cc7fb19fcb",
