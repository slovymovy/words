                        "entry_id": "ea606ce8-dcb2-310f-bbfe-1966c5c17e67",
                        "glosses": [
                            "Tenir, créer, gérer un vlog / vlogue, créer des vidéos et les publier via Internet."
                        ],
                        "tags": [
                            "Internet"
                        ],
                        "examples": [
                            {
                                "example_id": "f4fe1124-f5ff-4494-a69a-6283c87c2c54",
                                "sense_id": "fbda6989-2ff4-347a-be28-06238bc7cc69",
                                "text": "J'ai donc eu envie de vlogger cette journée pour partager ça avec vous."
                            },
                            {
                                "example_id": "a41d9f1c-4349-49e1-8762-8a0cf513edd4",
                                "sense_id": "fbda6989-2ff4-347a-be28-06238bc7cc69",
                                "text": "Bien sûr, je vous ai fait des vidéos en avance et je vais vlogger pendant que je serai là-bas."
                            },
                            {
                                "example_id": "9d6a7756-a65f-4bbf-a98c-a48a7754e6fd",
                                "sense_id": "fbda6989-2ff4-347a-be28-06238bc7cc69",
                                "text": "J'ai hâte de débuter cette semaine qui démarre aujourd'hui (dans exactement 1h) et hâte de tout vous montrer parce que je vais vlogger !"
                            },
                            {
                                "example_id": "5a70802b-7195-4c4a-b4fa-fae3b97ef74c",
                                "sense_id": "fbda6989-2ff4-347a-be28-06238bc7cc69",
                                "text": "Quand je vlogge un peu moins, j'ai l'impression que mes followers ne me comprennent pas toujours très bien."
                            }
                        ]
                    }
                ],
