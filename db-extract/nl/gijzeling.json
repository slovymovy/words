                        "examples": [
                            {
                                "example_id": "8c72ef43-8d86-4405-9462-c866895aaa38",
                                "sense_id": "56120db1-d1d0-3abb-a906-5c99a555e94a",
                                "text": "Een gijzeling is wederrechtelijke vrijheidsberoving van een persoon (de gijzelaar of gegijzelde), waarbij deze bedreigd wordt met het doel iets van derden gedaan te krijgen."
                            },
                            {
                                "example_id": "5d52c629-fffe-484e-be92-145bfda9b9f3",
                                "sense_id": "56120db1-d1d0-3abb-a906-5c99a555e94a",
                                "text": "Marc Dutroux werd in 2004 veroordeeld tot levenslang voor ontvoering, gijzeling, verkrachting, moord en illegale handel.",
                                "translation": "Mark Dutroux byl v roce 2004 doživotně odsouzen za únos, držení rukojmích, znásilnění, vraždu a nelegální obchod."
                            }
                        ]
                    }
