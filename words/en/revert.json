                {
                    "sense_id": "0c6b2336-caf1-3fef-ae68-aaac65b238a8",
                    "sense_definition": "A person who has converted to Islam.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "As a recent <w>revert</w>, she joined a community group for new Muslims.",
                            "target_lang_translations": {
                                "ru": "Как недавняя <w>новообращенная</w>, она присоединилась к группе общения для новых мусульман."
