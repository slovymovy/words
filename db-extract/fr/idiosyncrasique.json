                    },
                    {
                        "sense_id": "22c0f3aa-fa98-37ff-b3f5-5d53fb23f677",
                        "entry_id": "78368e24-2b3a-3c11-a6ca-ce9fdf34353c",
                        "glosses": [
                            "Relatif aux caractères propres au comportement d’un individu particulier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "455aa8cd-bfcf-44c5-a65f-efefb4bf0b71",
                                "sense_id": "22c0f3aa-fa98-37ff-b3f5-5d53fb23f677",
                                "text": "Il en est qui jugeront mon approche d'un dialogue entre non-musulmans et musulmans trop directe et idiosyncrasique."
                            },
                            {
                                "example_id": "5cfcc1bd-1738-4906-9b6b-2c22e11bcdd6",
                                "sense_id": "22c0f3aa-fa98-37ff-b3f5-5d53fb23f677",
                                "text": "Évidemment, [ces éléments] peuvent être articulés de manière plus ou moins idiosyncrasique par le chercheur ou par l'équipe de recherche …."
                            },
                            {
                                "example_id": "1f67434d-c8fb-4970-858f-64929742459f",
                                "sense_id": "22c0f3aa-fa98-37ff-b3f5-5d53fb23f677",
                                "text": "Mais, disons-le, son aversion des prêtres était idiosyncrasique."
                            }
                        ]
                    },
                    {
                        "sense_id": "38ec9a44-e127-33e8-b63b-6799844b3978",
                        "entry_id": "78368e24-2b3a-3c11-a6ca-ce9fdf34353c",
                        "glosses": [
                            "Qui marque l'exception ou l'anormal."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab2fbdb7-176a-46ce-a9f5-8de7fe9c5efa",
                                "sense_id": "38ec9a44-e127-33e8-b63b-6799844b3978",
                                "text": "Termes idiosyncrasiques."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "30dd1cd8-af99-4ba7-b7bf-1827bc00d868",
                        "source_entry_id": "78368e24-2b3a-3c11-a6ca-ce9fdf34353c",
                        "target_lang_word": "idiosyncratic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "idiosyncratic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5ca61588-d0aa-3961-9fbf-5ed16409bd40",
                                        "entry_id": "d38353d7-f531-37cf-af82-a368127938de",
                                        "glosses": [
                                            "Peculiar to a specific individual; eccentric."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea0c44a8-e878-47c1-bfce-356730054494",
                                                "sense_id": "5ca61588-d0aa-3961-9fbf-5ed16409bd40",
                                                "text": "At the time, I set it down to some idiosyncratic, personal distaste . . . but I have since had reason to believe the cause to lie much deeper in the nature of man."
                                            },
                                            {
                                                "example_id": "f5410208-850f-4599-af7d-7331a3b462c0",
                                                "sense_id": "5ca61588-d0aa-3961-9fbf-5ed16409bd40",
                                                "text": "It was no merely idiosyncratic experience, for the youth had the same: it was love!"
                                            },
                                            {
                                                "example_id": "00286afd-3e74-4ed5-8a9c-e82910a9605a",
                                                "sense_id": "5ca61588-d0aa-3961-9fbf-5ed16409bd40",
                                                "text": "British Director Ronald Eyre kept the action crisp; he was correctly content to execute the composer's wishes, rather than impose a fashionably idiosyncratic view of his own."
                                            },
                                            {
                                                "example_id": "5193f165-b621-4fb7-a774-409bfcea9574",
                                                "sense_id": "5ca61588-d0aa-3961-9fbf-5ed16409bd40",
                                                "text": "I’m not saying that Kaufman’s film will be enshrined as a classic, as those Kubrick films are. It’s too idiosyncratic and demanding for that: many viewers will be thinking of ending it halfway through"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
