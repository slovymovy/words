                "senses": [
                    {
                        "sense_id": "b9925cc0-9332-3254-a065-251392aecd66",
                        "entry_id": "0683d63b-0bbc-3575-a8d9-1435568277e6",
                        "glosses": [
                            "Donner un caractère galicien à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a812b515-f047-491d-953a-b60d6e86cb3a",
                                "sense_id": "b9925cc0-9332-3254-a065-251392aecd66",
                                "text": "Sur les documents de l'époque le nom de Noia, que le régionalement correct n'avait pas encore galicianisé, s'écrivait à la castillane : Noya."
                            },
                            {
                                "example_id": "840f7efb-860f-4006-8df7-5ada573e2639",
                                "sense_id": "b9925cc0-9332-3254-a065-251392aecd66",
                                "text": "Il est vrai aussi que dans El Indèpendiente le fédéralisme n’est pas seulement général : il se particularise, se galicianise."
                            },
                            {
                                "example_id": "8c2f5f57-b9ab-47fe-9506-2442c2357ab8",
                                "sense_id": "b9925cc0-9332-3254-a065-251392aecd66",
                                "text": "Quant au nord-ouest, il s'était «galicianisé» et donnera plus tard naissance au portugais."
                            }
                        ]
                    }
