                                "example_id": "1e357b6e-dc79-4b61-8a56-4e82c25ae086",
                                "sense_id": "e6ea70e2-e7f6-3736-9eb7-3e5d33bc9a8d",
                                "text": "„Das zeigte sich etwa an den Ergebnissen der regulären Gemeindewahlen, die trotz des Krieges abgehalten wurden und zwar Veränderungen, aber keinen Erdrutsch brachten.“"
                            },
                            {
                                "example_id": "c8202948-1963-4ae9-9b6e-f09fcca5b990",
                                "sense_id": "e6ea70e2-e7f6-3736-9eb7-3e5d33bc9a8d",
                                "text": "„In der amerikanischen Zone wurden für Januar 1946 die ersten freien Gemeindewahlen anberaumt.“"
                            }
                        ],
