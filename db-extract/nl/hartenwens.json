                            {
                                "example_id": "ec5ca477-b8f5-4970-a534-0e53c0b12537",
                                "sense_id": "c2a6cd2d-c344-30cc-81c2-36fb39f88a04",
                                "text": "Dit keer werd een andere hartenwens vervuld: de komst van de met een broze gezondheid kampende auteur van historische romans Hilary Mantel. Ze blijkt een innemende persoonlijkheid, die schrijvers van historische fictie typeert als nieuwsgierige mensen, die aan één leven niet genoeg hebben."
                            },
                            {
                                "example_id": "1d115dbf-7d51-4d1d-83a1-5b318405b6ed",
                                "sense_id": "c2a6cd2d-c344-30cc-81c2-36fb39f88a04",
                                "text": "Het streven naar vrede van de Korea's is onze hartenwens, omdat het invloed heeft op de stabiliteit van de hele regio en zelfs op onze hele wereld, die oorlogsmoe is', zei de paus vandaag na een ontmoeting met de Zuid-Koreaanse president Park Geun-hye."
                            }
                        ]
                    }
