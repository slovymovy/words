                ],
                "senses": [
                    {
                        "sense_id": "8bbfed8c-e319-3d6d-960d-3e1156baf71c",
                        "entry_id": "e5b0c779-f688-3fd0-a863-4fff5ccaf9d8",
                        "glosses": [
                            "Saigner très légèrement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc209c43-d87f-4b53-94e0-0aada6729b15",
                                "sense_id": "8bbfed8c-e319-3d6d-960d-3e1156baf71c",
                                "text": "La maladie, la misère qui vous disperse les heures, les années, l’insomnie qui vous barbouille en gris, des journées, des semaines entières et le cancer qui nous monte déjà peut-être, méticuleux et saignotant du rectum."
                            },
                            {
                                "example_id": "d9a8b308-a0d5-43d8-bb3d-b2e67cd2a220",
                                "sense_id": "8bbfed8c-e319-3d6d-960d-3e1156baf71c",
                                "text": "La clinique montre une lèvre kératosique et squameuse qui peut se fissurer, saignoter et devenir, par endroits, érosive."
                            },
                            {
                                "example_id": "5b68a04d-fd37-41c6-aaeb-28beeb77a6cc",
                                "sense_id": "8bbfed8c-e319-3d6d-960d-3e1156baf71c",
                                "text": "Je le ponctionnerai sous quarante-huit heures, ça doit encore saignoter à l’intérieur."
                            }
                        ]
                    }
                ],
