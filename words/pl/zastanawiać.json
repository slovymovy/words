            "senses": [
                {
                    "sense_id": "17475839-b6e0-3c60-b1d0-7c373d317687",
                    "sense_definition": "myśleć intensywnie nad czymś, analizować coś lub namyślać się (często w formie zwrotnej)",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "refleksja",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Bardzo długo się <w>zastanawiał</w> nad tą propozycją, ale w końcu ją odrzucił.",
                            "target_lang_translations": {
                                "ru": "Он очень долго <w>размышлял</w> над этим предложением, но в итоге отклонил его."
                            }
                        },
                        {
                            "text": "Często <w>zastanawiam</w> się, jak potoczyłyby się nasze losy w innym mieście.",
                            "target_lang_translations": {
                                "ru": "Я часто <w>задумываюсь</w>, как сложилась бы наша судьба в другом городе."
                            }
                        }
                    ],
                    "synonyms": [
                        "myśleć",
                        "rozważać"
                    ],
                    "common_phrases": [
                        "zastanawiać się nad sobą",
                        "zastanawiać się nad życiem",
                        "długo się zastanawiać"
                    ],
                    "target_lang_definitions": {
                        "ru": "глубоко думать о чём-либо, анализировать или взвешивать (обычно с частицей «się»)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "размышлять",
                                "target_lang_sense_clarification": "обдумывать, предаваться мыслям"
                            },
                            {
                                "target_lang_word": "задумываться",
                                "target_lang_sense_clarification": "обращать внимание, размышлять о чём-то"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ef43be7c-6f34-33c7-9a7c-aa5320be112a",
                    "sense_definition": "skłaniać do myślenia, wzbudzać ciekawość lub intrygować",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "refleksja",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Niezwykłe zachowanie sąsiada bardzo mnie <w>zastanawia</w> od kilku dni.",
                            "target_lang_translations": {
                                "ru": "Странное поведение соседа меня очень <w>озадачивает</w> уже несколько дней."
                            }
                        },
                        {
                            "text": "Ta nagła zmiana decyzji mocno <w>zastanawiała</w> wszystkich zebranych członków zarządu.",
                            "target_lang_translations": {
                                "ru": "Эта внезапная смена решения сильно <w>заставляла задуматься</w> всех собравшихся членов правления."
                            }
                        }
                    ],
                    "synonyms": [
                        "intrygować"
                    ],
                    "common_phrases": [
                        "zastanawia mnie to"
                    ],
                    "target_lang_definitions": {
                        "ru": "заставлять задуматься, вызывать интерес, удивление или озадачивать"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "озадачивать",
                                "target_lang_sense_clarification": "приводить в замешательство, заставлять размышлять"
                            },
                            {
                                "target_lang_word": "заставлять задуматься",
                                "target_lang_sense_clarification": "побуждать к мыслям"
                            },
                            {
                                "target_lang_word": "интриговать",
                                "target_lang_sense_clarification": "возбуждать любопытство"
                            }
                        ]
                    }
                }
            ]
        }
