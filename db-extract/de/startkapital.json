                                            {
                                                "example_id": "41693a58-df67-450d-b37e-c66bbf089551",
                                                "sense_id": "69ba1b79-230f-34be-aed2-79b5115e1de8",
                                                "text": "Met een startkapitaal van tientallen miljarden dollars moet de bank de aanleg van nieuwe infrastructuur gaan financieren."
                                            },
                                            {
                                                "example_id": "a6f1956e-59a4-4af4-8892-9e61fb3fc080",
                                                "sense_id": "69ba1b79-230f-34be-aed2-79b5115e1de8",
                                                "text": "Natuurmonumenten ondersteunt het initiatief met een startkapitaal van 10.000 euro."
                                            },
