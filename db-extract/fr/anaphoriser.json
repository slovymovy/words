                "senses": [
                    {
                        "sense_id": "626ae05e-d233-3593-adc6-9ea28234083c",
                        "entry_id": "472cb8c7-daa0-37ab-83cc-8cae78b795be",
                        "glosses": [
                            "Donner un caractère d’anaphore à, reprendre sons forme d'anaphore."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3efe1b1c-c805-4536-95d0-1b065797b4c3",
                                "sense_id": "626ae05e-d233-3593-adc6-9ea28234083c",
                                "text": "La (ou iluec), en début d’énoncé, uniquement précédable par un coordonnant dans 86 % des propositions non dépendantes, a un rôle au niveau des liaisons transphrastiques que ne peut avoir y, mais y, au même titre que la ou iluec, peut anaphoriser des SN prép de lieu : […]"
                            },
                            {
                                "example_id": "f2d50c70-6c8c-4032-96a8-db5bb1a9b8ae",
                                "sense_id": "626ae05e-d233-3593-adc6-9ea28234083c",
                                "text": "Il est en effet raisonnable de penser que lui ne puisse pas s’anaphoriser lui- même."
                            }
                        ]
                    }
