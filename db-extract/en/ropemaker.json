                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f4fe2089-0fcb-4eb0-a55e-f5639241064d",
                        "source_entry_id": "72319ebc-1ade-302b-bed9-caf20a544a00",
                        "source_sense_id": "71b0b0f9-05de-36b5-914a-928daf9541f7",
