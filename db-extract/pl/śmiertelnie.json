                            {
                                "example_id": "48d1afb7-4570-498e-a411-d6c13550a4fb",
                                "sense_id": "0b795fc4-5443-3969-9830-64c1cc0bafd5",
                                "text": "Czarownica zbierała śmiertelnie trujące muchomory w lesie."
