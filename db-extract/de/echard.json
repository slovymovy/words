                "senses": [
                    {
                        "sense_id": "9609c1c4-7c80-3935-8e1a-8b8708515bea",
                        "entry_id": "39a4d4d8-2242-3fbe-9c4c-544856d19453",
                        "glosses": [
                            "Familienname, Nachname; sehr seltenes Vorkommen in Deutschland und der Schweiz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "511ffc4a-9025-4290-bd35-0e6d25b6c769",
                                "sense_id": "9609c1c4-7c80-3935-8e1a-8b8708515bea",
                                "text": "Frau Echard ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "a235c4c0-f830-4117-b482-5885a4aba6a7",
                                "sense_id": "9609c1c4-7c80-3935-8e1a-8b8708515bea",
                                "text": "Herr Echard wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "d775f9e0-3c66-4b7b-840a-91f56f22d302",
                                "sense_id": "9609c1c4-7c80-3935-8e1a-8b8708515bea",
                                "text": "Die Echards kommen heute aus Trier."
                            },
                            {
                                "example_id": "1b407482-60e3-402e-8f27-bc7ee2f0950d",
                                "sense_id": "9609c1c4-7c80-3935-8e1a-8b8708515bea",
                                "text": "Der Echard trägt nie die Schals, die die Echard ihm strickt."
                            },
                            {
                                "example_id": "0454b843-feb2-4e1e-9873-c6a65ecb7070",
                                "sense_id": "9609c1c4-7c80-3935-8e1a-8b8708515bea",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Echard kommt, geht der Herr Echard.“"
                            },
                            {
                                "example_id": "6d4d5b45-52aa-4fea-acf1-de3886155ea8",
                                "sense_id": "9609c1c4-7c80-3935-8e1a-8b8708515bea",
                                "text": "Echard kommt und geht."
                            },
                            {
                                "example_id": "0638fe67-0794-4dd5-9f78-e57e47445fcf",
                                "sense_id": "9609c1c4-7c80-3935-8e1a-8b8708515bea",
                                "text": "Echards kamen, sahen und siegten."
                            },
                            {
                                "example_id": "51976ff3-f4c3-43b5-a6de-eecf032e4cce",
                                "sense_id": "9609c1c4-7c80-3935-8e1a-8b8708515bea",
                                "text": "An verregneten Herbsttagen ist Familie Echards liebste Beschäftigung das Bemalen von Hühnereiern."
                            },
                            {
                                "example_id": "bb05bc31-5a64-4d57-95e3-2b3589e2a569",
                                "sense_id": "9609c1c4-7c80-3935-8e1a-8b8708515bea",
                                "text": "An verschneiten Wintertagen ist die liebste Beschäftigung von Familie Echard das Schmücken von Weihnachtsbäumen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
