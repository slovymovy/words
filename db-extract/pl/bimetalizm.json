                "senses": [
                    {
                        "sense_id": "392c7cc7-e759-3fe3-bbdd-6ee610a23917",
                        "entry_id": "d68c921b-60d9-37d8-a916-be993d08d6e5",
                        "glosses": [
                            "system monetarny, w którym funkcję pieniądza spełniają dwa kruszce, złoto i srebro, a ich wartości są od siebie ściśle zależne"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "222b7163-594c-4bf5-a77e-3c4f53e58922",
                                "sense_id": "392c7cc7-e759-3fe3-bbdd-6ee610a23917",
                                "text": "W sprawach wewnętrznych republikanie sprzeciwiali się idei bimetalizmu i faworyzowali złoto."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "395c9eaa-d4fb-4979-abf6-47ef7d9a8fcf",
                        "source_entry_id": "d68c921b-60d9-37d8-a916-be993d08d6e5",
                        "source_sense_id": "392c7cc7-e759-3fe3-bbdd-6ee610a23917",
                        "target_lang_word": "bimetallism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bimetallism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a6bd9fe3-f7c1-3ed2-99eb-9bb584b9be58",
                                        "entry_id": "cef84450-852d-3722-b432-931684a7f2af",
                                        "glosses": [
                                            "The use of a monetary standard based upon two different metals, traditionally gold and silver usually in a fixed ratio of values."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ace74b06-a83c-46c5-9b28-8daaa5e11baf",
                                                "sense_id": "a6bd9fe3-f7c1-3ed2-99eb-9bb584b9be58",
                                                "text": "As in China, bi-metallism exacerbated rural unrest in Nguyen Vietnam."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "32f0e73e-405e-407e-a254-311e64c9f3b5",
                        "source_entry_id": "d68c921b-60d9-37d8-a916-be993d08d6e5",
                        "source_sense_id": "392c7cc7-e759-3fe3-bbdd-6ee610a23917",
                        "target_lang_word": "bimétallisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bimétallisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a90432bd-dbec-3fdc-8e0c-413f39a92f6b",
                                        "entry_id": "8a5c7746-e89f-3b0e-8250-e1c79a3f87ed",
                                        "glosses": [
                                            "Système monétaire d’après lequel deux métaux, l’or et l’argent, servent de monnaie avec cours légal illimité."
                                        ],
                                        "tags": [
                                            "Économie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c4e9ddde-2720-40ce-9330-7638e4438bdf",
                                                "sense_id": "a90432bd-dbec-3fdc-8e0c-413f39a92f6b",
                                                "text": "Debout contre le cheminée, M. Berthier d’Eyzelles, rédacteur du Journal des Débats, député, qui caressait ses favoris blancs et faisait la roue, tandis que Mme de Morlaine lui criait :\n« Votre article sur le bimétallisme, une perle, un bijou ! La fin surtout, une pure ivresse ! »"
                                            },
                                            {
                                                "example_id": "bd1b1192-5004-430e-9b02-22420d0366f7",
                                                "sense_id": "a90432bd-dbec-3fdc-8e0c-413f39a92f6b",
                                                "text": "Le bimétallisme or-argent est maintenu aux États-Unis pendant tout le XIXᵉ siècle."
                                            },
                                            {
                                                "example_id": "29ee6e75-493d-463b-abdd-2e12554299bb",
                                                "sense_id": "a90432bd-dbec-3fdc-8e0c-413f39a92f6b",
                                                "text": "D’ailleurs, peu à peu, le bimétallisme disparaît partout pour faire place au monométallisme de droit ou de fait."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "215e3b9f-4881-4c30-8b0a-deb95579011c",
                        "source_entry_id": "d68c921b-60d9-37d8-a916-be993d08d6e5",
                        "source_sense_id": "392c7cc7-e759-3fe3-bbdd-6ee610a23917",
