                                        "sense_id": "05d5b2a5-684a-3b2f-a9d4-6dd3e25ffe89",
                                        "entry_id": "36156979-ce87-3073-a9f6-ccf98803e230",
                                        "glosses": [
                                            "A single-stringed lute-like musical instrument with a bowl-shaped body, held vertically in the lap and played with a bow, originating among the Slavic peoples in the Balkans, especially in the Dinarides region."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ff9941a-6606-4f91-aa11-c3843eb341f3",
                                                "sense_id": "05d5b2a5-684a-3b2f-a9d4-6dd3e25ffe89",
                                                "text": "Songs of Brankovich's speed are sung to the strains of the gusle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1bdf0691-68e1-4436-a7c7-8c4614ef71fd",
