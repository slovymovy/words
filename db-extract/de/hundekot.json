                "senses": [
                    {
                        "sense_id": "fc06d37d-6876-39b0-874e-dcfa8a9ec101",
                        "entry_id": "e9d9086c-1e7b-367f-a928-b002e58c589e",
                        "glosses": [
                            "Kot, der von einem Hund stammt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b91f771d-0147-471b-be03-63c0c564b124",
                                "sense_id": "fc06d37d-6876-39b0-874e-dcfa8a9ec101",
                                "text": "„Auch wenn in vielen Stadtteilen das Problem mit dem Hundekot abgenommen hat, werden nach wie vor jedes Jahr Hunderte Besitzer abgestraft.“"
                            },
                            {
                                "example_id": "ff532742-0436-44ae-a843-16463a10c1eb",
                                "sense_id": "fc06d37d-6876-39b0-874e-dcfa8a9ec101",
                                "text": "„Als sie nun zur Türe hereinkam, fügte es unerwartet der Himmel, daß sie in der Dunkelheit mit einem Fuße in Hundekot trat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
