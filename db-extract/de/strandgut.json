                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2869acf5-b3f0-4d47-a2c3-20c058f760b5",
                                "sense_id": "85cf3d9e-a052-34ed-8145-c0403edeba8e",
                                "text": "„Von ihr blieb nicht einmal genug Strandgut übrig, um daraus eine Barkasse zu bauen.“"
                            }
                        ],
