                                                "example_id": "a387b2dd-4cc1-48df-a968-12e11d6cc1a9",
                                                "sense_id": "06266b3a-919b-34d7-ab2e-7246ea0b3ab7",
                                                "text": "The crewing of the vessel before the crash was deficient."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f28d8675-d4d3-338d-9d7b-8351d9e7a54a",
                                        "entry_id": "ac48f999-bf10-381a-aa96-1139f9828f17",
                                        "glosses": [
                                            "To take on, recruit (new) crew"
