                                "target_senses": [
                                    {
                                        "sense_id": "c31a9ea9-953c-350b-8af5-5255a10f31aa",
                                        "entry_id": "034b0196-7fd8-3099-a95f-721036e04c4a",
                                        "glosses": [
                                            "Not binary."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "042b8da6-55c4-4c9d-af6f-39c090d6523e",
                                                "sense_id": "c31a9ea9-953c-350b-8af5-5255a10f31aa",
                                                "text": "Thus digital computers operate directly with digits either at the bit level, which is short for binary digit, or at the byte level where a nonbinary digit such as a decimal number or alphabetic character is represented."
                                            },
                                            {
                                                "example_id": "03946c53-d0d0-47eb-a403-b993db26d8f7",
                                                "sense_id": "c31a9ea9-953c-350b-8af5-5255a10f31aa",
                                                "text": "The most common type of encoder is one that converts a nonbinary number system into an equivalent binary system."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e30a5c0-52b8-3aad-8239-3b92493aa726",
                                        "entry_id": "034b0196-7fd8-3099-a95f-721036e04c4a",
                                        "glosses": [
                                            "Having or pertaining to a gender identity not represented by the gender binary; not exclusively male or female; genderqueer."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "604491d1-ea8d-42ca-9792-4dc82cf54561",
                                                "sense_id": "1e30a5c0-52b8-3aad-8239-3b92493aa726",
                                                "text": "I'm expected to live in a world where […] forms have no or few options for non-binary people, where finding a GP who understands my non-binary needs and identity is a challenge."
                                            },
                                            {
                                                "example_id": "efcf27e1-87e5-436c-9b9e-9c9068baf296",
                                                "sense_id": "1e30a5c0-52b8-3aad-8239-3b92493aa726",
                                                "text": "[T]he most commonly used non-binary pronouns are the singular “they/their/theirs”."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "non-binary",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b168ea87-9c10-37a5-9ed3-7b9328464eb6",
