                                    {
                                        "sense_id": "eef461ff-22dd-36ae-89fc-5b0c8b7fe068",
                                        "entry_id": "2259c49e-8f5f-34f1-bb9d-5e84572b463d",
                                        "glosses": [
                                            "weibliche Person, die versucht, einen Streit zu schlichten"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "10d16af1-97ec-3016-ad45-615beffe7f7c",
                                        "entry_id": "2259c49e-8f5f-34f1-bb9d-5e84572b463d",
                                        "glosses": [
                                            "weibliche Person, die versucht, (meist gegen Bezahlung) eine Vereinbarung/ein Geschäft zwischen zwei Parteien anzubahnen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "570d98dc-290e-4cc5-83cb-3ce6f8b649e3",
                                                "sense_id": "10d16af1-97ec-3016-ad45-615beffe7f7c",
                                                "text": "„Er hatte sie gerade wieder hinausgeleitet und wollte nun einen Diener aussenden, um durch eine Vermittlerin eine Kinderwärterin besorgen zu lassen, als auf einmal die Gevatterin Süeh mit einer Amme auftauchte.“"
                                            },
                                            {
                                                "example_id": "c8426eca-cf53-4e62-9fe6-7a380229d3bd",
                                                "sense_id": "10d16af1-97ec-3016-ad45-615beffe7f7c",
                                                "text": "„Am nächsten Tag suchte der biedere Küan eine berufsmäßige Vermittlerin auf und beauftragte sie, seine ›Ware‹ auf dem Markt der ›Abwasser‹ unterzubringen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
