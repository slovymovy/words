                    {
                        "sense_id": "ac17f6eb-c3aa-3286-b637-1302f7b451e5",
                        "entry_id": "5f9f77a2-6dc0-3519-a8be-ae696d413b7c",
                        "glosses": [
                            "een opeenvolging van twee lettertekens die samen één gesproken klank weergeven."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ca7879e-a69a-41cd-8bc8-3ab547846e89",
                                "sense_id": "ac17f6eb-c3aa-3286-b637-1302f7b451e5",
                                "text": "In het Nederlands zijn de ch, ng en nk voorbeelden van een digraaf die één medeklinker weergeeft en de combinaties au, ei, eu, ie, ij, oe, ou en ui voorbeelden die één klinker representeren."
                            }
                        ]
                    },
