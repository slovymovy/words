                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ce05a17-3406-42a9-865c-502c91ec5c9a",
                                                "sense_id": "da8edff7-fabf-3a7c-ad9a-6d8246e68696",
                                                "text": "Prince Alexander of Battenberg […] was chosen by the Bulgars as their first ruler (1879)."
                                            }
                                        ]
                                    }
