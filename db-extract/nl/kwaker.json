                "senses": [
                    {
                        "sense_id": "c2e5860e-e562-39c9-b00a-8c3abe07e169",
                        "entry_id": "a12dcff4-ebf3-3111-8348-dd9f413338ba",
                        "glosses": [
                            "eend, kikker"
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "124ade73-8ec0-4ba7-b5f4-35ff7d1e6863",
                                "sense_id": "c2e5860e-e562-39c9-b00a-8c3abe07e169",
                                "text": "Kan het nog aandoenlijker? Twee dwergnijlpaarden die in de Rotterdamse Diergaarde Blijdorp wonen, helpen een klein eendje dat tevergeefs probeert om op de kant te komen. Dankzij een klein zetje wordt de kleine kwaker gered. ,,Het maakt mijn hele dag goed!\" vertelt Breshna Senchi uit Vlaardingen die het voor haar ogen zag gebeuren en filmde."
                            }
                        ]
                    },
                    {
                        "sense_id": "e1039db1-de20-379e-ba92-94a6fcd786a3",
                        "entry_id": "a12dcff4-ebf3-3111-8348-dd9f413338ba",
                        "glosses": [
                            "iemand die een hoop onzin uitkraamt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9dedf965-2950-48b3-af25-8e28b4df0821",
                                "sense_id": "e1039db1-de20-379e-ba92-94a6fcd786a3",
                                "text": "Renckens vervolgt dat Van Berkum tijdens de zitting van de tuchtcommissie 'enorm door de mand viel'. Zelf ziet dr. Frank het heel anders. 'De heren van de \"vereniging voor kwakers\" zaten met hun mond vol tanden.'"
                            }
                        ]
                    },
                    {
                        "sense_id": "d7c413b1-d775-339d-9ef1-d707584dd185",
                        "entry_id": "a12dcff4-ebf3-3111-8348-dd9f413338ba",
