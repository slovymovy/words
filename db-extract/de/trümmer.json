                "senses": [
                    {
                        "sense_id": "106a7d64-ff37-3a11-af9a-39469d6f4da5",
                        "entry_id": "d7d38573-63ae-3a73-900f-f53f52a92b2b",
                        "glosses": [
                            "ruins, debris, wreckage, remains, fragments"
                        ],
                        "tags": [
                            "archaic",
                            "feminine",
                            "masculine",
                            "mixed",
                            "neuter",
                            "plural",
                            "plural-only",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "50443eef-7d8d-4bd1-a7dd-c1bec7bb7dcc",
                                "sense_id": "106a7d64-ff37-3a11-af9a-39469d6f4da5",
                                "text": "1905, Mörike, Gesammelte Schriften 3, 41",
                                "translation": "before the end of an hour, the mill collapsed in ruins",
                                "english": "before the end of an hour, the mill collapsed in ruins"
                            },
                            {
                                "example_id": "33503e38-9f21-4b7f-9c30-02ac4cfa6f18",
                                "sense_id": "106a7d64-ff37-3a11-af9a-39469d6f4da5",
                                "text": "[…] zu stehn auf der flammenden Trümmer [fem. sg.] seines Tempels […]",
                                "translation": "[…] to stand on the flaming ruins of their [the people's] temple […]\n(please add an English translation of this quotation)",
                                "english": "[…] to stand on the flaming ruins of their [the people's] temple […]\n(please add an English translation of this quotation)"
                            },
                            {
                                "example_id": "e2c4236b-90f8-42d5-8b1e-dbf234c6e6d2",
                                "sense_id": "106a7d64-ff37-3a11-af9a-39469d6f4da5",
                                "text": "[…] brachten nur wenige Trümmer ihrer Besitztümer davon.",
                                "translation": "[the refugees] only saved a few fragments of their possessions",
                                "english": "[the refugees] only saved a few fragments of their possessions"
                            },
                            {
                                "example_id": "e1e78747-adb8-4257-8e29-b79ce3740c5f",
                                "sense_id": "106a7d64-ff37-3a11-af9a-39469d6f4da5",
                                "text": "Die Trümmer des alten Schlosses Dürande sehen über die Wipfel in die Einsamkeit hinein"
                            }
                        ]
                    }
                ],
