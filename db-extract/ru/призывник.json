                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "16933282-f2a5-4982-852a-5ecb0f70dc36",
                        "source_entry_id": "142fc1b6-969a-34e0-acc4-3a3ccb9efde6",
                        "source_sense_id": "094abf29-b7b6-3169-befa-45467e2a9d07",
                        "target_lang_word": "appelé",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "appelé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0b308901-964e-32d6-b47e-d42d7f86bca2",
                                        "entry_id": "6af503b1-d071-3991-89ba-2ed10ea99f5f",
                                        "glosses": [
                                            "Conscrit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cfd1a702-9449-48b4-b84e-ff342101ac05",
                                                "sense_id": "0b308901-964e-32d6-b47e-d42d7f86bca2",
                                                "text": "Lunettes épaisses à bordure de fer sur le nez, les cheveux tondus ras, c’était comme lui un appelé du contingent planqué dans les bureaux : il reclassait tous les dossiers que son prédécesseur avait déjà classés."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "appelé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8c468d03-aa63-36fd-a772-0c14b7aac5f2",
                                        "entry_id": "d518976f-256d-32da-af0b-953d50a9e5d2",
                                        "glosses": [
                                            "Participe passé masculin singulier du verbe appeler."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "77403234-4954-4ca8-adcd-3fae0435a5fc",
                                                "sense_id": "8c468d03-aa63-36fd-a772-0c14b7aac5f2",
                                                "text": "A la façon dont je serais appelé, à la pension Beauséjour, j’apprendrais vite à savoir quel sort me serait réservé : Etienne Lieutaud servirait aux jours de sortie et aux rencontres de ma mère avec M. Sarrazin."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9dd64d4b-36d8-4eed-a425-acaa3d40bec5",
                        "source_entry_id": "142fc1b6-969a-34e0-acc4-3a3ccb9efde6",
                        "source_sense_id": "094abf29-b7b6-3169-befa-45467e2a9d07",
                        "target_lang_word": "conscrit",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "conscrit",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "69a6e4d4-360a-3790-b410-bef5ae4db05b",
                                        "entry_id": "a442d11a-9885-388e-9367-7a12f5de93f8",
                                        "glosses": [
                                            "Personne appelée, par voie de conscription, au service militaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5570f42c-37ef-4edf-8b98-61da91a05a00",
                                                "sense_id": "69a6e4d4-360a-3790-b410-bef5ae4db05b",
                                                "text": "[…], et quand arriva le jour du tirage, le jeudi matin, j’étais tellement pâle, tellement défait, que les parents de conscrits enviaient en quelque sorte ma mine pour leur fils."
                                            },
                                            {
                                                "example_id": "4ca4fc8a-d3be-48ac-af0f-f6f95e528a0b",
                                                "sense_id": "69a6e4d4-360a-3790-b410-bef5ae4db05b",
                                                "text": "Bras dessus, bras dessous, des bandes joyeuses de conscrits passaient, traînant leurs sabots sur le pavé des rues.\nNous sommes trois pauv’ conscrits\nDe l’an mil huit cent dix,\nIls nous font tirer au sort, tirer au sort\nPour nous conduire à la mort."
                                            },
                                            {
                                                "example_id": "5c3bc528-645f-494e-b071-427bd3177864",
                                                "sense_id": "69a6e4d4-360a-3790-b410-bef5ae4db05b",
                                                "text": "J’arrive à Longwy le jour du conseil de révision et je vois, circulant dans les rues, des bandes de proprets conscrits, enrubannés de la tête au pieds et se démenant comme des gaillards nullement mécontents de leur sort."
                                            },
                                            {
                                                "example_id": "4a06a6c7-07f4-4140-84dc-daf91de951d1",
                                                "sense_id": "69a6e4d4-360a-3790-b410-bef5ae4db05b",
                                                "text": "J'avais été beaucoup plus rarement bombardé du haut des airs, et je me trouvai, devant ce danger-là, presque aussi béjaune que mes conscrits."
                                            },
                                            {
                                                "example_id": "2b0f1642-528f-443e-9288-297ab3d7cc29",
                                                "sense_id": "69a6e4d4-360a-3790-b410-bef5ae4db05b",
                                                "text": "Au mois de janvier, avec les dix-huit garçons de son village, nés comme lui en 1934, ses conscrits, il avait fait le tour, dix-huit jours durant, de toutes les fermes pour quêter les fonds nécessaires au grand banquet qui s’était célébré le dix-neuvième jour. Autant de jours de quête que de conscrits dans la commune, telle est la coutume en Bresse."
                                            },
                                            {
                                                "example_id": "99a72f84-417e-4d96-a259-ff897bd6db0e",
                                                "sense_id": "69a6e4d4-360a-3790-b410-bef5ae4db05b",
                                                "text": "L’année de conscrit est pleine de loisirs. Tout le village respecte cette floraison qui n’a lieu qu’une fois dans la vie. Les voisins donnent un coup de main au père dont le garçon fait le conscrit."
                                            },
                                            {
                                                "example_id": "543b86b7-111f-41b7-9fdb-08363168ec57",
                                                "sense_id": "69a6e4d4-360a-3790-b410-bef5ae4db05b",
                                                "text": "Le coffret contenait quelques pièces de monnaie plus ou moins anciennes mais qui n’avaient certainement plus cours. Le père y trouva aussi sa médaille de tirage au sort. C’était une médaille ronde, en fonte émaillée noir au dos et blanc sur la face. Tout autour, un double filet bleu et rouge. Au milieu, une inscription : « Vivent les Conscrits. Classe 1893 ». En caractères plus gros, le numéro « 156 »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "080bc5e6-52c0-3c9f-9226-ae3242bc3541",
                                        "entry_id": "a442d11a-9885-388e-9367-7a12f5de93f8",
                                        "glosses": [
                                            "Personne née la même année."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9384224c-c74d-4d92-896c-d6c86f9b920c",
