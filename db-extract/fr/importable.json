                        "entry_id": "93c441da-3d24-3717-9916-200f23e34cef",
                        "glosses": [
                            "Que l’on peut importer, susceptible d’être importé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15af6dcd-1c20-4efa-9196-3706270d3f86",
                                "sense_id": "f74a7d50-5d8c-392a-9e7c-b322be576053",
                                "text": "Le typhus est donc importable au moyen des malades par terre , il peut par conséquent l’être par mer."
                            },
                            {
                                "example_id": "6e79924c-834b-4aa3-947a-8a1c0cc64261",
                                "sense_id": "f74a7d50-5d8c-392a-9e7c-b322be576053",
                                "text": "La quarantaine d’observation ou de simple suspicion est applicable aux navires en patente brute ou jugés en état brut qui n’ont eu à bord aucune maladie réputée importable ou de nature suspecte."
                            },
                            {
                                "example_id": "5b2986d4-c718-4ce8-82d3-e24e3237f485",
                                "sense_id": "f74a7d50-5d8c-392a-9e7c-b322be576053",
                                "text": "La présence de charbon dans la région et de sable importable du Brabant wallon font de Charleroi une zone idéale pour y installer des verreries."
                            }
                        ]
                    }
