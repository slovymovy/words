                                    {
                                        "sense_id": "78ec213f-d15b-34be-a5f5-de9eb074a846",
                                        "entry_id": "73a5212c-1abf-34fd-b268-8a851a29c43c",
                                        "glosses": [
                                            "A branch of linguistics studying the meaning of words."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9a2e1710-b4ce-48e7-98a2-c6699595f3b4",
                                                "sense_id": "78ec213f-d15b-34be-a5f5-de9eb074a846",
                                                "text": "Holonym: linguistics"
                                            },
                                            {
                                                "example_id": "d87fefb3-4339-48f7-bb65-43d7b384345f",
                                                "sense_id": "78ec213f-d15b-34be-a5f5-de9eb074a846",
                                                "text": "Meronyms: semasiology, onomasiology"
                                            },
                                            {
                                                "example_id": "ce9e5e7c-f4fc-4fa4-9f6b-75a3deb34e30",
                                                "sense_id": "78ec213f-d15b-34be-a5f5-de9eb074a846",
                                                "text": "lexical semantics"
                                            },
                                            {
                                                "example_id": "9108ccde-9669-45df-b602-1633e33633ee",
                                                "sense_id": "78ec213f-d15b-34be-a5f5-de9eb074a846",
                                                "text": "cognitive semantics"
                                            },
                                            {
                                                "example_id": "6a582255-d950-4100-8599-c31d0b6ff7f0",
                                                "sense_id": "78ec213f-d15b-34be-a5f5-de9eb074a846",
                                                "text": "computational semantics"
                                            },
                                            {
                                                "example_id": "620ddc9a-1ce4-4164-a414-d43aaace3dc9",
                                                "sense_id": "78ec213f-d15b-34be-a5f5-de9eb074a846",
                                                "text": "historical semantics"
                                            },
                                            {
                                                "example_id": "603f24f4-d1af-4542-8870-2be9c2f9194f",
                                                "sense_id": "78ec213f-d15b-34be-a5f5-de9eb074a846",
                                                "text": "Semantics is a foundation of lexicography."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8026201-a3e4-3028-bf88-d451f4051b6b",
                                        "entry_id": "73a5212c-1abf-34fd-b268-8a851a29c43c",
                                        "glosses": [
                                            "The study of the relationship between words and their meanings."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cafa6f3d-61ca-457f-b24f-744826efc8af",
                                                "sense_id": "b8026201-a3e4-3028-bf88-d451f4051b6b",
                                                "text": "In fact, nowadays a lot is known about the semantics of natural languages, and it is surprisingly easy to build semantic representations which partially capture the meaning of sentences or even entire discourses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6334e352-28ff-3233-a22e-16982393cf2c",
                                        "entry_id": "73a5212c-1abf-34fd-b268-8a851a29c43c",
                                        "glosses": [
                                            "The meaning or set of meanings of a linguistic element, such as a word, morpheme or utterance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1cbf08cf-2a15-49bf-8123-b454bb524a86",
                                                "sense_id": "6334e352-28ff-3233-a22e-16982393cf2c",
                                                "text": "In very ancient or poorly documented languages, the precise semantics of words tend to be uncertain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d808d651-2c89-3649-bc10-57e5b3de6a60",
                                        "entry_id": "73a5212c-1abf-34fd-b268-8a851a29c43c",
                                        "glosses": [
                                            "The meaning or set of meanings of a linguistic element, such as a word, morpheme or utterance.",
                                            "The meanings of individual words, as opposed to the overall meaning of a passage."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3e494816-3dbb-4402-9dec-12f42c28b471",
                                                "sense_id": "d808d651-2c89-3649-bc10-57e5b3de6a60",
                                                "text": "The semantics of the terms used are debatable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "858ad482-104f-3beb-997a-0f07c7b053cb",
                                        "entry_id": "73a5212c-1abf-34fd-b268-8a851a29c43c",
                                        "glosses": [
                                            "The meaning of computer language constructs, in contrast to their form or syntax."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "70884ad8-2994-421b-bc0a-6d5c1c42de48",
                                                "sense_id": "858ad482-104f-3beb-997a-0f07c7b053cb",
                                                "text": "file sharing and locking semantics"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a11f6a9f-97a2-3127-8c6a-474ce1b2beb4",
                                        "entry_id": "73a5212c-1abf-34fd-b268-8a851a29c43c",
                                        "glosses": [
                                            "Pettiness or triviality."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "colloquial",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bdc1c5d2-43e2-40b8-9a87-06d9e3b014ae",
                                                "sense_id": "a11f6a9f-97a2-3127-8c6a-474ce1b2beb4",
                                                "text": "Who cares? This is all just semantics!"
                                            }
                                        ]
