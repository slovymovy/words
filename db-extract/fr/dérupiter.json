                        ],
                        "examples": [
                            {
                                "example_id": "d8b474d3-6527-4792-9d8b-dbcb08ee9c14",
                                "sense_id": "9168f728-ebe1-39d8-854d-b8bcd2115d27",
                                "text": "Wilbur, en proie à une fulgurante poussée d’andouillettes, reprend précipitamment sa descente en demandant : — Il a encore dérupité les escaliers de l’église ?"
                            }
                        ]
                    }
