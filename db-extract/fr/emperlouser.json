                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49325d46-b968-4c5a-8b12-3da0a3299e3e",
                                "sense_id": "56aad115-020a-38f4-84a4-295159d54a33",
                                "text": "Depuis que je chine au bazar de la quincaille stellaire, j'y ai dégotté de la fine émeraude à m'emperlouser d'éternité."
                            },
                            {
                                "example_id": "9e8bcd28-6841-412e-b8b7-5e6fa01b2199",
                                "sense_id": "56aad115-020a-38f4-84a4-295159d54a33",
                                "text": "En 2009, il va s'emperlouser à Monte-Carlo, lustrer le poil rubis de ses Skoda pour que ces dames à chapeaux s'y mirent en bord de plage."
                            },
                            {
                                "example_id": "834a6fd8-159e-46a3-a80c-46fee2f9385d",
                                "sense_id": "56aad115-020a-38f4-84a4-295159d54a33",
                                "text": "Une rose n'est jamais semblable à sa mère, elle a beau, à chaque printemps, s'emperlouser de rosée, elle demeure différente, unique."
                            },
                            {
                                "example_id": "f5f7bc04-c458-40dc-8f5f-20201b408cc6",
                                "sense_id": "56aad115-020a-38f4-84a4-295159d54a33",
                                "text": "Elle doit nettoyer la baraque, s'époumoner aux fourneaux, s'emperlouser et botter le cul de ses grands enfants."
                            }
                        ]
                    }
