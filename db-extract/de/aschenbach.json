                "senses": [
                    {
                        "sense_id": "cf731b3b-9013-374e-8ada-66cf0a0b0895",
                        "entry_id": "5452bc6a-2796-3c4a-b4cd-c40804ea08bf",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname; deutschlandweit mit häufigstem Vorkommen in Thüringen vorkommend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a75e47f1-3006-4b0a-baef-68635d4148e1",
                                "sense_id": "cf731b3b-9013-374e-8ada-66cf0a0b0895",
                                "text": "Frau Aschenbach ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "eda8a343-057e-40b8-91f6-69286574476f",
                                "sense_id": "cf731b3b-9013-374e-8ada-66cf0a0b0895",
                                "text": "Herr Aschenbach wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "be896caf-2591-438e-9482-cb639e13eae6",
                                "sense_id": "cf731b3b-9013-374e-8ada-66cf0a0b0895",
                                "text": "Die Aschenbachs fliegen heute nach Antwerpen."
                            },
                            {
                                "example_id": "2a63d300-6830-465d-aafe-0d06764dee5e",
                                "sense_id": "cf731b3b-9013-374e-8ada-66cf0a0b0895",
                                "text": "Der Aschenbach trägt nie die Pullover, die die Aschenbach ihm strickt."
                            },
                            {
                                "example_id": "fa679ca8-da52-4be7-ba01-8534b91814cb",
                                "sense_id": "cf731b3b-9013-374e-8ada-66cf0a0b0895",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Aschenbach kommt, geht der Herr Aschenbach.“"
                            },
                            {
                                "example_id": "97238a29-8157-403d-9471-40f4909cda22",
                                "sense_id": "cf731b3b-9013-374e-8ada-66cf0a0b0895",
                                "text": "Aschenbach kommt und geht."
                            },
                            {
                                "example_id": "619a6c49-c167-4024-a0a0-2fe5e5415160",
                                "sense_id": "cf731b3b-9013-374e-8ada-66cf0a0b0895",
                                "text": "Aschenbachs kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
