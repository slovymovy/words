                ],
                "senses": [
                    {
                        "sense_id": "9917a78a-588a-3df5-bdc2-394ba7c8ed00",
                        "entry_id": "7c4bdf3f-2399-3959-b80f-6e6f1bed59c4",
                        "glosses": [
                            "das Bewusstsein, seinen Pflichten nachkommen zu müssen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34bf852e-0b4e-4ca1-a686-03709acb3abe",
                                "sense_id": "9917a78a-588a-3df5-bdc2-394ba7c8ed00",
                                "text": "Der Lehrerin gefiel das Pflichtbewusstsein ihres Schülers."
                            },
                            {
                                "example_id": "474c7996-41a8-484c-a821-5a9620ff5c52",
                                "sense_id": "9917a78a-588a-3df5-bdc2-394ba7c8ed00",
                                "text": "„Und wer fast ein Jahrtausend lang keine sicheren Grenzen hat, macht eben nicht Freiheit, sondern Sicherheit und die bekannten preußischen Tugenden Gehorsam, Pflichtbewusstsein und Unterordnung zu seinen Leitprinzipien.“"
                            },
                            {
                                "example_id": "42350f1c-fbaf-4e52-9741-e7762115da2c",
                                "sense_id": "9917a78a-588a-3df5-bdc2-394ba7c8ed00",
                                "text": "„Er hatte sie aus Pflichtbewusstsein und Mitgefühl umarmt.“"
                            },
                            {
                                "example_id": "39062944-ff9e-4eba-bdfb-e018fc6bd389",
                                "sense_id": "9917a78a-588a-3df5-bdc2-394ba7c8ed00",
                                "text": "„Doch dann regte sich sein Pflichtbewusstsein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
