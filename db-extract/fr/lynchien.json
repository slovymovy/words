                        "sense_id": "91de9da6-0a17-3c3a-bb21-231c50768e71",
                        "entry_id": "b966aeb3-991b-3766-8a84-d0b58ad9db64",
                        "glosses": [
                            "Qui se rapporte à David Lynch, son style, ses thèmes d’écriture."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2009b84a-3f81-4702-a9c9-201df546c4a9",
                                "sense_id": "91de9da6-0a17-3c3a-bb21-231c50768e71",
                                "text": "La moitié des chambres sont en réalité des garçonnières de parlementaires, vides le week-end. « Un côté très lynchien. »"
                            },
                            {
                                "example_id": "bd7b3958-f6c8-4dda-aa55-f353c8fff560",
                                "sense_id": "91de9da6-0a17-3c3a-bb21-231c50768e71",
                                "text": "Il y a tourné quatre films fous, des comédies dadaïstes, des puzzles lynchiens sous mescaline, avec un net penchant pour l’humour absurde et la mise en abyme."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "76c534a0-eaf3-46e7-8536-e58d18899e4b",
                        "source_entry_id": "b966aeb3-991b-3766-8a84-d0b58ad9db64",
                        "source_sense_id": "91de9da6-0a17-3c3a-bb21-231c50768e71",
                        "target_lang_word": "Lynchian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lynchian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2bace88f-f8ef-3fa4-90fb-8ea139277fb5",
                                        "entry_id": "fc04c1cc-fcf0-3eb6-9c45-fd1851846f22",
                                        "glosses": [
                                            "Of or pertaining to David Keith Lynch (1946–2025), American filmmaker and director whose surrealist films are characterized by dream imagery and meticulous sound design."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39e346a1-0203-4570-89cc-36a897d910bf",
                                                "sense_id": "2bace88f-f8ef-3fa4-90fb-8ea139277fb5",
                                                "text": "But like postmodern or pornographic, Lynchian is one of those Potter Stewart-type words that’s definable only ostensively—i.e. we know it when we see it. Ted Bundy wasn’t particularly Lynchian, but good old Jeffrey Dahmer, with his victim’s various anatomies neatly separated and stored in his fridge alongside his chocolate milk and Shedd Spread, was thoroughgoingly Lynchian."
                                            },
                                            {
                                                "example_id": "a395c7aa-1286-428a-b8df-ce372302b21b",
                                                "sense_id": "2bace88f-f8ef-3fa4-90fb-8ea139277fb5",
                                                "text": "Lynchian \"refers to a particular kind of irony where the very macabre and the very mundane combine in such a way as to reveal the former's perpetual containment within the latter.\""
                                            },
                                            {
                                                "example_id": "959c051c-1c0d-484d-8c4b-a8d089ad19b5",
                                                "sense_id": "2bace88f-f8ef-3fa4-90fb-8ea139277fb5",
                                                "text": "My relationship towards tulips is inherently Lynchian. I think they are disgusting. Just imagine. Aren't these some kind of, how do you call it, vagina dentata, dental vaginas threatening to swallow you?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
