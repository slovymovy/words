                            {
                                "example_id": "85e36f9e-ebd9-4b03-8118-a72607a0055f",
                                "sense_id": "98aa1622-c349-3145-a021-9d092880f7f6",
                                "text": "Op Palmzondag wordt de feestelijke intocht van Jesus in Jeruzalem gevierd."
                            }
                        ]
