                {
                    "sense_id": "5148473a-4f68-3298-aa45-0220f9aee894",
                    "sense_definition": "A seedless orange with a navel-like mark at the apex.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She bought a box of fresh <w>navel</w> oranges at the market.",
                            "target_lang_translations": {
