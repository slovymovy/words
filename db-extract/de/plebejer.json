                        "form": "den Plebejer"
                    },
                    {
                        "form_id": "1db906c5-9b06-40c3-8d1a-e028a702f7d3",
                        "entry_id": "17137e83-9afd-3ab2-9dd9-94569873dcdc",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Plebejer"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e3f9308e-ca65-3c3c-9f94-f9a77436f366",
                        "entry_id": "17137e83-9afd-3ab2-9dd9-94569873dcdc",
                        "glosses": [
                            "der gemeine Mann des alten Roms, jemand, der zu der Plebs gehörte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6e66fc5-fd6a-4427-bf66-4a3453555ca0",
                                "sense_id": "e3f9308e-ca65-3c3c-9f94-f9a77436f366",
                                "text": "Die Plebejer sammelten sich am Rande des Marktplatzes."
                            },
                            {
                                "example_id": "78eb0155-1402-4a1a-9dfc-0c75a5d094b6",
                                "sense_id": "e3f9308e-ca65-3c3c-9f94-f9a77436f366",
                                "text": "Zwischen Patriziern und Plebejern bestand ein Eheverbot."
                            },
                            {
                                "example_id": "af41e1cb-0eea-427a-ba94-b188075a35ac",
                                "sense_id": "e3f9308e-ca65-3c3c-9f94-f9a77436f366",
                                "text": "„Im Verlauf des 5. Jahrhunderts v.Chr. zwangen die Plebejer dem patrizischen Adel die Kodifikation des geltenden Gewohnheitsrechts (XII-Tafel-Gesetz) sowie die zivilrechtliche Gleichstellung […] ab.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "8c861457-064c-3f1e-9302-3db5cc65cd41",
                        "entry_id": "17137e83-9afd-3ab2-9dd9-94569873dcdc",
                        "glosses": [
                            "einer aus dem gemeinen Volke, ein ungehobelter oder ungebildeter Mensch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3b9509e-2926-46c7-87d1-017f647e2438",
                                "sense_id": "8c861457-064c-3f1e-9302-3db5cc65cd41",
                                "text": "Vergiss diese Plebejer, im Grunde sollte man ihnen den Zutritt zur Ausstellung verwehren."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f2da5e75-c3ce-4296-b10f-1217795a4e96",
                        "source_entry_id": "17137e83-9afd-3ab2-9dd9-94569873dcdc",
                        "source_sense_id": "e3f9308e-ca65-3c3c-9f94-f9a77436f366",
                        "source_sense_description": "der gemeine Mann des alten Roms, jemand, der zu der Plebs gehörte",
                        "target_lang_word": "plebeian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "plebeian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9eb0ffec-c0a6-37d7-b620-5560283da1d1",
                                        "entry_id": "6bcee593-aa2c-30c2-85de-a2ec6f26dcc2",
                                        "glosses": [
                                            "A member of the plebs, the common citizens of ancient Rome."
                                        ],
                                        "tags": [
                                            "Ancient-Rome",
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df9f97fa-082a-4afe-bce3-46a995287f3d",
                                                "sense_id": "9eb0ffec-c0a6-37d7-b620-5560283da1d1",
                                                "text": "Na plebeane will tak þe dochter of ane patriciane but hir consent."
                                            },
                                            {
                                                "example_id": "884e593f-f6cf-44a7-a50c-1c961c0cbf09",
                                                "sense_id": "9eb0ffec-c0a6-37d7-b620-5560283da1d1",
                                                "text": "The cognomen was first used in patrician families, who were distinguished from the plebeians by their three names."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a0f2dc8f-cdcc-3d9a-a7a5-9fade928670a",
                                        "entry_id": "6bcee593-aa2c-30c2-85de-a2ec6f26dcc2",
                                        "glosses": [
                                            "A commoner, particularly (derogatory) a low, vulgar person."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d96dc415-ff9e-454a-9509-4df07b531766",
                                                "sense_id": "a0f2dc8f-cdcc-3d9a-a7a5-9fade928670a",
                                                "text": "There blude... vald hef na bettir cullour nor the blude of ane plebien or of ane mecanik craftis man."
                                            },
                                            {
                                                "example_id": "44f6c48e-ff49-44a3-bc5e-e9abebc5ed87",
                                                "sense_id": "a0f2dc8f-cdcc-3d9a-a7a5-9fade928670a",
                                                "text": "The feelings of our heart, the agitation of our passions, the vehemence of our affections, dissipate all its conclusions, and reduce the profound philosopher to a mere plebeian."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "plebeian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c9082b48-d14b-38dc-baf9-8463e304e998",
                                        "entry_id": "ee728a67-c279-36af-ad64-f1d255b7e3ea",
                                        "glosses": [
                                            "Of or concerning the plebs, the common citizens of ancient Rome."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f65351ee-c693-4ead-af07-2c9f0c18da80",
                                                "sense_id": "c9082b48-d14b-38dc-baf9-8463e304e998",
                                                "text": "To what purpose be the plebeian Magistrates ordeined?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1220f7e7-3bf0-3c8c-afd3-ddbd92ac4148",
                                        "entry_id": "ee728a67-c279-36af-ad64-f1d255b7e3ea",
                                        "glosses": [
                                            "Of or concerning the common people."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5263dad4-bde1-4b2e-9a25-93175e4e97f8",
                                                "sense_id": "1220f7e7-3bf0-3c8c-afd3-ddbd92ac4148",
                                                "text": "...priuate person or plebian multitude..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a6a5aee5-bd49-36a4-9961-550f18a8a9ca",
                                        "entry_id": "ee728a67-c279-36af-ad64-f1d255b7e3ea",
                                        "glosses": [
                                            "Common, particularly (derogatory) vulgar, crude, coarse, uncultured."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50757bac-bff6-4a08-a2e1-76fe84a5a6c9",
                                                "sense_id": "a6a5aee5-bd49-36a4-9961-550f18a8a9ca",
                                                "text": "For to plebeyan wits, it is as good,\nAs to be silent, as not vnderstood."
                                            },
                                            {
                                                "example_id": "9abbfcd9-c515-4036-8240-6776f4be1cc9",
                                                "sense_id": "a6a5aee5-bd49-36a4-9961-550f18a8a9ca",
                                                "text": "[…] told me love was too plebeian / told me you were through with me"
                                            },
                                            {
                                                "example_id": "78282af7-e42f-4e55-a6a3-8fd2ba4661f5",
                                                "sense_id": "a6a5aee5-bd49-36a4-9961-550f18a8a9ca",
                                                "text": "Completely absent was any mention of the Apple Watch Edition branding, which Apple used last year to launch a pair of $10,000-and-up Apple Watches that worked the same way as the cheap ones but were made out of actual gold instead of workaday, plebeian metals."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d8dc0d89-76a2-4958-805a-56253d31c664",
                        "source_entry_id": "17137e83-9afd-3ab2-9dd9-94569873dcdc",
                        "source_sense_id": "e3f9308e-ca65-3c3c-9f94-f9a77436f366",
                        "source_sense_description": "der gemeine Mann des alten Roms, jemand, der zu der Plebs gehörte",
                        "target_lang_word": "plébéien",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "plébéien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d85ff7d1-4e66-3ae0-9553-098bc4c31c4e",
                                        "entry_id": "0507cb49-e78e-3c92-b6ad-dc2c4355f728",
                                        "glosses": [
                                            "Citoyen appartenant au populus, mais ne jouissant pas des droits réservés aux patriciens."
                                        ],
                                        "tags": [
                                            "Ancient-Roman"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a4837772-c233-4de8-8296-bb363742e14c",
                                                "sense_id": "d85ff7d1-4e66-3ae0-9553-098bc4c31c4e",
                                                "text": "Le jurisconsulte dit qu’on ne peut être propriétaire que par le droit des Quirites ; or le plébéien n’est pas compté d’abord parmi les Quirites […] Ces plébéiens, qui n’ont pas la religion, n’ont pas ce qui fait que l’homme peut mettre son empreinte sur une part de terre et la faire sienne."
                                            },
                                            {
                                                "example_id": "eecd6811-5b90-4ecd-a8bd-9db5b1fbe3aa",
                                                "sense_id": "d85ff7d1-4e66-3ae0-9553-098bc4c31c4e",
                                                "text": "Et si les plébéiens se plaignent d’être par ces expédients illégalement écartés du consulat, où donc était le pouvoir en mesure de leur faire justice ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2cecc148-651b-33bd-ae48-6d53abc366ef",
                                        "entry_id": "0507cb49-e78e-3c92-b6ad-dc2c4355f728",
                                        "glosses": [
                                            "(sens moderne) Homme du peuple ; citoyen qui n’appartient pas à la classe dirigeante."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be8bd4ea-7135-40a6-85c5-77182e6c3a9e",
                                                "sense_id": "2cecc148-651b-33bd-ae48-6d53abc366ef",
                                                "text": "Elle sortait d’une vieille famille de gentilshommes, éteinte maintenant. Son mari, un plébéien que ses parents lui avaient fait épouser, était mort d’un coup d’épée, pendant sa grossesse, en lui laissant une fortune compromise."
                                            },
                                            {
                                                "example_id": "ce899141-dd4a-48de-9ab9-0033f9564895",
                                                "sense_id": "2cecc148-651b-33bd-ae48-6d53abc366ef",
                                                "text": "— Oh ! moi, tu sais, je suis dur à la fatigue, et puis je suis un plébéien ; je m’ennuie dans vos wagons de première classe où je ne trouve que des gens qui croiraient compromettre leur dignité s’ils parlaient à leurs voisins."
                                            },
                                            {
                                                "example_id": "b0441c9b-07a0-4cd0-b64d-f666eb8a3fa3",
                                                "sense_id": "2cecc148-651b-33bd-ae48-6d53abc366ef",
                                                "text": "Mais je vais certainement vous décevoir : je suis un plébéien et je ne fume que la pipe."
                                            },
                                            {
                                                "example_id": "d2fcbe7c-3c9c-4920-b093-3f4a15ccdbab",
                                                "sense_id": "2cecc148-651b-33bd-ae48-6d53abc366ef",
                                                "text": "Cette réflexion, parce qu’elle me paraît naturelle et paraîtra telle à tous les plébéiens de l’armée, sera affligeante pour nos beaux Messieurs s’ils me lisent."
                                            },
                                            {
                                                "example_id": "85cb146d-c9cc-4996-b68e-cba277ebd628",
                                                "sense_id": "2cecc148-651b-33bd-ae48-6d53abc366ef",
                                                "text": "À travers la figure du plébéien, c’est donc une contre-histoire de la modernité qui s’écrit. Face aux promesses trahies de l’« idéal démocratique », le plébéien est celui qui s’acharne à en demander les comptes."
                                            },
                                            {
                                                "example_id": "87e1c9e6-2c1f-4cf2-80c8-4aa05370e4a9",
                                                "sense_id": "2cecc148-651b-33bd-ae48-6d53abc366ef",
                                                "text": "[En parlant de L’Amant de Lady Chatterley] Dans ce grand moment d’abolition des castes, l’adultère entre Constance et Mellors —entre l’aristocrate et le plébéien— devient donc un véritable attentat à la norme —à la norme politique plus qu’à la norme morale pour l’aristocratie de l’époque !"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "plébéien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "48b0afd4-7898-3036-b26f-c409a9da9e48",
                                        "entry_id": "5cf51e9d-4480-3713-907a-817f0a4c4b68",
                                        "glosses": [
                                            "Relatif à la plèbe ; n’appartenant pas à l’aristocratie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4dd5646-b618-42e9-be57-d14ddfee28e8",
                                                "sense_id": "48b0afd4-7898-3036-b26f-c409a9da9e48",
                                                "text": "Magistrat plébéien ; une famille plébéienne illustre."
                                            },
                                            {
                                                "example_id": "bc632577-ed9e-4ef2-9be9-e08d0e00b406",
                                                "sense_id": "48b0afd4-7898-3036-b26f-c409a9da9e48",
                                                "text": "L’influent tribun de la plèbe devait obligatoirement être plébéien."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76b92c7d-e68b-3bd2-93d8-f0e9abb9dfce",
                                        "entry_id": "5cf51e9d-4480-3713-907a-817f0a4c4b68",
                                        "glosses": [
                                            "Relatif au peuple."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "668f872a-97d6-4c96-b5e6-845e0562da33",
                                                "sense_id": "76b92c7d-e68b-3bd2-93d8-f0e9abb9dfce",
                                                "text": "Elle lui trouva un visage plébéien mais follement sympatique."
                                            },
                                            {
                                                "example_id": "221f8576-02c6-40cb-9c55-5ddb683f67e3",
                                                "sense_id": "76b92c7d-e68b-3bd2-93d8-f0e9abb9dfce",
                                                "text": "[Julien Sorel, dans Le Rouge et le Noir] Mais cette découverte est vite contrariée par tout ce qui enchaîne le héros plébéien à son espèce et le renvoie à ses origines sociales : quoi qu’il fasse, il ne sera jamais qu’un petit gars issu d’un milieu rural et rustre…"
                                            },
                                            {
                                                "example_id": "8362dd55-5f15-4947-89ea-7c5d4113f84b",
                                                "sense_id": "76b92c7d-e68b-3bd2-93d8-f0e9abb9dfce",
                                                "text": "— Qu’adviendrons-nous demain ? se demandait à haute voix le vieux banquier dont le parler conservait les mauvaises tournures de ses origines plébéiennes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8e54cabe-eeea-4d25-acd0-16eef3e150d9",
                        "source_entry_id": "17137e83-9afd-3ab2-9dd9-94569873dcdc",
                        "source_sense_id": "e3f9308e-ca65-3c3c-9f94-f9a77436f366",
                        "source_sense_description": "der gemeine Mann des alten Roms, jemand, der zu der Plebs gehörte",
                        "target_lang_word": "plebeyo",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "plebeyo",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "d7a66add-61e3-3104-8174-95d07e8c76fa",
                                        "entry_id": "34fb9783-b18f-31b1-9e27-58d7a4510dce",
                                        "glosses": [
                                            "Que pertenece o concierne a la plebe, clase social de la antigua Roma."
                                        ],
                                        "tags": [
                                            "noun"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "65f421f5-8da7-4e9b-9241-87ff721d4826",
                                                "sense_id": "d7a66add-61e3-3104-8174-95d07e8c76fa",
                                                "text": "E estonce Ytilius, que lo avían criado en Aventín tribuno de los cavalleros, a fin que la avantaja de las elecciones de los tribunos de los cavalleros que así fizieron a crear en aquella hueste non fuesse fecha después de las elecciones de los tribunos plebeyos, él, como sabidor de las cosas populares e como omne poderoso, puso diligencia que ante que fuessen a la cibdat ellos creasen de semejante poder aquel mesmo número de tribunos del pueblo."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fac6c2ee-f3db-3e89-b67b-2fd9dc4c43db",
                                        "entry_id": "34fb9783-b18f-31b1-9e27-58d7a4510dce",
                                        "glosses": [
                                            "Que pertenece o concierne al vulgo."
                                        ],
                                        "tags": [
                                            "noun"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "863da6e0-c18d-43c0-bf0c-10d8d166133e",
                                                "sense_id": "fac6c2ee-f3db-3e89-b67b-2fd9dc4c43db",
                                                "text": "En una misma nación surgen del latín varios dialectos, que tienen su hado: mientras unos, ocultos acaso en erizadas sierras, en hondos valles, en provincias que aisló su situación topográfica, se quedan eternamente rudos e informes y no pasan de jerga villanesca, otros se acrisolan y refinan, dejan precipitarse el sedimento vulgar y plebeyo, y ascienden a lengua literaria y a idioma general de una gran nación."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "b937c2c1-6000-3bf7-a5db-ce57d3d99671",
                                        "entry_id": "34fb9783-b18f-31b1-9e27-58d7a4510dce",
                                        "glosses": [
                                            "Persona que no pertenece a la nobleza."
                                        ],
                                        "tags": [
                                            "noun"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2dd0fefb-eb15-4148-b827-0101d2a66ef8",
                                                "sense_id": "b937c2c1-6000-3bf7-a5db-ce57d3d99671",
                                                "text": "E si los jueces que gobiernan la república viviendo ordenadamente y ejercitando sus oficios tranquila y amorosamente y en el ministerio de la república siempre haber conformidad entre ellos, y no discordia, y gozando los reyes y señores o jueces de quieto principado, de tal manera que grandes y chicos, súbditos ricos o pobres, nobles y plebeyos estén siempre quietos y guarden al rey e magistrado entera obediencia, son tres argumentos de la bondad de la policía."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
