                "senses": [
                    {
                        "sense_id": "9ebab028-dce5-3fbb-a074-14788abc3675",
                        "entry_id": "fefd4b62-f17c-32c3-affc-9031f5208512",
                        "glosses": [
                            "Foundation."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "831672d5-ece1-397e-a310-7f3e6488609d",
                        "entry_id": "fefd4b62-f17c-32c3-affc-9031f5208512",
                        "glosses": [
                            "The bottom; the buttocks or anus."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea16834a-469d-4de8-9a14-725c34957f65",
                                "sense_id": "831672d5-ece1-397e-a310-7f3e6488609d",
                                "text": "It [the Sphincter Ani] serves to purse up the Fundament, and so hinders the involuntary Evacuation of the Fæces."
                            },
                            {
                                "example_id": "cc8c3dcd-af78-4400-b1ef-d4a3d01ea7e3",
                                "sense_id": "831672d5-ece1-397e-a310-7f3e6488609d",
                                "text": "ANOTHER defect that new-born infants are liable to is, to have their fundaments closed up; by which they can never evacuate the new excrements engendered by the milk they suck […]"
                            },
                            {
                                "example_id": "a5a84a73-758f-4cc4-a39b-3a2b7f5ecae5",
                                "sense_id": "831672d5-ece1-397e-a310-7f3e6488609d",
                                "text": "Bathe the parts frequently with cold water, and, if there be much pain at stool, always squirt up the fundament, beforehand, with a syringe, half a teacupful of cold water."
                            },
                            {
                                "example_id": "0ac2032f-dfa9-47db-81c1-911e5221e90e",
                                "sense_id": "831672d5-ece1-397e-a310-7f3e6488609d",
                                "text": "I flinched when he touched my rosebud, but pretty soon I was fucking his mouth like it was Hector's fundament."
                            }
                        ]
                    },
                    {
                        "sense_id": "780f23e5-44b1-3ee5-97d2-adae8e05bc3b",
                        "entry_id": "fefd4b62-f17c-32c3-affc-9031f5208512",
                        "glosses": [
