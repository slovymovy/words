                "senses": [
                    {
                        "sense_id": "c01841f5-4420-3b67-9671-73babe2012ac",
                        "entry_id": "2954b557-c54d-3a6f-b7fd-fea40c8249fd",
                        "glosses": [
                            "Block mit Vordrucken für Ärzte zum Verschreiben von Arzneimitteln"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a15ac613-a502-4ae4-ab48-b2e3d9786ccd",
                                "sense_id": "c01841f5-4420-3b67-9671-73babe2012ac",
                                "text": "„Oftmals weiss der Arzt durchaus, dass er Dinge auf den Rezeptblock schreibt, die im betreffenden Fall biologisch nichts bringen.“"
                            },
                            {
                                "example_id": "37dc6b67-6420-4fd9-8129-1e853d8dacd0",
                                "sense_id": "c01841f5-4420-3b67-9671-73babe2012ac",
                                "text": "„Er nahm seinen Rezeptblock und kritzelte etwas darauf.“"
                            },
                            {
                                "example_id": "6a7478f1-ef5f-43fe-8584-9dd525afdd57",
                                "sense_id": "c01841f5-4420-3b67-9671-73babe2012ac",
                                "text": "„Ravic schrieb es auf einen Rezeptblock.“"
                            }
                        ],
