                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67f00c7f-ab9a-45db-99a3-fc308deef2af",
                                "sense_id": "f382d041-64c8-34c7-8c80-146ba8b9676d",
                                "text": "„Der Richter trug eine mit Stroh- und Grashalmen gespickte Perücke aus trockenem Flussschlamm; den Kopf des Debilen bedeckte ein festgezurrter Fellfetzen, die schwärzlich verfärbte Blutseite zeigte nach außen.“"
                            },
                            {
                                "example_id": "1266a3a1-c624-4f1b-b251-6161e8d7fc0d",
                                "sense_id": "f382d041-64c8-34c7-8c80-146ba8b9676d",
                                "text": "„Der warme Geruch legte sich auf meine Schultern, braun wie Flussschlamm.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
