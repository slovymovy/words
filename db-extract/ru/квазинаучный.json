                        "form": "ква̀зинау́чна"
                    },
                    {
                        "form_id": "1b0854e6-0331-4e80-854e-f0d748151a49",
                        "entry_id": "90c19d9f-3541-3c99-9ffb-22cdbace6305",
                        "tags": [
