                            }
                        },
                        {
                            "text": "She became a professional <w>racer</w> after winning several local cycling competitions.",
                            "target_lang_translations": {
                                "ru": "Она стала профессиональной <w>гонщицей</w>, выиграв несколько местных соревнований по велоспорту."
