                "translations": [
                    {
                        "translation_id": "e9316066-294f-4d0d-925f-8a2aabcadb24",
                        "source_entry_id": "147069b7-bd8a-3fe8-9fa6-0b1e9253a5d8",
                        "source_sense_id": "6e48a048-7de4-3b72-844f-22538abc9cb2",
                        "target_lang_word": "prediction",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prediction",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "af9e7389-e75c-306c-bad0-3d9f8f9aa4c7",
                                        "entry_id": "cbca37e4-30c1-39fd-b032-5455e8bb4069",
                                        "glosses": [
                                            "A statement of what will happen in the future."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26eb2ab6-fc4b-417f-b261-77298a4dba64",
                                                "sense_id": "af9e7389-e75c-306c-bad0-3d9f8f9aa4c7",
                                                "text": "make predictions about something"
                                            },
                                            {
                                                "example_id": "ef647445-d2e4-41a9-8dbd-577e5377d1b3",
                                                "sense_id": "af9e7389-e75c-306c-bad0-3d9f8f9aa4c7",
                                                "text": "correct prediction"
                                            },
                                            {
                                                "example_id": "62d249dd-e84d-4f57-84ed-701aaa2759c8",
                                                "sense_id": "af9e7389-e75c-306c-bad0-3d9f8f9aa4c7",
                                                "text": "offer up a prediction"
                                            },
                                            {
                                                "example_id": "67786423-d0a8-4019-a4fd-44a00cb36d76",
                                                "sense_id": "af9e7389-e75c-306c-bad0-3d9f8f9aa4c7",
                                                "text": "incorrect prediction"
                                            },
                                            {
                                                "example_id": "7fae8364-62f9-4400-9a43-3816ae30479f",
                                                "sense_id": "af9e7389-e75c-306c-bad0-3d9f8f9aa4c7",
                                                "text": "the prediction came true"
                                            },
                                            {
                                                "example_id": "9581b362-4611-42c2-b069-6bf452418fa4",
                                                "sense_id": "af9e7389-e75c-306c-bad0-3d9f8f9aa4c7",
                                                "text": "The weather forecaster made a prediction of heavy rain tomorrow."
                                            },
                                            {
                                                "example_id": "3c7fe0c9-19a3-406d-8558-54c744af45c2",
                                                "sense_id": "af9e7389-e75c-306c-bad0-3d9f8f9aa4c7",
                                                "text": "His prediction about the stock market proved correct."
                                            },
                                            {
                                                "example_id": "d93c9d4a-22a5-4625-b27a-79705569b906",
                                                "sense_id": "af9e7389-e75c-306c-bad0-3d9f8f9aa4c7",
                                                "text": "It’s difficult to make an accurate prediction about the future."
                                            },
                                            {
                                                "example_id": "5e80fc47-ce7f-43cc-92a1-0c7b9d99b00a",
                                                "sense_id": "af9e7389-e75c-306c-bad0-3d9f8f9aa4c7",
                                                "text": "The scientists issued a bold prediction of technological change."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9aa70cb7-9893-3bd2-b5b1-95925f354fec",
                                        "entry_id": "cbca37e4-30c1-39fd-b032-5455e8bb4069",
                                        "glosses": [
                                            "A probability estimation based on statistical methods."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9a76d92b-5117-403b-bb06-255be51b8932",
                        "source_entry_id": "147069b7-bd8a-3fe8-9fa6-0b1e9253a5d8",
                        "source_sense_id": "6e48a048-7de4-3b72-844f-22538abc9cb2",
                        "target_lang_word": "prédiction",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prédiction",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c1f8e04f-e1fb-38fe-a2cb-e4de66d23626",
                                        "entry_id": "2b05d9ee-0fa9-3040-a6b1-6ff6857658d8",
                                        "glosses": [
                                            "Action de prédire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7ecf2ad-1fa9-4b95-aa0a-b3063a834c8c",
                                                "sense_id": "c1f8e04f-e1fb-38fe-a2cb-e4de66d23626",
                                                "text": "Faire une prédiction."
                                            },
                                            {
                                                "example_id": "a99c430b-f801-4484-8d0a-6ba44562c57a",
                                                "sense_id": "c1f8e04f-e1fb-38fe-a2cb-e4de66d23626",
                                                "text": "Se mêler de prédiction."
                                            },
                                            {
                                                "example_id": "18ea3fd9-e2ef-4ded-9406-903d0aa49133",
                                                "sense_id": "c1f8e04f-e1fb-38fe-a2cb-e4de66d23626",
                                                "text": "Avoir le don de prédiction."
                                            },
                                            {
                                                "example_id": "e8eb924e-71e1-45ee-852b-9bf51d4cbf3f",
                                                "sense_id": "c1f8e04f-e1fb-38fe-a2cb-e4de66d23626",
                                                "text": "Les astrologues avaient fait un art de la prédiction."
                                            },
                                            {
                                                "example_id": "10442556-4ce3-4134-9c47-ace821985161",
                                                "sense_id": "c1f8e04f-e1fb-38fe-a2cb-e4de66d23626",
                                                "text": "Comme nous l’avons vu, notre système cognitif réalise en permanence des prédictions sur les événements à venir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6c19a412-351c-34e0-8ce5-695b0b04a1cc",
                                        "entry_id": "2b05d9ee-0fa9-3040-a6b1-6ff6857658d8",
                                        "glosses": [
                                            "Chose qui est prédite."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1890a7a-d5a7-4a0b-9a72-779254555abc",
                                                "sense_id": "6c19a412-351c-34e0-8ce5-695b0b04a1cc",
                                                "text": "Bah ! vous croyez, Madame, dit le roi d’un air qui indiquait qu’il n’ajoutait pas grande foi aux prédictions de sa mère."
                                            },
                                            {
                                                "example_id": "79dc1b98-e91d-4718-b119-3323e1ec7eec",
                                                "sense_id": "6c19a412-351c-34e0-8ce5-695b0b04a1cc",
                                                "text": "C’était la première fois dans sa vie que Zaheira avait ajouté foi à des prédictions de ce genre. La compagnie des femmes du village, depuis son mariage, l’avait peu à peu inclinée vers ces superstitions."
                                            },
                                            {
                                                "example_id": "65f2b862-f772-4b8b-b6ef-6094ab90b363",
                                                "sense_id": "6c19a412-351c-34e0-8ce5-695b0b04a1cc",
                                                "text": "C'est un bon métier que celui de prophète, mais à la condition d'y éviter les trop grosses bourdes et de ne pas montrer aux simples mortels combien est peu sensible parfois l’écart entre une prédiction et une bévue."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
