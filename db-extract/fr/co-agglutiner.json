                "senses": [
                    {
                        "sense_id": "07896640-3ac1-3f1a-a59b-9acc20134ed0",
                        "entry_id": "e5a2c443-c76f-35c3-9f19-b5d84a5f4e9a",
                        "glosses": [
                            "Agglutiner en même temps (le système portant un antigène et le système portant son anticorps)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43c3871f-f379-4b71-94b4-9a807d64ea85",
                                "sense_id": "07896640-3ac1-3f1a-a59b-9acc20134ed0",
                                "text": "Il était intéressant, en particulier, de se demander si le sérum de ces malades, des actinomycosiques par exemple, n'exerçait pas une action co-agglutinante ou co-fixatrice sur la sporotrichum, de la même façon que le sérum des sujets atteints d'affections paratyphoïdes peut co-agglutiner ou co-fixer le bacille d'Eherlh et inversement."
                            }
                        ]
                    },
                    {
                        "sense_id": "a71e6485-2df5-3162-ae03-b6ae1b9ca4a0",
                        "entry_id": "e5a2c443-c76f-35c3-9f19-b5d84a5f4e9a",
                        "glosses": [
                            "Définition manquante ou à compléter. (Ajouter)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b8056d4-ac28-4386-b752-ec1ddc9272bf",
                                "sense_id": "a71e6485-2df5-3162-ae03-b6ae1b9ca4a0",
                                "text": "Les anticorps anti Brucella donnent des réactions croisées avec (co-agglutinent) avec : Yersinia entérocolitica O:9; (...)"
                            }
                        ]
                    }
