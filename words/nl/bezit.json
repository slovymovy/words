                            },
                            {
                                "target_lang_word": "property",
                                "target_lang_sense_clarification": "things that are owned by someone"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "собственность",
                                "target_lang_sense_clarification": "имущество, принадлежащее кому-либо"
