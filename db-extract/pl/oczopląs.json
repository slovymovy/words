                "senses": [
                    {
                        "sense_id": "9985342e-42c0-3843-93f4-62e6f06f0149",
                        "entry_id": "b7701686-0395-39e1-9eed-3d063bc481e6",
                        "glosses": [
                            "mimowolne drganie gałek ocznych wywołane chorobą lub wadą wzroku"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8cf45308-012a-4b97-8056-389b2558fc4d",
                                "sense_id": "9985342e-42c0-3843-93f4-62e6f06f0149",
                                "text": "Tym razem jednak mimo wizyt w przychodni i brania leków stan pogarszał się. Pojawiły się wymioty i oczopląs."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "33120a06-c175-3979-bb44-1a3bda70b5b1",
                        "entry_id": "b7701686-0395-39e1-9eed-3d063bc481e6",
                        "glosses": [
                            "wrażenie migania przed oczami spowodowane nadmiarem lub zbytnią intensywnością bodźców wzrokowych"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "d8f8a3b4-453c-4477-a7f1-bf662926e5bc",
                                "sense_id": "33120a06-c175-3979-bb44-1a3bda70b5b1",
                                "text": "Do oświetlenia to się zupełnie nie nadawało, co najwyżej migające żarówki mogłyby doprowadzić do oczopląsu, dlatego po domach paliły się albo lampy naftowe, albo dające jasne światło, lecz charakterystyczny niemiły zapach karbidówki."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
