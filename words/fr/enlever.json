{
    "word_family": [
        "enlèvement",
        "enlevage",
        "enleveur"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2254f690-5b40-3037-a7a4-4bf2341685dd",
                    "sense_definition": "Ôter un vêtement, une parure ou un accessoire que l'on porte sur soi.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "retirer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tu peux <w>enlever</w> ton manteau et l'accrocher dans l'entrée."
                        },
                        {
                            "text": "Il <w>enlève</w> ses chaussures dès qu'il rentre à la maison."
                        }
                    ],
                    "synonyms": [
                        "ôter",
                        "retirer"
                    ],
                    "antonyms": [
                        "mettre"
                    ],
                    "common_phrases": [
                        "enlever son manteau",
                        "enlever ses chaussures"
                    ]
                },
                {
                    "sense_id": "05a11a48-d7d7-3beb-a294-6a8754c11500",
                    "sense_definition": "Retirer, déplacer ou faire disparaître quelque chose d'un endroit ou d'une surface.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "retirer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce produit permet d'<w>enlever</w> efficacement les taches sur les tissus."
                        },
                        {
                            "text": "Nous devons <w>enlever</w> la poussière accumulée sur ces vieux meubles."
                        }
                    ],
                    "synonyms": [
                        "retirer",
                        "ôter"
                    ],
                    "common_phrases": [
                        "enlever une tache",
                        "enlever la poussière"
                    ]
                },
                {
                    "sense_id": "0b78c876-e227-30b5-b7c0-95e6125778e5",
                    "sense_definition": "Emporter ou retenir une personne contre son gré ; séquestrer ou kidnapper.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "kidnapper",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les criminels ont menacé d'<w>enlever</w> un enfant pour réclamer une rançon."
                        },
                        {
                            "text": "La police recherche activement le groupe qui a <w>enlevé</w> le diplomate."
                        }
                    ],
                    "synonyms": [
                        "kidnapper",
                        "ravir",
                        "séquestrer"
                    ],
                    "common_phrases": [
                        "enlever un enfant"
                    ]
                },
                {
                    "sense_id": "170c6724-8ef9-3d48-93ce-245a15c76f93",
                    "sense_definition": "Gagner, remporter un prix ou obtenir une victoire avec éclat.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "gagner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La jeune athlète est parvenue à <w>enlever</w> la victoire finale."
                        },
                        {
                            "text": "Son projet novateur a réussi à <w>enlever</w> tous les suffrages du jury."
                        }
                    ],
                    "synonyms": [
                        "décrocher",
                        "gagner",
                        "remporter"
                    ],
                    "common_phrases": [
                        "enlever la victoire",
                        "enlever les suffrages"
                    ]
                },
                {
                    "sense_id": "cda792d1-edb6-3c05-817e-c83dfe03498e",
                    "sense_definition": "Soulever de terre ou élever avec force et rapidité.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "soulever",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une violente bourrasque a soudainement <w>enlevé</w> le toit de la grange."
                        },
                        {
                            "text": "Le sportif parvient à <w>enlever</w> du sol cette lourde charge d'un seul geste."
                        }
                    ],
                    "synonyms": [
                        "hisser",
                        "soulever"
                    ],
                    "common_phrases": [
                        "enlever du sol"
                    ]
                }
            ]
        }
    ]
}