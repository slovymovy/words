{
    "word_family": [
        "заключение",
        "заключительный",
        "заключенный"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "35487125-17ca-3f2a-a5fe-a93f35cda61d",
                    "sense_definition": "состоять в чем-либо, иметь своей сутью что-либо",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "содержание",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В <w>заключается</w> вся суть этой сложной проблемы.",
                            "target_lang_translations": {
                                "en": "The whole point of this complex problem <w>lies in</w> this."
                            }
                        },
                        {
                            "text": "Главная трудность <w>заключается</w> в нехватке времени.",
                            "target_lang_translations": {
                                "en": "The main difficulty <w>consists in</w> a lack of time."
                            }
                        }
                    ],
                    "synonyms": [
                        "состоять"
                    ],
                    "common_phrases": [
                        "заключается в том"
                    ],
                    "target_lang_definitions": {
                        "en": "to consist of or have as its essence something"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to consist in",
                                "target_lang_sense_clarification": "used to define the essence or main component of a situation"
                            },
                            {
                                "target_lang_word": "to lie in",
                                "target_lang_sense_clarification": "used to indicate where the core of a problem or issue is located"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "03bd8249-c2a7-31d9-a688-9194ea188afa",
                    "sense_definition": "находиться внутри чего-либо, содержаться в чем-либо",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "содержание",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В этом документе <w>заключается</w> важная информация для проекта.",
                            "target_lang_translations": {
                                "en": "This document <w>contains</w> important information for the project."
                            }
                        },
                        {
                            "text": "В его словах <w>заключался</w> скрытый смысл, который никто не понял.",
                            "target_lang_translations": {
                                "en": "His words <w>held</w> a hidden meaning that no one understood."
                            }
                        }
                    ],
                    "synonyms": [
                        "содержаться"
                    ],
                    "target_lang_definitions": {
                        "en": "to be contained within something"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to be contained in",
                                "target_lang_sense_clarification": "to be present inside a document, text, or object"
                            },
                            {
                                "target_lang_word": "to hold",
                                "target_lang_sense_clarification": "to contain or carry a specific meaning or information"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4501c02d-71ea-3cd2-aaa0-c6034e4169b7",
                    "sense_definition": "официально подписываться или оформляться (о договорах, сделках)",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "договор",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Новые контракты <w>заключаются</w> каждый месяц в нашем офисе.",
                            "target_lang_translations": {
                                "en": "New contracts <w>are concluded</w> every month in our office."
                            }
                        },
                        {
                            "text": "Договоры часто <w>заключаются</w> на очень выгодных условиях.",
                            "target_lang_translations": {
                                "en": "Contracts are often <w>signed</w> on very favorable terms."
                            }
                        }
                    ],
                    "synonyms": [
                        "подписываться"
                    ],
                    "common_phrases": [
                        "договоры заключаются"
                    ],
                    "target_lang_definitions": {
                        "en": "to be officially signed or formalized (regarding contracts or deals)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to be concluded",
                                "target_lang_sense_clarification": "formal term for finalizing a contract or agreement"
                            },
                            {
                                "target_lang_word": "to be signed",
                                "target_lang_sense_clarification": "the act of formalizing a legal agreement"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9bac8a9f-65b7-3ce8-b145-23a23c1ac12c",
                    "sense_definition": "завершаться, заканчиваться чем-либо",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "завершение",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Официальное письмо обычно <w>заключается</w> вежливым приветствием.",
                            "target_lang_translations": {
                                "en": "An official letter usually <w>concludes</w> with a polite greeting."
                            }
                        },
                        {
                            "text": "Выступление <w>заключалось</w> подведением итогов всей конференции.",
                            "target_lang_translations": {
                                "en": "The speech <w>ended with</w> a summary of the entire conference."
                            }
                        }
                    ],
                    "synonyms": [
                        "завершаться"
                    ],
                    "target_lang_definitions": {
                        "en": "to finish or end with something"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to conclude",
                                "target_lang_sense_clarification": "to bring a speech or document to an end"
                            },
                            {
                                "target_lang_word": "to end with",
                                "target_lang_sense_clarification": "to have a specific closing element"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5f4a7f2b-4a1e-3bd1-837b-582bafff0877",
                    "sense_definition": "помещаться под стражу, лишаться свободы",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "арест",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Опасные преступники <w>заключаются</w> в тюрьмы строгого режима.",
                            "target_lang_translations": {
                                "en": "Dangerous criminals <w>are imprisoned</w> in maximum-security prisons."
                            }
                        },
                        {
                            "text": "Подозреваемого <w>заключают</w> под стражу до начала суда.",
                            "target_lang_translations": {
                                "en": "The suspect is <w>taken into custody</w> before the trial begins."
                            }
                        }
                    ],
                    "synonyms": [
                        "арестовываться"
                    ],
                    "common_phrases": [
                        "заключаться под стражу"
                    ],
                    "target_lang_definitions": {
                        "en": "to be placed in custody or deprived of freedom"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to be imprisoned",
                                "target_lang_sense_clarification": "to be put into a prison"
                            },
                            {
                                "target_lang_word": "to be taken into custody",
                                "target_lang_sense_clarification": "legal term for being detained by authorities"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f4b1f032-4f04-37fb-a64f-05acf1b12790",
                    "sense_definition": "поселяться или размещаться где-либо",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "размещение",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В прошлом многие люди <w>заключались</w> в монастыри для молитв.",
                            "target_lang_translations": {
                                "en": "In the past, many people <w>cloistered themselves</w> in monasteries for prayer."
                            }
                        },
                        {
                            "text": "Он решил <w>заключиться</w> в уединении своего загородного дома.",
                            "target_lang_translations": {
                                "en": "He decided to <w>seclude himself</w> in the privacy of his country house."
                            }
                        }
                    ],
                    "synonyms": [
                        "уединяться"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "устаревшее употребление"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to settle or seclude oneself somewhere (archaic)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to seclude oneself",
                                "target_lang_sense_clarification": "to withdraw into isolation"
                            },
                            {
                                "target_lang_word": "to cloister oneself",
                                "target_lang_sense_clarification": "to withdraw into a religious or isolated environment"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}