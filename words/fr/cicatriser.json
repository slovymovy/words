                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette pommade aide la peau à <w>cicatriser</w> plus rapidement après une intervention chirurgicale."
                        },
                        {
                            "text": "Il faut nettoyer soigneusement la coupure pour qu'elle puisse bien <w>cicatriser</w>."
