                },
                {
                    "sense_id": "1dacb58a-6c10-34e8-b968-028b6d566d2c",
                    "sense_definition": "met een machine honing uit een raat halen door middel van middelpuntvliedende kracht",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "techniek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De imker is de hele middag bezig geweest om de honing te <w>slingeren</w>.",
                            "target_lang_translations": {
                                "en": "The beekeeper spent the whole afternoon <w>spinning</w> the honey."
                            }
                        },
                        {
                            "text": "Nadat de raten zijn geoogst, moeten we ze direct <w>slingeren</w>.",
                            "target_lang_translations": {
                                "en": "After the combs are harvested, we must <w>extract</w> them immediately."
                            }
                        }
                    ],
                    "common_phrases": [
                        "honing slingeren"
                    ],
                    "target_lang_definitions": {
