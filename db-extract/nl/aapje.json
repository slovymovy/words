                        "sense_id": "5513f98a-babe-38a4-aa26-b8d827f4c172",
                        "entry_id": "c52110f9-e761-3739-ab29-1b082be728bc",
                        "glosses": [
                            "verkleinwoord enkelvoud van het zelfstandig naamwoord aap"
                        ],
                        "tags": [
