                "senses": [
                    {
                        "sense_id": "4f05683e-46b0-350d-badf-1f08fe24b968",
                        "entry_id": "c7523d5e-9663-33cc-a4d8-9fefd35912d7",
                        "glosses": [
                            "общее название инструментов, служащих для измерения высоты точек земной поверхности (геод.), высоты деревьев (лес.), высоты полёта летательного аппарата (авиац.), высоты полёта и разрыва снарядов (воен.) и т. п."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28f9ab13-a823-4bee-a365-d794f543f85f",
                                "sense_id": "4f05683e-46b0-350d-badf-1f08fe24b968",
                                "text": "Я посмотрел на высотомер: двести метров, стрелка медленно ползла от цифры к цифре. Мы набирали высоту."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3413417f-05ed-4385-800c-09fb86b39a01",
                        "source_entry_id": "c7523d5e-9663-33cc-a4d8-9fefd35912d7",
                        "source_sense_id": "4f05683e-46b0-350d-badf-1f08fe24b968",
                        "target_lang_word": "altimeter",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "altimeter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "29055d43-31fc-3956-bbae-7f4896b490eb",
                                        "entry_id": "815a07f4-b986-33fa-9526-ca75eb0363b2",
                                        "glosses": [
                                            "An apparatus for measuring altitude."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d88e9ed9-294b-43cf-a55e-d49613bbe009",
                                                "sense_id": "29055d43-31fc-3956-bbae-7f4896b490eb",
                                                "text": "For that reason, if you do any mountain climbing, allow a generous margin of error of extra altitude—not only for possible altimeter error, but also for downdrafts that are particularly prevalent if high winds are encountered."
                                            }
                                        ]
