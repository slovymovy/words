                            }
                        ]
                    }
                },
                {
                    "sense_id": "53b429e0-4ce6-3eb5-8570-961d4b2ccc71",
                    "sense_definition": "малолетний слуга или работник",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В старых книгах часто описывают, как <w>мальчик</w> прислуживал гостям за столом.",
                            "target_lang_translations": {
                                "en": "Old books often describe how a <w>boy</w> served guests at the table.",
                                "de": "In alten Büchern wird oft beschrieben, wie ein <w>Junge</w> den Gästen bei Tisch bediente.",
                                "pl": "W starych książkach często opisuje się, jak <w>chłopiec</w> usługiwał gościom przy stole.",
                                "fr": "Les vieux livres décrivent souvent comment un <w>garçon</w> servait les invités à table."
                            }
                        },
                        {
                            "text": "Хозяин трактира кликнул <w>мальчика</w> и велел ему подать гостю чаю.",
                            "target_lang_translations": {
                                "en": "The tavern keeper called for his <w>boy</w> and told him to bring the guest some tea.",
                                "de": "Der Schankwirt rief den <w>Jungen</w> herbei und hieß ihn, dem Gast Tee zu bringen.",
                                "pl": "Właściciel szynku zawołał <w>chłopca</w> i kazał mu podać gościowi herbatę.",
                                "fr": "L'aubergiste appela le <w>garçon</w> et lui ordonna de servir du thé au client."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "устаревшее значение"
                        }
                    ],
