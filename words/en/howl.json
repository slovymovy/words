{
    "word_family": [
        "howler",
        "howling"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0482a286-3c5e-3530-a61a-5bba4326f7ea",
                    "sense_definition": "To utter a loud, long, and mournful cry, typical of a dog or a wolf.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "animal_sounds",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wolves began to <w>howl</w> at the moon as soon as the sun went down.",
                            "target_lang_translations": {
                                "ru": "Волки начали <w>выть</w> на луну, как только зашло солнце."
                            }
                        },
                        {
                            "text": "We could hear a lonely dog <w>howl</w> in the distance throughout the night.",
                            "target_lang_translations": {
                                "ru": "Всю ночь мы слышали, как вдалеке <w>воет</w> одинокая собака."
                            }
                        }
                    ],
                    "synonyms": [
                        "bay",
                        "yowl"
                    ],
                    "common_phrases": [
                        "howl at the moon"
                    ],
                    "target_lang_definitions": {
                        "ru": "Издавать громкий, долгий и заунывный крик, характерный для собаки или волка."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выть",
                                "target_lang_sense_clarification": "о животных"
                            },
                            {
                                "target_lang_word": "завывать",
                                "target_lang_sense_clarification": "протяжно"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "21dfb022-f244-3656-8d2a-a427d4105cb2",
                    "sense_definition": "To make a loud noise similar to an animal's cry, often due to strong emotion or natural forces.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vocal_expression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The audience started to <w>howl</w> with laughter after the comedian told his best joke.",
                            "target_lang_translations": {
                                "ru": "Зрители начали <w>хохотать</w> до упаду после того, как комик рассказал свою лучшую шутку."
                            }
                        },
                        {
                            "text": "The wind began to <w>howl</w> through the trees during the heavy storm.",
                            "target_lang_translations": {
                                "ru": "Во время сильной бури ветер начал <w>завывать</w> в деревьях."
                            }
                        }
                    ],
                    "synonyms": [
                        "roar",
                        "bellow"
                    ],
                    "common_phrases": [
                        "howl with laughter",
                        "howl with pain"
                    ],
                    "target_lang_definitions": {
                        "ru": "Издавать громкий звук, похожий на крик животного, часто из-за сильных эмоций или сил природы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выть",
                                "target_lang_sense_clarification": "о ветре или смехе"
                            },
                            {
                                "target_lang_word": "завывать",
                                "target_lang_sense_clarification": "о ветре"
                            },
                            {
                                "target_lang_word": "хохотать",
                                "target_lang_sense_clarification": "громко смеяться"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "521efdfd-ee74-3355-8d19-7e4b9bec685d",
                    "sense_definition": "To cry out loudly in order to express deep pain, distress, or grief.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "vocal_expression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The injured player started to <w>howl</w> in agony while waiting for the medics.",
                            "target_lang_translations": {
                                "ru": "Травмированный игрок начал <w>выть</w> от боли в ожидании медиков."
                            }
                        },
                        {
                            "text": "She could only <w>howl</w> in grief when she heard the tragic news.",
                            "target_lang_translations": {
                                "ru": "Услышав трагическую новость, она могла только <w>рыдать</w> навзрыд."
                            }
                        }
                    ],
                    "synonyms": [
                        "wail",
                        "bawl"
                    ],
                    "common_phrases": [
                        "howl in agony",
                        "howl in grief"
                    ],
                    "target_lang_definitions": {
                        "ru": "Громко кричать, выражая глубокую боль, страдание или горе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выть",
                                "target_lang_sense_clarification": "от боли или горя"
                            },
                            {
                                "target_lang_word": "реветь",
                                "target_lang_sense_clarification": "громко плакать"
                            },
                            {
                                "target_lang_word": "завывать",
                                "target_lang_sense_clarification": "причитать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5665e0fa-dcfd-3172-9891-0b6dff0a7d18",
                    "sense_definition": "To shout or utter something with a very loud outcry.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "vocal_expression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The protesters began to <w>howl</w> abuse at the politicians as they entered the building.",
                            "target_lang_translations": {
                                "ru": "Протестующие начали <w>выкрикивать</w> оскорбления в адрес политиков, когда те входили в здание."
                            }
                        },
                        {
                            "text": "It is common for the crowd to <w>howl</w> derision when the referee makes a mistake.",
                            "target_lang_translations": {
                                "ru": "Толпа часто <w>осыпает</w> судью насмешками, когда он совершает ошибку."
                            }
                        }
                    ],
                    "synonyms": [
                        "shout",
                        "yell"
                    ],
                    "common_phrases": [
                        "howl derision",
                        "howl abuse"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выкрикивать что-либо очень громко."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выкрикивать",
                                "target_lang_sense_clarification": "громко кричать"
                            },
                            {
                                "target_lang_word": "орать",
                                "target_lang_sense_clarification": "грубо кричать"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e0883d40-2b93-3ba2-b6b8-232378bfe274",
                    "sense_definition": "A long, sad-sounding cry made by a dog, wolf, or other animal.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "animal_sounds",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The eerie <w>howl</w> of a dingo echoed across the empty desert.",
                            "target_lang_translations": {
                                "ru": "Жуткий <w>вой</w> динго эхом разносился по пустой пустыне."
                            }
                        },
                        {
                            "text": "We were startled by a sudden <w>howl</w> coming from the woods.",
                            "target_lang_translations": {
                                "ru": "Мы вздрогнули от внезапного <w>воя</w>, донесшегося из леса."
                            }
                        }
                    ],
                    "synonyms": [
                        "yowl",
                        "cry"
                    ],
                    "common_phrases": [
                        "eerie howl",
                        "distant howl"
                    ],
                    "target_lang_definitions": {
                        "ru": "Долгий, печальный крик, издаваемый собакой, волком или другим животным."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вой",
                                "target_lang_sense_clarification": "животного"
                            },
                            {
                                "target_lang_word": "вытьё",
                                "target_lang_sense_clarification": "процесс"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5251f7c6-9187-3f94-8ef4-86553556e3ee",
                    "sense_definition": "A loud noise that sounds like an animal's cry, such as the sound of the wind.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "sounds",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The constant <w>howl</w> of the wind made it difficult to sleep.",
                            "target_lang_translations": {
                                "ru": "Постоянный <w>вой</w> ветра мешал спать."
                            }
                        },
                        {
                            "text": "A <w>howl</w> of protest rose from the crowd when the decision was announced.",
                            "target_lang_translations": {
                                "ru": "Когда решение было объявлено, в толпе поднялся <w>гул</w> протеста."
                            }
                        }
                    ],
                    "synonyms": [
                        "roar",
                        "wail"
                    ],
                    "common_phrases": [
                        "howl of the wind",
                        "howl of protest"
                    ],
                    "target_lang_definitions": {
                        "ru": "Громкий шум, напоминающий крик животного, например, звук ветра."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вой",
                                "target_lang_sense_clarification": "ветра"
                            },
                            {
                                "target_lang_word": "завывание",
                                "target_lang_sense_clarification": "ветра"
                            },
                            {
                                "target_lang_word": "рёв",
                                "target_lang_sense_clarification": "сильный гул"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e4ccd25f-7eaf-3674-b241-45796558620e",
                    "sense_definition": "A long cry of pain, sadness, or anger.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "vocal_expression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The child let out a <w>howl</w> of anguish after falling off his bike.",
                            "target_lang_translations": {
                                "ru": "Упав с велосипеда, ребенок издал <w>вопль</w> боли."
                            }
                        },
                        {
                            "text": "His joke was met with a <w>howl</w> of delight from the children.",
                            "target_lang_translations": {
                                "ru": "Его шутка была встречена <w>визгом</w> восторга со стороны детей."
                            }
                        }
                    ],
                    "synonyms": [
                        "wail",
                        "shriek"
                    ],
                    "common_phrases": [
                        "howl of anguish",
                        "howl of delight"
                    ],
                    "target_lang_definitions": {
                        "ru": "Продолжительный крик боли, печали или гнева."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вопль",
                                "target_lang_sense_clarification": "громкий крик"
                            },
                            {
                                "target_lang_word": "вой",
                                "target_lang_sense_clarification": "плач"
                            },
                            {
                                "target_lang_word": "рёв",
                                "target_lang_sense_clarification": "громкий плач"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}
