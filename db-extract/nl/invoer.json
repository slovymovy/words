                "senses": [
                    {
                        "sense_id": "25f81de1-760d-32a2-8138-c3d0c9c552b1",
                        "entry_id": "f00e5ff4-4014-3ce6-b47d-7422c4acfa06",
                        "glosses": [
                            "input"
                        ],
                        "tags": [
                            "masculine",
