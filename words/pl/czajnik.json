                    "sense_id": "9b88665f-1a95-3762-8aed-c2728bba998c",
                    "sense_definition": "Zamknięte od góry naczynie z dziobkiem służące do podgrzewania i gotowania wody.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "kitchen_vessel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Woda w <w>czajniku</w> już się gotuje!",
                            "target_lang_translations": {
                                "ru": "Вода в <w>чайнике</w> уже кипит!",
                                "en": "The water in the <w>kettle</w> is already boiling!",
                                "nl": "Het water in de <w>waterkoker</w> kookt al!",
                                "de": "Das Wasser im <w>Wasserkocher</w> kocht schon!",
                                "fr": "L'eau dans la <w>bouilloire</w> bout déjà !",
                                "it": "L'acqua nel <w>bollitore</w> sta già bollendo!",
                                "cs": "Voda v <w>konvici</w> už se vaří!",
                                "tr": "<w>Çaydanlıktaki</w> su çoktan kaynıyor!",
                                "es": "¡El agua en el <w>hervidor</w> ya está hirviendo!"
                            }
                        },
                        {
                            "text": "Muszę kupić nowy <w>czajnik</w> elektryczny, bo stary się zepsuł.",
                            "target_lang_translations": {
                                "ru": "Мне нужно купить новый электрический <w>чайник</w>, потому что старый сломался.",
                                "en": "I need to buy a new electric <w>kettle</w> because the old one broke.",
                                "nl": "Ik moet een nieuwe elektrische <w>waterkoker</w> kopen, want de oude is kapot.",
                                "de": "Ich muss einen neuen elektrischen <w>Wasserkocher</w> kaufen, weil der alte kaputtgegangen ist.",
                                "fr": "Je dois acheter une nouvelle <w>bouilloire</w> électrique parce que l'ancienne est en panne.",
                                "it": "Devo comprare un nuovo <w>bollitore</w> elettrico perché quello vecchio si è rotto.",
                                "cs": "Musím si koupit novou rychlovarnou <w>konvici</w>, protože ta stará se rozbila.",
                                "tr": "Yeni bir elektrikli <w>su ısıtıcısı</w> almam gerekiyor çünkü eskisi bozuldu.",
                                "es": "Tengo que comprar un <w>hervidor</w> eléctrico nuevo porque el viejo se rompió."
                            }
                        }
                    ],
                    "synonyms": [
                        "sagan",
