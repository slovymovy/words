            {
                "entry_id": "73e19ded-6bc1-33ee-9c2e-5e9b027c6201",
                "word": "postern",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "2c774010-1258-4b35-93bd-f0ade3cb2841",
                        "entry_id": "73e19ded-6bc1-33ee-9c2e-5e9b027c6201",
                        "tags": [
                            "plural"
                        ],
                        "form": "posterns"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a1e2f360-bc5e-3d5e-82e8-19d5a38d8101",
                        "entry_id": "73e19ded-6bc1-33ee-9c2e-5e9b027c6201",
                        "glosses": [
                            "A back gate, back door, side entrance, or other gateway distinct from the main entrance, especially in a city wall or fortification."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8bbb1242-a736-491a-bc1e-e0068577ec40",
                                "sense_id": "a1e2f360-bc5e-3d5e-82e8-19d5a38d8101",
                                "text": "And as they cam hurlyng vnder the Castel where as sir launcelot lay in wyndowe / & sawe how two knyghtes layd vpon syr Blyaunt with their swerdes /[…]/ And thenne sir launcelot brake the chaynes fro his legges and of his armes /[…]/ & so sir launcelot ran out at a posterne / and there he mett with the two knyȝtes that chaced sir Blyaunt"
                            },
                            {
                                "example_id": "15acd2f9-788a-4c56-a757-1ffd733a13cb",
                                "sense_id": "a1e2f360-bc5e-3d5e-82e8-19d5a38d8101",
                                "text": "He by a privy postern took his flight."
                            },
                            {
                                "example_id": "c5afdf22-5a35-4e86-b336-fc80668a631d",
                                "sense_id": "a1e2f360-bc5e-3d5e-82e8-19d5a38d8101",
                                "text": "Out at the postern, by the abbey wall."
                            },
                            {
                                "example_id": "e58afed6-1c1a-4efb-9cf5-4d289d353d5d",
                                "sense_id": "a1e2f360-bc5e-3d5e-82e8-19d5a38d8101",
                                "text": "The Duke of Argyle led the way in silence to the small postern by which they had been admitted into Richmond Park, so long the favourite residence of Queen Caroline. It was opened by the same half-seen janitor, and they found themselves beyond the precincts of the royal demesne."
                            }
                        ]
                    },
                    {
                        "sense_id": "671bd819-e79c-36b6-9ed8-b4b35bba7096",
                        "entry_id": "73e19ded-6bc1-33ee-9c2e-5e9b027c6201",
                        "glosses": [
                            "A separate or hidden way in or out of a place, situation etc."
                        ],
                        "tags": [
                            "archaic",
                            "broadly"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "fc863afc-f459-3afd-8abb-a0145b2bd2a7",
                        "entry_id": "73e19ded-6bc1-33ee-9c2e-5e9b027c6201",
                        "glosses": [
                            "A subterranean passage communicating between the parade and the main ditch, or between the ditches and the interior of the outworks."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "7712b815-aef8-46ca-911c-b5a43bd0e8b7",
                                "sense_id": "fc863afc-f459-3afd-8abb-a0145b2bd2a7",
                                "text": "The postern of the enceinte leads through the middle of the curtain, descending from the plane of sight to the ditch"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f728e71e-b19c-4946-9366-ce180177da98",
                        "source_entry_id": "73e19ded-6bc1-33ee-9c2e-5e9b027c6201",
                        "source_sense_description": "secondary gateway",
                        "target_lang_word": "achterdeur",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "achterdeur",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "b5bcf62b-9f83-382b-a401-3cd54c305390",
                                        "entry_id": "cf8839f5-90aa-3036-8676-ce8ee258c510",
                                        "glosses": [
                                            "deur langs de achterkant van een gebouw"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "600052ab-93c4-4405-a6cf-ad005b00550c",
                                                "sense_id": "b5bcf62b-9f83-382b-a401-3cd54c305390",
                                                "text": "In een dorp komt men meestal via de niet gesloten achterdeur binnen."
                                            },
                                            {
                                                "example_id": "0768687e-ddda-4a5f-8684-df75f67f0fa0",
                                                "sense_id": "b5bcf62b-9f83-382b-a401-3cd54c305390",
                                                "text": "Geërgerd had Hind door het doorgeefraam een blik op de lege eettafels geworpen en was toen met Hbib in haar kielzog door de achterdeur naar buiten gelopen. De steeg had er verlaten en droefgeestig bij gelegen. Hind en Hbib keken toe hoe een jong stel langsliep. De man, die zijn arm om een bleke, tengere vrouw heen had geslagen, fluisterde iets in haar oor, waarna ze tot hun verbijstering haar hand op zijn kruis legde. Schaterend liepen ze de steeg uit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "00018bc9-7cfc-3eed-ba20-7e47991a705f",
                                        "entry_id": "cf8839f5-90aa-3036-8676-ce8ee258c510",
                                        "glosses": [
                                            "niet-officiële of heimelijke werkwijze"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "69561b9f-4d6c-4d8e-8db8-12a2853502d1",
                                                "sense_id": "00018bc9-7cfc-3eed-ba20-7e47991a705f",
                                                "text": "Hij heeft zijn diploma via een achterdeurtje gehaald."
                                            },
                                            {
                                                "example_id": "fdb3d23d-e67c-473d-b18d-0938c51be8ca",
                                                "sense_id": "00018bc9-7cfc-3eed-ba20-7e47991a705f",
                                                "text": "Als de overheid immers zélf procespartij is, heeft die wel toegang tot alle uitspraken. Via de achterdeur – de databases van de rechtbanken. Burgers hebben dat niet. Dat is rechtsongelijkheid die niet kan."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a808edf3-498e-4aa3-8862-15a2c8656fc9",
                        "source_entry_id": "73e19ded-6bc1-33ee-9c2e-5e9b027c6201",
                        "source_sense_description": "secondary gateway",
                        "target_lang_word": "achterpoort",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "achterpoort",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "c5b4a5bf-2a86-312a-bf8d-0fae6dc59afc",
                                        "entry_id": "d9b0ad59-2d87-3240-8f6f-44b31b069094",
                                        "glosses": [
                                            "een doorgang door een muur aan de achterzijde van een gebouw"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c43cc95-d6f4-4446-b5bf-44414e73e626",
                                                "sense_id": "c5b4a5bf-2a86-312a-bf8d-0fae6dc59afc",
                                                "text": "Voor In huis met een seriemoordenaar putten ze uit een gezamenlijk geheugen. Sanne: „De sfeer van de jaren zestig. De melkflessen bij de voordeur, het touwtje uit de brievenbus, buren die de achterpoort in en uit liepen.” Hij: „Nu zijn moorden aan de orde van de dag."
                                            },
                                            {
                                                "example_id": "e88eeacf-848e-4822-88d3-9a51ee6cf4ef",
                                                "sense_id": "c5b4a5bf-2a86-312a-bf8d-0fae6dc59afc",
                                                "text": "In de loop van de jaren veranderde de samenstelling van de buurt. Lage huren trokken mensen met lage inkomens. Zoals eenoudergezinnen en buitenlanders. Op voordeuren en achterpoorten verschenen stickers met afbeeldingen van vervaarlijke honden. ‘Ik heb maar 5 seconden nodig.’ ‘Betreden op eigen risico.’ ‘Hier is er maar een de baas. Dat ben ik.’"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e3db6de0-11ce-448f-8bc5-0f2fdfef3d99",
                        "source_entry_id": "73e19ded-6bc1-33ee-9c2e-5e9b027c6201",
                        "source_sense_description": "secondary gateway",
                        "target_lang_word": "zijingang",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zijingang",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "9123dfc0-b53c-3aaa-ab4d-1ff7bccba16f",
                                        "entry_id": "cf6bed54-708d-32b8-8149-6d68ab1e1d3b",
                                        "glosses": [
                                            "toegang aan de zijkant"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad4c2b63-62b5-414f-a8bf-fdc7c4f040f7",
                                                "sense_id": "9123dfc0-b53c-3aaa-ab4d-1ff7bccba16f",
                                                "text": "De schietpartij heeft geen gevolgen voor het vliegverkeer. Alle vluchten kunnen gewoon doorgaan. De terminal bleef via een zijingang bereikbaar."
                                            },
                                            {
                                                "example_id": "1607ff2f-6895-4132-94e4-a5f53546c77d",
                                                "sense_id": "9123dfc0-b53c-3aaa-ab4d-1ff7bccba16f",
                                                "text": "Onbekenden hebben vanochtend rond half vier een ramkraak gepleegd op juwelier/edelsmid Bilan in winkelcentrum Hasselo in Hengelo. De daders reden daarbij eerst een glazen pui van de zijingang aan diggelen en ramden vervolgens de winkelpui."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e0e1c7c1-7a8d-400e-b994-644a74e0728f",
                        "source_entry_id": "73e19ded-6bc1-33ee-9c2e-5e9b027c6201",
                        "source_sense_description": "secondary gateway",
                        "target_lang_word": "zijdeur",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zijdeur",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "978920e3-5836-3e89-9ded-6707e24078cb",
                                        "entry_id": "75e1c5e6-9025-3dba-96f2-daf6697fb8d4",
                                        "glosses": [
                                            "deur aan de zijkant van een gebouw of andere ruimte ook van toepassing op auto's, een andere deur dan de voordeur of hoofdingang"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9c5990e-d44b-4a9c-9256-803f0c9d5014",
                                                "sense_id": "978920e3-5836-3e89-9ded-6707e24078cb",
                                                "text": "De verlegen koning verdween via de zijdeur zodat hij niet in contact kwam met de fotografen die bij de voordeur op hem stonden te wachten."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0ef5ceef-11c2-4d8f-8d0d-ba1510bbf677",
                        "source_entry_id": "73e19ded-6bc1-33ee-9c2e-5e9b027c6201",
                        "source_sense_description": "secondary gateway",
                        "target_lang_word": "poterne",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "poterne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c11fe0e1-cb01-373d-bd17-34dad007ce5e",
                                        "entry_id": "1f65658d-24e4-3a13-995f-3b4cc6bc5dff",
                                        "glosses": [
                                            "Galerie souterraine, ménagée dans les fortifications pour faire des sorties secrètes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ba5bb2b-dd3b-4617-8286-3b9e645caf8f",
                                                "sense_id": "c11fe0e1-cb01-373d-bd17-34dad007ce5e",
                                                "text": "En parcourant l’enceinte intérieure de Carcassonne, on voit un grand nombre de poternes plus ou moins bien dissimulées et qui devaient permettre à la garnison de se répandre dans les lices par une quantité d’issues facilement masquées, ou de rentrer rapidement dans le cas où la première enceinte eût été forcée."
                                            },
                                            {
                                                "example_id": "22d43618-6af1-4dc2-81bf-cbfaec504d87",
                                                "sense_id": "c11fe0e1-cb01-373d-bd17-34dad007ce5e",
                                                "text": "La foule espère entrevoir une seconde Jack Ketch en personne (le bourreau), mais elle ignore qu'il est entré depuis quelque temps déjà par une poterne de service et qu'il s'en ira de même."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da8512b6-ccda-3299-9931-eb40ec3cbcae",
                                        "entry_id": "1f65658d-24e4-3a13-995f-3b4cc6bc5dff",
                                        "glosses": [
                                            "Porte qui ferme cette galerie."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "76a1ad35-3ba1-4b66-98d7-0fe8463acc83",
                                                "sense_id": "da8512b6-ccda-3299-9931-eb40ec3cbcae",
                                                "text": "On heurtait violemment à la poterne qui donnait accès dans la cour, protégée par de hautes murailles de bois."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "58c6fa3a-1b00-3e67-835b-2eeaa55df7bd",
                                        "entry_id": "1f65658d-24e4-3a13-995f-3b4cc6bc5dff",
                                        "glosses": [
                                            "Espèce de voûte faite sous un quai dans certaines villes pour pouvoir aller librement de la rue à la rivière."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "607f2f0c-c514-3bf9-9f81-5de80d590042",
                                        "entry_id": "1f65658d-24e4-3a13-995f-3b4cc6bc5dff",
                                        "glosses": [
                                            "Porte dérobée."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8b4a0e4e-992c-4c27-822c-0bd1011f0098",
                        "source_entry_id": "73e19ded-6bc1-33ee-9c2e-5e9b027c6201",
                        "source_sense_description": "secondary gateway",
                        "target_lang_word": "Hintertür",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hintertür",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "55948cda-a914-3e7c-a2c0-20f2daf956fa",
                                        "entry_id": "48b45d49-4a56-30b0-a90a-4aacd9e1a09e",
                                        "glosses": [
                                            "zusätzlicher Eingang zu einem Gebäude oder Raum, der sich an der Rückseite befindet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "445c94f8-ae1a-4223-b720-0882ce393aaf",
                                                "sense_id": "55948cda-a914-3e7c-a2c0-20f2daf956fa",
                                                "text": "Die Hintertür führt zur Terrasse und zum Garten."
                                            },
                                            {
                                                "example_id": "340e81d5-12bf-4414-8619-8164887dfc9a",
                                                "sense_id": "55948cda-a914-3e7c-a2c0-20f2daf956fa",
                                                "text": "„Am Nachmittag stahl ich mich mit Narcisse durch eine Hintertür davon, und wir machten einen langen Spaziergang.“"
                                            },
                                            {
                                                "example_id": "321b125f-38fd-4f75-bd8c-b127a2cf480d",
                                                "sense_id": "55948cda-a914-3e7c-a2c0-20f2daf956fa",
                                                "text": "„Er war durch die Hintertür geflüchtet.“"
                                            },
                                            {
                                                "example_id": "76d611c2-dddf-4ad4-9faf-06fcf65ec4c8",
                                                "sense_id": "55948cda-a914-3e7c-a2c0-20f2daf956fa",
                                                "text": "„Er versuchte, die Hintertür zu öffnen, aber sie war abgeschlossen.“"
                                            },
                                            {
                                                "example_id": "5f62ea8d-5281-412b-9a80-7dce748bc400",
                                                "sense_id": "55948cda-a914-3e7c-a2c0-20f2daf956fa",
                                                "text": "„Während dieses Gesprächs erschien in der Hintertür des Diwanzimmers der Kopf eines der Stubenmädchen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "17b6e629-5094-3162-b3a3-33959fef1cff",
                                        "entry_id": "48b45d49-4a56-30b0-a90a-4aacd9e1a09e",
                                        "glosses": [
                                            "Zugang für nicht-öffentliche Gäste oder für Dienstpersonal, Lieferanten"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d0588938-c1f5-4472-9abd-a31d594c4fa1",
                                                "sense_id": "17b6e629-5094-3162-b3a3-33959fef1cff",
                                                "text": "Er empfing seine Geliebte durch die Hintertür."
                                            },
                                            {
