                        "examples": [
                            {
                                "example_id": "6ac7d42c-54d1-4a36-a857-f4255ed358c2",
                                "sense_id": "aa516c26-640d-3e54-b24b-ced25a97eaf1",
                                "text": "Godronner de la vaisselle d’argent."
                            },
                            {
                                "example_id": "ccbc0bbf-6554-4ad5-bd4b-70f8e265e14f",
                                "sense_id": "aa516c26-640d-3e54-b24b-ced25a97eaf1",
                                "text": "Godronner une coiffure."
                            }
                        ]
                    },
                    {
                        "sense_id": "9163de31-9cb6-3dd0-a400-38973fb9d827",
                        "entry_id": "b32278a0-6716-3c52-b160-52258ad335d7",
                        "glosses": [
                            "Former des godrons."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b516497-1cd2-44b4-b0ed-f8fa38c7ae43",
                                "sense_id": "9163de31-9cb6-3dd0-a400-38973fb9d827",
                                "text": "Des collerettes godronnaient dans leurs cous bruns."
                            },
                            {
                                "example_id": "d956abcf-33f2-43b1-8427-0fb54e4e24cb",
                                "sense_id": "9163de31-9cb6-3dd0-a400-38973fb9d827",
                                "text": "Hedwige renonça à sa sieste, Fromentine dès trois heures s’était mise à godronner sa chevelure ; elle jouait maintenant avec ses quelques petites robes avant de se décider pour le smoking du soir de sa sœur aînée (dans la famille Boisrosé, vêtements, bas et souliers étaient interchangeables)."
                            }
                        ]
                    }
