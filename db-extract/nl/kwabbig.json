                "senses": [
                    {
                        "sense_id": "37d568de-a68b-309d-93ae-08887759260b",
                        "entry_id": "859c6387-593b-320e-a107-41954c27f123",
                        "glosses": [
                            "met de eigenschappen van een grote, weke vlees- of vetmassa"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a8690cab-73df-4426-9985-3713addb7dd1",
                                "sense_id": "37d568de-a68b-309d-93ae-08887759260b",
                                "text": "Twee miljoen doden later is hij een van de machtigste politici van Zuid-Soedan, dat 9 januari over onafhankelijkheid stemt. Juba groeide uit van een gehucht tot de Zuid-Soedanese hoofdstad, heeft banken, luxehotels en een casino. Er zijn asfaltwegen. Riëk kreeg ook een ander aangezicht, zijn fysieke charme is verdreven door een kwabbige buik. Maar die jongensachtige grijns staat nog steeds op zijn gezicht."
                            },
                            {
                                "example_id": "0df18b70-bb7d-41a7-be3c-e2ead5222dcb",
                                "sense_id": "37d568de-a68b-309d-93ae-08887759260b",
                                "text": "Om hun neus, wangen en rond de nagels van de poten schemeren wolkjes grauwwit. Hun heupbotten prikken door de vacht als een kleerhanger door een zachte blouse. Hun buik is uitgezakt, om hun hals en nek hangen kwabbige tressen vlees."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5c3687b9-547a-4b16-9528-14f35970856c",
                        "source_entry_id": "859c6387-593b-320e-a107-41954c27f123",
                        "source_sense_id": "37d568de-a68b-309d-93ae-08887759260b",
                        "source_sense_description": "met de eigenschappen van een grote, weke vlees- of vetmassa",
                        "target_lang_word": "pouchy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pouchy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "570913f2-6378-3360-b8bc-8ebabe47c0fe",
                                        "entry_id": "82821049-1912-343d-acd5-1fe1ea4c8c98",
                                        "glosses": [
                                            "Resembling a pouch; baggy"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4231922a-a19a-4390-b82d-3f68c6a1755a",
                                                "sense_id": "570913f2-6378-3360-b8bc-8ebabe47c0fe",
                                                "text": "He had a trick which I noticed even then, which grew on him later, of pulling his jowl with his right hand as he spoke, and his jowl was already fat and pouchy."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fd105dd3-5f05-4a07-9cab-9a77ae566720",
                        "source_entry_id": "859c6387-593b-320e-a107-41954c27f123",
                        "source_sense_id": "37d568de-a68b-309d-93ae-08887759260b",
                        "source_sense_description": "met de eigenschappen van een grote, weke vlees- of vetmassa",
                        "target_lang_word": "flabby",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "flabby",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c7fd5a9b-34d0-3e9b-83c8-1d30853b8ea3",
                                        "entry_id": "bb13d7b1-4bdd-309f-a813-f604d3558c91",
                                        "glosses": [
                                            "Yielding to the touch, and easily moved or shaken; hanging loose by its own weight; lacking firmness; flaccid."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "06bcf28a-b4cc-45cd-afec-0698a0843a87",
                                                "sense_id": "c7fd5a9b-34d0-3e9b-83c8-1d30853b8ea3",
                                                "text": "My attention was accidentally drawn to this aid, some five or six years ago, while attending a lady (multipara) in her confinement, who suffered from umbilical hernia, with large flabby abdomen."
                                            },
                                            {
                                                "example_id": "4dabf3af-a557-41ac-9b66-27d0cf72a8aa",
                                                "sense_id": "c7fd5a9b-34d0-3e9b-83c8-1d30853b8ea3",
                                                "text": "A neglected gap was all the gate it had, and the first glance at the place was enough to let you see the flabby devil was running that show."
                                            },
                                            {
                                                "example_id": "ec18f4d7-fbbe-495d-85e9-ecadbb964989",
                                                "sense_id": "c7fd5a9b-34d0-3e9b-83c8-1d30853b8ea3",
                                                "text": "The strings of some violins when up to pitch are loose and flabby; some are very taut and hard."
                                            },
                                            {
                                                "example_id": "a7699a30-63c7-4669-9ebc-3b672073c429",
                                                "sense_id": "c7fd5a9b-34d0-3e9b-83c8-1d30853b8ea3",
                                                "text": "Chassis of 1950s-1970s bikes are flabby tubular structures, often weak to the point of lacking straight-line stability!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3c2530e1-b1fc-3e2a-a9b3-51da4519eb00",
                                        "entry_id": "bb13d7b1-4bdd-309f-a813-f604d3558c91",
                                        "glosses": [
                                            "Having a slight lack of acidity; having mild sweetness."
                                        ],
                                        "tags": [
                                            "of wine"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5d240d34-5206-4a6c-aef5-cfd5afa5611a",
                                                "sense_id": "3c2530e1-b1fc-3e2a-a9b3-51da4519eb00",
                                                "text": "A flabby wine might be described as a wine in which nothing stands out."
                                            },
                                            {
                                                "example_id": "fd3db48d-a456-4e24-918f-dac4d0d49037",
                                                "sense_id": "3c2530e1-b1fc-3e2a-a9b3-51da4519eb00",
                                                "text": "An extremely hot region will give you flabby wine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6749c53c-b6da-3392-937d-45c0db6d167b",
                                        "entry_id": "bb13d7b1-4bdd-309f-a813-f604d3558c91",
                                        "glosses": [
                                            "overwrought."
                                        ],
                                        "tags": [
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1cb0cb64-add0-432d-a0ba-5d326de4c11c",
                                                "sense_id": "6749c53c-b6da-3392-937d-45c0db6d167b",
                                                "text": "As you revise, focus on eliminating flabby expressions. This takes conscious effort. As one expert copyeditor observed, “Trim sentences, like trim bodies, usually require far more effort than flabby ones."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "acc75ca6-3af8-3aa9-b17a-93a238b7a6a7",
                                        "entry_id": "bb13d7b1-4bdd-309f-a813-f604d3558c91",
                                        "glosses": [
                                            "Which forms a surjection from the domain to every open subset of the codomain."
                                        ],
