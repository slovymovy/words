{
    "word_family": [
        "whimsical",
        "whimsically",
        "whimsicality",
        "whimsicalness"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "df4e0c44-2321-3113-9a55-daaef08f48ac",
                    "sense_definition": "A playful, quaint, or fanciful quality or behavior that is often lighthearted and imaginative.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "playful_character",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children's book was full of <w>whimsy</w> and featured talking animals in colorful hats.",
                            "target_lang_translations": {
                                "ru": "Детская книга была полна <w>причудливости</w> и рассказывала о говорящих животных в ярких шляпах."
                            }
                        },
                        {
                            "text": "She added a touch of <w>whimsy</w> to her garden by placing small ceramic gnomes among the flowers.",
                            "target_lang_translations": {
                                "ru": "Она добавила саду нотку <w>игривости</w>, расставив среди цветов маленьких керамических гномов."
                            }
                        }
                    ],
                    "synonyms": [],
                    "antonyms": [
                        "seriousness",
                        "solemnity"
                    ],
                    "common_phrases": [
                        "touch of whimsy",
                        "sense of whimsy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Игривое, причудливое или фантазийное качество или поведение, часто беззаботное и воображаемое."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "причудливость",
                                "target_lang_sense_clarification": "необычность и фантазийность"
                            },
                            {
                                "target_lang_word": "причуда",
                                "target_lang_sense_clarification": "нечто странное и забавное"
                            },
                            {
                                "target_lang_word": "игривость",
                                "target_lang_sense_clarification": "легкость и фантазия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "028711ec-d30f-3f86-9986-7e7a92c0d992",
                    "sense_definition": "An impulsive, illogical, or capricious character or disposition.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "playful_character",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His sudden decision to quit his job and travel the world was driven by pure <w>whimsy</w>.",
                            "target_lang_translations": {
                                "ru": "Его внезапное решение бросить работу и отправиться в кругосветное путешествие было продиктовано чистым <w>капризом</w>."
                            }
                        },
                        {
                            "text": "The king was known for his <w>whimsy</w>, often changing laws based on his morning mood.",
                            "target_lang_translations": {
                                "ru": "Король был известен своим <w>своеволием</w>, часто меняя законы в зависимости от своего утреннего настроения."
                            }
                        }
                    ],
                    "synonyms": [],
                    "antonyms": [
                        "steadfastness",
                        "reliability"
                    ],
                    "target_lang_definitions": {
                        "ru": "Импульсивный, нелогичный или капризный характер или нрав."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "каприз",
                                "target_lang_sense_clarification": "внезапное и необоснованное желание"
                            },
                            {
                                "target_lang_word": "прихоть",
                                "target_lang_sense_clarification": "минутное желание или причуда"
                            },
                            {
                                "target_lang_word": "своеволие",
                                "target_lang_sense_clarification": "склонность действовать по прихоти"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e2c015b2-102c-3bc3-ab6c-948624d41405",
                    "sense_definition": "A jigsaw puzzle piece that has been cut into a recognizable shape, such as an animal or object.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "puzzle_terminology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I found a <w>whimsy</w> shaped like a butterfly while I was sorting the edge pieces of the puzzle.",
                            "target_lang_translations": {
                                "ru": "Я нашел <w>фигурную деталь</w> в форме бабочки, когда сортировал края пазла."
                            }
                        },
                        {
                            "text": "High-quality wooden puzzles often include several <w>whimsies</w> that match the theme of the picture.",
                            "target_lang_translations": {
                                "ru": "Высококачественные деревянные пазлы часто включают несколько <w>фигурок</w>, соответствующих тематике картины."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "specialized terminology for jigsaw puzzles"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Деталь пазла, вырезанная в форме узнаваемого предмета или животного."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фигурная деталь",
                                "target_lang_sense_clarification": "в контексте пазлов"
                            },
                            {
                                "target_lang_word": "фигурка",
                                "target_lang_sense_clarification": "деталь пазла в форме объекта"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "202f7ffa-2bb6-3a92-b147-47da5930b444",
                    "sense_definition": "A synonym of <w>whimsical</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The poet described the <w>whimsiest</w> creatures living deep within the enchanted forest.",
                            "target_lang_translations": {
                                "ru": "Поэт описал самых <w>причудливых</w> существ, живущих в глубине заколдованного леса."
                            }
                        },
                        {
                            "text": "In a <w>whimsy</w> mood, he decided to paint the entire kitchen bright purple.",
                            "target_lang_translations": {
                                "ru": "В <w>эксцентричном</w> настроении он решил выкрасить всю кухню в ярко-фиолетовый цвет."
                            }
                        }
                    ],
                    "synonyms": [
                        "whimsical"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "rarely used as an adjective in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Синоним слова «whimsical» (причудливый, эксцентричный)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "причудливый",
                                "target_lang_sense_clarification": "необычный и фантастический"
                            },
                            {
                                "target_lang_word": "эксцентричный",
                                "target_lang_sense_clarification": "своеобразный"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "34feb34f-7d77-35ff-822d-2e81fa9da382",
                    "sense_definition": "To fill with whimsies or to make someone act in a fantastic or crazed manner.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden influx of gold served only to <w>whimsy</w> his mind with greed and folly.",
                            "target_lang_translations": {
                                "ru": "Внезапный приток золота лишь <w>вскружил</w> ему голову жадностью и безрассудством."
                            }
                        },
                        {
                            "text": "He felt his brain <w>whimsied</w> by the strange and confusing events of the evening.",
                            "target_lang_translations": {
                                "ru": "Он чувствовал, что его разум <w>помутился</w> от странных и запутанных событий вечера."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Наполнять причудами или заставлять кого-либо вести себя фантастическим или безумным образом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вскружить голову",
                                "target_lang_sense_clarification": "наполнить странными мыслями"
                            },
                            {
                                "target_lang_word": "сводить с ума",
                                "target_lang_sense_clarification": "заставлять вести себя странно"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}
