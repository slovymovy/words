                    {
                        "sense_id": "5c5b6c5a-99d1-32d4-a0f9-502e17af0617",
                        "entry_id": "65ed9ec0-1359-32a5-b936-733134c102ea",
                        "glosses": [
                            "nawóz z przefermentowanych odchodów krów lub świń"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4cf55a8-e075-463c-890c-41f1d75e7440",
                                "sense_id": "5c5b6c5a-99d1-32d4-a0f9-502e17af0617",
                                "text": "Źródłem zanieczyszczeń wód są duże zakłady przemysłowe i miasta, a ostatnio także rolnictwo, zwłaszcza środki chemiczne i gnojowica przysparzają dużo kłopotów"
                            },
                            {
                                "example_id": "fac0b0c1-511a-45bf-8c37-fd5f5d3a3f56",
                                "sense_id": "5c5b6c5a-99d1-32d4-a0f9-502e17af0617",
                                "text": "Ilość powstającego metanu w przypadku gnojowicy świńskiej podczas magazynowania jest wyższa w porównaniu z gnojowicą bydlęcą"
                            }
                        ],
