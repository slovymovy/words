                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "serotonin",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "20266744-7d2d-3b7a-b8ed-f9cdb1f79b16",
                                        "entry_id": "71bb971f-b739-3471-89f7-dbcf716c4b85",
                                        "glosses": [
                                            "An indoleamine neurotransmitter, 5-hydroxytryptamine, that is involved in depression, appetite, etc., and is crucial in maintaining a sense of well-being, security, etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f720b260-fe00-482c-9a66-0b3c444261a5",
                                                "sense_id": "20266744-7d2d-3b7a-b8ed-f9cdb1f79b16",
                                                "text": "Notably, mouse lines targeting genes codifying for serotonin receptors, for enzymes involved in 5-HT synthesis as Tph1 and Tph2, in its metabolism as monoaminoxidase A (MAOA) or in its re-uptake as serotonin transporter (SERT), have been generated."
                                            },
                                            {
                                                "example_id": "70d98c8d-fe4a-442d-8d3e-6d4c8000ca61",
                                                "sense_id": "20266744-7d2d-3b7a-b8ed-f9cdb1f79b16",
                                                "text": "The class of antidepressants most commonly associated with sexual dysfunction is selective serotonin reuptake inhibitors, or SSRIs, which treat depression by ultimately increasing levels of the neurotransmitter serotonin in the brain."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
