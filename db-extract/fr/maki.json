                                            {
                                                "example_id": "8141f01e-5217-4faa-921b-d4c860510de5",
                                                "sense_id": "ba4512fd-0fc3-3fc4-9884-8e2d2ef45a5a",
                                                "text": "Lemuren sind vom Aussterben bedroht."
                                            },
                                            {
                                                "example_id": "2a19d882-ce68-4376-9545-1db7543ce23a",
                                                "sense_id": "ba4512fd-0fc3-3fc4-9884-8e2d2ef45a5a",
                                                "text": "„Die neuere Systematik teilt die Primaten in vier Unterordnungen: Lemuroidea oder Lemuren, Galagoidea oder Buschbabys und Loris, Tarsioidea oder Gespenstmakis und Simiae oder Affen.“"
                                            }
                                        ],
