                    {
                        "translation_id": "1a4bd558-a121-4f89-83ce-e1ea173fa19f",
                        "source_entry_id": "7b5565b5-ab3d-35ad-840f-45fc50366ca0",
                        "source_sense_id": "80dc5423-8959-3ada-9253-e1f1e9456d1b",
