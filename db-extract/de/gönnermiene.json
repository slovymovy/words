                "senses": [
                    {
                        "sense_id": "d957aee6-9413-3b5c-bc83-e3a2de81d738",
                        "entry_id": "dd3eb0c1-f06c-31e4-816c-425718c872d4",
                        "glosses": [
                            "Gesichtsausdruck, der eine leicht herablassende Freundlichkeit verrät"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "e0b87190-6614-4f11-b739-259649b5b9bd",
                                "sense_id": "d957aee6-9413-3b5c-bc83-e3a2de81d738",
                                "text": "„Ich konnte mich nicht an ihre vermaledeite Gönnermiene gewöhnen, die sich nicht mit der Liebe vereinbaren läßt; aber ich sah ein, daß sie im Beisein des Kardinals nicht anders handeln konnte.“"
                            },
                            {
                                "example_id": "96ad87ec-7a34-4d40-aa31-a57c79637c46",
                                "sense_id": "d957aee6-9413-3b5c-bc83-e3a2de81d738",
                                "text": "„Häufig hatte er mit der Gönnermiene eines spanischen Granden sein letztes Geld für ein fürstliches Trinkgeld verwendet und nicht einmal mehr den Betrag für ein Fahrzeug zum Nachhauseweg besessen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
