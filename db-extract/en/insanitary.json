                ],
                "senses": [
                    {
                        "sense_id": "1649ecd0-c3a0-3779-ba99-5dfe2defb742",
                        "entry_id": "bb2c0e05-8a46-3053-959c-abfc1d02f191",
                        "glosses": [
                            "Of or pertaining to a lack of sanitation; unsanitary, dirty, unhealthy."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a66a821f-aa00-463d-9d90-e656a40175a2",
                                "sense_id": "1649ecd0-c3a0-3779-ba99-5dfe2defb742",
                                "text": "The important duty of getting rid of uninhabitable houses or insanitary property devolves on the sanitary authority, and requires to be carried out with discrimination."
                            },
                            {
                                "example_id": "95ab27a8-09c9-43ff-8bab-144c338c96d7",
                                "sense_id": "1649ecd0-c3a0-3779-ba99-5dfe2defb742",
                                "text": "The insanitary house displayed poor heating and plumbing, arsenical wallpaper and, in the basement area at the front of the house, 'a large wooden dustbin, placed as is frequently the case, where its malodorous and often dangerous contents must be a constant nuisance on the premises'."
                            },
                            {
                                "example_id": "991837ff-3ef1-4260-8362-4f168d1d086f",
                                "sense_id": "1649ecd0-c3a0-3779-ba99-5dfe2defb742",
                                "text": "Within the minority of nuisance fines for which the ward was recorded, however, there was a striking degree of symmetry across the wards, a difference of only eighteen between the ward with the most insanitary nuisances, Monk Ward, and that with the fewest, Micklegate Ward."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "130c77b0-2a77-47fb-af48-9e4cd672ca8f",
                        "source_entry_id": "bb2c0e05-8a46-3053-959c-abfc1d02f191",
                        "source_sense_id": "1649ecd0-c3a0-3779-ba99-5dfe2defb742",
                        "source_sense_description": "Translations",
                        "target_lang_word": "insalubre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "insalubre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "caf0a2db-909d-3777-a96e-7eb18492e18e",
                                        "entry_id": "b5aad689-b491-3a21-be18-019693a1f4ed",
                                        "glosses": [
                                            "Qualifie les lieux où la santé est en danger par suite de mauvaises conditions environnantes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d55e180-5f86-4f56-a4ac-b31caf4580ee",
                                                "sense_id": "caf0a2db-909d-3777-a96e-7eb18492e18e",
                                                "text": "Du devoir pour les municipalités d'assainir les quartiers insalubres des villes manufacturières."
                                            },
                                            {
                                                "example_id": "153888c6-ace7-428f-8b25-753d0f86e832",
                                                "sense_id": "caf0a2db-909d-3777-a96e-7eb18492e18e",
                                                "text": "Pour peu que les baigneurs se plaignent et que l’on bouche les riveaux, les prairies de Nauzan et de Bernezac redeviendront des marais insalubres."
                                            },
                                            {
                                                "example_id": "3f565daa-52c9-439c-9f47-a67fa8bd3112",
                                                "sense_id": "caf0a2db-909d-3777-a96e-7eb18492e18e",
                                                "text": "[…] les fenêtres des chambres peuvent à peine être entrouvertes et c’est ainsi que, faute d’aération, un tel établissement est insalubre pour une asthmatique invétérée comme Pep."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
