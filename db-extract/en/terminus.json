                "forms": [],
                "senses": [
                    {
                        "sense_id": "39569018-619b-3fbd-a4c8-32cb755a3199",
                        "entry_id": "8b9eb68a-57fc-309a-9e4e-51f9b9c15b4d",
                        "glosses": [
                            "Endstation (einer Bus- oder Bahnlinie)"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fb178ab8-b3d4-495c-9d74-757a9e4fb38d",
                        "source_entry_id": "8b9eb68a-57fc-309a-9e4e-51f9b9c15b4d",
                        "source_sense_id": "39569018-619b-3fbd-a4c8-32cb755a3199",
                        "source_sense_description": "Endstation (einer Bus- oder Bahnlinie)",
                        "target_lang_word": "Endstation",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Endstation",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ebb6e27a-5151-3a33-80ad-f3415aa3f352",
                                        "entry_id": "f4a28894-d745-3c0d-a048-4de091296001",
                                        "glosses": [
                                            "letzte Haltestelle eines Verkehrsmittels"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "906f209b-14f7-4836-a033-8a6cd9bb1833",
                                                "sense_id": "ebb6e27a-5151-3a33-80ad-f3415aa3f352",
                                                "text": "Die Straßenbahn erreicht ihre Endstation in wenigen Minuten."
                                            },
                                            {
                                                "example_id": "61c8ffec-bf74-4267-bc3e-65163eb9a547",
                                                "sense_id": "ebb6e27a-5151-3a33-80ad-f3415aa3f352",
                                                "text": "„Und dann die große, rußgeschwärzte Endstation in Paris, diese dreckige Kathedrale, unfruchtbar und erschöpft, durch die man in die grauen Straßen hinausgeht.“"
                                            },
                                            {
                                                "example_id": "cbcb8159-1f93-49f6-a3a8-faf74c8c132c",
                                                "sense_id": "ebb6e27a-5151-3a33-80ad-f3415aa3f352",
                                                "text": "„Zusammen mit der Tochter ihrer Zimmerwirtin fuhr Ditti abends mit der Straßenbahn zur Endstation, sie kletterten auf die Güterwaggons mit den Eierbriketts, stopften die Rucksäcke voll und schleppten sie – verdammt schwer, wie sie waren – wieder zurück nach Hause.“"
                                            },
                                            {
                                                "example_id": "222da2d8-2933-4b6a-897b-c54fd4d50627",
                                                "sense_id": "ebb6e27a-5151-3a33-80ad-f3415aa3f352",
                                                "text": "„Als der Zug seine Geschwindigkeit verminderte und langsam über die große Flußbrücke fuhr, die unmittelbar vor der Endstation lag, trat Robert an das Fenster des Abteils und warf noch einen Blick auf das zurückliegende Land.“"
                                            },
                                            {
                                                "example_id": "3555417b-12b7-4ac4-9d25-046a845c96ab",
                                                "sense_id": "ebb6e27a-5151-3a33-80ad-f3415aa3f352",
                                                "text": "„Die Blätter lagen durchnässt im Regen, und der Wind trieb den Regen gegen den großen grünen Autobus an der Endstation, und das Café des Amateurs war überfüllt, und drinnen beschlugen die Fenster von Wärme und Rauch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2683c862-a08a-3c64-98df-79b3b92f63e6",
                                        "entry_id": "f4a28894-d745-3c0d-a048-4de091296001",
                                        "glosses": [
                                            "Endpunkt einer Entwicklung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78f17bbe-fcc6-417b-957f-56925edd8e75",
                                                "sense_id": "2683c862-a08a-3c64-98df-79b3b92f63e6",
                                                "text": "„Tómas hatte geklungen, als ob für Ari der Posten in Siglufjörđur die Endstation wäre.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
