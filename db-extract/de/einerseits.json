                                "example_id": "185a63e5-b377-4073-adad-ad32ad18968d",
                                "sense_id": "fed397fb-9258-3b43-a4f1-fc24d7475715",
                                "text": "Einerseits habe ich starke Gefühle ihr gegenüber, andererseits ist es ein zu hohes Risiko eine Liebesgeschichte innerhalb der Firma anzufangen."
                            },
                            {
                                "example_id": "639052ec-0772-438a-b6d4-dfb5ec222e57",
                                "sense_id": "fed397fb-9258-3b43-a4f1-fc24d7475715",
                                "text": "„Einerseits war die Stadt tatsächlich nicht mehr durch die gewöhnlichen Verkehrsmittel mit dem übrigen Land verbunden, und andererseits untersagte eine neue Verordnung jeglichen Briefwechsel, um zu verhüten, daß die Briefe zu Infektionsträgern würden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
