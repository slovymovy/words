                "senses": [
                    {
                        "sense_id": "a52dd227-9e94-344f-b707-16024792c493",
                        "entry_id": "3eaa3a99-ff32-324b-ae67-b1a4ce9c6acb",
                        "glosses": [
                            "ein tiefblauer Farbstoff"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9c813d3-efca-4ca3-81da-0f2697930e99",
                                "sense_id": "a52dd227-9e94-344f-b707-16024792c493",
                                "text": "Der/das Indigo gehört zu den ältesten natürlich gewonnenen Farbstoffen."
                            },
                            {
                                "example_id": "827c1270-3fd3-4878-b9e7-afc263d07a13",
                                "sense_id": "a52dd227-9e94-344f-b707-16024792c493",
                                "text": "„Im Kaplande waren Streitigkeiten mit den Buren ausgebrochen, in Indien tobten Kämpfe mit den Aufständischen, man zitterte um Indigo, Pfeffer und andere Handelsgüter.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "0c4ee710-7a81-30e2-9643-51b037793d78",
                        "entry_id": "3eaa3a99-ff32-324b-ae67-b1a4ce9c6acb",
                        "glosses": [
                            "ein tiefbläulich-violetter Farbton"
                        ],
                        "tags": [
                            "nur sächlich",
                            "meist artikellos"
                        ],
                        "examples": [
                            {
                                "example_id": "1b2d8857-594d-4226-93b0-cc5803e92627",
                                "sense_id": "0c4ee710-7a81-30e2-9643-51b037793d78",
                                "text": "Indigo passt zu diesem Anzug nicht."
                            }
                        ],
                        "sense_index_json": "\"2\""
