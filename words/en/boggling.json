{
    "word_family": [
        "boggle"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3c8bc886-a3f7-35b8-aff5-172f47068220",
                    "sense_definition": "Causing someone to feel extremely surprised, confused, or unable to think clearly.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "bewilderment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sheer scale of the universe is truly <w>boggling</w> to the human mind.",
                            "target_lang_translations": {
                                "it": "La vastità dell'universo è davvero <w>sbalorditiva</w> per la mente umana."
                            }
                        },
                        {
                            "text": "It is <w>boggling</w> how much information can be stored on such a tiny chip.",
                            "target_lang_translations": {
                                "it": "È <w>incredibile</w> quante informazioni possano essere archiviate su un chip così piccolo."
                            }
                        }
                    ],
                    "synonyms": [
                        "bewildering",
                        "staggering",
                        "astonishing"
                    ],
                    "common_phrases": [
                        "mind boggling"
                    ],
                    "target_lang_definitions": {
                        "it": "Che causa estrema sorpresa, confusione o incapacità di pensare chiaramente."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "sbalorditivo",
                                "target_lang_sense_clarification": "che lascia senza parole per la sorpresa"
                            },
                            {
                                "target_lang_word": "incredibile",
                                "target_lang_sense_clarification": "che supera la capacità di comprensione"
                            },
                            {
                                "target_lang_word": "strabiliante",
                                "target_lang_sense_clarification": "che stupisce profondamente"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7496606d-6d8e-38bd-89b3-b2da44f8c42f",
                    "sense_definition": "The state of being completely confused or overwhelmed.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "bewilderment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>bogglings</w> of his mind made it impossible for him to focus on the simple task.",
                            "target_lang_translations": {
                                "it": "Il <w>sconcerto</w> della sua mente gli rendeva impossibile concentrarsi sul compito semplice."
                            }
                        },
                        {
                            "text": "She felt a sudden <w>bogglings</w> when faced with the complex legal document.",
                            "target_lang_translations": {
                                "it": "Provò un improvviso <w>smarrimento</w> di fronte al complesso documento legale."
                            }
                        }
                    ],
                    "synonyms": [
                        "bewilderment",
                        "confusion"
                    ],
                    "target_lang_definitions": {
                        "it": "Lo stato di totale confusione o smarrimento mentale."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "sconcerto",
                                "target_lang_sense_clarification": "stato di turbamento e confusione"
                            },
                            {
                                "target_lang_word": "smarrimento",
                                "target_lang_sense_clarification": "perdita di orientamento mentale"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "be2a4cc9-753a-391b-ba00-5a145687b392",
                    "sense_definition": "Present participle and gerund of <w>boggle</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "bewilderment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was <w>boggling</w> at the sheer complexity of the new software interface.",
                            "target_lang_translations": {
                                "it": "Era <w>sbalordito</w> dalla pura complessità della nuova interfaccia software."
                            }
                        },
                        {
                            "text": "The constant <w>boggling</w> of his senses made him want to leave the noisy room.",
                            "target_lang_translations": {
                                "it": "Il costante <w>sbalordimento</w> dei suoi sensi lo spingeva a voler lasciare la stanza rumorosa."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "This is a grammatical form of the verb boggle."
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Participio presente e gerundio del verbo 'boggle', indicante l'essere confuso o sopraffatto."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "sbalordire",
                                "target_lang_sense_clarification": "essere confuso o sorpreso"
                            },
                            {
                                "target_lang_word": "rimanere interdetto",
                                "target_lang_sense_clarification": "essere bloccato dalla confusione"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}