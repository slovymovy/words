                        "cross_references": [
                            {
                                "target_word": "hyponymy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1f27e764-36b8-3d70-bbd8-9c3d95532294",
                                        "entry_id": "08bb4525-5d0f-3a9a-8183-ac06dbd2a6e2",
                                        "glosses": [
                                            "The semantic relation between hyponyms; the quality of being hyponymous."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e2c2b041-5d8b-48f0-b0d1-7ae2aff999e4",
                                                "sense_id": "1f27e764-36b8-3d70-bbd8-9c3d95532294",
                                                "text": "By isolating these two main types of relation, hyponymy and incompatibility, we can characterize the relations between a large web of items."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2b399a13-12a9-46fb-937b-082d48990e31",
                        "source_entry_id": "3a9d465f-d328-3215-b387-95a0f807056c",
                        "source_sense_id": "7e92e9db-1cd6-33a4-9fc2-2b2a495d0c7b",
                        "target_lang_word": "hyponymie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hyponymie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d6e7090b-7d17-36ac-8427-1624fa61168b",
                                        "entry_id": "1b8f7205-11fd-318e-826e-3f59ca677863",
                                        "glosses": [
                                            "Relation sémantique hiérarchique d’un lexème à un autre selon laquelle l’extension du premier terme est incluse dans l’extension du second. Le premier terme est dit hyponyme de l’autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2dad807e-c706-4431-aee1-27b57dbea516",
                                                "sense_id": "d6e7090b-7d17-36ac-8427-1624fa61168b",
                                                "text": "Si l’on s'en tient aux données fournies par l’hyponymie, on sait que teckel est hyponyme de chien qui lui est un hyponyme de animal."
                                            },
                                            {
                                                "example_id": "b1664932-3818-4d86-846c-43b5d0f446a7",
                                                "sense_id": "d6e7090b-7d17-36ac-8427-1624fa61168b",
                                                "text": "L’hyponymie est l’expression linguistique de la relation logique d’inclusion d’une classe dans une autre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1a98b9d1-521e-43a4-a469-c1e1e765178b",
                        "source_entry_id": "3a9d465f-d328-3215-b387-95a0f807056c",
