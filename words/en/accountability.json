{
    "word_family": [
        "account",
        "accountable",
        "accountant",
        "accounting"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "86c307d2-174b-3b46-8158-32224b0acab8",
                    "sense_definition": "The state of being responsible for one's actions and being able to provide a satisfactory reason for them.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "responsibility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new policy aims to increase <w>accountability</w> among senior managers for their financial decisions.",
                            "target_lang_translations": {
                                "ru": "Новая политика направлена на повышение <w>подотчётности</w> высшего руководства за их финансовые решения."
                            }
                        },
                        {
                            "text": "Without proper <w>accountability</w>, it is difficult to ensure that public funds are being spent wisely.",
                            "target_lang_translations": {
                                "ru": "Без надлежащей <w>отчётности</w> трудно гарантировать, что государственные средства расходуются разумно."
                            }
                        }
                    ],
                    "synonyms": [
                        "accountableness"
                    ],
                    "antonyms": [
                        "irresponsibility"
                    ],
                    "common_phrases": [
                        "hold to accountability",
                        "lack of accountability",
                        "personal accountability"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние ответственности за свои действия и способность предоставить удовлетворительное объяснение им."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подотчётность",
                                "target_lang_sense_clarification": "обязанность отчитываться перед кем-либо"
                            },
                            {
                                "target_lang_word": "ответственность",
                                "target_lang_sense_clarification": "обязанность отвечать за свои поступки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "39607b5f-9eb9-37c4-80db-b4a4aa2d49d1",
                    "sense_definition": "The willingness to accept responsibility for one's own actions and the consequences that follow.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "responsibility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Taking <w>accountability</w> for your mistakes is the first step toward improving your professional performance.",
                            "target_lang_translations": {
                                "ru": "Принятие <w>ответственности</w> за свои ошибки — это первый шаг к повышению профессиональной эффективности."
                            }
                        },
                        {
                            "text": "The leader showed great <w>accountability</w> by admitting the project failed due to his poor planning.",
                            "target_lang_translations": {
                                "ru": "Руководитель проявил большую <w>ответственность</w>, признав, что проект провалился из-за его плохого планирования."
                            }
                        }
                    ],
                    "antonyms": [
                        "denial"
                    ],
                    "common_phrases": [
                        "take accountability",
                        "demonstrate accountability"
                    ],
                    "target_lang_definitions": {
                        "ru": "Готовность признать ответственность за собственные действия и их последствия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ответственность",
                                "target_lang_sense_clarification": "готовность признать себя причиной чего-либо"
                            },
                            {
                                "target_lang_word": "сознательность",
                                "target_lang_sense_clarification": "добросовестное отношение к делу"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c2d73619-d089-3033-8093-a99720c84b48",
                    "sense_definition": "A formal process of determining who is responsible for a failure and ensuring they face the consequences.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "legal_and_formal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The public is demanding <w>accountability</w> from the corporation after the environmental disaster.",
                            "target_lang_translations": {
                                "ru": "Общественность требует <w>привлечения к ответственности</w> корпорации после экологической катастрофы."
                            }
                        },
                        {
                            "text": "There must be a clear system of <w>accountability</w> to punish those who violate safety regulations.",
                            "target_lang_translations": {
                                "ru": "Должна существовать четкая система <w>подотчётности</w>, чтобы наказывать тех, кто нарушает правила техники безопасности."
                            }
                        }
                    ],
                    "synonyms": [
                        "accountableness"
                    ],
                    "antonyms": [
                        "impunity"
                    ],
                    "common_phrases": [
                        "demand accountability",
                        "ensure accountability"
                    ],
                    "target_lang_definitions": {
                        "ru": "Формальный процесс определения виновных в неудаче и обеспечения наказания для них."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "привлечение к ответственности",
                                "target_lang_sense_clarification": "процесс наказания за нарушения"
                            },
                            {
                                "target_lang_word": "подотчётность",
                                "target_lang_sense_clarification": "система контроля и взыскания"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dc298e9c-02e9-363a-98d7-120c767c16ec",
                    "sense_definition": "The legal obligation to keep accurate records of property, documents, or money.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "legal_and_formal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The officer was charged with maintaining strict <w>accountability</w> for all government equipment in the warehouse.",
                            "target_lang_translations": {
                                "ru": "Офицеру было поручено вести строгий <w>учёт</w> всего государственного оборудования на складе."
                            }
                        },
                        {
                            "text": "Financial <w>accountability</w> requires that every transaction be recorded and verified by an auditor.",
                            "target_lang_translations": {
                                "ru": "Финансовая <w>отчётность</w> требует, чтобы каждая транзакция была записана и проверена аудитором."
                            }
                        }
                    ],
                    "common_phrases": [
                        "financial accountability",
                        "strict accountability"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical or legal context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Юридическая обязанность вести точный учет имущества, документов или денежных средств."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отчётность",
                                "target_lang_sense_clarification": "ведение учёта и составление документов"
                            },
                            {
                                "target_lang_word": "учёт",
                                "target_lang_sense_clarification": "регистрация и проверка операций"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}