                        ],
                        "examples": [
                            {
                                "example_id": "53b1a903-d7b5-4002-8cb7-9fc668800eca",
                                "sense_id": "a663db90-79c6-3a54-b922-0978fcfa6d9b",
                                "text": "Artcraft goods at the Leipzig Spring Fair of 1931 […] comprised mainly hand-made textiles of all kinds, and a large variety of decorative articles. Glass and ceramics predominated […] As the makers of artcraft goods are mostly small firms, those located in Germany usually unite in provincial cooperative associations."
                            },
                            {
                                "example_id": "9183fcee-be0e-4dac-b21c-881a49941c26",
                                "sense_id": "a663db90-79c6-3a54-b922-0978fcfa6d9b",
                                "text": "The notion that a significant proportion of an underdeveloped country's work force can be employed in producing handicrafts for export is universally popular. […] With artcrafts, their collection, export, and distribution abroad typically constitute the greater proportion of the price of the article when it is finally retailed abroad."
                            }
                        ]
                    }
