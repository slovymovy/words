                        "source_entry_id": "0c308e6e-ce0b-3f81-83d6-a79a485b99a7",
                        "source_sense_id": "ddb4b11f-04d8-3f74-9004-964564d60bfc",
                        "source_sense_description": "deel van de hersenen dat een directe verbinding heeft met het hormonale systeem",
                        "target_lang_word": "hypothalamus",
