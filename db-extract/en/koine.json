                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "da2c366a-0811-375d-99bf-7780eb94302a",
                                        "entry_id": "682e8afd-4199-3863-acf7-2e0bc45478c8",
                                        "glosses": [
                                            "Bezeichnung für eine Gemeinschaftssprache, die sich im alten Griechenland in vorchristlicher Zeit herausgebildet hatte und bis in die römische Zeit erhalten blieb"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9fc0545c-51eb-40e6-945f-81446a0314c1",
                                                "sense_id": "da2c366a-0811-375d-99bf-7780eb94302a",
                                                "text": "Mit Koine ist eine gemeinschaftliche Sprache gemeint, die sich in Griechenland zur Zeit des Hellenismus herausgebildet hat."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2af29529-af2e-3a02-a040-33df64f5d315",
                                        "entry_id": "682e8afd-4199-3863-acf7-2e0bc45478c8",
                                        "glosses": [
                                            "Bezeichnung für eine Sprache, die sich in einem von Dialekten geprägten Gebiet als Standardsprache herausgebildet hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7694a4a-7a56-436a-87bc-e77c57a0bf54",
                                                "sense_id": "2af29529-af2e-3a02-a040-33df64f5d315",
                                                "text": "Hochdeutsch kann als eine Koine angesehen werden, die sich im deutschen Sprachgebiet als Standardsprache durchgesetzt hat."
                                            },
                                            {
                                                "example_id": "b6346440-9f80-4c72-a08a-fa0c38e90a99",
                                                "sense_id": "2af29529-af2e-3a02-a040-33df64f5d315",
                                                "text": "„Wir müssen einräumen, daß auch das Bairische in mannigfaltigen Erscheinungsformen auftritt; doch auf Kosten der Ortsmundarten hat sich eine bestimmte Koine herausgearbeitet.“"
                                            },
                                            {
                                                "example_id": "feba4d90-6309-4160-b116-58ff92b12ee3",
                                                "sense_id": "2af29529-af2e-3a02-a040-33df64f5d315",
                                                "text": "„In der Zeit des Hellenismus war das Griechische die gemeinsame Sprache, die Koine des damaligen Wechselwirkungsbereiches, der die Kulturwelt im Mittelmeerraum ausmachte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
