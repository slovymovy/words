                                        "sense_id": "1f111e64-0f4a-31c7-ba3e-6838e61efa32",
                                        "entry_id": "583be99a-0772-336b-af46-e3077aa8213d",
                                        "glosses": [
                                            "A state of minimum power consumption, inactivity and metabolic depression in some animals during winter."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "71ed6a2e-7fb7-4852-892b-1b9e3731c77d",
                                                "sense_id": "1f111e64-0f4a-31c7-ba3e-6838e61efa32",
                                                "text": "The bears are in hibernation."
                                            },
                                            {
                                                "example_id": "2a0543b5-6f66-4f94-82de-b8bca8c74b7e",
                                                "sense_id": "1f111e64-0f4a-31c7-ba3e-6838e61efa32",
                                                "text": "The bears come out of hibernation in March."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "020c1e9f-54e8-3b75-b18f-2dff8216795b",
                                        "entry_id": "583be99a-0772-336b-af46-e3077aa8213d",
                                        "glosses": [
                                            "A hypothetical state of minimum power consumption, inactivity and metabolic depression in humans during long space flights."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
