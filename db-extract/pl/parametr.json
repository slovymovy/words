                "senses": [
                    {
                        "sense_id": "8ce2738f-9ac7-3a0e-a862-77bc915afbbe",
                        "entry_id": "bf586374-3b98-3fd7-a26a-b7f527eb0367",
                        "glosses": [
                            "wielkość charakteryzująca właściwości czegoś (np. równania, rozkładu, urządzenia, procesu technologicznego, materiału, itp.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6fe057ef-459a-4650-87b0-9c9bc93b7bd8",
                                "sense_id": "8ce2738f-9ac7-3a0e-a862-77bc915afbbe",
                                "text": "Dobór optymalnych parametrów procesu ma decydujący wpływ na jakość uzyskanego materiału."
                            },
                            {
                                "example_id": "dd3d011c-ca74-40da-b203-71d4faa42ca7",
                                "sense_id": "8ce2738f-9ac7-3a0e-a862-77bc915afbbe",
                                "text": "W równaniu ax²+bx+c=0 liczba rozwiązań zależy od parametrów a,b,c."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "ada8024d-29ba-39ad-85c6-b3777fc3fe3b",
                        "entry_id": "bf586374-3b98-3fd7-a26a-b7f527eb0367",
                        "glosses": [
                            "wartość lub zmienna przekazywana do podprogramu podczas jego wywoływania, pozwalająca na sterowanie jego zachowaniem lub uzyskanie jego wyników"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e3ea9f1c-9d4e-4f45-921d-0460ac9f2e12",
                        "source_entry_id": "bf586374-3b98-3fd7-a26a-b7f527eb0367",
                        "source_sense_id": "8ce2738f-9ac7-3a0e-a862-77bc915afbbe",
                        "target_lang_word": "parameter",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "parameter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3bd34361-85e0-3f1e-8673-f97340888691",
                                        "entry_id": "622ac02a-159c-3e75-b7fe-5ec95950ebcf",
                                        "glosses": [
                                            "A value kept constant during an experiment, equation, calculation, or similar, but varied over other versions of the experiment, equation, calculation, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5fb3564a-239c-4b74-b78e-d7f582393536",
                                                "sense_id": "3bd34361-85e0-3f1e-8673-f97340888691",
                                                "text": "As molecular surface-to-surface contacts control both solution phenomena and surface phenomena, it is not surprising that various correlations of cohesion parameters and surface phenomena can be found."
                                            },
                                            {
                                                "example_id": "97ec8142-5274-42f7-bfc4-76949564b540",
                                                "sense_id": "3bd34361-85e0-3f1e-8673-f97340888691",
                                                "text": "The independent parameters of a system or network over F(z) reflect its structure and determine its structural properties (such as the reducibility of coefficient matrix A and its characteristic polynomial det(λI −A), controllability and observability over F(z), etc.)."
                                            },
                                            {
                                                "example_id": "93abf1eb-fd79-4337-8ce9-783f8c4d239c",
                                                "sense_id": "3bd34361-85e0-3f1e-8673-f97340888691",
                                                "text": "On the other hand, if we have suitable data, we may be able to develop some direct computational methods for the essentially nonlinear parameter identification problems, in which fewer or even no nonlinear processes are involved."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c8683773-3285-3a4d-a4c0-4c95858426b7",
                                        "entry_id": "622ac02a-159c-3e75-b7fe-5ec95950ebcf",
                                        "glosses": [
                                            "A variable that describes a property or characteristic of some system (material, object, event, etc.) or some aspect thereof."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ea9611b-a8a3-43ae-b0e8-b9cc3dd070f7",
                                                "sense_id": "c8683773-3285-3a4d-a4c0-4c95858426b7",
                                                "text": "Cohesion parameters (solubility parameters) can be used with full theoretical justification to characterize many surfaces ..."
                                            },
                                            {
                                                "example_id": "f730cee8-8614-4ff0-ab10-fe01c601b543",
                                                "sense_id": "c8683773-3285-3a4d-a4c0-4c95858426b7",
                                                "text": "To this end, we derive an a posteriori error estimator for the error with respect to the unknown parameter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ea0d73e-6b10-3a50-b4b3-9862ed329236",
                                        "entry_id": "622ac02a-159c-3e75-b7fe-5ec95950ebcf",
                                        "glosses": [
                                            "A variable that describes a property or characteristic of some system (material, object, event, etc.) or some aspect thereof.",
                                            "Any measured quantity of a statistical population that summarises or describes an aspect of the population."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "98fb39e8-5330-357e-a5ab-d3e433ef1e14",
                                        "entry_id": "622ac02a-159c-3e75-b7fe-5ec95950ebcf",
                                        "glosses": [
                                            "A variable that describes a property or characteristic of some system (material, object, event, etc.) or some aspect thereof.",
                                            "A variable of a model that is trained by a machine learning algorithm."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4c12407-01f6-4eeb-bb95-ef9182e0e438",
                                                "sense_id": "98fb39e8-5330-357e-a5ab-d3e433ef1e14",
                                                "text": "The parameter estimation problem considered in this chapter consists of estimating the unknown parameter, ū [a barred v, actually], given N samples of the observation process."
                                            },
                                            {
                                                "example_id": "6ef07720-3c22-4e7a-9291-11d51ab9ca20",
                                                "sense_id": "98fb39e8-5330-357e-a5ab-d3e433ef1e14",
                                                "text": "Fundamental is the regulation of a for-profit OpenAI. The company initially delayed the launch of its earlier GPT-2, with a mere 1.5bn parameters, because the company fretted over its implications."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c3046b01-1fc1-3e5d-b434-aa3ac18371ac",
                                        "entry_id": "622ac02a-159c-3e75-b7fe-5ec95950ebcf",
                                        "glosses": [
                                            "An input variable of a function definition, that gets an actual value (argument) at execution time."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "45931ed1-0a9d-3736-80a8-7ac3a777745c",
                                        "entry_id": "622ac02a-159c-3e75-b7fe-5ec95950ebcf",
                                        "glosses": [
                                            "An actual value given to such a formal parameter."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9667f9a2-baf5-34c2-8dae-4e3f3336edac",
                                        "entry_id": "622ac02a-159c-3e75-b7fe-5ec95950ebcf",
                                        "glosses": [
                                            "A characteristic or feature that distinguishes something from others."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dd8e47b9-ba5d-380e-8d16-b2e541922864",
                                        "entry_id": "622ac02a-159c-3e75-b7fe-5ec95950ebcf",
                                        "glosses": [
                                            "In the ellipse and hyperbola, a third proportional to any diameter and its conjugate, or in the parabola, to any abscissa and the corresponding ordinate."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8d69133-4b7f-481a-a566-4d6aa93811c3",
                                                "sense_id": "dd8e47b9-ba5d-380e-8d16-b2e541922864",
                                                "text": "The parameter of the principal axis of a conic section is called the latus rectum."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df102d9e-e965-3f18-a4c8-c005b6cd6f16",
                                        "entry_id": "622ac02a-159c-3e75-b7fe-5ec95950ebcf",
                                        "glosses": [
                                            "Clipping of uniformizing parameter."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "clipping"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9e9c0052-b62d-31dc-abae-805d488f40ac",
                                        "entry_id": "622ac02a-159c-3e75-b7fe-5ec95950ebcf",
                                        "glosses": [
                                            "The ratio of the three crystallographic axes which determines the position of any plane."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "332f5824-e8de-3f40-beb2-d31c17377092",
