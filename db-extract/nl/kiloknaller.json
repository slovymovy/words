                    },
                    {
                        "sense_id": "480b07f7-812a-3fb8-9a00-7f3ca37c6645",
                        "entry_id": "543fbd50-4dcb-3f3f-84af-515c24700bb0",
                        "glosses": [
                            "aanbieding met te goedkoop geproduceerd vlees"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08c452c0-d8db-4768-97e0-3c6e1c0f3677",
                                "sense_id": "480b07f7-812a-3fb8-9a00-7f3ca37c6645",
                                "text": "Supermarkten hebben vorig jaar veel vaker gestunt met kiloknallers dan in 2014, zegt Wakker Dier. De organisatie maakt uit de folders van de zeven grootste supermarkten op dat het aantal aanbiedingen van vlees zonder het dierenwelzijnskeurmerk 40 procent hoger was."
                            },
                            {
                                "example_id": "f9f3ead7-9cf0-4ef4-ae51-4144df16f1bc",
                                "sense_id": "480b07f7-812a-3fb8-9a00-7f3ca37c6645",
                                "text": "50 procent korting, tweede product gratis en twee halen, één betalen. Aan de prijzenoorlog lijkt geen einde aan te komen. Extra druk dus voor de C1000 om zo goedkoop mogelijk vlees in te slaan. De boeren worden daarom gedwongen om nog goedkoper te produceren, ten koste van het dierenwelzijn. Omdat de C1000 met afstand de meest kilo-knallende supermarkt is, roept Wakker Dier 'solliciteer de kiloknaller de C1000 uit' in het leven, om de vleesinkoop bij de grootgrutter op de schop te nemen en diervriendelijker te maken."
                            },
                            {
                                "example_id": "8d17a119-3838-4b3d-a49d-1c53ac593edd",
                                "sense_id": "480b07f7-812a-3fb8-9a00-7f3ca37c6645",
                                "text": "Vooral kip is volgens Wakker Dier een favoriete kiloknaller. De stichting wijst op het dierenleed achter het goedkope vlees."
                            }
                        ]
                    }
