                ],
                "senses": [
                    {
                        "sense_id": "1fabedce-f58f-34c9-b08d-47c3063511d4",
                        "entry_id": "5bb84514-009c-3f04-ae16-df2580c44c09",
                        "glosses": [
                            "религ. повторное воплощение человека, возрождение души в новом теле"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "578b9089-99a1-4446-a15d-7403b9de49a0",
                                "sense_id": "1fabedce-f58f-34c9-b08d-47c3063511d4",
                                "text": "В 1989 году, когда умер 10-й панчен-лама, поиски его реинкарнации начала группа монахов из монастыря Таши Лумпо (резиденции панчен-лам на протяжении последних 350 лет)."
                            },
                            {
                                "example_id": "806fffb9-b29a-45f0-a2d5-1a3ebd70b19c",
                                "sense_id": "1fabedce-f58f-34c9-b08d-47c3063511d4",
                                "text": "Сначала основу брахманизма составляли культ и учение о жертвоприношении, но постепенно в нём возникают идеи о сансаре — мире, в котором душа любого живого существа ввергается в поток бесконечных перерождений (реинкарнаций), чем и объясняется многообразие всех форм жизни…"
                            }
                        ]
                    },
                    {
                        "sense_id": "771bf455-944b-3fea-8072-f6fde36ef857",
                        "entry_id": "5bb84514-009c-3f04-ae16-df2580c44c09",
                        "glosses": [
                            "книжн. перевоплощение"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67a39425-78be-4481-9ee7-3ddd4abc4d57",
                                "sense_id": "771bf455-944b-3fea-8072-f6fde36ef857",
                                "text": "Концерн BMW, спустя три года с момента реинкарнации знаменитого Mini, объявил о выпуске его открытой версии."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "46d4c2bd-9133-446c-bac4-9b5f78e040a5",
                        "source_entry_id": "5bb84514-009c-3f04-ae16-df2580c44c09",
                        "target_lang_word": "reincarnation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "reincarnation",
