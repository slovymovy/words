                ],
                "senses": [
                    {
                        "sense_id": "0e004bae-279d-3986-a047-b5a4e5277f61",
                        "entry_id": "f83e0ab5-2872-3a05-8bc5-b549403ff13d",
                        "glosses": [
                            "To exceed in sparkling."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75bc376f-b9ee-4ece-9161-278adec94e46",
                                "sense_id": "0e004bae-279d-3986-a047-b5a4e5277f61",
                                "text": "Her eyes outsparkled the jewels she wore."
                            },
                            {
                                "example_id": "63a98549-1f60-4802-9000-94ece4a6e9de",
                                "sense_id": "0e004bae-279d-3986-a047-b5a4e5277f61",
                                "text": "I want you to know about Tully because he is the epitome of good health, good habits, and a great disposition with a twinkle in his eye that will outsparkle the most precious diamond."
                            },
                            {
                                "example_id": "7fbdc46d-417a-4d18-b891-4adb328e4095",
                                "sense_id": "0e004bae-279d-3986-a047-b5a4e5277f61",
                                "text": "Her cheeks were as round and red as lore-apples, and she had dancing blue eyes that appeared for ever engaged in good-natured efforts to outsparkle each other."
                            }
                        ]
                    },
                    {
                        "sense_id": "24f49b98-1645-33a4-b5fe-220f2e942746",
                        "entry_id": "f83e0ab5-2872-3a05-8bc5-b549403ff13d",
                        "glosses": [
                            "To sparkle outwards."
                        ],
                        "tags": [
                            "poetic"
                        ],
                        "examples": [
                            {
                                "example_id": "29b72ffd-2fd7-47f9-a468-7b26053bcaea",
                                "sense_id": "24f49b98-1645-33a4-b5fe-220f2e942746",
                                "text": "a youthful wight Smiling beneath a coral diadem Outsparkling sudden like an upturn'd gem."
                            },
                            {
                                "example_id": "aa6030f3-d726-42e3-8cbe-97a8e4a01561",
                                "sense_id": "24f49b98-1645-33a4-b5fe-220f2e942746",
                                "text": "Or did they rise, thus rude, And curl their uncouth ring in that same age Which saw the fair-proportioned Parthenon In its first finish of Pentelic marble, Outsparkle from the hand of Phidias?"
                            },
                            {
                                "example_id": "faa26f14-07fb-44bb-8e23-c0690cdfe58d",
                                "sense_id": "24f49b98-1645-33a4-b5fe-220f2e942746",
                                "text": "A flushing font, a sure upheaving well, Which now outsparkled from its fountain-head To freshen even her trampled virgin wreath , Making her move aside to weep for death."
                            }
                        ]
                    }
                ],
