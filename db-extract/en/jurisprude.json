                        "examples": [
                            {
                                "example_id": "57d06c08-c2bf-4dca-a183-88e775001f41",
                                "sense_id": "160a5f21-911a-399f-9316-6b18bd89ab9f",
                                "text": "To judge a Chief Justice is usually the task of a historian or a jurisprude."
                            },
                            {
                                "example_id": "9a7dc301-99a9-44cf-8c0c-c28b2db6cc8d",
                                "sense_id": "160a5f21-911a-399f-9316-6b18bd89ab9f",
                                "text": "Perhaps a legal ethicist or a jurisprude could qualify to testify on the moral or legal necessity to bring an incompetent accused to trial by means of chemical manipulation of the brain, but not a doctor."
                            },
                            {
                                "example_id": "6a9b4759-839f-4595-9228-0cd207b06977",
                                "sense_id": "160a5f21-911a-399f-9316-6b18bd89ab9f",
                                "text": "[Feldman] truly views Kavanaugh as this Machiavellian, power-hungry, affection-desiring, empty-suited jurisprude."
                            }
                        ]
                    }
