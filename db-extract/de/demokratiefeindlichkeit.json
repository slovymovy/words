                "senses": [
                    {
                        "sense_id": "52d0ad1a-4bfc-39f0-b106-d8900b14ada0",
                        "entry_id": "5894bbc3-e386-3940-8469-d46c50636806",
                        "glosses": [
                            "Ablehnung der Demokratie; Einstellung/Haltung, die sich gegen die Demokratie richtet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "897df592-5881-4149-b7a1-541eb3d0187c",
                                "sense_id": "52d0ad1a-4bfc-39f0-b106-d8900b14ada0",
                                "text": "„Unter politischem Extremismus wird im Folgenden die fundamentale Demokratiefeindlichkeit verstanden, die ihre Ausprägung sowohl auf Einstellungs- als auch Handlungsebene finden kann […].“"
                            },
                            {
                                "example_id": "45b7ca7c-00b8-4eca-ad80-fa97d286a36e",
                                "sense_id": "52d0ad1a-4bfc-39f0-b106-d8900b14ada0",
                                "text": "„Auf struktureller Ebene begegnet uns hier erneut ein anderer Vorwurf gegenüber Trump: seine Demokratiefeindlichkeit.“"
                            },
                            {
                                "example_id": "f266d18a-387a-4189-abf3-6ec684baabd8",
                                "sense_id": "52d0ad1a-4bfc-39f0-b106-d8900b14ada0",
                                "text": "„Wann jedoch genau diese Grenze der System- und Demokratiefeindlichkeit überschritten wird, lässt sich nur schwer bestimmen.“"
                            },
                            {
                                "example_id": "92ee93a8-1eef-47ff-8edc-76c702d88273",
                                "sense_id": "52d0ad1a-4bfc-39f0-b106-d8900b14ada0",
                                "text": "„Wir können nicht schweigen zu dem Angriff auf das demokratische Gemeinwesen mit Häme, Hetze, Gewalt, Terror und Mord, mit rechtsextremer Demokratiefeindlichkeit, Judenfeindlichkeit, Ausländerfeindlichkeit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
