                    {
                        "sense_id": "c5022f58-598a-3a02-9c89-0218d2e94f39",
                        "entry_id": "8ba61cbb-3907-379f-be71-09897a20a8e2",
                        "glosses": [
                            "gesetzlich festgelegter Wert eines Zahlungsmittels"
                        ],
                        "tags": [
                            "Währung"
                        ],
                        "examples": [
                            {
                                "example_id": "2e9eb181-4648-4017-bb9b-60e1126f477b",
                                "sense_id": "c5022f58-598a-3a02-9c89-0218d2e94f39",
                                "text": "Der Nennwert dieser Goldmünze liegt inzwischen weit unter ihrem Marktpreis."
                            },
                            {
                                "example_id": "ffa85bad-66ad-43e3-8039-feed5d896858",
                                "sense_id": "c5022f58-598a-3a02-9c89-0218d2e94f39",
                                "text": "„Die Münze aus einer Unze (31,3 Gramm) Feinsilber hat einen Nennwert von 1,50 Euro.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
