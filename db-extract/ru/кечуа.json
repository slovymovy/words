                                    {
                                        "sense_id": "9d7610d0-7353-340d-9e65-5ae3ab883ff9",
                                        "entry_id": "41ef64b1-7f9d-35db-9892-123ee3923342",
                                        "glosses": [
                                            "bis heute in Südamerika verbreitete indianische Sprache, die unter anderen von den Inka gesprochen wurde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9354eee1-dc77-48c5-9a30-9ca51ebaf739",
                                                "sense_id": "9d7610d0-7353-340d-9e65-5ae3ab883ff9",
                                                "text": "Sprechen Sie Quechua?"
                                            },
                                            {
                                                "example_id": "14f3477a-bbb8-47e2-a229-9160f29e8f81",
                                                "sense_id": "9d7610d0-7353-340d-9e65-5ae3ab883ff9",
                                                "text": "Wie heißt das auf Quechua?"
                                            },
                                            {
                                                "example_id": "05a70268-47fd-4d33-bbb4-4919af72b900",
                                                "sense_id": "9d7610d0-7353-340d-9e65-5ae3ab883ff9",
                                                "text": "Wie kann ich mein Quechua verbessern?"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9b4bff7c-dbe8-4697-bd4f-fbb33580aec0",
                        "source_entry_id": "be67645a-b327-3a97-9483-95735c95995b",
                        "source_sense_description": "народ",
