                "senses": [
                    {
                        "sense_id": "e1ab6a45-3f9f-3f02-be41-ffc5958b6d69",
                        "entry_id": "b9a88cc4-f064-36f4-b819-9a195f8eab76",
                        "glosses": [
                            "Type de forum internet qui repose principalement sur le partage d’images."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "1eaf3e7e-885b-4fe4-bfce-5b1e206a0e9a",
                                "sense_id": "e1ab6a45-3f9f-3f02-be41-ffc5958b6d69",
                                "text": "Cette grande famille d'imageboards occidentaux s'est peu à peu fait connaître sous le nom de « chans ». Aujourd'hui encore, son émergence passe pour un phénomène inédit. 4chan et tous ses descendants ne sont pourtant que le dernier chapitre d'une très longue histoire."
                            },
                            {
                                "example_id": "d90a7dd2-d65a-495e-a36f-47bee4ab956d",
                                "sense_id": "e1ab6a45-3f9f-3f02-be41-ffc5958b6d69",
                                "text": "Laboratoires à mèmes, fourmilières à complots, humour pas vraiment politiquement correct, mais aussi déversoir à images pornographiques ou racistes, les imageboards sont un peu tout cela : un concentré de culture geek."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c82843b6-4ac4-42a4-8857-b6f005003bea",
                        "source_entry_id": "b9a88cc4-f064-36f4-b819-9a195f8eab76",
                        "source_sense_id": "e1ab6a45-3f9f-3f02-be41-ffc5958b6d69",
                        "target_lang_word": "imageboard",
                        "target_lang_code": "en",
