                            {
                                "example_id": "01c49c72-e2a8-4d9c-9a91-37436fa2a62f",
                                "sense_id": "f2c17470-1220-39ef-af07-ea24293064f8",
                                "text": "Die EMRK trat 1953 allgemein in Kraft."
                            },
                            {
                                "example_id": "81c43b4e-03ad-474b-932a-98df1f6edf08",
                                "sense_id": "f2c17470-1220-39ef-af07-ea24293064f8",
                                "text": "Der EGMR hat seinen Sitz in Straßburg und wacht über die Einhaltung der Europäischen Menschenrechtskonvention (EMRK) durch alle ihre 47 Mitglieder."
                            },
                            {
                                "example_id": "84dded74-b8c4-4b90-9bdd-2e633c32acaa",
                                "sense_id": "f2c17470-1220-39ef-af07-ea24293064f8",
                                "text": "Wer der EMRK beitritt, unterwirft sich der Rechtsprechung des Straßburger EGMR."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
