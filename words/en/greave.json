{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "dcc356e6-0433-3b8a-a352-056924be1801",
                    "sense_definition": "A piece of armor designed to protect the lower leg, especially the shin.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "armor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The knight polished each steel <w>greave</w> before buckling it onto his leg.",
                            "target_lang_translations": {
                                "es": "El caballero pulió cada <w>greba</w> de acero antes de abrochársela a la pierna."
                            }
                        },
                        {
                            "text": "A direct blow struck his right <w>greave</w>, leaving a noticeable dent but saving his shin.",
                            "target_lang_translations": {
                                "es": "Un golpe directo impactó en su <w>greba</w> derecha, dejando una abolladura notable pero salvando su espinilla."
                            }
                        }
                    ],
                    "synonyms": [
                        "cnemid"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used historically or in historical contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Pieza de la armadura diseñada para proteger la parte inferior de la pierna, en especial la espinilla."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "greba",
                                "target_lang_sense_clarification": "pieza de armadura para la pierna"
                            },
                            {
                                "target_lang_word": "espinillera",
                                "target_lang_sense_clarification": "protección para la espinilla"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c5c06590-9cae-3b4e-9a2d-22f701ff9e96",
                    "sense_definition": "A grove, thicket, or bush.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "vegetation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The frightened deer quickly bounded into the sheltering <w>greave</w>.",
                            "target_lang_translations": {
                                "es": "El ciervo asustado saltó rápidamente hacia el cobijo de la <w>espesura</w>."
                            }
                        },
                        {
                            "text": "They rested beneath the shade of an ancient <w>greave</w> at the edge of the forest.",
                            "target_lang_translations": {
                                "es": "Descansaron bajo la sombra de una antigua <w>arboleda</w> en el límite del bosque."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rare or poetic usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Arboleda, espesura o matorral."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "arboleda",
                                "target_lang_sense_clarification": "conjunto de árboles"
                            },
                            {
                                "target_lang_word": "espesura",
                                "target_lang_sense_clarification": "lugar poblado y denso de árboles y maleza"
                            },
                            {
                                "target_lang_word": "matorral",
                                "target_lang_sense_clarification": "conjunto de matas"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "37e3990d-3001-341f-ba6e-8c733eab91a7",
                    "sense_definition": "A bough or branch of a tree.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "vegetation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A solitary bird sang from a high <w>greave</w> in the quiet morning air.",
                            "target_lang_translations": {
                                "es": "Un pájaro solitario cantaba desde una <w>rama</w> alta en el aire tranquilo de la mañana."
                            }
                        },
                        {
                            "text": "The heavy snow weighed down each leafy <w>greave</w> until it nearly snapped.",
                            "target_lang_translations": {
                                "es": "La nieve pesada sobrecargó cada frondosa <w>rama</w> hasta casi partirla."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Obsolete or archaic usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Rama o vástago principal de un árbol."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "rama",
                                "target_lang_sense_clarification": "parte de un árbol"
                            },
                            {
                                "target_lang_word": "ramaje",
                                "target_lang_sense_clarification": "conjunto o estructura de ramas"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6f8cf70c-1550-35bb-82de-93883c419d22",
                    "sense_definition": "A ditch or trench.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Rainwater rapidly pooled inside the deep <w>greave</w> that ran along the property line.",
                            "target_lang_translations": {
                                "es": "El agua de lluvia se acumuló rápidamente dentro de la profunda <w>zanja</w> que corría a lo largo del límite de la propiedad."
                            }
                        },
                        {
                            "text": "Workers dug a narrow <w>greave</w> across the field to help drain the marshy soil.",
                            "target_lang_translations": {
                                "es": "Los trabajadores cavaron una estrecha <w>zanja</w> a través del campo para ayudar a drenar el suelo pantanoso."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "Regional or obsolete usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Foso, zanja o trinchera."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "zanja",
                                "target_lang_sense_clarification": "excavación larga y estrecha"
                            },
                            {
                                "target_lang_word": "foso",
                                "target_lang_sense_clarification": "zanja profunda"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9d42c29c-35ab-32da-afee-7f931794b184",
                    "sense_definition": "To clean the bottom of a ship, typically by burning off barnacles and applying protective coating.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sailors brought the vessel ashore during low tide to <w>greave</w> the wooden hull.",
                            "target_lang_translations": {
                                "es": "Los marineros llevaron la embarcación a tierra durante la marea baja para <w>despalmar</w> el casco de madera."
                            }
                        },
                        {
                            "text": "They prepared the dockyard to <w>greave</w> the fleet before the long ocean voyage.",
                            "target_lang_translations": {
                                "es": "Prepararon el astillero para <w>despalmar</w> la flota antes del largo viaje oceánico."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Nautical term"
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Limpiar el fondo de un barco, especialmente quemando los percebes y aplicando un revestimiento protector."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "despalmar",
                                "target_lang_sense_clarification": "limpiar y dar sebo al fondo de una nave"
                            },
                            {
                                "target_lang_word": "carefar",
                                "target_lang_sense_clarification": "limpiar la obra viva del barco"
                            }
                        ]
                    }
                }
            ]
        }
    ]
