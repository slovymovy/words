    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b072d9b4-95e6-3997-95e7-533afb691d71",
                    "sense_definition": "zeitweiliges Einstellen oder Pausieren eines Vorgangs oder einer Handlung",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "handlung_unterbrechen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nach einer kurzen <w>Unterbrechung</w> setzten die Teilnehmer die Besprechung fort."
                        },
                        {
                            "text": "Wir sind sechs Stunden lang ganz ohne <w>Unterbrechung</w> mit dem Auto gefahren."
                        }
                    ],
                    "synonyms": [
                        "Aussetzung",
                        "Pause"
                    ],
                    "antonyms": [
                        "Fortsetzung",
                        "Wiederaufnahme"
                    ],
                    "common_phrases": [
                        "ohne Unterbrechung",
                        "kurze Unterbrechung"
                    ]
                },
                {
                    "sense_id": "21a14f97-10f2-3965-90df-17b2e86d441a",
                    "sense_definition": "Störung oder Unterbinden einer Rede, eines Gesprächs oder einer Kommunikation",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "kommunikation_unterbrechen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Bitte entschuldigen Sie die <w>Unterbrechung</w>, aber ein wichtiger Anruf wartet auf Sie."
                        },
                        {
                            "text": "Der Redner bat das unruhige Publikum um Aufmerksamkeit ohne ständige <w>Unterbrechungen</w>."
                        }
                    ],
                    "synonyms": [
                        "Unterbruch"
                    ],
                    "common_phrases": [
                        "Entschuldigen Sie die Unterbrechung"
                    ]
                },
                {
                    "sense_id": "2d4e85e7-627b-3a28-a28e-e1f34570df2e",
                    "sense_definition": "physische Trennung oder Störung einer technischen Verbindung oder Leitung",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "technik_unterbrechen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die plötzliche <w>Unterbrechung</w> der Stromzufuhr legte die gesamte Produktion für Stunden lahm."
                        },
                        {
                            "text": "Wegen einer <w>Unterbrechung</w> der Wasserleitung blieb das Wohnviertel am Nachmittag ohne Trinkwasser."
                        }
                    ],
                    "synonyms": [
                        "Trennung"
                    ],
                    "common_phrases": [
                        "Unterbrechung der Stromzufuhr",
                        "Unterbrechung der Verbindung"
                    ]
                },
                {
                    "sense_id": "af2944ba-fb0c-3649-83a0-8cb7c25d4ae7",
                    "sense_definition": "vorübergehendes Ruhen oder Aussetzen einer rechtlichen Frist oder eines Verfahrens",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "recht_unterbrechen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die rechtzeitige Klageerhebung führt zur gesetzlichen <w>Unterbrechung</w> der laufenden Verjährungsfrist."
                        },
                        {
                            "text": "Das Gericht ordnete die vorläufige <w>Unterbrechung</w> des laufenden Verfahrens an."
                        }
                    ],
                    "synonyms": [
                        "Aussetzung",
                        "Suspendierung"
                    ],
                    "common_phrases": [
                        "Unterbrechung der Verjährungsfrist"
                    ]
                },
                {
                    "sense_id": "920cec29-c64c-32e1-973a-1b55a07065a3",
                    "sense_definition": "kurzfristiges Anhalten eines Computerprogramms zur vorrangigen Bearbeitung eines anderen Ereignisses",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "informatik_unterbrechen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ein Systemaufruf führt zur sofortigen <w>Unterbrechung</w> des laufenden Benutzerprozesses im Betriebssystem."
                        },
                        {
                            "text": "Die Hardware fordert bei jedem Tastendruck eine kurze <w>Unterbrechung</w> des Prozessors an."
                        }
                    ],
                    "synonyms": [
                        "Interrupt",
                        "Unterbrechungsaufforderung"
                    ]
                }
            ]
        }
    ]
}