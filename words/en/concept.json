{
    "word_family": [
        "conceptual",
        "conceptualize",
        "conceptualization",
        "preconcept",
        "misconception"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5c427092-c8e9-33e4-a7db-c51f74e90fde",
                    "sense_definition": "An abstract or general idea derived from specific instances, reasoning, or imagination.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "idea",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>concept</w> of time is difficult for young children to fully understand.",
                            "target_lang_translations": {
                                "ru": "<w>Понятие</w> времени трудно для полного понимания маленькими детьми."
                            }
                        },
                        {
                            "text": "Scientists are working to develop a new <w>concept</w> for sustainable energy production.",
                            "target_lang_translations": {
                                "ru": "Ученые работают над созданием новой <w>концепции</w> устойчивого производства энергии."
                            }
                        }
                    ],
                    "synonyms": [
                        "conception",
                        "notion",
                        "abstraction"
                    ],
                    "common_phrases": [
                        "basic concept",
                        "abstract concept",
                        "key concept"
                    ],
                    "target_lang_definitions": {
                        "ru": "Абстрактная или общая идея, полученная на основе конкретных примеров, рассуждений или воображения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "понятие",
                                "target_lang_sense_clarification": "логически оформленная общая мысль о предмете"
                            },
                            {
                                "target_lang_word": "концепция",
                                "target_lang_sense_clarification": "система взглядов или основной замысел"
                            },
                            {
                                "target_lang_word": "представление",
                                "target_lang_sense_clarification": "знание или понимание чего-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ab4bd01c-d41b-36c0-a573-52cf8d56ff37",
                    "sense_definition": "In programming, a description of supported operations on a type, including their syntax and semantics.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "technical_specification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The latest version of the programming language introduces a new <w>concept</w> for template constraints.",
                            "target_lang_translations": {
                                "ru": "Последняя версия языка программирования вводит новый <w>концепт</w> для ограничений шаблонов."
                            }
                        },
                        {
                            "text": "Using a <w>concept</w> helps the compiler verify that the data type meets all requirements.",
                            "target_lang_translations": {
                                "ru": "Использование <w>концепта</w> помогает компилятору проверить, что тип данных соответствует всем требованиям."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "В программировании — описание поддерживаемых операций над типом, включая их синтаксис и семантику."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "концепт",
                                "target_lang_sense_clarification": "технический термин в программировании (например, в C++)"
                            },
                            {
                                "target_lang_word": "понятие",
                                "target_lang_sense_clarification": "в контексте теоретического описания типов"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a04d074a-8a35-3fcb-841e-96c0bcead98a",
                    "sense_definition": "To develop a preliminary idea or to dream up a design or plan.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "creation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team spent several weeks <w>concepting</w> the visual style of the new video game.",
                            "target_lang_translations": {
                                "ru": "Команда потратила несколько недель, <w>прорабатывая концепцию</w> визуального стиля новой видеоигры."
                            }
                        },
                        {
                            "text": "Before we start production, we need to <w>concept</w> the entire marketing campaign.",
                            "target_lang_translations": {
                                "ru": "Прежде чем мы начнем производство, нам нужно <w>разработать концепцию</w> всей маркетинговой кампании."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in creative industries"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Разрабатывать предварительную идею, дизайн или план проекта."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прорабатывать концепцию",
                                "target_lang_sense_clarification": "создавать общую идею проекта"
                            },
                            {
                                "target_lang_word": "концептить",
                                "target_lang_sense_clarification": "жаргон в креативных индустриях"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}