                    {
                        "sense_id": "f5cb28d3-d101-313f-a318-02cde67ce464",
                        "entry_id": "3f28f5fc-ef5d-3154-a90d-f99b85f1a079",
                        "glosses": [
                            "een ritmisch basispatroon in een muziekstuk gespeeld op een gitaar"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0ba4009-8360-49e5-b9b2-445c5895c3bc",
                                "sense_id": "f5cb28d3-d101-313f-a318-02cde67ce464",
                                "text": "Karakteristieke gitaarloopjes met een dubbelganger zijn er ook. David Bowie maakte in januari 1975 het nummer Fame. Later dat jaar kwam James Brown met Hot (I Need to be Loved) en daarin een inmiddels vertrouwde gitaarriff."
                            },
                            {
                                "example_id": "ef00ebd9-5224-429f-a337-4967d04e1fb0",
                                "sense_id": "f5cb28d3-d101-313f-a318-02cde67ce464",
                                "text": "Begin jaren 60 was hij een toonaangevende gitarist in de popmuziek, maar zijn grootste faam had Dick Dale te danken aan de film Pulp Fiction uit 1994. Quentin Tarantino gebruikte de gitaarriff uit Dale's nummer Misirlou uit 1962 als introductie van de film."
                            }
                        ]
                    }
