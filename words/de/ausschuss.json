            "pos": "noun",
            "senses": [
                {
                    "sense_id": "14d09969-4017-3edd-91c5-bad7a6b5ccb6",
                    "sense_definition": "Eine Gruppe von Fachleuten oder Abgeordneten, die beauftragt ist, bestimmte Themen oder Beschlüsse für eine größere Organisation vorzubereiten.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "organisation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der parlamentarische <w>Ausschuss</w> berät heute über den neuen Gesetzentwurf zur Digitalisierung an Schulen."
                        },
                        {
                            "text": "Das Parlament beschloss einstimmig, einen eigenen <w>Ausschuss</w> für Umweltfragen einzusetzen."
                        }
                    ],
                    "synonyms": [
                        "Gremium",
                        "Komitee",
                        "Kommission"
                    ],
                    "common_phrases": [
                        "parlamentarischer Ausschuss",
                        "einen Ausschuss einsetzen"
                    ]
                },
                {
                    "sense_id": "5069a703-d4cc-3b75-b803-0e3a2fffb710",
                    "sense_definition": "Fehlerhafte oder unbrauchbare Produkte aus einer Produktion, die den Qualitätsanforderungen nicht genügen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "produktion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wegen einer Fehlfunktion der Anlage produzierte die Fabrik gestern fast nur noch <w>Ausschuss</w>."
                        },
                        {
                            "text": "Die Qualitätskontrolle sortiert fehlerhafte Teile sofort aus, damit der <w>Ausschuss</w> nicht beim Kunden landet."
                        }
                    ],
                    "synonyms": [
                        "Fehlproduktion"
                    ],
                    "antonyms": [],
                    "common_phrases": [
                        "Ausschuss produzieren"
                    ]
                },
                {
                    "sense_id": "237cb583-9b58-3751-ab65-a13b84e43aaa",
                    "sense_definition": "Die Stelle, an der ein Projektil einen durchdrungenen Körper wieder verlässt.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "medizin",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der Gerichtsmediziner untersuchte am Oberkörper der verletzten Person sowohl den Einschuss als auch den <w>Ausschuss</w>."
                        },
                        {
                            "text": "Der <w>Ausschuss</w> war deutlich größer als die Einschusswunde."
