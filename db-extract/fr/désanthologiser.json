                "senses": [
                    {
                        "sense_id": "cbe68c8a-1262-31a4-bbc6-c502e0174155",
                        "entry_id": "384dc7bd-e8f9-3538-a417-3c35fc252aa1",
                        "glosses": [
                            "Faire perdre son caractère anthologique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d4461fd-0f1d-40a6-b584-bdef92afaf13",
                                "sense_id": "cbe68c8a-1262-31a4-bbc6-c502e0174155",
                                "text": "Il s’agissait de « déclassiciser » Lamartine, de le « désanthologiser »."
                            },
                            {
                                "example_id": "013af8ba-d09e-48c5-8373-f04963fd6caa",
                                "sense_id": "cbe68c8a-1262-31a4-bbc6-c502e0174155",
                                "text": "Paradoxalement, la réduction de l’intitulé à la seule catégorie générique – « Lettre », « Billet » – a le même effet désanthologisant que la double désignation des correspondants."
                            }
                        ]
                    }
