                        "sense_id": "1d221e73-73c9-3b37-9281-bf02730e69e3",
                        "entry_id": "c034ad41-99df-3b98-b8f2-8a3e3b058794",
                        "glosses": [
                            "Frau, die vorübergehend oder dauerhaft Kinder anderer Eltern aufnimmt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d0188b9-f4e3-40a0-accb-81e4982f45b7",
                                "sense_id": "1d221e73-73c9-3b37-9281-bf02730e69e3",
                                "text": "„Gut zwei Jahre wohnt er nun schon bei seiner Ziehmutter Agota, als diese 1949 an einer schweren Tuberkulose erkrankt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d6fb6f77-b3f1-3c95-b725-5a105faae9b2",
                        "entry_id": "c034ad41-99df-3b98-b8f2-8a3e3b058794",
