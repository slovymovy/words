                        "translation_id": "995dd229-1b50-473d-ba16-1ed039883112",
                        "source_entry_id": "3317d39d-7c07-3226-8de2-3b34b9f77d34",
                        "source_sense_id": "8514a0e2-eb11-3525-9b95-1396a7e89654",
                        "target_lang_word": "workable",
