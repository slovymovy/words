                            {
                                "example_id": "9ee35287-9084-44c4-bf3a-0bfcd1661e3f",
                                "sense_id": "997f577f-d7ee-35fc-ad68-a2b360778519",
                                "text": "„Haptik ist in vielen Anwendungsbereichen von Interesse.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "de35dd93-cd2f-3c0e-92e4-75f09f7e6869",
                        "entry_id": "b7b0b5de-9928-3ec2-b63f-612bd37d9229",
                        "glosses": [
                            "Art und Weise, wie sich etwas anfühlt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef4bd391-388b-4ad1-b5be-e8fd1763878a",
                                "sense_id": "de35dd93-cd2f-3c0e-92e4-75f09f7e6869",
                                "text": "„Die Haptik wurde sowohl im Umfang als auch bezüglich der Funktionalität erweitert.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "14e9e92f-1725-443f-8692-0af06f7ddfd4",
                        "source_entry_id": "b7b0b5de-9928-3ec2-b63f-612bd37d9229",
                        "source_sense_id": "997f577f-d7ee-35fc-ad68-a2b360778519",
                        "source_sense_description": "Lehre vom Tastsinn",
                        "target_lang_word": "haptics",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "haptics",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6c6452a2-3770-333d-85ea-517456e4e183",
                                        "entry_id": "1f3b1abb-7f18-3b5c-b9ce-8083600eb6a7",
                                        "glosses": [
                                            "The study of the sense of touch."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "234d4a13-7b83-3b97-9952-95a6d6c1d995",
                                        "entry_id": "1f3b1abb-7f18-3b5c-b9ce-8083600eb6a7",
                                        "glosses": [
                                            "The study of user interfaces that use the sense of touch."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9dbe1a4-bf50-42a4-b9f8-121f5aeb3d0a",
                                                "sense_id": "234d4a13-7b83-3b97-9952-95a6d6c1d995",
                                                "text": "Future work of this research field will include two issues: the safety and psychology of haptics."
                                            },
                                            {
                                                "example_id": "b6c52c67-deb0-4d73-8dc5-3d5252f1d846",
                                                "sense_id": "234d4a13-7b83-3b97-9952-95a6d6c1d995",
                                                "text": "2008, Manuel Ferre (editor), Haptics: Perception, Devices and Scenarios: 6th International Conference: EuroHaptics, Madrid, Spain, June 2008: Proceedings, LNCS 5024."
                                            },
                                            {
                                                "example_id": "d3e6a687-32c4-477c-8e60-fcff5dfbd2d0",
                                                "sense_id": "234d4a13-7b83-3b97-9952-95a6d6c1d995",
                                                "text": "However haptics is more than that. Haptic perceptions range from minor interactions in everyday life, eg, drinking from a glass or writing this text, to a means of social communication, eg shaking hands"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fdb1a302-8ea7-46c8-8aca-1a1035f516fe",
                        "source_entry_id": "b7b0b5de-9928-3ec2-b63f-612bd37d9229",
                        "source_sense_id": "997f577f-d7ee-35fc-ad68-a2b360778519",
                        "source_sense_description": "Lehre vom Tastsinn",
                        "target_lang_word": "haptique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "haptique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c500844d-3690-3f94-9025-b5739d82f8c0",
                                        "entry_id": "b64bf667-ee4c-363e-bce2-3fb665f8577c",
                                        "glosses": [
                                            "Relatif au toucher, aux interfaces, procurant cette sensation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39ec0a10-e7b7-4951-b8b6-f3f9fb2db37a",
                                                "sense_id": "c500844d-3690-3f94-9025-b5739d82f8c0",
                                                "text": "De nombreuses recherches soulignent l’efficience du système perceptif haptique, qui peut appréhender presque toutes les propriétés accessibles par la vision."
                                            },
                                            {
                                                "example_id": "b1859350-b9e4-4eb0-ab0b-0a84cff6a354",
                                                "sense_id": "c500844d-3690-3f94-9025-b5739d82f8c0",
                                                "text": "Le sens haptique résulte de l'activité simultanée et coordonnée des récepteurs tactiles et kinesthésiques qui fournissent de l'objet une perception unique en trois dimensions."
                                            },
                                            {
                                                "example_id": "a4266a56-9a83-459c-9511-8cdc319d6cc7",
                                                "sense_id": "c500844d-3690-3f94-9025-b5739d82f8c0",
                                                "text": "Les sensations haptiques englobent un large éventail de perceptions, incluant les vibrations, les textures, la température, la dureté, le poids et la forme à différentes échelles."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "haptique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8d272e42-d4dc-341c-9cf8-902db46a345c",
                                        "entry_id": "9de269df-b43e-353c-9c41-07dab13f34e4",
                                        "glosses": [
                                            "Science du toucher, et des phénomènes kinesthésiques, c’est-à-dire de la perception du corps dans l’environnement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b34da99a-b1be-4d5f-add9-6aba43cd56f7",
                                                "sense_id": "8d272e42-d4dc-341c-9cf8-902db46a345c",
                                                "text": "En ce qui concerne la réception des œuvres littéraires et visuelles en général, l’haptique est présente dès lors que le texte ou l’image déclenche des simulations perceptives sensorimotrices engageant une réunion du tactile et du kinesthésique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
