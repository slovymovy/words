                "translations": [
                    {
                        "translation_id": "1957dfd2-2091-49c9-83e3-b7ddc9149c64",
                        "source_entry_id": "af0751a1-a16f-3e52-ae3e-56b3d8d0054e",
                        "target_lang_word": "reload",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "reload",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "afd7e312-f51a-33c0-ad5e-f78a762ef247",
                                        "entry_id": "ce2f12a1-a324-36d9-9acc-1fe4ece57de3",
                                        "glosses": [
                                            "To load (something) again."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67d45d2c-703a-437a-b737-30183685e345",
                                                "sense_id": "afd7e312-f51a-33c0-ad5e-f78a762ef247",
                                                "text": "If you need to reload film, the cassette can be rewound slightly by turning the hub located on one end of its spool."
                                            },
                                            {
                                                "example_id": "b179df88-103b-494c-9fdf-a10316de6f31",
                                                "sense_id": "afd7e312-f51a-33c0-ad5e-f78a762ef247",
                                                "text": "The train has only a short distance left to its destination at Swinden Quarry, where the wagons will be reloaded."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1acf827e-625e-3755-875d-5331a8f7319d",
                                        "entry_id": "ce2f12a1-a324-36d9-9acc-1fe4ece57de3",
                                        "glosses": [
                                            "To load (something) again.",
                                            "To refresh a copy of a program etc. in memory or of a web page etc. on screen"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b4e189c0-beea-3e93-8dd5-b206d385a3d2",
                                        "entry_id": "ce2f12a1-a324-36d9-9acc-1fe4ece57de3",
                                        "glosses": [
                                            "To load (something) again.",
                                            "To load a gun again; or recharge a used cartridge."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7fe04e74-7017-462f-971d-c69ccea5088b",
                                                "sense_id": "b4e189c0-beea-3e93-8dd5-b206d385a3d2",
                                                "text": "Naturally after firing solidly for five minutes without reloading Arnie has wiped out all the bad dudes and thumbs a lift to the nearest town."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5bf01a0a-71be-3b66-82ee-fa0c153627ad",
                                        "entry_id": "ce2f12a1-a324-36d9-9acc-1fe4ece57de3",
                                        "glosses": [
                                            "To load (something) again.",
                                            "To replay music in a DJ set."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed0228ce-b309-41f1-b864-07a15d7f1bd9",
                                                "sense_id": "5bf01a0a-71be-3b66-82ee-fa0c153627ad",
                                                "text": "We're gonna make the stars come out tonight. So why don't you reload,reload, re reload the music?"
                                            },
