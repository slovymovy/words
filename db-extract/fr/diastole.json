        "fr-extract.jsonl": [
            {
                "entry_id": "d0b9d35e-33f0-3e57-a92d-1a92a8a58f01",
                "word": "diastole",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "08ebc110-e89d-4813-bf70-367b3e1696b1",
                        "entry_id": "d0b9d35e-33f0-3e57-a92d-1a92a8a58f01",
                        "tags": [
                            "plural"
                        ],
                        "form": "diastoles"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "55e6d188-85ae-3b0c-aafc-d710c172785a",
                        "entry_id": "d0b9d35e-33f0-3e57-a92d-1a92a8a58f01",
                        "glosses": [
                            "Mouvement de dilatation du cœur et des artères qui alterne avec le mouvement de contraction dit systole."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43b6ea4c-5dcb-4472-854e-3b8166742639",
                                "sense_id": "55e6d188-85ae-3b0c-aafc-d710c172785a",
                                "text": "C’est par le mouvement de la diastole que le sang des veines entre dans le cœur."
                            }
                        ]
                    },
                    {
                        "sense_id": "5dacd11d-cc79-34ed-b56e-f1472206b645",
                        "entry_id": "d0b9d35e-33f0-3e57-a92d-1a92a8a58f01",
                        "glosses": [
                            "Phase d’expansion, de dilatation ou de croissance."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99c08bef-3260-4f05-ac0a-48961656df55",
                                "sense_id": "5dacd11d-cc79-34ed-b56e-f1472206b645",
                                "text": "Le progrès avait parcouru la terre à une allure invincible, croyait-on, pour ne jamais plus à présent trouver le repos. Pendant plus de trois siècles, la longue diastole, régulièrement accélérée, de la civilisation occidentale s’était étendue de toutes parts à travers le globe."
                            }
                        ]
                    },
                    {
                        "sense_id": "20c971f7-3ca4-3a90-8c0a-f157783b0fff",
                        "entry_id": "d0b9d35e-33f0-3e57-a92d-1a92a8a58f01",
                        "glosses": [
                            "Sorte de virgule par laquelle les grammairiens grecs séparaient deux syllabes susceptibles de se confondre en un seul mot."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "68dace35-7a93-459a-b1de-bc5179f0f656",
                        "source_entry_id": "d0b9d35e-33f0-3e57-a92d-1a92a8a58f01",
                        "target_lang_word": "diastole",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "diastole",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "71821968-02ff-3f20-951c-6ab1c9b6d16b",
                                        "entry_id": "15b79f63-5ed5-3e31-ae4d-094fcb4164f1",
                                        "glosses": [
                                            "The phase or process of relaxation and dilation of the heart chambers, between contractions, during which they fill with blood; an instance of the process."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c620a2c9-8320-40ab-91e2-3eaeffe1ce07",
                                                "sense_id": "71821968-02ff-3f20-951c-6ab1c9b6d16b",
                                                "text": "[…] I did almoſt beleeve, that the motion of the Heart vvas knovvn to God alone: For neither could I rightly diſtinguiſh, vvhich vvay the Diaſtole and Systole came to be, nor vvhen nor vvhere the dilation and conſtriction had its exiſtence."
                                            },
                                            {
                                                "example_id": "01f8c6f6-6ebd-4210-aa03-c438ef95f56a",
                                                "sense_id": "71821968-02ff-3f20-951c-6ab1c9b6d16b",
                                                "text": "In patients with rapid rates, diastole may be sufficiently shortened that the third and fourth heart sounds become superimposed and form a summation gallop."
                                            },
                                            {
                                                "example_id": "c302bd1c-69df-4283-99e3-bfeca2941cef",
                                                "sense_id": "71821968-02ff-3f20-951c-6ab1c9b6d16b",
                                                "text": "Of the total cardiac cycle at this rate, diastole accounts for 0.50 s, or 62% of the cycle, and systole accounts for 0.31 s, or 38%."
                                            },
                                            {
                                                "example_id": "981e45f8-3b6a-457f-8496-decfc379ac2e",
                                                "sense_id": "71821968-02ff-3f20-951c-6ab1c9b6d16b",
                                                "text": "During a short cycle or premature contraction, LV ejection begins before pressure in the aorta has completely decreased, and it remains higher than with longer diastoles [4, 5]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e98ddd02-849e-3be5-a080-7b9ebcdb217b",
                                        "entry_id": "15b79f63-5ed5-3e31-ae4d-094fcb4164f1",
                                        "glosses": [
                                            "The lengthening of a vowel or syllable beyond its typical length."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2b5ef86-49ad-4f8f-832f-e70f8165b821",
                                                "sense_id": "e98ddd02-849e-3be5-a080-7b9ebcdb217b",
                                                "text": "1815 March and June, On the Greek and Latin Accents, The Classical Journal, Volume XI, page 81,\nI have inserted diastole which is omitted in Putschius, an insertion which both the complement, and the subsequent text make necessary."
                                            },
                                            {
                                                "example_id": "df0786cf-d7d9-4a05-86dd-013b4d4509b8",
                                                "sense_id": "e98ddd02-849e-3be5-a080-7b9ebcdb217b",
                                                "text": "[A]ccording to prosody, this syllable has the diastole and the stress, whereas the second of “cujus” or of “animam” has not."
                                            },
                                            {
                                                "example_id": "75c0e832-5cbe-46e9-9f9f-2a9cb715e44b",
                                                "sense_id": "e98ddd02-849e-3be5-a080-7b9ebcdb217b",
                                                "text": "Surely Goethe′s basic dichotomy of systole and diastole in the Divan poem[…]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8ded3794-dc0e-31df-a43a-dee5c6db35ce",
                                        "entry_id": "15b79f63-5ed5-3e31-ae4d-094fcb4164f1",
                                        "glosses": [
                                            "The hypodiastole, a textual or punctuation mark formerly used to disambiguate homonyms in Greek."
                                        ],
                                        "tags": [
                                            "Greek",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
