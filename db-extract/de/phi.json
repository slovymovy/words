                "senses": [
                    {
                        "sense_id": "80fbe4f7-d725-3c62-a274-0718fb783f1f",
                        "entry_id": "79f0f9ed-669b-3e50-9dd7-6dcb3c095fd5",
                        "glosses": [
                            "einundzwanzigster Buchstabe des griechischen Alphabets"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46d20627-676f-45e9-8b6d-07626c1929b7",
                                "sense_id": "80fbe4f7-d725-3c62-a274-0718fb783f1f",
                                "text": "Tatsächlich geht Ph in der Regel auf die antiken Sprachen Griechisch und Latein zurück. Im Altgriechischen wurde Phi allerdings nicht als [f], sondern als aspiriertes [p] ausgesprochen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8dfb5ab2-833c-4dc5-91f8-089f9a0dbd53",
                        "source_entry_id": "79f0f9ed-669b-3e50-9dd7-6dcb3c095fd5",
                        "source_sense_id": "80fbe4f7-d725-3c62-a274-0718fb783f1f",
