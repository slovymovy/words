{
    "word_family": [
        "teammate",
        "teamwork",
        "teamer"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6e3c2b9f-7d80-3c4d-9b4f-0a66d2d8ae92",
                    "sense_definition": "A group of people who work together or play a sport together as a unit.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "group_of_people",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Our <w>team</w> won the championship game last night.",
                            "target_lang_translations": {
                                "ru": "Наша <w>команда</w> выиграла чемпионат вчера вечером."
                            }
                        },
                        {
                            "text": "The manager leads a <w>team</w> of five software developers.",
                            "target_lang_translations": {
                                "ru": "Менеджер руководит <w>командой</w> из пяти разработчиков программного обеспечения."
                            }
                        }
                    ],
                    "common_phrases": [
                        "football team",
                        "team member",
                        "work team"
                    ],
                    "target_lang_definitions": {
                        "ru": "Группа людей, работающих вместе или занимающихся спортом как единое целое."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "команда",
                                "target_lang_sense_clarification": "спортивная или рабочая группа"
                            },
                            {
                                "target_lang_word": "коллектив",
                                "target_lang_sense_clarification": "группа людей, объединенных общей деятельностью"
                            },
                            {
                                "target_lang_word": "бригада",
                                "target_lang_sense_clarification": "группа рабочих"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "52c637e7-70ec-3706-b153-e4e86241e12e",
                    "sense_definition": "A group of people who support one side of a specific debate or choice.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "group_of_people",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the debate over the new logo, I am definitely on <w>team</w> blue.",
                            "target_lang_translations": {
                                "ru": "В споре о новом логотипе я определенно в синей <w>команде</w>."
                            }
                        },
                        {
                            "text": "The internet is divided into <w>team</w> coffee and <w>team</w> tea.",
                            "target_lang_translations": {
                                "ru": "Интернет разделился на <w>команду</w> любителей кофе и <w>команду</w> любителей чая."
                            }
                        }
                    ],
                    "common_phrases": [
                        "on team"
                    ],
                    "target_lang_definitions": {
                        "ru": "Группа людей, поддерживающих одну сторону в споре или выборе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "команда",
                                "target_lang_sense_clarification": "сторонники определенного выбора"
                            },
                            {
                                "target_lang_word": "группа",
                                "target_lang_sense_clarification": "объединение по интересам"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dea4bca4-f7a2-36b1-9f57-91dad360c00e",
                    "sense_definition": "A set of animals, such as horses or oxen, harnessed together to pull a vehicle or plow.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "group_of_animals",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer used a <w>team</w> of horses to pull the heavy wagon.",
                            "target_lang_translations": {
                                "ru": "Фермер использовал <w>упряжку</w> лошадей, чтобы тянуть тяжелую повозку."
                            }
                        },
                        {
                            "text": "A <w>team</w> of oxen was required to move the fallen tree.",
                            "target_lang_translations": {
                                "ru": "Потребовалась <w>упряжка</w> волов, чтобы сдвинуть упавшее дерево."
                            }
                        }
                    ],
                    "common_phrases": [
                        "team of horses",
                        "team of oxen"
                    ],
                    "target_lang_definitions": {
                        "ru": "Группа животных (лошадей, волов), запряженных вместе для перевозки груза или вспашки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "упряжка",
                                "target_lang_sense_clarification": "несколько животных, запряженных вместе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a36e10f1-6444-3c86-82be-0e51a82cc5bb",
                    "sense_definition": "A group of certain animals moving together, particularly young ducks or swans.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "group_of_animals",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We saw a <w>team</w> of ducklings swimming behind their mother.",
                            "target_lang_translations": {
                                "ru": "Мы видели <w>выводок</w> утят, плывущих за матерью."
                            }
                        },
                        {
                            "text": "A <w>team</w> of swans flew gracefully over the lake.",
                            "target_lang_translations": {
                                "ru": "<w>Стая</w> лебедей грациозно пролетела над озером."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Группа определенных животных, движущихся вместе, особенно утят или лебедей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стая",
                                "target_lang_sense_clarification": "группа птиц"
                            },
                            {
                                "target_lang_word": "выводок",
                                "target_lang_sense_clarification": "группа птенцов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "901b27c4-a74d-3e07-9909-19d81163c619",
                    "sense_definition": "An old legal privilege granted to a lord regarding the offspring and goods of his bondmen.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient charter granted the lord the right of toll and <w>team</w>.",
                            "target_lang_translations": {
                                "ru": "Древняя хартия даровала лорду право сбора пошлин и <w>тима</w>."
                            }
                        },
                        {
                            "text": "Historians studied the medieval records to understand the scope of the <w>team</w> privilege.",
                            "target_lang_translations": {
                                "ru": "Историки изучали средневековые записи, чтобы понять масштаб привилегии <w>тима</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical legal term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Старинное юридическое право лорда на потомство и имущество своих крепостных."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тим",
                                "target_lang_sense_clarification": "исторический юридический термин"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4bce7f5f-96c8-3ace-a66c-803117699855",
                    "sense_definition": "To join together with others to work on a task or play a game.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "collaboration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The two companies decided to <w>team</w> up for the new project.",
                            "target_lang_translations": {
                                "ru": "Две компании решили <w>объединиться</w> для нового проекта."
                            }
                        },
                        {
                            "text": "They <w>teamed</w> to complete the difficult assignment on time.",
                            "target_lang_translations": {
                                "ru": "Они <w>объединились</w>, чтобы вовремя выполнить сложное задание."
                            }
                        }
                    ],
                    "synonyms": [
                        "team up"
                    ],
                    "common_phrases": [],
                    "target_lang_definitions": {
                        "ru": "Объединяться с другими для выполнения задачи или игры."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "объединяться",
                                "target_lang_sense_clarification": "в команду"
                            },
                            {
                                "target_lang_word": "кооперироваться",
                                "target_lang_sense_clarification": "для совместной работы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f600036f-937a-3013-a474-7f2df96d9a9c",
                    "sense_definition": "To match or go well with something else, such as clothing or food.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "matching",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This white shirt <w>teams</w> well with blue jeans.",
                            "target_lang_translations": {
                                "ru": "Эта белая рубашка хорошо <w>сочетается</w> с синими джинсами."
                            }
                        },
                        {
                            "text": "The chef suggested that the wine <w>teams</w> perfectly with the fish.",
                            "target_lang_translations": {
                                "ru": "Шеф-повар предположил, что вино идеально <w>гармонирует</w> с рыбой."
                            }
                        }
                    ],
                    "common_phrases": [
                        "teams well with"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сочетаться или хорошо подходить к чему-либо (об одежде или еде)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сочетаться",
                                "target_lang_sense_clarification": "подходить друг к другу"
                            },
                            {
                                "target_lang_word": "гармонировать",
                                "target_lang_sense_clarification": "о стиле или вкусе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9974df52-e80d-3282-bc6d-f36143c7097d",
                    "sense_definition": "To put animals together into a working group.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "collaboration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rancher had to <w>team</w> the oxen before starting the work.",
                            "target_lang_translations": {
                                "ru": "Ранчеру пришлось <w>запрячь</w> волов перед началом работы."
                            }
                        },
                        {
                            "text": "It is difficult to <w>team</w> young horses that have not worked together.",
                            "target_lang_translations": {
                                "ru": "Трудно <w>собрать в упряжку</w> молодых лошадей, которые раньше не работали вместе."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Собирать животных в рабочую группу (упряжку)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "запрягать",
                                "target_lang_sense_clarification": "животных вместе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "78f63c9c-9071-309a-ac88-3a90837d4e37",
                    "sense_definition": "To transport or haul goods using a group of animals.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The workers spent the morning <w>teaming</w> lumber to the construction site.",
                            "target_lang_translations": {
                                "ru": "Рабочие все утро <w>перевозили</w> пиломатериалы на стройплощадку."
                            }
                        },
                        {
                            "text": "He made a living <w>teaming</w> supplies across the mountain pass.",
                            "target_lang_translations": {
                                "ru": "Он зарабатывал на жизнь, <w>перевозя</w> припасы через горный перевал."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Перевозить грузы с помощью упряжки животных."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перевозить",
                                "target_lang_sense_clarification": "на упряжных животных"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eeec1eb2-b65e-30c0-a192-3bc7bd8c43c1",
                    "sense_definition": "To assign work to a group of laborers under a subcontractor.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The contractor would <w>team</w> the labor to various small gangs.",
                            "target_lang_translations": {
                                "ru": "Подрядчик <w>распределял</w> рабочую силу по различным небольшим бригадам."
                            }
                        },
                        {
                            "text": "The system was designed to <w>team</w> out the work efficiently.",
                            "target_lang_translations": {
                                "ru": "Система была разработана для эффективного <w>распределения</w> работы."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Распределять работу между группами рабочих под руководством субподрядчика."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "распределять",
                                "target_lang_sense_clarification": "работу по бригадам"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6b7c0fb8-8b72-33b4-a390-3d6f73c4fa24",
                    "sense_definition": "A common misspelling of the word <w>teem</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The streets were <w>teaming</w> with people during the festival.",
                            "target_lang_translations": {
                                "ru": "Во время фестиваля улицы <w>кишели</w> людьми."
                            }
                        },
                        {
                            "text": "He wrote that the pond was <w>teaming</w> with fish, though he meant teeming.",
                            "target_lang_translations": {
                                "ru": "Он написал, что пруд <w>кишит</w> рыбой, хотя имел в виду слово teeming."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "misspelling"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ошибочное написание слова teem (кишеть)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кишеть",
                                "target_lang_sense_clarification": "ошибочное написание team вместо teem"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "232cbb78-d31c-321f-94f4-c4ddaea40b3c",
                    "sense_definition": "A river in Gateshead, England, that flows into the River Tyne.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "geographical_feature",
                    "examples": [
                        {
                            "text": "The River <w>Team</w> flows through the valley before reaching the Tyne.",
                            "target_lang_translations": {
                                "ru": "Река <w>Тим</w> протекает через долину, прежде чем впасть в Тайн."
                            }
                        },
                        {
                            "text": "Local residents enjoy walking along the banks of the <w>Team</w>.",
                            "target_lang_translations": {
                                "ru": "Местные жители любят гулять по берегам <w>Тима</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Gateshead, England"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Река в Гейтсхеде, Англия, впадающая в реку Тайн."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Тим",
                                "target_lang_sense_clarification": "название реки"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "d1cd1e0e-9da3-3ccf-bb79-0044c5db6254",
                    "sense_definition": "An exclamation used to suggest that another player join the speaker's side.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He shouted <w>Team</w>! across the lobby to invite his friend to the match.",
                            "target_lang_translations": {
                                "ru": "Он крикнул «<w>В команду</w>!» через вестибюль, чтобы пригласить друга на матч."
                            }
                        },
                        {
                            "text": "If you want to play together, just yell <w>Team</w>! at the start.",
                            "target_lang_translations": {
                                "ru": "Если хотите играть вместе, просто крикните «<w>В команду</w>!» в начале."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "gaming context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Восклицание, предлагающее другому игроку присоединиться к своей стороне."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "В команду!",
                                "target_lang_sense_clarification": "призыв к объединению в игре"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}