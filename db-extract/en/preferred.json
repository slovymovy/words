                                        "sense_id": "015898bf-874b-3e50-a823-6523d48ae4cf",
                                        "entry_id": "d2657883-000e-3be9-a1b1-984b9b4f6f37",
                                        "glosses": [
                                            "Qui est choisi avant tous les autres ; qui l’aime le plus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d1a029e-5325-45dc-8499-e26b69e93260",
                                                "sense_id": "015898bf-874b-3e50-a823-6523d48ae4cf",
                                                "text": "Je préparais les plats préférés de ma petite-fille et surtout l’indéclassable gâteau au chocolat, je mettais des violettes sur la table, j'allumais une chandelle puis je m'assoyais devant la fenêtre."
                                            },
                                            {
                                                "example_id": "abda5e00-c96e-4282-8ea4-427d5c41207d",
                                                "sense_id": "015898bf-874b-3e50-a823-6523d48ae4cf",
                                                "text": "ou par ellipse C’est mon préféré, ma préférée."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "préféré",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1d959d22-1b0f-347c-9b8b-030f75c70c6d",
                                        "entry_id": "c2e4a534-587f-38e5-8329-c2d5c4c2358e",
                                        "glosses": [
                                            "Personne préférée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2bd6544e-a3b0-4c62-b463-fbdc5ae8ae6c",
                                                "sense_id": "1d959d22-1b0f-347c-9b8b-030f75c70c6d",
                                                "text": "Et si le préféré n’est pas le plus jeune, a-t-on le droit d’écrire : « Bien que l’aîné, il était le benjamin de la famille » ?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "préféré",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a3441f71-722b-37ba-a58a-d07e31d8ea15",
                                        "entry_id": "7c58d39d-5b1d-3ab4-ab28-d015902e643e",
                                        "glosses": [
                                            "Participe passé masculin singulier de préférer."
