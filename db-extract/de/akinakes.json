                "senses": [
                    {
                        "sense_id": "08e5e674-7a35-333e-b7ee-422e3fd567d7",
                        "entry_id": "99823a3d-648b-3125-8c8a-be0fe397bd03",
                        "glosses": [
                            "zweischneidiges Kurzschwert, das von den Persern, Skythen und Griechen verwendet wurde"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "fdca0498-aa2f-409b-a9d3-12a3d1ddc1a3",
                                "sense_id": "08e5e674-7a35-333e-b7ee-422e3fd567d7",
                                "text": "„Was hoffte Darius noch? Er hatte, so heißt es, in erster Verzweiflung daran gedacht, mit dem zweischneidigen Perserschwert, dem Akinakes, sich selbst zu entleiben. Aber das Eisen entfiel ihm.“"
                            },
                            {
                                "example_id": "5bdadd07-c513-439c-9d51-b49d10515297",
                                "sense_id": "08e5e674-7a35-333e-b7ee-422e3fd567d7",
                                "text": "„Nach diesem Gebet warf Xerxes die Schale in den Hellespont, dazu einen goldenen Mischkrug und ein persisches Schwert, das sie Akinakes nennen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
