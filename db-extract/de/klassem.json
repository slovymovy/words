                ],
                "senses": [
                    {
                        "sense_id": "3e6f6a56-434d-31cb-af98-fde09b702ca5",
                        "entry_id": "86887100-39c0-3e66-925a-962d5ae2e042",
                        "glosses": [
                            "klassenbildendes semantisches Merkmal"
                        ],
                        "tags": [
                            "speziell Semantik"
                        ],
                        "examples": [
                            {
                                "example_id": "ff6f63b7-ddbb-4402-8769-eedac08003d0",
                                "sense_id": "3e6f6a56-434d-31cb-af98-fde09b702ca5",
                                "text": "„Ein Verbum erfährt seine Kennzeichnung durch die Klasseme seiner Subjekte und seiner Objekte.“"
                            },
                            {
                                "example_id": "92d0dd53-6ae6-4d49-87c9-300543c6cb2f",
                                "sense_id": "3e6f6a56-434d-31cb-af98-fde09b702ca5",
                                "text": "„Klasseme sind zum Beispiel kontextuelle oder semantische Merkmale wie [+ belebt], [- human] als Klasseme für »Tier« oder »Pflanze«.“"
                            },
                            {
                                "example_id": "7f21ee7c-603b-48fb-ba97-ebf61ea2a578",
                                "sense_id": "3e6f6a56-434d-31cb-af98-fde09b702ca5",
                                "text": "„Ferner, wenn Pottier und Coseriu semantische Komponenten in Seme und Klasseme aufteilen, dann betonen sie, daß es die Klasseme sind, die die semantisch fundierten syntagmatischen Interdependenzen zwischen Substantiven und Adjektiven oder zwischen Substantiven und Verben determinieren…“"
                            },
                            {
                                "example_id": "af267437-6631-4bde-a94f-46547df4da4d",
                                "sense_id": "3e6f6a56-434d-31cb-af98-fde09b702ca5",
                                "text": "„Zur Analyse der Bedeutung im geschlossenen Paradigma gehört auch die semantische Kategorisierung der Wörter zu Wortklassen oder Klassemen, denen bestimmte Inhalte zuzuordnen sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
