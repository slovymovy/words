                                "sense_id": "a1b88c87-b566-30f5-89c2-fa434f6d5e29",
                                "text": "Я угора́ю с его́ выраже́ния лица́.",
                                "translation": "I'm dying from his facial expression.",
                                "english": "I'm dying from his facial expression."
                            },
                            {
                                "example_id": "94db1f60-25a0-4112-ba83-f3c1596dfa15",
                                "sense_id": "a1b88c87-b566-30f5-89c2-fa434f6d5e29",
                                "text": "Я угора́ю над тем, как он вы́глядит.",
                                "translation": "I'm dying at how he looks.",
                                "english": "I'm dying at how he looks."
                            }
