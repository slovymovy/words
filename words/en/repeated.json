    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a87a619c-5242-3165-9364-f2b1a4cc6794",
                    "sense_definition": "Happening or done many times in the same way.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "recurrence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The athlete suffered from <w>repeated</w> injuries throughout the season.",
                            "target_lang_translations": {
                                "ru": "Спортсмен страдал от <w>повторных</w> травм на протяжении всего сезона.",
                                "zh": "这位运动员在整个赛季中遭受了<w>多次</w>受伤。"
                            }
                        },
                        {
                            "text": "Despite <w>repeated</w> warnings, the students continued to talk during the exam.",
                            "target_lang_translations": {
                                "ru": "Несмотря на <w>неоднократные</w> предупреждения, студенты продолжали разговаривать во время экзамена.",
                                "zh": "尽管受到<w>一再</w>警告，学生们在考试期间还是继续交谈。"
                            }
                        }
                    ],
                    "synonyms": [
                        "reiterate"
                    ],
                    "antonyms": [
                        "unrepeated"
                    ],
                    "common_phrases": [
                        "repeated warnings",
                        "repeated attempts",
                        "repeated failures"
                    ],
                    "target_lang_definitions": {
                        "ru": "Происходящий или совершаемый многократно одним и тем же образом.",
                        "zh": "以同样的方式多次发生或进行。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "повторный",
                                "target_lang_sense_clarification": "происходящий еще раз"
                            },
                            {
                                "target_lang_word": "многократный",
                                "target_lang_sense_clarification": "происходящий много раз"
                            },
                            {
                                "target_lang_word": "неоднократный",
                                "target_lang_sense_clarification": "случавшийся не один раз"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "重复的",
                                "target_lang_sense_clarification": "指再次发生或出现的"
                            },
                            {
                                "target_lang_word": "多次的",
                                "target_lang_sense_clarification": "指发生次数很多的"
                            },
                            {
                                "target_lang_word": "一再的",
                                "target_lang_sense_clarification": "强调反复发生，常用于负面语境"
                            }
