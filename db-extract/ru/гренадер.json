                                        "entry_id": "c83bed82-1c89-37de-9e44-ffb33a061f1c",
                                        "glosses": [
                                            "Soldat, der mit Handgranaten ausgerüstet ist"
                                        ],
                                        "tags": [
                                            "historisch (17. bis 18. Jahrhundert)"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e647014d-cf69-4a0d-9391-8496acdfcc55",
                                                "sense_id": "04e1eafa-ff47-33c3-895e-af60096b90d7",
                                                "text": "„Staunend sah das Volk die blauen Jacken der Grenadiere, die weißen Röcke der Spanier, die schwarzen Bärenfellmützen, die bunten Standarten und Wimpel durch die rauchenden Trümmer ziehen.“"
                                            },
                                            {
                                                "example_id": "5acd2152-ae70-46cf-aab4-f558b0246159",
                                                "sense_id": "04e1eafa-ff47-33c3-895e-af60096b90d7",
                                                "text": "„Dolochow gab ihm keine Antwort; er hatte sich mit dem französischen Grenadier in eine hitzige Auseinandersetzung eingelassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
