                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a234d108-6d4c-3fd0-b1b5-eace5b376fbc",
                                        "entry_id": "4510f356-9163-3f35-8758-5014db27928b",
                                        "glosses": [
                                            "A yellow robe that Jews in England were compelled to wear in the year 1189 as a mark of distinction."
                                        ],
                                        "tags": [
                                            "countable",
                                            "historical",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "012aaf9a-ef26-458a-b6bd-23d39bb51dbd",
                                                "sense_id": "a234d108-6d4c-3fd0-b1b5-eace5b376fbc",
                                                "text": "You call me misbeliever, cut-throat dog,\nAnd spet upon my Jewish gabardine,\n And all for use of that which is mine own."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e29bbe90-e434-48ba-a5d6-36a1fc6301f9",
                        "source_entry_id": "87311463-2ab1-3192-a4c9-2b229a8bb04e",
                        "source_sense_id": "762a8342-8fce-3e94-9b5f-9146b7bd3120",
