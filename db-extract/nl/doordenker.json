                                "example_id": "b1875d78-7dd0-4ae8-b92e-606ed3d6395b",
                                "sense_id": "b76dcdbb-d2c3-3090-83de-1842a6ccd53a",
                                "text": "Wat heeft ogen aan alle kanten en kan toch niet zien? Dat is nu eens een doordenker…"
                            }
