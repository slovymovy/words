                "senses": [
                    {
                        "sense_id": "1c3f1d6e-7894-3d8d-8543-c92fa6a12fd6",
                        "entry_id": "ed210968-78f2-3a91-b74e-eecbc2672770",
                        "glosses": [
                            "postać biblijna"
                        ],
                        "tags": [
                            "Biblical"
                        ],
                        "examples": [
                            {
                                "example_id": "2f660d68-b602-4a5b-87da-724a01d2b635",
                                "sense_id": "1c3f1d6e-7894-3d8d-8543-c92fa6a12fd6",
                                "text": "I Jesse przedstawił Samuelowi siedmiu swoich synów, lecz Samuel oświadczył Jessemu: «Nie ich wybrał Pan»"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
