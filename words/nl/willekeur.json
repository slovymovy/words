{
    "word_family": [
        "willekeurig",
        "willekeurigheid"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "94e8b0c6-952f-3be4-bccc-be3c59c2119b",
                    "sense_definition": "Het handelen of beslissen zonder vaste regels of normen, louter op basis van eigen voorkeur of toeval.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "arbitrariness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De burgers protesteerden fel tegen de <w>willekeur</w> van de lokale overheid.",
                            "target_lang_translations": {
                                "en": "The citizens protested fiercely against the <w>arbitrariness</w> of the local government."
                            }
                        },
                        {
                            "text": "Zonder duidelijke wetgeving is er een groot risico op <w>willekeur</w> bij de rechtspraak.",
                            "target_lang_translations": {
                                "en": "Without clear legislation, there is a high risk of <w>arbitrariness</w> in the administration of justice."
                            }
                        }
                    ],
                    "synonyms": [
                        "arbitrariteit"
                    ],
                    "antonyms": [
                        "rechtszekerheid",
                        "systematiek"
                    ],
                    "common_phrases": [
                        "overgeleverd aan willekeur",
                        "een vorm van willekeur"
                    ],
                    "target_lang_definitions": {
                        "en": "Acting or deciding without fixed rules or standards, purely on the basis of personal preference or chance."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "arbitrariness",
                                "target_lang_sense_clarification": "lack of systematic rules or standards"
                            },
                            {
                                "target_lang_word": "randomness",
                                "target_lang_sense_clarification": "lack of pattern or predictability"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bb9f12ba-0fab-389c-8ad4-e4af4eefd679",
                    "sense_definition": "Grillig en onvoorspelbaar gedrag of handelen dat niet op logica is gebaseerd.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "capriciousness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Deze oneerlijke behandeling was een voorbeeld van volstrekte <w>willekeur</w>.",
                            "target_lang_translations": {
                                "en": "This unfair treatment was an example of absolute <w>capriciousness</w>."
                            }
                        },
                        {
                            "text": "Zijn beslissingen leken vaak ingegeven door pure <w>willekeur</w> in plaats van verstand.",
                            "target_lang_translations": {
                                "en": "His decisions often seemed to be motivated by pure <w>whim</w> rather than reason."
                            }
                        }
                    ],
                    "synonyms": [
                        "grilligheid",
                        "caprice"
                    ],
                    "antonyms": [
                        "consistentie"
                    ],
                    "common_phrases": [
                        "pure willekeur"
                    ],
                    "target_lang_definitions": {
                        "en": "Capricious and unpredictable behavior or action that is not based on logic."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "capriciousness",
                                "target_lang_sense_clarification": "unpredictable or whimsical behavior"
                            },
                            {
                                "target_lang_word": "whim",
                                "target_lang_sense_clarification": "a sudden desire or change of mind"
                            },
                            {
                                "target_lang_word": "arbitrariness",
                                "target_lang_sense_clarification": "decisions based on random choice or personal whim"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}