{
    "word_family": [
        "timmerman",
        "timmerwerk",
        "timmerhout",
        "timmerlieden"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3ac806ec-4cec-39b8-8ba5-3dc2405d3fab",
                    "sense_definition": "houten zaken in elkaar zetten of bouwen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "bouwen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij kan erg goed <w>timmeren</w>; hij heeft gisteren die hele tafel gemaakt.",
                            "target_lang_translations": {
                                "fr": "Il sait très bien <w>menuiser</w> ; il a fabriqué toute cette table hier."
                            }
                        },
                        {
                            "text": "De vakman gaat in de schuur een nieuwe kast <w>timmeren</w>.",
                            "target_lang_translations": {
                                "fr": "L'artisan va <w>menuiser</w> une nouvelle armoire dans l'atelier."
                            }
                        }
                    ],
                    "synonyms": [
                        "bouwen",
                        "construeren"
                    ],
                    "common_phrases": [
                        "iets in elkaar timmeren"
                    ],
                    "target_lang_definitions": {
                        "fr": "Assembler ou construire des objets en bois."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "menuiser",
                                "target_lang_sense_clarification": "Travailler le bois pour fabriquer des objets ou des meubles."
                            },
                            {
                                "target_lang_word": "bricoler",
                                "target_lang_sense_clarification": "Fabriquer ou réparer des objets de manière artisanale."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "be852afd-6c39-35df-8de0-b11067f3c47e",
                    "sense_definition": "herhaaldelijk met een hamer op iets slaan",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "slaan",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Stop alsjeblieft met dat <w>timmeren</w> op je tafel.",
                            "target_lang_translations": {
                                "fr": "S'il te plaît, arrête de <w>marteler</w> ta table."
                            }
                        },
                        {
                            "text": "Hij bleef maar op de spijker <w>timmeren</w> tot hij eindelijk vastzat.",
                            "target_lang_translations": {
                                "fr": "Il a continué à <w>marteler</w> le clou jusqu'à ce qu'il soit enfin fixé."
                            }
                        }
                    ],
                    "synonyms": [
                        "hameren",
                        "kloppen"
                    ],
                    "common_phrases": [
                        "op iets timmeren"
                    ],
                    "target_lang_definitions": {
                        "fr": "Frapper de manière répétée avec un marteau."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "marteler",
                                "target_lang_sense_clarification": "Frapper avec un marteau de façon répétée."
                            },
                            {
                                "target_lang_word": "taper",
                                "target_lang_sense_clarification": "Frapper sur quelque chose, souvent pour faire du bruit ou enfoncer un objet."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}