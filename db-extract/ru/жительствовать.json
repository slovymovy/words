                ],
                "translations": [
                    {
                        "translation_id": "43136902-c6e3-46d5-9e7a-1457352c6999",
                        "source_entry_id": "ae03aa52-71e7-3a6f-bc72-69962cdf90a6",
                        "source_sense_id": "0791f5a1-6133-3e0e-9220-3beb81ebca5f",
                        "target_lang_word": "résider",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "résider",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "264e09c1-08e3-3c1e-b86d-f04c6b6341e0",
                                        "entry_id": "2ea64a13-a821-3929-8a07-9420fd7cf11c",
                                        "glosses": [
                                            "Faire sa demeure ou sa résidence en quelque endroit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f936b48-464f-40d1-afc1-7947edcc549e",
                                                "sense_id": "264e09c1-08e3-3c1e-b86d-f04c6b6341e0",
                                                "text": "A dix-huit heures tapantes, c'est l’extinction des feux, à peine une demi-heure plus tard, la ville s’est complètement vidée de sa population, car tous les Foyalais résident dans les quartiers périphériques."
                                            },
                                            {
                                                "example_id": "2bf5fdf0-a158-4fba-8b00-639240d93e40",
                                                "sense_id": "264e09c1-08e3-3c1e-b86d-f04c6b6341e0",
                                                "text": "On l’a imposé au lieu où il résidait. — Il résidait presque toujours sur sa terre, dans sa terre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e24d3ffa-5287-3e4b-a467-01d4534fc2c1",
                                        "entry_id": "2ea64a13-a821-3929-8a07-9420fd7cf11c",
                                        "glosses": [
                                            "Demeurer dans le lieu de son diocèse, de son bénéfice, etc. , en parlant d’un prélat de l’Église catholique romaine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "deca398b-dd6b-4098-bd06-46b163a9be3c",
                                                "sense_id": "e24d3ffa-5287-3e4b-a467-01d4534fc2c1",
                                                "text": "Les moines et les prêtres surprirent le pauvre homme, le jetèrent en prison, et le firent conduire à Vienne en Dauphiné, où résidait l’archevêque. Rénier préféra être brûlé vif, plutôt que de rien céder."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d5c361e-8dab-3b77-ba36-ea627876025f",
                                        "entry_id": "2ea64a13-a821-3929-8a07-9420fd7cf11c",
                                        "glosses": [
                                            "Consister ; se trouver."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c9d456d7-ab49-4eab-a628-2f81258d4561",
                                                "sense_id": "2d5c361e-8dab-3b77-ba36-ea627876025f",
                                                "text": "La principale différence entre le Baccara en banque et le Chemin de fer réside en ce que chaque joueur, dans ce dernier jeu, devient banquier à tour de rôle."
                                            },
                                            {
                                                "example_id": "ac34e86a-86e3-42b1-9269-aa8615957824",
                                                "sense_id": "2d5c361e-8dab-3b77-ba36-ea627876025f",
                                                "text": "Le grand intérêt de la solarisation réside dans cette stimulation de la microflore saprophyte épargnée par l'élévation de la température."
                                            },
                                            {
                                                "example_id": "a65d20b9-aa02-4460-99dc-48ad19a9b64f",
                                                "sense_id": "2d5c361e-8dab-3b77-ba36-ea627876025f",
                                                "text": "C’est en lui seul que réside notre espoir."
                                            },
                                            {
                                                "example_id": "075a3624-db69-46bd-b27e-7db9de6ad852",
                                                "sense_id": "2d5c361e-8dab-3b77-ba36-ea627876025f",
                                                "text": "Mais le gros problème du foot, selon celui qui a porté le maillot de l’équipe de France à douze reprises entre 2004 et 2006, réside dans les footballeurs eux-mêmes. Pour Gaël Givet, la nouvelle génération de joueurs pense trop à l’extra-sportif et n’est pas assez concentrée sur le terrain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "80f78bf4-36ed-3659-a401-7228b58badec",
                                        "entry_id": "2ea64a13-a821-3929-8a07-9420fd7cf11c",
                                        "glosses": [
                                            "Définition manquante ou à compléter. (Ajouter)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4391d776-39a0-4f96-977e-04912eef835f",
                                                "sense_id": "80f78bf4-36ed-3659-a401-7228b58badec",
                                                "text": "Bien plus nombreuses étaient les communautés ecclésiastiques. Perpignan en possédait quatre : nᵒ 1 La communauté de la paroisse Saint-Jean. Les bénéfices qui y avaient été fondés étaient au nombre de 134 ; une soixantaine environ étaient résidés et, comme les chanoines étaient admis à la distribution des revenus, il y avait donc environ 85 membres participants. […] – La deuxième communauté de la ville était celle de la Réal comprenant 36 bénéfices, dont 27 étaient résidés quelques temps avant la Révolution. – La troisième, de Saint-Jacques, comptait 16 bénéfices non résidés et 18 résidés. – La quatrième, de Saint-Mathieu, n’avait que 9 bénéficiers résidés, 19 autres ne l’étaient pas."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e51d67f3-3737-405c-81dd-bb6c6f37795f",
                        "source_entry_id": "ae03aa52-71e7-3a6f-bc72-69962cdf90a6",
                        "source_sense_id": "0791f5a1-6133-3e0e-9220-3beb81ebca5f",
                        "target_lang_word": "habiter",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "habiter",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c55a2d3c-487e-35fa-9f82-b2babb8fb9e5",
                                        "entry_id": "e26b0568-ed4d-311c-bc98-b4dffc7efc58",
                                        "glosses": [
                                            "Faire sa demeure, son séjour quelque part ; y vivre d’habitude."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3488e3b8-ef3d-4e99-a99a-a9a9fefa541c",
                                                "sense_id": "c55a2d3c-487e-35fa-9f82-b2babb8fb9e5",
                                                "text": "D’ailleurs, […], il est impossible de ne pas tenir compte de ce fait que les juifs ont habité la France cinq siècles avant les Francs, les Burgondes et les Wisigoths et huit siècles avant les Normands."
                                            },
                                            {
                                                "example_id": "30a4a2e1-f1cc-4b23-94d8-65c318f33129",
                                                "sense_id": "c55a2d3c-487e-35fa-9f82-b2babb8fb9e5",
                                                "text": "— La paix habite ce séjour."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8c5000a7-3cd1-3be7-be86-7d2815950f28",
                                        "entry_id": "e26b0568-ed4d-311c-bc98-b4dffc7efc58",
                                        "glosses": [
                                            "Être fortement présent dans l’esprit ou dans le cœur de (quelqu'un)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "582e487a-ea93-4860-99f3-65e3823d20fc",
                                                "sense_id": "8c5000a7-3cd1-3be7-be86-7d2815950f28",
                                                "text": "De plus, la hargne perpétuelle qui l’habitait, durcissait ses traits et lui donnait un visage revêche."
                                            },
                                            {
                                                "example_id": "59ba9356-2d10-4315-8888-e1972e2fff21",
                                                "sense_id": "8c5000a7-3cd1-3be7-be86-7d2815950f28",
                                                "text": "Mais dans les années 1930, Einstein n’avait que faire de la physique nucléaire, alors en plein essor. Une obsession unique l’habitait : élaborer une théorie unifiée de la gravitation et de l’électromagnétisme."
                                            },
                                            {
                                                "example_id": "e5672517-3ab3-4d28-9b46-42555bc57493",
                                                "sense_id": "8c5000a7-3cd1-3be7-be86-7d2815950f28",
                                                "text": "Le héros gaullien ne s’illusionne ni sur la bonté naturelle des individus ni sur la pérennité des grandes actions : il agit par une nécessité impérieuse qui l’habite."
                                            },
                                            {
                                                "example_id": "0378db05-4343-4b97-a191-7069d8804fe4",
                                                "sense_id": "8c5000a7-3cd1-3be7-be86-7d2815950f28",
                                                "text": "C’est sous l’emprise de cette introspection que je me suis abîmé dans la contemplation, habité par l’esprit des temps qui courent. […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d1213e73-d626-3a0a-a4b4-bc3f86705e86",
                                        "entry_id": "e26b0568-ed4d-311c-bc98-b4dffc7efc58",
                                        "glosses": [
                                            "Vivre habituellement en un lieu."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e24efe4-c1f3-464e-88eb-8c37ad1afd4a",
                                                "sense_id": "d1213e73-d626-3a0a-a4b4-bc3f86705e86",
                                                "text": "Il avait pris un soir son baluchon pour aller habiter chez une copine. Où précisément ? Peut-être du côté d’Élan ou de Villers-le-Tilleul. Il n’en savait fichtre rien."
                                            },
                                            {
                                                "example_id": "ec5693ec-1441-4c0f-834b-06e1c5b23750",
                                                "sense_id": "d1213e73-d626-3a0a-a4b4-bc3f86705e86",
                                                "text": "Or, \"habiter seul, notamment dans les zones tendues, ce sont des prix au mètre carré supérieurs à la moyenne\", et un taux d'effort de 46% pour les personnes pauvres, soit 10 points de plus que pour les ménages pauvres et près de 20 points de plus que pour l'ensemble des ménages, selon les statistiques compilées par l'association."
                                            },
                                            {
                                                "example_id": "cdb14ec7-d34c-4f89-afa3-88e4396285b6",
                                                "sense_id": "d1213e73-d626-3a0a-a4b4-bc3f86705e86",
                                                "text": "Si je suis dans ma rue, je peux dire « j’habite là-bas, au 13 » ou « j’habite au 13 » ou « j’habite à l’autre bout de la rue » ou « j’habite à côté de la pizzeria»."
                                            },
                                            {
                                                "example_id": "e2e7ac5f-002e-49da-b4cd-9dc487ad0c6c",
                                                "sense_id": "d1213e73-d626-3a0a-a4b4-bc3f86705e86",
                                                "text": "Habiter sous les toits."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7a002aa-e5d0-3192-9ecc-b6db28336933",
                                        "entry_id": "e26b0568-ed4d-311c-bc98-b4dffc7efc58",
                                        "glosses": [
                                            "Dans certains textes, en particulier religieux, habiter avec une femme signifie avoir des relations sexuelles avec celle-ci."
                                        ],
                                        "tags": [
                                            "euphemism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ce86718-f1ed-4711-967b-01c897043c0c",
                                                "sense_id": "c7a002aa-e5d0-3192-9ecc-b6db28336933",
                                                "text": "Tous les mâles, et le roi lui-même, sont obligés de se soumettre à cette opération singulière, qu’on leur fait ordinairement dès qu’ils sont en âge de pouvoir habiter avec des femmes, quoique certains voyageurs prétendent que ce n’est que vers l’âge de vingt-cinq ou trente ans ; ce qui ne paraît guère probable."
                                            },
                                            {
                                                "example_id": "8d8fe8ce-92b0-43a9-b667-4da2cf479d06",
                                                "sense_id": "c7a002aa-e5d0-3192-9ecc-b6db28336933",
                                                "text": "Il est remarquable, qu’à l’exception des Égyptiens et des Grecs, les autres peuples ne se font aucun scrupule d’habiter avec des femmes dans l’intérieur d'un temple ou d’y entrer, en les quittant, sans se laver, persuadés qu’il est permis aux hommes de suivre en cela l’exemple des animaux."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "habiter",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2f53d1b6-cd44-3dc7-a196-30356b640895",
                                        "entry_id": "1eb1a89c-4a5f-3e8c-8f55-b97e0c18c3aa",
                                        "glosses": [
                                            "Processus de construction des individus et des sociétés par l’espace et de l’espace par l’individu, dans un rapport d’interaction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85c67dfe-5bd7-46f7-a3fa-9912824db1f1",
                                                "sense_id": "2f53d1b6-cd44-3dc7-a196-30356b640895",
                                                "text": "La notion d’habiter pose quelques-uns des débats problématiques majeurs des sciences sociales et humaines. Habite-t-on la Terre ou le Monde ? Habiter, est-ce inné ou acquis ? Habiter se fait-il par raison ou émotion ? L’individuel l’emporte-t-il sur le collectif ? Habiter implique des ordres : comment sont-ils établis, voire contestés ?, etc…"
                                            },
                                            {
                                                "example_id": "e8ed9e72-19eb-4b9a-9165-40b81898de2e",
                                                "sense_id": "2f53d1b6-cd44-3dc7-a196-30356b640895",
                                                "text": "Ainsi, on peut distinguer des modes d’habiter différents selon les pratiques des individus et des sociétés dans l’espace dans un contexte d’essor des mobilités et des interconnexions, ce que Mathis Stock appelle des « sociétés à habitants mobiles ». En effet, l’habiter peut se traduire par beaucoup d'actes, de processus et d'objets différents en impliquant l'ensemble des activités humaines (travail, résidence, loisirs, etc.), l'habitant étant alors un acteur territorial à part entière. Le terme est donc indissociable de la vie en société et de la construction, dans le temps, de ces sociétés, l’habiter ne peut être restreint à l'espace privé."
                                            },
                                            {
                                                "example_id": "4ecfdeb5-a783-462d-9810-a01d1636b018",
                                                "sense_id": "2f53d1b6-cd44-3dc7-a196-30356b640895",
                                                "text": "Ce que les gens mobilisés dénoncent est pour moi l’un des symptômes clés de l’habiter colonial : ce que tu produis ne sera pas ce que tu consommes et ce que tu consommes ne sera pas ce que tu produis. L’habiter colonial ne permet pas d’accéder à une forme d’autonomie ou de souveraineté alimentaire : il a pour fonction d’alimenter d’autres marchés ou devient en tant que tel un marché pour nourrir un capitalisme protégé par l’État, dominé aux Antilles par le groupe socio-racial des békés."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4c37eca6-3ff8-4299-a206-2914cceeb925",
                        "source_entry_id": "ae03aa52-71e7-3a6f-bc72-69962cdf90a6",
                        "source_sense_id": "0791f5a1-6133-3e0e-9220-3beb81ebca5f",
                        "target_lang_word": "demeurer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "demeurer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9c571775-c80f-3a24-93f3-a81fad245fd5",
                                        "entry_id": "6af255f3-8433-30a2-9f32-a4dd8e90486c",
                                        "glosses": [
                                            "S’arrêter assez longtemps en un lieu. — Note d’usage : Conjugué avec l’auxiliaire être."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08cffb53-1d06-4b4f-8121-4bfdf6b1f33b",
                                                "sense_id": "9c571775-c80f-3a24-93f3-a81fad245fd5",
                                                "text": "Eh quoi ! vous voilà déjà en route ? Isaac Laquedem, « qui souffre à demeurer », s’arrête au moins pour boire la chope de bière que lui offrent les bourgeois de Bruxelles en Brabant !"
                                            },
                                            {
                                                "example_id": "c0cc7191-58f9-48f2-a6e4-25b9c948233c",
                                                "sense_id": "9c571775-c80f-3a24-93f3-a81fad245fd5",
                                                "text": "En les apercevant, Bert s’aplatit sur le sol, rampa jusqu’à un creux propice et demeura étendu là à contempler leurs efforts."
                                            },
                                            {
                                                "example_id": "d275b306-d445-49ea-928e-5f6c879d386b",
                                                "sense_id": "9c571775-c80f-3a24-93f3-a81fad245fd5",
                                                "text": "Elle pourrait demeurer ici, l’assaillir d’invites, de chatteries, toute la nuit provoquer son désir, répandre ses effluves."
                                            },
                                            {
                                                "example_id": "a5b5932c-5e71-424e-b615-8d58aa148bc6",
                                                "sense_id": "9c571775-c80f-3a24-93f3-a81fad245fd5",
                                                "text": "Elle était demeurée longtemps debout devant ces hautes coques dont les hublots laissaient voir l'intérieur des cabines éclairées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f77eacf-8afe-313e-a782-b7898c8ffde8",
                                        "entry_id": "6af255f3-8433-30a2-9f32-a4dd8e90486c",
                                        "glosses": [
                                            "Habiter, loger, faire son logement. — Note d’usage : Conjugué avec l’auxiliaire avoir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04135912-3649-4155-b2a3-076dd678d627",
                                                "sense_id": "5f77eacf-8afe-313e-a782-b7898c8ffde8",
                                                "text": "En songeant à cela j’arrivai chez le sonneur de cloches Brainstein, qui demeurait au coin de la petite place, dans une vieille baraque décrépite ; […]."
                                            },
                                            {
                                                "example_id": "9d2dea0a-9ed4-4658-be6d-7c495f1bc881",
                                                "sense_id": "5f77eacf-8afe-313e-a782-b7898c8ffde8",
                                                "text": "(...), tous les trois brisés du voyage, effarés et perdus au milieu du vaste Paris, le nez levé sur les maisons, demandant à chaque carrefour la rue de la Michodière, dans laquelle leur oncle Baudu demeurait."
                                            },
                                            {
                                                "example_id": "6cfb343a-2847-40fb-9b1c-8a16a95c150b",
                                                "sense_id": "5f77eacf-8afe-313e-a782-b7898c8ffde8",
                                                "text": "M. A… G…, demeurant à Troyes, souffre depuis longtemps d’une entérite que différents traitements n’ont pu guérir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c0f958ba-893e-3b24-a89a-e069ca5b8cf5",
                                        "entry_id": "6af255f3-8433-30a2-9f32-a4dd8e90486c",
                                        "glosses": [
                                            "Être à demeure, être permanent ou tenir, persister, durer."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "becd3f76-5c62-4a28-a172-fb03971bebb3",
                                                "sense_id": "c0f958ba-893e-3b24-a89a-e069ca5b8cf5",
                                                "text": "Confusion : le kaiser s’est enfui en Hollande, mais le militarisme demeure et les chefs sociaux-démocrates du nouveau régime, républicain, font alliance avec les généraux monarchistes et les corps francs à croix gammée contre les spartakistes."
                                            },
                                            {
                                                "example_id": "af6ae63a-882c-4a96-9112-c6403f710fa3",
                                                "sense_id": "c0f958ba-893e-3b24-a89a-e069ca5b8cf5",
                                                "text": "Cet arc de triomphe n’a pas été fait pour demeurer."
                                            },
                                            {
                                                "example_id": "69f11c0d-f9ce-440a-ba72-e623c4f1a06f",
                                                "sense_id": "c0f958ba-893e-3b24-a89a-e069ca5b8cf5",
                                                "text": "La parole s’envole, et les écrits demeurent, l’écriture demeure."
                                            },
                                            {
                                                "example_id": "8e454abe-fb08-4734-bf83-cd5da5c6d8b7",
                                                "sense_id": "c0f958ba-893e-3b24-a89a-e069ca5b8cf5",
                                                "text": "La tache en demeure toujours."
                                            },
                                            {
                                                "example_id": "5b6c8685-8bba-43ad-b274-5e6b9a962fc7",
                                                "sense_id": "c0f958ba-893e-3b24-a89a-e069ca5b8cf5",
                                                "text": "La cicatrice lui en est demeurée."
                                            },
                                            {
                                                "example_id": "34f2cd76-f347-44fa-af6f-2d3bb782e946",
                                                "sense_id": "c0f958ba-893e-3b24-a89a-e069ca5b8cf5",
                                                "text": "Il lui en est demeuré une cicatrice, une infirmité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5aa016c1-697a-3c03-bf8b-3ed59226f31a",
                                        "entry_id": "6af255f3-8433-30a2-9f32-a4dd8e90486c",
                                        "glosses": [
                                            "Se trouver, rester ou être dans un certain état."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d48bcf7-0f7e-416a-ba59-444d60bb145e",
                                                "sense_id": "5aa016c1-697a-3c03-bf8b-3ed59226f31a",
                                                "text": "Pendant que le nouveau venu se débitait à lui-même ce monologue, un autre cavalier, entré par l’autre bout de la rue, […], s’arrêtait et demeurait aussi en extase devant l’enseigne de la Belle-Étoile."
                                            },
                                            {
                                                "example_id": "a613d186-0a13-40c6-9caa-a69a8546ffe4",
                                                "sense_id": "5aa016c1-697a-3c03-bf8b-3ed59226f31a",
                                                "text": "Parmi les tailleurs de pierre qui sculptaient les images des cathédrales, il y avait des hommes d’un talent supérieur, qui semblent être demeurés toujours confondus dans la masse des compagnons ; ils ne produisaient pas moins des chefs-d’œuvre."
                                            },
                                            {
                                                "example_id": "664b9e1f-58f7-4bea-9d2b-c9980d1f834a",
                                                "sense_id": "5aa016c1-697a-3c03-bf8b-3ed59226f31a",
                                                "text": "[…], il découvrit bientôt la carcasse de l’un des monoplans asiatiques […]. La machine avait évidemment opéré une chute verticale et elle était demeurée à demi suspendue dans un groupe d’arbres ; […]."
                                            },
                                            {
                                                "example_id": "855d2f0b-255b-4b04-9571-9d31e4820a28",
                                                "sense_id": "5aa016c1-697a-3c03-bf8b-3ed59226f31a",
                                                "text": "Je demeurai couché sur le dos, les yeux grands ouverts, fixant le plafond."
                                            },
                                            {
                                                "example_id": "27d676f8-2e67-47b2-9105-4abfb61d9280",
                                                "sense_id": "5aa016c1-697a-3c03-bf8b-3ed59226f31a",
                                                "text": "La respiration demeure calme, le cœur est encore bon, mais le sang lui dégouline du crâne sur le nez, dans les yeux, poisse la chemise."
                                            },
                                            {
                                                "example_id": "fb131135-bc8a-4620-9cdb-43aee5235564",
                                                "sense_id": "5aa016c1-697a-3c03-bf8b-3ed59226f31a",
                                                "text": "Débusquer les bases biologiques d’un comportement n’enlève rien à l’humanisme du geste ni au libre arbitre : nous demeurons toujours libres de choisir entre un geste altruiste ou égoïste."
                                            },
                                            {
                                                "example_id": "2149d728-92a5-4460-8306-e069e297e735",
                                                "sense_id": "5aa016c1-697a-3c03-bf8b-3ed59226f31a",
                                                "text": "Enfin, pour le repérage des noms de lieu et des réseaux de communication terrestres, les deux atlas routiers, Southeast Asia et Indonesia, publiés chez Nelles Verlag, demeurent irremplaçables."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e59aa8eb-ae04-37b3-bdb3-d3d210078975",
                                        "entry_id": "6af255f3-8433-30a2-9f32-a4dd8e90486c",
                                        "glosses": [
                                            "Ce qui est conservé, laissé ou dévolu à quelqu’un."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38deee70-92ca-4f21-9d55-83a87656ef56",
                                                "sense_id": "e59aa8eb-ae04-37b3-bdb3-d3d210078975",
                                                "text": "Ce bien lui est demeuré, malgré les efforts de ceux qui le lui disputaient."
                                            },
                                            {
                                                "example_id": "cf67e91a-3e00-4b4d-bcd3-2f77379dd08b",
                                                "sense_id": "e59aa8eb-ae04-37b3-bdb3-d3d210078975",
                                                "text": "Ce titre lui demeure. ,"
                                            },
                                            {
                                                "example_id": "195d2ce2-21df-41c3-9a63-b2c0b2ba8b4c",
                                                "sense_id": "e59aa8eb-ae04-37b3-bdb3-d3d210078975",
                                                "text": "La victoire lui demeura."
                                            },
                                            {
                                                "example_id": "86dddbc7-be94-4ee0-b27a-ad90ab6a4632",
                                                "sense_id": "e59aa8eb-ae04-37b3-bdb3-d3d210078975",
                                                "text": "La gloire lui en est demeurée tout entière."
                                            },
                                            {
                                                "example_id": "6be42ec4-341c-4543-91f5-3182bfa6dd78",
                                                "sense_id": "e59aa8eb-ae04-37b3-bdb3-d3d210078975",
                                                "text": "Que la honte vous en demeure !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54acc38a-4d3f-362f-859e-7c45871048a7",
                                        "entry_id": "6af255f3-8433-30a2-9f32-a4dd8e90486c",
                                        "glosses": [
                                            "Être de reste."
                                        ],
                                        "tags": [],
                                        "note": "Dans cette acception, on l’emploie presque toujours impersonnellement",
                                        "examples": [
                                            {
                                                "example_id": "b9f290ba-814a-4233-a433-8c75a6b88207",
                                                "sense_id": "54acc38a-4d3f-362f-859e-7c45871048a7",
                                                "text": "Sans doute, presque tout demeure à faire pour passer d'une symptomatique à une véritable étiologie."
                                            },
                                            {
                                                "example_id": "b6d83c5c-51d3-4dd0-9df3-c1dbcd352892",
                                                "sense_id": "54acc38a-4d3f-362f-859e-7c45871048a7",
                                                "text": "Il ne lui est rien demeuré de tant de biens qu’il avait."
                                            },
                                            {
                                                "example_id": "686da372-2090-44ee-9e51-83e7d53d0d27",
                                                "sense_id": "54acc38a-4d3f-362f-859e-7c45871048a7",
                                                "text": "Il ne lui en est pas demeuré une obole."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
