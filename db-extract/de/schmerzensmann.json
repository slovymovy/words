                "senses": [
                    {
                        "sense_id": "5c7636ce-8932-3568-b368-a29af3d59114",
                        "entry_id": "ac1eae17-7b1a-36f7-91b7-7e8974d7e70f",
                        "glosses": [
                            "eine aus der Mystik heraus entstandene Form eines Andachtsbildes, das in Abwandlung der Ecce homo-Motivik den stehenden, später auch den sitzenden Christus lebend (nicht am Kreuz) mit all seinen Wunden darstellt"
                        ],
                        "tags": [
                            "Kunstgeschichte"
                        ],
                        "examples": [
                            {
                                "example_id": "e3e85cca-a52a-416b-b094-3d0a4016d6e1",
                                "sense_id": "5c7636ce-8932-3568-b368-a29af3d59114",
                                "text": "Der Schmerzensmann als Form eines Andachtsbildes leitet sich von einer Vision des Papstes Gregor des Großen während einer Messe her."
                            },
                            {
                                "example_id": "5de1b090-d551-4f67-ac42-416de6cd47db",
                                "sense_id": "5c7636ce-8932-3568-b368-a29af3d59114",
                                "text": "Sollen wir, nachdem wir erkannt haben, daß die Apostel und die Propheten Schmerzensmänner gewesen sind, bei diesem traurigen Gedanken an den Schmerz stehen bleiben?"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6a2449c3-ac8b-3cf4-b2ff-159672c8a028",
