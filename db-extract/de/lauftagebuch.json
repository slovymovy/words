                "senses": [
                    {
                        "sense_id": "ab04e0e9-317f-39d4-bfe9-36174e59ce53",
                        "entry_id": "19b7e028-d2ae-349a-81f1-dd93edc9201b",
                        "glosses": [
                            "Tagebuch, in dem ein Läufer seine Trainingseinheiten, Fortschritte, Erfahrungen und Ziele dokumentiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8cb089a9-d1d6-49fc-b004-b1d83502330d",
                                "sense_id": "ab04e0e9-317f-39d4-bfe9-36174e59ce53",
                                "text": "„Mich hat dieses ehrliche Lauftagebuch nicht nur unterhalten, sondern auch berührt und wach gerüttelt.“"
                            },
                            {
                                "example_id": "87df8b86-55e1-439d-aa7f-a2df585f70e0",
                                "sense_id": "ab04e0e9-317f-39d4-bfe9-36174e59ce53",
                                "text": "„Die gemessene Zeit schreibst du auf – am besten in dein Lauftagebuch.“"
                            },
                            {
                                "example_id": "df58e484-9556-4ab8-8aad-2a55ebd1152f",
                                "sense_id": "ab04e0e9-317f-39d4-bfe9-36174e59ce53",
                                "text": "„Um einen Überblick über die bereits zurückgelegte Kilometerzahl zu behalten, ist ein Lauftagebuch sinnvoll, in dem man die jeweilige Strecke der einzelnen Trainingseinheiten dokumentiert.“"
                            },
                            {
                                "example_id": "56916788-dcf1-4f5b-8252-9d5fdcb9c878",
                                "sense_id": "ab04e0e9-317f-39d4-bfe9-36174e59ce53",
                                "text": "„Ein Lauftagebuch stellt die Dokumentation der wichtigsten Trainings- und mit dem Training zusammenhängenden Daten dar und kann in verschiedener Form (u. a. handschriftlich, digital) festgehalten werden.“"
                            },
                            {
                                "example_id": "c99013d0-8754-42c9-88bc-039d70e9ead5",
                                "sense_id": "ab04e0e9-317f-39d4-bfe9-36174e59ce53",
                                "text": "„Führe ein Lauftagebuch, in dem du tägliche deine körperliche Verfassung, dein Befinden einträgst.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
