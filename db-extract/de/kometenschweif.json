                "senses": [
                    {
                        "sense_id": "bd523fab-73c8-308d-9eb4-f66160aa632d",
                        "entry_id": "cb1131b9-425b-3aa4-b471-87851a026260",
                        "glosses": [
                            "leuchtender Schwanz (Schweif) eines Kometen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86a96c22-08ed-4187-953b-01b77c6fde91",
                                "sense_id": "bd523fab-73c8-308d-9eb4-f66160aa632d",
                                "text": "„Die Sterndeuter erkannten in dem mächtigen Kometenschweif ein großes N und brachten die Erscheinung mit der Geburt des kleinen Königs in Verbindung.“"
                            },
                            {
                                "example_id": "f1fb152e-7582-48db-a5fb-51865fcac2a8",
                                "sense_id": "bd523fab-73c8-308d-9eb4-f66160aa632d",
                                "text": "„Wie ein Kometenschweif schwebten sie über seinen Kopf hinweg und durch die regenfrische Luft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
