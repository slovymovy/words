                    }
                ],
                "senses": [
                    {
                        "sense_id": "afc3d532-1fa8-3b98-9372-a7300b968831",
                        "entry_id": "ea1302d3-059a-37be-afd7-cbeeb9a47b0a",
                        "glosses": [
                            "A female hero."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29688822-f9ce-48f2-844b-582196b9e24d",
                                "sense_id": "afc3d532-1fa8-3b98-9372-a7300b968831",
                                "text": "Packing estrogen and, not infrequently, a pen and a sword, sheroes come in every imaginable shape, size, and color, and manifest their sheroism in infinite ways."
                            },
                            {
                                "example_id": "22f9e2da-e4e9-4b89-9391-584288afb799",
                                "sense_id": "afc3d532-1fa8-3b98-9372-a7300b968831",
                                "text": "Every human grouping, whether it's just two people, a family, people in the neighborhood, people in the city, in a nation, a tribe, a species; people live in direct relation to the heroes and the sheroes they have."
                            },
                            {
                                "example_id": "a4977c63-de24-4097-bdbe-f64a1ddf91fe",
                                "sense_id": "afc3d532-1fa8-3b98-9372-a7300b968831",
                                "text": "He talks about how we must remember the unsung heroes and sheroes of the Talahassee boycott, of the movement in general, and finally, he wonders how C. K. Steele would be accepted here."
                            },
                            {
                                "example_id": "14b5457e-2c31-488b-a3a4-f3253ab457e5",
                                "sense_id": "afc3d532-1fa8-3b98-9372-a7300b968831",
                                "text": "“They are nobodies. They could be silenced tomorrow. They are sheroes, to the world.”"
                            }
                        ]
                    }
                ],
