                ],
                "senses": [
                    {
                        "sense_id": "b29ca901-5019-3c47-bd6c-18fffabdded0",
                        "entry_id": "ca447179-37ba-3e60-95a7-d0ec5eb29c68",
                        "glosses": [
                            "weit ausgeholter Schlag"
                        ],
                        "tags": [
                            "Kampfsport",
                            "meist Boxen"
                        ],
                        "examples": [
                            {
                                "example_id": "174b3e02-25f8-4ba2-abb0-485156279094",
                                "sense_id": "b29ca901-5019-3c47-bd6c-18fffabdded0",
                                "text": "Mit einem Schwinger brachte er seinen Gegner zum Fall."
                            },
                            {
                                "example_id": "524d35df-e5e3-4f59-91bb-c826f43a96d5",
                                "sense_id": "b29ca901-5019-3c47-bd6c-18fffabdded0",
                                "text": "„Er schlug ihm kurze Gerade und gewaltige Schwinger um Kinn und Ohren, er pfefferte zwei wüste Herzhaken und einen grauenhaften Schlag auf den Solarplexus hinterher, und es schien ihm, als hörte er Ammers mit einem Ächzen zu Boden krachen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "daf00e9a-9886-3211-b383-d628a112829b",
                        "entry_id": "ca447179-37ba-3e60-95a7-d0ec5eb29c68",
                        "glosses": [
                            "Person, die die Sportart Schwingen betreibt"
                        ],
                        "tags": [
                            "Swiss Standard German"
                        ],
                        "examples": [
                            {
                                "example_id": "026c9c07-cfd2-4e07-8961-84c079d22f9b",
                                "sense_id": "daf00e9a-9886-3211-b383-d628a112829b",
                                "text": "Die Schwinger tragen über ihrer Kleidung einen Jutesack in Form einer kurzen Hose mit Ledergürteln und an dieser dürfen sie ihren Gegner packen und versuchen mit Schwüngen zu Boden zu bringen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
