{
    "word_family": [
        "unite",
        "unity",
        "unitary",
        "reunion",
        "disunity",
        "unitive"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2c2646cf-8078-3321-8f00-117794d4addc",
                    "sense_definition": "A standard quantity used to measure or express physical attributes such as length, weight, or time.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "measurement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The kilogram is a standard <w>unit</w> of mass used in most countries.",
                            "target_lang_translations": {
                                "ru": "Килограмм — это стандартная <w>единица</w> массы, используемая в большинстве стран.",
                                "zh": "千克是大多数国家使用的标准质量<w>单位</w>。"
                            }
                        },
                        {
                            "text": "You must use the correct <w>unit</w> of measurement to get an accurate result.",
                            "target_lang_translations": {
                                "ru": "Вы должны использовать правильную <w>единицу</w> измерения, чтобы получить точный результат.",
                                "zh": "你必须使用正确的测量<w>单位</w>才能得到准确的结果。"
                            }
                        }
                    ],
                    "synonyms": [
                        "unit of measure",
                        "unit of measurement"
                    ],
                    "common_phrases": [
                        "standard unit",
                        "metric unit",
                        "basic unit"
                    ],
                    "target_lang_definitions": {
                        "ru": "Стандартная величина, используемая для измерения или выражения физических свойств, таких как длина, вес или время.",
                        "zh": "用于测量或表示物理属性（如长度、重量或时间）的标准量。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "единица",
                                "target_lang_sense_clarification": "мера измерения"
                            },
                            {
                                "target_lang_word": "единица измерения",
                                "target_lang_sense_clarification": "устойчивое словосочетание"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "单位",
                                "target_lang_sense_clarification": "度量衡的标准"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1ad22331-70d7-3af3-b093-a5b5392deec0",
                    "sense_definition": "A distinct group of people or a department working together within a larger organization, such as in a hospital, police force, or military.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "organization",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient was transferred to the intensive care <w>unit</w> for constant monitoring.",
                            "target_lang_translations": {
                                "ru": "Пациента перевели в <w>отделение</w> реанимации для постоянного наблюдения.",
                                "zh": "病人被转入重症监护<w>室</w>进行持续监测。"
                            }
                        },
                        {
                            "text": "A special police <w>unit</w> was called in to handle the emergency situation.",
                            "target_lang_translations": {
                                "ru": "Для разрешения чрезвычайной ситуации было вызвано специальное полицейское <w>подразделение</w>.",
                                "zh": "警方调派了一支特警<w>部队</w>来处理紧急情况。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "intensive care unit",
                        "military unit",
                        "police unit",
                        "special unit"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отдельная группа людей или отдел, работающие вместе в рамках более крупной организации, например, в больнице, полиции или армии.",
                        "zh": "在大型组织（如医院、警察部队或军队）内共同工作的一个独立群体或部门。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подразделение",
                                "target_lang_sense_clarification": "организационная единица"
                            },
                            {
                                "target_lang_word": "отделение",
                                "target_lang_sense_clarification": "в больнице или учреждении"
                            },
                            {
                                "target_lang_word": "отряд",
                                "target_lang_sense_clarification": "в полиции или спецслужбах"
                            },
                            {
                                "target_lang_word": "часть",
                                "target_lang_sense_clarification": "военная"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "部门",
                                "target_lang_sense_clarification": "组织机构"
                            },
                            {
                                "target_lang_word": "单位",
                                "target_lang_sense_clarification": "工作机构"
                            },
                            {
                                "target_lang_word": "部队",
                                "target_lang_sense_clarification": "军事或警察"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cdc0c9e3-e79d-32bf-a557-2d3d76ad97b7",
                    "sense_definition": "A single piece of equipment, machine, or device, especially one that is part of a larger system.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "object",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We need to repair the air conditioning <w>unit</w> before the summer heat begins.",
                            "target_lang_translations": {
                                "ru": "Нам нужно отремонтировать <w>блок</w> кондиционирования воздуха до начала летней жары.",
                                "zh": "我们需要在酷暑来临前修理空调<w>机组</w>。"
                            }
                        },
                        {
                            "text": "The central processing <w>unit</w> is the most important part of this computer.",
                            "target_lang_translations": {
                                "ru": "Центральное процессорное <w>устройство</w> — самая важная часть этого компьютера.",
                                "zh": "中央处理<w>器</w>是这台电脑最重要的部分。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "air conditioning unit",
                        "control unit",
                        "display unit",
                        "processing unit"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отдельный предмет оборудования, механизм или устройство, особенно являющееся частью более крупной системы.",
                        "zh": "一件独立的设备、机器或装置，尤指大型系统的一部分。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "блок",
                                "target_lang_sense_clarification": "часть системы или механизма"
                            },
                            {
                                "target_lang_word": "устройство",
                                "target_lang_sense_clarification": "прибор"
                            },
                            {
                                "target_lang_word": "модуль",
                                "target_lang_sense_clarification": "составная часть"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "装置",
                                "target_lang_sense_clarification": "机械设备"
                            },
                            {
                                "target_lang_word": "部件",
                                "target_lang_sense_clarification": "系统组成部分"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fa61969f-4123-396a-a9d0-b3a56cde2106",
                    "sense_definition": "A single item or product regarded as a distinct entity for sale, production, or shipment.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "business",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The factory produces over five thousand <w>units</w> of this toy every day.",
                            "target_lang_translations": {
                                "ru": "Фабрика производит более пяти тысяч <w>единиц</w> этой игрушки каждый день.",
                                "zh": "这家工厂每天生产超过五千<w>件</w>这种玩具。"
                            }
                        },
                        {
                            "text": "Our sales team managed to move more <w>units</w> this month than expected.",
                            "target_lang_translations": {
                                "ru": "Нашей команде продаж удалось реализовать больше <w>единиц</w> товара в этом месяце, чем ожидалось.",
                                "zh": "我们的销售团队本月售出的产品<w>数量</w>超出了预期。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "units sold",
                        "cost per unit",
                        "production unit"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отдельный предмет или товар, рассматриваемый как самостоятельная единица для продажи, производства или отгрузки.",
                        "zh": "作为销售、生产或运输的独立实体而看待的单个物品或产品。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "единица",
                                "target_lang_sense_clarification": "товара или продукции"
                            },
                            {
                                "target_lang_word": "штука",
                                "target_lang_sense_clarification": "при подсчете предметов"
                            },
                            {
                                "target_lang_word": "экземпляр",
                                "target_lang_sense_clarification": "отдельный образец"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "件",
                                "target_lang_sense_clarification": "计量单位"
                            },
                            {
                                "target_lang_word": "个",
                                "target_lang_sense_clarification": "通用量词"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "26318709-cb0e-3f06-b07f-2daa474931b0",
                    "sense_definition": "A self-contained housing facility, such as an apartment, within a larger building or residential complex.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "housing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new residential complex will contain fifty rental <w>units</w> for families.",
                            "target_lang_translations": {
                                "ru": "Новый жилой комплекс будет содержать пятьдесят арендных <w>квартир</w> для семей.",
                                "zh": "这个新住宅区将提供五十<w>套</w>供家庭租赁的住房。"
                            }
                        },
                        {
                            "text": "They bought a small <w>unit</w> in the city center close to their workplace.",
                            "target_lang_translations": {
                                "ru": "Они купили небольшую <w>квартиру</w> в центре города недалеко от работы.",
                                "zh": "他们在市中心买了一<w>套</w>靠近工作地点的小公寓。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "housing unit",
                        "rental unit",
                        "apartment unit",
                        "residential unit"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отдельное жилое помещение, например квартира, в большом здании или жилом комплексе.",
                        "zh": "大型建筑或住宅区内独立的居住设施，如公寓。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "квартира",
                                "target_lang_sense_clarification": "жилье"
                            },
                            {
                                "target_lang_word": "жилое помещение",
                                "target_lang_sense_clarification": "официально"
                            },
                            {
                                "target_lang_word": "секция",
                                "target_lang_sense_clarification": "часть здания"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "单元",
                                "target_lang_sense_clarification": "住宅单元"
                            },
                            {
                                "target_lang_word": "套",
                                "target_lang_sense_clarification": "房屋量词"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8c61a648-0383-373b-b887-904e37305d26",
                    "sense_definition": "A standard measure used to quantify the amount of pure alcohol in a drink.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "measurement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Health guidelines suggest limiting your intake to a specific number of <w>units</w> per week.",
                            "target_lang_translations": {
                                "ru": "Рекомендации по здоровью предлагают ограничить потребление определенным количеством <w>единиц</w> в неделю.",
                                "zh": "健康指南建议每周的酒精摄入量限制在特定的<w>单位</w>数以内。"
                            }
                        },
                        {
                            "text": "This bottle of wine contains about nine <w>units</w> of alcohol.",
                            "target_lang_translations": {
                                "ru": "Эта бутылка вина содержит около девяти <w>единиц</w> алкоголя.",
                                "zh": "这瓶酒含有大约九<w>单位</w>的酒精。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "units of alcohol",
                        "alcohol units"
                    ],
                    "target_lang_definitions": {
                        "ru": "Стандартная мера, используемая для количественной оценки чистого алкоголя в напитке.",
                        "zh": "用于量化饮料中纯酒精含量的标准度量。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "единица",
                                "target_lang_sense_clarification": "алкоголя"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "单位",
                                "target_lang_sense_clarification": "酒精含量度量"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6547cc75-e2a4-38c7-8d9d-7ee205cf43bd",
                    "sense_definition": "The number one; a single undivided entity or whole.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "math",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In mathematics, the number one is often referred to as a <w>unit</w>.",
                            "target_lang_translations": {
                                "ru": "В математике число один часто называют <w>единицей</w>.",
                                "zh": "在数学中，数字一常被称为<w>单位</w>。"
                            }
                        },
                        {
                            "text": "The value increases by one <w>unit</w> for every step in the sequence.",
                            "target_lang_translations": {
                                "ru": "Значение увеличивается на одну <w>единицу</w> на каждом шаге последовательности.",
                                "zh": "序列中每一步的数值都会增加一个<w>单位</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "unity"
                    ],
                    "target_lang_definitions": {
                        "ru": "Число один; единая неделимая сущность или целое.",
                        "zh": "数字一；单一的、不可分割的实体或整体。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "единица",
                                "target_lang_sense_clarification": "число"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "单位",
                                "target_lang_sense_clarification": "数学概念"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f5d213fb-a0a9-3082-bd32-342780d18be4",
                    "sense_definition": "A physically large, muscular, or imposing person.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "slang_person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new rugby player is an absolute <w>unit</w> and is very hard to tackle.",
                            "target_lang_translations": {
                                "ru": "Новый регбист — настоящий <w>амбал</w>, и его очень трудно сбить с ног.",
                                "zh": "这位新来的橄榄球运动员是个名副其实的<w>大块头</w>，很难被拦截。"
                            }
                        },
                        {
                            "text": "He is such a <w>unit</w> that he barely fits through the doorway.",
                            "target_lang_translations": {
                                "ru": "Он такой <w>шкаф</w>, что едва проходит в дверной проем.",
                                "zh": "他长得太<w>壮</w>了，几乎挤不进门框。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "absolute unit",
                        "big unit"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Физически крупный, мускулистый или внушительный человек.",
                        "zh": "体格魁梧、肌肉发达或外表威猛的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "громила",
                                "target_lang_sense_clarification": "разг."
                            },
                            {
                                "target_lang_word": "амбал",
                                "target_lang_sense_clarification": "разг."
                            },
                            {
                                "target_lang_word": "шкаф",
                                "target_lang_sense_clarification": "сленг"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "大块头",
                                "target_lang_sense_clarification": "口语"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b05a336d-94ae-3c98-bd18-1ff96174dbc8",
                    "sense_definition": "Calculated or measured for each single item or individual.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "business_adj",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We need to reduce the <w>unit</w> cost to make the product more profitable.",
                            "target_lang_translations": {
                                "ru": "Нам нужно снизить <w>удельную</w> себестоимость, чтобы сделать продукт более прибыльным.",
                                "zh": "我们需要降低<w>单位</w>成本以提高产品的利润。"
                            }
                        },
                        {
                            "text": "The <w>unit</w> price decreases when you buy the materials in bulk.",
                            "target_lang_translations": {
                                "ru": "Цена за <w>единицу</w> снижается, когда вы покупаете материалы оптом.",
                                "zh": "批量购买材料时，<w>单价</w>会降低。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "unit cost",
                        "unit price",
                        "per unit"
                    ],
                    "target_lang_definitions": {
                        "ru": "Рассчитанный или измеренный для каждого отдельного предмета или индивидуума.",
                        "zh": "针对每个单独项目或个人进行计算或测量的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "удельный",
                                "target_lang_sense_clarification": "на единицу продукции"
                            },
                            {
                                "target_lang_word": "единичный",
                                "target_lang_sense_clarification": "отдельный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "单位",
                                "target_lang_sense_clarification": "修饰名词"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}