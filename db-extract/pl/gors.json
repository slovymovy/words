                "senses": [
                    {
                        "sense_id": "e23f2958-a6f0-3f3e-8d51-2c1afda8ce1d",
                        "entry_id": "073f44b5-ec3e-33cd-935f-1c8b46905b17",
                        "glosses": [
                            "górna część klatki piersiowej"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "93891caa-f767-4444-85fe-fe4e68e9aab9",
                                "sense_id": "e23f2958-a6f0-3f3e-8d51-2c1afda8ce1d",
                                "text": "Czuł jej potężne piersi na swoim gorsie, dotykał jej aksamitnych włosów, gładził jej ramiona, jej łzy ciekły mu po rękach"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "79517ca7-125f-3aa2-87bc-bdb2c7826d31",
                        "entry_id": "073f44b5-ec3e-33cd-935f-1c8b46905b17",
                        "glosses": [
                            "przednia część męskiej koszuli"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "353f8c50-1a7e-4b4a-9ba3-169d7666ef97",
                                "sense_id": "79517ca7-125f-3aa2-87bc-bdb2c7826d31",
                                "text": "W zieleni żywopłotu pojawił się śnieżny frakowy gors i przycięta w klin bródka flibustiera"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "88b7bef1-a958-3ef4-ab85-5d00b5e606aa",
                        "entry_id": "073f44b5-ec3e-33cd-935f-1c8b46905b17",
                        "glosses": [
                            "dekolt sukni"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6625fbba-6ade-4c2c-8313-fa0a3aee7c0d",
                                "sense_id": "88b7bef1-a958-3ef4-ab85-5d00b5e606aa",
                                "text": "Czarna szata, rozchylona na gorsie, odsłaniała nieporównanej białości szyję"
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8f43410f-e9ca-4c61-8d60-4b1f065ad34c",
                        "source_entry_id": "073f44b5-ec3e-33cd-935f-1c8b46905b17",
                        "source_sense_id": "79517ca7-125f-3aa2-87bc-bdb2c7826d31",
                        "target_lang_word": "shirtfront",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "shirtfront",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8063f44e-cb40-397f-a694-d1dcc2f8ef08",
                                        "entry_id": "436443bd-166b-31a6-b539-9160408ea0c8",
                                        "glosses": [
                                            "To confront in a threatening manner."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "39f53b86-26ec-47d3-a4a6-5247bfc8038b",
                                                "sense_id": "8063f44e-cb40-397f-a694-d1dcc2f8ef08",
                                                "text": "This was a case of a deputy shirtfronting her leader with an ultimatum and forcing a decision that would come close to wrecking the government's environmental credibility."
                                            },
                                            {
                                                "example_id": "d1b711da-d700-4af6-ae73-8b64e912acd7",
                                                "sense_id": "8063f44e-cb40-397f-a694-d1dcc2f8ef08",
                                                "text": "Pravda has described Tony Abbott as “a disturbed mind crying out for therapy”: after his threat to “shirtfront” the Russian president, Vladimir Putin, in Brisbane."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "shirtfront",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ec3d8b44-34c3-358e-a3d9-56ee770706c5",
                                        "entry_id": "e4e7f16c-6fd7-3e9d-b405-424eb087f7c0",
                                        "glosses": [
                                            "The front part of a shirt."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "baee78e2-e03c-4cc4-bebb-499dd2fedf09",
                                                "sense_id": "ec3d8b44-34c3-358e-a3d9-56ee770706c5",
                                                "text": "In the Victorian Era, exposing your shirtfront in public was considered improper, as shirts were viewed as undergarments. Waistcoats concealed this and helped [to] tame oversized, billowy shirts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3931c20e-0651-34f0-9c76-5368b827496a",
                                        "entry_id": "e4e7f16c-6fd7-3e9d-b405-424eb087f7c0",
                                        "glosses": [
                                            "A detachable insert that simulates the front of a shirt."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a1e4f97-118c-4970-9da8-b804f0ab12bb",
                                                "sense_id": "3931c20e-0651-34f0-9c76-5368b827496a",
                                                "text": "I liked the man for his own sake, and even had he promised to turn out a celebrity it would have had no weight with me. I look upon notoriety with the same indifference as on the buttons on a man's shirt-front, or the crest on his note-paper."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23c2a334-2c2c-377e-8f60-67b89704af9c",
                                        "entry_id": "e4e7f16c-6fd7-3e9d-b405-424eb087f7c0",
                                        "glosses": [
                                            "A pitch that is easy to bat on."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "54cdd3f1-2b58-36da-b6f4-8a10e212bd26",
                                        "entry_id": "e4e7f16c-6fd7-3e9d-b405-424eb087f7c0",
                                        "glosses": [
                                            "A head-on charge aimed at bumping an opponent to the ground."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "99851344-ded4-380b-9720-402656786935",
                                        "entry_id": "e4e7f16c-6fd7-3e9d-b405-424eb087f7c0",
                                        "glosses": [
                                            "An attractive facade applied only to the front of a house."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "447d30c7-abff-4f0c-9b82-041558e327a8",
                                                "sense_id": "99851344-ded4-380b-9720-402656786935",
                                                "text": "It is explained that a \"shirt front\" building is one of which only the street elevation is given a finished architectural treatment, the sides and back being of cheaper material, with no attempt at unification with the front."
                                            },
                                            {
                                                "example_id": "c658744c-5055-4ca0-8ac0-91e5cd4d3153",
                                                "sense_id": "99851344-ded4-380b-9720-402656786935",
                                                "text": "False fronts, frequently called \"shirt fronts,\" are futile attempts to make a small, cheap house pass for something larger and more valuable."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
