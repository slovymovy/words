                "senses": [
                    {
                        "sense_id": "d1e880f6-c907-3b60-a292-36d0ef7af1d3",
                        "entry_id": "b9d1f4a4-e044-3732-97a8-711109e81aee",
                        "glosses": [
                            "Donner un caractère amorphe à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b2a4863-f409-4202-b444-c47eee2c22b9",
                                "sense_id": "d1e880f6-c907-3b60-a292-36d0ef7af1d3",
                                "text": "Au contraire, les alliages liquides qui correspondent à la stœchiométrie d’un quasicristal stable sont très difficiles à amorphiser."
                            },
                            {
                                "example_id": "fc648860-7903-41e6-ad71-59ba8810496c",
                                "sense_id": "d1e880f6-c907-3b60-a292-36d0ef7af1d3",
                                "text": "Dans le cas contraire (à haute température), la génération des paires de Frenkel est largement contrebalancée par les recombinaisons et on atteint donc cet état stationnaire qui ne permettra jamais d’amorphiser le matériau."
                            }
                        ]
                    }
