                    {
                        "sense_id": "d91dfc42-4e8b-3a64-9c66-fa2879549649",
                        "entry_id": "6a5093b4-677b-3c98-bbf1-87ccef9b9f1a",
                        "glosses": [
                            "Organisation, die eine Ware für jemanden besorgt oder herstellt und gegebenenfalls auch ausliefern lässt, wenn die Organisation grammatikalisch weiblich ist (beispielsweise eine AG oder GmbH)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "231f349a-af7d-433a-90d9-6469117a2322",
                                "sense_id": "d91dfc42-4e8b-3a64-9c66-fa2879549649",
                                "text": "Die OLGA AG ist Lieferantin von Reinigungsmitteln."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "717349db-68f1-3ce4-8c7c-f8f65364a4ae",
                        "entry_id": "6a5093b4-677b-3c98-bbf1-87ccef9b9f1a",
                        "glosses": [
                            "weibliche Person, die Waren selbst ausliefert beziehungsweise zustellt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec7d629d-e30e-4423-8296-c302ca34dd22",
                                "sense_id": "717349db-68f1-3ce4-8c7c-f8f65364a4ae",
                                "text": "Horst? Der flirtet gerade mit der Lieferantin."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fbf1d86e-2913-42ca-a687-2832927c7881",
                        "source_entry_id": "6a5093b4-677b-3c98-bbf1-87ccef9b9f1a",
                        "source_sense_id": "d91dfc42-4e8b-3a64-9c66-fa2879549649",
                        "source_sense_description": "Organisation, die Waren erzeugt und für Kunden bereitstellt",
                        "target_lang_word": "supplier",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "supplier",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e5f56d3a-d87b-385d-8d8e-ff4511aabead",
                                        "entry_id": "0ca8105c-1b84-3e88-b29c-bf2ac0e20dc9",
                                        "glosses": [
                                            "One who supplies; a provider."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "440f323d-6d68-401e-92ae-80aceb40c911",
                                                "sense_id": "e5f56d3a-d87b-385d-8d8e-ff4511aabead",
                                                "text": "A farmer could place an order for a new tractor part by text message and pay for it by mobile money-transfer. A supplier many miles away would then take the part to the local matternet station for airborne dispatch via drone."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1138d01b-0139-3bdc-aeb4-3ce49beb6bc7",
                                        "entry_id": "0ca8105c-1b84-3e88-b29c-bf2ac0e20dc9",
                                        "glosses": [
                                            "Someone who assists (sets up) a goal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea4c8a3f-3323-4190-8532-d63cddeb86c3",
                                                "sense_id": "1138d01b-0139-3bdc-aeb4-3ce49beb6bc7",
                                                "text": "Regular supplier Barton played in another teasing corner, which was headed on towards goal by the impressive Ameobi and flicked in by expert poacher Nolan."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d0eb1d4c-a95b-455a-9345-59dcf0b2678f",
                        "source_entry_id": "6a5093b4-677b-3c98-bbf1-87ccef9b9f1a",
                        "source_sense_id": "d91dfc42-4e8b-3a64-9c66-fa2879549649",
                        "source_sense_description": "Organisation, die Waren erzeugt und für Kunden bereitstellt",
                        "target_lang_word": "distributor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "distributor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7026df2b-bd92-3c27-bf64-27e9caaf2e1a",
                                        "entry_id": "fcf1cfcd-357d-3b52-97e0-0b6bd183d0a5",
                                        "glosses": [
                                            "One who or that which distributes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d2ecb17-01aa-4bce-908f-912a90f94369",
                                                "sense_id": "7026df2b-bd92-3c27-bf64-27e9caaf2e1a",
                                                "text": "“The importance of that decision means that the voices of upset consumers have been heard and that those responsible for harming the highly respected reputation of Bud Light and Anheuser-Busch are no longer able to do so,” the distributor said in its statement. […] Still, some distributors are upset with Anheuser-Busch (BUD)."
                                            },
                                            {
                                                "example_id": "d23f44ae-4533-437c-878f-a4f76a3ac9fd",
                                                "sense_id": "7026df2b-bd92-3c27-bf64-27e9caaf2e1a",
                                                "text": "The recall said that the distributors — Walmart, CVS and AACE Pharmaceuticals — will be arranging the return of all the affected products."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "61332c18-bb3d-3f2e-b6f9-23db55a3fc45",
                                        "entry_id": "fcf1cfcd-357d-3b52-97e0-0b6bd183d0a5",
                                        "glosses": [
                                            "A device that distributes electric current, especially to the spark plugs in an internal combustion engine."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "64fc7048-6882-3fdf-b813-324465731fc7",
                                        "entry_id": "fcf1cfcd-357d-3b52-97e0-0b6bd183d0a5",
                                        "glosses": [
                                            "A machine for distributing type."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2fbddf83-2ca5-307d-be4a-9b93d476dab8",
                                        "entry_id": "fcf1cfcd-357d-3b52-97e0-0b6bd183d0a5",
                                        "glosses": [
                                            "An appliance, such as a roller, in a printing press, for distributing ink."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bd838533-bdf2-4c29-819e-10de324edddc",
                        "source_entry_id": "6a5093b4-677b-3c98-bbf1-87ccef9b9f1a",
                        "source_sense_id": "d91dfc42-4e8b-3a64-9c66-fa2879549649",
                        "source_sense_description": "Organisation, die Waren erzeugt und für Kunden bereitstellt",
                        "target_lang_word": "provider",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "provider",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "120dc7cd-2b06-3e75-956c-49c3def508b1",
                                        "entry_id": "3837f502-8bb0-3b27-ad24-5fbdb9d223fc",
                                        "glosses": [
                                            "One who, or that which, provides a service, commodity, or the means for subsistence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9590e751-3c32-4dd2-98cd-60ed31ae9d69",
                                                "sense_id": "120dc7cd-2b06-3e75-956c-49c3def508b1",
                                                "text": "In view of this, it is clear why internet service providers (ISPs) are inclined to play a backbench role when it comes to combating file sharing."
                                            },
                                            {
                                                "example_id": "39a52648-d6d9-4a32-a159-54b067de78d8",
                                                "sense_id": "120dc7cd-2b06-3e75-956c-49c3def508b1",
                                                "text": "Using BLE, a merchant or other provider can define more targeted \"micro-locations\" to trigger an alert, in some cases requiring that you be in the presence of an iBeacon in order to validate a Passbook entry."
                                            },
                                            {
                                                "example_id": "c47927e8-660e-4c92-943a-a7431b57ca84",
                                                "sense_id": "120dc7cd-2b06-3e75-956c-49c3def508b1",
                                                "text": "Even if policy shifts resources away from hard investment and back into social spending, the \"Floridization\" of Chinese demographics will intensify the shortage of healthcare provision over the next decade, worsening the frayed contract between patients, providers, and the government."
                                            },
                                            {
                                                "example_id": "d7205103-73a7-4e4f-bf15-2fcfb087dd4e",
                                                "sense_id": "120dc7cd-2b06-3e75-956c-49c3def508b1",
                                                "text": "A part of the nervousness at Chelsea involves whether any more sponsors will follow the telecommunications and internet service provider Three in withdrawing support, at least temporarily."
                                            },
                                            {
                                                "example_id": "c15f9fbb-fd47-449e-9a7a-c12e7642c0b4",
                                                "sense_id": "120dc7cd-2b06-3e75-956c-49c3def508b1",
                                                "text": "Both switching costs and network effects tend to lead to enshittification because platform providers see early adopters as an investment in future profits."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "54127397-a62c-4786-9c71-d3570aa264e8",
                        "source_entry_id": "6a5093b4-677b-3c98-bbf1-87ccef9b9f1a",
                        "source_sense_id": "d91dfc42-4e8b-3a64-9c66-fa2879549649",
                        "source_sense_description": "Organisation, die Waren erzeugt und für Kunden bereitstellt",
                        "target_lang_word": "vendor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vendor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "adcc8008-a4f3-3ea8-adbd-ed84f4a8f600",
                                        "entry_id": "11c80003-33f6-3e62-9209-80c56a3a8a5b",
                                        "glosses": [
                                            "A person or a company that vends or sells."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "beb7b2c5-2093-47d4-9d9b-b000dff6d794",
                                                "sense_id": "adcc8008-a4f3-3ea8-adbd-ed84f4a8f600",
                                                "text": "[…] Tanee was accosted by certain good fellows, friends and boon companions, who condoled with him on his misfortunes—railed against the queen, and finally dragged him away to an illicit vender of spirits, in whose house the party got gloriously mellow."
                                            },
                                            {
                                                "example_id": "1c7fb3eb-5218-440d-a6ea-ea25d3261d50",
                                                "sense_id": "adcc8008-a4f3-3ea8-adbd-ed84f4a8f600",
                                                "text": "Travel is enlivened not only by the mixed company of French, Berbers, Arabs, and descendants of the Mediterranean-Corsairs who sit together indiscriminately, but also by itinerant vendors of macaroons, sweetmeats and the like, who, as long as they have a travel ticket, ply their wares unhindered by the [ticket] collectors."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "159e1daf-2adb-354e-bb70-b2c2af0f9d6f",
                                        "entry_id": "11c80003-33f6-3e62-9209-80c56a3a8a5b",
                                        "glosses": [
                                            "A vending machine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "154f6347-cec5-4ba1-baef-e7a3c900af04",
                                                "sense_id": "159e1daf-2adb-354e-bb70-b2c2af0f9d6f",
                                                "text": "She left her duties guarding the cola vendor and brushed past Earl to the aisle with the creamed corn."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "vendor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "59aaf96b-26fe-3cf9-909d-00bbb16c1dfb",
                                        "entry_id": "33ae9c3c-a14b-3e7c-81f6-7bce05f45f2c",
                                        "glosses": [
                                            "To bundle third-party dependencies with the source code for one's own program."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9da60a5a-a93b-4920-8d8d-975acf29948c",
                                                "sense_id": "59aaf96b-26fe-3cf9-909d-00bbb16c1dfb",
                                                "text": "I distributed my application with a vendored copy of Perl so that it wouldn't use the system copies of Perl where it is installed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0067b820-d48b-3f09-a18d-055ae57ba703",
                                        "entry_id": "33ae9c3c-a14b-3e7c-81f6-7bce05f45f2c",
                                        "glosses": [
                                            "As the software vendor, to bundle one's own, possibly modified version of dependencies with a standard program."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "462c0e8e-2e33-4af5-8228-f1e00dcb9ca9",
                                                "sense_id": "0067b820-d48b-3f09-a18d-055ae57ba703",
                                                "text": "Strawberry Perl contains vendored copies of some CPAN modules, designed to allow them to run on Windows."
                                            }
                                        ]
                                    }
                                ]
                            }
