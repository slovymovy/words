                "senses": [
                    {
                        "sense_id": "2e27d220-ce6b-33c0-87f8-6ed2eabddb71",
                        "entry_id": "f6234237-9435-305a-aa2b-21f09e5af107",
                        "glosses": [
                            "Donner un caractère cosaque à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f2ffc86f-e548-4484-ab75-5b98004bcae9",
                                "sense_id": "2e27d220-ce6b-33c0-87f8-6ed2eabddb71",
                                "text": "Napoléon, lui, voulait « cosaquiser » les paysans français en les transformant en partisans sur les arrières de l'ennemi et il possédait ses krakkus polonais."
                            },
                            {
                                "example_id": "5554e6c7-cedc-4cb4-9aa8-a74247cb0a61",
                                "sense_id": "2e27d220-ce6b-33c0-87f8-6ed2eabddb71",
                                "text": "La campagne de 1812 conduit à en créer d'autres où les éléments cosaques de souche se mêlent à des paysans « cosaquisés » durant les décennies précédentes."
                            }
                        ]
                    }
