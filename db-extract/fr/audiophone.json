                "senses": [
                    {
                        "sense_id": "fdda5292-b7d9-3a46-b794-9f952c3145b0",
                        "entry_id": "e4b37485-8b8b-3738-b5c0-8b243daa0202",
                        "glosses": [
                            "Petit appareil que les malentendants utilisent pour amplifier les sons."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2645c457-0497-4a3e-85dc-b23f07c4ca94",
                                "sense_id": "fdda5292-b7d9-3a46-b794-9f952c3145b0",
                                "text": "Et maintenant le soleil s’adresse à moi qui n’ai rien à voir, ou bien peu, dans cette histoire; pour me parler de plus près, il devient un mot saxon qui vibre un bon moment dans mon oreille comme l’audiophone d’un sourd."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "45b3de1c-c766-4f29-93b1-017c7ad58599",
                        "source_entry_id": "e4b37485-8b8b-3738-b5c0-8b243daa0202",
                        "source_sense_id": "fdda5292-b7d9-3a46-b794-9f952c3145b0",
                        "target_lang_word": "Hörgerät",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hörgerät",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a50bdf69-0527-318f-9843-9084656e8529",
                                        "entry_id": "107d972a-37bc-3ce2-a630-336fb0ccd1a5",
                                        "glosses": [
                                            "Gerät für Hörgeschädigte, um die Hörfähigkeit zu verbessern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ad50a7b-97d8-45d6-9362-063b22ff4912",
                                                "sense_id": "a50bdf69-0527-318f-9843-9084656e8529",
                                                "text": "Als ihr Vater sechzig Jahre alt war, brauchte er wegen Hörverlustes ein Hörgerät."
                                            },
                                            {
                                                "example_id": "4465e7a5-53b1-41f4-b256-32a178430641",
                                                "sense_id": "a50bdf69-0527-318f-9843-9084656e8529",
                                                "text": "„Wir sehen Gehhilfen, Hörgeräte, Tablettendosen, zitternde und gleichwohl konzentrierte Hände, die die Medikamente neben dem Besteck ordnen.“"
                                            },
                                            {
                                                "example_id": "2a20f7a3-5a35-40ed-a3ce-6f89592fbf0b",
                                                "sense_id": "a50bdf69-0527-318f-9843-9084656e8529",
                                                "text": "„Erst kürzlich hatte ich mir bei einem Besuch bei meiner Mutter ihre Hörgeräte ausgeborgt und in die Ohren geschoben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b10b55b6-4294-4db5-949d-ae0ff9f26f4f",
                        "source_entry_id": "e4b37485-8b8b-3738-b5c0-8b243daa0202",
