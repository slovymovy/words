                "senses": [
                    {
                        "sense_id": "3d39d37d-c7d9-37fd-96d9-67ea482fc95e",
                        "entry_id": "5ee05c72-9186-361b-8da4-ce1c62987c45",
                        "glosses": [
                            "Person, die mit dauerhaften körperlichen oder psychischen Einschränkungen Surfen als Sport betreibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e68c5102-8ef1-4bd4-96f1-add00a3a75c4",
                                "sense_id": "3d39d37d-c7d9-37fd-96d9-67ea482fc95e",
                                "text": "„Jetzt hoffen die Parasurfer, dass sie es zu den Paralympics nach Los Angeles 2018 schaffen, die dort vom 15. bis zum 27. August 2028 ausgetragen werden.“"
                            },
                            {
                                "example_id": "1807f87f-163b-4127-a7df-bc1c158f3081",
                                "sense_id": "3d39d37d-c7d9-37fd-96d9-67ea482fc95e",
                                "text": "„Geehrt mit dem Bayerischen Sportpreis wurden außerdem: Bayernspieler Thomas Müller, Sprinterin Gina Lückenkemper, Trainer Peter Schlickenrieder, Parasurfer Ben Neumann und die Organisatoren des Rother Triathlons, den es seit 1984 gibt.“"
                            },
                            {
                                "example_id": "afa68341-5ab8-4bbe-9175-2ae81c7d5a39",
                                "sense_id": "3d39d37d-c7d9-37fd-96d9-67ea482fc95e",
                                "text": "„Im Laufe des Abends wird ein Dokumentarfilm (OmeU) über ihn und zwei weiteren Parasurfern gezeigt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
