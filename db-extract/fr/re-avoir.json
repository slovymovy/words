                        "glosses": [
                            "Avoir à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e921b26-0b90-4542-96f7-ce06d4345d98",
                                "sense_id": "01793a1a-bb4c-37ff-8435-196a589e3bfb",
                                "text": "Noémie a, quant à elle, « peur de re-craquer et de ne plus arriver [dans ses études], c’est-à-dire de re-avoir une grosse déprime et de laisser tomber, quelque chose qui fasse que je lâche tout »."
                            },
                            {
                                "example_id": "30b544e4-9d0e-43a7-8a02-0f3d06d0a6a4",
                                "sense_id": "01793a1a-bb4c-37ff-8435-196a589e3bfb",
                                "text": "Juste un petit reproche, pas de communication pour m’informer que le téléphone était réparé et renvoyé, mais bon, trop content de re-avoir mon téléphone."
                            },
                            {
                                "example_id": "29b0e5a9-5b64-4c82-a67b-012331bfc9aa",
                                "sense_id": "01793a1a-bb4c-37ff-8435-196a589e3bfb",
                                "text": "Re-avoir confiance en soi, les solutions de coach Blondine Koffi"
                            }
                        ]
                    }
