                        "source_sense_id": "2bc59968-f1c7-33ac-bce3-704608e5965e",
                        "source_sense_description": "organisme behorend tot de stam Chlorophyta",
                        "target_lang_word": "chlorophyte",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chlorophyte",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "24b484e8-6766-3742-9adb-5b65af9a6786",
                                        "entry_id": "0d9cb757-809a-3936-b015-2c9574122a06",
                                        "glosses": [
                                            "Any of the green algae that make up the division Chlorophyta"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b915ff3-91e5-4b0b-b500-839ae4fcaf82",
                                                "sense_id": "24b484e8-6766-3742-9adb-5b65af9a6786",
                                                "text": "Also consistent with the notion that chlorophytes require high light was the unprecedented appearance of the desmid Hyalotheca dissiliens that occurred when gypsy moth larvae defoliated the tree canopy overhanging a Rhode Island stream (Sheath et al., 1986)."
                                            },
                                            {
                                                "example_id": "a6767a3f-1d69-4850-9456-9b90a0d78b3b",
                                                "sense_id": "24b484e8-6766-3742-9adb-5b65af9a6786",
                                                "text": "Haploid flagellated spores dominate the life cycle of Chlamydomonas, a single-celled, freshwater chlorophyte (Figure 20.13)."
                                            },
                                            {
                                                "example_id": "e9b9b49b-0375-4c3c-981d-1953772121d4",
                                                "sense_id": "24b484e8-6766-3742-9adb-5b65af9a6786",
                                                "text": "Although there are as many ways to classify the chlorophytes as there are texts and publications discussing it, especially as new research becomes available, this chapter will focus on the scheme described in Graham and Wilcox (2000) and Wehr and Sheath (2003)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
