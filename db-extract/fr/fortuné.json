                                "target_senses": [
                                    {
                                        "sense_id": "2f9af50a-139f-3153-9046-6dda2e0dedcf",
                                        "entry_id": "681e9026-6d00-3dd0-8ed2-56f29e6b51aa",
                                        "glosses": [
                                            "door stom geluk begunstigd"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce246d52-fd90-4cac-9eed-5d35aa7c28ae",
                                                "sense_id": "2f9af50a-139f-3153-9046-6dda2e0dedcf",
                                                "text": "De fortuinlijke man was erg gelukkig."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7f122dec-26aa-46d3-a72d-b12301670c8e",
                        "source_entry_id": "57372f66-d992-3f48-a13e-efc02e74475c",
                        "target_lang_word": "gefortuneerd",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gefortuneerd",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "2280d53b-4765-39ab-91a2-43e9db4b6314",
                                        "entry_id": "7b3650b6-41de-3eac-9be6-7cebc73ffbba",
                                        "glosses": [
                                            "van een persoon dat deze veel geld heeft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "179f2f35-d8fd-4ab3-9cdc-9ee58aa45a53",
                                                "sense_id": "2280d53b-4765-39ab-91a2-43e9db4b6314",
                                                "text": "Een jeugdige collega van mij is op zoek naar een heel oude zeer gefortuneerde man. Doel: huwelijk. En zij voegt daar meteen en zeer beslist aan toe: de enige gemeenschap die er zal zijn, is die van goederen."
                                            },
                                            {
                                                "example_id": "a9162fd5-56a7-4144-8cff-c2c90b043604",
                                                "sense_id": "2280d53b-4765-39ab-91a2-43e9db4b6314",
                                                "text": "In november 2016 zond de Franse televisiezender France 3 een bijna anderhalf uur durende documentaire van Pierre Huvel uit, onder de titel La stratégie du météore. De meteoor in kwestie heet Emmanuel Macron, is 39 jaar oud, voormalig minister van Economische Zaken onder president Hollande en gefortuneerd ex-bankier bij de investeringsbank De Rothschild."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
