                    {
                        "sense_id": "407f2442-9fa4-3905-b4e5-fc78f5a1b628",
                        "entry_id": "a95e1a23-c456-3b2b-a38a-79530bb72be0",
                        "glosses": [
                            "Zeugnis, das nach Abschluss einer Ausbildung ausgehändigt wird und den Abschluss bezeugt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48819335-11fb-4381-ba40-ba91c5e92370",
                                "sense_id": "407f2442-9fa4-3905-b4e5-fc78f5a1b628",
                                "text": "Mein Abschlusszeugnis des Gymnasiums war nicht sonderlich gut, aber an der Universität hatte ich nur gute Zensuren."
                            },
                            {
                                "example_id": "4854d178-0387-43da-90ac-f44b9de7ff34",
                                "sense_id": "407f2442-9fa4-3905-b4e5-fc78f5a1b628",
                                "text": "„Tesfaye hat sein Abschlusszeugnis in einer feierlichen Zeremonie vor drei Jahren überreicht bekommen.“"
                            },
                            {
                                "example_id": "6be99482-7098-4bee-8b9f-93bb071c4451",
                                "sense_id": "407f2442-9fa4-3905-b4e5-fc78f5a1b628",
                                "text": "„Es wird ihm das Abschlusszeugnis ausgestellt, »um sich dem Studium der Medizin zu widmen«.“"
                            },
                            {
                                "example_id": "982aae1c-e00f-4e91-8e3e-e23e450449d7",
                                "sense_id": "407f2442-9fa4-3905-b4e5-fc78f5a1b628",
                                "text": "„In seinem Abschlusszeugnis erhielt Roth gute und sehr gute Noten in den akademischen Fächern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
