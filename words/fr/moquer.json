{
    "word_family": [
        "moqueur",
        "moquerie",
        "moqueusement"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "42acb45f-8f9d-3548-a468-36730bb99bec",
                    "sense_definition": "Tourner quelqu'un ou quelque chose en dérision, rire d'une personne de façon malveillante ou taquine.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "moquerie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les enfants dans la cour de récréation aiment se <w>moquer</w> gentiment de leurs camarades."
                        },
                        {
                            "text": "Il ne faut jamais se <w>moquer</w> de quelqu'un qui essaie d'apprendre une nouvelle langue."
                        }
                    ],
                    "synonyms": [
                        "railler",
                        "narguer",
                        "vanner"
                    ],
                    "common_phrases": [
                        "se moquer de quelqu'un",
                        "se moquer du monde"
                    ]
                },
                {
                    "sense_id": "b1a14ae6-0c8a-3dd5-bb62-42fbb0950c66",
                    "sense_definition": "Être complètement indifférent à quelque chose, n'accorder aucune importance à un fait ou à une opinion.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "indifference",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Peu importe ce que disent les voisins, elle s'en <w>moque</w> totalement."
                        },
                        {
                            "text": "Il s'est toujours <w>moqué</w> du danger et continue de pratiquer des sports extrêmes."
                        }
                    ],
                    "common_phrases": [
                        "s'en moquer royalement",
                        "s'en moquer éperdument"
                    ]
                },
                {
                    "sense_id": "8b618e80-71e5-3552-979b-6f93d29f0b9b",
                    "sense_definition": "Ne pas s'exprimer sérieusement, plaisanter en disant des choses invraisemblables.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "plaisanterie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tu ne peux pas penser cela, tu te <w>moques</w> sans doute de moi."
                        },
                        {
                            "text": "Quand elle annonce un tel projet à son équipe, elle se <w>moque</w> évidemment."
                        }
                    ],
                    "synonyms": [
                        "blaguer"
                    ]
                },
                {
                    "sense_id": "3c742423-af10-3f23-b97d-2e3332d36d04",
                    "sense_definition": "Tourner directement en ridicule un comportement, une idée ou une personne dans un emploi transitif.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "moquerie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le journaliste a habilement <w>moqué</w> les promesses irréalistes faites par les candidats."
                        },
                        {
                            "text": "Cette pièce de théâtre classique <w>moque</w> les travers et les vanités de la bourgeoisie."
                        }
                    ],
                    "synonyms": [
                        "railler",
                        "ironiser"
                    ],
                    "common_phrases": [
                        "moquer les travers"
                    ]
                }
            ]
        }
    ]
}