                        "examples": [
                            {
                                "example_id": "23041902-59df-439a-a5c8-88a691ae0625",
                                "sense_id": "436ced93-85cf-3707-8f8c-9e21f1254ff0",
                                "text": "Z panią Wiolettą pracującą u mojego poprzedniego pracodawcy dobrze się znałem."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "37d4d8f1-e658-4920-a5d4-1a97f0eac086",
                        "source_entry_id": "4656f386-89be-3840-8640-81de457c42ae",
                        "source_sense_id": "436ced93-85cf-3707-8f8c-9e21f1254ff0",
                        "target_lang_word": "Violet",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Violet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1765c091-5708-3baf-a5b9-8af2cfb2ec18",
                                        "entry_id": "d233f90b-0964-35c4-9b47-192e30c3c389",
                                        "glosses": [
                                            "A female given name from English."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2e9a7a9-be43-43cb-b8fe-4256c5da5ec3",
                                                "sense_id": "1765c091-5708-3baf-a5b9-8af2cfb2ec18",
                                                "text": "It may be as well to say, by way of parenthesis, that her real name was Violante,―at least, such was the name by which her mother had her christened. But her father thought it much too long, and said it was better to call her Violet."
                                            },
                                            {
                                                "example_id": "7614c231-7a18-4fe6-863f-37667f615ec9",
                                                "sense_id": "1765c091-5708-3baf-a5b9-8af2cfb2ec18",
                                                "text": "Her Pakeha name was Violet, and everybody called her that because her Maori name was too long. And my Nanny, she was just like a violet; shy and small and hiding her face in her petals if the sun blazed too strong."
                                            },
                                            {
                                                "example_id": "458fa161-7526-401f-b322-780a34331de8",
                                                "sense_id": "1765c091-5708-3baf-a5b9-8af2cfb2ec18",
                                                "text": "My name is Violet Brown. - - - If I sound colorful, I am not. It's nought but a pair of names, stamped on me by two people who never met. First, my mother. She was fond of romantic novels with \"Violets\" in them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "213efa7e-7e6a-3f2a-9bb1-ec5954a4b80b",
                                        "entry_id": "d233f90b-0964-35c4-9b47-192e30c3c389",
                                        "glosses": [
                                            "A surname."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "53486093-be25-3a6a-b547-c9ec784dff5c",
