                    {
                        "form_id": "13628094-6c16-40b8-9459-5f4fce1b350b",
                        "entry_id": "2d35cf53-6254-3e9c-9656-ca4ab48a29eb",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "den Magnetar"
                    },
                    {
                        "form_id": "05d02d12-b938-43c2-8883-5ff5ae38f0fc",
                        "entry_id": "2d35cf53-6254-3e9c-9656-ca4ab48a29eb",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Magnetare"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2fa165b6-157e-3ebe-8054-45033d889442",
                        "entry_id": "2d35cf53-6254-3e9c-9656-ca4ab48a29eb",
                        "glosses": [
                            "Neutronenstern, dessen Magnetfeld das 1000fache des bei Neutronensternen üblichen Wertes aufweist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "411325fb-6bc6-4e0e-865d-5ea5070f4805",
                                "sense_id": "2fa165b6-157e-3ebe-8054-45033d889442",
                                "text": "„Man kennt mehr als ein Dutzend Röntgenquellen in unserer Milchstraße, die als Kandidaten für Magnetare angesehen werden.“"
                            },
                            {
                                "example_id": "d1068455-2b2b-49ad-9288-9126415f95ec",
                                "sense_id": "2fa165b6-157e-3ebe-8054-45033d889442",
                                "text": "Derzeit sind in unserem Milchstraßensystem nur vier Magnetare, aber rund 2000 normale Pulsare bekannt."
                            },
                            {
                                "example_id": "906c07d8-9039-48b0-a174-c5e87b617092",
                                "sense_id": "2fa165b6-157e-3ebe-8054-45033d889442",
                                "text": "Aber auch die Strahlung, die beim Ausbruch eines Magnetars freigesetzt wird, könnte mit einem Mal die Atmosphäre der Erde hinwegfegen. Zuletzt brachen 1998 der Magnetar SGR 1900 + 14 in 20 000 Lichtjahren und 2005 SGR 1806–20 in 50 000 Lichtjahren Entfernung aus."
                            },
                            {
                                "example_id": "07b2deb3-73e3-45e2-a999-6a94f0bb7f0d",
                                "sense_id": "2fa165b6-157e-3ebe-8054-45033d889442",
                                "text": "So einen ehemaligen Begleiter glauben die Forscher nun entdeckt zu haben. Dieser sei vermutlich von der Wucht der Supernova-Explosion, in der sich der Magnetar geformt habe, weggeschleudert worden, denn heute entfernt er sich mit hoher Geschwindigkeit aus der Magnetar-Nachbarschaft."
                            },
                            {
                                "example_id": "284dc030-d668-498e-a2dd-7d546cccc1b2",
                                "sense_id": "2fa165b6-157e-3ebe-8054-45033d889442",
                                "text": "Das extrem starke Magnetfeld des Magnetars sorgt dafür, dass die von ihm ausgehende Strahlung hochgradig polarisiert wird, also bevorzugt in einer Ebene schwingt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b5339204-1663-4eb6-9045-5064731ee8d5",
                        "source_entry_id": "2d35cf53-6254-3e9c-9656-ca4ab48a29eb",
                        "source_sense_id": "2fa165b6-157e-3ebe-8054-45033d889442",
                        "target_lang_word": "magnetar",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "magnetar",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a99c57af-59cd-3a2f-a6f6-cac82ce3ce39",
                                        "entry_id": "a71fec6a-4d24-3cad-bbfb-8c87388bc2bf",
                                        "glosses": [
                                            "A neutron star or pulsar with an extremely powerful magnetic field, especially those on which starquakes occur, thought to be the source of some gamma-ray bursts."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46e322cb-a0e3-4d5c-ac53-728e2442445c",
                                                "sense_id": "a99c57af-59cd-3a2f-a6f6-cac82ce3ce39",
                                                "text": "This signal could be detected with Advanced LIGO-class detectors up to the distance of the Virgo cluster, where ≥ 1 yr⁻¹ magnetars are expected to form."
                                            },
                                            {
                                                "example_id": "c65f7ca1-46af-4a00-96fb-7003eaa5f262",
                                                "sense_id": "a99c57af-59cd-3a2f-a6f6-cac82ce3ce39",
                                                "text": "2008, W. Becker, F, Haberl, J Trümper, 14: Pulsars and Isolated Neutron Stars, Joachim E. Trümper, Günther Hasinger (editors), The Universe in X-Rays, page 193,\nThe radio-silent neutron stars include anomalous X-ray pulsars (AXPs), soft gamma-ray repeaters (SGRs), and “quiescent” neutron star candidates in SNRs. There is growing evidence that AXPs and SGRs are indeed magnetars (see [109] for a review)."
                                            },
                                            {
                                                "example_id": "375fc449-2435-43a1-aca7-80ffd2654e87",
                                                "sense_id": "a99c57af-59cd-3a2f-a6f6-cac82ce3ce39",
                                                "text": "One of most mysterious feature[s] of magnetars is their X-ray luminosities, which always exceed the rotational energy loss. Thus, the energy source of the radiation of magnetars is a mysterious question."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e6e879ee-6a31-4b38-8ee2-2c72807c7cb2",
                        "source_entry_id": "2d35cf53-6254-3e9c-9656-ca4ab48a29eb",
                        "source_sense_id": "2fa165b6-157e-3ebe-8054-45033d889442",
                        "target_lang_word": "magnétar",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "magnétar",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bba756c1-aafe-32d7-a181-e6f9dc45f6a4",
                                        "entry_id": "1bca2087-35e7-3ada-915c-e49ed2ab7c86",
                                        "glosses": [
                                            "Étoile à neutrons disposant d’un champ magnétique hyper-puissant, qui émet des radiations électromagnétiques de haute énergie (rayons X et rayons gamma)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c4b5b10-fe42-4782-bd20-511659dabd39",
                                                "sense_id": "bba756c1-aafe-32d7-a181-e6f9dc45f6a4",
                                                "text": "Suite à ce transfert de masse, l’étoile compagnon est devenue si massive qu’à son tour, elle expulse une vaste quantité de la matière récemment accrétée avant de s’effondrer pour former un magnétar."
                                            },
                                            {
                                                "example_id": "e9c181fd-b666-41f4-9beb-83be8e69d404",
                                                "sense_id": "bba756c1-aafe-32d7-a181-e6f9dc45f6a4",
                                                "text": "Certaines étoiles à neutrons avec un mouvement de rotation élevé sont nommées « pulsars », d’autres, dotées d’un champ magnétique très intense (qui dépasse 100 millions de teslas), sont nommées « magnétars »."
                                            },
                                            {
                                                "example_id": "a43bf8b3-e088-4d39-9e04-c260eb72e591",
                                                "sense_id": "bba756c1-aafe-32d7-a181-e6f9dc45f6a4",
                                                "text": "Des astronomes supposent cependant qu’ils sont causés par les champs magnétiques d’un magnétar, une étoile à neutrons hautement magnétique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2f6aff3c-828e-4cfb-974a-0d83bba7c0a4",
                        "source_entry_id": "2d35cf53-6254-3e9c-9656-ca4ab48a29eb",
                        "source_sense_id": "2fa165b6-157e-3ebe-8054-45033d889442",
