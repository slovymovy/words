                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "negotiation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They spent hours <w>bargaining</w> over the price of the car.",
                            "target_lang_translations": {
