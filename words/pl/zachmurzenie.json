                    "sense_definition": "stopień pokrycia nieba przez chmury; stan nieba pokrytego chmurami",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "pogoda",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W prognozie pogody zapowiadano duże <w>zachmurzenie</w> oraz przelotne opady deszczu w całym kraju.",
                            "target_lang_translations": {
                                "ru": "В прогнозе погоды обещали сильную <w>облачность</w> и кратковременные дожди по всей стране."
                            }
                        },
                        {
                            "text": "Mimo że było spore <w>zachmurzenie</w>, temperatura na zewnątrz pozostała dość wysoka.",
                            "target_lang_translations": {
                                "ru": "Несмотря на то что была значительная <w>облачность</w>, температура на улице оставалась довольно высокой."
                            }
                        }
                    ],
                    "antonyms": [
                        "bezchmurność"
                    ],
                    "common_phrases": [
                        "duże zachmurzenie",
                        "małe zachmurzenie",
                        "umiarkowane zachmurzenie",
                        "całkowite zachmurzenie"
                    ],
                    "target_lang_definitions": {
                        "ru": "степень покрытия неба облаками; состояние облачного неба"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "облачность",
                                "target_lang_sense_clarification": "степень покрытия неба облаками, погода"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4440fccc-079b-3e42-9cdc-84c55515a124",
                    "sense_definition": "rzeczownik odczasownikowy od: <w>zachmurzyć</w>",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "czynność",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Niespodziewane <w>zachmurzenie</w> nieba zepsuło nam plany na popołudniowy spacer po plaży.",
                            "target_lang_translations": {
                                "ru": "Неожиданное <w>затягивание</w> неба <w>тучами</w> испортило нам планы на дневную прогулку по пляжу."
                            }
                        },
                        {
                            "text": "Gwałtowne <w>zachmurzenie</w> się horyzontu zwiastowało nadchodzącą burzę z silnym wiatrem.",
                            "target_lang_translations": {
                                "ru": "Внезапное <w>потемнение</w> горизонта предвещало надвигающуюся бурю с сильным ветром."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "действие по значению глагола zachmurzyć (затягивание облаками, омрачение)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "затягивание облаками",
                                "target_lang_sense_clarification": "процесс покрытия неба тучами или облаками"
                            },
                            {
                                "target_lang_word": "набегание туч",
                                "target_lang_sense_clarification": "появление облачности"
                            }
                        ]
                    }
