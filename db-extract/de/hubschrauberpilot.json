                ],
                "senses": [
                    {
                        "sense_id": "5675202f-957d-37c5-8089-1c439fd29c10",
                        "entry_id": "ee930bca-c278-3be6-ae0b-32a8b6381da6",
                        "glosses": [
                            "Person, die einen Hubschrauber steuert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12b934bc-91ef-4e65-b7de-3e98f336c898",
                                "sense_id": "5675202f-957d-37c5-8089-1c439fd29c10",
                                "text": "Hubschrauberpiloten üben einen gefährlichen Beruf aus."
                            },
                            {
                                "example_id": "826021b4-5fd6-47d0-95b2-d3aa716edcd1",
                                "sense_id": "5675202f-957d-37c5-8089-1c439fd29c10",
                                "text": "„Der Hubschrauberpilot ist seit sechs am Stützpunkt Wiener Neustadt, hat mit Notarzt Helmut Trimmel und Sanitäter Roman Lechner Helikopter und die medizinische Ausrüstung überprüft.“"
                            },
                            {
                                "example_id": "e4094af1-ab55-45f9-8f44-ec0db5dac508",
                                "sense_id": "5675202f-957d-37c5-8089-1c439fd29c10",
                                "text": "„Er war an der Rettung zweier Seeleute eines gekenterten Frachters beteiligt - für andere Crewmitglieder kam die Rettungsaktion des royalen Hubschrauberpiloten allerdings zu spät.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
