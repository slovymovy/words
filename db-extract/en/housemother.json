                "entry_id": "76402187-ad62-39d5-954f-89324a7f08a3",
                "word": "housemother",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "3bdd360a-a2dd-4243-96f5-8fd7e9f4ef8c",
                        "entry_id": "76402187-ad62-39d5-954f-89324a7f08a3",
                        "tags": [
                            "plural"
                        ],
                        "form": "housemothers"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "40b4b04f-5e82-3665-afd8-cdd12debcd6e",
                        "entry_id": "76402187-ad62-39d5-954f-89324a7f08a3",
                        "glosses": [
                            "The mother of a family; the female head of household, or of any collection of persons living as a family or in common, as in a primitive community."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4048cc8-62cc-428d-b1a9-c7c43cfbda13",
                                "sense_id": "40b4b04f-5e82-3665-afd8-cdd12debcd6e",
                                "text": "At length, the aged house-mother died, or rather slept away into the other world, without pain or sickness, from absolute decay; leaving her solitary partner to mourn her loss, and with an unfeigned longing to join her in the grave."
                            }
                        ]
                    },
                    {
                        "sense_id": "26feec8d-0ccc-389e-a7ea-eeeb5b892d06",
                        "entry_id": "76402187-ad62-39d5-954f-89324a7f08a3",
                        "glosses": [
                            "A woman in charge of a residence for young people to look after them."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ace0364d-ac98-456f-82c0-7f4ed2f98170",
                        "source_entry_id": "76402187-ad62-39d5-954f-89324a7f08a3",
                        "source_sense_description": "mother of a family; the female head of household",
                        "target_lang_word": "Hausmutter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hausmutter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "55a51777-a17c-3b01-b013-679854f5f371",
                                        "entry_id": "06bedec1-e75f-372d-87c6-6b7bd0678d97",
                                        "glosses": [
                                            "Nachtfalter aus der Familie der Eulenfalter"
                                        ],
                                        "tags": [
                                            "Entomologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1658cb0b-cbed-4570-bf55-64108dbc11be",
                                                "sense_id": "55a51777-a17c-3b01-b013-679854f5f371",
                                                "text": "Die Hausmutter ist ein recht häufiger Nachtfalter."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "137e6a00-b587-3778-8b01-98bea38ef531",
                                        "entry_id": "06bedec1-e75f-372d-87c6-6b7bd0678d97",
                                        "glosses": [
                                            "Familienmutter, die als Hausfrau tätig ist"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "45467dc8-bb52-4f45-a534-0883de9ba5c5",
                                                "sense_id": "137e6a00-b587-3778-8b01-98bea38ef531",
                                                "text": "Meine Oma war Hausmutter und hatte nie eine berufliche Anstellung."
                                            },
                                            {
                                                "example_id": "3343cedf-109b-4378-b786-6f27a68f9c57",
                                                "sense_id": "137e6a00-b587-3778-8b01-98bea38ef531",
                                                "text": "„Er stellte mich seiner Frau vor, die, wie ich wußte, mit Donna Lucrezia eng befreundet war; sie war eine gute Hausmutter und hatte Kinder, die noch ganz klein waren.“"
                                            },
                                            {
                                                "example_id": "4bf2ea1c-e946-47b7-a23f-2ad557efbe3b",
                                                "sense_id": "137e6a00-b587-3778-8b01-98bea38ef531",
                                                "text": "„Die Hausmutter lud uns ein, bei ihr Kaffee zu trinken, aber viele, darunter ich, sagten, wir müßten rasch nach Haus; einige sagten, sie hätten nicht einmal Zeit gehabt, sich nach der Arbeit zu waschen; und es war spät.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "18ce3a21-12d2-3e6c-bbd3-5ae429e5bd38",
                                        "entry_id": "06bedec1-e75f-372d-87c6-6b7bd0678d97",
                                        "glosses": [
                                            "weibliche Person, die eine Jugendherberge oder Ähnliches leitet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c520012d-59f4-4e15-bdc7-eadb17702361",
                                                "sense_id": "18ce3a21-12d2-3e6c-bbd3-5ae429e5bd38",
                                                "text": "Von der Hausmutter wurden heute die Regeln aufgestellt."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3c7d7d6a-56b0-4421-b8d3-7c1dc8f00f89",
                        "source_entry_id": "76402187-ad62-39d5-954f-89324a7f08a3",
                        "source_sense_description": "woman in charge of a residence for young people",
                        "target_lang_word": "surveillante",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "surveillante",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6608e8b0-ed98-3943-b1cc-68de7925acf0",
                                        "entry_id": "2ce8ce6d-eb9a-3240-9b1c-f516eccc2207",
                                        "glosses": [
                                            "Personne qui surveille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "029c9033-7669-4f28-8a80-68a7dce57fe7",
                                                "sense_id": "6608e8b0-ed98-3943-b1cc-68de7925acf0",
                                                "text": "Il faut leur donner une bonne surveillante."
                                            },
                                            {
                                                "example_id": "002de390-a7dc-427f-846a-255d6d6faa91",
                                                "sense_id": "6608e8b0-ed98-3943-b1cc-68de7925acf0",
                                                "text": "[…] la surveillante, madame Cabin, frappa et lui donna une lettre, d’un air de mystère."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f48ca9f-1ed2-393a-aa74-d0a8822317b0",
                                        "entry_id": "2ce8ce6d-eb9a-3240-9b1c-f516eccc2207",
                                        "glosses": [
                                            "Femme chargée de la surveillance des détenus dans une prison."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "59777935-da9b-4d58-a729-10590dc39795",
                                                "sense_id": "5f48ca9f-1ed2-393a-aa74-d0a8822317b0",
                                                "text": "J’ai entendu la surveillante qui t’a engueulée hier parce que tu chantais."
                                            },
                                            {
                                                "example_id": "1d02d4a4-34c7-45fa-b16a-d0a63c61e4ca",
                                                "sense_id": "5f48ca9f-1ed2-393a-aa74-d0a8822317b0",
                                                "text": "Oui, il y a des surveillantes femmes dans les prisons pour hommes, mais aussi des hommes dans les prisons pour femmes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ec9c67e-1371-3bc6-9d0b-fd8ccc2ab765",
                                        "entry_id": "2ce8ce6d-eb9a-3240-9b1c-f516eccc2207",
                                        "glosses": [
                                            "Femme chargée de la surveillance des élèves pendant les études, les récréations et les promenades."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "note": "En général, ce sont elles, ainsi que leurs homologues masculins, qui assurent les fameuses \"heures de colles\", gèrent les absences, les retards en cours",
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
