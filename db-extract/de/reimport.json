                "senses": [
                    {
                        "sense_id": "4c382db7-bc77-3075-a61c-a0899d0a8259",
                        "entry_id": "b99fb65e-b5f2-398a-b5a1-66c219e28ddb",
                        "glosses": [
                            "Ware, die im Exportland des Herstellers günstig erworben und durch den Käufer wieder ins Produktionsland eingeführt wird, der Vorgang des Wiedereinführens derartiger Produkte"
                        ],
                        "tags": [
                            "auch"
                        ],
                        "examples": [
                            {
                                "example_id": "34ee3faf-ca23-4083-9e92-5da9f0593b7b",
                                "sense_id": "4c382db7-bc77-3075-a61c-a0899d0a8259",
                                "text": "„Reimporte sind Arzneimittel, die in Deutschland für den ausländischen Markt hergestellt werden, dann exportiert und wieder importiert werden.“"
                            },
                            {
                                "example_id": "75741a84-655b-466e-a32e-7e924bd7dde0",
                                "sense_id": "4c382db7-bc77-3075-a61c-a0899d0a8259",
                                "text": "„Die vorliegenden Fälle zeigen, dass Reimporte und Parallelimporte ein Einfallstor für Arzneimittelfälschungen sind.“"
                            },
                            {
                                "example_id": "0c12b82e-2819-4127-99ae-15a6780501cc",
                                "sense_id": "4c382db7-bc77-3075-a61c-a0899d0a8259",
                                "text": "„Aber auch in Deutschland wäre die Preisbindung damit im höchsten Maße gefährdet, weil innerhalb des deutschen Sprachraums Reimporte in der Praxis nicht zu verhindern wären.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
