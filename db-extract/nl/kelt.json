                                    {
                                        "sense_id": "254129ac-da46-3c3f-bf36-33ab6f2d6621",
                                        "entry_id": "f71a193c-0c50-3683-902f-11634b865abe",
                                        "glosses": [
                                            "członek grupy ludów indoeuropejskich wywodzących się z środkowej Europy"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc17738f-92ba-4c17-b9d5-4e969aa34298",
                                                "sense_id": "254129ac-da46-3c3f-bf36-33ab6f2d6621",
                                                "text": "Poziom cywilizacyjny Celtów w połowie tysiąclecia nie odbiegał od poziomu prawie wszystkich – bo poza Grekami – ludów mieszkających na europejskich wybrzeżach Morza Śródziemnego. Dopiero później narosły dysproporcje."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d07802d3-ee37-40aa-83c7-7c7b0f078ddd",
                        "source_entry_id": "266fd899-9aad-366a-8639-37b2d2d0b534",
                        "source_sense_id": "ac3fcca8-b755-348a-a274-6add1bce6e09",
