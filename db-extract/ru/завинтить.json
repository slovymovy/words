                        "source_sense_id": "f796e761-a4b6-34bb-90e0-e796ab708b62",
                        "target_lang_word": "visser",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "visser",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "44b02b06-3931-3df7-8172-7a824a950a2a",
                                        "entry_id": "49231b13-d43b-36df-b52a-64f5f5b12b25",
                                        "glosses": [
                                            "Attacher, fixer avec des vis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "98b33e41-e78f-41a9-b1e6-4722cd8151a9",
                                                "sense_id": "44b02b06-3931-3df7-8172-7a824a950a2a",
                                                "text": "Il ne faut pas clouer cette ferrure, vous feriez éclater le bois ; il vaut mieux la visser."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "84063909-1131-36ce-a23a-91b82e1a9866",
                                        "entry_id": "49231b13-d43b-36df-b52a-64f5f5b12b25",
                                        "glosses": [
                                            "Fixer à quelque chose, fermer, clore, par un ustensile qui est terminé en vis, ou est creusé en manière d’écrou et qu’on tourne comme une vis."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "711046d2-2fd9-471b-b540-59dde051ccff",
                                                "sense_id": "84063909-1131-36ce-a23a-91b82e1a9866",
                                                "text": "Visser le couvercle d’un étui, le bouchon d’un flacon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1833a941-cb5d-3e6e-95fe-396ddddecc11",
                                        "entry_id": "49231b13-d43b-36df-b52a-64f5f5b12b25",
                                        "glosses": [
                                            "Fixer de manière qui la fait sembler inamovible une personne dans un lieu."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "ironic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e2a6184-5c6c-4978-a98b-d4a2751ac390",
                                                "sense_id": "1833a941-cb5d-3e6e-95fe-396ddddecc11",
                                                "text": "Le notaire, l’imperturbable notaire, […], était, depuis le dîner, comme vissé sur sa chaise."
                                            },
                                            {
                                                "example_id": "574fbe60-b90c-4e8d-95e3-04b05cf32c71",
                                                "sense_id": "1833a941-cb5d-3e6e-95fe-396ddddecc11",
                                                "text": "Puis, d'autorité, il apporte une piste de 421. Vissés au zinc, les deux vieux compères poursuivent leur conversation."
                                            },
                                            {
                                                "example_id": "c9fcd89f-4d1d-4666-9118-cc1a8e8f5e81",
                                                "sense_id": "1833a941-cb5d-3e6e-95fe-396ddddecc11",
                                                "text": "Dites, vous m'écoutez quand je parle ! Je me retins de justesse de jurer, car non content de me tenir des propos sibyllins, il était vissé devant l'écran de son ordinateur, attitude que je trouvais particulièrement mufle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0db72928-0d0f-3c6e-94f5-9c140b9663ae",
                                        "entry_id": "49231b13-d43b-36df-b52a-64f5f5b12b25",
                                        "glosses": [
                                            "Traiter avec rigueur, serrer la vis."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a62d2172-9dcc-4b06-8beb-35de52e68e18",
                                                "sense_id": "0db72928-0d0f-3c6e-94f5-9c140b9663ae",
                                                "text": "Ce gamin fait n’importe quoi, il a besoin d’être vissé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "06046f0c-120c-3da3-89d9-67c3ff1b2adf",
                                        "entry_id": "49231b13-d43b-36df-b52a-64f5f5b12b25",
                                        "glosses": [
                                            "Effectuer un panoramique horizontal avec une caméra dans le sens horaire."
                                        ],
                                        "tags": [
                                            "Audiovisuel"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7bdbff15-f72b-3260-9815-fe96562624d4",
                                        "entry_id": "49231b13-d43b-36df-b52a-64f5f5b12b25",
                                        "glosses": [
                                            "(Verlan) Viens du verlan de servir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8a6efce-ece1-4af6-9ca6-6fcbf3e3b1e0",
                                                "sense_id": "7bdbff15-f72b-3260-9815-fe96562624d4",
                                                "text": "Je vie je visser\nPNL ici dealer"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "visser",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4e4f454a-a947-3182-b5a5-1fe60bf28a22",
                                        "entry_id": "2ac88c59-4c22-3aa7-af88-658dbe7ff643",
                                        "glosses": [
                                            "Servir."
                                        ],
                                        "tags": [
                                            "verlan"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d14159a2-ff13-39d4-bf2c-bbeace5b1346",
                                        "entry_id": "2ac88c59-4c22-3aa7-af88-658dbe7ff643",
                                        "glosses": [
                                            "Vendre de la drogue."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1756c982-b877-4883-8d0c-ed3c16646d71",
                                                "sense_id": "d14159a2-ff13-39d4-bf2c-bbeace5b1346",
                                                "text": "On kiffe le ient-cli qui appelle. Je m’endors, bigo qui sonne, j’allais visser à n’importe quelle heure."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "214c10e7-63fc-44c2-81f6-072861b59d45",
                        "source_entry_id": "d87a6394-e02c-3938-a195-30029678c46c",
                        "source_sense_id": "f796e761-a4b6-34bb-90e0-e796ab708b62",
                        "target_lang_word": "serrer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "serrer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d04986a0-4f48-3739-869a-9c18069820ee",
                                        "entry_id": "65569505-a071-376e-bc7f-cd909b5a734b",
                                        "glosses": [
                                            "Renfermer, ranger, mettre en lieu sûr, à l’abri."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b98cc29-546d-407b-be68-2a176260a3fb",
                                                "sense_id": "d04986a0-4f48-3739-869a-9c18069820ee",
                                                "text": "La moisson estant faite, ce peuple serre son blé dans la terre en des fosses qu’ils font en quelque pendant de colline ou tertre, pour l’égout des eaux, garnissans de nattes icelles fosses : et cela font ils pource qu’ils n’ont point de maisons à étages, ni de coffres pour le serrer autrement : puis, le blé conservé de cette façon est hors la voye des rats et souris."
                                            },
                                            {
                                                "example_id": "2e1689c5-8212-471b-bbfb-dc87c3817705",
                                                "sense_id": "d04986a0-4f48-3739-869a-9c18069820ee",
                                                "text": "Ce nom de Trognon lui fit entrevoir quelque machination, il crut à quelque vice de forme projeté par avance, à quelque infidélité préméditée par la Cibot, et il résolut de se servir de ce Trognon pour se faire dicter un testament olographe qu’il cachèterait et serrerait dans le tiroir de sa commode."
                                            },
                                            {
                                                "example_id": "cf1cab77-3d4a-48be-870a-c446a0b5930f",
                                                "sense_id": "d04986a0-4f48-3739-869a-9c18069820ee",
                                                "text": "Au moment où ils traversaient cette chambre, madame Magloire serrait l’argenterie dans le placard qui était au chevet du lit."
                                            },
                                            {
                                                "example_id": "f8f547f6-d546-4832-896b-2d15e98c3e29",
                                                "sense_id": "d04986a0-4f48-3739-869a-9c18069820ee",
                                                "text": "Puis, avec un gros soupir, il replia les originaux, les serra dans la poche de côté de son veston et, très soigneusement, les remplaça dans le portefeuille par les copies qu’il avait faites."
                                            },
                                            {
                                                "example_id": "bc378a1a-27ac-46af-b809-191beffb4f33",
                                                "sense_id": "d04986a0-4f48-3739-869a-9c18069820ee",
                                                "text": "Un simple grenier, où, du temps de Jacques, on serrait en hiver les jeux de jardin, et dans lequel deux chambres de domestiques avaient été mansardées."
                                            },
                                            {
                                                "example_id": "a5ec9058-e5c9-4f03-9ad8-72023addb0c7",
                                                "sense_id": "d04986a0-4f48-3739-869a-9c18069820ee",
                                                "text": "C’était une assez grande pièce, au rez-de-chaussée, toujours fermée à clef, où on serrait les provisions et où il y avait une immense glacière de boucher que les patrons avaient achetée à une vente."
                                            },
                                            {
                                                "example_id": "0f975f4d-ee84-4648-b92e-b2506d02043e",
                                                "sense_id": "d04986a0-4f48-3739-869a-9c18069820ee",
                                                "text": "Elle emploie seulement… c’est rare… certains mots qui ont un air vieillot… comme « serrer » pour « ranger »… « Serre cela dans le tiroir de la commode »…"
                                            },
                                            {
                                                "example_id": "151cbf28-847b-47a4-a354-b8fb6ab774fa",
                                                "sense_id": "d04986a0-4f48-3739-869a-9c18069820ee",
                                                "text": "Il touchait sa paie chaque soir et chaque fois je craignais qu’en serrant son argent dans sa bourse il ne nous annonçât qu’il ne reviendrait pas le lendemain."
                                            },
                                            {
                                                "example_id": "d7b0ad42-83ae-480f-b45e-079f7a08bc44",
                                                "sense_id": "d04986a0-4f48-3739-869a-9c18069820ee",
                                                "text": "Heureux en ménage, il n’avait jamais trouvé dans le lit conjugal ces débauches de soie et de coloris chantants, dont il raffolait pourtant, et que la divine créature devait serrer dans sa garde-robe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4239a7a8-5ffa-3cf7-a0cf-af53f6eab4e5",
                                        "entry_id": "65569505-a071-376e-bc7f-cd909b5a734b",
                                        "glosses": [
                                            "Étreindre ; presser."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea0454e2-3c56-458a-ba69-e5f8b17dd5b3",
                                                "sense_id": "4239a7a8-5ffa-3cf7-a0cf-af53f6eab4e5",
                                                "text": "Ces souliers sont trop étroits : ils me serrent. Cette robe serre un peu au niveau du ventre."
                                            },
                                            {
                                                "example_id": "33bcf3fa-19cb-435c-9f4c-b4f925f323ad",
                                                "sense_id": "4239a7a8-5ffa-3cf7-a0cf-af53f6eab4e5",
                                                "text": "Vous serrez trop fort."
                                            },
                                            {
                                                "example_id": "fcd56ceb-5fe0-40dc-ba83-7cf793953d82",
                                                "sense_id": "4239a7a8-5ffa-3cf7-a0cf-af53f6eab4e5",
                                                "text": "Ne serrez pas."
                                            },
                                            {
                                                "example_id": "53481fb7-4925-442a-b0f2-1bdb88421a59",
                                                "sense_id": "4239a7a8-5ffa-3cf7-a0cf-af53f6eab4e5",
                                                "text": "Serrer la main à quelqu’un."
                                            },
                                            {
                                                "example_id": "1ad188e1-a668-4308-8ade-cba5ac5de6e4",
                                                "sense_id": "4239a7a8-5ffa-3cf7-a0cf-af53f6eab4e5",
                                                "text": "Je l’ai serré dans mes bras, contre mon cœur."
                                            },
                                            {
                                                "example_id": "fecbc04b-df1c-431d-a179-5383c3bc8ad5",
                                                "sense_id": "4239a7a8-5ffa-3cf7-a0cf-af53f6eab4e5",
                                                "text": "Les sables sont les matières que l’on mélange le plus habituellement à la chaux pour former les mortiers ; ils doivent être rudes au toucher et crier quand on les serre dans la main."
                                            },
                                            {
                                                "example_id": "c7786d1d-ec7e-4d19-a5bd-c810e7d0db8c",
                                                "sense_id": "4239a7a8-5ffa-3cf7-a0cf-af53f6eab4e5",
                                                "text": "C’est un vieil homme debout à l’arrière d'un bateau. Il serre dans ses bras une valise légère et un nouveau-né, plus léger encore que la valise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a97ddb8c-2106-3ab3-8a37-b5b80ab2117a",
                                        "entry_id": "65569505-a071-376e-bc7f-cd909b5a734b",
                                        "glosses": [
                                            "Mettre près l’un de l’autre, rapprocher étroitement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72f4b02b-b92a-463f-974b-d021cc98b7a6",
                                                "sense_id": "a97ddb8c-2106-3ab3-8a37-b5b80ab2117a",
                                                "text": "Nous sommes trop serrés à cette table."
                                            },
                                            {
                                                "example_id": "a9421400-0271-43de-9470-d7d5a34c4b40",
                                                "sense_id": "a97ddb8c-2106-3ab3-8a37-b5b80ab2117a",
                                                "text": "Reculez-vous un peu, nous serons moins serrés."
                                            },
                                            {
                                                "example_id": "f27fd351-b50b-4ed9-95b3-0ae080082235",
                                                "sense_id": "a97ddb8c-2106-3ab3-8a37-b5b80ab2117a",
                                                "text": "Serrez-vous les uns contre les autres."
                                            },
                                            {
                                                "example_id": "49a4f44f-92bc-4e43-bb82-f7cccebb0793",
                                                "sense_id": "a97ddb8c-2106-3ab3-8a37-b5b80ab2117a",
                                                "text": "Il faut nous serrer davantage."
                                            },
                                            {
                                                "example_id": "2918dcc0-8d07-4e67-9a22-d8fe88d9d21f",
                                                "sense_id": "a97ddb8c-2106-3ab3-8a37-b5b80ab2117a",
                                                "text": "Serrer les dents"
                                            },
                                            {
                                                "example_id": "6a2c5d0c-cc7d-41a7-b1b4-4124dac826c3",
                                                "sense_id": "a97ddb8c-2106-3ab3-8a37-b5b80ab2117a",
                                                "text": "Serrer son écriture"
                                            },
                                            {
                                                "example_id": "4ffe044a-6897-4aff-abe4-d1fb6b3da505",
                                                "sense_id": "a97ddb8c-2106-3ab3-8a37-b5b80ab2117a",
                                                "text": "Votre écriture est trop lâche, serrez-la davantage."
                                            },
                                            {
                                                "example_id": "c094b84a-d370-4e0f-a03f-eb3fe14be166",
                                                "sense_id": "a97ddb8c-2106-3ab3-8a37-b5b80ab2117a",
                                                "text": "Serrez davantage vos lignes."
                                            },
                                            {
                                                "example_id": "1df2e2aa-e73e-4ce0-afc2-d2132da275d2",
                                                "sense_id": "a97ddb8c-2106-3ab3-8a37-b5b80ab2117a",
                                                "text": "Il parlait très vite et très petit, comme écrivent certaines personnes, en serrant les mots."
                                            },
                                            {
                                                "example_id": "f943e1fa-567b-45e1-900e-3fe4dce037ef",
                                                "sense_id": "a97ddb8c-2106-3ab3-8a37-b5b80ab2117a",
                                                "text": "Serrer son style"
                                            },
                                            {
                                                "example_id": "a01ca2d8-96fa-4d6d-b473-d1fa70bfea7e",
                                                "sense_id": "a97ddb8c-2106-3ab3-8a37-b5b80ab2117a",
                                                "text": "Serrez !"
                                            },
                                            {
                                                "example_id": "d3b90e40-c660-4d63-8ffd-83472e668cc0",
                                                "sense_id": "a97ddb8c-2106-3ab3-8a37-b5b80ab2117a",
                                                "text": "Se serrer contre le mur"
                                            },
                                            {
                                                "example_id": "7fea95c9-202b-422b-affc-a5abf53e7b92",
                                                "sense_id": "a97ddb8c-2106-3ab3-8a37-b5b80ab2117a",
                                                "text": "Serrer la muraille"
                                            },
                                            {
                                                "example_id": "6d28bb29-ff75-4abe-8600-011d7050b62b",
                                                "sense_id": "a97ddb8c-2106-3ab3-8a37-b5b80ab2117a",
                                                "text": "Serrer quelqu’un de près"
                                            },
                                            {
                                                "example_id": "5c31423c-e265-460e-80aa-5691c417e974",
                                                "sense_id": "a97ddb8c-2106-3ab3-8a37-b5b80ab2117a",
                                                "text": "Serrer une femme de près"
                                            },
                                            {
                                                "example_id": "d34f8878-afc1-49a2-afb1-5ca29b79909d",
                                                "sense_id": "a97ddb8c-2106-3ab3-8a37-b5b80ab2117a",
                                                "text": "Serrer de près une ville, un fort"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26bba3b9-3a0d-31f7-b46f-117927a49378",
                                        "entry_id": "65569505-a071-376e-bc7f-cd909b5a734b",
                                        "glosses": [
                                            "Oppresser."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc5bf226-2984-4469-b175-b3d4bb8e286f",
                                                "sense_id": "26bba3b9-3a0d-31f7-b46f-117927a49378",
                                                "text": "Mais les minutes, les quarts d’heure, s’écoulèrent, les heures mêmes, sans qu’il la vît. Alors l’inquiétude commença à le serrer au cœur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be8775a6-aec8-37ca-8360-755aff3373ec",
                                        "entry_id": "65569505-a071-376e-bc7f-cd909b5a734b",
                                        "glosses": [
                                            "Définition manquante ou à compléter. (Ajouter)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5bb36d25-1fde-427f-a336-648c24ac0286",
                                                "sense_id": "be8775a6-aec8-37ca-8360-755aff3373ec",
                                                "text": "Serrer les voiles"
                                            },
                                            {
                                                "example_id": "3ca04024-9e69-4e69-ae85-0f590d705194",
                                                "sense_id": "be8775a6-aec8-37ca-8360-755aff3373ec",
                                                "text": "Serrer la terre"
                                            },
                                            {
                                                "example_id": "984583ea-b985-4477-9af3-7808b86c805b",
                                                "sense_id": "be8775a6-aec8-37ca-8360-755aff3373ec",
                                                "text": "Serrer la ligne"
                                            },
                                            {
                                                "example_id": "06ac0397-1a9b-4855-b392-e4e31fe6cdbe",
                                                "sense_id": "be8775a6-aec8-37ca-8360-755aff3373ec",
                                                "text": "Chaque vaisseau doit serrer sur son matelot d’avant, pour empêcher l’ennemi de couper la ligne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "19eb2b9c-7635-3511-bf92-d190f8e85a98",
                                        "entry_id": "65569505-a071-376e-bc7f-cd909b5a734b",
                                        "glosses": [
                                            "Replier et ranger une voile sur sa vergue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "adb4307a-7f8f-4be9-9713-4dbffd3c21e1",
                                                "sense_id": "19eb2b9c-7635-3511-bf92-d190f8e85a98",
                                                "text": "Le grand hunier, tendu sous l’effort du vent, eût contrarié le dégagement du navire. Il fallut le serrer, ce qui se fit tant bien que mal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b0f18897-5be3-3eb5-801d-20617829cf1b",
                                        "entry_id": "65569505-a071-376e-bc7f-cd909b5a734b",
                                        "glosses": [
                                            "Ranger."
                                        ],
                                        "tags": [
                                            "Régionalisme",
                                            "Poitou"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2593ba78-478e-358a-922f-14dcb3e9313e",
                                        "entry_id": "65569505-a071-376e-bc7f-cd909b5a734b",
                                        "glosses": [
                                            "Perdre son sang froid, son calme, faire n’importe quoi (référence au moteur qui serre lorsqu’il n’y a plus d’huile, serrer désigne la personne qui ne se maîtrise plus, par sa conduite ou ses paroles)."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "96ddd83a-ab15-4c04-a2da-0c56160327d6",
                                                "sense_id": "2593ba78-478e-358a-922f-14dcb3e9313e",
                                                "text": "« Faut qu’il arrête de rester enfermé chez lui à jouer à la PS3, il va finir par serrer ! »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "182ace9f-d6e8-32cb-bcc8-2a6c0e234f27",
                                        "entry_id": "65569505-a071-376e-bc7f-cd909b5a734b",
                                        "glosses": [
                                            "Séduire, réussir à sortir avec quelqu’un, à flirter, etc."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a300858d-4b14-4098-97af-ecd98052f5bc",
                                                "sense_id": "182ace9f-d6e8-32cb-bcc8-2a6c0e234f27",
                                                "text": "Cyril s’était battu, le cousin était resté pour serrer une meuf et Lyas était rentré."
                                            },
                                            {
                                                "example_id": "31dcbd7c-08d5-4660-a2f3-016af374779e",
                                                "sense_id": "182ace9f-d6e8-32cb-bcc8-2a6c0e234f27",
                                                "text": "[…] un conseil ouvre les rideaux, éteins ta ps3 et sors dehors te serrer des meufs […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "68d2f8ef-2378-3f6b-9dd5-85dcc0191ae1",
                                        "entry_id": "65569505-a071-376e-bc7f-cd909b5a734b",
                                        "glosses": [
                                            "Attraper ; interpeller."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "35603134-8eb1-45d4-934f-dbbe6fcc1f6e",
                                                "sense_id": "68d2f8ef-2378-3f6b-9dd5-85dcc0191ae1",
                                                "text": "Je vous retrouverai les sommes volées chez M. et Mme Crottat ; je vous serre marron un des agents de Bibi-Lupin, son bras droit, et je vous donnerai le secret du crime commis à Nanterre…"
                                            },
                                            {
                                                "example_id": "c8648c90-f76d-4ab7-80f0-d46e78f164f3",
                                                "sense_id": "68d2f8ef-2378-3f6b-9dd5-85dcc0191ae1",
                                                "text": "Les témoignages relatifs à cet incident sont assez différents et, à part le flic qui les a serrés, les protagonistes de cette affaire se sont montrés plutôt énigmatiques."
                                            },
                                            {
                                                "example_id": "8dd8e3da-5a71-4dca-8f6a-0239ea56361d",
                                                "sense_id": "68d2f8ef-2378-3f6b-9dd5-85dcc0191ae1",
                                                "text": "La plus cruelle injure qu’une fille puisse jeter au front déshonoré d’une autre fille, c’est de l’accuser d’infidélité envers un amant serré (mis en prison)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "acbac867-7468-31f4-8389-2af6739fb40b",
                                        "entry_id": "65569505-a071-376e-bc7f-cd909b5a734b",
                                        "glosses": [
                                            "Diminuer l’angle de champ d’une prise de vue ou d’un plan."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "59078aaf-fe4e-4d66-a3dc-e4617753e47b",
                                                "sense_id": "acbac867-7468-31f4-8389-2af6739fb40b",
                                                "text": "La caméra serre la scène au plus près."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b7717ffb-c001-3fb8-b6a2-0f1ac668b5eb",
                                        "entry_id": "65569505-a071-376e-bc7f-cd909b5a734b",
                                        "glosses": [
                                            "Économiser, épargner, se restreindre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67823905-b7c8-45cc-b130-dc091e8cf9e0",
                                                "sense_id": "b7717ffb-c001-3fb8-b6a2-0f1ac668b5eb",
                                                "text": "« L'hôtel me reviendrait trop cher : je ne suis pas riche, je dois serrer. »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
