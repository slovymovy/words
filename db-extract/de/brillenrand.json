                "senses": [
                    {
                        "sense_id": "d1fa8500-6699-321b-9507-73725e0b25b4",
                        "entry_id": "190dd51e-a311-3589-9add-780ed266f1b6",
                        "glosses": [
                            "Kante/äußere Begrenzung um die Gläser einer Brille"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c900cfc-1d24-4fd2-ab7c-341dce09933a",
                                "sense_id": "d1fa8500-6699-321b-9507-73725e0b25b4",
                                "text": "„Den Kenner erkennt der Händler - am flüchtigen Spähen über den Brillenrand, weniger am prall gefüllten Portemonnaie.“"
                            },
                            {
                                "example_id": "d9bf7a64-f9f9-4e52-8620-37188169af15",
                                "sense_id": "d1fa8500-6699-321b-9507-73725e0b25b4",
                                "text": "[Sonnenbrillen:] „Ideal ist, wenn der obere Brillenrand bis zu den Augenbrauen geht.“"
                            },
                            {
                                "example_id": "18686690-bee9-4fb4-9474-9dfecfde3d43",
                                "sense_id": "d1fa8500-6699-321b-9507-73725e0b25b4",
                                "text": "„Er wirft einen Blick über den randlosen Brillenrand zu seinen Assistenten, die fleißig alles mitschreiben.“"
                            },
                            {
                                "example_id": "6e978d5a-932b-46ea-adfb-62a8dcf14a4b",
                                "sense_id": "d1fa8500-6699-321b-9507-73725e0b25b4",
                                "text": "„Ein roter Brillenrand blitzt über ihren Augen.“"
                            },
                            {
                                "example_id": "50cc4769-95ca-4580-83f6-1cdc55bb306b",
                                "sense_id": "d1fa8500-6699-321b-9507-73725e0b25b4",
                                "text": "„Die schwarzen Brillenränder gaben seinen auseinanderlaufenden Pupillen, wie die Bilderrahmen seinen verrückten Bildgestalten, etwas äußere Ordnung.“"
                            },
                            {
                                "example_id": "9780b9e0-946f-4c72-b89d-2b691bcbabf1",
                                "sense_id": "d1fa8500-6699-321b-9507-73725e0b25b4",
                                "text": "„»Ich habe keine schlechten Erfahrungen gemacht. Im Gegenteil, ich habe einen großen deutschen Bekanntenkreis«, lächelt Konopek und seine Augen glänzen dabei hinter dem goldenen Brillenrand:“ […]."
                            },
                            {
                                "example_id": "528cf16b-0541-4daf-9354-0c3a092ff031",
                                "sense_id": "d1fa8500-6699-321b-9507-73725e0b25b4",
                                "text": "[Coronapandemie 2020:] „Mit diesen Tipps behalten Sie klare Sicht: Maskenrand unter den Brillenrand schieben. Dann kommt nicht so viel Atemluft an die Gläser.“ […]"
                            },
                            {
                                "example_id": "3c40752d-0fa1-4851-995a-344c383beb54",
                                "sense_id": "d1fa8500-6699-321b-9507-73725e0b25b4",
                                "text": "[…] „Forscher der Carnegie Mellon University haben im vergangenen Jahr Gesichtserkennung allein durch bunte Brillen überlistet. Und noch mehr: Druckten die Forscher Merkmale anderer Personen auf den ziemlich dicken Brillenrand, konnten sie der Software vortäuschen, eben jene Person zu sein.“"
                            },
                            {
                                "example_id": "1f5d72a2-19f3-4617-a913-0719e3737e50",
                                "sense_id": "d1fa8500-6699-321b-9507-73725e0b25b4",
                                "text": "„Wenn Churchill am Ende des Films über seinen Brillenrand hinweg in die Kamera blickt und der Nation via Radio Mut zuspricht, dann spürt man einen Moment lang die Magie, die «the greatest Briton ever», den grössten Briten überhaupt, ausgemacht haben muss.“"
                            },
                            {
                                "example_id": "02f882b3-649e-4595-97f5-8032ee59aea4",
                                "sense_id": "d1fa8500-6699-321b-9507-73725e0b25b4",
                                "text": "„Es begann vor 22 Jahren in einem weißen Raum, in dessen Mitte Cruise an einem Seil hing, weil jeder Kontakt mit dem Boden einen Alarm auslösen würde. Unvergessen die Schweißperle, die sich am Brillenrand bildete (und herabzutropfen drohte), während Cruise nur Zentimeter über dem Boden seine Balance zu halten versuchte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
