                "senses": [
                    {
                        "sense_id": "b56dc65d-5ae8-3b32-8663-d5b5389ebebd",
                        "entry_id": "47503500-da1e-319b-9b30-adfef36b321e",
                        "glosses": [
                            "to exchange glances, to look at each other"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6da221f3-5361-4a4c-b3fb-eccd5daf09d9",
                                "sense_id": "b56dc65d-5ae8-3b32-8663-d5b5389ebebd",
                                "text": "В э́то вре́мя доложи́ли о прие́зде гра́фа Безу́хова. О́ба супру́га перегляну́лись самодово́льною улы́бкой, ка́ждый себе́ припи́сывая честь э́того посеще́ния.",
                                "translation": "Just then Count Bezúkhov was announced. Husband and wife glanced at one another, both smiling with self-satisfaction, and each mentally claiming the honor of this visit.",
                                "english": "Just then Count Bezúkhov was announced. Husband and wife glanced at one another, both smiling with self-satisfaction, and each mentally claiming the honor of this visit."
                            }
                        ]
                    }
                ],
