                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "robber",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dbb5059c-cc85-3826-8c0a-0e1ae8f3ce20",
                                        "entry_id": "70d20428-1604-3379-9e49-31aaac6f36e4",
                                        "glosses": [
                                            "A person who robs."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5968df03-d139-30c6-80d0-6f43f041c071",
                                        "entry_id": "70d20428-1604-3379-9e49-31aaac6f36e4",
                                        "glosses": [
                                            "An animal who robs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e63a14e2-dcd1-4d08-9078-4e4742668bbc",
                                                "sense_id": "5968df03-d139-30c6-80d0-6f43f041c071",
                                                "text": "I remember as a boy in my native land the bad name the common magpie (Pica caudata) had as a destroyer of chickens, and a robber of nests."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f90dd2a0-a4bc-44a9-bf3c-e43e3386f43e",
                        "source_entry_id": "4b76eef8-6454-3ddd-a612-dd6a2028ff80",
                        "source_sense_id": "e42390f6-5d28-3b19-bf29-69c507718189",
                        "target_lang_word": "Räuber",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Räuber",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1ba85373-a4a7-3fab-9aeb-aa9fb1899f88",
                                        "entry_id": "7667820d-d322-3a87-9c39-a9ef51ecbbb6",
                                        "glosses": [
                                            "Person, die einer anderen Person rechtswidrig und unter Androhung oder auch Anwendung von Gewalt etwas wegnimmt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2a3a58a-2fac-4991-baad-a8ccaaddb0d4",
                                                "sense_id": "1ba85373-a4a7-3fab-9aeb-aa9fb1899f88",
                                                "text": "Der Räuber wurde für seine Tat verurteilt."
                                            },
                                            {
                                                "example_id": "ddd64159-dc79-4829-84b0-b9aa94ef905e",
                                                "sense_id": "1ba85373-a4a7-3fab-9aeb-aa9fb1899f88",
                                                "text": "„Damals war auch die Soldatensprache weitgehend identisch mit dem Jargon der Räuber.“"
                                            },
                                            {
                                                "example_id": "d1197242-335c-4446-ad94-90068f63b3f4",
                                                "sense_id": "1ba85373-a4a7-3fab-9aeb-aa9fb1899f88",
                                                "text": "„Am Ende sagt der Karl sich von den Räubern los.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1e5f0953-4434-3f2c-883a-cdd9d236e508",
                                        "entry_id": "7667820d-d322-3a87-9c39-a9ef51ecbbb6",
                                        "glosses": [
                                            "spaßhaft (zu einem Kind) für Schelm, Schlingel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96d96b37-cbe9-492e-9877-73a4b6a22ec8",
                                                "sense_id": "1e5f0953-4434-3f2c-883a-cdd9d236e508",
                                                "text": "Du kleiner Räuber, hast du mich schon wieder hereingelegt?"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
