                        "entry_id": "3b8af2fc-b3d2-3e5b-81cd-ea100422cc9d",
                        "glosses": [
                            "vierde vinger gerekend vanaf de duim, gelegen tussen de pink en de middelvinger, traditioneel bestemd voor het dragen van ringen"
                        ],
                        "tags": [],
