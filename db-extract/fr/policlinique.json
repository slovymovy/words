                    }
                ],
                "senses": [
                    {
                        "sense_id": "506b5746-0bee-35bf-a596-292c1584c25a",
                        "entry_id": "3e8f7615-9d94-3de1-be07-d118c6dea2e8",
                        "glosses": [
                            "Dispensaire de soin, ou service de consultation externe, non prévu pour l’hospitalisation des patients. Littéralement, \\\"clinique de la ville\\\"."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff4fb026-c90f-4e6f-9384-0a9e848df1fa",
                                "sense_id": "506b5746-0bee-35bf-a596-292c1584c25a",
                                "text": "Pas de cuistrerie mais rappel: une policlinique est une clinique de ville et non une clinique à service multiples, c’est-à-dire une polyclinique."
                            }
                        ]
                    },
                    {
                        "sense_id": "fc2b2ea1-208e-393f-a15d-31cd3011a49e",
                        "entry_id": "3e8f7615-9d94-3de1-be07-d118c6dea2e8",
                        "glosses": [
                            "Méthode pédagogique consistant à visiter des patients avec ses étudiants en médecine."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f70235d3-803b-4996-bcb6-5e81e592ac8d",
                        "source_entry_id": "3e8f7615-9d94-3de1-be07-d118c6dea2e8",
                        "target_lang_word": "Poliklinik",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Poliklinik",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d0250022-18ca-3d49-81cc-2e25a21b6685",
                                        "entry_id": "2fa0599b-da06-3ae7-bafd-7e2ee5e8f77f",
                                        "glosses": [
                                            "Krankenhaus, das in der Regel nur ambulante Untersuchung und Behandlung anbietet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "854217ed-9969-4ac6-83fa-69e22d39bcec",
                                                "sense_id": "d0250022-18ca-3d49-81cc-2e25a21b6685",
                                                "text": "Nach der Wiedervereinigung wurden die Polikliniken auf dem Gebiet der ehemaligen DDR geschlossen."
                                            },
                                            {
                                                "example_id": "ff71fa86-a074-4f5c-b9c6-9773664e2f4a",
                                                "sense_id": "d0250022-18ca-3d49-81cc-2e25a21b6685",
                                                "text": "„Für manche praktischen Probleme fand die DDR sogar gute Lösungen. Inzwischen werden sie auch in den alten Bundesländern endlich offener diskutiert und nachgeahmt. Man denke an Kindertagesstätten, Ganztagsschulen und Polikliniken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "82f29a54-b785-3c14-a01e-7e761ae06ccd",
                                        "entry_id": "2fa0599b-da06-3ae7-bafd-7e2ee5e8f77f",
                                        "glosses": [
                                            "Abteilung einer Klinik oder eines Krankenhauses, die in der Regel nur ambulante Untersuchung und Behandlung anbietet"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3fa9b696-7302-4294-ac35-bfdfe9d494c9",
                        "source_entry_id": "3e8f7615-9d94-3de1-be07-d118c6dea2e8",
                        "target_lang_word": "clinic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "clinic",
