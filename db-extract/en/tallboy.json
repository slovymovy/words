                        "examples": [
                            {
                                "example_id": "ec5167b3-cd68-429a-8a99-178afa8e951a",
                                "sense_id": "997c83b2-2746-3deb-8b3b-9cdfa32753a3",
                                "text": "In her post, which was less than a minute long, she said that the company had sent her a tallboy can of Bud Light with her face on it. An image of the can was edited into the video."
