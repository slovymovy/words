                                        "entry_id": "bf9f885f-df63-3393-92f1-94bea0d1d17d",
                                        "glosses": [
                                            "Qui est l’agent d’une sécrétion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90805834-f9f6-4993-8418-fe99378b7c27",
                                                "sense_id": "101f2056-8d3f-36d1-a11c-fcc1ea113032",
                                                "text": "Des expériences analogues ont démontré ultérieurement que les nerfs vagues renferment également des nerfs sécréteurs innervant le pancréas."
                                            }
