                ],
                "senses": [
                    {
                        "sense_id": "9e74303c-b582-3d08-a2d9-666e146ac529",
                        "entry_id": "2a5e09ab-4e15-3d53-a204-951e01c15994",
                        "glosses": [
                            "Menge von Wörtern, die danach bestimmt wird, ob bzw. wie sie flektiert werden können, in welcher syntaktischen Umgebung sie verwendet werden können oder welche Art von Bedeutung sie tragen. Die Wortklassen werden meistens durch eine Kombination mehrerer dieser Kriterien definiert."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85d65d53-ecd4-47a7-a067-55c29603e327",
                                "sense_id": "9e74303c-b582-3d08-a2d9-666e146ac529",
                                "text": "Präpositionen bilden eine Wortklasse."
                            },
                            {
                                "example_id": "0f7fe6d3-504c-4a59-9c33-6061cb0ac05c",
                                "sense_id": "9e74303c-b582-3d08-a2d9-666e146ac529",
                                "text": "„Dies sind solche Eigenschaften eines Wortes, die seine syntaktische Kombinierbarkeit mit anderen Wörtern einschränken, sogenannte syntaktische Selektionsbeschränkungen, beispielsweise das grammatische Genus, die Wortklasse und Subkategorisierungseigenschaften, das heißt Angaben zu syntaktisch notwendigen Ergänzungen.“"
                            },
                            {
                                "example_id": "c27d6c62-f189-4c95-a6a6-75f2f46e5924",
                                "sense_id": "9e74303c-b582-3d08-a2d9-666e146ac529",
                                "text": "„Mit der statistischen Untersuchung von Wortklassen kommen wir schon einen Schritt näher an den Bereich der Sinngehalte sprachlichen Ausdrucks heran.“"
                            },
                            {
                                "example_id": "7df4e9fe-d186-41e3-b7d6-57c666035ed4",
                                "sense_id": "9e74303c-b582-3d08-a2d9-666e146ac529",
                                "text": "„Wie steht es mit den gehaltreicheren Wörtern, insbesondere den drei flektierenden Wortklassen Nomen, Verb und Adjektiv?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c55ec9a4-a05e-373c-a107-391ce332dba0",
                        "entry_id": "2a5e09ab-4e15-3d53-a204-951e01c15994",
                        "glosses": [
                            "Menge von Wörtern, die übereinstimmend bestimmte Eigenschaften aufweisen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32ada9c6-262a-413c-83aa-fb42adc3bca2",
                                "sense_id": "c55ec9a4-a05e-373c-a107-391ce332dba0",
                                "text": "„Die Stichwortauswahl kann von einer angenommenen Höher- oder Minderwertigkeit bestimmter Wörter oder Wortklassen geleitet sein.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
