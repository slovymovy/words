                    }
                ],
                "translations": [
                    {
                        "translation_id": "97a25e0a-4b99-495c-a043-a56b3b72eeed",
                        "source_entry_id": "9cf0bb1c-1839-386c-9928-ac9a8af50e9c",
                        "source_sense_id": "35508d5c-996a-3cdf-a1d1-d8af9aa27a44",
                        "target_lang_word": "Streitwagen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Streitwagen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "81928065-94b8-3a8a-a294-ae6244768929",
                                        "entry_id": "d3b68f84-1d6b-3dfc-a763-a421e3444269",
                                        "glosses": [
                                            "Antike: von Pferden gezogener Wagen, der im Kampf eingesetzt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a08a1578-6b66-4aab-be11-1151023a1205",
                                                "sense_id": "81928065-94b8-3a8a-a294-ae6244768929",
                                                "text": "„Wie bildliche Darstellungen und Grabfunde belegen, waren die hölzernen Streitwagen zweiräderig.“"
                                            },
                                            {
                                                "example_id": "78a8ae38-11bf-4feb-9b95-1307d6e298f7",
                                                "sense_id": "81928065-94b8-3a8a-a294-ae6244768929",
                                                "text": "„Die Mumienabteilung ist das Herz des Ägyptischen Museums, vorher mussten wir an Sphinxen und Göttern vorbei, die entweder keinen Kopf oder keinen Rumpf mehr hatten, aber auch an Nachbauten von Streitwagen, für die ich ein größeres Faible besitze.“"
                                            },
                                            {
                                                "example_id": "250850ef-a327-4212-9b2a-85d518cc2dfd",
                                                "sense_id": "81928065-94b8-3a8a-a294-ae6244768929",
                                                "text": "„Solche Prunkgräber entdeckten die Archäologen im westlichen Europa, als Beigaben fanden sie oft Streitwagen und prächtige Dolche, griechisches Trinkgeschirr, etruskischen Schmuck und goldene Halsringe.“"
                                            },
                                            {
                                                "example_id": "8c09abee-52ea-40d0-867a-87e14872a552",
                                                "sense_id": "81928065-94b8-3a8a-a294-ae6244768929",
                                                "text": "„Aufrecht auf dem Streitwagen stehend, den Speer in der Rechten, verkörpert die Keltenführerin am linken Themeseufer bis heute den Freiheitsdrang der Briten – und die Verklärung der keltischen Frauen.“"
                                            },
                                            {
                                                "example_id": "a564e7fc-4ef1-4b2b-b6b4-af1b0d8586ad",
                                                "sense_id": "81928065-94b8-3a8a-a294-ae6244768929",
                                                "text": "„Ihre Krieger zogen auf schnellen, leichten Streitwagen in den Kampf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7c9cf55a-36f5-41bb-a3d6-3597635bb4a6",
