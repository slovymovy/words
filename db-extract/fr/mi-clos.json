                ],
                "senses": [
                    {
                        "sense_id": "254142c4-9741-3972-8b61-822197878547",
                        "entry_id": "c0021326-d845-3afb-8d80-ef64d0be4564",
                        "glosses": [
                            "Qui est à moitié fermé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f2de583-1f5e-4164-bf26-cbd5aabdcd60",
                                "sense_id": "254142c4-9741-3972-8b61-822197878547",
                                "text": "Fleur, bouche, lèvre mi-close."
                            },
                            {
                                "example_id": "ccf27070-ce8e-48a4-a0be-98c408c3db8e",
                                "sense_id": "254142c4-9741-3972-8b61-822197878547",
                                "text": "L’ardent Lykoréen, l’œil mi-clos de sommeil,\nDe la blonde Thétys touche le sein vermeil."
                            },
                            {
                                "example_id": "07dea823-439a-4de4-bf15-8dcc88cca6c3",
                                "sense_id": "254142c4-9741-3972-8b61-822197878547",
                                "text": "La baronne (…), les paupières mi-closes et les lèvres entr’ouvertes, frissonnait encore de cette ardente et douce étreinte."
                            },
                            {
                                "example_id": "964a59c5-a27c-46c5-b63b-4de7bcadb77d",
                                "sense_id": "254142c4-9741-3972-8b61-822197878547",
                                "text": "Et Maigret le regardait à travers ses cils mi-clos. Cela devenait une manie, chez lui, de faire ainsi de petits yeux.\nOu peut-être cela tenait-il à ce qu’il vivait obstinément dans un rayon de soleil ?"
                            },
                            {
                                "example_id": "987c38b4-8a83-449c-a068-d857f87cebe2",
                                "sense_id": "254142c4-9741-3972-8b61-822197878547",
                                "text": "Le petit jour entre par les volets mi-clos."
                            },
                            {
                                "example_id": "cf8a2447-d324-4a17-96cc-77d10aa2fed3",
                                "sense_id": "254142c4-9741-3972-8b61-822197878547",
                                "text": "Il épie la fille entre ses cils mi-clos."
                            },
                            {
                                "example_id": "8b5786f3-13a0-4300-95ca-62acd8381822",
                                "sense_id": "254142c4-9741-3972-8b61-822197878547",
                                "text": "Le Père Saverio a une voix perçante. Je lui réponds dents serrées et lèvres mi-closes."
                            }
                        ]
                    }
                ],
