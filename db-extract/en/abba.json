                        "entry_id": "16fe8021-ae01-3d77-9b7c-10b4dd776070",
                        "glosses": [
                            "Father, an honorific title given to God in the New Testament, especially used in prayers."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb0af550-a92e-409d-9fdb-c29ba7205118",
                                "sense_id": "7ee461c8-8675-359e-a966-6089d5e5fbfd",
                                "text": "And because yee are sonnes, God hath sent foorth the spirit of his Sonne into your hearts, crying Abba, Father."
                            }
                        ]
                    }
                ],
