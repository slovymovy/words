{
    "word": "patchouli",
    "lang_code": "en",
    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "81b30791-e710-32b8-a361-5a0a4a99ea83",
                "word": "patchouli",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "a6fee628-3fe6-40e0-8941-d63d3a7761b8",
                        "entry_id": "81b30791-e710-32b8-a361-5a0a4a99ea83",
                        "tags": [
                            "plural"
                        ],
                        "form": "patchoulis"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4eaa14b6-ace4-3497-8708-9fc8c1f6b59d",
                        "entry_id": "81b30791-e710-32b8-a361-5a0a4a99ea83",
                        "glosses": [
                            "Any of several East Indian plants in the genus Pogostemon, especially Pogostemon cablin, which yield a highly fragrant oil."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "bb6e19c6-158a-3069-9ecc-b0c1f20eed7f",
                        "entry_id": "81b30791-e710-32b8-a361-5a0a4a99ea83",
                        "glosses": [
                            "The oil or perfume made from these plants."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "4eb9824f-b08e-4291-b6ba-86f3261cae8e",
                                "sense_id": "bb6e19c6-158a-3069-9ecc-b0c1f20eed7f",
                                "text": "Well she looks at you so coolly / And her eyes shine like the moon in the sea / She comes in incense and patchouli"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6ba56bf2-bc52-4de2-89d6-7f54e712c192",
                        "source_entry_id": "81b30791-e710-32b8-a361-5a0a4a99ea83",
                        "source_sense_description": "any of several East Indian plants",
                        "target_lang_word": "patchouli",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "patchouli",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b25d21e1-62bd-31ad-aa8c-d862a3b63b34",
                                        "entry_id": "29e0effb-ff74-3dd3-93d9-77ca891934ca",
                                        "glosses": [
                                            "Nom usuel de Pogostemon cablin, plante herbacée de la famille des Lamiacées originaire d’Inde et du sud del’Asie, remarquable par son odeur aromatique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5a7a0d5-8fac-4ceb-ae59-c2f05c42c1e0",
                                                "sense_id": "b25d21e1-62bd-31ad-aa8c-d862a3b63b34",
                                                "text": "Pastilles de patchouli."
                                            },
                                            {
                                                "example_id": "0c9bee63-4c48-4762-9b5e-10ed86909cc6",
                                                "sense_id": "b25d21e1-62bd-31ad-aa8c-d862a3b63b34",
                                                "text": "Dans l’air moite, dans la fadeur exhalée des cuvettes, traînait par instant une odeur plus aiguë, quelques brins de patchouli sec, brisés menu au fond d’une coupe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e46a06bd-bff4-3736-a520-dda4c073af25",
                                        "entry_id": "29e0effb-ff74-3dd3-93d9-77ca891934ca",
                                        "glosses": [
                                            "Parfum extrait des feuilles et des tiges de cette plante."
                                        ],
                                        "tags": [
                                            "Parfumerie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e17a64f1-2c01-4b13-a16e-7e970488c5d0",
                                                "sense_id": "e46a06bd-bff4-3736-a520-dda4c073af25",
                                                "text": "— Si monsieur le baron entrait dans l’appartement de mademoiselle Mirah, il y trouverait mademoiselle Héloïse Brisetout, monsieur Bixiou, monsieur Léon de Lora, monsieur Lousteau, monsieur de Vernisset, monsieur Stidmann, et des femmes pleines de patchouli qui pendent la crémaillère…"
                                            },
                                            {
                                                "example_id": "ec203b07-83c9-4ccd-ba32-a013b545f0ca",
                                                "sense_id": "e46a06bd-bff4-3736-a520-dda4c073af25",
                                                "text": "Et dans ce salon, tout imprégné des odeurs furieuses de l’ambre et du patchouli, c’était un vacarme, un brouhaha, un tohu-bohu !"
                                            },
                                            {
                                                "example_id": "e1b16847-e9b9-49a3-994e-809f331afda9",
                                                "sense_id": "e46a06bd-bff4-3736-a520-dda4c073af25",
                                                "text": "Elle lui promenait sur les lèvres ses bras nus, sa chair un peu affaissée, luxueusement rehaussée par des odeurs de musc et de patchouli."
                                            },
                                            {
                                                "example_id": "ad53c125-3c23-4354-bbed-fefa3aeba1e0",
                                                "sense_id": "e46a06bd-bff4-3736-a520-dda4c073af25",
                                                "text": "Leurs odeurs de vieux cuir, de patchouli, de peau d’Espagne et de tabac à priser supplantèrent aussitôt les odeurs de notre clan."
                                            },
                                            {
                                                "example_id": "e56306a4-ff72-499a-91d5-e6815d5b8baf",
                                                "sense_id": "e46a06bd-bff4-3736-a520-dda4c073af25",
                                                "text": "Odeur des gaufres, des chaussures chaudes, et le patchouli de vague en vague dont s’est noyé le montreur d’ours, et l’amertume de la poussière pleine de raies comme en ont les palmiers."
                                            },
                                            {
                                                "example_id": "de57c543-0dfb-43d0-a99f-7940d5286c74",
                                                "sense_id": "e46a06bd-bff4-3736-a520-dda4c073af25",
                                                "text": "J'avais beau marcher pieds nus, fumer des Vogue multicolores, me parfumer au patchouli, porter des robes parme sous des gilets fuchsia et des bracelets autour des chevilles, rien n'y faisait : Léa grandissait plus vite que moi."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
