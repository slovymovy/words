                "senses": [
                    {
                        "sense_id": "910ceef1-628a-3e19-8819-ef3ee83dc9ae",
                        "entry_id": "534ad555-bb3e-314d-bc15-708228263d1e",
                        "glosses": [
                            "Travailler au burin en enlevant de la matière."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6afde6b-5767-43ac-b947-527eb2461dda",
                                "sense_id": "910ceef1-628a-3e19-8819-ef3ee83dc9ae",
                                "text": "Il était tout dépoitraillé, obscène, et pourtant j’enviais ce corps dégoûtant, balayé par les derniers feux du dérèglement, ce visage d’aveugle, déburiné par les caresses."
                            },
                            {
                                "example_id": "8b272dd0-a660-4652-acb2-100ad2fc500f",
                                "sense_id": "910ceef1-628a-3e19-8819-ef3ee83dc9ae",
                                "text": "Signe extérieur de mon bien-être mal assumé, le rouge aux joues me déburine l’âme."
                            },
                            {
                                "example_id": "8a489db0-c706-4b4c-ba6f-74022b360ab1",
                                "sense_id": "910ceef1-628a-3e19-8819-ef3ee83dc9ae",
                                "text": "Il a pris les choses à l'envers, partant de son autoportrait déjà réalisé pour l’étioler à petites touches, le déburiner à mort et indéfiniment, jusqu’à la toile crue !"
                            },
                            {
                                "example_id": "9cea0df1-d062-4d94-a219-bee3d3694347",
                                "sense_id": "910ceef1-628a-3e19-8819-ef3ee83dc9ae",
                                "text": "J’ai donc coupé deux longueurs d’alum 0,032 po d’épaisseur que je dois passer au primaire, déburiner et embrêver avant d’installer."
                            },
                            {
                                "example_id": "5f3dae3f-7117-43c2-9a08-49a90c9c30a9",
                                "sense_id": "910ceef1-628a-3e19-8819-ef3ee83dc9ae",
                                "text": "4. DÉBURINER ET ÉLIMINER TOUTES ARÊTES VIVES."
                            }
                        ]
                    }
                ],
