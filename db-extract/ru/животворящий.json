                                            {
                                                "example_id": "150a01f5-06cb-4b5c-8888-db88ce9874e3",
                                                "sense_id": "afa5f44d-099d-3e43-a8fa-e275370bd87a",
                                                "text": "A wtedy życiodajny deszcz przywrócił roślinom siły po długiej suszy."
