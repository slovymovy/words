            "senses": [
                {
                    "sense_id": "f157d964-a8b3-3297-9de0-7e34f7722ea3",
                    "sense_definition": "A muscular organ that pumps blood through the body, traditionally thought to be the seat of emotion.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "organ",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor listened to the patient's <w>heart</w> with a stethoscope.",
                            "target_lang_translations": {
                                "ru": "Врач выслушал <w>сердце</w> пациента стетоскопом."
                            }
                        },
                        {
                            "text": "Regular exercise is very important for maintaining a healthy <w>heart</w>.",
                            "target_lang_translations": {
                                "ru": "Регулярные упражнения очень важны для поддержания здоровья <w>сердца</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "heart rate",
                        "heart attack",
                        "heart beat"
                    ],
                    "target_lang_definitions": {
                        "ru": "Мышечный орган, который перекачивает кровь по телу, традиционно считающийся средоточием чувств."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сердце",
                                "target_lang_sense_clarification": "анатомический орган"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c0dd4c4b-d330-31fc-a635-325c709a4d22",
                    "sense_definition": "A conventional shape or symbol used to represent the heart, love, or emotion: ♥.",
