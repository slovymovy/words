                                "target_senses": [
                                    {
                                        "sense_id": "f88aefc5-3628-388d-a59a-12deaa1652f7",
                                        "entry_id": "e05881e8-860e-3086-a0c2-751b33f0f2c3",
                                        "glosses": [
                                            "Spécialiste de l’immunologie, de l’immunité physiologique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f522a790-6d3d-4992-86f3-4257b6c105ce",
                                                "sense_id": "f88aefc5-3628-388d-a59a-12deaa1652f7",
                                                "text": "Comme immunologiste, impliqué dans la recherche de nouveaux vaccins, j’ai été stupéfait d’apprendre que 800,000 enfants par an mouraient de la rougeole et de ses complications, alors qu’un vaccin efficace et très bon marché existait."
                                            },
                                            {
                                                "example_id": "b9f204b9-1f9d-4801-a4b4-5ad1c5616d8e",
                                                "sense_id": "f88aefc5-3628-388d-a59a-12deaa1652f7",
                                                "text": "L’immunologiste Jean-François Delfraissy a présidé pendant deux ans et demi le Conseil scientifique, qui sera dissous ce dimanche."
                                            },
                                            {
                                                "example_id": "f53ba3b0-4c05-4a2e-a1dd-e7836b28fbf1",
                                                "sense_id": "f88aefc5-3628-388d-a59a-12deaa1652f7",
                                                "text": "En 2019, la revue Santé publique publie un article du docteur Qing Li, immunologiste à l’Université de médecine de Tokyo, auteur de Shinrin Yoku - L’art et la science du bain de forêt (First). — (France Mutuelle Magazine, nᵒ 176, avril-mai-juin 2023, page 28)#* En 2019, la revue Santé publique publie un article du docteur Qing Li, immunologiste à l’Université de médecine de Tokyo, auteur de Shinrin Yoku - L’art et la science du bain de forêt (First)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
