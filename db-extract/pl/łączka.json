                        "translation_id": "f0d87757-d218-4c03-9713-40b423cb9bc7",
                        "source_entry_id": "9d80c461-20ae-3bee-8083-c62790dc9563",
                        "source_sense_id": "da338db4-34b4-3426-8bdd-f7344674a5db",
