                ],
                "senses": [
                    {
                        "sense_id": "83d09397-e488-3398-aace-6c0d8bc1d538",
                        "entry_id": "6d8f9310-9d31-3492-bbdd-4d8384dc5d69",
                        "glosses": [
                            "Donner un caractère asexuel à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ade4877a-0b93-4c05-954d-0772735d94af",
                                "sense_id": "83d09397-e488-3398-aace-6c0d8bc1d538",
                                "text": "Il faut donc isoler l’enfant, « l’asexualiser » et le maintenir dans une totale ignorance de la sexualité."
                            },
                            {
                                "example_id": "e815dcca-e1fa-4cb8-9034-c4439cfe7b10",
                                "sense_id": "83d09397-e488-3398-aace-6c0d8bc1d538",
                                "text": "En somme, il s'agit d'« asexualiser » la société."
                            },
                            {
                                "example_id": "2afcb4aa-4d9d-40e9-8f5d-21df824ee736",
                                "sense_id": "83d09397-e488-3398-aace-6c0d8bc1d538",
                                "text": "La théorie du genre anéantit ces modèles et tend à asexualiser la société."
                            }
                        ]
                    }
