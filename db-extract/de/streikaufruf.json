                        "sense_id": "7ed6fdcb-3802-3d4d-a2c3-2f378e363382",
                        "entry_id": "48bd2085-25ce-372d-a96e-1009c44df204",
                        "glosses": [
                            "Appel à la grève, émanant le plus souvent d’un syndicat."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "445e690e-9d78-4e06-92c7-3c2f0a34601d",
                                "sense_id": "7ed6fdcb-3802-3d4d-a2c3-2f378e363382",
                                "text": "Viele Lehrer sind dem Streikaufruf gefolgt. - Beaucoup d’enseignants ont suivi l’appel à faire grève"
                            },
                            {
                                "example_id": "10761548-f2c0-42b3-9f93-057cd3255f94",
                                "sense_id": "7ed6fdcb-3802-3d4d-a2c3-2f378e363382",
                                "text": "\"Unser Streikaufruf wurde zu 100 Prozent befolgt\", sagte der Sprecher der Gewerkschaft. - Notre appel à la grève a été suivi à 100%, a déclaré le porte-parole du syndicat."
                            }
                        ]
                    }
