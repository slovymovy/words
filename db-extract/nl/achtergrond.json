                                            "An extra who appears in the background, with no speaking role."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "17774c77-240c-3ffa-89af-8451d19e2744",
                                        "entry_id": "c7fad553-9c11-3d64-9ba9-300f31d16817",
                                        "glosses": [
                                            "Information relevant to the current situation about past events; history."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "45f6a9f2-97a0-3060-9d9b-020a9390f86a",
                                        "entry_id": "c7fad553-9c11-3d64-9ba9-300f31d16817",
                                        "glosses": [
                                            "A less important feature of scenery (as opposed to foreground)."
                                        ],
                                        "tags": [
                                            "countable",
