                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette actrice possède une allure singulière et elle a vraiment du <w>chien</w> sur scène."
                        },
                        {
                            "text": "Avec sa nouvelle coupe de cheveux et son manteau sombre, elle a un <w>chien</w> fou."
