                    },
                    {
                        "form_id": "e24f4547-38bf-4f4e-9b54-24087d534722",
                        "entry_id": "b5f39daa-0c3c-3906-a129-f30dc9bd19bc",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Zier"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7e9aa52d-6614-3fbe-8bc7-e547616f34af",
                        "entry_id": "b5f39daa-0c3c-3906-a129-f30dc9bd19bc",
                        "glosses": [
                            "schmückendes Beiwerk"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "0ad16261-072b-4e8c-919d-0f86f1a18da0",
                                "sense_id": "7e9aa52d-6614-3fbe-8bc7-e547616f34af",
                                "text": "„Wenn Sie aber im Job erfolgreich sind und das für sich behalten, ist das keine Zier, sondern Dummheit!“"
                            },
                            {
                                "example_id": "ee229331-c17f-49e1-821e-30b70ea0f35f",
                                "sense_id": "7e9aa52d-6614-3fbe-8bc7-e547616f34af",
                                "text": "„Der Tempel kann z. B. die Zier (im ästhetischen Sinne) der Stadt Jerusalem sein, oder die Zier (im ethischen Sinne = der Stolz, der Ruhm) des Volkes Israel.“"
                            },
                            {
                                "example_id": "09480beb-86de-4b84-9812-d3f3471cf3f6",
                                "sense_id": "7e9aa52d-6614-3fbe-8bc7-e547616f34af",
                                "text": "„‚Bescheidenheit ist eine Zier, doch weiter komm ich ohne ihr‘ – sicher ist Ihnen dieser Spruch auch schon mal eingefallen, wenn Sie wieder den Kürzeren gezogen haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
