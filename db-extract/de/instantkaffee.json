                "senses": [
                    {
                        "sense_id": "0b52f923-f13f-3613-aec8-329ba402559d",
                        "entry_id": "c78a2a37-412e-3041-9137-37c2e583e5b7",
                        "glosses": [
                            "getrockneter Kaffeeextrakt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78481b2c-4c3b-4567-833f-fe7931d4c57f",
                                "sense_id": "0b52f923-f13f-3613-aec8-329ba402559d",
                                "text": "„Eines Nachmittags gegen drei Uhr saß sie mit einem Becher Instantkaffee auf dem Dach, als sie den Klang von Sex aus einer der Wohnungen unter sich heraufdriften hörte.“"
                            },
                            {
                                "example_id": "8133cefd-0137-47a6-8d1f-60786f26d997",
                                "sense_id": "0b52f923-f13f-3613-aec8-329ba402559d",
                                "text": "„Doch bevor er am Abend Chaos und Verwüstung anrichtete, ging Gentry erst einmal in einen Supermarkt, um sich mit Bohnen, Softdrinks, Instantkaffee und Wasser einzudecken.“"
                            },
                            {
                                "example_id": "6554f0cd-398f-412c-80db-3973c998a2dc",
                                "sense_id": "0b52f923-f13f-3613-aec8-329ba402559d",
                                "text": "„Da war nichts als seine Decke, der Futon und das Kissen, die er auf dem Markt im Viertel gekauft hatte, der niedrige Tisch, der schon beim Einzug da gewesen war, ein elektrischer Wasserkocher, mit dem er Nudelsuppe und Instantkaffee aufbrühen konnte, und eine einzelne Tasche mit Kleidern aus der Stadt.“"
                            },
                            {
                                "example_id": "944d586c-fc6c-4e24-8dc1-a8bf6f3a548f",
                                "sense_id": "0b52f923-f13f-3613-aec8-329ba402559d",
                                "text": "„Im Sucher von Agent Plaudertasches Videokamera schaufelte sich der Killerkoch mit einem Löffel triefend grünes Spinatsoufflé ins Gesicht und sagte: ›Ich bin Koch von Beruf. Ich bin kein Restaurantkritiker. Aber drei Monate Instantkaffee halt ich nicht aus ...‹“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
