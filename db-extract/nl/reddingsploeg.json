                        "entry_id": "c2fc4eef-4ec3-39ee-b7e6-698c3f05f1c8",
                        "glosses": [
                            "team van mensen met de taak slachtoffers of belangrijke zaken uit een noodsituatie te halen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f50bbd0-10dd-4933-86b3-ae522b0406f1",
                                "sense_id": "5bfbd5e0-ade4-36ae-a589-f41cc79e8d6b",
                                "text": "De helikopter stortte woensdagavond neer in de Ionische Zee tussen Griekenland en Italië. Er is een veld van wrakstukken gevonden. Reddingsploegen zoeken nog naar overlevenden."
                            },
                            {
                                "example_id": "c5f4eca8-811c-4dfa-882a-f0b129b067d6",
                                "sense_id": "5bfbd5e0-ade4-36ae-a589-f41cc79e8d6b",
                                "text": "Met Scott zelf liep het ook niet goed af. Bijna een jaar later, op 12 november 1912, werd hij met twee van zijn metgezellen en een dagboek gevonden door een reddingsploeg. Doodgevroren in zijn slaapzak, op slechts 17 kilometer van een voedseldepot."
                            }
                        ]
                    }
