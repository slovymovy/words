                ],
                "senses": [
                    {
                        "sense_id": "7c0208ac-56fe-3c3f-b785-eac2b8cb32e1",
                        "entry_id": "c80e3f3f-119e-3d5f-aea0-f6f763084730",
                        "glosses": [
                            "Fait de louper quelque-chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ef6e361-6d72-41d8-9289-4adff67177d8",
                                "sense_id": "7c0208ac-56fe-3c3f-b785-eac2b8cb32e1",
                                "text": "Parfois, un fiasco vaut mieux qu’une victoire. Un loupé est plus bénéfique, plus riche d’enseignements qu’un triomphe."
                            }
                        ]
                    },
                    {
                        "sense_id": "6d1db9a4-7e37-328c-9334-988228507690",
                        "entry_id": "c80e3f3f-119e-3d5f-aea0-f6f763084730",
                        "glosses": [
                            "Erreur commise par un joueur, occasion de but manquée ou erreur grossière d’un défenseur qui entraîne un but de l’équipe adverse."
                        ],
                        "tags": [
                            "specifically"
                        ],
                        "examples": [
                            {
                                "example_id": "17adecc5-347e-45d4-b6ad-7f22fa10005c",
                                "sense_id": "6d1db9a4-7e37-328c-9334-988228507690",
                                "text": "Sur un loupé d’Hanot, Jacolliot réussit un shoot plongeant qui pénètre dans le coin gauche des filets nordistes loin de Bournonville."
                            },
                            {
                                "example_id": "f9af9b3c-0c8b-4120-af3b-b49e1a697b81",
                                "sense_id": "6d1db9a4-7e37-328c-9334-988228507690",
                                "text": "Rodez souffrait et à la 40e minute, un centre de Rouve pour une tête de Rossetti que tout le monde voyait marquer, s’achevait par un loupé magistral de l'attaquant local."
                            }
                        ]
                    }
