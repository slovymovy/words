                        "glosses": [
                            "A leader used to attach a fishhook to the main line, especially in commercial fishing."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d21e99d0-8236-4816-a7ed-2d1f3b623ec6",
                                "sense_id": "b0bdc708-f094-3c02-b177-4ed40441d944",
                                "text": "The object of the snood swivels, in which the gangings are so easily adjustable, is to save time in removing the fish and in baiting the hooks."
                            },
                            {
                                "example_id": "8c45b4e3-580b-4d40-b351-b8f8d17f1300",
                                "sense_id": "b0bdc708-f094-3c02-b177-4ed40441d944",
                                "text": "The full length of each tub was just under half a mile and had a total of 270 gangings and hooks if it was a nine-foot rig. Each line was coiled into a wooden barrel three feet in diameter and thirty inches high."
                            }
                        ]
                    }
                ],
