                                    },
                                    {
                                        "sense_id": "590955dc-2258-3377-a34a-00455d16e8e8",
                                        "entry_id": "7a31dde8-2fe1-3311-a770-ac5b39cd8463",
                                        "glosses": [
                                            "An officer who delivered the royal answer to petitions."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4f2831b0-1806-46e0-b572-86f9c62890a4",
                                                "sense_id": "590955dc-2258-3377-a34a-00455d16e8e8",
                                                "text": "In the writs of Merovingian kings , the king normally signed his name first , and his referendary followed"
                                            },
                                            {
                                                "example_id": "6f8ea77b-1274-4c86-a2f3-ad7661519e41",
                                                "sense_id": "590955dc-2258-3377-a34a-00455d16e8e8",
                                                "text": "referendaries were involved in the presentation of petitions to the king"
