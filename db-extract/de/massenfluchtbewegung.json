                "senses": [
                    {
                        "sense_id": "9569a3cd-0784-37a0-9108-497961b25761",
                        "entry_id": "ed3cf5bc-f0d8-3d77-806d-9b7ee93eb16d",
                        "glosses": [
                            "die Bewegung von sehr vielen Menschen, die sich auf der Flucht befinden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d19323d5-5840-4d29-b2bb-9585597686be",
                                "sense_id": "9569a3cd-0784-37a0-9108-497961b25761",
                                "text": "„In der Verzweiflung (oder auch zur politischen Verschleierung der Verzweiflung) mag mit Waffengewalt nach fremden Ressourcen des Überlebens gegriffen werden. Ökologische Zerstörungen (z. B. das Überfluten Bangladeschs) können Massenfluchtbewegungen auslösen, die ihrerseits in kriegerische Konflikte münden. Oder kriegführende, von Niederlagen bedrohte Staaten mögen zum »letzten Mittel«, der Selbst- und Fremdvernichtung von Atom- und Chemiewerken, greifen, um angrenzende Regionen und Großstädte mit atomarer Vernichtung zu bedrohen.“"
                            },
                            {
                                "example_id": "e27c713e-2ad0-42c1-84c7-a1dd0b645ba8",
                                "sense_id": "9569a3cd-0784-37a0-9108-497961b25761",
                                "text": "„Das Hohe Flüchtlingskommissariat der Vereinten Nationen (UNHCR) berichtete von ersten Massenfluchtbewegungen in Richtung Liberia und Guinea.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
