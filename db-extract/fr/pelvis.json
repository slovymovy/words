                    },
                    {
                        "translation_id": "b4427002-ab07-492a-a655-2e9ee1a36918",
                        "source_entry_id": "9c5a3103-f6ec-3943-a397-197523c2d975",
                        "source_sense_id": "eda113c1-ca5a-348b-9ff7-52b447b2fe84",
