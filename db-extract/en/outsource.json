                                "sense_id": "0186fc60-3257-3945-b806-8b333cd93b4e",
                                "text": "They decided to outsource the design and manufacture of the system to a vendor."
                            },
                            {
                                "example_id": "19684137-1b78-49b2-b93e-2904937fab84",
                                "sense_id": "0186fc60-3257-3945-b806-8b333cd93b4e",
                                "text": "Read said maintenance would be outsourced, with \"positive discussions\" held with two companies."
                            }
                        ]
