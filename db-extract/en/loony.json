                                "target_senses": [
                                    {
                                        "sense_id": "ff6919e2-0178-3343-830b-acf7725dd3a0",
                                        "entry_id": "9e010c71-c58d-3e32-bde9-b7a671a15d3a",
                                        "glosses": [
                                            "разг. то же, что психопат; человек, страдающий психическим расстройством"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17892d63-13c0-45bd-aa9e-25a6ffb621fa",
                                                "sense_id": "ff6919e2-0178-3343-830b-acf7725dd3a0",
                                                "text": "Поэтому буйные психи лопают бензодиазепин ложкой и грустят взаперти, а тихие изучают трещины на потолке."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a4b4b49-4fb2-3de5-8888-067eebaaa33c",
                                        "entry_id": "9e010c71-c58d-3e32-bde9-b7a671a15d3a",
                                        "glosses": [
                                            "перен., разг. крайне несдержанный в поведении, взбалмошный, неуравновешенный человек"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fce38a73-e80e-40fb-9d55-b43fc2461a79",
                                                "sense_id": "9a4b4b49-4fb2-3de5-8888-067eebaaa33c",
                                                "text": "Не бывает такого, чтобы в одной группе собрались все послушные зануды, а в другой — все неуправляемые психи."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cb9a77d2-f25f-493a-911c-00e1fed81017",
                        "source_entry_id": "1d996617-fe5c-35c9-97af-0ebbc9657ea9",
                        "source_sense_id": "9251c144-c133-3307-8f39-7d54446e7a84",
                        "source_sense_description": "an insane or very foolish person",
                        "target_lang_word": "душевнобольной",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "душевнобольной",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "e0245d74-77ff-3449-a12d-85243174d031",
                                        "entry_id": "33a034a6-4e37-3fb0-9f66-d699783e43c4",
                                        "glosses": [
                                            "разг. тот, кто страдает психическим заболеванием"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58bac26d-78ff-421d-9454-f1ad3b345a7c",
                                                "sense_id": "e0245d74-77ff-3449-a12d-85243174d031",
                                                "text": "Я практикую около двадцати лет и не встречал ещё ни одного душевнобольного, который не был бы убеждён, что он вполне здоров."
                                            },
                                            {
                                                "example_id": "c9def487-286a-4cf9-87b0-d00b5e0e823a",
                                                "sense_id": "e0245d74-77ff-3449-a12d-85243174d031",
                                                "text": "В том, что я доктор, а вы душевнобольной, нет ни нравственности, ни логики, а одна только пустая случайность."
                                            },
                                            {
                                                "example_id": "1b8d7a02-d5e0-4cc9-9be5-3eaa088cb55a",
                                                "sense_id": "e0245d74-77ff-3449-a12d-85243174d031",
                                                "text": "Когда-то узнал, что Соню отвезли в больницу за́ городом, этого следовало ждать, всё-таки у неё плохая наследственность: мать Юлии Михайловны кончила в доме для душевнобольных и сама Юлия Михайловна была, конечно, не очень здорова."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "душевнобольной",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "087250a9-3c09-3296-b53b-6e6a4d868767",
                                        "entry_id": "c36beb7e-693a-3005-b21e-8251dc9a9ba8",
                                        "glosses": [
                                            "страдающий психическим заболеванием"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ced547b2-01c8-4879-9a2c-2ae27fd3b21f",
                                                "sense_id": "087250a9-3c09-3296-b53b-6e6a4d868767",
                                                "text": "В душевнобольных людях того времени видели одержимых злым духом или же святых."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
