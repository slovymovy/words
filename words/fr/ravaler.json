{
    "word_family": [
        "ravalement",
        "avaler"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "825bd7cd-327e-36b5-bd91-c7df3999f275",
                    "sense_definition": "Retenir ou dissimuler avec effort une émotion, des paroles ou des larmes sur le point d'être exprimées.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "expression_emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Face aux remarques injustes de son supérieur, il a dû <w>ravaler</w> sa fierté pour éviter un conflit."
                        },
                        {
                            "text": "Elle sentait une vive tristesse l'envahir mais a réussi à <w>ravaler</w> ses larmes devant ses proches."
                        }
                    ],
                    "synonyms": [
                        "réprimer",
                        "contenir",
                        "refouler"
                    ],
                    "antonyms": [
                        "exprimer",
                        "extérioriser"
                    ],
                    "common_phrases": [
                        "ravaler sa fierté",
                        "ravaler sa colère",
                        "ravaler ses larmes",
                        "ravaler ses paroles"
                    ]
                },
                {
                    "sense_id": "3acb4eb5-0eb0-383f-9ea7-d3f6dbecfdcb",
                    "sense_definition": "Remettre en état, nettoyer ou crépir la façade extérieure d'un bâtiment.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "batiment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La copropriété a enfin voté le budget nécessaire pour faire <w>ravaler</w> la façade de l'immeuble."
                        },
                        {
                            "text": "Les ouvriers ont passé trois semaines à <w>ravaler</w> un mur abîmé par les intempéries."
                        }
                    ],
                    "synonyms": [
                        "restaurer",
                        "rénover"
                    ],
                    "common_phrases": [
                        "ravaler une façade",
                        "ravaler un mur"
                    ]
                },
                {
                    "sense_id": "110a8ed7-d116-33f1-9ff6-11de6c675686",
                    "sense_definition": "Rabaisser une personne ou une chose à un niveau inférieur ou indigne ; déprécier.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "depreciation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il refuse de se <w>ravaler</w> au rang de ses détracteurs en répondant à leurs provocations."
                        },
                        {
                            "text": "Ses critiques acerbes cherchaient délibérément à <w>ravaler</w> le mérite de son prédécesseur."
                        }
                    ],
                    "synonyms": [
                        "rabaisser",
                        "déprécier",
                        "avilir"
                    ],
                    "antonyms": [
                        "élever",
                        "valoriser"
                    ],
                    "common_phrases": [
                        "se ravaler au rang de",
                        "ravaler le mérite"
                    ]
                },
                {
                    "sense_id": "61f51309-1e7c-3e4f-9346-7f56e9c0dcfc",
                    "sense_definition": "Avaler de nouveau ou faire redescendre dans la gorge.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "ingurgiter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sous le coup de l'angoisse, le témoin s'est arrêté un instant pour <w>ravaler</w> sa salive."
                        },
                        {
                            "text": "Pris de panique au milieu de sa prise de parole, il <w>ravala</w> péniblement sa salive."
                        }
                    ],
                    "synonyms": [
                        "réavaler"
                    ],
                    "antonyms": [
                        "recracher"
                    ],
                    "common_phrases": [
                        "ravaler sa salive"
                    ]
                }
            ]
        }
    ]
}