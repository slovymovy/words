                    {
                        "translation_id": "c26c303b-a6f6-464e-b30b-8d33732d11d3",
                        "source_entry_id": "cfd830db-944f-3ae6-81f3-895da85d79c4",
                        "source_sense_id": "f67a7618-a214-353b-b472-79d812a26d5e",
                        "target_lang_word": "hosianna",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hosianna",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a9e8d205-d6f3-393b-b539-0112c12f1bfd",
                                        "entry_id": "b48d5d86-f8d7-309e-8b8a-c744018a031d",
                                        "glosses": [
                                            "liturgischer Ausruf der Freude"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee45d906-311f-43d6-a2c8-63ecbc704ce7",
                                                "sense_id": "a9e8d205-d6f3-393b-b539-0112c12f1bfd",
                                                "text": "Hosianna! Ehre sei Gott in der Höhe."
                                            },
                                            {
                                                "example_id": "7e9a6963-0376-4ab8-aa28-7e42cfd321ff",
                                                "sense_id": "a9e8d205-d6f3-393b-b539-0112c12f1bfd",
                                                "text": "„Freunde der »null-nuklearen Welt« werden nur verhalten hosianna rufen angesichts des Abbaus der je 2200 Sprengköpfe auf 1550 und der Halbierung ihrer Träger auf 800.“"
                                            },
                                            {
                                                "example_id": "4a5ebe5d-ffd3-4c5f-9ac0-462b7d585e0d",
                                                "sense_id": "a9e8d205-d6f3-393b-b539-0112c12f1bfd",
                                                "text": "Das Volk aber, das vorging und nachfolgte, schrie und sprach: Hosianna dem Sohn Davids! Gelobt sei, der da kommt in dem Namen des HERRN! Hosianna in der Höhe!"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f3b8083e-12df-4889-8c65-90b19ad68a3e",
                        "source_entry_id": "cfd830db-944f-3ae6-81f3-895da85d79c4",
                        "source_sense_id": "f67a7618-a214-353b-b472-79d812a26d5e",
                        "target_lang_word": "осанна",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "осанна",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "aeeb64e8-a2a5-3f23-abf8-b26bb89fb80f",
                                        "entry_id": "b7ae7f65-7b57-319c-9afe-9e64c000038f",
                                        "glosses": [
                                            "религ. молитвенный возглас, славословие"
                                        ],
                                        "tags": [
                                            "мн. нет"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "90f646b9-b735-4f92-911a-f3634add3a3d",
                                                "sense_id": "aeeb64e8-a2a5-3f23-abf8-b26bb89fb80f",
                                                "text": "Многие же постилали одежды свои по дороге; а другие резали ветви с дерев и постилали по дороге. И предшествовавшие и сопровождавшие восклицали: осанна! благословен Грядущий во имя Господне!"
                                            },
                                            {
                                                "example_id": "d616c38a-424c-4074-b3ed-1a5b852786ef",
                                                "sense_id": "aeeb64e8-a2a5-3f23-abf8-b26bb89fb80f",
                                                "text": "Не дрогнет же у меня рука отправить на тот свет хоть одного из тех идиотов, которые, корчась от боли, вопиют — осанна тебе, жизнь прекрасная!"
                                            },
                                            {
                                                "example_id": "3c16dab0-369e-4d14-ada3-1d039ccb3af6",
                                                "sense_id": "aeeb64e8-a2a5-3f23-abf8-b26bb89fb80f",
                                                "text": "Святой Косьма расскажет вам, как явишася источницы бездны, влаги непричастны; он же уверит вас своим каноном и в том, что спасутся от вечных бед изрядные церковные люди поющие — осанна, благословен еси, Грядый!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
