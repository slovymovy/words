                "senses": [
                    {
                        "sense_id": "dd50af6a-9751-3705-ba19-b82e64d7f0d6",
                        "entry_id": "b32595de-a5ee-3979-9ade-d75cf1d71e10",
                        "glosses": [
                            "Diluvien."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d40e56b-c70e-4d1f-a20d-f6ec6d531699",
                                "sense_id": "dd50af6a-9751-3705-ba19-b82e64d7f0d6",
                                "text": "Bientôt, soit qu'elle se volatilisât par l'effet du feu intérieur, cet atelier de Vulcain; soit qu'elle s'évaporât par l'action du soleil, cet œil de Dieu, l'eau diluviale commença de diminuer."
                            },
                            {
                                "example_id": "c990a3fb-4fb6-428a-b266-6910eb939f7c",
                                "sense_id": "dd50af6a-9751-3705-ba19-b82e64d7f0d6",
                                "text": "L’Européen ne peut se faire une idée de ces pluies diluviales, quelquefois si fréquentes pendant l’hivernage."
                            }
                        ]
                    }
