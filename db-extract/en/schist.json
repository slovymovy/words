{
    "word": "schist",
    "lang_code": "en",
    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "37486849-e760-393b-8dbe-c2fe9022013c",
                "word": "schist",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "5e2f85d7-a36d-45de-be92-702e4cc59d12",
                        "entry_id": "37486849-e760-393b-8dbe-c2fe9022013c",
                        "tags": [
                            "plural"
                        ],
                        "form": "schists"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3d8d721a-f4a6-3be9-9638-2a6c0a9c165e",
                        "entry_id": "37486849-e760-393b-8dbe-c2fe9022013c",
                        "glosses": [
                            "Any of a variety of coarse-grained crystalline metamorphic rocks with a foliated structure that allows easy division into slabs or slates."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "fb8d971d-8b9e-4c09-97f3-318128034bcb",
                                "sense_id": "3d8d721a-f4a6-3be9-9638-2a6c0a9c165e",
                                "text": "Although it shows under the microscope traces of the original gabbro structure and of the original gabbro minerals, no one would hesitate from a microscopical examination to class it with the schists."
                            },
                            {
                                "example_id": "68b0b174-56af-49e2-a6a9-3792be0483e2",
                                "sense_id": "3d8d721a-f4a6-3be9-9638-2a6c0a9c165e",
                                "text": "1915, Charles Will Wright, Geology and Ore Deposits of Copper Mountain and Kasaan Peninsula, Alaska, US Geological Survey, Professional Paper 87, page 29,\nNarrow bands of schist are interstratified with these limestones, and in turn narrow beds of limestone are interstratified with the schists."
                            },
                            {
                                "example_id": "16abd8a8-c56c-4e5b-b7bb-8fc60a51b5e5",
                                "sense_id": "3d8d721a-f4a6-3be9-9638-2a6c0a9c165e",
                                "text": "Millions of years ago the mica schists surrounding the old Brandberg West Mine became folded and concertinaed by enormous horizontal pressures."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "38d9bd55-b953-4ea5-bae7-06d281868754",
                        "source_entry_id": "37486849-e760-393b-8dbe-c2fe9022013c",
                        "source_sense_id": "3d8d721a-f4a6-3be9-9638-2a6c0a9c165e",
                        "source_sense_description": "crystalline foliated rock",
                        "target_lang_word": "schist",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "schist",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "127feafe-925e-3591-bc34-381df2b69da6",
                                        "entry_id": "6180fd68-2e72-3a03-80a6-adbcfb3dc04f",
                                        "glosses": [
                                            "een kristallijn gesteente, dat vanwege een duidelijke foliatie gemakkelijk splijtbaar is"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86e9c311-de69-4706-b6c9-2fd277160841",
                                                "sense_id": "127feafe-925e-3591-bc34-381df2b69da6",
                                                "text": "Deze schist bevat het mineraal biotiet."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6ed917bc-915a-4d76-b75f-72519f4791b9",
                        "source_entry_id": "37486849-e760-393b-8dbe-c2fe9022013c",
                        "source_sense_id": "3d8d721a-f4a6-3be9-9638-2a6c0a9c165e",
                        "source_sense_description": "crystalline foliated rock",
                        "target_lang_word": "schiste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "schiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d31e4a9e-9c03-39bb-b9cd-4ee9edbb0761",
                                        "entry_id": "bf629d37-6ac2-30d5-88de-542067c653ad",
                                        "glosses": [
                                            "Roche sédimentaire ou métamorphique (cristallophyllienne) à structure feuilletée et pouvant se diviser (se cliver) facilement en lames ou feuilles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fcbba45c-ace6-405b-9c1c-d583b8a3f0ed",
                                                "sense_id": "d31e4a9e-9c03-39bb-b9cd-4ee9edbb0761",
                                                "text": "Le terrain ardoisier montre une succession de schistes et de quartzites des nuances les plus diverses, dont l’inclinaison générale est vers le sud de la boussole."
                                            },
                                            {
                                                "example_id": "86f068c1-bc22-49a9-9478-f508d2e6e0b3",
                                                "sense_id": "d31e4a9e-9c03-39bb-b9cd-4ee9edbb0761",
                                                "text": "Vous ne chercheriez pas longtemps dans ces fissures de schiste ardoisé sans rencontrer des pépites importantes."
                                            },
                                            {
                                                "example_id": "5e9fc8b3-728d-4def-87f8-0ae26c83629a",
                                                "sense_id": "d31e4a9e-9c03-39bb-b9cd-4ee9edbb0761",
                                                "text": "On retrouve ce psammite à l'Est, à mi-hauteur du chemin d’Aiglemont, où il passe en dessus et en dessous des schistes gris-bleu, quarzeux."
                                            },
                                            {
                                                "example_id": "a3c6e760-0df9-4f64-87ca-ca1c110ad9aa",
                                                "sense_id": "d31e4a9e-9c03-39bb-b9cd-4ee9edbb0761",
                                                "text": "Il verrait succéder la flore calcifuge moins variée des schistes et des grès, celle des tourbières avec leurs éléments relictuels."
                                            },
                                            {
                                                "example_id": "c590c44f-a7a6-4fc4-9f30-3804ee13ffcb",
                                                "sense_id": "d31e4a9e-9c03-39bb-b9cd-4ee9edbb0761",
                                                "text": "Quant aux pommes de terre, les canadas, venus dans les défrichements, du terrain sec, du schiste pourri tout pailleté d'écailles irisées, on leur découvre toujours un goût nouveau."
                                            },
                                            {
                                                "example_id": "fba0db29-d59a-4375-b789-423b2d90b407",
                                                "sense_id": "d31e4a9e-9c03-39bb-b9cd-4ee9edbb0761",
                                                "text": "Shaw remarque que les schistes contenant des hydrocarbures ou du carbone libre contiennent en moyenne 1,23 ppm de Tl [thallium], deux fois plus que les sédiments argileux non carbonés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54ab1878-eab8-3a95-8e48-3c444bb9fe84",
                                        "entry_id": "bf629d37-6ac2-30d5-88de-542067c653ad",
                                        "glosses": [
                                            "Substance stérile mêlée au charbon."
                                        ],
                                        "tags": [
                                            "Industrie minière"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ad04152-6dfd-42c7-89e2-6dbb7cf6afab",
                                                "sense_id": "54ab1878-eab8-3a95-8e48-3c444bb9fe84",
                                                "text": "Dans sa forme la plus simple, cet épierreur sélectionne le charbon brut en deux classes : les schistes d'une part, et, d'autre part, les charbons plus ou moins barrés ."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9aaea5e-3a99-39d6-aa9a-c976cab84b1a",
                                        "entry_id": "bf629d37-6ac2-30d5-88de-542067c653ad",
                                        "glosses": [
                                            "Huile de schiste, utilisée autrefois pour l'éclairage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a75ee22a-c3ab-423c-8d60-0285716cce98",
                                                "sense_id": "f9aaea5e-3a99-39d6-aa9a-c976cab84b1a",
                                                "text": "Cette loge, qu’il partageait avec deux camarades, était un cabinet sans fenêtre, bas de plafond, éclairé au schiste."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4c32202c-e568-41e9-be7e-eb66edbb1ce4",
                        "source_entry_id": "37486849-e760-393b-8dbe-c2fe9022013c",
                        "source_sense_id": "3d8d721a-f4a6-3be9-9638-2a6c0a9c165e",
