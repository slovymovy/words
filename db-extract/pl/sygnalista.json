                        "glosses": [
                            "ktoś, kto nadaje i odbiera sygnały, np. świetlne, radiowe itp."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00cc1e0f-445e-45db-9c5a-151803b48959",
                                "sense_id": "58039f5c-615f-3bdc-8b33-6813c05cead3",
                                "text": "Sygnalista Karlik, przy windzie wpisuje w tablicę wyciągnięte wozy z urobkiem."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "147131a2-6c14-385c-a725-a803c6402ed4",
                        "entry_id": "eeba46ea-cd52-3978-b0aa-09b1b7a299d5",
                        "glosses": [
                            "trębacz (wojskowy, harcerski), który wygrywa sygnały na trąbce lub fanfarze"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec7c9ee8-2ac4-40a9-b6f8-df0152086eb5",
                                "sense_id": "147131a2-6c14-385c-a725-a803c6402ed4",
                                "text": "Wesoło wtórowały dźwięczne trąbki sygnalistów."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "e576d66c-1f79-3fd2-89f3-b0fa0c6a40e6",
                        "entry_id": "eeba46ea-cd52-3978-b0aa-09b1b7a299d5",
                        "glosses": [
                            "człowiek, który działając w dobrej intencji, ujawnia lub zgłasza nieprawidłowości, do jakich dochodzi w miejscu pracy, a które naruszają interes pracodawcy lub interes publiczny"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e3cd876-a98f-48bc-96a9-d6d0c8d52798",
                                "sense_id": "e576d66c-1f79-3fd2-89f3-b0fa0c6a40e6",
                                "text": "Podczas procesu o ekstradycję niezależnego dziennikarza i sygnalisty Juliana Asange’a, jego obrońcy przedstawili zeznania świadka, który twierdził, że USA naciskały na zgładzenie Juliana Assange’a."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e90a4160-2ba8-40fb-8dcf-ba14849b793f",
                        "source_entry_id": "eeba46ea-cd52-3978-b0aa-09b1b7a299d5",
                        "source_sense_id": "e576d66c-1f79-3fd2-89f3-b0fa0c6a40e6",
                        "target_lang_word": "whistleblower",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "whistleblower",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7570802b-e078-30e7-8f6f-bc900523ba54",
                                        "entry_id": "c5986e2e-afc3-35cc-8419-06dd60378986",
                                        "glosses": [
                                            "Alternative form of whistle-blower."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a1ced4c4-f2fe-463a-9f7c-eba9413ce920",
                        "source_entry_id": "eeba46ea-cd52-3978-b0aa-09b1b7a299d5",
                        "source_sense_id": "e576d66c-1f79-3fd2-89f3-b0fa0c6a40e6",
                        "target_lang_word": "Whistleblower",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Whistleblower",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a49c724a-c08b-3ba0-a866-b91b394453f3",
                                        "entry_id": "c7b0c216-42df-3993-b7be-c46dd9845550",
                                        "glosses": [
                                            "(männliche^☆) Person, die Missstände oder Gesetzwidrigkeiten (an ihrem Arbeitsplatz) an die Öffentlichkeit bringt; (männliche^☆) Person, die Whistleblowing betreibt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c3a2159-d6e2-43ba-a0ad-fb105ad98aa1",
                                                "sense_id": "a49c724a-c08b-3ba0-a866-b91b394453f3",
                                                "text": "„Was ist im modernen amerikanischen Slang ein ‚Whistleblower‘? Ein Musiker? Eine Vogelart? Ein technisches Gerät? Nichts von alledem. Unter einem Whistleblower - wörtlich: Pfeifenbläser - versteht man einen verantwortungsbewußten Wissenschaftler, Ingenieur oder Techniker, der die Öffentlichkeit rechtzeitig davor warnt, wenn in seinem speziellen Fachbereich eine Entwicklung verfolgt wird, die auf die eine oder andere Weise Schaden bringen kann.“"
                                            },
                                            {
                                                "example_id": "cbfd8593-392d-4cee-9a99-c9031ade52af",
                                                "sense_id": "a49c724a-c08b-3ba0-a866-b91b394453f3",
                                                "text": "„Whistleblower sind Menschen, die frühzeitig auf Probleme und Bedrohungen unserer Gesellschaft aufmerksam machen. Leute also, die die Alarmpfeife blasen.“"
                                            },
                                            {
                                                "example_id": "1a2248a1-6f6d-4cfe-8714-988c860ff02e",
                                                "sense_id": "a49c724a-c08b-3ba0-a866-b91b394453f3",
                                                "text": "„Die Bundesregierung plant eine Regelung zum Schutz von sogenannten ‚Whistleblowern‘.“"
                                            },
                                            {
                                                "example_id": "c25b83e1-9aae-4a8e-83d3-61e5cec06949",
                                                "sense_id": "a49c724a-c08b-3ba0-a866-b91b394453f3",
                                                "text": "„Aber in Deutschland scheiterte bisher selbst der erste zaghafte Schritt, die Rechtslage für Whistleblower durch eine Regelung im Bürgerlichen Gesetzbuch zu verbessern.“"
                                            },
                                            {
                                                "example_id": "88539396-73ed-4e24-a650-ae6a857a13e1",
                                                "sense_id": "a49c724a-c08b-3ba0-a866-b91b394453f3",
                                                "text": "„Zudem wäre es auch an der Zeit, wenn im Interesse aller die rechtlichen Schutznormen für «Whistleblower» endlich verbessert würden!“"
                                            },
                                            {
                                                "example_id": "e1ef0a26-774c-449e-b8be-916bddd2b51e",
                                                "sense_id": "a49c724a-c08b-3ba0-a866-b91b394453f3",
                                                "text": "„Die Informanten werden auch ‚Whistleblower‘ (Tippgeber) genannt.“"
                                            },
                                            {
                                                "example_id": "8a043e94-7bc0-4a45-bfc5-5325c5e8d6b6",
                                                "sense_id": "a49c724a-c08b-3ba0-a866-b91b394453f3",
                                                "text": "„Es wird häufig mit Illoyalität, Denunziantentum oder sogar Geheimnisverrat assoziiert und endet nicht selten mit einer Sanktionierung des Whistleblowers (Mobbing, Bedrohung, Entlassung oder strafrechtliche Verfolgung).“"
                                            },
                                            {
                                                "example_id": "c89e37f4-100f-4403-8ad3-62a941b885ed",
                                                "sense_id": "a49c724a-c08b-3ba0-a866-b91b394453f3",
                                                "text": "„Und seit Obama Präsident ist, hat sich auch die strafrechtliche Verfolgung von Whistleblowern, von Leuten, die Informationen aus der Regierung nach außen geben, intensiviert.“"
                                            },
                                            {
                                                "example_id": "6d79299a-97ab-40d4-81fa-25a6ed00288d",
                                                "sense_id": "a49c724a-c08b-3ba0-a866-b91b394453f3",
                                                "text": "„Die spektakuläre Flucht des sogenannten Whistleblowers sorgt für erhebliche politische Spannungen.“"
                                            },
                                            {
                                                "example_id": "95cc217e-02a1-44a2-8f59-89cb0c8ca4f3",
                                                "sense_id": "a49c724a-c08b-3ba0-a866-b91b394453f3",
                                                "text": "„Die unnachsichtige Kriminalisierung von Whistleblowern soll offensichtlich dazu dienen, potenzielle Quellen für eine kritische Berichterstattung über den Missbrauch staatlicher Macht durch Strafandrohung systematisch trockenzulegen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
