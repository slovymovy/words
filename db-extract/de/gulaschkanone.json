                "senses": [
                    {
                        "sense_id": "e1813542-8380-3cf8-9d6d-c80792776b42",
                        "entry_id": "f438ed0b-4a45-33ac-830e-3cbb9d60c973",
                        "glosses": [
                            "fahrbare Feldküche"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "bdf40c94-6d2d-40c2-85b1-7c20de6a766e",
                                "sense_id": "e1813542-8380-3cf8-9d6d-c80792776b42",
                                "text": "Beim Zeltlager hatten sie eine Gulaschkanone dabei."
                            },
                            {
                                "example_id": "6f236ff5-2849-4e2d-bfc9-ee6eb1784191",
                                "sense_id": "e1813542-8380-3cf8-9d6d-c80792776b42",
                                "text": "„Er ist ganz verzweifelt, weil er nicht weiß, wie er seine Gulaschkanone leerkriegen soll.“"
                            },
                            {
                                "example_id": "6116eac9-12bd-4a0b-8521-5220dc64088b",
                                "sense_id": "e1813542-8380-3cf8-9d6d-c80792776b42",
                                "text": "„Es gab Suppe und Wurst aus der Gulaschkanone und dann das Spiel.“"
                            },
                            {
                                "example_id": "2b6a98e7-4359-476a-b9aa-5add57024c48",
                                "sense_id": "e1813542-8380-3cf8-9d6d-c80792776b42",
                                "text": "„Er ließ den Soldaten eine Extraportion Branntwein austeilen, ritt die Stellungen ab, inspizierte die Gulaschkanonen, probierte das Essen und sprach mit diesem und jenem.“"
                            },
                            {
                                "example_id": "88869fa6-c0e9-4380-9ead-696858a5ee9f",
                                "sense_id": "e1813542-8380-3cf8-9d6d-c80792776b42",
                                "text": "„Eine Gulaschkanone stand draußen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
