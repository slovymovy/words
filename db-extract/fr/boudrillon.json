                        "glosses": [
                            "Variante de boudrion, homme de petite taille."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "a90fa0eb-9894-4e98-b0fe-728952d854dd",
                                "sense_id": "2530da38-365f-3b41-9029-6b8d7394c1d9",
                                "text": "L'orgueil insupportable\nDu petit Mirmidon, Boudrillon,\nLe rend impraticable Jusque dans sa maison."
                            },
                            {
                                "example_id": "5d176c46-e83f-4f60-b62f-fdcbde209992",
                                "sense_id": "2530da38-365f-3b41-9029-6b8d7394c1d9",
                                "text": "Le sobriquet boudrillon désigne donc la petite baudroie et s’applique à un personnage grotesque."
                            },
                            {
                                "example_id": "89c2367c-c20d-4b9d-827e-783fc4f44c24",
                                "sense_id": "2530da38-365f-3b41-9029-6b8d7394c1d9",
                                "text": "– L’on m’a répondu… Je veux dire une espèce de boudrillon, haut, à peine, de cinq pieds, deux pouces, et chargé de ganache, me répond : « Je n’en ai plus. »"
                            }
                        ]
                    }
