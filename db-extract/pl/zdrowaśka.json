                "senses": [
                    {
                        "sense_id": "29a93fe1-d7c2-3aa5-82f2-e001f4fcb5f6",
                        "entry_id": "3104d91d-a080-369e-93f3-ff886d017e2e",
                        "glosses": [
                            "modlitwa chrześcijańska zaczynająca się od słów „Zdrowaś Maryjo”"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "24c41400-b3aa-4d6e-a267-2589ca064e0d",
                                "sense_id": "29a93fe1-d7c2-3aa5-82f2-e001f4fcb5f6",
                                "text": "Zbyszek odmówił przed snem dwie zdrowaśki."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "3952f99d-c989-35d7-8f4e-42863ceefe29",
                        "entry_id": "3104d91d-a080-369e-93f3-ff886d017e2e",
                        "glosses": [
                            "ilość czasu potrzebna do odmówienia jednej zdrowaśki (1.1)"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "f860c1fd-247f-4eee-b631-6b6c13f9eb5d",
                                "sense_id": "3952f99d-c989-35d7-8f4e-42863ceefe29",
                                "text": "On był tak przekonujący, że nawet nie minęła zdrowaśka, jak oddała mu się Kaśka."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1664ce6b-8f75-4ba4-b87f-f5a2e9356a08",
                        "source_entry_id": "3104d91d-a080-369e-93f3-ff886d017e2e",
                        "source_sense_id": "29a93fe1-d7c2-3aa5-82f2-e001f4fcb5f6",
                        "target_lang_word": "Hail Mary",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hail Mary",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "28fc3fc8-00b4-32b9-af68-67cedf095b9b",
                                        "entry_id": "897a044a-89ad-3f9b-b5c0-2b2ea507e289",
                                        "glosses": [
                                            "A prayer, of established or conventional wording, calling for the intercession of the Virgin Mary."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b10cba9-4375-48fa-b33f-e1db8806371e",
                                                "sense_id": "28fc3fc8-00b4-32b9-af68-67cedf095b9b",
                                                "text": "“What did the priest, and all of you, keep on saying when we first went in?” / “Our Fathers, Hail Maries, and Glorias; couldn’t you hear?” asked Emily, laughing. / “No, I should think not, you rattled on so fast- What are Hail Maries and Glorias?” / “The Gloria you know well enough, my dear, because you say it in your church at the end of every psalm,” replied Miss Horton; “the Hail Mary is a prayer to our Blessed Lady,” and she repeated it."
                                            },
                                            {
                                                "example_id": "1e17ac18-6c76-4cb5-bbdc-5c710f9eda49",
                                                "sense_id": "28fc3fc8-00b4-32b9-af68-67cedf095b9b",
                                                "text": "And if I say ten Hail Marys / Leave a light on in Heaven for me"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "64332c43-4a5b-3137-9983-65437d38b461",
                                        "entry_id": "897a044a-89ad-3f9b-b5c0-2b2ea507e289",
                                        "glosses": [
                                            "A risky last-ditch effort with great benefit but little chance of success; one whose success would require divine intervention; a Hail Mary pass."
                                        ],
                                        "tags": [
                                            "US",
                                            "attributive",
                                            "figuratively",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea7f5332-71e3-4009-a8b3-f57ed4ee27b7",
                                                "sense_id": "64332c43-4a5b-3137-9983-65437d38b461",
                                                "text": "Hail Mary deal"
                                            },
                                            {
                                                "example_id": "fd3f02ea-9d6d-4440-8071-2bfbf283125e",
                                                "sense_id": "64332c43-4a5b-3137-9983-65437d38b461",
                                                "text": "There are hundreds of plays and combinations, plus a great two-player mode. This guide should tell you which plays work best and when to use them. Grab a hot-dog and take to the stands for a few Hail Marys followed by a quick Toss and Pass."
                                            },
                                            {
                                                "example_id": "b9a91d97-d9af-4911-8159-ecc694acc937",
                                                "sense_id": "64332c43-4a5b-3137-9983-65437d38b461",
                                                "text": "Silk Road was, in some sense, a last heave—a Hail Mary in the parlance of Ross's football-mad hometown."
                                            },
                                            {
                                                "example_id": "95615ae6-cd19-4923-b276-d9512dd4af7d",
                                                "sense_id": "64332c43-4a5b-3137-9983-65437d38b461",
                                                "text": "Trump administration files Hail Mary appeal to derail youth climate lawsuit [title]"
                                            },
                                            {
                                                "example_id": "b73366a7-6672-4887-8907-5104e4d52042",
                                                "sense_id": "64332c43-4a5b-3137-9983-65437d38b461",
                                                "text": "SoundCloud finally secured a Hail Mary deal that included $170 million of new funding from the Raine Group and Singapore’s Temasek in August of 2017."
                                            },
                                            {
                                                "example_id": "4fefd17a-4a42-4861-9183-091043c5f8e2",
                                                "sense_id": "64332c43-4a5b-3137-9983-65437d38b461",
                                                "text": "“I have traveled across continents to come to the jungle to do psychedelics,” marveled Mr. Gonsior, who had steered clear from drugs his whole life. “I guess this is what might be considered a Hail Mary.”"
                                            },
                                            {
                                                "example_id": "07a6afdd-bbe5-4676-a3b0-c66581d6b074",
                                                "sense_id": "64332c43-4a5b-3137-9983-65437d38b461",
                                                "text": "With each passing day, Facebook’s metaverse aspirations look more like a Hail Mary fantasy, a beleaguered CEO’s escape attempt to a 3-D virtual world where he might leave behind the misery of his dull 2-D version."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Hail Mary",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "98535462-65d6-3d1a-be57-5dc89b11742a",
                                        "entry_id": "62b19b3b-0497-3da2-b038-3f904d2d45d0",
                                        "glosses": [
                                            "To pray by saying a Hail Mary."
                                        ],
                                        "tags": [
                                            "often",
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c230079-d200-42c6-ab7a-c36cb47196b4",
                                                "sense_id": "98535462-65d6-3d1a-be57-5dc89b11742a",
                                                "text": "He Hail Maryed himself to sleep every night and woke up Hail Marying in the morning, and to his amazement and delight it worked."
                                            },
                                            {
                                                "example_id": "04e39cc0-8393-49b9-b760-8c2813e566f0",
                                                "sense_id": "98535462-65d6-3d1a-be57-5dc89b11742a",
                                                "text": "Sister Cecilia Hail Maryed herself and slid back in the room."
                                            },
                                            {
                                                "example_id": "bbc3d0fd-c915-4aef-9765-690b1d02fbfd",
                                                "sense_id": "98535462-65d6-3d1a-be57-5dc89b11742a",
                                                "text": "I can just imagine a medical examiner standing beside my corpse, pulling the sheet back so as to expose my head and torso, and explaining to a detective, “This poor man Hail Maryed himself to death!”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "414d9201-294e-4241-88d0-07d980835947",
                        "source_entry_id": "3104d91d-a080-369e-93f3-ff886d017e2e",
                        "source_sense_id": "29a93fe1-d7c2-3aa5-82f2-e001f4fcb5f6",
