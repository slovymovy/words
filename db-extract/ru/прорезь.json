                    {
                        "sense_id": "5deab449-ca18-32f4-9179-b81577b39410",
                        "entry_id": "bd95d29b-6df4-3a82-a9f7-2c5d26f8adac",
                        "glosses": [
                            "сквозное (обычно узкое) отверстие, прорезанное в чём-либо"
