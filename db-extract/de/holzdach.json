                "senses": [
                    {
                        "sense_id": "8f881a09-71cf-3b1a-b16b-5b9092e6d522",
                        "entry_id": "625684fc-62f9-3c04-87c3-37c304ddfa6a",
                        "glosses": [
                            "Dach aus Holz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54cc6d56-dfeb-415d-abe8-2d46aa6da1ab",
                                "sense_id": "8f881a09-71cf-3b1a-b16b-5b9092e6d522",
                                "text": "„Oben war das Holzdach nicht verkleidet, die Schindeln waren zu sehen, auf der rechten Seite hatte es durchgeregnet, vielleicht war auch Schnee geschmolzen, und man hörte auf dem Dach jemand hämmern.“"
                            },
                            {
                                "example_id": "51562150-78fb-434b-b947-8ce9ca7fe499",
                                "sense_id": "8f881a09-71cf-3b1a-b16b-5b9092e6d522",
                                "text": "„Mehr als 600 Genossen hocken unter dem Holzdach des Ballsaals an langen Tischen, trinken Bier (2,90 Euro), schneiden Schweineschnitzel (13,50 Euro).“"
                            },
                            {
                                "example_id": "caa0d595-bf31-47c4-8bae-38323db3fce9",
                                "sense_id": "8f881a09-71cf-3b1a-b16b-5b9092e6d522",
                                "text": "„Das Flackern des gewaltigen Feuers muss weit über die Donauebene sichtbar gewesen sein: Nicht nur die Holzdächer der Häuser auf dem Burgberg loderten hell, sondern auch die Gehöfte der Außensiedlung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
