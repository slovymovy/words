                ],
                "senses": [
                    {
                        "sense_id": "560f5716-1a15-313f-8b64-0fc5e1333492",
                        "entry_id": "3e0a413f-941d-3776-ab36-59752b808888",
                        "glosses": [
                            "następujący, odbywający się przed obiadem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "42805e09-3ac8-47af-b289-4a6bf963734b",
                                "sense_id": "560f5716-1a15-313f-8b64-0fc5e1333492",
                                "text": "Pierwotnie w tym miejscu przy zwykłych niczym nie nakrytych stolikach śniadania i jakieś przedobiednie przekąski jadali architekci i konserwatorzy zabytków zatrudnieni w Pracowniach Konserwacji Zabytków."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2ec2a9b2-c86b-4c4c-b025-1008c3102d48",
                        "source_entry_id": "3e0a413f-941d-3776-ab36-59752b808888",
                        "source_sense_id": "560f5716-1a15-313f-8b64-0fc5e1333492",
                        "target_lang_word": "anteprandial",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anteprandial",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "17efd1fe-caf8-3d8e-b286-ca10b36fc0c1",
                                        "entry_id": "573effcc-a0d1-3924-9640-26d719a41ddd",
                                        "glosses": [
                                            "Before a meal, especially before dinner."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "28e27b2a-a6b9-4928-ba11-2365d56ade74",
                        "source_entry_id": "3e0a413f-941d-3776-ab36-59752b808888",
                        "source_sense_id": "560f5716-1a15-313f-8b64-0fc5e1333492",
                        "target_lang_word": "preprandial",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "preprandial",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bbd9b846-e978-3d61-8580-3a0d03a9cf57",
                                        "entry_id": "f3460f4b-0f99-3066-a8f0-c26aa476c989",
                                        "glosses": [
                                            "Occurring before a meal, especially dinner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61244c95-f8d9-4b44-9170-6e09ecf97021",
                                                "sense_id": "bbd9b846-e978-3d61-8580-3a0d03a9cf57",
                                                "text": "Whilst meditating on the beauty and design as shown in the ant-eater, whose præprandial movements I was intently watching, a young gentleman (not a naturalist) asked me, sotto voce, \"what is that contrivance?\" \"It is a contrivance,\" said I, \"for catching ants, and that is why he is called the ant-eater,\" I continued to a young lady, who wanted to know the meaning of his name."
                                            },
                                            {
                                                "example_id": "72e35a43-97ad-4f5b-8120-87f164e9f037",
                                                "sense_id": "bbd9b846-e978-3d61-8580-3a0d03a9cf57",
                                                "text": "Gauss laid aside his pipe, pulled his velvet cap over the back of his head, returned the Russian dictionary and the little volume of Pushkin to the shelf, and prepared to go for his preprandial walk."
                                            },
                                            {
                                                "example_id": "3e9cd8a8-56db-40ac-8c8a-68770ee5d4cc",
                                                "sense_id": "bbd9b846-e978-3d61-8580-3a0d03a9cf57",
                                                "text": "Patients who demonstrate significant insulin resistance at diagnosis and require insulin therapy may alternate preprandial and postprandial evaluations to enable more rapid optimization of control by using an additional supplemental insulin sliding scale as needed to cover preprandial hyperglycaemia (>100 ml per dl)[…]."
                                            },
                                            {
                                                "example_id": "1a930d93-b91e-4846-8c33-973db8785192",
                                                "sense_id": "bbd9b846-e978-3d61-8580-3a0d03a9cf57",
                                                "text": "Social drinkers (as they are sometimes called) may have excellent control over the amount they drink and still look forward to a preprandial aperitif (and miss it when they do not get one)."
                                            },
                                            {
                                                "example_id": "4d691aa0-cc72-4ec8-b6c0-074d403211cc",
                                                "sense_id": "bbd9b846-e978-3d61-8580-3a0d03a9cf57",
                                                "text": "The standardized analysis of metabolic parameters in the preprandial and postprandial state may provide important functional clues for the diagnosis of metabolic disorders."
                                            },
                                            {
                                                "example_id": "656d85f0-6b4b-4e23-86e9-a9d7c2a69527",
                                                "sense_id": "bbd9b846-e978-3d61-8580-3a0d03a9cf57",
                                                "text": "The slight increase in pre-prandial and post-prandial bile acids are suggestive of hepatic dysfunction, but other causes of slight elevations, such as pancreatic or gastrointestinal disease, cannot be ruled out."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "preprandial",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6779e4b0-cd87-3006-93cd-28bbc55efabe",
                                        "entry_id": "6f4d62df-61c4-3c9d-b1db-17f1900a1201",
                                        "glosses": [
                                            "A predinner drink; an apéritif."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7eb7d3a-e999-4138-b863-f6da0c38a814",
                                                "sense_id": "6779e4b0-cd87-3006-93cd-28bbc55efabe",
                                                "text": "They drink, for one thing, sweet ports as preprandials, anathema to most English, who consider them digestifs, or after-dinner company."
                                            },
                                            {
                                                "example_id": "b54a837c-5805-4ce8-9fc8-66abc4249ba9",
                                                "sense_id": "6779e4b0-cd87-3006-93cd-28bbc55efabe",
                                                "text": "Why have people forsaken martinis, Manhattans, old fashioneds, and other preprandials of long-standing popularity?"
                                            },
                                            {
                                                "example_id": "915710af-4962-413d-ba76-1e58f0772a91",
                                                "sense_id": "6779e4b0-cd87-3006-93cd-28bbc55efabe",
                                                "text": "'How's Allison?' I asked over preprandials. He smiled as I ordered Southern Comfort – no ice, no soda; he liked the idea that some things don't change."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
