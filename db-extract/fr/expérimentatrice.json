                        "sense_id": "73854742-ff97-3e55-8d75-f2a5f84a9cce",
                        "entry_id": "1834a3a6-eca3-3500-bf5a-47ed8f9fc6b8",
                        "glosses": [
                            "Celle qui fait des expériences."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df40b426-ea37-4faa-9cd1-4cfa59c06964",
                                "sense_id": "73854742-ff97-3e55-8d75-f2a5f84a9cce",
                                "text": "Dans deux conditions expérimentales différentes, l’expérimentatrice initiait le nourrisson à une séance de jeu de « coucou me voilà ! » structurée ou bien désorganisée."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
