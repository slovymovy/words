                    },
                    {
                        "form_id": "f9f3ccd3-5de9-49da-acad-699812c0633d",
                        "entry_id": "fcd6ef57-dbae-324f-aedb-c937224665da",
                        "tags": [
                            "plural"
                        ],
                        "form": "Perseidae"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a4eff983-7954-371c-9e3a-81bc9cfbb2bd",
                        "entry_id": "fcd6ef57-dbae-324f-aedb-c937224665da",
                        "glosses": [
                            "A descendant of Perseus."
                        ],
                        "tags": [
                            "Greek"
                        ],
                        "examples": [
                            {
                                "example_id": "39516391-8a86-45ab-8604-53acbce2890b",
                                "sense_id": "a4eff983-7954-371c-9e3a-81bc9cfbb2bd",
                                "text": "Thus the Family of Pelops got the poſſeſſion of two Kingdoms, and became ſuperior in Wealth and Power to the Perſeids their Rivals."
                            },
                            {
                                "example_id": "cefe656c-cb4f-4c01-a38f-9c71c93af2f2",
                                "sense_id": "a4eff983-7954-371c-9e3a-81bc9cfbb2bd",
                                "text": "[…] the Perseids, who reigned at Mycenæ […]"
                            },
                            {
                                "example_id": "7eaf76e7-1cc8-46fd-bf01-7ba994fd7653",
                                "sense_id": "a4eff983-7954-371c-9e3a-81bc9cfbb2bd",
                                "text": "[…] Heracles, who traces his lineage back to the two great families in the Argolid, the Perseids and the Pelopids […]"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "22041c03-22b1-4ea5-9934-c01368234a34",
