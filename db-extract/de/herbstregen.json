                ],
                "senses": [
                    {
                        "sense_id": "ccc7c0fd-5b6b-3aa4-9307-258d36f0a925",
                        "entry_id": "0fdb3003-cb4a-33ec-9b4b-1418f76b36ee",
                        "glosses": [
                            "Regen in der Jahreszeit Herbst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c80f82f2-a3eb-4f1e-a0d9-19c0bb3a62fc",
                                "sense_id": "ccc7c0fd-5b6b-3aa4-9307-258d36f0a925",
                                "text": "„Im Süden kann es sehr trostlos sein, wenn der Herbstregen einsetzt.“"
                            },
                            {
                                "example_id": "d465af87-343c-46fa-9036-28cbb38ac591",
                                "sense_id": "ccc7c0fd-5b6b-3aa4-9307-258d36f0a925",
                                "text": "„Nachdem die Schafherden von den Hochweiden heimgetrieben, der Herbstregen aufgehört, kam klares Wetter mit leichten Nachtfrösten, so daß die Wasserpfützen Eisränder bekamen und Rauhreif an den Gräsern hing.“"
                            },
                            {
                                "example_id": "e862665d-2e2a-4daf-9077-bc394ed62539",
                                "sense_id": "ccc7c0fd-5b6b-3aa4-9307-258d36f0a925",
                                "text": "„Die Heide ist nach dem Herbstregen so aufgeweicht, dass sie mit dem Absteigen und Pinkeln wartet, bis sie steinigeren Untergrund erreicht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
