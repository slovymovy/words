                                "target_senses": [
                                    {
                                        "sense_id": "3ae03cc2-b6b5-36ac-bdc1-088545876619",
                                        "entry_id": "0d41c8cd-4cb7-31e4-bb37-47a33cb4ef40",
                                        "glosses": [
                                            "gelijktijdig gebruik van energie voor verwarming en beweging, zodat er minder van verspild wordt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53e7b60b-a8b1-42c9-b2cd-8b861e5e77eb",
                                                "sense_id": "3ae03cc2-b6b5-36ac-bdc1-088545876619",
                                                "text": "Onze huizen hebben nauwelijks nog energie van buiten nodig. Zonnepanelen op het dak, een warmte-krachtkoppeling en een accu in de bijkeuken zorgen voor een huis waar de elektriciteitsmeter zo goed als op nul kan staan. De energie die we te veel opwekken wordt gedeeld via internet."
                                            },
                                            {
                                                "example_id": "c47c2d82-f537-4d5a-8dc6-3e252de9cc38",
                                                "sense_id": "3ae03cc2-b6b5-36ac-bdc1-088545876619",
                                                "text": "„Ja, deze afkorting staat voor warmte-krachtkoppeling. Het was een installatie in een hal, die het hele fabriekscomplex van 1984 tot 2018 van warmte en elektriciteit heeft voorzien. Het bedrijf was op deze manier geheel zelfvoorzienend. Deze installatie werd aangedreven door een straalmotor van het merk Allison, het tegenwoordige Rolls Royce. Diezelfde motor zit ook in Herculesvliegtuigen. TenCate zocht daarvoor een goede bestemming.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
