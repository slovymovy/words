                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "постига́вши"
                    },
                    {
                        "form_id": "ca2e46c7-3f5f-48be-b621-a835d180ce1c",
                        "entry_id": "8453a24d-dec6-3567-ae73-87762950724a",
                        "tags": [
                            "future"
                        ],
                        "form": "буду/будешь… постига́ть"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "791f810c-a9de-36e6-80f7-03e03856ad3b",
                        "entry_id": "8453a24d-dec6-3567-ae73-87762950724a",
                        "glosses": [
                            "уяснять смысл, значение чего-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a3d331c-6495-4a58-9c60-675c2a00c1f6",
                                "sense_id": "791f810c-a9de-36e6-80f7-03e03856ad3b",
                                "text": "Может быть, единственно оттого мы и не постигаем нравственной гармонии, что она есть высочайшая, совершеннейшая."
                            },
                            {
                                "example_id": "5c7a946e-b542-46df-900a-19570c41d64d",
                                "sense_id": "791f810c-a9de-36e6-80f7-03e03856ad3b",
                                "text": "Он день ото дня более привязывался к государю, лучше постигал его высокую душу."
                            },
                            {
                                "example_id": "49b9290e-fc2d-487f-ba4e-b233c9472fdb",
                                "sense_id": "791f810c-a9de-36e6-80f7-03e03856ad3b",
                                "text": "Я любил эту минуту, когда, возносясь всё выше и выше в области мысли, вдруг постигаешь всю необъятность её и сознаёшь невозможность идти далее."
                            }
                        ]
                    },
                    {
                        "sense_id": "5880ed22-40e1-3dd4-96ae-ff5749740cca",
                        "entry_id": "8453a24d-dec6-3567-ae73-87762950724a",
                        "glosses": [
                            "случаться с кем-либо, выпадать на долю кого-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9853a881-afdc-491f-957f-4a87aa29ed77",
                                "sense_id": "5880ed22-40e1-3dd4-96ae-ff5749740cca",
                                "text": "Может быть, у других это иначе происходит, а меня тревожное ощущение возрастного сдвига постигает ранней весной."
                            },
                            {
                                "example_id": "92efb15e-ac39-4942-ab2f-3d86ca1193c4",
                                "sense_id": "5880ed22-40e1-3dd4-96ae-ff5749740cca",
