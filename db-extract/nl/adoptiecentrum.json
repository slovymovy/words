                        "glosses": [
                            "organisatie die betrokken is bij de adoptie van kinderen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5bbd3d52-3c82-43cc-b582-089a10a16394",
                                "sense_id": "1afff8a6-feaf-33f4-8a2b-d0b7fcdf3ac0",
                                "text": "Een groep Indiase mensenhandelaren heeft een onbekend aantal baby's van hun moeder afgepakt en verkocht aan een adoptiecentrum. De lokale politie zegt dat elf mensen daarvoor zijn opgepakt."
                            },
                            {
                                "example_id": "faf17e21-3244-40ed-81ab-050077f5f80e",
                                "sense_id": "1afff8a6-feaf-33f4-8a2b-d0b7fcdf3ac0",
                                "text": "Adoptie werd populair. Veel kinderen kwamen uit onder andere Korea, India en Indonesië. Hoksbergen en de zijnen waren actief in wat later de bemiddelingsorganisatie Wereldkinderen zou worden. Zijn wetenschappelijke werk op de Utrechtse universiteit mondde uit in het -inmiddels door de universiteit opgeheven- Adoptiecentrum. Het aantal aanvragen voor adoptie liep in die jaren op tot ruim 3000."
                            },
                            {
                                "example_id": "dab5f490-2acd-4f66-a16a-fe6702ce445c",
                                "sense_id": "1afff8a6-feaf-33f4-8a2b-d0b7fcdf3ac0",
                                "text": "De emeritus hoogleraar pleit al jaren voor een adoptiecentrum dat begeleiding moet geven aan adoptieouders. „En vooral nazorg, daar ontbreek het vaak aan.” Hij wil het desnoods zelf opzetten, mits de overheid het financiert."
                            }
                        ]
                    }
