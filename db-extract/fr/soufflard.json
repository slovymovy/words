                        "glosses": [
                            "Trou ou faille par lequel jaillit du gaz ou de la vapeur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fcee654e-d010-406d-a979-95cb85005b82",
                                "sense_id": "3df03cd8-d95e-3cb3-9e88-d77b31b24adb",
                                "text": "Un soufflard de trois mètres de diamètre s'est formé au niveau de la lèvre de ce conduit volcanique. Toutes les minutes environ, il souffle fortement."
                            }
                        ]
                    },
                    {
                        "sense_id": "5c2d1278-c10d-32bc-ac8d-72179ca57312",
                        "entry_id": "c6cc654c-6f8c-3bfc-bea5-0910ceeb8155",
                        "glosses": [
                            "Orifice par lequel le grisou se dégage brusquement, ce jet même."
                        ],
                        "tags": [
                            "Industrie minière"
                        ],
                        "examples": [
                            {
                                "example_id": "b4f93dd8-659e-4eec-a624-808b33bfc799",
                                "sense_id": "5c2d1278-c10d-32bc-ac8d-72179ca57312",
                                "text": "Un soufflard imperceptible dans un trou de mine avait traversé une veinule de charbon et provoqué une explosion bousculant tout sur plus de 500 mètres."
                            },
                            {
                                "example_id": "3b7180d3-8158-432f-93ec-7d8908135e4a",
                                "sense_id": "5c2d1278-c10d-32bc-ac8d-72179ca57312",
                                "text": "Le gaz qui s’enflamma ne provenait pas de la couche exploitée, mais d’un soufflard situé dans une autre couche, à 38 fathoms au-dessous de celle-ci ; l’abondance du gaz inflammable fourni par ce soufflard avait obligé d’abandonner les travaux de la couche inférieure, que l’on avait laissés s’inonder."
                            }
                        ]
                    },
                    {
                        "sense_id": "3b010ad5-914d-3576-bfd0-e8be3e7a5679",
                        "entry_id": "c6cc654c-6f8c-3bfc-bea5-0910ceeb8155",
                        "glosses": [
                            "Nom vulgaire de l'anguille commune."
                        ],
