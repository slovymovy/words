                ],
                "senses": [
                    {
                        "sense_id": "0a204052-5854-3739-910c-75492ec66a65",
                        "entry_id": "3c6f9cc5-16c4-31a4-8d5b-d5bf25d9125c",
                        "glosses": [
                            "innerer Raum eines Autos"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18c957ee-74cf-4806-a96d-aa577f421a6f",
                                "sense_id": "0a204052-5854-3739-910c-75492ec66a65",
                                "text": "„Der ist damit beschäftigt, sein Autoinneres auf Hochglanz zu bringen, und freut sich diebisch über die Reinigungstücher, die er beim Zahnarzt bekommen hat.“"
                            },
                            {
                                "example_id": "625b8f91-f438-45ac-b6ea-6cc42c4eebf9",
                                "sense_id": "0a204052-5854-3739-910c-75492ec66a65",
                                "text": "„Doreen hatte sich deshalb schon auf abgenutzte, verschlissene Sitze und kalten Tabakgeruch eingestellt, war aber positiv überrascht, als sie ein topp gepflegtes Autoinneres vorfand, ganz in glänzend schwarzem Leder.“"
                            },
                            {
                                "example_id": "c9cfd9bc-0cc8-42b3-b915-e14e6a530bd2",
                                "sense_id": "0a204052-5854-3739-910c-75492ec66a65",
                                "text": "„Es wurde im Autoinneren nicht vorrangig nach der Tatwaffe gesucht, sondern nach Hinweisen auf einen Täter.“"
                            },
                            {
                                "example_id": "e3f39ec6-278e-4de8-9a52-3df4bd55f0b6",
                                "sense_id": "0a204052-5854-3739-910c-75492ec66a65",
                                "text": "„Meine Augen gewöhnen sich an die Dunkelheit des Autoinneren und ich mache das verhältnismäßig bleiche Gesicht des Insassen aus.“"
                            },
                            {
                                "example_id": "798c57e5-6c98-48ab-972f-f71809df143a",
                                "sense_id": "0a204052-5854-3739-910c-75492ec66a65",
                                "text": "„Und auch wenn es sich nur um ein simples kleines Auto handelte, so schaute es im Autoinneren doch sehr schön und ordentlich aus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
