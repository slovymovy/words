        "fr-extract.jsonl": [
            {
                "entry_id": "5a598e4a-ae3d-389b-8628-6d8cf8466b0c",
                "word": "kiki",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "46cfbc93-a300-33b1-9969-b4d72e0d941b",
                        "entry_id": "5a598e4a-ae3d-389b-8628-6d8cf8466b0c",
                        "glosses": [
                            "Mesquin, petit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75e7af10-10d8-474b-ab5c-33a2227026ce",
                                "sense_id": "46cfbc93-a300-33b1-9969-b4d72e0d941b",
                                "text": "Ça fait un peu kiki, un peu radin (…) un peu roadster."
                            },
                            {
                                "example_id": "6e3fb31e-d8fe-4d87-a9e7-b4ca2c59cee3",
                                "sense_id": "46cfbc93-a300-33b1-9969-b4d72e0d941b",
                                "text": "Le mobilier est terriblement kiki. Les fauteuils ont l'air de faire la retape et de vous pousser leur mauvais coussin sous la croupe."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "bed358d2-a52f-3baf-b2fb-af1c91ab3b81",
                "word": "Kiki",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "6cd5f21d-e7c8-3b77-81d9-3400edd81718",
                        "entry_id": "bed358d2-a52f-3baf-b2fb-af1c91ab3b81",
                        "glosses": [
                            "Abréviation de Christine et autres prénoms apparentés (Kristina, etc.)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8f9b014-0f25-49e1-8e52-fde0767d97b2",
                                "sense_id": "6cd5f21d-e7c8-3b77-81d9-3400edd81718",
                                "text": "– Tu n’as rien à boire, Kiki ?\n– Kiki apporta sur la table une bouteille de guignolet et quatre verres."
                            },
                            {
                                "example_id": "5af42767-b64b-42d8-83f0-8cda0753d753",
                                "sense_id": "6cd5f21d-e7c8-3b77-81d9-3400edd81718",
                                "text": "Ouais, regarde, Kiki, il neige."
                            },
                            {
                                "example_id": "36cb09ae-e3a0-469e-831b-8b6f15acd2a2",
                                "sense_id": "6cd5f21d-e7c8-3b77-81d9-3400edd81718",
                                "text": "Véritable star dans les années 1960, nageuse de haut niveau pendant dix années puis chanteuse et actrice, Christine Caron, surnommée \"Kiki Caron\", fut la première femme porte-drapeau de la délégation française à des Jeux Olympiques."
                            },
                            {
                                "example_id": "26ec08fd-827a-44d6-bb4c-ce564e04d239",
                                "sense_id": "6cd5f21d-e7c8-3b77-81d9-3400edd81718",
                                "text": "« Kiki » déjà sur le pont"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "5acdf44f-13d2-34cf-a50d-ff37e1778e1a",
