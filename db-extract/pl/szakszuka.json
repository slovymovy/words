                        "target_lang_word": "shakshuka",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "shakshuka",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6dfb5f31-e5ef-34ce-9cbc-a0124787aab3",
                                        "entry_id": "ce309861-09c8-3409-b8ba-b0788b2e26f1",
                                        "glosses": [
                                            "A Maghrebi dish of eggs simmered in a mixture of chopped tomatoes, chilies, cumin, peppers, and onions."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26a338a4-190e-4677-a7ab-77ac06d54a22",
                                                "sense_id": "6dfb5f31-e5ef-34ce-9cbc-a0124787aab3",
                                                "text": "Coordinate term: menemen"
                                            },
                                            {
                                                "example_id": "f1451d51-d059-4464-a63c-9336929044fa",
                                                "sense_id": "6dfb5f31-e5ef-34ce-9cbc-a0124787aab3",
                                                "text": "Shakshuka came out of total obscurity and, in a couple of decades, evolved into one of the symbols of the local food renaissance. It then went on to conquer the world. If asked to name the top iconic Israeli dishes, most people would mention shakshuka next to hummus, falafel, and chopped salad."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
