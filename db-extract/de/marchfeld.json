                "senses": [
                    {
                        "sense_id": "b08b7171-36c6-3c05-960f-dd910e15cac7",
                        "entry_id": "ad589a0f-81f8-3b5f-adce-1d0469beffec",
                        "glosses": [
                            "eine Landschaft im Osten von Niederösterreich"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e1f7ba2-38dd-44e6-8996-350109078a46",
                                "sense_id": "b08b7171-36c6-3c05-960f-dd910e15cac7",
                                "text": "Das Marchfeld befindet sich östlich von Wien."
                            },
                            {
                                "example_id": "86da1ad2-44a0-453b-a11c-ad03b130e7a0",
                                "sense_id": "b08b7171-36c6-3c05-960f-dd910e15cac7",
                                "text": "„Den Kiefern, die im brettelebenen Marchfeld und an der nicht weniger flach verlaufenden Neunkirchner Allee bei Wiener Neustadt die Böden vor Sonne und Austrocknung schützen, macht dieser Wetterstress langsam, aber sicher den Garaus.“"
                            },
                            {
                                "example_id": "f1530f86-8fbf-4ad8-beb6-f2fc4d65d9a3",
                                "sense_id": "b08b7171-36c6-3c05-960f-dd910e15cac7",
                                "text": "„Der provisorische Neubau am Eingang passt auf paradoxe Art zu dem Ort mitten im Marchfeld, dem Gemüsegarten des Landes, und auch zu diesem einstigen Mustergut im sich aufklärenden Reich der Habsburger im 18. Jahrhundert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
