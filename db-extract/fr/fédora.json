                        "glosses": [
                            "Chapeau de feutre classique à bord de largeur moyenne dont la calotte est typiquement fendue."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c20d283-b17e-4577-84ef-e8784d44889f",
                                "sense_id": "48ce7a0e-e45d-32f0-884c-da0a4dbc2706",
                                "text": "Je suis […] très émue lorsque j’arbore un des vrais chapeaux de Jeanne Córdova, un fédora gris à rayure, offert par Lynn Ballen."
                            },
                            {
                                "example_id": "22d2a68a-d58d-4a2b-b902-1dd514e8da2b",
                                "sense_id": "48ce7a0e-e45d-32f0-884c-da0a4dbc2706",
                                "text": "Un vieil homme. Il est sanglé dans une longue gabardine grise à double boutonnage et coiffé d’un fédora sombre."
                            }
                        ]
                    }
