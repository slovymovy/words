                    },
                    {
                        "translation_id": "a3922c9f-f319-4725-ab41-4bb3515f4620",
                        "source_entry_id": "88c7a24e-06ba-37b2-97b1-9c1663e11233",
                        "source_sense_id": "c9527a93-9af2-39e4-8045-e813780bd39c",
                        "target_lang_word": "whistle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "whistle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "339e848c-f9a2-3f0d-800f-224f5af4405f",
                                        "entry_id": "97e4b60f-14d5-397c-a347-f50f6a5f7c60",
                                        "glosses": [
                                            "A device designed to be placed in the mouth and blown, or driven by steam or some other mechanism, to make a whistling sound."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "acc35bcf-94c7-4d02-ad6e-e0db58277504",
                                                "sense_id": "339e848c-f9a2-3f0d-800f-224f5af4405f",
                                                "text": "A lovely crisp exhaust: a feeling of almost unlimited power combined with complete freedom of running: and, to crown it all, a most melodious and wholly American chime whistle—these were my immediate impressions as we stormed rapidly out of Göttingen, intent on winning back some of the lost time."
                                            },
                                            {
                                                "example_id": "a066b975-c5c7-4cab-bc77-1cd578ab3666",
                                                "sense_id": "339e848c-f9a2-3f0d-800f-224f5af4405f",
                                                "text": "One thing I took great care to observe was obedience to the \"whistle\" boards which crop up with great frequency, for failure to sound the whistle, if observed by the gendarmerie, can bring about serious consequences."
                                            },
                                            {
                                                "example_id": "182ef2a1-b0fc-4e5f-9b84-a8a4fecc3fb7",
                                                "sense_id": "339e848c-f9a2-3f0d-800f-224f5af4405f",
                                                "text": "[...] and Temple station, which had to have a very modestly proportioned station building on the insistence of the Duke of Norfolk who owned the land on which it was built, and where the trains under the glass roof of the station were not allowed to blow their whistles, at the insistence of the barristers in the nearby Inns of Court."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ee7fb1bb-e065-313e-afbe-c17437c83cc4",
                                        "entry_id": "97e4b60f-14d5-397c-a347-f50f6a5f7c60",
                                        "glosses": [
                                            "An act of whistling."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "208e6351-6611-38fc-bc38-445daa32490a",
                                        "entry_id": "97e4b60f-14d5-397c-a347-f50f6a5f7c60",
                                        "glosses": [
                                            "A shrill, high-pitched sound made by whistling."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cdfbf01c-a5a4-463f-8a2b-85cca72fbf82",
                                                "sense_id": "208e6351-6611-38fc-bc38-445daa32490a",
                                                "text": "We expressed our readiness, and in ten minutes were in the station wagon, rolling rapidly down the long drive, for it was then after nine.[…]As we reached the lodge we heard the whistle, and we backed up against one side of the platform as the train pulled up at the other."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fdc82def-4c1c-30ee-8489-2bd7e76bcb7a",
                                        "entry_id": "97e4b60f-14d5-397c-a347-f50f6a5f7c60",
                                        "glosses": [
                                            "Any high-pitched sound similar to the sound made by whistling."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e89fe0a6-0237-4272-867f-9005bd156490",
                                                "sense_id": "fdc82def-4c1c-30ee-8489-2bd7e76bcb7a",
                                                "text": "the whistle of the wind in the trees"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df8aa13d-9be8-3ff2-b65a-840ad2136ce8",
                                        "entry_id": "97e4b60f-14d5-397c-a347-f50f6a5f7c60",
                                        "glosses": [
                                            "A suit (from whistle and flute)."
                                        ],
                                        "tags": [
                                            "Cockney",
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "797af794-62d7-4ad6-87a9-e2bed0fc8398",
                                                "sense_id": "df8aa13d-9be8-3ff2-b65a-840ad2136ce8",
                                                "text": "We soldiers changed into our No.1 dress uniforms, Sid into his best whistle and we set off for the church."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a69a6ba-636a-3b36-9030-fc888488eaad",
                                        "entry_id": "97e4b60f-14d5-397c-a347-f50f6a5f7c60",
                                        "glosses": [
                                            "The mouth and throat; so called as being the organs of whistling."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc97e337-2ebf-4d54-91da-d7eefc72d569",
                                                "sense_id": "9a69a6ba-636a-3b36-9030-fc888488eaad",
                                                "text": "Let's […] drink the other cup to wet our whistles."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "whistle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3bde4b32-eecb-37a8-846e-a5b5bdaa6289",
                                        "entry_id": "e1f2a7bf-a827-30e7-9fc5-7213e4090d2a",
                                        "glosses": [
                                            "To make a shrill, high-pitched sound by forcing air through the mouth. To produce a whistling sound, restrictions to the flow of air are created using the teeth, tongue and lips."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bbf4dff8-c137-4613-8ba1-0f2b73bed12a",
                                                "sense_id": "3bde4b32-eecb-37a8-846e-a5b5bdaa6289",
                                                "text": "Never whistle at a funeral."
                                            },
                                            {
                                                "example_id": "14bc97be-aced-4e9b-aa7c-1d7ab018520f",
                                                "sense_id": "3bde4b32-eecb-37a8-846e-a5b5bdaa6289",
                                                "text": "He was whistling a happy tune."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "18338f4c-64bf-39f7-a31c-8f987d74dc50",
                                        "entry_id": "e1f2a7bf-a827-30e7-9fc5-7213e4090d2a",
                                        "glosses": [
                                            "To make a similar sound by forcing air through a musical instrument or a pipe etc."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a2884817-f41e-49a7-a1ae-1fab9d84a496",
                                                "sense_id": "18338f4c-64bf-39f7-a31c-8f987d74dc50",
                                                "text": "The steam train whistled as it passed by."
                                            },
                                            {
                                                "example_id": "706c98c0-f35c-4678-8b9d-e9e3bc6545c9",
                                                "sense_id": "18338f4c-64bf-39f7-a31c-8f987d74dc50",
                                                "text": "It requires quite an orchestra to get a train to start; the guard blows his horn, the stationmaster rings a large bell, and the engine whistles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d7b2a094-e012-383b-b65a-bf93f1c7f305",
                                        "entry_id": "e1f2a7bf-a827-30e7-9fc5-7213e4090d2a",
                                        "glosses": [
                                            "To move in such a way as to create a whistling sound."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "894ae1d9-4097-48ec-9bbf-d2ffce477f60",
                                                "sense_id": "d7b2a094-e012-383b-b65a-bf93f1c7f305",
                                                "text": "A bullet whistled past."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23bd2232-3ccb-3659-820c-5662f46c4dd5",
                                        "entry_id": "e1f2a7bf-a827-30e7-9fc5-7213e4090d2a",
                                        "glosses": [
                                            "To send, signal, or call by a whistle."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cd791832-8e58-36a1-80c0-a2f6bbf87cbb",
                                        "entry_id": "e1f2a7bf-a827-30e7-9fc5-7213e4090d2a",
                                        "glosses": [
                                            "To request admission to Opus Dei, a Roman Catholic organization."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
