{
    "word_family": [
        "slim",
        "slimmer",
        "slimness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "2e34e68c-9c37-3f33-ae6e-fc32c77eb784",
                    "sense_definition": "Making someone appear thinner, or helping someone to lose weight.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dark colors are generally considered more <w>slimming</w> than light ones.",
                            "target_lang_translations": {
                                "nl": "Donkere kleuren worden over het algemeen als meer <w>afkledend</w> beschouwd dan lichte."
                            }
                        },
                        {
                            "text": "She started drinking a special herbal <w>slimming</w> tea every morning.",
                            "target_lang_translations": {
                                "nl": "Ze begon elke ochtend een speciale kruiden-<w>afslankthee</w> te drinken."
                            }
                        }
                    ],
                    "synonyms": [
                        "flattering"
                    ],
                    "antonyms": [
                        "fattening"
                    ],
                    "common_phrases": [
                        "slimming effect",
                        "slimming club",
                        "slimming tea"
                    ],
                    "target_lang_definitions": {
                        "nl": "Iemand slanker doen lijken, of helpen om gewicht te verliezen."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "afslankend",
                                "target_lang_sense_clarification": "kleding of dieetproducten die slanker maken"
                            },
                            {
                                "target_lang_word": "kleed af",
                                "target_lang_sense_clarification": "figuurcorrigerend, kleedt voordelig af"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8ce2886a-1869-3a1f-854c-b3bf9255687c",
                    "sense_definition": "present participle and gerund of <w>slim</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He has been <w>slimming</w> down by eating healthier meals and exercising daily.",
                            "target_lang_translations": {
                                "nl": "Hij is aan het <w>afvallen</w> door gezonder te eten en dagelijks te bewegen."
                            }
                        },
                        {
                            "text": "The company is <w>slimming</w> its workforce to reduce operational costs.",
                            "target_lang_translations": {
                                "nl": "Het bedrijf is zijn personeelsbestand aan het <w>inkrimpen</w> om de bedrijfskosten te verlagen."
                            }
                        }
                    ],
                    "common_phrases": [
                        "slimming down"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle and gerund"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Onvoltooid deelwoord en gerundium van 'to slim': afvallen, vermageren, of inkrimpen."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "afvallen",
                                "target_lang_sense_clarification": "gewicht verliezen"
                            },
                            {
                                "target_lang_word": "vermageren",
                                "target_lang_sense_clarification": "lichamelijk dunner worden"
                            },
                            {
                                "target_lang_word": "inkrimpen",
                                "target_lang_sense_clarification": "van personeelsbestand of organisatie"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "baab8640-560a-353d-82e6-657353db1049",
                    "sense_definition": "The process of reducing size, weight, or personnel; a reduction.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The latest <w>slimmings</w> of the budget forced the clinic to shut its doors.",
                            "target_lang_translations": {
                                "nl": "De recente <w>inkrimpingen</w> van het budget dwongen de kliniek haar deuren te sluiten."
                            }
                        },
                        {
                            "text": "Successful long-term <w>slimming</w> requires a permanent change in daily eating habits.",
                            "target_lang_translations": {
                                "nl": "Succesvol <w>afslanken</w> op de lange termijn vereist een blijvende verandering in dagelijkse eetgewoonten."
                            }
                        }
                    ],
                    "synonyms": [
                        "downsizing",
                        "reduction"
                    ],
                    "target_lang_definitions": {
                        "nl": "Het proces van het verminderen van omvang, gewicht of personeelsbestand; een inkrimping of besparing."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "het afslanken",
                                "target_lang_sense_clarification": "het verminderen van gewicht of organisatieomvang"
                            },
                            {
                                "target_lang_word": "de inkrimping",
                                "target_lang_sense_clarification": "het verkleinen van personeel of budget"
                            },
                            {
                                "target_lang_word": "de afslanking",
                                "target_lang_sense_clarification": "reductie of sanering"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "71bb63e1-1117-3349-919c-0ce7e86ab813",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The <w>Slimmings</w> invited their neighbors over for dinner last Saturday evening.",
                            "target_lang_translations": {
                                "nl": "De familie <w>Slimming</w> nodigde afgelopen zaterdagavond hun buren uit voor het eten."
                            }
                        },
                        {
                            "text": "We met Mr. <w>Slimming</w> at the historical society meeting yesterday.",
                            "target_lang_translations": {
                                "nl": "We ontmoetten meneer <w>Slimming</w> gisteren bij de bijeenkomst van de historische vereniging."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "English family name"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Een familienaam."
                    },
                    "translations": {
                        "nl": []
                    }
                }
            ]
        }
    ]
}