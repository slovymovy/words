{
    "word_family": [
        "nikkel",
        "vernikkeling"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "452debb3-75ec-3b8c-863e-f342def70e17",
                    "sense_definition": "Stijf en grauw worden van de kou.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "kou_lijden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het vroor dat het kraakte en hij stond te <w>vernikkelen</w> buiten de gesloten deur.",
                            "target_lang_translations": {
                                "en": "It was freezing cold and he stood there <w>freezing</w> outside the closed door."
                            }
                        },
                        {
                            "text": "Zonder een warme jas sta je binnen een paar minuten te <w>vernikkelen</w> van de kou.",
                            "target_lang_translations": {
                                "en": "Without a warm coat, you'll be <w>shivering with cold</w> within a few minutes."
                            }
                        }
                    ],
                    "synonyms": [
                        "verkleumen",
                        "koukleumen",
                        "blauwbekken"
                    ],
                    "common_phrases": [
                        "staan te vernikkelen",
                        "vernikkelen van de kou"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Vaak informeel gebruikt om extreme kou uit te drukken."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To become stiff and pale/grey from extreme cold; to freeze or shiver intensely."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "freeze",
                                "target_lang_sense_clarification": "to feel extremely cold"
                            },
                            {
                                "target_lang_word": "shiver with cold",
                                "target_lang_sense_clarification": "to shake from being very cold"
                            },
                            {
                                "target_lang_word": "perish with cold",
                                "target_lang_sense_clarification": "to suffer extremely from cold weather"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d7d14889-5269-3fdc-83da-931bb7074b34",
                    "sense_definition": "Een metalen voorwerp bedekken met een dun laagje nikkel.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "metaalbewerking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Veel onderdelen van klassieke motorfietsen worden <w>vernikkeld</w> om roest te voorkomen.",
                            "target_lang_translations": {
                                "en": "Many parts of classic motorcycles are <w>nickel-plated</w> to prevent rust."
                            }
                        },
                        {
                            "text": "De fabriek besloot om de stalen schroeven te <w>vernikkelen</w> voor een betere glans.",
                            "target_lang_translations": {
                                "en": "The factory decided to <w>nickel-plate</w> the steel screws for a better shine."
                            }
                        }
                    ],
                    "common_phrases": [
                        "onderdelen vernikkelen"
                    ],
                    "target_lang_definitions": {
                        "en": "To coat or plate a metal object with a thin layer of nickel."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "nickel-plate",
                                "target_lang_sense_clarification": "to coat a metal with nickel"
                            },
                            {
                                "target_lang_word": "nickel",
                                "target_lang_sense_clarification": "to plate with nickel"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}