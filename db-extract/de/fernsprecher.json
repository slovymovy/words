                ],
                "senses": [
                    {
                        "sense_id": "4c7b9209-bcc8-33fc-84f5-982e4f81434d",
                        "entry_id": "3097d35c-4ac5-3aa5-b4b0-f8293af0dece",
                        "glosses": [
                            "(heute) handliches (früher stehendes oder beispielsweise an einer Wand befestigtes) [[[Handgerät|Hand-]]|Stand-|Wand-]Gerät für die Übermittlung von Sprache über mehr oder weniger große Entfernungen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "239e11fa-405a-455a-a893-439d3fe93aac",
                                "sense_id": "4c7b9209-bcc8-33fc-84f5-982e4f81434d",
                                "text": "„Dieser alte Hörer entpuppte sich als Fernsprecher von Bell aus dem Jahre 1877.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fc67a2d9-791f-49ca-bb5d-cccbf48adafd",
                        "source_entry_id": "3097d35c-4ac5-3aa5-b4b0-f8293af0dece",
                        "source_sense_id": "4c7b9209-bcc8-33fc-84f5-982e4f81434d",
                        "target_lang_word": "telephone",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "telephone",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "03aeabc2-2074-3a70-ba89-9ad3ce8a7e5c",
                                        "entry_id": "d45c44a5-e860-3745-8f34-7fc62a3ad662",
                                        "glosses": [
                                            "A telecommunication device (originally mechanical, and now electronic) used for two-way talking with another person (now often shortened to phone)."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "eee77136-9473-3cf0-b88e-1d39049e82ad",
                                        "entry_id": "d45c44a5-e860-3745-8f34-7fc62a3ad662",
                                        "glosses": [
                                            "The receiver of such a device."
                                        ],
                                        "tags": [
                                            "countable",
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "024ae73e-5909-3c0e-8510-0b7e2c2adcba",
                                        "entry_id": "d45c44a5-e860-3745-8f34-7fc62a3ad662",
                                        "glosses": [
                                            "The game of Chinese whispers."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e41d8e4-9662-4392-aac8-65ccf5b2b528",
                                                "sense_id": "024ae73e-5909-3c0e-8510-0b7e2c2adcba",
                                                "text": "And since the spring of 1995, no game of telephone has ended without some Simpsons-loving smart-ass dropping “purple monkey dishwasher” into the chain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a94637e7-cab9-3f3d-80cb-6a1d7c8d9ffd",
                                        "entry_id": "d45c44a5-e860-3745-8f34-7fc62a3ad662",
                                        "glosses": [
                                            "Chinese whispers; a situation in which an initial message has been distorted and misunderstood by being passed from person to person."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "abed5a6d-b1bc-49e6-b0d2-303020a46f44",
                                                "sense_id": "a94637e7-cab9-3f3d-80cb-6a1d7c8d9ffd",
                                                "text": "In other words, Jones' career and life may have been derailed because a game of telephone went bad."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "telephone",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b9259861-d74f-3a11-ba12-a9e2b0589a65",
                                        "entry_id": "cc945b59-c990-3a48-8f84-0fb8e52182cf",
                                        "glosses": [
                                            "To (attempt to) contact someone using a telephone."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a74942a1-ca08-4626-b6a1-2c6b2f6c184c",
                                                "sense_id": "b9259861-d74f-3a11-ba12-a9e2b0589a65",
                                                "text": "“I came down like a wolf on the fold, didn’t I ? Why didn’t I telephone ? Strategy, my dear boy, strategy. This is a surprise attack, and I’d no wish that the garrison, forewarned, should escape. …”"
                                            },
                                            {
                                                "example_id": "83dba49f-e8a5-4525-951c-2f9006ac6c41",
                                                "sense_id": "b9259861-d74f-3a11-ba12-a9e2b0589a65",
                                                "text": "Having completed their task, Fireman Page telephoned from a lineside box to the next signal cabin, briefly reported the incident and said that, as no high explosive had dropped and the track was safe, they proposed proceeding \"at caution\"."
                                            },
                                            {
                                                "example_id": "658478a6-9f36-43f7-b9fb-55ed4688a36a",
                                                "sense_id": "b9259861-d74f-3a11-ba12-a9e2b0589a65",
                                                "text": "The length ganger saw the train passing with the van derailed and promptly telephoned the Sandbach signalman, who restored his signals to danger, but not in time to stop the train before the final derailment occurred."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f0a6404a-32f6-3b70-8735-6c7693e4274f",
                                        "entry_id": "cc945b59-c990-3a48-8f84-0fb8e52182cf",
                                        "glosses": [
                                            "To convey (a message) via telephone."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8625dec2-dae0-4aa0-856d-9f9cc5d86c89",
                                                "sense_id": "f0a6404a-32f6-3b70-8735-6c7693e4274f",
                                                "text": "He telephoned what he knew to his chief[.]"
                                            },
                                            {
                                                "example_id": "e86a4cb5-8fa9-4b88-9909-091f7544957d",
                                                "sense_id": "f0a6404a-32f6-3b70-8735-6c7693e4274f",
                                                "text": "David telephoned his apologies to his mother."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dbae4f71-c547-461f-ba2d-43517787a7fa",
                        "source_entry_id": "3097d35c-4ac5-3aa5-b4b0-f8293af0dece",
                        "source_sense_id": "4c7b9209-bcc8-33fc-84f5-982e4f81434d",
                        "target_lang_word": "téléphone",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "téléphone",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1d9b9005-c04a-3e8b-89b0-3ffbda492587",
                                        "entry_id": "7a65d2f4-2a1f-3b96-ac91-9d4e1ff5e741",
                                        "glosses": [
                                            "Appareil utilisé par deux personnes ou plus, pour mener une conversation à distance, qu'il soit fixe (relié à un réseau câblé) ou mobile (communiquant via des ondes radio)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "439504fc-1a93-4793-bbe9-55be5363ad8e",
                                                "sense_id": "1d9b9005-c04a-3e8b-89b0-3ffbda492587",
                                                "text": "Il aperçut non loin un officier de haute taille, en uniforme bleu, qui parlait dans un téléphone portatif […]"
                                            },
                                            {
                                                "example_id": "f798f672-0255-45ba-987b-59f9e5c58265",
                                                "sense_id": "1d9b9005-c04a-3e8b-89b0-3ffbda492587",
                                                "text": "Le cornet à l’oreille, Aïssa, debout près du guéridon où le téléphone communiquant avec la ferme était posé, tapa du pied :\n— Mais qu’est-ce qu’elle fabrique !…"
                                            },
                                            {
                                                "example_id": "7c05b89e-1bcf-474b-be75-a03ac993c5b9",
                                                "sense_id": "1d9b9005-c04a-3e8b-89b0-3ffbda492587",
                                                "text": "Enfin, la pendule-réclame Guérin-Boutron, fixée près d’une cabine de téléphone, marquait une fois pour toutes la demie de minuit, en cas de contestation."
                                            },
                                            {
                                                "example_id": "f1eba895-d3cd-4120-a874-51c083550bff",
                                                "sense_id": "1d9b9005-c04a-3e8b-89b0-3ffbda492587",
                                                "text": "Le téléphone sonna trois fois et Max parla longuement, en fumant. Il gribouillait sur une feuille de papier près de l’appareil."
                                            },
                                            {
                                                "example_id": "d51cccff-51a8-400b-88b8-88a92d3c4d39",
                                                "sense_id": "1d9b9005-c04a-3e8b-89b0-3ffbda492587",
                                                "text": "À l’obsolescence technique s’adjoint donc une obsolescence psychologique : un téléphone de deux ans est ringard, un vêtement de six mois est démodé, un écran plat est déjà bien triste face à une télévision 3D."
                                            },
                                            {
                                                "example_id": "f6a78316-6334-4e02-86ce-93dec57b5824",
                                                "sense_id": "1d9b9005-c04a-3e8b-89b0-3ffbda492587",
                                                "text": "Il avait encore un vieux téléphone couleur coquille d’œuf, avec un cadran et un récepteur qui avait l’air d’un os, relié à l’appareil par un câble à spirales."
                                            },
                                            {
                                                "example_id": "63884d73-5ffa-41d8-baf3-9cd1303cb3bf",
                                                "sense_id": "1d9b9005-c04a-3e8b-89b0-3ffbda492587",
                                                "text": "Le téléphone est « l'un de nos techno-organes externes les plus accessibles et intimes »; …."
                                            },
                                            {
                                                "example_id": "29661d00-2be2-4d00-a6f0-d77e53314b53",
                                                "sense_id": "1d9b9005-c04a-3e8b-89b0-3ffbda492587",
                                                "text": "L'enquête a montré que la voiture était en mode Autopilot au moment de l'accident, mais surtout que le conducteur était en train d'utiliser son téléphone lorsqu'il a entendu un choc"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "84a29d8d-7f18-3c06-b431-2dbbb903dffd",
                                        "entry_id": "7a65d2f4-2a1f-3b96-ac91-9d4e1ff5e741",
                                        "glosses": [
                                            "Service public qui assure les communications par téléphone."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "88863bb5-84fc-4459-842a-679ae72f2a5b",
                                                "sense_id": "84a29d8d-7f18-3c06-b431-2dbbb903dffd",
                                                "text": "Un autre développement majeur des années 70 est rendu possible par la combinaison du circuit intégré et des télécommunications numériques : le commutateur téléphonique automatique. C’est un progrès technique important : d’objet de frustration perpétuelle (Allô ! le 22 à Asnières ?), le téléphone devient soudain fiable, et beaucoup plus utile."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56d4020d-69a6-363b-97bf-c67a0d9d8375",
                                        "entry_id": "7a65d2f4-2a1f-3b96-ac91-9d4e1ff5e741",
                                        "glosses": [
                                            "Bureau où l’on peut se servir du téléphone."
