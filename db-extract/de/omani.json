                    }
                ],
                "senses": [
                    {
                        "sense_id": "67b00006-2823-3b42-a4ac-ae6083f2acc2",
                        "entry_id": "18379257-7775-3a4e-910d-6581176b2ad3",
                        "glosses": [
                            "Staatsbürger von Oman"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8bf69f6b-433e-4c43-95a5-a65f37041a77",
                                "sense_id": "67b00006-2823-3b42-a4ac-ae6083f2acc2",
                                "text": "„Nach einiger Fahrzeit stellte sich heraus, dass ein junger Omani und ich im falschen Bus saßen.“"
                            },
                            {
                                "example_id": "28754f07-4324-4ed8-a51c-680c12c39911",
                                "sense_id": "67b00006-2823-3b42-a4ac-ae6083f2acc2",
                                "text": "„Die ausländischen Arbeitskräfte, zurzeit etwa ein Fünftel der Bevölkerung, sollen zunehmend durch Omanis ersetzt werden – eine Chance für die Frauen, die in den Arbeitsmarkt drängen.“"
                            },
                            {
                                "example_id": "52a45a36-d73c-43cd-93cf-fdb9d25660cf",
                                "sense_id": "67b00006-2823-3b42-a4ac-ae6083f2acc2",
                                "text": "„Bei der Werbung im Ausland helfe der Verbund, sagt der Kurdirektor. Knapp ein Drittel der Besucher sind Ausländer. […] Die Omani, die sogar ihr eigenes Hotel haben, kommen lieber im Sommer, da ist es ihnen schon kühl genug.“"
                            },
                            {
                                "example_id": "5c92fd3e-1e6e-4491-99c8-d8fd4173e4d4",
                                "sense_id": "67b00006-2823-3b42-a4ac-ae6083f2acc2",
                                "text": "„Es ist kein Problem, die Menschen dort beim Baden und Grillen zu fotografieren, mit ihnen ins Gespräch zu kommen und zu einem Lammfleischspieß eingeladen zu werden – die Omanis sind traditionell gastfreundlich.“"
                            },
                            {
                                "example_id": "2747cb76-8539-4b84-8930-6441c43cf1e9",
                                "sense_id": "67b00006-2823-3b42-a4ac-ae6083f2acc2",
                                "text": "„Fahad sieht unsere fragenden Blicke und klärt auf: ‚Jeder Omani kann ab dem 24. Geburtstag schriftlich beim Sultan ein Grundstück erbitten und bekommt es in der Regel auch. […]‘“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
