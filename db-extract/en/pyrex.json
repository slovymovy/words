            {
                "entry_id": "b318fdf7-4277-350c-a1e3-b4d55e065bd3",
                "word": "pyrex",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b08383e0-10bf-3aad-81d3-c073bfa7b009",
                        "entry_id": "b318fdf7-4277-350c-a1e3-b4d55e065bd3",
                        "glosses": [
                            "A kind of heat-resistant borosilicate glass, made by mixing a high concentration of boron oxides into the molten glass to reduce its thermal expansion coefficient."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "23f6db9c-7475-47a6-85f7-1bce6e4886eb",
                                "sense_id": "b08383e0-10bf-3aad-81d3-c073bfa7b009",
                                "text": "This steel tube slips into the pyrex glass focus tube, which is jacketed by a vacuum"
                            },
                            {
                                "example_id": "c1a5ad0f-396d-470d-87f5-7a39c712a51c",
                                "sense_id": "b08383e0-10bf-3aad-81d3-c073bfa7b009",
                                "text": "There is half of a yesteryear's tin of baked beans in a pyrex bowl"
                            },
                            {
                                "example_id": "420b7d7b-5b68-426d-bef0-2e95de51142a",
                                "sense_id": "b08383e0-10bf-3aad-81d3-c073bfa7b009",
                                "text": "I tiptoed into the kitchen, turned on the fluorescent light over the stove, and peered into the oven. It was still warm, though the gas had been turned off. My dinner was there, in a pyrex dish with a cover."
                            }
                        ]
                    },
