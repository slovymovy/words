                ],
                "senses": [
                    {
                        "sense_id": "0bc9e5ac-49b4-3d28-a94a-6c42b0fd483a",
                        "entry_id": "32eaa207-3064-3bb0-ae0d-95a4ba505e98",
                        "glosses": [
                            "геол. пологая синклинальная складка, имеющая форму чаши"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97766d3a-86f2-428b-ba7e-d8f990edf0fc",
                                "sense_id": "0bc9e5ac-49b4-3d28-a94a-6c42b0fd483a",
                                "text": "Положение мульды в зоне стыка Алайского и Ферганского хр. обусловило ее своеобразную брахиморфность и субпараллельность Ферганскому хр."
                            }
                        ]
                    },
                    {
                        "sense_id": "807d1fe8-64f9-3ac2-97d3-503f047a1831",
                        "entry_id": "32eaa207-3064-3bb0-ae0d-95a4ba505e98",
                        "glosses": [
                            "металл. стальная, обычно литая коробка (емкостью 0,25-3,3 м³) для загрузки шихты в печь завалочной машиной"
                        ],
                        "tags": [
                            "в сталеплавильном производстве"
                        ],
                        "examples": [
                            {
                                "example_id": "5fd07ac5-c58e-44c3-b70c-d23170974633",
                                "sense_id": "807d1fe8-64f9-3ac2-97d3-503f047a1831",
                                "text": "Скрапный двор бесперебойно подавал вагонетки с мульдами, подтягивая их на место, откуда завалочная машина брала мульды своим хоботом."
                            }
                        ]
                    },
                    {
                        "sense_id": "2f6a89cb-cee8-3971-8dd4-9145b1dcb8ba",
                        "entry_id": "32eaa207-3064-3bb0-ae0d-95a4ba505e98",
                        "glosses": [
                            "металл. форма (изложница) для отливки чугунных чушек на разливочной машине"
                        ],
                        "tags": [
                            "в доменном производстве"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "07436f2b-83e1-4e18-b1ca-09757eac745b",
                        "source_entry_id": "32eaa207-3064-3bb0-ae0d-95a4ba505e98",
                        "target_lang_word": "Datsche",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Datsche",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bcfaeb6f-8bbb-31b9-ac78-f48ced3c0154",
                                        "entry_id": "8d79a35d-9d33-354d-a04e-cd89be7cb13a",
                                        "glosses": [
                                            "Grundstück mit einem meist kleinen Wochenendhaus, Sommerhaus oder ein Gartenhaus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a30d9b4-133d-4d35-9a17-252ee1a3b81a",
                                                "sense_id": "bcfaeb6f-8bbb-31b9-ac78-f48ced3c0154",
                                                "text": "„In der Umgebung belebten sich halb verlassene Dörfer, die Prager entdeckten das Isergebirge als Erholungsgebiet, wandelten leere Häuser zu Datschen um.“"
                                            },
                                            {
                                                "example_id": "a52dca11-f89e-489b-8c63-c7c7a4927b05",
                                                "sense_id": "bcfaeb6f-8bbb-31b9-ac78-f48ced3c0154",
                                                "text": "„Meine Eltern hatten zu wenig Geld, um ein Grundstück zu pachten, dafür legten sie ihre Ersparnisse mit denen einer befreundeten Familie zusammen und mieteten eine fertige Datsche für drei Jahre.“"
                                            },
                                            {
                                                "example_id": "b9192220-57db-4a27-989e-d8a02bbf30fd",
                                                "sense_id": "bcfaeb6f-8bbb-31b9-ac78-f48ced3c0154",
                                                "text": "„In Meixners Datsche würden sie ungestört reden können.“"
                                            },
                                            {
                                                "example_id": "2f858a9d-4ac4-4cf2-9868-8b8c76d4006c",
                                                "sense_id": "bcfaeb6f-8bbb-31b9-ac78-f48ced3c0154",
                                                "text": "„Zum erstenmal blieben die Häuser der Fremden leer, alte und neue Gebäude in allen Lagen, Fischerhütten und Bungalows in den Wäldern, verrammelte Luxuspaläste und offene Datschen, verlassene Geisterhäuser an leeren Buchten, ein aufgelassenes Gefängnis, ein Restaurant – billig zu kaufen, billiger zu mieten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
