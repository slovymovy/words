                            },
                            {
                                "target_lang_word": "clean",
                                "target_lang_sense_clarification": "free from dirt or impurities"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "чистый",
                                "target_lang_sense_clarification": "без примесей и грязи"
                            },
                            {
                                "target_lang_word": "чистейший",
                                "target_lang_sense_clarification": "высшей степени чистоты"
                            }
                        ]
