    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c0c1e0bf-5e95-3c34-9ca6-8340cd6de9f9",
                    "sense_definition": "Qui est serviable, attentionné et bienveillant envers les autres.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "bienveillance_amabilite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mon voisin est très <w>gentil</w> : il m'aide toujours à porter mes courses."
                        },
                        {
                            "text": "Merci, vous êtes vraiment <w>gentille</w> de m'avoir attendu sous la pluie."
                        }
                    ],
                    "synonyms": [
                        "aimable"
                    ],
                    "antonyms": [
                        "méchant"
                    ],
                    "common_phrases": [
                        "très gentil",
                        "gentil avec tout le monde",
                        "être gentil avec"
                    ]
                },
                {
                    "sense_id": "f05a3929-4230-395c-860c-a52a75ed1823",
                    "sense_definition": "Agréable et aimable dans son attitude, ses paroles ou ses gestes.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "bienveillance_amabilite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il m'a adressé un sourire <w>gentil</w> en entrant dans la pièce."
                        },
                        {
                            "text": "Elle a toujours un mot <w>gentil</w> pour ses collègues le matin."
                        }
                    ],
                    "synonyms": [
                        "aimable"
                    ],
                    "common_phrases": [
                        "un mot gentil",
                        "un sourire gentil"
                    ]
                },
                {
                    "sense_id": "1428d033-a2aa-3a31-aeaf-1ecabea13ad8",
                    "sense_definition": "Sage, tranquille ; se dit surtout d'un enfant qui se comporte bien.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les enfants ont été très <w>gentils</w> pendant tout le voyage en train."
                        },
                        {
                            "text": "Sois <w>gentil</w> et reste tranquille pendant que je téléphone."
                        }
                    ],
                    "antonyms": [
                        "vilain"
                    ],
                    "common_phrases": [
                        "être gentil",
                        "un enfant gentil"
                    ]
                },
                {
                    "sense_id": "7baa132a-1410-3507-a50c-1432f97cddc4",
                    "sense_definition": "Charmant, mignon ; qui a une grâce délicate, surtout en parlant de petites choses ou d'animaux.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "charme_joli",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "C'est une <w>gentille</w> petite maison au bord de la rivière."
                        },
                        {
                            "text": "Nous avons vu un <w>gentil</w> petit chat dans le jardin ce matin."
                        }
                    ],
                    "common_phrases": [
                        "un gentil petit village",
                        "une gentille petite maison"
                    ]
                },
                {
                    "sense_id": "56b687a7-cf01-31a9-a974-130c1edcf688",
                    "sense_definition": "Sympa, chouette ; se dit d'une idée, d'un geste ou d'une attention qui fait plaisir.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "bienveillance_amabilite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Quelle <w>gentille</w> idée de nous apporter des fleurs pour la fête !"
                        },
                        {
                            "text": "Ce serait <w>gentil</w> de nous inviter à dîner samedi soir."
                        }
                    ],
                    "common_phrases": [
                        "une gentille idée",
                        "gentil de ta part"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "emploi familier"
                        }
                    ]
                },
                {
                    "sense_id": "830b8bc0-90fd-36c2-8b9e-cd948f86df27",
