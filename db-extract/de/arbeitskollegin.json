                                "example_id": "dc3aba7f-dc3f-4fdc-8446-2ed09cc81a63",
                                "sense_id": "cd7917a9-1279-3105-9b25-783cd9bd7dac",
                                "text": "„Da sahen ihre Arbeitskolleginnen sie lange an und bliesen mit ihrem Zigarettenrauch große Kringel in die Luft.“"
                            }
                        ],
