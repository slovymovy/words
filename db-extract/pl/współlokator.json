                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "roommate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6a71d14e-3e44-3ede-81c6-a549585957de",
                                        "entry_id": "92805cc9-d147-3c93-9c6b-8c37aa3b2f8d",
                                        "glosses": [
                                            "A person with whom one shares a room, as in a dormitory, barracks, rooming house, or apartment."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "53d80813-e8e2-3038-8632-7237e0b000b9",
                                        "entry_id": "92805cc9-d147-3c93-9c6b-8c37aa3b2f8d",
                                        "glosses": [
                                            "A person sharing the same home albeit not the same room (but generally not a family member or spouse)."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "Canada",
                                            "New-Zealand",
                                            "Philippines",
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cfe9d8b9-1211-49af-b76d-5f0b4f742049",
                                                "sense_id": "53d80813-e8e2-3038-8632-7237e0b000b9",
                                                "text": "I live with Marsha. We’re roommates."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7debddb4-be92-39fc-95be-4607855aabf7",
                                        "entry_id": "92805cc9-d147-3c93-9c6b-8c37aa3b2f8d",
                                        "glosses": [
                                            "A same-sex significant other with whom one lives; a coinhabitant in a non-heterosexual relationship."
                                        ],
                                        "tags": [
                                            "humorous",
                                            "ironic"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ad2400c5-150f-45e0-8658-d4ac26da68ee",
                        "source_entry_id": "c531e2d7-2ee4-3ead-8c66-b21702529906",
                        "source_sense_id": "5a34ba71-c83f-3e93-a820-8ecc51895555",
                        "target_lang_word": "roomie",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "roomie",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8af12c69-ad07-30a3-a428-45fcf1a65a54",
                                        "entry_id": "20fc8f5b-91f7-3e74-951b-7a144ff5af22",
                                        "glosses": [
                                            "A roommate."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "82adc376-0b69-4960-9e42-1e130fdd5917",
                                                "sense_id": "8af12c69-ad07-30a3-a428-45fcf1a65a54",
                                                "text": "“The bed is amazing,” he said and grinned. “Good night, roomie,” he said and chuckled."
                                            },
                                            {
                                                "example_id": "8a10fea1-6f4c-464b-990f-9dfbda16676b",
                                                "sense_id": "8af12c69-ad07-30a3-a428-45fcf1a65a54",
                                                "text": "“Don't you dare, roomie,” he murmured, moving his lips to her jaw."
                                            },
                                            {
                                                "example_id": "3b269bd9-4cfe-4c6c-a1f1-4ae4b4e52386",
                                                "sense_id": "8af12c69-ad07-30a3-a428-45fcf1a65a54",
                                                "text": "The last thing she remembers before drifting off to sleep is seeing her roomie use a disposable razor to shave someone's head."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "98ea65b3-2ff9-426f-b916-053721a393d2",
                        "source_entry_id": "c531e2d7-2ee4-3ead-8c66-b21702529906",
                        "source_sense_id": "5a34ba71-c83f-3e93-a820-8ecc51895555",
                        "target_lang_word": "flatmate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "flatmate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7d09e36d-0763-3eb9-8031-9eba22bb4276",
                                        "entry_id": "34540db6-5445-3453-9984-1b7f586167e7",
                                        "glosses": [
                                            "A person with whom one shares a flat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7df020b2-8d29-4a81-a177-740ec5b8e0ea",
                                                "sense_id": "7d09e36d-0763-3eb9-8031-9eba22bb4276",
                                                "text": "Yet when both Regine and her flatmate are at home they tend to spend their time in their rooms, although Regine (and probably the flatmate too) tends to spend more time in the communal areas of the flat when the other is not at home."
                                            },
                                            {
                                                "example_id": "75c56f4e-62dc-434f-9ef1-5fc446e818bb",
                                                "sense_id": "7d09e36d-0763-3eb9-8031-9eba22bb4276",
                                                "text": "“So, it would probably [be] best if we could find another flatmate and go for a flat of five, and if old Chip does pull out, at least we can then drop down to a flat of four. What do you reckon?”"
                                            },
                                            {
                                                "example_id": "d4269efb-8aa8-4ea4-8fab-2850ae922e58",
                                                "sense_id": "7d09e36d-0763-3eb9-8031-9eba22bb4276",
                                                "text": "Kamal moved Fathi′s things into his own room, and the two became flatmates.\nThe apartment in which Kamal lived was spacious, with several large rooms and various flatmates."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c924ae06-873e-3690-a74c-a83b67a0ef12",
                                        "entry_id": "34540db6-5445-3453-9984-1b7f586167e7",
                                        "glosses": [
                                            "A person with whom one shares any rental dwelling, not necessarily a flat."
                                        ],
                                        "tags": [
                                            "Ireland",
                                            "New-Zealand",
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "01191ea4-f0e3-46e8-9ec1-1fdafe064b9c",
                                                "sense_id": "c924ae06-873e-3690-a74c-a83b67a0ef12",
                                                "text": "It had been weeks since all the flatmates had sat down together for a meal. Communication was breaking down. Written notes had begun to appear all over the house; please don′t touch this food, I bought it especially for Hermione[…]."
                                            },
                                            {
                                                "example_id": "2149c0a7-2c75-464e-9518-510ddb5c5536",
                                                "sense_id": "c924ae06-873e-3690-a74c-a83b67a0ef12",
                                                "text": "One night, one of the flatmates (the one who owned the house) was ranting and raving all night about her girlfriend."
                                            },
                                            {
                                                "example_id": "20debfcb-67bb-445f-b8af-9865e4272ddf",
                                                "sense_id": "c924ae06-873e-3690-a74c-a83b67a0ef12",
                                                "text": "The position may have been different when your client was living in the house with the flatmates."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "816d5f5f-6152-4352-b1b0-c5d649c8f107",
                        "source_entry_id": "c531e2d7-2ee4-3ead-8c66-b21702529906",
                        "source_sense_id": "5a34ba71-c83f-3e93-a820-8ecc51895555",
                        "target_lang_word": "housemate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "housemate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "79a08732-36e7-3788-bc26-38b08fc3ba1d",
                                        "entry_id": "5e853b7e-747a-352c-b4c8-365c676f215a",
                                        "glosses": [
                                            "Someone living in the same house."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f5f2d0a-d6b7-45fe-b4f0-ca16e95820aa",
                                                "sense_id": "79a08732-36e7-3788-bc26-38b08fc3ba1d",
                                                "text": "‘“Housemate”,’ he repeated, disdainfully. ‘What does this word imply?’\n‘That we are two unpartnered people, sharing the cost of the rent on a house, and are not romantically involved.’"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0f6ad8ea-8baf-4c09-9228-b2f93d31a863",
                        "source_entry_id": "c531e2d7-2ee4-3ead-8c66-b21702529906",
                        "source_sense_id": "5a34ba71-c83f-3e93-a820-8ecc51895555",
                        "target_lang_word": "spolubydlící",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "c598dbc5-4b85-4554-90e4-6e4a91f060d3",
                        "source_entry_id": "c531e2d7-2ee4-3ead-8c66-b21702529906",
                        "source_sense_id": "5a34ba71-c83f-3e93-a820-8ecc51895555",
                        "target_lang_word": "colocataire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "colocataire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "72451bd3-296a-3d53-a44a-e1c8b2ec079d",
                                        "entry_id": "e1669f3d-8413-32e0-a42e-ebaba3b14d55",
                                        "glosses": [
                                            "Personne qui vit en colocation, partageant une seule location."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27993d69-d2ed-402f-bb1d-97981c324c2e",
                                                "sense_id": "72451bd3-296a-3d53-a44a-e1c8b2ec079d",
                                                "text": "Appelant à l’aide, elle est secourue par les deux colocataires du prévenu."
                                            },
                                            {
                                                "example_id": "613fc7d0-3cd0-4fd5-a2ac-fd8d4c997564",
                                                "sense_id": "72451bd3-296a-3d53-a44a-e1c8b2ec079d",
                                                "text": "Claude commence le travail très tôt le matin et se couche également tôt le soir, alors que son colocataire suit un horaire décalé de plusieurs heures par rapport au sien. Le colocataire de Michel passe souvent la journée à la maison […]."
                                            },
                                            {
                                                "example_id": "5fa52ecd-cd25-43d6-b502-8ffd85cd56de",
                                                "sense_id": "72451bd3-296a-3d53-a44a-e1c8b2ec079d",
                                                "text": "Les trois colocataires, bouleversés par la disparition de leur amie, se serrent les coudes comme une vraie famille."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4522a143-0021-3116-bf00-99f6deba2005",
                                        "entry_id": "e1669f3d-8413-32e0-a42e-ebaba3b14d55",
                                        "glosses": [
                                            "Personne qui vit dans un immeuble de location en commun."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e604e334-f712-4189-a223-d26816db8a80",
                                                "sense_id": "4522a143-0021-3116-bf00-99f6deba2005",
                                                "text": "En cas d’incendie détruisant l’immeuble loué, tous les locataires sont responsables de l’incendie proportionnellement à la valeur de la partie du bâtiment qu’ils occupent.\nChaque colocataire peut rapporter la preuve que l’incendie n’a pas éclaté chez lui […] ; dans ce cas il n’est pas tenu de participer à l’indemnisation […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
