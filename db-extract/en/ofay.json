                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "4704a5da-bee0-42e3-9d47-e9886385d671",
                        "entry_id": "6f9874c0-4956-34ff-aec1-a4c4d60ef7b7",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more ofay"
                    },
                    {
                        "form_id": "a1c369b9-8855-4e71-9a13-a8a2dd7ea391",
                        "entry_id": "6f9874c0-4956-34ff-aec1-a4c4d60ef7b7",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most ofay"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a5f71cb8-68c8-33f6-bb9f-aa86c3275793",
                        "entry_id": "6f9874c0-4956-34ff-aec1-a4c4d60ef7b7",
                        "glosses": [
                            "White; white-skinned."
                        ],
                        "tags": [
                            "US",
                            "ethnic",
                            "slang",
                            "slur"
                        ],
                        "examples": [
                            {
                                "example_id": "18768754-8cef-4e91-9a86-8645d544497c",
                                "sense_id": "a5f71cb8-68c8-33f6-bb9f-aa86c3275793",
                                "text": "“You better tell your little ofay kid friend move along.”"
                            },
                            {
                                "example_id": "7a8f7445-dccf-4fac-bb52-dacf28b7b4f5",
                                "sense_id": "a5f71cb8-68c8-33f6-bb9f-aa86c3275793",
                                "text": "‘Baby,’ April Elgar said, ‘you may be an uptight ofay milk-toast limey bastard, but you ain’t no fag.’"
                            },
                            {
                                "example_id": "f2c80ec4-4157-4d2a-83f2-89a2139719f9",
                                "sense_id": "a5f71cb8-68c8-33f6-bb9f-aa86c3275793",
                                "text": "Everything is strictly peachy keen, as the ofay kids say."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "2f4ad610-ff96-3284-915c-f89216291b97",
                "word": "ofay",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "1afcc49b-0418-4bc4-b47a-4559b8ed319e",
                        "entry_id": "2f4ad610-ff96-3284-915c-f89216291b97",
                        "tags": [
                            "plural"
                        ],
                        "form": "ofays"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "50551156-bf40-3bc5-a769-543cf2fad030",
                        "entry_id": "2f4ad610-ff96-3284-915c-f89216291b97",
                        "glosses": [
                            "A white person."
                        ],
                        "tags": [
                            "US",
                            "ethnic",
                            "slang",
                            "slur"
                        ],
                        "examples": [
                            {
                                "example_id": "b411780e-14ee-4b22-87f3-276dea92489a",
                                "sense_id": "50551156-bf40-3bc5-a769-543cf2fad030",
                                "text": "For example we have words like ofay, pink, fade, space, Mr. Charlie, cracker, peckawood, hoojah, and so on—nice words and bitter."
                            },
                            {
                                "example_id": "26e1346c-7f0b-4d50-84d6-e44c21a72349",
                                "sense_id": "50551156-bf40-3bc5-a769-543cf2fad030",
                                "text": "You get outa my alley, Lucas -- and take that ofay with you, hear?"
                            },
                            {
                                "example_id": "37deac4f-1b2a-4a15-af03-27f8f66c3c0d",
                                "sense_id": "50551156-bf40-3bc5-a769-543cf2fad030",
                                "text": "The rival, the foe, the ofay, veins stretched and bulged between white knuckles."
                            }
                        ]
                    }
                ],
