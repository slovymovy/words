                                    },
                                    {
                                        "sense_id": "42661600-476a-3099-a148-ca9ea40114cc",
                                        "entry_id": "ab42c4f4-3a94-370b-a9f9-3bafd8eac1fa",
                                        "glosses": [
                                            "Gril pour boucaner. ^([2])"
                                        ],
                                        "tags": [
