                "senses": [
                    {
                        "sense_id": "2a1f6ab9-dc7f-3c3d-9361-6292e16a097b",
                        "entry_id": "edec978b-dd4e-33ac-b168-9cfa4bdc2e6a",
                        "glosses": [
                            "To undo the result of brushing."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c1a3796-cf2a-4a13-80b7-c27c47159ff8",
                                "sense_id": "2a1f6ab9-dc7f-3c3d-9361-6292e16a097b",
                                "text": "Your hair is brushed very nicely, but just unbrush it a minute so that they can see the scar."
                            },
                            {
                                "example_id": "96c2de9f-8aba-4f4a-ae3a-c8952ab56cdb",
                                "sense_id": "2a1f6ab9-dc7f-3c3d-9361-6292e16a097b",
                                "text": "You can tease a wig by back brushing. If you want a little fullness only, the fibers should be held at a forward angle while brushing. For medium fullness, hold the strands straight up and back brush. Be sure you unbrush the teasing before you wash your wig."
                            },
                            {
                                "example_id": "9353679b-ea4b-488d-90b8-e2c7559bf14c",
                                "sense_id": "2a1f6ab9-dc7f-3c3d-9361-6292e16a097b",
                                "text": "I could also unbrush this effect. By lightly brushing over the distorted area (with the erase function), I made the vehicle's original shape gradually reappear."
                            },
                            {
                                "example_id": "71a025b4-9c04-4a04-b79f-0bb3ea5d3f6e",
                                "sense_id": "2a1f6ab9-dc7f-3c3d-9361-6292e16a097b",
                                "text": "Like every morning he shuffled into the bathroom to stick extra stubble on his chin and to unbrush his teeth."
                            }
                        ]
                    }
                ],
