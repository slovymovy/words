                                "target_senses": [
                                    {
                                        "sense_id": "8d88a183-721f-3bf8-93dd-5c4f77797496",
                                        "entry_id": "da125068-519b-38af-8419-f23b0d9816b8",
                                        "glosses": [
                                            "een traditioneel Grieks (fastfood)gerecht bestaande uit aan een grote spies gegrild varkensvlees, in reepjes gesneden en gekruid afgeleid van het Turkse döner kebab"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f6a64a3-95e3-4b27-af36-ea354f4ed14d",
                                                "sense_id": "8d88a183-721f-3bf8-93dd-5c4f77797496",
                                                "text": "Je tanden zetten in een pittige Varoufakis? In een taaie Dijsselbloem? Of in een niet te versmaden Merkel? In Grieks restaurant Corfu aan de Waalkade in Nijmegen kun je sinds het weekeinde een heuse Dijsselbloemschotel, met souvlaki, souzuki en gyros, bestellen."
                                            },
                                            {
                                                "example_id": "e9cbee7d-7c44-4eba-af7f-4b32dc72b55c",
                                                "sense_id": "8d88a183-721f-3bf8-93dd-5c4f77797496",
                                                "text": "Het land van de gyros en moussaka scoort dit jaar onder Nederlanders 65 procent hoger op Google dan vorig jaar. Turkije nam 14 procent af, wegens de politieke onrust en angst voor terrorisme."
                                            },
                                            {
                                                "example_id": "9886dc3a-3281-44b0-ae8f-7653b2698530",
                                                "sense_id": "8d88a183-721f-3bf8-93dd-5c4f77797496",
                                                "text": "Heb je een Turks brood weleens geprobeerd te vullen? Wij doen het namelijk regelmatig. Het is niet alleen lekker als makkelijk diner, maar ook ideaal als je een borrel moet verzorgen. Even de oven in en klaar is je broodje gyros XL!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
