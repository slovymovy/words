                    },
                    {
                        "form_id": "bf00b7d5-5e58-41bb-9067-61516bfc2204",
                        "entry_id": "a0d760e1-15fd-3880-b1a6-463649115593",
                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "причеса́вшись"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "03856a4d-ef0a-3015-a20c-95a6733d3b26",
                        "entry_id": "a0d760e1-15fd-3880-b1a6-463649115593",
                        "glosses": [
                            "причесать себе волосы, сделать себе причёску"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8659c151-1a50-4eb5-b077-54236ddae1eb",
                                "sense_id": "03856a4d-ef0a-3015-a20c-95a6733d3b26",
                                "text": "Отдохнув, я причесался, почистился и сошёл вниз к чаю."
                            },
                            {
                                "example_id": "96ea2b5e-b88e-4e4b-8ea4-612d8febc7e7",
                                "sense_id": "03856a4d-ef0a-3015-a20c-95a6733d3b26",
                                "text": "Причесаться в парикмахерской."
                            },
                            {
                                "example_id": "da46fbe2-2121-4ded-9b5c-aa8a07dcb30a",
                                "sense_id": "03856a4d-ef0a-3015-a20c-95a6733d3b26",
                                "text": "Как оделась и причесалась, ну просто очарование!"
                            },
                            {
                                "example_id": "4cfe472b-2013-4e5b-81b5-975db7b53b76",
                                "sense_id": "03856a4d-ef0a-3015-a20c-95a6733d3b26",
                                "text": "Она уже причесалась и подкрасилась, и на ней был не халат, а домашнее платье, самое его любимое, ярко-синее с большим вырезом."
                            },
                            {
                                "example_id": "baf1ae6d-7a19-4a56-ac40-de201db0f92a",
                                "sense_id": "03856a4d-ef0a-3015-a20c-95a6733d3b26",
                                "text": "Жихарь причесался пятернёй, застегнул одёжную обновку на прехитрый замок, как учил торговец, и приблизился к идолу."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2f326873-327b-4d07-8641-03af3563f44c",
                        "source_entry_id": "a0d760e1-15fd-3880-b1a6-463649115593",
                        "source_sense_id": "03856a4d-ef0a-3015-a20c-95a6733d3b26",
                        "target_lang_word": "se coiffer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "se coiffer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b6db5df5-35b1-3176-9736-614dd4be556d",
                                        "entry_id": "48cd1973-030e-3730-9658-e9b9b34dfcaf",
                                        "glosses": [
                                            "Forme pronominale de coiffer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "413032d4-d7ae-46a2-b872-d19cbe900884",
                                                "sense_id": "b6db5df5-35b1-3176-9736-614dd4be556d",
                                                "text": "[…], il avait chaussé de gros souliers à clous et il s’était coiffé d’un chapeau à larges bords comme les forts de la halle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "839047d5-9d0f-46ca-8195-4e15f55fe7e1",
                        "source_entry_id": "a0d760e1-15fd-3880-b1a6-463649115593",
                        "source_sense_id": "03856a4d-ef0a-3015-a20c-95a6733d3b26",
                        "target_lang_word": "se peigner",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "se peigner",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2271fc44-6ade-344d-9cc6-a1c56aec2d25",
                                        "entry_id": "c820ec35-4340-32fb-96b4-49c1aa66677e",
                                        "glosses": [
                                            "Forme pronominale de peigner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10f23fb3-496a-4960-bff8-f09e96459cee",
                                                "sense_id": "2271fc44-6ade-344d-9cc6-a1c56aec2d25",
                                                "text": "Elle se peignait. Elle ramenait ses cheveux noirs sur son épaule et les peignait avec lenteur parce qu’elle avait bien le temps de voir ce qui allait arriver."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
