                    "frequency": "High",
                    "semantic_group_id": "habitat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ils ont décidé de passer leurs vacances dans un petit <w>village</w> de montagne."
                        },
                        {
                            "text": "Mon grand-père a toujours vécu dans son <w>village</w> natal près de la côte."
                        }
                    ],
                    "synonyms": [
                        "bourgade"
                    ],
                    "antonyms": [
                        "ville"
                    ],
                    "common_phrases": [
