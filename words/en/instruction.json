{
    "word_family": [
        "instruct",
        "instructor",
        "instructional",
        "instructive"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b9cc7fbb-1cd6-3a11-9689-2a40f318e7a8",
                    "sense_definition": "A set of directions provided by a manufacturer for the users of a product or service.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please read the <w>instructions</w> carefully before assembling the furniture.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, внимательно прочитайте <w>инструкцию</w> перед сборкой мебели.",
                                "pl": "Proszę uważnie przeczytać <w>instrukcję</w> przed montażem mebli.",
                                "zh": "在组装家具前，请仔细阅读<w>说明书</w>。"
                            }
                        },
                        {
                            "text": "The box contains full <w>instructions</w> on how to operate the machine.",
                            "target_lang_translations": {
                                "ru": "В коробке находится полная <w>инструкция</w> по эксплуатации машины.",
                                "pl": "Pudełko zawiera pełną <w>instrukcję</w> obsługi urządzenia.",
                                "zh": "盒子里有关于如何操作这台机器的完整<w>说明</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "follow instructions",
                        "read the instructions",
                        "operating instructions"
                    ],
                    "target_lang_definitions": {
                        "ru": "Набор указаний от производителя для пользователей продукта или услуги",
                        "pl": "Zbiór wskazówek dostarczonych przez producenta dla użytkowników produktu lub usługi.",
                        "zh": "由制造商为产品或服务用户提供的操作指南。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "инструкция",
                                "target_lang_sense_clarification": "документ с правилами использования"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "instrukcja",
                                "target_lang_sense_clarification": "dokument z zasadami użytkowania"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "说明书",
                                "target_lang_sense_clarification": "产品使用指南"
                            },
                            {
                                "target_lang_word": "指南",
                                "target_lang_sense_clarification": "操作说明"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8ad274ad-95b5-3e25-a9cf-5f82c1393b02",
                    "sense_definition": "An authoritative order or command.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldiers received strict <w>instructions</w> to stay at their posts.",
                            "target_lang_translations": {
                                "ru": "Солдаты получили строгие <w>указания</w> оставаться на своих постах.",
                                "pl": "Żołnierze otrzymali surowe <w>rozkazy</w>, aby pozostać na swoich stanowiskach.",
                                "zh": "士兵们收到了必须坚守岗位的严格<w>指示</w>。"
                            }
                        },
                        {
                            "text": "I have <w>instructions</w> to call the manager immediately if there is a problem.",
                            "target_lang_translations": {
                                "ru": "У меня есть <w>указания</w> немедленно позвонить менеджеру в случае возникновения проблемы.",
                                "pl": "Mam <w>polecenie</w> natychmiastowego skontaktowania się z kierownikiem w razie problemów.",
                                "zh": "我有<w>指令</w>，如果出现问题要立即给经理打电话。"
                            }
                        }
                    ],
                    "synonyms": [
                        "advice",
                        "counsel"
                    ],
                    "common_phrases": [
                        "strict instructions",
                        "await instructions",
                        "specific instructions"
                    ],
                    "target_lang_definitions": {
                        "ru": "Авторитетный приказ или распоряжение",
                        "pl": "Oficjalne lub stanowcze polecenie bądź nakaz.",
                        "zh": "权威性的命令或指示。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "указание",
