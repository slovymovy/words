                ],
                "senses": [
                    {
                        "sense_id": "c94bd228-010c-3c7a-a154-b1eeca948460",
                        "entry_id": "492b2a52-f8c4-3df7-bd9d-2adcb50d202f",
                        "glosses": [
                            "(männliche^☆) Person, die nicht genug zu essen bekommt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "debe48f6-338e-40a8-9fb4-1edb73dac888",
                                "sense_id": "c94bd228-010c-3c7a-a154-b1eeca948460",
                                "text": "„Jeder neunte Mensch weltweit hungert. Die meisten Hungernden sind nicht von einer akuten Katastrophe betroffen - sie hungern chronisch.“"
                            },
                            {
                                "example_id": "3cf39c73-38e1-49ba-b253-2d2eb0cac383",
                                "sense_id": "c94bd228-010c-3c7a-a154-b1eeca948460",
                                "text": "„Als Hungernde gelten nach FAO nur jene Menschen, die ein ganzes Jahr lang hungern.“"
                            },
                            {
                                "example_id": "fabeff0b-06d7-49c9-a5b1-6cf362a632f3",
                                "sense_id": "c94bd228-010c-3c7a-a154-b1eeca948460",
                                "text": "[Schlagzeile:] „Zahl der weltweit Hungernden ist 2021 stark gestiegen“"
                            },
                            {
                                "example_id": "f7ed102b-c7ff-4f1c-9914-3a63092dd557",
                                "sense_id": "c94bd228-010c-3c7a-a154-b1eeca948460",
                                "text": "„Die Zahl der Hungernden ist auf rund fünf Millionen Menschen gestiegen, allein in Burkina Faso hat sie sich innerhalb eines Jahres verdreifacht.“"
                            },
                            {
                                "example_id": "91460ed2-2653-4fa0-be68-dfd8eb3b768b",
                                "sense_id": "c94bd228-010c-3c7a-a154-b1eeca948460",
                                "text": "[Russischer Angriffskrieg auf die Ukraine:] „Laut ersten Prognosen der Welternährungsorganisation (FAO) wird der Krieg zu einem weiteren drastischen Anstieg der Zahl der Hungernden führen.“"
                            },
                            {
                                "example_id": "49f3f2e2-95f9-4bb1-ac5c-9269a29f8b56",
                                "sense_id": "c94bd228-010c-3c7a-a154-b1eeca948460",
                                "text": "„Während der Hungerkatastrophe von 1424 setzte er sich über den Rat der Minister hinweg und versorgte die Hungernden mit Lebensmitteln.“"
                            },
                            {
                                "example_id": "6045cfa0-3cb2-49ad-99a2-0e544c172cdb",
                                "sense_id": "c94bd228-010c-3c7a-a154-b1eeca948460",
                                "text": "„Rechts von Elisabeth steht eine Frau mit einem Brotkorb, aus dem sie an die Hungernden austeilt.“"
                            },
                            {
                                "example_id": "99d3e0f0-80ae-4e0e-a7ea-4c10b31e3aac",
                                "sense_id": "c94bd228-010c-3c7a-a154-b1eeca948460",
                                "text": "„Allein mit den Lebensmitteln, die in Europa und Nordamerika weggeworfen werden, könnten alle Hungernden der Welt dreimal satt werden.“"
                            },
                            {
                                "example_id": "d4bd46c5-2deb-4a4c-94f8-62c5f005fcf9",
                                "sense_id": "c94bd228-010c-3c7a-a154-b1eeca948460",
                                "text": "[2. August 1921:] „Der Vorsitzende des Rates der Volkskommissare, Wladimir I. Lenin, bittet die Industrienationen um Hilfe für die Hungernden in Sowjetrussland.“"
                            },
                            {
                                "example_id": "78547d87-185c-427d-84a3-ddcae96b2eb7",
                                "sense_id": "c94bd228-010c-3c7a-a154-b1eeca948460",
                                "text": "[18. April 2000:] „Rom: Die Vereinten Nationen fordern 2 Mio. t Nahrungsmittelhilfen für die Hungernden am Horn von Afrika.“"
                            },
                            {
                                "example_id": "da9a5ef1-7ee4-4770-9013-2d04175deeb5",
                                "sense_id": "c94bd228-010c-3c7a-a154-b1eeca948460",
                                "text": "[…] „die politische Relevanz chronischer Mangelernährung“ [ist] „für Regierungen“ [gering.] „Sie betraf in den vergangenen Jahrzehnten vor allem ländliche Regionen, die Hungernden sind (trotz ihrer großen Zahl) marginalisiert und vereinzelt, der Hunger ist alltäglich.“"
                            },
                            {
                                "example_id": "6854055e-e1ea-46ee-ab92-4860f78b479d",
                                "sense_id": "c94bd228-010c-3c7a-a154-b1eeca948460",
                                "text": "„»Es ist ein Skandal, dass von den 800 Millionen Unterernährten und Hungernden in der Welt drei Viertel Landbevölkerung sind. Menschen, deren Hungerproblem wir mit unserem heutigen Wissen und mit der Innovation in den Bewirtschaftungsmethoden lösen könnten.«“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
