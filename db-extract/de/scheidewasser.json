                    {
                        "translation_id": "9eb837d3-7229-47fe-a42b-44fb2efc6f93",
                        "source_entry_id": "cabf52fe-9bad-3995-8529-20f26ce06378",
                        "source_sense_id": "b2898fa5-2782-3653-a645-72254cc48acd",
