                ],
                "senses": [
                    {
                        "sense_id": "da39dbe5-ae96-3a7f-82df-dcecc9500666",
                        "entry_id": "da28961d-cc5a-369c-b113-6c91ca9112db",
                        "glosses": [
                            "durch ein bauliches Gefälle (Neigung) der Rohrleitung oder offenem Gerinne vorgegebenen Fließrichtung"
                        ],
                        "tags": [
                            "jargon"
                        ],
                        "examples": [
                            {
                                "example_id": "da791375-a86c-456f-8927-30ed957102b2",
                                "sense_id": "da39dbe5-ae96-3a7f-82df-dcecc9500666",
                                "text": "„Neben der Ausführung für den Abzug im Freigefälle gibt es auch die Variante mit Pumpe, zudem besteht die Option, den Dekanter während Mischen/Belüften mit Hilfe eines Linearantriebes gegen das Eindringen von Schlammpartikeln zu verschliessen.“"
                            },
                            {
                                "example_id": "33114c28-5dea-4b10-a822-e5c5fa786b80",
                                "sense_id": "da39dbe5-ae96-3a7f-82df-dcecc9500666",
                                "text": "„Im wesentlichen war nur aus den Ortsteilen Neunkirchen, Neunkirchen-Hohn und Eischeid eine Ableitung des Abwassers im Freigefälle möglich.“"
                            },
                            {
                                "example_id": "d937bc08-ab05-47a8-9b75-4762c008e5b2",
                                "sense_id": "da39dbe5-ae96-3a7f-82df-dcecc9500666",
                                "text": "„Die auf öffentlichem Grund zu verlegenden Leitungen könnten mit Freigefälle bis zum Ortsausgang in Richtung Hiddingen geführt werden, wo ein Pumpwerk gebaut werden muss, das das Abwasser über eine 1.470 Meter lange Druckleitung zum bestehenden Netz in Hiddingen-Battenbrock befördert, von wo aus es weiter zur Kläranlage Visselhövede befördert wird.“"
                            },
                            {
                                "example_id": "7a4d5c24-ae06-4609-9e34-c99b37a1ac19",
                                "sense_id": "da39dbe5-ae96-3a7f-82df-dcecc9500666",
                                "text": "„Nicht überall ist die problemlose Entsorgung von Abwasser über das Freigefälle in die Kanalisation möglich.“"
                            },
                            {
                                "example_id": "c7a11f52-725b-40ef-9fd4-7cdb6a21c396",
                                "sense_id": "da39dbe5-ae96-3a7f-82df-dcecc9500666",
                                "text": "„Zum Einsatz kommen dabei die verschiedensten Kanalisationssysteme, welche das Schmutzwasser im Freigefälle (Freigefälleentwässerung), über Druckleitungen (Druckentwässerung) und über Unterdruck- bzw. Vakuumleitungen (Vakuumentwässerung) zum Ortshauptpumpwerk oder zur Ortskläranlage transportieren.“"
                            },
                            {
                                "example_id": "57596726-c6d6-4091-b229-c1bda3a7f80e",
                                "sense_id": "da39dbe5-ae96-3a7f-82df-dcecc9500666",
                                "text": "„Im Bereich Grüne Schweiz war ein Anschluss der Grundstücke im Freigefälle nicht möglich, hier wurde auf ca. 250 m parallel zum Schmutzwasserkanal eine Abwasserdruckleitung verlegt und ein Pumpwerk errichtet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
