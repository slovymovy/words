                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0f633500-3ab8-421d-9587-ba14649e32fc",
                        "source_entry_id": "43c5d655-b342-3629-9e54-d8eaad956532",
                        "source_sense_id": "c94a62dc-e079-3d2c-9bd3-59f57e2dc29f",
                        "source_sense_description": "Mittel, das den Geschlechtstrieb, die sexuelle Lust dämpft",
                        "target_lang_word": "anaphrodisiaque",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anaphrodisiaque",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9732a47b-ccb4-3175-bff5-9b12b98ae3bf",
                                        "entry_id": "8eb7e63b-81fa-31e0-93b8-b3406df70f84",
                                        "glosses": [
                                            "Qui amortit les désirs sexuels."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ccd4fc00-c07e-4ec0-b16a-9105fb33997a",
                                                "sense_id": "9732a47b-ccb4-3175-bff5-9b12b98ae3bf",
                                                "text": "Le houblon est une plante anaphrodisiaque."
                                            },
                                            {
                                                "example_id": "dafb94af-6444-4b7c-ab5e-23b6870fe515",
                                                "sense_id": "9732a47b-ccb4-3175-bff5-9b12b98ae3bf",
                                                "text": "Il faudra éviter la laitue, la bière, le vin, l’alcool et le tabac en trop grande quantité, l’odeur de camphre et surtout le café noir, qui sont anaphrodisiaques, c’est à dire qui ont pour effet d’éteindre, partiellement au moins, les désirs amoureux."
                                            },
                                            {
                                                "example_id": "9b191fb8-9b47-4716-9076-73967354b037",
                                                "sense_id": "9732a47b-ccb4-3175-bff5-9b12b98ae3bf",
                                                "text": "Mais, comme on n’a même pas pris la peine d’arroser chacune d’elles d’une manière spécifique – ils emploient des arrosoirs automatiques – il tombe sous le sens que la seule et même vertu d’une infusion aphrodisiaque et d’une infusion anaphrodisiaque, par exemple, est d’enrichir les mercantis."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "anaphrodisiaque",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "767231fb-77f8-3961-a9cf-e6e9681bafb8",
                                        "entry_id": "2b528665-00fc-373d-85ca-f8e1716b7f7c",
                                        "glosses": [
                                            "Produit, substance, qui calme, voire inhibe, les désirs sexuels."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3dbb3d0-3c0a-4fc1-9698-59c34c8aba98",
                                                "sense_id": "767231fb-77f8-3961-a9cf-e6e9681bafb8",
                                                "text": "Un anaphrodisiaque apaise les feux ardents de la concupiscence."
                                            },
                                            {
                                                "example_id": "33dff113-99fa-4b0d-ac92-55726001a01e",
                                                "sense_id": "767231fb-77f8-3961-a9cf-e6e9681bafb8",
                                                "text": "L’agnos avait aussi la réputation d’être un anaphrodisiaque efficace."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
