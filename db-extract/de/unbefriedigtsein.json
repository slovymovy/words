                        "examples": [
                            {
                                "example_id": "d86207ee-dfd0-42e0-84c3-96577fa72a75",
                                "sense_id": "523ccc35-f810-3645-bb2f-b42ac0c623ea",
                                "text": "Antrieb des Handelns ist das Unbefriedigtsein. […] Doch damit gehandelt werde, muss zum Unbefriedigtsein und zum Wissen von einem Zustand, der besser befriedigen würde, noch ein Weiteres hinzutreten: die Meinung, dass man fahig sei, durch sein Verhalten das Unbefriedigtsein zu beheben oder doch wenigstens zu mildern.",
                                "translation": "The impetus for action is dissatisfaction. … But for action to be taken, in addition to dissatisfaction and the knowledge of a state that would be more satisfying, there must be another factor: the opinion that one is capable of remedying or at least alleviating the dissatisfaction through one's behaviour.",
                                "english": "The impetus for action is dissatisfaction. … But for action to be taken, in addition to dissatisfaction and the knowledge of a state that would be more satisfying, there must be another factor: the opinion that one is capable of remedying or at least alleviating the dissatisfaction through one's behaviour."
                            }
                        ]
                    }
