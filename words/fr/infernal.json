            "senses": [
                {
                    "sense_id": "f2ea9f0c-f1ac-3b31-81a4-62fade5404c8",
                    "sense_definition": "Extrêmement fort, assourdissant et pénible à supporter.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "intensite_penible",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les ouvriers du chantier font un bruit <w>infernal</w> depuis le début de la matinée."
                        },
                        {
                            "text": "Il est impossible de se concentrer avec ce vacarme <w>infernal</w> dans la rue."
                        }
                    ],
                    "synonyms": [
                        "assourdissant",
                        "insupportable"
                    ],
                    "antonyms": [
                        "apaisant",
                        "silencieux"
                    ],
                    "common_phrases": [
