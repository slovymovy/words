                ],
                "senses": [
                    {
                        "sense_id": "c549e33e-ba38-3068-ae5e-e4ec8c7a68ca",
                        "entry_id": "e65f29bf-9978-3b90-ade5-2eeb51d701cc",
                        "glosses": [
                            "A canker in the mouth of a hawk."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b8a3af3-ce23-41bb-82f8-107dec94db62",
                                "sense_id": "c549e33e-ba38-3068-ae5e-e4ec8c7a68ca",
                                "text": "The hawke had no lyst\nTo come to his fyst;\nShe loked as she had the frounce; […]"
                            },
                            {
                                "example_id": "41d2f209-14e4-48f4-b13c-21f5c2fe84c7",
                                "sense_id": "c549e33e-ba38-3068-ae5e-e4ec8c7a68ca",
                                "text": "I say that the eyass should have her meat unwashed, until she becomes a brancher—’twere the ready way to give her the frounce, to wash her meat sooner, and so knows every one who knows a gled from a falcon."
                            }
                        ]
                    },
                    {
                        "sense_id": "85f0d9a6-c610-372c-b9ff-a1327bbd3217",
                        "entry_id": "e65f29bf-9978-3b90-ade5-2eeb51d701cc",
                        "glosses": [
                            "A plait or curl."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "120b0d64-aba1-3da1-9e25-4ff152d3b5d4",
