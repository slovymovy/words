                "senses": [
                    {
                        "sense_id": "3a2f7fc9-ff05-345d-a8d3-b437c568b443",
                        "entry_id": "1a9b62a1-ca76-33d2-9b96-64e93c1cfc9d",
                        "glosses": [
                            "Detektiv, der die Kunden in einem Kaufhaus überwacht"
                        ],
                        "tags": [
                            "Beruf"
                        ],
                        "examples": [
                            {
                                "example_id": "8472f5f0-e88d-4331-9a95-29b2baefc42e",
                                "sense_id": "3a2f7fc9-ff05-345d-a8d3-b437c568b443",
                                "text": "Als sie von einem Kaufhausdetektiv auf frischer Tat erwischt wurde, ist eine Ladendiebin am Montag im Bezirk Mödling rabiat geworden."
                            },
                            {
                                "example_id": "99e2fc27-5e62-4e11-b5b1-b38612019765",
                                "sense_id": "3a2f7fc9-ff05-345d-a8d3-b437c568b443",
                                "text": "„Beim letzten Mal war ihr ein junger Mann beim Tragen behilflich - der Kaufhausdetektiv.“"
                            },
                            {
                                "example_id": "5f331eb9-7cb0-4617-a8bd-8544cd114126",
                                "sense_id": "3a2f7fc9-ff05-345d-a8d3-b437c568b443",
                                "text": "„Wahid Hakimi, ehemaliger Kaufhausdetektiv bei Saturn, rettete beim Amoklauf im OEZ viele Menschen.“"
                            },
                            {
                                "example_id": "60957377-8375-4c1b-8c7b-bd723df4e520",
                                "sense_id": "3a2f7fc9-ff05-345d-a8d3-b437c568b443",
                                "text": "„Ein Kaufhausdetektiv vermutete eine betrügerische Verwendung der Karten und informierte die Polizei, die den Täter festnahm.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
