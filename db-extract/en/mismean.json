                        "glosses": [
                            "To mean or intend wrongly; mistake the meaning of; misinterpret."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "fe2c2395-fc95-4d49-8092-a93e4d730135",
                                "sense_id": "8bde61ae-798c-3e06-b0dc-187ed47a2455",
                                "text": "If we ever misstate the facts it is, alas, because sometimes we mismean the proposition that we utter."
                            },
                            {
                                "example_id": "a1bd6d69-cf99-4b7a-aa72-cf63f4c94530",
                                "sense_id": "8bde61ae-798c-3e06-b0dc-187ed47a2455",
                                "text": "To mismean is not to mean; to mismean is to honor a meaning glimpsed but unmeant."
                            }
                        ]
                    }
