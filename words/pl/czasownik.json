                    "sense_definition": "człowiek przepowiadający przyszłość; wróżbiarz",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "wróżbiarstwo",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W dawnych wiekach <w>czasownik</w> cieszył się wielkim szacunkiem wśród ludu.",
                            "target_lang_translations": {
                                "ru": "В стародавние времена <w>прорицатель</w> пользовался огромным уважением среди народа."
                            }
                        },
                        {
                            "text": "Miejscowy <w>czasownik</w> zapowiedział nadejście surowej zimy.",
                            "target_lang_translations": {
                                "ru": "Местный <w>предсказатель</w> предрек наступление суровой зимы."
