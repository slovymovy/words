                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f1a8b051-2108-3a4d-bc24-7c39b9fe924d",
                                        "entry_id": "af4a01ca-f7b6-304a-b196-620d0377a971",
                                        "glosses": [
                                            "simple past and past participle of leave (“depart, separate from; (cause or allow to) remain”)."
                                        ],
                                        "tags": [
                                            "form-of",
                                            "participle",
                                            "past"
