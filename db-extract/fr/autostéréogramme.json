                        "sense_id": "a475a576-61d5-36a1-b27e-78ebd0eb010e",
                        "entry_id": "bf0e3511-c343-39b6-beea-13070cd43984",
                        "glosses": [
                            "Stéréogramme constitué d’une seule image qui donne l’illusion d’une scène en trois dimensions (3D) à partir d’une image en deux dimensions (2D)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4cf8b2a-b021-4181-bf05-3d8fed040d4e",
                                "sense_id": "a475a576-61d5-36a1-b27e-78ebd0eb010e",
                                "text": "Cette figure, soit dit en passant, non seulement montre comment sont faits les autostéréogrammes, mais marche aussi elle-même comme un autostéréogramme passable."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3ae5b9e7-948c-4995-80eb-39f8d7d40ea8",
                        "source_entry_id": "bf0e3511-c343-39b6-beea-13070cd43984",
                        "source_sense_id": "a475a576-61d5-36a1-b27e-78ebd0eb010e",
                        "target_lang_word": "autostereogram",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "autostereogram",
