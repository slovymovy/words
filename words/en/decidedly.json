{
    "word_family": [
        "decide",
        "decision",
        "decisive",
        "decider"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "7ea7063f-7ec3-3613-8905-7dee59019a7f",
                    "sense_definition": "In a manner that is clear, certain, or leaves little room for doubt.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "certainty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She spoke in a <w>decidedly</w> firm tone that left no room for further argument.",
                            "target_lang_translations": {
                                "pl": "Mówiła <w>zdecydowanie</w> stanowczym tonem, który nie pozostawiał miejsca na dalszą dyskusję."
                            }
                        },
                        {
                            "text": "The old building has a <w>decidedly</w> derelict appearance after years of neglect.",
                            "target_lang_translations": {
                                "pl": "Stary budynek ma <w>zdecydowanie</w> zaniedbany wygląd po latach braku opieki."
                            }
                        }
                    ],
                    "synonyms": [
                        "definitely",
                        "clearly",
                        "unquestionably",
                        "certainly"
                    ],
                    "antonyms": [
                        "vaguely",
                        "uncertainly"
                    ],
                    "common_phrases": [
                        "decidedly unpleasant",
                        "decidedly different",
                        "decidedly better"
                    ],
                    "target_lang_definitions": {
                        "pl": "W sposób jasny, pewny, niepozostawiający wątpliwości."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "zdecydowanie",
                                "target_lang_sense_clarification": "używane do podkreślenia pewności lub bezdyskusyjności faktu"
                            },
                            {
                                "target_lang_word": "ewidentnie",
                                "target_lang_sense_clarification": "w sposób oczywisty, widoczny na pierwszy rzut oka"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "51d3e8cf-901a-3d7f-a44b-eaf4fe159623",
                    "sense_definition": "In a firm, final, or resolute manner.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "certainty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We cannot go there tonight, she said <w>decidedly</w> while closing the door.",
                            "target_lang_translations": {
                                "pl": "Nie możemy tam dziś iść, powiedziała <w>zdecydowanie</w>, zamykając drzwi."
                            }
                        },
                        {
                            "text": "He <w>decidedly</w> refused to change his mind despite the pressure from his colleagues.",
                            "target_lang_translations": {
                                "pl": "On <w>zdecydowanie</w> odmówił zmiany zdania pomimo nacisków ze strony kolegów."
                            }
                        }
                    ],
                    "synonyms": [
                        "resolutely",
                        "firmly",
                        "determinedly"
                    ],
                    "antonyms": [
                        "hesitantly",
                        "indecisively"
                    ],
                    "common_phrases": [
                        "refused decidedly",
                        "spoke decidedly"
                    ],
                    "target_lang_definitions": {
                        "pl": "W sposób stanowczy, nieodwołalny lub zdeterminowany."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "zdecydowanie",
                                "target_lang_sense_clarification": "w sposób stanowczy, wyrażający silną wolę"
                            },
                            {
                                "target_lang_word": "stanowczo",
                                "target_lang_sense_clarification": "w sposób nieustępliwy, wyrażający kategoryczną odmowę lub decyzję"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}