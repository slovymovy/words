                "senses": [
                    {
                        "sense_id": "e5ae5a8e-d774-30d8-8f50-f0927b8ad898",
                        "entry_id": "ec6cd53b-1c1b-3653-8334-8e728024145d",
                        "glosses": [
                            "Ardoiser à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b62a4f57-11e5-42e4-ab4e-b424a7b66fa8",
                                "sense_id": "e5ae5a8e-d774-30d8-8f50-f0927b8ad898",
                                "text": "Vous avez idéalement des connaissances en couverture, vous savez monter sur un toit, désardoiser et réardoiser."
                            },
                            {
                                "example_id": "49e37d32-59c7-4bd3-bd0d-778afdc65d90",
                                "sense_id": "e5ae5a8e-d774-30d8-8f50-f0927b8ad898",
                                "text": "Composition pour ardoiser et réardoiser soi même les tableaux noirs en bois, carton, papier et autres substances, ainsi que les surfaces murales et objets analogues, dite l’ardoisine."
                            }
                        ]
                    }
