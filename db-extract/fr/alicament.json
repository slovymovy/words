                "entry_id": "975adc4f-412d-3014-bca6-6063a9082c7e",
                "word": "alicament",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a9023cb5-525a-4748-8b5c-b5b0dbc7843d",
                        "entry_id": "975adc4f-412d-3014-bca6-6063a9082c7e",
                        "tags": [
                            "plural"
                        ],
                        "form": "alicaments"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "964a9c77-8b35-3ad0-9c74-b76408a53e1c",
                        "entry_id": "975adc4f-412d-3014-bca6-6063a9082c7e",
                        "glosses": [
                            "Nutriment destiné à soigner (ou à prévenir l’apparition de certaines maladies) incorporé dans l’alimentation courante."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b6a2b62-263d-45ca-b29a-c98b415fe354",
                                "sense_id": "964a9c77-8b35-3ad0-9c74-b76408a53e1c",
                                "text": "L’apparition d’aliments qui protègent les artères pourraient donner naissance à un nouveau type d’alicaments sur un marché déjà saturé de yaourts aux probiotiques censés aider à digérer, de céréales qui réduisent le cholestérol et d’eaux minérales enrichies en collagène, acides aminés et vitamine A pour aider à lutter contre l’apparition de rides."
                            },
                            {
                                "example_id": "ce47f8bd-1984-4f5f-a4f4-3ef68b999c11",
                                "sense_id": "964a9c77-8b35-3ad0-9c74-b76408a53e1c",
                                "text": "Il ne figure pas encore sur nos listes de commissions mais le fruit du baobab pourrait bien devenir le prochain alicament à la mode grâce à ses fortes propriétés antioxydantes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f4c1430e-d8a6-47b8-9f2a-6a122d676fe7",
                        "source_entry_id": "975adc4f-412d-3014-bca6-6063a9082c7e",
                        "source_sense_id": "964a9c77-8b35-3ad0-9c74-b76408a53e1c",
