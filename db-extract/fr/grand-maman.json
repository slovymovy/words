        "fr-extract.jsonl": [
            {
                "entry_id": "082ce146-aa57-306a-b3b0-b04bac5b0040",
                "word": "grand-maman",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "518a7958-d5fd-49a4-923d-55b24e6f5b8c",
