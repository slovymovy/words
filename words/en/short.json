                    ],
                    "synonyms": [
                        "brief"
                    ],
                    "common_phrases": [
                        "cut short",
                        "stop short"
                    ],
                    "target_lang_definitions": {
                        "ru": "Внезапно, резко или кратко."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "резко",
                                "target_lang_sense_clarification": "о прекращении действия"
