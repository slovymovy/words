                ],
                "senses": [
                    {
                        "sense_id": "efc1170c-9e08-396b-b8fd-277df7d8d058",
                        "entry_id": "6a8ff8cd-1dcc-3618-8a37-b9383c611c87",
                        "glosses": [
                            "je nach Auffassung eine Niger-Kongo-Sprache mit mehreren Dialekten oder eine Gruppe aus bis zu zwanzig Sprachen, die vom gleichnamigen Volk gesprochen werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "616c7500-586f-4180-a05d-66dffd856d98",
                                "sense_id": "efc1170c-9e08-396b-b8fd-277df7d8d058",
                                "text": "„Wie viele andere afrikanische Sprachen, besitzt auch das Dogon komplexe Grußformeln, die selbst bei flüchtigen Begegnungen angewandt werden.“"
                            },
                            {
                                "example_id": "7f8c20a9-b773-4f35-9c78-ae135d6a8be2",
                                "sense_id": "efc1170c-9e08-396b-b8fd-277df7d8d058",
                                "text": "„Auch in den Bozo-Varietäten Xanyaxo/Kelenga, Tieyaxo, Sorogaama und in Nicht-Mande-Sprachen wie Dogon, Senari (beides Gur-Sprachen) wird der Begriff ‚gara‘ bzw. ‚gala‘ zur Bezeichnung von Indigo verwendet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
