                "senses": [
                    {
                        "sense_id": "13cc516c-bd69-307d-9624-6e6d4c7dd96a",
                        "entry_id": "705249fc-bbe1-3610-b76a-26aff01e3716",
                        "glosses": [
                            "Agent der US-amerikanischen Ermittlungsbehörde FBI"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b04bb511-3552-4083-8cf0-b076efecb0f5",
                                "sense_id": "13cc516c-bd69-307d-9624-6e6d4c7dd96a",
                                "text": "„Bei ihr war Robert Croge, ein Anwalt im Dienst der CIA, sowie ein FBI-Agent mit einem slawischen Namen, den Ferris sich nicht merken konnte.“"
                            },
                            {
                                "example_id": "9280a12e-822d-46a6-92b5-a638c9867b0d",
                                "sense_id": "13cc516c-bd69-307d-9624-6e6d4c7dd96a",
                                "text": "„Auf dem Flughafen wimmelt es von FBI-Agenten, die alle Tender Branson den Massenmörder suchen.“"
                            },
                            {
                                "example_id": "809ac09f-f942-4b58-8a8a-443277da8a78",
                                "sense_id": "13cc516c-bd69-307d-9624-6e6d4c7dd96a",
                                "text": "„Am Morgen erschien eine Horde kurz geschorener FBI-Agenten in dem mit Kunststein verkleideten Haus, das die Regierung nur achtundvierzig Stunden zuvor für DelGiorno angemietet hatte.“"
                            },
                            {
                                "example_id": "03f8e67e-9a5f-495e-861e-9284050c0d83",
                                "sense_id": "13cc516c-bd69-307d-9624-6e6d4c7dd96a",
                                "text": "„Wenn wir die Elemente der Täterprofilerstellung vor FBI-Agenten oder sonstigen Beamten der Strafverfolgungsbehörden an der National Academy lehren, bemühen wir uns, sie dazu zu bringen, die gesamte Geschichte des Verbrechens zu bedenken.“"
                            },
                            {
                                "example_id": "9fba39cb-72bd-4a16-9cc4-2c416ed1fc3f",
                                "sense_id": "13cc516c-bd69-307d-9624-6e6d4c7dd96a",
                                "text": "„›Sie sind aber schnell‹, sage ich zu den beiden FBI-Agenten, als wir uns im Wohnzimmer niederlassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
