                    }
                ],
                "senses": [
                    {
                        "sense_id": "0daae8db-6679-351c-a1e5-fc16e2b5fd8c",
                        "entry_id": "1739a595-4285-3ba7-b266-b20f804fbf77",
                        "glosses": [
                            "Gegenstand, der (grundsätzlich) Bestandteil eines Gerätes ist, welches selbsttätig Arbeitsgänge verrichtet"
                        ],
                        "tags": [
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "196ac4b6-387f-4f89-9586-9ba07daa1467",
                                "sense_id": "0daae8db-6679-351c-a1e5-fc16e2b5fd8c",
                                "text": "„Die grundlegenden mechanischen Maschinenelemente wie Rad, Hebel, Rolle, schiefe Ebene (Keil) und alle wichtigeren Handwerkszeuge (Axt, Hammer, Säge) waren schon in vorgeschichtlichen Zeiten bekannt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "78e5053a-139b-47e1-aef8-9bab0cea1df8",
                        "source_entry_id": "1739a595-4285-3ba7-b266-b20f804fbf77",
                        "source_sense_id": "0daae8db-6679-351c-a1e5-fc16e2b5fd8c",
                        "target_lang_word": "machine element",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "0256a79f-d11b-49f0-a281-479488e3dce7",
                        "source_entry_id": "1739a595-4285-3ba7-b266-b20f804fbf77",
                        "source_sense_id": "0daae8db-6679-351c-a1e5-fc16e2b5fd8c",
                        "target_lang_word": "élément de machine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "c62f778a-5eae-4763-96f2-164d26f09268",
                        "source_entry_id": "1739a595-4285-3ba7-b266-b20f804fbf77",
                        "source_sense_id": "0daae8db-6679-351c-a1e5-fc16e2b5fd8c",
                        "target_lang_word": "organe",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "organe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9fb5af1a-59cd-3429-bb4b-3a7d8eab4d0e",
                                        "entry_id": "bcd75ca8-62cb-380d-ad9f-49359eee600a",
                                        "glosses": [
                                            "Partie d’un organisme vivant, considéré comme un tout et comme remplissant une fonction nécessaire ou utile à sa vie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "312843c9-50ff-4744-9b23-39e2b5966cf9",
                                                "sense_id": "9fb5af1a-59cd-3429-bb4b-3a7d8eab4d0e",
                                                "text": "Voilà pourquoi la fissiparité n'est point possible chez les êtres dont la vie se trouve concentrée en une parfaite unité, et qui ont des organes centraux , un cœur et un cerveau."
                                            },
                                            {
                                                "example_id": "5db67e3c-247d-4f98-b161-6c342986ad60",
                                                "sense_id": "9fb5af1a-59cd-3429-bb4b-3a7d8eab4d0e",
                                                "text": "« Tous les animaux, écrivait Bichat, sont des assemblages de divers organes qui, en exécutant chacun sa fonction, concourent, chacun à sa manière, à la conservation du tout. »"
                                            },
                                            {
                                                "example_id": "4a72a870-287e-4bf4-adc4-cda15103e8cf",
                                                "sense_id": "9fb5af1a-59cd-3429-bb4b-3a7d8eab4d0e",
                                                "text": "Les sulfatages précoces que beaucoup hésitaient à faire avaient pourtant l'avantage d'atteindre tous les organes de la vigne, notamment les mannes, c'est-à-dire les futurs raisins."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f5b8ad6-2d91-3c17-a3f4-06c09a5abfd1",
                                        "entry_id": "bcd75ca8-62cb-380d-ad9f-49359eee600a",
                                        "glosses": [
                                            "La voix."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26df77e0-17ce-441b-a161-6cc34888fd3d",
                                                "sense_id": "9f5b8ad6-2d91-3c17-a3f4-06c09a5abfd1",
                                                "text": "[…], dit La Brière d’une voix douce et mélodieuse qui produisit un soudain contraste avec le ton péremptoire du poète dont l’organe flexible avait quitté le ton de la câlinerie pour le ton magistral de la Tribune."
                                            },
                                            {
                                                "example_id": "d768a027-0047-4e96-bafa-7a3726ced963",
                                                "sense_id": "9f5b8ad6-2d91-3c17-a3f4-06c09a5abfd1",
                                                "text": "Le Carcan rentrait des champs ; il fut mis au courant de l’affaire et bientôt mêla son organe tonitruant aux glapissements de sa conjointe."
                                            },
                                            {
                                                "example_id": "ed2c2052-0ce5-4340-a643-906c15bb548a",
                                                "sense_id": "9f5b8ad6-2d91-3c17-a3f4-06c09a5abfd1",
                                                "text": "Je ne connais pas cet organe, dit Alfred, après un moment d'audition réfléchie;"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03f387bf-f099-3dcb-872b-1bd6f0562fe4",
                                        "entry_id": "bcd75ca8-62cb-380d-ad9f-49359eee600a",
                                        "glosses": [
                                            "Les diverses parties d’une machine."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e48e2c52-8750-49aa-872e-551609c503f6",
                                                "sense_id": "03f387bf-f099-3dcb-872b-1bd6f0562fe4",
                                                "text": "Le ramasseur fonctionne à la manière d'un râteau rotatif qui soulève le fourrage ou la paille en andain sur le sol et l'élève vers les organes internes de la presse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "40e96800-67dd-3eb2-8294-aab950a2671b",
                                        "entry_id": "bcd75ca8-62cb-380d-ad9f-49359eee600a",
                                        "glosses": [
                                            "Ce dont on se sert pour déclarer ses volontés, par l’entremise et par le moyen de quoi on fait quelque chose."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be3be42f-9290-4bec-9381-2b99476489e5",
                                                "sense_id": "40e96800-67dd-3eb2-8294-aab950a2671b",
                                                "text": "Le ministère public est l’organe de l’accusation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af77900c-952d-373e-8141-fb2c8bb9b178",
                                        "entry_id": "bcd75ca8-62cb-380d-ad9f-49359eee600a",
                                        "glosses": [
                                            "Journal, gazette de propagande, toute publication en tant qu'elle est le porte-parole d'une institution ou d'un groupe d'influence."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "53c07eca-2dec-4641-a8ae-0601880638cd",
                                                "sense_id": "af77900c-952d-373e-8141-fb2c8bb9b178",
                                                "text": "Jean-Pierre Baud […] fut aussi le rédacteur (du nᵒ 1 au nᵒ 15) de l’organe de ladite Amicale, ce bulletin « irrégulomadaire » (dixit Georges Mahé) qu'était à ses débuts notre cher Petit Diagonaliste."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d51ffc28-7f3d-3561-9a5c-e409e3196f70",
                                        "entry_id": "bcd75ca8-62cb-380d-ad9f-49359eee600a",
                                        "glosses": [
                                            "Organe génital."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "86a8d9c3-2d57-4a02-8641-f92b2ac06ca0",
                                                "sense_id": "d51ffc28-7f3d-3561-9a5c-e409e3196f70",
                                                "text": "Il est soigneux de ses affaires et de sa personne. Introduisant sa senestre derrière sa ceinture, il se reclasse confortablement les organes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
