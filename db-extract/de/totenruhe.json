                        "sense_id": "3351badc-82ba-344f-9182-68c87adbd1be",
                        "entry_id": "b7d7d240-7472-39b5-8ba2-1ed5556f0419",
                        "glosses": [
                            "die Ruhe, in der sich der Tote befindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "772aaf3d-0192-4817-af59-e11975a249a0",
                                "sense_id": "3351badc-82ba-344f-9182-68c87adbd1be",
                                "text": "Der Respekt vor der Totenruhe ist sogar gesetzlich verankert."
                            },
                            {
                                "example_id": "47bd76ff-6cc7-4355-868d-7d8f743bff86",
                                "sense_id": "3351badc-82ba-344f-9182-68c87adbd1be",
                                "text": "„Und damit Louis' Totenruhe nicht gestört werde, beschlossen die Chiefs, dass um Mount Vaea das Abfeuern von Schusswaffen auf alle Zeit verboten sein sollte.“"
                            },
                            {
                                "example_id": "4007758b-ad75-4b0a-a160-5372f21f05fa",
                                "sense_id": "3351badc-82ba-344f-9182-68c87adbd1be",
                                "text": "„Empört ließ eine Frau ihre Gießkanne fallen und schrie etwas von Totenruhe, Krähen flatterten krächzend von einem zerfledderten Kranz auseinander, ich hätte am liebsten mitgeschrien.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
