                                "target_word": "афганец",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "3933fe86-1c4b-3195-a0e1-8823e713e796",
                                        "entry_id": "e8cd2b43-8771-32e8-9e0f-13f49aada152",
                                        "glosses": [
                                            "представитель народа, населяющего Афганистан, выходец из Афганистана или потомок таких выходцев"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3bb14cda-b9a2-4f50-b03e-3c3b8d73cc07",
                                                "sense_id": "3933fe86-1c4b-3195-a0e1-8823e713e796",
                                                "text": "Приток афганцев в Россию начался практически сразу после вывода советских войск из Афганистана."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c2eb0edf-c678-376f-b070-25412f872818",
                                        "entry_id": "e8cd2b43-8771-32e8-9e0f-13f49aada152",
                                        "glosses": [
                                            "перен., разг. воин из СССР, воевавший в Афганистане с 1979 по 1989 годы"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8bdff371-6730-45bb-b721-766a532f9b2e",
                                                "sense_id": "c2eb0edf-c678-376f-b070-25412f872818",
                                                "text": "В Оренбурге воины-афганцы просят не строить мечеть у них под окнами."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c9c4fda5-4037-359b-9802-c6fb2c078631",
