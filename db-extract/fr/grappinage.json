                "senses": [
                    {
                        "sense_id": "eb95f268-a60b-369b-9c21-80979cb14563",
                        "entry_id": "88d988f8-8404-35b8-8d01-27fabfbc5505",
                        "glosses": [
                            "Action de grappiner, de saisir avec un ou des grappins."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33c9e0d8-6c24-4c3d-a093-3180cdf442ab",
                                "sense_id": "eb95f268-a60b-369b-9c21-80979cb14563",
                                "text": "Dans le cadre des travaux d'entretien des écluses, des usines de production hydroélectrique, des prises d'eau et des barrages, ou avant la réalisation d'opérations de remplacement de grilles d'entrée d'eau, O'CAN est souvent amenée à effectuer des travaux de grappinage, c'est-à-dire à extraire des bois, ou autres matériaux, à l'aide d'un grappin."
                            },
                            {
                                "example_id": "767d4854-f74b-45bc-bab0-1a27fe0f3494",
                                "sense_id": "eb95f268-a60b-369b-9c21-80979cb14563",
                                "text": "Grappinage : Nous réalisons des curages sur des ouvrages type barrages ou ouvrages d'arts. Ces interventions sont réalisées avec des grues téléscopiques et 1 grappin hydraulique."
                            }
                        ]
                    },
                    {
                        "sense_id": "fc3ed462-d7fb-3547-bb42-902b7cc6b31d",
                        "entry_id": "88d988f8-8404-35b8-8d01-27fabfbc5505",
                        "glosses": [
                            "Action de grappiner le poisson."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2221e12c-0820-4c46-8dc5-f8c4599c0c75",
                                "sense_id": "fc3ed462-d7fb-3547-bb42-902b7cc6b31d",
                                "text": "Grappiner : prendre un poisson en piquant l'hameçon ailleurs que dans la gueule, comme avec un grappin. Le grappinage peut être volontaire (braconnage) ou accidentel."
                            },
                            {
                                "example_id": "7c6b00b7-3ad6-47a5-a983-88991663d8ae",
                                "sense_id": "fc3ed462-d7fb-3547-bb42-902b7cc6b31d",
                                "text": "La pêche de ce poisson à la quimperloise est bien sûr autorisée, mais les prises légales avec ce leurre sont exceptionnelles. C'est le grappinage volontaire avec cette cuiller qui est prohibé."
                            }
                        ]
                    }
