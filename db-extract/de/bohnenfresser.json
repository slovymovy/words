                                        "sense_id": "556e82f6-9373-3839-95ed-76d51748c541",
                                        "entry_id": "29092175-2d9d-325e-a385-edbd7e853ec1",
                                        "glosses": [
                                            "A Mexican."
                                        ],
                                        "tags": [
                                            "US",
                                            "ethnic",
                                            "offensive",
                                            "slur"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6215f2e8-2015-4010-b320-43a6049f4d0d",
                                                "sense_id": "556e82f6-9373-3839-95ed-76d51748c541",
                                                "text": "You're gonna work out good, Dave. I was afraid they were gonna hire another nigger or a beaner."
                                            },
                                            {
                                                "example_id": "d142763d-4b20-4390-b301-33c04f2aca01",
                                                "sense_id": "556e82f6-9373-3839-95ed-76d51748c541",
                                                "text": "Hey bro I'm a beaner, we ain't good at math. Jeez, dawn 'ju watch TV?"
                                            },
                                            {
                                                "example_id": "1e764556-51f2-4de6-89ca-84a48e362428",
                                                "sense_id": "556e82f6-9373-3839-95ed-76d51748c541",
                                                "text": "I'm a beaner, and I'm telling you white people, that's a bullshit number right off the bat!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53bffafd-bd14-3c5f-9691-50c408ab202d",
                                        "entry_id": "29092175-2d9d-325e-a385-edbd7e853ec1",
                                        "glosses": [
                                            "Any Hispanic or Latino person."
                                        ],
