        "ru-extract.jsonl": [
            {
                "entry_id": "9b008b9e-0136-3556-abd4-bc544c717172",
                "word": "тяп-ляп",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "07c5d9e9-d94c-3076-9e68-767a076bbf9b",
                        "entry_id": "9b008b9e-0136-3556-abd4-bc544c717172",
                        "glosses": [
                            "разг. некачественно, неаккуратно, халатно, небрежно"
                        ],
                        "tags": [],
