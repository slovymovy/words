                "senses": [
                    {
                        "sense_id": "016bf1c9-5422-3f36-b3de-1aaac0f9c1c2",
                        "entry_id": "dc6e0fbb-fa8c-33a7-8651-95afae0c489c",
                        "glosses": [
                            "Tankstelle, die ohne örtlich anwesendes Personal betrieben wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d17fbde-6075-4f99-af72-7c5741671af0",
                                "sense_id": "016bf1c9-5422-3f36-b3de-1aaac0f9c1c2",
                                "text": "„Der Betreiber, die OMV-Tochter Avanti, hat für die Automatentankstelle einen Teil der Parkplatzfläche von Aldi Süd gepachtet.“"
                            },
                            {
                                "example_id": "51b54d75-93f0-4609-ac9e-01759b2a25c4",
                                "sense_id": "016bf1c9-5422-3f36-b3de-1aaac0f9c1c2",
                                "text": "„Ein verrutschtes Komma sorgte in Lippstadt für glückliche Autofahrer. An einer Automatentankstelle gab es den Liter Benzin für 16,2 Cent.“"
                            },
                            {
                                "example_id": "f29b9e52-fc96-4db3-bf07-a5f4232f47db",
                                "sense_id": "016bf1c9-5422-3f36-b3de-1aaac0f9c1c2",
                                "text": "„Auch so manche Tankstelle wird über die Feiertage geschlossen haben. Wer dennoch tanken muss, kann nach einer Automatentankstelle Ausschau halten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
