                                        "sense_id": "267fa186-a22c-3397-ace6-06b19ffdcbc9",
                                        "entry_id": "97c0dc11-59b5-3414-bb98-bdd501260ed5",
                                        "glosses": [
                                            "Personne déplaisante et agaçante."
                                        ],
                                        "tags": [
