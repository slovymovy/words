                },
                {
                    "sense_id": "953feca3-7c80-3ce9-9b7a-9cc420cb00af",
                    "sense_definition": "blijven vloeien als een vloeistof",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "vloeistof",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het laboratorium is allang verlaten, maar dat water <w>stroomt</w> nog gewoon <w>door</w> in de kanalen.",
                            "target_lang_translations": {
                                "en": "The laboratory has long been abandoned, but that water just <w>keeps flowing</w> in the canals."
                            }
                        },
                        {
                            "text": "Zelfs na de vorst begon het water in de beek weer rustig <w>door</w> te <w>stromen</w>.",
                            "target_lang_translations": {
