                                "example_id": "12817454-54d4-45bb-be46-33d04675f3c5",
                                "sense_id": "2eb6f30b-02a2-3e69-925e-15b768f71360",
                                "text": "„Ihre eigene weiße Baumwollbluse hatte kurze Ärmel, und sie trug keine Strümpfe unter ihrem Leinenrock, trotzdem war es ihr viel zu warm.“"
                            },
                            {
                                "example_id": "de49bf2d-4582-4e67-a605-dff601701d82",
                                "sense_id": "2eb6f30b-02a2-3e69-925e-15b768f71360",
                                "text": "„Allerdings war sie bekleidet: mit einer langärmeligen Baumwollbluse, Leinenhose und Lederstiefeln.“"
                            }
                        ],
