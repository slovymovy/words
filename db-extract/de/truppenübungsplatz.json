                        "entry_id": "f9fc7a35-02f0-3dea-9a56-2f5df9a241f7",
                        "glosses": [
                            "Örtlichkeit zur wirklichkeitsnahen Gefechtsausbildung von Soldaten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b8245be5-0769-420c-b3f7-bb31b1e840e8",
                                "sense_id": "6f868ad7-62ff-3920-b527-24bff914834e",
                                "text": "Zum Ende seiner Grundausbildung fand eine Gefechtsübung auf dem Truppenübungsplatz statt."
                            },
                            {
                                "example_id": "4634588d-ac18-4703-b57b-a7e15d0c7f5a",
                                "sense_id": "6f868ad7-62ff-3920-b527-24bff914834e",
                                "text": "„Der Stablack ist eine weitläufige, hügelige Landschaft, in die hinein zehn Jahre zuvor, 1934, ein riesiger Truppenübungsplatz mit einer Fläche von 10000 Hektar gebaut worden war.“"
                            }
                        ],
