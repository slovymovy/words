    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3ce57f03-ab23-3cdd-9690-c867aef6cc13",
                    "sense_definition": "Envoyer quelque chose à une destination par la poste ou par un transporteur.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "envoi",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le commerçant va <w>expédier</w> votre commande dès demain matin."
                        },
                        {
                            "text": "Nous devons <w>expédier</w> un colis urgent à nos clients en Italie."
                        }
                    ],
                    "synonyms": [
                        "envoyer",
                        "acheminer",
                        "adresser"
                    ],
                    "antonyms": [
                        "recevoir"
                    ],
                    "common_phrases": [
                        "expédier un colis",
                        "expédier un paquet",
                        "expédier une lettre",
                        "expédier du courrier"
                    ]
                },
                {
                    "sense_id": "f4df00b2-a08b-382e-90ba-e03aa7454ff9",
                    "sense_definition": "Faire, traiter ou conclure quelque chose rapidement, souvent sans grand soin.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "rapidite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a voulu <w>expédier</w> son travail pour pouvoir partir plus tôt en week-end."
                        },
                        {
                            "text": "Le ministre continue d'<w>expédier</w> les affaires courantes en attendant la nomination du gouvernement."
                        }
                    ],
                    "synonyms": [
                        "bâcler",
                        "régler",
                        "liquider"
                    ],
                    "antonyms": [
                        "approfondir",
                        "fignoler"
                    ],
                    "common_phrases": [
                        "expédier les affaires courantes",
                        "expédier le travail"
                    ]
                },
                {
                    "sense_id": "6da57c4e-bd8a-330b-a03c-0662334ff116",
                    "sense_definition": "Consommer ou avaler très rapidement un repas ou un aliment.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "consommation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pressé par l'horaire du train, il <w>expédie</w> son déjeuner en dix minutes."
                        },
                        {
                            "text": "Nous avons dû <w>expédier</w> le petit-déjeuner avant de partir au travail."
                        }
                    ],
                    "synonyms": [
                        "avaler",
                        "engloutir"
                    ],
                    "antonyms": [
                        "savourer"
                    ],
                    "common_phrases": [
                        "expédier son déjeuner",
                        "expédier son repas"
                    ]
                },
                {
                    "sense_id": "ea286c59-a130-3d20-91e4-c50d04d353d8",
                    "sense_definition": "Se débarrasser rapidement de quelqu'un en le congédiant ou en abrégeant la rencontre.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "relation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Occupé par un dossier prioritaire, le directeur a rapidement <w>expédié</w> ce visiteur."
                        },
                        {
                            "text": "Elle n'avait aucun temps à perdre et <w>expédia</w> poliment le démarcheur."
                        }
                    ],
                    "synonyms": [
                        "éconduire",
                        "congédier",
                        "renvoyer"
                    ],
                    "antonyms": [
                        "accueillir",
                        "recevoir"
                    ]
                },
                {
                    "sense_id": "4c87f488-663c-35ed-8b83-0c16dc93e332",
                    "sense_definition": "Faire mourir promptement quelqu'un ou abréger brutalement ses jours.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce poison violent l'a <w>expédié</w> dans l'autre monde en quelques heures."
                        },
                        {
                            "text": "Dans ce roman policier, les criminels ont vite <w>expédié</w> le témoin gênant."
                        }
                    ],
                    "synonyms": [
                        "achever",
                        "tuer",
                        "éliminer"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "au sens de faire mourir"
                        }
                    ]
                },
                {
                    "sense_id": "52daa3ed-3783-36ab-b840-b59220bf6ab0",
                    "sense_definition": "Rédiger et délivrer la copie officielle d'un acte juridique, notarié ou administratif.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "droit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le notaire doit encore <w>expédier</w> une copie authentique du contrat de vente."
                        },
                        {
                            "text": "Le greffier a <w>expédié</w> le jugement en forme exécutoire à la demande de l'avocat."
                        }
                    ],
                    "synonyms": [
                        "délivrer"
                    ]
                }
            ]
        }
    ]
