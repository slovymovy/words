                            "ellipsis"
                        ],
                        "examples": [
                            {
                                "example_id": "534b8119-0a77-45b7-8c23-bc10aec22da8",
                                "sense_id": "fced13e4-8d6e-3810-9337-934637ffdc5c",
                                "text": "En programmation, les modificateurs de classe sont au nombre de quatre : public, protected, private, internal."
                            }
                        ]
                    }
                ],
