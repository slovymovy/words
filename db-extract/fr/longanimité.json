                                        "sense_id": "6992ca37-b79b-34b3-89e7-20d04ba4b991",
                                        "entry_id": "74f562b7-313a-3a25-b7f6-1db03e4f4f3f",
                                        "glosses": [
                                            "Presencia de ánimo frente a la adversidad."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ca5427f-d8e3-44f8-a81e-283c4853963c",
                                                "sense_id": "6992ca37-b79b-34b3-89e7-20d04ba4b991",
                                                "text": "¿O menosprecias las riquezas de su benignidad, paciencia y longanimidad, ignorando que su benignidad te guía al arrepentimiento?"
                                            }
