        "fr-extract.jsonl": [
            {
                "entry_id": "9d0c693d-149a-3a85-ac08-0daaed3b2e84",
                "word": "Waters",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "188c069f-c717-3eb7-8fa4-00ddf25865f0",
                        "entry_id": "9d0c693d-149a-3a85-ac08-0daaed3b2e84",
                        "glosses": [
                            "Nom de famille."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "350feb18-185e-47c8-aa55-0a8bfbbc06cc",
                                "sense_id": "188c069f-c717-3eb7-8fa4-00ddf25865f0",
                                "text": "Johnny Depp, c’est Cry-Baby, de John Waters, qui a été, pour moi, une claque énorme."
                            },
                            {
                                "example_id": "30f50658-151d-4073-98eb-c8c295e42cdb",
                                "sense_id": "188c069f-c717-3eb7-8fa4-00ddf25865f0",
                                "text": "Samantha Jayne et Arturo Perez Jr. ont revisité le film culte réalisé en 2003 par Mark Waters à la façon d’un musical de Broadway, transportant une adolescente dans un lycée où les filles se livrent à un combat sans merci pour rester populaires."
                            },
                            {
                                "example_id": "335b4d57-8c47-4bb2-a0c1-842e0571adc1",
                                "sense_id": "188c069f-c717-3eb7-8fa4-00ddf25865f0",
                                "text": "Connue pour ses romans néovictoriens, la Britannique Sarah Waters change d’époque avec \"Derrière la porte\"."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "144f0f09-b2fb-366e-9187-852a08acb916",
                "word": "waters",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "fd17c8e4-2517-47cb-9aaf-6e370970c0f1",
                        "entry_id": "144f0f09-b2fb-366e-9187-852a08acb916",
