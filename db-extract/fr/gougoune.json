                                        "entry_id": "f2382545-9b91-382a-a697-6f1a6b02e715",
                                        "glosses": [
                                            "besonders leichte Sandale, die außer einer Sohle nur noch eine Schlaufe für die Zehen hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "582a4b7c-3cb1-47b3-877d-844a389e6f4a",
                                                "sense_id": "ea0754b3-2980-3450-b788-df66121bd587",
                                                "text": "„Die Abendluft weht lau, es ist angenehm warm, und die Flipflops sind noch immer nicht weggepackt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Flipflop",
