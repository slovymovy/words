                                        "sense_id": "0a302c16-0f6e-3748-99c9-55e7a12fa4c3",
                                        "entry_id": "c2e8cc1e-6934-383a-a514-3fd6be132253",
                                        "glosses": [
                                            "To lament; to bewail; to grieve over."
