                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d018594-1395-4da4-bd56-ed069172ee30",
                                "sense_id": "5600d642-120d-359c-9d11-a050587969c3",
                                "text": "Si on me pêchait un soir de très bonne représentation théâtrale en me disant : \"Ne voudrais-tu pas jouer une telle pièce dans deux mois ?\" je serais peut-être capable de resuccomber."
                            },
                            {
                                "example_id": "7dae3922-3b73-4545-b930-775d1cc839a9",
                                "sense_id": "5600d642-120d-359c-9d11-a050587969c3",
                                "text": "Elle me refait le coup de Suzanne en 1966, qui refusait de me parler au téléphone parce qu'elle avait peur de resuccomber à mes charmes."
                            }
                        ]
                    }
