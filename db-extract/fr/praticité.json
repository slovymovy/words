                    {
                        "translation_id": "36ff5404-210a-4810-b394-a63ac1a6aa39",
                        "source_entry_id": "85816afd-6eca-39e6-aba2-c8a23eefe0e7",
                        "source_sense_id": "1feb4999-7178-35af-b124-3f3044e63320",
                        "target_lang_word": "gebruiksvriendelijkheid",
