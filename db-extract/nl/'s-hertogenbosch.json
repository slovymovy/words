                        "entry_id": "d4d7f3e7-5930-3fcf-beeb-bd54ae98fe71",
                        "glosses": [
                            "een stad en gemeente in de Nederlandse provincie Noord-Brabant"
                        ],
                        "tags": [
                            "toponiem: gemeente"
                        ],
                        "examples": [
                            {
                                "example_id": "1f4f9dcb-81e0-4df4-9b79-2db10f4cd157",
                                "sense_id": "715e379a-3a0e-3330-9149-0fe91dde3914",
                                "text": "Is het nu 's-Hertogenbosch of Den Bosch?"
                            },
                            {
                                "example_id": "556977f1-50a1-49b3-87e0-0d76cf79ede7",
                                "sense_id": "715e379a-3a0e-3330-9149-0fe91dde3914",
                                "text": "Wonen en werken in 's-Hertogenbosch is leven in een stad die een historisch centrum combineert met een aantrekkelijk winkelgebied, uitstekende uitgaansvoorzieningen en een breed cultureel aanbod."
                            }
                        ]
                    }
                ],
