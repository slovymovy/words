                "senses": [
                    {
                        "sense_id": "9c9d84e0-6a80-36a2-845e-95e4fa23bea6",
                        "entry_id": "3559d04a-8cf7-3af2-91ea-6c6fddd04a2b",
                        "glosses": [
                            "to tread, to step on"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ef909bb-123c-4b7e-a09e-376a4f43cebd",
                                "sense_id": "9c9d84e0-6a80-36a2-845e-95e4fa23bea6",
                                "text": "Не наступа́й мне на пя́тки.",
                                "translation": "Do not step on my heels.",
                                "english": "Do not step on my heels."
                            }
                        ]
                    },
                    {
                        "sense_id": "5b7f6896-625b-356c-98d7-7b13995c55e7",
                        "entry_id": "3559d04a-8cf7-3af2-91ea-6c6fddd04a2b",
                        "glosses": [
                            "to come, to begin, to set in"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ba36f7d-c74b-44d9-84d5-08ba1d921104",
                                "sense_id": "5b7f6896-625b-356c-98d7-7b13995c55e7",
                                "text": "Наступа́ют холода́.",
                                "translation": "The cold is setting in.",
                                "english": "The cold is setting in."
                            },
                            {
                                "example_id": "8c131a1e-82a1-4af7-ae54-cd89e035a2b4",
                                "sense_id": "5b7f6896-625b-356c-98d7-7b13995c55e7",
                                "text": "Ра́но о́сень наступа́ет.",
                                "translation": "Autumn is coming early.",
                                "english": "Autumn is coming early."
                            }
                        ]
                    },
                    {
                        "sense_id": "9d170aaf-6bc2-3457-add9-d7a4e96cc68d",
                        "entry_id": "3559d04a-8cf7-3af2-91ea-6c6fddd04a2b",
                        "glosses": [
                            "to attack, to advance, to be on the offensive"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c06132c-0cc2-4e97-a0b8-c2b832a0961d",
                                "sense_id": "9d170aaf-6bc2-3457-add9-d7a4e96cc68d",
                                "text": "Враг наступа́ет.",
                                "translation": "The enemy is advancing.",
                                "english": "The enemy is advancing."
                            }
                        ]
                    }
                ],
