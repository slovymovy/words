                "senses": [
                    {
                        "sense_id": "6d930fc7-f21d-3fea-93ef-c958a39ff4e4",
                        "entry_id": "74cd5a6c-b2c4-306a-9349-4aa6374c8050",
                        "glosses": [
                            "Redonner un caractère territorial à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8516dc44-18ee-4183-8cae-bc555ae41d78",
                                "sense_id": "6d930fc7-f21d-3fea-93ef-c958a39ff4e4",
                                "text": "Il faut une «nouvelle économie du bien manger» et la technologie la plus pointue doit contribuer à re-naturer, re-socialiser et re-territorialiser la manière de nous nourrir."
                            },
                            {
                                "example_id": "4af24134-4bb3-44dc-b6b5-df8c380d53e2",
                                "sense_id": "6d930fc7-f21d-3fea-93ef-c958a39ff4e4",
                                "text": "On savait qu’il fallait re-territorialiser les stations. Mais c’est une relation bijective : il faut aussi re-stationnaliser les territoires supports » - E. Marcelpoil - Cemagref"
                            },
                            {
                                "example_id": "e568cb01-6bc8-4bfe-b85a-b82e547cbf9b",
                                "sense_id": "6d930fc7-f21d-3fea-93ef-c958a39ff4e4",
                                "text": "Assimilant à une annexion la pénétration de ce qu'ils considèrent encore comme leur terre, les blancs ont pour principal dessein de se re-territorialiser, de manière à conserver, pour eux seuls, informellement, une part de leur cité idéale perdue."
                            }
                        ]
                    }
