                    },
                    {
                        "sense_id": "416dfcac-d3f1-3205-923d-90362f26421f",
                        "entry_id": "8db49bcb-73b0-3527-803c-9440296d67e5",
                        "glosses": [
                            "The degree to which something, such as a knowledge structure, is veridical; the degree to which an experience, perception, or interpretation accurately represents reality."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "d2cada84-1d25-4eed-8c40-afe79a299be4",
                                "sense_id": "416dfcac-d3f1-3205-923d-90362f26421f",
                                "text": "Symbol structures can, and commonly do, serve as internal representations (e.g. \"mental images\") of the environments to which the symbol system is seeking to adapt. They allow it to model that environment with greater or less veridicality and in greater or less detail, and consequently to reason about it."
                            }
                        ]
                    }
                ],
