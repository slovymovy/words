                        "examples": [
                            {
                                "example_id": "1e716da3-172a-410c-8f48-e20125ce77f2",
                                "sense_id": "ffb9193b-2ef6-38b7-a113-747743220dda",
                                "text": "Alle sogenannten Sommergewächse, alles, was im Herbst mit Blühen nicht enden kann und sich der Kälte noch keck entgegenentwickelt, Astern besonders, waren in der größten Mannigfaltigkeit gesäet und sollten nun, überallhin verpflanzt, einen Sternhimmel über die Erde bilden.",
                                "translation": "Elective Affinities",
                                "english": "Elective Affinities"
                            }
                        ]
                    }
