                        "examples": [
                            {
                                "example_id": "18e96395-b83b-45fa-83ac-fad779a30442",
                                "sense_id": "34d341ee-b5ca-3f8c-9dcd-e6f0bbced664",
                                "text": "Un type qui ressemble fort à un vadrouilleur ; je les ai vus quitter le quai ensemble."
                            },
                            {
                                "example_id": "de334fc5-3e2a-4f9e-a380-bc2d78a97521",
                                "sense_id": "34d341ee-b5ca-3f8c-9dcd-e6f0bbced664",
                                "text": "Oh ! pour ce qu’il s’y intéressait, à sa famille, ce petit vadrouilleur-là…"
                            },
                            {
                                "example_id": "ba2090e7-1ba0-4eac-8f35-501bd704eb75",
                                "sense_id": "34d341ee-b5ca-3f8c-9dcd-e6f0bbced664",
                                "text": "Le conducteur de la voiture ne peut être qu’un vadrouilleur dominical, qui va de rien à rien, mais qu’un ralentissement imposé dans ce programme agacera bientôt."
                            }
                        ]
                    }
                ],
