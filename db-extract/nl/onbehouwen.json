                ],
                "senses": [
                    {
                        "sense_id": "f630990e-cca2-3070-95f9-8122c33373de",
                        "entry_id": "2096efb7-f052-37f0-a243-77e0659e89ed",
                        "glosses": [
                            "van een persoon een lomp en ruw en zonder enige beschaving"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43f98e2c-dac5-42b9-8531-28754ffca9eb",
                                "sense_id": "f630990e-cca2-3070-95f9-8122c33373de",
                                "text": "Uber krijgt een normale ceo. En wordt dus een normaal bedrijf. Dat wordt wennen! Er waren nochtans een aantal beroemde zakenlui genoemd als mogelijke opvolgers van de onbehouwen, met pek en ­veren weggestuurde oprichter Travis Kalanick. Meg Whitman bijvoorbeeld, de taaie dame die eBay groot maakte en ooit (tevergeefs) probeerde om ­Arnold Schwarzenegger op te volgen als gouverneur van Californië. Van haar wist je zeker dat ze geen geduld zou hebben met de seksuele intimidatie die diep ingeburgerd was bij het online taxibedrijf - Whitman is bijna even grofgebekt als Kalanick zelf, en ze heeft een notoir kort lontje."
                            },
                            {
                                "example_id": "17a928e3-377b-49f5-ac53-38b77c0e316a",
                                "sense_id": "f630990e-cca2-3070-95f9-8122c33373de",
                                "text": "Zichtbaar emotioneel vertelde hij over het verlies in 2013 van zijn broer, prins Friso, na een skiongeluk. 'Je beseft pas wat je verliest als je elkaar niet meer hebt. Hij leefde in Londen, met Mabel en de kinderen, maar was wel een goede adviseur op de achtergrond. Soms onbehouwen, maar altijd goudeerlijk. Als je dat niet meer hebt, mis je dat echt wel (...) Je ziet ook wat er gebeurt met een moeder die een kind verliest, die een deel van zichzelf verliest.'"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "812a7532-5e75-4688-8d2c-31a82d5f4ff2",
                        "source_entry_id": "2096efb7-f052-37f0-a243-77e0659e89ed",
                        "source_sense_id": "f630990e-cca2-3070-95f9-8122c33373de",
                        "source_sense_description": "van een persoon een lomp en ruw en zonder enige beschaving",
                        "target_lang_word": "rude",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rude",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "90964215-9a73-3170-9686-5c6f1be5bac7",
                                        "entry_id": "9e443223-cc6e-3974-8454-5adaa5becc55",
                                        "glosses": [
                                            "Lacking in refinement or civility; bad-mannered; discourteous."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7af2e8e-9021-46e4-8376-3914da0ef7d2",
                                                "sense_id": "90964215-9a73-3170-9686-5c6f1be5bac7",
                                                "text": "This girl was so rude towards the cashier by screaming at him for no apparent reason."
                                            },
                                            {
                                                "example_id": "b77bc3f6-ea7f-46c4-af8f-18bdefafd0ac",
                                                "sense_id": "90964215-9a73-3170-9686-5c6f1be5bac7",
                                                "text": "Karen broke up with Fred because he was often rude to her."
                                            },
                                            {
                                                "example_id": "09e1d8c5-af90-402c-bfb7-152e0d6f4c83",
                                                "sense_id": "90964215-9a73-3170-9686-5c6f1be5bac7",
                                                "text": "Art thou thus bolden'd, man, by thy distress?\nOr else a rude despiser of good manners,\nThat in civility thou seem'st so empty?"
                                            },
                                            {
                                                "example_id": "69d4bdd6-2e7b-471e-8afc-4ac6a462a4dd",
                                                "sense_id": "90964215-9a73-3170-9686-5c6f1be5bac7",
                                                "text": "[S]he was rude to Sir James sometimes; but he is so kind, he never noticed it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f02ea987-aaf5-30ab-9b03-e8b60ed5b354",
                                        "entry_id": "9e443223-cc6e-3974-8454-5adaa5becc55",
                                        "glosses": [
                                            "Lacking refinement or skill; untaught; ignorant; raw."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9bab2305-a7e2-48a3-965f-e177c7be2e8c",
                                                "sense_id": "f02ea987-aaf5-30ab-9b03-e8b60ed5b354",
                                                "text": "But though I be rude in speech, yet not in knowledge"
                                            },
                                            {
                                                "example_id": "8de9ad85-bea2-4ad8-a166-d3f9a81e92cd",
                                                "sense_id": "f02ea987-aaf5-30ab-9b03-e8b60ed5b354",
                                                "text": "Though not as shee with Bow and Quiver armd,\nBut with such Gardning Tools as Are yet rude,\nGuiltless of fire had formd, or Angels brought […]"
                                            },
                                            {
                                                "example_id": "af822044-c4ba-4e95-8828-69e12a9a3e61",
                                                "sense_id": "f02ea987-aaf5-30ab-9b03-e8b60ed5b354",
                                                "text": "It might be apprehended, that among rude nations, where the means of subsistence are procured with so much difficulty, the mind could never raise itself above the consideration of this subject"
                                            },
                                            {
                                                "example_id": "bc9cd124-4fc0-4151-bcc8-e931a2265b3a",
                                                "sense_id": "f02ea987-aaf5-30ab-9b03-e8b60ed5b354",
                                                "text": "She had one of the caves fitted up as a laboratory, and, although her appliances were necessarily rude, the results that she attained were, as will become clear in the course of this narrative, sufficiently surprising."
                                            },
                                            {
                                                "example_id": "8b686d6a-71a9-4741-af5c-b0ee24e8e3fc",
                                                "sense_id": "f02ea987-aaf5-30ab-9b03-e8b60ed5b354",
                                                "text": "When the flush of a new-born sun fell first on Eden's green and gold,\nOur father Adam sat under the Tree and scratched with a stick in the mould;\nAnd the first rude sketch that the world had seen was joy to his mighty heart,\nTill the Devil whispered behind the leaves, \"It's pretty, but is it Art?\""
                                            },
                                            {
                                                "example_id": "6ca94050-2802-4173-9826-1f00cc226713",
                                                "sense_id": "f02ea987-aaf5-30ab-9b03-e8b60ed5b354",
                                                "text": "There was a rude bridge there, much fallen, where floating branches caught and white water swirled; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7f323698-ff74-394d-8f96-9155197ce181",
                                        "entry_id": "9e443223-cc6e-3974-8454-5adaa5becc55",
                                        "glosses": [
                                            "Violent; abrupt; turbulent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8812c955-5c47-43e7-8f4f-0a1421493f3a",
                                                "sense_id": "7f323698-ff74-394d-8f96-9155197ce181",
                                                "text": "a rude awakening"
                                            },
                                            {
                                                "example_id": "a761377c-8d1b-4b3b-bda6-d0d6bea6f9ef",
                                                "sense_id": "7f323698-ff74-394d-8f96-9155197ce181",
                                                "text": "The Air attrite to Fire, as late the Clouds\nJustling or pusht with Winds rude in thir shock"
                                            },
                                            {
                                                "example_id": "18297c9d-6d3f-48a0-a9c2-66482f03b2a5",
                                                "sense_id": "7f323698-ff74-394d-8f96-9155197ce181",
                                                "text": "All night no ruder air perplex\n⁠Thy sliding keel, till Phosphor, bright\n⁠As our pure love, thro’ early light\nShall glimmer on the dewy decks."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ea0ee62-4775-31ff-b04a-8d9e7873f023",
                                        "entry_id": "9e443223-cc6e-3974-8454-5adaa5becc55",
                                        "glosses": [
                                            "Somewhat obscene, pornographic, offensive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "549dcdf2-0ca3-4cc0-9b98-aff83daf0431",
                                                "sense_id": "3ea0ee62-4775-31ff-b04a-8d9e7873f023",
                                                "text": "a rude film"
                                            },
                                            {
                                                "example_id": "6abd35ec-883f-46be-a2b7-8ee80fa5aa41",
                                                "sense_id": "3ea0ee62-4775-31ff-b04a-8d9e7873f023",
                                                "text": "rude language"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7607b321-b908-3ffc-9f9c-51005937c4c7",
                                        "entry_id": "9e443223-cc6e-3974-8454-5adaa5becc55",
                                        "glosses": [
                                            "Undeveloped, unskilled, inelegant."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "76aa5041-fd3b-366f-a282-8aa175e4c7d7",
                                        "entry_id": "9e443223-cc6e-3974-8454-5adaa5becc55",
                                        "glosses": [
                                            "Hearty, vigorous; found particularly in the phrase rude health."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b16fe0d-973b-497f-bfc6-6949e9f0b11e",
                                                "sense_id": "76aa5041-fd3b-366f-a282-8aa175e4c7d7",
                                                "text": "A comfortable house for a rude and hardy race, that lived mostly out of doors, was once made here almost entirely of such materials as Nature furnished ready to their hands."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a69ee9c-c257-373f-abfa-8772c6a2c2a2",
                                        "entry_id": "9e443223-cc6e-3974-8454-5adaa5becc55",
                                        "glosses": [
                                            "Crudely made; primitive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "177dca26-5378-4d1b-b1fb-e5cf7640b4e9",
                                                "sense_id": "1a69ee9c-c257-373f-abfa-8772c6a2c2a2",
                                                "text": "For a while, purple-robed, heel-dangling, I sat on the edge of one of the rude tables, under the wooshing pines."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54ee2d87-d538-3baa-b0db-a1b956c70752",
                                        "entry_id": "9e443223-cc6e-3974-8454-5adaa5becc55",
                                        "glosses": [
                                            "Good, awesome."
                                        ],
                                        "tags": [
                                            "Multicultural-London-English",
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "15a6da86-831f-3a22-9044-8cd6587e9af8",
                                        "entry_id": "9e443223-cc6e-3974-8454-5adaa5becc55",
                                        "glosses": [
                                            "Sexy, hot, overtly attractive."
                                        ],
                                        "tags": [
                                            "Multicultural-London-English",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b0ab7d6-4a92-4b2c-b3ac-0e0b6c2416db",
                                                "sense_id": "15a6da86-831f-3a22-9044-8cd6587e9af8",
                                                "text": "Now the girl's rude, I know she's rude/But she's screwed right through you, you'll be on your knees soon"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
