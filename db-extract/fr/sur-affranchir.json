                ],
                "senses": [
                    {
                        "sense_id": "d115aebc-2e97-3c24-a159-ff3cf9883fb1",
                        "entry_id": "97183d0c-1477-32c8-9c7e-5b52803b87ea",
                        "glosses": [
                            "Affranchir (un courrier) à un tarif supérieur au tarif normal."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a58f3b47-5241-4f18-adc6-870b6e0670ed",
                                "sense_id": "d115aebc-2e97-3c24-a159-ff3cf9883fb1",
                                "text": "Elles permettent ensuite de réaliser jusqu'à 12% d'économie en garantissant un affranchissement automatique au centime près là où les utilisateurs de timbres ont souvent tendance à sur-affranchir leur courrier."
                            },
                            {
                                "example_id": "0a578442-4e9e-48b4-a71d-e03514eff444",
                                "sense_id": "d115aebc-2e97-3c24-a159-ff3cf9883fb1",
                                "text": "La balance postale permet de peser précisément vos courriers et donc de les affranchir au centime près. Cela vous permet d'éviter de sur-affranchir vos envois."
                            },
                            {
                                "example_id": "d9bdf787-f89d-47cc-9e7f-fb54003d4860",
                                "sense_id": "d115aebc-2e97-3c24-a159-ff3cf9883fb1",
                                "text": "Si votre affranchisseuse de courrier ne dispose pas de balance intégrée, il est possible de lui en adjoindre une qui vous évitera de sur-affranchir vos plis."
                            }
                        ]
                    }
                ],
