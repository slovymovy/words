{
    "word_family": [
        "sew",
        "sewage",
        "sewerage"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c6d864b4-a068-36c5-85f3-e439f753db15",
                    "sense_definition": "A pipe or system of pipes used to carry away waste and provide drainage.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "infrastructure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The city is planning to upgrade the old <w>sewer</w> system to prevent flooding.",
                            "target_lang_translations": {
                                "ru": "Город планирует модернизировать старую систему <w>канализации</w>, чтобы предотвратить затопление."
                            }
                        },
                        {
                            "text": "Workers were sent down into the <w>sewer</w> to clear a blockage in the pipes.",
                            "target_lang_translations": {
                                "ru": "Рабочих отправили в <w>канализацию</w>, чтобы устранить засор в трубах."
                            }
                        }
                    ],
                    "common_phrases": [
                        "sewer system",
                        "sewer pipe"
                    ],
                    "target_lang_definitions": {
                        "ru": "Система труб или каналов для отвода сточных вод и обеспечения дренажа."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "канализа́ция",
                                "target_lang_sense_clarification": "общая система отвода сточных вод"
                            },
                            {
                                "target_lang_word": "канализацио́нная труба́",
                                "target_lang_sense_clarification": "конкретный элемент системы"
                            },
                            {
                                "target_lang_word": "колле́ктор",
                                "target_lang_sense_clarification": "крупный подземный трубопровод для сточных вод"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "988c53f1-a60e-3ca1-8c24-99bd01f86993",
                    "sense_definition": "A person who sews.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The skilled <w>sewer</w> carefully stitched the delicate fabric by hand.",
                            "target_lang_translations": {
                                "ru": "Опытная <w>швея</w> аккуратно сшила деликатную ткань вручную."
                            }
                        },
                        {
                            "text": "Every professional <w>sewer</w> knows the importance of using the right needle.",
                            "target_lang_translations": {
                                "ru": "Каждый профессиональный <w>портной</w> знает, как важно использовать правильную иглу."
                            }
                        }
                    ],
                    "synonyms": [
                        "seamstress",
                        "sewist",
                        "tailor"
                    ],
                    "common_phrases": [
                        "skilled sewer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который занимается шитьем."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "швея́",
                                "target_lang_sense_clarification": "мастер по шитью одежды"
                            },
                            {
                                "target_lang_word": "портно́й",
                                "target_lang_sense_clarification": "мастер по пошиву одежды (обычно мужской)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "057c8974-0fb0-3bb4-bedb-5cd88cd080ed",
                    "sense_definition": "An official in a royal or noble household responsible for serving meals and seating guests.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "historical_role",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>sewer</w> stood by the table to ensure the king's dinner was served properly.",
                            "target_lang_translations": {
                                "ru": "<w>Стольник</w> стоял у стола, следя за тем, чтобы обед короля был подан должным образом."
                            }
                        },
                        {
                            "text": "In the medieval court, the <w>sewer</w> held a position of significant trust.",
                            "target_lang_translations": {
                                "ru": "При средневековом дворе <w>стольник</w> занимал должность, требующую большого доверия."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Refers to a historical role in a household."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Должностное лицо в королевском или знатном доме, отвечающее за подачу блюд и рассадку гостей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сто́льник",
                                "target_lang_sense_clarification": "исторический придворный чин, подававший кушанья к столу"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6fc6bb96-3c2d-3be2-84f9-cfe92e709c61",
                    "sense_definition": "A type of moth whose larva uses silk to sew leaf edges together.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "insect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The apple-leaf <w>sewer</w> can cause significant damage to orchard foliage.",
                            "target_lang_translations": {
                                "ru": "Яблонная <w>листовёртка</w> может нанести значительный ущерб листве в садах."
                            }
                        },
                        {
                            "text": "Researchers identified the pest as a common leaf <w>sewer</w>.",
                            "target_lang_translations": {
                                "ru": "Исследователи определили вредителя как обычную <w>листовёртку</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вид моли, личинка которой использует шелк для сшивания краев листьев."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "листовёртка",
                                "target_lang_sense_clarification": "насекомое, повреждающее листья растений"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "084d4f14-581a-3361-8e57-b56509684d20",
                    "sense_definition": "To install a system of sewers in a specific area.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "infrastructure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The town council decided to <w>sewer</w> the new residential development last summer.",
                            "target_lang_translations": {
                                "ru": "Городской совет решил <w>провести канализацию</w> в новом жилом районе прошлым летом."
                            }
                        },
                        {
                            "text": "It is expensive to <w>sewer</w> rural areas due to the distance between houses.",
                            "target_lang_translations": {
                                "ru": "Дорого <w>проводить канализацию</w> в сельской местности из-за большого расстояния между домами."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прокладывать канализационную систему в определенном районе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проводи́ть канализа́цию",
                                "target_lang_sense_clarification": "процесс установки системы"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}