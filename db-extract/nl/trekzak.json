                                                "sense_id": "1174d87d-b256-3b87-88c6-571f6aa2709d",
                                                "text": "Pat pushed the button marked \"shred\" on the blender."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d3cf2f0-469a-3383-b2af-728391ce75a0",
                                        "entry_id": "45ea75df-b244-34db-af6c-41d79d5baefc",
