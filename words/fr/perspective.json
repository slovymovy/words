                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "art_vision",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Au fond de l'allée du jardin, une fausse <w>perspective</w> donnait l'illusion d'une colonnade romaine."
                        },
                        {
                            "text": "L'artiste a restauré la <w>perspective</w> peinte sur le mur extérieur du pavillon."
