                    "sense_definition": "To pledge to marry someone; to betroth.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "pledge",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The duke intended to <w>troth</w> his daughter to the neighboring prince to secure peace.",
                            "target_lang_translations": {
                                "es": "El duque tenía la intención de <w>desposar</w> a su hija con el príncipe vecino para asegurar la paz."
                            }
                        },
                        {
                            "text": "They chose to <w>troth</w> each other before departing for distant lands.",
                            "target_lang_translations": {
                                "es": "Decidieron <w>comprometerse</w> mutuamente antes de partir hacia tierras lejanas."
                            }
                        }
                    ],
                    "synonyms": [
