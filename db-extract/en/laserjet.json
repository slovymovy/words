                        "sense_id": "0f999efc-0edc-3748-afd6-0519aea27508",
                        "entry_id": "c6350cc3-f302-398c-a0bb-c7b31b843124",
                        "glosses": [
                            "A laser printer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c184daf-831c-431c-8c4c-0d5d96d5d0a3",
                                "sense_id": "0f999efc-0edc-3748-afd6-0519aea27508",
                                "text": "The application, form and all, can be printed on hundreds of printers including inkjet and laserjets."
                            },
                            {
                                "example_id": "af550bc9-209c-4bee-bc40-3b43df8055b6",
                                "sense_id": "0f999efc-0edc-3748-afd6-0519aea27508",
                                "text": "Printers, such as inkjets and laserjets, typically print at resolutions ranging from 300 to 720 dots per inch (dpi)."
                            },
                            {
                                "example_id": "dde02921-9c40-4a14-a8f8-6b26b97019d4",
                                "sense_id": "0f999efc-0edc-3748-afd6-0519aea27508",
                                "text": "the Samsung SCX-4100 compares well with other small, desktop laserjets and you get a copier and scanner thrown in."
                            },
                            {
                                "example_id": "40e934af-640a-4af8-977e-bb5b29b74d90",
                                "sense_id": "0f999efc-0edc-3748-afd6-0519aea27508",
                                "text": "Profiles are available for inkjets, dye-subs, and small event printers (Sony); Kodak- and 8600-series printers; Fuji Pictography printers; RA-4 printers (Light Jet, Durst Lambda/Epsilon, Fuji Frontier, Noritsu QSS, Gretag Sienna, Kodak LED, Agfa D-Lab, etc.); color laserjets; and thermal printers."
                            },
                            {
                                "example_id": "eab3491f-70f6-4380-a780-d753409a036e",
                                "sense_id": "0f999efc-0edc-3748-afd6-0519aea27508",
                                "text": "Did you know that the famous computer printer companies can sell their laserjets, inkjets and dot printers at under production cost?"
                            },
                            {
                                "example_id": "3705189f-0251-4b56-9590-dc839cdf6829",
                                "sense_id": "0f999efc-0edc-3748-afd6-0519aea27508",
                                "text": "HP aims to improve energy efficiency of its inkjet and laserjet printers 40% by 2011 and to triple its use of recycled material in inkjet products by 2011."
                            }
                        ]
                    }
