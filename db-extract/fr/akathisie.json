                "senses": [
                    {
                        "sense_id": "b84b46dc-f255-30eb-a46d-d0a233079da5",
                        "entry_id": "586a5d10-19d1-38fd-9ff3-763cdba31885",
                        "glosses": [
                            "Impossibilité (ou grande difficulté) de rester assis, pour cause d’une forte sensation d'inconfort."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db9d4423-2d30-44b3-b845-561a0b9a3caf",
                                "sense_id": "b84b46dc-f255-30eb-a46d-d0a233079da5",
                                "text": "L’akathisie favorise par ailleurs la non observance des traitements et augmente le risque de rechute."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2c88ee01-da82-4119-bad3-371246f22e81",
                        "source_entry_id": "586a5d10-19d1-38fd-9ff3-763cdba31885",
                        "source_sense_id": "b84b46dc-f255-30eb-a46d-d0a233079da5",
                        "target_lang_word": "akathisia",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "akathisia",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "56e622d5-1e07-3db2-a671-8c7bdc3d4ad1",
                                        "entry_id": "aa759260-888e-3d4a-abe1-7677af83d4df",
                                        "glosses": [
                                            "A sensation of restlessness characterized by an inability to sit still/down or remain motionless/seated, arising from a subjective need or desire to move, often coinciding with the sensation of twitching of muscles, often as a side effect of psychiatric medications."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "997306fd-74ff-4c4f-9208-bff5fa973f05",
                                                "sense_id": "56e622d5-1e07-3db2-a671-8c7bdc3d4ad1",
                                                "text": "Haskowic first described this condition last November and applied the term \"Akathisia\" to it. The subject can seat himself and remain seated a few minutes, but then the contortions begin, and unless he gets up he suffers actual torture."
                                            },
                                            {
                                                "example_id": "43a0a573-5075-4f51-9fd2-54b31902aef8",
                                                "sense_id": "56e622d5-1e07-3db2-a671-8c7bdc3d4ad1",
                                                "text": "Central Nervous System Effects: Neuromuscular (extrapyramidal) reactions: These are usually dosage-related and may be of three forms: (1) pseudoparkinsonism, (2) akathisia (motor restlessness), and (3) dystonias."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
