                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "8db39f74-9295-448f-8766-554790f75c0b",
                        "entry_id": "d9e5708c-07c9-363a-94c5-09b52d15029c",
                        "tags": [
                            "plural"
                        ],
                        "form": "uprises"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "44ac2f12-ed2e-3a8a-bf80-a9e21b89b886",
                        "entry_id": "d9e5708c-07c9-363a-94c5-09b52d15029c",
                        "glosses": [
                            "The act of rising; appearance above the horizon; rising."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab2beb93-9a96-4f7e-ace5-6eab580d5d4c",
                                "sense_id": "44ac2f12-ed2e-3a8a-bf80-a9e21b89b886",
                                "text": "I told her of my sufferings and my madness,\nAnd how, awakened from that dreamy mood\nBy Liberty’s uprise, the strength of gladness\nCame to my spirit in my solitude; […]"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
