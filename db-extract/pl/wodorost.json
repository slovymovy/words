                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "водоросль",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "5bafbd9f-b658-3b6f-a0a5-abdac8c67484",
                                        "entry_id": "53c81759-bf3d-3047-b925-5232b46aa401",
                                        "glosses": [
                                            "низшее растение, обитающее, как правило, в воде"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20f7e9e8-1fac-4538-849d-51930afb99fe",
                                                "sense_id": "5bafbd9f-b658-3b6f-a0a5-abdac8c67484",
                                                "text": "Одноклеточная водоросль."
                                            },
                                            {
                                                "example_id": "139928ab-4e8b-4bf3-9268-e2044413a286",
                                                "sense_id": "5bafbd9f-b658-3b6f-a0a5-abdac8c67484",
                                                "text": "Некоторые водоросли, вступая в симбиоз с грибами, образуют лишайники."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b5c350af-dc4f-32a9-af85-d395e5f8a7de",
                                        "entry_id": "53c81759-bf3d-3047-b925-5232b46aa401",
                                        "glosses": [
                                            "ботан. мн. ч. гетерогенная экологическая группа таких растений"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05ceb242-959e-40c4-8b25-c89979ac6470",
                                                "sense_id": "b5c350af-dc4f-32a9-af85-d395e5f8a7de",
                                                "text": "Раньше к водорослям относили также цианобактерий (их старое название — сине-зелёные водоросли), которые, как сейчас понятно, не являются ни водорослями, ни вообще растениями, ни даже эукариотами."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
