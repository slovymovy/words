                    {
                        "translation_id": "bc6ddff7-3238-4a0d-b38c-6c379f0f79ba",
                        "source_entry_id": "9a6e2bc3-2379-32a6-997d-52c6fb32da1a",
                        "source_sense_description": "s’irriter excessivement",
                        "target_lang_word": "die Nerven verlieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "die Nerven verlieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dc0ba8c9-2118-3f2b-8902-88a9ad622624",
                                        "entry_id": "a7c923b2-4fcf-3b58-b32e-26d506df06c2",
                                        "glosses": [
                                            "unangemessen heftig, panisch, unbeherrscht reagieren, kopflos werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3955a106-91f5-4093-b373-7a25edfd173a",
                                                "sense_id": "dc0ba8c9-2118-3f2b-8902-88a9ad622624",
                                                "text": "Beim Bergsteigen darf man in brenzligen Situationen auf keinen Fall die Nerven verlieren, sondern muss Ruhe bewahren."
                                            },
                                            {
                                                "example_id": "f35f6bea-73e0-47f1-b402-8b5bb9bb3799",
                                                "sense_id": "dc0ba8c9-2118-3f2b-8902-88a9ad622624",
                                                "text": "„Dann aber kassierte Fognini im ersten Spiel des zweiten Durchgangs das Break, verlor die Nerven, zertrümmerte sogar seinen Schläger und war nach 1:28 Stunden geschlagen.“"
                                            },
                                            {
                                                "example_id": "94754863-59b1-46d9-bb08-f66d194495b2",
                                                "sense_id": "dc0ba8c9-2118-3f2b-8902-88a9ad622624",
                                                "text": "„Blutige Familientragödie am Niederrhein: Ein Rentner hat offenbar bei einem Gutachter-Termin im Haus seiner Tochter in Schwalmtal die Nerven verloren und blind um sich geschossen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
