                    {
                        "sense_id": "2d87eaa4-b7eb-3a8e-9fd8-9678c52edca8",
                        "entry_id": "4780ecc6-4385-3f76-bcb1-d613aad7561a",
                        "glosses": [
                            "Versorgung von (bedürftigen) Personen mit Nahrung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f735039-0e4d-46e3-9b11-18f67816c71d",
                                "sense_id": "2d87eaa4-b7eb-3a8e-9fd8-9678c52edca8",
                                "text": "„Wie bereits angedeutet, standen der Totenkult der christlichen Religion und die Speisung der Armen eng in Verknüpfung. Wie viele christliche Rituale findet auch die Armenspeisung ihren Ursprung im Heidentum, besonders im Zusammenhang mit den Totenmählern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "8866999b-077a-3a15-a258-a8ae07422cad",
                        "entry_id": "4780ecc6-4385-3f76-bcb1-d613aad7561a",
                        "glosses": [
                            "Versorgung eines Systems mit den zum Betrieb erforderlichen Ressourcen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30f288fd-7a84-4a19-8109-4015df250479",
                                "sense_id": "8866999b-077a-3a15-a258-a8ae07422cad",
                                "text": "„Um die Energielieferung nicht zu unterbrechen, ist entweder Kurzunterbrechung oder zumindest zweiseitige Speisung (vermaschtes Netz) anzuwenden.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
