                                        "sense_id": "520f12f6-f866-3521-8884-43811bc454af",
                                        "entry_id": "c6f6f7b7-182a-3028-a829-d112b9b8b23e",
                                        "glosses": [
                                            "druh míčové hry pro dva nebo čtyři hráče hraný přes nataženou síť speciálními raketami"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d794af1-bfa8-43ab-a8eb-892d46cc12e8",
                                                "sense_id": "520f12f6-f866-3521-8884-43811bc454af",
                                                "text": "Kolébkou tenisu (stejně jako fotbalu) je Anglie."
                                            },
                                            {
                                                "example_id": "6a3e94b3-c4ff-42fb-a791-6124556f8db7",
                                                "sense_id": "520f12f6-f866-3521-8884-43811bc454af",
                                                "text": "V pražské politice devadesátých let se ten, kdo vůbec nehrál tenis, mohl jít zahrabat."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tenis",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "89384f7a-d44f-34c5-ace8-b20c1366b900",
                                        "entry_id": "3fd56dcf-7525-35b9-88ce-b26f794067ff",
