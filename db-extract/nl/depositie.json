                    {
                        "sense_id": "72636238-0be6-3f04-87d5-4ba3e84c2276",
                        "entry_id": "afd587b3-329a-3f2a-8081-96d9b4bc2f04",
                        "glosses": [
                            "het neerslaan van minerale stoffen en gassen op een vaste ondergrond"
