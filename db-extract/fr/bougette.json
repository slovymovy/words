        "fr-extract.jsonl": [
            {
                "entry_id": "652f52ab-ecfe-3dc1-9899-79cbabe193e0",
                "word": "bougette",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "9bbec1a2-4ff3-4aa8-9f8a-5d655251bec4",
                        "entry_id": "652f52ab-ecfe-3dc1-9899-79cbabe193e0",
                        "tags": [
                            "plural"
                        ],
                        "form": "bougettes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2148b0ff-0aa8-339b-9a9c-24a3c066e550",
                        "entry_id": "652f52ab-ecfe-3dc1-9899-79cbabe193e0",
                        "glosses": [
                            "Sacoche de voyage en cuir."
                        ],
                        "tags": [
                            "dated",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "45551601-626d-43b7-aa2b-224c29897650",
                                "sense_id": "2148b0ff-0aa8-339b-9a9c-24a3c066e550",
                                "text": "Trésor des Fèves descendit de son équipage, le ramassa précieusement, et le laissa couler dans une bougette de cuir qu'il avait à sa ceinture pour y serrer les échantillons de ses fèves, mais après en avoir retiré le porte-manteau."
                            },
                            {
                                "example_id": "4c4cff53-11f4-4e76-ab41-786f3f14ec77",
                                "sense_id": "2148b0ff-0aa8-339b-9a9c-24a3c066e550",
                                "text": "Monsieur, dit-elle, il y a environ deux mois que deux hommes accoutrez en marchands vinrent loger céans, et d’arrivée me donnèrent à garder une grande bougette de cuir fermée à clé, fort pesante."
                            },
                            {
                                "example_id": "d2bd78f1-7e79-4e9f-954c-fa9643bb0ee3",
                                "sense_id": "2148b0ff-0aa8-339b-9a9c-24a3c066e550",
                                "text": "Mon hôtesse, baillez-moi un peu la bougette ; car nous allons faire un payement avec ces marchands que vous voyez là."
                            },
                            {
                                "example_id": "cb553db9-c106-4eb2-a08b-02aae7bed658",
                                "sense_id": "2148b0ff-0aa8-339b-9a9c-24a3c066e550",
                                "text": "Elles portaient à la taille une petite sacoche nommée bulga, ce que les Romains appelaient reticulum, le moyen-âge bougette et les merveilleuses du Directoire, ridicule."
                            },
                            {
                                "example_id": "0806c09d-d08e-45b7-877c-19401623af6a",
                                "sense_id": "2148b0ff-0aa8-339b-9a9c-24a3c066e550",
                                "text": "Le message de Robert d'Artois cousu dans son vêtement et la bague d'argent enfermée dans sa bougette lui semblaient les gages d'un grand avenir."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "93e95954-1df6-4802-bc9b-e35943052f83",
                        "source_entry_id": "652f52ab-ecfe-3dc1-9899-79cbabe193e0",
                        "source_sense_id": "2148b0ff-0aa8-339b-9a9c-24a3c066e550",
                        "target_lang_word": "budget",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "budget",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "643806b6-a4c6-34f7-80ca-221e4afdddaa",
                                        "entry_id": "73753c13-df8c-340f-a9f2-dd45929a2da1",
                                        "glosses": [
                                            "The amount of money or resources earmarked for a particular institution, activity or timeframe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb62edae-9181-4aa4-a360-1c558f9493de",
                                                "sense_id": "643806b6-a4c6-34f7-80ca-221e4afdddaa",
                                                "text": "limited budget"
                                            },
                                            {
                                                "example_id": "3f21d4f4-ee76-415c-bcd2-358262043a15",
                                                "sense_id": "643806b6-a4c6-34f7-80ca-221e4afdddaa",
                                                "text": "unlimited budget"
                                            },
                                            {
                                                "example_id": "75e16c59-1074-4c30-a36f-063d1fff3a0e",
                                                "sense_id": "643806b6-a4c6-34f7-80ca-221e4afdddaa",
                                                "text": "tight budget"
                                            },
                                            {
                                                "example_id": "88a92317-98f4-46ec-9ed7-20e51b31e5f7",
                                                "sense_id": "643806b6-a4c6-34f7-80ca-221e4afdddaa",
                                                "text": "within the budget"
                                            },
                                            {
                                                "example_id": "31c6536b-71cf-428a-b0d0-269525ec14bf",
                                                "sense_id": "643806b6-a4c6-34f7-80ca-221e4afdddaa",
                                                "text": "over the budget"
                                            },
                                            {
                                                "example_id": "2136e8b0-30db-4138-9339-49ff550c7fb4",
                                                "sense_id": "643806b6-a4c6-34f7-80ca-221e4afdddaa",
                                                "text": "At the other extreme, with limitless budgets all they have to do is dream up amazing lighting rigs to be constructed and operated by the huge team of gaffers and sparks, with their generators, discharge lights, flags, gobos and brutes."
                                            },
                                            {
                                                "example_id": "3ba85218-61f5-4ca3-b59a-f0ec679a42b9",
                                                "sense_id": "643806b6-a4c6-34f7-80ca-221e4afdddaa",
                                                "text": "The latest Tory budget continued the trend begun in 2000 by making further small cuts in family income taxes."
                                            },
                                            {
                                                "example_id": "a959cbbf-5900-42ff-bf69-84375e2702e9",
                                                "sense_id": "643806b6-a4c6-34f7-80ca-221e4afdddaa",
                                                "text": "The most common poly budget in use for games at the time of this writing is between 5,000 and 10,000 tris."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f2918e71-45f6-371c-9e76-dbfe8a4bbcd2",
                                        "entry_id": "73753c13-df8c-340f-a9f2-dd45929a2da1",
                                        "glosses": [
                                            "The amount of money or resources earmarked for a particular institution, activity or timeframe.",
                                            "A relatively small amount of available money."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ece8e7a-ce49-4ec6-8660-926bb96d35c3",
                                                "sense_id": "f2918e71-45f6-371c-9e76-dbfe8a4bbcd2",
                                                "text": "We're on a budget, so we can't afford to eat at that restaurant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e86b7332-5780-3cbe-9a0e-4bc20338ceb0",
                                        "entry_id": "73753c13-df8c-340f-a9f2-dd45929a2da1",
                                        "glosses": [
                                            "An itemized summary of intended expenditure; usually coupled with expected revenue."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "17f45c7c-d166-32f8-b636-3e7be247eb8a",
                                        "entry_id": "73753c13-df8c-340f-a9f2-dd45929a2da1",
                                        "glosses": [
                                            "A wallet, purse or bag."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "65e90d3c-0d7e-4c46-9bcd-805e6281843f",
                                                "sense_id": "17f45c7c-d166-32f8-b636-3e7be247eb8a",
                                                "text": "With that out of his bouget forth he drew / Great store of treasure, therewith him to tempt […]"
                                            },
                                            {
                                                "example_id": "691c6396-c80a-44c2-acf8-5ee6d3c85622",
                                                "sense_id": "17f45c7c-d166-32f8-b636-3e7be247eb8a",
                                                "text": "The king holds up a hand to the lute player: ‘Thank you, leave us.’ The boy stuffs his music back into his budget and goes out backwards."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1daec9b2-d3dd-3e87-b6bf-6cf4ffa95689",
                                        "entry_id": "73753c13-df8c-340f-a9f2-dd45929a2da1",
                                        "glosses": [
                                            "A compact collection of things."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "895e4ed9-6663-4a31-bbec-25ab1138f962",
                                                "sense_id": "1daec9b2-d3dd-3e87-b6bf-6cf4ffa95689",
                                                "text": "I set off, therefore, in high spirits, for I felt that I had done good work and was bringing back a fine budget of news for my companions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f02122e-e813-3700-9d3d-a8b658bd0088",
                                        "entry_id": "73753c13-df8c-340f-a9f2-dd45929a2da1",
                                        "glosses": [
                                            "A socket in which the end of a cavalry carbine rests."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "budget",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3d958676-4164-3661-a58f-0a08730a6baa",
                                        "entry_id": "54bdf3fd-6cca-36c3-a1b2-4ced332bd4a6",
                                        "glosses": [
                                            "Appropriate to a restricted budget."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7a419de0-cb5b-4130-85cc-7a0fcc0ac848",
                                                "sense_id": "3d958676-4164-3661-a58f-0a08730a6baa",
                                                "text": "We flew on a budget airline."
                                            },
                                            {
                                                "example_id": "7c27ab10-f001-44db-8174-4fab3074f778",
                                                "sense_id": "3d958676-4164-3661-a58f-0a08730a6baa",
                                                "text": "A classic budget game, there isn't really anything outstanding about Rescue at all."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "budget",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "77178c3e-97fe-3f3e-bc10-d95a338c0642",
                                        "entry_id": "93b2e147-7562-3980-9250-156632529d34",
                                        "glosses": [
                                            "To construct or draw up a budget."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c85283c-c125-49a0-8c34-26bd2f6cc6c4",
                                                "sense_id": "77178c3e-97fe-3f3e-bc10-d95a338c0642",
                                                "text": "Budgeting is even harder in times of recession"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "138ac45e-c0fe-333c-962a-411f70db7860",
                                        "entry_id": "93b2e147-7562-3980-9250-156632529d34",
                                        "glosses": [
                                            "To provide funds, allow for in a budget."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "77a57614-bfeb-414b-b10d-727122af1f43",
                                                "sense_id": "138ac45e-c0fe-333c-962a-411f70db7860",
                                                "text": "The PM’s pet projects are budgeted rather generously"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a0f9710-11a0-32cb-8a88-8fcf09db6ebe",
                                        "entry_id": "93b2e147-7562-3980-9250-156632529d34",
                                        "glosses": [
                                            "To plan for the use of in a budget."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af18633b-dff8-4077-ae37-e29d3060b5e4",
                                                "sense_id": "4a0f9710-11a0-32cb-8a88-8fcf09db6ebe",
                                                "text": "The prestigious building project is budgeted in great detail, from warf facilities to the protocollary opening."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
