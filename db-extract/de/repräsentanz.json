                ],
                "senses": [
                    {
                        "sense_id": "01a16e0c-9a23-3111-a27f-89ec0adb8613",
                        "entry_id": "d2634d2a-b389-3648-b9ef-6680e398068d",
                        "glosses": [
                            "Organisationseinheit eines Unternehmens oder einer Organisation, deren Hauptaufgabe in der Kontaktpflege und der Geschäftsanbahnung besteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be3c2db0-b8ca-4125-897c-a4b08f6a9dd6",
                                "sense_id": "01a16e0c-9a23-3111-a27f-89ec0adb8613",
                                "text": "Unsere Firma eröffnet bald eine neue Repräsentanz in Berlin."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "77765b4c-adac-437d-931e-4646d0bcf53d",
                        "source_entry_id": "d2634d2a-b389-3648-b9ef-6680e398068d",
                        "source_sense_id": "01a16e0c-9a23-3111-a27f-89ec0adb8613",
                        "target_lang_word": "représentation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "représentation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "180c0df9-5c27-3626-9fc6-97eea7913002",
                                        "entry_id": "af90b19d-27ac-31ae-9259-946927be7091",
                                        "glosses": [
                                            "Action de représenter, de rendre présent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "283b4ab0-eb17-4be4-bbb7-288d8cfc7032",
                                                "sense_id": "180c0df9-5c27-3626-9fc6-97eea7913002",
                                                "text": "Il intervint un arrêt qui ordonnait la représentation des titres, la représentation des titres en original."
                                            },
                                            {
                                                "example_id": "b9782153-2047-456d-9f97-97b464efe44b",
                                                "sense_id": "180c0df9-5c27-3626-9fc6-97eea7913002",
                                                "text": "On exigea la représentation de son passeport."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e24bea4-e9bb-3a56-9307-e8febc57cfa5",
                                        "entry_id": "af90b19d-27ac-31ae-9259-946927be7091",
                                        "glosses": [
                                            "Action de représenter des objets, par la peinture, la sculpture, la gravure, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43c56ffc-cb4a-4008-9392-3a2f6a41e545",
                                                "sense_id": "5e24bea4-e9bb-3a56-9307-e8febc57cfa5",
                                                "text": "En outre, différents auteurs adaptèrent à des zootropes, soit des figures construites d’après mes notations chronographiques, soit des images obtenues par le célèbre photographe américain, et obtinrent ainsi une représentation saisissante d’animaux en mouvement."
                                            },
                                            {
                                                "example_id": "e25b8100-3724-4659-b5c0-5d43ad395d81",
                                                "sense_id": "5e24bea4-e9bb-3a56-9307-e8febc57cfa5",
                                                "text": "Qu’un musulman croie la viande de porc immangeable, l’alcool imbuvable, la chevelure d’une femme obscène par définition, blasphématoire la représentation du visage d’un prophète qui fut un homme, libre à lui."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1e5234e-fc24-3cdd-bf8c-119be7572eba",
                                        "entry_id": "af90b19d-27ac-31ae-9259-946927be7091",
                                        "glosses": [
                                            "Description, peinture faite dans un ouvrage de l’esprit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b1e17ec-2e1a-4797-8606-341bfbae127b",
                                                "sense_id": "e1e5234e-fc24-3cdd-bf8c-119be7572eba",
                                                "text": "Nicolas Oresme applique à la représentation du mouvement une représentation graphique, grâce à un système de coordonnées rectangulaires, ce qui fait de lui un précurseur de la géométrie analytique de Descartes."
                                            },
                                            {
                                                "example_id": "b05d3934-cde5-4f92-8879-7595c009f08d",
                                                "sense_id": "e1e5234e-fc24-3cdd-bf8c-119be7572eba",
                                                "text": "On a cru voir dans ce bas-relief une représentation de la mort de Simon de Montfort, tué devant les murs de Toulouse par la pierre d’un engin servi par des femmes, sur la place de Saint-Sernin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c32be6b6-302a-367c-b451-e9cfcc806f56",
                                        "entry_id": "af90b19d-27ac-31ae-9259-946927be7091",
                                        "glosses": [
                                            "Action de représenter des pièces de théâtre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a544f184-7f49-4504-a254-b93ac73edd39",
                                                "sense_id": "c32be6b6-302a-367c-b451-e9cfcc806f56",
                                                "text": "le 10 nov. Je fus ce matin chez Mme de Trémonet.[…]. Elle nous a procuré une loge pour après-demain à la 6ᵉ représentation de « Charles IX »."
                                            },
                                            {
                                                "example_id": "dfd0f83f-8c96-4df9-9122-1402e2a969a8",
                                                "sense_id": "c32be6b6-302a-367c-b451-e9cfcc806f56",
                                                "text": "À la ville comme à la scène, ce Fregoli de la chanson ne cesse d'être en représentation. Jamais naturel, toujours à la parade."
                                            },
                                            {
                                                "example_id": "30c56b7b-3d05-4fdf-9b33-d954df050f38",
                                                "sense_id": "c32be6b6-302a-367c-b451-e9cfcc806f56",
                                                "text": "— Quand Napoléon III fut empoigné à Boulogne pour avoir donné une seconde représentation du débarquement à Cannes, on le jeta au cachot et on l’emmena à Paris sans lui donner le temps de changer de chemise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "715c7448-2eee-343d-b804-51bbcc71f908",
                                        "entry_id": "af90b19d-27ac-31ae-9259-946927be7091",
                                        "glosses": [
                                            "Acte par lequel l’esprit reproduit en lui des images."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93864e0e-92ac-4554-a8e4-5a88f7a11e85",
                                                "sense_id": "715c7448-2eee-343d-b804-51bbcc71f908",
                                                "text": "Je représentai à M. Norman qu’il convenait mieux de les tenir tous réunis, dans la crainte d’une attaque subite de la part des insulaires; mais notre commandant n’eut pas d’égard à cette représentation."
                                            },
                                            {
                                                "example_id": "5bba4edc-39b5-4797-9eb9-060ae7956705",
                                                "sense_id": "715c7448-2eee-343d-b804-51bbcc71f908",
                                                "text": "Interrogeant la science et laissant comme les guerres leur empreinte au niveau démographique, l’impact des pandémies s'est ancré dans les représentations sociales : un impact symbolisé par une mémorisation d'un nombre important de morts (la Peste Noire – dite « la Grande Peste » – ayant décimé plus d'un tiers de la population médiévale – au XIVᵉ siècle – du Royaume de France et la « grippe espagnole » en 1918-19, plus de cinquante millions des habitants du globe...) ainsi que par des clichés forts, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bba9868d-a93b-3d7a-82c8-019d3e745a3f",
                                        "entry_id": "af90b19d-27ac-31ae-9259-946927be7091",
                                        "glosses": [
                                            "Action de prendre la place et d'exercer les droits de parents morts en les représentant, dans une succession."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0669eeaf-733a-493a-8a91-bcd4cd9d13a0",
                                                "sense_id": "bba9868d-a93b-3d7a-82c8-019d3e745a3f",
                                                "text": "Il figure à cette succession par droit de représentation. - Il partage avec ses oncles par représentation de sa mère."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "78000221-bd27-3903-afff-49ad30c91df6",
                                        "entry_id": "af90b19d-27ac-31ae-9259-946927be7091",
                                        "glosses": [
                                            "Action de tenir la place des électeurs, d’être leur mandataire dans une assemblée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63c64442-ffaf-46ef-adf3-8ccfda3e8330",
                                                "sense_id": "78000221-bd27-3903-afff-49ad30c91df6",
                                                "text": "Il y exerce toute la vivacité de son esprit rebelle à ces combines, ces bassesses, ces tripotages, fricotages et grenouillages qui déshonorent à ses yeux la représentation des élus du peuple."
                                            },
                                            {
                                                "example_id": "1672d84a-87f2-4788-a3c0-67a474f75d92",
                                                "sense_id": "78000221-bd27-3903-afff-49ad30c91df6",
                                                "text": "Une étude du Cépii suggère qu’une meilleure représentation des salariés au conseil d’administration et une plus grande proximité géographique entre les sièges sociaux et les usines expliquent, en partie, pourquoi l’Allemagne a moins désindustrialisé que la France."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "247471d9-cebd-3543-8642-f0eab512bc1a",
                                        "entry_id": "af90b19d-27ac-31ae-9259-946927be7091",
                                        "glosses": [
                                            "Action de recueillir des affaires, pour le compte d'un commerçant ou d’une société de commerce."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f85a2f7f-5938-4226-8cd6-0917fdfa9ae9",
                                                "sense_id": "247471d9-cebd-3543-8642-f0eab512bc1a",
                                                "text": "Faire de la représentation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c38e6618-58d7-3b4b-bb0d-5c4c6cd9d578",
                                        "entry_id": "af90b19d-27ac-31ae-9259-946927be7091",
                                        "glosses": [
                                            "Administration qui agit pour le compte et sous la tutelle d'une autorité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8556367e-b88c-43eb-b064-183186a663bd",
                                                "sense_id": "c38e6618-58d7-3b4b-bb0d-5c4c6cd9d578",
                                                "text": "Il n'y a aucune représentation officielle de l'administration militaire dans le village. On doit se rendre à Dinant ou à Yvoir pour tout ce qui relève de celle-ci : à la Kommandantur et à la Feldgendarmerie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7528b64b-42ca-3ec9-96a4-dcb87ec8e50d",
                                        "entry_id": "af90b19d-27ac-31ae-9259-946927be7091",
                                        "glosses": [
                                            "État que tient une personne distinguée par son rang, par sa dignité, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9877e72-dfc1-4f86-8a45-96167be9c786",
                                                "sense_id": "7528b64b-42ca-3ec9-96a4-dcb87ec8e50d",
                                                "text": "Cette place exige une grande représentation. Cet ambassadeur néglige trop la représentation. - Frais de représentation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c0c74fed-d811-38c2-b201-fbc5fd81fe11",
                                        "entry_id": "af90b19d-27ac-31ae-9259-946927be7091",
                                        "glosses": [
                                            "Sorte d’objection ou de remontrance qu’on fait à quelqu’un avec égards, avec mesure."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f8c8f4a-14b7-4256-9e38-14a63b52b0d7",
                                                "sense_id": "c0c74fed-d811-38c2-b201-fbc5fd81fe11",
                                                "text": "Un jour que la marquise riait trop haut depuis six minutes avec ses voisins, un prêtre s’approcha et voulut hasarder des représentations."
                                            },
                                            {
                                                "example_id": "7e8e2c34-a7f6-480e-aa6a-ab5645b19c35",
                                                "sense_id": "c0c74fed-d811-38c2-b201-fbc5fd81fe11",
                                                "text": "Aussi profité-je du reste de sang-froid que je garde en ce moment pour vous faire d’humbles représentations."
                                            },
                                            {
                                                "example_id": "662469b3-1f0b-4979-a52a-9c2200e524df",
                                                "sense_id": "c0c74fed-d811-38c2-b201-fbc5fd81fe11",
                                                "text": "J'ai fait des représentations au grand vizir et ai dû revenir à la charge à plusieurs reprises pour faire cesser cette pratique répugnante."
                                            },
                                            {
                                                "example_id": "137de372-2199-4fd7-b243-e923006f6e95",
                                                "sense_id": "c0c74fed-d811-38c2-b201-fbc5fd81fe11",
                                                "text": "« — Comprenez-vous maintenant, ajouta-t-il, la gravité de l’action que vous avez commise ? »\nEn vérité je ne la comprenais pas encore. Mais peu à peu, par l’effet des représentations très sensées de M. Paul, j’arrivai à sentir que je serais jugé, non sur mes intentions qui sont innocentes, mais sur mon action qui est condamnable. Alors je me désespérai et me lamentai."
                                            },
                                            {
                                                "example_id": "3af77893-82a5-4381-8f5b-a77a2c8e6e28",
                                                "sense_id": "c0c74fed-d811-38c2-b201-fbc5fd81fe11",
                                                "text": "Je vous prie de le croire, cet agent de basse police, quand il m’a donné sa représentation, a été bien reçu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85a5f14e-1f7c-3be4-84e3-2b90224af65b",
                                        "entry_id": "af90b19d-27ac-31ae-9259-946927be7091",
                                        "glosses": [
                                            "Correspondance mathématique continue, généralement biunivoque, entre les points d'un ellipsoïde de référence, ou d'une partie de cet ellipsoïde, et les points d’un plan, ou éventuellement d’une autre surface."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
