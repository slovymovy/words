{
    "word_family": [
        "beuk",
        "beukenhout",
        "beukenhagen",
        "beukennootje",
        "gebeuk"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2750c144-9dd0-3f5f-bec8-1809ea81cf2d",
                    "sense_definition": "met grote kracht herhaaldelijk ergens tegenaan slaan of stoten",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "slaan",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De golven <w>beuken</w> met enorme kracht tegen de hoge rotsen aan de kust.",
                            "target_lang_translations": {
                                "en": "The waves <w>pound</w> against the high rocks on the coast with enormous force."
                            }
                        },
                        {
                            "text": "Hij begon hard op de deur te <w>beuken</w> omdat hij zijn sleutels was vergeten.",
                            "target_lang_translations": {
                                "en": "He started to <w>bash</w> hard on the door because he had forgotten his keys."
                            }
                        }
                    ],
                    "common_phrases": [
                        "op de deur beuken",
                        "tegen de rotsen beuken"
                    ],
                    "target_lang_definitions": {
                        "en": "To strike or hit something repeatedly with great force."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pound",
                                "target_lang_sense_clarification": "to strike hard and repeatedly"
                            },
                            {
                                "target_lang_word": "bash",
                                "target_lang_sense_clarification": "to hit forcefully and often clumsily"
                            },
                            {
                                "target_lang_word": "batter",
                                "target_lang_sense_clarification": "to strike repeatedly with heavy blows"
                            },
                            {
                                "target_lang_word": "hammer",
                                "target_lang_sense_clarification": "to hit something hard as if with a tool"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "649ad4ae-9c24-3336-8718-4812ea57b39e",
                    "sense_definition": "meervoud van het zelfstandig naamwoord <w>beuk</w>",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In dit oude bos staan prachtige grote <w>beuken</w> die al honderd jaar oud zijn.",
                            "target_lang_translations": {
                                "en": "In this old forest stand beautiful large <w>beech trees</w> that are already a hundred years old."
                            }
                        },
                        {
                            "text": "De bladeren van de <w>beuken</w> kleuren in de herfst prachtig goudbruin.",
                            "target_lang_translations": {
                                "en": "The leaves of the <w>beeches</w> turn a beautiful golden brown in autumn."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Plural form of the noun 'beuk' (beech tree)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "beech trees",
                                "target_lang_sense_clarification": "plural of the tree species"
                            },
                            {
                                "target_lang_word": "beeches",
                                "target_lang_sense_clarification": "plural of the tree species"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "980dc649-68a5-30d8-bce7-91854171c3cd",
                    "sense_definition": "gemaakt van het hout van een beuk",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "materiaal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de woonkamer ligt een prachtige massief <w>beuken</w> parketvloer.",
                            "target_lang_translations": {
                                "en": "In the living room lies a beautiful solid <w>beech</w> parquet floor."
                            }
                        },
                        {
                            "text": "Zij hebben gekozen voor een <w>beuken</w> tafel omdat dat hout erg sterk is.",
                            "target_lang_translations": {
                                "en": "They chose a <w>beech</w> table because that wood is very strong."
                            }
                        }
                    ],
                    "synonyms": [
                        "beukenhouten"
                    ],
                    "common_phrases": [
                        "beuken parketvloer",
                        "massief beuken"
                    ],
                    "target_lang_definitions": {
                        "en": "Made of the wood of a beech tree."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "beech",
                                "target_lang_sense_clarification": "made of beech wood"
                            },
                            {
                                "target_lang_word": "beechen",
                                "target_lang_sense_clarification": "consisting of beech wood (literary)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}