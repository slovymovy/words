                "senses": [
                    {
                        "sense_id": "1438d2e7-2b97-38a1-961a-95e4528eadb9",
                        "entry_id": "b61e9134-fe46-3699-9608-ed6bed0b4620",
                        "glosses": [
                            "gebouw, waarin aan sociaal-cultureel werk wordt gedaan voor een bepaalde buurt."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b67a0088-6093-4bd4-8cb9-c36ded9e7091",
                                "sense_id": "1438d2e7-2b97-38a1-961a-95e4528eadb9",
                                "text": "In het buurthuis wordt Nederlands gegeven voor nieuwe Nederlanders."
                            },
                            {
                                "example_id": "b065fda7-8220-4885-ab66-b59855b9343c",
                                "sense_id": "1438d2e7-2b97-38a1-961a-95e4528eadb9",
                                "text": "Maar als het straks voorbij is, wil iedereen de (gratis) plantjes wel hebben. Zeegers is verrast en onder de indruk van de motivatie van de belangstellenden. \"Er zijn mensen die zeggen dat ze het fantastisch zouden vinden als ze de planten in het buurthuis kunnen neerzetten. Er zijn ook mensen die het met de school in de wijk hebben besproken, kunnen we daar nog planten gebruiken?\""
                            },
                            {
                                "example_id": "f520f1f4-b676-4bb7-85c5-81d943bb8fb4",
                                "sense_id": "1438d2e7-2b97-38a1-961a-95e4528eadb9",
                                "text": "Sinds 2012 is er sprake van een sterke daling van het aantal buurthuizen in Nederland, omdat meerdere gemeenten vanwege de bezuinigingen besloten hebben om deze voorzieningen te sluiten"
                            }
                        ]
                    }
