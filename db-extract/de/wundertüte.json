                ],
                "senses": [
                    {
                        "sense_id": "021c6ccf-90fc-3a5f-a424-debd86fc9d9e",
                        "entry_id": "5136c093-4d8d-346a-89fd-a57561d9960d",
                        "glosses": [
                            "Tüte, in der sich Überraschungen wie Süßigkeiten oder kleine Spielzeuge befinden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25f94934-5e4d-47d3-a2da-7a5dca7e2df2",
                                "sense_id": "021c6ccf-90fc-3a5f-a424-debd86fc9d9e",
                                "text": "„Als ich meinen Groschen auf den Ladentisch legte und von Kaufmann Sumpf eine Wundertüte erheischte, sagte er patzig: „Kost jetz zwanzig Fennje, wir ham nämlich Kriech.““"
                            },
                            {
                                "example_id": "194fd97a-4415-43b1-a1d3-fb0cd90ae449",
                                "sense_id": "021c6ccf-90fc-3a5f-a424-debd86fc9d9e",
                                "text": "„Die Inhalte der Wundertüten sind meist unscheinbar, enthalten häufig zumindest eine Süßigkeit und wecken stets den Wunsch nach einer weiteren Überraschung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "af594994-06c1-3694-ae62-aa0f2fb020f1",
                        "entry_id": "5136c093-4d8d-346a-89fd-a57561d9960d",
                        "glosses": [
                            "etwas, das Überraschungen birgt"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "985a01d9-f0b2-4c35-ad7e-7ddf1bd8c5fa",
                                "sense_id": "af594994-06c1-3694-ae62-aa0f2fb020f1",
                                "text": "„Das Zitat illustriert sehr sprechend das Problem: „Identität“ ist eine semantische Wundertüte, eine selbsterklärende Worthülse, die keiner weiteren Klärung zu bedürfen scheint. Dies führt häufig zu Missverständnissen, […].“"
                            },
                            {
                                "example_id": "0f3f8311-7616-4827-a47d-1ce17e7bdcb7",
                                "sense_id": "af594994-06c1-3694-ae62-aa0f2fb020f1",
                                "text": "„Das Bosco ist längst zur großen Wundertüte geworden.“"
                            },
                            {
                                "example_id": "0358cced-b655-4e90-b22a-3cc578a804bb",
                                "sense_id": "af594994-06c1-3694-ae62-aa0f2fb020f1",
                                "text": "„Darüber streiten sich die Experten, denn die ‚Equipe Tricolore‘ ist die Wundertüte dieser Fußball-EM.“"
                            },
                            {
                                "example_id": "6e853be1-8779-43d1-9df9-dba5f5d913b4",
                                "sense_id": "af594994-06c1-3694-ae62-aa0f2fb020f1",
                                "text": "„Eine Wundertüte von Programmideen und (zumindest im ORF) neuen Formaten, von der österreichischen Antwort auf Frank Plasbergs ‚Hart aber fair‘, einem monothematischen Wochenmagazin, Ranking- und Talenteshow, Samstagabendsport bis zu weiteren Wiederbelebungsversuchen von ‚Musikantenstadl‘ bis ‚Club 2.‘“"
                            },
                            {
                                "example_id": "1473dc93-e1d8-4f78-8333-6d4f382e83b7",
                                "sense_id": "af594994-06c1-3694-ae62-aa0f2fb020f1",
                                "text": "„Dafür ist der Infotainment-Baukasten des Volkswagen-Konzerns zuständig, und Škoda hat tief in diese technische Wundertüte hineingegriffen.“"
                            },
                            {
                                "example_id": "d6cab91c-9f30-4cd8-a013-b697a2f7ecfd",
                                "sense_id": "af594994-06c1-3694-ae62-aa0f2fb020f1",
                                "text": "Der menschliche Enddarm ist so etwas wie eine Wundertüte. Deshalb müssen wir hier zuweilen etwas genauer hinschauen."
                            },
                            {
                                "example_id": "b263b4ba-f7e8-4638-8cc2-5e5431db1106",
                                "sense_id": "af594994-06c1-3694-ae62-aa0f2fb020f1",
                                "text": "„Was sind die Festspiele an der Côte d'Azur anderes als eine bunte Wundertüte des Kinos?“"
                            },
                            {
                                "example_id": "70323a6b-49c6-4fd4-ab9b-dd9b4cf0301f",
                                "sense_id": "af594994-06c1-3694-ae62-aa0f2fb020f1",
                                "text": "„»Man geht hier jeden Tag hin, und der Tag ist wie eine Wundertüte. Das macht den Job sehr spannend, aber auch sehr herausfordernd.«“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
