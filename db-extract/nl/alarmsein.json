                "senses": [
                    {
                        "sense_id": "61ad0014-65da-39ab-a361-bbb8038a9250",
                        "entry_id": "f6f735f5-6b6b-303d-92c4-d706c07846f6",
                        "glosses": [
                            "een auditief of visueel teken dat aangeeft dat er gevaar dreigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5691c762-a64e-4ea0-aa59-0704a68ad7ba",
                                "sense_id": "61ad0014-65da-39ab-a361-bbb8038a9250",
                                "text": "De kop ”Onderwijsvrijheid serieus in gevaar” (RD 23-5) deed me schrikken. Een alarmsein over het christelijk onderwijs! Is men zich er wel voldoende van bewust hoeveel leed men een groot gedeelte van ons volk hiermee zou aandoen?"
                            },
                            {
                                "example_id": "55f71f38-6a20-401e-bff6-148b3bde3a89",
                                "sense_id": "61ad0014-65da-39ab-a361-bbb8038a9250",
                                "text": "'Wanneer een alarmsein binnenkomt, belt de centrale enkele geprogrammeerde nummers op om bevestiging', zegt brandweercommandant Bart van Hauwermeiren. 'In dit geval waren dat de koster en de pastoor. Maar die waren niet bereikbaar. Er werd dus meteen groot alarm geslagen. Een kerkbrand is niet niks.'"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "91b697ec-d8fe-4e6a-bbbb-08c06485fe8e",
                        "source_entry_id": "f6f735f5-6b6b-303d-92c4-d706c07846f6",
                        "source_sense_id": "61ad0014-65da-39ab-a361-bbb8038a9250",
                        "target_lang_word": "alarm-signal",
