                        "examples": [
                            {
                                "example_id": "b5387527-d2f7-4954-8a38-ea349f06fc9b",
                                "sense_id": "92bc95a5-ddbe-377e-880e-8814e47d0da9",
                                "text": "There was nothing of disorganization, nothing of procrastination, nothing evincive of a temper to embarrass or obstruct the public business."
                            },
                            {
                                "example_id": "05ee3e4e-8a1c-438c-9167-38741067541c",
                                "sense_id": "92bc95a5-ddbe-377e-880e-8814e47d0da9",
                                "text": "That slaveholders are not insensible to public opinion and to the value of a good character was strikingly exhibited by Mr. Calhoun, in his place in the Senate of the United States, when he followed his frank disclaimer of all suspicion, that the abolitionists are meditating a war against the slaveholder's person, with remarks evincive of his sensitiveness under the war, which they are waging against the slaveholder's character."
                            },
                            {
                                "example_id": "8dffcc16-8109-44b0-89f6-3fcaa538b730",
                                "sense_id": "92bc95a5-ddbe-377e-880e-8814e47d0da9",
                                "text": "These, especially the latter, were urged with every species of cruelty--a mode of attempting to proselyte, evincive of human folly."
                            }
                        ]
