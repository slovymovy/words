                        "glosses": [
                            "ein Bereich in einer Stadt, der nur für Fußgänger (und nicht für Fahrzeuge) bestimmt ist"
                        ],
                        "tags": [
                            "norddeutsch (in Dithmarschen sowie Nordfriesland geläufig)"
