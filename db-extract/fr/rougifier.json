                "senses": [
                    {
                        "sense_id": "e30a030e-6ff1-3bdc-a401-0e3c72c7342a",
                        "entry_id": "90022587-10f3-394c-8c13-434e59d7a73e",
                        "glosses": [
                            "Présenter comme rouge."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1bb17328-a7bb-4864-a1e5-2139700d323a",
                                "sense_id": "e30a030e-6ff1-3bdc-a401-0e3c72c7342a",
                                "text": "Nous aimons à croire que tout de même le ministre de l’Instruction publique a eu d’autres raisons pour « rougifier » M. André de Lorde."
                            }
                        ]
                    },
                    {
                        "sense_id": "79646c01-1a21-32d1-9afe-c207ffd21b4f",
                        "entry_id": "90022587-10f3-394c-8c13-434e59d7a73e",
                        "glosses": [
                            "Rendre rouge."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8ccfdd3-7f0a-48be-998d-856161f910c6",
                                "sense_id": "79646c01-1a21-32d1-9afe-c207ffd21b4f",
                                "text": "Du papier babybel pour rougifier des lampes à diodes ?!?!?"
                            },
                            {
                                "example_id": "f7e5725b-cf16-4d9f-8e4b-7ababa9600a4",
                                "sense_id": "79646c01-1a21-32d1-9afe-c207ffd21b4f",
                                "text": "Erratum: J'ai oublié de \"rougifier un passage (avec la tante), mais bon, ça se voit tout de suite que c'est pas KM qui a ecrit ça xD."
                            },
                            {
                                "example_id": "c3344c3c-44b4-4ff7-8c06-203b4e00af2c",
                                "sense_id": "79646c01-1a21-32d1-9afe-c207ffd21b4f",
                                "text": "Ou alors tu parles de \"rougifier\" l'image, la rendre plus rouge, je sais pas comment dire."
                            }
                        ]
                    },
                    {
                        "sense_id": "b5d693e1-b915-3446-8f31-72c14e184cf1",
                        "entry_id": "90022587-10f3-394c-8c13-434e59d7a73e",
                        "glosses": [
                            "ou Devenir rouge."
                        ],
                        "tags": [
                            "intransitive",
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "618d0c59-f310-4ddc-bc56-710c060e6c61",
                                "sense_id": "b5d693e1-b915-3446-8f31-72c14e184cf1",
                                "text": "Les fleurs orange tendaient à \"rougifier\" en fin de floraison et la réaction phototropique est une évidence."
                            }
                        ]
                    }
                ],
