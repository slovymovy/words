                ],
                "senses": [
                    {
                        "sense_id": "41d6a1e0-c50a-33f8-b5cf-9274ddb86508",
                        "entry_id": "11489d09-2dd0-3d2d-acc7-9219ea6e02cb",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "280b2562-9011-402d-922e-c1209bf66b63",
                                "sense_id": "41d6a1e0-c50a-33f8-b5cf-9274ddb86508",
                                "text": "Frau Volkert ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "11323286-2016-4288-8d86-625896344077",
                                "sense_id": "41d6a1e0-c50a-33f8-b5cf-9274ddb86508",
                                "text": "Herr Volkert wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "99ef380f-4625-46af-a7b0-2fbd1345ec7b",
                                "sense_id": "41d6a1e0-c50a-33f8-b5cf-9274ddb86508",
                                "text": "Die Volkerts fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "93ce8632-7479-4ab0-89e6-ebe225582030",
                                "sense_id": "41d6a1e0-c50a-33f8-b5cf-9274ddb86508",
                                "text": "Der Volkert trägt nie die Schals, die die Volkert ihm strickt."
                            },
                            {
                                "example_id": "1a98deeb-287a-4e13-a78e-b4ae973ee6c2",
                                "sense_id": "41d6a1e0-c50a-33f8-b5cf-9274ddb86508",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Volkert kommt, geht der Herr Volkert.“"
                            },
                            {
                                "example_id": "58e7a406-dd5d-4149-8530-f339f372e439",
                                "sense_id": "41d6a1e0-c50a-33f8-b5cf-9274ddb86508",
                                "text": "Volkert kommt und geht."
                            },
                            {
                                "example_id": "e82581a3-9a4e-41bf-a1dc-518798563105",
                                "sense_id": "41d6a1e0-c50a-33f8-b5cf-9274ddb86508",
                                "text": "Volkerts kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
