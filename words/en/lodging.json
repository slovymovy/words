    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c98f9015-1365-3059-9ccd-4286ff5844c9",
                    "sense_definition": "A temporary place to stay or sleep, such as a rented room or hotel accommodation.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "accommodation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The travel package includes both board and <w>lodging</w> for the entire week.",
                            "target_lang_translations": {
                                "pl": "Pakiet wycieczkowy obejmuje zarówno wyżywienie, jak i <w>nocleg</w> na cały tydzień."
                            }
                        },
                        {
                            "text": "They had to find temporary <w>lodging</w> after their apartment was damaged by the storm.",
                            "target_lang_translations": {
                                "pl": "Musieli znaleźć tymczasowe <w>zakwaterowanie</w> po tym, jak ich mieszkanie zostało zniszczone przez burzę."
                            }
                        }
                    ],
                    "synonyms": [
                        "accommodation",
                        "quarters"
                    ],
                    "common_phrases": [
                        "board and lodging",
                        "overnight lodging",
                        "temporary lodging"
                    ],
                    "target_lang_definitions": {
                        "pl": "Tymczasowe miejsce pobytu lub spania, np. wynajmowany pokój lub zakwaterowanie hotelowe."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "nocleg",
                                "target_lang_sense_clarification": "miejsce do spania poza domem"
                            },
                            {
                                "target_lang_word": "zakwaterowanie",
                                "target_lang_sense_clarification": "miejsce pobytu, hotel"
                            },
                            {
                                "target_lang_word": "kwatera",
                                "target_lang_sense_clarification": "wynajmowane miejsce na pobyt czasowy"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4b10fb74-66fb-3bd9-89e8-b4acad0414c9",
                    "sense_definition": "A place where a person lives or resides.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "accommodation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He provided cheap <w>lodging</w> to local workers near the factory.",
                            "target_lang_translations": {
                                "pl": "Zapewniał tanie <w>lokum</w> lokalnym pracownikom w pobliżu fabryki."
                            }
                        },
                        {
                            "text": "The student spent weeks searching for suitable <w>lodging</w> before classes started.",
                            "target_lang_translations": {
                                "pl": "Student spędził tygodnie na poszukiwaniu odpowiedniego <w>mieszkania</w> przed rozpoczęciem zajęć."
                            }
                        }
                    ],
                    "synonyms": [
                        "residence",
                        "dwelling",
                        "abode"
                    ],
                    "common_phrases": [
                        "suitable lodging"
                    ],
                    "target_lang_definitions": {
                        "pl": "Miejsce, w którym ktoś mieszka lub przebywa; mieszkanie."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "lokum",
                                "target_lang_sense_clarification": "miejsce zamieszkania"
                            },
                            {
                                "target_lang_word": "mieszkanie",
                                "target_lang_sense_clarification": "miejsce zamieszkania"
                            },
                            {
                                "target_lang_word": "zakwaterowanie",
                                "target_lang_sense_clarification": "miejsce do mieszkania"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "02745144-bc7b-3e03-9b53-e25f0b22917e",
                    "sense_definition": "A rented room or set of furnished rooms inside a house.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "accommodation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He took a small <w>lodging</w> on the top floor of an old Victorian house.",
                            "target_lang_translations": {
                                "pl": "Wynajął małą <w>kwaterę</w> na najwyższym piętrze starego wiktoriańskiego domu."
                            }
                        },
                        {
                            "text": "Her private <w>lodging</w> was modest, containing only a bed, a desk, and a wardrobe.",
                            "target_lang_translations": {
                                "pl": "Jej prywatny <w>pokój</w> był skromny i mieścił tylko łóżko, biurko oraz szafę."
                            }
                        }
                    ],
                    "synonyms": [
                        "digs",
                        "billet"
                    ],
                    "target_lang_definitions": {
                        "pl": "Wynajmowany pokój lub zestaw umeblowanych pokojów w budynku mieszkalnym."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "kwatera",
                                "target_lang_sense_clarification": "wynajmowany pokój"
                            },
                            {
                                "target_lang_word": "stancja",
                                "target_lang_sense_clarification": "wynajmowany pokój u kogoś"
                            },
                            {
                                "target_lang_word": "pokój",
                                "target_lang_sense_clarification": "wynajmowany pokój"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cac1b827-0b2c-3086-bc84-5049752bdcd2",
                    "sense_definition": "The condition of a crop or cereal plant being permanently knocked down or flattened in the field, typically by wind or rain.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "agriculture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Heavy rainfall late in the season caused severe stem <w>lodging</w> across the wheat fields.",
                            "target_lang_translations": {
                                "pl": "Ulewne deszcze pod koniec sezonu spowodowały poważne <w>wyleganie</w> łodyg na polach pszenicy."
                            }
                        },
                        {
                            "text": "Farmers choose shorter varieties of barley to prevent <w>lodging</w> during strong summer storms.",
                            "target_lang_translations": {
                                "pl": "Rolnicy wybierają niższe odmiany jęczmienia, aby zapobiec <w>wyleganiu</w> podczas silnych letnich burz."
                            }
                        }
                    ],
                    "common_phrases": [
                        "stem lodging",
                        "root lodging"
                    ],
                    "target_lang_definitions": {
                        "pl": "Trwałe położenie się lub przewrócenie roślin uprawnych, wywołane np. silnym wiatrem lub deszczem."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "wyleganie",
                                "target_lang_sense_clarification": "kładzenie się łanów zbóż"
                            }
                        ]
                    }
                }
            ]
        },
        {
