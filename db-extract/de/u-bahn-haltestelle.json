                            {
                                "example_id": "363c6f79-d372-4452-b2d7-88a9d391e457",
                                "sense_id": "e663bbb8-d49b-3f46-995b-dbe029d060cc",
                                "text": "Zu welchem Zeitpunkt eine U-Bahn an einer U-Bahn-Haltestelle ankommen sollte, lässt sich im Normalfall dem entsprechenden Fahrplan entnehmen."
                            },
                            {
                                "example_id": "b9234081-5d2a-4d82-ae2e-15e994d227c5",
                                "sense_id": "e663bbb8-d49b-3f46-995b-dbe029d060cc",
                                "text": "„Wir trennten uns vor der U-Bahn-Haltestelle in der Nähe des Tower of London.“"
                            }
                        ],
