{
    "word_family": [
        "inhabit",
        "inhabitable",
        "inhabitant",
        "inhabitation",
        "uninhabitable"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0a1a7fa0-a975-3557-85a7-32026022f908",
                    "sense_definition": "Not lived in or occupied by people; having no human inhabitants.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "population",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sailors finally washed ashore on an <w>uninhabited</w> island far from civilization.",
                            "target_lang_translations": {
                                "ru": "Моряков наконец выбросило на берег <w>необитаемого</w> острова далеко от цивилизации."
                            }
                        },
                        {
                            "text": "Due to extreme weather conditions, the northern plateau remains completely <w>uninhabited</w> all year round.",
                            "target_lang_translations": {
                                "ru": "Из-за суровых погодных условий северное плато остаётся совершенно <w>незаселённым</w> круглый год."
                            }
                        }
                    ],
                    "synonyms": [
                        "deserted",
                        "unoccupied",
                        "unpeopled",
                        "unpopulated"
                    ],
                    "antonyms": [
                        "inhabited",
                        "peopled",
                        "populated"
                    ],
                    "common_phrases": [
                        "uninhabited island",
                        "largely uninhabited",
                        "remain uninhabited"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не имеющий населения или жителей; такой, где не живут люди."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "необитаемый",
                                "target_lang_sense_clarification": "о месте или острове, где никто не живёт"
                            },
                            {
                                "target_lang_word": "безлюдный",
                                "target_lang_sense_clarification": "лишённый людей, пустой"
                            },
                            {
                                "target_lang_word": "незаселённый",
                                "target_lang_sense_clarification": "не занятый поселенцами, не имеющий населения"
                            },
                            {
                                "target_lang_word": "ненаселённый",
                                "target_lang_sense_clarification": "не заселённый людьми"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a2942011-2b9a-3e7b-b1e1-a051eed070bb",
                    "sense_definition": "Of a type in logic or computer science: having no values, terms, or instances.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mathematics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In type theory, an <w>uninhabited</w> type corresponds to a false proposition.",
                            "target_lang_translations": {
                                "ru": "В теории типов <w>ненаселённый</w> тип соответствует ложному высказыванию."
                            }
                        },
                        {
                            "text": "Because this data type is <w>uninhabited</w>, no valid values can ever be constructed for it.",
                            "target_lang_translations": {
                                "ru": "Поскольку этот тип данных является <w>пустым</w>, для него невозможно создать ни одного допустимого значения."
                            }
                        }
                    ],
                    "synonyms": [
                        "vacant"
                    ],
                    "antonyms": [
                        "inhabited"
                    ],
                    "common_phrases": [
                        "uninhabited type"
                    ],
                    "target_lang_definitions": {
                        "ru": "В логике или теории типов: тип данных, не содержащий значений, термов или экземпляров."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ненаселённый",
                                "target_lang_sense_clarification": "о типе данных без значений или экземпляров"
                            },
                            {
                                "target_lang_word": "пустой",
                                "target_lang_sense_clarification": "не содержащий элементов тип"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}