                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11314544-92ce-41c5-8e26-7c3d330024dc",
                                "sense_id": "bb382593-d8a3-36fb-bc26-88cbff453549",
                                "text": "„Geluidloos scheert de roofvogel over de heuvelkam, op zoek naar een prooi.” Zo zou een verzonnen verhaal kunnen beginnen. Maar in het vakantiegebied rond het Luxemburgse Walsdorf is het echt waar. Daar zijn heuvels en haviken genoeg."
                            },
                            {
                                "example_id": "d040cddf-c499-4678-a776-0603088aebc2",
                                "sense_id": "bb382593-d8a3-36fb-bc26-88cbff453549",
                                "text": "„Wanneer de zon scheen op de tegenoverliggende kust kon je de Griekse dorpen van Anatolië zien liggen, leeg, verlaten en gebleekt in de zon. Je kon zelfs kamelenkaravanen onderscheiden die langzaam over een heuvelkam bewogen.”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e9e74311-7b7b-487d-aeef-d4b84dfc6941",
                        "source_entry_id": "7c462306-86d2-37ca-8ec7-74ffb832add6",
                        "source_sense_id": "bb382593-d8a3-36fb-bc26-88cbff453549",
                        "target_lang_word": "crest",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
