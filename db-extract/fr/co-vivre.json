                ],
                "senses": [
                    {
                        "sense_id": "65b40f46-debc-320c-8be4-9173211d12cc",
                        "entry_id": "b7e2f0aa-b4ee-3fa2-aac7-931ddb5782ff",
                        "glosses": [
                            "Vivre en commun."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36919eb3-f850-4e6f-b28a-93ab5ba0836c",
                                "sense_id": "65b40f46-debc-320c-8be4-9173211d12cc",
                                "text": "Or la construction des savoirs passe par l'intériorisation et la construction du savoir social, le privilégié, celui par lequel nous apprenons à survivre, à co-vivre, à convivre, à organiser."
                            },
                            {
                                "example_id": "4024c71b-a898-4b4b-b1d0-dc5cb9f9570d",
                                "sense_id": "65b40f46-debc-320c-8be4-9173211d12cc",
                                "text": "Tout au long de l'enfance puis de l'adolescence, frères et sœurs se voient contraints de co-vivre un même espace familial, de partager une même réalité affective, unis tantôt par la rivalité, tantôt par la solidarité qui les fait souvent se réunir face à l'étranger."
                            }
                        ]
                    }
                ],
