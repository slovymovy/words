                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "594b96a1-6684-4d16-a582-4cd35f83e30b",
                                                "sense_id": "5e07225d-0385-30f7-8efb-fe01c602ce06",
                                                "text": "They [ballads] began to be collected into little miscellanies under the name of garlands."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a8c155ba-56b8-3aea-8c2f-788a4a9fb56c",
                                        "entry_id": "45746db8-9d81-3769-856a-ad66b8cc28e5",
                                        "glosses": [
                                            "The top; the thing most prized."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b5baa61-482d-4ae4-8cef-289d048c3cf8",
                                                "sense_id": "a8c155ba-56b8-3aea-8c2f-788a4a9fb56c",
