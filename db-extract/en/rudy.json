                        "entry_id": "41f293ec-1ca4-3e83-87fe-75affcad4125",
                        "glosses": [
                            "A rude boy; a member of a Jamaican street gang in the 1960s and 70s."
                        ],
                        "tags": [
                            "UK",
                            "historical",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "7f8348f4-32bd-4bb6-a5f4-258c6331c3c3",
                                "sense_id": "f2b5720a-1bb5-39b2-ad7e-75dd17591e7a",
                                "text": "Stop your running around / Making problems in town / Rudy, a message to you, Rudy"
                            },
                            {
                                "example_id": "77368f63-f2f9-48a4-8e63-01968af571fb",
                                "sense_id": "f2b5720a-1bb5-39b2-ad7e-75dd17591e7a",
                                "text": "They dance the West Indian Reggae because it is the only old‐fashioned dance beat around and the total opposite of Pepsi‐Rock, the Plastic Ono Band and Jethro Tull and Blood, Sweat & Tears, all of which they naturally despise; and they also have a wary respect for West Indians in general and the Rudys in particular, the Jamaican street gangs who are older and tougher then^([sic]) themselves."
                            }
                        ]
                    }
