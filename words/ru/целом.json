                            },
                            {
                                "target_lang_word": "entire",
                                "target_lang_sense_clarification": "complete, with no parts missing"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "整个",
                                "target_lang_sense_clarification": "表示全部、完整"
                            }
                        ]
                    }
                }
            ]
        },
