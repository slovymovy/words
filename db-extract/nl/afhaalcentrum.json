                        "glosses": [
                            "plaats waar klanten hun bestelde goederen zelf kunnen ophalen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "712040e5-f503-4fee-a30f-e7638ff09cca",
                                "sense_id": "8c5c155e-56dc-3551-8f70-edd4f7910083",
                                "text": "Hornbach begint direct met de voorbereiding van de bouw, zegt een woordvoerder. Wanneer de bouwmarkt open gaat, kan hij nog niet zeggen. „Binnen twee maanden denken we meer te weten over planning, we willen snel van start.” Er komt een bouwmarkt met tuincentrum en afhaalcentrum van in totaal 17.000 vierkante meter, waar ze 120.000 producten verkopen."
                            },
                            {
                                "example_id": "9516c3a0-0792-4f54-b232-3aba07f1fd6b",
                                "sense_id": "8c5c155e-56dc-3551-8f70-edd4f7910083",
                                "text": "Dankzij een groeifinanciering van tientallen miljoenen euro’s kan het in Hengelo gevestigde De Buren Afhaalcentrum uitbreiden naar landelijke dekking. Dankzij die financiële injectie en een intensieve voorbereiding is het De Buren mogelijk binnen enkele jaren 3000 onbemande pakketkluiswanden verspreid over heel Nederland te plaatsen."
                            }
                        ]
