                ],
                "senses": [
                    {
                        "sense_id": "f5e26a04-23a2-3ebc-8247-4568ba1fc827",
                        "entry_id": "e5aeda42-d836-355e-9b92-2c17f7cb4b15",
                        "glosses": [
                            "niewielka przekąska podawana do alkoholu"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "faf0a4f1-91bf-47c8-a5e5-1928922a0ade",
                                "sense_id": "f5e26a04-23a2-3ebc-8247-4568ba1fc827",
                                "text": "Pije szlachta „w zagryzkę” i chleb spożywa"
                            },
                            {
                                "example_id": "5fd3b727-b425-4e6d-9a2f-0d8794cfe9d9",
                                "sense_id": "f5e26a04-23a2-3ebc-8247-4568ba1fc827",
                                "text": "Stasia nalewała im setkę do literatki i za darmo częstowała kiszonym ogórkiem na zagryzkę"
                            },
                            {
                                "example_id": "5bc906a4-5ca8-4518-aaad-b31351ac92db",
                                "sense_id": "f5e26a04-23a2-3ebc-8247-4568ba1fc827",
                                "text": "Rozsmakowanych artystycznie gości, dla pełni doznań w rozkoszowaniu się Sztuką, napojono szampanem i nakarmiono chlebem ze smalcem, na zagryzkę podając fikuśne marcheweczki i inne warzywka maczane w smakowitych dipach"
                            },
                            {
                                "example_id": "78c9649e-1506-4d04-9b2e-88013794ec1a",
                                "sense_id": "f5e26a04-23a2-3ebc-8247-4568ba1fc827",
                                "text": "Przybyłych gości kolekcjoner poczęstował chlebem ze smalcem własnego wyrobu, gdyż, jak stwierdził, właśnie ten frykas idealnie pasuje jako zagryzka przy pykaniu fajki"
                            },
                            {
                                "example_id": "66c29f7f-d477-4adb-a095-7fe38dc8553c",
                                "sense_id": "f5e26a04-23a2-3ebc-8247-4568ba1fc827",
                                "text": "Na stół wjeżdżają nietypowe dania: suszone ryby, które odrywa się płatami, wielorybi tłuszcz, pokrojony w kostki (znakomita zagryzka do alkoholi), baranie udźce z lodówki"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
