                        "form": "den Anmarsch"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "cb657c7b-9527-3915-87e3-f1c1165338ff",
                        "entry_id": "dff26b5f-fd94-3522-8d39-50698266d165",
                        "glosses": [
                            "ein Näherkommen durch Marschieren"
                        ],
                        "tags": [
                            "im engen Sinne"
                        ],
                        "examples": [
                            {
                                "example_id": "73d16880-1a5f-47cd-9d54-f6af60be4edb",
                                "sense_id": "cb657c7b-9527-3915-87e3-f1c1165338ff",
                                "text": "War die römische Armee im Anmarsch, verbreitete das Furcht und Schrecken unter ihren Gegnern."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "28290e31-ac56-343b-b30a-af88ca50170a",
                        "entry_id": "dff26b5f-fd94-3522-8d39-50698266d165",
                        "glosses": [
                            "eine Annäherung (auch zeitlich)"
                        ],
                        "tags": [
                            "im weiten Sinne"
                        ],
                        "examples": [
                            {
                                "example_id": "871311ba-d34f-40a5-9f5a-30d61bf00f5b",
                                "sense_id": "28290e31-ac56-343b-b30a-af88ca50170a",
                                "text": "Da ist jede Menge Ärger im Anmarsch."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "81347887-70da-46b4-8264-3cfdef3ae407",
                        "source_entry_id": "dff26b5f-fd94-3522-8d39-50698266d165",
                        "source_sense_id": "cb657c7b-9527-3915-87e3-f1c1165338ff",
                        "source_sense_description": "im engen Sinne: ein Näherkommen durch Marschieren",
                        "target_lang_word": "advance",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "advance",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "04cee1eb-d4c3-3954-b929-7e1286ced9f9",
                                        "entry_id": "1be03d3f-3242-3322-b24b-ddacbbb2335d",
                                        "glosses": [
                                            "To promote or advantage.",
                                            "To help the progress of (something); to further."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7bbffdf1-590a-410d-80db-2f8f27f0085a",
                                                "sense_id": "04cee1eb-d4c3-3954-b929-7e1286ced9f9",
                                                "text": "Some see it as in effect the end of the Syrian uprising that began with peaceful protests against Assad’s police state in 2011, with opposition fighters working to advance Turkey’s interests at the expense of the revolution’s goals."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "234737e4-29e0-301d-a827-6d3c553dcac5",
                                        "entry_id": "1be03d3f-3242-3322-b24b-ddacbbb2335d",
                                        "glosses": [
                                            "To promote or advantage.",
                                            "To raise (someone) in rank or office; to prefer, to promote."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3785a166-1bf3-41ea-b4d7-f22a2c741687",
                                                "sense_id": "234737e4-29e0-301d-a827-6d3c553dcac5",
                                                "text": "After these things did king Ahasuerus promote Haman the son of Hammedatha the Agagite, and advanced him, and set his seat above all the princes that were with him."
                                            },
                                            {
                                                "example_id": "439ce40c-2170-46c6-9d58-eb7a7d6bb985",
                                                "sense_id": "234737e4-29e0-301d-a827-6d3c553dcac5",
                                                "text": "This, however, was in time evaded by the monarchs, who advanced certain of their own retainers to a level with the ancient peers of the land[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "38e65c72-3fb4-3525-a03b-7e47bc65e668",
                                        "entry_id": "1be03d3f-3242-3322-b24b-ddacbbb2335d",
                                        "glosses": [
                                            "To move forward in space or time.",
                                            "To move or push (something) forwards, especially forcefully."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d4f30c2-0fb6-43b2-99dd-5e7ea0300fa2",
                                                "sense_id": "38e65c72-3fb4-3525-a03b-7e47bc65e668",
                                                "text": "Whence and what art thou, execrable shape, / That dar'st, though grim and terrible, advance / Thy miscreated front athwart my way / To yonder gates?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc18505d-4c2e-3b1a-9508-7cd8b5e70850",
                                        "entry_id": "1be03d3f-3242-3322-b24b-ddacbbb2335d",
                                        "glosses": [
                                            "To move forward in space or time.",
                                            "To make (something) happen at an earlier time or date; to bring forward, to hasten."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a89c3ab7-ea5f-4cef-afc8-20f12e261f55",
                                                "sense_id": "fc18505d-4c2e-3b1a-9508-7cd8b5e70850",
                                                "text": "[S]in and sorrow it were, considering the hardships of this noble and gallant knight, no whit mentioning or weighing those we ourselves have endured, if we were now either to advance or retard the hour of refection beyond the time when the viands are fit to be set before us."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a613a91-682e-33e1-8949-fcd0af8a34ad",
                                        "entry_id": "1be03d3f-3242-3322-b24b-ddacbbb2335d",
                                        "glosses": [
                                            "To move forward in space or time.",
                                            "To move forwards; to approach."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b90ee6a-ef35-4298-b41e-c2947ed6ef67",
                                                "sense_id": "4a613a91-682e-33e1-8949-fcd0af8a34ad",
                                                "text": "I advanced towards him step by step, stopping sometimes for fear of waking him."
                                            },
                                            {
                                                "example_id": "dee3c0b0-12ce-443b-bf16-3d78ca920803",
                                                "sense_id": "4a613a91-682e-33e1-8949-fcd0af8a34ad",
                                                "text": "This army recaptured Wu-chʻang, on the right bank of the Yangtze, in 1854, reached Chen-chiang four years later, advanced to Chiu-chiang and threatened Nanking."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60afb307-fd0a-3aa5-aaab-2b8f3720c721",
                                        "entry_id": "1be03d3f-3242-3322-b24b-ddacbbb2335d",
                                        "glosses": [
                                            "To move forward in space or time.",
                                            "To provide (money or other value) before it is due, or in expectation of some work; to lend."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0872180f-89ca-4111-bf86-f280c72df19e",
                                                "sense_id": "60afb307-fd0a-3aa5-aaab-2b8f3720c721",
                                                "text": "“I had intended to ask you to advance me a hundred pounds,” said Phineas."
                                            },
                                            {
                                                "example_id": "05d4df9d-b1f4-4b14-9540-dd72da776eeb",
                                                "sense_id": "60afb307-fd0a-3aa5-aaab-2b8f3720c721",
                                                "text": "On the urgent representations of several parties of the first importance in the City of London, the bank advanced 120,000l. to the Governor and Company of the Copper Miners […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "02b15a82-cbd8-3987-ad24-9d00adffb1e3",
                                        "entry_id": "1be03d3f-3242-3322-b24b-ddacbbb2335d",
                                        "glosses": [
                                            "To move forward in space or time.",
                                            "To put forward (an idea, argument etc.); to propose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b499e861-27f1-457b-8d62-976dc130662b",
                                                "sense_id": "02b15a82-cbd8-3987-ad24-9d00adffb1e3",
                                                "text": "Some ne'er advance a Judgement of their own, / But catch the spreading notion of the Town […]."
                                            },
                                            {
                                                "example_id": "3a779674-c1ec-4ec8-903b-7f0bedfa46d8",
                                                "sense_id": "02b15a82-cbd8-3987-ad24-9d00adffb1e3",
                                                "text": "Ghosts, it is advanced, either do not exist at all, or else, like the stars at noonday, they are there all the time and it is we who cannot see them. The stories in the following pages were written on the second of these assumptions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "341b006e-d086-3b7b-9c73-78bcbff39ade",
                                        "entry_id": "1be03d3f-3242-3322-b24b-ddacbbb2335d",
                                        "glosses": [
                                            "To move forward in space or time.",
                                            "To make progress; to do well, to succeed."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "529e15cc-160d-4686-aa9c-2f7a1b47998d",
                                                "sense_id": "341b006e-d086-3b7b-9c73-78bcbff39ade",
                                                "text": "Earlier the caller said men were more likely to be in senior positions. Clegg says that's partly because the current maternity leave arrangements make it difficult for women to advance in the workplace."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f77a3a84-80c4-3d27-aeb3-b4c0254775d1",
                                        "entry_id": "1be03d3f-3242-3322-b24b-ddacbbb2335d",
                                        "glosses": [
                                            "To move forward in space or time.",
                                            "To move forward in time; to progress towards completion."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4dcbb70d-319c-44a5-a518-adf2b2281629",
                                                "sense_id": "f77a3a84-80c4-3d27-aeb3-b4c0254775d1",
                                                "text": "I can promise you that you will feel even less humorous as the evening advances."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e4fd388-2319-3011-919c-cf6e20135192",
                                        "entry_id": "1be03d3f-3242-3322-b24b-ddacbbb2335d",
                                        "glosses": [
                                            "To raise, be raised.",
                                            "To raise; to lift or elevate."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "97353f11-f46e-4e02-a9dc-ec76199a07e9",
                                                "sense_id": "4e4fd388-2319-3011-919c-cf6e20135192",
                                                "text": "The fringed Curtaines of thine eyes aduance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ec5bdfa-f98b-3c33-8430-51fe51284fa9",
                                        "entry_id": "1be03d3f-3242-3322-b24b-ddacbbb2335d",
                                        "glosses": [
                                            "To raise, be raised.",
                                            "To raise or increase (a price, rate)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08430b04-59dc-4952-85d3-482f745b3984",
                                                "sense_id": "9ec5bdfa-f98b-3c33-8430-51fe51284fa9",
                                                "text": "In February last […] bakers advanced the price of bread sold over the counter in London from 8d. to 8½d. per quartern loaf."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa4650cf-e0ff-35b6-aac4-818fe815e2ad",
                                        "entry_id": "1be03d3f-3242-3322-b24b-ddacbbb2335d",
                                        "glosses": [
                                            "To raise, be raised.",
                                            "To increase (a number or amount)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "665a6115-8d18-3d04-84dd-32a5646cd7b0",
                                        "entry_id": "1be03d3f-3242-3322-b24b-ddacbbb2335d",
                                        "glosses": [
                                            "To raise, be raised.",
                                            "To make a higher bid at an auction."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "advance",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fb313b07-f6ef-36ef-be75-a722bdf7cb60",
                                        "entry_id": "97a95b91-4acc-32ce-975b-05b222b968b1",
                                        "glosses": [
                                            "A forward move; improvement or progression."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01c52272-1689-4cff-ab34-e084a97857f1",
                                                "sense_id": "fb313b07-f6ef-36ef-be75-a722bdf7cb60",
                                                "text": "an advance in health or knowledge"
                                            },
                                            {
                                                "example_id": "09a5a0f3-275f-4495-a5c8-e59ebfa5ff13",
                                                "sense_id": "fb313b07-f6ef-36ef-be75-a722bdf7cb60",
                                                "text": "an advance in rank or office"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "741e1601-6546-3e14-a42e-3408208d4362",
                                        "entry_id": "97a95b91-4acc-32ce-975b-05b222b968b1",
                                        "glosses": [
                                            "An amount of money or credit, especially given as a loan, or paid before it is due; an advancement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c0690ac-daea-4529-9a06-7beea5c8c246",
                                                "sense_id": "741e1601-6546-3e14-a42e-3408208d4362",
                                                "text": "Could he ask the cashier privately for an advance? No, the cashier was no good, no damn good: he wouldn't give an advance."
                                            },
                                            {
                                                "example_id": "3f9c8b6c-8ed4-4346-80b7-1f684357a1bb",
                                                "sense_id": "741e1601-6546-3e14-a42e-3408208d4362",
                                                "text": "I shall, with pleasure, make the necessary advances."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cff2efa3-49ed-304a-ad3f-fc9235fddf6c",
                                        "entry_id": "97a95b91-4acc-32ce-975b-05b222b968b1",
                                        "glosses": [
                                            "An addition to the price; rise in price or value."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6309e415-7b12-4872-a946-b2731b9bbd66",
                                                "sense_id": "cff2efa3-49ed-304a-ad3f-fc9235fddf6c",
                                                "text": "an advance on the prime cost of goods"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "30f63452-0de7-3786-9d11-673a2ea85792",
                                        "entry_id": "97a95b91-4acc-32ce-975b-05b222b968b1",
                                        "glosses": [
                                            "An opening approach or overture, now especially of an unwelcome or sexual nature."
                                        ],
                                        "tags": [
                                            "in-plural",
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f3d28b0-0bbb-4f8b-bc14-b8613d2482f0",
                                                "sense_id": "30f63452-0de7-3786-9d11-673a2ea85792",
                                                "text": "For, if it were of any use to recall matters of fact, what is more notorious, than that prince's applying himself first to the church of England? and upon their refusal to fall in with his measures, making the like advances to the dissenters of all kinds, who readily and almost universally complied with him"
                                            },
                                            {
                                                "example_id": "3acb6797-e6bc-4fe3-b0b8-1ab4d65d00fa",
                                                "sense_id": "30f63452-0de7-3786-9d11-673a2ea85792",
                                                "text": "As the sun fell, so did our spirits. I had tried to make advances to the girl again; but she would have none of me, and so I was not only thirsty but otherwise sad and downhearted."
                                            },
                                            {
                                                "example_id": "0c43a054-1575-4acc-bb36-41edea6a4061",
                                                "sense_id": "30f63452-0de7-3786-9d11-673a2ea85792",
                                                "text": "I felt vaguely he was a sneak, and remained quite unmollified by advances on his side, which, in a boy's barbarous fashion, unless it suited me to be magnanimous, I haughtily ignored."
                                            },
                                            {
                                                "example_id": "82a53e32-afcd-4ea2-9f2d-b766ad45e91d",
                                                "sense_id": "30f63452-0de7-3786-9d11-673a2ea85792",
                                                "text": "[A]nd Rosamund though quite a genteelly brought up young lady had responded to his advances by slapping his face."
                                            },
                                            {
                                                "example_id": "18a9e282-c8e6-4e74-82a3-2758203e190e",
                                                "sense_id": "30f63452-0de7-3786-9d11-673a2ea85792",
                                                "text": "In public he put on a performance that was at once outraged and outrageous, but usually he did not carry grudges into his private life. Exuding the backslapping air of a socializer who loved to gamble and drink, he could not understand why people whose careers he had ruined and publicly ridiculed would be hostile to his friendly advances."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "advance",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4aa5d50d-7103-36f2-9f3c-607fdd743729",
                                        "entry_id": "c587c6e3-14ed-3fd9-a1ac-8ae7d16e20ea",
                                        "glosses": [
                                            "Completed before necessary or a milestone event."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4029bf4-b86b-48e3-a6ea-88088e91c7bb",
                                                "sense_id": "4aa5d50d-7103-36f2-9f3c-607fdd743729",
                                                "text": "He made an advance payment on the prior shipment to show good faith."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "72abc388-dd44-3469-a2b9-39b37d13e441",
                                        "entry_id": "c587c6e3-14ed-3fd9-a1ac-8ae7d16e20ea",
                                        "glosses": [
                                            "Preceding."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec7cf6ae-f79b-4ff0-8819-1e6fb0c6db3a",
                                                "sense_id": "72abc388-dd44-3469-a2b9-39b37d13e441",
                                                "text": "The advance man came a month before the candidate."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b1a870ee-e8bf-3d83-b288-ce8c559ac91e",
                                        "entry_id": "c587c6e3-14ed-3fd9-a1ac-8ae7d16e20ea",
                                        "glosses": [
                                            "Forward."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "899eb2d7-9bf5-45cf-af5b-b117d4a9f680",
                                                "sense_id": "b1a870ee-e8bf-3d83-b288-ce8c559ac91e",
                                                "text": "The scouts found a site for an advance base."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
