                                        "sense_id": "9140fa27-80ce-3dd8-8ac1-38f87bd997b5",
                                        "entry_id": "28b4d4e6-32fe-3125-9186-f775e55c64cd",
                                        "glosses": [
                                            "Guitare électrique qui se joue posée sur les genoux et en utilisant un bottleneck et des plectres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f768681-05f1-4c77-b8f6-c0bce9867efb",
                                                "sense_id": "9140fa27-80ce-3dd8-8ac1-38f87bd997b5",
                                                "text": "Bientôt, c’est un véritable engouement pour la guitare jouée à plat avec une barre d’acier, la « lap steel guitar »."
                                            },
                                            {
                                                "example_id": "09503890-292e-46e2-87af-e0ef5383392d",
                                                "sense_id": "9140fa27-80ce-3dd8-8ac1-38f87bd997b5",
                                                "text": "Pendant ce temps, Mathias s’est emparé d’un des nombreux instruments insolites qui décorent la scène : une lap steel guitar, qu’il caresse avec la douceur d’un tigre en rut et sous amphétamines."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
