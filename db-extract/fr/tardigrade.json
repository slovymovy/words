            {
                "entry_id": "f9cc0c59-d896-3bd9-afab-17fd7a9363f0",
                "word": "tardigrade",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "0fcba10b-fb37-4031-bd0f-94d323653f70",
                        "entry_id": "f9cc0c59-d896-3bd9-afab-17fd7a9363f0",
                        "tags": [
                            "plural"
                        ],
                        "form": "tardigrades"
                    },
                    {
                        "form_id": "29af4e8a-93f7-4d55-a354-5565fa375512",
                        "entry_id": "f9cc0c59-d896-3bd9-afab-17fd7a9363f0",
                        "tags": [],
                        "form": "Tardigrade"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ea3c494d-bdda-3fc6-8e09-b7730fd8745c",
                        "entry_id": "f9cc0c59-d896-3bd9-afab-17fd7a9363f0",
                        "glosses": [
                            "Taxon de panarthropodes au corps très petit (0,5 à 1,5 mm), cylindrique, couvert d'une cuticule, avec 4 paires de petites pattes munies de griffes et qui sont présents en milieu humide et en mer, se nourrissant de végétaux tels les mousses et les lichens."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04b22dc4-85e9-4e35-ab6e-135efa009495",
                                "sense_id": "ea3c494d-bdda-3fc6-8e09-b7730fd8745c",
                                "text": "Le Tetrakentron est le seul Tardigrade parasite ; il vit sur les tentacules péribuccaux de Leptosynapta Galliennei herapath (Roscoff) ; il y a de 1 à 3 individus sur chaque Synapte, accrochés solidement par leurs griffes et se déplaçant très lentement, sans jamais quitter leur hôte ; on n’en trouve pas sur le corps des Synaptes."
                            },
                            {
                                "example_id": "b2b4c5e1-17ee-4d52-b907-f39bf7fe9305",
                                "sense_id": "ea3c494d-bdda-3fc6-8e09-b7730fd8745c",
                                "text": "Le tréhalose est aussi à l’œuvre chez les artémies, mais semble absent chez les tardigrades, qui peuvent rester plusieurs décennies dans un état de dessiccation quasi totale après avoir perdu 97 % de leur eau."
                            }
                        ]
                    },
                    {
                        "sense_id": "16932702-19ad-3d16-9b12-5335808d84fa",
                        "entry_id": "f9cc0c59-d896-3bd9-afab-17fd7a9363f0",
                        "glosses": [
                            "Famille de mammifères qui n’ont pas de dents incisives, dont les doigts sont réunis jusqu’aux ongles et qui sont remarquables par la lenteur de leurs mouvements."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "e40ecd7a-43e4-4748-949e-1780e16a6a29",
                                "sense_id": "16932702-19ad-3d16-9b12-5335808d84fa",
                                "text": "Les chats se lissent les poils, les chiens se baigne, les tardigrades ou paresseux ne se peignent jamais."
                            },
                            {
                                "example_id": "b4ad2063-bbe4-4d55-a845-10ff9610c780",
                                "sense_id": "16932702-19ad-3d16-9b12-5335808d84fa",
                                "text": "On dirait que tu te souviens aujourd’hui d’avoir été le plus grand tardigrade de la création."
                            },
                            {
                                "example_id": "37e025e2-0c91-48da-9314-4f75882110ea",
                                "sense_id": "16932702-19ad-3d16-9b12-5335808d84fa",
                                "text": "Trois mois d’une pareille existence avaient suffi pour faire de cette jeunesse amoureuse du sacrifice, une ribambelle de tardigrades fantômes qu’on faisait semblant d’utiliser comme éclaireurs, et que les campagnards inquiets voyaient apparaître sur tous les chemins."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "33f0dbac-e5ea-4196-8396-ff4a5b2f0bb0",
                        "source_entry_id": "f9cc0c59-d896-3bd9-afab-17fd7a9363f0",
                        "source_sense_description": "Taxon (1):",
                        "target_lang_word": "Bärtierchen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bärtierchen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9b1446d3-b858-32fd-bb2e-224c296839b6",
                                        "entry_id": "ece67725-7356-3e39-afa5-fc37e736d685",
                                        "glosses": [
                                            "Gliedertiere bis zu einem Millimeter Größe, sie besitzen vier Paar Stummelbeine und leben in Moosen, feuchter Erde oder in Wasser"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f70e52d-da3c-4013-956a-a78d512fbcd9",
                                                "sense_id": "9b1446d3-b858-32fd-bb2e-224c296839b6",
                                                "text": "„Man sie kochen, man kann sie tiefkühlen - Bärtierchen überleben härteste Umweltbedingungen.“"
                                            },
                                            {
                                                "example_id": "f1f899fc-8fa9-4837-b2ae-2795e1af357b",
                                                "sense_id": "9b1446d3-b858-32fd-bb2e-224c296839b6",
                                                "text": "„Bärtierchen sind erstaunliche Lebewesen, gleichsam die unkaputtbaren Superhelden der Tierwelt: Kaum größer als ein Sandkorn, haben es die achtbeinigen, tonnenförmigen Kreaturen geschafft, in praktisch allen Biotopen der Erde zu gedeihen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
