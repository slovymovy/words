                        "translation_id": "56f3438a-f6ab-4fd2-8a9f-009d1d57d2a4",
                        "source_entry_id": "4b3b6296-ded9-39eb-a772-342dfb83fb12",
                        "source_sense_id": "7e5f00db-778d-3f25-bee1-6b3afce5a316",
                        "target_lang_word": "Nordamerikanischer Ochsenfrosch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "ddbcaaac-3506-40ff-9b6d-08190faaf1e1",
                        "source_entry_id": "4b3b6296-ded9-39eb-a772-342dfb83fb12",
                        "source_sense_id": "7e5f00db-778d-3f25-bee1-6b3afce5a316",
                        "target_lang_word": "Ochsenfrosch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ochsenfrosch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3869eab3-2bc8-33ba-b56b-29b418fe6d40",
                                        "entry_id": "b0eb449b-0818-342d-a043-7334357aa937",
                                        "glosses": [
                                            "sehr große, weltweit verbreitete Froschart"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e8fa426-f8fa-4e43-b848-e839686715b4",
                                                "sense_id": "3869eab3-2bc8-33ba-b56b-29b418fe6d40",
                                                "text": "„Die Hälfte des Baus war den Elementen ungeschützt ausgesetzt und wir konnten, nicht weit entfernt in den Sümpfen, die Ochsenfrösche belfern hören, wir konnten die Abgasfackeln wie ferne defekte Sterne glimmern sehen.“"
                                            },
                                            {
                                                "example_id": "7b73adcf-947d-4d8e-acd5-76d23bdb62e2",
                                                "sense_id": "3869eab3-2bc8-33ba-b56b-29b418fe6d40",
                                                "text": "„Sonia griff nach einem Ochsenfrosch mit übergroßen Augen aus Porzellan.“"
                                            },
                                            {
                                                "example_id": "5a55c224-326b-484f-b5ec-a6638b894422",
                                                "sense_id": "3869eab3-2bc8-33ba-b56b-29b418fe6d40",
                                                "text": "„Triumphierend blies er sich auf wie ein Ochsenfrosch und landete einen Schwinger, schlug den Kopf des Gegners mit schrecklicher Wucht ein.“"
                                            },
                                            {
                                                "example_id": "ae5869ec-df29-430f-b9e7-4a51386900f1",
                                                "sense_id": "3869eab3-2bc8-33ba-b56b-29b418fe6d40",
                                                "text": "„Ochsenfrösche krächzten, und überall um sie herum summten Moskitos mit einer Beharrlichkeit, die sie fast wahnsinnig machte.“"
                                            },
                                            {
                                                "example_id": "e2a5a33c-50b9-4853-8dba-e63a341a8999",
                                                "sense_id": "3869eab3-2bc8-33ba-b56b-29b418fe6d40",
                                                "text": "„›Wenn sie alles über jemand herausbekommen wollen, was es gibt, dann machen sie das mit ihm. Trensenbereifen. Seine Innenseite nach außen stülpen, so wie man bei einem Ochsenfrosch das Innerste nach außen stülpt.‹“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e9f28101-63c4-41f9-8d1a-2b7623b4117a",
                        "source_entry_id": "4b3b6296-ded9-39eb-a772-342dfb83fb12",
                        "source_sense_id": "18e7d267-cc5c-3772-925b-584ca2b6de40",
                        "target_lang_word": "Frosch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Frosch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "41299b69-d2b6-32f3-af3b-204e16da709e",
                                        "entry_id": "0dd5bea7-c3ed-3857-a0ea-f21b20a272aa",
                                        "glosses": [
                                            "grün- oder bräunlich gefärbte, schwanzlose Amphibie mit überlangen, hinteren Sprungbeinen, die laute Quaktöne hervor bringt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "900b877e-2a18-44ea-b80d-debb7c96d03c",
                                                "sense_id": "41299b69-d2b6-32f3-af3b-204e16da709e",
                                                "text": "Die Frösche paaren sich im Wasser."
                                            },
                                            {
                                                "example_id": "5a6a48b3-73b0-4c92-ba7a-50b380196e8a",
                                                "sense_id": "41299b69-d2b6-32f3-af3b-204e16da709e",
                                                "text": "„Die Frösche und Grillen rings um die Ufer des Teichs hatten zu rufen begonnen.“"
                                            },
                                            {
                                                "example_id": "7100ee41-f137-456f-b312-11e724bf5c2e",
                                                "sense_id": "41299b69-d2b6-32f3-af3b-204e16da709e",
                                                "text": "„Zwei Frösche sitzen auf einer Wiese.“"
                                            },
                                            {
                                                "example_id": "93c2630e-86da-4149-9c2e-0aa145389fe9",
                                                "sense_id": "41299b69-d2b6-32f3-af3b-204e16da709e",
                                                "text": "„Am Himmel blitzten einzelne Sterne wie aus einem matten Schleier herab, vom nahen Ufer trug dann und wann ein starker Luftzug das Quaken der Frösche und den einsamen Ruf des Ziegenmelkers herüber.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "017abd23-270b-3066-827f-d3ad54abecbf",
                                        "entry_id": "0dd5bea7-c3ed-3857-a0ea-f21b20a272aa",
                                        "glosses": [
                                            "Teil des Bogens für Streichinstrumente"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a0fc6867-80ed-4a8e-82dc-2535114e004e",
                                                "sense_id": "017abd23-270b-3066-827f-d3ad54abecbf",
                                                "text": "Der Abstrich ist eine Bogenbewegung vom Frosch in Richtung Spitze."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "67ebed7c-b315-33ae-88bb-faf20f97ed08",
                                        "entry_id": "0dd5bea7-c3ed-3857-a0ea-f21b20a272aa",
                                        "glosses": [
                                            "eine Unterlage für Messlatten"
                                        ],
                                        "tags": [
                                            "Vermessungswesen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aef35db7-3b34-4a85-b734-717a6509c08b",
                                                "sense_id": "67ebed7c-b315-33ae-88bb-faf20f97ed08",
                                                "text": "Der Frosch ist eine schwere, tragbare Unterlegplatte mit wohldefiniertem Höhenpunkt."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "b1fce97b-ce7c-3dfa-baed-58a4998b151e",
                                        "entry_id": "0dd5bea7-c3ed-3857-a0ea-f21b20a272aa",
                                        "glosses": [
                                            "ängstlicher Mensch"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "22414e9d-3005-49d1-9157-a8523191e3aa",
                                                "sense_id": "b1fce97b-ce7c-3dfa-baed-58a4998b151e",
                                                "text": "Also Günther, sei doch kein Frosch!"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "b5af9e00-c36b-3f81-9165-d771b9739cae",
                                        "entry_id": "0dd5bea7-c3ed-3857-a0ea-f21b20a272aa",
                                        "glosses": [
                                            "knallender, springender Feuerwerkskörper"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c20e6151-f87c-4d38-98bd-1216d0b2451a",
                                                "sense_id": "b5af9e00-c36b-3f81-9165-d771b9739cae",
                                                "text": "Die Erwachsenen zündeten Raketen, als die Kinder plötzich Frösche auf den Boden warfen."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "1b010a88-3c4c-305a-9692-707dbf0ce015",
                                        "entry_id": "0dd5bea7-c3ed-3857-a0ea-f21b20a272aa",
                                        "glosses": [
                                            "Auflagebasis/Träger für das Hobeleisen in einem Metall-Hobel"
                                        ],
                                        "tags": [
                                            "Handwerk"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f67fec91-2e37-4d6b-828a-1e437077e629",
                                                "sense_id": "1b010a88-3c4c-305a-9692-707dbf0ce015",
                                                "text": "Der Putzhobel No. 4 ist dank seiner Vielseitigkeit der am häufigsten benutzte Bankhobel überhaupt. Bei ihm kann der Frosch verschoben werden."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "722b41db-7453-3e99-b2b6-c2e290edcff2",
                                        "entry_id": "0dd5bea7-c3ed-3857-a0ea-f21b20a272aa",
                                        "glosses": [
                                            "Explosionsramme, mit der man zum Beispiel in der 2. Hälfte des 20. Jahrhunderts Straßenpflaster im Sandbett festgestampft hat"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "242e8f72-025e-464b-af9a-c2022f3dfdde",
                                                "sense_id": "722b41db-7453-3e99-b2b6-c2e290edcff2",
                                                "text": "„Hallo, ich suche die Bezeichnung … von einer alten Maschine die früher noch so um 1970 im Strassenbau zum Bodenverdichten benutzt wurde. Dieses Gerät war ein aufrecht stehender schwerer Stahl-Zylinder so ca. 1,5m hoch und 40cm Durchmesser. Oben war ein Bügel dran, wo ein Arbeiter das … auf einen Hebel [drückte] und dann sprang das ganze schwere Teil durch eine Bezinexplosion im Inneren so ca. 20-30cm in die Luft und knallte dann wieder auf den Boden zurück.“ - „Ein so genannter Frosch. War ein benzinbetriebenes Gerät mit einem Hubkolben. Sowas startete ich mal als Lausbub auf einer Baustelle, es funktionierte prompt. Macht dann einen Hüpfer. Am besten, man steht nicht mit einem Fuß in der Nähe.“"
                                            },
                                            {
                                                "example_id": "04f640bc-f620-4b5f-8272-03268b7acb5c",
                                                "sense_id": "722b41db-7453-3e99-b2b6-c2e290edcff2",
                                                "text": "Die Dieselramme wurde auch auch Dieselbär oder Benzinfrosch, kurz Frosch genannt."
                                            }
                                        ],
                                        "sense_index_json": "\"7\""
                                    },
                                    {
                                        "sense_id": "13aba604-e832-3e86-808f-5abdd783b8e1",
                                        "entry_id": "0dd5bea7-c3ed-3857-a0ea-f21b20a272aa",
                                        "glosses": [
                                            "mit Lampenöl betriebene Grubenlampe"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d951fc89-10b7-4898-aed5-b5605f7831fd",
                                                "sense_id": "13aba604-e832-3e86-808f-5abdd783b8e1",
                                                "text": "„Im Obergeschoss brannte ein Westfälischer Frosch im Fenster. Es war eine kleine Grubenlampe aus Eisen, und die Bergleute mussten höllisch aufpassen, dass die offen brennenden Frösche keine Schlagwetterexplosionen auslösten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"8\""
                                    }
                                ]
                            }
                        ]
                    }
