                                        "sense_id": "ff0662b7-760e-3c66-8633-92722b1f5221",
                                        "entry_id": "60faa494-66cd-3319-a633-3625894cffdc",
                                        "glosses": [
                                            "A heap or store."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "35397a53-d3ca-43df-b1bc-cbe6f451b654",
                                                "sense_id": "ff0662b7-760e-3c66-8633-92722b1f5221",
                                                "text": "A paper-blurrer, who on all occasions, / For all times, and all season, hath such trinkets / Ready in the deck"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "02134163-9f89-3da3-8f23-a4f145a94460",
                                        "entry_id": "60faa494-66cd-3319-a633-3625894cffdc",
                                        "glosses": [
                                            "A folded paper used for distributing illicit drugs."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4021411f-b840-48f2-84b5-0b4afb297757",
                                                "sense_id": "02134163-9f89-3da3-8f23-a4f145a94460",
                                                "text": "Defendant placed the decks in his pocket and, after driving out of the city, gave one to Shore. While still in the car, Shore snorted half of the deck. When they returned to defendant's home, defendant handed Shore a second deck of heroin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d40d27ee-cbca-3242-ae7e-4040053c0023",
                                        "entry_id": "60faa494-66cd-3319-a633-3625894cffdc",
                                        "glosses": [
                                            "The floor."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "12b55ae5-d3cf-471c-9071-c6348ac6f495",
                                                "sense_id": "d40d27ee-cbca-3242-ae7e-4040053c0023",
                                                "text": "We hit the deck as bullets began to fly."
                                            },
                                            {
                                                "example_id": "adec9054-2d98-4ebf-9574-8211496ca281",
                                                "sense_id": "d40d27ee-cbca-3242-ae7e-4040053c0023",
                                                "text": "Williams fell to the deck. Following a lengthy check, he was replaced by Connor Roberts due to a suspected concussion - a scenario well explained by the stadium's staff over the PA system."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b64c6ca0-228a-36af-9a22-88bf1423304f",
                                        "entry_id": "60faa494-66cd-3319-a633-3625894cffdc",
                                        "glosses": [
                                            "The bottom of a water body."
                                        ],
                                        "tags": [
                                            "British"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c4d0f19f-6837-48c6-a08b-71aea2c61675",
                                                "sense_id": "b64c6ca0-228a-36af-9a22-88bf1423304f",
                                                "text": "Wily carp are quickly put on their guard by tight lines cutting through the water, so another common measure is to use a back lead to keep the line on the deck."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b645ec87-f9b5-3593-b335-3827c1cf477f",
                                        "entry_id": "60faa494-66cd-3319-a633-3625894cffdc",
                                        "glosses": [
                                            "The stage."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5d66de65-08ab-37be-83dd-818de4d27992",
                                        "entry_id": "60faa494-66cd-3319-a633-3625894cffdc",
                                        "glosses": [
                                            "Ellipsis of tape deck."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3588ba30-5166-4cb1-9857-7c7f432c20a5",
                                                "sense_id": "5d66de65-08ab-37be-83dd-818de4d27992",
                                                "text": "The general operating procedure for recording a tape is basically the same as for playing it. After you insert the tape in the deck, you fast forward it to the end and then completely rewind it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69e2f767-b5d1-3ffe-b0c8-9dee0b031d36",
                                        "entry_id": "60faa494-66cd-3319-a633-3625894cffdc",
                                        "glosses": [
                                            "The multiset of graphs formed from a single graph by deleting a single vertex in all possible ways."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "deck",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fc354342-2b10-384b-9d1c-e83db35cd575",
                                        "entry_id": "c71d5501-e577-377a-89d1-b907fbe5f82b",
                                        "glosses": [
                                            "To furnish with a deck, as a vessel."
                                        ],
                                        "tags": [
                                            "uncommon"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1138287a-22ee-3f0d-a48b-ca1f1cc56909",
                                        "entry_id": "c71d5501-e577-377a-89d1-b907fbe5f82b",
                                        "glosses": [
                                            "To knock someone to the floor, especially with a single punch."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d472c272-5e00-4642-a1d0-15b021755f32",
                                                "sense_id": "1138287a-22ee-3f0d-a48b-ca1f1cc56909",
                                                "text": "Wow, did you see her deck that guy who pinched her?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95c318ee-41ce-36e2-a928-055512ee585e",
                                        "entry_id": "c71d5501-e577-377a-89d1-b907fbe5f82b",
                                        "glosses": [
                                            "To cause a player to run out of cards to draw, usually making them lose the game."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "deck",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "617edc70-62b5-3883-ac71-b09ed449ff77",
                                        "entry_id": "e242c803-880d-3073-a8d4-5b192af6f572",
                                        "glosses": [
                                            "To dress (someone) up, to clothe with more than ordinary elegance."
                                        ],
                                        "tags": [
                                            "sometimes",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c243a9ea-03c6-4bd3-8030-1d807f22ef9a",
                                                "sense_id": "617edc70-62b5-3883-ac71-b09ed449ff77",
                                                "text": "And deck my body in gay ornaments, / And witch sweet ladies with my words and looks."
                                            },
                                            {
                                                "example_id": "60ebbb03-8796-42fb-8b68-ca065d0cd3a7",
                                                "sense_id": "617edc70-62b5-3883-ac71-b09ed449ff77",
                                                "text": "Decke thy selfe now with Maiestie, and excellencie, and aray thy selfe with glory, and beautie."
                                            },
                                            {
                                                "example_id": "7c2900c1-7566-4fb6-b7df-87e30485976b",
                                                "sense_id": "617edc70-62b5-3883-ac71-b09ed449ff77",
                                                "text": "They call beautiful a dress, a dog, a sermon; and when they are face to face with Beauty cannot recognise it. The false emphasis with which they try to deck their worthless thoughts blunts their susceptibilities."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ef92232a-5862-33fb-b66d-8ce1b6c3da8f",
                                        "entry_id": "e242c803-880d-3073-a8d4-5b192af6f572",
                                        "glosses": [
                                            "To decorate (something)."
                                        ],
                                        "tags": [
                                            "sometimes",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be92bbac-9316-4ca7-8816-6a2eff0aab5f",
                                                "sense_id": "ef92232a-5862-33fb-b66d-8ce1b6c3da8f",
                                                "text": "(now the dew with spangles decked the ground)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7aeb5fa8-3805-39c8-baa0-0ea0a9d51335",
                                        "entry_id": "e242c803-880d-3073-a8d4-5b192af6f572",
                                        "glosses": [
                                            "To cover; to overspread."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0fd90ec9-43d9-4742-b634-1828bbc5b482",
                                                "sense_id": "7aeb5fa8-3805-39c8-baa0-0ea0a9d51335",
                                                "text": "Whether to deck with clouds the uncoloured sky, / Or wet the thirsty earth with falling showers"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
