                    ],
                    "target_lang_definitions": {
                        "en": "Short form of the neuter adjective 'absolute'; complete and unconditional.",
                        "cs": "Krátký tvar přídavného jména 'absolutní'; úplný, bezpodmínečný.",
                        "zh": "形容词“绝对的”的短语形式，表示完全且无条件的。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "absolute",
                                "target_lang_sense_clarification": "existing independently and not in relation to other things; not limited or restricted"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "absolutní",
                                "target_lang_sense_clarification": "vztahuje se k něčemu, co je úplné a bezvýhradné"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "绝对",
                                "target_lang_sense_clarification": "指不受任何限制或条件的"
