                    {
                        "form_id": "14dc53ac-b8e1-4bb5-b9b0-ede4549a6d69",
                        "entry_id": "a6341b94-f2ca-340c-bc72-536d88f2e33b",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Bekanntgaben"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f9c14f35-666a-39d4-a5e3-81fda58bf192",
                        "entry_id": "a6341b94-f2ca-340c-bc72-536d88f2e33b",
                        "glosses": [
                            "eine mündliche oder schriftliche Aussage, die Leute/die Öffentlichkeit über etwas informiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b97a9fbd-89bb-4865-92aa-481017d6b0cc",
                                "sense_id": "f9c14f35-666a-39d4-a5e3-81fda58bf192",
                                "text": "Nach der unbeabsichtigten Bekanntgabe der Maueröffnung auf einer Pressekonferenz durch Günter Schabowski sind die Ostberliner noch in derselben Nacht zu Zehntausenden über die Grenze geströmt."
                            },
                            {
                                "example_id": "e2ca26f5-387a-44a0-ba1a-25d3ce54b385",
                                "sense_id": "f9c14f35-666a-39d4-a5e3-81fda58bf192",
                                "text": "„Der Antrag auf Durchführung eines weiteren Asylverfahrens wird abgelehnt. Der Antragsteller wird aufgefordert, die Bundesrepublik Deutschland innerhalb einer Woche nach Bekanntgabe dieser Entscheidung zu verlassen. Sollte der Antragsteller die Ausreisefrist nicht einhalten, wird er nach Algerien abgeschoben.“"
                            },
                            {
                                "example_id": "ebebeea5-b969-415f-b26b-13625326a660",
                                "sense_id": "f9c14f35-666a-39d4-a5e3-81fda58bf192",
                                "text": "Im letzten Testspiel der DFB-Elf vor der Bekanntgabe des endgültigen Kaders kehrt Manuel Neuer gegen Österreich ins Tor zurück."
                            },
                            {
                                "example_id": "b20747dd-8910-45fc-880d-485f6d593c2b",
                                "sense_id": "f9c14f35-666a-39d4-a5e3-81fda58bf192",
                                "text": "Ein halbes Jahr nach der Bekanntgabe der katastrophalen Prozessorfehler Meltdown und Spectre, von denen immer noch neue Varianten entdeckt werden, wartet Xen nun mit umfangreichen Gegenmaßnahmen auf […]."
                            },
                            {
                                "example_id": "0b3432e9-14a0-420b-ad58-3716f1498288",
                                "sense_id": "f9c14f35-666a-39d4-a5e3-81fda58bf192",
                                "text": "Bereits wenige Stunden nach der Bekanntgabe der Lücke seien viele Drupal-Instanzen durch automatische Systeme angegriffen und wohl auch erfolgreich kompromittiert worden."
                            },
                            {
                                "example_id": "8821c25d-dca3-4f20-8acc-cbefe8ba0db3",
                                "sense_id": "f9c14f35-666a-39d4-a5e3-81fda58bf192",
                                "text": "Kurz nach Bekanntgabe einer Vereinbarung zur Umsiedlung afrikanischer Einwanderer von Israel in westliche Staaten hat Regierungschef Netanjahu die Übereinkunft schon wieder ausgesetzt. Ihm wurde wohl die Kritik zu groß."
                            },
                            {
                                "example_id": "ae1fb960-a0d2-4f45-a578-43331cc5e8ca",
                                "sense_id": "f9c14f35-666a-39d4-a5e3-81fda58bf192",
                                "text": "Gut eineinhalb Jahre nach der Bekanntgabe der Fusionspläne macht das US-Justizministerium offenbar den Weg für die Übernahme von Monsanto durch den Bayer-Konzern frei."
                            },
                            {
                                "example_id": "f28687a8-ef00-4353-ae4a-01db1a5f7982",
                                "sense_id": "f9c14f35-666a-39d4-a5e3-81fda58bf192",
                                "text": "[Die ehemalige Bildungsministerin Blanca] Ovelar, die nur 31 Prozent der Stimmen der 2,8 Millionen Wahlberechtigten auf sich vereinigen konnte, gab ihre Wahlniederlage noch vor der Bekanntgabe des endgültigen Wahlergebnisses zu."
                            },
                            {
                                "example_id": "d27de7e5-d143-4069-8d76-c9fb88bd6212",
                                "sense_id": "f9c14f35-666a-39d4-a5e3-81fda58bf192",
                                "text": "Die Bekanntgabe des Preisträgers [des Nobelpreises für Literatur] erfolgt jährlich Anfang bis Mitte Oktober […]."
                            },
                            {
                                "example_id": "dc8de051-f42f-4b36-9de4-cb2841c9cc2a",
                                "sense_id": "f9c14f35-666a-39d4-a5e3-81fda58bf192",
                                "text": "In der Praxis ist insbesondere die Art und der Zeitpunkt der Bekanntgabe der Einleitung des Bußgeldverfahrens gegenüber dem Betroffenen ein wichtiger taktischer Aspekt der Verfahrensführung."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f9c586a6-6270-4944-be71-475499c300ad",
                        "source_entry_id": "a6341b94-f2ca-340c-bc72-536d88f2e33b",
                        "source_sense_id": "f9c14f35-666a-39d4-a5e3-81fda58bf192",
                        "source_sense_description": "Information für die Öffentlichkeit",
                        "target_lang_word": "announcement",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "announcement",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "270cd55b-a471-3a9c-9ec5-c712222d05d2",
                                        "entry_id": "6b19a5ec-3949-37b6-a792-7bc57f21940b",
                                        "glosses": [
                                            "An act of announcing, or giving notice."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4db82f24-0394-4e90-af27-f15c15170461",
                                                "sense_id": "270cd55b-a471-3a9c-9ec5-c712222d05d2",
                                                "text": "He raised his hand to make his announcement and said, \"Excuse me everyone, I have an announcement to make.\""
                                            },
                                            {
                                                "example_id": "cc69f6df-c7ea-44ac-8eea-6ea76f41a500",
                                                "sense_id": "270cd55b-a471-3a9c-9ec5-c712222d05d2",
                                                "text": "Where else in the world can you pre-order sushi and fondue on some of the trains, travel in family carriages equipped with mini-playgrounds, or use a request stop button at some small stations? Where else can you hear the announcement: \"The train at Platform 4 is ten minutes late due to an incident in another country,\" as I did once at the Swiss station of Spiez?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fb782c23-2cfc-320c-8507-74b7bdf55019",
                                        "entry_id": "6b19a5ec-3949-37b6-a792-7bc57f21940b",
                                        "glosses": [
                                            "That which conveys what is announced."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9fed345d-aad2-411c-8c5c-4e12133a1063",
                                                "sense_id": "fb782c23-2cfc-320c-8507-74b7bdf55019",
                                                "text": "This announcement was made during the first training session."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cdfd8ebc-9aed-38a2-a8b1-e56754ae36e9",
                                        "entry_id": "6b19a5ec-3949-37b6-a792-7bc57f21940b",
                                        "glosses": [
                                            "The content which is announced."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd1c62a1-7956-43bf-bc25-3df056a43231",
                                                "sense_id": "cdfd8ebc-9aed-38a2-a8b1-e56754ae36e9",
                                                "text": "The announcement implied that somebody needed a spare Toshiba charger."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
