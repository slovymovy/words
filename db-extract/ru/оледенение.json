                    },
                    {
                        "translation_id": "30322918-de75-4f1d-993d-fd27ff006aa0",
                        "source_entry_id": "40759c34-4929-3522-8351-dcb325f8b432",
                        "target_lang_word": "hielo",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hielo",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "a5e82a03-e24c-32a9-b6b2-84b78d578205",
                                        "entry_id": "7e5246b2-d10d-3ea6-b51d-67245c3bbe9c",
                                        "glosses": [
                                            "Acción o efecto de helar o de helarse."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d5bf234d-afd0-4b62-b830-6e7f11ba1b35",
                                                "sense_id": "a5e82a03-e24c-32a9-b6b2-84b78d578205",
                                                "text": "«Y en los signos frío y secos causan grandísimos fríos y hielos en invierno, cuando ayuda al signo alguna constelación fría; y en el tiempo caliente, grandísimos calores»."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f56ff0d1-253d-32c1-ba58-74d1809205a2",
                                        "entry_id": "7e5246b2-d10d-3ea6-b51d-67245c3bbe9c",
                                        "glosses": [
                                            "Estado sólido del agua."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7bea863-89aa-48d9-8a83-8f4b13d73c15",
                                                "sense_id": "f56ff0d1-253d-32c1-ba58-74d1809205a2",
                                                "text": "«Y que el viaje y camino que por allí llevaban no era para ir a las bienaventuradas Molucas, sino a algunas perpetuas nieves y hielos, ya tierra de tanta destemplanza donde todos pereciesen»."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "216367e6-9290-3313-9988-4bb486b558a2",
                                        "entry_id": "7e5246b2-d10d-3ea6-b51d-67245c3bbe9c",
                                        "glosses": [
                                            "Por extensión, estado sólido de otros elementos volátiles que forman parte de la atmósfera planetaria."
                                        ],
                                        "tags": [
                                            "Física"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fabdd88a-344e-46e4-807f-62ab230395ab",
                                                "sense_id": "216367e6-9290-3313-9988-4bb486b558a2",
                                                "text": "«Al final de un largo día en Plutón la luz del Sol distante se refleja en una planicie de hielo de metano»."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "dc052f98-05b9-33c4-a57a-5ee068dbd049",
                                        "entry_id": "7e5246b2-d10d-3ea6-b51d-67245c3bbe9c",
                                        "glosses": [
                                            "Figuradamente, falta de afecto o interés entre dos personas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "328dba17-3f06-4d56-85e4-3ffed9ec6080",
                                                "sense_id": "dc052f98-05b9-33c4-a57a-5ee068dbd049",
                                                "text": "«¿Cuándo será aquel día\nque el corazón descanse de su duelo,\ny el alma tibia y fría,\ndesecho ya su hielo,\nse abrase en amor tuyo, oh Rey del cielo?»."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            },
                            {
                                "target_word": "hielo",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "cc20068f-67d4-3a01-9468-406894e48328",
