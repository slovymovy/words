                ],
                "senses": [
                    {
                        "sense_id": "7106af77-d07b-3b2d-9069-0f9c56d24e64",
                        "entry_id": "bd2392f6-cc06-3e1d-aa88-4c347d852360",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6cb779b1-5670-42e1-9e02-353b60213815",
                                "sense_id": "7106af77-d07b-3b2d-9069-0f9c56d24e64",
                                "text": "Frau Bürgle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "fcffe4cb-f7a1-41c0-9a65-5cbe319b5887",
                                "sense_id": "7106af77-d07b-3b2d-9069-0f9c56d24e64",
                                "text": "Herr Bürgle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "5cdf990a-5233-46a0-b78a-534d4e070b9f",
                                "sense_id": "7106af77-d07b-3b2d-9069-0f9c56d24e64",
                                "text": "Die Bürgles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "70d71057-5b68-4d01-b637-e0262306badc",
                                "sense_id": "7106af77-d07b-3b2d-9069-0f9c56d24e64",
                                "text": "Der Bürgle trägt nie die Pullover, die die Bürgle ihm strickt."
                            },
                            {
                                "example_id": "473b40f7-448e-4225-bbd6-56ba641f8ecf",
                                "sense_id": "7106af77-d07b-3b2d-9069-0f9c56d24e64",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Bürgle kommt, geht der Herr Bürgle.“"
                            },
                            {
                                "example_id": "8481f59a-10f4-4175-b733-e0f0d469d5c8",
                                "sense_id": "7106af77-d07b-3b2d-9069-0f9c56d24e64",
                                "text": "Bürgle kommt und geht."
                            },
                            {
                                "example_id": "5c374d94-b4b1-4c99-944f-e4e005499f20",
                                "sense_id": "7106af77-d07b-3b2d-9069-0f9c56d24e64",
                                "text": "Bürgles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
