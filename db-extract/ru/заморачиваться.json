                    }
                ],
                "senses": [
                    {
                        "sense_id": "81db424e-a95b-3897-829a-93a47e79f144",
                        "entry_id": "5d7341ff-155f-3952-a39f-d4e36f0e8ffb",
                        "glosses": [
                            "to bother (with), to go through the trouble (of getting)"
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "968bfb14-0d1d-4b1d-8e17-566a7b0fe06a",
                                "sense_id": "81db424e-a95b-3897-829a-93a47e79f144",
                                "text": "Не хочу́ замора́чиваться с логи́стикой.",
                                "translation": "I don't want to bother with logistics.",
                                "english": "I don't want to bother with logistics."
                            },
                            {
                                "example_id": "1bc78fbf-ad5e-4d8a-9569-ce04c5bfcef7",
                                "sense_id": "81db424e-a95b-3897-829a-93a47e79f144",
                                "text": "Не ну́жно замора́чиваться над устано́вкой приложе́ний.",
                                "translation": "You don't need to bother with installing applications.",
                                "english": "You don't need to bother with installing applications."
                            },
                            {
                                "example_id": "5d6a516d-347d-43fc-88c6-cfb32d0da4ec",
                                "sense_id": "81db424e-a95b-3897-829a-93a47e79f144",
                                "text": "Кто бу́дет замора́чиваться на фальши́вые докуме́нты и креди́тку?",
                                "translation": "Who would go through the trouble of getting a fake ID and credit card?",
                                "english": "Who would go through the trouble of getting a fake ID and credit card?"
                            }
                        ]
                    },
                    {
                        "sense_id": "da3334c8-da18-362a-8276-786968f73e86",
                        "entry_id": "5d7341ff-155f-3952-a39f-d4e36f0e8ffb",
                        "glosses": [
                            "to get hung up (on), to get wrapped up (about), to worry (about), to obsess (over), to overthink, to beat oneself up (over)"
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "5b8e14fd-25ff-4620-b6ee-7997c1e7a94f",
                                "sense_id": "da3334c8-da18-362a-8276-786968f73e86",
                                "text": "Не замора́чивайся.",
                                "translation": "Don't get hung up (about it). / Don't worry (about it).",
                                "english": "Don't get hung up (about it). / Don't worry (about it)."
                            },
                            {
                                "example_id": "4e4e137b-06c2-4b91-a1e6-31c83c470506",
                                "sense_id": "da3334c8-da18-362a-8276-786968f73e86",
                                "text": "Я предпочита́ю не замора́чиваться вопро́сами терминоло́гии.",
                                "translation": "I prefer not to get hung up on matters of terminology.",
                                "english": "I prefer not to get hung up on matters of terminology."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
