        "fr-extract.jsonl": [
            {
                "entry_id": "90c95d11-b669-380a-934a-f63e7bae8d1f",
                "word": "minimaliste",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "1d66d840-d919-47bd-8a09-1486d8fbda2f",
                        "entry_id": "90c95d11-b669-380a-934a-f63e7bae8d1f",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "minimalistes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e73e1b7e-aab7-3c7d-b48e-20dfa1f2284a",
                        "entry_id": "90c95d11-b669-380a-934a-f63e7bae8d1f",
                        "glosses": [
                            "Qui se contente d’un minimum."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "225e99c6-7fc2-46c9-93d1-ac1cb2800ffb",
                                "sense_id": "e73e1b7e-aab7-3c7d-b48e-20dfa1f2284a",
                                "text": "Adopter une position minimaliste."
                            },
                            {
                                "example_id": "95f83d14-c4b2-45f1-a190-4ffde21ed839",
                                "sense_id": "e73e1b7e-aab7-3c7d-b48e-20dfa1f2284a",
                                "text": "Des jeunes vont choisir d'aller vers des téléphones minimalistes pour mieux se concentrer, pour éviter d'être constamment distraits et tentés par des applications."
                            }
                        ]
                    },
                    {
                        "sense_id": "053ecdf0-02f8-3764-b6ea-9536b54bb77a",
                        "entry_id": "90c95d11-b669-380a-934a-f63e7bae8d1f",
                        "glosses": [
                            "Relatif au minimalisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91ab856e-cf5d-4486-a39a-072eb605d7b7",
                                "sense_id": "053ecdf0-02f8-3764-b6ea-9536b54bb77a",
                                "text": "Du design minimaliste."
                            },
                            {
                                "example_id": "629297d3-0e61-43cc-a601-f50e9f34e8fa",
                                "sense_id": "053ecdf0-02f8-3764-b6ea-9536b54bb77a",
                                "text": "L’artiste François Morellet, précurseur du minimalisme, est mort\nPeintre, graveur et sculpteur, l’artiste français est décédé ce mercredi 11 mai à l’âge de 90 ans. Il restera notamment célèbre pour ses œuvres lumineuses réalisées à partir de néons."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "04787a5c-bb3a-467a-b057-37747c6f3677",
                        "source_entry_id": "90c95d11-b669-380a-934a-f63e7bae8d1f",
                        "source_sense_description": "Qui se contente d'un minimum",
                        "target_lang_word": "minimalist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "minimalist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e3b58ac9-540d-38ba-a0c1-118e7b586823",
                                        "entry_id": "6801861a-ca9c-3db4-8454-d8f193792d5e",
                                        "glosses": [
                                            "Believing in or seeking a minimal state; seeking to minimize or reduce to a minimum."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "edd04848-9db6-4b28-9e97-0d33e1b1d169",
                                                "sense_id": "e3b58ac9-540d-38ba-a0c1-118e7b586823",
                                                "text": "I am sure such a minimalist style of furniture would never fit well with my packrat nature."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "minimalist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b3ff93a5-6933-3e55-b31b-78b1cab2783d",
                                        "entry_id": "487f679f-0725-3389-ac4d-5961bf7134c1",
                                        "glosses": [
                                            "One who believes in or seeks a minimal state; one who seeks to minimize or reduce to a minimum."
