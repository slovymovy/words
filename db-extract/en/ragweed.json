                                        "entry_id": "1e96778b-8ca7-39b6-8553-8438f0eca8a7",
                                        "glosses": [
                                            "naam voor planten uit het geslacht Ambrosia, dat oorspronkelijk uit Amerika afkomstig is"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2aa8df02-bf91-41cf-8185-6574a1d8431a",
                                                "sense_id": "c5edbf59-808f-333a-852d-44377b20029a",
                                                "text": "Door de hooikoortsplant ambrosia te vernietigen, kunnen we er met zijn allen voor zorgen dat het hooikoortsseizoen niet onnodig lang duurt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d5eece8a-4d2d-31f8-93d3-bbf6be01a432",
                                        "entry_id": "1e96778b-8ca7-39b6-8553-8438f0eca8a7",
                                        "glosses": [
                                            "voedsel voor de goden uit de Griekse en Romeinse mythologie, dat onsterfelijk zou maken"
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de1e1deb-8a80-40ae-a9a1-e86683ed7b5c",
                                                "sense_id": "d5eece8a-4d2d-31f8-93d3-bbf6be01a432",
                                                "text": "Tantalus zette in zijn hoogmoed zijn geestes-kinderen voor aan de goden, om te zien of ze het verschil met ambrosia zouden bemerken."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
