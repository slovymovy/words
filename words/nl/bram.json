                {
                    "sense_id": "c6500a13-23fe-35e0-bb79-dc45dcbd7671",
                    "sense_definition": "Een zeil aan de bramsteng, boven het marszeil; verkorting van <w>bramzeil</w>.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "nautical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De matrozen moesten de <w>bram</w> hijsen toen de wind draaide.",
                            "target_lang_translations": {
                                "en": "The sailors had to hoist the <w>topgallant</w> when the wind turned.",
                                "ru": "Матросам пришлось поднять <w>брамсель</w>, когда ветер переменился.",
                                "tr": "Rüzgar döndüğünde denizciler <w>bramseli</w> çekmek zorunda kaldı."
                            }
                        },
                        {
                            "text": "Het schip voer met volle zeilen, inclusief de <w>bram</w>.",
                            "target_lang_translations": {
                                "en": "The ship sailed with full sails, including the <w>topgallant</w>.",
                                "ru": "Корабль шел на всех парусах, включая <w>брамсель</w>.",
                                "tr": "Gemi, <w>bramsel</w> de dahil olmak üzere tam yelken seyrediyordu."
                            }
                        }
                    ],
                    "synonyms": [
                        "bramzeil"
                    ],
                    "target_lang_definitions": {
                        "en": "A sail on the topgallant mast, above the topsail; short for topgallant sail.",
                        "ru": "Парус на брам-стеньге, выше марселя; сокращение от брамселя.",
                        "tr": "Bramsteng üzerindeki, gabya yelkeninin üstündeki yelken; bramzeil'in kısaltması."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "topgallant sail",
                                "target_lang_sense_clarification": "nautical"
                            },
                            {
                                "target_lang_word": "topgallant",
                                "target_lang_sense_clarification": "nautical, short form"
                            }
                        ],
                        "ru": [
