                                        "glosses": [
                                            "Nom donné à un gouvernement dirigé par deux personnalités (politiques ou militaires) de poids égal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5028531b-b4f9-4483-9792-d708af755020",
                                                "sense_id": "a2d88068-c083-374f-b0da-36189de7db3f",
                                                "text": "Le duumvirat ou le quattuorvirat ont remplacé toute autre forme de pouvoir suprême local dans les provinces gauloises durant le Haut-Empire."
                                            }
                                        ]
                                    }
                                ]
                            }
