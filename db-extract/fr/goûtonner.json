                "senses": [
                    {
                        "sense_id": "31145470-7f9d-3706-abbb-4ba3b53ce7ce",
                        "entry_id": "7b9a70d1-13cc-328b-8500-e8f9c644debb",
                        "glosses": [
                            "Prendre son goûter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61625956-9404-4779-93a9-37b725a8c6ed",
                                "sense_id": "31145470-7f9d-3706-abbb-4ba3b53ce7ce",
                                "text": "Peut-on avoir goûtonné sans parler du nez ?"
                            },
                            {
                                "example_id": "385ae4f4-4bb6-4f74-ae21-333c7edfef96",
                                "sense_id": "31145470-7f9d-3706-abbb-4ba3b53ce7ce",
                                "text": "M. le Curé arriva vers six heures, pendant qu’on « goûtonnait »."
                            },
                            {
                                "example_id": "f9e0e54d-4d8c-46ef-968c-467ef5b6a293",
                                "sense_id": "31145470-7f9d-3706-abbb-4ba3b53ce7ce",
                                "text": "À 4 h, toujours de l’après-midi, on « goûtonnait »."
                            },
                            {
                                "example_id": "e69911ac-24e6-4f29-b310-cd9ce7836802",
                                "sense_id": "31145470-7f9d-3706-abbb-4ba3b53ce7ce",
                                "text": "Prendre une collation au milieu de l’après-midi, « goûtonner » comme on disait autrefois, est une invitation qui mérite plus que l’objet enfantin qu’on lui attribue trop souvent."
                            }
                        ]
                    }
                ],
