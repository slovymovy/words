                        "examples": [
                            {
                                "example_id": "af9ce69f-6fe3-42ef-91cb-b35b592d17f3",
                                "sense_id": "324601fa-463a-3c20-8bd2-41ecfa2f1b98",
                                "text": "Dr Stefan Banach otrzymał tytuł naukowy bez ukończenia studiów wyższych."
                            },
                            {
                                "example_id": "0c4b92ca-0825-42a7-9685-06da9820ab4a",
                                "sense_id": "324601fa-463a-3c20-8bd2-41ecfa2f1b98",
                                "text": "dr. Kowalskiego"
                            },
                            {
                                "example_id": "e5e488da-53f2-4feb-a729-385bd09685d9",
                                "sense_id": "324601fa-463a-3c20-8bd2-41ecfa2f1b98",
                                "text": "Widziała pani dzisiaj dr Kowalską?"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "c27ac280-ff46-3028-b86a-821a891c9941",
