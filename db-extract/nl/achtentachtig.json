                "senses": [
                    {
                        "sense_id": "df25cba7-a956-3d9e-9644-50f36b6b0c22",
                        "entry_id": "73750feb-afd4-3611-b7ee-c192eadf65b5",
                        "glosses": [
                            "dat wat in een (rang)ordening met 88 is aangeduid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aae1b7ca-36d1-4baa-978a-07f258ac1c2f",
                                "sense_id": "df25cba7-a956-3d9e-9644-50f36b6b0c22",
                                "text": "Het is weer de achtentachtig die het niet doet, kunnen we die niet simpel vervangen?"
                            },
                            {
                                "example_id": "41dbb783-18b4-456a-9741-612257383f28",
                                "sense_id": "df25cba7-a956-3d9e-9644-50f36b6b0c22",
                                "text": "Haar negenentachtigste verjaardag was een belangrijk moment, want haar leven werd heel anders toen ze de achtentachtig eenmaal voorbij was."
                            }
                        ]
                    },
                    {
                        "sense_id": "9c19bd1d-d99a-3ef3-ac2b-54313c3c0d32",
                        "entry_id": "73750feb-afd4-3611-b7ee-c192eadf65b5",
                        "glosses": [
                            "groep van 88 eenheden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b3aa80b-2d8e-418b-a749-4824cc9d11ea",
                                "sense_id": "9c19bd1d-d99a-3ef3-ac2b-54313c3c0d32",
                                "text": "De achtentachtig zijn natuurlijk blij, maar laten we ook denken aan het verdriet van de vier die zijn afgewezen."
                            }
                        ]
                    }
