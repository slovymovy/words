                "senses": [
                    {
                        "sense_id": "21e357b5-b951-3f90-8e7b-a2fe3694c673",
                        "entry_id": "962a8a0f-45e1-3a30-ab11-fd13e63b3065",
                        "glosses": [
                            "Ort, an dem Ansteckung (Infektion) mit einer Infektionskrankheit erstmals geschieht"
                        ],
                        "tags": [
                            "Epidemiologie"
                        ],
                        "examples": [
                            {
                                "example_id": "393db440-bc81-451f-9b5e-55e5d354e228",
                                "sense_id": "21e357b5-b951-3f90-8e7b-a2fe3694c673",
                                "text": "„Nach offiziellen Angaben starben 1996 allein in Gabun 68 Menschen an Ebola. Diese waren offenbar alle auf einen Infektionsherd in der Booue- Region zurückzuführen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "7b42bc9e-9ed7-3334-a13b-21f141ff3792",
                        "entry_id": "962a8a0f-45e1-3a30-ab11-fd13e63b3065",
                        "glosses": [
                            "Ort im Körper, an dem ein Infektion erstmals auftritt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce5786ee-77eb-4ac1-b58c-a68b4c22e4c0",
                                "sense_id": "7b42bc9e-9ed7-3334-a13b-21f141ff3792",
                                "text": "„Beispielsweise kann sich ein Infektionsherd entwickeln bei einer Verletzung von Haut oder Schleimhaut, einer ziliaren Dysfunktion der Epithelzellen des Tracheobronchialbaumes oder in Assoziation mit einem Fremdkörper.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
