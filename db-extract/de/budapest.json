                            {
                                "example_id": "b85f3692-d665-4270-8a37-40bb66a6c738",
                                "sense_id": "3f5d8373-8126-386a-87e3-e4668aa69a1a",
                                "text": "In Budapest leben etwa 1.702.297 Menschen."
                            },
                            {
                                "example_id": "f46982d7-eca8-4227-9cbf-ea096252811d",
                                "sense_id": "3f5d8373-8126-386a-87e3-e4668aa69a1a",
                                "text": "„So habe das universitäre Fach Germanistik im Jahre 1949 nur noch in Budapest existiert, während die entsprechenden Lehrstühle in Szeged, Debrecen und Pécs aufgelöst worden seien.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
