                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e031d49-50e2-43ee-8fb1-2670a2eef78f",
                                                "sense_id": "528fe1a8-680f-3c19-916b-a795db20fe59",
                                                "text": "Všechny strany jsou ve sněmovně zastoupeny poměrně."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d4efadb1-1fa2-3f71-99bd-156e1b0c80d9",
                                        "entry_id": "da08cfdb-2564-3920-b87a-587ae951ab9e",
                                        "glosses": [
                                            "ve srovnání s obdobnými entitami"
                                        ],
                                        "tags": [],
