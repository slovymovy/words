                ],
                "senses": [
                    {
                        "sense_id": "058908d2-61ec-37ee-84e4-85cbfcee2f50",
                        "entry_id": "ca6e62d0-acdb-3d10-a166-984723ddb0c1",
                        "glosses": [
                            "politisch bedeutsamer Vorgang oder Gegenstand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba465698-94a6-4b28-9468-adb76fcf395e",
                                "sense_id": "058908d2-61ec-37ee-84e4-85cbfcee2f50",
                                "text": "Auch zunächst unbedeutende Dinge können zum Politikum werden."
                            },
                            {
                                "example_id": "6f91d1b3-af32-4891-b2e3-b8ea8dbe4c11",
                                "sense_id": "058908d2-61ec-37ee-84e4-85cbfcee2f50",
                                "text": "„In einem Staatswesen, das keine Trennung zwischen militärischer und ziviler Gewalt kannte, in dem Politiker Heerführer und Heerführer Politiker waren, stellte der Oberbefehl auf bedeutenden Kriegsschauplätzen von jeher ein Politikum dar.“"
                            },
                            {
                                "example_id": "e953cb67-658d-453f-a707-c64139f782e8",
                                "sense_id": "058908d2-61ec-37ee-84e4-85cbfcee2f50",
                                "text": "„Und so wurde aus einem trockenen Hügel ein Politikum.“"
                            },
                            {
                                "example_id": "dcf0c69e-7075-44f1-ab87-b8d852b646f0",
                                "sense_id": "058908d2-61ec-37ee-84e4-85cbfcee2f50",
                                "text": "„In letzter Zeit wird Sprache jedoch immer mehr zum Politikum.“"
                            },
                            {
                                "example_id": "4a52e431-541e-4cce-b35e-92d526271590",
                                "sense_id": "058908d2-61ec-37ee-84e4-85cbfcee2f50",
                                "text": "„Volkszählungen in Pakistan stellen immer auch ein Politikum dar.“"
                            },
                            {
                                "example_id": "4c7c8fcb-699f-4b76-bfb1-a400f2175023",
                                "sense_id": "058908d2-61ec-37ee-84e4-85cbfcee2f50",
                                "text": "„Erst die Protestbewegung der 1960er Jahre brachte eine nachhaltige Veränderung. Die Strafbarkeit von Homosexualität wurde immer mehr zum Politikum, die Betroffenen fingen an, sich zu wehren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
