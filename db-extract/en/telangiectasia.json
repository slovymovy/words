                        "glosses": [
                            "A condition characterized by dilatation of the capillaries, causing them to appear as small red or purple clusters, often spidery in appearance, on the skin or the surface of an organ."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
