                        "examples": [
                            {
                                "example_id": "633cea4d-5781-4e3e-94e5-a576f2f03c0a",
                                "sense_id": "1e43e1d6-bd9f-326d-8ab3-12ef831fbca5",
                                "text": "Dwie kobiety nie poddały się postępowaniu mandatowemu za opalanie się topless na kąpielisku miejskim. Sąd pierwszej instancji uznał, że dopuściły się one nieobyczajnego wybryku."
                            }
                        ],
