                ],
                "senses": [
                    {
                        "sense_id": "355b2992-6578-3f8e-a80b-0f69812253a3",
                        "entry_id": "995ecf3d-d6e3-3ad2-9f2d-8c8c2ea51a03",
                        "glosses": [
                            "Bidon pour carburant automobile."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b29b90e-cdb5-4e52-a17a-2dae9cc05ed8",
                                "sense_id": "355b2992-6578-3f8e-a80b-0f69812253a3",
                                "text": "C’est à ce moment-là que Pierre débarque, tenant dans sa main un jerrican en fer."
                            },
                            {
                                "example_id": "0f571342-56c6-4742-82f3-c872ebd8b517",
                                "sense_id": "355b2992-6578-3f8e-a80b-0f69812253a3",
                                "text": "Un jerrican l’y attendait, oublié. Un jerrican en plastique jaune, opaque et couvert de poussière, de terre, de toiles d’insectes ; celui qui servait de réserve à la grosse Talbot noire."
                            },
                            {
                                "example_id": "b370bcc1-e435-44a0-b210-49b18c8d3d4c",
                                "sense_id": "355b2992-6578-3f8e-a80b-0f69812253a3",
                                "text": "Il faut d'abord souligner qu'il s'agit d'une installation de fortune : emploi de fûts d'essence pour la fumigérite, de Jerrican pour l'ammoniaque, de conduites et de robinets sommairement étudiés."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "98d1005e-ee92-4de4-8a6a-cb326540a9c1",
                        "source_entry_id": "995ecf3d-d6e3-3ad2-9f2d-8c8c2ea51a03",
                        "source_sense_id": "355b2992-6578-3f8e-a80b-0f69812253a3",
                        "source_sense_description": "Bidon pour carburant automobile",
                        "target_lang_word": "Benzinkanister",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Benzinkanister",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b0bc49fe-7712-3835-ab21-f630b2da3f6d",
                                        "entry_id": "c2815bf3-9276-3487-8758-3a0b2a0279fc",
                                        "glosses": [
                                            "verschließbarer Behälter, meist aus Blech oder Plastik, der zum Transport und Aufbewahren von Benzin benutzt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5490390b-00cc-4301-a9b6-c4debe5ca287",
                                                "sense_id": "b0bc49fe-7712-3835-ab21-f630b2da3f6d",
                                                "text": "Der Benzinkanister ist leer."
                                            },
                                            {
                                                "example_id": "1e22ecf6-119b-4026-b9f4-3b747d2e2ac6",
                                                "sense_id": "b0bc49fe-7712-3835-ab21-f630b2da3f6d",
                                                "text": "„Es fanden sich Berge von grünen Benzinkanistern.“"
                                            },
                                            {
                                                "example_id": "c56a57a6-6137-4f83-933c-329bb0b25b53",
                                                "sense_id": "b0bc49fe-7712-3835-ab21-f630b2da3f6d",
                                                "text": "„Einmal die Woche hatte sie das schwere Gerät über die Straße hinter sich hergezogen, und manchmal hatte sie einen roten Benzinkanister dabeigehabt.“"
                                            },
                                            {
                                                "example_id": "712002fd-8576-4732-a16b-3abfdfdbbcdf",
                                                "sense_id": "b0bc49fe-7712-3835-ab21-f630b2da3f6d",
                                                "text": "„Autoreifen, Benzinkanister und Zigarettenkartons lagen herum.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "76a94dd2-d906-436b-9cdd-ae26bb7feb8f",
                        "source_entry_id": "995ecf3d-d6e3-3ad2-9f2d-8c8c2ea51a03",
