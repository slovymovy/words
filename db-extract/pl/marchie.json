                "senses": [
                    {
                        "sense_id": "c47e9b06-b8e1-35e1-9e49-f21cfd93b860",
                        "entry_id": "1b7d32e4-ab5a-3cb1-acbb-f7066e3fa6c0",
                        "glosses": [
                            "Marche, region we Włoszech"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07e6f2b5-ca4c-4c29-bee1-b94ddbf8ffed",
                                "sense_id": "c47e9b06-b8e1-35e1-9e49-f21cfd93b860",
                                "text": "W dniach 4 i 5 listopada 1860 r. plebiscyty w Marchiach i Umbrii, jak zwykle, zapewniły o woli tamtejszej ludności poddania się panowaniu Wiktora Emanuela II"
                            },
                            {
                                "example_id": "62048401-99d8-4ec3-8a4e-176a1eb64bf4",
                                "sense_id": "c47e9b06-b8e1-35e1-9e49-f21cfd93b860",
                                "text": "(…) Republika św. Marka poszukiwała kondotierów na zewnątrz, w Mantui, Romanii, Marchiach, lekką jazdę sprowadzając z posiadłości bałkańskich"
                            },
                            {
                                "example_id": "2debcbbe-1528-42ea-bed1-ad006289784c",
                                "sense_id": "c47e9b06-b8e1-35e1-9e49-f21cfd93b860",
                                "text": "Mapa wędrówek Lorenza Lotta też nie jest zbyt bogata, nie wskazuje na głód przestrzeni, ogranicza się do paru miasteczek na terenach należących do Republiki Weneckiej i w Marchiach"
                            },
                            {
                                "example_id": "109e1b94-514c-4283-80cf-04f3e3199102",
                                "sense_id": "c47e9b06-b8e1-35e1-9e49-f21cfd93b860",
                                "text": "Jeżeli szczęściem jest dla Romanii, Marchii i Ankony, że je odbierą Papieżowi, czemuż tego szczęścia pozbawiać Rzym? — a jeźli Rzymowi dobrze ma być z Papieżem, czemu ma być źle Ankonie, Marchiom i Romanii"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
