                                        "glosses": [
                                            "A person from Egypt or of Egyptian descent."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7641efb0-06b2-3a71-996d-20b79662012d",
                                        "entry_id": "66fbcdb5-51d0-3a6e-865d-7966f637fbe4",
                                        "glosses": [
                                            "A gypsy."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c4b635fe-aca7-420d-9457-1e613e9adf65",
                                                "sense_id": "7641efb0-06b2-3a71-996d-20b79662012d",
                                                "text": "The people then assembled in this barn were no other than a company of Egyptians, or, as they are vulgarly called, gypsies, and they were now celebrating the wedding of one of their society."
                                            },
                                            {
                                                "example_id": "be40916d-44f9-4c48-a30f-b9d4a6d7841a",
                                                "sense_id": "7641efb0-06b2-3a71-996d-20b79662012d",
                                                "text": "I went to see the Egyptian, and the Hoodoo doctors too. They shook their heads, and told me there was nothing they could do."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Egyptian",
