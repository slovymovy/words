                        "examples": [
                            {
                                "example_id": "4f2d932f-6517-4de4-8715-ad5634d48d32",
                                "sense_id": "66fa6448-c56b-3229-901c-ec1ac65be7a4",
                                "text": "Après cinq ans, elle rentre en Île-de-France enceinte de Julien Derouault, danseur rencontré dans la ville phocéenne."
                            },
                            {
                                "example_id": "c7384ba9-55c2-403f-873b-13afabf9758b",
                                "sense_id": "66fa6448-c56b-3229-901c-ec1ac65be7a4",
                                "text": "Les colons grecs renouvellent toutefois, en partie mais durablement, ce substrat humain ancien. En effet, leur patrimoine génétique est encore présent chez 4 % de la population marseillaise d’aujourd’hui, identifiable par la présence, sur le chromosome Y, du « signal phocéen », appelé « marqueur E-V13 », une mutation apparue en Grèce et dans ses colonies d’Asie Mineure, à l’instar de Phocée – ce qui confirme l’importance de l’implantation phocéenne."
                            }
                        ]
                    }
