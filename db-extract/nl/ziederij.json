                "senses": [
                    {
                        "sense_id": "9196c346-9a75-3fe7-9149-7fc7675ec002",
                        "entry_id": "1c6fddf8-e13b-367a-8d0c-08132997748f",
                        "glosses": [
                            "werkplaats waar producten worden gemaakt door een vloeistof te koken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e18d4313-38a9-415b-aac5-b1cc9be8168c",
                                "sense_id": "9196c346-9a75-3fe7-9149-7fc7675ec002",
                                "text": "Kromhout ontwierp in zakelijk-expressionistische stijl ook diverse uitbreidingen voor de in 1873 te Rotterdam gestichte Heinekens bierbrouwerij (…). Van het in 1968 gesloten bedrijf resteren de hoge ziederij (…) aan de singel en het kantoorgebouw (…)."
                            }
                        ]
                    },
                    {
                        "sense_id": "6c8f4378-0ba8-3c25-9d0e-1c344675afb8",
                        "entry_id": "1c6fddf8-e13b-367a-8d0c-08132997748f",
                        "glosses": [
                            "werkplaats waar producten worden gemaakt door een vloeistof te koken",
                            "bedrijf dat zeep bereidt door vet met loog te zieden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "20bea341-16ec-4eb8-b6c5-81625563a322",
                                "sense_id": "6c8f4378-0ba8-3c25-9d0e-1c344675afb8",
                                "text": "Kromhout ontwierp in zakelijk-expressionistische stijl ook diverse uitbreidingen voor de in 1873 te Rotterdam gestichte Heinekens bierbrouwerij (…). Van het in 1968 gesloten bedrijf resteren de hoge ziederij (…) aan de singel en het kantoorgebouw (…)."
                            },
                            {
                                "example_id": "b6cb41f0-e7a6-4884-bb55-1d6aa46aab70",
                                "sense_id": "6c8f4378-0ba8-3c25-9d0e-1c344675afb8",
                                "text": "Johann Peter kocht de failliete boedel van deze al sinds 1733 bestaande ziederij van zachte groene zeep in 1854 op, breidde het assortiment uit met harde toiletzeep en bracht het zaakje tot bescheiden bloei."
                            }
                        ]
                    },
                    {
                        "sense_id": "910db472-c604-3fce-b3fd-1200089d13b8",
                        "entry_id": "1c6fddf8-e13b-367a-8d0c-08132997748f",
                        "glosses": [
                            "werkplaats waar producten worden gemaakt door een vloeistof te koken",
                            "bedrijf dat zout wint door pekel te verdampen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f14c715-c565-498d-a904-e129a580d00a",
                                "sense_id": "910db472-c604-3fce-b3fd-1200089d13b8",
                                "text": "Kromhout ontwierp in zakelijk-expressionistische stijl ook diverse uitbreidingen voor de in 1873 te Rotterdam gestichte Heinekens bierbrouwerij (…). Van het in 1968 gesloten bedrijf resteren de hoge ziederij (…) aan de singel en het kantoorgebouw (…)."
                            },
                            {
                                "example_id": "7d192715-cdd4-4a8b-84fe-9e5db0b588f0",
                                "sense_id": "910db472-c604-3fce-b3fd-1200089d13b8",
                                "text": "Aan de Westkeet was de zoutziederij De Bondt de laatste. Deze ziederij, die bestond sinds 1687 en sinds 1823 in handen was van de familie De Bondt, sloot haar deuren in 1957."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4349362b-5440-4f71-a357-2434337e18cd",
                        "source_entry_id": "1c6fddf8-e13b-367a-8d0c-08132997748f",
                        "source_sense_id": "9196c346-9a75-3fe7-9149-7fc7675ec002",
                        "source_sense_description": "werkplaats waar producten worden gemaakt door een vloeistof te koken",
                        "target_lang_word": "boilery",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "boilery",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "420b9f30-cd22-34c2-945a-5aecd7b27582",
                                        "entry_id": "b282b261-4fe8-33b2-ab6e-236d39c56a71",
                                        "glosses": [
                                            "A buisness (and place of business) that engages primarily in boiling, such as in the boiling of sugarcane juice to make sugar, the boiling of brine to make salt, the boiling of soap or tallow, the boiling of bones to make glue, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d0c7643-2f6c-4ee2-b0df-017ec630a3ba",
                                                "sense_id": "420b9f30-cd22-34c2-945a-5aecd7b27582",
                                                "text": "Holonyms: saltworks; sugarhouse"
                                            },
                                            {
                                                "example_id": "36246496-ab2f-4a1c-a1ae-0e788b72bea5",
                                                "sense_id": "420b9f30-cd22-34c2-945a-5aecd7b27582",
                                                "text": "By the grant of a boilery of salt it is said that the soil passes, for it is the whole profit of the soil, and the water being fixed in a certain place within the bounds and compass of the well is considered a part of the soil."
                                            },
                                            {
                                                "example_id": "3c430020-41c4-44c2-b9a1-56b7d1afa05d",
                                                "sense_id": "420b9f30-cd22-34c2-945a-5aecd7b27582",
                                                "text": "In an old case of an informationm for erecting and continuing a soap boilery in Wood Street, in London, to the annoyance of the neighborhood, the trial was before Jeffreys, C.J., at Guildhall—a judge whose name is more unsavory to posterity than any soap boilery."
                                            },
                                            {
                                                "example_id": "7a44cd14-1893-4483-9fa4-9b70dff74a93",
                                                "sense_id": "420b9f30-cd22-34c2-945a-5aecd7b27582",
                                                "text": "Hibiscus, agaves and clematis have been planted round about in small artistic arrangements, the flamboyant flowers like blood that never dries, and inside the boilery there are two iron cauldrons still cemented in their original places and merely converted into small water basins with water lilies, goldfish and submerged electric lighting."
                                            },
                                            {
                                                "example_id": "4e8d3a13-20f0-47d9-a8b6-348e0a8a0fcb",
                                                "sense_id": "420b9f30-cd22-34c2-945a-5aecd7b27582",
                                                "text": "Lampblack factories, for example, further processed bones from the boilery into a substance used in writing and printing inks (also in shoe blacking), products critical to a nation newly awash in newspapers, novels, and penny press features. Curled hair was another material supplied by boileries (as well as by piggeries and slughter-houses.)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95d21cda-8fae-3387-8e1a-3f51faaf60c6",
                                        "entry_id": "b282b261-4fe8-33b2-ab6e-236d39c56a71",
                                        "glosses": [
                                            "A room or area where there is equipment for boiling that is part of a larger establishment, such as equipment for rendering blubber on board a whaling vessel, or vats for boiling laundry as part of a large farmhouse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dfe43169-d1e5-4274-a5c7-10e36d774c47",
                                                "sense_id": "95d21cda-8fae-3387-8e1a-3f51faaf60c6",
                                                "text": "All the appointments, from the carthouse to the boilery, stood in need of repair."
                                            },
                                            {
                                                "example_id": "ee51c314-fa8d-45ce-86cc-6577965ff5ae",
                                                "sense_id": "95d21cda-8fae-3387-8e1a-3f51faaf60c6",
                                                "text": "The time has gone by when a boilery for urine was regarded as indispensable for a physician's scientific progress, and I dare say we are all grateful for this deliverance."
                                            },
                                            {
                                                "example_id": "97afa64a-e10a-4956-b4ec-609f60413342",
                                                "sense_id": "95d21cda-8fae-3387-8e1a-3f51faaf60c6",
                                                "text": "The Factory is placed in the 'tween deck, i.e., aft the blubber boilery, and forward of it the press boilery and Hartmann apparatus."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6a4f37b2-7ba4-4b7e-b319-ac37ee323d8e",
                        "source_entry_id": "1c6fddf8-e13b-367a-8d0c-08132997748f",
