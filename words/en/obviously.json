{
    "word_family": [
        "obvious",
        "obviousness"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "96c80741-c542-35b5-8e96-21aed645f096",
                    "sense_definition": "In a way that is easy to see, understand, or recognize.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "clarity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The plane has <w>obviously</w> been delayed because the departure board shows a new time.",
                            "target_lang_translations": {
                                "ru": "Рейс, <w>очевидно</w>, задерживается, так как на табло вылета указано новое время."
                            }
                        },
                        {
                            "text": "She was in floods of tears and <w>obviously</w> very upset about the news.",
                            "target_lang_translations": {
                                "ru": "Она обливалась слезами и была <w>явно</w> очень расстроена новостями."
                            }
                        }
                    ],
                    "synonyms": [
                        "clearly",
                        "evidently",
                        "plainly",
                        "visibly",
                        "noticeably"
                    ],
                    "antonyms": [
                        "subtly",
                        "unobviously"
                    ],
                    "common_phrases": [
                        "obviously very upset",
                        "obviously been delayed",
                        "quite obviously"
                    ],
                    "target_lang_definitions": {
                        "ru": "Так, что это легко увидеть, понять или распознать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "очевидно",
                                "target_lang_sense_clarification": "ясно для всех, не вызывает сомнений"
                            },
                            {
                                "target_lang_word": "явно",
                                "target_lang_sense_clarification": "заметно невооруженным глазом"
                            },
                            {
                                "target_lang_word": "заметно",
                                "target_lang_sense_clarification": "видимо для окружающих"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cd09882b-dad8-3cf7-9437-ea0b96bf7ba5",
                    "sense_definition": "Used as a filler word or to introduce information that the speaker assumes the listener might already know.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "filler",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You weren't to know, but I've spoken to, <w>obviously</w>, Jim about this already.",
                            "target_lang_translations": {
                                "ru": "Вы не могли знать, но я уже поговорил об этом, <w>разумеется</w>, с Джимом."
                            }
                        },
                        {
                            "text": "We need to consider the budget, <w>obviously</w>, before we make any final decisions.",
                            "target_lang_translations": {
                                "ru": "Нам нужно учесть бюджет, <w>конечно</w>, прежде чем принимать какие-либо окончательные решения."
                            }
                        }
                    ],
                    "synonyms": [
                        "apparently"
                    ],
                    "common_phrases": [
                        "obviously Jim about"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used as a conversational filler"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется как слово-филлер или для введения информации, которую слушатель, по мнению говорящего, уже может знать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разумеется",
                                "target_lang_sense_clarification": "само собой разумеется"
                            },
                            {
                                "target_lang_word": "конечно",
                                "target_lang_sense_clarification": "подтверждение общеизвестного факта"
                            },
                            {
                                "target_lang_word": "естественно",
                                "target_lang_sense_clarification": "логичное и ожидаемое дополнение"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}