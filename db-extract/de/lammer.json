                ],
                "senses": [
                    {
                        "sense_id": "93e9318c-aa9d-373c-829a-bf3967d09ace",
                        "entry_id": "57e39f83-fcda-3a2e-a779-83af85d93636",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d5fa6ca-e00a-4a1d-b68f-78deb143cdb6",
                                "sense_id": "93e9318c-aa9d-373c-829a-bf3967d09ace",
                                "text": "Frau Lammer ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "c6ee4e08-17ac-4fc9-9305-f5b17c7137cb",
                                "sense_id": "93e9318c-aa9d-373c-829a-bf3967d09ace",
                                "text": "Herr Lammer wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "b4149d55-c467-4a21-8dae-64825136bf34",
                                "sense_id": "93e9318c-aa9d-373c-829a-bf3967d09ace",
                                "text": "Die Lammers fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "32685c11-fd8e-4990-928b-1915169b0854",
                                "sense_id": "93e9318c-aa9d-373c-829a-bf3967d09ace",
                                "text": "Der Lammer trägt nie die Schals, die die Lammer ihm strickt."
                            },
                            {
                                "example_id": "69534214-dcb8-41bc-b703-d1972c28bf68",
                                "sense_id": "93e9318c-aa9d-373c-829a-bf3967d09ace",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Lammer kommt, geht der Herr Lammer.“"
                            },
                            {
                                "example_id": "bef0081b-af20-4cbe-a1b1-f808c06aea2b",
                                "sense_id": "93e9318c-aa9d-373c-829a-bf3967d09ace",
                                "text": "Lammer kommt und geht."
                            },
                            {
                                "example_id": "935e9418-6f03-48f4-af74-d072b9ce062d",
                                "sense_id": "93e9318c-aa9d-373c-829a-bf3967d09ace",
                                "text": "Lammers kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
