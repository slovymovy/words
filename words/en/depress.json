                                "nl": "Hoge rentestanden <w>drukken</w> vaak de consumentenbestedingen.",
                                "pl": "Wysokie stopy procentowe często <w>obniżają</w> wydatki konsumpcyjne.",
                                "de": "Hohe Zinsen <w>drücken</w> oft die Konsumausgaben.",
                                "fr": "Les taux d'intérêt élevés <w>font</w> souvent <w>baisser</w> les dépenses de consommation.",
                                "it": "Gli alti tassi di interesse spesso <w>riducono</w> la spesa dei consumatori.",
                                "cs": "Vysoké úrokové sazby často <w>snižují</w> spotřebitelské výdaje.",
                                "tr": "Yüksek faiz oranları genellikle tüketici harcamalarını <w>düşürür</w>.",
                                "es": "Las altas tasas de interés a menudo <w>reducen</w> el gasto del consumidor.",
                                "zh": "高利率往往会<w>抑制</w>消费支出。"
                            }
                        },
                        {
                            "text": "The surplus of goods <w>depressed</w> market prices.",
                            "target_lang_translations": {
                                "ru": "Избыток товаров <w>понизил</w> рыночные цены.",
                                "nl": "Het overschot aan goederen <w>drukte</w> de marktprijzen.",
                                "pl": "Nadwyżka towarów <w>obniżyła</w> ceny rynkowe.",
                                "de": "Das Überangebot an Waren <w>drückte</w> die Marktpreise.",
                                "fr": "L'excédent de marchandises a <w>fait baisser</w> les prix du marché.",
                                "it": "L'eccedenza di merci ha <w>fatto calare</w> i prezzi di mercato.",
                                "cs": "Přebytek zboží <w>stlačil</w> tržní ceny.",
                                "tr": "Mal fazlası piyasa fiyatlarını <w>düşürdü</w>.",
                                "es": "El excedente de bienes <w>redujo</w> los precios del mercado.",
                                "zh": "商品过剩<w>压低</w>了市场价格。"
                            }
                        }
