                        "entry_id": "553bc136-7d5d-3e73-836a-2a267a541f31",
                        "glosses": [
                            "Not disputable; not open to question; obviously true"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9fdc4787-4944-4107-b80f-94fd5e547911",
                                "sense_id": "0cba7a90-5bb2-3545-8a31-171a341ed8b5",
                                "text": "Nay, if he be of a proud humour, […] he will not Bate an Ace of abſolute certainty, but however doubtful or improbable the thing is, coming f[r]om him it muſt go for an indiſputable truth."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a0cf03d9-b0ae-4925-8f8f-6d4cc6f990ab",
                        "source_entry_id": "553bc136-7d5d-3e73-836a-2a267a541f31",
                        "source_sense_id": "0cba7a90-5bb2-3545-8a31-171a341ed8b5",
                        "source_sense_description": "not disputable",
                        "target_lang_word": "onomstotelijk",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "onomstotelijk",
                                "target_lang_code": "nl",
