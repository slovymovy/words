                "forms": [],
                "senses": [
                    {
                        "sense_id": "73498e84-676c-3ba0-aad9-1ce9c27369ec",
                        "entry_id": "149d6e62-6f6f-300a-af49-7666d59fea87",
                        "glosses": [
                            "een water helemaal leeg vissen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d521d1b8-b625-42af-a4e2-c12f2361fdb6",
                                "sense_id": "73498e84-676c-3ba0-aad9-1ce9c27369ec",
                                "text": "\"Dat ze de Koksvijver nu afvissen, is voor ons een kans om te zien wat de populatie is. Normaal halen we de kennis bij de vissers weg\", vertelt Post."
                            }
                        ]
                    },
                    {
                        "sense_id": "327d1ab4-2b3b-3c2a-bcfb-65427e4fc947",
                        "entry_id": "149d6e62-6f6f-300a-af49-7666d59fea87",
                        "glosses": [
                            "vissen in het algemeen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44e9a1cd-9ac1-4457-9d4e-31cbe5f002c3",
                                "sense_id": "327d1ab4-2b3b-3c2a-bcfb-65427e4fc947",
                                "text": "Gudrun, de drijvende kracht achter reisbureau De Vluchtende Visser, krijgt de vrije hand om een geschikte plek uit te zoeken met daarbij een snelle kajuitboot. Dat laatste is onmisbaar om goede stekken in een redelijk tempo te kunnen afvissen."
                            }
                        ]
                    }
