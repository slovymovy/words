                "senses": [
                    {
                        "sense_id": "102a69f4-913a-378d-8a6d-e57ca453115f",
                        "entry_id": "73f067ad-ab0d-3bf1-824d-24a360548d07",
                        "glosses": [
                            "incompleet, uit onsamenhangende brokstukken bestaand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47ea7555-3ec1-44ae-819b-2d7df0af6b3f",
                                "sense_id": "102a69f4-913a-378d-8a6d-e57ca453115f",
                                "text": "„De informatie erover is fragmentarisch. Ik heb een overzicht gevonden van de Universiteit Leiden, van 1865 tot 1872. De meeste lichamen, 67, waren van overledenen uit het academisch ziekenhuis en andere ziekenhuizen in de buurt. Maar er kwamen in die periode ook 22 lichamen uit gevangenissen. En de gevangenis-arts in Woerden heeft het over 1 tot 12 lichamen per jaar.”"
                            },
                            {
                                "example_id": "12b24755-1f5e-48bd-86d6-c370d55ecc79",
                                "sense_id": "102a69f4-913a-378d-8a6d-e57ca453115f",
                                "text": "Al zit dit grimmigere Left, alone vol originele vondsten, het is te bescheiden en fragmentarisch."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
