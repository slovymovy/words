        "nl-extract.jsonl": [
            {
                "entry_id": "d9095eee-88e4-3045-8795-a0fe753529c3",
                "word": "peinzend",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "9c0f3397-ce92-3558-8f75-9644c722ee09",
                        "entry_id": "d9095eee-88e4-3045-8795-a0fe753529c3",
                        "glosses": [
                            "diep en serieus nadenkend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d134edaa-8b97-4180-9789-00fdee85632f",
                                "sense_id": "9c0f3397-ce92-3558-8f75-9644c722ee09",
                                "text": "Tegenover de bar, op een belicht schilderij aan de muur, de meewarig peinzende blik van haar vader; Harm oet Riessen. De komiek heeft met de plaatselijke revue grote triomfen gevierd in het Parkgebouw. \"De mensen vinden dat hij hier moet hangen.\" Harms dochter is het daar mee eens."
                            },
                            {
                                "example_id": "7f2a62a2-ce3b-4ed4-99dd-6d11d6251178",
                                "sense_id": "9c0f3397-ce92-3558-8f75-9644c722ee09",
                                "text": "Peinzende kinderhoofden sierden gisteren wijkgebouw De Brake tijdens de schoolschaakkampioenschappen van de gemeente Hellendoorn."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0c9d5adc-78bf-4ebe-8b87-5004e3586093",
                        "source_entry_id": "d9095eee-88e4-3045-8795-a0fe753529c3",
                        "source_sense_id": "9c0f3397-ce92-3558-8f75-9644c722ee09",
                        "source_sense_description": "diep en serieus nadenkend",
                        "target_lang_word": "absorbed in thought",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "ac171c1b-54c1-4986-9dcb-9f535af32232",
                        "source_entry_id": "d9095eee-88e4-3045-8795-a0fe753529c3",
                        "source_sense_id": "9c0f3397-ce92-3558-8f75-9644c722ee09",
                        "source_sense_description": "diep en serieus nadenkend",
                        "target_lang_word": "day-dreaming",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "d0c8f7cf-5b85-4504-b94d-974c7bdc41f1",
                        "source_entry_id": "d9095eee-88e4-3045-8795-a0fe753529c3",
                        "source_sense_id": "9c0f3397-ce92-3558-8f75-9644c722ee09",
                        "source_sense_description": "diep en serieus nadenkend",
                        "target_lang_word": "thoughtful",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "thoughtful",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "70e6bf9f-e5bf-3c59-b5f5-a68cc54bc685",
                                        "entry_id": "abd1fd48-c2f7-3966-8ccc-cbe37aa9d409",
                                        "glosses": [
                                            "Demonstrating thought or careful consideration."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ddf3dce0-aead-436f-beca-1f26c15b0f33",
                                                "sense_id": "70e6bf9f-e5bf-3c59-b5f5-a68cc54bc685",
                                                "text": "Most thoughtful people eventually solve the puzzle."
                                            },
                                            {
                                                "example_id": "ccd4471a-f88c-4800-afec-491fe4899d42",
                                                "sense_id": "70e6bf9f-e5bf-3c59-b5f5-a68cc54bc685",
                                                "text": "Now the New Year reviving old Desires,\nThe thoughtful Soul to Solitude retires,\nWhere the White Hand of Moses on the Bough\nPuts out, and Jesus from the Ground suspires."
                                            },
                                            {
                                                "example_id": "9b9a0b42-3fee-46e4-90fe-13b3f0949f21",
                                                "sense_id": "70e6bf9f-e5bf-3c59-b5f5-a68cc54bc685",
                                                "text": "But Richmond, his grandfather's darling, after one thoughtful glance cast under his lashes at that uncompromising countenance appeared to lose himself in his own reflections."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d3533ea-a156-3faf-bcb1-c6e9cf3a18cd",
                                        "entry_id": "abd1fd48-c2f7-3966-8ccc-cbe37aa9d409",
                                        "glosses": [
                                            "Demonstrating kindness or consideration for others."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51ff19ae-7a1d-47f1-9d28-9695266dc78f",
                                                "sense_id": "6d3533ea-a156-3faf-bcb1-c6e9cf3a18cd",
                                                "text": "Preparing dinner is a thoughtful gesture for a new mother."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
