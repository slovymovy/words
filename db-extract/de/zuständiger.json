                    {
                        "sense_id": "c320f84a-c6e5-3cd3-a007-9bd827fbd1aa",
                        "entry_id": "f87fd2c1-cf02-3932-83af-7e0f47d423f7",
                        "glosses": [
                            "eine Person, die verantwortlich ist; ein Beauftragter"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d219f74-20b7-4972-9e1a-fde9ff046af6",
                                "sense_id": "c320f84a-c6e5-3cd3-a007-9bd827fbd1aa",
                                "text": "Der Zuständige hat sich verdrückt, als das Gebäude am Einstürzen war."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8b7c8d93-06f2-4b72-a8a0-de7d4d718ebd",
                        "source_entry_id": "f87fd2c1-cf02-3932-83af-7e0f47d423f7",
                        "source_sense_id": "c320f84a-c6e5-3cd3-a007-9bd827fbd1aa",
                        "source_sense_description": "eine Person, die verantwortlich ist; ein Beauftragter",
                        "target_lang_word": "ответственный",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ответственный",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "00026464-dea1-3295-bdd7-6c7f17cb6a8b",
                                        "entry_id": "6b8f7883-d5a6-3fbc-96d3-fe69599bc721",
                                        "glosses": [
                                            "с предл. за + вин. п. обязанный отвечать, обычно — за свои действия или их последствия, несущий ответственность за что-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f11f9940-b184-4505-8e06-484b716c13e6",
                                                "sense_id": "00026464-dea1-3295-bdd7-6c7f17cb6a8b",
                                                "text": "Назначен ответственный за организацию мероприятия."
                                            },
                                            {
                                                "example_id": "3aecf90d-5a05-4537-b419-7b608a3e50a5",
                                                "sense_id": "00026464-dea1-3295-bdd7-6c7f17cb6a8b",
                                                "text": "Он ответственный за исполнение ваших поручений."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "10bbe060-7031-3bad-9dad-83a609df5e5e",
                                        "entry_id": "6b8f7883-d5a6-3fbc-96d3-fe69599bc721",
                                        "glosses": [
                                            "с предл. перед + тв. п. подотчётный кому-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32e2c4b9-72ad-455e-93f0-da783e3c4a9f",
                                                "sense_id": "10bbe060-7031-3bad-9dad-83a609df5e5e",
                                                "text": "Ответственный перед избирателями депутат громко выступает в заводском доме культуры."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85faefbb-77d2-3166-aa53-a79954c77dd8",
                                        "entry_id": "6b8f7883-d5a6-3fbc-96d3-fe69599bc721",
                                        "glosses": [
                                            "высокопоставленный, облечённый значительными правами и обязанностями"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e95f1882-94a8-4eb4-8399-46c75301bd48",
                                                "sense_id": "85faefbb-77d2-3166-aa53-a79954c77dd8",
                                                "text": "Ответственная сотрудница из обкома комсомола поднялась на этаж."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dabb185c-2af8-3f71-94ae-2c7e3fc43b92",
                                        "entry_id": "6b8f7883-d5a6-3fbc-96d3-fe69599bc721",
                                        "glosses": [
                                            "добросовестный, имеющий развитое чувство долга, ревниво относящийся к своим обязанностям"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "561bea81-d4b4-44bf-b7f8-4d25495ed390",
                                                "sense_id": "dabb185c-2af8-3f71-94ae-2c7e3fc43b92",
                                                "text": "На него можешь полностью положиться: он очень ответственный."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "086db382-0922-3d9d-b59a-443d25014506",
                                        "entry_id": "6b8f7883-d5a6-3fbc-96d3-fe69599bc721",
                                        "glosses": [
                                            "очень важный, имеющий решающее значение"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fce1d8d6-95d9-4cbd-86ea-128945101f40",
                                                "sense_id": "086db382-0922-3d9d-b59a-443d25014506",
                                                "text": "В переговорах наступил самый ответственный момент."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
