                            }
                        },
                        {
                            "text": "The team showed <w>indomitable</w> courage despite falling behind early in the match.",
                            "target_lang_translations": {
                                "tr": "Takım, maçın başlarında geriye düşmesine rağmen <w>sarsılmaz</w> bir cesaret gösterdi."
