                        "examples": [
                            {
                                "example_id": "2057d6b0-5314-4944-9d62-c333aa1ba1b0",
                                "sense_id": "664f9b96-f501-3051-97b4-5aa120af365a",
                                "text": "Volgens de Wit-Russische Diaspora en solidariteitsorganisatie Bysol gebruikt bandenmaker Vredestein staaldraad van dit staatsbedrijf. Een woordvoerder van Vredestein wil ontkennen noch bevestigen dat het producten afneemt van BMZ en wil ook niet zeggen wat het bedrijf van de oproep vindt. \"We gaan hier helemaal geen commentaar op geven.\""
                            },
                            {
                                "example_id": "c9fc5d0c-df5c-4262-b061-784192cc7ad8",
                                "sense_id": "664f9b96-f501-3051-97b4-5aa120af365a",
                                "text": "Operationeel directeur Thierry Bolloré van Renault, die Ghosns taken al waarnam, volgt hem op als ceo. Jean-Dominique Senard, die binnenkort vertrekt bij bandenmaker Michelin, is door de raad van bestuur verkozen tot voorzitter."
                            },
                            {
                                "example_id": "0c7f32ca-ab44-4ab6-8f6c-bfd455f15d36",
                                "sense_id": "664f9b96-f501-3051-97b4-5aa120af365a",
                                "text": "François Michelin, de man die van zijn bedrijf een van de grootste bandenmakers ter wereld maakte, is op 88-jarige leeftijd overleden."
                            }
                        ]
