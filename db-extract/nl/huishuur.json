                                            {
                                                "example_id": "bd668d97-dc30-4709-bf3a-2826efa2c561",
                                                "sense_id": "d4510985-66ea-3f71-9e21-8731ee5b8b7f",
                                                "text": "[O]ne streak of copper-coloured light made a narrow rent between sea and sky."
                                            },
                                            {
                                                "example_id": "608a4261-731e-4991-9522-4c1a41bdc394",
                                                "sense_id": "d4510985-66ea-3f71-9e21-8731ee5b8b7f",
                                                "text": "The brown paint on the door was so old that the naked wood showed between the rents."
                                            },
                                            {
                                                "example_id": "23b2d829-7cdf-4b22-ac98-d7d8c7de315d",
                                                "sense_id": "d4510985-66ea-3f71-9e21-8731ee5b8b7f",
                                                "text": "The oscillations were getting so severe that painters on the bridge learned to tie down their tins before a train passed. They found holes and rents in the iron but never reported them as they were never asked, and it wasn't their job. These were deferential times, and few wanted to talk out of turn."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "597761df-cdd8-39e5-a33a-5379779bb53a",
                                        "entry_id": "5fccf090-eb5c-39d8-acca-23896d60233b",
                                        "glosses": [
                                            "A division or schism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f835cd8-bef1-4c74-a309-54811697f3a4",
                                                "sense_id": "597761df-cdd8-39e5-a33a-5379779bb53a",
                                                "text": "[T]he White House was considering sending Vice President Humphrey to Cairo to patch up the many rents in U.S.—Egyptian relations."
                                            }
                                        ]
                                    }
                                ]
                            },
