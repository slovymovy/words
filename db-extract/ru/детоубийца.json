                                                "sense_id": "a7434591-1853-3d76-870f-fc4e4b132124",
                                                "text": "Ned is running, panicked, […] running for the cold hard road and the sanctuary of the Brunch farm like a filicide caught in the act."
                                            }
                                        ]
                                    }
                                ]
                            }
