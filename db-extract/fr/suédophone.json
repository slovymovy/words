                ],
                "translations": [
                    {
                        "translation_id": "cfc7e043-a41a-4d3a-b5e2-e8dc641c43f8",
                        "source_entry_id": "4c503a7d-6488-3a08-a250-68dc790eb238",
                        "target_lang_word": "Swedophone",
