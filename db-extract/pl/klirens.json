                                        "entry_id": "3c4d9541-90b1-38e7-9381-3fb0a2730b1d",
                                        "glosses": [
                                            "The act of kicking a ball away from the goal one is defending."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
