                        ]
                    },
                    {
                        "translation_id": "3aecfe28-4756-44a4-b55e-480f205d39a6",
                        "source_entry_id": "23c8d069-fe04-3ef5-8add-2ae386212fd8",
                        "source_sense_id": "381cfebc-ec72-3f12-a4bc-26315d381c6d",
                        "target_lang_word": "xiphoid process",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "xiphoid process",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4fd2c584-9725-36dd-bbfc-227bccfc9079",
                                        "entry_id": "9035c1e1-2e40-3438-921d-ec414fec09bf",
                                        "glosses": [
                                            "The small cartilaginous extension to the lower part of the sternum, usually ossified in the adult human."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "505ebc4c-a522-4910-bada-83cae4539d4f",
                                                "sense_id": "4fd2c584-9725-36dd-bbfc-227bccfc9079",
                                                "text": "The adult sternum is comprised of three main parts—the manubrium, sternal body, and xiphoid process. The manubrium (fig. 7.2a) is the thickest, most superior part of the sternum, while the xiphoid process is variable in appearance and forms the inferior terminus of the sternum."
                                            },
                                            {
                                                "example_id": "bd6077e3-a969-4c77-91ba-8a3629297130",
                                                "sense_id": "4fd2c584-9725-36dd-bbfc-227bccfc9079",
                                                "text": "In chondrosternal prominence where there is angulation at the sternoxiphoidal junction, the xiphoid process is detached and a 2 to 3 cm length of the lower sternum is resected."
                                            },
                                            {
                                                "example_id": "1af51a57-cbc7-4298-b027-d63648e0f146",
                                                "sense_id": "4fd2c584-9725-36dd-bbfc-227bccfc9079",
                                                "text": "This is a constellation of symptoms, including severe intermittent anterior chest wall pain in the region of the xiphoid process, made worse with overeating, stooping, and bending (Figures 103-2 and 103-3)"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
