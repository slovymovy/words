                                    {
                                        "sense_id": "876a0762-347d-3a34-80fc-99f2c61b5dfc",
                                        "entry_id": "e55ff5c3-971a-3b8c-b021-7e6c3923ee77",
                                        "glosses": [
                                            "Sportart, bei der ein Ball mit der Hand in das gegnerische Tor geworfen werden muss"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ab14565-c599-4e66-8324-4a048cf7f173",
                                                "sense_id": "876a0762-347d-3a34-80fc-99f2c61b5dfc",
                                                "text": "Neben Fußball wird in unserem Verein auch Handball gespielt."
                                            },
                                            {
                                                "example_id": "baf51012-12a5-44ea-a382-6e9080a5cb60",
                                                "sense_id": "876a0762-347d-3a34-80fc-99f2c61b5dfc",
                                                "text": "Die Zuschauer mögen beim Handball das hohe Tempo sehr."
                                            },
                                            {
                                                "example_id": "b9d97084-11a7-43ce-82dd-0e6ce8c8fd4b",
                                                "sense_id": "876a0762-347d-3a34-80fc-99f2c61b5dfc",
                                                "text": "„Handball und Basketball spielen in Island eine viel größere Rolle.“"
                                            },
                                            {
                                                "example_id": "77051785-8fc3-4dd2-a771-ee3e11f9bff8",
                                                "sense_id": "876a0762-347d-3a34-80fc-99f2c61b5dfc",
                                                "text": "„Nachdem Melanie gegangen war und er ihr versprochen hatte, dass sie sich heute Abend beim Handball sehen würden, fand Andreas seine Mutter im Wohnzimmer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
