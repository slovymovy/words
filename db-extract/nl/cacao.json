                    {
                        "translation_id": "4ea9eeaf-af56-4c2e-b8ee-11a11dc464e9",
                        "source_entry_id": "4b2c2563-7223-3f13-a14b-c79386baea8a",
                        "source_sense_id": "1bb675f1-0c7b-3a59-8bcb-db46fcf73419",
