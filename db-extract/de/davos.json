                                "sense_id": "95ab4780-518f-3c66-93cb-0c4f9c17dad3",
                                "text": "Thomas Mann machte Davos mit seinem Roman Der Zauberberg auch in der deutschsprachigen Welt berühmt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "864b58ac-4b3a-3994-8129-5f93e580972b",
                        "entry_id": "31ab28d8-cf8e-3bc8-9494-dcbb55169310",
