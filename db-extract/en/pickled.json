                        ]
                    },
                    {
                        "translation_id": "fe67f9f3-25c2-4c34-be64-204f5aab9566",
                        "source_entry_id": "1d727c8f-8953-3433-b099-56eb46b421ea",
                        "source_sense_description": "preserved by pickling",
                        "target_lang_word": "солёный",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "солёный",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "855a450a-7dc8-3186-89e8-cd24472b6cc1",
                                        "entry_id": "d3643a75-f3d8-3cd2-85f6-879646ef0ad6",
                                        "glosses": [
                                            "пропитанный солью"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a425fc9f-05ca-48cb-8be8-04a75ba70c10",
                                                "sense_id": "855a450a-7dc8-3186-89e8-cd24472b6cc1",
                                                "text": "Зоя поднялась на верхнюю палубу к рубке радиотелеграфа. Прищурясь, вдохнула солёный воздух."
                                            },
                                            {
                                                "example_id": "3ee14be2-3161-47ee-971b-a2761152fb47",
                                                "sense_id": "855a450a-7dc8-3186-89e8-cd24472b6cc1",
                                                "text": "И пока ты спал, женщины стирали твою солёную от пота рубаху и тихо, чтоб не разбудить тебя, грустно пели."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f79bc125-3bb6-306c-b5ae-30ffdfc90428",
                                        "entry_id": "d3643a75-f3d8-3cd2-85f6-879646ef0ad6",
                                        "glosses": [
                                            "содержащий соль и имеющий придаваемый ею характерный вкус; состоящий из насыщенной солью воды"
                                        ],
                                        "tags": [
                                            "о влаге, водоёмах"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b3e75215-62e2-4717-ac58-4377bd072943",
                                                "sense_id": "f79bc125-3bb6-306c-b5ae-30ffdfc90428",
                                                "text": "В удачные годы из солёных озёр Ахиолу можно получить от 150 тысяч до 200 тысяч кило соли .."
                                            },
                                            {
                                                "example_id": "250610ff-f90d-44b4-be75-149ee5306a33",
                                                "sense_id": "f79bc125-3bb6-306c-b5ae-30ffdfc90428",
                                                "text": "Маргарита ощутила солёный вкус на губах и поняла, что её моют кровью."
                                            },
                                            {
                                                "example_id": "9165bd09-4cd9-4926-85f1-2ce89905d7e2",
                                                "sense_id": "f79bc125-3bb6-306c-b5ae-30ffdfc90428",
                                                "text": "Почему в море вода солёная?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2872af00-605d-3245-aa90-6450077377f4",
                                        "entry_id": "d3643a75-f3d8-3cd2-85f6-879646ef0ad6",
                                        "glosses": [
                                            "приправленный солью и имеющий придаваемый ею характерный вкус"
                                        ],
                                        "tags": [
                                            "о пище"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a6f69090-76d6-40a4-88f3-f78f8d7d6e1e",
                                                "sense_id": "2872af00-605d-3245-aa90-6450077377f4",
                                                "text": "Ел много, торопливо, морщился, точно пища была слишком солона, кисла или горька, хотя глухая Фелициата готовила очень вкусно."
                                            },
                                            {
                                                "example_id": "d5b56926-a71f-4baf-9cfe-39adc51020b6",
                                                "sense_id": "2872af00-605d-3245-aa90-6450077377f4",
                                                "text": "Колбаса очень солёная, твёрдая, но всё равно вкусная-превкусная."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e751f2b4-6183-386d-9e09-65a643a40da4",
                                        "entry_id": "d3643a75-f3d8-3cd2-85f6-879646ef0ad6",
                                        "glosses": [
                                            "приготовленный впрок с солью, в растворе соли"
                                        ],
                                        "tags": [
                                            "только полная форма",
                                            "о пище"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "05ed73fb-a48b-409c-95c5-b7a83a2c1412",
                                                "sense_id": "e751f2b4-6183-386d-9e09-65a643a40da4",
                                                "text": "К жарко́му поданы были сырые и солёные огурцы, солёные лимоны, изрезанные в куски и сложенные в пирамиды, солёные сливы и кислое молоко."
                                            },
                                            {
                                                "example_id": "98c84f06-7f85-4165-9700-99335a11090c",
                                                "sense_id": "e751f2b4-6183-386d-9e09-65a643a40da4",
                                                "text": "— Ну да, свиное. Солёное сало, кусковое — словом сказать. Добрая вещь, сытная, кто толк понимает."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "09d0237d-2a4a-3e73-b410-8711a2d0e1e4",
                                        "entry_id": "d3643a75-f3d8-3cd2-85f6-879646ef0ad6",
                                        "glosses": [
                                            "перен., разг., : остроумный, выразительный, но при этом колкий, грубый, непристойный"
                                        ],
                                        "tags": [
                                            "о словах, выражениях и т. п."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9fc8645-bb26-44f0-a8ac-81f4994ab1db",
                                                "sense_id": "09d0237d-2a4a-3e73-b410-8711a2d0e1e4",
                                                "text": "Конечно, дело не в том, что мои собеседники соблюдали деликатность, приличествующую месту их работы, — при случае и тот и другой позволяли себе и солёные шутки, и вполне университетские выражения."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e3613d4-ac64-39f0-b63c-3539a4b9182d",
                                        "entry_id": "d3643a75-f3d8-3cd2-85f6-879646ef0ad6",
                                        "glosses": [
                                            "разг. требующий большого труда и напряжения, изнурительный, тяжёлый"
                                        ],
                                        "tags": [
                                            "только краткая форма"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1e811b1b-2765-497a-b48e-13bf55aef623",
                                                "sense_id": "7e3613d4-ac64-39f0-b63c-3539a4b9182d",
                                                "text": "Солона эта проклятущая работа, а всё ж таки надо взяться, потому что этак-то, не ровён час, и с голоду подохнешь."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d4c2765a-e92b-3fa0-96bd-4f193dbf0184",
                                        "entry_id": "d3643a75-f3d8-3cd2-85f6-879646ef0ad6",
                                        "glosses": [
                                            "разг. доставляющий много неприятностей, причиняющий горе"
                                        ],
                                        "tags": [
                                            "только краткая форма"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c344244-6385-47a8-a634-b25cba561f76",
                                                "sense_id": "d4c2765a-e92b-3fa0-96bd-4f193dbf0184",
                                                "text": "Солона пришлась ему жена, красавица ненаглядная; ни днём, ни ночью покоя не знай, всё ей угождай."
                                            },
                                            {
                                                "example_id": "20678e4c-50e5-491f-857a-7fcdd1138d42",
                                                "sense_id": "d4c2765a-e92b-3fa0-96bd-4f193dbf0184",
                                                "text": "И она тоже рада была видеть Ваську наказанным судьбой; он и ей солон был, обращаясь с нею не как служащий, а скорее как начальник с подчинённой."
                                            },
                                            {
                                                "example_id": "f153a8a8-ba24-4972-b278-f8d917ae23c1",
                                                "sense_id": "d4c2765a-e92b-3fa0-96bd-4f193dbf0184",
                                                "text": "Но сейчас уж слишком солона стала ей жизнь в корпусе: рада хоть в ад, да — лишь бы отсюда."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c5d60252-f36b-3b01-bc8f-6c7affe37535",
                                        "entry_id": "d3643a75-f3d8-3cd2-85f6-879646ef0ad6",
                                        "glosses": [
                                            "диал. подлежащий засолке, годный для неё"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69499abd-0437-4e9f-91d5-db3f63dbf8a8",
                                                "sense_id": "c5d60252-f36b-3b01-bc8f-6c7affe37535",
                                                "text": "Пойти в лес по солёные грибы."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
