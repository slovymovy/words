                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "7c80bdb8-1ea3-464a-831f-ed72ba9e0e11",
                                "sense_id": "a9904922-bd57-337d-91b0-12e61baf9bbf",
                                "text": "They invited him to come to-morrow, […] and bring half a quid with him."
                            }
                        ]
                    },
                    {
                        "sense_id": "fd8e6d90-6b2d-3625-b911-42ee95f456d3",
                        "entry_id": "b1c86d2e-edd4-3464-8593-cece629bb8bd",
                        "glosses": [
                            "Pound sterling. (usually only used with a whole number of pounds)"
                        ],
                        "tags": [
                            "UK",
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "8a897af6-3981-4260-9c54-0c94a5420232",
                                "sense_id": "fd8e6d90-6b2d-3625-b911-42ee95f456d3",
                                "text": "Seven quid for a toastie? You're joking, aren't you?!"
                            },
                            {
                                "example_id": "db4c9a25-ca87-468b-8928-95316e656389",
                                "sense_id": "fd8e6d90-6b2d-3625-b911-42ee95f456d3",
                                "text": "Forty quid a fuckin ticket. No shy they British Rail cunts, ah kin fuckin tell ye."
                            },
                            {
                                "example_id": "116af05e-190d-4926-aa1d-fbe2ca25a035",
                                "sense_id": "fd8e6d90-6b2d-3625-b911-42ee95f456d3",
                                "text": "The ride costs exactly fifteen quid, but that doesn't include the tip, and bitter is two pounds a pint."
                            },
                            {
                                "example_id": "39659bcf-f63a-4d0a-904e-2c5e544f34bb",
                                "sense_id": "fd8e6d90-6b2d-3625-b911-42ee95f456d3",
                                "text": "When I worked in a toyshop, I once bought the manageress a sandwich. Do I still work there? No. Our relationship is, therefore, over. Has she given me the quid back? No."
                            }
                        ]
                    },
