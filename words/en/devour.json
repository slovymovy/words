{
    "word_family": [
        "voracious",
        "voracity"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cf663b21-a3c4-3f99-9e6f-cd21700bb530",
                    "sense_definition": "To eat quickly, greedily, hungrily, or ravenously.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "eating",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hungry dog <w>devoured</w> the food in seconds.",
                            "target_lang_translations": {
                                "de": "Der hungrige Hund <w>verschlang</w> das Futter in Sekunden."
                            }
                        },
                        {
                            "text": "He <w>devoured</w> his meal after a long day of hiking.",
                            "target_lang_translations": {
                                "de": "Er <w>verschlang</w> seine Mahlzeit nach einem langen Wandertag."
                            }
                        }
                    ],
                    "synonyms": [
                        "gobble",
                        "gorge",
                        "wolf#Verb"
                    ],
                    "common_phrases": [
                        "devour food"
                    ],
                    "target_lang_definitions": {
                        "de": "Etwas sehr schnell, gierig oder hungrig essen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "verschlingen",
                                "target_lang_sense_clarification": "gierig oder hastig essen"
                            },
                            {
                                "target_lang_word": "herunterschlingen",
                                "target_lang_sense_clarification": "sehr schnell und ohne zu kauen essen"
                            },
                            {
                                "target_lang_word": "fressen",
                                "target_lang_sense_clarification": "gierig essen (oft bei Tieren oder abwertend bei Menschen)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4029cfb7-f1c6-3bc0-8e4b-8dd49050fd35",
                    "sense_definition": "To take in avidly with the intellect or with one's gaze.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "intellectual_consumption",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>devoured</w> the book in a single afternoon.",
                            "target_lang_translations": {
                                "de": "Sie <w>verschlang</w> das Buch an einem einzigen Nachmittag."
                            }
                        },
                        {
                            "text": "The student <w>devoured</w> every article on the subject.",
                            "target_lang_translations": {
                                "de": "Der Student <w>verschlang</w> jeden Artikel zu diesem Thema."
                            }
                        }
                    ],
                    "synonyms": [
                        "consume"
                    ],
                    "common_phrases": [
                        "devour books"
                    ],
                    "target_lang_definitions": {
                        "de": "Etwas mit großem Interesse oder Begeisterung aufnehmen, besonders beim Lesen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "verschlingen",
                                "target_lang_sense_clarification": "mit großer Begeisterung lesen oder aufnehmen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8b89d120-7a75-3452-8604-7a44e2c4ad06",
                    "sense_definition": "To rapidly destroy, engulf, or lay waste.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "destruction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The forest fire <w>devoured</w> everything in its path.",
                            "target_lang_translations": {
                                "de": "Das Waldfeuer <w>verschlang</w> alles auf seinem Weg."
                            }
                        },
                        {
                            "text": "Flames <w>devoured</w> the old wooden house quickly.",
                            "target_lang_translations": {
                                "de": "Flammen <w>verschlangen</w> das alte Holzhaus schnell."
                            }
                        }
                    ],
                    "synonyms": [
                        "devastate"
                    ],
                    "common_phrases": [
                        "fire devours"
                    ],
                    "target_lang_definitions": {
                        "de": "Etwas schnell und vollständig zerstören oder vernichten."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "verschlingen",
                                "target_lang_sense_clarification": "bildlich für das Aufsaugen oder Zerstören durch Naturgewalten"
                            },
                            {
                                "target_lang_word": "vernichten",
                                "target_lang_sense_clarification": "vollständig zerstören"
                            },
                            {
                                "target_lang_word": "zerstören",
                                "target_lang_sense_clarification": "kaputt machen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ba87b028-77a8-3f5d-a0fc-b338f4267b45",
                    "sense_definition": "To absorb or engross the mind fully, especially in a destructive manner.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "emotional_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was <w>devoured</w> by jealousy after hearing the news.",
                            "target_lang_translations": {
                                "de": "Er war nach den Nachrichten von Eifersucht <w>zerfressen</w>."
                            }
                        },
                        {
                            "text": "She was <w>devoured</w> by grief following the tragic accident.",
                            "target_lang_translations": {
                                "de": "Sie war nach dem tragischen Unfall von Trauer <w>überwältigt</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "overwhelm"
                    ],
                    "target_lang_definitions": {
                        "de": "Von einem starken, negativen Gefühl völlig beherrscht oder überwältigt werden."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "eingenommen sein von",
                                "target_lang_sense_clarification": "von einem Gefühl völlig in Anspruch genommen werden"
                            },
                            {
                                "target_lang_word": "besessen sein von",
                                "target_lang_sense_clarification": "von einem Gedanken oder Gefühl beherrscht werden"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "008273b5-5d93-323a-b4d3-d008bab6bf4a",
                    "sense_definition": "To be very good at something; to excel.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "excellence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The performer <w>devoured</w> the stage with her incredible energy.",
                            "target_lang_translations": {
                                "de": "Die Künstlerin <w>dominierte</w> die Bühne mit ihrer unglaublichen Energie."
                            }
                        },
                        {
                            "text": "She <w>devoured</w> the competition in the final round.",
                            "target_lang_translations": {
                                "de": "Sie <w>überragte</w> die Konkurrenz in der letzten Runde."
                            }
                        }
                    ],
                    "synonyms": [
                        "slay",
                        "excel",
                        "shine"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Used in modern internet culture."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "In einer Situation oder einem Wettbewerb überragend sein und andere dominieren."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "dominieren",
                                "target_lang_sense_clarification": "die Kontrolle haben oder überlegen sein"
                            },
                            {
                                "target_lang_word": "überragen",
                                "target_lang_sense_clarification": "deutlich besser sein als andere"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}