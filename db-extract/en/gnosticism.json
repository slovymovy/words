                    {
                        "translation_id": "a0a952e0-e1c1-4ed3-a439-2ffb6774940f",
                        "source_entry_id": "5464c113-dcad-3f41-8a9f-d718e2836347",
                        "source_sense_id": "212791a1-dc87-3f98-899f-55be41557401",
