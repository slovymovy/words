                                        "entry_id": "fd26b318-3d34-3374-a61f-4dd40f32ace6",
                                        "glosses": [
                                            "einsitziges Polstermöbelstück, bestens geeignet zum Fernsehen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "773e05f8-e92e-4620-b035-9ec1fd8e42ac",
                                                "sense_id": "b54f69c2-6129-3277-a509-47a337063ca9",
