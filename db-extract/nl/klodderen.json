        "ru-extract.jsonl": [],
        "nl-extract.jsonl": [
            {
                "entry_id": "06e32665-6223-3b5e-82e5-55e71be85ebf",
                "word": "klodderen",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "6aa3b7a0-2a99-3fcc-b5f9-8ceeb482a1e3",
                        "entry_id": "06e32665-6223-3b5e-82e5-55e71be85ebf",
                        "glosses": [
                            "ruw neersmijten van half vloeibare smerigheden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "adcdb4fb-65a7-4be2-a7c7-f41b5ad8d3b5",
                                "sense_id": "6aa3b7a0-2a99-3fcc-b5f9-8ceeb482a1e3",
                                "text": "Verder ben jij mijn ‘beschermer’ en ik de ‘beschermeling’ van de nederlandsche kunstcritici, zoodat ik vuiligheden mag klodderen in Gr. Ned. en wij zijn allemaal communisten - wschl. binnenkort ook homosexueelen, net als Vestdijk!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "87730e3e-ac49-42a9-bd2b-12cd0e41aeef",
                        "source_entry_id": "06e32665-6223-3b5e-82e5-55e71be85ebf",
                        "source_sense_id": "6aa3b7a0-2a99-3fcc-b5f9-8ceeb482a1e3",
                        "source_sense_description": "ruw neersmijten van half vloeibare smerigheden",
                        "target_lang_word": "make blots",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "aac1a1ca-40d7-4c0b-a9ae-e68f27302e04",
                        "source_entry_id": "06e32665-6223-3b5e-82e5-55e71be85ebf",
                        "source_sense_id": "6aa3b7a0-2a99-3fcc-b5f9-8ceeb482a1e3",
                        "source_sense_description": "ruw neersmijten van half vloeibare smerigheden",
                        "target_lang_word": "blot",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "blot",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "75b05e67-01ad-367e-a0aa-895c5972ae78",
                                        "entry_id": "29bd00f9-ec86-3ac7-b5a9-c6c9bcc4def7",
                                        "glosses": [
                                            "A blemish, spot or stain made by a coloured substance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b4c712a-df52-431f-8bb9-2da1a7562672",
                                                "sense_id": "75b05e67-01ad-367e-a0aa-895c5972ae78",
                                                "text": "England bound in with the triumphant ſea, / Whoſe rocky ſhore beates backe the enuious ſiedge / Of watery Neptune, is now bound in with ſhame, / With Inky blottes, and rotten Parchment bonds."
                                            },
                                            {
                                                "example_id": "d4e69ad1-a08b-4926-958c-ba9a384b613a",
                                                "sense_id": "75b05e67-01ad-367e-a0aa-895c5972ae78",
                                                "text": "When I and some others subscribed our names / To a plot for expelling my master king James [James II of England]; / I withdrew my subscription by help of a blot, / And so might discover or gain by the plot: […]"
                                            },
                                            {
                                                "example_id": "4721b39c-d06e-408f-a7d7-0e7e2a17bac2",
                                                "sense_id": "75b05e67-01ad-367e-a0aa-895c5972ae78",
                                                "text": "Her utmost powers of expression (which were certainly not great in ink) were exhausted in the attempt to write what she felt on the subject of my journey. Four sides of incoherent and interjectional beginnings of sentences, that had no end, except blots, were inadequate to afford her any relief. But the blots were more expressive to me than the best composition; for they showed me that Peggotty had been crying all over the paper, and what could I have desired more?"
                                            },
                                            {
                                                "example_id": "2f91c10e-4de5-4b69-8cb9-409ef65e52fa",
                                                "sense_id": "75b05e67-01ad-367e-a0aa-895c5972ae78",
                                                "text": "[…] He was blind; he could not see the stars\nGlinting among the wraiths of wandering cloud;\nQueer blots of colour, purple, scarlet, green,\nFlickered and faded in his drowning eyes."
                                            },
                                            {
                                                "example_id": "885139f2-b826-4b40-b1fa-1f27349af332",
                                                "sense_id": "75b05e67-01ad-367e-a0aa-895c5972ae78",
                                                "text": "But, like more than one similar North Wales beauty-spot, there had to be (at least at the time of which I write), a quarry, or ironworks, or some kind of industrial plant, which lay perpetually under a cloud of yellowish smoke—literally a blot on the landscape."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ef754b2-82e7-3334-a5ab-b24f18bd6a96",
                                        "entry_id": "29bd00f9-ec86-3ac7-b5a9-c6c9bcc4def7",
                                        "glosses": [
                                            "A stain on someone's reputation or character; a disgrace."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aefa64e6-4bdc-4653-b43e-e1ccacb1cec6",
                                                "sense_id": "4ef754b2-82e7-3334-a5ab-b24f18bd6a96",
                                                "text": "Thy ouerflow of good, conuerts to bad, / And thy abundant goodneſſe ſhall excuſe / This deadly blot, in thy digreſſing ſonne."
                                            },
                                            {
                                                "example_id": "aa74e4df-e5e4-4553-8904-c3b5b943460a",
                                                "sense_id": "4ef754b2-82e7-3334-a5ab-b24f18bd6a96",
                                                "text": "He that reproueth a ſcorner, getteth to himſelfe ſhame: and he that rebuketh a wicked man, getteth himſelfe a blot."
                                            },
                                            {
                                                "example_id": "a8434f2f-f810-446e-aa65-b3054d19980e",
                                                "sense_id": "4ef754b2-82e7-3334-a5ab-b24f18bd6a96",
                                                "text": "Thus man devotes his brother, and deſtroys; / And worſe than all, and moſt to be deplored / As human nature’s broadeſt, fouleſt blot, / Chains him, and taſks him, and exacts his ſweat / With ſtripes, that mercy with a bleeding heart / Weeps when ſhe ſees inflicted on a beaſt."
                                            },
                                            {
                                                "example_id": "f1bd0229-65bf-4a12-8e30-5366eef7439a",
                                                "sense_id": "4ef754b2-82e7-3334-a5ab-b24f18bd6a96",
                                                "text": "The only blot on this service is that of its Kentish Town connections, which throughout the day in many cases just miss the St. Pancras-Luton stopping trains."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "968f3e80-b599-3e4f-b49e-7c70d00257e3",
                                        "entry_id": "29bd00f9-ec86-3ac7-b5a9-c6c9bcc4def7",
                                        "glosses": [
                                            "A method of transferring proteins, DNA or RNA, onto a carrier."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b9b9bee9-915e-3694-bf4c-29ba6f72d737",
                                        "entry_id": "29bd00f9-ec86-3ac7-b5a9-c6c9bcc4def7",
                                        "glosses": [
                                            "An exposed piece in backgammon."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "blot",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e9020013-5031-35de-a335-01a12a751b58",
                                        "entry_id": "f9cd0622-841b-3ad2-a10c-0ce891bd1076",
                                        "glosses": [
                                            "To cause a blot (on something) by spilling a coloured substance."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fdeab498-1840-34af-86a0-cb90f6b49c9c",
                                        "entry_id": "f9cd0622-841b-3ad2-a10c-0ce891bd1076",
                                        "glosses": [
                                            "To soak up or absorb liquid."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "87e99c4d-5215-4920-87b7-2eb1bea88848",
                                                "sense_id": "fdeab498-1840-34af-86a0-cb90f6b49c9c",
                                                "text": "This paper blots easily."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "566c3c6d-0008-39b0-8493-f13f74e2c92f",
                                        "entry_id": "f9cd0622-841b-3ad2-a10c-0ce891bd1076",
                                        "glosses": [
                                            "To dry (writing, etc.) with blotting paper."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c6397f33-26c7-34b6-9200-989f15b556e2",
                                        "entry_id": "f9cd0622-841b-3ad2-a10c-0ce891bd1076",
                                        "glosses": [
                                            "To spot, stain, or bespatter, as with ink."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c7b4362-a4ec-44ae-9c68-2308a00eee72",
                                                "sense_id": "c6397f33-26c7-34b6-9200-989f15b556e2",
                                                "text": "The briefe was writte and blotted all with gore,[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "efe50a63-923d-3065-874a-6c84f7ab1eca",
                                        "entry_id": "f9cd0622-841b-3ad2-a10c-0ce891bd1076",
                                        "glosses": [
                                            "To impair; to damage; to mar; to soil."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06fa6563-d462-4c4c-a621-5e7b7953d4b4",
                                                "sense_id": "efe50a63-923d-3065-874a-6c84f7ab1eca",
                                                "text": "It blots thy beautie, as froſts doe bite the Meads,[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0365510-f586-3b01-bdb2-7e08fc8e048d",
                                        "entry_id": "f9cd0622-841b-3ad2-a10c-0ce891bd1076",
                                        "glosses": [
                                            "To stain with infamy; to disgrace."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "48949c95-c7d1-4771-9298-e9f7d0bc1a60",
                                                "sense_id": "e0365510-f586-3b01-bdb2-7e08fc8e048d",
                                                "text": "Blot not thy Innocence with guiltleſs Blood."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5cec2eba-42f7-3700-aee3-07868964338a",
                                        "entry_id": "f9cd0622-841b-3ad2-a10c-0ce891bd1076",
                                        "glosses": [
                                            "To obliterate, as writing with ink; to cancel; to efface; generally with out."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "13711fec-e8cc-44b3-b965-4cd5c54067b9",
                                                "sense_id": "5cec2eba-42f7-3700-aee3-07868964338a",
                                                "text": "to blot out a word or a sentence"
                                            },
                                            {
                                                "example_id": "e0d2e056-f1ee-4bd9-a2e6-3e9191508d5c",
                                                "sense_id": "5cec2eba-42f7-3700-aee3-07868964338a",
                                                "text": "One act like this blots out a thouſand Crimes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a2219c2a-303d-3f9e-8ecf-c8e69faa53e0",
                                        "entry_id": "f9cd0622-841b-3ad2-a10c-0ce891bd1076",
                                        "glosses": [
                                            "To obscure; to eclipse; to shadow."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f8f0b289-ada1-4f7e-b958-9892d3bd8928",
                                                "sense_id": "a2219c2a-303d-3f9e-8ecf-c8e69faa53e0",
                                                "text": "He ſung how Earth blots the Moons gilded Wane,[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8379d0dc-5a65-3754-af2b-f26b030cb50f",
                                        "entry_id": "f9cd0622-841b-3ad2-a10c-0ce891bd1076",
                                        "glosses": [
                                            "To sell illegal drugs, to deal, to push."
                                        ],
                                        "tags": [
                                            "Multicultural-London-English",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4830ae07-83e9-43cb-ba66-7313c6b830cd",
                                                "sense_id": "8379d0dc-5a65-3754-af2b-f26b030cb50f",
                                                "text": "I'm walking down the street, past the coppers on the beat. Past the shotters blottin' weed, clear for everyone to see."
                                            },
                                            {
                                                "example_id": "659c26c5-2082-44e6-a60d-a267cfb47e3c",
                                                "sense_id": "8379d0dc-5a65-3754-af2b-f26b030cb50f",
                                                "text": "What kind of things that you have. When I find out don't expect me to stop. I'll come for the P's that you stack. And come for the food that you blot."
                                            },
                                            {
                                                "example_id": "d2d5f9a7-47a6-48c3-b9f2-3dd0f3196c1a",
                                                "sense_id": "8379d0dc-5a65-3754-af2b-f26b030cb50f",
                                                "text": "Porchy: Blottin' dope on the block, going on these shows."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4277afee-534c-3cb5-aa86-f29014f62b31",
                                        "entry_id": "f9cd0622-841b-3ad2-a10c-0ce891bd1076",
                                        "glosses": [
                                            "To hit a blot."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
