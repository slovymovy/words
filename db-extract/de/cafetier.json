                "senses": [
                    {
                        "sense_id": "5e6d2bd9-7c82-3b04-b72f-d7cdb93557b4",
                        "entry_id": "06279081-5794-3c39-9ad8-484c363da75d",
                        "glosses": [
                            "Besitzer eines Kaffeehauses"
                        ],
                        "tags": [
                            "Austrian German",
                            "Swiss Standard German"
                        ],
                        "examples": [
                            {
                                "example_id": "0550e84c-5bd9-422a-9d85-66770114d0a1",
                                "sense_id": "5e6d2bd9-7c82-3b04-b72f-d7cdb93557b4",
                                "text": "„Nachdem ich 2007 nach XXXX ging, habe ich als Cafetier zu arbeiten begonnen, weil meine Frau und mein Schwager bereits in diesem Geschäftszweig tätig waren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3578cfbc-dd07-403c-8579-21449568dbb9",
                        "source_entry_id": "06279081-5794-3c39-9ad8-484c363da75d",
                        "source_sense_id": "5e6d2bd9-7c82-3b04-b72f-d7cdb93557b4",
                        "source_sense_description": "Besitzer eines Kaffeehauses",
                        "target_lang_word": "cafetier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cafetier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "097c6c34-81c3-3ac4-a7eb-0b85adb04301",
                                        "entry_id": "f58e4d09-2d5e-33d2-85bb-d0af6701673a",
                                        "glosses": [
                                            "Commerçant qui vend du café tout fait, ainsi que d’autres boissons, chaudes ou froides."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90aecd1f-3707-47ad-b953-2920c51f1d05",
                                                "sense_id": "097c6c34-81c3-3ac4-a7eb-0b85adb04301",
                                                "text": "Au fait, dit le cafetier, ils peuvent bien avoir de l’argent, une fois par hasard."
                                            },
                                            {
                                                "example_id": "27fcd91e-cdec-4e09-a6e5-c239ef710479",
                                                "sense_id": "097c6c34-81c3-3ac4-a7eb-0b85adb04301",
                                                "text": "Quand Yasmina rentra, sa mère lui annonça qu’on allait la marier à Mohammed Elaour, cafetier à Batna."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1867de65-99bb-35b8-8c6d-ca51117b0ccf",
                                        "entry_id": "f58e4d09-2d5e-33d2-85bb-d0af6701673a",
                                        "glosses": [
                                            "Commerçant qui tient un café."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6382fd7-a66e-46be-bd8d-7195c97e2e0c",
                                                "sense_id": "1867de65-99bb-35b8-8c6d-ca51117b0ccf",
                                                "text": "L'organisateur de ces combats est souvent un cafetier possédant un gallodrome aménagé à cet effet. La somme qu'il a versée, il arrive à la récupérer par le prix des entrées, pas toujours, mais souvent, car ces combats trouvent encore beaucoup d'amateurs."
                                            },
                                            {
                                                "example_id": "546e86d3-219d-483e-a1d9-e536617eaf5a",
                                                "sense_id": "1867de65-99bb-35b8-8c6d-ca51117b0ccf",
                                                "text": "Les rouges étaient aux cent coups. Ils s'étaient réunis en comité restreint dans la cuisine du cafetier. Autour de la toile cirée, le bureau de la Libre-Pensée cogitait ferme."
                                            },
                                            {
                                                "example_id": "c710c469-cbe4-4a2e-b9d9-2464447150ba",
                                                "sense_id": "1867de65-99bb-35b8-8c6d-ca51117b0ccf",
                                                "text": "Face à la difficulté de contrôler la réalité des futurs passes vaccinaux, le gouvernement a décidé de demander aux cafetiers et restaurateurs de contrôler aussi les pièces d’identité des détenteurs."
                                            },
                                            {
                                                "example_id": "9a78c93e-87f9-4d84-b771-3a3756217790",
                                                "sense_id": "1867de65-99bb-35b8-8c6d-ca51117b0ccf",
                                                "text": "Notre propre relevé à partir des listes de recensement de 1936 donne des chiffres un peu moindres : 200 marchands de vins, 190 cafetiers, 50 cafés-hôtels, 90 cafés-restaurants."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
