                                "example_id": "003b9853-4e20-4648-80ae-8c86caf2ab4c",
                                "sense_id": "6a2a39be-1cd2-3c09-bdb7-d64ba78bb3bf",
                                "text": "En ouvrant la porte, Patrick vit un homme de taille moyenne, vêtu d'un pantalon de velours bleu, d'un pull à col roulé, et d'une paire de basquettes crasseuses."
                            },
                            {
                                "example_id": "5f6c2fb0-200a-4a2c-b51d-4c8c52c128a5",
                                "sense_id": "6a2a39be-1cd2-3c09-bdb7-d64ba78bb3bf",
                                "text": "Elle alla chercher son sac et vida son contenu sur le canapé. Il y avait un sac de couchage militaire, […], une paire de basquettes, une paire de rangers identiques à celles qu'elle avait aux pieds, […]."
                            },
                            {
                                "example_id": "1bf918fa-11cf-45fc-ab32-5d7b4664da6b",
                                "sense_id": "6a2a39be-1cd2-3c09-bdb7-d64ba78bb3bf",
                                "text": "Et ils me jettent à l'eau. Avec mes belles basquettes aux pieds. Andouilles de pirates !"
                            }
                        ]
                    }
