                "senses": [
                    {
                        "sense_id": "bf48d614-1a5a-3f5d-b789-c622aa6d72fb",
                        "entry_id": "8f9728a8-7a7d-316f-8cad-d4b5cdc62dcc",
                        "glosses": [
                            "Stadt in der Woiwodschaft Pommern, Polen (38.000 Einwohner)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4578cffc-b6e4-4fac-b4b7-56cdfa667acc",
                                "sense_id": "bf48d614-1a5a-3f5d-b789-c622aa6d72fb",
                                "text": "Bekannt sind in Marienwerder die große Domkirche (1343–84 erbaut), die (früher einzige) katholische Kirche und das alte Domschloss."
                            },
                            {
                                "example_id": "ef9943ba-43e5-4f36-934f-2c4008e5bb1e",
                                "sense_id": "bf48d614-1a5a-3f5d-b789-c622aa6d72fb",
                                "text": "„Unruhe und Verwirrung herrschen in Hoffmanns Seele; Hippel kann er sich nur über das Ersatzmittel der Korrespondenz anvertrauen, denn der Freund hat seit kurzem den Posten als juristischer Auskultator in Marienwerder angetreten.“"
                            }
                        ],
