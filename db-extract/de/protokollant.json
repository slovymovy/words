                "senses": [
                    {
                        "sense_id": "54d34820-d922-32a7-a27a-444dc8231827",
                        "entry_id": "931ccd5b-5a38-3598-88ce-5a89213c34fd",
                        "glosses": [
                            "Verfasser eines Protokolls"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "626752a4-9aa1-40dd-8986-4b96fd1aab36",
                                "sense_id": "54d34820-d922-32a7-a27a-444dc8231827",
                                "text": "Ein Protokollant übernimmt die Aufgabe, im Rahmen von beispielsweise Interviews, Sitzungen, Verhandlungen oder Gruppendiskussionen das Gesagte mitzuschreiben."
                            },
                            {
                                "example_id": "b0133774-bb1f-471a-88f1-7898739a22bf",
                                "sense_id": "54d34820-d922-32a7-a27a-444dc8231827",
                                "text": "Der Protokollant unterschreibt rechts, der Sitzungsleiter links."
                            },
                            {
                                "example_id": "5dbd7a75-b96c-4df0-9a42-faa5fa4a3a22",
                                "sense_id": "54d34820-d922-32a7-a27a-444dc8231827",
                                "text": "„Wieland war Protokollant und hat sich die kleine Freiheit einer gewissen Süffisanz genommen: »und was dergleichen mehr war p«.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
