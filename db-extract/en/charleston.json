                        "examples": [
                            {
                                "example_id": "95240831-35be-4052-aef5-c37af8017002",
                                "sense_id": "1aeaf7dd-c659-3107-9a3f-a8dc16b6e825",
                                "text": "Dubbed “the Black Venus”, she danced the charleston in nothing but a string of pearls and a skirt made of 16 rubber bananas, performed with a snake wrapped suggestively round her neck, strolled down the Champs-Élysées with her pet cheetah, and became an international superstar. https://www.theguardian.com/world/2021/nov/28/dancer-singer-spy-frances-pantheon-to-honour-josephine-baker"
                            }
                        ]
                    }
