                "senses": [
                    {
                        "sense_id": "d1e21353-81aa-32fe-8ef9-1c872c09b77d",
                        "entry_id": "b65cacc2-921d-33c8-a471-9a24c6ea9b4c",
                        "glosses": [
                            "door degeen die uitmaakt wie er volgens de wet gelijk heeft, uitgevoerd door het gerecht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5875c853-3679-4537-badd-1f2f7cea70e7",
                                "sense_id": "d1e21353-81aa-32fe-8ef9-1c872c09b77d",
                                "text": "Hij had het boek geleend uit de bibliotheek van het Huis van Bewaring in Utrecht, waar hij, verdacht van doodslag op zijn hospita, al bijna zes maanden had gewacht op de uitslag van het gerechtelijk vooronderzoek."
                            }
                        ]
                    },
                    {
                        "sense_id": "947b862f-cdf9-31bb-8e56-a5f80411ec43",
                        "entry_id": "b65cacc2-921d-33c8-a471-9a24c6ea9b4c",
                        "glosses": [
                            "van degeen die uitmaakt wie er volgens de wet gelijk heeft, betrekking hebbend op of behorend tot het gerecht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46346f6c-6a5b-434c-9409-90635c47d6c8",
                                "sense_id": "947b862f-cdf9-31bb-8e56-a5f80411ec43",
                                "text": "Een baljuw kon als gerechtelijk ambtenaar in een bepaald rechtsgebied optreden als vertegenwoordiger van de landsheer."
                            }
                        ]
                    },
                    {
                        "sense_id": "e79862e1-229d-379f-8c26-677c807bb87b",
                        "entry_id": "b65cacc2-921d-33c8-a471-9a24c6ea9b4c",
                        "glosses": [
                            "bij degeen die uitmaakt wie er volgens de wet gelijk heeft, voor het gerecht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c764816-c02c-416d-ba65-53288acb0060",
                                "sense_id": "e79862e1-229d-379f-8c26-677c807bb87b",
                                "text": "Hierop vertrekt Gauvain richting Escavalon, om daar de aanklacht in een gerechtelijk duel te weerleggen."
                            }
                        ]
                    }
                ],
