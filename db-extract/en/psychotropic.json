                "senses": [
                    {
                        "sense_id": "c6cfdd55-919d-315c-9ac7-d80531fb48af",
                        "entry_id": "abe33afb-1ece-3e56-89da-22727e2b8864",
                        "glosses": [
                            "Affecting the mind or mental processes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98bab985-811e-49d6-a1f4-be2801854be8",
                                "sense_id": "c6cfdd55-919d-315c-9ac7-d80531fb48af",
                                "text": "“Medication can be part of a psychotropic arsenal,” he said, discussing one therapist who urged him to stop taking Xanax so he could address his anxiety directly and not mask the physical symptoms."
                            }
                        ]
                    }
                ],
                "translations": [
