                "senses": [
                    {
                        "sense_id": "376afd45-8f98-3e0a-a31e-ca322053b6af",
                        "entry_id": "cb9a1384-2f99-32a0-8844-4b029c90c766",
                        "glosses": [
                            "runder Bogen als oberer Abschluss einer Maueröffnung oder als Verbindung zwischen Säulen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27484fb0-ceba-4a30-a7db-a9ef9d05fdc5",
                                "sense_id": "376afd45-8f98-3e0a-a31e-ca322053b6af",
                                "text": "„Erst vor einem Rundbogen mit Zierbrunnen, von wo aus man die Cafébar einsehen konnte, hielt er an.“"
                            },
                            {
                                "example_id": "c7e70739-eb3b-449c-939a-d50b279215b0",
                                "sense_id": "376afd45-8f98-3e0a-a31e-ca322053b6af",
                                "text": "„Wenige breit ausgetretene Steinstufen führten zu einem freistehenden Rundbogen, der vermutlich einmal zum Innentor eines antiken Palastes gehört hatte.“"
                            },
                            {
                                "example_id": "e4815a6b-cecb-4260-80e1-5e08c2e43939",
                                "sense_id": "376afd45-8f98-3e0a-a31e-ca322053b6af",
                                "text": "„Der Rundbogen herrscht in der Provence noch im XIII. Jahrhundert vor.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
