                        "source_entry_id": "484ffebf-79a2-35a7-92bb-7e6cd1b713ba",
                        "source_sense_description": "Translations",
                        "target_lang_word": "потусторонний мир",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "потусторонний мир",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "fe58ebf0-aae3-34cd-bf3d-81a6072dec72",
                                        "entry_id": "5e4539e5-fece-31df-882b-58045a9665a9",
                                        "glosses": [
                                            "мифол. название места, куда попадают после смерти души людей, чтобы переродиться"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc4ed014-0164-441a-b349-03e537386982",
                                                "sense_id": "fe58ebf0-aae3-34cd-bf3d-81a6072dec72",
                                                "text": "Но душа, освободившаяся от бледных радостей и мелких печалей земли, трепещет и рвётся ввысь, в потусторонний мир."
                                            },
                                            {
                                                "example_id": "8eb7d8e1-513f-417b-adf3-8a1dd14eae02",
                                                "sense_id": "fe58ebf0-aae3-34cd-bf3d-81a6072dec72",
                                                "text": "Иногда видения или голоса кажутся больным идущими неизвестно откуда, точно из потустороннего мира."
                                            },
                                            {
                                                "example_id": "0ef4c053-bf84-46c9-80b1-9e683c273e40",
                                                "sense_id": "fe58ebf0-aae3-34cd-bf3d-81a6072dec72",
                                                "text": "Природа — слишком ревнивая и скупая любовница, чтоб отпускать своих любимцев в некий потусторонний мир, где нет её самой и куда не простираются её законы."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
