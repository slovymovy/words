                "senses": [
                    {
                        "sense_id": "4e61ba18-29bf-3ecf-8c81-55c6bb01f7dc",
                        "entry_id": "32be0ed7-878e-35a1-935d-f57843f60b52",
                        "glosses": [
                            "Donner un caractère nouchi à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "019f490c-cac6-4bfe-8f05-f70ddaf2a0ec",
                                "sense_id": "4e61ba18-29bf-3ecf-8c81-55c6bb01f7dc",
                                "text": "Comme nous le décrit l’auteur, elle ne se sent donc concernée ni de près ni de loin par les schémas archétypaux de la ville de Babi, ou, pour nouchiser le discours, elle fait rien avec ça."
                            },
                            {
                                "example_id": "a45470d5-fce2-4dbd-ab9a-e08a7e7ae586",
                                "sense_id": "4e61ba18-29bf-3ecf-8c81-55c6bb01f7dc",
                                "text": "Franchement la « sœur » Nadine j'espère que tu liras mon message « nouchisé » (français me fatigue) mais je dis ho, est ce que tu sais que les gaulois étaient mal vilains même ?"
                            },
                            {
                                "example_id": "3de9fe49-2ab1-40bd-bf11-ddfead069c09",
                                "sense_id": "4e61ba18-29bf-3ecf-8c81-55c6bb01f7dc",
                                "text": "excusez moi, je nouchise de travers !!"
                            }
                        ]
                    }
