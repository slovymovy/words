                        "examples": [
                            {
                                "example_id": "2bbe70ed-93ce-4103-83a7-2929c3e76648",
                                "sense_id": "883ab912-a732-3ea0-b4e5-43416711a64b",
                                "text": "„Die häufige Verwendung des Zehnersystems statt anderer Zahlensysteme beruht auf der Verwendung der zehn Finger der beiden Hände zum Zählen mit den Fingern.“"
                            },
                            {
                                "example_id": "2e3499a3-97ba-4915-8d31-f192a0c6efff",
                                "sense_id": "883ab912-a732-3ea0-b4e5-43416711a64b",
                                "text": "„Im Unterschied zum Zehnersystem kennt das duale Zahlensystem nur zwei Charaktere oder Ziffern: 0 und 1.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
