                        "examples": [
                            {
                                "example_id": "74238c22-6952-42e5-b7f1-6b8b5d15902e",
                                "sense_id": "50ad66fc-03f9-3186-84f3-77b64a18850d",
                                "text": "Les Khoungouzes sont particulièrement bien organisés et prélèvent leur dû sur le commerce régional depuis longtemps déjà."
                            },
                            {
                                "example_id": "0ae679a2-9573-486e-8699-f431c936700e",
                                "sense_id": "50ad66fc-03f9-3186-84f3-77b64a18850d",
                                "text": "Je devais le défendre contre les voleurs de l’Oural qui avaient attaqué les saltimbanques de Jules Verne\nContre les Khoungouzes, les boxers de la Chine\nEt les enragés petits mongols du Grand-Lama […]."
                            },
                            {
                                "example_id": "581e892f-d34f-4511-8d35-5f931b4a3078",
                                "sense_id": "50ad66fc-03f9-3186-84f3-77b64a18850d",
                                "text": "Les Khoungouzes ont établi leurs postes principaux sur le territoire chinois, près des confluents des grandes rivières, affluents du fleuve Amour, par conséquent à la frontière même des possessions russes et chinoises."
                            }
                        ]
