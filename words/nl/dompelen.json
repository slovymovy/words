{
    "word_family": [
        "dompelaar",
        "onderdompelen",
        "dompeling"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6fad225c-6ceb-323f-a829-400ae813d338",
                    "sense_definition": "Iets geheel of gedeeltelijk in een vloeistof steken of onder water houden.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vloeistof",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je moet de koekjes kort in de thee <w>dompelen</w> voor de beste smaak.",
                            "target_lang_translations": {
                                "en": "You should briefly <w>dip</w> the cookies in the tea for the best taste."
                            }
                        },
                        {
                            "text": "Hij <w>dompelde</w> de aardappels in het water om ze schoon te maken.",
                            "target_lang_translations": {
                                "en": "He <w>submerged</w> the potatoes in the water to clean them."
                            }
                        }
                    ],
                    "synonyms": [
                        "onderdompelen",
                        "dopen",
                        "indopen"
                    ],
                    "common_phrases": [
                        "in water dompelen"
                    ],
                    "target_lang_definitions": {
                        "en": "To put something completely or partially into a liquid or keep it under water."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "dip",
                                "target_lang_sense_clarification": "briefly putting into liquid"
                            },
                            {
                                "target_lang_word": "submerge",
                                "target_lang_sense_clarification": "putting completely under water"
                            },
                            {
                                "target_lang_word": "plunge",
                                "target_lang_sense_clarification": "pushing quickly into liquid"
                            },
                            {
                                "target_lang_word": "immerse",
                                "target_lang_sense_clarification": "covering completely with liquid"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "62386a35-6908-346e-ac7e-e1984a04968a",
                    "sense_definition": "Iemand of iets figuurlijk in een bepaalde (meestal negatieve) toestand of sfeer brengen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "toestand",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het plotselinge overlijden van de koning <w>dompelde</w> het hele land in diepe rouw.",
                            "target_lang_translations": {
                                "en": "The sudden death of the king <w>plunged</w> the entire country into deep mourning."
                            }
                        },
                        {
                            "text": "De economische crisis <w>dompelde</w> veel gezinnen in diepe armoede.",
                            "target_lang_translations": {
                                "en": "The economic crisis <w>plunged</w> many families into deep poverty."
                            }
                        }
                    ],
                    "synonyms": [
                        "storten"
                    ],
                    "common_phrases": [
                        "in rouw dompelen",
                        "in ellende dompelen"
                    ],
                    "target_lang_definitions": {
                        "en": "To figuratively bring someone or something into a certain (usually negative) state or atmosphere."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "plunge",
                                "target_lang_sense_clarification": "suddenly bringing into a negative state"
                            },
                            {
                                "target_lang_word": "immerse",
                                "target_lang_sense_clarification": "deeply involving in a state or feeling"
                            },
                            {
                                "target_lang_word": "cast",
                                "target_lang_sense_clarification": "throwing into a state like grief or darkness"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}