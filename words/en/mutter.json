{
    "word_family": [
        "mutterer",
        "muttering"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cdfdb8b2-468d-347d-88ee-83615c22419e",
                    "sense_definition": "To speak quietly and unclearly, especially when complaining or being angry, so that others cannot hear the words distinctly.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "speak quietly",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The students began to <w>mutter</w> under their breath when the teacher announced a surprise test.",
                            "target_lang_translations": {
                                "ru": "Ученики начали <w>бормотать</w> себе под нос, когда учитель объявил о внезапной контрольной."
                            }
                        },
                        {
                            "text": "He would often <w>mutter</w> an angry complaint to himself rather than confront his boss directly.",
                            "target_lang_translations": {
                                "ru": "Он часто <w>бурчал</w> сердитые жалобы себе под нос вместо того, чтобы высказать всё начальнику в лицо."
                            }
                        }
                    ],
                    "synonyms": [
                        "grumble",
                        "mumble"
                    ],
                    "antonyms": [
                        "shout",
                        "yell",
                        "exclaim"
                    ],
                    "common_phrases": [
                        "mutter under breath",
                        "mutter an angry complaint",
                        "mutter to oneself"
                    ],
                    "target_lang_definitions": {
                        "ru": "Говорить тихо и невнятно, особенно выражая недовольство или гнев, так что окружающие не могут разобрать слова."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бормотать",
                                "target_lang_sense_clarification": "тихо и невнятно"
                            },
                            {
                                "target_lang_word": "бурчать",
                                "target_lang_sense_clarification": "выражать недовольство"
                            },
                            {
                                "target_lang_word": "ворчать",
                                "target_lang_sense_clarification": "жаловаться"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "822053d4-d579-3faa-9ebc-c1c7ec7ce73e",
                    "sense_definition": "To speak softly and incoherently, often with poor articulation or as if talking to oneself.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "speak quietly",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient continued to <w>mutter</w> incoherently while drifting in and out of sleep.",
                            "target_lang_translations": {
                                "ru": "Пациент продолжал бессвязно <w>бормотать</w>, то засыпая, то просыпаясь."
                            }
                        },
                        {
                            "text": "It is common to <w>mutter</w> soft words when you are deep in thought and alone.",
                            "target_lang_translations": {
                                "ru": "Часто случается <w>бормотать</w> тихие слова, когда ты глубоко задумчив и одинок."
                            }
                        }
                    ],
                    "synonyms": [
                        "mumble",
                        "murmur",
                        "babble"
                    ],
                    "antonyms": [
                        "articulate",
                        "enunciate"
                    ],
                    "common_phrases": [
                        "mutter soft words",
                        "mutter incoherently"
                    ],
                    "target_lang_definitions": {
                        "ru": "Говорить тихо и бессвязно, часто с плохой артикуляцией или как будто разговаривая с самим собой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бормотать",
                                "target_lang_sense_clarification": "невнятно"
                            },
                            {
                                "target_lang_word": "бубнить",
                                "target_lang_sense_clarification": "монотонно и глухо"
                            },
                            {
                                "target_lang_word": "лепетать",
                                "target_lang_sense_clarification": "бессвязно"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cfb0eac8-d3ab-3d31-a335-cfa2413e7407",
                    "sense_definition": "To make a low, continuous, and rumbling sound, like distant thunder or an engine.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "low sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We could hear the distant thunder <w>mutter</w> across the dark valley.",
                            "target_lang_translations": {
                                "ru": "Мы слышали, как в темной долине <w>рокочет</w> далекий гром."
                            }
                        },
                        {
                            "text": "The old car engine started to <w>mutter</w> rhythmically as it warmed up in the driveway.",
                            "target_lang_translations": {
                                "ru": "Старый двигатель машины начал ритмично <w>урчать</w>, прогреваясь на подъездной дорожке."
                            }
                        }
                    ],
                    "synonyms": [
                        "rumble",
                        "putter"
                    ],
                    "common_phrases": [
                        "muttering thunder",
                        "engine muttering"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "figurative use"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Издавать низкий, продолжительный и рокочущий звук, подобный отдаленному грому или шуму двигателя."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рокотать",
                                "target_lang_sense_clarification": "о громе или двигателе"
                            },
                            {
                                "target_lang_word": "ворчать",
                                "target_lang_sense_clarification": "переносно о звуках"
                            },
                            {
                                "target_lang_word": "урчать",
                                "target_lang_sense_clarification": "о моторе"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "69e51a80-b56f-357a-97fa-eb213177281e",
                    "sense_definition": "A quiet, indistinct sound or a complaint made in a low voice.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "speak quietly",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The crowd fell silent, and not a single <w>mutter</w> of protest was heard.",
                            "target_lang_translations": {
                                "ru": "Толпа затихла, и не было слышно ни единого <w>ропота</w> протеста."
                            }
                        },
                        {
                            "text": "She gave a low <w>mutter</w> of dissatisfaction before walking out of the room.",
                            "target_lang_translations": {
                                "ru": "Она издала тихое <w>ворчание</w> недовольства, прежде чем выйти из комнаты."
                            }
                        }
                    ],
                    "synonyms": [
                        "murmur",
                        "mumble"
                    ],
                    "common_phrases": [
                        "low mutter",
                        "mutter of protest",
                        "mutter of dissatisfaction"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тихий, невнятный звук или жалоба, произнесенная вполголоса."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бормотание",
                                "target_lang_sense_clarification": "процесс или звук"
                            },
                            {
                                "target_lang_word": "ропот",
                                "target_lang_sense_clarification": "недовольство"
                            },
                            {
                                "target_lang_word": "ворчание",
                                "target_lang_sense_clarification": "жалоба"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0518fce2-d62f-3050-b4c5-c5c4c2517e73",
                    "sense_definition": "A term used to refer to peas, typically in the context of Indian cuisine.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I ordered a side of <w>mutter</w> paneer to go with my garlic naan.",
                            "target_lang_translations": {
                                "ru": "Я заказал порцию <w>матар</w> панира к чесночной лепешке наан."
                            }
                        },
                        {
                            "text": "The recipe calls for fresh <w>mutter</w> to be added to the spicy gravy.",
                            "target_lang_translations": {
                                "ru": "По рецепту в острый соус нужно добавить свежий <w>горох</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "mutter paneer"
                    ],
