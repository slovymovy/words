{
    "word_family": [
        "coronate",
        "coronation",
        "crownless",
        "crowner",
        "uncrown",
        "dethrone"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "039ff620-a9b4-319e-8ba0-068fdd250150",
                    "sense_definition": "A royal, imperial or princely headdress; a diadem.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "royalty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The king wore a heavy gold <w>crown</w> decorated with many diamonds.",
                            "target_lang_translations": {
                                "ru": "Король носил тяжелую золотую <w>корону</w>, украшенную множеством бриллиантов."
                            }
                        },
                        {
                            "text": "She adjusted the <w>crown</w> on her head before the ceremony began.",
                            "target_lang_translations": {
                                "ru": "Она поправила <w>корону</w> на голове перед началом церемонии."
                            }
                        }
                    ],
                    "synonyms": [
                        "diadem",
                        "coronet"
                    ],
                    "common_phrases": [
                        "royal crown",
                        "gold crown"
                    ],
                    "target_lang_definitions": {
                        "ru": "Королевский, императорский или княжеский головной убор; диадема."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "коро́на",
                                "target_lang_sense_clarification": "головной убор монарха"
                            },
                            {
                                "target_lang_word": "вене́ц",
                                "target_lang_sense_clarification": "торжественный или поэтический термин для короны"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8d341e5e-2ce6-36d1-8114-79864a3d7003",
                    "sense_definition": "The topmost part of the head.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "top_part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sun beat down directly on the <w>crown</w> of his head.",
                            "target_lang_translations": {
                                "ru": "Солнце палило прямо ему в <w>макушку</w>."
                            }
                        },
                        {
                            "text": "He felt a sharp pain at the <w>crown</w> after hitting the low ceiling.",
                            "target_lang_translations": {
                                "ru": "Он почувствовал острую боль в <w>темени</w> после того, как ударился о низкий потолок."
                            }
                        }
                    ],
                    "synonyms": [
                        "top",
                        "apex"
                    ],
                    "antonyms": [
                        "base",
                        "bottom",
                        "foot"
                    ],
                    "common_phrases": [
                        "crown of the head"
                    ],
                    "target_lang_definitions": {
                        "ru": "Самая верхняя часть головы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "маку́шка",
                                "target_lang_sense_clarification": "верхняя часть головы"
                            },
                            {
                                "target_lang_word": "те́мя",
                                "target_lang_sense_clarification": "анатомическая область верхней части головы"
                            },
                            {
                                "target_lang_word": "ма́ковка",
                                "target_lang_sense_clarification": "разговорное обозначение макушки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "50bada67-46f3-3a7a-a0d8-bd897744786e",
                    "sense_definition": "A prosthetic covering for a tooth.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "dentistry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dentist recommended a porcelain <w>crown</w> to protect the broken tooth.",
                            "target_lang_translations": {
                                "ru": "Стоматолог порекомендовал фарфоровую <w>коронку</w>, чтобы защитить сломанный зуб."
                            }
                        },
                        {
                            "text": "I need to go back to the clinic because my temporary <w>crown</w> fell out.",
                            "target_lang_translations": {
                                "ru": "Мне нужно вернуться в клинику, потому что моя временная <w>коронка</w> выпала."
                            }
                        }
                    ],
                    "synonyms": [
                        "dental crown",
                        "dental cap"
                    ],
                    "common_phrases": [
                        "temporary crown"
                    ],
                    "target_lang_definitions": {
                        "ru": "Протез, покрывающий зуб."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "коро́нка",
                                "target_lang_sense_clarification": "стоматологический протез"
                            },
                            {
                                "target_lang_word": "зубна́я коро́нка",
                                "target_lang_sense_clarification": "полное название стоматологического протеза"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a386e919-a244-3e9e-a207-ccefdb38baf0",
                    "sense_definition": "The highest part of a hill or mountain.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "top_part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We finally reached the <w>crown</w> of the hill and looked at the valley below.",
                            "target_lang_translations": {
                                "ru": "Мы наконец достигли <w>вершины</w> холма и посмотрели на долину внизу."
                            }
                        },
                        {
                            "text": "The snowy <w>crown</w> of the mountain was visible from miles away.",
                            "target_lang_translations": {
                                "ru": "Снежная <w>вершина</w> горы была видна за много миль."
                            }
                        }
                    ],
                    "synonyms": [
                        "summit",
                        "peak",
                        "crest",
                        "hillcrest"
                    ],
                    "antonyms": [
                        "base",
                        "foot"
                    ],
                    "common_phrases": [
                        "crown of the hill"
                    ],
                    "target_lang_definitions": {
                        "ru": "Самая высокая часть холма или горы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "верши́на",
                                "target_lang_sense_clarification": "верхняя точка горы или холма"
                            },
                            {
                                "target_lang_word": "гре́бень",
                                "target_lang_sense_clarification": "верхняя часть горного хребта"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b7cd7a5e-97e3-3066-9f00-28ae34d5c82d",
                    "sense_definition": "The top section of a hat, above the brim.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "top_part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>crown</w> of his fedora was slightly crushed from the luggage.",
                            "target_lang_translations": {
                                "ru": "<w>Тулья</w> его фетровой шляпы была слегка помята багажом."
                            }
                        },
                        {
                            "text": "She chose a hat with a high <w>crown</w> to match her long dress.",
                            "target_lang_translations": {
                                "ru": "Она выбрала шляпу с высокой <w>тульей</w> под стать своему длинному платью."
                            }
                        }
                    ],
                    "synonyms": [
                        "top"
                    ],
                    "common_phrases": [
                        "hat crown"
                    ],
                    "target_lang_definitions": {
                        "ru": "Верхняя часть шляпы, расположенная над полями."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ту́лья",
                                "target_lang_sense_clarification": "основная часть головного убора без полей"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c3e6af74-a2d7-3046-a913-23542d25c13f",
                    "sense_definition": "The highest point of achievement; splendor; culmination.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "abstract_top",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Winning the Olympic gold was the <w>crown</w> of her long athletic career.",
                            "target_lang_translations": {
                                "ru": "Победа на Олимпийских играх стала <w>венцом</w> ее долгой спортивной карьеры."
                            }
                        },
                        {
                            "text": "This masterpiece is considered the <w>crown</w> of his artistic life.",
                            "target_lang_translations": {
                                "ru": "Этот шедевр считается <w>вершиной</w> его творческой жизни."
                            }
                        }
                    ],
                    "synonyms": [
                        "culmination",
                        "acme",
                        "splendor",
                        "completion"
                    ],
                    "common_phrases": [
                        "crown of glory"
                    ],
                    "target_lang_definitions": {
                        "ru": "Высшая точка достижений; великолепие; кульминация."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вене́ц",
                                "target_lang_sense_clarification": "завершение или высшее достижение"
                            },
                            {
                                "target_lang_word": "верши́на",
                                "target_lang_sense_clarification": "пик карьеры или успеха"
                            },
                            {
                                "target_lang_word": "кульмина́ция",
                                "target_lang_sense_clarification": "наивысший момент развития"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6932f039-ed6e-3837-93f4-1df9a349b77b",
                    "sense_definition": "Various currencies known by similar names, such as the koruna, krona, or krone.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "currency",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He exchanged his euros for Czech <w>crowns</w> at the airport.",
                            "target_lang_translations": {
                                "ru": "В аэропорту он обменял свои евро на чешские <w>кроны</w>."
                            }
                        },
                        {
                            "text": "The price of the meal was several hundred <w>crowns</w>.",
                            "target_lang_translations": {
                                "ru": "Стоимость обеда составила несколько сотен <w>крон</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "swedish crown",
                        "czech crown"
                    ],
                    "target_lang_definitions": {
                        "ru": "Различные валюты с похожими названиями, такие как крона."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кро́на",
                                "target_lang_sense_clarification": "денежная единица ряда стран"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4835494f-b72e-37bb-8ee9-2aa322922da1",
                    "sense_definition": "During childbirth, the appearance of the baby's head from the mother's vagina.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "medical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The midwife told the mother to push as the baby's <w>crown</w> appeared.",
                            "target_lang_translations": {
                                "ru": "Акушерка сказала матери тужиться, когда показалась <w>головка</w> ребенка."
                            }
                        },
                        {
                            "text": "The doctor monitored the <w>crown</w> during the final stages of labor.",
                            "target_lang_translations": {
                                "ru": "Врач наблюдал за <w>прорезыванием головки</w> на заключительных стадиях родов."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Появление головки ребенка из влагалища матери во время родов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проре́зывание головки",
                                "target_lang_sense_clarification": "медицинский термин в акушерстве"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "da112b07-9a64-3ccf-a26b-af986f3b534d",
                    "sense_definition": "The knurled knob on the outside of a watch case used to wind it or adjust the hands.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "mechanics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pull the <w>crown</w> out gently to set the correct time on your watch.",
                            "target_lang_translations": {
                                "ru": "Осторожно вытяните <w>заводную головку</w>, чтобы установить правильное время на часах."
                            }
                        },
                        {
                            "text": "The watch is water-resistant only if the <w>crown</w> is pushed in tightly.",
                            "target_lang_translations": {
                                "ru": "Часы водонепроницаемы только в том случае, если <w>заводная головка</w> плотно прижата."
                            }
                        }
                    ],
                    "common_phrases": [
                        "watch crown"
                    ],
                    "target_lang_definitions": {
                        "ru": "Рифленая головка на внешней стороне корпуса часов, используемая для завода или перевода стрелок."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заводна́я голо́вка",
                                "target_lang_sense_clarification": "деталь часов для завода и настройки"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e6235efd-cc12-392e-846e-6a6253840a89",
                    "sense_definition": "To formally declare someone a king, queen, or emperor.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "ceremony",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The archbishop will <w>crown</w> the new king in the cathedral tomorrow.",
                            "target_lang_translations": {
                                "ru": "Завтра в соборе архиепископ <w>коронует</w> нового короля."
                            }
                        },
                        {
                            "text": "She was <w>crowned</w> queen after the death of her father.",
                            "target_lang_translations": {
                                "ru": "Она была <w>венчана на царство</w> после смерти своего отца."
                            }
                        }
                    ],
                    "synonyms": [
                        "coronate",
                        "enthrone"
                    ],
                    "antonyms": [
                        "dethrone#Verb",
                        "uncrown#Verb"
                    ],
                    "common_phrases": [
                        "crown queen",
                        "crown king"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официально провозгласить кого-либо королем, королевой или императором."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "коронова́ть",
                                "target_lang_sense_clarification": "возводить на престол"
                            },
                            {
                                "target_lang_word": "венча́ть на ца́рство",
                                "target_lang_sense_clarification": "проводить обряд возведения на престол"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "24718337-587b-386c-9cac-21a6641dd71a",
                    "sense_definition": "To declare someone a winner of a competition or championship.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "ceremony",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team was <w>crowned</w> champions after winning the final match.",
                            "target_lang_translations": {
                                "ru": "Команда была <w>увенчана</w> титулом чемпионов после победы в финальном матче."
                            }
                        },
                        {
                            "text": "She was <w>crowned</w> the winner of the beauty pageant.",
                            "target_lang_translations": {
                                "ru": "Ее <w>провозгласили</w> победительницей конкурса красоты."
                            }
                        }
                    ],
                    "common_phrases": [
                        "crown champions",
                        "crown winner"
                    ],
                    "target_lang_definitions": {
                        "ru": "Объявить кого-либо победителем соревнования или чемпионата."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "увенча́ть",
                                "target_lang_sense_clarification": "присвоить титул или звание победителя"
                            },
                            {
                                "target_lang_word": "провозгласи́ть чемпио́ном",
                                "target_lang_sense_clarification": "официально объявить победителем"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f3cf6cb9-548e-35b3-9c4f-42d050d1f9b2",
                    "sense_definition": "To form the topmost part of something; to complete or perfect.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "abstract_top",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A beautiful spire <w>crowns</w> the top of the historic building.",
                            "target_lang_translations": {
                                "ru": "Красивый шпиль <w>венчает</w> крышу исторического здания."
                            }
                        },
                        {
                            "text": "To <w>crown</w> the evening, they watched a spectacular fireworks display.",
                            "target_lang_translations": {
                                "ru": "Чтобы <w>увенчать</w> вечер, они посмотрели захватывающий фейерверк."
                            }
                        }
                    ],
                    "synonyms": [
                        "complete",
                        "consummate"
                    ],
                    "common_phrases": [
                        "crown the achievement"
                    ],
                    "target_lang_definitions": {
                        "ru": "Образовывать самую верхнюю часть чего-либо; завершать или совершенствовать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "увенча́ть",
                                "target_lang_sense_clarification": "завершать что-либо успехом или находиться сверху"
                            },
                            {
                                "target_lang_word": "венча́ть",
                                "target_lang_sense_clarification": "находиться на вершине чего-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bd9d911c-b8ef-37e5-857f-9faceea32532",
                    "sense_definition": "For the surface of a baby's head to appear in the vaginal opening during birth.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "medical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The nurse shouted that the baby was <w>crowning</w> and called for the doctor.",
                            "target_lang_translations": {
                                "ru": "Медсестра крикнула, что <w>показалась головка</w> ребенка, и позвала врача."
                            }
                        },
                        {
                            "text": "You can see the head <w>crowning</w> during the strongest contractions.",
                            "target_lang_translations": {
                                "ru": "Можно увидеть, как <w>прорезывается</w> головка во время самых сильных схваток."
                            }
                        }
                    ],
                    "common_phrases": [
                        "baby crowning"
                    ],
                    "target_lang_definitions": {
                        "ru": "О моменте родов: когда головка ребенка показывается в родовых путях."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проре́зываться",
                                "target_lang_sense_clarification": "о головке ребенка при родах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a1512a58-ebca-3ad7-965f-33f2710e811d",
                    "sense_definition": "To hit someone on the head.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "violence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He almost <w>crowned</w> the intruder with a heavy frying pan.",
                            "target_lang_translations": {
                                "ru": "Он чуть не <w>дал по башке</w> незваному гостю тяжелой сковородой."
                            }
                        },
                        {
                            "text": "The boy was <w>crowned</w> with a ball during the game.",
                            "target_lang_translations": {
                                "ru": "Мальчику <w>заехали</w> мячом по голове во время игры."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal usage for hitting someone"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ударить кого-либо по голове."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дать по башке́",
                                "target_lang_sense_clarification": "грубо-разговорное: ударить по голове"
                            },
                            {
                                "target_lang_word": "сту́кнуть по голове́",
                                "target_lang_sense_clarification": "ударить в область макушки"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "310a7168-57c2-3cc4-a7cc-6a81c01c888a",
                    "sense_definition": "The sovereign or the government of a monarchy.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "government",
                    "name_type": "organization_name",
                    "examples": [
                        {
