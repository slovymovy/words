                    {
                        "sense_id": "8432601b-7d31-3b7e-9ada-0fd3e0117644",
                        "entry_id": "be19b666-3d5f-3718-946f-ba09685be75b",
                        "glosses": [
                            "Brücke, die als vorläufiger Ersatz für eine noch fertigzustellende/wiederherzustellende Brücke eingesetzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "489d9ff0-1131-4a8d-b7e8-be742d421da8",
                                "sense_id": "8432601b-7d31-3b7e-9ada-0fd3e0117644",
                                "text": "„Auf den vor 1945 den Linien 7 und 8 vorbehaltenen Gleisen in der Emil-Schüller-Straße pendelte eine Zeitlang die »neue« Linie 2, als Verbindung zwischen Hauptbahnhof und der provisorischen, anfangs nur zu Fuß zu passierenden Notbrücke über den Rhein.“"
                            },
                            {
                                "example_id": "983b4960-4991-4777-9236-85f3fa7bda5c",
                                "sense_id": "8432601b-7d31-3b7e-9ada-0fd3e0117644",
                                "text": "„Wir gingen auf einer schmalen Notbrücke über einen kleinen Fluss.“"
                            }
                        ],
