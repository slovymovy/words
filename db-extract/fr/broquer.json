                "senses": [
                    {
                        "sense_id": "7bbfb6bc-fb4c-32fd-94c3-4ae0dfba687b",
                        "entry_id": "dcf5447e-4470-36ae-be86-891872072153",
                        "glosses": [
                            "Percer un petit poisson avec l'hameçon, pour servir d'amorce. ^([1 & 2])"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "a2efcf65-519e-4fb7-866c-912c1a7e5423",
                                "sense_id": "7bbfb6bc-fb4c-32fd-94c3-4ae0dfba687b",
                                "text": "Quand on se sert de ces menises pour amorcer les haims , comme la plupart sont petits, on est presque toujours obligé de les broquer par les yeux, ce qui me fait soupçonner que ce sont les mêmes poissons qu'on nomme ailleurs œillets."
                            }
                        ]
                    },
                    {
                        "sense_id": "30fe9a6c-5870-3a45-9656-7ab2fe09f8e6",
                        "entry_id": "dcf5447e-4470-36ae-be86-891872072153",
                        "glosses": [
                            "Manger ; croquer. ^([3])"
                        ],
                        "tags": [
                            "Lorraine"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "d26c8711-aac0-328f-a28f-b874fc183a70",
                        "entry_id": "dcf5447e-4470-36ae-be86-891872072153",
                        "glosses": [
                            "Épuiser quelqu'un ; lui sucer son argent ; le ruiner.  ^([4])"
                        ],
                        "tags": [
                            "Louisiane"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "8c8f8cec-dd98-37b3-807f-eafb57626ede",
                        "entry_id": "dcf5447e-4470-36ae-be86-891872072153",
                        "glosses": [
                            "Se précipiter, souvent avec de mauvaises intentions.  ^([5])"
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "6a4c1012-fbf7-3cc8-88a2-19553f45fb44",
                        "entry_id": "dcf5447e-4470-36ae-be86-891872072153",
                        "glosses": [
                            "Pointer , poindre ou commencer à se montrer en parlant du blé qui lève ou d'une dent qui perce à un enfant. ^([6])"
                        ],
                        "tags": [
                            "Picardie"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "bc311f57-dac9-3611-ace9-91c3e82643dc",
                        "entry_id": "dcf5447e-4470-36ae-be86-891872072153",
                        "glosses": [
                            "Braquer ; broyer le chanvre ou le lin.  ^([7])"
                        ],
                        "tags": [
                            "Département de la Meuse"
                        ],
                        "examples": [
                            {
                                "example_id": "f94873ec-0184-498a-b525-b9d1d48b874a",
                                "sense_id": "bc311f57-dac9-3611-ace9-91c3e82643dc",
                                "text": "A ses moments de loisir, pendant l’hiver, elle « broquait » le lin récolté, le « shréhait », le filait."
                            }
                        ]
                    },
