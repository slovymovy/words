                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "calmness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В лесу сегодня было удивительно тихо и <w>спокойно</w>.",
