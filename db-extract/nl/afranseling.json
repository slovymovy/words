                                    },
                                    {
                                        "sense_id": "15cb2553-91d2-3a2e-ba00-4589a3e7dbd3",
                                        "entry_id": "d09b648f-6d0b-3790-852a-00e108428016",
                                        "glosses": [
                                            "To move in a rolling, cumbersome manner; to waddle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b721ba2c-1134-4490-9c0c-1ba2fc3bad04",
                                                "sense_id": "15cb2553-91d2-3a2e-ba00-4589a3e7dbd3",
                                                "text": "Saluting the far loin of his mare[…]with an energy that made all his accoutrements wallop."
                                            },
