                        "sense_id": "3eaf0354-d69e-37dd-ad60-d5558b71c33f",
                        "entry_id": "e188f5d5-4cad-382c-975e-cea6931608d1",
                        "glosses": [
                            "een taal die is ontstaan doordat bevolkingsgroepen die twee verschillende talen spraken met elkaar in contact kwamen en een nieuwe taal ontwikkelden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a3058cc-b085-477b-a2a9-6c8b5cda1c50",
                                "sense_id": "3eaf0354-d69e-37dd-ad60-d5558b71c33f",
                                "text": "In zekere zin kan misschien ook het Afrikaans als een creooltaal worden bestempeld."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "01252316-4c38-4272-acc6-0de77e2d7c5b",
                        "source_entry_id": "e188f5d5-4cad-382c-975e-cea6931608d1",
                        "source_sense_id": "3eaf0354-d69e-37dd-ad60-d5558b71c33f",
                        "source_sense_description": "een taal die is ontstaan doordat bevolkingsgroepen die twee verschillende talen spraken met elkaar in contact kwamen en een nieuwe taal ontwikkelden",
                        "target_lang_word": "Kreolsprache",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kreolsprache",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3eb95eaa-ffd3-3e69-b688-fe771d66597c",
                                        "entry_id": "2826deae-c60a-3d98-80b1-b1559cdccc01",
                                        "glosses": [
                                            "„Pidgin, das zur Muttersprache einer Gemeinschaft geworden ist“. Die Kreolsprache muss dazu in Wortschatz und Grammatik weiter entwickelt sein als eine Pidgin-Sprache. Kreolsprachen können aber auch ohne die vorhergehende Phase einer Pidginsprache entstehen."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "22a50a77-7643-43c2-b712-a87ae78f07c0",
                                                "sense_id": "3eb95eaa-ffd3-3e69-b688-fe771d66597c",
                                                "text": "„1969 wurde das Neue Testament in die neomelanische Kreolsprache übersetzt, was die Tauglichkeit dieser Sprache unter Beweis stellt.“"
                                            },
                                            {
                                                "example_id": "8c4bd27e-4993-4412-abdc-516eb8122c93",
                                                "sense_id": "3eb95eaa-ffd3-3e69-b688-fe771d66597c",
                                                "text": "Bei Crystal findet man eine Liste von 100 Pidgin- und Kreolsprachen."
                                            },
                                            {
                                                "example_id": "4ecab230-0ceb-4ab2-8d8c-9a4fefe7156b",
                                                "sense_id": "3eb95eaa-ffd3-3e69-b688-fe771d66597c",
                                                "text": "„Als Kreolsprache wurde bisher in der Regel bezeichnet eine ehemalige Pidginsprache, die zur Muttersprache mindestens eines Teiles ihrer Sprecher geworden ist.“"
                                            },
                                            {
                                                "example_id": "f37e9647-b4a1-4ca3-8f78-fd4684c1e54d",
                                                "sense_id": "3eb95eaa-ffd3-3e69-b688-fe771d66597c",
                                                "text": "„Unserdeutsch gilt als die einzige Kreolsprache, die das Deutsche hervorgebracht hat, eine Mischung der Sprachen von Kolonialherren und Einheimischen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
