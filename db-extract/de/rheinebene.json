                                "example_id": "53a35cf2-a996-4ea6-b50a-125c63bc09ef",
                                "sense_id": "f3e6c0e9-a9ce-34e2-9c58-81a0210911a0",
                                "text": "„Jedes Mal, wenn ich nach Straßburg zurückkehre und die Turmspitze des Münsters sehe, die den Himmel über der Rheinebene zerschneidet, habe ich Tränen in den Augen.“"
                            },
                            {
                                "example_id": "96db0714-a040-430f-bfce-34a8b6e30351",
                                "sense_id": "f3e6c0e9-a9ce-34e2-9c58-81a0210911a0",
                                "text": "„Die Rheinebene, auch Oberrheinische Tiefebene genannt, erstreckt sich über 300 Kilometer von Hessen im Norden bis nach Basel im Süden.“"
                            }
                        ],
