                "senses": [
                    {
                        "sense_id": "7436abc9-3fdb-3c81-84c8-f626e7ae7554",
                        "entry_id": "4d71b11d-30b7-3633-b6b6-83ea19d65951",
                        "glosses": [
                            "Zahnmedizin: Tuch aus Gummi oder Kunststoff zur Abschirmung von zu behandelnden Zähnen vom restlichen Mundraum"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8a699fd-f0c8-4ddf-9af3-cd7520ed47ae",
                                "sense_id": "7436abc9-3fdb-3c81-84c8-f626e7ae7554",
                                "text": "Die Erfindung des Kofferdams wird dem amerikanischen Zahnarzt Sanford Christie Barnum (1838–1885) zugeschrieben."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "799b2e46-94e5-3673-a89c-d2534d82a42b",
                        "entry_id": "4d71b11d-30b7-3633-b6b6-83ea19d65951",
                        "glosses": [
                            "Prävention: Folie, die über die Vulva oder den After des Sexualpartners gelegt wird, um die Ansteckung mit HIV oder Geschlechtskrankheiten beim Oralverkehr zu vermeiden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc38e6b3-3bd4-4e45-9e54-6d3bb1bafbd3",
                                "sense_id": "799b2e46-94e5-3673-a89c-d2534d82a42b",
                                "text": "Kofferdam, besser bekannt als „Lecktuch\" (engl. „dental dam\"), ist besonders bei lesbischen Frauen sehr verbreitet."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4540897f-d18a-4220-9291-7718cc199b92",
                        "source_entry_id": "4d71b11d-30b7-3633-b6b6-83ea19d65951",
                        "source_sense_id": "7436abc9-3fdb-3c81-84c8-f626e7ae7554",
                        "target_lang_word": "cofferdam",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cofferdam",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3835ec2c-3faa-31f4-ba4e-dd3d43a4966a",
                                        "entry_id": "bf52ce60-983b-3724-8153-f2f4f17d7050",
                                        "glosses": [
                                            "A temporary watertight enclosure used to create a dry foundation for building bridges and other structures over water."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8395ccfb-456a-461b-b155-909244e2cdf1",
                                                "sense_id": "3835ec2c-3faa-31f4-ba4e-dd3d43a4966a",
                                                "text": "He stood full six feet in height, with noble shoulders, and a chest like a coffer-dam."
                                            },
                                            {
                                                "example_id": "8747c4f7-0140-4b4d-819f-45efd5eb2731",
                                                "sense_id": "3835ec2c-3faa-31f4-ba4e-dd3d43a4966a",
                                                "text": "Downstream there was a small wooden cofferdam and when he woke there were naked children splashing in the pool there and he rose and wrapped his jacket about his waist and walked out along the bank where he could sit and watch them."
                                            },
                                            {
                                                "example_id": "c5d7a231-8ecb-4c56-aa21-e1e3482703d7",
                                                "sense_id": "3835ec2c-3faa-31f4-ba4e-dd3d43a4966a",
                                                "text": "At fixed injection volume of PVC gels solution, the curvature of MLAs [(microlens arrays)] obtained with patterned electrode substrates at fixed sizes of cofferdam can be tuned by changing the preparation voltage."
                                            },
                                            {
                                                "example_id": "51c1e8ad-5ae8-47e8-8985-0122e2ea7319",
                                                "sense_id": "3835ec2c-3faa-31f4-ba4e-dd3d43a4966a",
                                                "text": "Where the viaduct crosses the lake, the piles will be bored directly into the lakebed, using a cofferdam to hold back the water while the pier is built."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bb3d7ea8-cb9a-30e2-90da-40bd1319d16f",
                                        "entry_id": "bf52ce60-983b-3724-8153-f2f4f17d7050",
                                        "glosses": [
                                            "An empty space that acts as a protective barrier between two floors or bulkheads on a ship."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e2eb6607-6d4f-36e1-bb31-f933f008102d",
                                        "entry_id": "bf52ce60-983b-3724-8153-f2f4f17d7050",
                                        "glosses": [
                                            "A rubber dam to keep the teeth dry when operating upon them."
                                        ],
                                        "tags": [
                                            "New-York"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df95c43f-6c8c-4db1-b23e-c8f6b3e75d74",
                                                "sense_id": "e2eb6607-6d4f-36e1-bb31-f933f008102d",
                                                "text": "I refer to Dr. Barnum, who has given us the coffer-dam. I cannot detain you while I describe the immense benefit which his application of a very simple material has conferred on the public."
                                            },
                                            {
                                                "example_id": "2b13dff0-5e7d-40d1-8f51-08e29e4d8145",
                                                "sense_id": "e2eb6607-6d4f-36e1-bb31-f933f008102d",
                                                "text": "Dr. La Roche then first we are informed made the claim that he knew of and used rubber for a coffer dam prior to Barnum."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "689ef3de-10db-4ef2-83d2-f2cc5f6a7b0e",
                        "source_entry_id": "4d71b11d-30b7-3633-b6b6-83ea19d65951",
