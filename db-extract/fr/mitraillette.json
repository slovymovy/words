        "fr-extract.jsonl": [
            {
                "entry_id": "e0d6e6b8-449d-3c26-ac3b-efc6e9818a3f",
                "word": "mitraillette",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "6777fd7f-2da5-4baf-9143-a5c11be71ec1",
                        "entry_id": "e0d6e6b8-449d-3c26-ac3b-efc6e9818a3f",
                        "tags": [
                            "plural"
                        ],
                        "form": "mitraillettes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3a79efb5-2c7f-307a-8060-385fe6c16694",
                        "entry_id": "e0d6e6b8-449d-3c26-ac3b-efc6e9818a3f",
                        "glosses": [
                            "Pistolet-mitrailleur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a94d6b6a-69d3-4d4a-ae31-5df5055c69ba",
                                "sense_id": "3a79efb5-2c7f-307a-8060-385fe6c16694",
                                "text": "Le para était à côté de moi : le canon de sa mitraillette me heurtait les côtes : « Il y en a un bon tas là-dedans pour vous, si vous faites le con. »"
                            },
                            {
                                "example_id": "46217ed8-3212-48b9-b0f5-07aff8025c5a",
                                "sense_id": "3a79efb5-2c7f-307a-8060-385fe6c16694",
                                "text": "Sus à l’ennemi ! Aurèle sonne le hallali. Tout à l’heure, il pensait rafale de mitraillette, sulfatage, pruneaux. Mais la balle de métal est trop noble : par elle meurent les héros."
                            },
                            {
                                "example_id": "ea9becfb-be31-40e7-8254-b947c3939105",
                                "sense_id": "3a79efb5-2c7f-307a-8060-385fe6c16694",
                                "text": "Tout se passe rapidement, les Allemands fouillent le véhicule, ainsi que les deux officiers et découvrent alors, dans le portefeuille du capitaine Mulsant, une notice explicative sur le fonctionnement de la mitraillette « Sten »."
                            },
                            {
                                "example_id": "b0d60f01-dbb5-4060-b96d-ad50a590df92",
                                "sense_id": "3a79efb5-2c7f-307a-8060-385fe6c16694",
                                "text": "La franchise d’Activision s’est imposée comme une référence absolue à coups de shoots en pleine tête des soldats nazis, et de rafales de mitraillettes sur des troupes communistes."
                            }
                        ]
                    },
                    {
                        "sense_id": "cf9f7a1c-506c-39f2-a08b-6bebc869dc26",
                        "entry_id": "e0d6e6b8-449d-3c26-ac3b-efc6e9818a3f",
                        "glosses": [
                            "Demi-baguette dans laquelle on met des frites, une viande cuite à la friture et éventuellement de la sauce."
                        ],
                        "tags": [
                            "Belgique"
                        ],
                        "examples": [
                            {
                                "example_id": "dcc5a7e8-e732-47f8-915c-8a70dd29742e",
                                "sense_id": "cf9f7a1c-506c-39f2-a08b-6bebc869dc26",
                                "text": "Il a commandé une mitraillette fricadelle, une mitraillette avec fricadelle."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "714ee909-ec9c-4918-9387-32b578bd68e9",
                        "source_entry_id": "e0d6e6b8-449d-3c26-ac3b-efc6e9818a3f",
                        "source_sense_description": "pistolet-mitrailleur",
                        "target_lang_word": "Maschinenpistole",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Maschinenpistole",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "db585472-6fea-34ac-bfa3-b86e5b368f03",
                                        "entry_id": "f6ea9a0d-f2dd-3484-93ae-e42515a41ef5",
                                        "glosses": [
                                            "vollautomatische Handfeuerwaffe mit geringer Masse und kurzem Lauf"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2806774-a827-4e47-9ff3-9d0af8bc8b5d",
                                                "sense_id": "db585472-6fea-34ac-bfa3-b86e5b368f03",
                                                "text": "Die Polizisten schossen mit ihren Maschinenpistolen auf die Demonstranten."
                                            },
                                            {
                                                "example_id": "86b26425-451a-41d9-bc94-680824bf78e0",
                                                "sense_id": "db585472-6fea-34ac-bfa3-b86e5b368f03",
                                                "text": "„Zudem konnte schon bald jeder von uns die an Bord mitgeführten Handfeuerwaffen wie Maschinengewehre oder Maschinenpistolen fast schon mit verbundenen Augen zerlegen und pflegen.“"
                                            },
                                            {
                                                "example_id": "ce0c712f-1460-48e2-81f3-222b2ab3c6da",
                                                "sense_id": "db585472-6fea-34ac-bfa3-b86e5b368f03",
                                                "text": "„Hinter ihm treten ein paar Männer in einem seltsamen Aufzug mit Maschinenpistolen aus dem Gebüsch.“"
                                            },
                                            {
                                                "example_id": "bcfd15f4-0ffa-4a59-955b-b68c8d4648dd",
                                                "sense_id": "db585472-6fea-34ac-bfa3-b86e5b368f03",
                                                "text": "„Ich bekam meine Maschinenpistole.“"
                                            },
                                            {
                                                "example_id": "331e4a28-2f4c-4b5c-842a-45acf8180a71",
                                                "sense_id": "db585472-6fea-34ac-bfa3-b86e5b368f03",
                                                "text": "„Und kein Cherubim mit dem bloßen, hauenden Schwert, kein Russe mit seiner Maschinenpistole verwehrt den Zutritt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "314f51a6-1bf7-4730-9f2a-de7a803d4777",
                        "source_entry_id": "e0d6e6b8-449d-3c26-ac3b-efc6e9818a3f",
