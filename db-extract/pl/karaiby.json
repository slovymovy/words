                        "target_lang_word": "Caraïbe",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Caraïbe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6cfe6fcc-8580-38e7-8479-9d94f6fb7008",
                                        "entry_id": "70bfe9e1-81ff-3415-a5af-7c3203b23a73",
                                        "glosses": [
                                            "Membre du peuple des Caraïbes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "701717e9-5c7e-441d-b025-634afeec74a7",
                                                "sense_id": "6cfe6fcc-8580-38e7-8479-9d94f6fb7008",
                                                "text": "Balmaseda, Cabrera, Palillos et autres chefs de bande plus ou moins importants reviennent à toute minute sur le tapis ; on en conte des choses à faire frémir, des cruautés passées de mode et regardées depuis longtemps comme de mauvais goût par les Caraïbes et les Cherokees."
                                            },
                                            {
                                                "example_id": "dac4d001-616b-4e34-a253-9a8dc5a31a3f",
                                                "sense_id": "6cfe6fcc-8580-38e7-8479-9d94f6fb7008",
                                                "text": "Le joueur de flûte lui décocha un petit regard bleu clair, empoisonné comme une flèche de Caraïbe."
                                            },
                                            {
                                                "example_id": "c08ab251-cbd5-4152-b437-26723992e38f",
                                                "sense_id": "6cfe6fcc-8580-38e7-8479-9d94f6fb7008",
                                                "text": "Cette forme naturelle dans le principe a dû être exagérée par l’habitude qu’avaient quelques-uns de ces peuples de déformer le crâne des nouveaux-nés par des moyens artificiels. Parmi ces peuples, nous citerons ceux qui appartenaient au groupe Colhuaque ou Maya, les Colhuaques, Yucatèques, Guatémaliens, Nicaraguayens, Honduréniens, Costaricains, Aymaras, Caraïbes, tandis que les Mexicains et tous ceux du groupe Nahuatl avaient le crâne normal."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Caraïbe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cbb1b02f-d958-3e10-a8c7-5af5f4993769",
                                        "entry_id": "1570260a-81ca-3796-833d-3fe4ab9a27d0",
                                        "glosses": [
                                            "Variante de Caraïbes."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e1a80c1-5130-4766-8120-628b53cd711f",
                                                "sense_id": "cbb1b02f-d958-3e10-a8c7-5af5f4993769",
                                                "text": "Le cachiman serait originaire de Colombie et du Venezuela, il peuple maintenant tout le bassin de la Caraïbe."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9b8074a1-8d5a-4ab0-94ac-c847383b0c96",
                        "source_entry_id": "161badca-922b-3947-9c4d-6d80ba527a76",
                        "source_sense_id": "dcfbe5c9-3e7a-37dd-9e98-5299aab2824f",
                        "target_lang_word": "Karibik",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Karibik",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "36eecee4-5141-3cf8-9db6-60320f228df4",
                                        "entry_id": "803b247f-f02b-334b-a6e3-011dc699e46a",
                                        "glosses": [
                                            "südöstlicher Teil des Amerikanischen Mittelmeers mit der Inselwelt dieses Meeres"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d368d4b-329d-4c32-8b00-c6832433452b",
                                                "sense_id": "36eecee4-5141-3cf8-9db6-60320f228df4",
                                                "text": "Sie sind auf einer Kreuzfahrt in die Karibik."
                                            },
                                            {
                                                "example_id": "3e805b20-19f7-4231-b624-f98569ea7a25",
                                                "sense_id": "36eecee4-5141-3cf8-9db6-60320f228df4",
                                                "text": "Viele internationale Popstars stammen aus der Karibik."
                                            },
                                            {
                                                "example_id": "c634e37d-411e-4253-b474-ad85f3764f6d",
                                                "sense_id": "36eecee4-5141-3cf8-9db6-60320f228df4",
                                                "text": "„Zuvor waren gut 150 Jahre lang aus den Mutterländern Europas immer neue Gruppen von Abenteurern in die Karibik geströmt.“"
                                            },
                                            {
                                                "example_id": "ae9139e9-ab1f-4595-b392-9e2b8fc3b5c0",
                                                "sense_id": "36eecee4-5141-3cf8-9db6-60320f228df4",
                                                "text": "„Die Urbevölkerung war bereits von den Spaniern vertrieben oder versklavt und in die spanischen Kolonien der Karibik verschleppt worden.“"
                                            },
                                            {
                                                "example_id": "7f8704ff-9922-4706-8427-1fb0c421e459",
                                                "sense_id": "36eecee4-5141-3cf8-9db6-60320f228df4",
                                                "text": "„Doch die Welser waren unerfahren, und andere hatten den Markt in der Karibik bereits unter sich aufgeteilt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
