                                        "entry_id": "d6526a21-9554-340e-b23a-b8922c57bb62",
                                        "glosses": [
                                            "An allusion to something by denying that it will be mentioned."
                                        ],
                                        "tags": [
                                            "countable",
                                            "rhetoric",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b8d78233-4b49-4a68-8333-3dfc7a315181",
                                                "sense_id": "e2ac13a6-44ef-3800-aa4d-fc4a5bb7abbd",
                                                "text": "Apophasis, affecting to conceal;\nWhat it would seem to hide, will yet reveal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e486983f-8618-391d-9272-76111b5e1763",
                                        "entry_id": "d6526a21-9554-340e-b23a-b8922c57bb62",
                                        "glosses": [
                                            "A process of arriving at knowledge by statements of denial; particularly, developing a concept of God through negative assertions about his nature."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
