{
    "word_family": [
        "deceive",
        "deceitful",
        "deceitfully",
        "deceitfulness",
        "deceiver"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "113fbae6-66ad-39c9-8353-931726517bf1",
                    "sense_definition": "The quality or practice of deceiving someone; dishonesty or misrepresentation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "deceit_concept",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He gained their trust through practiced <w>deceit</w> and lies. \n",
                            "target_lang_translations": {
                                "pl": "Zyskał ich zaufanie poprzez wypracowane <w>oszustwo</w> i kłamstwa."
                            }
                        },
                        {
                            "text": "A web of <w>deceit</w> surrounded his financial dealings for years.",
                            "target_lang_translations": {
                                "pl": "Pajęczyna <w>fałszu</w> otaczała jego interesy finansowe przez lata."
                            }
                        }
                    ],
                    "synonyms": [
                        "deception",
                        "deceitfulness",
                        "deceptiveness",
                        "underhandedness"
                    ],
                    "common_phrases": [
                        "web of deceit",
                        "practiced deceit"
                    ],
                    "target_lang_definitions": {
                        "pl": "Jakość lub praktyka okłamywania kogoś; nieuczciwość lub wprowadzanie w błąd."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "oszustwo",
                                "target_lang_sense_clarification": "działanie lub cecha polegająca na okłamywaniu"
                            },
                            {
                                "target_lang_word": "fałsz",
                                "target_lang_sense_clarification": "brak szczerości, nieuczciwość"
                            },
                            {
                                "target_lang_word": "obłuda",
                                "target_lang_sense_clarification": "zakłamanie i nieszczerość"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e62ff7b8-8ba9-386b-b8ca-d3e269b0e008",
                    "sense_definition": "An action, statement, or trick intended to deceive someone.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "deceit_concept",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His promise to return the money was a total <w>deceit</w>.",
                            "target_lang_translations": {
                                "pl": "Jego obietnica zwrotu pieniędzy była całkowitym <w>podstępem</w>."
                            }
                        },
                        {
                            "text": "She exposed his latest <w>deceit</w> before any damage could be done.",
                            "target_lang_translations": {
                                "pl": "Ujawniła jego najnowszy <w>podstęp</w>, zanim doszło do jakichkolwiek szkód."
                            }
                        }
                    ],
                    "synonyms": [
                        "trick",
                        "fraud",
                        "deception",
                        "trickery"
                    ],
                    "common_phrases": [
                        "clever deceit"
                    ],
                    "target_lang_definitions": {
                        "pl": "Działanie, wypowiedź lub podstęp mający na celu wprowadzenie kogoś w błąd."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "podstęp",
                                "target_lang_sense_clarification": "przemyślane działanie mające na celu oszukanie kogoś"
                            },
                            {
                                "target_lang_word": "oszustwo",
                                "target_lang_sense_clarification": "konkretny czyn mający wprowadzić w błąd"
                            },
                            {
                                "target_lang_word": "krętactwo",
                                "target_lang_sense_clarification": "krętackie lub nieszczere zachowanie"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d6f0d8c4-8311-3986-ae3e-df267aef750b",
                    "sense_definition": "A tort involving a fraudulent representation made knowingly or recklessly to induce reliance, causing injury to the victim.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The victim sued the company for the tort of <w>deceit</w> after losing his savings.",
                            "target_lang_translations": {
                                "pl": "Ofiara pozwała firmę o delikt <w>celowego wprowadzenia w błąd</w> po utracie swoich oszczędności."
                            }
                        },
                        {
                            "text": "Proving intentional <w>deceit</w> in a court of law requires strong evidence.",
                            "target_lang_translations": {
                                "pl": "Udowodnienie celowego <w>oszustwa</w> przed sądem wymaga mocnych dowodów."
                            }
                        }
                    ],
                    "synonyms": [
                        "fraud",
                        "fraudulence"
                    ],
                    "common_phrases": [
                        "action for deceit",
                        "tort of deceit"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "In legal contexts, often used formally in common law jurisdiction."
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Delikt polegający na świadomym lub lekkomyślnym wprowadzeniu w błąd w celu wywołania określonego działania, co skutkuje szkodą dla ofiary."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "celowe wprowadzenie w błąd",
                                "target_lang_sense_clarification": "pojęcie prawne określające umyślne oszustwo"
                            },
                            {
                                "target_lang_word": "oszustwo",
                                "target_lang_sense_clarification": "przestępstwo lub delikt polegający na wyłudzeniu lub wprowadzeniu w błąd"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}