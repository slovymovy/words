                        "glosses": [
                            "армянская фамилия"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89a78f56-4056-40dd-b386-166224861cd8",
                                "sense_id": "d126312d-4a17-3829-8924-3fce33c2f574",
                                "text": "Полузащитник сборной Армении и донецкого «Шахтёра» Генрих Мхитарян, признанный лучшим футболистом последнего чемпионата Украины, вероятно продолжит карьеру в рядах дортмундской «Боруссии»."
                            },
                            {
                                "example_id": "3485b7fe-7bec-4ed1-b310-aec056443b80",
                                "sense_id": "d126312d-4a17-3829-8924-3fce33c2f574",
                                "text": "Особенно опасной выглядит атакующая линия армян. Знакомые российским болельщикам по выступлениям за «Спартак» Юра Мовсисян и Араз Озбилиз плюс сильнейший на сегодняшний день полузащитник постсоветского пространства и звезда дортмундской «Боруссии» Генрих Мхитарян."
                            }
                        ]
                    }
