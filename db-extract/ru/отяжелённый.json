                "senses": [
                    {
                        "sense_id": "4774347a-5c44-3895-b591-589074e0f5a9",
                        "entry_id": "2545324b-7721-3f31-a46b-a91466cea933",
                        "glosses": [
                            "страд. прич. прош. вр. от отяжелить"
                        ],
                        "tags": [
                            "participle"
                        ],
                        "examples": [
                            {
                                "example_id": "e4e44e9f-3568-4415-bba8-32b0a2e36fee",
                                "sense_id": "4774347a-5c44-3895-b591-589074e0f5a9",
                                "text": "Хладный пот оросил чело мое. Члены мои отяжелены, как бревна дубовые."
                            },
                            {
                                "example_id": "07311452-d353-4c6a-8201-19ece19f11f8",
                                "sense_id": "4774347a-5c44-3895-b591-589074e0f5a9",
                                "text": "Барачные разбредались, глотая слюну, отяжелённые раздумьем и обидой."
                            },
                            {
                                "example_id": "e5298ca0-6b57-4fcb-8603-1f333986cd8b",
                                "sense_id": "4774347a-5c44-3895-b591-589074e0f5a9",
                                "text": "Расчёты показали, что мотор «Гермес» не потянет амфибии, отяжелённой усиленной броней."
                            }
                        ]
                    }
