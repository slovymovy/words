                    {
                        "translation_id": "203af2e0-449b-481b-9cf1-f67103b622e9",
                        "source_entry_id": "1696509f-9937-31e3-9418-23a7fba532c2",
                        "source_sense_description": "infant",
                        "target_lang_word": "Kleinkind",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
