                    {
                        "form_id": "be0adf6e-0749-4ae7-bbcb-b81a36d4d760",
                        "entry_id": "5bb26fa8-b851-39b1-bdd9-71d2bd5784bd",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Göre"
                    },
                    {
                        "form_id": "b624a1f2-6c28-4849-885b-e88eff7e8096",
                        "entry_id": "5bb26fa8-b851-39b1-bdd9-71d2bd5784bd",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Gören"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "246bdbc8-ecb4-3ce1-81bb-ffdac9bc9cf8",
                        "entry_id": "5bb26fa8-b851-39b1-bdd9-71d2bd5784bd",
                        "glosses": [
                            "Nebenform zu Gör: „(ungezogenes) kleines weibliches Kind“"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3115effe-476e-45b6-bf6a-a4a778b3e90f",
                                "sense_id": "246bdbc8-ecb4-3ce1-81bb-ffdac9bc9cf8",
                                "text": "„Ein Mädchen, Stulpenstiefel, Bubikopf und Baskenmütze, ganz Typ Berliner Göre, erstattet Anzeige auf einer Berliner Polizeiwache.“"
                            },
                            {
                                "example_id": "6819f559-0e82-47a6-892d-ef17ff9fcccf",
                                "sense_id": "246bdbc8-ecb4-3ce1-81bb-ffdac9bc9cf8",
                                "text": "„Karin schien zwar die Ruhe selbst, nur ihr Atem ging kurz und aufgeregt, die Ruhe vielleicht äußerlich, nur scheinbar, vielleicht hatte er sich die ganze Zeit getäuscht, vielleicht war die Gelassenheit der Göre nichts als Tarnung.“"
                            },
                            {
                                "example_id": "86bb28c4-5455-430c-8faa-50df984ca030",
                                "sense_id": "246bdbc8-ecb4-3ce1-81bb-ffdac9bc9cf8",
                                "text": "„Als berlinische Geschichte, die ihm bekannt wurde, führt Schöffler die Fragequengelei einer vierjährigen Göre in der Linie 154 an, die einem jungen Mann, ihrem Onkel, auf dem Schoß sitzt und ihn unerbittlich mit dummen Fragen in der Zange hält.“"
                            },
                            {
                                "example_id": "2d0fa3d3-fc16-4232-b9c8-e991a56c9fc7",
                                "sense_id": "246bdbc8-ecb4-3ce1-81bb-ffdac9bc9cf8",
                                "text": "„Oder er kann der diebischen Göre die Schaufel emport wegnehmen und ihr zeigen: Auf Kevin trampelt keiner rum.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
