                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4f8fc6c3-a229-4212-b42a-e156df855a65",
                                                "sense_id": "052797ad-410f-39c5-9a33-2b0a47c25750",
                                                "text": "„Die Walzmeister haben hier zirka 1,35 Mk. pro Schicht mehr als die Vor- und Fertigwalzer, der erste Ofenmann verdient zirka 90 Pf. pro Schicht mehr als der zweite und zirka 2 Mk. mehr als Stocher und Chargierer.“ (1912)"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
