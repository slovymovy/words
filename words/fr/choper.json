                    "frequency": "High",
                    "semantic_group_id": "capturer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le voleur essayait de fuir mais la police a fini par le <w>choper</w>."
                        },
                        {
                            "text": "Il a triché pendant l'examen et il s'est fait <w>choper</w> par le professeur."
                        }
                    ],
                    "synonyms": [
                        "arrêter",
                        "pogner"
                    ],
                    "common_phrases": [
                        "se faire choper"
                    ],
                    "traits": [
