                            }
                        },
                        {
                            "text": "Как <мило>, что вы вспомнили о моём дне рождения!",
                            "target_lang_translations": {
                                "en": "How <sweet> that you remembered my birthday!",
                                "nl": "Wat <lief> dat je aan mijn verjaardag hebt gedacht!",
                                "pl": "Jak <miło>, że pamiętaliście o moich urodzinach!",
                                "de": "Wie <süß>, dass Sie an meinen Geburtstag gedacht haben!",
                                "fr": "Comme c'est <adorable> que vous ayez pensé à mon anniversaire !",
                                "it": "Che <carino> da parte vostra ricordarvi del mio compleanno!",
                                "cs": "Jak <milé>, že jste si vzpomněli na mé narozeniny!",
