                    {
                        "sense_id": "45d37950-4849-3fbd-a251-0e602f6e6b24",
                        "entry_id": "3d499441-5690-36fb-a383-c7e352febc2c",
                        "glosses": [
                            "An academy; a place of learning."
                        ],
                        "tags": [
                            "poetic"
                        ],
                        "examples": [
                            {
                                "example_id": "a9d48fe7-3640-4df2-be66-9b3bc35b0505",
                                "sense_id": "45d37950-4849-3fbd-a251-0e602f6e6b24",
                                "text": "Navarre shall be the wonder of the world; / Our court shall be a little Academe,/ Still and contemplative in living art."
                            }
                        ]
                    },
                    {
                        "sense_id": "589c1aae-fd6e-35c2-a3e8-e689a2dda2a2",
                        "entry_id": "3d499441-5690-36fb-a383-c7e352febc2c",
                        "glosses": [
                            "The scholarly life, environment, or community."
