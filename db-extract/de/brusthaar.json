                "senses": [
                    {
                        "sense_id": "f831d8a2-87a9-3a0b-8858-4597d30d58ef",
                        "entry_id": "2ae6a280-aa70-325a-80f0-c91590848120",
                        "glosses": [
                            "Behaarung auf der Brust eines Mannes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ee5d661-acad-4b3e-8712-fa792b0ae63b",
                                "sense_id": "f831d8a2-87a9-3a0b-8858-4597d30d58ef",
                                "text": "Sieglinde mag es gar nicht, wenn ihr Mann sich das Brusthaar rasiert."
                            },
                            {
                                "example_id": "bb3142e1-2025-4812-9292-adeac3e7679a",
                                "sense_id": "f831d8a2-87a9-3a0b-8858-4597d30d58ef",
                                "text": "Aurelio ist stolz auf sein dichtes Brusthaar."
                            },
                            {
                                "example_id": "f0ce4cb6-10b5-4c21-a759-41054183b1e4",
                                "sense_id": "f831d8a2-87a9-3a0b-8858-4597d30d58ef",
                                "text": "Aus seinem Hemdkragen schauten einzelne Brusthaare hervor."
                            },
                            {
                                "example_id": "68d3a8e9-60cb-4e5c-941a-5d1fd2115c56",
                                "sense_id": "f831d8a2-87a9-3a0b-8858-4597d30d58ef",
                                "text": "„Es sind die Söhne der Besitzer, dunkel, die Brusthaare kräuseln sich über ihren Hemden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
