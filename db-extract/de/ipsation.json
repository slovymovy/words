                                                "example_id": "527170ba-79b3-44a8-a5df-6b1b4bcbab00",
                                                "sense_id": "f76bb967-b76e-3669-a2b0-bbe7eb667103",
                                                "text": "Но мастурбация у него может продолжаться."
                                            },
                                            {
                                                "example_id": "cd9c0c2e-1646-4e01-a6c5-62afb798f0bf",
                                                "sense_id": "f76bb967-b76e-3669-a2b0-bbe7eb667103",
