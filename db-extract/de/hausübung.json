                ],
                "senses": [
                    {
                        "sense_id": "adb33a2d-ab81-360d-9760-2b6a48c7b3f9",
                        "entry_id": "db725860-0b8b-3884-bb26-de311d3bc398",
                        "glosses": [
                            "Aufgabe, welche ein Lehrer Schülern aufgibt und in der Regel zu Hause gemacht werden soll"
                        ],
                        "tags": [
                            "Österr."
                        ],
                        "examples": [
                            {
                                "example_id": "29085893-8401-40c6-be60-3d1a0a651cb0",
                                "sense_id": "adb33a2d-ab81-360d-9760-2b6a48c7b3f9",
                                "text": "„Zur Ergänzung der Unterrichtsarbeit können den Schülern auch Hausübungen aufgetragen werden, die jedoch so vorzubereiten sind, daß sie von den Schülern ohne Hilfe anderer durchgeführt werden können.“"
                            },
                            {
                                "example_id": "06476400-1233-451e-8a3d-43ef601c5427",
                                "sense_id": "adb33a2d-ab81-360d-9760-2b6a48c7b3f9",
                                "text": "„Denn an der Sinnhaftigkeit von Hausübungen wird in der Gesellschaft nicht gezweifelt.“"
                            },
                            {
                                "example_id": "5151e898-3bea-4c28-bf2c-3ef189de6761",
                                "sense_id": "adb33a2d-ab81-360d-9760-2b6a48c7b3f9",
                                "text": "„Dabei räumt Kohler aber ein, dass die Qualität des Unterrichts nicht zwingend mit dem Zeitpunkt der Vergabe von Hausübungen in Verbindung stehe.“"
                            },
                            {
                                "example_id": "e375453a-f635-42cb-a07a-f88b7c1815b1",
                                "sense_id": "adb33a2d-ab81-360d-9760-2b6a48c7b3f9",
                                "text": "„Keine Hausübungen mehr: Das ist für Eltern als auch für Schulkinder praktisch unvorstellbar.“"
                            },
                            {
                                "example_id": "b5f3a755-d4bc-453b-8ef7-7f9fa519b3e9",
                                "sense_id": "adb33a2d-ab81-360d-9760-2b6a48c7b3f9",
                                "text": "„In beiden Schulen seien in Mathematik Hausübungen, wie das vorgelegte Hausübungsheft zeige, erbracht worden und der Beschwerdeführer habe sich am Unterricht interessiert gezeigt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
