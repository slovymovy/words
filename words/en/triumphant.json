{
    "word_family": [
        "triumph",
        "triumphantly",
        "triumphal"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "9c6cea57-6f71-3427-a7ce-79e6ebd3192e",
                    "sense_definition": "Having achieved victory or success in a contest or struggle.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "victory",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>triumphant</w> team returned home to a massive parade in the city center.",
                            "target_lang_translations": {
                                "zh": "<w>获胜的</w>队伍回到家乡，市中心举行了盛大的游行。"
                            }
                        },
                        {
                            "text": "She felt <w>triumphant</w> after finally finishing the difficult project on time.",
                            "target_lang_translations": {
                                "zh": "在终于按时完成那个困难的项目后，她感到非常<w>得意</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "victorious",
                        "successful"
                    ],
                    "antonyms": [
                        "defeated",
                        "beaten"
                    ],
                    "common_phrases": [
                        "emerge triumphant"
                    ],
                    "target_lang_definitions": {
                        "zh": "在竞争或斗争中取得胜利或成功的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "获胜的",
                                "target_lang_sense_clarification": "指在比赛或竞争中取得胜利的状态。"
                            },
                            {
                                "target_lang_word": "成功的",
                                "target_lang_sense_clarification": "指达成目标或取得成就的。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "13f593f4-bf1a-3aa5-8f32-8505a22455c2",
                    "sense_definition": "Showing great joy or pride because of a victory or success.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "victory",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A <w>triumphant</w> smile spread across his face when he heard the good news.",
                            "target_lang_translations": {
                                "zh": "当他听到好消息时，脸上露出了<w>得意洋洋的</w>笑容。"
                            }
                        },
                        {
                            "text": "The crowd gave a <w>triumphant</w> cheer as the final goal was scored.",
                            "target_lang_translations": {
                                "zh": "当最后一球踢进时，人群发出了<w>欢欣鼓舞的</w>欢呼声。"
                            }
                        }
                    ],
                    "synonyms": [
                        "exultant",
                        "jubilant"
                    ],
                    "common_phrases": [
                        "triumphant smile",
                        "triumphant cheer"
                    ],
                    "target_lang_definitions": {
                        "zh": "因胜利或成功而表现出极大的喜悦或自豪。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "得意洋洋的",
                                "target_lang_sense_clarification": "形容因成功而显得非常自豪和满足。"
                            },
                            {
                                "target_lang_word": "欢欣鼓舞的",
                                "target_lang_sense_clarification": "形容因胜利而感到非常兴奋和快乐。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "87f4412a-549f-3b03-bef4-5eb5da72fbcd",
                    "sense_definition": "Relating to or celebrating a victory.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "victory",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The band played a <w>triumphant</w> march to honor the returning soldiers.",
                            "target_lang_translations": {
                                "zh": "乐队演奏了一首<w>庆祝胜利的</w>进行曲，以向归来的士兵致敬。"
                            }
                        },
                        {
                            "text": "They held a <w>triumphant</w> ceremony to mark the end of the long war.",
                            "target_lang_translations": {
                                "zh": "他们举行了一场<w>庆祝胜利的</w>仪式，以纪念漫长战争的结束。"
                            }
                        }
                    ],
                    "synonyms": [
                        "triumphal",
                        "celebratory"
                    ],
                    "common_phrases": [
                        "triumphant march"
                    ],
                    "target_lang_definitions": {
                        "zh": "与胜利有关的或用于庆祝胜利的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "庆祝胜利的",
                                "target_lang_sense_clarification": "用于描述仪式或活动旨在纪念胜利。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8f3316f3-4b73-37e6-88d2-27f44db2a9ce",
                    "sense_definition": "Very impressive, grand, or magnificent.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The architect designed a <w>triumphant</w> building that dominated the entire skyline.",
                            "target_lang_translations": {
                                "zh": "建筑师设计了一座<w>宏伟的</w>建筑，在整个天际线中显得格外突出。"
                            }
                        },
                        {
                            "text": "The opera performance was a <w>triumphant</w> display of artistic skill and passion.",
                            "target_lang_translations": {
                                "zh": "这场歌剧表演是艺术技巧与激情的<w>壮丽</w>展现。"
                            }
                        }
                    ],
                    "synonyms": [
                        "magnificent",
                        "splendid"
                    ],
                    "target_lang_definitions": {
                        "zh": "非常令人印象深刻、宏伟或壮丽的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "宏伟的",
                                "target_lang_sense_clarification": "形容建筑或表演规模巨大且壮观。"
                            },
                            {
                                "target_lang_word": "壮丽的",
                                "target_lang_sense_clarification": "形容事物极其出色且令人赞叹。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}