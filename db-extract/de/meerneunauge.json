                "senses": [
                    {
                        "sense_id": "bbb08579-f2db-3583-9af9-7406cf983368",
                        "entry_id": "18c917d2-29ec-3fbb-97a7-361db4afe28a",
                        "glosses": [
                            "ein aalähnlicher Fisch mit einem unpaaren Flossensaum und glatter, schuppenloser Haut sowie einem Knorpelskelett, der sich zum Laichen in den Unterlauf von Flüssen begibt"
                        ],
                        "tags": [
                            "Ichthyologie"
                        ],
                        "examples": [
                            {
                                "example_id": "12a5031e-1522-48ec-99d3-9ec0654fe8bd",
                                "sense_id": "bbb08579-f2db-3583-9af9-7406cf983368",
                                "text": "Das Meerneunauge wird bis zu einem Meter lang und 1,5 Kilogramm schwer. Es laicht im Unterlauf von Flüssen und wird besonders an der englischen und französischen Küste gefangen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
