                "senses": [
                    {
                        "sense_id": "2c9626f5-7209-34b1-86a8-0c624d00e931",
                        "entry_id": "9a84d133-fd76-30b2-a66f-c2a16e7546aa",
                        "glosses": [
                            "Dolch mit gekrümmter Klinge"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "566726a8-e3a5-407e-84fe-9c9a58dc7dc2",
                                "sense_id": "2c9626f5-7209-34b1-86a8-0c624d00e931",
                                "text": "„In McGraths Hand glänzte jedoch ein afghanischer Krummdolch, der ihm in zahllosen vergangenen Kämpfen bereits gute Dienste erwiesen hatte.“"
                            },
                            {
                                "example_id": "624a7c1d-8935-4794-b437-b30d5a1a1e03",
                                "sense_id": "2c9626f5-7209-34b1-86a8-0c624d00e931",
                                "text": "„Die Sperrung der Altstadt war aufgehoben, und wir durchstöberten sie nach billigen Klappmessern aus China. Sie hatten Holzgriffe, gemusterte Blecheinlagen und beängstigende Klingen wie die arabischen Krummdolche.“"
                            },
                            {
                                "example_id": "aefbab76-65f5-42b3-8d94-183322645c5e",
                                "sense_id": "2c9626f5-7209-34b1-86a8-0c624d00e931",
                                "text": "„Sein Krummdolch glitt in seine rechte Hand.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
