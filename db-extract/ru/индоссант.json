                                    {
                                        "sense_id": "5db529d1-d787-3cda-8520-59acc8dcddd8",
                                        "entry_id": "d8e7687d-47a9-3255-b160-d86f17a9baf3",
                                        "glosses": [
                                            "Personne au profit de laquelle est endossé un effet de commerce ou un chèque."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7964464b-1626-4c09-b569-1c935aa9de38",
                                                "sense_id": "5db529d1-d787-3cda-8520-59acc8dcddd8",
                                                "text": "L’ancien propriétaire (l’endosseur) peut néanmoins interdire à son endossataire d’endosser le titre à son tour."
                                            },
                                            {
                                                "example_id": "090d8cce-2b99-48c8-8f01-e9935cb18fac",
                                                "sense_id": "5db529d1-d787-3cda-8520-59acc8dcddd8",
                                                "text": "L’endossement permet à l’endosseur (une banque) d’encaisser le montant de l’effet de commerce."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6a877b1f-0f13-4ab1-a2a8-c613391d941e",
