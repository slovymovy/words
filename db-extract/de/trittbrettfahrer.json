                    },
                    {
                        "translation_id": "90eac4dc-dcc7-476b-b852-da818ccb69df",
                        "source_entry_id": "80f82984-8632-3ae1-afc3-897f94ebd3d2",
                        "source_sense_id": "a8633d8e-43b3-33af-84ea-769fc4ca45d8",
                        "source_sense_description": "Person, die ohne Anstrengung an Vorteilen teilhaben will",
                        "target_lang_word": "scroccone",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "scroccone",
                                "target_lang_code": "it",
                                "target_senses": [
                                    {
                                        "sense_id": "9eefa026-0744-3fb6-935c-f8ef698b3dc8",
                                        "entry_id": "c2d99432-de95-3e7e-b67a-65c71ee3663c",
