                                            {
                                                "example_id": "9c72b113-fac5-431b-a053-680faaf27a5d",
                                                "sense_id": "ebd73158-5828-37f6-a637-347162ac960a",
                                                "text": "I'm really impressed with how little Jesus monologed."
                                            },
                                            {
                                                "example_id": "3886461b-129e-4283-9647-460034a71bad",
                                                "sense_id": "ebd73158-5828-37f6-a637-347162ac960a",
                                                "text": "Instead of simply being broadcast to or monologed at, denizens of the virtual world are creating conversations and “hive minds” that produce truly collaborative experiences."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
