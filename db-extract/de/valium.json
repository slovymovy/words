                "senses": [
                    {
                        "sense_id": "56b73f5b-bca4-35f6-b4ae-ab6e69a9278f",
                        "entry_id": "5ea4b37b-ee79-3990-b195-d70bfeca1afa",
                        "glosses": [
                            "Handelsname des Arzneistoffs Diazepam"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ee376e3-f82f-4282-be8f-a973ad77de0e",
                                "sense_id": "56b73f5b-bca4-35f6-b4ae-ab6e69a9278f",
                                "text": "„Neal öffnete die Abdeckung über den Reglern für die Feineinstellung und entdeckte dort eingeklebtes Valium.“"
                            },
                            {
                                "example_id": "5f888794-b445-4bdc-9b1e-459ff7b7e9dc",
                                "sense_id": "56b73f5b-bca4-35f6-b4ae-ab6e69a9278f",
                                "text": "„›Ich habe sie vollgepumpt mit Thiamin und Valium. Das wird Ihnen beim Entzug helfen. Aber Sie müssen etwas essen‹, sagte er leise.“"
                            },
                            {
                                "example_id": "16639f52-4ffc-47fb-89be-4826752f657b",
                                "sense_id": "56b73f5b-bca4-35f6-b4ae-ab6e69a9278f",
                                "text": "„›Ich wollte eigentlich was zur Beruhigung. Xanax, Valium oder so. Die haben mir Scotch gebracht.‹“"
                            },
                            {
                                "example_id": "ae0c85b0-aa5b-4b7b-8fb9-8557f168c747",
                                "sense_id": "56b73f5b-bca4-35f6-b4ae-ab6e69a9278f",
                                "text": "„Am nächsten Morgen war Ron ziemlich verkatert, noch verstärkt durch das Meskalin und das Valium, das er beides regelmäßig konsumierte.“"
                            },
                            {
                                "example_id": "82350dfd-f580-4da3-91d8-30bb4828aac1",
                                "sense_id": "56b73f5b-bca4-35f6-b4ae-ab6e69a9278f",
                                "text": "„›Stattdessen‹, sagt er zu sich, ›haben wir Marihuana und Fernsehen. Bier und Valium.‹“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
