                    {
                        "sense_id": "dddfd2ff-1cbf-359e-bb5d-d1d4f5a0eda8",
                        "entry_id": "eeb6e1fd-1bbe-3e21-a212-ae97bdca483c",
                        "glosses": [
                            "Toute action bénévole et volontaire de terrain dans un but de préservation de l’environnement, de développement durable, de protection ou de la valorisation des espèces et des habitats naturels."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee92e786-c32d-479f-b233-a0cd56a40ca5",
                                "sense_id": "dddfd2ff-1cbf-359e-bb5d-d1d4f5a0eda8",
                                "text": "Destinée à l’époque à poursuivre ses études commerciales, mais passionnée de voyages « intelligents », Claire prend connaissance d’une association qui organise des missions d’écovolontariat de reboisement au Bénin."
                            },
                            {
                                "example_id": "de7bf773-c0d4-4e87-95b5-1de18f5ca9df",
                                "sense_id": "dddfd2ff-1cbf-359e-bb5d-d1d4f5a0eda8",
                                "text": "Depuis 2005, Cybelle Planète organise des missions d’écovolontariat en France et à l’étranger."
                            }
                        ]
                    }
