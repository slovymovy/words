                                        "entry_id": "594eda01-abc6-36f2-a80d-7d525828156d",
                                        "glosses": [
                                            "Stilrichtung in der modernen Kunst, in der natürliche Formen (zum Beispiel menschliche Körper) mit geometrischen Formen dargestellt werden"
                                        ],
                                        "tags": [
                                            "Bildende Kunst"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "589dc198-305c-442e-9239-ed24b1ff865d",
                                                "sense_id": "fd2dd393-f661-3989-89ce-f1fc3ab3b4c8",
                                                "text": "Pablo Picasso ist einer der bekanntesten Vertreter des Kubismus."
                                            },
                                            {
                                                "example_id": "9315055a-7ec9-47e3-894b-13b9cacc8428",
                                                "sense_id": "fd2dd393-f661-3989-89ce-f1fc3ab3b4c8",
                                                "text": "„Matisse habe die Begriffe Kubismus und Expressionismus erfunden, berichtet Däubler.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
