                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fb78e91f-1299-3f78-8caf-b41a50765a79",
                                        "entry_id": "5c7cc8da-327f-3990-a25d-e2aa48cb3720",
                                        "glosses": [
                                            "Troisième personne du singulier du subjonctif présent de chuter."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7f2d925d-4a35-3c60-aa0c-e93c94d6ddfc",
                                        "entry_id": "5c7cc8da-327f-3990-a25d-e2aa48cb3720",
