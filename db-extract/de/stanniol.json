                "senses": [
                    {
                        "sense_id": "47c64904-409f-31dc-ac13-82a0234daa0a",
                        "entry_id": "510a432e-95c9-3462-a199-43122383e930",
                        "glosses": [
                            "Folie aus Zinn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "343dc792-34b3-4b6f-a8ce-58c938aa9bf9",
                                "sense_id": "47c64904-409f-31dc-ac13-82a0234daa0a",
                                "text": "„Papierdünnes Aluminiumblech wird heute vielfach an Stelle von Stanniol zur Verpackung von Genußmitteln benutzt.“"
                            },
                            {
                                "example_id": "5d954153-1aa5-4421-8e38-2315395f0601",
                                "sense_id": "47c64904-409f-31dc-ac13-82a0234daa0a",
                                "text": "„Nicht nur, dass sich das klassische, aus Stanniol gefertigte Lametta als Weihnachtsaccessoire überlebt hat, es wird seit diesem Jahr auch nicht mehr hergestellt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "5828dbd2-5b7d-3e88-aaf1-d57d5e461980",
                        "entry_id": "510a432e-95c9-3462-a199-43122383e930",
                        "glosses": [
                            "Folie aus Aluminium"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5be2ed89-c48f-456d-8a7e-6fa1e37c5a06",
                                "sense_id": "5828dbd2-5b7d-3e88-aaf1-d57d5e461980",
                                "text": "Sie sammelte das Stanniol vom Schokoladeneinwickelpapier in einer Zigarrenkiste, nachdem sie es sorgfältig gebügelt hatte."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
