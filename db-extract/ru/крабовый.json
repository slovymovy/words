                ],
                "senses": [
                    {
                        "sense_id": "88555da3-1146-3c44-88d5-d48815c76595",
                        "entry_id": "f7db3108-7a57-35db-8b4b-cd014a563c8f",
                        "glosses": [
                            "связанный, соотносящийся по значению с существительным краб; свойственный, характерный для него"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "205f5ff2-ef34-49dd-af6e-c21f498ae18d",
                                "sense_id": "88555da3-1146-3c44-88d5-d48815c76595",
                                "text": "Мистер Краггс гулял, неся впереди, на животе, громадные крабовые клешни и опустив веки."
                            },
                            {
                                "example_id": "983c7990-2cb0-4b3d-85db-cd67ecbac4c5",
                                "sense_id": "88555da3-1146-3c44-88d5-d48815c76595",
                                "text": "Советский Союз по крабовому промыслу стоит на первом месте в мире."
                            }
                        ]
                    },
                    {
                        "sense_id": "967dacb4-b401-317c-a51c-996c06327c88",
                        "entry_id": "f7db3108-7a57-35db-8b4b-cd014a563c8f",
                        "glosses": [
                            "приготовленный из мяса крабов"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d67cdebe-de64-46d4-ade8-33116595b3f3",
                                "sense_id": "967dacb4-b401-317c-a51c-996c06327c88",
                                "text": "Целая колонна крабовых консервов возвышалась уже на подоконнике в комнате Софьи Петровны, под ногами скрипела крупа, и всё-таки ежедневно после службы она отправлялась закупать продукты ещё и ещё."
                            }
                        ]
                    }
                ],
