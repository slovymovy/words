                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "organization_name",
                    "examples": [
                        {
                            "text": "Many Australians use <w>NAB</w> for their personal banking and mortgage needs.",
                            "target_lang_translations": {
                                "cs": "Mnoho Australanů využívá <w>NAB</w> pro své osobní bankovnictví a hypotéky."
                            }
                        },
                        {
                            "text": "The <w>NAB</w> announced new interest rates for small business loans this morning.",
                            "target_lang_translations": {
                                "cs": "Banka <w>NAB</w> dnes ráno oznámila nové úrokové sazby pro úvěry malým podnikům."
                            }
                        }
