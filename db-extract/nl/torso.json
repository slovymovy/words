                        "sense_id": "9a3c9301-77ac-3972-ab49-ff144975a255",
                        "entry_id": "58d7195c-bb7b-38cd-aa29-987175e75884",
                        "glosses": [
                            "vaak klassiek beeld van een lichaam met alleen aanzetten van armen en benen en zonder hoofd"
                        ],
                        "tags": [
                            "beeldhouwen"
                        ],
                        "examples": [
                            {
                                "example_id": "2c91a05c-f6d7-4714-a5ea-7cce13810076",
                                "sense_id": "9a3c9301-77ac-3972-ab49-ff144975a255",
                                "text": "De torso van Belvédère kon in zijn fragmentarische volmaaktheid zelfs figureren in allegorieën van de Schone Kunsten als ‘de Sculptuur’."
                            }
                        ]
                    },
                    {
                        "sense_id": "5822b66c-bcc2-38d2-aa35-0407cff0cb79",
                        "entry_id": "58d7195c-bb7b-38cd-aa29-987175e75884",
                        "glosses": [
                            "beeld van een persoon met alleen het bovenlijf, zonder ledematen, maar met hoofd"
                        ],
                        "tags": [
                            "beeldhouwen"
                        ],
                        "examples": [
                            {
                                "example_id": "ed6e2c62-b645-4588-9bec-0118de7ec7e6",
                                "sense_id": "5822b66c-bcc2-38d2-aa35-0407cff0cb79",
                                "text": "Er was geen spoor van protserig koper, druk bespannen wanden of draperieën, al stond op een simpel tafeltje wel een bronzen torso van Bismarck."
                            }
                        ]
                    },
                    {
                        "sense_id": "cdba0939-09f5-3d68-b758-dc0e0239a03c",
                        "entry_id": "58d7195c-bb7b-38cd-aa29-987175e75884",
                        "glosses": [
                            "lichaam afgezien van hoofd en ledematen, met de nadruk op het bovenste deel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98357c2c-c9e9-4a07-8cb8-a44daf311a56",
                                "sense_id": "cdba0939-09f5-3d68-b758-dc0e0239a03c",
                                "text": "Hij gespt zijn riem los en trekt verscheidene overhemden en een hemd omhoog. Zijn buik en torso zijn getatoeëerd."
                            }
                        ]
                    },
                    {
                        "sense_id": "5c491706-1cad-3946-aca9-efd667837720",
                        "entry_id": "58d7195c-bb7b-38cd-aa29-987175e75884",
                        "glosses": [
                            "werkstuk dat niet is afgemaakt"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "e971cbf8-1e5b-4525-b045-de2369c9bb88",
                                "sense_id": "5c491706-1cad-3946-aca9-efd667837720",
                                "text": "En tenslotte is er het door Mozarts vroege einde torso gebleven Requiem."
