                "senses": [
                    {
                        "sense_id": "2125e19b-4dac-39cd-94b0-7db99a69487b",
                        "entry_id": "d464d3de-76a5-3277-995a-1420c0954247",
                        "glosses": [
                            "разг. об очень вкусной пище"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "90f0e2d8-ed95-3991-904f-4629ab1308ac",
                        "entry_id": "d464d3de-76a5-3277-995a-1420c0954247",
                        "glosses": [
                            "устар. употребление чрезмерно большого количества пищи"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6da9e721-165a-4ba9-b651-072ee6bfacc9",
                        "source_entry_id": "d464d3de-76a5-3277-995a-1420c0954247",
                        "source_sense_description": "об очень вкусной пище",
                        "target_lang_word": "régal",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "régal",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cc9922a2-7b7e-3c4f-ac20-bc648d5d1d6e",
                                        "entry_id": "d438b0be-64c1-3ebe-a6ec-a83241fb3d2f",
                                        "glosses": [
                                            "Festin, grand repas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1399d42d-31d0-4d83-a978-6cb29afcc411",
                                                "sense_id": "cc9922a2-7b7e-3c4f-ac20-bc648d5d1d6e",
                                                "text": "On leur fit un régal magnifique."
                                            },
                                            {
                                                "example_id": "03a2c370-044f-4f94-a54f-a43f02b431b7",
                                                "sense_id": "cc9922a2-7b7e-3c4f-ac20-bc648d5d1d6e",
                                                "text": "Lhomme, en effet, l’étui de son instrument sous le bras, filait le long du Gymnase, le nez tendu, riant d’aise tout seul, à l’idée du régal qu’il se promettait."
                                            },
                                            {
                                                "example_id": "6e7966ca-edf1-4861-9386-9db81987f68f",
                                                "sense_id": "cc9922a2-7b7e-3c4f-ac20-bc648d5d1d6e",
                                                "text": "Le chien s’était mis à rôder dans les environs, fouillant avidement les tas d’ordures, sans doute pour y déterrer un os ou quelque régal de ce genre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6426e57e-e81a-330c-acf0-31e20c10f50f",
                                        "entry_id": "d438b0be-64c1-3ebe-a6ec-a83241fb3d2f",
                                        "glosses": [
                                            "Plaisir de la table."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "90052499-5229-4e9b-97af-e63bc744d80a",
                                                "sense_id": "6426e57e-e81a-330c-acf0-31e20c10f50f",
                                                "text": "Ce plat est un régal, un vrai régal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e2364523-07f9-32db-948f-96a17f311877",
                                        "entry_id": "d438b0be-64c1-3ebe-a6ec-a83241fb3d2f",
                                        "glosses": [
                                            "Plaisir."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "375de234-6c61-4b79-a8e8-5bd835d7d4ab",
                                                "sense_id": "e2364523-07f9-32db-948f-96a17f311877",
                                                "text": "Cette lecture, ce spectacle a été pour moi un régal."
                                            },
                                            {
                                                "example_id": "36623521-7f73-420c-8255-984cda63b352",
                                                "sense_id": "e2364523-07f9-32db-948f-96a17f311877",
                                                "text": "Ce carnaval des dieux, l’Olympe traîné dans la boue, toute une religion, toute une poésie bafouée, semblèrent un régal exquis."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b66408c0-a769-4336-8715-709afcf40a18",
                        "source_entry_id": "d464d3de-76a5-3277-995a-1420c0954247",
                        "source_sense_description": "об очень вкусной пище",
                        "target_lang_word": "délice",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "délice",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fc36678f-1012-3ae2-904d-92dd0f0e2e2e",
                                        "entry_id": "be63303b-2512-3a0a-acd3-601df0728573",
                                        "glosses": [
                                            "Plaisir extrême."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ced29030-718f-490c-9b20-ea065a84fb05",
                                                "sense_id": "fc36678f-1012-3ae2-904d-92dd0f0e2e2e",
                                                "text": "Comment résister aux délices du bortsch, la soupe nationale, sorte de pot-au-feu, additionné de chou rouge et de crème fraîche, dont les marbrures glacées de rose et de blanc rappellent la page de garde d'un vieux bouquin."
                                            },
                                            {
                                                "example_id": "c9c431f7-5a1e-4270-82d8-6412013bc151",
                                                "sense_id": "fc36678f-1012-3ae2-904d-92dd0f0e2e2e",
                                                "text": "Voilà un livre qui fera les délices de tous les orchidologues en même temps que ceux des amateurs de belles photos."
                                            },
                                            {
                                                "example_id": "2c7e04f7-9b03-46d4-94bb-e4ee08f46070",
                                                "sense_id": "fc36678f-1012-3ae2-904d-92dd0f0e2e2e",
                                                "text": "La lecture de cet ouvrage est un pur délice."
                                            },
                                            {
                                                "example_id": "c3c4d61c-3563-47a2-b887-8ef3560dafa6",
                                                "sense_id": "fc36678f-1012-3ae2-904d-92dd0f0e2e2e",
                                                "text": "...ce rare génie exaltant avec le charme le plus entraînant les molles délices d'une vie tout entière vouée à l'amour et à des sensualité exquises."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d97f61e3-dba4-323f-a310-e43dc832fa8f",
                                        "entry_id": "be63303b-2512-3a0a-acd3-601df0728573",
                                        "glosses": [
                                            "Chose délicieuse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f03c4b6-685e-40d7-997d-7ba41734c20b",
                                                "sense_id": "d97f61e3-dba4-323f-a310-e43dc832fa8f",
                                                "text": "C'est chez la veuve Thorsdal que j'appris à savourer les délices de la cuisine islandaise. Le dîner se composait invariablement de poisson bouilli."
                                            },
                                            {
                                                "example_id": "c30d2f54-0517-43d9-b66b-cb51543f616b",
                                                "sense_id": "d97f61e3-dba4-323f-a310-e43dc832fa8f",
                                                "text": "Ce gâteau est un délice. — Ces nougats sont un vrai délice. — Quel délice que cette musique !"
                                            },
                                            {
                                                "example_id": "9f483269-2d0a-44fc-a055-861267574346",
                                                "sense_id": "d97f61e3-dba4-323f-a310-e43dc832fa8f",
                                                "text": "Le gâteau que les filles m'ont fait était un pur délice."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
