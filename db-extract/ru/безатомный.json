                "senses": [
                    {
                        "sense_id": "d7ab3ee2-1641-3361-805e-8f1d94bfe260",
                        "entry_id": "3cf6a62b-d094-3977-bcbf-c6b3cdc01fa5",
                        "glosses": [
                            "полит. свободный от производства, размещения и применения ядерного оружия; безъядерный"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19dd13be-0053-4dec-99b3-6e2d90ea8952",
                                "sense_id": "d7ab3ee2-1641-3361-805e-8f1d94bfe260",
                                "text": "В 1958 г. продолжалось международное обсуждение вопроса о создании безатомной зоны в Центральной Европе."
                            }
                        ]
                    },
                    {
                        "sense_id": "0829f900-7c27-3698-9913-9fec24eb4c24",
                        "entry_id": "3cf6a62b-d094-3977-bcbf-c6b3cdc01fa5",
                        "glosses": [
                            "матем. не содержащий ни одного атома"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "64c1c5ac-0259-4eb1-b282-7ef9c73e3199",
                                "sense_id": "0829f900-7c27-3698-9913-9fec24eb4c24",
                                "text": "Булеву алгебру, не содержащую ни одного атома называют безатомной или непрерывной."
                            }
                        ]
                    }
                ],
