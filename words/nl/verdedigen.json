                                "ru": "Ему пришлось <w>защищать</w> свой выбор перед коллегами.",
                                "de": "Er musste seine Entscheidung vor seinen Kollegen <w>verteidigen</w>.",
                                "pl": "Musiał <w>bronić</w> swojego wyboru przed kolegami.",
                                "fr": "Il devait <w>défendre</w> son choix devant ses collègues.",
                                "it": "Ha dovuto <w>difendere</w> la sua scelta davanti ai colleghi.",
                                "cs": "Musel si svou volbu před svými kolegy <w>obhájit</w>.",
                                "tr": "Seçimini meslektaşlarına karşı <w>savunmak</w> zorundaydı.",
                                "es": "Tuvo que <w>defender</w> su elección ante sus colegas."
