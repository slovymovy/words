                        "form": "es ist unbrechbar"
                    },
                    {
                        "form_id": "f6a173ac-08f6-4174-9b78-a57b54052612",
                        "entry_id": "f6d279d0-0a42-3a45-9b55-092cd14f1aef",
                        "tags": [
                            "positive",
                            "predicative",
                            "plural"
                        ],
                        "form": "sie sind unbrechbar"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "270cdf43-0def-3cab-a583-16e395a7caf4",
                        "entry_id": "f6d279d0-0a42-3a45-9b55-092cd14f1aef",
                        "glosses": [
                            "so, dass es nicht gebrochen werden kann"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "d2577434-a0a6-4e9c-8d0c-20ce23204a2e",
                                "sense_id": "270cdf43-0def-3cab-a583-16e395a7caf4",
                                "text": "„Man hat dergleichen zu lange geduldet. Du kannst annehmen, daß meine Entschlüsse unbrechbar sind.“"
                            },
                            {
                                "example_id": "9f28ea7c-2649-4f77-a166-dab512a97f4a",
                                "sense_id": "270cdf43-0def-3cab-a583-16e395a7caf4",
                                "text": "„Ich bemerkte ihre Bewegung, die sehr ruhig aber irgendwie groß und belebt war, irgendwie unbrechbar und stark.“"
                            },
                            {
                                "example_id": "4f6e2dca-c0cc-4571-8639-200320ac3ca8",
                                "sense_id": "270cdf43-0def-3cab-a583-16e395a7caf4",
                                "text": "„Denn die mit den Energien einer großen Zeitwende aufgeladene Idee ist unbrechbar und unbesiegbar, und in eben solchen Zeiten ist der in der Brust des Menschen mit aller Leidenschaft und Todesbereitschaft gehegte Wunsch beinahe schon des Wunsches Erfüllung.“"
                            },
                            {
                                "example_id": "07c45a06-3927-471a-a38c-be310f32423b",
                                "sense_id": "270cdf43-0def-3cab-a583-16e395a7caf4",
                                "text": "„Jedenfalls aber hatte sie … ungeteilt und unbrechbar die ganze Selbstironie ihrer Rasse und konnte sich viel bewußter, als etwa Rosenemil, aus sich selbst herausstellen und ihr eigener Zuschauer sein.“"
                            },
                            {
                                "example_id": "15068092-4181-4d22-842a-7bd548566d47",
                                "sense_id": "270cdf43-0def-3cab-a583-16e395a7caf4",
                                "text": "„So bäumte sich die angeborene Natur ungebrochen und unbrechbar wider alle Versuche, sie zu biegen, und Ulrike erfuhr es.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
