    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a4a921fe-af4e-35f3-9863-2c02cf1d9afd",
                    "sense_definition": "Mouiller ou humecter quelque chose, en particulier des végétaux ou le sol, en y versant de l'eau.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "mouiller",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "N'oublie pas d'<w>arroser</w> les fleurs du balcon avant qu'il ne fasse trop chaud."
                        },
                        {
                            "text": "Mon grand-père <w>arrose</w> son potager tous les soirs avec l'eau de pluie."
                        }
                    ],
                    "synonyms": [
                        "asperger",
                        "irriguer"
                    ],
                    "common_phrases": [
                        "arroser les plantes",
                        "arroser le jardin"
                    ]
                },
                {
                    "sense_id": "f01e9dee-1c4a-3ee5-96d0-b52ed1f8ee9a",
                    "sense_definition": "Traverser une région, une plaine ou une ville, en parlant d'un cours d'eau.",
