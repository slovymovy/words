                "senses": [
                    {
                        "sense_id": "2a054215-791a-33d5-b660-ac0a9e145e21",
                        "entry_id": "33f185d9-33cd-396e-aa30-02bed69ca5d9",
                        "glosses": [
                            "kulturpolitische Mittlerorganisation zur Förderung deutscher Sprach- und Kulturkenntnis im Ausland; ein Ort des deutschen Sprach- und Kulturerwerbs"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "7100216d-fd02-4571-851c-d7b65ab57a9b",
                                "sense_id": "2a054215-791a-33d5-b660-ac0a9e145e21",
                                "text": "das Institut: „Mit „uni-deutsch\" können Sie sich auch beim Goethe-Institut weltweit optimal vorbereiten und unmittelbar vor der Prüfung einen Kurs in Deutschland belegen.“"
                            },
                            {
                                "example_id": "616f321a-7fa8-4f29-88b5-af7126005a42",
                                "sense_id": "2a054215-791a-33d5-b660-ac0a9e145e21",
                                "text": "übertragen: „[…] (er kennt seinen Kleist, hat aber auch über jenen seltsamen Augenblick in der Geschichte der Universität Straßburg geschrieben, als sie so etwas war wie ein Goethe-Institut in Soldatenstiefeln, ein wenig zivilisiert durch Max Weber) […]“"
                            },
                            {
                                "example_id": "13d4bec7-b5ae-4449-be73-a148f6deb39e",
                                "sense_id": "2a054215-791a-33d5-b660-ac0a9e145e21",
                                "text": "übertragen: „Tatsächlich machte sie aus der Villa Monacone für uns Kinder einen Hort kultureller deutscher Eigenart im Ausland, sozusagen ein Goethe-Institut en miniature.“"
                            },
                            {
                                "example_id": "fd097964-3f8f-471a-b3ec-c9a84e922e88",
                                "sense_id": "2a054215-791a-33d5-b660-ac0a9e145e21",
                                "text": "„Die kleine Dachwohnung war für Eva und ihren Mann reserviert; das Mansardenzimmer wurde später an Studenten des Arolser Goethe-Instituts vermietet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
