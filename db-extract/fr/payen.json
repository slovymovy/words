                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "070c9afb-b235-462f-a8b1-a786303d962b",
                                "sense_id": "b713d9fc-5b14-356f-92dd-0e37640c398c",
                                "text": "Ayant ainsi prouvé, au moyen de nos quatre règles, la vérité des faits attribués à Moïse et à Jésus Christ, voyons maintenant si ces règles peuvent s'appliquer à ceux qu'on rapporte de Mahomet et des déités payennes."
                            }
                        ]
                    }
                ],
