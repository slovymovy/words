                                    {
                                        "sense_id": "97cc4d2e-c7dd-34bf-a5b6-6e7842ca993f",
                                        "entry_id": "c92e5eec-5c12-3f30-90b2-70270619cdd4",
                                        "glosses": [
                                            "A toxic substance, specifically a poison produced by the biological processes of organisms."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b521992e-7f1a-4c7b-8230-d4a69caee34e",
                                                "sense_id": "97cc4d2e-c7dd-34bf-a5b6-6e7842ca993f",
                                                "text": "The blue-ringed octopus Hapalochlaena lunulata has tetrodotoxin, the deadly toxin it also releases in a bite, in their ink but the concentrations and effect in inking are not known."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "668fac9e-ffa5-3abe-835a-b4a34876e81b",
                                        "entry_id": "c92e5eec-5c12-3f30-90b2-70270619cdd4",
                                        "glosses": [
                                            "Synonym of toxicant: a toxic substance in a body requiring removal."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "proscribed",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
