                    ]
                },
                {
                    "sense_id": "b1385d47-31a4-3f9c-ba24-d8096fcc542a",
                    "sense_definition": "Outil amovible servant autrefois à faire tourner le moteur d'une automobile pour le démarrer.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "automobile",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le chauffeur devait insérer la <w>manivelle</w> à l'avant du véhicule pour le faire démarrer."
                        },
                        {
                            "text": "Autrefois, il fallait un bon tour de bras pour lancer le moteur avec la <w>manivelle</w>."
