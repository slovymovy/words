                        "sense_id": "7a9d9726-f27a-3a1f-b53d-ba3646bc6a2d",
                        "entry_id": "84083b5e-af8f-391e-b95c-db5c15727c33",
                        "glosses": [
                            "vom Gericht an einen Pflichtverteidiger vergebenes Mandat"
                        ],
                        "tags": [
                            "Rechtssprache"
                        ],
                        "examples": [
                            {
                                "example_id": "3118e154-5b24-42f0-b018-3cd18faa83ae",
                                "sense_id": "7a9d9726-f27a-3a1f-b53d-ba3646bc6a2d",
                                "text": "„Würde er das Pflichtmandat ablehnen, müsste er das begründen - und da Mollath ihm noch zu vertrauen scheint, könnte das schwierig werden.“"
                            },
                            {
                                "example_id": "7a892a30-da83-4e20-89c8-31e273550640",
                                "sense_id": "7a9d9726-f27a-3a1f-b53d-ba3646bc6a2d",
                                "text": "„Üblicherweise fragt das Gericht vor der Bestellung an, ob man bereit und zeitlich imstande sei, das Pflichtmandat zu übernehmen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
