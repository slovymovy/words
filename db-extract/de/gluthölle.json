                "senses": [
                    {
                        "sense_id": "b773e0e2-e18f-31ec-9501-e3e504046325",
                        "entry_id": "213cb778-ac8d-3101-957b-1c57c0462aa9",
                        "glosses": [
                            "Ort, Stelle mit extrem hohen Temperaturen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c675350d-fd38-4daf-85b8-bec9a4e3230d",
                                "sense_id": "b773e0e2-e18f-31ec-9501-e3e504046325",
                                "text": "„Auf den ersten Blick nicht mehr als eine mit Kratern übersäte, tote Gluthölle, ist der innerste Planet des Sonnensystems für die Astronomen doch eine geheimnisvolle Welt voll spannender Rätsel.“"
                            },
                            {
                                "example_id": "2664b67f-b67a-4133-b68e-c7e7575788b0",
                                "sense_id": "b773e0e2-e18f-31ec-9501-e3e504046325",
                                "text": "„Die erste Zeit zog sich noch die Bucht von Krasnowodsk neben der Bahnstrecke hin, und wenigstens von der einen Seite kühlte ein frischer Luftzug die Gluthölle.“"
                            },
                            {
                                "example_id": "78e05fc8-e6c4-4e95-8e5e-de4ff0f50e26",
                                "sense_id": "b773e0e2-e18f-31ec-9501-e3e504046325",
                                "text": "„Denn wirklich radelte eine blonde Touristin mit unbedecktem Kopf in Hotpants, schon angesengt, aber gemächlich in die Gluthölle der Sanddünen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
