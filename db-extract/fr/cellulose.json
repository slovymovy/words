                                "target_senses": [
                                    {
                                        "sense_id": "20dfcf26-71b7-3323-abc0-d29266855597",
                                        "entry_id": "e9429866-7982-3f10-8805-0c892b95db5c",
                                        "glosses": [
                                            "aus Pflanzen, häufig aus Holz, hergestellte Zellulose; Grundstoff von Papier und Kunststoffen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36f3c5ce-9781-42f1-9273-ade12e4b3454",
                                                "sense_id": "20dfcf26-71b7-3323-abc0-d29266855597",
                                                "text": "Zellstoff ist die Grundlage zur Herstellung von holzfreiem Papier, das die Eigenschaft besitzt nicht zu vergilben."
                                            },
                                            {
                                                "example_id": "9f4d0aff-71c3-40b5-98fe-97bcabd96668",
                                                "sense_id": "20dfcf26-71b7-3323-abc0-d29266855597",
                                                "text": "„Nur wenige Jahre vergingen, bis es den ersten Chemikern gelang, durch das Kochen von Holzschnitzeln mit unterschiedlichen Chemikalien Zellstoff herzustellen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e498bdff-bc29-3aab-893a-2c445a8d8559",
                                        "entry_id": "e9429866-7982-3f10-8805-0c892b95db5c",
                                        "glosses": [
                                            "Kurzbezeichnung für aus [1] hergestellten saugfähigen Hygieneartikel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20aae741-d9ad-4079-80ff-371de04cd95e",
                                                "sense_id": "e498bdff-bc29-3aab-893a-2c445a8d8559",
                                                "text": "Irgendwie verspürte ich Erleichterung, legte dem Kleinen die Decke unter den Kopf, dann begann ich notdürftig Zellstoff und Mull auf die Wunden zu legen."
                                            }
