                    "frequency": "Middle",
                    "semantic_group_id": "deterioration_morale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce conflit entre collègues a fini par <w>pourrir</w> toute l'ambiance du bureau."
