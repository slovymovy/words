                "senses": [
                    {
                        "sense_id": "9e09cae0-885f-3cf1-8d88-c1f31912bcee",
                        "entry_id": "60cd75f7-3689-3e3c-84b0-d8926a695f1b",
                        "glosses": [
                            "Art und Menge der zu erbringenden Dienstleistungen oder Waren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19bac5ab-8de5-4f73-b2d1-88ef4a4f73fa",
                                "sense_id": "9e09cae0-885f-3cf1-8d88-c1f31912bcee",
                                "text": "Das Ministerium verweigert die Abnahme, Bezahlung und Veröffentlichung. »Die vorgelegte Studie entsprach (…) nicht dem vertraglich vereinbarten Leistungsumfang«, heißt es aus dem Ministerium."
                            },
                            {
                                "example_id": "a71e8c06-ea6f-4ef9-8e13-1ed302dfcfc5",
                                "sense_id": "9e09cae0-885f-3cf1-8d88-c1f31912bcee",
                                "text": "Ihre Beiträge werden Prämien genannt, die Höhe hängt vor allem vom Krankheitsrisiko und vom Leistungsumfang ab."
                            },
                            {
                                "example_id": "eaccb7be-4c90-467e-bdc2-eb1d76fa25c7",
                                "sense_id": "9e09cae0-885f-3cf1-8d88-c1f31912bcee",
                                "text": "\"Die Versicherungen werden nicht länger den Leistungsumfang willkürlich begrenzen und keine unerhörten Zuzahlungen zu den Beiträgen mehr verlangen dürfen\", versprach der Präsident seinen zahlreichen Zuhörern."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "709b4ac0-7dea-4e87-a576-8cc42ffa02d2",
