{
    "word_family": [
        "afwisselen",
        "afwisselend"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4df68102-3e35-3dc6-b64c-3f1124108c4c",
                    "sense_definition": "Het anders of gevarieerd zijn, het ontbreken van eentonigheid.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "variatie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je moet voor wat meer <w>afwisseling</w> in je leven zorgen.",
                            "target_lang_translations": {
                                "en": "You need to bring some more <w>variety</w> into your life."
                            }
                        },
                        {
                            "text": "Na jarenlang hetzelfde werk te hebben gedaan, was ik echt toe aan wat <w>afwisseling</w>.",
                            "target_lang_translations": {
                                "en": "After doing the same work for years, I was really ready for a <w>change</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "variatie",
                        "verandering"
                    ],
                    "antonyms": [
                        "eentonigheid",
                        "sleur"
                    ],
                    "common_phrases": [
                        "ter afwisseling",
                        "behoefte aan afwisseling",
                        "zorgen voor afwisseling"
                    ],
                    "target_lang_definitions": {
                        "en": "Being different or varied; the absence of monotony."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "variety",
                                "target_lang_sense_clarification": "the quality of being different or diverse"
                            },
                            {
                                "target_lang_word": "change",
                                "target_lang_sense_clarification": "a welcome break from routine"
                            },
                            {
                                "target_lang_word": "variation",
                                "target_lang_sense_clarification": "a change or difference in condition or amount"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "14e33a2b-7c15-3b4b-ae53-63cbcad8eb47",
                    "sense_definition": "Het elkaar regelmatig opvolgen van verschillende dingen of personen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "opvolging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De snelle <w>afwisseling</w> van dag en nacht is in de tropen heel opvallend.",
                            "target_lang_translations": {
                                "en": "The rapid <w>alternation</w> of day and night is very striking in the tropics."
                            }
                        },
                        {
                            "text": "Er is een goede <w>afwisseling</w> tussen theorie en praktijk tijdens deze cursus.",
                            "target_lang_translations": {
                                "en": "There is a good <w>alternation</w> between theory and practice during this course."
                            }
                        }
                    ],
                    "synonyms": [
                        "alternatie",
                        "beurtwisseling"
                    ],
                    "common_phrases": [
                        "snelle afwisseling"
                    ],
                    "target_lang_definitions": {
                        "en": "The regular succession or alternation of different things or people."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "alternation",
                                "target_lang_sense_clarification": "the occurrence of things in turn repeatedly"
                            },
                            {
                                "target_lang_word": "succession",
                                "target_lang_sense_clarification": "a number of people or things sharing a specified characteristic and following one after another"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}