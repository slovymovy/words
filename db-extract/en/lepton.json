                    {
                        "sense_id": "b8f8c69f-b002-3a19-86fa-3bd0257244b1",
                        "entry_id": "bb8f0025-8696-39f6-977c-66960aad5134",
                        "glosses": [
                            "A coin used since ancient times in Greece, serving in modern times as one hundredth of a phoenix, a drachma, and a euro (as the Greek form of the Eurocent)."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "b10355ee-6ef1-37b8-ab1d-f79b6761c8c8",
                        "entry_id": "bb8f0025-8696-39f6-977c-66960aad5134",
                        "glosses": [
                            "A small, bronze Judean coin from the 1st century BCE, considered by some to be the widow's mite."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "59bb0d99-b6e3-48a9-a256-b1a9d7a6309f",
                        "source_entry_id": "bb8f0025-8696-39f6-977c-66960aad5134",
                        "source_sense_description": "Greek coin",
                        "target_lang_word": "lepton",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lepton",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e782b6a5-e99b-3d13-aaf1-feae3b7af354",
                                        "entry_id": "d3ddd184-86f3-325e-9a78-2500cd3f0a2d",
                                        "glosses": [
                                            "Particule élémentaire qui n’est sensible qu’à l’interaction électrofaible et à la gravitation."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18e54626-1a1a-49a6-ae86-310f95c2983a",
                                                "sense_id": "e782b6a5-e99b-3d13-aaf1-feae3b7af354",
                                                "text": "L’autre catégorie de particules élémentaires, les leptons, est liée aux électrons qu'elle contient."
                                            },
                                            {
                                                "example_id": "a03e68e5-8e04-4aea-a6f4-49d963a82b8c",
                                                "sense_id": "e782b6a5-e99b-3d13-aaf1-feae3b7af354",
                                                "text": "Les leptons forment une catégorie de particules insensibles à la force nucléaire forte, qui se combinent avec les quarks pour façonner la matière."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "lepton",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6ef5cc3a-a8d8-3a9d-a4a6-39ee333f4432",
                                        "entry_id": "b75f9a52-a678-3f7d-addd-d2a0be45a411",
                                        "glosses": [
                                            "Centime de la drachme."
                                        ],
                                        "tags": [
                                            "Système monétaire"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c1be3fb3-7e2f-4590-b97f-9341210bc96f",
                                                "sense_id": "6ef5cc3a-a8d8-3a9d-a4a6-39ee333f4432",
                                                "text": "La drachme se divise en cent parties égales appelées lepta. Un lepton […] vaut donc 9/10 de centime."
                                            },
                                            {
                                                "example_id": "c0aa69b9-1e41-49ba-9ea8-01b04d08594d",
                                                "sense_id": "6ef5cc3a-a8d8-3a9d-a4a6-39ee333f4432",
                                                "text": "L’unité monétaire est la drachme, divisée en 100 lepta."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "lepton",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "225af634-a74d-333c-bf31-1309e676b07b",
                                        "entry_id": "32dbdcfe-bbd7-33bd-871c-2b2dd6ccf90c",
                                        "glosses": [
                                            "Unité de mesure de masse valant 1,34 centigramme."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10ad4995-b4fb-4fe9-b589-87d1eba18412",
                                                "sense_id": "225af634-a74d-333c-bf31-1309e676b07b",
                                                "text": "LEPTON. Nom d’une petite monnaie des anciens Grecs, que l’on considère aussi comme un poids formant la 336ᵉ partie de la grande drachme attique, ou le 7ᵉ du chalque, et pesant 1.34 centigramme = 2.068 grains anglais."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "lepton",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6bc10436-63a5-35ec-ba25-b5ead7e35237",
                                        "entry_id": "5918ce3b-b0d7-314b-a67c-fcac99ca00bd",
                                        "glosses": [
                                            "Mollusque lamellibranche."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08389a01-a924-4dec-9859-e4271d16eb67",
                                                "sense_id": "6bc10436-63a5-35ec-ba25-b5ead7e35237",
                                                "text": "Lepton squameux. Sa coquille (fig. 16, pl. 8) est mince, déprimée, pellucide, élégamment pointillée et chagrinée en dessus […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dfa8f0e5-b9be-47e2-bea3-9aa8ef59868d",
                        "source_entry_id": "bb8f0025-8696-39f6-977c-66960aad5134",
