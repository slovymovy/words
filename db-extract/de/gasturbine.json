                ],
                "senses": [
                    {
                        "sense_id": "e8fa7e38-0903-3ff8-a172-48a137d23df3",
                        "entry_id": "3b8b565f-45c3-3374-bded-f87e17f94dac",
                        "glosses": [
                            "Turbine, die mit der in mechanische Arbeit (Drehbewegung des Rotors) umgewandelten Verbrennungsenergie von Gas angetrieben wird; Gaskraftanlage"
                        ],
                        "tags": [
                            "Kraftmaschine"
                        ],
                        "examples": [
                            {
                                "example_id": "054db0a5-c0da-42f6-8790-7235f6e425e3",
                                "sense_id": "e8fa7e38-0903-3ff8-a172-48a137d23df3",
                                "text": "„Die Zustandsänderungen in einer Gasturbine finden nur im Gasgebiet statt.“"
                            },
                            {
                                "example_id": "88e097a8-aa28-4307-b806-ae48d790c412",
                                "sense_id": "e8fa7e38-0903-3ff8-a172-48a137d23df3",
                                "text": "„Die Gasturbine gehört zu den Verbrennungskraftmaschinen einer Unterordnung der Thermischen Fluidenergiemaschinen.“"
                            },
                            {
                                "example_id": "cafa6701-ae9a-490a-a13d-2d9f70ccc639",
                                "sense_id": "e8fa7e38-0903-3ff8-a172-48a137d23df3",
                                "text": "„Eine Gasturbine ist eine Turbine (also eine Art von Motor), die von einem heißen Gas angetrieben wird.“"
                            },
                            {
                                "example_id": "82c2fcd1-7b1e-4f35-a843-dcfd09dabc18",
                                "sense_id": "e8fa7e38-0903-3ff8-a172-48a137d23df3",
                                "text": "„Nicht nur GM experimentierte in den 50er Jahren mit Gasturbinen, auch im Chrysler-Konzern forschten die Ingenieure an dieser alternativen Antriebstechnik.“"
                            },
                            {
                                "example_id": "a231887f-3b91-46fc-9adc-445053a99b3e",
                                "sense_id": "e8fa7e38-0903-3ff8-a172-48a137d23df3",
                                "text": "„Ob Einsatz in Gasturbinen- oder Gas- und Dampf-Kraftwerken mit oder ohne Wärme-Kopplung – Siemens verfügt über ein umfassendes Portfolio leistungsstarker Gasturbinen im Leistungsbereich bis 400 MW.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
