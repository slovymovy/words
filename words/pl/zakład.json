    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "01439d75-e09d-3e22-8edd-08e840fd67d6",
                    "sense_definition": "umowa między dwiema stronami, w której przegrany spełnia ustalone świadczenie na rzecz wygranego",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "wager",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wygraliśmy ten <w>zakład</w> bez większego problemu.",
                            "target_lang_translations": {
                                "ru": "Мы выиграли это <w>пари</w> без особых проблем."
                            }
                        },
                        {
                            "text": "Idę o <w>zakład</w>, że nasz zespół znowu wygra.",
                            "target_lang_translations": {
                                "ru": "<w>Бьюсь об заклад</w>, что наша команда снова выиграет."
                            }
                        }
                    ],
                    "common_phrases": [
                        "iść o zakład",
                        "wygrać zakład",
                        "przegrać zakład"
                    ],
                    "target_lang_definitions": {
                        "ru": "соглашение между двумя сторонами, по которому проигравший выполняет оговорённое обязательство в пользу выигравшего"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пари",
                                "target_lang_sense_clarification": "спор с условием"
                            },
                            {
                                "target_lang_word": "спор",
                                "target_lang_sense_clarification": "пари, заклад"
                            },
                            {
                                "target_lang_word": "заклад",
                                "target_lang_sense_clarification": "в споре"
                            }
                        ]
