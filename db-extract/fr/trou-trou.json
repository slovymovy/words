                "senses": [
                    {
                        "sense_id": "6826364f-e4f4-3a4d-99ef-082a90dc079c",
                        "entry_id": "a8af315f-9042-38e2-93fd-ba75ee9396ca",
                        "glosses": [
                            "Sur de la lingerie, suite de petits jours par lesquels on passe un ruban."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90f60b35-7e1a-413f-bc78-1ad5a45caa4d",
                                "sense_id": "6826364f-e4f4-3a4d-99ef-082a90dc079c",
                                "text": "Marguerite ôta sa robe, son jupon et son cache-corset, sans qu’il trouvât rien à lui dire. Elle apparut à peine vêtue d’un corset d’où émergeait la fine chemise à trou-trou nouée d’un ruban bleu, et d’un pantalon très court dont la broderie laissait voir les bas presque jusqu’au-dessus du genou."
                            },
                            {
                                "example_id": "0ebf5c56-93ff-4cd5-b948-992e4de369ab",
                                "sense_id": "6826364f-e4f4-3a4d-99ef-082a90dc079c",
                                "text": "Don Juan s’abandonne et s’égare dans un dessin rose de chemise à trou-trou."
                            },
                            {
                                "example_id": "98356807-d033-4777-8eff-4dc1e35f4089",
                                "sense_id": "6826364f-e4f4-3a4d-99ef-082a90dc079c",
                                "text": "Même le joggeur, court vêtu de maillot à trou-trous et short fluorescent, cette façon qu’il a de traverser en frôlant les voitures, avec une maîtrise de torero blasé, tellement indifférent qu’on se sent obligé de l’admirer…"
                            },
                            {
                                "example_id": "0c94bd0e-d8c1-4259-a4d0-4581f9dab2e9",
                                "sense_id": "6826364f-e4f4-3a4d-99ef-082a90dc079c",
                                "text": "Je me souviens vaguement des traits de la gamine, une blondine coiffée d'un chapeau de paille orné de cerises artificielles, avec une robe en lingerie blanche, percée de trou-trous ourlés."
                            },
                            {
                                "example_id": "c392cb24-a3b9-44e5-9a6d-655ff6cb909f",
                                "sense_id": "6826364f-e4f4-3a4d-99ef-082a90dc079c",
                                "text": "Le dessus de pied, quant à lui, offre des variances à en couper le souffle : en cuir, en daim, en toile, en plastique, en lamé, au crochet, fleuri, à trou-trou, à carreaux vichy."
                            },
                            {
                                "example_id": "28829470-797e-44d5-9212-f3003ab935dc",
                                "sense_id": "6826364f-e4f4-3a4d-99ef-082a90dc079c",
                                "text": "Elle enfila ensuite son harnachement de jument de cirque : un paquet de trucs élastiques avec des dentelles et des fleurs en tissu partout, un slip à trous-trous et des bas à grosse couture."
                            }
                        ]
                    },
                    {
                        "sense_id": "77ee64ee-060a-39c4-9d83-278ad7b2bb23",
                        "entry_id": "a8af315f-9042-38e2-93fd-ba75ee9396ca",
                        "glosses": [
                            "Perforations opérées à titre décoratif sur le cuir des chaussures."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "cc8e22af-b6c8-469c-980a-0d1256827fd8",
                                "sense_id": "77ee64ee-060a-39c4-9d83-278ad7b2bb23",
                                "text": "– Tu aimes ça, toi, les trou-trous sur le bout des chaussures ? dit-il en se redressant.\n– Je ne sais pas, dit Daniel, c’est la mode."
                            }
                        ]
                    }
