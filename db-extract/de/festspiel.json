                    {
                        "sense_id": "5ac7e3c0-6470-3c63-b35e-6f2d70b3e4b5",
                        "entry_id": "d1f2a6dd-87d3-3907-89e3-c74be29ca4c9",
                        "glosses": [
                            "glanzvolle Veranstaltung von kulturellem Rang"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c1c58360-4f8f-4414-ae7c-d50b51279683",
                                "sense_id": "5ac7e3c0-6470-3c63-b35e-6f2d70b3e4b5",
                                "text": "„Das Liebesspiel trägt seinen Namen gewiß mit Recht, und auch die Kult- und Festspiele, die in urtümlichen Sozialformen in großer Mannigfaltigkeit anzutreffen sind, […] haben durchaus ausgesprochenen Spielcharakter.“"
                            },
                            {
                                "example_id": "1e6b29b3-61e1-4f1b-b428-fca05eeacef2",
                                "sense_id": "5ac7e3c0-6470-3c63-b35e-6f2d70b3e4b5",
                                "text": "Stichwort Festspiel"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "fb68ddb6-c0f6-3cfc-a1a2-8ee5797868cd",
                        "entry_id": "d1f2a6dd-87d3-3907-89e3-c74be29ca4c9",
                        "glosses": [
                            "Reihe von Veranstaltungen von kulturellem Rang an einem bestimmten Ort, zu einem bestimmten Thema oder eines bestimmten Genres"
                        ],
                        "tags": [
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "78d255b7-0b01-4975-a13e-4a29da5f2904",
                                "sense_id": "fb68ddb6-c0f6-3cfc-a1a2-8ee5797868cd",
                                "text": "Dieses Jahr können die Festspiele nicht durchgeführt werden, da die Finanzierung nicht gesichert ist."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
