                ],
                "senses": [
                    {
                        "sense_id": "437f11f9-9894-35f5-b08b-55efb327b986",
                        "entry_id": "a2361ef5-04a0-3a4d-9c7f-47e8ebebb5e6",
                        "glosses": [
                            "Grand-mère, femme âgée (mémère)."
                        ],
                        "tags": [
                            "Belgique"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "a05dd898-1086-313a-a933-5a33cc92bed4",
                        "entry_id": "a2361ef5-04a0-3a4d-9c7f-47e8ebebb5e6",
                        "glosses": [
                            "Bonne, servante, bonne d’enfants."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "81b70ca9-fe40-4510-ba43-f00c206d489e",
                                "sense_id": "a05dd898-1086-313a-a933-5a33cc92bed4",
                                "text": "… elle enlevait son chapeau, le remplaçait par un bonnet de bonne apporté sous son mantelet, dépliait un tablier blanc dissimulé de la même façon, le nouait autour de sa taille, et portant dans une serviette son chapeau de ville et le vêtement qui tout à l'heure lui couvrait les épaules, elle s’en allait trottinant, hardie, les hanches découvertes, petite bobonne qui fait une commission ; … Qui donc aurait reconnu dans cette servante mince et vive madame la première présidente Amandon ?"
                            },
                            {
                                "example_id": "10eefd1b-e004-444b-b67a-7ce4709975a2",
                                "sense_id": "a05dd898-1086-313a-a933-5a33cc92bed4",
                                "text": "Il courut au-devant de la bobonne qui lançait des bouffées pareilles aux jets de fumée d’un bateau à vapeur. Dix minutes après il rentrait.\n- Elle prétend que dans son pays toutes les nourrices sèches fument la pipe."
                            }
                        ]
                    },
                    {
                        "sense_id": "5d70f4b1-3955-3bb6-a401-b0a6bd03c07f",
                        "entry_id": "a2361ef5-04a0-3a4d-9c7f-47e8ebebb5e6",
                        "glosses": [
                            "Nom donné par un mari à son épouse lorsqu’il s’adresse à elle."
                        ],
                        "tags": [
                            "colloquial",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "de18c9ca-0c1a-4e4a-b042-741cb8173d17",
                                "sense_id": "5d70f4b1-3955-3bb6-a401-b0a6bd03c07f",
                                "text": "Allons, c’est dit, bobonne, fais toilette;\nAu salon bleu remets des rideaux neufs."
                            }
                        ]
                    },
                    {
                        "sense_id": "9696d9a5-d691-38ac-b33d-1aaa135c554e",
                        "entry_id": "a2361ef5-04a0-3a4d-9c7f-47e8ebebb5e6",
                        "glosses": [
                            "Femme au foyer."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "b1cb791e-993a-404a-9aa7-e97f6d9fb5ff",
                                "sense_id": "9696d9a5-d691-38ac-b33d-1aaa135c554e",
                                "text": "Au moins avait-elle quitté le rôle de la potiche, ainsi que celui de la bobonne trompée et impuissante."
                            },
                            {
                                "example_id": "db9f883a-e371-4e22-9a1d-6fd18bb4f834",
                                "sense_id": "9696d9a5-d691-38ac-b33d-1aaa135c554e",
                                "text": "Soudainement, monsieur, qui jusque-là n’adressait la parole à bobonne que pour lui demander d’aller lui chercher une bière dans le frigo, se vide un flacon d’Aqua Velva derrière les oreilles, achète des fleurs de dépanneur à sa dulcinée et l’amène manger chez Da Giovanni."
                            }
                        ]
                    }
                ],
