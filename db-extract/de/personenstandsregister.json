                "senses": [
                    {
                        "sense_id": "cc00a1dd-65d9-3fbb-9c40-798dab53c3ab",
                        "entry_id": "e2ee873d-5cfd-3de7-b756-68613fb5a21e",
                        "glosses": [
                            "Register, welches Angaben zum Personenstand beinhaltet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99360ff6-58f9-412d-806c-6082f775b4f6",
                                "sense_id": "cc00a1dd-65d9-3fbb-9c40-798dab53c3ab",
                                "text": "„Bei ihren Untersuchungen ist die Bevölkerungsgeographie auf die amtliche Statistik, auf Personenstandsregister, Befragungen u. Ä. angewiesen.“"
                            },
                            {
                                "example_id": "30a1cbc2-7632-429e-bef2-ddb4b7421c0c",
                                "sense_id": "cc00a1dd-65d9-3fbb-9c40-798dab53c3ab",
                                "text": "„Der Personenstand wird von den Standesämtern in Personenstandsregistern geführt (Eheregister, Lebenspartnerschaftsregister, Geburtenregister und Sterberegister).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
