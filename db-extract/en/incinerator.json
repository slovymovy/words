                "translations": [
                    {
                        "translation_id": "32e3040e-750a-40fc-9e82-8fa65944a72f",
                        "source_entry_id": "7e0cb8dd-f93e-3010-acd5-3717f7803721",
                        "source_sense_id": "16ee0e51-2eb0-3001-91d8-7ea0ad634627",
                        "source_sense_description": "furnace that burns refuse",
                        "target_lang_word": "incinérateur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "incinérateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "79cb55c6-e375-3690-8254-7af5d103cd42",
                                        "entry_id": "2e95fd3c-ecd1-390e-bb15-d99822fae532",
                                        "glosses": [
                                            "Appareil ou installation servant à incinérer les déchets."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a56e0195-ff07-4b38-9b08-e4897eb04b7c",
                                                "sense_id": "79cb55c6-e375-3690-8254-7af5d103cd42",
                                                "text": "L’incinérateur c’est mieux que la décharge quand même ?"
                                            },
                                            {
                                                "example_id": "821f1f43-501a-4634-8691-8821004a5839",
                                                "sense_id": "79cb55c6-e375-3690-8254-7af5d103cd42",
                                                "text": "254 kilos. C’est la quantité d’ordures ménagères produite chaque année par un Français. Soit le poids de deux réfrigérateurs américains. Une fois collectées, les poubelles grises sont envoyées en décharge ou brûlées dans des incinérateurs."
                                            },
                                            {
                                                "example_id": "8fe7b0a9-4004-4012-8caa-a7955cd5f7ab",
                                                "sense_id": "79cb55c6-e375-3690-8254-7af5d103cd42",
                                                "text": "Depuis, l’ARS recommande toujours de ne pas consommer d’œufs issus de poulaillers domestiques dans 410 communes de l’aire urbaine de Paris et répète que l’incinérateur est une source de pollution parmi d’autres avec le trafic routier ou le brûlage de déchets à l’air libre."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "incinérateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "facc7baa-1e62-34e4-87b4-05f06e0007a9",
                                        "entry_id": "102bda2d-6727-33cf-af22-ddb0ca9ab7d0",
                                        "glosses": [
                                            "Qui a un rapport avec l’incinération."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da1aae81-f543-4926-be75-1554a616da90",
                                                "sense_id": "facc7baa-1e62-34e4-87b4-05f06e0007a9",
                                                "text": "Il va assez de soi que la centrale incinératrice doit cesser de fonctionner dès qu’elle ne s'aligne pas sur les normes …"
                                            },
                                            {
                                                "example_id": "02e2be39-7e6d-4119-a67a-fa4944769a55",
                                                "sense_id": "facc7baa-1e62-34e4-87b4-05f06e0007a9",
                                                "text": "Il n'hésite pas à déclarer, par exemple, qu'on « ne parlait pas slave sur la Baltique et la Vistule avant l’arrivée du peuple incinérateur. On parlait finno-este »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "34af0a6c-f109-4adf-801f-d507b5daf441",
                        "source_entry_id": "7e0cb8dd-f93e-3010-acd5-3717f7803721",
                        "source_sense_id": "16ee0e51-2eb0-3001-91d8-7ea0ad634627",
                        "source_sense_description": "furnace that burns refuse",
                        "target_lang_word": "Verbrennungsanlage",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verbrennungsanlage",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "786058d8-0d8d-32f1-b71b-dc11c703e4dd",
                                        "entry_id": "5983e2f2-76e1-3844-a381-bbe28541ccb3",
                                        "glosses": [
                                            "eine technische Einrichtung, in der etwas durch Verbrennung beseitigt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7381fe0a-25ef-4d7f-931d-32452902ee43",
                                                "sense_id": "786058d8-0d8d-32f1-b71b-dc11c703e4dd",
                                                "text": "„Die thermische Verbrennungsanlage von Venjakob ist besonders geeignet zur Beseitigung lösemittelhaltiger Luftschadstoffe (VOC) in mittleren bis hohen Konzentrationen.“"
                                            },
                                            {
                                                "example_id": "6b69f1a8-8eb0-4e65-a690-0105c6582b5c",
                                                "sense_id": "786058d8-0d8d-32f1-b71b-dc11c703e4dd",
                                                "text": "„Die neue Verbrennungsanlage soll den Restmüll von ganz Südtirol aufnehmen (ca. 130.000 Tonnen)　und auch Wärme für die Fernheizung in der Landeshauptstadt bereitstellen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
