                "forms": [],
                "senses": [
                    {
                        "sense_id": "00707851-10be-3355-b85b-6a9503701fe0",
                        "entry_id": "a7dadd41-45ba-3804-993f-bc5465c6dab0",
                        "glosses": [
                            "Of or pertaining to the uterus."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "2c63ef4c-6749-4d13-9868-d52e8ccb2dcb",
                                "sense_id": "00707851-10be-3355-b85b-6a9503701fe0",
                                "text": "It has been reported that periparturient cows undergo a period of immunosuppression of various immunological parameters associated with a high susceptibility to uterine and mammary infections […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "b9a822d5-9dea-351b-9499-f94c7a3a55b9",
                        "entry_id": "a7dadd41-45ba-3804-993f-bc5465c6dab0",
                        "glosses": [
                            "Born of the same mother but of a different father."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "c7412f90-04a6-4d07-93b7-317a40f19e9e",
                                "sense_id": "b9a822d5-9dea-351b-9499-f94c7a3a55b9",
                                "text": "uterine siblings"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "137520cc-8079-4241-b690-60f3503cccb4",
                        "source_entry_id": "a7dadd41-45ba-3804-993f-bc5465c6dab0",
                        "source_sense_description": "of or pertaining to the uterus",
