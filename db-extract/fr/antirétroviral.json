                                    {
                                        "sense_id": "963a3705-e84d-3df5-898b-d4c1b54f5a33",
                                        "entry_id": "be1060c3-6479-3245-8cb2-33de991bb8b5",
                                        "glosses": [
                                            "That combats infection by retroviruses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f08744ce-0d73-4ca3-9014-171db44a34f6",
                                                "sense_id": "963a3705-e84d-3df5-898b-d4c1b54f5a33",
                                                "text": "Begun in 2003 and covering some 50 countries, Pepfar has saved the lives of an estimated 13m people living with HIV-Aids, mostly in Africa, by providing them with antiretroviral drugs."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "antiretroviral",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2ccdefa5-d23a-3ce1-b2ef-f26b50bbf3e7",
                                        "entry_id": "09fc3f12-6901-366b-bbf4-32b338491686",
                                        "glosses": [
                                            "An agent that combats retroviruses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f756d3ec-327d-4e3c-ad9c-0c656a398a36",
                                                "sense_id": "2ccdefa5-d23a-3ce1-b2ef-f26b50bbf3e7",
                                                "text": "Inequality, research shows, [is why] we still see Aids-related deaths in an era when we have all the antiretrovirals, HIV prevention pills, vaginal rings, injections and harm-reduction plans needed to end the pandemic."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
