                                    {
                                        "sense_id": "8e03e985-7c32-3502-b4e5-13650a625887",
                                        "entry_id": "8c2fc373-1eb0-390c-a795-da4ddcc28dcb",
                                        "glosses": [
                                            "книжн., неодобр. поведение фили́стера; косность и ханжество обывателя"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17ec543a-e0d9-4a12-bf4f-710491569d1e",
                                                "sense_id": "8e03e985-7c32-3502-b4e5-13650a625887",
                                                "text": "Что это за заглядыванье в даль? — твердили вы, — что за филистерство — непременно отмеривать себе счастье саженями да пудами?"
                                            }
                                        ]
                                    }
