                "senses": [
                    {
                        "sense_id": "9ead7db3-6782-3f8c-9dd9-0194b4be74bb",
                        "entry_id": "e67c5093-2418-3747-99d0-2fb5b3226a1f",
                        "glosses": [
                            "einheimischer Soldat des ehemaligen britischen Kolonialheers in Indien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e8e0ff8-c232-4c77-b4fa-7231b0e22643",
                                "sense_id": "9ead7db3-6782-3f8c-9dd9-0194b4be74bb",
                                "text": "„Schnell verbreitete sich unter den Sepoys die Nachricht, dass es sich um den Talg von Rindern oder Schweinen handele.“"
                            },
                            {
                                "example_id": "e0d486db-0d08-46f1-9fa2-6fb2eccf8279",
                                "sense_id": "9ead7db3-6782-3f8c-9dd9-0194b4be74bb",
                                "text": "„Von 139000 Sepoys, den indigenen Soldaten in der britischen Armee Indiens, revoltierten alle bis auf eine kleine Minderheit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "15560c24-78bf-43f6-8cc1-d3e269a7067b",
                        "source_entry_id": "e67c5093-2418-3747-99d0-2fb5b3226a1f",
                        "source_sense_id": "9ead7db3-6782-3f8c-9dd9-0194b4be74bb",
                        "source_sense_description": "Geschichte: einheimischer Soldat des ehemaligen britischen Kolonialheers in Indien",
                        "target_lang_word": "sepoy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sepoy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c08b22af-2618-3c36-a874-100745d1694e",
                                        "entry_id": "2d7ff0e1-4256-388c-bda9-1a7e269d169b",
                                        "glosses": [
                                            "A native soldier of the East Indies, employed in the service of a European colonial power, notably the British India army (first under the British-chartered East India Company, later in the crown colony), but also France and Portugal."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "55b0010f-ea0c-4024-b210-4ace3aa44144",
                                                "sense_id": "c08b22af-2618-3c36-a874-100745d1694e",
                                                "text": "If our door were in the hands of the Sepoys the place must fall, and the women and children be treated as they were in Cawnpore."
                                            },
                                            {
                                                "example_id": "5eca01a6-0491-43a9-8696-385263628972",
                                                "sense_id": "c08b22af-2618-3c36-a874-100745d1694e",
                                                "text": "They proved to be the wives of a body of sepoys, also from the 5th Regiment of Bombay Native Infantry; the sepoys had perished, and their families been enslaved, when their pattamar had been captured by the Qawasim some months before."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be51164f-0cce-37bc-9323-190174662535",
                                        "entry_id": "2d7ff0e1-4256-388c-bda9-1a7e269d169b",
                                        "glosses": [
                                            "The holder of an infantry enlisted rank equivalent to private in other countries."
                                        ],
                                        "tags": [
                                            "India",
                                            "Nepal",
                                            "Pakistan"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
