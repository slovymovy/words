                "senses": [
                    {
                        "sense_id": "54c2109d-9d6b-3706-88c1-6418a4cc721b",
                        "entry_id": "07ff4edc-f132-30ba-a4c7-d3763b184869",
                        "glosses": [
                            "To believe in or expound upon the Ebionite heresy."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b7529d3-72f0-461c-8fa6-8b19b7375a81",
                                "sense_id": "54c2109d-9d6b-3706-88c1-6418a4cc721b",
                                "text": "When, therefore, St John came forward with the testimony of his Gospel to oppose the Ebionizing and Gnostic fundamental principle of all heresy, and at the same time externally and internally supplemented the Synoptists, he was not influenced by a multiplicity of separate and independent aims."
                            },
                            {
                                "example_id": "9166bf50-cf7d-459f-94ce-5fca63507902",
                                "sense_id": "54c2109d-9d6b-3706-88c1-6418a4cc721b",
                                "text": "These writers unanimously attribute to him an Ebionizing Christology; and to this must be added as a further sign his strong chiliasm […]"
                            },
                            {
                                "example_id": "7e83adda-09be-460c-8d7c-fe603186f06e",
                                "sense_id": "54c2109d-9d6b-3706-88c1-6418a4cc721b",
                                "text": "Would you be willing to imitate all the examples of the old church? Or are you Ebionizing, and do you wish to return us to the Mosaic rule?"
                            }
                        ]
                    }
                ],
