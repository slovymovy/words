                        "examples": [
                            {
                                "example_id": "e9c66809-3c8d-4605-ba8e-266e7f43889d",
                                "sense_id": "2b87db90-220c-3e34-8827-3ed1fb2d0742",
                                "text": "Przed Jakubowym domem rosną piękne rozłożyste kasztany."
                            },
                            {
                                "example_id": "9d15a6a6-64cb-42c0-8d51-f7cfb684ae53",
                                "sense_id": "2b87db90-220c-3e34-8827-3ed1fb2d0742",
                                "text": "Sąsiadował z Jakubową zagrodą z jednej strony i z Maciejowym polem z drugiej."
                            },
                            {
                                "example_id": "179458f5-c084-498e-820d-ae5649648ab3",
                                "sense_id": "2b87db90-220c-3e34-8827-3ed1fb2d0742",
                                "text": "Jakubowi synowie wyrośli na dorodnych mężczyzn."
                            }
                        ],
