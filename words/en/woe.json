                },
                {
                    "sense_id": "17da25aa-a88d-34fc-816b-1c103f26fd66",
                    "sense_definition": "A curse or malediction.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient text pronounced a solemn <w>woe</w> upon anyone who dared to disturb the tomb.",
                            "target_lang_translations": {
                                "pl": "Starożytny tekst rzucał uroczyste <w>przekleństwo</w> na każdego, kto odważyłby się zakłócić spokój grobowca."
                            }
                        },
                        {
                            "text": "He uttered a bitter <w>woe</w> against those who had betrayed his trust.",
                            "target_lang_translations": {
                                "pl": "Wypowiedział gorzkie <w>złorzeczenie</w> przeciwko tym, którzy zawiedli jego zaufanie."
