                ],
                "senses": [
                    {
                        "sense_id": "2dcbecc4-6587-3cd7-bd45-5d82a0bb2a84",
                        "entry_id": "1b02b069-2323-3503-9e8b-b4bf2092d48a",
                        "glosses": [
                            "Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "42c58441-f4e1-4538-b86c-2e9b8de6a5b2",
                                "sense_id": "2dcbecc4-6587-3cd7-bd45-5d82a0bb2a84",
                                "text": "Frau Hajek ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "1cf01751-242a-407b-a373-fb0be630ba73",
                                "sense_id": "2dcbecc4-6587-3cd7-bd45-5d82a0bb2a84",
                                "text": "Herr Hajek wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "71567a2b-4db8-4275-b756-e832639a6867",
                                "sense_id": "2dcbecc4-6587-3cd7-bd45-5d82a0bb2a84",
                                "text": "Die Hajeks kommen heute aus dem Böhmerwald."
                            },
                            {
                                "example_id": "243368fb-ece4-4582-bc00-27d26d61a180",
                                "sense_id": "2dcbecc4-6587-3cd7-bd45-5d82a0bb2a84",
                                "text": "Der Hajek trägt nie die Schals, die die Hajek ihm strickt."
                            },
                            {
                                "example_id": "3bf968ce-1cf2-4ff8-a49e-703bb837087f",
                                "sense_id": "2dcbecc4-6587-3cd7-bd45-5d82a0bb2a84",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Hajek kommt, geht der Herr Hajek.“"
                            },
                            {
                                "example_id": "5340ac2f-51c1-443a-8f37-c51139c619fd",
                                "sense_id": "2dcbecc4-6587-3cd7-bd45-5d82a0bb2a84",
                                "text": "Hajek kommt und geht."
                            },
                            {
                                "example_id": "b7876908-ba96-4827-b1be-7a41a5f99a08",
                                "sense_id": "2dcbecc4-6587-3cd7-bd45-5d82a0bb2a84",
                                "text": "Hajeks kamen, sahen und siegten."
                            },
                            {
                                "example_id": "ba250cf7-61bb-4ff5-b2c1-7f605b992e4e",
                                "sense_id": "2dcbecc4-6587-3cd7-bd45-5d82a0bb2a84",
                                "text": "An verregneten Herbsttagen ist Familie Hajeks liebste Beschäftigung das Bemalen von Hühnereiern."
                            },
                            {
                                "example_id": "9282a5f9-5710-4535-b2e7-b3fcbcd9ceda",
                                "sense_id": "2dcbecc4-6587-3cd7-bd45-5d82a0bb2a84",
                                "text": "An verschneiten Wintertagen ist die liebste Beschäftigung von Familie Hajek das Schmücken von Weihnachtsbäumen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
