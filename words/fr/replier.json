    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e9060ab6-992a-35b0-8dc6-e9ac3355fbe2",
                    "sense_definition": "Plier de nouveau ou rabattre ce qui a été déplié ou étendu.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "plier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après avoir fini la lecture, il a soigneusement <w>replié</w> le journal sur la table."
                        },
                        {
                            "text": "N'oublie pas de <w>replier</w> ta serviette avant de quitter la salle à manger."
                        }
                    ],
                    "synonyms": [
                        "plier",
                        "rabattre"
                    ],
                    "antonyms": [
                        "déplier",
                        "étendre"
                    ],
                    "common_phrases": [
                        "replier la carte",
                        "replier une chaise"
                    ]
                },
                {
                    "sense_id": "adb65d42-f404-3ebc-b767-75c314d9acd6",
                    "sense_definition": "Faire reculer des troupes en bon ordre, ou se retirer stratégiquement face au danger.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "retraite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Devant l'avancée rapide de l'ennemi, le capitaine a ordonné à l'armée de se <w>replier</w>."
                        },
                        {
                            "text": "Les manifestants ont dû se <w>replier</w> dans les ruelles adjacentes face à la police."
                        }
                    ],
                    "synonyms": [
                        "reculer",
                        "battre en retraite"
                    ],
                    "antonyms": [
                        "avancer",
                        "attaquer"
                    ],
                    "common_phrases": [
                        "se replier en bon ordre",
                        "replier les troupes"
                    ]
                },
                {
                    "sense_id": "b46344de-8916-3465-b176-d04a23f26bfa",
                    "sense_definition": "Se renfermer dans sa solitude, se couper du monde extérieur pour s'isoler ou méditer.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "isolement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après cette terrible épreuve, elle a préféré se <w>replier</w> sur elle-même pendant plusieurs mois."
                        },
                        {
                            "text": "Il a tendance à se <w>replier</w> quand il fait face à des difficultés émotionnelles."
                        }
                    ],
                    "synonyms": [
                        "s'isoler",
                        "se renfermer"
                    ],
                    "antonyms": [
                        "s'ouvrir"
                    ],
                    "common_phrases": [
                        "se replier sur soi-même",
                        "se replier sur soi"
                    ]
                },
                {
                    "sense_id": "1a4dc21a-fc13-3fb6-b14a-6848c5cebf6a",
                    "sense_definition": "S'enrouler, former des méandres ou des courbes successives.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "courbe",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En approchant de la plaine, le fleuve se <w>replie</w> lentement entre les collines verdoyantes."
                        },
                        {
                            "text": "Effrayé par le bruit soudain, le serpent se <w>replie</w> aussitôt au pied de l'arbre."
                        }
                    ],
                    "synonyms": [
                        "s'enrouler",
                        "onduler"
                    ],
                    "common_phrases": [
                        "se replier en méandres"
                    ]
                }
            ]
        }
    ]
}