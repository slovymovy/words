                "senses": [
                    {
                        "sense_id": "af761fd2-b7e3-3654-88e7-b872e025c387",
                        "entry_id": "f9cbd683-4f1d-34d6-b194-3a5f9e6caea3",
                        "glosses": [
                            "Se succéder à soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0654e08-f920-4586-a933-1581dcffce30",
                                "sense_id": "af761fd2-b7e3-3654-88e7-b872e025c387",
                                "text": "Un candidat est hors course: Santer lui-même, qui, il y a peu de temps encore, semblait encore croire aux chances de s’autosuccéder, faute de mieux."
                            },
                            {
                                "example_id": "a720e4c2-e25e-49bb-ad6c-faf2a702e76b",
                                "sense_id": "af761fd2-b7e3-3654-88e7-b872e025c387",
                                "text": "Au poste de Secrétaire à la Défense, le très modéré Gates de l’administration Bush serait pressenti pour s’autosuccéder."
                            },
                            {
                                "example_id": "87870fba-2104-4ac7-bf69-c8ce11811808",
                                "sense_id": "af761fd2-b7e3-3654-88e7-b872e025c387",
                                "text": "L'Ancien, Charles Bossicart, pour s’autosuccéder à Interlux, et le Nouveau, Jean-Michel Morette, pour Télélux."
                            }
                        ]
                    }
