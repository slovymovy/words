                        ],
                        "examples": [
                            {
                                "example_id": "553bbf52-738c-4cc3-83b6-5fe115eacefb",
                                "sense_id": "ce13a60b-98d7-39b4-aa04-4cb20b5fe29e",
                                "text": "'Normaal ga ik met de motor, nu met een amfibie. Weer eens wat anders', zegt een werknemer van de steenfabriek Wienerberger in Echteld, nabij Tiel, enthousiast. Door het hoge water moet hij met dit ouderwetse doch functionele voertuig naar het werk."
                            },
                            {
                                "example_id": "9ed4142b-5214-401f-bb75-0454e72898b1",
                                "sense_id": "ce13a60b-98d7-39b4-aa04-4cb20b5fe29e",
                                "text": "In Ooij in Gelderland heeft een man een tijdje op een 55 meter hoge schoorsteen van een voormalige steenfabriek gelopen. Hij is door de politie naar beneden gehaald."
                            }
                        ]
                    }
