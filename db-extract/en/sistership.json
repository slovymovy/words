                                "example_id": "a872c6bf-db54-4700-87fa-77033f9565f5",
                                "sense_id": "e51ddba1-5fa6-33ad-9cb0-32221e9aae6e",
                                "text": "Only three weeks ago Orange, a sistership to Maiden II sailed by Bruno Peyron, failed to break the Round Britain record by just one hour and 16 minutes when it was becalmed in sight of the finish line."
                            },
                            {
                                "example_id": "5a3c23b7-b5a5-48b9-b2dc-106c94c4ee65",
                                "sense_id": "e51ddba1-5fa6-33ad-9cb0-32221e9aae6e",
                                "text": "She is now one of four sisterships back on the classic circuit, including Tuiga, owned by Prince Albert of Monaco."
                            }
                        ]
