                        "examples": [
                            {
                                "example_id": "2f6135bc-33c7-4dc4-814c-dd208e52123e",
                                "sense_id": "cd3751b9-06b2-30d6-9871-f3ec6f0bf2b2",
                                "text": "Op zijn thuisbaan in Lichtenvoorde werd hij die julidag voor de tweede keer wereldkampioen."
                            },
                            {
                                "example_id": "6b5f438e-10e6-4903-9a04-eb6013f2e76e",
                                "sense_id": "cd3751b9-06b2-30d6-9871-f3ec6f0bf2b2",
                                "text": "Donderdag ging ook de boeken in als de warmste julidag ooit sinds het begin van de metingen. In Maastricht werd donderdagmiddag 37,3 graden gemeten."
                            }
                        ]
                    }
