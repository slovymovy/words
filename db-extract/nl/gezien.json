                "forms": [],
                "senses": [
                    {
                        "sense_id": "8862af05-e05c-3698-9ce8-ef19a3e48430",
                        "entry_id": "7eb67bdd-b68c-383c-9a49-b9bf20dd239d",
                        "glosses": [
                            "geacht, in aanzien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb902a65-be5c-4ca2-a364-9afa7c3d9745",
                                "sense_id": "8862af05-e05c-3698-9ce8-ef19a3e48430",
                                "text": "Hij was een geziene gast."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4611b0c6-1dae-4ac2-b64d-b504de9497aa",
                        "source_entry_id": "7eb67bdd-b68c-383c-9a49-b9bf20dd239d",
                        "source_sense_id": "8862af05-e05c-3698-9ce8-ef19a3e48430",
                        "target_lang_word": "dear",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dear",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "260675b8-fe37-31f5-9797-f8d4fabb0b99",
                                        "entry_id": "e9f45503-0afe-3b5a-9a11-2dfcd11d69bc",
                                        "glosses": [
                                            "High in price; expensive."
                                        ],
                                        "tags": [
                                            "Ireland",
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2894383c-6167-4c03-a278-ed234c8554af",
                                                "sense_id": "260675b8-fe37-31f5-9797-f8d4fabb0b99",
                                                "text": "The dearer the jewel, the greater the love expressed."
                                            },
                                            {
                                                "example_id": "0a9fae18-b7df-4ffb-9f83-650bb01ca545",
                                                "sense_id": "260675b8-fe37-31f5-9797-f8d4fabb0b99",
                                                "text": "There's more depends on this than on the value.\nThe dearest ring in Venice will I give you,\nAnd find it out by proclamation:\nOnly for this, I pray you, pardon me."
                                            },
                                            {
                                                "example_id": "8b295ae2-ef77-417f-852c-a49b527e6760",
                                                "sense_id": "260675b8-fe37-31f5-9797-f8d4fabb0b99",
                                                "text": "This water is sold for 50 cents per ton, which is not dear under the circumstances."
                                            },
                                            {
                                                "example_id": "4abddfde-e325-47d0-9732-178f38a72f59",
                                                "sense_id": "260675b8-fe37-31f5-9797-f8d4fabb0b99",
                                                "text": "Every summer we can rent a cottage in the Isle of Wight, if it's not too dear."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f91c6448-2743-3823-8139-f032f40b6bd8",
                                        "entry_id": "e9f45503-0afe-3b5a-9a11-2dfcd11d69bc",
                                        "glosses": [
                                            "Loved; lovable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b868ba8d-7df7-4d5c-ac95-b97eb6a0b5ba",
                                                "sense_id": "f91c6448-2743-3823-8139-f032f40b6bd8",
                                                "text": "\"Yes, children dear, wait a bit till it turns itself,\" she answered - she ought to have said \"till I turn it\"[.]"
                                            },
                                            {
                                                "example_id": "a885e913-c1e7-4467-9e58-801a44010425",
                                                "sense_id": "f91c6448-2743-3823-8139-f032f40b6bd8",
                                                "text": "So this was my future home, I thought![…]Backed by towering hills, the but faintly discernible purple line of the French boundary off to the southwest, a sky of palest Gobelin flecked with fat, fleecy little clouds, it in truth looked a dear little city; the city of one's dreams."
                                            },
                                            {
                                                "example_id": "040cce2d-625d-4446-89d7-943be389c9ad",
                                                "sense_id": "f91c6448-2743-3823-8139-f032f40b6bd8",
                                                "text": "\"We shall have to put up with whitebait. And, of course, a dear little chicken with peas and roast potatoes.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3cfe6b53-6771-385e-bc02-ad17e99ee2a3",
                                        "entry_id": "e9f45503-0afe-3b5a-9a11-2dfcd11d69bc",
                                        "glosses": [
                                            "Lovely; kind."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4157dcb9-ee8d-42d3-a376-52cc0c77c5c7",
                                                "sense_id": "3cfe6b53-6771-385e-bc02-ad17e99ee2a3",
                                                "text": "\"I've never met the kind of man I mean.\" \"Tell me about him. What does he look like?\" \"Oh, he might look very much like you.\" \"How dear of you to say that!\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "17a05b3c-596d-3e8c-a798-97389888314c",
                                        "entry_id": "e9f45503-0afe-3b5a-9a11-2dfcd11d69bc",
                                        "glosses": [
                                            "Loving, affectionate, heartfelt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f948c6c-0dc3-45f1-88d5-302e629abed0",
                                                "sense_id": "17a05b3c-596d-3e8c-a798-97389888314c",
                                                "text": "Such dear embrace tenderly comforts even in this dear sorrow."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5cac6ea9-6dab-314b-8d62-017cd1bbf7fb",
                                        "entry_id": "e9f45503-0afe-3b5a-9a11-2dfcd11d69bc",
                                        "glosses": [
                                            "Precious to or greatly valued by someone."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14cf8ca5-d219-43f8-9653-dfd827d88d9a",
                                                "sense_id": "5cac6ea9-6dab-314b-8d62-017cd1bbf7fb",
                                                "text": "The dearer the giver, the dearer the trinket he brings!"
                                            },
                                            {
                                                "example_id": "d15c923b-27cd-47c1-b4df-0b8fe3746420",
                                                "sense_id": "5cac6ea9-6dab-314b-8d62-017cd1bbf7fb",
                                                "text": "[…] dear as sacramental wine\nTo dying lips is all he said […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "73869409-aab9-39d5-9a4e-cd3078ef96c8",
                                        "entry_id": "e9f45503-0afe-3b5a-9a11-2dfcd11d69bc",
                                        "glosses": [
                                            "A formal way to start (possibly after my) addressing somebody at the beginning of a letter, memo etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f733773-4ddf-4e78-8582-09c17f043562",
                                                "sense_id": "73869409-aab9-39d5-9a4e-cd3078ef96c8",
                                                "text": "Dear Sir/Madam/Miss, please notice our offices will be closed during the following bank holidays:[…]."
                                            },
                                            {
                                                "example_id": "5ada7ff8-0de6-4fee-8cee-f1d5d8bce061",
                                                "sense_id": "73869409-aab9-39d5-9a4e-cd3078ef96c8",
                                                "text": "Dearest Joseph/son:..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0842b6b2-3c6d-38d0-b5ab-e28728f1db32",
                                        "entry_id": "e9f45503-0afe-3b5a-9a11-2dfcd11d69bc",
                                        "glosses": [
                                            "A formal way to start (often after my) addressing somebody one likes or regards kindly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec85294c-fec7-4592-9bbf-4e0f65ba8d53",
                                                "sense_id": "0842b6b2-3c6d-38d0-b5ab-e28728f1db32",
                                                "text": "My dear friend, I feel better as soon as you come sit beside my sickbed!"
                                            },
                                            {
                                                "example_id": "39b81945-e051-4809-a152-777a49e186e9",
                                                "sense_id": "0842b6b2-3c6d-38d0-b5ab-e28728f1db32",
                                                "text": "“A very welcome, kind, useful present, that means to the parish. By the way, Hopkins, let this go no further. We don't want the tale running round that a rich person has arrived. Churchill, my dear fellow, we have such greedy sharks, and wolves in lamb's clothing.[…]”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "93d468f0-8510-3c7a-b04d-137e4a84d9fe",
                                        "entry_id": "e9f45503-0afe-3b5a-9a11-2dfcd11d69bc",
                                        "glosses": [
                                            "An ironic way to start (often after my) addressing an inferior or someone one dislikes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25806435-a479-47d6-abfa-0c4d452e959b",
                                                "sense_id": "93d468f0-8510-3c7a-b04d-137e4a84d9fe",
                                                "text": "My dear man, you ought to think twice about who you're trying to blackmail."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a6d6822-30a2-320a-9222-5b93e725406f",
                                        "entry_id": "e9f45503-0afe-3b5a-9a11-2dfcd11d69bc",
                                        "glosses": [
                                            "Noble."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "dear",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e3ece8c9-051e-3ee7-9f15-7a83af2d41f8",
                                        "entry_id": "23d20428-53a4-38f6-97f6-39d985fae24f",
                                        "glosses": [
                                            "A very kind, loving person."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28032f57-db76-4738-88aa-c4f46e414dc7",
                                                "sense_id": "e3ece8c9-051e-3ee7-9f15-7a83af2d41f8",
                                                "text": "My little cousin is such a dear, always drawing me pictures."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bcb04fa2-7ffa-358d-bd06-403d7e729a1e",
                                        "entry_id": "23d20428-53a4-38f6-97f6-39d985fae24f",
                                        "glosses": [
                                            "A beloved person."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4bf0c2f7-bf40-3545-aea0-9a308b003e58",
                                        "entry_id": "23d20428-53a4-38f6-97f6-39d985fae24f",
                                        "glosses": [
                                            "An affectionate, familiar term of address, such as used between husband and wife."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb57ef4d-2e41-45f1-b403-a298d1b78ebf",
                                                "sense_id": "4bf0c2f7-bf40-3545-aea0-9a308b003e58",
                                                "text": "Pass me the salt, would you dear?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "333be445-abd8-3101-9c19-e81c1327689d",
                                        "entry_id": "23d20428-53a4-38f6-97f6-39d985fae24f",
                                        "glosses": [
                                            "An elderly person, especially a woman."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "dear",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f5348961-e474-383a-a2cc-31f90acb4f98",
                                        "entry_id": "94401c62-be7c-3877-a4b0-c2875a7f66fa",
                                        "glosses": [
                                            "To endear."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "237db30c-3d6e-4c0e-9f45-7d549f47f3bb",
                                                "sense_id": "f5348961-e474-383a-a2cc-31f90acb4f98",
                                                "text": "Nor should a Sonne his Sire loue for reward, But for he is his Sire, in nature dear’d."
                                            },
                                            {
                                                "example_id": "1b5e132e-0d58-4fa3-ba11-2fb983cfcd5a",
                                                "sense_id": "f5348961-e474-383a-a2cc-31f90acb4f98",
                                                "text": "I should have known no less: It hath been taught us from the primal state That he which is was wished until he were; And the ebbed man, ne'er loved till ne'er worth love, Comes deared by being lacked."
                                            },
                                            {
                                                "example_id": "b1336f28-a97b-4bb2-8896-878e870bb419",
                                                "sense_id": "f5348961-e474-383a-a2cc-31f90acb4f98",
                                                "text": "Nay, hide him in thy house, and also show Such deared love to him, as to delight In his base company both day and night?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dear",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d617b520-1bd6-3e0f-929c-875eb8eea823",
                                        "entry_id": "1d601e78-8250-3d06-99a4-4a681d139a6f",
                                        "glosses": [
                                            "Dearly; at a high price."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c64665c9-81fc-4898-8bb2-e7bd218cd78f",
                                                "sense_id": "d617b520-1bd6-3e0f-929c-875eb8eea823",
                                                "text": "If thou attempt it, it will cost thee dear."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dear",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f2e5d5c7-65b6-354e-addd-ead3a28be359",
                                        "entry_id": "bf16ea5b-3e5a-3993-850f-ca83c4c40121",
                                        "glosses": [
                                            "Indicating surprise, pity, or disapproval."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bcf65b37-3c5d-44ed-b9c1-0ad821b1e533",
                                                "sense_id": "f2e5d5c7-65b6-354e-addd-ead3a28be359",
                                                "text": "Dear, dear! Whatever were they thinking?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dear",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "aec877eb-6c2f-31df-b742-5f18c92a3861",
                                        "entry_id": "e56219af-e67c-3ddd-8054-7e22704207bb",
                                        "glosses": [
                                            "Severe, or severely affected; sore."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f7ae91e3-519e-3893-82a6-25385e74eb8b",
                                        "entry_id": "e56219af-e67c-3ddd-8054-7e22704207bb",
                                        "glosses": [
                                            "Fierce."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "798217f2-c8c7-4fd9-ad6e-590a2ab31c12",
                                                "sense_id": "f7ae91e3-519e-3893-82a6-25385e74eb8b",
                                                "text": "The Christens found the heathens dear, as the lion doth the bear."
                                            }
