                        "sense_id": "13572c39-0e71-3ed3-a84b-28ef8b5317f3",
                        "entry_id": "a475e561-63b2-3353-ae87-1b995682686e",
                        "glosses": [
                            "One of a demographic class of young, socially-conscious, urban professionals."
