                                        "sense_id": "2e50d542-feae-3295-b737-ace2d13fb7c9",
                                        "entry_id": "54e3a0c0-3257-3c3b-8b5c-708b49763e4b",
                                        "glosses": [
                                            "A sliding scutcheon for covering a keyhole."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
