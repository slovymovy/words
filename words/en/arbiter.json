                    "frequency": "Low",
                    "semantic_group_id": "judge",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The two companies hired an independent <w>arbiter</w> to resolve their contract dispute."
                        },
                        {
                            "text": "Both sides agreed to accept the decision made by the <w>arbiter</w>."
                        }
                    ],
                    "synonyms": [
                        "arbitrator",
                        "mediator",
                        "umpire"
                    ]
                },
                {
                    "sense_id": "15be00a4-9349-3035-801d-6599550c21b4",
                    "sense_definition": "A person or thing with the power to decide or influence what is accepted or standard.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "judge",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Fashion magazines often act as the final <w>arbiter</w> of what is considered stylish."
                        },
                        {
                            "text": "The market is the ultimate <w>arbiter</w> of whether a new product will succeed."
                        }
                    ],
                    "synonyms": [
                        "judge",
                        "authority"
