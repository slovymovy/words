                    {
                        "sense_id": "ee6a039c-0099-36dd-99e3-86cef6f888e5",
                        "entry_id": "e925f3b5-627d-3b46-afee-47942f437476",
                        "glosses": [
                            "mangelnde sexuelle Erregbarkeit"
