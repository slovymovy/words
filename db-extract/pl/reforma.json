                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b7f1b7c9-4082-38db-8b42-aa0c35434f22",
                                        "entry_id": "f4f5c550-c3b3-3b53-b70c-f1887011df59",
                                        "glosses": [
                                            "sukzessive, planmäßige und gewaltlose Umgestaltung und Verbesserung bestehender Verhältnisse"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26a4d164-9822-424b-b33b-dceabad2a828",
                                                "sense_id": "b7f1b7c9-4082-38db-8b42-aa0c35434f22",
                                                "text": "Dem Minister wird vorgeworfen, eine längst überfällige Reform hinauszuzögern."
                                            },
                                            {
                                                "example_id": "f248c661-70a5-4352-99f0-2c9037c19f27",
                                                "sense_id": "b7f1b7c9-4082-38db-8b42-aa0c35434f22",
                                                "text": "„Tafari lässt sich von Franzosen und Amerikanern beraten und setzt erste Reformen um.“"
                                            },
                                            {
                                                "example_id": "5f1017ca-1eb5-49b1-8dd5-7e4d57f18565",
                                                "sense_id": "b7f1b7c9-4082-38db-8b42-aa0c35434f22",
                                                "text": "„Dafür musste er den Briten soziale und politische Reformen versprechen.“"
                                            },
                                            {
                                                "example_id": "46632288-a3ae-4cf3-8d45-e9a4fcfda5d3",
                                                "sense_id": "b7f1b7c9-4082-38db-8b42-aa0c35434f22",
                                                "text": "„Eine der ersten umfänglichen Arbeiten für den Magistrat ist ein Gutachten zur Reform des Schulwesens, das durch bürokratische Misswirtschaft zerrüttet sei.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
