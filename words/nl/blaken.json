                    "sense_id": "9872d8f6-99f0-32bd-9a85-d1bf4200ad51",
                    "sense_definition": "uitbundig bezitten, stralen van (een bepaalde positieve eigenschap of toestand, zoals gezondheid of zelfvertrouwen)",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "stralen_van",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na haar vakantie in de bergen bleek zij te <w>blaken</w> van gezondheid.",
                            "target_lang_translations": {
                                "en": "After her holiday in the mountains, she seemed to <w>glow</w> with health."
                            }
                        },
                        {
                            "text": "De jonge ondernemer stond op het podium te <w>blaken</w> van zelfvertrouwen.",
                            "target_lang_translations": {
                                "en": "The young entrepreneur stood on the stage <w>beaming</w> with confidence."
                            }
                        }
                    ],
                    "synonyms": [
