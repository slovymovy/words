                    "semantic_group_id": "noun_subordinate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans ce contrat juridique, les droits dérivés constituent seulement l'<w>accessoire</w> de la clause principale."
                        },
                        {
                            "text": "En droit civil, l'<w>accessoire</w> suit obligatoirement le régime du bien principal."
                        }
                    ],
                    "antonyms": [
                        "principal"
