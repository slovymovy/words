                    "sense_id": "fcdd10a0-38d6-3066-9b03-3519d3c469be",
                    "sense_definition": "Kunstvorm die gebruikmaakt van klanken, ritme en melodie om gevoelens uit te drukken.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "art_sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij luistert elke avond naar rustige <w>muziek</w>.",
                            "target_lang_translations": {
                                "en": "She listens to quiet <w>music</w> every evening.",
                                "ru": "Она каждый вечер слушает спокойную <w>музыку</w>.",
                                "pl": "Ona każdego wieczoru słucha spokojnej <w>muzyki</w>.",
                                "de": "Sie hört jeden Abend ruhige <w>Musik</w>.",
                                "fr": "Elle écoute de la <w>musique</w> calme tous les soirs.",
                                "it": "Lei ascolta della <w>musica</w> tranquilla ogni sera.",
                                "cs": "Každý večer poslouchá klidnou <w>hudbu</w>.",
                                "tr": "Her akşam sakin <w>müzik</w> dinler.",
                                "es": "Ella escucha <w>música</w> tranquila todas las noches."
                            }
                        },
                        {
                            "text": "Wij maken samen <w>muziek</w> in een klein orkest.",
                            "target_lang_translations": {
                                "en": "We make <w>music</w> together in a small orchestra.",
                                "ru": "Мы вместе играем <w>музыку</w> в небольшом оркестре.",
                                "pl": "Razem tworzymy <w>muzykę</w> w małej orkiestrze.",
                                "de": "Wir machen zusammen in einem kleinen Orchester <w>Musik</w>.",
                                "fr": "Nous faisons de la <w>musique</w> ensemble dans un petit orchestre.",
                                "it": "Facciamo <w>musica</w> insieme in una piccola orchestra.",
                                "cs": "Společně děláme <w>hudbu</w> v malém orchestru.",
                                "tr": "Küçük bir orkestrada birlikte <w>müzik</w> yapıyoruz.",
                                "es": "Hacemos <w>música</w> juntos en una pequeña orquesta."
                            }
                        }
                    ],
                    "common_phrases": [
