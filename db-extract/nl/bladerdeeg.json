                "senses": [
                    {
                        "sense_id": "46e7d473-d3be-3efb-b5c7-76220e3136e4",
                        "entry_id": "48771c2e-8436-3a44-b1a6-0d2483141334",
                        "glosses": [
                            "een deegsoort die in rechthoekige plakken wordt gebruikt en bestaat uit dunne laagjes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5b7b889-67b2-45f8-b1c8-61bba8b59068",
                                "sense_id": "46e7d473-d3be-3efb-b5c7-76220e3136e4",
                                "text": "Van de hele groentetaart vond het kind het bladerdeeg nog het lekkerst."
                            },
                            {
                                "example_id": "a97410f8-f9e1-4e2d-8bda-26097123eaa4",
                                "sense_id": "46e7d473-d3be-3efb-b5c7-76220e3136e4",
                                "text": "Bij dit gerecht was ik in het begin even in de war. Want moet je nou wel of niet een muurtje van aluminiumfolie bouwen in de quiche om het vega en vleesdeel te scheiden? In het recept staat van wel, maar in het boek blijken twee foto’s over elkaar geplakt te zijn. De beste oplossing is in mijn ogen om een muurtje van bladerdeeg te bouwen. Heb je extra veel knapperige korst."
                            },
                            {
                                "example_id": "958dad00-73e7-4ea3-b7e9-d5b684fe8256",
                                "sense_id": "46e7d473-d3be-3efb-b5c7-76220e3136e4",
                                "text": "Daar op tafel, gebakken in bladerdeeg, lag dus twee kilo vlees te wachten tot het getrancheerd werd."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b1b14cdc-0ab1-44c4-8c87-bad74300bad4",
                        "source_entry_id": "48771c2e-8436-3a44-b1a6-0d2483141334",
                        "source_sense_id": "46e7d473-d3be-3efb-b5c7-76220e3136e4",
                        "source_sense_description": "een deegsoort die in rechthoekige plakken wordt gebruikt",
                        "target_lang_word": "Blätterteig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Blätterteig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5f4dd308-5d45-39bd-aee3-f78203123f88",
                                        "entry_id": "469a3764-c34d-3536-92b3-ed0c2d1920cd",
                                        "glosses": [
                                            "ein ohne Backpulver, Hefe oder ähnliche Zutaten hergestellter, mehrfach geschichteter, dünn ausgerollter Teig, der nach dem Backen dünnen, aufeinandergelegten Blättern ähnelt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78b55bd3-69eb-407f-b6fa-3e3c24d91d84",
                                                "sense_id": "5f4dd308-5d45-39bd-aee3-f78203123f88",
                                                "text": "Diese Pastetchen können schon am frühen Abend vorbereitet und erst kurz vor dem Auftragen in den Ofen geschoben werden. Sie werden meist aus Blätterteig hergestellt, oder man kauft sie fertig vom Bäcker."
                                            },
                                            {
                                                "example_id": "c245747c-f6ac-4344-b095-61b8470ff407",
                                                "sense_id": "5f4dd308-5d45-39bd-aee3-f78203123f88",
                                                "text": "Törtchen (Torteletten) sind kleine Gebilde aus Mürbe-, Hefe- oder Blätterteig und werden mit kleinen Früchten oder Fruchtteilen gefüllt. Oft verziert man sie noch mit Schlagsahne."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
