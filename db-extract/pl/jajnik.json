                "translations": [
                    {
                        "translation_id": "6fa78f29-c417-4e0a-8cc7-e2b207bdaf7d",
                        "source_entry_id": "221cc527-1983-3d1c-8855-7072ebbc2aa9",
                        "source_sense_id": "4c5acb20-ddc3-367d-be5c-857345e6152a",
                        "target_lang_word": "ovary",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ovary",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2652f834-b991-3adc-b264-080609830da1",
                                        "entry_id": "3ada1f9a-0c55-3189-ac4f-98f5960dfb7e",
                                        "glosses": [
                                            "A female reproductive organ, often paired, that produces ova in most animals, and in mammals, secretes the hormones estrogen and progesterone."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8826c85d-55b6-4754-9bec-bfc6c27da999",
                                                "sense_id": "2652f834-b991-3adc-b264-080609830da1",
                                                "text": "The male testicles are homologous to the female ovaries."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "188a66f5-4cc8-3842-ac01-c5179dc9dc55",
                                        "entry_id": "3ada1f9a-0c55-3189-ac4f-98f5960dfb7e",
                                        "glosses": [
                                            "The lower part of a pistil or carpel that bears ovules and ripens into fruit."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6174d035-a8c4-482c-8485-3761d7005b91",
                        "source_entry_id": "221cc527-1983-3d1c-8855-7072ebbc2aa9",
                        "source_sense_id": "4c5acb20-ddc3-367d-be5c-857345e6152a",
                        "target_lang_word": "ovaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ovaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8caf0c44-0758-3fd3-8b92-d6979dc1c294",
                                        "entry_id": "b1cf7482-39d9-34b1-a66d-9d7c54a7e183",
                                        "glosses": [
                                            "Organe pair du système reproducteur femelle, présent chez la plupart des animaux, où sont produits les ovules."
                                        ],
                                        "tags": [
                                            "Reproduction"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e6e81b1c-c815-4b33-9165-2a9e3509932e",
                                                "sense_id": "8caf0c44-0758-3fd3-8b92-d6979dc1c294",
                                                "text": "C’est l’hormone de l’ovaire (folliculine) qui fait apparaître le plumage particulier de la poule, qui suscite le rut chez les mammifères."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6c5c526-d60b-34b1-a3ba-5a764725e2fb",
                                        "entry_id": "b1cf7482-39d9-34b1-a66d-9d7c54a7e183",
                                        "glosses": [
                                            "Glande reproductrice située dans le pelvis de la femme, latéralement à l’utérus, qui produit les ovocytes et sécrète les hormones sexuelles féminines (œstrogènes, progestérone)."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2821b7be-afe9-4904-acfd-f8b6b96257fd",
                                                "sense_id": "b6c5c526-d60b-34b1-a3ba-5a764725e2fb",
                                                "text": "[Charcot] découvre les zones hystérogènes, [et] peut, en maniant adroitement les ovaires, enrayer ou accélérer les crises."
                                            },
                                            {
                                                "example_id": "99953d8f-01ee-4c71-a763-486d17211a12",
                                                "sense_id": "b6c5c526-d60b-34b1-a3ba-5a764725e2fb",
                                                "text": "La fausse puberté précoce isosexuelle est secondaire à une sécrétion œstrogénique anormale par une tumeur de l’ovaire ou des surrénales sans maturation ovarienne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a7c2d35-65b3-33f7-bb95-1a9c5bef9be4",
                                        "entry_id": "b1cf7482-39d9-34b1-a66d-9d7c54a7e183",
                                        "glosses": [
                                            "Partie inférieure du pistil des plantes à fleurs, contenant les ovules et se transformant en fruit après la fécondation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57e4f2dc-07e3-4d65-9154-3f7a590d1ebd",
                                                "sense_id": "9a7c2d35-65b3-33f7-bb95-1a9c5bef9be4",
                                                "text": "L’auxine est normalement apportée dans l’ovule par le pollen et l’on pense que la pollinisation doit stimuler la production d’auxine par l’ovaire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a95ee33f-5642-45f3-927a-26680459a6ac",
                        "source_entry_id": "221cc527-1983-3d1c-8855-7072ebbc2aa9",
