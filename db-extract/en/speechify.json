                ],
                "senses": [
                    {
                        "sense_id": "7e1a95b4-cef8-3448-9f33-c26a17ff78d4",
                        "entry_id": "8ff12e09-cf9a-3a12-a4bc-ccd9f06d88ad",
                        "glosses": [
                            "To give a speech; to hold forth; (now especially) to pronounce pompously or at length."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "f7a0d87b-3048-4d31-a6a2-7dbfe9e7f819",
                                "sense_id": "7e1a95b4-cef8-3448-9f33-c26a17ff78d4",
                                "text": "Caleb was a powerful man and knew little of any fear except the fear of hurting others and the fear of having to speechify."
                            },
                            {
                                "example_id": "6166d1f9-a632-4168-8400-f2230014e5da",
                                "sense_id": "7e1a95b4-cef8-3448-9f33-c26a17ff78d4",
                                "text": "He never missed a chance of speechifying in public."
                            },
                            {
                                "example_id": "4699f821-d771-4f9b-9a49-b1f4f629fdf1",
                                "sense_id": "7e1a95b4-cef8-3448-9f33-c26a17ff78d4",
                                "text": "The home minister, Admiral Suetsugu, speechified grandly of a Japanese eminent domain beyond the seas, of a “moral purification drive” in the home islands."
                            },
                            {
                                "example_id": "01f85024-11a7-4c35-8ad9-2139ec53d332",
                                "sense_id": "7e1a95b4-cef8-3448-9f33-c26a17ff78d4",
                                "text": "Rodey McQueen speechified elegantly about the necessity for harmony."
                            }
                        ]
                    },
                    {
                        "sense_id": "4defa417-ae23-307c-bbe6-d4afc637844e",
                        "entry_id": "8ff12e09-cf9a-3a12-a4bc-ccd9f06d88ad",
                        "glosses": [
                            "To make speeches to (someone); to address in a speech."
                        ],
                        "tags": [
                            "obsolete",
                            "possibly",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "1352766a-543c-4bf5-8ae1-a4c1f615b1b9",
                                "sense_id": "4defa417-ae23-307c-bbe6-d4afc637844e",
                                "text": "They take their little enjoyments on little means and with little things and don't let solemn big-wigs stare them out of countenance or speechify them dull."
                            }
                        ]
                    }
                ],
