                                "example_id": "8cf86224-5157-47ec-8487-13e70e2e4c5b",
                                "sense_id": "0f27224c-cff1-3148-baf2-ad5edcf897ab",
                                "text": "Les nuées de cultivateurs qui noircissent la terre peuvent se comparer à une fourmillière industrieuse ; leur indolence naturelle est aiguillonnée par le fouet du maître et l’espoir des fleurs et des fruits que doit multiplier leur travail."
                            },
                            {
                                "example_id": "96a7ddb9-b2ea-4f80-aeab-a206c031c5df",
                                "sense_id": "0f27224c-cff1-3148-baf2-ad5edcf897ab",
                                "text": "Le soufre. : On fouille le plus près qu'il est possible de la fourmillière, plus bas d'un pied, et on la frappe en dessous en tour creuse."
                            }
                        ]
                    }
