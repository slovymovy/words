                "senses": [
                    {
                        "sense_id": "67fb0549-4d66-3bcb-94f9-dc0cb039b42b",
                        "entry_id": "1d687674-274d-3a6e-b1a4-86e8d194068d",
                        "glosses": [
                            "aeromechanical"
                        ],
                        "tags": [
                            "not-comparable",
