                        "tags": [],
                        "examples": [
                            {
                                "example_id": "929868eb-bf24-4cf7-8f9a-a18859a70ea9",
                                "sense_id": "a7bd4c6c-52c0-3176-b20c-effde259d50d",
                                "text": "„Der Mai hat eine Warmwetterperiode eingeleitet, und die milde Frühlingsluft fühlt sich wunderbar an auf meiner blassen Haut.“"
                            },
                            {
                                "example_id": "84611510-8a9a-49f5-86dd-a62d882e3165",
                                "sense_id": "a7bd4c6c-52c0-3176-b20c-effde259d50d",
                                "text": "„Bedingt durch eine ausgedehnte Warmwetterperiode im Februar geht die Natur ungewöhnlich früh in die Vollen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
