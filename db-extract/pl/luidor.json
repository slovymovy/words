                "senses": [
                    {
                        "sense_id": "5800c167-a607-34ab-aa1f-21169bff42fb",
                        "entry_id": "bb341bd1-6b4a-3975-a7c4-01aab768b834",
                        "glosses": [
                            "złota moneta bita we Francji"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "c6aa27f7-8914-4767-b418-8a5be87f81a9",
                                "sense_id": "5800c167-a607-34ab-aa1f-21169bff42fb",
                                "text": "Na awersie luidorów umieszczano podobiznę panujących władców francuskich."
                            },
                            {
                                "example_id": "bac7090b-e291-4226-8444-b16d967fc59f",
                                "sense_id": "5800c167-a607-34ab-aa1f-21169bff42fb",
                                "text": "Ja widzę rzeczy wielkie, i piękne i śmiałe, / Która ludzkość mizerna, rachityczna, chora, / Chwyta z obrzydliwością w swoje ręce małe / I przerabia na rubla, gwineę, luidora!"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "33b9c2c1-1e9c-4c8f-8cd9-1961ab914af7",
                        "source_entry_id": "bb341bd1-6b4a-3975-a7c4-01aab768b834",
                        "source_sense_id": "5800c167-a607-34ab-aa1f-21169bff42fb",
