                            {
                                "example_id": "c0e14144-74fa-4062-9860-b56f54688e3b",
                                "sense_id": "6edc282b-5747-3a82-9385-1b694a457113",
                                "text": "Rapsodie pour orchestre et saxophone."
                            },
                            {
                                "example_id": "758015b7-2df7-4f0a-94e8-468e5555b40b",
                                "sense_id": "6edc282b-5747-3a82-9385-1b694a457113",
                                "text": "Il ne parcourra qu’avec impatience cette interminable et incohérente rapsodie de fables, de préceptes et de déclamations, qui inspire rarement un sentiment ou une idée, qui se traîne quelquefois dans la poussière, et d’autres fois se perd dans les nues."
                            },
                            {
                                "example_id": "9c14feaa-67c9-402a-b82e-8f6bb764855c",
                                "sense_id": "6edc282b-5747-3a82-9385-1b694a457113",
                                "text": "Lucien, ne pouvant le remercier, se mit à lire avec lui la rapsodie ayant pour titre Victoires et Conquêtes des Français."
                            }
                        ]
                    }
                ],
