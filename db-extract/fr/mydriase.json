                        "entry_id": "c9865a64-84fd-33ad-be10-1567977df0f0",
                        "glosses": [
                            "Paralysie de l’iris caractérisée par la dilatation permanente de la pupille, ou temporaire sous l’effet d’une substance telle que l’atropine."
                        ],
                        "tags": [
                            "Nosologie"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "fef926bd-e193-3ed5-b450-36a45216f004",
                        "entry_id": "c9865a64-84fd-33ad-be10-1567977df0f0",
                        "glosses": [
                            "Augmentation normale du diamètre de la pupille par contraction du muscle dilatateur de l'iris, pour capter plus de lumière."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7fa1bfb8-9cdf-48fa-a1fa-7837767a6c84",
                                "sense_id": "fef926bd-e193-3ed5-b450-36a45216f004",
                                "text": "La pupille se dilate lors de moments de stupeur mais aussi de gaieté. Une mydriase est donc plutôt un signe de confiance en soi et de bien-être. Les émotions négatives, en revanche, se traduisent souvent par un myosis."
                            }
                        ]
                    }
