{
    "word_family": [
        "opalić",
        "opalenizna",
        "opalanie",
        "opalony",
        "opalacz"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "462262d6-1260-3278-b47a-df079092c56a",
                    "sense_definition": "wystawiać ciało lub skórę na działanie promieni słonecznych",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "slonce",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W lecie chętnie <w>opalam</w> całe ciało nad jeziorem.",
                            "target_lang_translations": {
                                "ru": "Летом я с удовольствием <w>подставляю солнцу</w> всё тело у озера."
                            }
                        },
                        {
                            "text": "Dlaczego znowu <w>opalasz</w> twarz bez kremu z filtrem?",
                            "target_lang_translations": {
                                "ru": "Почему ты опять <w>загораешь</w> лицом без защитного крема?"
                            }
                        }
                    ],
                    "common_phrases": [
                        "opalać twarz",
                        "opalać plecy"
                    ],
                    "target_lang_definitions": {
                        "ru": "подставлять тело или часть тела солнечным лучам, загорать"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "загорать",
                                "target_lang_sense_clarification": "на солнце"
                            },
                            {
                                "target_lang_word": "подставлять солнцу",
                                "target_lang_sense_clarification": "кожу или часть тела"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ca224640-214d-35e3-b440-beee427564c3",
                    "sense_definition": "o słońcu: sprawiać, że skóra staje się brązowa lub ciemniejsza",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "slonce",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W południe mocne słońce <w>opala</w> wyjątkowo szybko i intensywnie.",
                            "target_lang_translations": {
                                "ru": "В полдень яркое солнце <w>оставляет загар</w> исключительно быстро и интенсивно."
                            }
                        },
                        {
                            "text": "Wysoko w górach ostre słońce <w>opalało</w> nas nawet przez chmury.",
                            "target_lang_translations": {
                                "ru": "Высоко в горах палящее солнце <w>опаляло</w> нас даже сквозь облака."
                            }
                        }
                    ],
                    "common_phrases": [
                        "słońce opala"
                    ],
                    "target_lang_definitions": {
                        "ru": "о солнце: делать кожу тёмной или загорелой"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "делать загар",
                                "target_lang_sense_clarification": "о солнце"
                            },
                            {
                                "target_lang_word": "опалять",
                                "target_lang_sense_clarification": "о солнце, обжигать кожу"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d796ca89-d821-34e5-8fd7-2d3c835e3b0f",
                    "sense_definition": "ogrzewać budynek lub pomieszczenie przez spalanie materiału opałowego",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "ogrzewanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Moi dziadkowie nadal <w>opalają</w> stary dom drewnem i węglem.",
                            "target_lang_translations": {
                                "ru": "Мои бабушка и дедушка до сих пор <w>отапливают</w> старый дом дровами и углём."
                            }
                        },
                        {
                            "text": "Zastanawiamy się, czym najtaniej <w>opalać</w> ten duży budynek zimą.",
                            "target_lang_translations": {
                                "ru": "Мы думаем, чем дешевле всего <w>топить</w> это большое здание зимой."
                            }
                        }
                    ],
                    "synonyms": [
                        "ogrzewać"
                    ],
                    "common_phrases": [
                        "opalać dom",
                        "opalać węglem",
                        "opalać drewnem"
                    ],
                    "target_lang_definitions": {
                        "ru": "отапливать помещение или здание сжиганием топлива"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отапливать",
                                "target_lang_sense_clarification": "помещение, дом"
                            },
                            {
                                "target_lang_word": "топить",
                                "target_lang_sense_clarification": "печь, дровами или углём"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b8b35b90-d3b1-3e77-b35b-0cb3e6a1abef",
                    "sense_definition": "podgrzewać coś płomieniem z wierzchu, aby usunąć włoski, pióra lub nierówności",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "ogien",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Przed gotowaniem rosołu kucharz starannie <w>opala</w> skórę drobiu nad ogniem.",
                            "target_lang_translations": {
                                "ru": "Перед варкой бульона повар тщательно <w>опаливает</w> кожу птицы над огнём."
                            }
                        },
                        {
                            "text": "Zawsze <w>opalałem</w> końcówki syntetycznych sznurków, żeby się nie pruły.",
                            "target_lang_translations": {
                                "ru": "Я всегда <w>опаливал</w> концы синтетических шнурков, чтобы они не распускались."
                            }
                        }
                    ],
                    "synonyms": [
                        "osmalic"
                    ],
                    "common_phrases": [
                        "opalać nad płomieniem"
                    ],
                    "target_lang_definitions": {
                        "ru": "обрабатывать пламенем снаружи (птицу, нитки и т. д.)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "опаливать",
                                "target_lang_sense_clarification": "птицу, концы шнурков над огнём"
                            },
                            {
                                "target_lang_word": "обжигать",
                                "target_lang_sense_clarification": "края, поверхность"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a6cfe791-fa48-3652-bfe4-6308d7867286",
                    "sense_definition": "przypadkowo uszkadzać płomieniem fragment ubrania lub włosów",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "ogien",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pochylił się zbyt blisko świeczki i niemal <w>opalał</w> sobie grzywkę.",
                            "target_lang_translations": {
                                "ru": "Он наклонился слишком близко к свече и чуть не <w>подпалил</w> себе чёлку."
                            }
                        },
                        {
                            "text": "Przez nieuwagę przy ognisku brat <w>opalał</w> rękaw nowej kurtki.",
                            "target_lang_translations": {
                                "ru": "По невнимательности у костра брат <w>подпаливал</w> рукав новой куртки."
                            }
                        }
                    ],
                    "synonyms": [
                        "przypalać",
                        "osmalic"
                    ],
                    "target_lang_definitions": {
                        "ru": "случайно повреждать огнём часть одежды или волос"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подпаливать",
                                "target_lang_sense_clarification": "случайно огнём"
                            },
                            {
                                "target_lang_word": "прижигать",
                                "target_lang_sense_clarification": "край ткани, волосы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d80af27d-a56e-3e54-8c1f-79200dcb1fa9",
                    "sense_definition": "naciągać innych na papierosy i palić na ich koszt",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "On nigdy nie ma własnej paczki i bez przerwy <w>opala</w> kolegów z pracy.",
                            "target_lang_translations": {
                                "ru": "У него никогда нет своей пачки, и он постоянно <w>стреляет сигареты у</w> коллег по работе."
                            }
                        },
                        {
                            "text": "Przestań mnie wreszcie <w>opalać</w> i kup sobie własne papierosy.",
                            "target_lang_translations": {
                                "ru": "Перестань наконец <w>стрелять у</w> меня и купи себе собственные сигареты."
                            }
                        }
                    ],
                    "common_phrases": [
                        "opalać kolegów"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "выпрашивать сигареты, курить за чужой счёт"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стрелять",
                                "target_lang_sense_clarification": "сигареты, курить за чужой счёт"
                            },
                            {
                                "target_lang_word": "клянчить сигареты",
                                "target_lang_sense_clarification": "у других"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}