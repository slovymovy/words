                                    {
                                        "sense_id": "e1a58cd8-f292-3f40-8afc-798afe049df4",
                                        "entry_id": "b4627e30-a11b-3956-8a37-d9a2df27345d",
                                        "glosses": [
                                            "To create in one’s mind; to invent."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "91a5f074-56cf-45bd-a71f-b30d8eac1fd9",
                                                "sense_id": "e1a58cd8-f292-3f40-8afc-798afe049df4",
                                                "text": "I can think up plenty of excuses not to go, but we really should attend."
                                            }
                                        ]
                                    }
                                ]
