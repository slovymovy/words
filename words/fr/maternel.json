            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "07e3ae8f-a1ef-3500-bb60-695ab3367576",
                    "sense_definition": "Qualifie la première langue apprise dès l'enfance au sein de sa famille.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "langue",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le français est sa langue <w>maternelle</w>, mais elle parle aussi espagnol couramment."
                        },
                        {
                            "text": "Les enfants qui grandissent dans un foyer bilingue possèdent souvent deux langues <w>maternelles</w>."
                        }
                    ],
                    "common_phrases": [
                        "langue maternelle"
                    ]
                },
                {
                    "sense_id": "233d394b-1abb-3fa9-a8c4-f02e8e952496",
                    "sense_definition": "Qui est propre ou naturel à une mère, ou qui en évoque la tendresse protectrice.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "comportement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle protège ses jeunes enfants au quotidien avec un profond amour <w>maternel</w>."
                        },
                        {
                            "text": "Son attitude douce et <w>maternelle</w> a tout de suite rassuré le petit garçon perdu."
                        }
                    ],
                    "antonyms": [
                        "paternel"
                    ],
                    "common_phrases": [
                        "amour maternel",
                        "instinct maternel"
                    ]
                },
                {
                    "sense_id": "2a79db42-a767-3dbb-b3f4-671207cbe3ed",
                    "sense_definition": "Relatif à la parenté ou à la filiation du côté de la mère.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "parenté",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chaque été, nous rendons visite à nos grands-parents <w>maternels</w> dans le sud de la France."
                        },
                        {
                            "text": "Elle ressemble beaucoup à sa tante <w>maternelle</w> dont elle a hérité les yeux bleus."
                        }
                    ],
                    "antonyms": [
                        "paternel"
                    ],
                    "common_phrases": [
                        "côté maternel",
                        "grands-parents maternels",
                        "oncle maternel"
                    ]
                }
            ]
        }
