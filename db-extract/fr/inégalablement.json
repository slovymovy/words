                        "entry_id": "69844533-b060-367b-a149-d6a0770b7a66",
                        "glosses": [
                            "De manière inégalable ; sans qu'on puisse faire aussi bien."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "e1da10bc-6fa9-4d1f-9d74-84f13628b2d0",
                                "sense_id": "1c7448fc-e618-3535-b77f-9abf32fc067e",
                                "text": "La traduction anglaise de ce verset est inégalablement belle : « I am thy shield and thy exceeding great reward. »"
                            },
                            {
                                "example_id": "9ff2d8c4-9150-45af-8206-6928f44e6814",
                                "sense_id": "1c7448fc-e618-3535-b77f-9abf32fc067e",
                                "text": "La raison pour laquelle cette attitude est obscure consiste en ce que la foi fait croire l'âme à des vérités révélées par Dieu lui-même, qui dépassent inégalablement toute intelligence humaine."
                            }
                        ]
                    }
