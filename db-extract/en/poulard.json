                                        "examples": [
                                            {
                                                "example_id": "0ac76f97-9978-4763-800e-1595cbf95862",
                                                "sense_id": "4afab0d2-9399-323b-83b2-91a1dfe1d88d",
                                                "text": "C’était un bout de la pièce qu’il voulait semer de blé, une variété écossaise de poulard, une tentative que lui avait conseillée son ancien maître."
                                            },
                                            {
                                                "example_id": "24451080-95de-4714-adab-117c876e098c",
                                                "sense_id": "4afab0d2-9399-323b-83b2-91a1dfe1d88d",
                                                "text": "C'est un poulard blanc lisse, à épi plus court que le précédent, moins serré, moins régulier, à barbes tantôt blanches, tantôt noires. Le grain, d'un blanc jaune, tendre et de moyenne grosseur, annonce une belle qualité."
                                            }
                                        ]
