                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d78961e2-eeed-497c-81bf-cdfcfcc1290d",
                                "sense_id": "0cb7c13c-4fe5-3682-a1c5-dfec86b201b7",
                                "text": "Na het uitbreken van de brand bleek het draaiboek 'grote rampen' nergens te vinden."
                            }
                        ]
