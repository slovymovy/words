{
    "word_family": [
        "photograph",
        "photographer",
        "photography",
        "photographic",
        "photogenic",
        "photocopy"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4ea362c1-0094-3949-814e-6fb7f0948fc2",
                    "sense_definition": "A picture taken with a camera.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "image",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Can you please take a <w>photo</w> of us?",
                            "target_lang_translations": {
                                "ru": "Вы не могли бы сделать наше <w>фото</w>?",
                                "zh": "你能帮我们<w>拍</w>张照片吗？"
                            }
                        },
                        {
                            "text": "She keeps a <w>photo</w> of her family on her desk.",
                            "target_lang_translations": {
                                "ru": "Она хранит <w>фотографию</w> своей семьи на рабочем столе.",
                                "zh": "她在桌子上放了一张家人的<w>照片</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "photograph",
                        "picture",
                        "image",
                        "snapshot",
                        "shot"
                    ],
                    "common_phrases": [
                        "take a photo",
                        "photo album",
                        "profile photo",
                        "group photo",
                        "digital photo"
                    ],
                    "target_lang_definitions": {
                        "ru": "Изображение, полученное с помощью фотоаппарата.",
                        "zh": "用照相机拍摄的图像。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фотография",
                                "target_lang_sense_clarification": "основное значение"
                            },
                            {
                                "target_lang_word": "фото",
                                "target_lang_sense_clarification": "разговорное сокращение"
                            },
                            {
                                "target_lang_word": "снимок",
                                "target_lang_sense_clarification": "результат съемки"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "照片",
                                "target_lang_sense_clarification": "最常用的名词形式"
                            },
                            {
                                "target_lang_word": "相片",
                                "target_lang_sense_clarification": "照片的另一种说法"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5df59987-cdc0-39d3-ae61-1a0ecf05437e",
                    "sense_definition": "The activity, art, or profession of taking photographs; photography.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "activity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He works as a <w>photo</w> editor for a fashion magazine.",
                            "target_lang_translations": {
                                "ru": "Он работает <w>фото</w>редактором в модном журнале.",
                                "zh": "他在一家时尚杂志社担任<w>图片</w>编辑。"
                            }
                        },
                        {
                            "text": "The <w>photo</w> session took longer than we expected.",
                            "target_lang_translations": {
                                "ru": "<w>Фото</w>сессия заняла больше времени, чем мы ожидали.",
                                "zh": "这次<w>拍摄</w>过程比我们预想的要长。"
                            }
                        }
                    ],
                    "synonyms": [
                        "photography"
                    ],
                    "common_phrases": [
                        "photo shoot",
                        "photo session",
                        "photo editor",
                        "photo journalist"
                    ],
                    "target_lang_definitions": {
                        "ru": "Деятельность или профессия, связанная с фотографией; часто используется как первая часть сложных слов.",
                        "zh": "与摄影相关的活动或职业；常作为复合词的前缀。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фото",
                                "target_lang_sense_clarification": "как часть сложных слов (напр. фотосессия)"
                            },
                            {
                                "target_lang_word": "фотографический",
                                "target_lang_sense_clarification": "прилагательное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "摄影",
                                "target_lang_sense_clarification": "指摄影艺术或职业"
                            },
                            {
                                "target_lang_word": "照相",
                                "target_lang_sense_clarification": "指拍照的活动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b2f39434-84f3-34a1-820c-58781a653bcd",
                    "sense_definition": "A finish in a race where the competitors are so close that a photograph is needed to determine the winner.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "race_result",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The horse race ended in a <w>photo</w>, so we waited for the official result.",
                            "target_lang_translations": {
                                "ru": "Скачки закончились <w>фотофинишем</w>, поэтому мы ждали официального результата.",
                                "zh": "赛马比赛以<w>照片判定</w>结束，所以我们等待了官方结果。"
                            }
                        },
                        {
                            "text": "It was a <w>photo</w> at the finish line between the two fastest runners.",
                            "target_lang_translations": {
                                "ru": "На финишной черте между двумя самыми быстрыми бегунами был <w>фотофиниш</w>.",
                                "zh": "两位最快的选手在终点线处几乎同时到达，需要<w>照片判定</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "photo finish"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "short for photo finish"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Окончание гонки, когда участники приходят настолько близко друг к другу, что для определения победителя требуется снимок.",
                        "zh": "赛跑中因选手几乎同时到达终点，需通过照片来判定胜负的情况。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фотофиниш",
                                "target_lang_sense_clarification": "спортивный термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "照片判定",
                                "target_lang_sense_clarification": "体育术语"
                            },
                            {
                                "target_lang_word": "照相终点",
                                "target_lang_sense_clarification": "指通过照片判定胜负的终点线"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "04ef4d11-4775-3296-a2e3-975026ddcb16",
                    "sense_definition": "To take a photograph of someone or something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We stopped to <w>photo</w> the beautiful sunset over the ocean.",
                            "target_lang_translations": {
                                "ru": "Мы остановились, чтобы <w>сфотографировать</w> красивый закат над океаном.",
                                "zh": "我们停下来<w>拍摄</w>海面上美丽的日落。"
                            }
                        },
                        {
                            "text": "He likes to <w>photo</w> birds in his garden during the spring.",
                            "target_lang_translations": {
                                "ru": "Он любит <w>фотографировать</w> птиц в своем саду весной.",
                                "zh": "他喜欢在春天<w>拍摄</w>花园里的鸟儿。"
                            }
                        }
                    ],
                    "synonyms": [
                        "photograph",
                        "snap",
                        "shoot"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фотографировать кого-либо или что-либо.",
                        "zh": "拍摄某人或某物的照片。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фотографировать",
                                "target_lang_sense_clarification": "действие"
                            },
                            {
                                "target_lang_word": "снимать",
                                "target_lang_sense_clarification": "делать снимки"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "拍照",
                                "target_lang_sense_clarification": "动词，指拍摄照片"
                            },
                            {
                                "target_lang_word": "摄影",
                                "target_lang_sense_clarification": "动词，指进行拍摄活动"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}