                    {
                        "translation_id": "d87ff8f9-08a5-4d52-a326-54600745dd7e",
                        "source_entry_id": "de637047-69c9-3dea-a49a-616cecdabda0",
                        "source_sense_id": "e4eebe6a-29c1-362d-b9c8-1f60f4f8cd23",
                        "target_lang_word": "villa",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "villa",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "9ad0690f-d20f-353a-8da1-40d11d778ffd",
                                        "entry_id": "bf93dcd4-3a68-3638-a93f-ae5be2c405c9",
                                        "glosses": [
                                            "een groot en vrijstaand huis"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96754d0d-2310-497f-bbc4-9ea772360ddf",
                                                "sense_id": "9ad0690f-d20f-353a-8da1-40d11d778ffd",
                                                "text": "Hij woont in die grote villa daar."
                                            },
                                            {
                                                "example_id": "6be9d881-e26b-4376-ac43-459a1f86806d",
                                                "sense_id": "9ad0690f-d20f-353a-8da1-40d11d778ffd",
                                                "text": "Het Grand Hotel was al in 1893 klaar, het sanatorium tien jaar later, aan de zuidkant van de spoorweg werden grote villa's gebouwd, de huizen van de arbeiders kwamen aan de noordkant."
                                            },
                                            {
                                                "example_id": "bf665318-9dcf-4841-ac91-a6c95a1abecb",
                                                "sense_id": "9ad0690f-d20f-353a-8da1-40d11d778ffd",
                                                "text": "In de villa tegenover me was het donker en stil."
                                            },
                                            {
                                                "example_id": "a35ddf52-a418-45fd-a047-49066db7b9f6",
                                                "sense_id": "9ad0690f-d20f-353a-8da1-40d11d778ffd",
                                                "text": "Er is een erotische scène op te zien en mogelijk de vloer van een slaapkamer in een villa of domus, een stadswoning voor de rijke klasse in de Romeinse tijd."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0f1c3457-dfed-4149-b209-aba945252278",
                        "source_entry_id": "de637047-69c9-3dea-a49a-616cecdabda0",
                        "source_sense_id": "e4eebe6a-29c1-362d-b9c8-1f60f4f8cd23",
                        "target_lang_word": "Villa",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Villa",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5909fbe8-a7cc-3071-b82a-00849fa1d409",
                                        "entry_id": "e19e19a5-07f9-3027-838d-e40b5caa8894",
                                        "glosses": [
                                            "großes, freistehendes Einfamilienhaus mit großem Garten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ff35bdd-f23d-4dce-a93f-968c0cb8961a",
                                                "sense_id": "5909fbe8-a7cc-3071-b82a-00849fa1d409",
                                                "text": "In Hamburg kann man am Elbufer schöne Villen sehen."
                                            },
                                            {
                                                "example_id": "fb90b220-f5f6-4f56-8a24-e9be9f16169a",
                                                "sense_id": "5909fbe8-a7cc-3071-b82a-00849fa1d409",
                                                "text": "„Die reichen Weißen in den Villen an der Esplanade ließen auf der gegenüberliegenden Seite großzügige Häuser für ihre schwarzen und halbblütigen Mätressen errichten.“"
                                            },
                                            {
                                                "example_id": "41613d25-a176-4b59-b612-f0506effc220",
                                                "sense_id": "5909fbe8-a7cc-3071-b82a-00849fa1d409",
                                                "text": "„Vor dem Abflug brachte sie ihren Freund dazu, ihr eine Generalvollmacht über sein Vermögen, Blankounterschriften, die Schlüssel für sein Auto und den Tresor in der Villa samt Zahlenkombinationen zu überlassen.“"
                                            },
                                            {
                                                "example_id": "507c5c3e-c5d1-4e4c-9f8a-012a2561fd46",
                                                "sense_id": "5909fbe8-a7cc-3071-b82a-00849fa1d409",
                                                "text": "„Gestern bin ich aus der Villa ausgezogen.“"
                                            },
                                            {
                                                "example_id": "15fdda7e-f741-4f65-a2d6-2c40dbda74c9",
                                                "sense_id": "5909fbe8-a7cc-3071-b82a-00849fa1d409",
                                                "text": "„Da sie auch Diener und Hausmädchen mitgenommen hätten, stünden ihre Villen und Paläste leer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1bc4944e-fad2-4f12-b428-760e6b7659c0",
                        "source_entry_id": "de637047-69c9-3dea-a49a-616cecdabda0",
