                        "examples": [
                            {
                                "example_id": "fad568e6-10b4-4c75-aeb1-25301d3446f7",
                                "sense_id": "85ebd879-d380-36bb-bbcf-a244ac0bfc72",
                                "text": "Ces trente mille francs inespérés le grisaient encore plus que la purée septembrale, il les maniait idéalement entre ses pouces."
                            },
                            {
                                "example_id": "e1b842aa-ac60-4de0-a11a-a9ce582a9628",
                                "sense_id": "85ebd879-d380-36bb-bbcf-a244ac0bfc72",
                                "text": "Par un beau temps septembral, le long d’un chemin de campagne, s’avance un groupe de curés rabelaisiens."
                            },
                            {
                                "example_id": "684707fb-391c-437e-adde-84c12ccc2674",
                                "sense_id": "85ebd879-d380-36bb-bbcf-a244ac0bfc72",
                                "text": "Ce qui est extraordinaire c'est que toute cette maculature peut se renverser en constellation dans le vol migratoire septembral dont ces vols vespéraux dont parle Buffon sont l'esquisse."
                            }
                        ]
                    }
