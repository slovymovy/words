                        "glosses": [
                            "sporter die een financiële overeenkomst heeft gesloten met een sportclub"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ccef384-27bb-4fbc-ba28-2cbc950a3bf2",
                                "sense_id": "8d6ebaa0-2ff0-3199-bb7b-a331bfff28ac",
                                "text": "De overgang werd namelijk aanvankelijk tegengehouden door Santos en de Braziliaanse voetbalbond. De FIFA heeft nu aan de KNVB en Ajax laten weten dat Giovanni met onmiddellijke ingang geregistreerd kan worden als contractspeler van Ajax."
                            },
                            {
                                "example_id": "3037410d-6326-49f2-8fc5-d83f285ae728",
                                "sense_id": "8d6ebaa0-2ff0-3199-bb7b-a331bfff28ac",
                                "text": "De 44-jarige Hagenaar is al ruim twintig jaar aan de Eindhovense club verbonden. Tussen 2000 en 2008 was hij contractspeler. Na het beëindigen van zijn actieve loopbaan trad De Jong toe tot het scoutingsteam, waarin hij vanaf 2013 hoofdscout was."
                            },
                            {
                                "example_id": "347537cb-a9c3-453a-835a-a530eeb7421b",
                                "sense_id": "8d6ebaa0-2ff0-3199-bb7b-a331bfff28ac",
                                "text": "De 25-jarige Warda werd deze week om disciplinaire redenen uit de selectie gezet. De Egyptische bond gaf geen verdere toelichting op de maatregel, maar vermoedelijk had die te maken met eerdere beschuldigingen tegen de middenvelder. De contractspeler van de Griekse club PAOK Saloniki wordt ervan beschuldigd dat hij een model heeft lastiggevallen via Instagram."
                            }
                        ]
                    }
