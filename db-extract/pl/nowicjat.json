                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c23780ba-1c66-427d-a454-13b12a5f11cc",
                                "sense_id": "61749b37-13c3-3065-8b94-815618410d7f",
                                "text": "Osobom postronnym nie wolno wchodzić na nowicjat bez zgody magistra."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "648e68be-6fb0-38ab-979c-b66bbbc186ea",
                        "entry_id": "9444b6f6-3adb-32ac-9897-4dc932bae8b1",
