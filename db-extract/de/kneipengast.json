                "senses": [
                    {
                        "sense_id": "4a2fd705-c39c-3742-b8da-0f7abef06a83",
                        "entry_id": "6344f4ba-ed15-3304-8de5-c837311b1e47",
                        "glosses": [
                            "jemand, der in sich in einer Kneipe aufhält, um sich dort zu vergnügen, Alkohol zu trinken, et cetera …"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab34ea8c-194d-4de1-8d9a-9151a961fa9a",
                                "sense_id": "4a2fd705-c39c-3742-b8da-0f7abef06a83",
                                "text": "„Der Mann schritt bei einem Überfall mutig ein und bezahlte dafür mit dem Leben: Gut zwei Monate nach dem Tod eines Kneipengastes in Bocholt hat die Staatsanwaltschaft Anklage gegen den mutmaßlichen Täter erhoben.“"
                            },
                            {
                                "example_id": "549a3ba0-3a02-4631-a421-68657b833cac",
                                "sense_id": "4a2fd705-c39c-3742-b8da-0f7abef06a83",
                                "text": "„So mancher Einwohner geht mit dem Gewehr schlafen, und nicht selten schultern Kneipengäste ihre Waffe, bevor sie das Lokal verlassen.“"
                            },
                            {
                                "example_id": "24d24435-52c1-49a9-95d7-4ed5f7710138",
                                "sense_id": "4a2fd705-c39c-3742-b8da-0f7abef06a83",
                                "text": "„Wieder Ärger um Abzocke auf dem Kiez: Die Hamburger Polizei hat drei Tatverdächtige festgenommen, die von einem Kneipengast unter Androhung von Schlägen 340 Euro erpresst haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
