                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d266af2c-03ab-46dc-bb99-1e9c1601d265",
                                "sense_id": "15ca1248-98db-3caa-bc12-5fd610de9d23",
                                "text": "Das Unfallopfer erlitt eine Knieverletzung."
                            },
                            {
                                "example_id": "405d234a-1879-4af6-b187-fca29cd9073d",
                                "sense_id": "15ca1248-98db-3caa-bc12-5fd610de9d23",
                                "text": "„Europacup-Gesamtsieger Maximilian Lahnsteiner hat sich wenige Tage vor dem Weltcup-Auftakt der Alpinskiläufer in Sölden eine schwere Knieverletzung zugezogen und fällt für die gesamte Saison aus.“"
                            },
                            {
                                "example_id": "2b77005b-a882-459a-a473-741cc635dce7",
                                "sense_id": "15ca1248-98db-3caa-bc12-5fd610de9d23",
                                "text": "„Leider beendete eine Knieverletzung seine vielversprechende Karriere nach nur wenigen Jahren.“"
                            }
                        ],
