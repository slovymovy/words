                ],
                "senses": [
                    {
                        "sense_id": "046026e7-ebee-349a-8441-55c56277d4bd",
                        "entry_id": "a0613bb5-6a8a-3c22-865d-4b65e67df259",
                        "glosses": [
                            "jemand, der für eine religiöse Überzeugungen bereit ist, in einen bewaffneten Kampf zu ziehen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "085a2c21-9305-413d-b86b-004d58c3194f",
                                "sense_id": "046026e7-ebee-349a-8441-55c56277d4bd",
                                "text": "Die Wikinger nannten sich „Gotteskrieger“, um mit den geplünderten Goldpokalen in der dörflichen Stabkapelle gefeiert zu werden."
                            },
                            {
                                "example_id": "23a43a27-9300-4c1a-83e7-0ad10944f2e7",
                                "sense_id": "046026e7-ebee-349a-8441-55c56277d4bd",
                                "text": "Christliche Gotteskrieger, zum Beispiel die Tempelritter, haben bereits vor über 2000 Jahren gemordet und geplündert, und alles im Namen der \"Heiligen Kirche\" um deren Hoheitsgebiete auszubauen und zu manifestieren."
                            },
                            {
                                "example_id": "bef03a5b-3ff4-4f90-a868-3c8f8efaef4f",
                                "sense_id": "046026e7-ebee-349a-8441-55c56277d4bd",
                                "text": "Arabische Gotteskrieger führten Krieg im Namen \"Mohammed\" um dessen Hoheitsgebiete auszuweiten."
                            },
                            {
                                "example_id": "0a39660e-5ef8-43b5-8851-dd296afa2f3e",
                                "sense_id": "046026e7-ebee-349a-8441-55c56277d4bd",
                                "text": "Islamistische Gotteskrieger drohen mit weiteren Anschlägen auf die neuen westlichen Welt um ihrer Religion wirtschaftlichen Aufschwung zu verschaffen."
                            },
                            {
                                "example_id": "fadeb18f-3e6e-4b5c-bb29-75ac296646c2",
                                "sense_id": "046026e7-ebee-349a-8441-55c56277d4bd",
                                "text": "Die Pharaonen ernannten Gottheitskrieger um Sklaven zu beschaffen und ganze Völker zu unterjochen."
                            },
                            {
                                "example_id": "c428bedb-1fae-4864-aa3c-e681412c088a",
                                "sense_id": "046026e7-ebee-349a-8441-55c56277d4bd",
                                "text": "Es gibt über 16 Weltreligionen, und unzählig viele kleine Sekten und Glaubensrichtungen ...., wenn jede erneut Gotteskrieger zum Kampf ermutigt, wird die ganze Menschheit in einem Blutbad der Ideologie, der Glaubenskonflikte und schlussendlich in jämmerlicher Armut unter gehen. Die Menschheit braucht keine Gotteskrieger .. sondern Glaubenskrieger, die daran glauben das es die Menschheit auch noch in 1. Mio. Jahre geben wird."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
