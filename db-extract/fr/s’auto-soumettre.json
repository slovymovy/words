                ],
                "senses": [
                    {
                        "sense_id": "15c41c79-9e5e-332b-adb5-05f7e2026fe0",
                        "entry_id": "c1dd366f-018b-3223-93f8-e50a45938f36",
                        "glosses": [
                            "Se soumettre de soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf2a7e7e-1fc7-42c4-a623-da1c4e7ff3e9",
                                "sense_id": "15c41c79-9e5e-332b-adb5-05f7e2026fe0",
                                "text": "La force de cette raison lui vient de sa capacité de s’auto-soumettre à l’épreuve raisonnable."
                            },
                            {
                                "example_id": "599b9887-8e02-43b0-9925-2774646f989c",
                                "sense_id": "15c41c79-9e5e-332b-adb5-05f7e2026fe0",
                                "text": "Permets-moi de m'auto-soumettre afin de sanctionner ma défaillance cérébrale."
                            },
                            {
                                "example_id": "cb84914e-1016-4c43-8a6f-62d1240ed057",
                                "sense_id": "15c41c79-9e5e-332b-adb5-05f7e2026fe0",
                                "text": "par contre s'auto-soumettre à une entité abstraite appelé \"nation\", faire d'elle son maître et cela de son plein gré, c'est juste à mourir de rire."
                            }
                        ]
                    }
