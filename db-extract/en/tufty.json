                "senses": [
                    {
                        "sense_id": "3840d1ee-77cb-3fb3-bb85-31a9b1b6024d",
                        "entry_id": "98a674ac-e0f2-3cc1-af72-f59fc6c3e5a2",
                        "glosses": [
                            "The tufted duck (Aythya fuligula)."
                        ],
                        "tags": [
                            "British",
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "24d5abcc-928a-4e69-b33b-a96c70dd0c52",
                                "sense_id": "3840d1ee-77cb-3fb3-bb85-31a9b1b6024d",
                                "text": "Buoyant. That's a tufty. Well, tufted duck, to be formal, but the name always sounds more like tufty duck, and there is something inspiringly matey about a tufty: we are on nickname terms with the bird at first glance."
                            }
                        ]
