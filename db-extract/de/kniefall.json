                        ],
                        "form": "den Kniefall"
                    },
                    {
                        "form_id": "fe4dcc84-2ad4-457e-9c52-05b75713fd3f",
                        "entry_id": "9c35cec2-8339-3385-962e-359491efd359",
                        "tags": [
                            "accusative",
