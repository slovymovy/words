                ],
                "senses": [
                    {
                        "sense_id": "36abcd10-4756-309b-a7fd-76ff3f7ad6b6",
                        "entry_id": "517216ab-8660-38da-9f31-50d7b8a5c879",
                        "glosses": [
                            "Maß für die Zündwilligkeit von Dieselkraftstoff"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85da301f-1c05-447e-932a-307f82cfac2a",
                                "sense_id": "36abcd10-4756-309b-a7fd-76ff3f7ad6b6",
                                "text": "„Ausschlaggebend für die akustische Verbesserung des neuen Kraftstoffs ist die Erhöhung der Cetanzahl.“"
                            },
                            {
                                "example_id": "5ace4b58-24aa-43f2-a8d3-197c3d6b7689",
                                "sense_id": "36abcd10-4756-309b-a7fd-76ff3f7ad6b6",
                                "text": "„Er enthält weder Schwefel noch Stickstoff oder aromatische Verbindungen, dafür aber eine deutlich höhere Cetanzahl (75-80 statt normal 50-56). Das bedeutet, er verbrennt viel sauberer und auch besser.“"
                            },
                            {
                                "example_id": "a4eae6e3-7a38-4655-aac6-240188fbc4d6",
                                "sense_id": "36abcd10-4756-309b-a7fd-76ff3f7ad6b6",
                                "text": "„Als Faustformel gilt: je höher die Cetanzahl, desto zündwilliger ist der Dieselkraftstoff – und umso besser und damit umso leiser verbrennt er.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
