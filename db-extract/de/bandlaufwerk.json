                "senses": [
                    {
                        "sense_id": "5d059b26-17ca-35ec-9a1d-bd432a9ea67d",
                        "entry_id": "47f73336-2fcd-3f33-9aed-a2111ec9790b",
                        "glosses": [
                            "Gerät zur Speicherung von Daten auf Magnetbändern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f1776b0-92f9-4b55-911c-09b6ab3db48c",
                                "sense_id": "5d059b26-17ca-35ec-9a1d-bd432a9ea67d",
                                "text": "Im Computermuseum sah er mehrere Bandlaufwerke aus den 1950er und 1960er Jahren."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "8c3b5f72-b7ab-3d3b-89dc-86d4bfd515b6",
                        "entry_id": "47f73336-2fcd-3f33-9aed-a2111ec9790b",
                        "glosses": [
                            "Fahrwerk mit Bändern / Ketten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3729f064-8656-4d5b-bee4-ef30b1e1c757",
                                "sense_id": "8c3b5f72-b7ab-3d3b-89dc-86d4bfd515b6",
                                "text": "„An allen vier Bandlaufwerken des Traktors sorgen ein Antriebsrad mit 11 % größerem Durchmesser und eine 5 % längere Gummikette – im Vergleich zu aktuellen den Quadtrac-Modellen – für eine längere Lebensdauer der Kette.“"
                            },
                            {
                                "example_id": "8b9c29c0-eed4-4666-8b1f-7a905ec2aa93",
                                "sense_id": "8c3b5f72-b7ab-3d3b-89dc-86d4bfd515b6",
                                "text": "„Der Claas Axion TerraTrac mit Bandlaufwerk startet in Serie.“"
                            },
                            {
                                "example_id": "a68035b7-38ca-4c03-ba30-cc4508b89dcb",
                                "sense_id": "8c3b5f72-b7ab-3d3b-89dc-86d4bfd515b6",
                                "text": "„Bei dem Bandlaufwerk (oder Raupenlaufwerk) wird die Arbeitsmaschine nicht durch Räder, sondern durch ein Gummiband angetrieben und getragen.“"
                            },
                            {
                                "example_id": "a94a572c-db0e-4736-bfbd-896041c477a6",
                                "sense_id": "8c3b5f72-b7ab-3d3b-89dc-86d4bfd515b6",
                                "text": "„Der Mähdrescher mit Bandlaufwerk und einer Last von 9500 kg auf einem Laufwerk ruft auch bei vollem Korntank keine Schäden am Boden hervor.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
