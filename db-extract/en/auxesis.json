                        ],
                        "examples": [
                            {
                                "example_id": "be4876ac-0217-4065-a518-638f5c3f93f9",
                                "sense_id": "30e97d90-a81f-34d0-a545-3b1bc1b2855f",
                                "text": "Avxesis, when we vse a greater word for a lesse, or thus, when the word is greater then the thing is in deede."
                            }
                        ]
                    },
                    {
                        "sense_id": "bdab39fe-76d2-3d3d-a5e6-34b6602e8575",
