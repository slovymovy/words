                "senses": [
                    {
                        "sense_id": "78c028af-9404-357a-8486-ee780808238e",
                        "entry_id": "a21aca92-5951-3ad7-8b63-2cb6cac5e14e",
                        "glosses": [
                            "Verschluss eines Gullys, als Gitter auf einem Straßenablauf für Regenwasser oder als Verschluss eines Wartungsschachtes zu einem unterirdischen Kanal"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4eb4063-5a6a-47d8-8b09-e5171fd68dbf",
                                "sense_id": "78c028af-9404-357a-8486-ee780808238e",
                                "text": "„In der Innenstadt von Oslo schweißte man die Gullydeckel zu.“"
                            },
                            {
                                "example_id": "1e2d531c-d52e-40a9-819c-a0506c012d63",
                                "sense_id": "78c028af-9404-357a-8486-ee780808238e",
                                "text": "„Als Ursache für Überschwemmungen nennt die Polizei mit Laub verstopfte Gullydeckel.“"
                            },
                            {
                                "example_id": "dce15d7c-4518-48d5-9f1d-70e8847cb0cc",
                                "sense_id": "78c028af-9404-357a-8486-ee780808238e",
                                "text": "„Grundsätzlich sind Gullydeckel (korrekt: Kanalschachtdeckel) nach DIN-Normen klassifiziert; die entsprechenden Codes sind DIN 1229 und DIN EN 124.“"
                            },
                            {
                                "example_id": "3990bc4b-eabd-4126-8212-c804f69587b7",
                                "sense_id": "78c028af-9404-357a-8486-ee780808238e",
                                "text": "„Die Spur führt zu einem Gullydeckel in der Nähe des alten Parks.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
