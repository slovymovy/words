                                            {
                                                "example_id": "85d8d7ef-fe03-4fb5-a12b-07c8b9e3dc5a",
                                                "sense_id": "5ccc9700-01df-3177-954d-a8a24dee7441",
                                                "text": "„In großer Höhe drehte ein Doppeldecker einen Looping nach dem andern und weit draußen übte die Marine Schießen.“"
                                            },
                                            {
                                                "example_id": "38e12bc7-f778-4799-8e19-38d345bfaaae",
                                                "sense_id": "5ccc9700-01df-3177-954d-a8a24dee7441",
                                                "text": "„Er machte seinen Pilotenschein und kaufte sich später einen Doppeldecker, einen Zweisitzer, und unternahm sogar mit seiner Tochter Geneviève Rundflüge.“"
                                            }
                                        ],
