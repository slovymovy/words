                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "7a164228-7abd-4ceb-b3f6-303b1378286d",
                                "sense_id": "1338537a-6649-38a5-a579-7ab611473096",
                                "text": "Heute gibt unser Quintett ein kleines Konzert."
                            },
                            {
                                "example_id": "4c2a0a7e-536f-472e-8719-8621c02b8928",
                                "sense_id": "1338537a-6649-38a5-a579-7ab611473096",
                                "text": "„Till Altenburg tourt mit einem Quintett durch Europa, der alte Hofnarr.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "be0a1153-e3ed-331b-9bb6-c0a9be4582cb",
                        "entry_id": "508b6539-5099-3f84-9f01-1cd314564e08",
