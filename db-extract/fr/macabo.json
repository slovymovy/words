                        "cross_references": [
                            {
                                "target_word": "tayer",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "2bf9de5f-fa5d-3842-a25d-d034db97903d",
                                        "entry_id": "4d94b0e5-e4de-30d1-9b05-e25fc13a40e3",
                                        "glosses": [
                                            "Xanthosoma sagittifolium een plant uit de aronskelkfamilie (Araceae). Het is een kruidachtige, vaste plant waarvan zowel de wortelknollen als de bladeren worden gegeten. De knol gebruikt men als ingrediënt in pom"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2db67833-9d27-454d-a72f-570fb3a3c5f1",
                                                "sense_id": "2bf9de5f-fa5d-3842-a25d-d034db97903d",
                                                "text": "Vroeger kochten we altijd van het merk Lufo, maar intussen is het nog wel de duurste, maar niet meer de beste. Andere merken zijn prima, zoals Apoera en zelfs de goedkoopste Fawaka is prima, maar daar zitten vaak nog grove stukken tayer in, die je er dan wel moet uithalen."
                                            },
                                            {
                                                "example_id": "1fbdb85e-7115-4f97-af00-698f4a41ebcf",
                                                "sense_id": "2bf9de5f-fa5d-3842-a25d-d034db97903d",
                                                "text": "Surinaamse eethuisjes waar moeders pot de toon zet, en waar je bijvoorbeeld bekende Surinaamse gerechten als roti-kip, moksi meti, of oma’s pom tayer kunt eten. Die keuken is in bijna veertig jaar niet of nauwelijks geëvolueerd. Want voor evolutie in de keuken heb je werkelijk goede koks nodig zoals Paul Bocuse deed met de haute cuisine en Ferran Adrià en Heston Blumenthal met de moleculaire keuken."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
