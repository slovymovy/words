                "senses": [
                    {
                        "sense_id": "0652dcbf-97a3-3f9f-a18c-2caac6dcf507",
                        "entry_id": "2fa52bc6-4af3-3d7b-ad50-91a513852edb",
                        "glosses": [
                            "Maschine zur Erzeugung von Strom mit Benzin oder Diesel, die bei einem Ausfall der öffentlichen Stromversorgung einspringt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d75a9ec-c262-4493-924d-24cae7dd2414",
                                "sense_id": "0652dcbf-97a3-3f9f-a18c-2caac6dcf507",
                                "text": "„BMW bietet den i3 (ab 35.700 Euro) auch mit „Range Extender“ an. Diese 40.400 Euro teure Variante hat einen kleinen Benzinmotor im Heck, der wie ein Notstromgenerator bei Bedarf anspringt und die Akkus lädt (also nicht direkt antreibt).“"
                            },
                            {
                                "example_id": "34334e99-e3f2-43ed-9f4c-937d41fde86d",
                                "sense_id": "0652dcbf-97a3-3f9f-a18c-2caac6dcf507",
                                "text": "„Neben einer eigenen Wasseraufbereitungsanlage, gibt es auch einen Windgenerator, eine Photovoltaik-Anlage sowie einen Notstromgenerator.“"
                            },
                            {
                                "example_id": "802eb61c-b360-445d-9dd6-ab4cf223b0b6",
                                "sense_id": "0652dcbf-97a3-3f9f-a18c-2caac6dcf507",
                                "text": "„Insbesondere den Notstromgenerator wollten die Bordbesucher am Donnerstag deshalb inspizieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
