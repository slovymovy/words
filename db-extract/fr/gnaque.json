                                        "sense_id": "0cfa3579-c25b-36e7-8fd7-3bf2671c7672",
                                        "entry_id": "2733bb67-fccb-3c15-a787-e21894b20e53",
                                        "glosses": [
                                            "The act of determining, or the state of being determined.",
