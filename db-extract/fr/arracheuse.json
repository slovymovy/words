                        "glosses": [
                            "Délinquante qui arrache le collier de sa victime."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "7e0ab6ed-c9af-352a-af98-f805843e4d59",
                        "entry_id": "02c392f8-5565-3b69-8ac5-fceeed894838",
                        "glosses": [
                            "Machine qui sert à arracher les betteraves, les pommes de terre, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "88d31c94-0f03-4024-a22c-6530bba6eb6c",
                                "sense_id": "7e0ab6ed-c9af-352a-af98-f805843e4d59",
                                "text": "On a cité ici l’emploi de l’arracheuse de pommes de terre pour nettoyer les champs infestés de chiendent; mais cette utilisation n’est pas la seule particularité de cet instrument fort pratique."
                            },
                            {
                                "example_id": "786ea61b-1ca2-4ce1-9726-4ca8ef1ec735",
                                "sense_id": "7e0ab6ed-c9af-352a-af98-f805843e4d59",
                                "text": "Des diplômes encadrés – taureaux, vaches laitières, truies primées – voisinaient avec des fragments de cadastres, avec des cartes d’état-major, des photos de troupeaux et de basses-cours, des prospectus en quadrichromie de tracteurs, de batteuses, d’arracheuses, de semoirs."
                            },
                            {
                                "example_id": "2255bd06-2452-4301-bc3b-ebf4d2da416b",
                                "sense_id": "7e0ab6ed-c9af-352a-af98-f805843e4d59",
                                "text": "Holmer, le spécialiste de la récolte de betteraves dans le giron d’Excel développe un service pour restaurer les anciennes arracheuses de betteraves automotrices."
                            }
                        ]
                    }
