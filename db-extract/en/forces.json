                    },
                    {
                        "translation_id": "763a20e3-8632-45d8-ab33-c18e258ea2c7",
                        "source_entry_id": "4b1b1436-0c26-300f-9654-9d2e854cffc4",
                        "source_sense_description": "troops",
                        "target_lang_word": "Truppe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Truppe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "88d507dd-9965-3a47-bc66-00a730bb8e46",
                                        "entry_id": "1e6d5e46-8b50-3752-8c90-77b935270f48",
                                        "glosses": [
                                            "Gesamtheit der Streitkräfte eines Staates oder einer der Teilstreitkräfte, besonders des Heeres"
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "43c2ac4d-e4d4-4e53-ada1-b942cef87db1",
                                                "sense_id": "88d507dd-9965-3a47-bc66-00a730bb8e46",
                                                "text": "Die deutschen Truppen nahmen während des zweiten Weltkriegs Frankreich ein."
                                            },
                                            {
                                                "example_id": "fcc9dd52-86f8-470e-91cb-b79befe96517",
                                                "sense_id": "88d507dd-9965-3a47-bc66-00a730bb8e46",
                                                "text": "„Unsere Truppen wurden in fest ausgebaute Stellungen zurückgenommen, wie es im Heeresbericht hieß.“"
                                            },
                                            {
                                                "example_id": "2048ba07-515c-4ac5-bb00-6ef7b907ad8b",
                                                "sense_id": "88d507dd-9965-3a47-bc66-00a730bb8e46",
                                                "text": "„Vor zwei Wochen hatte die US-Armee in einem Memo alle Truppen angewiesen, Drohnen von DJI nicht mehr einzusetzen, die Batterien und Speicherkarten zu entfernen und die Fluggeräte sicher aufzubewahren.“"
                                            },
                                            {
                                                "example_id": "4735c6d7-17bb-4b93-9fa0-02e6001ad37b",
                                                "sense_id": "88d507dd-9965-3a47-bc66-00a730bb8e46",
                                                "text": "„Der Aufenthalt von Truppen ist nicht zu gestatten, wenn diese Kriegsmaterial mit sich führen, dessen Entwicklung oder Herstellung oder Einsatz nach österreichischer Rechtsordnung unzulässig ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "eacf271e-5771-3f08-aa50-83847a274a26",
                                        "entry_id": "1e6d5e46-8b50-3752-8c90-77b935270f48",
                                        "glosses": [
                                            "kleinere Einheit der Streitkräfte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51ff1992-7ca8-4b6d-9576-aebe9a8ae380",
                                                "sense_id": "eacf271e-5771-3f08-aa50-83847a274a26",
                                                "text": "„Der Aufenthalt von Truppen ist nicht zu gestatten, wenn diese Kriegsmaterial mit sich führen, dessen Entwicklung oder Herstellung oder Einsatz nach österreichischer Rechtsordnung unzulässig ist.“"
                                            },
                                            {
                                                "example_id": "6e20d678-bb65-4be0-bb06-a12773ea4085",
                                                "sense_id": "eacf271e-5771-3f08-aa50-83847a274a26",
                                                "text": "Die Truppe ruht heute, um morgen den langen Marsch zu beginnen."
                                            },
                                            {
                                                "example_id": "32b19718-1c58-49e4-b3a5-318e41a657cb",
                                                "sense_id": "eacf271e-5771-3f08-aa50-83847a274a26",
                                                "text": "„In der Mitte dieser Ebene erhob sich eine riesige Staubwolke, wie sie nur von einer großen Truppe Kavallerie stammen konnte!“"
                                            },
                                            {
                                                "example_id": "eb6c9d6b-450f-4a46-87cc-63223350a62a",
                                                "sense_id": "eacf271e-5771-3f08-aa50-83847a274a26",
                                                "text": "„[…] dann, am Morgen des 24. Februar 2022, überfielen russische Truppen die Ukraine.“"
                                            },
                                            {
                                                "example_id": "21dbdecb-fab8-4cf5-a2fa-b30c7ab0cb59",
                                                "sense_id": "eacf271e-5771-3f08-aa50-83847a274a26",
                                                "text": "„Im Oktober 1805 besetzten russische Truppen Dörfer und Städte des Erzherzogtums Oesterreich.“"
                                            },
                                            {
                                                "example_id": "c972c805-d5d2-4a58-89b2-808c2ba77a84",
                                                "sense_id": "eacf271e-5771-3f08-aa50-83847a274a26",
                                                "text": "„An der Befreiung Marseilles hatten auch französische Truppen und Partisanenverbände teilgenommen, die aus allen Teilen des Südens zusammengeströmt waren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "8047700f-7b60-33a9-a978-c9f425289af5",
                                        "entry_id": "1e6d5e46-8b50-3752-8c90-77b935270f48",
                                        "glosses": [
                                            "Gruppe von Künstlern, die gemeinsam auftreten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "990a88cd-c6d4-40a3-a917-0b8f5b00f463",
                                                "sense_id": "8047700f-7b60-33a9-a978-c9f425289af5",
                                                "text": "Die Truppe junger Amateurkünstler wanderte von Ort zu Ort über Monate hinweg, um mit Theatervorstellungen der Bevölkerung den Schutz vor AIDS näher zu bringen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "622feede-ddf1-336a-99ce-1b33f28795c9",
                                        "entry_id": "1e6d5e46-8b50-3752-8c90-77b935270f48",
                                        "glosses": [
                                            "Gruppe von Arbeitskollegen"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c0f2d1a7-5963-4fdc-a4c2-ef6cbaa6535b",
                                                "sense_id": "622feede-ddf1-336a-99ce-1b33f28795c9",
                                                "text": "Die Truppe räumt heute die Regale in der Spielzeugabteilung ein."
                                            },
                                            {
                                                "example_id": "449581aa-e21d-44a0-b54f-bec82fd187a4",
                                                "sense_id": "622feede-ddf1-336a-99ce-1b33f28795c9",
                                                "text": "Nach Feierabend trifft sich die Truppe manchmal in einer Kneipe."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    }
