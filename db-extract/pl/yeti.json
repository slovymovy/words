                "senses": [
                    {
                        "sense_id": "bd572134-38ff-3b9b-93c3-5d200bc3a384",
                        "entry_id": "aacbb592-767c-3009-8590-cb7fff6f59f0",
                        "glosses": [
                            "duża, dwunożna istota, podobna do człowieka, o gęstym futrze, żyjąca rzekomo w Himalajach"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "752b4ad9-c2bf-47fc-9003-e8d80cd8d4f0",
                                "sense_id": "bd572134-38ff-3b9b-93c3-5d200bc3a384",
                                "text": "Tybetańczycy tę rzekomą, tajemniczą, budzącą strach istotę nazywają kanguli, Nepalczycy natomiast yeti"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d9a68e19-dce8-489b-b067-bd7090662d99",
                        "source_entry_id": "aacbb592-767c-3009-8590-cb7fff6f59f0",
                        "source_sense_id": "bd572134-38ff-3b9b-93c3-5d200bc3a384",
                        "target_lang_word": "yeti",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "yeti",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "94528f24-3b34-313e-9fbd-b7d52ec841ce",
                                        "entry_id": "34e283c6-c49b-3b5a-a522-a4f20d078f81",
                                        "glosses": [
                                            "An unidentified humanoid animal said to live in the Himalayas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10f53c57-8600-4b02-9e62-97b8b4ad4f50",
                                                "sense_id": "94528f24-3b34-313e-9fbd-b7d52ec841ce",
                                                "text": "There is no doubt that the Sherpas accept the fact that the Yeti really exists. But then they believe just as confidently that their gods live in comfort on the summit of Mount Everest. We found it quite impossible to divorce the Yeti from the supernatural."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e9124865-e6a4-451c-96c9-4000a85ae9c6",
                        "source_entry_id": "aacbb592-767c-3009-8590-cb7fff6f59f0",
                        "source_sense_id": "bd572134-38ff-3b9b-93c3-5d200bc3a384",
