                "senses": [
                    {
                        "sense_id": "b60002ba-2034-3f7f-891d-85c2bb2d69aa",
                        "entry_id": "f1d7e0af-c4a0-3bf4-93f0-2b6f10884194",
                        "glosses": [
                            "een hap of een slok die zo groot is dat ze de mond vult"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "429a6436-89ec-3840-91d7-bcd560932c5c",
                        "entry_id": "f1d7e0af-c4a0-3bf4-93f0-2b6f10884194",
                        "glosses": [
                            "een woord dat moeilijk is uit te spreken door de lengte ervan"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "d0679625-4d71-4740-ad0d-b1c6b754aa28",
                                "sense_id": "429a6436-89ec-3840-91d7-bcd560932c5c",
                                "text": "'De essentie van ons verhaal is dat we met Kriket een tussendoortje proberen maken dat een antwoord formuleert op enkele grote uitdagingen waar we als fans van lekker eten én wakkere burgers voor staan: de obesitasepidemie en de opwarming van de aarde zijn er daar twee van.' Een mondvol voor een reep die de kleine honger moet stillen. Nu alleen nog via crowdfunding genoeg geld zien op te halen zodat een eerste lading in productie kan gaan."
                            },
                            {
                                "example_id": "a931aab9-36f6-4c86-b587-4b12e86fce56",
                                "sense_id": "429a6436-89ec-3840-91d7-bcd560932c5c",
                                "text": "Onderwaterbabyfotografie? Als woord is het al een mondvol, in de gedachten van ouders nog veel meer. Aan zwembadwater dat de kleintjes binnenkrijgen. Een onderwaterfotosessie bij 't Spilbroek bewees zondagmorgen dat juist de allerkleinsten geboren watermensjes zijn. Zie ook filmpje!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b7573017-dc4b-494f-b138-0cc5235bf6f0",
                        "source_entry_id": "f1d7e0af-c4a0-3bf4-93f0-2b6f10884194",
                        "source_sense_id": "b60002ba-2034-3f7f-891d-85c2bb2d69aa",
                        "source_sense_description": "een hap of een slok die zo groot is dat ze de mond vult",
                        "target_lang_word": "mouthful",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mouthful",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c82dde0b-abd5-3fbb-a6b5-1ca5c4216a82",
                                        "entry_id": "bb767273-3d2d-366c-bc99-eadd74d1e97c",
                                        "glosses": [
                                            "The amount that will fit in a mouth."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10cdecdb-ffde-4a40-9ca7-5121b18184c4",
                                                "sense_id": "c82dde0b-abd5-3fbb-a6b5-1ca5c4216a82",
                                                "text": "He swallowed a mouthful of sea water when he fell in."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a288cc0a-2ee8-39eb-8db4-f37bcdaa6c79",
                                        "entry_id": "bb767273-3d2d-366c-bc99-eadd74d1e97c",
                                        "glosses": [
                                            "Quite a bit."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a6accb38-4784-4acd-b0db-3946421e7581",
                                                "sense_id": "a288cc0a-2ee8-39eb-8db4-f37bcdaa6c79",
                                                "text": "“Unquestionably his metabolism is unduly susceptible to stresses resulting from the interaction of external excitations,” he said, and Bobbie patted him on the shoulder in a maternal sort of way, a thing I wouldn't have cared to do myself though our relations were, as I have indicated, more cordial than they had been at one time, and told him he had said a mouthful."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4367722d-8365-31f9-9d7d-75eb058fa0e1",
                                        "entry_id": "bb767273-3d2d-366c-bc99-eadd74d1e97c",
                                        "glosses": [
                                            "Something difficult to pronounce or say."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e855e9e-cf21-4554-95ca-3706617baa05",
                                                "sense_id": "4367722d-8365-31f9-9d7d-75eb058fa0e1",
                                                "text": "“She sells sea shells” is a bit of a mouthful to say."
                                            },
                                            {
                                                "example_id": "8fd2d29c-440d-4f74-bb6d-43536573bb64",
                                                "sense_id": "4367722d-8365-31f9-9d7d-75eb058fa0e1",
                                                "text": "Although there have been many examples of double names, three always have been uncommon. The L.S.W.R. had Horsley & Ockham & Ripley, but the South Yorkshire Railway produced a real mouthful in Smithley, Darley Main & Worsborough. This was soon found to be too much, and the name of the station became Dovecliffe."
                                            },
                                            {
                                                "example_id": "57526fc3-51b2-472f-87b3-69bc7447ff5d",
                                                "sense_id": "4367722d-8365-31f9-9d7d-75eb058fa0e1",
                                                "text": "“Yes, you may leave this little matter entirely to me, Mr Wooster.” “I wish you'd call me Bertie.” “Certainly, certainly.” “And might I call you Roderick?” “I shall be delighted.” “Or Roddy? Roderick's rather a mouthful.” “Whichever you prefer.”"
                                            },
                                            {
                                                "example_id": "19228d92-9c51-4302-bdcd-faf936a8776d",
                                                "sense_id": "4367722d-8365-31f9-9d7d-75eb058fa0e1",
                                                "text": "\"Tony, I'm the executive director of S.H.I.E.L.D., the Strategic Homeland Intelligence, Enforcement, and Logistics Division,\" explained Fury.\nTony nodded. […] \"Want a tip? Fire your namer of things, because that's a mouthful.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4c41f8a8-9a9c-35e6-95e1-69ae99a35cde",
                                        "entry_id": "bb767273-3d2d-366c-bc99-eadd74d1e97c",
                                        "glosses": [
                                            "A tirade of abusive language."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f130c2b5-7d24-42ac-9f02-451c7c4d8324",
                                                "sense_id": "4c41f8a8-9a9c-35e6-95e1-69ae99a35cde",
                                                "text": "to give someone a mouthful"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "mouthful",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f9b61eb5-1e05-3a95-88d8-426ffa44db81",
                                        "entry_id": "41adaef3-5b20-36b4-bbf6-aad0d39446fc",
                                        "glosses": [
                                            "Bombastic or awkward."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65cbf46c-3a2e-44e6-bbb4-967b72c91c8e",
                                                "sense_id": "f9b61eb5-1e05-3a95-88d8-426ffa44db81",
                                                "text": "Once this happens to be the result, there is little reason for waxing over such mouthful phrases as 'grass-roots democracy', 'democratic decentralization' or 'panchayati raj'."
                                            },
                                            {
                                                "example_id": "348fac68-fc46-4ef7-b81a-d4bea44b679d",
                                                "sense_id": "f9b61eb5-1e05-3a95-88d8-426ffa44db81",
                                                "text": "The sufferers are regaled with such mouthful promises by every party on the eve of the successive elections and thereafter they continue to be shouted with unabated vigour by the party occupying the saddle while the problems are relegated to the limbo of time to find out their own solutions."
                                            },
                                            {
                                                "example_id": "de8a3677-0476-4a09-ab68-1815cc41e088",
                                                "sense_id": "f9b61eb5-1e05-3a95-88d8-426ffa44db81",
                                                "text": "Angley then drifts into his hourful, mouthful extempore, accentuated with refrains of \"cast the demon away with the power of the Lord.\""
                                            },
                                            {
                                                "example_id": "4c6647c8-9089-4429-8b07-6605aaf3a980",
                                                "sense_id": "f9b61eb5-1e05-3a95-88d8-426ffa44db81",
                                                "text": "...how else to explain such mouthful menu offerings as plantain-coated mahi mahi with fufu and lily salad and boneless braised short ribs with Paraguayan chipaguasu?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
