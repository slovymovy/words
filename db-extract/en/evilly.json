                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "aa16431a-b632-3c03-9abf-f646a394737b",
                                        "entry_id": "47b37328-c8c1-3d43-bf02-073d0ac37341",
                                        "glosses": [
