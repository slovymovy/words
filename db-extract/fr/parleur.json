                ],
                "senses": [
                    {
                        "sense_id": "ac6e0406-0fa8-371e-8c8d-2cfc025f120a",
                        "entry_id": "52ef2f08-d94b-3c65-9e0d-98c94be15c98",
                        "glosses": [
                            "Qui parle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa6055f8-b3a4-4ada-a4a6-e2da60303512",
                                "sense_id": "ac6e0406-0fa8-371e-8c8d-2cfc025f120a",
                                "text": "La bêtise a deux manières d’être : elle se tait ou elle parle. La bêtise muette est supportable, mais la bêtise de Rogron était parleuse."
                            },
                            {
                                "example_id": "67d6ab93-cad7-46ab-b657-7b5d453ed980",
                                "sense_id": "ac6e0406-0fa8-371e-8c8d-2cfc025f120a",
                                "text": "Oiseau parleur : Oiseau qu’on dresse pour reproduire la voix humaine, comme le perroquet, le sansonnet."
                            },
                            {
                                "example_id": "33e18d00-8578-4682-865c-8651b28ec37d",
                                "sense_id": "ac6e0406-0fa8-371e-8c8d-2cfc025f120a",
                                "text": "Haut-parleur : Appareil qui amplifie tous les sons."
                            },
                            {
                                "example_id": "b2603a09-d827-4169-8f78-c3fa2701ef43",
                                "sense_id": "ac6e0406-0fa8-371e-8c8d-2cfc025f120a",
                                "text": "Des haut-parleurs."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
