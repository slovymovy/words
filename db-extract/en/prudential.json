                                            {
                                                "example_id": "d7904f53-b903-4cbb-9a4d-f875eec630cc",
                                                "sense_id": "1dcba413-0257-30f5-9919-46698c828821",
                                                "text": "Ein heiterer Juniusnachmittag besonnte die Straßen der Residenzstadt."
                                            },
                                            {
                                                "example_id": "a6b9e8ad-ecb8-44f7-bdd8-30dc9e442c17",
                                                "sense_id": "1dcba413-0257-30f5-9919-46698c828821",
                                                "text": "Am Freitag begann alles mit Regen. Als dann aber die ersten Gäste eintrafen, verschwanden die Regenwolken und die Abendsonne besonnte den Abend."
                                            },
                                            {
                                                "example_id": "86a4601a-97b6-4509-9a89-d352104669c7",
                                                "sense_id": "1dcba413-0257-30f5-9919-46698c828821",
                                                "text": "Gerade als sich Annunziata dem Laden näherte, flammte die Bogenlampe auf und besonnte den matten Regen in ihrem Kreis wie einen Mückenkranz."
                                            },
                                            {
                                                "example_id": "fe6e804b-e887-4396-838c-94bea2f6084d",
                                                "sense_id": "1dcba413-0257-30f5-9919-46698c828821",
                                                "text": "Nachbars Katze lag in der Wiese und besonnte sich."
                                            }
