                "senses": [
                    {
                        "sense_id": "a6265763-89e9-30a2-8c17-c70eba76693c",
                        "entry_id": "64820ab8-97a8-3747-8bd0-1a5f658cb911",
                        "glosses": [
                            "ein freies oder gebundenes Morphem, das eine lexikalische Bedeutung hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6147ab6a-7e94-456a-9b61-086032a860e5",
                                "sense_id": "a6265763-89e9-30a2-8c17-c70eba76693c",
                                "text": "\"Auto\", \"Haus\", \"schön\", \"schreib-\", \"spiel-\", \"Tor\" sind Beispiele für Grundmorpheme."
                            },
                            {
                                "example_id": "bf5a9509-fdac-478b-9ab6-2b78c33d785b",
                                "sense_id": "a6265763-89e9-30a2-8c17-c70eba76693c",
                                "text": "Wörter enthalten oft außer einem Grundmorphem weitere Grundmorpheme, Ableitungs- und Flexionsmorpheme."
                            },
                            {
                                "example_id": "eaeac912-0dc2-4220-af9b-62b07e052f85",
                                "sense_id": "a6265763-89e9-30a2-8c17-c70eba76693c",
                                "text": "Viele Linguisten betrachten Verbstämme wie \"schreib-\", \"spiel-\" als gebundene lexikalische Morpheme, da sie ohne Flexionsendung nicht wortfähig sind; sie sind dann auch gebundene Grundmorpheme."
                            },
                            {
                                "example_id": "bbb94118-1e88-49a0-8108-afabbe4442e9",
                                "sense_id": "a6265763-89e9-30a2-8c17-c70eba76693c",
                                "text": "Kürschner setzt Grundmorphem mit Wurzel gleich."
                            },
                            {
                                "example_id": "ce89fbff-4bf4-416e-98ae-42c33cf9d3f6",
                                "sense_id": "a6265763-89e9-30a2-8c17-c70eba76693c",
                                "text": "„Im Unterschied zu den Grundmorphemen kommen die Wortbildungsmorpheme nicht frei vor, sondern dienen in Verbindung mit Derivationsbasen (Grundmorphemen oder Wörtern) der Bildung komplexer Wörter.“"
                            },
                            {
                                "example_id": "7409c103-f01a-4662-b512-f7671a6d0743",
                                "sense_id": "a6265763-89e9-30a2-8c17-c70eba76693c",
                                "text": "Zur Länge von Komposita: „Vorläufige Untersuchungen haben ergeben, daß acht Grundmorpheme die obere Grenze sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
