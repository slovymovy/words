                "senses": [
                    {
                        "sense_id": "e2fdb3a2-60a8-3fc6-917c-68459976750e",
                        "entry_id": "946c191f-43c3-301b-b982-7362dbb127a1",
                        "glosses": [
                            "Frapper d'une baguette."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "cf3a1f94-b3dd-4107-bbfc-e1c604a186e7",
                                "sense_id": "e2fdb3a2-60a8-3fc6-917c-68459976750e",
                                "text": "Pour faire disparaitre les turricules sans utiliser de lombricide, vous pouvez aussi essayer de \"baguetter\" votre gazon avant la tonte."
                            },
                            {
                                "example_id": "1ebdbe11-46fe-492b-9c88-a5813c090453",
                                "sense_id": "e2fdb3a2-60a8-3fc6-917c-68459976750e",
                                "text": "Après les triages faits, le mélange des matières indiqué, préparé, et avant de les employer, il les faut baguetter souvent, séparément d'abord, ensuite mélanger, carder enfin."
                            }
                        ]
                    },
                    {
                        "sense_id": "0d351939-c142-32aa-b574-f3e1ff44f5ae",
                        "entry_id": "946c191f-43c3-301b-b982-7362dbb127a1",
                        "glosses": [
                            "Munir de baguettes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e797474a-4cba-4f8c-94a2-b49cb8196213",
                                "sense_id": "0d351939-c142-32aa-b574-f3e1ff44f5ae",
                                "text": "Mettant le pied sur le tapis rouge baguetté de cuivre, qui mène à ce qu’on appelle en Italie l’étage noble, il monte d’un pas ni trop rapide, ni trop ralenti, se demandant comment finira tout ça."
                            }
                        ]
                    }
