                    {
                        "translation_id": "007c243c-a4b6-4161-9ee7-6acecb047115",
                        "source_entry_id": "2b5bb5b5-cfbe-363e-82e9-b6d326b041f9",
                        "source_sense_id": "b4116581-6b24-3e6a-8b8e-0751fe4e8fae",
