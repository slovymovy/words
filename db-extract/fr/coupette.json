                                "example_id": "0fce32a0-aab3-433d-b963-c124d1fa92ed",
                                "sense_id": "a31725c6-f8ad-313c-9be7-b37cbf773f64",
                                "text": "« Est-ce que je peux boire une coupette de champagne pour mon anniversaire ? »"
                            },
                            {
                                "example_id": "b2cfd44c-60b0-408a-9612-47518d6d35ce",
                                "sense_id": "a31725c6-f8ad-313c-9be7-b37cbf773f64",
                                "text": "Design sophistiqué et sobre, les branchouilles de tous les pays se retrouvent ici pour siroter une coupette de champagne, accoudés au bar ovale et immaculé."
                            },
                            {
                                "example_id": "376b4b43-76b5-4da8-b085-831b9a870933",
                                "sense_id": "a31725c6-f8ad-313c-9be7-b37cbf773f64",
                                "text": "Mon chien ? C'est un bulldog de Poméranie Orientale. Il a gagné quinze coupettes et trois médaillons avec de l'or à Stuttgart et à Dortmund !"
                            }
                        ]
                    }
