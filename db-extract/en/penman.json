                "entry_id": "6483f4d9-f33c-3013-983e-8d9d86db0475",
                "word": "penman",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "950c410e-a2a4-4da8-83e3-022ddffb479e",
                        "entry_id": "6483f4d9-f33c-3013-983e-8d9d86db0475",
                        "tags": [
                            "plural"
                        ],
