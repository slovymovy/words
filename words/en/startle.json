{
    "word_family": [
        "startling",
        "startled",
        "startlement"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b1248879-00ba-3a57-ad94-e9dd703351f6",
                    "sense_definition": "To cause a person or animal to feel a sudden shock or alarm, usually by surprise.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "surprise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The loud noise from the kitchen was enough to <w>startle</w> the sleeping cat.",
                            "target_lang_translations": {
                                "ru": "Громкого шума на кухне было достаточно, чтобы <w>напугать</w> спящую кошку.",
                                "tr": "Mutfaktan gelen yüksek ses, uyuyan kediyi <w>ürkütmeye</w> yetti."
                            }
                        },
                        {
                            "text": "I did not mean to <w>startle</w> you when I walked into the room so quietly.",
                            "target_lang_translations": {
                                "ru": "Я не хотел тебя <w>пугать</w>, когда так тихо вошел в комнату.",
                                "tr": "Odaya bu kadar sessizce girdiğimde seni <w>korkutmak</w> istememiştim."
                            }
                        }
                    ],
                    "synonyms": [
                        "scare",
                        "frighten",
                        "surprise",
                        "shock",
                        "alarm"
                    ],
                    "antonyms": [
                        "calm",
                        "soothe",
                        "reassure"
                    ],
                    "common_phrases": [
                        "startle someone",
                        "easily startled"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызвать у человека или животного внезапное чувство шока или тревоги, обычно врасплох.",
                        "tr": "Genellikle beklenmedik bir durum karşısında bir insanı ya da hayvanı aniden ürkütmek, şaşırtmak veya korkutmak."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "испугать",
                                "target_lang_sense_clarification": "вызвать внезапный испуг"
                            },
                            {
                                "target_lang_word": "напугать",
                                "target_lang_sense_clarification": "внушить страх или тревогу"
                            },
                            {
                                "target_lang_word": "всполошить",
                                "target_lang_sense_clarification": "вызвать переполох или тревогу"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "ürkütmek",
                                "target_lang_sense_clarification": "ani bir hareket veya sesle tedirgin etmek"
                            },
                            {
                                "target_lang_word": "korkutmak",
                                "target_lang_sense_clarification": "aniden telaşa veya şaşkınlığa düşürmek"
                            },
                            {
                                "target_lang_word": "şaşırtmak",
                                "target_lang_sense_clarification": "ansızın şok etmek"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7cb0e7d6-f748-329a-ba61-573ad23e5ec8",
                    "sense_definition": "To move or jump suddenly because of a feeling of alarm or surprise.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The horse tends to <w>startle</w> at the slightest sound of thunder.",
                            "target_lang_translations": {
                                "ru": "Лошадь склонна <w>шарахаться</w> от малейшего звука грома.",
                                "tr": "At, en ufak gök gürültüsü sesinde bile <w>ürkmeye</w> meyillidir."
                            }
                        },
                        {
                            "text": "She would <w>startle</w> and look around every time a door opened behind her.",
                            "target_lang_translations": {
                                "ru": "Она <w>вздрагивала</w> и оглядывалась каждый раз, когда за ее спиной открывалась дверь.",
                                "tr": "Arkasında her kapı açıldığında <w>irkilir</w> ve etrafına bakınırdı."
                            }
                        }
                    ],
                    "synonyms": [
                        "start"
                    ],
                    "common_phrases": [
                        "startle at something"
                    ],
                    "target_lang_definitions": {
                        "ru": "Внезапно вздрогнуть или подпрыгнуть от чувства тревоги или неожиданности.",
                        "tr": "Ani bir korku veya şaşkınlık hissiyle yerinden sıçramak veya irkilmek."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вздрогнуть",
                                "target_lang_sense_clarification": "от неожиданности"
                            },
                            {
                                "target_lang_word": "шарахаться",
                                "target_lang_sense_clarification": "пугаться и отскакивать"
                            },
                            {
                                "target_lang_word": "пугаться",
                                "target_lang_sense_clarification": "реагировать на раздражитель"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "irkilmek",
                                "target_lang_sense_clarification": "ani bir tepkiyle sarsılmak"
                            },
                            {
                                "target_lang_word": "ürkmek",
                                "target_lang_sense_clarification": "korkarak geri çekilmek veya tedirgin olmak"
                            },
                            {
                                "target_lang_word": "sıçramak",
                                "target_lang_sense_clarification": "aniden yerinden fırlamak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2436d97e-c7f5-34ce-bd60-15c975cd5d35",
                    "sense_definition": "To discourage or prevent someone from a course of action by causing sudden concern.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "deterrence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden change in policy might <w>startle</w> investors from committing more capital.",
                            "target_lang_translations": {
                                "ru": "Внезапное изменение политики может <w>отпугнуть</w> инвесторов от вложения дополнительного капитала.",
                                "tr": "Politikadaki ani değişiklik, yatırımcıları daha fazla sermaye koymaktan <w>caydırabilir</w>."
                            }
                        },
                        {
                            "text": "The harsh conditions of the contract were designed to <w>startle</w> any potential competitors.",
                            "target_lang_translations": {
                                "ru": "Жесткие условия контракта были призваны <w>отпугнуть</w> любых потенциальных конкурентов.",
                                "tr": "Sözleşmenin ağır koşulları, olası rakipleri <w>ürkütmek</w> amacıyla tasarlanmıştı."
                            }
                        }
                    ],
                    "synonyms": [
                        "deter"
                    ],
                    "antonyms": [
                        "encourage",
                        "invite"
                    ],
                    "common_phrases": [
                        "startle from"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обескуражить или предотвратить чьи-либо действия, вызвав внезапное беспокойство.",
                        "tr": "Ani bir endişe yaratarak birinin bir eylemi gerçekleştirmesini engellemek veya vazgeçirmek."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отпугнуть",
                                "target_lang_sense_clarification": "заставить отказаться от намерений"
                            },
                            {
                                "target_lang_word": "испугать",
                                "target_lang_sense_clarification": "ослабить решимость"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "caydırmak",
                                "target_lang_sense_clarification": "endişelendirerek vazgeçirmek"
                            },
                            {
                                "target_lang_word": "ürkütmek",
                                "target_lang_sense_clarification": "gözünü korkutarak uzaklaştırmak"
                            },
                            {
                                "target_lang_word": "vazgeçirmek",
                                "target_lang_sense_clarification": "kararından dönmesini sağlamak"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1673c2fd-12f7-3041-8454-c2c513be245a",
                    "sense_definition": "A sudden involuntary movement or feeling of shock caused by surprise.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "reaction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden appearance of a stranger in the woods caused a visible <w>startle</w>.",
                            "target_lang_translations": {
                                "ru": "Внезапное появление незнакомца в лесу вызвало заметный <w>испуг</w>.",
                                "tr": "Ormanda bir yabancının aniden belirmesi gözle görülür bir <w>irkilmeye</w> neden oldu."
                            }
                        },
                        {
                            "text": "He recovered quickly from his initial <w>startle</w> and began to laugh at the joke.",
                            "target_lang_translations": {
                                "ru": "Он быстро оправился от первого <w>испуга</w> и начал смеяться над шуткой.",
                                "tr": "İlk <w>ürküntüsünü</w> çabucak atlattı ve şakaya gülmeye başladı."
                            }
                        }
                    ],
                    "synonyms": [
                        "start"
                    ],
                    "common_phrases": [
                        "cause a startle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Внезапное непроизвольное движение или чувство шока, вызванное неожиданностью.",
                        "tr": "Şaşkınlık veya ani korkunun yol açtığı istemsiz hareket, irkilme ya da şok hissi."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "испуг",
                                "target_lang_sense_clarification": "внезапное чувство страха"
                            },
                            {
                                "target_lang_word": "вздрагивание",
                                "target_lang_sense_clarification": "физическая реакция"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "irkilme",
                                "target_lang_sense_clarification": "ani fiziki tepki veya sarsılma"
                            },
                            {
                                "target_lang_word": "korku",
                                "target_lang_sense_clarification": "ani ürküntü hissi"
                            },
                            {
                                "target_lang_word": "ürküntü",
                                "target_lang_sense_clarification": "anlık tedirginlik ve şaşkınlık"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}