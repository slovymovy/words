                        "tags": [],
                        "examples": [
                            {
                                "example_id": "121216c5-0408-4638-8119-33d4f8f46b54",
                                "sense_id": "04abf4db-5162-31d3-a34a-d212f966dfaa",
                                "text": "Die abgeführten Täter verhielten sich später im Verhör kooperativ.",
                                "translation": "De afgevoerde daders waren later in het verhoor meewerkend."
                            }
                        ]
                    },
                    {
                        "sense_id": "c32b8839-a75c-3dfa-99b7-fb0a243a70a1",
                        "entry_id": "db5c89fc-a6ce-38fa-b650-f3e96103938c",
                        "glosses": [
                            "afgevoerd, geloosd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ccd7b8c0-9fc9-48af-85d3-4b18cefb3265",
                                "sense_id": "c32b8839-a75c-3dfa-99b7-fb0a243a70a1",
                                "text": "Rückgewinnung von bis zu 75% Wärme aus der abgeführten Luft",
                                "translation": "Terugwinning tot 75% van de warmte uit de afgevoerde lucht."
                            }
                        ]
                    },
                    {
                        "sense_id": "4e0008a9-44d6-348f-923a-8c9173fe6fe4",
                        "entry_id": "db5c89fc-a6ce-38fa-b650-f3e96103938c",
                        "glosses": [
                            "afgedragen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6dd1aae7-aad2-44c8-991f-7617f7d833af",
                                "sense_id": "4e0008a9-44d6-348f-923a-8c9173fe6fe4",
                                "text": "Wer unter dem Freibetrag liegt, bekommt seine abgeführten Steuern zurück.",
                                "translation": "Wie onder het belastingvrije bedrag zit, krijgt zijn afgedragen belastingen terug."
                            }
                        ]
                    },
                    {
                        "sense_id": "46f491d4-a79f-3941-ae6b-3e8757cb5958",
                        "entry_id": "db5c89fc-a6ce-38fa-b650-f3e96103938c",
                        "glosses": [
                            "afgericht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a209f01-b926-4c8b-9593-8f893ab36c8d",
                                "sense_id": "46f491d4-a79f-3941-ae6b-3e8757cb5958",
                                "text": "In einer Zeit in der der Jäger mehr als je zuvor von einer kritischen Öffentlichkeit bei der Ausübung seines Handwerks beobachtet wird, hat dieser besonderes Augenmerk darauf zu richten, dass dem Wild unnötige Qualen erspart bleiben. So kennzeichnen den gut abgeführten Jagdhund und sein sachkundiger Einsatz den verantwortungsbewussten und waidgerechten Jäger aus.",
                                "translation": "In de tijd dat de jager meer dan ooit tevoren door een kritisch publiek bij de uitoefening van zijn beroep bekeken wordt, let deze er heel erg op dat het wild geen onnodig leed aangedaan wordt. Zo kenmerken de goed afgerichte jachthond en zijn deskundige inzet de verantwoordelijke en weidelijke jager."
                            }
                        ]
                    }
