                                    {
                                        "sense_id": "19584994-cc7a-390d-bae5-daee1fa329b1",
                                        "entry_id": "8b97c2ee-1dcd-3559-9ac4-65c84f7b1218",
                                        "glosses": [
                                            "Étude détaillée sur un sujet précis et limité ou sur un personnage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e1adc23-17c3-41b7-91ad-8c4ad5f44334",
                                                "sense_id": "19584994-cc7a-390d-bae5-daee1fa329b1",
                                                "text": "Dans une librairie, elle feuilleta une monographie d’Andrew Wyeth tandis que j’ouvrais les romans policiers."
                                            },
                                            {
                                                "example_id": "9ecf9404-0b86-4cdd-a8e2-106aa408bf27",
                                                "sense_id": "19584994-cc7a-390d-bae5-daee1fa329b1",
                                                "text": "Les instituteurs, si souvent dépeints en massacreurs des coutumes, des savoirs locaux, des langues régionales, tâchaient de cheminer du proche au lointain, se faisaient volontiers ethnologues des terroirs, recueillant les chansons, les proverbes, les mille façons de vivre et de mourir, rivalisant de zèle avec les curés dans la rédaction des monographies communales."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f8accd84-fcab-3da0-a2cf-44b17548e8e3",
                                        "entry_id": "8b97c2ee-1dcd-3559-9ac4-65c84f7b1218",
                                        "glosses": [
                                            "Publication non périodique, c’est-à-dire qui est complète en un seul volume ou destinée à être complétée en un nombre limité de volumes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f12af202-bc27-48ce-944f-5db48db09e84",
                                                "sense_id": "f8accd84-fcab-3da0-a2cf-44b17548e8e3",
                                                "text": "Vous pouvez ici consulter de multiples monographies."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
