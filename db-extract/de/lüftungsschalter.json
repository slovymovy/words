                "senses": [
                    {
                        "sense_id": "f7864711-552b-3810-b9ab-1288516e23da",
                        "entry_id": "291af319-a3b3-312a-985f-46ba20a17623",
                        "glosses": [
                            "elektrisches Bauelement zur Herstellung oder Unterbrechung einer elektrischen Verbindung und Steuerung der Lüftung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e13b6914-a488-4e60-bdaf-74ddabcea1b8",
                                "sense_id": "f7864711-552b-3810-b9ab-1288516e23da",
                                "text": "„Dabei muß der Lüftungsschalter ausgerastet werden.“"
                            },
                            {
                                "example_id": "b8057c23-8867-4ee3-a4d9-204f126abc5e",
                                "sense_id": "f7864711-552b-3810-b9ab-1288516e23da",
                                "text": "„Wenn ein Lüftungsschalter an die 12-polige Servicebuchse für den Installateur angeschlossen wird, kann die Situation des Systemventilators von dem hier Geschilderten abweichen (siehe §5.7.7).“"
                            },
                            {
                                "example_id": "c2bd74df-169b-4ea8-ab31-809e324d9731",
                                "sense_id": "f7864711-552b-3810-b9ab-1288516e23da",
                                "text": "„Während der Not-Auslösung dürfen vorhandene Lüftungsschalter jedoch nicht mehr funktionieren (Vorrangschaltung).“"
                            },
                            {
                                "example_id": "cc7c9983-2426-4f28-8734-5bf9048807c7",
                                "sense_id": "f7864711-552b-3810-b9ab-1288516e23da",
                                "text": "„Erst als auch der Lüftungsschalter Alarm schlug, bequemte sich der Dienstgruppenleiter zu dem im Keller liegenden Zellentrakt.“"
                            },
                            {
                                "example_id": "c83a7319-7d7c-4116-b59f-92b32cb5401d",
                                "sense_id": "f7864711-552b-3810-b9ab-1288516e23da",
                                "text": "„Bei Betätigung des Lichtschalters oder Lüftungsschalters ist zeitweise die Intensivlüftung aktiviert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
