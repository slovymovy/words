                ],
                "senses": [
                    {
                        "sense_id": "d5c6b238-7986-3808-af1e-4fba49cf0cba",
                        "entry_id": "3c777e18-d7a8-3c43-8b85-1d93b5fb8dab",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0564e56e-ac5b-4022-bf7d-1aaea501e9da",
                                "sense_id": "d5c6b238-7986-3808-af1e-4fba49cf0cba",
                                "text": "Frau Tremmel ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "15f20114-4378-4456-8448-1e770e800a43",
                                "sense_id": "d5c6b238-7986-3808-af1e-4fba49cf0cba",
                                "text": "Herr Tremmel wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "6909c20c-e29d-4f5e-b9ce-56a1f99d677b",
                                "sense_id": "d5c6b238-7986-3808-af1e-4fba49cf0cba",
                                "text": "Die Tremmels fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "dcd52f9f-9914-4a50-af1d-81c9c7011d1d",
                                "sense_id": "d5c6b238-7986-3808-af1e-4fba49cf0cba",
                                "text": "Der Tremmel trägt nie die Schals, die die Tremmel ihm strickt."
                            },
                            {
                                "example_id": "7394fa05-9d73-4021-9a1f-ec1647f7ea8e",
                                "sense_id": "d5c6b238-7986-3808-af1e-4fba49cf0cba",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Tremmel kommt, geht der Herr Tremmel.“"
                            },
                            {
                                "example_id": "991701db-4251-42f8-9cb6-f288379a94b8",
                                "sense_id": "d5c6b238-7986-3808-af1e-4fba49cf0cba",
                                "text": "Tremmel kommt und geht."
                            },
                            {
                                "example_id": "eb7593ba-79c0-437a-929b-4abd269ee005",
                                "sense_id": "d5c6b238-7986-3808-af1e-4fba49cf0cba",
                                "text": "Tremmels kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
