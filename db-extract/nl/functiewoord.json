                    }
                ],
                "translations": [
                    {
                        "translation_id": "9c557484-120f-4d27-85a0-80194ecbbb5f",
                        "source_entry_id": "34f1551a-5fe9-37e3-93f4-74ddb9bdcdcb",
                        "source_sense_id": "c834cbdf-db29-37d3-82b4-7e39255864b0",
                        "target_lang_word": "Synsemantikum",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Synsemantikum",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "73dd2a3b-5094-3229-9e8d-eef2541cd0de",
                                        "entry_id": "6e6355e0-11c6-3779-9970-6467bfdb2035",
                                        "glosses": [
                                            "Bezeichnung für Wörter, die in erster Linie eine grammatische Funktion haben, aber oft nur eine schwache eigenständige, das heißt lexikalische Bedeutung aufweisen."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36415628-c1f7-4603-8455-e55c023fd5ac",
                                                "sense_id": "73dd2a3b-5094-3229-9e8d-eef2541cd0de",
                                                "text": "Artikel, Hilfsverben, Konjunktionen, Präpositionen, Pronomen und Subjunktionen sind Synsemantika."
                                            },
                                            {
                                                "example_id": "ef6504e6-5bd2-49e9-bd3f-104fd03cdf63",
                                                "sense_id": "73dd2a3b-5094-3229-9e8d-eef2541cd0de",
                                                "text": "Wörter, die eine grammatische Funktion, aber keine eigenständige lexikalische Bedeutung haben, sind Synsemantika."
                                            },
                                            {
                                                "example_id": "77698182-6fa6-447f-8543-a780ccb16806",
                                                "sense_id": "73dd2a3b-5094-3229-9e8d-eef2541cd0de",
                                                "text": "„Die vorstehende Dreiteilung ist der ‚logischen Propädeutik‘ (…) verpflichtet (vergleiche auch die Unterscheidung in Autosemantica – denen Prädikatoren – und Synsemantica, denen Indikatoren und Junktoren entsprechen).“"
                                            },
                                            {
                                                "example_id": "e1982cd2-d925-473b-8ee1-74cedaf29a7c",
                                                "sense_id": "73dd2a3b-5094-3229-9e8d-eef2541cd0de",
                                                "text": "„Autosemantika sind relativ selbständige, begriffliche Bedeutung tragende Wörter, Synsemantika besitzen keine semantische Selbständigkeit, sondern dienen der Organisation der Rede.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d678326f-72c5-4b8f-af18-c062fe39cd9f",
                        "source_entry_id": "34f1551a-5fe9-37e3-93f4-74ddb9bdcdcb",
                        "source_sense_id": "c834cbdf-db29-37d3-82b4-7e39255864b0",
                        "target_lang_word": "Synsemantikon",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Synsemantikon",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "771e3be7-0c3f-3780-961a-61182fbf7293",
                                        "entry_id": "79afcbef-c759-3317-b978-7b893435f76e",
                                        "glosses": [
                                            "Wort, das in erster Linie eine grammatische Funktion hat, aber häufig nur eine schwache eigenständige, das heißt lexikalische Bedeutung aufweist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ade02336-185b-42f7-a3ac-693d3ecdedd2",
                                                "sense_id": "771e3be7-0c3f-3780-961a-61182fbf7293",
                                                "text": "Wörter, die eine grammatische Funktion, aber keine eigenständige lexikalische Bedeutung haben, sind Synsemantika."
                                            },
                                            {
                                                "example_id": "50be5e37-e844-450a-821f-a1c0280beaab",
                                                "sense_id": "771e3be7-0c3f-3780-961a-61182fbf7293",
                                                "text": "Artikel, Hilfsverben, Konjunktionen, Präpositionen, Pronomen und Subjunktionen sind Synsemantika."
                                            },
                                            {
                                                "example_id": "14461cca-1165-4eb4-a4e9-4235fa74a162",
                                                "sense_id": "771e3be7-0c3f-3780-961a-61182fbf7293",
                                                "text": "„Synsemantika besitzen keine lexikalisch-semantische Selbständigkeit, sondern dienen ausschließlich der Organisation des Textes, indem sie Beziehungen zwischen sprachlichen Einheiten herstellen, verflechtende oder verweisende Funktion haben.“"
                                            },
                                            {
                                                "example_id": "86b55930-9a42-42bf-ac5c-1f8f92392242",
                                                "sense_id": "771e3be7-0c3f-3780-961a-61182fbf7293",
                                                "text": "„Der Anteil der grammatischen Informationen ist auch aufgrund von Pauls Zugehörigkeit zur junggrammatischen Schule groß, insbesondere zu sogenannten Synsemantika oder Formwörtern wie zum Beispiel Partikelwörtern, Präpositionen und Konjunktionen sowie Verben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
