                                        "glosses": [
                                            "Qualifie un écolier, collégien ou lycéen, qui n'est ni en pension, ni en demi-pension, dans l'établissement."
                                        ],
                                        "tags": [
                                            "Scolarité"
                                        ],
                                        "examples": [
