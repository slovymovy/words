                        "cross_references": [
                            {
                                "target_word": "Loire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "131f7287-2eec-3528-b2e9-77550b62dbac",
                                        "entry_id": "b58494a0-6a4b-3a00-8cf6-adc669b1b4a1",
