                "senses": [
                    {
                        "sense_id": "57f3e284-ca7f-3a4f-b8af-f928934ac2df",
                        "entry_id": "a66a9abb-6592-3c16-bb09-caef1fe92a57",
                        "glosses": [
                            "Donner un caractère incrédible à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6323548d-ae83-485c-9255-73dc749d189c",
                                "sense_id": "57f3e284-ca7f-3a4f-b8af-f928934ac2df",
                                "text": "Et le fait qu’il ait eu quelques pratiques guère déontologiques doivent-elles pour autant \"incrédibiliser\" certaines réalités."
                            },
                            {
                                "example_id": "b15499cc-cc57-4f3d-931f-f6cccf4cdc9a",
                                "sense_id": "57f3e284-ca7f-3a4f-b8af-f928934ac2df",
                                "text": "A-t-on le droit de penser autrement sans être tourné en dérision ou incrédibilisé de facto ?"
                            },
                            {
                                "example_id": "45d45cbb-6628-4601-8075-f8ed3fca735b",
                                "sense_id": "57f3e284-ca7f-3a4f-b8af-f928934ac2df",
                                "text": "Ou alors avons nous affaire à une stratégie volontaire d'incrédibiliser cette discipline."
                            }
                        ]
                    }
