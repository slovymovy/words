        "fr-extract.jsonl": [
            {
                "entry_id": "179d57d6-70f3-3f65-9ae8-ab2132d81cf9",
                "word": "endométriose",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "d7b746cf-3fe9-41c8-9d98-e92afff5c281",
                        "entry_id": "179d57d6-70f3-3f65-9ae8-ab2132d81cf9",
                        "tags": [
                            "plural"
                        ],
                        "form": "endométrioses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f654f90b-1a9e-30f0-a214-e7f71f74dec7",
                        "entry_id": "179d57d6-70f3-3f65-9ae8-ab2132d81cf9",
                        "glosses": [
                            "Affection caractérisée par la présence d’endométriomes, développement anarchique de cellules endométriales sur la muqueuse et en dehors de la cavité utérine."
                        ],
                        "tags": [
                            "Nosologie",
                            "Gynécologie"
                        ],
                        "examples": [
                            {
                                "example_id": "42b72508-d702-49c1-88a5-050a863382fb",
                                "sense_id": "f654f90b-1a9e-30f0-a214-e7f71f74dec7",
                                "text": "L’endométriose est une maladie gynécologique méconnue et incomprise."
                            },
                            {
                                "example_id": "f49b9e42-8599-45a8-81c4-79aa28e1538a",
                                "sense_id": "f654f90b-1a9e-30f0-a214-e7f71f74dec7",
                                "text": "L’endométriose est une maladie méconnue des professionnels de santé, trop souvent sous-diagnostiquée et assez mal prise en charge."
                            },
                            {
                                "example_id": "854e8919-4a01-4535-bca4-59ed3e110689",
                                "sense_id": "f654f90b-1a9e-30f0-a214-e7f71f74dec7",
                                "text": "L’an passé, elle s’était vu confier par le gouvernement une mission sur l’endométriose, un sujet sur lequel elle s’est engagée depuis des années."
                            },
                            {
                                "example_id": "b4b6e4a4-b2df-468f-966c-6c7d39522586",
                                "sense_id": "f654f90b-1a9e-30f0-a214-e7f71f74dec7",
                                "text": "Les lésions d'endométriose, outre la sphère gynécologique, peuvent également se situer sur les organes digestifs, dont le rectum, sur la vessie, voire sur les reins."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "44924021-0e5a-4b97-be85-8b078239e8eb",
                        "source_entry_id": "179d57d6-70f3-3f65-9ae8-ab2132d81cf9",
                        "source_sense_id": "f654f90b-1a9e-30f0-a214-e7f71f74dec7",
                        "target_lang_word": "endometriosis",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "endometriosis",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "11e35b04-3a1b-31b3-a1f3-52e4cdb39e49",
                                        "entry_id": "9794fbc5-4f69-35a1-98b8-90305267ce64",
                                        "glosses": [
                                            "A generally painful condition characterised by the presence of endometrial-like tissue in places other than the lining of the uterus; an instance of such tissue being present."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e7f3675b-5788-48ca-a065-c60ed34f3f6f",
                                                "sense_id": "11e35b04-3a1b-31b3-a1f3-52e4cdb39e49",
                                                "text": "The cyclic changes characterizing endometrioses are particularly apparent in endometriosis of the bladder."
                                            },
                                            {
                                                "example_id": "8716762e-db9d-461f-ac8c-dbb6eb190905",
                                                "sense_id": "11e35b04-3a1b-31b3-a1f3-52e4cdb39e49",
                                                "text": "This chapter will cover all types of extragenital endometriosis reported in the literature, besides bowel and urinary tract endometriosis, which are dealt with in detail elsewhere in this book."
                                            },
                                            {
                                                "example_id": "9fe8aa22-2b7e-4135-bbfb-9dec86fc3b91",
                                                "sense_id": "11e35b04-3a1b-31b3-a1f3-52e4cdb39e49",
                                                "text": "One can treat all adnexal diseases including cysts and endometrioses of the rectovaginal septum."
                                            },
                                            {
                                                "example_id": "73df2d5a-efa7-4514-b4e3-7455c4b803b9",
                                                "sense_id": "11e35b04-3a1b-31b3-a1f3-52e4cdb39e49",
                                                "text": "Endometriosis is classically defined as the presence of endometrial glands and stroma in ectopic locations. Affecting from 6% to 10% of reproductive-aged women, endometriosis may result in dysmenorrhea, dyspareunia, chronic pelvic pain and/or subfertility."
                                            },
                                            {
                                                "example_id": "9da52a59-28e3-4f45-9112-521a9138712f",
                                                "sense_id": "11e35b04-3a1b-31b3-a1f3-52e4cdb39e49",
                                                "text": "Endometriosis, which involves tissue similar to uterine tissue growing elsewhere in the body, has myriad symptoms, including GI distress, migraines, discomfort during sex and abdominal pain that can range from debilitating to excruciating."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "560c57e6-04ff-4965-b03b-b5ba60d4bfc4",
                        "source_entry_id": "179d57d6-70f3-3f65-9ae8-ab2132d81cf9",
                        "source_sense_id": "f654f90b-1a9e-30f0-a214-e7f71f74dec7",
