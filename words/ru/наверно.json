                    "sense_id": "48dca366-1e6d-3b25-bf45-1d8bee72d765",
                    "sense_definition": "Вероятно, по всей видимости; вводное слово, выражающее неуверенность или предположение.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "probability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы, <w>наверно</w>, пойдём завтра в кино, если будет хорошая погода.",
                            "target_lang_translations": {
                                "en": "We will <w>probably</w> go to the cinema tomorrow if the weather is good.",
                                "de": "Wir gehen morgen <w>wahrscheinlich</w> ins Kino, wenn das Wetter gut ist.",
                                "nl": "Wij gaan <w>waarschijnlijk</w> morgen naar de film als het mooi weer is.",
                                "pl": "Jutro <w>prawdopodobnie</w> pójdziemy do kina, jeśli będzie ładna pogoda.",
                                "fr": "Nous irons <w>probablement</w> au cinéma demain, s'il fait beau.",
                                "it": "Noi <w>probabilmente</w> andremo al cinema domani, se ci sarà bel tempo.",
                                "cs": "Zítra <w>asi</w> půjdeme do kina, pokud bude hezké počasí.",
                                "tr": "Hava güzel olursa yarın <w>muhtemelen</w> sinemaya gideceğiz.",
                                "es": "Nosotros <w>probablemente</w> iremos al cine mañana si hace buen tiempo.",
                                "zh": "如果明天天气好，我们<w>大概</w>会去看电影。"
                            }
                        },
                        {
                            "text": "Ты, <w>наверно</w>, очень устал после долгой работы.",
                            "target_lang_translations": {
                                "en": "You are <w>probably</w> very tired after working for so long.",
                                "de": "Du bist nach der langen Arbeit <w>vermutlich</w> sehr müde.",
                                "nl": "Je bent <w>waarschijnlijk</w> erg moe na lang werken.",
                                "pl": "Jesteś <w>pewnie</w> bardzo zmęczony po długiej pracy.",
                                "fr": "Tu es <w>probablement</w> très fatigué après avoir travaillé si longtemps.",
                                "it": "Tu sei <w>probabilmente</w> molto stanco dopo aver lavorato a lungo.",
                                "cs": "Jsi <w>pravděpodobně</w> po dlouhé práci velmi unavený.",
                                "tr": "Uzun süren çalışmadan sonra <w>galiba</w> çok yoruldun.",
                                "es": "Tú <w>seguramente</w> estás muy cansado después de trabajar tanto tiempo.",
                                "zh": "工作了这么久，你<w>想必</w>很累了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "вероятно",
                        "возможно",
                        "по-видимому",
                        "по всей видимости",
                        "предположительно",
