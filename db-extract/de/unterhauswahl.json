                ],
                "senses": [
                    {
                        "sense_id": "ab323332-8936-3d98-b0d6-7edcdf085bb7",
                        "entry_id": "c6ba782f-f48c-3c81-82a7-31a8e9f4b0ad",
                        "glosses": [
                            "Wahl von Abgeordneten zu einer von zwei Kammern mit gesetzgeberischen Befugnissen (= Parlament)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ca90558-a7b2-4304-b458-5a808bf8e833",
                                "sense_id": "ab323332-8936-3d98-b0d6-7edcdf085bb7",
                                "text": "„Die britische Unterhauswahl 2024 fand am 4. Juli 2024 statt.“"
                            },
                            {
                                "example_id": "5cc9be1e-ae5a-45ea-8431-fcdacb9fd44d",
                                "sense_id": "ab323332-8936-3d98-b0d6-7edcdf085bb7",
                                "text": "„Nach Labours Sieg bei den britischen Unterhauswahlen eröffnet König Charles III. die neue Sitzungsperiode des Parlaments.“"
                            },
                            {
                                "example_id": "6ec86449-2d8c-46b0-add2-7d93d5888486",
                                "sense_id": "ab323332-8936-3d98-b0d6-7edcdf085bb7",
                                "text": "„Die Unterhauswahl in Großbritannien am 5. Mai 2005 endete mit einem historischen Wahlsieg für die Labour Party und Premierminister Tony Blair.“"
                            },
                            {
                                "example_id": "20870181-f318-4cb5-9be2-d44d76900c3a",
                                "sense_id": "ab323332-8936-3d98-b0d6-7edcdf085bb7",
                                "text": "„Bei den Unterhauswahlen in Großbritannien am 7. Mai 2015 entscheiden die Briten auch über die zukünftige EU-Strategie des Landes.“"
                            },
                            {
                                "example_id": "e037df48-14b6-4e87-8a20-a7f8c6d6be81",
                                "sense_id": "ab323332-8936-3d98-b0d6-7edcdf085bb7",
                                "text": "„Bei den regulären Unterhauswahlen 1979 verteidigte er sein Mandat knapp.“"
                            },
                            {
                                "example_id": "2c7e4535-ddb9-42f3-9b4c-9ac53061d725",
                                "sense_id": "ab323332-8936-3d98-b0d6-7edcdf085bb7",
                                "text": "„Vor den Unterhauswahlen 1983 wurde der Wahlkreis Berwickshire and East Lothian aufgelöst.“"
                            },
                            {
                                "example_id": "8cac48b6-c5de-423d-863c-cac5dff7c065",
                                "sense_id": "ab323332-8936-3d98-b0d6-7edcdf085bb7",
                                "text": "„Bei den folgenden Unterhauswahlen 1987, 1992 und 1997 verteidigte er sein Mandat.“"
                            },
                            {
                                "example_id": "226cbab5-34e9-44a7-99cc-b81a4da7809e",
                                "sense_id": "ab323332-8936-3d98-b0d6-7edcdf085bb7",
                                "text": "„Zu den Unterhauswahlen 2001 trat er nicht mehr an.“"
                            },
                            {
                                "example_id": "3c7d0a5d-8eb9-4053-8bdf-bfb67ebc2366",
                                "sense_id": "ab323332-8936-3d98-b0d6-7edcdf085bb7",
                                "text": "„Als junger Mann wurde Mansel bei der Unterhauswahl 1689 dank des Einflusses seiner Familie als Abgeordneter für Cardiff in das House of Commons gewählt“ […]."
                            },
                            {
                                "example_id": "a4a8b578-57eb-493e-8c99-8a804d7a6347",
                                "sense_id": "ab323332-8936-3d98-b0d6-7edcdf085bb7",
                                "text": "„Bei den Unterhauswahlen 1702 und 1705 wurde er wiedergewählt.“"
                            },
                            {
                                "example_id": "1e79c33e-e423-4f3d-8154-b472d2f7cdc6",
                                "sense_id": "ab323332-8936-3d98-b0d6-7edcdf085bb7",
                                "text": "„Aus der irischen Unterhauswahl am 8. Februar sind die linksgerichtete Sinn Féin und die konservative Fianna Fáil als stärkste Kräfte hervorgegangen.“"
                            },
                            {
                                "example_id": "46c2b28e-b0e8-4ce7-bce5-69f4ed9dc0cf",
                                "sense_id": "ab323332-8936-3d98-b0d6-7edcdf085bb7",
                                "text": "[Irland:] „Bei der Unterhauswahl 2015 gewann die SDLP erneut 3 Wahlkreismandate.“"
                            },
                            {
                                "example_id": "e153383f-6dae-48a2-a3b6-b7dfb6e3e1d2",
                                "sense_id": "ab323332-8936-3d98-b0d6-7edcdf085bb7",
                                "text": "„Nach der kanadischen Unterhauswahl 2011 traten die Konservativen und die NDP als die beiden stärksten Parteien der Region hervor.“"
                            },
                            {
                                "example_id": "aefa48b7-affe-46ab-b928-f4a884a61a12",
                                "sense_id": "ab323332-8936-3d98-b0d6-7edcdf085bb7",
                                "text": "„Kanadische Unterhauswahl 2021 – […] Das Ergebnis blieb im Vergleich zur Unterhauswahl 2019 beinahe unverändert und es resultierten nur geringfügige Sitzverschiebungen.“"
                            },
                            {
                                "example_id": "d3013a5a-6dca-4bf4-ac68-65ef0cb5da09",
                                "sense_id": "ab323332-8936-3d98-b0d6-7edcdf085bb7",
                                "text": "[Indien:] „Nach ihrem Achtungserfolg in der Hauptstadtregion Delhi tritt sie bei den Unterhauswahlen 2014 erstmals landesweit an.“"
                            },
                            {
                                "example_id": "c62398aa-fea3-4be4-8365-6adc1ec8f1d4",
                                "sense_id": "ab323332-8936-3d98-b0d6-7edcdf085bb7",
                                "text": "[Indien:] „Auch Wahlen sind eine teure Angelegenheit. Nach Schätzung von Ökonomen und politischen Beobachtern wurden bei den Unterhauswahlen im Jahr 2009 umgerechnet mehr als zwei Milliarden Euro eingesetzt – das ist mehr als im Wahlkampf um die US-Präsidentschaft.“"
                            },
                            {
                                "example_id": "91df1d4e-8bc4-4594-9cda-a5e2a4d6518b",
                                "sense_id": "ab323332-8936-3d98-b0d6-7edcdf085bb7",
                                "text": "„Die Koalition von Ministerpräsident Junichiro Koizumi wird bei den Unterhauswahlen in Japan trotz Stimmeneinbußen im Amt bestätigt.“"
                            },
                            {
                                "example_id": "85999951-dfc4-48f5-9edd-6566e0e5bb11",
                                "sense_id": "ab323332-8936-3d98-b0d6-7edcdf085bb7",
                                "text": "„Ohne Zustimmung in diesen Regionen kann man keine Unterhauswahl gewinnen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
