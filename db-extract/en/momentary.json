                    },
                    {
                        "sense_id": "96706a4f-2f2f-35e3-ba42-bbc621ffd377",
                        "entry_id": "95f90049-8e16-306b-baf2-bc535a3b9c0d",
                        "glosses": [
                            "Happening at every moment; perpetual."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "261b5cea-5e9b-3d93-9221-e625479dcb00",
                        "entry_id": "95f90049-8e16-306b-baf2-bc535a3b9c0d",
                        "glosses": [
                            "Ephemeral or relatively short-lived."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7bbd6aa2-8bdb-4e58-b0b3-494b04f98801",
                                "sense_id": "261b5cea-5e9b-3d93-9221-e625479dcb00",
                                "text": "Yet oh! what an immense difference did I feel between this impression of a pleasure merely animal, and struck out of the collision of the sexes by a passive bodily effect, from that sweet fury, that rage of active delight which crowns the enjoyments of a mutual love-passion, where two hearts, tenderly and truly united, club to exalt the joy, and give it a spirit and soul that bids defiance to that end which mere momentary desires generally terminate in, when they die of a surfeit of satisfaction!",
                                "translation": "Fanny Hill",
                                "english": "Fanny Hill"
                            },
                            {
                                "example_id": "0decc4e2-4caa-4ced-bf82-ed262489afcc",
                                "sense_id": "261b5cea-5e9b-3d93-9221-e625479dcb00",
                                "text": "Tony's face expressed relief, and Nettie sat silent for a moment until the vicar said “It was a generous impulse, but it may have been a momentary one,[…].”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ce55c8a8-0bd9-4b27-8f6e-3ea8a17f3c2a",
                        "source_entry_id": "95f90049-8e16-306b-baf2-bc535a3b9c0d",
                        "source_sense_description": "lasting for only a moment",
                        "target_lang_word": "chvilkový",
                        "target_lang_code": "cs",
