                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3fa9b0b5-f5f5-4230-8d97-377fbcfe43ad",
                                "sense_id": "9ceb7916-86fd-3481-9ed3-31e2fefd6315",
                                "text": "Le crucifiement de Jésus-Christ."
                            },
                            {
                                "example_id": "4dbf95a6-c5a0-4fe8-873c-ce7eec8792fd",
                                "sense_id": "9ceb7916-86fd-3481-9ed3-31e2fefd6315",
                                "text": "Peut-on dire que sans Judas, il n’y aurait pas eu de Chemin de Croix, de flagellation, de crucifiement, de mort, de résurrection ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "88032bbf-7b0d-3cee-9082-1c5ed59fb7c2",
                        "entry_id": "6f4914aa-96b3-3179-97da-7d62f62b1bd0",
                        "glosses": [
                            "Tableaux où le crucifiement (1) de Jésus-Christ est représenté."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "afc5330c-7b92-43dc-9815-b3397e9f31ce",
                                "sense_id": "88032bbf-7b0d-3cee-9082-1c5ed59fb7c2",
                                "text": "Le crucifiement de Le Brun, de Rubens."
                            },
                            {
                                "example_id": "2d4443a8-2468-4615-bb70-c277f076ac22",
                                "sense_id": "88032bbf-7b0d-3cee-9082-1c5ed59fb7c2",
                                "text": "C’est un des plus grands bas-reliefs qu’il y ait au monde : selon l’usage gothique, il est divisé en plusieurs compartiments, le Jardin des Oliviers, le Portement de croix, le Crucifiement entre les deux voleurs, […]"
                            }
                        ]
                    }
