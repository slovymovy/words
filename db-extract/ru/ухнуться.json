                        "examples": [
                            {
                                "example_id": "fbc26602-eb90-4507-ae1d-c9d7221b5f4e",
                                "sense_id": "75a1d5fa-9931-326b-9a40-345c2eab94d6",
                                "text": "В сле́дующий миг она́ вы́летела из седла́, описа́ла в во́здухе дугу́, и у́хнулась во что́-то зелёное, мя́гкое, хрустя́щее – в придоро́жный куст.",
                                "translation": "The next moment she went flying out of the saddle, describing an arc through the air and landing heavily in something green, yielding, and rustling—a bush at the side of the road.",
                                "english": "The next moment she went flying out of the saddle, describing an arc through the air and landing heavily in something green, yielding, and rustling—a bush at the side of the road."
                            }
                        ]
