                                                "text": "Die Befragerin fragte nach den Gründen der Berufswahl."
                                            },
                                            {
                                                "example_id": "2c6eff0c-bf42-4e40-8111-022712d80736",
                                                "sense_id": "c3a1a52d-1c6a-3340-970b-4c78b054d2a0",
