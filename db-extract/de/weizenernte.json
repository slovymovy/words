                "senses": [
                    {
                        "sense_id": "094f3230-663b-3ee3-b7d4-c3e277a0839b",
                        "entry_id": "43d29436-9ff3-36ec-90e8-648c3b4272c5",
                        "glosses": [
                            "Gesamtheit aller Arbeiten, die zum Einbringen von Weizen notwendig sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87e56dca-a4dd-4a9b-a426-d11af66f9db1",
                                "sense_id": "094f3230-663b-3ee3-b7d4-c3e277a0839b",
                                "text": "„Sie flog hinauf und überquerte, auf diesen Winden segelnd, zwei Tage später die Grenze nach Indien, wo die Weizenernte früher beginnt und die Elektromasten sicherer sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ecb532dc-6552-38b7-8e19-78ea6fb4815e",
                        "entry_id": "43d29436-9ff3-36ec-90e8-648c3b4272c5",
                        "glosses": [
                            "Ertrag des Einbringens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2cb2b93f-fe58-4c29-a95a-aefdfc0c4cd2",
                                "sense_id": "ecb532dc-6552-38b7-8e19-78ea6fb4815e",
                                "text": "„Auf Sizilien hat der Schwarzrost 2016 große Teile der Weizenernte vernichtet.“"
                            },
                            {
                                "example_id": "126296c4-3512-4296-a847-36cfecf3633b",
                                "sense_id": "ecb532dc-6552-38b7-8e19-78ea6fb4815e",
                                "text": "„Trotz der verderblichen Kalkdüngung, der eingesparten Zweitbearbeitung und der unzeitgemäßen Unkrautjätung hatte Bouvard im nächsten Jahr eine schöne Weizenernte vor sich.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
