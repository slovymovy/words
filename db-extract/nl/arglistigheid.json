                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f8349f8d-9bdd-4721-9e5f-5fd56a818494",
                                                "sense_id": "94ade7ca-46ec-36d6-82ee-caf93b9897bf",
                                                "text": "Jesus saw Nathanael coming to him, and saith of him, Behold an Israelite indeed, in whom is no guile!"
