                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "6926c487-fc5d-4452-94fb-f6afc5966518",
                        "entry_id": "4d9c965a-bacf-3282-8792-c51998731f78",
                        "tags": [
                            "plural"
                        ],
                        "form": "inflammateurs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8eff23b9-58d5-364c-ab9b-8b12e28fc7f1",
                        "entry_id": "4d9c965a-bacf-3282-8792-c51998731f78",
                        "glosses": [
                            "Amorce pyrotechnique produisant principalement une flamme et utilisée dans la constitution des allumeurs de charges propulsives ou des pieces pyrotechniques."
                        ],
                        "tags": [
                            "Armement",
                            "Matériaux énergétiques"
                        ],
                        "examples": [
                            {
                                "example_id": "bec1812e-824d-4727-9971-288596e8fc52",
                                "sense_id": "8eff23b9-58d5-364c-ab9b-8b12e28fc7f1",
                                "text": "L’élément de propagation aussi appelé inflammateur est chargé de transmettre une flamme à une bombe d’artifice."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7d8a21b4-93ea-45c8-ab31-978ac950c5c7",
                        "source_entry_id": "4d9c965a-bacf-3282-8792-c51998731f78",
                        "source_sense_id": "8eff23b9-58d5-364c-ab9b-8b12e28fc7f1",
                        "target_lang_word": "squib",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "squib",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c78fd1d2-1bde-3825-9a49-d465862beb7b",
                                        "entry_id": "0378ec69-e5d0-3a47-8d22-ad619daa03f1",
                                        "glosses": [
                                            "A small firework that is intended to spew sparks rather than explode."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e48b473a-eb74-4c46-ad07-caef28bcca87",
                                                "sense_id": "c78fd1d2-1bde-3825-9a49-d465862beb7b",
                                                "text": "English Navy squibs set fire to two dozen enemy ships in a Dutch harbor during the 16th-century battle against the Spanish Armada."
                                            },
                                            {
                                                "example_id": "0449023a-fb8a-4c23-9d59-f8eb9ad9ec9e",
                                                "sense_id": "c78fd1d2-1bde-3825-9a49-d465862beb7b",
                                                "text": "The making and selling of fireworks and squibs, or throwing them about on any street, is […] punishable by fine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fe7bd368-abd5-34d7-8cf0-c411aed635ae",
                                        "entry_id": "0378ec69-e5d0-3a47-8d22-ad619daa03f1",
                                        "glosses": [
                                            "A similar device used to ignite an explosive or launch a rocket, etc."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7dad8222-b6e3-3565-a482-12921660ae76",
                                        "entry_id": "0378ec69-e5d0-3a47-8d22-ad619daa03f1",
                                        "glosses": [
                                            "A kind of slow match or safety fuse."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "02d3d483-ded9-3163-9e40-d0be1d713312",
                                        "entry_id": "0378ec69-e5d0-3a47-8d22-ad619daa03f1",
                                        "glosses": [
                                            "Any small firecracker sold to the general public, usually in special clusters designed to explode in series after a single master fuse is lit."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2d449bc7-1fce-39ad-99f7-7dc612d6f3c1",
                                        "entry_id": "0378ec69-e5d0-3a47-8d22-ad619daa03f1",
                                        "glosses": [
                                            "A malfunction in which the fired projectile does not have enough force behind it to exit the barrel, and thus becomes stuck."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "97f5b510-1a0a-341b-a4b1-d1efd9be8a22",
                                        "entry_id": "0378ec69-e5d0-3a47-8d22-ad619daa03f1",
                                        "glosses": [
                                            "The heating element used to set off the sodium azide pellets in a vehicle's airbag."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6acdee35-e85a-3764-8f22-59e1b83932ac",
                                        "entry_id": "0378ec69-e5d0-3a47-8d22-ad619daa03f1",
                                        "glosses": [
                                            "In special effects, a small explosive used to replicate a bullet hitting a surface or a gunshot wound on an actor."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6642f9aa-fecf-3c50-bd32-8b97a1c81c0b",
                                        "entry_id": "0378ec69-e5d0-3a47-8d22-ad619daa03f1",
                                        "glosses": [
                                            "A short piece of witty writing; a lampoon."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d22a757-5fd9-4745-abf9-90555010527c",
                                                "sense_id": "6642f9aa-fecf-3c50-bd32-8b97a1c81c0b",
                                                "text": "Ye nevvs-paper vvitlings! ye pert ſcribbling folks! / VVho copied his ſquibs, and re-echoed his jokes, […]"
                                            },
                                            {
                                                "example_id": "6d90f649-90aa-4537-ad07-989f8d31e9f5",
                                                "sense_id": "6642f9aa-fecf-3c50-bd32-8b97a1c81c0b",
                                                "text": "Of the dozen or so surviving articles, squibs, and letters to the editor, the most remarkable appeared in the Whip and Satirist’s February 12, 1842, issue, and disclosed the existence of a cabal of gay men in New York's otherwise wholesome nightscape of brothels and riots."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5872d60e-8e53-3d03-8e04-1b601d37fa11",
                                        "entry_id": "0378ec69-e5d0-3a47-8d22-ad619daa03f1",
                                        "glosses": [
                                            "A writer of lampoons."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "92dfe599-2899-4a45-aa77-74dccb9ba89c",
                                                "sense_id": "5872d60e-8e53-3d03-8e04-1b601d37fa11",
                                                "text": "November 1, 1709, Richard Steele, The Tatler\nThe squibs are those who in the common phrase of the world are called libellers, lampooners, and pamphleteers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6603334d-2473-3773-a530-c226d819b45f",
                                        "entry_id": "0378ec69-e5d0-3a47-8d22-ad619daa03f1",
                                        "glosses": [
                                            "In a legal casebook, a short summary of a legal action placed between more extensively quoted cases."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "741c1f36-c592-34bf-bb1e-c09db9d15c3b",
                                        "entry_id": "0378ec69-e5d0-3a47-8d22-ad619daa03f1",
                                        "glosses": [
                                            "A short article, often published in journals, that introduces theoretically problematic empirical data or discusses an overlooked theoretical problem. In contrast to a typical article, a squib need not answer the questions that it poses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "daf3df39-2e40-4f14-918a-c2803be5e70d",
                                                "sense_id": "741c1f36-c592-34bf-bb1e-c09db9d15c3b",
                                                "text": "In this squib I will prove that the number of possible metrical parsings into feet under these assumptions […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3c664b41-1a7c-3782-adac-8973b99d868e",
                                        "entry_id": "0378ec69-e5d0-3a47-8d22-ad619daa03f1",
                                        "glosses": [
                                            "An unimportant, paltry, or mean-spirited person."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d2aa917-fb05-454e-8a58-e295832da39e",
                                                "sense_id": "3c664b41-1a7c-3782-adac-8973b99d868e",
                                                "text": "Its a hard case when men of good deserving / must either driven be perforce to sterving / or asked for their pas by everie squib."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08cba324-c831-3f86-bffe-c763adac3832",
                                        "entry_id": "0378ec69-e5d0-3a47-8d22-ad619daa03f1",
                                        "glosses": [
                                            "A sketched concept or visual solution, usually very quick and not too detailed."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "791b4a4f-0216-3d19-83e7-e4d588bbec60",
                                        "entry_id": "0378ec69-e5d0-3a47-8d22-ad619daa03f1",
                                        "glosses": [
                                            "A coward or wimp."
                                        ],
                                        "tags": [
                                            "Australia"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f5b0131a-c85b-4331-b699-96ddd573c342",
                                                "sense_id": "791b4a4f-0216-3d19-83e7-e4d588bbec60",
                                                "text": "I'm putting my foot down, Janelle. We're raising a nation of squibs!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "squib",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "17331681-ad72-3070-9695-cf87113d0400",
                                        "entry_id": "9585b4e5-c374-3f47-afca-3de4aadaaf6e",
                                        "glosses": [
                                            "To make a sound like a small explosion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3aff2769-1207-40ae-86fd-2f1b6a19e8f1",
                                                "sense_id": "17331681-ad72-3070-9695-cf87113d0400",
                                                "text": "A Snider squibbed in the jungle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "57650aac-fcac-37f7-9086-51ca00b86c34",
                                        "entry_id": "9585b4e5-c374-3f47-afca-3de4aadaaf6e",
                                        "glosses": [
                                            "To throw squibs; to utter sarcastic or severe reflections; to contend in petty dispute."
                                        ],
                                        "tags": [
                                            "ambitransitive",
                                            "colloquial",
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "33726433-3ac5-4b05-a64e-dabddf8e3593",
                                                "sense_id": "57650aac-fcac-37f7-9086-51ca00b86c34",
                                                "text": "to squib a little debate"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "17250c4b-d359-39e5-8d52-2c483ad6d1ee",
                                        "entry_id": "9585b4e5-c374-3f47-afca-3de4aadaaf6e",
                                        "glosses": [
                                            "To dodge something difficult, to bottle."
                                        ],
                                        "tags": [
                                            "Australia"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1f320f3c-c186-499d-8f93-4b0fa2cb5b46",
                                                "sense_id": "17250c4b-d359-39e5-8d52-2c483ad6d1ee",
                                                "text": "He squibbed the opportunity to push the claim that Kyoto should remain the flagship for international action - because deep down those on the other side know that the world has moved on beyond Kyoto."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
