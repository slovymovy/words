                        "examples": [
                            {
                                "example_id": "ea0c51f7-e30b-40f1-8727-15951cf6f397",
                                "sense_id": "cdee663b-3b7f-3589-bd88-4dbca8ad7538",
                                "text": "Les Ouvriers donnent à la molybdene les noms de potelot , mine de plomb noire ou savonneuse, crayon d'Angleterre, plomb de mer, plombagine, plomb de mine, céruse noire, talc-blende , fausse galene, mica des Peintres, ou crayon de plomb."
                            },
                            {
                                "example_id": "263cd465-cb7f-44b1-81ba-40a3e90cd940",
                                "sense_id": "cdee663b-3b7f-3589-bd88-4dbca8ad7538",
                                "text": "Le potelot, ou sulfure de molybdène natif, exposé au feu dans un vaisseau ouvert, exhale du soufre, & s'évapore presque tout entier en fumée blanche."
                            }
                        ]
                    }
