                                "target_senses": [
                                    {
                                        "sense_id": "d918ca3f-7c00-3619-92f6-759a91e9ae65",
                                        "entry_id": "2c10a277-3502-3772-8288-084580607e4d",
                                        "glosses": [
                                            "Habitant de Metz, en Lorraine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e79b52db-ae1c-4b9f-8cca-d16ea63cf6db",
                                                "sense_id": "d918ca3f-7c00-3619-92f6-759a91e9ae65",
                                                "text": "Le Messin Gaspard de Heu est célèbre par la participation qu’il eut, avec son frère, dans l'introduction des Français dans la ville de Metz."
                                            },
                                            {
                                                "example_id": "421f3b44-7c44-44ec-a291-6f95213bec44",
                                                "sense_id": "d918ca3f-7c00-3619-92f6-759a91e9ae65",
                                                "text": "Face à des Messins pourtant réduits à dix, les hommes de Marcelino, qui menaient grâce à Soglo (14e) avant de concéder deux buts, ont arraché le nul grâce à Vitinha (82e)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b167bf0f-80f0-40fe-b4f8-6e86d6081f14",
                        "source_entry_id": "7017d63d-45ce-30a6-85e0-741a3757ffa6",
