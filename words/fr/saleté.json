                    "sense_id": "80b12497-7cab-3f17-8a03-1c32e77674f1",
                    "sense_definition": "Action déloyale, basse ou méchante commise au détriment de quelqu'un.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "morale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Son collègue lui a fait une <w>saleté</w> pour obtenir la promotion à sa place.",
                            "target_lang_translations": {
                                "en": "His colleague pulled a <w>dirty trick</w> on him to get the promotion instead of him.",
                                "ru": "Коллега сделал ему <w>гадость</w>, чтобы получить повышение вместо него.",
                                "de": "Sein Kollege hat ihm eine <w>Gemeinheit</w> angetan, um an seiner Stelle die Beförderung zu bekommen.",
                                "es": "Su compañero le hizo una <w>faena</w> para conseguir el ascenso en su lugar.",
                                "zh": "同事为了取代他得到晋升，对他使了<w>阴招</w>。"
                            }
                        },
                        {
                            "text": "Après une telle <w>saleté</w>, ils ont refusé de se parler à nouveau.",
                            "target_lang_translations": {
                                "en": "After such a <w>dirty trick</w>, they refused to speak to each other again.",
                                "ru": "После такой <w>подлости</w> они отказались снова разговаривать друг с другом.",
                                "de": "Nach so einer <w>Gemeinheit</w> weigerten sie sich, wieder miteinander zu reden.",
                                "es": "Tras semejante <w>faena</w>, se negaron a volver a hablarse.",
                                "zh": "经历了这样的<w>阴招</w>后，他们再也不肯互相说话了。"
                            }
                        }
