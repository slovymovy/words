{
    "word_family": [
        "uncharted",
        "charter",
        "rechart"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "28599986-58ff-38da-8123-b1c5468150a3",
                    "sense_definition": "A visual representation of data, such as a graph, diagram, or table, intended to make information easier to understand.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "visual_data",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher pointed to the <w>chart</w> on the wall to explain the population growth.",
                            "target_lang_translations": {
                                "ru": "Учитель указал на <w>график</w> на стене, чтобы объяснить рост населения.",
                                "tr": "Öğretmen, nüfus artışını açıklamak için duvardaki <w>grafiği</w> işaret etti.",
                                "zh": "老师指着墙上的<w>图表</w>来解释人口增长。"
                            }
                        },
                        {
                            "text": "Please look at this pie <w>chart</w> to see how the budget is divided.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, посмотрите на эту круговую <w>диаграмму</w>, чтобы увидеть, как распределен бюджет.",
                                "tr": "Bütçenin nasıl bölündüğünü görmek için lütfen bu pasta <w>grafiğine</w> bakın.",
                                "zh": "请看这张饼状<w>图表</w>，了解预算是如何分配的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "graph",
                        "diagram"
                    ],
                    "common_phrases": [
                        "pie chart",
                        "flow chart",
                        "bar chart",
                        "organization chart"
                    ],
                    "target_lang_definitions": {
                        "ru": "Визуальное представление данных, например график, диаграмма или таблица, предназначенное для упрощения понимания информации.",
                        "tr": "Bilginin daha kolay anlaşılmasını sağlamak amacıyla grafi, diyagram veya tablo şeklinde sunulan görsel temsil.",
                        "zh": "一种用于呈现数据的视觉表现形式，如统计图、图表或表格，旨在使信息更易于理解。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "диаграмма",
                                "target_lang_sense_clarification": "схема, рисунок"
                            },
                            {
                                "target_lang_word": "график",
                                "target_lang_sense_clarification": "линейный график, чертеж"
                            },
                            {
                                "target_lang_word": "схема",
                                "target_lang_sense_clarification": "общий план"
                            },
                            {
                                "target_lang_word": "таблица",
                                "target_lang_sense_clarification": "структурированные данные"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "grafik",
                                "target_lang_sense_clarification": "çizelge, görsel veri"
                            },
                            {
                                "target_lang_word": "şema",
                                "target_lang_sense_clarification": "diyagram"
                            },
                            {
                                "target_lang_word": "tablo",
                                "target_lang_sense_clarification": "düzenli veri listesi"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "图表",
                                "target_lang_sense_clarification": "通用的数据展示形式"
                            },
                            {
                                "target_lang_word": "统计图",
                                "target_lang_sense_clarification": "用于展示统计数据的图"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b843bfa8-34ff-3358-aa83-56501ba22f63",
                    "sense_definition": "A weekly listing of the most popular music, books, or other products, ranked by sales or streams.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "music_ranking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Their new song climbed to the top of the <w>charts</w> within a week.",
                            "target_lang_translations": {
                                "ru": "Их новая песня поднялась на вершину <w>чартов</w> за одну неделю.",
                                "tr": "Yeni şarkıları bir hafta içinde <w>müzik listelerinin</w> zirvesine tırmandı.",
                                "zh": "他们的新歌在一周内就登上了<w>排行榜</w>榜首。"
                            }
                        },
                        {
                            "text": "She has been listening to the hits from the pop <w>charts</w> all day.",
                            "target_lang_translations": {
                                "ru": "Она весь день слушала хиты из поп-<w>чартов</w>.",
                                "tr": "Bütün gün pop <w>listelerindeki</w> hit şarkıları dinliyor.",
                                "zh": "她整天都在听流行音乐<w>排行榜</w>上的热门歌曲。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "top of the charts",
                        "hit the charts",
                        "music charts"
                    ],
                    "target_lang_definitions": {
                        "ru": "Еженедельный список самых популярных музыкальных произведений, книг или других товаров, ранжированный по продажам или прослушиваниям.",
                        "tr": "Satış veya dinlenme sayılarına göre sıralanan en popüler müzik, kitap veya diğer ürünlerin haftalık listesi.",
                        "zh": "按销量或流媒体播放量排名的最受欢迎音乐、书籍或其他产品的每周榜单。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хит-парад",
                                "target_lang_sense_clarification": "список популярных песен"
                            },
                            {
                                "target_lang_word": "чарт",
                                "target_lang_sense_clarification": "рейтинг популярности"
                            },
                            {
                                "target_lang_word": "рейтинг",
                                "target_lang_sense_clarification": "общий список лидеров"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "müzik listesi",
                                "target_lang_sense_clarification": "popüler şarkılar sıralaması"
                            },
                            {
                                "target_lang_word": "hit sıralaması",
                                "target_lang_sense_clarification": "en çok satanlar listesi"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "排行榜",
                                "target_lang_sense_clarification": "流行度排名列表"
                            },
                            {
                                "target_lang_word": "榜单",
                                "target_lang_sense_clarification": "音乐或产品的排名"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fb57bb9f-a665-3848-8713-9863077a7559",
                    "sense_definition": "A detailed map used for navigation, especially for ships at sea or aircraft.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "navigation_map",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The captain studied the <w>chart</w> to avoid the shallow waters near the coast.",
                            "target_lang_translations": {
                                "ru": "Капитан изучал <w>морскую карту</w>, чтобы избежать мелководья у побережья.",
                                "tr": "Kaptan, kıyıya yakın sığ sulardan kaçınmak için <w>deniz haritasını</w> inceledi.",
                                "zh": "船长研究了<w>航海图</w>，以避开海岸附近的浅水区。"
                            }
                        },
                        {
                            "text": "We need a detailed <w>chart</w> of the island before we start sailing.",
                            "target_lang_translations": {
                                "ru": "Нам нужна подробная <w>карта</w> острова, прежде чем мы отплывем.",
                                "tr": "Denize açılmadan önce adanın detaylı bir <w>haritasına</w> ihtiyacımız var.",
                                "zh": "在起航前，我们需要一份该岛详细的<w>海图</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "nautical chart",
                        "navigation chart"
                    ],
                    "target_lang_definitions": {
                        "ru": "Подробная карта, используемая для навигации, особенно судами в море или самолетами.",
                        "tr": "Özellikle denizdeki gemiler veya hava taşıtları için navigasyonda kullanılan ayrıntılı harita.",
                        "zh": "用于导航的详细地图，特别是指海上的航海图或航空图。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "морская карта",
                                "target_lang_sense_clarification": "навигационная карта"
                            },
                            {
                                "target_lang_word": "карта",
                                "target_lang_sense_clarification": "общая география"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "deniz haritası",
                                "target_lang_sense_clarification": "seyrüsefer haritası"
                            },
                            {
                                "target_lang_word": "harita",
                                "target_lang_sense_clarification": "navigasyon haritası"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "航海图",
                                "target_lang_sense_clarification": "海上导航地图"
                            },
                            {
                                "target_lang_word": "海图",
                                "target_lang_sense_clarification": "专门用于航海的地图"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "83b33444-0be2-35c9-b350-2bb896682f25",
                    "sense_definition": "A medical record containing a patient's history, diagnosis, and treatment details.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "medical_record",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The nurse updated the patient's <w>chart</w> with the latest blood pressure readings.",
                            "target_lang_translations": {
                                "ru": "Медсестра внесла последние показания артериального давления в <w>медицинскую карту</w> пациента.",
                                "tr": "Hemşire, son tansiyon ölçümleriyle hastanın <w>dosyasını</w> güncelledi.",
                                "zh": "护士将最新的血压读数更新到了患者的<w>病历</w>中。"
                            }
                        },
                        {
                            "text": "The doctor looked at my <w>chart</w> before prescribing the medication.",
                            "target_lang_translations": {
                                "ru": "Врач посмотрел мою <w>историю болезни</w> перед тем, как выписать лекарство.",
                                "tr": "Doktor ilacı yazmadan önce <w>hasta dosyama</w> baktı.",
                                "zh": "医生在开药前查看了我的<w>病历</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "patient chart",
                        "medical chart"
                    ],
                    "target_lang_definitions": {
                        "ru": "Медицинская запись, содержащая историю болезни пациента, диагноз и подробности лечения.",
                        "tr": "Hastanın geçmişini, teşhisini ve tedavi ayrıntılarını içeren tıbbi kayıt.",
                        "zh": "包含患者病史、诊断和治疗详情的医疗记录。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "медицинская карта",
                                "target_lang_sense_clarification": "документ пациента"
                            },
                            {
                                "target_lang_word": "история болезни",
                                "target_lang_sense_clarification": "записи о ходе лечения"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "hasta dosyası",
                                "target_lang_sense_clarification": "tıbbi kayıt"
                            },
                            {
                                "target_lang_word": "tıbbi kartı",
                                "target_lang_sense_clarification": "sağlık karnesi/kaydı"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "病历",
                                "target_lang_sense_clarification": "患者的医疗记录"
                            },
                            {
                                "target_lang_word": "医疗档案",
                                "target_lang_sense_clarification": "正式的医疗记录文件"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "05ae1512-f889-3270-8bba-015ff2763aa1",
                    "sense_definition": "A written deed or charter granting rights or privileges.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "legal_document",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient <w>chart</w> outlined the land rights given to the monastery.",
                            "target_lang_translations": {
                                "ru": "Древняя <w>грамота</w> описывала права на землю, дарованные монастырю.",
                                "tr": "Eski <w>ferman</w>, manastıra verilen toprak haklarını hatlarıyla belirtiyordu.",
                                "zh": "那份古老的<w>特许状</w>概述了授予修道院的土地权利。"
                            }
                        },
                        {
                            "text": "Historians examined the royal <w>chart</w> to understand the laws of that era.",
                            "target_lang_translations": {
                                "ru": "Историки изучали королевскую <w>хартию</w>, чтобы понять законы той эпохи.",
                                "tr": "Tarihçiler, o dönemin yasalarını anlamak için kraliyet <w>şartnamesini</w> incelediler.",
                                "zh": "历史学家研究了那份皇家<w>宪章</w>，以了解那个时代的法律。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Refers to historical legal documents."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Письменный документ или грамота, предоставляющая права или привилегии.",
                        "tr": "Haklar veya ayrıcalıklar sağlayan yazılı belge veya şartname.",
                        "zh": "授予权利或特权的正式书面文件或特许状。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хартия",
                                "target_lang_sense_clarification": "исторический документ"
                            },
                            {
                                "target_lang_word": "грамота",
                                "target_lang_sense_clarification": "документ о правах"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "şartname",
                                "target_lang_sense_clarification": "resmi sözleşme"
                            },
                            {
                                "target_lang_word": "ferman",
                                "target_lang_sense_clarification": "tarihi hak belgesi"
                            },
                            {
                                "target_lang_word": "berat",
                                "target_lang_sense_clarification": "imtiyaz belgesi"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "特许状",
                                "target_lang_sense_clarification": "授予权利的正式文件"
                            },
                            {
                                "target_lang_word": "宪章",
                                "target_lang_sense_clarification": "具有法律效力的纲领性文件"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f914089a-dff8-360c-be8f-88b935a8838e",
                    "sense_definition": "To plan a course of action or to make a map of an area.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "navigation_map",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The explorers tried to <w>chart</w> the unknown territory accurately.",
                            "target_lang_translations": {
                                "ru": "Исследователи пытались точно <w>нанести на карту</w> неизвестную территорию.",
                                "tr": "Kaşifler, bilinmeyen bölgenin tam olarak <w>haritasını çıkarmaya</w> çalıştılar.",
                                "zh": "探险家们试图精确地<w>绘制</w>这片未知区域的地图。"
                            }
                        },
                        {
                            "text": "We need to <w>chart</w> a new course for the company to ensure future success.",
                            "target_lang_translations": {
                                "ru": "Нам нужно <w>наметить</w> новый курс для компании, чтобы обеспечить будущий успех.",
                                "tr": "Gelecekteki başarıyı güvence altına almak için şirket adına yeni bir rota <w>çizmemiz</w> gerekiyor.",
                                "zh": "我们需要为公司<w>规划</w>一条新路线，以确保未来的成功。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "chart a course",
                        "chart a path",
                        "chart the waters"
                    ],
                    "target_lang_definitions": {
                        "ru": "Планировать порядок действий или составлять карту местности.",
                        "tr": "Bir eylem planı çizmek veya bir bölgenin haritasını çıkarmak.",
                        "zh": "规划行动方案或绘制某地区的地图。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прокладывать курс",
                                "target_lang_sense_clarification": "планировать маршрут"
                            },
                            {
                                "target_lang_word": "составлять карту",
                                "target_lang_sense_clarification": "картография"
                            },
                            {
                                "target_lang_word": "намечать",
                                "target_lang_sense_clarification": "планировать действия"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "haritasını çıkarmak",
                                "target_lang_sense_clarification": "bölgeyi haritaya aktarmak"
                            },
                            {
                                "target_lang_word": "planlamak",
                                "target_lang_sense_clarification": "yol/yön belirlemek"
                            },
                            {
                                "target_lang_word": "çizmek",
                                "target_lang_sense_clarification": "rota çizmek"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "绘制",
                                "target_lang_sense_clarification": "制作地图"
                            },
                            {
                                "target_lang_word": "规划",
                                "target_lang_sense_clarification": "制定行动路线"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "52f12717-90fb-36d1-8c82-e87934000d14",
                    "sense_definition": "To record information or progress systematically, often over a period of time.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "medical_record",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scientist continued to <w>chart</w> the temperature changes every hour.",
                            "target_lang_translations": {
                                "ru": "Ученый продолжал <w>фиксировать</w> изменения температуры каждый час.",
                                "tr": "Bilim insanı her saat sıcaklık değişimlerini <w>kaydetmeye</w> devam etti.",
                                "zh": "科学家继续每小时<w>记录</w>一次温度变化。"
                            }
                        },
                        {
                            "text": "Nurses must <w>chart</w> every dose of medicine given to the patients.",
                            "target_lang_translations": {
                                "ru": "Медсестры должны <w>записывать</w> каждую дозу лекарства, выданную пациентам.",
                                "tr": "Hemşireler hastalara verilen her doz ilacı <w>kaydetmelidir</w>.",
                                "zh": "护士必须<w>记录</w>给患者服用的每一剂药物。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "chart progress",
                        "chart growth"
                    ],
                    "target_lang_definitions": {
                        "ru": "Систематически записывать информацию или прогресс, часто в течение определенного периода времени.",
                        "tr": "Bilgileri veya gelişimi genellikle belirli bir zaman diliminde sistematik olarak kaydetmek.",
                        "zh": "系统地记录信息或进展，通常是在一段时间内。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фиксировать",
                                "target_lang_sense_clarification": "регистрировать данные"
                            },
                            {
                                "target_lang_word": "вести график",
                                "target_lang_sense_clarification": "отслеживать изменения"
                            },
                            {
                                "target_lang_word": "записывать",
                                "target_lang_sense_clarification": "делать записи"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "kaydetmek",
                                "target_lang_sense_clarification": "düzenli kayıt tutmak"
                            },
                            {
                                "target_lang_word": "grafiğe dökmek",
                                "target_lang_sense_clarification": "gelişimi takip etmek"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "记录",
                                "target_lang_sense_clarification": "系统地记下数据"
                            },
                            {
                                "target_lang_word": "追踪",
                                "target_lang_sense_clarification": "持续观察并记录进展"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c4c5a646-1208-3c5f-b880-1b711c5b8b81",
                    "sense_definition": "To appear on a list of best-selling music or popular products.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "music_ranking",
                    "name_type": "no",
                    "examples": [
                        {
