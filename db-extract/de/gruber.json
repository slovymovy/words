                ],
                "senses": [
                    {
                        "sense_id": "a6089a9d-6259-328f-a0a7-bfdb00fbd1c8",
                        "entry_id": "474a1329-c999-35a6-a4cb-d9b543110474",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname, häufigster Name in Österreich"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77de3847-c5ea-4e53-a388-510309f4a79a",
                                "sense_id": "a6089a9d-6259-328f-a0a7-bfdb00fbd1c8",
                                "text": "Herr Gruber wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "fd097008-52b1-4a11-b3a3-b1a85459b9d7",
                                "sense_id": "a6089a9d-6259-328f-a0a7-bfdb00fbd1c8",
                                "text": "Die Gruber fliegen heute nach Punta Arenas."
                            },
                            {
                                "example_id": "dfc4fc5d-3158-452b-9791-54c2ed24b8ac",
                                "sense_id": "a6089a9d-6259-328f-a0a7-bfdb00fbd1c8",
                                "text": "Der Gruber trägt nie die Pullover, die die Gruber ihm strickt."
                            },
                            {
                                "example_id": "ca018942-2412-4ac8-b565-f874cc91b49c",
                                "sense_id": "a6089a9d-6259-328f-a0a7-bfdb00fbd1c8",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Gruber kommt, geht der Herr Gruber.“"
                            },
                            {
                                "example_id": "4c7ce2f4-aa21-4d83-bbf2-dd876a2dd253",
                                "sense_id": "a6089a9d-6259-328f-a0a7-bfdb00fbd1c8",
                                "text": "Gruber kommt und geht."
                            },
                            {
                                "example_id": "1fca94e8-5ce6-4763-9f7b-92d5ff2c3410",
                                "sense_id": "a6089a9d-6259-328f-a0a7-bfdb00fbd1c8",
                                "text": "Grubers kamen, sahen und siegten."
                            },
                            {
                                "example_id": "5ac784f0-9619-45cc-8b22-f556f1e58426",
                                "sense_id": "a6089a9d-6259-328f-a0a7-bfdb00fbd1c8",
                                "text": "Frau Gruber ist ein Genie im Verkauf."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
