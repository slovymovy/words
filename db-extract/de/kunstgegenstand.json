                        "examples": [
                            {
                                "example_id": "766567e8-def6-4436-b869-d9653955ee62",
                                "sense_id": "e0a8bbdd-945f-3e3a-932f-8f603319ec1d",
                                "text": "„Die Wände hier waren weder violett gestrichen noch mit ägyptischen Kunstgegenständen oder Malereien verziert.“"
                            },
                            {
                                "example_id": "8de0bd4d-863f-48b6-9242-06d691797909",
                                "sense_id": "e0a8bbdd-945f-3e3a-932f-8f603319ec1d",
                                "text": "„Er zeigte Lovecraft die Kunstgegenstände, die er von seinen Europareisen mitgebracht hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
