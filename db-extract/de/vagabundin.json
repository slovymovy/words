                "senses": [
                    {
                        "sense_id": "aceb26d7-36f3-3423-b534-cf97ec076937",
                        "entry_id": "c990d621-6d1b-3a88-84d2-04902320ba64",
                        "glosses": [
                            "eine ohne Obdach allein umherziehende weibliche Person"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "360e4ba3-67fe-4a0c-9426-f4d31ad1de72",
                                "sense_id": "aceb26d7-36f3-3423-b534-cf97ec076937",
                                "text": "„So haben wir sie, ich meine die Vagabundin, hinter Haneburgs Hecke im Busch gefunden, krummgedrückt hinter der Hecke, die Schürze voll von Haneburgs gestohlenen Mohrrüben […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d8f60ed0-7ac7-424d-bcc3-bfc948b937fb",
                        "source_entry_id": "c990d621-6d1b-3a88-84d2-04902320ba64",
                        "source_sense_id": "aceb26d7-36f3-3423-b534-cf97ec076937",
                        "source_sense_description": "eine ohne Obdach allein umherziehende weibliche Person",
                        "target_lang_word": "vagabond",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vagabond",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "84ea5c49-7659-3de8-8185-0f57708b953b",
                                        "entry_id": "2793d0ae-6a7e-320b-802d-bdf25665a93e",
                                        "glosses": [
                                            "A person on a trip of indeterminate destination and/or length of time."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3b6a3196-2702-3402-935a-b52339e6fd2c",
                                        "entry_id": "2793d0ae-6a7e-320b-802d-bdf25665a93e",
                                        "glosses": [
                                            "One who usually wanders from place to place, having no fixed dwelling, or not abiding in it, and usually without the means of honest livelihood."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85517ed5-f819-4d6f-aac2-2a962de3a742",
                                                "sense_id": "3b6a3196-2702-3402-935a-b52339e6fd2c",
                                                "text": "Foꝛ when thou tylleſt the grounde ſhe ſhall hẽcefoꝛth not geve hyꝛ power vnto the. A vagabunde and a rennagate ſhalt thou be vpon the erth."
                                            },
                                            {
                                                "example_id": "0688e3c0-47b9-44c9-8845-dbd25e4ab172",
                                                "sense_id": "3b6a3196-2702-3402-935a-b52339e6fd2c",
                                                "text": "\"Here is the beastly thing. 'Every person professing to tell fortunes or using any subtle craft, means or device to deceive and impose on any of His Majesty's subjects shall be deemed a rogue and a vagabond', and so on and so forth.\""
                                            },
                                            {
                                                "example_id": "3d642c11-9adb-4350-8660-851c29e8a315",
                                                "sense_id": "3b6a3196-2702-3402-935a-b52339e6fd2c",
                                                "text": "Anoleis: You will excuse me if I don't stand up.\nAnoleis: I have no time to entertain spaceborn vagabonds."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "vagabond",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1199c576-87f6-340c-99f3-0ecb60ef99f7",
                                        "entry_id": "16268042-99bb-30e6-a902-b1ad428c848f",
                                        "glosses": [
                                            "To roam, as a vagabond"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "vagabond",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "22714e29-0d24-31a6-9b2b-e9b5b06351bc",
                                        "entry_id": "26dfc137-ac72-3201-8ab9-8e5fb6a94052",
                                        "glosses": [
                                            "Floating about without any certain direction; driven to and fro."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e15f250d-556b-4bc0-8a9a-33cdd652cae5",
                                                "sense_id": "22714e29-0d24-31a6-9b2b-e9b5b06351bc",
                                                "text": "To heaven their prayers / Flew up, nor missed the way, by envious winds / Blown vagabond or frustrate."
                                            },
                                            {
                                                "example_id": "9505b9c8-09cd-4e66-a83a-7f3e37a4fdf3",
                                                "sense_id": "22714e29-0d24-31a6-9b2b-e9b5b06351bc",
                                                "text": "Truly, the worships of the Mystery wandered as did men, and between filchings and borrowings the gods had as vagabond a time of it as did we."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
