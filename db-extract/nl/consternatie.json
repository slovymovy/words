                "senses": [
                    {
                        "sense_id": "5541056c-3407-368c-9876-2807f99fd7b6",
                        "entry_id": "560ec12c-53cc-303a-b77d-ae8cb55ec56d",
                        "glosses": [
                            "een situatie waarin men zich geen raad meer weet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "937b77b7-9b83-48bc-9f47-7a13bc383548",
                                "sense_id": "5541056c-3407-368c-9876-2807f99fd7b6",
                                "text": "Een schokgolf van consternatie."
                            },
                            {
                                "example_id": "3d7bd634-77a6-476d-81ad-d95998448bc3",
                                "sense_id": "5541056c-3407-368c-9876-2807f99fd7b6",
                                "text": "In de consternatie van het ongeluk sloeg de zakkenroller toe."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "78a1e88b-74c4-42a2-a20f-bb24ee7e8947",
                        "source_entry_id": "560ec12c-53cc-303a-b77d-ae8cb55ec56d",
                        "source_sense_id": "5541056c-3407-368c-9876-2807f99fd7b6",
                        "source_sense_description": "een situatie waarin men zich geen raad meer weet",
                        "target_lang_word": "Bestürzung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bestürzung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "07126079-46df-359a-922b-e0093c0aee12",
                                        "entry_id": "9e484c61-dcc9-3eb5-8898-64cd94be0a75",
                                        "glosses": [
                                            "Gefühl zufolge einer unerwarteten schlechten Nachricht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4fec8d5-2549-40dd-8a9f-1240018e1627",
                                                "sense_id": "07126079-46df-359a-922b-e0093c0aee12",
                                                "text": "Mit tiefer Bestürzung geben wir das Ableben unserer Großmutter bekannt."
                                            },
                                            {
                                                "example_id": "0b649006-37bd-43db-ab1e-59f879df1975",
                                                "sense_id": "07126079-46df-359a-922b-e0093c0aee12",
                                                "text": "„Aber danach hatte sie der Frau direkt ins Gesicht und in ihre Gedanken geschaut, geübt darin, die Mimik und Gestik zu lesen, keine Bestürzung wahrgenommen oder überhaupt etwas anderes als diese normale Hausfrauenmilde.“"
                                            },
                                            {
                                                "example_id": "78cc4731-8ea6-4820-a216-b58aa94e621b",
                                                "sense_id": "07126079-46df-359a-922b-e0093c0aee12",
                                                "text": "„Ihre Bestürzung wurde so stark, daß sie das Trommeln und den Tanz der anderen unterbrechen wollte.“"
                                            },
                                            {
                                                "example_id": "90bbe320-55bb-4af8-9241-9ae2b4e2de6a",
                                                "sense_id": "07126079-46df-359a-922b-e0093c0aee12",
                                                "text": "„Die beiden wurden der Herrschaft gemeldet, und dann war es, als sei unter der Dienerschaft des Fürsten eine gewisse Verwirrung und Bestürzung entstanden.“"
                                            },
                                            {
                                                "example_id": "4cbf5f58-71b3-4da0-9bdd-d9e2fe9b9b69",
                                                "sense_id": "07126079-46df-359a-922b-e0093c0aee12",
                                                "text": "„Die unnennbare Angst des Kindes hatte die Anwesenden mit Verwunderung und Bestürzung erfüllt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "979fce14-7108-4ada-9f56-4444433faf16",
                        "source_entry_id": "560ec12c-53cc-303a-b77d-ae8cb55ec56d",
                        "source_sense_id": "5541056c-3407-368c-9876-2807f99fd7b6",
                        "source_sense_description": "een situatie waarin men zich geen raad meer weet",
                        "target_lang_word": "Fassungslosigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fassungslosigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a1cb2bfa-9af2-3b62-95c1-46eaaea50be4",
                                        "entry_id": "2739c895-f75d-3102-82f7-ce05d1a7913c",
                                        "glosses": [
                                            "Fassungslossein; Zustand, in dem jemand fassungslos ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc2c6683-9b4e-43c6-8f0b-303f46e1353c",
                                                "sense_id": "a1cb2bfa-9af2-3b62-95c1-46eaaea50be4",
                                                "text": "Manche Vorgänge in der Welt kann man nur mit Fassungslosigkeit beobachten."
                                            },
                                            {
                                                "example_id": "1fbd4f35-4574-4a66-885e-0c3ed9735a28",
                                                "sense_id": "a1cb2bfa-9af2-3b62-95c1-46eaaea50be4",
                                                "text": "„Niemand im Raum hätte auch nur im Entferntesten vermutet, dass diese Fassungslosigkeit der Furcht entsprang, sein Beschützer könne womöglich gar nicht da sein.“"
                                            },
                                            {
                                                "example_id": "24fd89ba-7049-4236-8df6-ed3760f69c20",
                                                "sense_id": "a1cb2bfa-9af2-3b62-95c1-46eaaea50be4",
                                                "text": "„Über das Gesicht den Rottenführers breitet sich Fassungslosigkeit aus, er blickt sich wie suchend um.“"
                                            },
                                            {
                                                "example_id": "bbb2d5d7-61ed-4dac-abf2-7367b2a22cc0",
                                                "sense_id": "a1cb2bfa-9af2-3b62-95c1-46eaaea50be4",
                                                "text": "„Grenfeld betrachtete Minni mit einer Mischung aus Fassungslosigkeit und Ärger.“"
                                            },
                                            {
                                                "example_id": "696261d2-0a4f-4695-967f-a53f0f691f5f",
                                                "sense_id": "a1cb2bfa-9af2-3b62-95c1-46eaaea50be4",
                                                "text": "„Noch einmal spiegelte die Stimme der Mutter die Fassungslosigkeit von damals wider.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "498472ac-49a1-4bf2-96b9-f002b732e0b7",
                        "source_entry_id": "560ec12c-53cc-303a-b77d-ae8cb55ec56d",
                        "source_sense_id": "5541056c-3407-368c-9876-2807f99fd7b6",
                        "source_sense_description": "een situatie waarin men zich geen raad meer weet",
                        "target_lang_word": "consternation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "consternation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0bfb025a-8b7b-3283-a5dd-26c765ee34b4",
                                        "entry_id": "c953c29d-b9c5-3f61-852f-825947492f3a",
                                        "glosses": [
                                            "Amazement or horror that confounds the faculties, and incapacitates for reflection; terror, combined with amazement; dismay."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "098bfb65-8e1b-4454-bae9-e14445728e4d",
                                                "sense_id": "0bfb025a-8b7b-3283-a5dd-26c765ee34b4",
                                                "text": "\"Out!\" exclaimed her husband, with something like genuine consternation in his voice."
                                            },
                                            {
                                                "example_id": "602baf81-173e-4c3e-9592-ba81593c7eac",
                                                "sense_id": "0bfb025a-8b7b-3283-a5dd-26c765ee34b4",
                                                "text": "Their audience had been listening in increasing consternation."
                                            },
                                            {
                                                "example_id": "48b24c20-55c4-46c7-89d5-0265fe6cc51c",
                                                "sense_id": "0bfb025a-8b7b-3283-a5dd-26c765ee34b4",
                                                "text": "It was probably worth four millennia of consternation and regret."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ed69f2cc-2b82-4777-b230-dc842686d49a",
                        "source_entry_id": "560ec12c-53cc-303a-b77d-ae8cb55ec56d",
                        "source_sense_id": "5541056c-3407-368c-9876-2807f99fd7b6",
                        "source_sense_description": "een situatie waarin men zich geen raad meer weet",
                        "target_lang_word": "consternation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "consternation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "af8d4691-6846-37f1-bf06-bfc41401ca3f",
                                        "entry_id": "b022619c-87e3-357d-bc22-adb3f7db5477",
                                        "glosses": [
                                            "Abattement profond à la suite de quelque accident inattendu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c104d68-03d1-4122-b35f-251562b46aa4",
                                                "sense_id": "af8d4691-6846-37f1-bf06-bfc41401ca3f",
                                                "text": "Valère regardait la planche-contact avec une certaine consternation."
                                            },
                                            {
                                                "example_id": "1bbffe2d-bba3-44a1-9e86-defe4e013b87",
                                                "sense_id": "af8d4691-6846-37f1-bf06-bfc41401ca3f",
                                                "text": "Le 10 de ce mois, un triste accident a jeté la consternation dans un des quartiers de la paroisse St.-Jacques."
                                            },
                                            {
                                                "example_id": "8d18f0ee-5f93-41f5-bfb6-275d742f87d5",
                                                "sense_id": "af8d4691-6846-37f1-bf06-bfc41401ca3f",
                                                "text": "Un soir pluvieux, Corinne laissa entendre qu'elle était amoureuse. J'allais m'en montrer consterné mais je craignis que ma consternation ne prêtât à confusion et ne fût mal interprétée : il ne fallait pas qu'elle m’imaginât épris d'elle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7745fe7b-1228-4cf0-8faa-d84365207643",
                        "source_entry_id": "560ec12c-53cc-303a-b77d-ae8cb55ec56d",
                        "source_sense_id": "5541056c-3407-368c-9876-2807f99fd7b6",
                        "source_sense_description": "een situatie waarin men zich geen raad meer weet",
                        "target_lang_word": "sidération",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sidération",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "62e4acbd-aa25-36b7-a941-6f437a20349f",
                                        "entry_id": "ae115d3a-7e2a-31f4-8013-7710318656ff",
                                        "glosses": [
                                            "Ensemble des maladies des arbres produites par la mauvaise influence des astres ; action néfaste des météores sur la végétation."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2df0e19a-4bfb-4d60-9ec7-43b6d1874845",
                                                "sense_id": "62e4acbd-aa25-36b7-a941-6f437a20349f",
                                                "text": "La sidération dépend tout entière du ciel ; par conséquent il faut ranger dans cette classe la grêle, la bruine, et les dommages causés par la gelée blanche. […]. Toutefois, ce qui est le propre de la sidération, c'est au lever de la Canicule l'ardeur et la sécheresse, qui tuent les greffes et les jeunes arbres, particulièrement le figuier et la vigne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "84d28176-6024-362a-920e-bf799fdecbe6",
                                        "entry_id": "ae115d3a-7e2a-31f4-8013-7710318656ff",
                                        "glosses": [
                                            "Influence subite attribuée à un astre, sur la vie ou la santé d’une personne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9541639-6186-4144-8a56-310bcdef21a1",
                                                "sense_id": "84d28176-6024-362a-920e-bf799fdecbe6",
                                                "text": "— Picasso ressortit à l'ordre des phénomènes, des choses visibles et qui peuvent donc être en-visagées, plutôt que con-sidérées : approchées dans un vis-à-vis où il n'y aurait pas place pour la sidération à laquelle nous contraignent les astres, les sidera."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6c08f96e-599f-321b-ae7b-d0afdae7869e",
                                        "entry_id": "ae115d3a-7e2a-31f4-8013-7710318656ff",
                                        "glosses": [
                                            "État d’anéantissement subit, produit par certaines maladies, qui semblent frapper les organes avec la promptitude de l’éclair ou de la foudre, comme l’apoplexie."
                                        ],
                                        "tags": [],
                                        "note": "Cet état était autrefois attribué à l’influence malfaisante des astres",
                                        "examples": [
                                            {
                                                "example_id": "ad5f6702-de24-4a25-8374-c9dbf2c26896",
                                                "sense_id": "6c08f96e-599f-321b-ae7b-d0afdae7869e",
                                                "text": "L'attaque foudroyante tue sur place, par une sorte de sidération, en enrayant du même coup l'action des poumons, du cœur, du diaphragme et des parois thoraciques. La catastrophe peut être plus tardive, sans être moins certaine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "22463f92-2922-31e5-8bf4-d3cc11c1be2f",
                                        "entry_id": "ae115d3a-7e2a-31f4-8013-7710318656ff",
                                        "glosses": [
                                            "Dysfonction contractile transitoire d'un muscle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7366fd58-5b72-4c92-9bcd-2b9e083883cc",
                                                "sense_id": "22463f92-2922-31e5-8bf4-d3cc11c1be2f",
                                                "text": "La dysfonction post-ischémique persistante mais réversible a d'abord été une observation expérimentale, décrite par Heybdrix et diffusée par la suite avec succès sous le nom de « sidération myocardique » par Braunwald en 1982."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0082d5cb-82ad-38a8-a8da-9e418abd7291",
                                        "entry_id": "ae115d3a-7e2a-31f4-8013-7710318656ff",
                                        "glosses": [
                                            "Profonde stupeur vécue lors d'une violence subie, particulièrement un viol ; paralysie et dissociation mentale et émotionnelle qui empêche toute compréhension, réflexion et action, et cause un trouble de stress post-traumatique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e7f3c0f-7134-41c2-84ba-71d63814ddc1",
                                                "sense_id": "0082d5cb-82ad-38a8-a8da-9e418abd7291",
                                                "text": "Le terrorisme ne date pas d'aujourd’hui […]. A diverses reprises, il avait déjà frappé le territoire des USA, mais il s’agissait, cette fois, d’un acte minutieusement préparé, d’une ampleur inégalée qui plongeait le monde et tout particulièrement les États-Unis dans un véritable état de sidération."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d7cb184b-fde0-3664-89f8-2dca63a0b6a2",
                                        "entry_id": "ae115d3a-7e2a-31f4-8013-7710318656ff",
                                        "glosses": [
                                            "État de fort étonnement."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7375a184-e1ff-42c8-898d-bb6b77ba6de4",
                                                "sense_id": "d7cb184b-fde0-3664-89f8-2dca63a0b6a2",
                                                "text": "La carte postale envoyée de Bizerte par un cousin qui y faisait son service militaire plongeait dans une sidération rêveuse."
                                            },
                                            {
                                                "example_id": "929ca56a-14d7-42b0-9dee-5f955f365216",
                                                "sense_id": "d7cb184b-fde0-3664-89f8-2dca63a0b6a2",
                                                "text": "Et j'ai éprouvé de la sidération face aux mots très forts par lesquels Ludovic exposait sa souffrance, sidération qu'il éprouve peut-être lui-même à certains moments dans sa situation."
                                            },
                                            {
                                                "example_id": "0769b06d-c698-448f-a87f-c2a5e431e519",
                                                "sense_id": "d7cb184b-fde0-3664-89f8-2dca63a0b6a2",
                                                "text": "J'avoue ma sidération face à ces gens innombrables qui, s'il faut les en croire, souffrent du peu de sens de leur existence. Ils m'évoquent les élégantes qui s'écrient, devant une garde-robe fabuleuse, qu'elles n'ont rien à se mettre."
                                            },
                                            {
                                                "example_id": "db7a2491-62be-4b97-86cf-9cc601266fe6",
                                                "sense_id": "d7cb184b-fde0-3664-89f8-2dca63a0b6a2",
                                                "text": "Devant le couple que nous formions visiblement, les regards se faisaient impudents, frôlaient la sidération, comme devant un assemblage contre nature."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1754c72b-f5a4-370a-a193-ebe5f508ee12",
                                        "entry_id": "ae115d3a-7e2a-31f4-8013-7710318656ff",
                                        "glosses": [
                                            "Procédé cultural qui introduit les légumineuses (luzerne, trèfle, sainfoin, etc) dans la rotation culturale, en culture dérobée ou en culture sous couvert."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e5ede46c-785e-4ade-bf0f-d9e243799e06",
                                                "sense_id": "1754c72b-f5a4-370a-a193-ebe5f508ee12",
                                                "text": "À l’heure qu’il est, l'agriculture paye l’azote à 1 fr. ou 1 fr. 50 le kilogr. La sidération le lui livrera-t-il à meilleur marché ? Presque tout est là. J'ai essayé la sidération dans les terres pauvres et siliceuses, non calcaires de Sologne."
                                            },
                                            {
                                                "example_id": "3e6cf6fe-27af-465e-b236-0841774dc7ab",
                                                "sense_id": "1754c72b-f5a4-370a-a193-ebe5f508ee12",
                                                "text": "Grâce à la sidération, grâce à la fixation directe par certaines plantes de l'azote atmosphérique, ces fâcheuses conditions sont retournées."
                                            }
