                        "entry_id": "93a9ba22-0b13-3198-996f-d8bc1af6455a",
                        "glosses": [
                            "Blouse qui a aussi un rôle de tablier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a423874b-82fb-4035-b765-6c9203155833",
                                "sense_id": "fd5c7ab0-8453-31dc-81a7-2fb15a391893",
                                "text": "De ses deux mains, elle serrait les pans d’un chandail de laine brune et sa blouse-tablier flottait au vent, le long de ses jambes fortes."
                            },
                            {
                                "example_id": "8e5f703a-a9f4-468b-8f77-01058ce351bf",
                                "sense_id": "fd5c7ab0-8453-31dc-81a7-2fb15a391893",
                                "text": "Lorsque j’enfile ma blouse-tablier à manches longues bleu roi, c’est comme si je devenais unique, dans mon rôle à moi : celui de l’écolière appliquée."
                            },
                            {
                                "example_id": "085b970b-dda1-4dfb-9879-bb47020d7e26",
                                "sense_id": "fd5c7ab0-8453-31dc-81a7-2fb15a391893",
                                "text": "Elle porte une blouse-tablier au motif floral bleu."
                            },
                            {
                                "example_id": "cb308fa3-9c75-4f0f-8725-ac17288b2c8e",
                                "sense_id": "fd5c7ab0-8453-31dc-81a7-2fb15a391893",
                                "text": "Chaussée de bottes en caoutchouc, coiffée d’un foulard multicolore, drapée dans une blouse-tablier, il fallait la voir poser avec maëstria, la trayeuse électrique sur le pis d’une hollandaise, ou d’une normande."
                            }
                        ]
                    }
