                    {
                        "translation_id": "3b240fb2-08d6-4c26-8482-91786060845d",
                        "source_entry_id": "344244b2-093e-36e0-ac23-bb99c6079546",
                        "source_sense_id": "9f6d7601-05f4-3264-a203-c9edb4b58f49",
                        "target_lang_word": "adembenemend",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "adembenemend",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "ac31afcc-6841-37ef-a603-36e3cb7137ef",
                                        "entry_id": "9caf1a31-5ff0-3f16-8b9e-d188980686da",
                                        "glosses": [
                                            "heel indrukwekkend, zo indrukwekkend dat je zelfs vergeet te ademen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07cb69a3-734a-4ac7-8c7d-dba439487fe8",
                                                "sense_id": "ac31afcc-6841-37ef-a603-36e3cb7137ef",
                                                "text": "De zonsondergang in de tropen is een adembenemend gezicht."
                                            },
                                            {
                                                "example_id": "a4558bec-5b3f-4e95-b044-29a7ea3b6d43",
                                                "sense_id": "ac31afcc-6841-37ef-a603-36e3cb7137ef",
                                                "text": "Het adembenemende uitzicht aan de andere kant van de berg verraste ons. Dit is hoe het paradijs eruit moet zien, dacht ik toen ik neerkeek over het beloofde land."
                                            },
                                            {
                                                "example_id": "112c9feb-8644-477d-9b5d-7413da347a13",
                                                "sense_id": "ac31afcc-6841-37ef-a603-36e3cb7137ef",
                                                "text": "Het is het adembenemende verhaal over de moord op modemagnaat Maurizio Gucci, die in 1995 in Milaan werd doodgeschoten."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
