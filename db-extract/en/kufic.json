                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kufi",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4cd40ca4-ede2-3d97-8c6e-67fa3a73512d",
                                        "entry_id": "c17f8711-45b3-34b1-8155-ef8119152130",
                                        "glosses": [
                                            "Bonnet destiné aux hommes et porté principalement en Afrique de l’Ouest, bien qu’il soit également porté parfois dans d’autres régions d’Afrique, ainsi qu’en Asie, dont l’équivalent en Afrique de l’Est est le kofia, et qui est porté à la fois par les musulmans, les chrétiens ou les juifs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "103a6e79-6afb-4847-ab44-ebc596610ecd",
                                                "sense_id": "4cd40ca4-ede2-3d97-8c6e-67fa3a73512d",
                                                "text": "Des types portant des keffiehs s'affairaient autour, avec deux autres types coiffés d'un kufi."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "kufi",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "24174ee7-9ba2-379d-83f3-abf38e456845",
