                                        "glosses": [
                                            "Construction propre et particulière à la langue grecque."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f071b0c-e2ef-4812-a1bb-7c012009b0cb",
                                                "sense_id": "479b1fc3-48d0-3aa2-a125-e284dd40c93a",
                                                "text": "C’était déjà le cas des poètes parnassiens, qui recouraient massivement aux latinismes et aux hellénismes lexicaux, syntaxiques, rhétoriques, insérés dans une forme métrique impeccablement classique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "07571046-267c-3c34-bcdd-6c17c7f5a709",
                                        "entry_id": "73f5e4f9-b23d-3472-ac02-281d0c0165ca",
                                        "glosses": [
                                            "Tour, terme, expression qui est un emprunt directement à la langue grecque en une autre langue, souvent par translittération."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "77a742a9-ee29-490b-9096-746281166fb7",
                                                "sense_id": "07571046-267c-3c34-bcdd-6c17c7f5a709",
                                                "text": "Parler de discours symbouleutique, c’est utiliser un hellénisme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6637b25-ada5-3741-9147-cd8da136fecf",
                                        "entry_id": "73f5e4f9-b23d-3472-ac02-281d0c0165ca",
                                        "glosses": [
                                            "Ensemble des idées et des mœurs de la Grèce antique."
                                        ],
