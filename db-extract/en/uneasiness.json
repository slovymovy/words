                "senses": [
                    {
                        "sense_id": "33562a17-c2b1-316a-b72f-05f1aaf1f30a",
                        "entry_id": "3b7fd118-4ca6-3047-b15c-d621dd61f359",
                        "glosses": [
                            "The state of being uneasy, nervous or restless."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "538c7062-dea4-493c-9ff4-affa8783f990",
                                "sense_id": "33562a17-c2b1-316a-b72f-05f1aaf1f30a",
                                "text": "Although the Celebrity was almost impervious to sarcasm, he was now beginning to exhibit visible signs of uneasiness, the consciousness dawning upon him that his eccentricity was not receiving the ovation it merited."
                            }
                        ]
                    },
                    {
                        "sense_id": "3df32b18-a166-3e35-8983-1a2a9cefa0f9",
                        "entry_id": "3b7fd118-4ca6-3047-b15c-d621dd61f359",
                        "glosses": [
                            "An anxious state of mind; anxiety."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "14179b4f-527d-4ff1-bf42-518bf2c024b6",
                                "sense_id": "3df32b18-a166-3e35-8983-1a2a9cefa0f9",
                                "text": "Finding that the afternoon coach was gone, and finding that his uneasiness grew into positive alarm, as obstacles came in his way, he resolved to follow in a post-chaise."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "39475eb2-82f3-44ce-83a6-b815e9d12153",
                        "source_entry_id": "3b7fd118-4ca6-3047-b15c-d621dd61f359",
                        "source_sense_description": "the state of being uneasy",
                        "target_lang_word": "Unbehagen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Unbehagen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "74d0b03a-ffdc-32b9-aae1-497662bc7c94",
                                        "entry_id": "2f9364d0-248d-3f67-ba6c-1e87b1956500",
                                        "glosses": [
                                            "Ein unbestimmtes Gefühl des Sich-Nicht-Wohlfühlens (körperlich oder seelisch)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b37ad15b-a5e9-40d2-91ee-7de599ee5699",
                                                "sense_id": "74d0b03a-ffdc-32b9-aae1-497662bc7c94",
                                                "text": "„Aber wie sollte man unfassbares Unbehagen in Worte kleiden, das sich in eine Wolke wandelte und davon wirbelte wie der Wind?“"
                                            },
                                            {
                                                "example_id": "fb9e1643-51c2-481a-b245-ecf0ac227037",
                                                "sense_id": "74d0b03a-ffdc-32b9-aae1-497662bc7c94",
                                                "text": "„Während Hearn ihre Gesichter prüfte, stellte er ein leichtes Unbehagen auf ihnen fest.“"
                                            },
                                            {
                                                "example_id": "a8d3e5a1-4164-4191-88f8-38f218d8e263",
                                                "sense_id": "74d0b03a-ffdc-32b9-aae1-497662bc7c94",
                                                "text": "„Die undurchsichtigen Vorgänge von der Levanteküste haben bei Althistorikern, Ausgräbern und Kunstgeschichtlern Unbehagen ausgelöst.“"
                                            },
                                            {
                                                "example_id": "c13a7e24-19e6-46ec-9414-f592adac85d6",
                                                "sense_id": "74d0b03a-ffdc-32b9-aae1-497662bc7c94",
                                                "text": "„Sie kehrten zurück, kletterten über die umgestürzten Eisentore und nahmen ihre Fahrräder, schüttelten das Unbehagen ab und schwangen sich auf die Sättel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c31de8c5-7875-4118-a727-fd87ac0c96f1",
                        "source_entry_id": "3b7fd118-4ca6-3047-b15c-d621dd61f359",
