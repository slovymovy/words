                    {
                        "sense_id": "edc2ffd8-5cf8-34ee-a619-aa02b91ba700",
                        "entry_id": "4f447de9-9e08-3026-b915-05d282af28ba",
                        "glosses": [
                            "een pas die een geldigheidsduur heeft van één week; een pas die toegang tot iets verleent voor de duur van één week"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5a5f56b-505b-4a6e-a850-6a27588cce58",
                                "sense_id": "edc2ffd8-5cf8-34ee-a619-aa02b91ba700",
                                "text": "Een jaarabonnement voor de Vélibfietsen kost 29 euro en een weekpas 5 euro. Voor het eerste halfuur dat de fiets langer wordt gebruikt, hoeft niets extra te worden betaald."
                            },
                            {
                                "example_id": "4d63e196-d2ee-43d2-a977-6cbed86ccb88",
                                "sense_id": "edc2ffd8-5cf8-34ee-a619-aa02b91ba700",
                                "text": "Lobbyisten die de nieuwe regels willen ontwijken kunnen dat doen door niet zo'n pas aan te vragen, maar wie regelmatig in Brussel en Straatsburg actief is zal er geen zin in hebben om steeds weer in de rij te staan voor een dag- of weekpas."
                            },
                            {
                                "example_id": "03196bfa-283a-4898-ad3c-dd02769284e4",
                                "sense_id": "edc2ffd8-5cf8-34ee-a619-aa02b91ba700",
                                "text": "*Beurs van Berlage, Damrak 243, Amsterdam. Open: zo 18 11-18u, ma-vr 11-20u, za 11-18u, zo 25 11-17u. Toegang incl. catalogus: ƒ40, ƒ60 voor twee pers., ƒ75 weekpas. Inl: 071-5724477. www.aadf.nl"
                            }
                        ]
                    }
