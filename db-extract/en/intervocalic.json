                        "entry_id": "60c6a624-7d19-39a0-b111-eff12a22b64d",
                        "glosses": [
                            "Existing or occurring between vowels."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "9159a61a-80cb-4a8d-b8cf-bf2120998f47",
                                "sense_id": "14fbadaa-9868-30fa-b630-5eee56020882",
                                "text": "For the ending -au, we need to assume the loss of an original intervocalic consonant, as Lat. -au- regularly yields -a- in Sardinian."
                            }
                        ]
                    }
                ],
                "translations": [
