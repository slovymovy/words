        "fr-extract.jsonl": [
            {
                "entry_id": "4298b730-98fd-3f09-b876-a83363e1141b",
                "word": "Calvados",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d72cda15-b091-39c6-a6c1-5659d988743f",
                        "entry_id": "4298b730-98fd-3f09-b876-a83363e1141b",
                        "glosses": [
                            "Département normand portant le numéro 14."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c5328da-b151-4a3a-a2c4-8eb5852b78dc",
                                "sense_id": "d72cda15-b091-39c6-a6c1-5659d988743f",
                                "text": "L’autopsie. Pourquoi faire ? Tous les poulets et pandores du Calvados ont déjà identifié le Vieux Marlou à son étalage de ratiches."
                            },
                            {
                                "example_id": "d5aa44c8-f0c3-4150-b881-b1961db5418c",
                                "sense_id": "d72cda15-b091-39c6-a6c1-5659d988743f",
                                "text": "Il a seulement au fond de sa poche l’adresse d'un pépiniériste, dans le Calvados, à Torgeville, où un boulot l’attend."
                            },
                            {
                                "example_id": "17cf3afa-dd8a-4a48-919c-37f30644cc77",
                                "sense_id": "d72cda15-b091-39c6-a6c1-5659d988743f",
                                "text": "Les îles Saint-Marcouf, ne l’oubliez pas, sont presque équidistantes du littoral de la Manche et de celui du Calvados, par le travers de la baie des Veys."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c9483da5-8155-4544-8cba-6d25e1ba374a",
                        "source_entry_id": "4298b730-98fd-3f09-b876-a83363e1141b",
                        "source_sense_id": "d72cda15-b091-39c6-a6c1-5659d988743f",
                        "target_lang_word": "Calvados",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Calvados",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4683782f-e15d-3a61-9669-e2bc0d6446b9",
                                        "entry_id": "28cfb2b4-2d69-3698-86f2-0cd78f269d65",
                                        "glosses": [
                                            "französischer Apfelbranntwein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32040045-5491-4930-ad10-dda7c8671d1a",
                                                "sense_id": "4683782f-e15d-3a61-9669-e2bc0d6446b9",
                                                "text": "„Noch eine Champagnerflasche wird aufgemacht, und sogar der beste Calvados kommt auf den Tisch.“"
                                            },
                                            {
                                                "example_id": "2861b0ed-d9f1-4a80-8865-85f1e4b1e310",
                                                "sense_id": "4683782f-e15d-3a61-9669-e2bc0d6446b9",
                                                "text": "„Er trank das Glas Calvados aus.“"
                                            },
                                            {
                                                "example_id": "d6a7dbe7-b3f9-44bb-a64e-65c097634d8f",
                                                "sense_id": "4683782f-e15d-3a61-9669-e2bc0d6446b9",
                                                "text": "„Sie tranken Calvados und spielten Schallpatten, und Chantal war in einer fast unglaublichen Weise anschmiegsam, sentimental und weich.“"
                                            },
                                            {
                                                "example_id": "ed3363fe-d7af-4310-8680-160655095907",
                                                "sense_id": "4683782f-e15d-3a61-9669-e2bc0d6446b9",
                                                "text": "„Dabei war er von einem halben Calvados so angeschickert, dass er bestimmt eher den Mond oder sich selbst getroffen hätte als den Laster.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
