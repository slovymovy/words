                {
                    "sense_id": "2d5bb51b-3ad5-3231-adad-935b89549e25",
                    "sense_definition": "Een informele, vlotte manier om iemand te bedanken.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "gratitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hier is de pen die je wilde lenen. — <w>Joe</w>, bedankt!",
                            "target_lang_translations": {
                                "ru": "Вот ручка, которую ты хотел одолжить. — <w>Ага</w>, спасибо!",
                                "en": "Here is the pen you wanted to borrow. — <w>Cheers</w>, thanks!",
                                "pl": "Oto długopis, który chciałeś pożyczyć. — <w>Dzięki</w>, wielkie dzięki!",
                                "de": "Hier ist der Stift, den du dir leihen wolltest. — <w>Danke</w>, danke!",
                                "fr": "Voici le stylo que tu voulais emprunter. — <w>Merci</w> !",
                                "it": "Ecco la penna che volevi in prestito. — <w>Grazie</w>!",
                                "cs": "Tady je ta propiska, co sis chtěl půjčit. — <w>Dík</w>, díky!",
                                "tr": "İşte ödünç almak istediğin kalem. — <w>Sağ ol</w>, teşekkürler!",
                                "es": "Aquí tienes el bolígrafo que querías pedir prestado. — ¡<w>Gracias</w>!",
                                "zh": "这是你要借的笔。——<w>谢了</w>！"
                            }
                        },
                        {
                            "text": "Ik heb het geld naar je overgemaakt. — <w>Joe</w>!",
                            "target_lang_translations": {
                                "ru": "Я перевел тебе деньги. — <w>Спасибо</w>!",
                                "en": "I've transferred the money to you. — <w>Thanks</w>!",
                                "pl": "Przelałem ci pieniądze. — <w>Dzięki</w>!",
                                "de": "Ich habe dir das Geld überwiesen. — <w>Danke</w>!",
                                "fr": "Je t'ai transféré l'argent. — <w>Merci</w> !",
                                "it": "Ti ho trasferito i soldi. — <w>Grazie</w>!",
                                "cs": "Poslal jsem ti ty peníze. — <w>Díky</w>!",
                                "tr": "Parayı sana gönderdim. — <w>Eyvallah</w>!",
                                "es": "Te he transferido el dinero. — ¡<w>Gracias</w>!",
                                "zh": "钱我已经转给你了。——<w>谢了</w>！"
                            }
                        }
                    ],
                    "synonyms": [
                        "bedankt",
                        "merci",
                        "dankje"
                    ],
                    "traits": [
