                                "target_senses": [
                                    {
                                        "sense_id": "04623f7f-879d-3d33-890e-298172efc60b",
                                        "entry_id": "8984d02b-6a36-30a8-ba26-b1c1cbc2f6fe",
                                        "glosses": [
                                            "Unterhäkchen unter einem Buchstaben; diakritisches Zeichen mit unterschiedlichen Funktionen in verschiedenen Sprachen"
                                        ],
                                        "tags": [
                                            "Typografie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ce530817-6a8d-43ac-9816-b935c2a2f68f",
                                                "sense_id": "04623f7f-879d-3d33-890e-298172efc60b",
                                                "text": "In dem französischen Namen »Françoise« kommt ein Buchstabe ›c‹ mit zusätzlicher Cedille vor. Die Cedille hat hier die Funktion anzuzeigen, dass es sich um den Laut [s] und nicht um ein [k] handelt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "00cd8b07-bd28-4b46-80b5-e8835a5b8c61",
                        "source_entry_id": "5ce0ee2d-6df2-30a9-a6fb-2c07f4fbe76d",
                        "source_sense_id": "b8c1b488-cf92-36e0-8821-865bcb71cb67",
                        "target_lang_word": "Zedille",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zedille",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2a95ba63-fe7b-3459-a657-1f2c45839a05",
                                        "entry_id": "9951bad1-55a0-3935-a408-5c72490a4494",
                                        "glosses": [
                                            "Unterhäkchen unter einem Buchstaben; diakritisches Zeichen mit unterschiedlichen Funktionen in verschiedenen Sprachen"
                                        ],
                                        "tags": [
                                            "outdated",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "03312a3b-d568-44fe-a2c1-7d20a08b2d37",
                                                "sense_id": "2a95ba63-fe7b-3459-a657-1f2c45839a05",
                                                "text": "„Beispiele für diakritische Zeichen sind Trema, Accent, Breve, Zedille, Betonungs- oder Tonzeichen, Ring, Caron (Hatschek), Mittelpunkt, Ogonek, Querstrich über, Schrägstrich durch, Punkt über/unter, Querstrich in halber Höhe durch den Buchstaben.“"
                                            },
                                            {
                                                "example_id": "82bb6d2b-40a7-42ce-a2c3-316502526526",
                                                "sense_id": "2a95ba63-fe7b-3459-a657-1f2c45839a05",
                                                "text": "„Folgende Liste zeigt, mit welcher Taste ein diakritisches Zeichen erzeugt wird: […] , (Komma) ⇒ ein Buchstabe mit Zedille (Çç) […]“"
                                            },
                                            {
                                                "example_id": "ea67d524-3f7e-4085-afe7-d41328c31193",
                                                "sense_id": "2a95ba63-fe7b-3459-a657-1f2c45839a05",
                                                "text": "„Sonst bemerke ich noch zur Schreibung daß die Zedillen unter dem c bereits in der Handschrift gesetzt sind.“"
                                            },
                                            {
                                                "example_id": "2c0937d3-d388-42e5-9720-da5659ab260e",
                                                "sense_id": "2a95ba63-fe7b-3459-a657-1f2c45839a05",
                                                "text": "„Zuweilen ist die Titelkopie auch übertrieben, so bei Nr. 582 Zeile 8 ein Punkt unter dem us-Zeichen oder Nr. 604 Zeile 5 ein e mit Zedille.“"
                                            },
                                            {
                                                "example_id": "ccc68469-26de-497a-93a3-d9b5f2658e42",
                                                "sense_id": "2a95ba63-fe7b-3459-a657-1f2c45839a05",
                                                "text": "„[E]r setzt zwar moderne Interpunktion und Apostrophe (diese sogar in den Varianten), vermeidet aber den Gebrauch des Akzentes auf betontem auslautendem e, die Setzung der Zedille, die Regelung von i und j, u und v in modernem Sinne.“"
                                            },
                                            {
                                                "example_id": "b46e560d-c817-433d-b8f7-9e72d27bba0a",
                                                "sense_id": "2a95ba63-fe7b-3459-a657-1f2c45839a05",
                                                "text": "„Die Zedille ist wegen eines Fleckens im Papier der Handschrift nicht sicher zu erkennen.“"
                                            },
                                            {
                                                "example_id": "3b2e024f-e598-4c6b-ad62-701dceb59380",
                                                "sense_id": "2a95ba63-fe7b-3459-a657-1f2c45839a05",
                                                "text": "„Die Verben auf çar verlieren die Zedille vor e.“"
                                            },
                                            {
                                                "example_id": "a1ffd0ee-18f6-475d-b034-85d7790c3205",
                                                "sense_id": "2a95ba63-fe7b-3459-a657-1f2c45839a05",
                                                "text": "„Das Alphabet kennt weiterhin ö Ö mit Trema wie bei köle (Sklave), ğ Ğ mit Breve wie bei ağaç (Baum), ç Ç mit Zedille wie bei ağaç (Abbildung 28).“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
