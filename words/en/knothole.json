                {
                    "sense_id": "b7566f8e-1ab9-3b20-8910-54efac480e86",
                    "sense_definition": "A hole in a piece of wood left where a knot has fallen out.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "wood_feature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The child tried to <w>peek</w> through the <w>knothole</w> in the wooden fence.",
                            "target_lang_translations": {
                                "ru": "Ребенок пытался подсмотреть через <w>дыру от сучка</w> в деревянном заборе."
                            }
                        },
                        {
                            "text": "A small bird flew out of the <w>knothole</w> in the old oak tree.",
                            "target_lang_translations": {
                                "ru": "Маленькая птичка вылетела из <w>дупла</w> в старом дубе."
                            }
                        }
                    ],
