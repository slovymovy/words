                ],
                "senses": [
                    {
                        "sense_id": "18eb40e7-fdb7-3972-85a9-60585a90cfb2",
                        "entry_id": "9300110f-526c-3bcd-8650-95ae4eb61963",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fdad42d3-4cea-4f8c-adae-e401a462a271",
                                "sense_id": "18eb40e7-fdb7-3972-85a9-60585a90cfb2",
                                "text": "Frau Rüble ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "78b5c716-4d9c-4413-88bf-48277cd5ba56",
                                "sense_id": "18eb40e7-fdb7-3972-85a9-60585a90cfb2",
                                "text": "Herr Rüble wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "6f42f93b-bf05-4250-ac31-ac2bbf3d13b6",
                                "sense_id": "18eb40e7-fdb7-3972-85a9-60585a90cfb2",
                                "text": "Die Rübles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "514a82bc-0df8-41ba-bbd6-1d0788534faa",
                                "sense_id": "18eb40e7-fdb7-3972-85a9-60585a90cfb2",
                                "text": "Der Rüble trägt nie die Pullover, die die Rüble ihm strickt."
                            },
                            {
                                "example_id": "c62f9d38-3695-4765-aacb-304bc56c403b",
                                "sense_id": "18eb40e7-fdb7-3972-85a9-60585a90cfb2",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Rüble kommt, geht der Herr Rüble.“"
                            },
                            {
                                "example_id": "17b63309-b784-4ac5-b793-4dcb73c80b8f",
                                "sense_id": "18eb40e7-fdb7-3972-85a9-60585a90cfb2",
                                "text": "Rüble kommt und geht."
                            },
                            {
                                "example_id": "d7feb423-90c2-4dd5-a3ca-0328b2a88ff4",
                                "sense_id": "18eb40e7-fdb7-3972-85a9-60585a90cfb2",
                                "text": "Rübles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
