{
    "word_family": [
        "выход",
        "выходной",
        "выходка",
        "выходчик"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3b70a9fe-1607-3ab7-b966-cd018666edad",
                    "sense_definition": "покидать какое-либо место, идя пешком",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Когда я <w>выходил</w> из магазина, туда прошёл странный человек.",
                            "target_lang_translations": {
                                "en": "As I was <w>going out</w> of the shop, a strange man walked in."
                            }
                        },
                        {
                            "text": "Нам нужно <w>выходить</w> из дома прямо сейчас, чтобы не опоздать.",
                            "target_lang_translations": {
                                "en": "We need to <w>go out</w> of the house right now so we don't be late."
                            }
                        }
                    ],
                    "antonyms": [
                        "входить"
                    ],
                    "common_phrases": [
                        "выходить из дома",
                        "выходить из магазина"
                    ],
                    "target_lang_definitions": {
                        "en": "To leave a place by walking."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "go out",
                                "target_lang_sense_clarification": "To leave a building or room."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e37de74f-831f-3fb6-9ee1-56eff51b35de",
                    "sense_definition": "публиковаться или появляться в печати",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "publishing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Эта газета <w>выходит</w> ежедневно по утрам.",
                            "target_lang_translations": {
                                "en": "This newspaper <w>comes out</w> daily in the mornings."
                            }
                        },
                        {
                            "text": "Новая книга известного автора <w>выходит</w> в следующем месяце.",
                            "target_lang_translations": {
                                "en": "The famous author's new book <w>comes out</w> next month."
                            }
                        }
                    ],
                    "synonyms": [
                        "издаваться"
                    ],
                    "common_phrases": [
                        "газета выходит"
                    ],
                    "target_lang_definitions": {
                        "en": "To be published, released, or made available to the public."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "come out",
                                "target_lang_sense_clarification": "To be published or released for the first time."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "25bc07c9-7cb9-368f-bb04-a3b441759786",
                    "sense_definition": "вступать в брак (о женщине)",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "marriage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Она решила <w>выходить</w> замуж за своего лучшего друга.",
                            "target_lang_translations": {
                                "en": "She decided to <w>get married</w> to her best friend."
                            }
                        },
                        {
                            "text": "Моя сестра <w>выходит</w> замуж в эту субботу.",
                            "target_lang_translations": {
                                "en": "My sister is <w>getting married</w> this Saturday."
                            }
                        }
                    ],
                    "synonyms": [
                        "вступать в брак"
                    ],
                    "antonyms": [
                        "разводиться"
                    ],
                    "common_phrases": [
                        "выходить замуж"
                    ],
                    "target_lang_definitions": {
                        "en": "To get married (specifically for a woman)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "get married",
                                "target_lang_sense_clarification": "To enter into a marriage."
                            },
                            {
                                "target_lang_word": "marry",
                                "target_lang_sense_clarification": "To become the husband or wife of someone."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f4b778be-a588-3312-8046-a7fecaea95ff",
                    "sense_definition": "иметь какой-либо результат, получаться",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "result",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "У нас всё <w>выходит</w> именно так, как мы планировали.",
                            "target_lang_translations": {
                                "en": "Everything is <w>turning out</w> exactly as we planned."
                            }
                        },
                        {
                            "text": "Из этого проекта ничего хорошего не <w>выходит</w>.",
                            "target_lang_translations": {
                                "en": "Nothing good is <w>working out</w> from this project."
                            }
                        }
                    ],
                    "synonyms": [
                        "удаваться"
                    ],
                    "target_lang_definitions": {
                        "en": "To have a specific result or outcome."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "turn out",
                                "target_lang_sense_clarification": "To result in a particular way."
                            },
                            {
                                "target_lang_word": "work out",
                                "target_lang_sense_clarification": "To develop or result in a specific way."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a715e0c9-9dc9-3926-93ea-61db09f0111c",
                    "sense_definition": "вырастить кого-либо с заботой и уходом",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "rearing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Бабушка <w>выходила</w> меня, когда я был совсем маленьким.",
                            "target_lang_translations": {
                                "en": "My grandmother <w>nursed me back to health</w> when I was very small."
                            }
                        },
                        {
                            "text": "Она <w>выходила</w> всех своих детей в трудные времена.",
                            "target_lang_translations": {
                                "en": "She <w>raised</w> all her children through difficult times."
                            }
                        }
                    ],
                    "synonyms": [
                        "вырастить",
                        "воспитать",
                        "вскормить"
                    ],
                    "antonyms": [
                        "загубить"
                    ],
                    "target_lang_definitions": {
                        "en": "To nurse someone back to health or raise them with care."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "nurse back to health",
                                "target_lang_sense_clarification": "To care for someone until they recover."
                            },
                            {
                                "target_lang_word": "raise",
                                "target_lang_sense_clarification": "To bring up a child with care."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}