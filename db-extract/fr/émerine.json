                    {
                        "sense_id": "36c36b37-8c39-3083-9db0-ee97857ab434",
                        "entry_id": "13f41402-2a0d-37f4-84f3-63407efd95db",
                        "glosses": [
                            "Prénom féminin français."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75a8698c-d425-4a8b-8954-8397b6f4f8e4",
                                "sense_id": "36c36b37-8c39-3083-9db0-ee97857ab434",
                                "text": "Le parquet de Lille ordonne l’autopsie du cadavre de Mme Émerine Watteau, blanchisseuse, à Wasquehal, qui avait été tamponnée, dimanche, près du parc Barbieux, par l’auto d’un industriel et qui est morte dans une clinique."
                            },
                            {
                                "example_id": "aeb6b8ef-cd6f-4322-b394-6eb9c711c0e5",
                                "sense_id": "36c36b37-8c39-3083-9db0-ee97857ab434",
                                "text": "Alors, et sur le conseil de sa femme Émerine (uxoris suæ nomine Émerinæ), il fonda le couvent de Saint-Orens et lui donna diverse terres qu’il me serait impossible d’identifier pour la plupart."
                            }
                        ]
                    }
                ],
