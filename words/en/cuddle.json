{
    "word_family": [
        "cuddly",
        "cuddler",
        "cuddlesome"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e74831ed-5786-386e-9212-286382e48daf",
                    "sense_definition": "To hold someone close in one's arms as a way of showing love or affection.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "affectionate_embrace",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mother decided to <w>cuddle</w> her crying child to make him feel safe.",
                            "target_lang_translations": {
                                "ru": "Мать решила <w>прижать к себе</w> плачущего ребенка, чтобы он почувствовал себя в безопасности."
                            }
                        },
                        {
                            "text": "They like to <w>cuddle</w> on the sofa while watching their favorite movies.",
                            "target_lang_translations": {
                                "ru": "Им нравится <w>обниматься</w> на диване за просмотром любимых фильмов."
                            }
                        }
                    ],
                    "synonyms": [
                        "hug",
                        "snuggle",
                        "embrace"
                    ],
                    "common_phrases": [
                        "cuddle on the sofa",
                        "cuddle up together"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обнимать кого-либо, проявляя любовь или нежность."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обнимать",
                                "target_lang_sense_clarification": "проявлять нежность"
                            },
                            {
                                "target_lang_word": "прижимать к себе",
                                "target_lang_sense_clarification": "ласково"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6ae5c929-3bf5-394c-9b0d-09438bac686a",
                    "sense_definition": "To lie or sit close together in a snug and intimate way.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "affectionate_embrace",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young lovers <w>cuddled</w> on the couch for hours during the cold winter evening.",
                            "target_lang_translations": {
                                "ru": "Молодые влюбленные часами <w>обнимались</w> на кушетке холодным зимним вечером."
                            }
                        },
                        {
                            "text": "It was so cold that we had to <w>cuddle</w> under the blanket to stay warm.",
                            "target_lang_translations": {
                                "ru": "Было так холодно, что нам пришлось <w>прижаться друг к другу</w> под одеялом, чтобы согреться."
                            }
                        }
                    ],
                    "synonyms": [
                        "snuggle",
                        "nestle",
                        "nuzzle"
                    ],
                    "common_phrases": [
                        "cuddle under a blanket",
                        "cuddle in bed"
                    ],
                    "target_lang_definitions": {
                        "ru": "Лежать или сидеть вплотную друг к другу в уютной и интимной обстановке."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обниматься",
                                "target_lang_sense_clarification": "сидя или лежа вместе"
                            },
                            {
                                "target_lang_word": "прижиматься друг к другу",
                                "target_lang_sense_clarification": "чтобы согреться или проявить близость"
                            },
                            {
                                "target_lang_word": "прильнуть",
                                "target_lang_sense_clarification": "тесно прижаться"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "43e2b4de-73f5-39c3-873e-e97f141ee041",
                    "sense_definition": "To hold a baby or small child gently in one's arms to provide comfort or warmth.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "caregiving",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>cuddled</w> the infant before bedtime until the baby finally fell asleep.",
                            "target_lang_translations": {
                                "ru": "Она <w>нянчила</w> младенца перед сном, пока тот наконец не уснул."
                            }
                        },
                        {
                            "text": "The nurse would <w>cuddle</w> the newborn to soothe it after the checkup.",
                            "target_lang_translations": {
                                "ru": "Медсестра <w>прижимала</w> новорожденного, чтобы успокоить его после осмотра."
                            }
                        }
                    ],
                    "synonyms": [
                        "cradle",
                        "nuzzle"
                    ],
                    "common_phrases": [
                        "cuddle a baby"
                    ],
                    "target_lang_definitions": {
                        "ru": "Осторожно держать младенца или маленького ребенка на руках, чтобы успокоить или согреть."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нянчить",
                                "target_lang_sense_clarification": "ласково прижимая"
                            },
                            {
                                "target_lang_word": "прижимать",
                                "target_lang_sense_clarification": "ребенка для утешения"
                            },
                            {
                                "target_lang_word": "тискать",
                                "target_lang_sense_clarification": "разг., любя"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "428c1757-0833-3891-a197-34e0587bc769",
                    "sense_definition": "To lie close or snug against something, or to crouch down low.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "positioning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The frightened animal tried to <w>cuddle</w> low behind the bushes to avoid being seen.",
                            "target_lang_translations": {
                                "ru": "Испуганное животное пыталось <w>прижаться</w> пониже к земле за кустами, чтобы его не заметили."
                            }
                        },
                        {
                            "text": "She <w>cuddles</w> low in the grass, hoping the hikers will pass by without noticing her.",
                            "target_lang_translations": {
                                "ru": "Она <w>пригибается</w> низко в траве, надеясь, что туристы пройдут мимо, не заметив её."
                            }
                        }
                    ],
                    "synonyms": [
                        "nestle",
                        "crouch"
                    ],
                    "common_phrases": [
                        "cuddle low"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "literary usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Плотно прилегать к чему-либо или низко пригибаться к земле."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прижиматься",
                                "target_lang_sense_clarification": "к земле или поверхности"
                            },
                            {
                                "target_lang_word": "жаться",
                                "target_lang_sense_clarification": "стараясь стать незаметным"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d67b74fa-34f2-38c4-a78d-e5bbfc59af34",
                    "sense_definition": "A brief, affectionate hug given to a friend or family member.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_affection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Give me a <w>cuddle</w> before you leave for school today.",
                            "target_lang_translations": {
                                "ru": "Дай я тебя <w>обниму</w>, прежде чем ты уйдешь сегодня в школу."
                            }
                        },
                        {
                            "text": "A quick <w>cuddle</w> from his daughter always made him feel much better.",
                            "target_lang_translations": {
                                "ru": "Быстрое <w>объятие</w> дочери всегда заставляло его чувствовать себя намного лучше."
                            }
                        }
                    ],
                    "synonyms": [
                        "hug",
                        "embrace"
                    ],
                    "common_phrases": [
                        "give a cuddle",
                        "quick cuddle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Короткое ласковое объятие друга или члена семьи."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "объятие",
                                "target_lang_sense_clarification": "дружеское или родственное"
                            },
                            {
                                "target_lang_word": "обнимашки",
                                "target_lang_sense_clarification": "разг., милое проявление чувств"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "718c6d58-fc54-3103-8b56-42124dfbacfd",
                    "sense_definition": "A long, intimate period of holding someone close, usually while sitting or lying down.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_affection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After a long day at work, all she wanted was a long <w>cuddle</w> with her partner.",
                            "target_lang_translations": {
                                "ru": "После долгого рабочего дня всё, чего ей хотелось, — это долгих <w>обниманий</w> со своим партнером."
                            }
                        },
                        {
                            "text": "They shared a morning <w>cuddle</w> in bed before starting their busy weekend.",
                            "target_lang_translations": {
                                "ru": "Они устроили утренние <w>нежности</w> в постели, прежде чем начать насыщенные выходные."
                            }
                        }
                    ],
                    "synonyms": [
                        "snuggle"
                    ],
                    "common_phrases": [
                        "morning cuddle",
                        "long cuddle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Долгое и интимное времяпрепровождение в объятиях, обычно сидя или лежа."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обнимания",
                                "target_lang_sense_clarification": "процесс"
                            },
                            {
                                "target_lang_word": "нежности",
                                "target_lang_sense_clarification": "физическое проявление близости"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}