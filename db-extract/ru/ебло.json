                "senses": [
                    {
                        "sense_id": "825aa7fe-d65b-3ba6-a36d-ac07c5855742",
                        "entry_id": "11ef5392-dfce-3a6c-8d6e-b1881b302693",
                        "glosses": [
                            "обсц. рот"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3ff1464-a1a7-4b6a-aa7a-4214093efd6d",
                                "sense_id": "825aa7fe-d65b-3ba6-a36d-ac07c5855742",
                                "text": "— Пастер наш! — Ебло закрой! — всполошился и Михалыч."
                            }
                        ]
                    },
                    {
                        "sense_id": "a66870b8-e1de-38b0-99d9-f9978a35cd00",
                        "entry_id": "11ef5392-dfce-3a6c-8d6e-b1881b302693",
                        "glosses": [
                            "обсц. лицо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5691e4ff-d5ee-4ca6-ba3d-28469036f465",
                                "sense_id": "a66870b8-e1de-38b0-99d9-f9978a35cd00",
                                "text": "Кто первый стал говорить с бумажкой перед еблом?"
                            },
                            {
                                "example_id": "1f482fc3-732f-4a56-aeb0-57ae2c156000",
                                "sense_id": "a66870b8-e1de-38b0-99d9-f9978a35cd00",
                                "text": "Дима бухает каждый день и уже стал похож на бича: морда — красная, ебло опухшее, волосы — грязные и со струпьями перхоти."
                            }
                        ]
                    }
