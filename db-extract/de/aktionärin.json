                        ]
                    },
                    {
                        "translation_id": "35309d66-ad0a-402f-a373-6961312eeada",
                        "source_entry_id": "ce9793f5-b17e-3440-98c6-e7f384f8ad79",
                        "source_sense_id": "738fce6c-1f07-3aa6-b0be-b32240f2397c",
                        "source_sense_description": "Inhaberin von Aktien",
                        "target_lang_word": "actionnaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "actionnaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "80eb4d2d-d3fd-3889-aa8e-300d38f5c27a",
                                        "entry_id": "2c7372a0-73f2-3a08-aefe-96f2836886fe",
                                        "glosses": [
                                            "Propriétaire d’actions dans une société commerciale ou civile."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d3c40e0-0c84-4513-b2d3-c472463f3ba7",
                                                "sense_id": "80eb4d2d-d3fd-3889-aa8e-300d38f5c27a",
                                                "text": "Chez les actionnaires, certains se sont saisis du sujet."
                                            },
                                            {
                                                "example_id": "b0df787e-294b-4547-9401-9f875e22afe4",
                                                "sense_id": "80eb4d2d-d3fd-3889-aa8e-300d38f5c27a",
                                                "text": "Total peut se sentir visé. Il réalise près de 90 % de ses opérations de financement à travers des banques américaines, et 30 % de son actionnariat provient des États-Unis : avec 6,3 % des titres, la multinationale de gestion d’actifs BlackRock, contrôlée par M. Laurence D. Fink, est même sa première actionnaire."
                                            },
                                            {
                                                "example_id": "96bebc15-dd84-4157-bbc7-bc9a4e86e2fc",
                                                "sense_id": "80eb4d2d-d3fd-3889-aa8e-300d38f5c27a",
                                                "text": "Les actionnaires de la Banque de France. — Les actionnaires d’un chemin de fer, d’un canal, d’un théâtre. — L’assemblée des actionnaires."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
