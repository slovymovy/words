                        "glosses": [
                            "Débarrasser, défaire de ce qui occupait."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a63d3047-bd3c-4acf-a3e3-cf1208679269",
                                "sense_id": "04ebe274-596a-3a58-93c5-e08982c9f4b8",
                                "text": "Dieu entraîne l’âme et la désoccupe d'elle-même en l’occupant de lui"
                            }
                        ]
                    },
                    {
                        "sense_id": "26733380-a690-3391-bb6d-5d20f3f5c7fe",
                        "entry_id": "5c75b96f-75bb-3abd-acc2-9f121edfe41a",
                        "glosses": [
                            "Cesser de s’occuper."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "b48c4a60-5f03-4e80-b24e-9c2ef6668d1c",
                                "sense_id": "26733380-a690-3391-bb6d-5d20f3f5c7fe",
                                "text": "Son principal soin était de se désoccuper"
                            },
                            {
                                "example_id": "e5426bfd-5e1a-4a11-aad4-30f0a654fe40",
                                "sense_id": "26733380-a690-3391-bb6d-5d20f3f5c7fe",
                                "text": "Ils s’appliquaient avec toute leur attention à ce qu’ils devaient à Dieu, et se désoccupaient de tout autre soin"
                            }
                        ]
