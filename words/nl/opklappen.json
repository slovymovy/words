    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2402674a-11c6-35cf-ae84-65d1631d360b",
                    "sense_definition": "iets door middel van een scharnier of draaibeweging naar boven of opzij bewegen om het te openen of ruimte te maken",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "vouwen_en_draaien",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je kunt de zitting van de stoel eenvoudig <w>opklappen</w> om meer ruimte te maken in de kamer.",
                            "target_lang_translations": {
                                "en": "You can easily <w>fold up</w> the seat of the chair to create more space in the room."
                            }
                        },
                        {
                            "text": "Vergeet niet de tafel weer te <w>opklappen</w> nadat je klaar bent met eten.",
                            "target_lang_translations": {
                                "en": "Don't forget to <w>fold up</w> the table again after you've finished eating."
                            }
                        }
                    ],
                    "synonyms": [
                        "openslaan",
                        "omslaan",
                        "wegdraaien"
                    ],
                    "antonyms": [
                        "neerklappen"
                    ],
                    "common_phrases": [
                        "tafel opklappen",
                        "zitting opklappen",
                        "scherm opklappen"
                    ],
                    "target_lang_definitions": {
                        "en": "to move something upwards or sideways by means of a hinge or rotating motion to open it or create space"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "fold up",
                                "target_lang_sense_clarification": "to make more compact by folding"
                            },
                            {
                                "target_lang_word": "raise",
                                "target_lang_sense_clarification": "to lift or elevate, such as an armrest or seat"
                            },
                            {
                                "target_lang_word": "swing up",
                                "target_lang_sense_clarification": "to move upwards on a hinge"
                            },
                            {
                                "target_lang_word": "flip up",
                                "target_lang_sense_clarification": "to move something up quickly with a hinge"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9bb4c1a4-6260-3256-85ed-c358105a040c",
                    "sense_definition": "met grote kracht en lawaai tegen iets aan botsen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "botsing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De auto raakte uit de bocht en we zagen hem met hoge snelheid tegen de vangrail <w>opklappen</w>.",
                            "target_lang_translations": {
                                "en": "The car spun out of the corner and we saw it <w>crash into</w> the guardrail at high speed."
                            }
                        },
                        {
                            "text": "Tijdens het spelen kunnen honden soms per ongeluk hard tegen de toeschouwers <w>opklappen</w>.",
                            "target_lang_translations": {
                                "en": "While playing, dogs can sometimes accidentally <w>slam into</w> the spectators hard."
                            }
                        }
                    ],
                    "synonyms": [
                        "botsen"
                    ],
                    "common_phrases": [
                        "tegen iets opklappen"
                    ],
                    "target_lang_definitions": {
                        "en": "to collide with something with great force and noise"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "crash into",
                                "target_lang_sense_clarification": "to collide violently"
                            },
                            {
                                "target_lang_word": "smash into",
                                "target_lang_sense_clarification": "to hit with great force"
                            },
                            {
                                "target_lang_word": "slam into",
                                "target_lang_sense_clarification": "to hit something hard and noisily"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c49f27ad-48a4-3d55-9e93-2a9f6ca2d2f2",
                    "sense_definition": "met veel inzet en fysieke kracht de strijd aangaan, vaak in een sportieve context",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "strijd",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De coach eiste dat de spelers er vanaf de eerste minuut vol op zouden <w>opklappen</w>.",
                            "target_lang_translations": {
                                "en": "The coach demanded that the players <w>get stuck in</w> fully from the very first minute."
                            }
                        },
                        {
                            "text": "Als we willen winnen, moeten we meteen op de tegenstander <w>opklappen</w> en geen ruimte geven.",
                            "target_lang_translations": {
                                "en": "If we want to win, we must <w>tackle</w> the opponent hard immediately and give them no space."
                            }
                        }
                    ],
                    "common_phrases": [
                        "er bovenop klappen",
                        "vol opklappen"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Vaak gebruikt in sporttaal"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to engage in a struggle with a lot of effort and physical strength, often in a sporting context"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "get stuck in",
                                "target_lang_sense_clarification": "to start doing something with energy and determination"
                            },
                            {
                                "target_lang_word": "tackle hard",
                                "target_lang_sense_clarification": "to engage physically with intensity"
                            },
                            {
                                "target_lang_word": "go all out",
                                "target_lang_sense_clarification": "to use all available energy and effort"
                            }
                        ]
                    }
                }
            ]
        }
    ]
