                        "glosses": [
                            "weibliche Person, die mit einem Maschinengewehr (MG) schießt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71c0946a-3686-45e4-b00b-28152c1820af",
                                "sense_id": "93c19d1b-446e-3e1d-b1a2-86beebbd5f6d",
                                "text": "„Die Haupthelden des Films – Tschapajew, sein Adjutant Petka und die MG-Schützin Anna – sind Gegenstand zahlreicher Anekdoten.“"
                            },
                            {
                                "example_id": "1afd6593-c250-47ea-937e-ee822a283904",
                                "sense_id": "93c19d1b-446e-3e1d-b1a2-86beebbd5f6d",
                                "text": "„1942 bildete der Komsomol Frauen als MG-Schützinnen aus, 7.800 davon für leichte MG und 4.500 für schwere MG.“"
                            },
                            {
                                "example_id": "11044597-088f-4d95-9788-660075cd143e",
                                "sense_id": "93c19d1b-446e-3e1d-b1a2-86beebbd5f6d",
                                "text": "„Als MG-Schützin kam sie zur 21. Gardeschützen-Division und an die Front.“"
                            }
                        ],
