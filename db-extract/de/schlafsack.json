                    {
                        "form_id": "facd6ff3-4e8e-4c2d-af4c-3e08650673aa",
                        "entry_id": "bb7a1236-d9c2-39b7-a4e7-cb2312c1460e",
                        "tags": [
                            "accusative",
                            "plural"
