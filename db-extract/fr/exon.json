                        "entry_id": "0f561647-d58d-3797-9494-76d8dbbc3ae1",
                        "glosses": [
                            "Segment d’un transcrit primaire conservé après l’épissage de l’ARN."
                        ],
                        "tags": [
                            "Génétique"
                        ],
                        "examples": [
