                                        "entry_id": "92b8fb40-d778-3cb9-ab8a-c582d1feeb7e",
                                        "glosses": [
                                            "A wandering homeless person, especially (historical) one illegally travelling by rail or (derogatory) a penniless, unemployed bum."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1375c58b-b390-4087-bb3f-07b6ad92a67d",
                                                "sense_id": "808699cc-0a25-3453-b4fe-4c2f25be4584",
                                                "text": "He’d heard the word hobo used for travelers, heard it was short for homeward bound, or homeless boy, or Hoboken having something to do with New Jersey."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "879abed4-1822-3f53-b0a0-4bdd5affb17a",
                                        "entry_id": "92b8fb40-d778-3cb9-ab8a-c582d1feeb7e",
                                        "glosses": [
                                            "Any migratory laborer, whether homeless or not."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5fc76834-1365-349e-8319-8e65f9a0775d",
                                        "entry_id": "92b8fb40-d778-3cb9-ab8a-c582d1feeb7e",
                                        "glosses": [
                                            "A kind of large handbag."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fad043d0-9502-440e-96ae-6e7c87eb97f0",
                                                "sense_id": "5fc76834-1365-349e-8319-8e65f9a0775d",
                                                "text": "Avoid bulky styles such as duffle sacks, buckets, doctors' satchels, and hobos."
                                            }
                                        ]
                                    }
                                ]
