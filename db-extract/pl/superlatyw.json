                                    {
                                        "sense_id": "4f5997ae-8bb3-3b15-9544-47cc2832691a",
                                        "entry_id": "f7e341a3-7014-3580-8ff1-5e600fd334c3",
                                        "glosses": [
                                            "overtreffende trap (van een bijvoeglijk naamwoord)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed494533-e141-4cfc-b27a-43d38d7e02d7",
                                                "sense_id": "4f5997ae-8bb3-3b15-9544-47cc2832691a",
                                                "text": "De superlatief van zwaar is zwaarst."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cc5cd603-e89f-4e4d-8608-386dadb16b6a",
                        "source_entry_id": "bde55159-8b21-3320-8199-08b1bad6714d",
                        "source_sense_id": "7ccead39-3762-37be-ab80-3dbb37c95f18",
                        "target_lang_word": "Superlativ",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Superlativ",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dec50a51-2ead-3259-a22c-78609b81f0b1",
                                        "entry_id": "c7e8995e-d7a6-3a68-bc4a-0143fd2e45fc",
                                        "glosses": [
                                            "höchste Stufe der Steigerung der Adjektive und einiger Adverbien"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8b02c48-8d06-4809-8eb5-f168a12c0c42",
                                                "sense_id": "dec50a51-2ead-3259-a22c-78609b81f0b1",
                                                "text": "In „Hans ist der größte Junge in seiner Klasse“ steht das Adjektiv „größte“ im Superlativ."
                                            },
                                            {
                                                "example_id": "ee1a623a-0c44-4ad7-9390-3e6a92e50d6c",
                                                "sense_id": "dec50a51-2ead-3259-a22c-78609b81f0b1",
                                                "text": "„In Vergleichskonstruktionen drückt der Superlativ den höchsten Grad aus:…“"
                                            },
                                            {
                                                "example_id": "75d9be6d-7e56-433e-a99f-7a6b1b41b205",
                                                "sense_id": "dec50a51-2ead-3259-a22c-78609b81f0b1",
                                                "text": "„Bei den Adjektiven sind die verschiedenen Steigerungsformen zu beachten: der Positiv (die Normalform), der Komparativ (die Steigerungsform) und der Superlativ (die Höchststufe, die außerhalb von Vergleichen Elativ genannt wird).“"
                                            },
                                            {
                                                "example_id": "91ed2bb5-2a2b-44f0-bf12-9f4bd8520cf6",
                                                "sense_id": "dec50a51-2ead-3259-a22c-78609b81f0b1",
                                                "text": "„Als die Alten in Wahrheit noch nicht alt wurden, machte man die Ältesten, also den Superlativ des Alten, zu Häuptlingen: zum Dorfältesten, zum Stammesältesten.“"
                                            },
                                            {
                                                "example_id": "f408340a-2ca1-44ab-96ce-ce6a27854e50",
                                                "sense_id": "dec50a51-2ead-3259-a22c-78609b81f0b1",
                                                "text": "„Sprachlich drückt sich dieses Bessersein in der gehäuften Verwendung des Komparativs aus, manchmal gar des Superlativs.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0e596c41-8502-3071-a11f-88c27b0a32a2",
                                        "entry_id": "c7e8995e-d7a6-3a68-bc4a-0143fd2e45fc",
                                        "glosses": [
                                            "etwas nicht Überbietbares"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b7828a63-1907-4f14-9c13-5c4f18e4d444",
                                                "sense_id": "0e596c41-8502-3071-a11f-88c27b0a32a2",
                                                "text": "„Für die Teilnehmer und Teilnehmerinnen war die Reise in diese Stadt der Superlative eine interessante Erfahrung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
