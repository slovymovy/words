                "senses": [
                    {
                        "sense_id": "93974eab-e396-3cb8-9b3b-3d3c23d62ad8",
                        "entry_id": "2b965b20-066d-3393-8960-454323eb481b",
                        "glosses": [
                            "Teich, dessen Wasser aus einer Quelle am Grund oder am Rand des Teiches stammt"
                        ],
                        "tags": [
                            "Hydrologie"
                        ],
                        "examples": [
                            {
                                "example_id": "cc2d0769-fba1-4046-ac65-39e2992cb4da",
                                "sense_id": "93974eab-e396-3cb8-9b3b-3d3c23d62ad8",
                                "text": "„Bei den Teichquellen liegt der Quellmund am Grund einer mehr oder weniger tiefen Mulde des Quellteiches, über dessen Rand der Quellbach abfließt.“"
                            },
                            {
                                "example_id": "909abe3d-8500-4656-8035-0ed56291e558",
                                "sense_id": "93974eab-e396-3cb8-9b3b-3d3c23d62ad8",
                                "text": "„Sind Quelle oder Quellteich künstlich überbaut oder eingefasst, so spricht man von einer Quellfassung.“"
                            },
                            {
                                "example_id": "69f97337-d478-458d-937a-3a405b64d2e7",
                                "sense_id": "93974eab-e396-3cb8-9b3b-3d3c23d62ad8",
                                "text": "„In einem Quellteich, der von einem großen Sumpf umgeben ist, perlt langsam das Quellwasser empor.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
