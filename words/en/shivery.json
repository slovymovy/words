{
    "word_family": [
        "shiver"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "51af0f36-86df-3e09-94bc-508fcee8af48",
                    "sense_definition": "Feeling cold or afraid, causing one to shake slightly.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_sensation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cold wind made me feel <w>shivery</w> while waiting for the bus.",
                            "target_lang_translations": {
                                "pl": "Zimny wiatr sprawił, że <w>poczułem dreszcze</w>, czekając na autobus."
                            }
                        },
                        {
                            "text": "She felt <w>shivery</w> after hearing the scary story in the dark.",
                            "target_lang_translations": {
                                "pl": "Poczuła się <w>drżąca ze strachu</w> po usłyszeniu strasznej historii w ciemności."
                            }
                        }
                    ],
                    "synonyms": [
                        "chilly",
                        "trembling"
                    ],
                    "common_phrases": [
                        "feel shivery"
                    ],
                    "target_lang_definitions": {
                        "pl": "Odczuwanie zimna lub strachu, powodujące lekkie drżenie ciała."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "drżący",
                                "target_lang_sense_clarification": "odnoszący się do drżenia ciała z zimna lub emocji"
                            },
                            {
                                "target_lang_word": "przejęty dreszczem",
                                "target_lang_sense_clarification": "opisujący stan fizyczny wywołany zimnem lub strachem"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "94e72832-06f0-3fe3-b923-c5361102775f",
                    "sense_definition": "Easily broken or crumbling into small pieces.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "physical_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old stone wall was <w>shivery</w> and began to crumble under pressure.",
                            "target_lang_translations": {
                                "pl": "Stary kamienny mur był <w>kruchy</w> i zaczął się kruszyć pod naciskiem."
                            }
                        },
                        {
                            "text": "Handle the <w>shivery</w> clay carefully so it does not break apart.",
                            "target_lang_translations": {
                                "pl": "Obchodź się z <w>kruchą</w> gliną ostrożnie, aby się nie rozpadła."
                            }
                        }
                    ],
                    "synonyms": [
                        "brittle",
                        "fragile",
                        "flaky"
                    ],
                    "antonyms": [
                        "sturdy",
                        "durable"
                    ],
                    "target_lang_definitions": {
                        "pl": "Łatwo pękający lub kruszący się na małe kawałki."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "kruchy",
                                "target_lang_sense_clarification": "podatny na łamanie się lub kruszenie"
                            },
                            {
                                "target_lang_word": "łamliwy",
                                "target_lang_sense_clarification": "łatwo ulegający uszkodzeniu pod wpływem nacisku"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}