                "senses": [
                    {
                        "sense_id": "e2c1c807-cab3-3978-ad8f-deab9e27e6a3",
                        "entry_id": "48b3c323-33bb-30ad-be21-fb1d3f9a362d",
                        "glosses": [
                            "weibliche Person, die im Dritten Reich auf der Grundlage nationalsozialistischer Gesetze Juden ihre Besitztümer gewaltsam und ohne Entschädigung weggenommen und diese dann zu „arischen“ Besitztümern gemacht hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e386a25-626f-45ad-b0ad-2749d20b4b4a",
                                "sense_id": "e2c1c807-cab3-3978-ad8f-deab9e27e6a3",
                                "text": "„Persönliche Beziehungen der ‚Ariseurin‘ und Elisabeth Koppels – eine jüdische Verwandte war eine Schulfreundin der ‚Ariseurin‘ gewesen – waren die Ursache.“"
                            },
                            {
                                "example_id": "55aac627-ff04-42de-8f1f-3529fdfa763c",
                                "sense_id": "e2c1c807-cab3-3978-ad8f-deab9e27e6a3",
                                "text": "„Zu dem genannten, annähernd vollständigen Betrag wird man zumindest noch die Erbschaftsteuer rechnen müssen, die Otto Metz-Randa als Erbe der Ariseurin von Epenstein für die Fromms Act 1941 zu entrichten hatte.“"
                            },
                            {
                                "example_id": "953065dd-d4cc-4809-9010-39b4dc023097",
                                "sense_id": "e2c1c807-cab3-3978-ad8f-deab9e27e6a3",
                                "text": "„Ihre Mutter Auguste Kallai, erhielt im Jahr 1950 im Zuge eines Rückstellungsverfahrens ihre Münzhandlung zurück – allerdings nur gegen Bezahlung von öS 4.000,- an die Erben der Ariseurin, Emilie Graf.“"
                            },
                            {
                                "example_id": "e16970bd-ae82-4995-8dfc-f4cd2c4370e5",
                                "sense_id": "e2c1c807-cab3-3978-ad8f-deab9e27e6a3",
                                "text": "„Auch der Wiedereinsatz der Ariseurin als Laborvorstand zeigt, wie wenig geneigt man war, Vermögenswerte zu restituieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
