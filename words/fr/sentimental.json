                {
                    "sense_id": "38ed4b90-d545-347d-826e-effa8ab55fa2",
                    "sense_definition": "Qui est naturellement porté à l'émotion, à la tendresse ou aux passions amoureuses.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "sentiment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il pleure souvent devant les histoires tristes parce qu'il est très <w>sentimental</w>.",
                            "target_lang_translations": {
                                "en": "He often cries at sad stories because he is very <w>sentimental</w>.",
                                "ru": "Он часто плачет над грустными историями, потому что он очень <w>сентиментальный</w>.",
                                "de": "Er weint oft bei traurigen Geschichten, weil er sehr <w>sentimental</w> ist.",
                                "es": "A menudo llora con las historias tristes porque es muy <w>sentimental</w>.",
                                "zh": "他常常为悲伤的故事落泪，因为他非常<w>多愁善感</w>。"
                            }
                        },
                        {
                            "text": "C'est une femme <w>sentimentale</w> qui garde soigneusement tous les souvenirs de sa jeunesse.",
                            "target_lang_translations": {
                                "en": "She is a <w>sentimental</w> woman who carefully keeps all the memories of her youth.",
                                "ru": "Она — <w>сентиментальная</w> женщина, которая бережно хранит все воспоминания о своей молодости.",
                                "de": "Sie ist eine <w>sentimentale</w> Frau, die alle Erinnerungen an ihre Jugend sorgfältig aufbewahrt.",
                                "es": "Es una mujer <w>sentimental</w> que guarda con cuidado todos los recuerdos de su juventud.",
                                "zh": "她是一个<w>多情</w>的女人，小心地保存着青春时代的所有回忆。"
                            }
                        }
                    ],
                    "synonyms": [
                        "émotif",
                        "sensible"
                    ],
                    "antonyms": [
                        "froid",
                        "insensible"
                    ],
                    "target_lang_definitions": {
                        "en": "Naturally prone to emotion, tenderness, or romantic passion.",
                        "ru": "От природы склонный к эмоциям, нежности или любовным страстям.",
                        "de": "Von Natur aus leicht bewegt und zu Zärtlichkeit oder verliebten Gefühlen neigend.",
                        "es": "Dicho de una persona, que se emociona con facilidad y es propensa a la ternura o a las pasiones amorosas.",
                        "zh": "天生容易动感情，常常充满柔情或对爱情的热情。"
