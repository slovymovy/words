                                    {
                                        "sense_id": "abb06d7f-ed22-3ac2-ae4f-7e55902719a1",
                                        "entry_id": "97abd4f9-57b6-3df3-b7d8-b7814d660960",
                                        "glosses": [
                                            "stan bycia chudym"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0e36e3e-6839-4ec0-9db1-72fd5c185225",
                                                "sense_id": "abb06d7f-ed22-3ac2-ae4f-7e55902719a1",
                                                "text": "I pomimo swojej chudości i pozornej kruchości, zwyciężył pojedynek na rękę ze spasionym Tymonem."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "abbdaba6-d656-4093-9629-57e522080cae",
