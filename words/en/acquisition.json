            "senses": [
                {
                    "sense_id": "122fc3f4-5380-3f94-b665-eb2024d6965e",
                    "sense_definition": "The act or process of obtaining or gaining possession of something.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>acquisition</w> of a second language requires significant time and practice.",
                            "target_lang_translations": {
                                "ru": "<w>Овладение</w> вторым языком требует значительного времени и практики.",
                                "de": "Der <w>Erwerb</w> einer Zweitsprache erfordert viel Zeit und Übung."
                            }
                        },
                        {
                            "text": "The company announced the <w>acquisition</w> of its largest competitor yesterday.",
                            "target_lang_translations": {
                                "ru": "Вчера компания объявила о <w>приобретении</w> своего крупнейшего конкурента.",
                                "de": "Das Unternehmen gab gestern die <w>Übernahme</w> seines größten Konkurrenten bekannt."
                            }
                        }
                    ],
                    "synonyms": [
                        "procurement",
                        "obtainment",
                        "gaining"
                    ],
                    "antonyms": [
                        "loss"
                    ],
                    "common_phrases": [
                        "language acquisition",
                        "talent acquisition",
                        "mergers and acquisitions",
                        "customer acquisition"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие или процесс получения чего-либо во владение или овладения чем-либо.",
                        "de": "Die Handlung oder der Prozess des Erlangens oder Erwerbens von Besitz oder Wissen."
                    },
                    "translations": {
