                    "examples": [
                        {
                            "text": "Sie gründete das neue Unternehmen zusammen mit einer erfahrenen geschäftlichen <w>Partnerin</w>.",
                            "target_lang_translations": {
                                "en": "She founded the new company together with an experienced business <w>partner</w>.",
                                "ru": "Она основала новую компанию вместе с опытной деловой <w>партнёршей</w>.",
                                "nl": "Ze richtte het nieuwe bedrijf op samen met een ervaren zakelijke <w>partner</w>.",
                                "pl": "Założyła nową firmę razem z doświadczoną <w>partnerką</w> biznesową.",
                                "fr": "Elle a fondé la nouvelle entreprise avec une <w>associée</w> commerciale expérimentée.",
                                "it": "Ha fondato la nuova impresa insieme a un'esperta <w>socia</w> in affari.",
                                "cs": "Založila novou firmu společně se zkušenou obchodní <w>partnerkou</w>.",
                                "tr": "Yeni şirketi deneyimli bir iş <w>ortağıyla</w> birlikte kurdu.",
                                "es": "Fundó la nueva empresa junto con una <w>socia</w> comercial experimentada.",
                                "zh": "她与一位经验丰富的商业<w>合伙人</w>共同创立了这家新公司。"
                            }
                        },
                        {
                            "text": "Beim Doppelturnier verstand sie sich mit ihrer sportlichen <w>Partnerin</w> hervorragend.",
                            "target_lang_translations": {
                                "en": "At the doubles tournament, she got along wonderfully with her <w>partner</w>.",
                                "ru": "На турнире в парном разряде она отлично ладила со своей <w>напарницей</w>.",
                                "nl": "Tijdens het dubbeltoernooi kon ze het uitstekend vinden met haar sportieve <w>partner</w>.",
                                "pl": "Podczas turnieju deblowego świetnie rozumiała się ze swoją sportową <w>partnerką</w>.",
                                "fr": "Lors du tournoi de double, elle s'entendait à merveille avec sa <w>partenaire</w> de jeu.",
                                "it": "Al torneo di doppio andava d'accordo a meraviglia con la sua <w>compagna</w> di gioco.",
                                "cs": "Na turnaji ve čtyřhře si se svou sportovní <w>partnerkou</w> skvěle rozuměla.",
