                "senses": [
                    {
                        "sense_id": "5a3cc1ad-de96-395e-a714-d662d3020e8b",
                        "entry_id": "41baad37-7066-3c03-8141-bac5285edfc8",
                        "glosses": [
                            "Sportart, ähnlich dem Baseball, mit etwas veränderten Regeln"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b743c23-5101-445b-8430-7f07e4341978",
                                "sense_id": "5a3cc1ad-de96-395e-a714-d662d3020e8b",
                                "text": "„Die Frauen hatten ihre Mahjong-Runden, die Männer spielten in der Küche Binokel und alberten herum, und im Sommer veranstalteten die Familien gemeinsame Picknicks in der South Mountains Reservation; dort spielte man Softball, warf Hufeisen und hörte sich in einem »knisternden, rauschenden Kofferradio, das jemand mitgebracht hatte«, ein Baseballspiel an.“"
                            },
                            {
                                "example_id": "a8e9ea35-5536-4c22-956a-7bb2aad447a3",
                                "sense_id": "5a3cc1ad-de96-395e-a714-d662d3020e8b",
                                "text": "„Baseball bei den Männern und Softball bei den Frauen waren zuletzt 2020 Teil des olympischen Programms, in Paris im kommenden Jahr sind die Sportarten nicht dabei.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
