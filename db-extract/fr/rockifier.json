                "senses": [
                    {
                        "sense_id": "b213a820-f095-33f2-9da0-50f49fa9e74c",
                        "entry_id": "32399d09-3d01-3b92-b9a7-dbedb275ddb7",
                        "glosses": [
                            "Donner un caractère rock à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6cb49ccf-1f59-4c58-ba9c-4ef484a882d1",
                                "sense_id": "b213a820-f095-33f2-9da0-50f49fa9e74c",
                                "text": "Le trio Love Sculpture, avec à sa tête Dave Edmund, ne s’était pas privé pour sa part de rockifier la « Danse du sabre » et « L’Arlésienne »."
                            },
                            {
                                "example_id": "bf89169f-59e3-43eb-8187-2bb23492b192",
                                "sense_id": "b213a820-f095-33f2-9da0-50f49fa9e74c",
                                "text": "On va se « rockifier. »"
                            },
                            {
                                "example_id": "92eb98d0-dddf-4a1c-aff7-60ecee150982",
                                "sense_id": "b213a820-f095-33f2-9da0-50f49fa9e74c",
                                "text": "Un album particulièrement intense, tant sur le plan musical que textuel, premier jalon d’une trilogie où le chanteur se « rockifie » et accomplit un travail d’épuration du langage."
                            }
                        ]
                    }
