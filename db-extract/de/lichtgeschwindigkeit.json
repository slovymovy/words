                    {
                        "form_id": "f4005b15-b7a3-4aea-b53a-629822d00b21",
                        "entry_id": "b551433a-bb60-30d0-85c7-208e4cd63414",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Lichtgeschwindigkeit"
                    },
                    {
                        "form_id": "c8cfe37c-87fc-45ff-bd78-3c5bc63a9f59",
                        "entry_id": "b551433a-bb60-30d0-85c7-208e4cd63414",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Lichtgeschwindigkeiten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "58e400f3-7753-3b1e-8723-7b91484b3443",
                        "entry_id": "b551433a-bb60-30d0-85c7-208e4cd63414",
                        "glosses": [
                            "Geschwindigkeit, mit der sich Licht und andere elektromagnetische Strahlung ausbreitet; im Vakuum beträgt diese für jeden Inertialbeobachter 299.792,458 Kilometer pro Sekunde"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "3767ea5b-ee11-4212-899c-4b3715aac4af",
                                "sense_id": "58e400f3-7753-3b1e-8723-7b91484b3443",
                                "text": "In der Speziellen Relativitätstheorie definiert die Lichtgeschwindigkeit eine obere Geschwindigkeitsgrenze."
                            },
                            {
                                "example_id": "d6ac9ae9-b3a8-4127-8489-0ff4c337b5b4",
                                "sense_id": "58e400f3-7753-3b1e-8723-7b91484b3443",
                                "text": "Die Konstanz der Lichtgeschwindigkeit ist in der Speziellen Relativitätstheorie ein Grundpostulat."
                            },
                            {
                                "example_id": "ca373808-bcb6-4490-8e5f-8c5ee04afb56",
                                "sense_id": "58e400f3-7753-3b1e-8723-7b91484b3443",
                                "text": "Die Existenz der spektroskopischen Doppelsterne und der Umstand, daß in weitaus den meisten Fällen die beobachtete Radialgeschwindigkeit vollständig durch die Keplersche Bewegung repräsentiert wird, ist also ein kräftiger Beweis für die Konstanz der Lichtgeschwindigkeit."
                            },
                            {
                                "example_id": "145755fd-4686-44ff-acfd-65a5eed16d5f",
                                "sense_id": "58e400f3-7753-3b1e-8723-7b91484b3443",
                                "text": "In Materie ist die Lichtgeschwindigkeit geringer als im Vakuum."
                            },
                            {
                                "example_id": "1b157f6f-5220-4f94-beb7-483535b21479",
                                "sense_id": "58e400f3-7753-3b1e-8723-7b91484b3443",
                                "text": "Durch die neue Meterdefinition ist die Messung von c nur noch von historischem Interesse, da die Lichtgeschwindigkeit selbst die Längeneinheit Meter definiert, in der vor 1983 die Lichtgeschwindigkeit gemessen wurde."
                            },
                            {
                                "example_id": "a48ece59-3a07-4438-8caa-bdddb59c2100",
                                "sense_id": "58e400f3-7753-3b1e-8723-7b91484b3443",
                                "text": "„Der Verfasser hatte an den Anfang aller Naturbetrachtung die Frage nach der Lichtgeschwindigkeit gestellt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "22d73712-a2ed-4990-96cc-7572db5bf42a",
                        "source_entry_id": "b551433a-bb60-30d0-85c7-208e4cd63414",
                        "source_sense_id": "58e400f3-7753-3b1e-8723-7b91484b3443",
                        "source_sense_description": "Geschwindigkeit des Lichts",
                        "target_lang_word": "speed of light",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "speed of light",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "74ce4d48-1a21-3360-a5b5-22b05c7de369",
                                        "entry_id": "9ebac330-3539-3947-b3c6-14808412e6b6",
                                        "glosses": [
                                            "The speed of electromagnetic radiation, which in a perfect vacuum is equivalent to 299,792,458 metres per second."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36496c78-10d6-4067-aed5-a82bac52cac4",
                                                "sense_id": "74ce4d48-1a21-3360-a5b5-22b05c7de369",
                                                "text": "As the subjective speed of light is raised within the field, objects outside will appear to red-shift, eventually becoming visible only to radio telescope antennae."
                                            },
                                            {
                                                "example_id": "31178640-f708-4912-aae9-c968f1909dbf",
                                                "sense_id": "74ce4d48-1a21-3360-a5b5-22b05c7de369",
                                                "text": "The science world was left in shock when workers at the world's largest physics lab announced they had recorded subatomic particles travelling faster than the speed of light – a feat that Einstein said was impossible."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "834cfc38-6bb7-367d-84e4-5db37dd3eb39",
                                        "entry_id": "9ebac330-3539-3947-b3c6-14808412e6b6",
                                        "glosses": [
                                            "A very rapid speed."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "figuratively"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "862ad67a-f489-3df3-9d17-838ab18a7bbe",
                                        "entry_id": "9ebac330-3539-3947-b3c6-14808412e6b6",
                                        "glosses": [
                                            "A rate of travel of a signal equal to one cell per generation, the fastest possible speed in the Moore and von Neumann neighborhoods."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04522f3f-53cf-48a8-90be-d25fe1d5f3a5",
                                                "sense_id": "862ad67a-f489-3df3-9d17-838ab18a7bbe",
                                                "text": "The translated distance divided by the period is the speed of the spaceship. Since the maximum speed of propagation of a signal in Life is one cell per generation, this speed is known as c (the speed of light). This speed is also the fastest possible growth of any finite object for a finite number of generations (think of a long line of ON cells). However, growth (or even just movement) of a finite object for an infinite time cannot occur at this speed."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "10d49c9c-7729-43ca-aaff-b22d984c5430",
                        "source_entry_id": "b551433a-bb60-30d0-85c7-208e4cd63414",
                        "source_sense_id": "58e400f3-7753-3b1e-8723-7b91484b3443",
                        "source_sense_description": "Geschwindigkeit des Lichts",
                        "target_lang_word": "vitesse de la lumière",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vitesse de la lumière",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ea0dd79f-39b6-38d6-80da-ae360ea7f7e9",
                                        "entry_id": "7f623c3c-9b42-3a26-bec2-01d7aa7218a8",
                                        "glosses": [
                                            "Vitesse de la lumière dans le vide, une constante physique fixée à 299,792,458 m/s par la définition du mètre. Le symbole est c."
                                        ],
                                        "tags": [
                                            "physical",
                                            "singular"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a833248d-b30a-3396-a82c-0e9b6adf0af2",
