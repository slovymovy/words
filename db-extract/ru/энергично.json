                                        "examples": [
                                            {
                                                "example_id": "a2aad63a-44b3-4fab-95a4-d152a5a730cb",
                                                "sense_id": "f9e754a5-46cb-3317-9d95-901a562d68e6",
                                                "text": "Er forderte energisch die Gewährleistung ein."
                                            },
                                            {
                                                "example_id": "9b91bdc8-f839-45a7-bc11-ab4b99250dd1",
                                                "sense_id": "f9e754a5-46cb-3317-9d95-901a562d68e6",
                                                "text": "„Mehr Wettbewerb auf der Schiene wird zwar gefordert, aber nicht energisch durchgesetzt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0820bbb6-3ea8-3e4b-9413-84d5b8ead804",
                                        "entry_id": "e2569f16-5ba0-3f4e-a871-80976884688f",
                                        "glosses": [
                                            "Energie, Kraft zeigend, kraftvoll"
                                        ],
                                        "tags": [],
                                        "examples": [
