                "senses": [
                    {
                        "sense_id": "168c4e3c-7fd0-3de7-a67f-35de7b6f78bd",
                        "entry_id": "7fad2d8b-f70c-3c02-b550-b298ccd1c697",
                        "glosses": [
                            "bewohnbare Fläche einer Wohnung, eines Gebäudes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c750f073-1c85-429d-9dda-107597b9eb6f",
                                "sense_id": "168c4e3c-7fd0-3de7-a67f-35de7b6f78bd",
                                "text": "„Seniorinnen und Senioren leben im Schnitt auf über 60 Quadratmetern Wohnfläche.“"
                            },
                            {
                                "example_id": "4457a297-ee8e-49f6-9d24-8616212bc975",
                                "sense_id": "168c4e3c-7fd0-3de7-a67f-35de7b6f78bd",
                                "text": "„In diesem Land zahlt man für 100 Quadratmeter Wohnfläche 45 Millionen Dollar, und zwei Straßen weiter wird ein Obdachloser in der Müllpresse zerquetscht.“"
                            },
                            {
                                "example_id": "e6c4045b-338a-4243-a8b1-63634832b194",
                                "sense_id": "168c4e3c-7fd0-3de7-a67f-35de7b6f78bd",
                                "text": "„Das Haus hat über 300 qm Wohnfläche und wurde durch den Verkauf des großväterlichen Bäckereibetriebes, den Albert gemeinsam mit der Mutter geerbt hatte, und einem Bankdarlehen finanziert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
