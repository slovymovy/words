                                    {
                                        "sense_id": "211210a4-6e82-3585-988c-3869caf89e11",
                                        "entry_id": "d97efad2-006e-3333-b1a0-174fe2085d00",
                                        "glosses": [
                                            "Something that is ephemeral."
