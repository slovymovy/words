                "senses": [
                    {
                        "sense_id": "79fb29de-3ef5-3ac5-8bcd-53de9332fb3c",
                        "entry_id": "0f13a124-93fb-32f0-9f69-e320d958a3d1",
                        "glosses": [
                            "Direktor eines Zoos"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6186611-4722-408e-949d-f8595a705b8e",
                                "sense_id": "79fb29de-3ef5-3ac5-8bcd-53de9332fb3c",
                                "text": "Die Ehrengäste wurden vom Zoodirektor persönlich begrüßt."
                            },
                            {
                                "example_id": "8cf09f4b-fe37-49ab-bc62-bb7b9519058d",
                                "sense_id": "79fb29de-3ef5-3ac5-8bcd-53de9332fb3c",
                                "text": "„2009 ließ ein Zoodirektor in Gaza einen Esel wegen mangelnder echter Steppentiere umlackieren.“"
                            },
                            {
                                "example_id": "d7d61033-1c56-4652-b92e-d1ac248ebb88",
                                "sense_id": "79fb29de-3ef5-3ac5-8bcd-53de9332fb3c",
                                "text": "„Der ehemalige Leipziger Zoodirektor Johannes Gebbing hat dem Tierpark in den 1930er- Jahren mehrere Skulpturen geliehen, sein Sohn fordert sie nun zurück.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
