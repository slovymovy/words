                        "tags": [
                            "adverb"
                        ],
                        "examples": [
                            {
                                "example_id": "f18d2096-dff9-4de3-9cb0-377a84d3c396",
                                "sense_id": "c76c7efe-e4f3-31fa-adae-afa5e303026e",
                                "text": "За столом она держалась очень чинно, почти чопорно, едва отведывала кушанья и пила воду из рюмки."
                            }
                        ]
                    }
                ],
