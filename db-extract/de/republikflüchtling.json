                "senses": [
                    {
                        "sense_id": "2b3be679-4796-305d-a4da-7f4ea3de468a",
                        "entry_id": "a28a617c-19a3-3dce-9b38-49e3df64c43e",
                        "glosses": [
                            "Person, die die Deutsche Demokratische Republik ohne Erlaubnis verlassen hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9225024-842c-4521-a421-fd0f4a695882",
                                "sense_id": "2b3be679-4796-305d-a4da-7f4ea3de468a",
                                "text": "„Da Đureković ein bekannter Mann war, wäre eine Ermordung im eigenen Land zu auffällig gewesen. Doch als Republikflüchtling war er Freiwild, und das wusste er. Einem Reporter der Bild am Sonntag sagte Đureković kurz nach seiner Flucht: […]“"
                            },
                            {
                                "example_id": "461d01da-6eb0-4660-b5d5-d8cbb666b745",
                                "sense_id": "2b3be679-4796-305d-a4da-7f4ea3de468a",
                                "text": "„Jedes Jahr wird von der Bundesregierung eine bestimmte Anzahl Republikflüchtlinge freigekauft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
