                "senses": [
                    {
                        "sense_id": "d5125436-0724-3f8e-9013-30609283dbd8",
                        "entry_id": "0b991206-a24f-3603-9e9f-3d39a6d01253",
                        "glosses": [
                            "pomada lub mazisty płyn stosowany do układania męskiej fryzury i wąsów"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "05a06304-3c4d-4a64-8af3-38389a6731a1",
                                "sense_id": "d5125436-0724-3f8e-9013-30609283dbd8",
                                "text": "Za szynkwasem stał gruby, baryłkowaty mężczyzna z wielką szramą na policzku i z zakręconymi po wilhelmowsku czarnymi wąsami, lśniącymi od fiksatuaru"
                            },
                            {
                                "example_id": "6c33a061-dca2-4199-a1b0-ce78560861af",
                                "sense_id": "d5125436-0724-3f8e-9013-30609283dbd8",
                                "text": "Gładził jej głowę, twarz, ręce. Z jakąż radością poczuła znajomy zapach cygar, kochany zapach fiksatuaru!"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
