                    "sense_definition": "iets wat een mens hindert of ongemak veroorzaakt",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "hinder",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik heb vandaag erg veel <w>last</w> van hoofdpijn door het warme weer.",
                            "target_lang_translations": {
                                "en": "I am <w>suffering</w> a lot from a headache today because of the warm weather.",
                                "ru": "Сегодня я сильно <w>страдаю</w> от головной боли из-за жаркой погоды.",
                                "pl": "Dziś z powodu upału bardzo dokucza mi ból głowy; mam z nim duży <w>problem</w>."
                            }
                        },
                        {
                            "text": "De buren hebben vaak <w>last</w> van het lawaai van de drukke straat.",
                            "target_lang_translations": {
                                "en": "The neighbors are often <w>bothered</w> by the noise from the busy street.",
                                "ru": "Соседям часто <w>мешает</w> шум оживленной улицы.",
                                "pl": "Sąsiadom często przeszkadza hałas z ruchliwej ulicy; to duża <w>uciążliwość</w>."
                            }
                        }
