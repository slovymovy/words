                ],
                "senses": [
                    {
                        "sense_id": "df783749-a8e8-32bb-889f-48a178407a40",
                        "entry_id": "f613ab38-06cd-3104-b232-71df033544fd",
                        "glosses": [
                            "To make concrete, substantial, real, or tangible; to represent or embody a concept through a particular instance or example."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "9b364a5f-0d3e-47a2-9117-f2910647df25",
                                "sense_id": "df783749-a8e8-32bb-889f-48a178407a40",
                                "text": "An essence exists if and only if it is actualized or concretized somehow, in some concrete form."
                            },
                            {
                                "example_id": "b3d187b4-76ad-4b52-b769-db894258dce8",
                                "sense_id": "df783749-a8e8-32bb-889f-48a178407a40",
                                "text": "But Ms. Yauger's death concretized these abstract discussions and theories."
                            },
                            {
                                "example_id": "7103312c-ff32-4c5e-aa2b-638427a1a06c",
                                "sense_id": "df783749-a8e8-32bb-889f-48a178407a40",
                                "text": "Rights in this way stem from social conventions that concretize and shape the values that underlie them."
                            },
                            {
                                "example_id": "30332119-1517-43d5-9c72-0929d2807985",
                                "sense_id": "df783749-a8e8-32bb-889f-48a178407a40",
                                "text": "The Russian Ministry of Education has taken additional steps to concretize Russian control over the school system in occupied Ukraine."
                            }
                        ]
                    },
                    {
                        "sense_id": "78b972ef-24f8-3b63-8412-3d9ea40128ab",
                        "entry_id": "f613ab38-06cd-3104-b232-71df033544fd",
                        "glosses": [
                            "To be embodied, to have physical representation."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "b56af282-9e80-4118-baff-0dcf02a6cc76",
                                "sense_id": "78b972ef-24f8-3b63-8412-3d9ea40128ab",
                                "text": "These expressions of God's concern concretize around the figure of the divine hand or arm."
                            }
                        ]
                    }
                ],
