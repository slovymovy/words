                    {
                        "sense_id": "af863ba1-4c70-348d-8da5-a06ed1ce8d7b",
                        "entry_id": "4428ef60-e1b3-3d90-8107-fdde4d98dd05",
                        "glosses": [
                            "Regel, nach der sich die Mitglieder eines Ordens zu richten haben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0535aac1-d057-4d75-9ae6-f30522d7974d",
                                "sense_id": "af863ba1-4c70-348d-8da5-a06ed1ce8d7b",
                                "text": "„Ich sagte dem Kapuziner, er müsse sich schämen, seine Ordensregel durch die Sünde der Hoffart zu verletzen.“"
                            },
                            {
                                "example_id": "43b88007-ab3f-4fe0-b891-5e14af99ccbd",
                                "sense_id": "af863ba1-4c70-348d-8da5-a06ed1ce8d7b",
                                "text": "„Immerhin ist es ungewöhnlich, daß ein Katholik Aufnahme bei den Guttemplern fand, was nach den Ordensregeln nicht gestattet war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
