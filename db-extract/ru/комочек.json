                "senses": [
                    {
                        "sense_id": "b46d41f1-f1ea-33dd-9f68-2ba632725ab0",
                        "entry_id": "9304be9c-0744-32c9-9000-8840ef97ef34",
                        "glosses": [
                            "разг. небольшой комок"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12945b84-71ee-4b94-b0a2-1016af9ac58a",
                                "sense_id": "b46d41f1-f1ea-33dd-9f68-2ba632725ab0",
                                "text": "И если шью зигзагом, периодически нижняя нитка прямо на ткани завязывается в узелок и получается такой заметный комочек."
                            },
                            {
                                "example_id": "f4575a44-e68b-414b-85aa-c1351e05ba24",
                                "sense_id": "b46d41f1-f1ea-33dd-9f68-2ba632725ab0",
                                "text": "Под правой подмышкой чувствуется какой-то комочек, то ли воспалился лимфоузел, то еще что."
                            }
                        ]
                    }
                ],
