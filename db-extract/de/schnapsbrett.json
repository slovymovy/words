                "senses": [
                    {
                        "sense_id": "711c4982-4837-3b59-8110-14cb286c018e",
                        "entry_id": "522f6ae3-589c-3040-b884-5e202add09b2",
                        "glosses": [
                            "Brett mit Vertiefungen für Schnapsgläser, auf dem mehrere Schnäpse serviert werden können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d137788-d218-45f1-8f7f-1470e9a8a4a5",
                                "sense_id": "711c4982-4837-3b59-8110-14cb286c018e",
                                "text": "„Das Schnapsbrett kreist ein weiteres Mal zu fünf Probanden.“"
                            },
                            {
                                "example_id": "ff632ccc-4fd2-40a6-b8c9-37e6effea3cc",
                                "sense_id": "711c4982-4837-3b59-8110-14cb286c018e",
                                "text": "„Hier kannst Du Dein persönliches Schnapsbrett gestalten.“"
                            },
                            {
                                "example_id": "b6ace01e-987e-4de4-8735-a62393ed17b1",
                                "sense_id": "711c4982-4837-3b59-8110-14cb286c018e",
                                "text": "„Drei Kräuterspirituosen sind im Angebot, der Postillion, der Bochumer Tropfen und Blau-Weiß. Sie gibt es auch als Trio zum Sonderpreis auf einem ‚Schnapsbrett‘ – eine lose Verbindung zum Livingroom, zu dessen Spezialitäten es gehört, drei auswählbare Tapas auf einem ‚Essbrett‘ zu servieren.“"
                            },
                            {
                                "example_id": "2016e2cc-9e74-4bb7-ae5a-3ae4a10068de",
                                "sense_id": "711c4982-4837-3b59-8110-14cb286c018e",
                                "text": "„‚Woits a Schnapserl?‘, fragt ihr Mann und reicht schon das Schnapsbrett in die Runde.“"
                            },
                            {
                                "example_id": "da4af878-3a54-4e2e-9c1b-ef8976f0a42b",
                                "sense_id": "711c4982-4837-3b59-8110-14cb286c018e",
                                "text": "„Neben diesen Schnapsbrettern gibt es Käsebretter, ebenfalls in Form des Kölner Doms, in die viele kleine Löcher gebohrt sind, wo die Käsespieße hineingesteckt werden können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
