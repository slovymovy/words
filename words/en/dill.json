{
    "word_family": [
        "dillseed"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "503a8a50-021d-38a7-8582-0ca85892cf15",
                    "sense_definition": "An aromatic herb used in cooking, known for its pungent seeds and feathery leaves.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "herb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Add some fresh <w>dill</w> to the potato salad for extra flavor.",
                            "target_lang_translations": {
                                "ru": "Добавьте немного свежего <w>укропа</w> в картофельный салат для дополнительного аромата.",
                                "pl": "Dodaj do sałatki ziemniaczanej trochę świeżego <w>koperku</w>, aby nadać jej dodatkowego smaku."
                            }
                        },
                        {
                            "text": "The recipe calls for a tablespoon of chopped <w>dill</w> to garnish the fish.",
                            "target_lang_translations": {
                                "ru": "По рецепту требуется столовая ложка нарезанного <w>укропа</w> для украшения рыбы.",
                                "pl": "Przepis wymaga łyżki posiekanego <w>koperku</w> do przybrania ryby."
                            }
                        }
                    ],
                    "synonyms": [
                        "anet",
                        "dillseed",
                        "Peucedanum graveolens"
                    ],
                    "common_phrases": [
                        "fresh dill",
                        "chopped dill"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ароматная трава, используемая в кулинарии, известная своими пряными семенами и перистыми листьями.",
                        "pl": "Aromatyczna roślina zielna używana w kuchni, charakteryzująca się intensywnie pachnącymi nasionami i pierzastymi liśćmi."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "укроп",
                                "target_lang_sense_clarification": "общее название растения и зелени, используемой в пищу"
                            },
                            {
                                "target_lang_word": "укроп пахучий",
                                "target_lang_sense_clarification": "ботаническое название вида Anethum graveolens"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "koperek",
                                "target_lang_sense_clarification": "świeże liście używane jako przyprawa"
                            },
                            {
                                "target_lang_word": "koper",
                                "target_lang_sense_clarification": "roślina jako całość lub dojrzały koper z nasionami"
                            },
                            {
                                "target_lang_word": "koper ogrodowy",
                                "target_lang_sense_clarification": "nazwa botaniczna gatunku"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "af0e062c-01ee-36d3-a586-fe30ab320396",
                    "sense_definition": "A cucumber preserved in a brine or vinegar solution flavored with dill.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "herb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He ordered a sandwich with a side of <w>dill</w> pickle.",
                            "target_lang_translations": {
                                "ru": "Он заказал сэндвич с <w>маринованным</w> огурцом на гарнир.",
                                "pl": "Zamówił kanapkę z dodatkiem <w>ogórka konserwowego</w>."
                            }
                        },
                        {
                            "text": "The crunchy <w>dill</w> pickle was the perfect snack.",
                            "target_lang_translations": {
                                "ru": "Хрустящий <w>маринованный</w> огурец был идеальной закуской.",
                                "pl": "Chrupiący <w>ogórek kwaszony</w> był idealną przekąską."
                            }
                        }
                    ],
                    "common_phrases": [
                        "dill pickle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Огурец, маринованный или соленый с добавлением укропа.",
                        "pl": "Ogórek konserwowany lub kwaszony z dodatkiem kopru."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "маринованный огурец",
                                "target_lang_sense_clarification": "огурец, приготовленный в уксусном маринаде"
                            },
                            {
                                "target_lang_word": "соленый огурец",
                                "target_lang_sense_clarification": "огурец, приготовленный в рассоле с укропом"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "ogórek konserwowy",
                                "target_lang_sense_clarification": "ogórek marynowany w zalewie octowej z koperkiem"
                            },
                            {
                                "target_lang_word": "ogórek kwaszony",
                                "target_lang_sense_clarification": "ogórek kiszony w solance z dodatkiem kopru"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "49fa965d-a95b-378e-91f1-82265540b98c",
                    "sense_definition": "A foolish or silly person.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Don't be such a <w>dill</w> and listen to what I am saying.",
                            "target_lang_translations": {
                                "ru": "Не будь таким <w>дураком</w> и послушай, что я говорю.",
                                "pl": "Nie bądź takim <w>głupkiem</w> i posłuchaj, co mówię."
                            }
                        },
                        {
                            "text": "He felt like a total <w>dill</w> after making that silly mistake in front of everyone.",
                            "target_lang_translations": {
                                "ru": "Он почувствовал себя полным <w>болваном</w> после того, как совершил эту глупую ошибку на глазах у всех.",
                                "pl": "Poczuł się jak kompletny <w>dureń</w>, gdy popełnił ten głupi błąd na oczach wszystkich."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Commonly used in Australian English."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Глупый или нелепый человек (сленг).",
                        "pl": "Głupia, niemądra osoba (slang australijski)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дурак",
                                "target_lang_sense_clarification": "разговорное обозначение глупого человека"
                            },
                            {
                                "target_lang_word": "болван",
                                "target_lang_sense_clarification": "пренебрежительное обозначение глупого человека"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "głupek",
                                "target_lang_sense_clarification": "osoba postępująca niemądrze"
                            },
                            {
                                "target_lang_word": "dureń",
                                "target_lang_sense_clarification": "obraźliwe określenie głupiej osoby"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a9639892-fe8c-30aa-8169-d36a01871546",
                    "sense_definition": "To add the herb dill to food for seasoning.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should <w>dill</w> the sauce just before serving to keep the flavor fresh.",
                            "target_lang_translations": {
                                "ru": "Вам следует <w>добавить укроп</w> в соус прямо перед подачей, чтобы сохранить свежий вкус.",
                                "pl": "Powinieneś <w>dodać koperku do</w> sosu tuż przed podaniem, aby zachować świeży smak."
                            }
                        },
                        {
                            "text": "She likes to <w>dill</w> her salmon fillets with lemon and butter.",
                            "target_lang_translations": {
                                "ru": "Ей нравится <w>приправлять укропом</w> филе лосося с лимоном и маслом.",
                                "pl": "Ona lubi <w>doprawiać koperkiem</w> swoje filety z łososia wraz z cytryną i masłem."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Добавлять укроп в пищу для придания аромата.",
                        "pl": "Doprawiać lub posypywać potrawę koperkiem."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "добавлять укроп",
                                "target_lang_sense_clarification": "процесс приправления блюда укропом"
                            },
                            {
                                "target_lang_word": "посыпать укропом",
                                "target_lang_sense_clarification": "украшение или придание вкуса готовому блюду"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "doprawiać koperkiem",
                                "target_lang_sense_clarification": "dodawać koperek do potrawy dla smaku"
                            },
                            {
                                "target_lang_word": "posypywać koperkiem",
                                "target_lang_sense_clarification": "dekorować lub przyprawiać siekanym koperkiem"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a55c3fb4-948e-339b-88cb-1e26ca998fdf",
                    "sense_definition": "To calm, soothe, or reduce the intensity of something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The medicine helped to <w>dill</w> the sharp pain in his leg.",
                            "target_lang_translations": {
                                "ru": "Лекарство помогло <w>смягчить</w> острую боль в ноге.",
                                "pl": "Lekarstwo pomogło <w>uśmierzyć</w> ostry ból w nodze."
                            }
                        },
                        {
                            "text": "The angry crowd began to <w>dill</w> down after the leader spoke.",
                            "target_lang_translations": {
                                "ru": "Разъяренная толпа начала <w>успокаиваться</w> после того, как выступил лидер.",
                                "pl": "Wzburzony tłum zaczął się <w>uspokajać</w> po przemówieniu przywódcy."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Успокаивать, смягчать или уменьшать интенсивность чего-либо (устар.).",
                        "pl": "Uspokajać, uśmierzać lub łagodzić (znaczenie archaiczne)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "успокаивать",
                                "target_lang_sense_clarification": "снижение интенсивности эмоций или боли"
                            },
                            {
                                "target_lang_word": "смягчать",
                                "target_lang_sense_clarification": "уменьшение остроты или силы воздействия"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "uśmierzać",
                                "target_lang_sense_clarification": "łagodzić ból lub intensywność"
                            },
                            {
                                "target_lang_word": "uspokajać",
                                "target_lang_sense_clarification": "wyciszać emocje lub zamieszanie"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
