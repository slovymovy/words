        "fr-extract.jsonl": [
            {
                "entry_id": "fa010c89-fe1b-31d0-9d83-16ed8e56c8a3",
                "word": "chiromancie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "10248266-545f-4cb2-8f8d-90242b16485b",
                        "entry_id": "fa010c89-fe1b-31d0-9d83-16ed8e56c8a3",
                        "tags": [
                            "plural"
                        ],
                        "form": "chiromancies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0d89fe1e-66e4-38c2-94de-e5b324549d1b",
                        "entry_id": "fa010c89-fe1b-31d0-9d83-16ed8e56c8a3",
                        "glosses": [
                            "Divination de ce qui doit arriver, par l’inspection de la main et plus particulièrement de ses lignes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb775f44-fbdd-4779-8edd-187561e6b3cc",
                                "sense_id": "0d89fe1e-66e4-38c2-94de-e5b324549d1b",
                                "text": "Savoir la chiromancie, les règles de la chiromancie."
                            },
                            {
                                "example_id": "63c7d23f-096d-4638-a7cf-0a04ad14640b",
                                "sense_id": "0d89fe1e-66e4-38c2-94de-e5b324549d1b",
                                "text": "La chiromancie est une science frivole."
                            },
                            {
                                "example_id": "5d70465d-ca59-4319-b0f1-4095ead8c45b",
                                "sense_id": "0d89fe1e-66e4-38c2-94de-e5b324549d1b",
                                "text": "Des instructions pratiques spécifiques pour l’examen des mains apparaissent aussi dans les discussions de chiromancie qui sont devenues des parties intégrantes des traités de physiognomonie de la fin du Moyen Âge, puisque la chiromancie est « véritablement une partie de la physiognomonie »."
                            },
                            {
                                "example_id": "a21a115f-2af5-44aa-9f16-0ece58f31b21",
                                "sense_id": "0d89fe1e-66e4-38c2-94de-e5b324549d1b",
                                "text": "Les sciences dites occultes avaient droit de cité (l’astrologie, la pronostication ou la chiromancie)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "443efc9f-0e99-4325-9d96-c9c2b4b72f15",
                        "source_entry_id": "fa010c89-fe1b-31d0-9d83-16ed8e56c8a3",
                        "source_sense_id": "0d89fe1e-66e4-38c2-94de-e5b324549d1b",
                        "target_lang_word": "Handlesen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "8c2bd508-f039-4882-995b-1bd26f8fd6b7",
                        "source_entry_id": "fa010c89-fe1b-31d0-9d83-16ed8e56c8a3",
                        "source_sense_id": "0d89fe1e-66e4-38c2-94de-e5b324549d1b",
                        "target_lang_word": "Handliniendeutung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "d15cafba-8768-48d2-b14b-7827d76fce60",
                        "source_entry_id": "fa010c89-fe1b-31d0-9d83-16ed8e56c8a3",
                        "source_sense_id": "0d89fe1e-66e4-38c2-94de-e5b324549d1b",
                        "target_lang_word": "Chiromantie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Chiromantie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d541f640-9370-3612-8494-cfbc1190e4fb",
                                        "entry_id": "10d83097-2d00-3906-ab6f-0cda1b233218",
                                        "glosses": [
                                            "Kunst, aufgrund der Form und Linien der Hand wahrzusagen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5f6b983-0b15-4d56-8a36-439993e78fcb",
                                                "sense_id": "d541f640-9370-3612-8494-cfbc1190e4fb",
                                                "text": "„Über den Unterschied zwischen ernsthaft betriebener Chiromantie und betrügerischem Handlesen belehrt ein 1661 in Leipzig bei Johann Bartholomäus Oehler gedrucktes Kupfer.“"
                                            },
                                            {
                                                "example_id": "430fe2f0-d96a-49f9-987a-ac0d31ea7789",
                                                "sense_id": "d541f640-9370-3612-8494-cfbc1190e4fb",
                                                "text": "„Ich glaube, Sie haben recht, die Chiromantie liegt Ihnen nicht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c4be144a-d925-4509-a90d-80038014dfef",
                        "source_entry_id": "fa010c89-fe1b-31d0-9d83-16ed8e56c8a3",
                        "source_sense_id": "0d89fe1e-66e4-38c2-94de-e5b324549d1b",
                        "target_lang_word": "Handlesekunst",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "abf0850b-d254-4cb4-80f1-f73626cee11d",
                        "source_entry_id": "fa010c89-fe1b-31d0-9d83-16ed8e56c8a3",
                        "source_sense_id": "0d89fe1e-66e4-38c2-94de-e5b324549d1b",
                        "target_lang_word": "chiromancy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chiromancy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c7604c7c-f85a-3fe6-a4b0-b3396ccbf9e8",
                                        "entry_id": "41b5b420-b8f3-3e76-960f-1aff4a67f12b",
                                        "glosses": [
                                            "Synonym of palmistry: fortune-telling performed by reading another's hand."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f5312cbf-6d73-43eb-9516-e31d07ce2e42",
                                                "sense_id": "c7604c7c-f85a-3fe6-a4b0-b3396ccbf9e8",
                                                "text": "If they fore-tell things that shall happen by signes that they see in lines of a mans hand; then it is called Chyromancie..."
                                            },
                                            {
                                                "example_id": "094236e7-0b76-4f59-a4fb-af07cb779e30",
                                                "sense_id": "c7604c7c-f85a-3fe6-a4b0-b3396ccbf9e8",
                                                "text": "Modern palmistry differs from the ancient methods in concentrating on what is called chirognomy at the expense of chiromancy."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8260c405-5cfa-4f55-830a-67dc11cbbbf5",
                        "source_entry_id": "fa010c89-fe1b-31d0-9d83-16ed8e56c8a3",
                        "source_sense_id": "0d89fe1e-66e4-38c2-94de-e5b324549d1b",
                        "target_lang_word": "palmistry",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "palmistry",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "58b02046-1d61-3b4f-bad1-6689fbd83eac",
                                        "entry_id": "a86ca3ff-6251-3f2a-82e0-d3c86198eb3b",
                                        "glosses": [
                                            "Telling fortunes from the lines on the palms of the hand."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e56be98a-ae2d-4d1e-b6aa-fb74f1cbbf77",
                                                "sense_id": "58b02046-1d61-3b4f-bad1-6689fbd83eac",
                                                "text": "Chiromantie is a coniecturyng by beholdyng the lynes, or wryncles of the handes called commonly Palmistry."
                                            },
                                            {
                                                "example_id": "5f9a3ae8-4cec-44c5-89d0-ede411578d50",
                                                "sense_id": "58b02046-1d61-3b4f-bad1-6689fbd83eac",
                                                "text": "And those fayre hands within whose louely palmes,\nFortune diuineth happie Augurie,\nThose straightest fingers dealing heauenly almes,\nPointed with pur’st of Natures Alcumie,\nWhere loue sits looking in loues palmistrie."
                                            },
                                            {
                                                "example_id": "b4dd28b2-b997-46e0-80f5-d2b632923160",
                                                "sense_id": "58b02046-1d61-3b4f-bad1-6689fbd83eac",
                                                "text": "[…] but his [God’s] right hand of truth and bountie, does by a Catholike and vnfeigned Palmistrie, shew the blessings prouided for other men!"
                                            },
                                            {
                                                "example_id": "23ebe093-73c8-4546-9351-c0b0cd88589f",
                                                "sense_id": "58b02046-1d61-3b4f-bad1-6689fbd83eac",
                                                "text": "He must (at least) hold up his hand,\nBy twelve Free-holders to be scan’d,\nWho by their skill in Palmistry,\nWill quickly read his Destiny;"
                                            },
                                            {
                                                "example_id": "04f8b4e4-df0d-4493-8426-bac6317d79d3",
                                                "sense_id": "58b02046-1d61-3b4f-bad1-6689fbd83eac",
                                                "text": "I have seen a gipsy vagabond; she has practised in hackneyed fashion the science of palmistry and told me what such people usually tell."
                                            },
                                            {
                                                "example_id": "6b21eb28-da3a-49d0-8913-6b2997973dad",
                                                "sense_id": "58b02046-1d61-3b4f-bad1-6689fbd83eac",
                                                "text": "If you had cared to do so, you could have told the little chap’s fortune from those hands. They were not flat and featureless as you might have expected them to be; already they had all the lines and creases known to palmistry."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a320de74-bc0a-34f1-ae30-299727dc2564",
                                        "entry_id": "a86ca3ff-6251-3f2a-82e0-d3c86198eb3b",
                                        "glosses": [
                                            "A book on palmistry; a system of palmistry."
                                        ],
                                        "tags": [
                                            "countable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f2fbb170-da04-4177-80ad-abd13d593854",
                                                "sense_id": "a320de74-bc0a-34f1-ae30-299727dc2564",
                                                "text": "No living palmistries can spell\nThe bird-runes on the stretched silk of her hand"
                                            },
                                            {
                                                "example_id": "caca3b4f-4485-4678-9c9c-f0a7119876d2",
                                                "sense_id": "a320de74-bc0a-34f1-ae30-299727dc2564",
                                                "text": "Both the composition and the transmission of this palmistry must be taken in the context of the medieval Christian world, in which the life on earth was still secondary to the life in the hereafter; even so, texts such as these palmistries do make the unreadable mysteries of one’s relationship to the world seem more familiar and more accessible."
                                            },
                                            {
                                                "example_id": "8266d028-aac4-4859-958f-049116ba0544",
                                                "sense_id": "a320de74-bc0a-34f1-ae30-299727dc2564",
                                                "text": "1996, Richard Grossinger, New Moon, Berkeley, CA: Frog, Part 7, Chapter 2, p. 534,\nTo fulfill my graduate language requirement I began reading Michel Foucault’s work on signatures, Les Mots et Les Choses, which joined the meanings of the bestiaries, herbals, palmistries, and physiognomies of olden Europe to the totemic orders of plants and animals among the Arapaho, Xhosa, and Aranda."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "40b91dbe-7b80-31e0-93ff-8194a497c2af",
                                        "entry_id": "a86ca3ff-6251-3f2a-82e0-d3c86198eb3b",
                                        "glosses": [
                                            "A dexterous use or trick of the hand."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "rare",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f628cb9d-c1b1-4f8b-9f78-d207971b84da",
                                                "sense_id": "40b91dbe-7b80-31e0-93ff-8194a497c2af",
                                                "text": "1711, Joseph Addison and Richard Steele, The Spectator, Volume 2, No. 130, 30 July, 1711, London: J. and R. Tonson, 12th edition, 1739, p. 182,\nIn the Height of his Good-humour, meeting a common Beggar upon the Road who was no Conjuror, as he went to relieve him he found his Pocket was pick’d: That being a Kind of Palmistry at which this Race of Vermin are very dextrous."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
