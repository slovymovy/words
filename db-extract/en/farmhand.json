                        "target_lang_word": "ouvrier agricole",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ouvrier agricole",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a8b901d7-a140-3759-8862-dddc537e50ef",
                                        "entry_id": "f0a4a175-5349-3e03-88a7-d4a70275da3e",
                                        "glosses": [
                                            "Personne travaillant de façon permanente ou saisonnière dans des fermes de toutes tailles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89027279-9c63-437a-9a5b-9e6f120a58e7",
                                                "sense_id": "a8b901d7-a140-3759-8862-dddc537e50ef",
                                                "text": "C’était un ancien ouvrier agricole, le grade le plus bas dans la hiérarchie des campagnes, un loueur de ses bras qu’on couchait dans l’étable et qu’on salariait d’un couvert."
                                            }
                                        ]
