                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ae0ea2d8-4b58-4b68-a5ea-20e61a137798",
                        "source_entry_id": "546204ea-f63a-3125-8384-f3c4d484635e",
                        "source_sense_id": "0da06547-14a1-38d9-bc73-46efcd10738f",
