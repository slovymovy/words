                "senses": [
                    {
                        "sense_id": "932767c6-e194-3225-b2ca-21609c24715c",
                        "entry_id": "a9615c7f-354f-36d9-a868-3a3dd3f07f6f",
                        "glosses": [
                            "разг. склонившийся вниз; поникший"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e2a2045f-8a5b-4111-8ecc-435124e67e28",
                                "sense_id": "932767c6-e194-3225-b2ca-21609c24715c",
                                "text": "Листья все еще ревниво берегли от солнца низкорослый горбатенький стебелек, увенчанный снежно-белыми пониклыми чашечками цветов."
                            },
                            {
                                "example_id": "212186fd-7e99-4f08-9e06-1dc16f426cdf",
                                "sense_id": "932767c6-e194-3225-b2ca-21609c24715c",
                                "text": "Камыши встречали их [волны] мягким шелестом, качая пониклыми коричневыми макушками."
                            }
                        ]
                    }
