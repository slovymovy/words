                "senses": [
                    {
                        "sense_id": "1f84e797-36fd-31df-97e1-f2f230141f4d",
                        "entry_id": "58ed2e25-0ea7-3eb4-a5c3-c9ef182ed858",
                        "glosses": [
                            "herausschlüpfen"
                        ],
                        "tags": [
                            "Bavarian"
                        ],
                        "examples": [
                            {
                                "example_id": "4af0deb2-cf31-4e22-ad9f-7e944303fbe0",
                                "sense_id": "1f84e797-36fd-31df-97e1-f2f230141f4d",
                                "text": "„Die Frau, die dort im Föisn liegt, auf aram stoanern Sofa, wia sa si in sei Muidn schmiegt, moanst, sie waar aussagschloffa“"
                            },
                            {
                                "example_id": "81251a62-68be-49fd-be00-b77ade8ae600",
                                "sense_id": "1f84e797-36fd-31df-97e1-f2f230141f4d",
                                "text": "„Wia-r-a aussaschliaft und si aussawindt, kimmt a großa Wölfisch und nimmt 'n in 's Maul.“"
                            },
                            {
                                "example_id": "42526727-46f1-4a85-9c56-f6f826ca41c1",
                                "sense_id": "1f84e797-36fd-31df-97e1-f2f230141f4d",
                                "text": "„Wia de furt sein, is s' aussagschloffa und is in-an-åndas Zimma kemma.“"
                            },
                            {
                                "example_id": "45d209f8-e852-4694-87d8-d78a01f81d1c",
                                "sense_id": "1f84e797-36fd-31df-97e1-f2f230141f4d",
                                "text": "„Eahm schaug o, hab i zu eahm gsagt, Herr Richter, kaum is a ausn Kinderwagl aussagschloffa, mecht a scho an Rennfahrer schpuin!“"
                            },
                            {
                                "example_id": "cab73b58-1e2b-4606-a7e3-74754ae87a29",
                                "sense_id": "1f84e797-36fd-31df-97e1-f2f230141f4d",
                                "text": "„Erscht braucht ma an Kar, am bestn an rundn aus Droht, der meglichst durchsichtig is und der umgschtiazt flach mid'm Rand aufm Bodn liegt - damits ned aussaschliaffa kinnan.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
