                                        "glosses": [
                                            "A native or inhabitant of the Sahara."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fceaf4ac-4572-49ee-8023-24ad6a84cd1e",
                                                "sense_id": "191d8788-19dc-3ba9-8ff3-fd75b67a9135",
                                                "text": "A central element in the settlement proposals is the identification and registration of all Western Saharans eligible to vote in the referendum."
