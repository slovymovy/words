                                        ],
                                        "examples": [
                                            {
                                                "example_id": "74591b81-1571-4660-8501-aecabde08b5e",
                                                "sense_id": "6eca0026-8bad-378b-b46b-a17348f63912",
                                                "text": "The Tuesday meetings are only thirty minutes now. That proclamation was made in the previous meeting."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dae465a1-0367-4d21-b423-b72a88cc4e26",
                        "source_entry_id": "3dc1adae-d56f-31ec-b4b4-63d268a1102b",
                        "source_sense_id": "54771459-b348-3a19-b599-7f63372dc2be",
                        "target_lang_word": "publication",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "publication",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b136755b-aa93-3319-bef6-4a7655e77700",
                                        "entry_id": "4ddc5737-615e-33a7-909b-1ed5b0ef7caf",
                                        "glosses": [
                                            "The act of publishing printed or other matter."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4407e0d1-68a7-4133-b789-798bbac06e2d",
                                                "sense_id": "b136755b-aa93-3319-bef6-4a7655e77700",
                                                "text": "The publication of these papers was not owing to our folly, but that of others."
                                            },
                                            {
                                                "example_id": "4cb121e6-853a-43f3-9744-baa5d45e2f34",
                                                "sense_id": "b136755b-aa93-3319-bef6-4a7655e77700",
                                                "text": "Owing to the time lag which must occur between the dates of closing for press and publication, it sometimes happens that items of news are out of date, or inaccurate, by the time they reach readers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0dace37-734d-3042-81e2-72496c698f0a",
                                        "entry_id": "4ddc5737-615e-33a7-909b-1ed5b0ef7caf",
                                        "glosses": [
                                            "An issue of printed or other matter, offered for sale or distribution."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "480f03dd-7246-3f59-89c0-85fa535a5609",
                                        "entry_id": "4ddc5737-615e-33a7-909b-1ed5b0ef7caf",
                                        "glosses": [
                                            "The communication of information to the general public etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e75bdb3c-0596-4cfe-aa81-049b3ae3ac23",
                                                "sense_id": "480f03dd-7246-3f59-89c0-85fa535a5609",
                                                "text": "His jealousy ... attends the business, the recreations, the publications, and retirements of every man."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a54bfd31-5850-47e9-9f35-6ae15fa1a441",
                        "source_entry_id": "3dc1adae-d56f-31ec-b4b4-63d268a1102b",
                        "source_sense_id": "54771459-b348-3a19-b599-7f63372dc2be",
                        "target_lang_word": "publicación",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "publicación",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "58b0ef69-602a-37f1-b15e-3c1dec2970e7",
                                        "entry_id": "0e05248e-0a3b-3a5e-b885-abff11005d5f",
                                        "glosses": [
                                            "Acción o efecto de publicar."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dca80709-d774-4488-b198-b6f0145e0918",
                                                "sense_id": "58b0ef69-602a-37f1-b15e-3c1dec2970e7",
                                                "text": "«Y decimos de gracia que tal clérigo debe ser depuesto; pero hoy se establece por el cardenal que si algún clérigo tuviere amiga públicamente, que si la tuviere por dos meses después de la publicación de aquella constitución, que si fuere beneficiado, que haya pérdida de la tercera parte de los frutos de su beneficio (…)»."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1374ccf3-2fb9-3e62-9e22-dc186f257fde",
                                        "entry_id": "0e05248e-0a3b-3a5e-b885-abff11005d5f",
                                        "glosses": [
                                            "Obra artística o impreso literario que ha sido publicado."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18010c60-3ebd-4d21-b835-2f3c1f41d058",
                                                "sense_id": "1374ccf3-2fb9-3e62-9e22-dc186f257fde",
                                                "text": "«En cuanto a la finalidad buscada por esta publicación, debe advertirse que no está destinada a relatar hechos producidos por la subversión durante casi treinta años en nuestro país (desde la aparición de los “Uturuncos” en 1959, hasta el ataque al cuartel de La Tablada en 1989) ya que existen varias obras que con la mayor autoridad los relatan y analizan (…)»."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
