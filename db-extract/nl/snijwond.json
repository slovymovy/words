                "senses": [
                    {
                        "sense_id": "001bdbca-3fcf-3c01-81b6-5cefe54a221f",
                        "entry_id": "5f94e9f1-6da1-39f6-a85b-84bd3b275bda",
                        "glosses": [
                            "door snijden veroorzaakte wond"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af437211-1bcc-45ec-bd80-b11cef9d7eec",
                                "sense_id": "001bdbca-3fcf-3c01-81b6-5cefe54a221f",
                                "text": "Een snijwond is door een scherp voorwerp veroorzaakt en is vaak lang en smal, een heel korte snijwond noemen we een steekwond"
                            },
                            {
                                "example_id": "8dc32d08-62d5-4c32-ac8c-9bc5bd88301d",
                                "sense_id": "001bdbca-3fcf-3c01-81b6-5cefe54a221f",
                                "text": "Tennisster Petra Kvitova (26) is dinsdag in haar woning aangevallen door een man met een mes. De tweevoudig winnares van Wimbledon (2011 en 2014) liep daarbij snijwonden aan haar linkerhand op, liet haar manager weten in Tsjechische media. De linkshandige tennisster raakte niet levensbedreigend gewond, maar moest wel geopereerd worden. „Het ergste is al achter de rug”, meldde Kvitova op de Facebook-pagina van het Tsjechische team waarmee ze vorige maand de Fed Cup won."
                            }
                        ]
                    }
