{
    "word_family": [
        "clincher"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1b452504-acab-3822-9c56-2d415f931615",
                    "sense_definition": "To settle, confirm, or finalize a deal, argument, or victory conclusively.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The last presentation helped to <w>clinch</w> the deal for our team.",
                            "target_lang_translations": {
                                "nl": "De laatste presentatie hielp onze ploeg de deal <w>rond te krijgen</w>."
                            }
                        },
                        {
                            "text": "His final goal <w>clinched</w> the championship for the team.",
                            "target_lang_translations": {
                                "nl": "Zijn laatste doelpunt <w>stelde</w> het kampioenschap voor het team <w>veilig</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "finalize",
                        "secure",
                        "seal"
                    ],
                    "common_phrases": [
                        "clinch the deal",
                        "clinch victory"
                    ],
                    "target_lang_definitions": {
                        "nl": "Een deal, argument of overwinning definitief beslissen, bevestigen of afronden."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "rondkrijgen",
                                "target_lang_sense_clarification": "een overeenkomst definitief afronden"
                            },
                            {
                                "target_lang_word": "veiligstellen",
                                "target_lang_sense_clarification": "een overwinning, deal of resultaat veiligstellen"
                            },
                            {
                                "target_lang_word": "bezegelen",
                                "target_lang_sense_clarification": "formeel: definitief bekrachtigen of afronden"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5001db14-291d-3aaa-9c7a-3a155a1f51bf",
                    "sense_definition": "To secure or guarantee a position, playoff spot, or title in sports.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team managed to <w>clinch</w> a spot in the upcoming playoffs.",
                            "target_lang_translations": {
                                "nl": "Het team wist een plek in de komende play-offs <w>veilig te stellen</w>."
                            }
                        },
                        {
                            "text": "They hope to <w>clinch</w> a spot with a win this weekend.",
                            "target_lang_translations": {
                                "nl": "Ze hopen dit weekend met een overwinning een plek <w>veilig te stellen</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "clinch a spot",
                        "clinch a playoff spot",
                        "clinch the title"
                    ],
                    "target_lang_definitions": {
                        "nl": "In de sport een positie, play-offplek of titel veiligstellen of garanderen."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "veiligstellen",
                                "target_lang_sense_clarification": "in sport: een plek of titel zeker stellen"
                            },
                            {
                                "target_lang_word": "veroveren",
                                "target_lang_sense_clarification": "definitief bemachtigen"
                            },
                            {
                                "target_lang_word": "zekerstellen",
                                "target_lang_sense_clarification": "officieel zeker maken"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a6b83407-110b-3e50-a6c8-2747fa3e5342",
                    "sense_definition": "To hold tightly or clench.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He began to <w>clinch</w> his fist in anger during the debate.",
                            "target_lang_translations": {
                                "nl": "Hij begon tijdens het debat woedend zijn vuist <w>te ballen</w>."
                            }
                        },
                        {
                            "text": "She had to <w>clinch</w> her fists to stay calm.",
                            "target_lang_translations": {
                                "nl": "Ze moest haar vuisten <w>ballen</w> om kalm te blijven."
                            }
                        }
                    ],
                    "synonyms": [
                        "clench",
                        "grasp",
                        "grip"
                    ],
                    "common_phrases": [
                        "clinch his fist"
                    ],
                    "target_lang_definitions": {
                        "nl": "Stevig vasthouden of samenknijpen."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "ballen",
                                "target_lang_sense_clarification": "vuist of hand strak samentrekken"
                            },
                            {
                                "target_lang_word": "klemmen",
                                "target_lang_sense_clarification": "stevig dichtdrukken of samentrekken"
                            },
                            {
                                "target_lang_word": "vastgrijpen",
                                "target_lang_sense_clarification": "iets stevig vastgrijpen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ea492eb3-e5df-31b9-aaff-1c37a034d8c0",
                    "sense_definition": "To press or close tightly together, such as teeth or hands.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He tried not to <w>clinch</w> his teeth while listening to the painful news.",
                            "target_lang_translations": {
                                "nl": "Hij probeerde zijn tanden niet <w>op elkaar te klemmen</w> terwijl hij naar het pijnlijke nieuws luisterde."
                            }
                        },
                        {
                            "text": "Stress made her <w>clinch</w> her jaw tightly.",
                            "target_lang_translations": {
                                "nl": "Door stress ging ze haar kaak stevig <w>op elkaar klemmen</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "clench"
                    ],
                    "common_phrases": [
                        "clinch his teeth"
                    ],
                    "target_lang_definitions": {
                        "nl": "Stevig tegen elkaar drukken of sluiten, bijvoorbeeld tanden of handen."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "op elkaar klemmen",
                                "target_lang_sense_clarification": "tanden stevig op elkaar drukken"
                            },
                            {
                                "target_lang_word": "klemmen",
                                "target_lang_sense_clarification": "kaak of tanden gespannen dichtdrukken"
                            },
                            {
                                "target_lang_word": "op elkaar persen",
                                "target_lang_sense_clarification": "kaak samenpersen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "28260bae-4339-37e4-9374-c041a2659f14",
                    "sense_definition": "To hold an opponent with one or both arms in combat sports like boxing to prevent attacks or rest.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The boxer decided to <w>clinch</w> his opponent to catch his breath.",
                            "target_lang_translations": {
                                "nl": "De bokser besloot zijn tegenstander in een <w>clinch te nemen</w> om op adem te komen."
                            }
                        },
                        {
                            "text": "When exhausted, fighters often try to <w>clinch</w> during the late rounds.",
                            "target_lang_translations": {
                                "nl": "Als vechters uitgeput zijn, proberen ze in de latere rondes vaak te <w>clincheren</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "In vechtsporten een tegenstander met één of beide armen vasthouden om aanvallen te verhinderen of uit te rusten."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "in de clinch nemen",
                                "target_lang_sense_clarification": "in boksen of vechtsport: de tegenstander vastpakken om aanvallen te stoppen"
                            },
                            {
                                "target_lang_word": "clincheren",
                                "target_lang_sense_clarification": "zich aan de tegenstander vastklampen in een gevecht"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8197c624-7063-3d13-887a-cd14767c07cf",
                    "sense_definition": "To embrace or hug someone passionately.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lovers began to <w>clinch</w> tightly before saying goodbye.",
                            "target_lang_translations": {
                                "nl": "De geliefden begonnen elkaar stevig te <w>omhelzen</w> voordat ze afscheid namen."
                            }
                        },
                        {
                            "text": "They stood on the platform and started to <w>clinch</w> affectionately.",
                            "target_lang_translations": {
                                "nl": "Ze stonden op het perron en begonnen elkaar liefdevol te <w>omhelzen</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Iemand hartstochtelijk omarmen of vasthouden."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "omhelzen",
                                "target_lang_sense_clarification": "iemand hartstochtelijk vasthouden"
                            },
                            {
                                "target_lang_word": "innig omarmen",
                                "target_lang_sense_clarification": "innig tegen elkaar aan staan"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "302f2ae6-0de6-39c0-8eac-f9a31f2ecc05",
                    "sense_definition": "To bend over and flatten the protruding end of a nail so that it is secured.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The carpenter used a hammer to <w>clinch</w> the nail on the reverse side of the board.",
                            "target_lang_translations": {
                                "nl": "De timmerman gebruikte een hamer om de punt van de spijker aan de achterkant van de plank <w>om te slaan</w>."
                            }
                        },
                        {
                            "text": "Make sure you <w>clinch</w> the tip properly so it stays put.",
                            "target_lang_translations": {
                                "nl": "Zorg ervoor dat je de punt goed <w>omklinkt</w>, zodat die goed blijft zitten."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Het uitstekende uiteinde van een spijker ombuigen en plat slaan zodat die goed vastzit."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "omklinken",
                                "target_lang_sense_clarification": "de uitstekende punt van een spijker ombuigen zodat hij vastzit"
                            },
                            {
                                "target_lang_word": "omslaan",
                                "target_lang_sense_clarification": "de spijkerpunt aan de achterkant omslaan"
                            },
                            {
                                "target_lang_word": "omzetten",
                                "target_lang_sense_clarification": "technisch: ombuigen ter bevestiging"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5e019f8c-54a6-3f91-96c3-2b79b8d10b21",
                    "sense_definition": "To interlock, clasp, or entwine firmly.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gears will <w>clinch</w> together once the mechanism is engaged.",
                            "target_lang_translations": {
                                "nl": "De tandwielen zullen stevig <w>in elkaar grijpen</w> zodra het mechanisme wordt ingeschakeld."
                            }
                        },
                        {
                            "text": "Their fingers began to <w>clinch</w> as they walked through the crowd.",
                            "target_lang_translations": {
                                "nl": "Hun vingers begonnen zich <w>in elkaar te verstrengelen</w> terwijl ze door de menigte liepen."
                            }
                        }
                    ],
                    "synonyms": [
                        "clasp",
                        "interlock"
                    ],
                    "target_lang_definitions": {
                        "nl": "Stevig in elkaar haken, vastklemmen of verstrengelen."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "in elkaar grijpen",
                                "target_lang_sense_clarification": "stevig in elkaar haken"
                            },
                            {
                                "target_lang_word": "verstrengelen",
                                "target_lang_sense_clarification": "stevig samen vastmaken of verstrengelen"
                            },
                            {
                                "target_lang_word": "ineensluiten",
                                "target_lang_sense_clarification": "handen of vingers ineen sluiten"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3060571c-92e7-3755-96cb-d89b07d740ce",
                    "sense_definition": "To fasten or fix securely and permanently.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The blacksmith used heavy rivets to <w>clinch</w> the iron plates.",
                            "target_lang_translations": {
                                "nl": "De smid gebruikte zware klinknagels om de ijzeren platen stevig <w>te bevestigen</w>."
                            }
                        },
                        {
                            "text": "They had to <w>clinch</w> the structure to withstand strong winds.",
                            "target_lang_translations": {
                                "nl": "Ze moesten de constructie stevig <w>vastzetten</w> zodat die harde wind kon weerstaan."
                            }
                        }
                    ],
                    "synonyms": [
                        "fasten",
                        "attach"
                    ],
                    "target_lang_definitions": {
                        "nl": "Stevig en permanent vastmaken of bevestigen."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "bevestigen",
                                "target_lang_sense_clarification": "stevig en blijvend vastmaken"
                            },
                            {
                                "target_lang_word": "vastzetten",
                                "target_lang_sense_clarification": "goed vastzetten"
                            },
                            {
                                "target_lang_word": "vastklinken",
                                "target_lang_sense_clarification": "aan elkaar klinken of hechten"
                            }
                        ]
                    }
                }
            ]
        },
        {
