                        "form": "die Gebrauchsgegenstände"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ff74bba6-6548-3c6c-9668-23a2d1dcc80b",
                        "entry_id": "a2363a47-6d9d-398b-a173-1da26a2f715c",
                        "glosses": [
                            "ein Gegenstand für den alltäglichen Gebrauch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b80cc0a8-0665-4da1-94af-729b0cbc9cc7",
                                "sense_id": "ff74bba6-6548-3c6c-9668-23a2d1dcc80b",
                                "text": "„Da sind zunächst die Soldaten und Offiziere, die sich mit Gebrauchsgegenständen eindecken, die sie später auf dem sowjetischen Schwarzmarkt tauschen oder zu Geld machen wollen.“"
                            },
                            {
                                "example_id": "059aa8b4-a175-4064-8d82-532b98c73ad3",
                                "sense_id": "ff74bba6-6548-3c6c-9668-23a2d1dcc80b",
                                "text": "„In dem alten Bauernhaus mit seinem begrünten Dach, das vom Anfang des 19. Jahrhunderts bis 1950 bewohnt war, sind Gebrauchsgegenstände und Werkzeuge der Fischer und Bauern aus dem 19. und 20. Jahrhundert ausgestellt.“"
                            },
                            {
                                "example_id": "d2c221f1-060c-4478-ba71-e6d9642ef7d5",
                                "sense_id": "ff74bba6-6548-3c6c-9668-23a2d1dcc80b",
                                "text": "„Keine Pelzdecke und keiner unserer Pelzmäntel kam abhanden, denn dafür interessierten sich die Russen nicht; Pelze sind für sie offenbar reine Gebrauchsgegenstände, über die sie selbst reichlich verfügen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6df8cdfe-bad5-4f70-a936-eeb57f67a6d5",
                        "source_entry_id": "a2363a47-6d9d-398b-a173-1da26a2f715c",
                        "source_sense_id": "ff74bba6-6548-3c6c-9668-23a2d1dcc80b",
                        "source_sense_description": "ein Gegenstand für den alltäglichen Gebrauch",
                        "target_lang_word": "utensil",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "utensil",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "adc2c0c5-0732-309d-8e2c-0c981c37fe27",
                                        "entry_id": "4e4de9a0-3d52-397e-9c2a-3750ad766781",
                                        "glosses": [
                                            "An instrument or device for domestic use, especially in the kitchen."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c38bae0-ae9a-4142-abb6-cccdb7801c0c",
                                                "sense_id": "adc2c0c5-0732-309d-8e2c-0c981c37fe27",
                                                "text": "We have convenient storage for all the kitchen/eating utensils."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8d2a267c-3a88-3136-90d4-2a14644c8ca5",
                                        "entry_id": "4e4de9a0-3d52-397e-9c2a-3750ad766781",
                                        "glosses": [
                                            "A useful small tool, implement, or vessel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96f95455-dfb7-4a75-85e7-455e85917822",
                                                "sense_id": "8d2a267c-3a88-3136-90d4-2a14644c8ca5",
                                                "text": "He stocked up on old-style writing utensils."
                                            },
                                            {
                                                "example_id": "663141bd-98f0-4e79-b1b5-4919255c2f63",
                                                "sense_id": "8d2a267c-3a88-3136-90d4-2a14644c8ca5",
                                                "text": "Relations, sparing no expense'll/Send some useless old utensil,/Or a matching pen and pencil./\"just the thing I need! how nice!\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b30f71b9-d9b7-4610-87ab-4a65f3edb35f",
                        "source_entry_id": "a2363a47-6d9d-398b-a173-1da26a2f715c",
                        "source_sense_id": "ff74bba6-6548-3c6c-9668-23a2d1dcc80b",
                        "source_sense_description": "ein Gegenstand für den alltäglichen Gebrauch",
                        "target_lang_word": "implement",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "implement",
