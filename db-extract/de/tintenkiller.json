                                        "glosses": [
                                            "Stylo permettant d’effacer l’encre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5dac63d0-9238-4038-b29b-757b1a07e757",
                                                "sense_id": "7a07961f-436b-38dc-a497-1a530abc3ca0",
                                                "text": "Il utilise trop souvent son effaceur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "080513f5-5819-3586-bae3-8bb71f27e5e4",
                                        "entry_id": "3a40862c-b81b-3e45-ae8e-fe61257e8380",
                                        "glosses": [
                                            "Qui estompe ou supprime."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d94725cc-2d76-4570-9738-25e159db1e55",
                                                "sense_id": "080513f5-5819-3586-bae3-8bb71f27e5e4",
                                                "text": "Adrien Simkolochuski appartenait à cette race d’artisans pour qui toute journée passée est une journée de gagnée. Il vivait avec une sorte d’effaceur dans la tête. Sitôt qu’il avait raccroché, qu’il n’entendait pas votre voix, vous n’existiez plus."
                                            },
                                            {
                                                "example_id": "b2ebf07d-4ac4-4f68-b111-0091b1502cf9",
                                                "sense_id": "080513f5-5819-3586-bae3-8bb71f27e5e4",
                                                "text": "On veut protéger un art de vivre qui est un brassage culturel populaire, un effaceur social, ethnique et confessionnel."
                                            }
                                        ]
                                    }
                                ]
