                    },
                    {
                        "translation_id": "3a5c059a-5e89-47ec-a269-d5a8013f68ad",
                        "source_entry_id": "84ad30f0-0539-316f-b0d4-42f4ed54eabe",
                        "source_sense_id": "9e5531e3-ad1e-357c-b224-a08fec31cde6",
                        "source_sense_description": "use, and pass off as one's own, someone else's writing/speech",
                        "target_lang_word": "abkupfern",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abkupfern",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0bdbf412-a073-347a-b717-74a2ffb54222",
                                        "entry_id": "2aa2f42f-f578-3234-a609-bd96933b1021",
                                        "glosses": [
                                            "ein Plagiat / eine Kopie ohne Erlaubnis erstellen"
                                        ],
                                        "tags": [
                                            "negative Konnotation"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a6761f6d-793d-443f-a702-83a78d24a4c6",
                                                "sense_id": "0bdbf412-a073-347a-b717-74a2ffb54222",
                                                "text": "»Du kannst dieses Kapitel für Deine Hausarbeit nicht einfach abkupfern!«"
                                            },
                                            {
                                                "example_id": "06601d8c-1b38-47d4-b7e2-bfca7d6a6448",
                                                "sense_id": "0bdbf412-a073-347a-b717-74a2ffb54222",
                                                "text": "„Studierenden, die aus dem Internet oder von anderen Veröffentlichungen abkupfern, droht in Baden-Württemberg der Rauswurf aus der Universität.“"
                                            },
                                            {
                                                "example_id": "138c9947-b065-455c-bd1d-30150c1293b8",
                                                "sense_id": "0bdbf412-a073-347a-b717-74a2ffb54222",
                                                "text": "„»Herr Sattler, Sie promovieren gerade selbst an der Universität Bielefeld, wie kommen Sie darauf, dass Studierende so viel abkupfern?«“"
                                            },
                                            {
                                                "example_id": "e5e14806-cdbb-4698-a5fa-5f91a322c40f",
                                                "sense_id": "0bdbf412-a073-347a-b717-74a2ffb54222",
                                                "text": "„[…] die Studierenden und Doktoranden [sollen] eigene Leistungsnachweise bringen und nicht einfach nur abkupfern.“"
                                            },
                                            {
                                                "example_id": "0ffa3709-85b0-469c-ac03-7a62d6451e52",
                                                "sense_id": "0bdbf412-a073-347a-b717-74a2ffb54222",
                                                "text": "„Auch wer das Layout einer Website abkupfert, könne Probleme bekommen, so Stefan.“"
                                            },
                                            {
                                                "example_id": "dd4dea1c-e76f-4c49-a838-720538f28daa",
                                                "sense_id": "0bdbf412-a073-347a-b717-74a2ffb54222",
                                                "text": "„Damit aber nicht jeder bei jedem beliebig und nach Gutdünken kopieren, abkupfern oder Ideenklau betreiben kann, gibt es rechtliche Grundsätze, die den Urheber schützen, das Copyright.“"
                                            },
                                            {
                                                "example_id": "1469531d-818b-4ebf-8d83-cb0c2887f7d3",
                                                "sense_id": "0bdbf412-a073-347a-b717-74a2ffb54222",
                                                "text": "„Präsidentschaftskandidatin Marine Le Pen soll laut der Zeitung «Le Monde» Teile einer Rede bei ihrem einstigen Konkurrenten François Fillon abgekupfert haben.“"
                                            },
                                            {
                                                "example_id": "64836671-d7c4-41f4-aa7c-1cde0f8df023",
                                                "sense_id": "0bdbf412-a073-347a-b717-74a2ffb54222",
                                                "text": "„Chapmans Patentrezept [Anmerkung: für eine Giftspritze für zum Tode Verurteilte] wurde in Oklahoma zum Gesetz. Texas kupferte es umgehend ab und weitere 35 Bundesstaaten schlossen sich an.“"
                                            },
                                            {
                                                "example_id": "cba56abe-e6a4-4323-b3bd-6fdf0ed9455d",
                                                "sense_id": "0bdbf412-a073-347a-b717-74a2ffb54222",
                                                "text": "„[Europäische Jazzmusiker] kupferten bei ihren amerikanischen Kollegen ab, manchmal besser, manchmal schlechter.“"
                                            },
                                            {
                                                "example_id": "5ed4056e-bb56-49da-8347-d6cf282cb346",
                                                "sense_id": "0bdbf412-a073-347a-b717-74a2ffb54222",
                                                "text": "„Gerade erst hat ein Gericht entschieden, dass Katy Perry 2,78 Millionen Dollar an den Rapper Flame zahlen muss, weil ihr Song \"Dark Horse\" von ihm abgekupfert sein soll.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
