            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "5f3715e3-9e98-3469-b168-ae3ce86a58ef",
                    "sense_definition": "duidelijk waarneembaar, concreet of fysiek aanwezig",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "concreet",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De directeur eiste <w>tastbare</w> resultaten van zijn personeel.",
                            "target_lang_translations": {
                                "en": "The director demanded <w>tangible</w> results from his staff."
                            }
                        },
                        {
                            "text": "In tegenstelling tot het investeren in crypto is een verkoopautomaat iets heel <w>tastbaars</w>.",
                            "target_lang_translations": {
                                "en": "In contrast to investing in crypto, a vending machine is something very <w>tangible</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "concreet",
                        "voelbaar",
                        "merkbaar"
                    ],
                    "antonyms": [
                        "ontastbaar"
                    ],
                    "common_phrases": [
                        "tastbare resultaten",
                        "tastbaar bewijs"
                    ],
                    "target_lang_definitions": {
                        "en": "clearly perceptible, concrete, or physically present"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "tangible",
                                "target_lang_sense_clarification": "concrete and perceptible"
                            },
                            {
                                "target_lang_word": "concrete",
                                "target_lang_sense_clarification": "real and specific rather than general"
                            },
                            {
                                "target_lang_word": "noticeable",
                                "target_lang_sense_clarification": "easily seen or noticed"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f8b2411f-f2a1-3bfc-89c0-e76dda6e9e85",
                    "sense_definition": "met de handen aan te raken",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fysiek_aanraakbaar",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De geschiedenis werd <w>tastbaar</w> toen we de oude voorwerpen mochten aanraken.",
                            "target_lang_translations": {
                                "en": "History became <w>tangible</w> when we were allowed to touch the old objects."
                            }
                        },
                        {
                            "text": "Zij verlangde naar een <w>tastbare</w> herinnering aan haar grootmoeder.",
                            "target_lang_translations": {
                                "en": "She longed for a <w>tangible</w> keepsake of her grandmother."
                            }
                        }
                    ],
                    "synonyms": [
                        "aanraakbaar",
                        "palpabel"
                    ],
                    "antonyms": [
                        "ontastbaar"
                    ],
                    "common_phrases": [
                        "tastbare herinnering"
                    ],
                    "target_lang_definitions": {
                        "en": "able to be touched with the hands"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "tangible",
                                "target_lang_sense_clarification": "able to be touched physically"
                            },
                            {
                                "target_lang_word": "palpable",
                                "target_lang_sense_clarification": "so intense as to seem almost tangible"
                            },
                            {
                                "target_lang_word": "touchable",
                                "target_lang_sense_clarification": "physically touchable"
                            }
                        ]
                    }
                }
            ]
