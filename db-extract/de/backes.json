                "senses": [
                    {
                        "sense_id": "0298032e-a526-3343-a54a-64e893851906",
                        "entry_id": "08702a1a-41ea-386b-adf0-fc6388688b87",
                        "glosses": [
                            "Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce1caff0-6719-451c-b4c2-a82a5c75157a",
                                "sense_id": "0298032e-a526-3343-a54a-64e893851906",
                                "text": "Frau Backes ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "c0bcee80-fd18-4d26-a328-329e94c05114",
                                "sense_id": "0298032e-a526-3343-a54a-64e893851906",
                                "text": "Herr Backes wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "05803881-5dcc-4ac1-bf26-dd3756a6701a",
                                "sense_id": "0298032e-a526-3343-a54a-64e893851906",
                                "text": "Die Backesens fliegen heute nach Liverpool."
                            },
                            {
                                "example_id": "484fd1af-893a-4b09-a423-13ec817d7ada",
                                "sense_id": "0298032e-a526-3343-a54a-64e893851906",
                                "text": "Der Backes trägt nie die Pullover, die die Backes ihm strickt."
                            },
                            {
                                "example_id": "eb46345c-a294-447f-9598-cd29ee77324a",
                                "sense_id": "0298032e-a526-3343-a54a-64e893851906",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Backes kommt, geht der Herr Backes.“"
                            },
                            {
                                "example_id": "e570efdc-7516-4ad5-aeab-e1a4be6eb54f",
                                "sense_id": "0298032e-a526-3343-a54a-64e893851906",
                                "text": "Backes kommt und geht."
                            },
                            {
                                "example_id": "914731d3-1fff-4e7d-82ea-5311c6c3e288",
                                "sense_id": "0298032e-a526-3343-a54a-64e893851906",
                                "text": "Backes kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
