        "nl-extract.jsonl": [
            {
                "entry_id": "3606ddea-9fbe-3889-8d59-7c710f147520",
                "word": "muskus",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d111a5b5-b87e-3d53-aaf1-68753c544735",
                        "entry_id": "3606ddea-9fbe-3889-8d59-7c710f147520",
                        "glosses": [
                            "de geurstof uitgescheiden door de geurklieren van bepaalde zoogdieren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b71eaedc-ed8a-4431-a75e-860cf3f2d532",
                                "sense_id": "d111a5b5-b87e-3d53-aaf1-68753c544735",
                                "text": "Sommige mensen vinden muskus lekker reuken, maar ik vind het te aanwezig."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cbcf7106-9782-4e00-b6b2-1a9d5a8b6874",
                        "source_entry_id": "3606ddea-9fbe-3889-8d59-7c710f147520",
                        "source_sense_id": "d111a5b5-b87e-3d53-aaf1-68753c544735",
                        "source_sense_description": "de geurstof uitgescheiden door de geurklieren van bepaalde zoogdieren",
                        "target_lang_word": "Moschus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Moschus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "53937980-bbd0-358c-b1dc-fc5eb1f20d44",
                                        "entry_id": "4995b194-f5d3-388f-8329-3c68637fc97f",
                                        "glosses": [
                                            "Sekret aus der Drüse eines Moschushirsches"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea6bbfc0-5c3b-425f-944a-f0560138b9e8",
                                                "sense_id": "53937980-bbd0-358c-b1dc-fc5eb1f20d44",
                                                "text": "„Die Luft in der Stube war angefüllt mit dem Duft von Moschus und Narde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5d7ecf1d-1c0a-3df6-b07e-80d5c801d179",
                                        "entry_id": "4995b194-f5d3-388f-8329-3c68637fc97f",
                                        "glosses": [
                                            "Duftstoff, der als Produkt aus dem Sekret [1] gewonnen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7362138c-b0a0-4e98-ab6a-b2de64b671b0",
                                                "sense_id": "5d7ecf1d-1c0a-3df6-b07e-80d5c801d179",
                                                "text": "„Ihre Haut roch nach Moschus und einer herben Minznote.“"
                                            },
                                            {
                                                "example_id": "9f4ac9f0-1e78-4e62-b1d7-5294a94d2521",
                                                "sense_id": "5d7ecf1d-1c0a-3df6-b07e-80d5c801d179",
                                                "text": "„Aber die rochen ja alle so, nach Patschuli oder Moschus.“"
                                            },
                                            {
                                                "example_id": "6ca580dd-d394-45e7-b167-3098efb5a260",
                                                "sense_id": "5d7ecf1d-1c0a-3df6-b07e-80d5c801d179",
                                                "text": "„Ich gehorchte respektvoll, aber ein Pestgeruch von Moschus, der mich an einen Leichnam erinnerte, hätte mich beinahe ohnmächtig gemacht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
