                                        "entry_id": "00e66cc4-c3c4-328e-ac5b-c870ebf11e09",
                                        "glosses": [
                                            "Polygone qui a quatre côtés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33c2952a-72b5-46b1-bd30-53d1e0ae7643",
                                                "sense_id": "64f9cdff-45de-3350-b9fc-c6d264d86b1e",
                                                "text": "Les côtés d’un quadrilatère."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "249d4e34-6604-3123-9615-0a88b859e695",
                                        "entry_id": "00e66cc4-c3c4-328e-ac5b-c870ebf11e09",
                                        "glosses": [
                                            "Espace limité par quatre côtés."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "606f2afd-ccdc-47a2-9765-35fc1f084b16",
                                                "sense_id": "249d4e34-6604-3123-9615-0a88b859e695",
                                                "text": "Le troupeau des faisans fonctionne dans le quadrilatère que forment les rues Montmartre et Richelieu d’un côté, les boulevards et le rue Réaumur de l’autre."
                                            },
                                            {
                                                "example_id": "72347593-8a0d-4de9-9420-686256d2bcb6",
                                                "sense_id": "249d4e34-6604-3123-9615-0a88b859e695",
                                                "text": "Ils ont ensuite déambulé dans le quadrilatère autour du quartier général du Service de police de SherbrookeSPS, escortés par les policiers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f9f373f-96af-3c71-9db0-07fa492241a5",
                                        "entry_id": "00e66cc4-c3c4-328e-ac5b-c870ebf11e09",
                                        "glosses": [
                                            "Bloc de terrain compris entre les rues qui le bordent. → voir pâté de maisons"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87494c29-d144-4adb-a7e1-1a68e08f599a",
                                                "sense_id": "4f9f373f-96af-3c71-9db0-07fa492241a5",
                                                "text": "Ces édifices en vinrent à occuper des quadrilatères complets."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8a66e73b-9e11-35fd-a788-39007b2567af",
                                        "entry_id": "00e66cc4-c3c4-328e-ac5b-c870ebf11e09",
                                        "glosses": [
                                            "Espace limité par quatre côtés, dont quatre forteresses occupent les angles."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "689aa475-ce49-4812-ad97-70716316e672",
                                                "sense_id": "8a66e73b-9e11-35fd-a788-39007b2567af",
                                                "text": "Ces quatre forteresses sont placées de manière à former un quadrilatère."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "quadrilatère",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "62e710f0-6f8c-3fa9-afad-6db644c07f87",
                                        "entry_id": "d30fb55e-59dd-3e2d-af6e-cef5fdbcdd32",
                                        "glosses": [
                                            "Qui a quatre côtés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90a6d845-5e73-4d1b-8208-af1f76a45f16",
                                                "sense_id": "62e710f0-6f8c-3fa9-afad-6db644c07f87",
                                                "text": "Appliqué contre la face externe de la branche du maxillaire inférieur, le masséter est court, large et très-épais, aplati d’un côté à l’autre, de forme irrégulièrement quadrilatère, formé de plans superposés dont deux principaux, qui sont parfaitement distincts, près de l’articulation temporo-maxillaire, par la direction un peu différente de leurs fibres."
                                            },
                                            {
                                                "example_id": "56acb375-79df-4cfa-9b31-6137645619f9",
                                                "sense_id": "62e710f0-6f8c-3fa9-afad-6db644c07f87",
                                                "text": "Les labiales supérieures sont au nombre de six, et de grandeur assez inégale ; […] elles ont une forme quadrilatère […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
