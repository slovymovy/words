                ],
                "senses": [
                    {
                        "sense_id": "3ef408c3-0fac-376a-bf80-795cc0ce7437",
                        "entry_id": "8139c4c2-a65e-394f-ab76-9a8e04f0d7ce",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ea5f107-db04-4325-afbd-2010f475bea8",
                                "sense_id": "3ef408c3-0fac-376a-bf80-795cc0ce7437",
                                "text": "Frau Holfelder ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "0817d2e6-591e-4918-97b7-c84509ab8076",
                                "sense_id": "3ef408c3-0fac-376a-bf80-795cc0ce7437",
                                "text": "Herr Holfelder wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "1815bc80-0df9-498a-b2f7-db4c1401463b",
                                "sense_id": "3ef408c3-0fac-376a-bf80-795cc0ce7437",
                                "text": "Die Holfelders fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "fd0f495c-cb2c-4928-9893-17c2e36c65f3",
                                "sense_id": "3ef408c3-0fac-376a-bf80-795cc0ce7437",
                                "text": "Der Holfelder trägt nie die Schals, die die Holfelder ihm strickt."
                            },
                            {
                                "example_id": "2b2026cf-eba0-40bb-b94e-f85bf78848ec",
                                "sense_id": "3ef408c3-0fac-376a-bf80-795cc0ce7437",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Holfelder kommt, geht der Herr Holfelder.“"
                            },
                            {
                                "example_id": "fba68c38-10fc-4845-b48d-5554f2a8e5eb",
                                "sense_id": "3ef408c3-0fac-376a-bf80-795cc0ce7437",
                                "text": "Holfelder kommt und geht."
                            },
                            {
                                "example_id": "668eae10-71c3-45c9-aa1c-e17cb5bae715",
                                "sense_id": "3ef408c3-0fac-376a-bf80-795cc0ce7437",
                                "text": "Holfelders kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
