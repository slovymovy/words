                                        "sense_id": "dc147013-e0d4-3a1f-974e-83964dabbf76",
                                        "entry_id": "c6ab46bd-04fb-3a7a-9b8e-589e7c7118ed",
                                        "glosses": [
                                            "Personne qui mène une vie dissolue ; débauché."
