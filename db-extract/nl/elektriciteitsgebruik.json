                        "examples": [
                            {
                                "example_id": "1087e70d-e21b-4bf0-aba4-9951dc34328e",
                                "sense_id": "2e9270c5-2fe0-3511-80ec-4929742a196b",
                                "text": "Schone energie betekent vaak schone elektriciteit. Het elektriciteitsnetwerk in Nederland kan zonder ingrijpende wijzigingen de verwachte toename van het elektriciteitsgebruik niet aan."
                            },
                            {
                                "example_id": "c2f2aedd-8643-4a5e-becf-2788e37921f3",
                                "sense_id": "2e9270c5-2fe0-3511-80ec-4929742a196b",
                                "text": "Denemarken is wel goed op weg om helemaal zelfvoorzienend en duurzaam te worden. In 2020 wil het land 35 procent van de gebruikte energie duurzaam opwekken. Daarnaast willen de Denen 50 procent van het elektriciteitsgebruik in 2020 halen uit windenergie. In 2050 willen de Denen 100 procent duurzame energie hebben."
                            }
                        ]
