                "senses": [
                    {
                        "sense_id": "7c600117-8647-331d-b0e9-b2c7f90076f4",
                        "entry_id": "4a40334d-1714-32ec-90d3-3728887ce4db",
                        "glosses": [
                            "Qui déconcerte fortement."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "2bb37f23-2d86-481d-840a-7511e8938312",
                                "sense_id": "7c600117-8647-331d-b0e9-b2c7f90076f4",
                                "text": "C’est une nouvelle renversante."
                            },
                            {
                                "example_id": "ebe6302a-4021-44b6-a7b9-7be2f56800f2",
                                "sense_id": "7c600117-8647-331d-b0e9-b2c7f90076f4",
                                "text": "Des gens qui me connaissent ont beau me soutenir qu’il n’y avait rien là de si renversant, moi je persiste à trouver au moins curieux que ma mère m’ait parlé, sans en rien savoir, de ce livre que j’étais justement en train d’écrire."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "9d8d5876-6fd0-3d10-8f28-5704326a4f15",
                "word": "renversant",
                "pos": "verb",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "cd8d1601-b5f9-3764-a6c6-495eb688330f",
                        "entry_id": "9d8d5876-6fd0-3d10-8f28-5704326a4f15",
                        "glosses": [
                            "Participe présent de renverser."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "16c33dcc-2f4a-4817-bd0f-816949673a16",
                                "sense_id": "cd8d1601-b5f9-3764-a6c6-495eb688330f",
                                "text": "Trois jours durant, trois nuits d’horreur, la mer franchit les digues, effondra la falaise, balayant tout dans son irrésistible furie, éventrant les champs saccagés, renversant les chaumières et laissant sur le rivage, lorsqu’elle s’apaisa, un monstre comme seul en peut produire l’Enfer."
                            }
                        ]
                    }
                ],
