                "senses": [
                    {
                        "sense_id": "ece789e7-df88-3397-95b1-f133230d3b39",
                        "entry_id": "b660b049-8437-3335-a65e-c1aa6e37a5f4",
                        "glosses": [
                            "Donner un caractère mandarinal à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d04a890-d5f4-40d2-ba3d-1086f51f7e11",
                                "sense_id": "ece789e7-df88-3397-95b1-f133230d3b39",
                                "text": "Et là est ma terreur pour son œuvre parce que ces animaux malfaisants sont puissants, en ce pays de France, plus mandarinisé que la Chine."
                            },
                            {
                                "example_id": "769188a7-aba0-4d26-95fd-6ef9ec7e4db9",
                                "sense_id": "ece789e7-df88-3397-95b1-f133230d3b39",
                                "text": "Wittgenstein représente un comble du présocratisme dans un monde qui alexandrinise et mandarinise à mort."
                            }
                        ]
                    },
                    {
                        "sense_id": "6a9e75bf-19ba-38c1-851a-c2d11f8961f1",
                        "entry_id": "b660b049-8437-3335-a65e-c1aa6e37a5f4",
                        "glosses": [
                            "Faire adopter la langue mandarine à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e04102e8-c65c-4899-9ecf-f01401e5a7fb",
                                "sense_id": "6a9e75bf-19ba-38c1-851a-c2d11f8961f1",
                                "text": "Lorsque la Chine s'étend sur de nouveaux territoires comme au Tibet, Xinjiang ou en Mongolie, elle « sinise » progressivement les populations. Ici, non. Hong Kong aurait plutôt tendance à se « mandariniser »."
                            }
                        ]
                    }
