                    }
                ],
                "senses": [
                    {
                        "sense_id": "7792d849-b9de-3a64-b768-bf46dfdfb403",
                        "entry_id": "740fac28-6b22-3edf-8bc9-7e35c0759a69",
                        "glosses": [
                            "Revêtement de façade au mortier qui, coloré dans la masse et posé en couches successives de couleurs différentes, fait apparaître, par grattage des couches superficielles et selon un dessin voulu, un motif ornemental."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "261c920b-4508-4326-9673-e5a663265898",
                                "sense_id": "7792d849-b9de-3a64-b768-bf46dfdfb403",
                                "text": "Une frise de sgraffite aux tons délicieusement veloutés se développe dans l’entablement de cette façade."
                            }
                        ]
                    },
                    {
                        "sense_id": "f43b98a9-97ac-3197-b05c-8d82cfae6f29",
                        "entry_id": "740fac28-6b22-3edf-8bc9-7e35c0759a69",
                        "glosses": [
                            "Pratique qui consiste à creuser, à gratter ou à inciser une surface afin de créer un graffiti."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "ff3c97f2-4abc-3b07-8ac8-867f37881690",
                        "entry_id": "740fac28-6b22-3edf-8bc9-7e35c0759a69",
                        "glosses": [
                            "Le graffiti ainsi obtenu."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9f28068e-5469-418a-a945-7c84abbc052b",
                        "source_entry_id": "740fac28-6b22-3edf-8bc9-7e35c0759a69",
                        "source_sense_id": "7792d849-b9de-3a64-b768-bf46dfdfb403",
                        "target_lang_word": "Sgraffito",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sgraffito",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "afbd1c22-5b9c-3931-a241-4d50b00b72c9",
                                        "entry_id": "acce1b25-d8db-3fa6-be0d-06930b61ecb8",
                                        "glosses": [
                                            "Art der wetterbeständigen Fassadenmalerei, bei der zunächst auf Rohputz verschiedenfarbige Putzschichten aufgetragen werden und dann durch ein unterschiedlich tiefes Kratzen mit einem Kratzeisen mehrfarbige Motive kreiert werden"
                                        ],
                                        "tags": [
                                            "Bildende Kunst"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "48e1d4f4-efe1-42e7-b105-008dc6332722",
                                                "sense_id": "afbd1c22-5b9c-3931-a241-4d50b00b72c9",
                                                "text": "Vor allem in der italienischen Renaissance wurden viele Sgraffiti geschaffen."
                                            },
                                            {
                                                "example_id": "47eb72f5-648f-44a1-b1df-c02c44266de7",
                                                "sense_id": "afbd1c22-5b9c-3931-a241-4d50b00b72c9",
                                                "text": "Sgraffiti und Graffiti, beide Bezeichnungen standen synonym für eine Technik der Fassadengestaltung, einer Kratzputztechnik, bei welcher verschiedenfarbige Putzschichten aufgetragen und dann durch Wegkratzen der oberen Schicht reliefartige Motive gestaltet wurden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d612eddd-9f63-47c9-a8db-fcb475a5615e",
                        "source_entry_id": "740fac28-6b22-3edf-8bc9-7e35c0759a69",
                        "source_sense_id": "7792d849-b9de-3a64-b768-bf46dfdfb403",
                        "target_lang_word": "sgraffito",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sgraffito",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "edd63097-d24e-3e57-98c5-dfbee2631f70",
                                        "entry_id": "554af221-8edc-397f-a738-0e5ef5f83cc5",
                                        "glosses": [
                                            "A technique in ceramics, art and wall design, where the top layer of pigment or slip is scratched through to reveal an underlying layer."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0330787c-fb04-4e7f-b899-00fe52d9a567",
                                                "sense_id": "edd63097-d24e-3e57-98c5-dfbee2631f70",
                                                "text": "Through color and tone Byzantine potters gave to sgraffito pottery qualities that go beyond the contrasts possible in metalwork. And the history of the colors in their use on Byzantine sgraffito ware again takes us back to Tang China."
                                            },
                                            {
                                                "example_id": "feaa79bf-ee0b-4ef6-bd71-b3af12dd1bc8",
                                                "sense_id": "edd63097-d24e-3e57-98c5-dfbee2631f70",
                                                "text": "Sgraffito is a valuable design technique for working with slips[…], but did you know that this technique has other applications? With leather-hard clay you can incise (cut into) the clay surface. […] To make smooth lines in a raw-glazed surface, first cover the area with liquid wax. Then, using any sharp-edged tool, scratch through the wax and into the glaze, pressing deeply enough to reveal the clay body underneath[…]. When the piece is fired, the wax will burn off and the glaze will pull back from the sgraffito scratches to reveal the underlying clay."
                                            },
                                            {
                                                "example_id": "302d0725-d363-4a54-a00e-0d2af5b01b73",
                                                "sense_id": "edd63097-d24e-3e57-98c5-dfbee2631f70",
                                                "text": "Sgraffito is not only weather resistant but also requires less artistic skill than alfresco painting. Although scratch work was used in Germany from the 13th century (e.g. Magdeburg Cathedral, cloisters), true sgraffito developed in Italy and spread from there. Decoration of a plastered façade with simulated regular stonework existed in Florence from the late 13th century, two-tone decorations from the 15th century. The early sgraffito decorations follow on from the medieval practice of using overlay and ornamentation on buildings and reflect the way in which stone is worked."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af8e4508-636a-3108-b6a0-4181d8a022ba",
                                        "entry_id": "554af221-8edc-397f-a738-0e5ef5f83cc5",
                                        "glosses": [
                                            "An instance or sample of sgraffito."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c3d06fbf-643a-4082-ab77-1767eb10eadc",
                                                "sense_id": "af8e4508-636a-3108-b6a0-4181d8a022ba",
                                                "text": "[I]n the corner room a sitting platform, 3 ft. broad, as well as a large fireplace, were brought to light, while in the hall (E. iii.), open towards the south, the rough plaster surface of the partly well-preserved east wall proved to be covered with sgraffiti both Tibetan and Chinese."
                                            },
                                            {
                                                "example_id": "d4b21a64-e754-4cd0-b71e-1371097d1338",
                                                "sense_id": "af8e4508-636a-3108-b6a0-4181d8a022ba",
                                                "text": "The few surviving examples of early sgraffiti are thought to be late 14th century and have a mediaeval quality about them. Ugo Procacci points out that the technique of two contrasting colours was seldom used and most of them are pure and simple sgraffiti."
                                            },
                                            {
                                                "example_id": "8c11c25c-1941-4817-8037-fda617486dc5",
                                                "sense_id": "af8e4508-636a-3108-b6a0-4181d8a022ba",
                                                "text": "I did murals there as well, designs for windows, bas relief and otherwise, sgraffitoes – a very special technique cut in stucco."
                                            },
                                            {
                                                "example_id": "464c6052-e734-47c7-bc02-f90f02324ec8",
                                                "sense_id": "af8e4508-636a-3108-b6a0-4181d8a022ba",
                                                "text": "[Josep] Puig [i Cadafalch] wanted to emphasize the ornamentation of the stone window frames of the facade by contrasting it against the white stucco sgraffitos."
                                            },
                                            {
                                                "example_id": "451c867f-ba58-48f7-84d5-925ff9eb8d27",
                                                "sense_id": "af8e4508-636a-3108-b6a0-4181d8a022ba",
                                                "text": "SGRAFFITI. Artwork painted on the exterior of private homes, sgraffiti emerged at the end of the 19th century, when city officials encouraged urban beautification by organizing competitions for decorating house fronts. Several techniques developed; the most common one involves applying a light-colored base to the surface, after which portions of the base are scratched away while still wet, leaving the support medium to show through in displaying a drawing."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sgraffito",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4c9c4dfe-8409-37b8-9a69-ae661318e99a",
                                        "entry_id": "74482028-84a8-3c1f-906e-7bec388756f1",
                                        "glosses": [
                                            "To produce a design using this technique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7e2378d-6fb7-4149-afad-cded591ee7ee",
                                                "sense_id": "4c9c4dfe-8409-37b8-9a69-ae661318e99a",
                                                "text": "Use a ceramic tool or any pointer to sgraffito the lines in the enamel powder."
                                            },
                                            {
                                                "example_id": "8f724260-061c-4f56-b061-8898f2a87f84",
                                                "sense_id": "4c9c4dfe-8409-37b8-9a69-ae661318e99a",
                                                "text": "A West African woman sgraffitoes a traditional pattern […]"
                                            },
                                            {
                                                "example_id": "93cc77ce-a720-4c6c-941f-5d8d0ad91e96",
                                                "sense_id": "4c9c4dfe-8409-37b8-9a69-ae661318e99a",
                                                "text": "The last gasp of the British inscribed-pottery tradition is represented by the \"motto wares\" that became a specialty of South Devon potteries such as Aller Vale in the late 1800s. Homey and comical sayings, sometimes poetic or in stereotyped West Country dialect, were sgraffitoed on wares for tourists on holiday in the coastal town of Torquay."
                                            },
                                            {
                                                "example_id": "d56aace9-3a18-4814-aeb4-abcb6352c5a3",
                                                "sense_id": "4c9c4dfe-8409-37b8-9a69-ae661318e99a",
                                                "text": "I paint or pour onto the piece, […] and then use the spaces to play with either trailing, using the slip trailers to flick, or thickly spurt the colours onto the piece, sgraffitoing and painting and using slip trailers in a more restrained fashion to draw with. I think I am guided by intuition or my own response to each piece as I decorate it, rather than by any conscious outside influence."
                                            },
                                            {
                                                "example_id": "aa556ebb-7349-4b0f-8864-766a4d9f4af6",
                                                "sense_id": "4c9c4dfe-8409-37b8-9a69-ae661318e99a",
                                                "text": "I use a calligraphy pen with a rounded scratch nib and a stylus for my sgraffito work. Deciding when to sgraffito the piece depends on how wet you like the slip. I prefer a leather-hard surface but some potters prefer to sgraffito right after the slip has been applied and others like to sgraffito when the slip is bone dry."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c388324b-18be-4023-9f5a-16097d3e36ad",
                        "source_entry_id": "740fac28-6b22-3edf-8bc9-7e35c0759a69",
