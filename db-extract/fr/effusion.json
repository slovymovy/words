        "fr-extract.jsonl": [
            {
                "entry_id": "69a7c1ea-7c84-3905-97b7-aa1e0d62ac4c",
                "word": "effusion",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "5ca03b46-96e7-4694-a239-ec2fc4f456df",
                        "entry_id": "69a7c1ea-7c84-3905-97b7-aa1e0d62ac4c",
                        "tags": [
                            "plural"
                        ],
                        "form": "effusions"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d74b000c-983c-3e09-ad7d-8aa833ce3ef9",
                        "entry_id": "69a7c1ea-7c84-3905-97b7-aa1e0d62ac4c",
                        "glosses": [
                            "Action de répandre un liquide, de se répandre, en parlant d’un liquide, ou résultat de cette action."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61f79d76-9d2c-49bc-8c57-0a6fcc8a1fba",
                                "sense_id": "d74b000c-983c-3e09-ad7d-8aa833ce3ef9",
                                "text": "…autre précaution que l’on prenait habituellement pour empêcher une inutile effusion de sang, la durée trop prolongée d’un jeu si meurtrier."
                            }
                        ]
                    },
                    {
                        "sense_id": "ae439db7-0564-3516-a57a-fa2e76f3afcb",
                        "entry_id": "69a7c1ea-7c84-3905-97b7-aa1e0d62ac4c",
                        "glosses": [
                            "Vive et sincère manifestation d’un sentiment, épanchement."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "500386f9-a645-4e81-bfab-eec53a693a59",
                                "sense_id": "ae439db7-0564-3516-a57a-fa2e76f3afcb",
                                "text": "L'accent avec lequel madame d'Aiglemont prononça ces paroles peignit une effusion de cœur et une émotion intime, dont il serait difficile de donner une idée sans employer le mot de sainteté."
                            },
                            {
                                "example_id": "3e63affc-25ca-4166-bb81-bfee01b7b978",
                                "sense_id": "ae439db7-0564-3516-a57a-fa2e76f3afcb",
                                "text": "Cette femme héroïque, qui a joué un si grand rôle dans l’histoire de la Servie, me reçut avec une sorte d’effusion pleine de dignité, d’empressement et de curiosité."
                            },
                            {
                                "example_id": "03384d0b-e91a-421b-bf29-5658fe9a4b1c",
                                "sense_id": "ae439db7-0564-3516-a57a-fa2e76f3afcb",
                                "text": "Vous avez sauvé la vie de ma nièce, lui dit le général avec effusion, comment m’acquitterai-je jamais envers vous ?"
                            },
                            {
                                "example_id": "0253101a-b3ac-41ed-98ab-489dd7ef0a7b",
                                "sense_id": "ae439db7-0564-3516-a57a-fa2e76f3afcb",
                                "text": "Elle parlait vite, avec une effusion de gestes et de paroles, une ardeur de physionomie qui rendaient notre entretien des plus dangereux."
                            },
                            {
                                "example_id": "3bb4a9e7-a339-4955-a5da-c8e90b84e572",
                                "sense_id": "ae439db7-0564-3516-a57a-fa2e76f3afcb",
                                "text": "Elle nous bousculait de caresses, prise, à n’importe quel moment du jour, d’un besoin d’effusion où son affection pour nous débordait."
                            },
                            {
                                "example_id": "18848b7d-dff7-4de8-8433-97057ed13d77",
                                "sense_id": "ae439db7-0564-3516-a57a-fa2e76f3afcb",
                                "text": "Nous réservâmes aux nouveaux venus un accueil qui fut cordial et empressé, mais le temps n'était pas aux effusions et d'un commun avis, il fallait agir vite."
                            },
                            {
                                "example_id": "60a3e834-f97b-4b3a-b4cb-818cc76b2272",
                                "sense_id": "ae439db7-0564-3516-a57a-fa2e76f3afcb",
                                "text": "Cette effusion fut si rapide et d’une telle décence que je n’éprouvai aucun scrupule, aucune gêne à y assister."
                            },
                            {
                                "example_id": "01322b41-0683-4c51-adb5-44d113497634",
                                "sense_id": "ae439db7-0564-3516-a57a-fa2e76f3afcb",
                                "text": "Lucile nous embrassa sans effusion, aucune de nous ne savait quoi faire de ses bras et nous ne tenions pas tant que ça sur nos jambes."
                            }
                        ]
                    },
                    {
                        "sense_id": "32e6df18-52ff-344f-9d02-e1b3e7a0de3d",
                        "entry_id": "69a7c1ea-7c84-3905-97b7-aa1e0d62ac4c",
                        "glosses": [
                            "Technique de séparation des constituants d'un mélange gazeux, qui utilise les différences de vitesse entre les gaz qui traversent une paroi poreuse."
                        ],
                        "tags": [
                            "physical"
                        ],
                        "examples": []
                    }
