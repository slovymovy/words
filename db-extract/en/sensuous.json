                                "target_senses": [
                                    {
                                        "sense_id": "80cbf180-042b-394f-873b-f2473a8ac4e9",
                                        "entry_id": "8eaaea1e-3726-35ec-9986-adcb5ec6b369",
                                        "glosses": [
                                            "Qui est relatif aux sens, à la sensation, considéré sous son aspect subjectif."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "366a8cbc-ff4f-4988-9714-754104aa913a",
                                                "sense_id": "80cbf180-042b-394f-873b-f2473a8ac4e9",
                                                "text": "Il la pénétrait bestialement, dans une hébétude sensuelle qui n’atteignait à la lucidité qu’à la minute où l’on voit, par une nuit d’été, la fusée d’un feu d’artifice fondre en un riche bouquet d’étoiles pâmées qui retombent au néant."
                                            },
                                            {
                                                "example_id": "b7651d4e-5917-41a9-925c-23381ee7b1ad",
                                                "sense_id": "80cbf180-042b-394f-873b-f2473a8ac4e9",
                                                "text": "Elle avait déjà entendu parler de l’égoïsme sensuel des hommes, toujours à l’affût d’une aventure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b7a76b60-9f49-3b35-96b0-acd093b6bccc",
                                        "entry_id": "8eaaea1e-3726-35ec-9986-adcb5ec6b369",
                                        "glosses": [
                                            "Qui flatte les sens."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e61bd79e-9712-438c-880e-9fab575c9ff6",
                                                "sense_id": "b7a76b60-9f49-3b35-96b0-acd093b6bccc",
                                                "text": "Les paroles crépitent du rouge-baiser sensuel et altruiste de l’informatrice."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "70998157-3155-3a3b-b99b-03738b3acb56",
                                        "entry_id": "8eaaea1e-3726-35ec-9986-adcb5ec6b369",
                                        "glosses": [
                                            "Qui est porté, attaché aux plaisirs des sens, en parlant d’une personne ou d’un animal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6161e33c-27f7-43a0-894b-1a60f91b7d8e",
                                                "sense_id": "70998157-3155-3a3b-b99b-03738b3acb56",
                                                "text": "Il savait que les femmes de l’aristocratie devenaient après leur mariage des meubles de communauté pour la famille et les amis de leur mari. Elles sont d'ailleurs bien trop dévotes pour être sensuelles. Les étrangers n'ont pas beau jeu à ce train de galanterie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8e40c40a-2e3a-4e46-a79a-eda4b8159f4c",
                        "source_entry_id": "5b570e8a-00d1-3de7-8610-e5226ee0149e",
                        "source_sense_description": "appealing to the senses",
                        "target_lang_word": "sinnenfreudig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sinnenfreudig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "125aacc2-889e-31af-99b8-8c541d094b52",
                                        "entry_id": "ab42b17e-0567-3a18-a1db-e7afb5347a4b",
                                        "glosses": [
                                            "in Bezug auf die Sinnenfreude; sich am sinnlichen Genuss erfreuend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95168730-a66b-42a7-8039-75eaa904f89d",
                                                "sense_id": "125aacc2-889e-31af-99b8-8c541d094b52",
                                                "text": "„Norio riecht sinnenfreudig am Wein, kostet und dreht dann das Glas genüsslich in seiner Hand.“"
                                            },
                                            {
                                                "example_id": "b6b19116-be53-46aa-8b95-3f9dbda0d21a",
                                                "sense_id": "125aacc2-889e-31af-99b8-8c541d094b52",
                                                "text": "„Sie ist empathisch, hilfsbereit und sinnenfreudig, sie hat Glück, dass sie einen Beruf findet, in dem sie diese Potenziale ausleben kann.“"
                                            },
                                            {
                                                "example_id": "2916d3b7-0525-432e-9aba-ba2b1b815ec5",
                                                "sense_id": "125aacc2-889e-31af-99b8-8c541d094b52",
                                                "text": "„Am Abend machte Sophie es sich im Wohnzimmer bequem und schaute sinnenfreudig fern – ein Luxus, den sie sich in ihren fernsehlosen Unterkünften nicht leisten konnte.“"
                                            },
                                            {
                                                "example_id": "caacc156-ca6f-4f2f-a2dd-69e821de0fb6",
                                                "sense_id": "125aacc2-889e-31af-99b8-8c541d094b52",
                                                "text": "„Sie beobachtete eine Wespe, die sich sinnenfreudig an Sylvies frisch gepresstem Orangensaft delektierte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bd763a13-68cc-41b0-8659-d58fd25829e9",
                        "source_entry_id": "5b570e8a-00d1-3de7-8610-e5226ee0149e",
