{
    "word_family": [
        "conclusion",
        "conclusive",
        "conclusively",
        "inconclusive"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0f9d0a71-f0ad-37eb-b594-73b9faceee4c",
                    "sense_definition": "To bring something to an end, such as a speech, meeting, or event.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "end_finish",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>concluded</w> her presentation with a summary of the main points.",
                            "target_lang_translations": {
                                "ru": "Она <w>завершила</w> свою презентацию кратким изложением основных моментов.",
                                "zh": "她用要点总结<w>结束</w>了她的演讲。"
                            }
                        },
                        {
                            "text": "The director decided to <w>conclude</w> the meeting early because there were no more questions.",
                            "target_lang_translations": {
                                "ru": "Директор решил <w>закончить</w> собрание раньше, так как вопросов больше не было.",
                                "zh": "由于没有更多问题，主任决定提前<w>结束</w>会议。"
                            }
                        }
                    ],
                    "synonyms": [
                        "finish",
                        "close",
                        "end",
                        "wrap up"
                    ],
                    "antonyms": [
                        "start",
                        "begin",
                        "commence",
                        "initiate"
                    ],
                    "common_phrases": [
                        "conclude with",
                        "conclude by"
                    ],
                    "target_lang_definitions": {
                        "ru": "Довести что-либо до конца, например, речь, встречу или мероприятие.",
                        "zh": "使某事（如演讲、会议或活动）结束。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "завершать",
                                "target_lang_sense_clarification": "оканчивать, доводить исполнение чего-либо до конца"
                            },
                            {
                                "target_lang_word": "заканчивать",
                                "target_lang_sense_clarification": "переставать делать что-либо, доводить до конца"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "结束",
                                "target_lang_sense_clarification": "使某事停止或完成"
                            },
                            {
                                "target_lang_word": "完成",
                                "target_lang_sense_clarification": "做完某事"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4de53a79-9445-3f3f-9bf8-1269afa74bb6",
                    "sense_definition": "To come to an end.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "end_finish",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The festivities <w>concluded</w> with a magnificent fireworks display.",
                            "target_lang_translations": {
                                "ru": "Празднества <w>завершились</w> грандиозным фейерверком.",
                                "zh": "庆祝活动在绚丽的烟花表演中<w>结束</w>了。"
                            }
                        },
                        {
                            "text": "The program <w>concluded</w> at midnight after a long series of performances.",
                            "target_lang_translations": {
                                "ru": "Программа <w>закончилась</w> в полночь после длинной серии выступлений.",
                                "zh": "经过一系列漫长的表演，节目在午夜<w>结束</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "end",
                        "finish",
                        "wrap up"
                    ],
                    "antonyms": [
                        "start",
                        "begin"
                    ],
                    "common_phrases": [
                        "conclude with"
                    ],
                    "target_lang_definitions": {
                        "ru": "Подойти к концу, закончиться.",
                        "zh": "某事走到尽头或停止。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "завершаться",
                                "target_lang_sense_clarification": "подходить к концу (возвратная форма)"
                            },
                            {
                                "target_lang_word": "заканчиваться",
                                "target_lang_sense_clarification": "истекать, прекращаться (возвратная форма)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "结束",
                                "target_lang_sense_clarification": "事情告一段落"
                            },
                            {
                                "target_lang_word": "告终",
                                "target_lang_sense_clarification": "最终结束"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "88292a3d-1091-35e0-946c-e658e50fd87e",
                    "sense_definition": "To decide or believe something is true after considering all the information or evidence.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "deduce_decide",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "From the evidence presented, the jury <w>concluded</w> that the defendant was innocent.",
                            "target_lang_translations": {
                                "ru": "Исходя из представленных доказательств, присяжные <w>пришли к выводу</w>, что подсудимый невиновен.",
                                "zh": "根据所提供的证据，陪审团<w>得出结论</w>认为被告是无罪的。"
                            }
                        },
                        {
                            "text": "I <w>concluded</w> that he was not interested in the job because he never replied to my emails.",
                            "target_lang_translations": {
                                "ru": "Я <w>сделал вывод</w>, что он не заинтересован в работе, так как он ни разу не ответил на мои письма.",
                                "zh": "我<w>断定</w>他对这份工作不感兴趣，因为他从不回复我的邮件。"
                            }
                        }
                    ],
                    "synonyms": [
                        "deduce",
                        "infer",
                        "decide",
                        "judge"
                    ],
                    "common_phrases": [
                        "conclude that"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прийти к решению или мнению на основе анализа информации или фактов.",
                        "zh": "在考虑所有信息或证据后，做出决定或认为某事属实。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "делать вывод",
                                "target_lang_sense_clarification": "приходить к умозаключению на основе фактов"
                            },
                            {
                                "target_lang_word": "заключать",
                                "target_lang_sense_clarification": "строить умозаключение, выводить следствие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "得出结论",
                                "target_lang_sense_clarification": "经过分析后做出判断"
                            },
                            {
                                "target_lang_word": "断定",
                                "target_lang_sense_clarification": "经过判断后下结论"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3120f48b-7c38-35be-ad48-6b5fcbd914ac",
                    "sense_definition": "To formally settle or arrange an agreement, treaty, or business deal.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "agreement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The two nations <w>concluded</w> a peace treaty after years of conflict.",
                            "target_lang_translations": {
                                "ru": "Две страны <w>заключили</w> мирный договор после многих лет конфликта.",
                                "zh": "两国在多年冲突后<w>缔结</w>了和平条约。"
                            }
                        },
                        {
                            "text": "We hope to <w>conclude</w> the business deal before the end of the fiscal year.",
                            "target_lang_translations": {
                                "ru": "Мы надеемся <w>заключить</w> сделку до конца финансового года.",
                                "zh": "我们希望在财年结束前<w>达成</w>这笔商业交易。"
                            }
                        }
                    ],
                    "synonyms": [
                        "settle",
                        "finalize"
                    ],
                    "common_phrases": [
                        "conclude an agreement",
                        "conclude a treaty",
                        "conclude a deal"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официально оформить соглашение, договор или сделку.",
                        "zh": "正式达成或安排协议、条约或商业交易。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заключать",
                                "target_lang_sense_clarification": "официально подписывать договор или вступать в соглашение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "缔结",
                                "target_lang_sense_clarification": "正式签订条约或协议"
                            },
                            {
                                "target_lang_word": "达成",
                                "target_lang_sense_clarification": "通过协商完成交易或协议"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}