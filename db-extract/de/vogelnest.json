                                    {
                                        "sense_id": "0afd0b53-4491-3545-977e-ec2be208d48b",
                                        "entry_id": "64a05308-40c3-350c-84ed-175a242ddaba",
                                        "glosses": [
                                            "A snug, comfortable, or cosy residence or job situation."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "45eb461a-b712-3a0b-90c5-4f9e02083dae",
                                        "entry_id": "64a05308-40c3-350c-84ed-175a242ddaba",
                                        "glosses": [
                                            "A retreat, or place of habitual resort."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "42e9430f-ffb3-3bc6-a736-91b8fcbbd168",
                                        "entry_id": "64a05308-40c3-350c-84ed-175a242ddaba",
                                        "glosses": [
                                            "A hideout for bad people to frequent or haunt; a den."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ade1b6bf-269b-47ba-867f-2c783fae1ccf",
                                                "sense_id": "42e9430f-ffb3-3bc6-a736-91b8fcbbd168",
                                                "text": "a nest of thieves"
                                            },
                                            {
                                                "example_id": "f6515af1-044f-4333-bda1-8712d30c9372",
                                                "sense_id": "42e9430f-ffb3-3bc6-a736-91b8fcbbd168",
                                                "text": "That nightclub is a nest of strange people!"
                                            },
                                            {
                                                "example_id": "10c77a37-403b-45b2-96e9-80d89229a381",
                                                "sense_id": "42e9430f-ffb3-3bc6-a736-91b8fcbbd168",
                                                "text": "Capt. Kirby and I concluding it might be of great Service to the Eaſt-India Company to deſtroy such a Neſt of Rogues, were ready to ſail for that Purpoſe […]"
                                            },
                                            {
                                                "example_id": "17f5c891-3456-41bf-b382-410905dfdbbe",
                                                "sense_id": "42e9430f-ffb3-3bc6-a736-91b8fcbbd168",
                                                "text": "Miss Carpenter told me that a short time previously some Bow Street constables had been sent down to this place to ferret out a crime which had been committed there, and that they reported there was not in all London such a nest of wickedness as they had explored."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c5d371e-dddc-3809-ba0b-e81990604be2",
                                        "entry_id": "64a05308-40c3-350c-84ed-175a242ddaba",
                                        "glosses": [
                                            "A home that a child or young adult shares with a parent or guardian."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7738e00-e43a-4447-8628-763f3a9027fd",
                                                "sense_id": "5c5d371e-dddc-3809-ba0b-e81990604be2",
                                                "text": "I am aspiring to leave the nest."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0c6f4f8-3bf1-3f5c-b9aa-d305e2a3876f",
                                        "entry_id": "64a05308-40c3-350c-84ed-175a242ddaba",
                                        "glosses": [
                                            "A fixed number of cards in some bidding games awarded to the highest bidder allowing him to exchange any or all with cards in his hand."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5de65c17-8fb4-4eff-afd8-ccedb6cec50b",
                                                "sense_id": "e0c6f4f8-3bf1-3f5c-b9aa-d305e2a3876f",
                                                "text": "I was forced to change trumps when I found the ace, jack, and nine of diamonds in the nest."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "20f00005-3516-3012-8df9-544245ea2fab",
                                        "entry_id": "64a05308-40c3-350c-84ed-175a242ddaba",
                                        "glosses": [
                                            "A fortified position for a weapon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a552c00-2c54-46fb-ab06-6beeecd12ac7",
                                                "sense_id": "20f00005-3516-3012-8df9-544245ea2fab",
                                                "text": "a machine gun nest"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e60803e2-22e8-3aab-9ca6-8a62790b6204",
                                        "entry_id": "64a05308-40c3-350c-84ed-175a242ddaba",
                                        "glosses": [
                                            "A structure consisting of nested structures, such as nested loops or nested subroutine calls."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af0a71f7-80c7-42f8-877e-ad2e26ffe69d",
                                                "sense_id": "e60803e2-22e8-3aab-9ca6-8a62790b6204",
                                                "text": "Subroutine 4 cannot jump out of the subroutine nest in one step. Each return address must be popped from the stack in the order in which it was pushed onto the stack."
                                            },
                                            {
                                                "example_id": "0d12052b-48b9-4d6e-88c5-343f35fc5cd5",
                                                "sense_id": "e60803e2-22e8-3aab-9ca6-8a62790b6204",
                                                "text": "Our analysis to this point has assumed that in a loop nest, we are only parallelizing a single loop."
                                            }
                                        ]
                                    },
