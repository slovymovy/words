                    {
                        "sense_id": "ee999d06-ce0c-3444-a3da-d5dc57b0207a",
                        "entry_id": "fd0711e8-9db6-356d-b9cf-17f5eae64b48",
                        "glosses": [
                            "Appareil ou dispositif qui sert à amplifier le son."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9932e594-7b55-4f7c-8f6b-6d3bafb28b98",
                                "sense_id": "ee999d06-ce0c-3444-a3da-d5dc57b0207a",
                                "text": "Des étudiants mettent au point un résonateur en bois et en peau, créant six instruments de tailles et de sonorités différentes, testés et améliorés par plusieurs percussionnistes."
                            },
                            {
                                "example_id": "309be47f-2b55-48f7-8155-b61007fa905d",
                                "sense_id": "ee999d06-ce0c-3444-a3da-d5dc57b0207a",
                                "text": "Les voix diffèrent selon la dimension des plis vocaux et selon l’impact des résonateurs que sont la gorge, la bouche et les fosses nasales."
                            }
                        ]
                    },
                    {
                        "sense_id": "12d84c22-439b-3acf-964a-701f05b5939f",
                        "entry_id": "fd0711e8-9db6-356d-b9cf-17f5eae64b48",
                        "glosses": [
                            "Appareil servant à analyser les sons."
                        ],
                        "tags": [
