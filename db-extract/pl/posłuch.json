                    {
                        "translation_id": "1fa43c45-e7ff-451c-9766-f863693623d2",
                        "source_entry_id": "cebad64e-315f-3a19-b249-d20d61f18872",
                        "source_sense_id": "cdedc0b4-1e3b-3f10-8e44-aa992b7655e0",
                        "target_lang_word": "obedience",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "obedience",
