{
    "word_family": [
        "effortless",
        "effortlessly",
        "effortfulness"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5c13ae9e-b9b7-3614-9e8b-8b3c8239cc2b",
                    "sense_definition": "The physical or mental energy needed to do something; exertion.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "exertion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It took a lot of <w>effort</w> to find a decent apartment within walking distance of the office.",
                            "target_lang_translations": {
                                "ru": "Потребовалось много <w>усилий</w>, чтобы найти приличную квартиру в пешей доступности от офиса."
                            }
                        },
                        {
                            "text": "He made a conscious <w>effort</w> to stay calm during the difficult meeting.",
                            "target_lang_translations": {
                                "ru": "Он сделал сознательное <w>усилие</w>, чтобы сохранять спокойствие во время трудной встречи."
                            }
                        }
                    ],
                    "synonyms": [
                        "struggle",
                        "trouble"
                    ],
                    "antonyms": [
                        "ease",
                        "idleness"
                    ],
                    "common_phrases": [
                        "make an effort",
                        "take a lot of effort",
                        "put in effort",
                        "conscious effort"
                    ],
                    "target_lang_definitions": {
                        "ru": "Физическая или умственная энергия, необходимая для выполнения чего-либо; напряжение сил."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "усилие",
                                "target_lang_sense_clarification": "напряжение физических или умственных сил"
                            },
                            {
                                "target_lang_word": "старание",
                                "target_lang_sense_clarification": "усердие и прилежание в работе"
                            },
                            {
                                "target_lang_word": "труд",
                                "target_lang_sense_clarification": "затраченная работа или энергия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6d1da751-601b-3aae-b425-133cdfa3cf42",
                    "sense_definition": "A determined attempt to achieve a particular goal; an endeavor.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "attempt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team's <w>effort</w> at the Olympics won over many fans despite the lack of medals.",
                            "target_lang_translations": {
                                "ru": "<w>Старания</w> команды на Олимпиаде покорили многих болельщиков, несмотря на отсутствие медалей."
                            }
                        },
                        {
                            "text": "The government launched a joint <w>effort</w> to protect the local environment.",
                            "target_lang_translations": {
                                "ru": "Правительство предприняло совместные <w>усилия</w> по защите местной окружающей среды."
                            }
                        }
                    ],
                    "synonyms": [
                        "struggle"
                    ],
                    "common_phrases": [
                        "joint effort",
                        "team effort",
                        "valiant effort"
                    ],
                    "target_lang_definitions": {
                        "ru": "Решительная попытка достичь определенной цели; начинание или стремление."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "попытка",
                                "target_lang_sense_clarification": "стремление сделать что-либо"
                            },
                            {
                                "target_lang_word": "усилие",
                                "target_lang_sense_clarification": "сознательное действие для достижения результата"
                            },
                            {
                                "target_lang_word": "старание",
                                "target_lang_sense_clarification": "усилия для получения хороших результатов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "255c11c3-3617-3dad-82ff-cf93c03c0710",
                    "sense_definition": "A force acting on a body in the direction of its motion.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "physics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The engineer calculated the <w>effort</w> required to move the heavy lever.",
                            "target_lang_translations": {
                                "ru": "Инженер рассчитал <w>усилие</w>, необходимое для перемещения тяжелого рычага."
                            }
                        },
                        {
                            "text": "In a simple machine, the <w>effort</w> is the force applied to overcome resistance.",
                            "target_lang_translations": {
                                "ru": "В простом механизме <w>усилие</w> — это сила, приложенная для преодоления сопротивления."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сила, действующая на тело в направлении его движения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "усилие",
                                "target_lang_sense_clarification": "физическая нагрузка или приложенная сила"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "da3dab2b-10b1-3114-8719-6a6cb5a4075d",
                    "sense_definition": "To make a physical or mental attempt to do something.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager is currently <w>efforting</w> a solution to the logistics problem.",
                            "target_lang_translations": {
                                "ru": "Менеджер в настоящее время <w>прорабатывает</w> решение логистической проблемы."
                            }
                        },
                        {
                            "text": "We are <w>efforting</w> to get the project finished by the end of the week.",
                            "target_lang_translations": {
                                "ru": "Мы <w>прилагаем усилия</w>, чтобы завершить проект к концу недели."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in business jargon"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Предпринимать физическую или умственную попытку сделать что-либо (бизнес-жаргон)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прилагать усилия",
                                "target_lang_sense_clarification": "стараться найти решение или выполнить задачу"
                            },
                            {
                                "target_lang_word": "прорабатывать",
                                "target_lang_sense_clarification": "заниматься поиском решения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1a7858e7-4e10-353e-9a38-69e8e5bf1aef",
                    "sense_definition": "To strengthen, fortify, or stimulate someone's spirits or mind.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "strengthen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>efforted</w> his spirits by remembering the glorious days of his youth.",
                            "target_lang_translations": {
                                "ru": "Он <w>подкреплял</w> свой дух, вспоминая славные дни своей юности."
                            }
                        },
                        {
                            "text": "The old man sought to <w>effort</w> his mind against the creeping despair of poverty.",
                            "target_lang_translations": {
                                "ru": "Старик пытался <w>укрепить</w> свой разум против подступающего отчаяния нищеты."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Укреплять, подбадривать или стимулировать чей-либо дух или разум (архаизм)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подкреплять",
                                "target_lang_sense_clarification": "укреплять душевные силы"
                            },
                            {
                                "target_lang_word": "воодушевлять",
                                "target_lang_sense_clarification": "стимулировать дух"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}