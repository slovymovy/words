                ],
                "senses": [
                    {
                        "sense_id": "92c6127a-7495-39bc-8399-0c0e4428c2e1",
                        "entry_id": "824aae0b-f486-3079-8ba5-ef954c7fc19a",
                        "glosses": [
                            "Beschreibung/Anleitung, nach der sprachliche Einheiten grammatisch korrekt zu größeren Einheiten verbunden werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7050f429-524d-491c-9269-293748646bef",
                                "sense_id": "92c6127a-7495-39bc-8399-0c0e4428c2e1",
                                "text": "„Diejenigen, die in einer Sprache lesen und schreiben konnten, waren nun auch fähig, andere Sprachen zu lernen, indem sie sich die Grammatikregeln und die Bedeutung der Wörter aus einem bilingualen Wörterbuch aneigneten.“"
                            },
                            {
                                "example_id": "cfefd1d9-97bf-48d3-9b4c-6b0f89f4ad12",
                                "sense_id": "92c6127a-7495-39bc-8399-0c0e4428c2e1",
                                "text": "„Möglicherweise beeinflusste das Fehlen des Ausrufezeichens auf der Tastatur der Remington allgemeine Einstellungen zur Sprache, sodass ihr funktionaler Zweck Grammatikregeln wie die der Fowler-Brüder unterstützte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
