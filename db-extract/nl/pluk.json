                            {
                                "example_id": "401d6ebf-bfc4-4eaa-94da-d6cee852a3de",
                                "sense_id": "41f99e03-30fd-31a7-8521-9495124d296d",
                                "text": "Tijdens de vechtpartij verloren beide meisjes een pluk haar."
                            }
                        ]
                    },
                    {
                        "sense_id": "ca85bc63-6c02-3775-b50a-21f3fa33c405",
                        "entry_id": "17406ab6-42c5-3107-bbb4-308d06fc4c71",
