                "senses": [
                    {
                        "sense_id": "3b315583-eef8-359d-bb43-214b9b7b16e7",
                        "entry_id": "a2853fee-c359-3a5c-989b-84d17d91a654",
                        "glosses": [
                            "viertägiges Fest im Islam, dessen Beginn sich nach dem Mondkalender richtet und auf jede Jahreszeit fallen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "894f4ae1-0e6a-41ce-875d-160789462780",
                                "sense_id": "3b315583-eef8-359d-bb43-214b9b7b16e7",
                                "text": "Das islamische Opferfest 2019 beginnt am 11. August abends."
                            },
                            {
                                "example_id": "95546aef-f7c9-474b-9a60-82235b2f2fdc",
                                "sense_id": "3b315583-eef8-359d-bb43-214b9b7b16e7",
                                "text": "„Es gibt zwei besonders wichtige religiöse Feiertage für Muslime: das Ramadanfest und das Opferfest. Deren Stellenwert in der türkischen Kultur ist in etwa mit Weihnachten und Ostern in der christlichen Welt vergleichbar.“"
                            },
                            {
                                "example_id": "d9c609d5-5fd3-4ae4-ba31-4d7bc2c39e2e",
                                "sense_id": "3b315583-eef8-359d-bb43-214b9b7b16e7",
                                "text": "„Die Versuchung Abrahams ist der religiöse Ursprung des Opferfestes, kurban bayram, das die Muslime jeweils zwei Mondphasen nach Abschluss des Ramadan, der Fastenzeit, feiern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
