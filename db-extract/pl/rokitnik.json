                    {
                        "translation_id": "1c138556-64fa-47ea-8195-151c22bd0188",
                        "source_entry_id": "e5ca4ea3-81f6-3f06-9b53-0e4e1297958f",
                        "source_sense_id": "1024e975-2367-3f99-bf9f-3f623a7e7e8f",
                        "target_lang_word": "облепи́ха",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "облепи́ха",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "0416a824-0a34-39c7-b9fc-4ed00ee1d1c0",
                                        "entry_id": "41b2c649-7077-3ac1-8421-b5798b89ed7e",
                                        "glosses": [
                                            "ботан. кустарник или дерево из семейства лоховых"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e79f413-ba03-4fce-b8cf-87633e1c4034",
                                                "sense_id": "0416a824-0a34-39c7-b9fc-4ed00ee1d1c0",
                                                "text": "Посадку саженцев облепихи следует производить только весной, при осенней посадке велик процент неприжившихся растений."
                                            },
                                            {
                                                "example_id": "38868237-8c02-481c-9f26-fea1aed7e48a",
                                                "sense_id": "0416a824-0a34-39c7-b9fc-4ed00ee1d1c0",
                                                "text": "Облепиха чрезвычайно плодовита, и к осени кусты её почти сплошь покрываются ягодой, так что в массе представляют очень эффектный вид; а издали кажутся как бы покрытыми золотым матом, сильно выдаваясь из другой растительности."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "12d3ba2c-855d-3895-b057-01a3c249dc1e",
                                        "entry_id": "41b2c649-7077-3ac1-8421-b5798b89ed7e",
                                        "glosses": [
                                            "ягоды облепихи [1]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "119bc78c-7d11-4aad-ab19-3df70778b48a",
                                                "sense_id": "12d3ba2c-855d-3895-b057-01a3c249dc1e",
                                                "text": "Садоводы придумали множество способов, облегчающих сбор облепихи."
                                            },
                                            {
                                                "example_id": "35c2205b-4990-44c1-9588-e9f4a2405dc1",
                                                "sense_id": "12d3ba2c-855d-3895-b057-01a3c249dc1e",
                                                "text": "В Алтае есть ещё особая ягода желтовато-красноватого цвета, так называемая облепиха, которая хороша только в киселе, желе и мороженом. Вкусом и, главное, запахом она очень напоминает ананас. Видом же походит на зёрна кукурузы и растёт на довольно большом кустарнике с большими колючими иглами преимущественно около берегов Оби и других алтайских речек. ❬…❭ Из облепихи настаивают и наливку, но она только для любителей и далеко уступает всеми излюбленной княженике."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1c9a1309-b761-4428-88b1-b1c2977f7429",
                        "source_entry_id": "e5ca4ea3-81f6-3f06-9b53-0e4e1297958f",
                        "source_sense_id": "3e570678-3833-34dd-8d58-71a259312845",
