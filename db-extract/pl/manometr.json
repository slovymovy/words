                                        "entry_id": "e9f6ecde-2aaf-3f2d-a713-021c4037be51",
                                        "glosses": [
                                            "Dispositivo de medición de la presión de fluidos (líquidos y gases) contenidos en recipientes cerrados. Por ello existen dos tipos de manómetros, según se empleen para cuantificar la presión de líquidos o de gases."
                                        ],
                                        "tags": [
                                            "Física",
                                            "industria"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f04e42c7-453d-449b-86e5-ac31d2109147",
                                                "sense_id": "0eda2047-749a-3060-b8ca-79c1632e04b9",
                                                "text": "Si la manguera, el dispositivo acústico o el manómetro se dañan, un limitador en el cuerpo reductor limita la pérdida de aire a 25 litros/minuto"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
