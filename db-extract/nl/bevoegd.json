                                "example_id": "a8c3554a-f1b1-4b5b-b463-b16e358e7751",
                                "sense_id": "acab6530-c2c7-31de-a87d-4b9628179b75",
                                "text": "volledig bevoegd zijn : avoir pleine compétence (pour)."
