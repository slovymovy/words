                ],
                "senses": [
                    {
                        "sense_id": "3de82665-1509-3b69-b920-57c9bc848cfa",
                        "entry_id": "ccee1de2-95fb-38cd-bc3f-61563f91b3a2",
                        "glosses": [
                            "Préparer plus que la normale, ou de façon excessive."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a565d9ba-575f-4bce-9fe2-7ad93831cf4a",
                                "sense_id": "3de82665-1509-3b69-b920-57c9bc848cfa",
                                "text": "Il faut impérativement éviter de se sur-préparer ou d'apprendre par coeur."
                            },
                            {
                                "example_id": "a1cc52b7-e99a-4f17-86cb-0f77ad9359b9",
                                "sense_id": "3de82665-1509-3b69-b920-57c9bc848cfa",
                                "text": "Afin de ne pas être démasqué, l'imposteur peut investir une grande quantité d'énergie face à une tâche à accomplir voire se sur-préparer (overdoing)."
                            },
                            {
                                "example_id": "190be6a0-c1f7-4a01-a774-d0301ff0ea3b",
                                "sense_id": "3de82665-1509-3b69-b920-57c9bc848cfa",
                                "text": "La recherche montre que les couples qui se sur-préparent s'entendent beaucoup mieux une fois que le bébé arrive."
                            }
                        ]
                    }
                ],
