                ],
                "senses": [
                    {
                        "sense_id": "f5a470c2-85da-3fa9-b7c8-f7ca680276fc",
                        "entry_id": "66e42ebf-c67c-3ac5-9d02-fb86de608366",
                        "glosses": [
                            "Luftsportler, der mit einem Hängegleiter fliegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47d5572f-055e-47a2-bd51-3f2d0799f4fb",
                                "sense_id": "f5a470c2-85da-3fa9-b7c8-f7ca680276fc",
                                "text": "„Der geübte Deltaflieger verwächst funktionstechnisch und erlebnismäßg so eng mit seinem Fluggerät, dass ihm der angelegte Flügel zu einer Art neuem Körperteil wird, dessen er sich wie eines verlängerten Arms oder einer gut sitzenden Prothese bedient.“"
                            },
                            {
                                "example_id": "5b7936ed-cb81-48c2-b224-59f32dafbcbc",
                                "sense_id": "f5a470c2-85da-3fa9-b7c8-f7ca680276fc",
                                "text": "„Das Stockhorn bietet ideale Startbedingungen für Gleitschirm- und Deltaflieger.“"
                            },
                            {
                                "example_id": "7959db49-4805-4b71-bbd0-b03e9f2542a2",
                                "sense_id": "f5a470c2-85da-3fa9-b7c8-f7ca680276fc",
                                "text": "„Einen Beitrag dazu leisten die unzähligen Bergbahnen. Durch sie wird das Gebiet auch zum Eldorado für Gleitschirm- und Deltaflieger.“"
                            },
                            {
                                "example_id": "9e71e0e0-8f56-47bc-917b-32fc34204ab7",
                                "sense_id": "f5a470c2-85da-3fa9-b7c8-f7ca680276fc",
                                "text": "„Bald einmal gehörten die Deltaflieger so selbstverständlich zum Himmel über Vaduz wie die Bussarde und Milane, mit denen sie gemeinsam die Aufwinde nützen.“"
                            },
                            {
                                "example_id": "f3472665-9ad4-45c9-b1cd-ee07b6ccfb6c",
                                "sense_id": "f5a470c2-85da-3fa9-b7c8-f7ca680276fc",
                                "text": "„In den Alpen und im Alpenvorland kreisen bei guter Thermik nicht weniger als zwei bis drei Dutzend Gleit- und Deltaflieger gleichzeitig über dem Tal.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "196b07a3-facb-3bfc-85cf-f11cd6928319",
