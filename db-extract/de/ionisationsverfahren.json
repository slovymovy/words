                "senses": [
                    {
                        "sense_id": "c6d9f39f-d8a7-3671-8e27-30a976ae234c",
                        "entry_id": "e6587b3c-0d47-315b-98fd-fdf65cf10d8c",
                        "glosses": [
                            "die Art und Weise der Ionisation von etwas; Durchführung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c12ef85c-264f-4b0d-a870-ddc4d47437fb",
                                "sense_id": "c6d9f39f-d8a7-3671-8e27-30a976ae234c",
                                "text": "„Durch die Entwicklung sog. weicher Ionisationsverfahren und entsprechender Massenspektrometer konnte die Arbeitsgruppe um Hoffmann die Konzentrationen einzelner Molekülspezies in den Atmosphärensimulationskammern verfolgen und damit letztlich die Alterung des atmosphärischen Aerosols auf molekularer Basis verstehen.“"
                            },
                            {
                                "example_id": "359609c7-aada-438a-be8f-9422d9b314fa",
                                "sense_id": "c6d9f39f-d8a7-3671-8e27-30a976ae234c",
                                "text": "„In der Arbeitsgruppe werden verschiedene Ionisationsverfahren verwendet.“"
                            },
                            {
                                "example_id": "251df143-6f2e-479c-9f58-25a6eceb57cd",
                                "sense_id": "c6d9f39f-d8a7-3671-8e27-30a976ae234c",
                                "text": "„Vor allem Ionisationsverfahren, die bei Atmosphärendruck (engl. Atmospheric Pressure Ionization, API) operieren, stehen im Mittelpunkt der Forschungsaktivitäten.“"
                            },
                            {
                                "example_id": "371e00c4-2ef0-4488-829f-53dbf680120c",
                                "sense_id": "c6d9f39f-d8a7-3671-8e27-30a976ae234c",
                                "text": "„Stärker berücksichtigt werden die neuen Ionisationsverfahren und Anwendungen der spektroskopischen und massensprektrometrischen Analysenmethoden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
