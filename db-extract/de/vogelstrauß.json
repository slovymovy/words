                        ],
                        "form": "die Vogelstrauße"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e7e2a745-848a-3527-b921-b4b541334be8",
                        "entry_id": "e12fe88a-b7be-3add-b664-f7edc931b76f",
                        "glosses": [
                            "(in den Steppen Afrikas und Vorderasiens lebender) Vertreter einer Gattung bis zu annähernd 3 Meter großer, flugunfähiger Laufvögel mit einem langen, nackten Hals, hohen, kräftigen Beinen und gekräuselten Schwungfedern, dessen Gefieder bei Männchen überwiegend schwarz und bei Weibchen überwiegend braun ist (Struthio)"
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "1fc18e26-4f1c-4ed3-b7c4-d7fc2c0c5fa1",
                                "sense_id": "e7e2a745-848a-3527-b921-b4b541334be8",
                                "text": "„Ausgewachsen ist der Vogelstrauß der größte Vogel der Erde.“"
                            },
                            {
                                "example_id": "2e86429f-8282-416b-9f5a-3b25a8eb1f52",
                                "sense_id": "e7e2a745-848a-3527-b921-b4b541334be8",
                                "text": "„‚Hiermit werden alle Import- sowie Transit-Genehmigungen für lebendes Geflügel und anderer Vögel sowie ungekochte Geflügelprodukte – einschließlich lebendiger Vogelstrauße und rohem Vogelstraußfleisch – infolge des Ausbruchs der Vogelgrippe (Highly Pathogenic Avian Influenza, HPAI) mit sofortiger Wirkung storniert‘, heißt es in dem Schreiben des namibischen Veterinäramtes.“"
                            },
                            {
                                "example_id": "51b7e995-2d73-4df8-acfa-1af8b4973f46",
                                "sense_id": "e7e2a745-848a-3527-b921-b4b541334be8",
                                "text": "„Während er früher in ganz Afrika und Westasien beheimatet war, ist ihm heute nur noch ein bescheidener Lebensraum südlich der Sahara gegönnt. In allen anderen Gebieten haben wir Menschen den Vogelstrauß wegen seines Leders, seines Fleisches und – als Modetorheit – wegen seiner Federn ausgerottet.“"
                            },
                            {
                                "example_id": "861e82d7-70a5-4d25-a623-afd4b588692a",
                                "sense_id": "e7e2a745-848a-3527-b921-b4b541334be8",
                                "text": "«Der Vogelstrauss ist auf seinen zwei Beinen mit rund 70 Kilometern in der Stunde fast doppelt so schnell wie der Mensch.»"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "70a288c5-02b3-48e3-acc4-ef43d4064c69",
                        "source_entry_id": "e12fe88a-b7be-3add-b664-f7edc931b76f",
                        "source_sense_id": "e7e2a745-848a-3527-b921-b4b541334be8",
                        "target_lang_word": "Strauß",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Strauß",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e11fa181-5005-3eca-b6b7-7549a73eb72f",
                                        "entry_id": "649f61d1-bcd3-38ce-a755-8c3f2d93b2fa",
                                        "glosses": [
                                            "(kunstvoll gestaltete, häufig gebundene) Zusammenstellung von abgeschnittenen oder gepflückten Blumen, Halmgräsern, Zweigen oder dergleichen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af0523a5-5bf5-41db-b36e-8afe48ace2a7",
                                                "sense_id": "e11fa181-5005-3eca-b6b7-7549a73eb72f",
                                                "text": "Zum Geburtstag wird gern ein großer Strauß Blumen verschenkt."
                                            },
                                            {
                                                "example_id": "b757421e-7b7d-4474-a975-fe41b039b2df",
                                                "sense_id": "e11fa181-5005-3eca-b6b7-7549a73eb72f",
                                                "text": "„Sie zog die Königin der Blumen an Stöcken in ihrem Garten, schützte sie sorgfältig, mit gebotenen Mitteln, gegen fressende Raupen, und immer standen, solange die Glorie nur währte, auf den Etageren und Tischchen ihres Boudoirs Sträuße von wohlerquickten Rosen, knospenden, halb- und vollerblühten, roten namentlich (denn weiße sah sie nicht gern), von eigener Zucht oder Gaben der Aufmerksamkeit von Besucherinnen, denen ihre Passion bekannt war.“"
                                            },
                                            {
                                                "example_id": "8b52df86-faac-483c-a844-03d9e2d601d3",
                                                "sense_id": "e11fa181-5005-3eca-b6b7-7549a73eb72f",
                                                "text": "„Emma Dürr knispelt an einem Asternstrauß. Den Strauß soll sie dem Dichter beim Theaterschluß überreichen.“"
                                            },
                                            {
                                                "example_id": "e95cbe90-875f-4802-b49b-2fa1c5fa63f7",
                                                "sense_id": "e11fa181-5005-3eca-b6b7-7549a73eb72f",
                                                "text": "„Und die Maggifirma […] schickte der Mutter leere Maggiflaschen aller Größen, die an bunten Bändern hingen, dazu aus Leinwand gefertigtes Kunstgemüse: Möhren, Petersilienwurzel, Maggikraut, das heißt Liebstöckl, und auch Grünkern-Ähren zu Sträußen gebündelt.“"
                                            },
                                            {
                                                "example_id": "1c0e3525-6288-4ce1-8cec-02f3c01fc89d",
                                                "sense_id": "e11fa181-5005-3eca-b6b7-7549a73eb72f",
                                                "text": "„Daß so viel blühte, war Johann erst aufgefallen, als Anita gesagt hatte, auf dem Heimweg wolle sie einen Strauß für ihre Mutter pflücken.“"
                                            },
                                            {
                                                "example_id": "2ba22c7f-1104-41c2-95e9-0c3fc11cc9da",
                                                "sense_id": "e11fa181-5005-3eca-b6b7-7549a73eb72f",
                                                "text": "„Auf den Wiesen blühten Blumen, blaue, gelbe und weiße. Malka hätte gerne einen Strauß gepflückt, aber die Mutter ließ es nicht zu. »Später«, sagte sie.“"
                                            },
                                            {
                                                "example_id": "39ac382c-fc19-4406-9d81-badb74695a6a",
                                                "sense_id": "e11fa181-5005-3eca-b6b7-7549a73eb72f",
                                                "text": "«Sie holte sich ihre Erhebung in den Bergen eigenhändig, etwa in Gestalt eines Straußes wilder Narzissen, und verteilte ihn auf die Zimmer der Gäste, die ihrem Haus treu geblieben waren.»"
                                            },
                                            {
                                                "example_id": "42fcd92d-72b9-408e-9a48-339c024e3b8f",
                                                "sense_id": "e11fa181-5005-3eca-b6b7-7549a73eb72f",
                                                "text": "„Sie hebt den Strauß an ihr Gesicht und atmet den Duft ein, mit langen, tiefen Zügen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3ea26f56-fb41-3294-9dc2-a60e929ae78c",
                                        "entry_id": "649f61d1-bcd3-38ce-a755-8c3f2d93b2fa",
                                        "glosses": [
                                            "reiche Zusammenstellung vielfältiger (ausgewählter) Dinge; abwechslungsreiche Vielzahl"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a85a60f-1b9b-4103-b377-032a895ef673",
                                                "sense_id": "3ea26f56-fb41-3294-9dc2-a60e929ae78c",
                                                "text": "„Der Junge bekam einen ganzen Strauß unverblümter Grobheiten an den Kopf geworfen, die darauf abzielten, ihn der größten Faulheit zu bezichtigen, zu der jemals ein Mensch fähig gewesen wäre.“"
                                            },
                                            {
                                                "example_id": "57d40168-ffd4-4b69-afa8-1e4492ea2179",
                                                "sense_id": "3ea26f56-fb41-3294-9dc2-a60e929ae78c",
                                                "text": "„Über die Springer-Blätter und Radio Luxemburg ließ er Leser und Hörer einen Strauß populärer Melodien auswählen.“"
                                            },
                                            {
                                                "example_id": "93488c80-511e-483c-b59b-18d2334cfe33",
                                                "sense_id": "3ea26f56-fb41-3294-9dc2-a60e929ae78c",
                                                "text": "„Denn auf einen Wink des Imperators, der nach sieben Reden schon gelangweilt schien und der nun auch dem achten Redner das Zeichen aus einer solchen Ferne gab, daß Naso nur die tiefe Blässe in Augustus Antlitz wahrnahm, aber keine Augen, kein Gesicht …, auf einen müden, gleichgültigen Wink also, trat Naso in dieser Nacht vor einen Strauß schimmernder Mikrophone und ließ mit diesem einen Schritt das römische Imperium hinter sich, verschwieg, vergaß! die um alles in der Welt befohlene Litanei der Anreden, den Kniefall vor den Senatoren, den Generälen, ja dem Imperator unter seinem Baldachin, vergaß sich selbst und sein Glück, trat ohne die geringste Verbeugung vor die Mikrophone und sagte nur: Bürger von Rom.“"
                                            },
                                            {
                                                "example_id": "5a29a7f7-089e-4fa9-b2b5-e495d7ffaa23",
                                                "sense_id": "3ea26f56-fb41-3294-9dc2-a60e929ae78c",
                                                "text": "„Ein ganzer Strauß Anekdoten rankt sich um ihn.“"
                                            },
                                            {
                                                "example_id": "3355382c-a022-49df-b063-cf79fe9be289",
                                                "sense_id": "3ea26f56-fb41-3294-9dc2-a60e929ae78c",
                                                "text": "„Jetzt, zu seinem 40. Geburtstag, schenkte er sich sozusagen selbst einen Strauß von Werken aus eigener Feder.“"
                                            },
                                            {
                                                "example_id": "23177845-bc50-4717-a82f-c0db29eabb55",
                                                "sense_id": "3ea26f56-fb41-3294-9dc2-a60e929ae78c",
                                                "text": "„In einem bunten Strauß ineinander verschachtelter Szenen rasen Autos gegen Hauswände (auf der Tonspur), quälen Altenpfleger die Dementen, vergessen Eltern ihre Kinder, stürzen Paare in gemeinsame Abgründe, und Internet-Bekanntschaften enden im Totschlag.“"
                                            },
                                            {
                                                "example_id": "8a4207eb-210a-4e15-9849-d74985df31c1",
                                                "sense_id": "3ea26f56-fb41-3294-9dc2-a60e929ae78c",
                                                "text": "„Die Walfangnationen, allen voran Japan, begründen den Abschuss der in der hohen Zeit des Walfangs zwischen 1920 und 1970 fast ausgerotteten Tiere mit einem ganzen Strauß von Argumenten.“"
                                            },
                                            {
                                                "example_id": "7f8f81e6-5d2c-4303-9f96-d45d45d5c3b1",
                                                "sense_id": "3ea26f56-fb41-3294-9dc2-a60e929ae78c",
                                                "text": "„Als ich jung war, war die Zeitung jeden Tag ein Strauß voller Überraschungen. Das ist heute nicht mehr so, oft gehen Geschichten zu schnell, zu schmutzig ins Blatt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Strauß",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c153fb26-43fc-3776-aa7f-54cf8d15c886",
                                        "entry_id": "05207612-273e-352d-b254-2734b8f884ae",
                                        "glosses": [
                                            "(in den Steppen Afrikas und Vorderasiens lebender) Vertreter einer Gattung bis zu annähernd 3 Meter großer, flugunfähiger Laufvögel mit einem langen, nackten Hals, hohen, kräftigen Beinen und gekräuselten Schwungfedern, dessen Gefieder bei Männchen überwiegend schwarz und bei Weibchen überwiegend braun ist (Struthio)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e530c98-8bc8-487b-90da-1912b22f15c9",
                                                "sense_id": "c153fb26-43fc-3776-aa7f-54cf8d15c886",
                                                "text": "Dem Strauß wird nachgesagt, er stecke den Kopf bei Gefahr in den Sand."
                                            },
                                            {
                                                "example_id": "81fffdba-b206-4e67-9d4a-9ff686d8a03e",
                                                "sense_id": "c153fb26-43fc-3776-aa7f-54cf8d15c886",
                                                "text": "„Und diese sollt ihr verabscheuen unter den Vögeln, dass ihr sie nicht esst, denn ein Gräuel sind sie: den Adler, den Habicht, den Fischaar, den Geier, die Weihe mit ihrer Art und alle Raben mit ihrer Art, den Strauß, die Nachteule, den Kuckuck, den Sperber mit seiner Art, das Käuzchen, den Schwan, den Uhu, die Fledermaus, die Rohrdommel, den Storch, den Reiher, den Häher mit seiner Art, den Wiedehopf und die Schwalbe.“"
                                            },
                                            {
                                                "example_id": "c37f6fcc-3184-4387-9c21-f5a7f6a6b91c",
                                                "sense_id": "c153fb26-43fc-3776-aa7f-54cf8d15c886",
                                                "text": "„Schließlich waren die Strauße und Löwen, die Leoparden, Geparden, die Oryx- und die Mendes-Antilopen in den arabischen Staaten Nordafrikas erbarmungslos und restlos ausgerottet worden, alle Wälder niedergeholzt.“"
                                            },
                                            {
                                                "example_id": "08907f35-084a-4822-8a19-582ef8162743",
                                                "sense_id": "c153fb26-43fc-3776-aa7f-54cf8d15c886",
                                                "text": "„Im Hereroland waren Elefanten und Strauße eine Seltenheit geworden.“"
                                            },
                                            {
                                                "example_id": "164b329a-724e-4682-afbc-f86b27375b3b",
                                                "sense_id": "c153fb26-43fc-3776-aa7f-54cf8d15c886",
                                                "text": "„Neben zahlreichen Vogelarten wie Straußen, Riesentrappen und Sekretären konnten Springböcke, Streifengnus und Oryxantilopen entdeckt werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Strauß",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "667367d9-87f4-300a-8cc3-636cd2686be5",
