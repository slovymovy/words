                "senses": [
                    {
                        "sense_id": "adea98ee-83ab-317f-8908-d2de5e31e87b",
                        "entry_id": "12653d32-028d-3c8c-9a55-fde449c7dc13",
                        "glosses": [
                            "Kugel aus Plutonium"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d459e4d5-7249-44e2-840d-69e6253d075a",
                                "sense_id": "adea98ee-83ab-317f-8908-d2de5e31e87b",
                                "text": "„Die Idee zu diesem Zeitpunkt war, den Plutoniumkern mit einer Schicht von hochexplosiven Sprengstoff zu umhüllen, der an vielen Punkten gleichzeitig gezündet werden und so die Plutoniumkugel im Inneren zu einer überkritischen Masse verdichten sollte.“"
                            },
                            {
                                "example_id": "0002ed78-3c9c-47d5-98e2-b8754bf91713",
                                "sense_id": "adea98ee-83ab-317f-8908-d2de5e31e87b",
                                "text": "„Die Sprengstofflinsen aus konventionellem, chemischem Sprengstoff wurden zur Komprimierung der Plutoniumkugel benötigt, um die kritische Masse zu erreichen und dadurch die atomare Kernspaltung auszulösen.“"
                            },
                            {
                                "example_id": "595713c3-f3e7-4d13-bfd7-2ec8e1fdb421",
                                "sense_id": "adea98ee-83ab-317f-8908-d2de5e31e87b",
                                "text": "„Bei einer typischen Atombombe ist eine Plutoniumkugel von Sprengstoff umgeben, der von vielen Drähten extrem präzis gezündet wird, damit die Kugel perfekt zur kritischen Masse gepresst wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
