                                        "glosses": [
                                            "Noble, sublime; heavenly."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "96e8fbb0-ade6-32fb-a563-1fd63fe916f2",
                                        "entry_id": "d204c003-a993-334b-b220-27fd7a3e20af",
                                        "glosses": [
                                            "Elated; blissful."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae8318ce-9dc6-4a5e-b4b0-67a865b2caf4",
                                                "sense_id": "96e8fbb0-ade6-32fb-a563-1fd63fe916f2",
                                                "text": "She felt an exalted joy after the victory."
                                            }
                                        ]
