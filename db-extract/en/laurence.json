                    {
                        "translation_id": "cc569420-e3b9-4295-b335-a74f96487701",
                        "source_entry_id": "ca7ee964-f5bd-3efc-b308-12b2767c6744",
                        "source_sense_description": "male given name",
                        "target_lang_word": "Wawrzyniec",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wawrzyniec",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "87e1fe7f-9408-339e-a312-21b9ae8881d5",
                                        "entry_id": "6a990504-0b87-3728-b362-72cd0073c27c",
                                        "glosses": [
                                            "imię męskie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c2aab24-72a1-41c6-8f04-c1e071c02f5f",
                                                "sense_id": "87e1fe7f-9408-339e-a312-21b9ae8881d5",
                                                "text": "Mój nauczyciel łaciny i greki ma na imię Wawrzyniec."
                                            },
                                            {
                                                "example_id": "97905644-c121-4685-9cfe-23e13b7f53c5",
                                                "sense_id": "87e1fe7f-9408-339e-a312-21b9ae8881d5",
                                                "text": "Wawrzyniec Hajda, zwany śląskim Wernyhorą, w swoich wierszach okolicznościowych, bajkach, podaniach i legendach głosił proroctwa o wskrzeszeniu Polski."
                                            },
                                            {
                                                "example_id": "29a2dbe0-45f3-45b7-b3e9-ea27d42f93ae",
                                                "sense_id": "87e1fe7f-9408-339e-a312-21b9ae8881d5",
                                                "text": "W Kościele katolickim na 10 sierpnia przypada wspomnienie św. Wawrzyńca z Rzymu, patrona bibliotekarzy, kucharzy, piekarzy i ubogich oraz chroniącego od reumatyzmu."
                                            },
                                            {
                                                "example_id": "c6f77064-e9d1-40db-93eb-13e8141d61c1",
                                                "sense_id": "87e1fe7f-9408-339e-a312-21b9ae8881d5",
                                                "text": "Bądź pochwalony i uwielbiony, święty Wawrzyńcze, męczenniku"
                                            },
                                            {
                                                "example_id": "2ebac390-8fc4-45c8-9d6f-9c33e4344779",
                                                "sense_id": "87e1fe7f-9408-339e-a312-21b9ae8881d5",
                                                "text": "Wawrzyńcowie dzień swego patrona, czyli imieniny, obchodzą 10 sierpnia, a także 5 września."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
