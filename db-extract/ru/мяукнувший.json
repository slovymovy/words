                                        "examples": [
                                            {
                                                "example_id": "0266b171-5af0-427e-8df1-3566e9d0b39d",
                                                "sense_id": "7866e799-e226-34e4-85b4-526a730dfe11",
                                                "text": "A cat’s meow and a cow’s moo, I can recite them all / Just tell me where it hurts you, honey"
                                            },
                                            {
                                                "example_id": "16475f86-4b46-4a44-b45e-bd8032e5e957",
                                                "sense_id": "7866e799-e226-34e4-85b4-526a730dfe11",
                                                "text": "It’s from within that breathing room the meow finally emerged. […] These days every Fantasia screening begins with a cacophony of meows — timed by the audience to start and stop at black leader."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba833f0f-b5fd-3e25-a03c-79429a82e09e",
                                        "entry_id": "cba43457-b41d-3ff3-bb32-6ba59d540862",
                                        "glosses": [
                                            "The drug mephedrone."
                                        ],
                                        "tags": [
                                            "UK",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "meow",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9a2cbcb2-c635-31bd-9105-ce220fc3cb91",
                                        "entry_id": "1099cbef-1a02-393c-8744-f8f1ef4e27d6",
                                        "glosses": [
                                            "Of a cat, to make its cry."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "192aed29-a630-45c0-a284-dab4aa7d7da8",
                                                "sense_id": "9a2cbcb2-c635-31bd-9105-ce220fc3cb91",
                                                "text": "“The last thing they had seen in 2012 before that break was a short from Simon’s Cat called ‘Cat Man Do,’” said Lamothe. “When you leave 800 people in the dark, they will do something. That’s what Fantasia is. But because they had just seen that cat go meow, they meowed.”"
                                            },
                                            {
                                                "example_id": "02615659-49b6-4def-ba3f-55ba6e82b680",
                                                "sense_id": "9a2cbcb2-c635-31bd-9105-ce220fc3cb91",
                                                "text": "The cat meows at me and bird-watches by the window facing the street. Sometimes I bird-watch with him because the older I get, the more interested I get in birds lol."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
