                    "target_lang_definitions": {
                        "zh": "指人性格放松、随和且开朗。",
                        "tr": "Rahat, huzurlu, tasasız ve keyifli.",
                        "pl": "Zrelaksowany, wyluzowany i pogodny.",
                        "it": "Rilassato, tranquillo e di buon umore.",
                        "nl": "Ontspannen, gemoedelijk en op zijn gemak."
