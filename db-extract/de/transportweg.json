                "senses": [
                    {
                        "sense_id": "90063180-1f26-3bc2-a1ed-72cb88cc7b55",
                        "entry_id": "1d5b7f46-136a-323c-942c-97ceb77a3e07",
                        "glosses": [
                            "Strecke, auf der Transporte durchgeführt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f29988d-a979-402d-824d-1e1203bf38eb",
                                "sense_id": "90063180-1f26-3bc2-a1ed-72cb88cc7b55",
                                "text": "„Je länger der Transportweg eines Produktes, desto größer ist der Schadstoffausstoß durch den Transport.“"
                            },
                            {
                                "example_id": "7e673491-aa45-435d-81c5-67fbd9cd52c8",
                                "sense_id": "90063180-1f26-3bc2-a1ed-72cb88cc7b55",
                                "text": "„Wie wichtig der Rhein als Transportweg für Massengüter und Container ist, wurde deutlich, als im März 2007 nach der Havarie eines Containerschiffes der Fluss für mehrere Tage gesperrt werden musste.“"
                            }
                        ],
