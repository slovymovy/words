                            {
                                "example_id": "40386c64-01a2-4511-a0a0-377f3c4572b1",
                                "sense_id": "68a4ab7b-5ac3-3a0c-a962-9987d86726f6",
                                "text": "Docteur en géographie de la même université, Maman Waziri Mato est un Nigérien d’origine kanuri mais familier du sud-est du Niger, à dominante hausaphone (comprenant aussi d’importantes minorités peul et bouzou), où se situe la présente étude."
                            },
                            {
                                "example_id": "b6486ed2-e1a2-4780-b69e-76e236a12157",
                                "sense_id": "68a4ab7b-5ac3-3a0c-a962-9987d86726f6",
                                "text": "Au cours de mes recherches sur l’histoire du Bornū, j’ai pu mettre au jour un vocabulaire kanuri inconnu jusqu’ici."
                            }
                        ]
                    }
                ],
