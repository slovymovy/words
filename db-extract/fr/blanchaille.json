        "fr-extract.jsonl": [
            {
                "entry_id": "47b1489b-0d2f-3cbc-8355-7ff992b6a667",
                "word": "blanchaille",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "be4403f0-8173-49e4-9800-e58b58c58ade",
                        "entry_id": "47b1489b-0d2f-3cbc-8355-7ff992b6a667",
                        "tags": [
                            "plural"
                        ],
                        "form": "blanchailles"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "78660b93-c7df-3cc4-af3e-9999854d8ed1",
                        "entry_id": "47b1489b-0d2f-3cbc-8355-7ff992b6a667",
                        "glosses": [
                            "Fretin, menu poisson qui sert ordinairement d’appât aux pêcheurs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b07333f3-a074-4abc-be01-3a2eb31c4b69",
                                "sense_id": "78660b93-c7df-3cc4-af3e-9999854d8ed1",
                                "text": "— Ça chasse, murmura Jobeau.\nLa blanchaille commençait à sauter au nez des perches ou des brochets. L'éclairage prenait du biais et les grenouilles de l'autorité."
                            },
                            {
                                "example_id": "e6b01796-1a3e-4d18-af05-d628b3fcaf4e",
                                "sense_id": "78660b93-c7df-3cc4-af3e-9999854d8ed1",
                                "text": "Au temps où on trouvait du poisson à foison, on pêchait dans la Tamise la blanchaille – terme générique pour les jeunes et petits poissons –, le sprat – appelé aussi menuise ou blanquette – et même le hareng."
                            }
                        ]
                    },
                    {
                        "sense_id": "97cfa744-7823-3416-a0d2-75b3ccb1d4e2",
                        "entry_id": "47b1489b-0d2f-3cbc-8355-7ff992b6a667",
                        "glosses": [
                            "Poisson blanc appartenant à la famille des cyprinidés, par opposition aux truites, brochets, perches et autres carnassiers."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0177c1b5-d529-4a49-b802-e41cc3862001",
                                "sense_id": "97cfa744-7823-3416-a0d2-75b3ccb1d4e2",
                                "text": "Tous ces prédateurs misent sur ces opportunes concentrations de blanchaille présente sur les frayères pour se refaire une santé à moindre coût énergétique."
                            },
                            {
                                "example_id": "dd4dd44a-0007-4edb-acc6-c825f8a205d2",
                                "sense_id": "97cfa744-7823-3416-a0d2-75b3ccb1d4e2",
                                "text": "C’est vrai qu’il avait oublié ce foutu concours ! Pourtant, il aurait bien dû y penser, avec toute cette blanchaille qui giclait autour de la barque, à croire que les poissons étaient devenus fous."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b001049a-92c5-4de9-9d7b-9f324ef789b8",
                        "source_entry_id": "47b1489b-0d2f-3cbc-8355-7ff992b6a667",
                        "target_lang_word": "small fry",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "small fry",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "11855c5c-4470-35ce-b8a0-946fcebf3e8a",
                                        "entry_id": "71a16a07-26a4-397b-92a2-9e1b660f78aa",
                                        "glosses": [
                                            "One or more small or immature fish."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "69ad82f0-9164-3160-95b2-04d5e1a54bba",
                                        "entry_id": "71a16a07-26a4-397b-92a2-9e1b660f78aa",
                                        "glosses": [
                                            "One or more children."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a0f5d319-f04e-4fb5-9d17-ae20060cc360",
                                                "sense_id": "69ad82f0-9164-3160-95b2-04d5e1a54bba",
                                                "text": "After his death in 1950, his widow and a board of trustees who were left with responsibility of running the cranberry plant decided to continue the miniature railway's services to the \"small fry\", and it opened as usual on December 6, 1951."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ba392a1-44e3-34fb-bb26-83863ff1001a",
                                        "entry_id": "71a16a07-26a4-397b-92a2-9e1b660f78aa",
                                        "glosses": [
                                            "One or more relatively small and insignificant individuals or things of relatively little consequence, importance, or value."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b40cc9f9-032d-4d40-9304-ea555ff23020",
                                                "sense_id": "4ba392a1-44e3-34fb-bb26-83863ff1001a",
                                                "text": "These slot machines are just the small fry. The big games are in the back room."
                                            },
                                            {
                                                "example_id": "61be0ec2-ed4a-4dda-aca2-b8ebb524860f",
                                                "sense_id": "4ba392a1-44e3-34fb-bb26-83863ff1001a",
                                                "text": "The police did not arrest the drug dealer since he was a small fry compared to his boss."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
