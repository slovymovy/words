                                        "sense_id": "8a9e369e-927d-30d9-bfb6-4300b9041cdd",
                                        "entry_id": "a6ceae3b-4a1c-3a30-be0e-10e54e04abaa",
                                        "glosses": [
                                            "Dépenser malhonnêtement le bien d’autrui."
                                        ],
