{
    "word_family": [
        "applause",
        "applauder",
        "applausible",
        "plaudit"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2a5a0ac8-8c38-3ecc-9957-583fcb5851fe",
                    "sense_definition": "To show approval or enjoyment by clapping the hands together.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "approval",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The audience began to <w>applaud</w> loudly as soon as the pianist finished the final note.",
                            "target_lang_translations": {
                                "ru": "Публика начала громко <w>аплодировать</w>, как только пианист закончил последнюю ноту."
                            }
                        },
                        {
                            "text": "It is polite to <w>applaud</w> the performers after a long and difficult show.",
                            "target_lang_translations": {
                                "ru": "Вежливо <w>похлопать</w> артистам после долгого и трудного выступления."
                            }
                        }
                    ],
                    "synonyms": [
                        "beclap"
                    ],
                    "antonyms": [
                        "boo",
                        "hiss"
                    ],
                    "common_phrases": [
                        "applaud the performers",
                        "applaud loudly"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выражать одобрение или удовольствие, хлопая в ладоши."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "аплодировать",
                                "target_lang_sense_clarification": "хлопать в ладоши в знак одобрения"
                            },
                            {
                                "target_lang_word": "хлопать",
                                "target_lang_sense_clarification": "разговорный вариант выражения одобрения"
                            },
                            {
                                "target_lang_word": "рукоплескать",
                                "target_lang_sense_clarification": "торжественный или книжный вариант"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a3035063-3389-382d-8876-9beff6ccb002",
                    "sense_definition": "To express strong praise or approval for an action, decision, or person.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "approval",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We <w>applaud</w> your decision to return to school and finish your degree.",
                            "target_lang_translations": {
                                "ru": "Мы <w>одобряем</w> ваше решение вернуться в учебное заведение и получить диплом."
                            }
                        },
                        {
                            "text": "Many world leaders <w>applaud</w> the courage shown by the young activists.",
                            "target_lang_translations": {
                                "ru": "Многие мировые лидеры <w>приветствуют</w> мужество, проявленное молодыми активистами."
                            }
                        }
                    ],
                    "antonyms": [
                        "criticize",
                        "condemn"
                    ],
                    "common_phrases": [
                        "applaud the decision",
                        "applaud your courage"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выражать решительную похвалу или одобрение действия, решения или человека."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "одобрять",
                                "target_lang_sense_clarification": "признавать правильным или хорошим"
                            },
                            {
                                "target_lang_word": "приветствовать",
                                "target_lang_sense_clarification": "выражать поддержку решению или идее"
                            },
                            {
                                "target_lang_word": "хвалить",
                                "target_lang_sense_clarification": "высказывать положительное мнение"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "652f6747-0742-3346-8a1a-434a4f4e438e",
                    "sense_definition": "The act of clapping or an expression of praise.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "praise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The actor received a thunderous <w>applaud</w> from the crowd after his monologue.",
                            "target_lang_translations": {
                                "ru": "Актер удостоился бурных <w>аплодисментов</w> толпы после своего монолога."
                            }
                        },
                        {
                            "text": "Such a brave act deserves a sincere <w>applaud</w> from everyone in this room.",
                            "target_lang_translations": {
                                "ru": "Такой смелый поступок заслуживает искреннего <w>одобрения</w> со стороны каждого в этом зале."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used as a noun in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт хлопанья в ладоши или выражение похвалы (устаревшее использование в качестве существительного)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "аплодисменты",
                                "target_lang_sense_clarification": "рукоплескания"
                            },
                            {
                                "target_lang_word": "одобрение",
                                "target_lang_sense_clarification": "выражение признания"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}