                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dcae3aa3-b466-4254-8c79-564cd7c9a18f",
                                                "sense_id": "43e1e582-96b0-342f-9650-79df58dbf1d1",
                                                "text": "Bei unserer Neurochirurgin sind Sie da in den besten Händen. Sie wird Ihnen auch alle weiteren Fragen beantworten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8542930e-c4eb-4946-a167-6a3649e15a4d",
                        "source_entry_id": "35361605-a213-3956-a4ee-f7f1c3bc8e62",
                        "source_sense_id": "9f4f44ff-4200-3b16-b663-97ef5db58cea",
                        "target_lang_word": "neurochirurg",
