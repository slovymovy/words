                                        "entry_id": "52ee4397-2b15-347c-b6bc-1491062f49ca",
                                        "glosses": [
                                            "ɡebrek aan dinɡen die noodzakelijk zijn om voort te kunnen leven"
                                        ],
                                        "tags": [],
