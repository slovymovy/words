                    {
                        "translation_id": "8899a629-99eb-485e-8caf-fb1007fce002",
                        "source_entry_id": "9a94d1bd-4888-378c-8af7-dea5aceb8354",
                        "source_sense_id": "1d3d7534-a13e-33fe-a6e8-da42ac1d0b63",
                        "target_lang_word": "vitiligo",
                        "target_lang_code": "fr",
