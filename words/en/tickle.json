                            "comment": "rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Нестабильный, небезопасный или легко меняющийся (архаичное)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шаткий",
                                "target_lang_sense_clarification": "неустойчивый"
                            },
                            {
                                "target_lang_word": "непостоянный",
                                "target_lang_sense_clarification": "изменчивый"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "3d0ded23-81cf-3e0b-97a5-976426b9f976",
                    "sense_definition": "In an insecure, unstable, or precarious manner.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "stability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The vase stood so <w>tickle</w> on the edge of the table that it nearly fell.",
                            "target_lang_translations": {
                                "ru": "Ваза стояла на краю стола так <w>неустойчиво</w>, что чуть не упала."
                            }
                        },
                        {
                            "text": "His reputation hung <w>tickle</w> upon the outcome of the upcoming trial.",
                            "target_lang_translations": {
                                "ru": "Его репутация <w>шатко</w> зависела от исхода предстоящего суда."
                            }
                        }
                    ],
                    "antonyms": [
                        "securely",
                        "stably"
                    ],
                    "traits": [
