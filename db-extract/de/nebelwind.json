                                "sense_id": "d8a28276-2103-36ca-9bae-36f5d18213bd",
                                "text": "„Ja, eure Reden, die so blinkend sind,",
                                "translation": "Der herbstlich durch die dürren Blätter säuselt!“"
                            },
                            {
                                "example_id": "947249a5-85ad-423f-a0d0-8395e77cb302",
                                "sense_id": "d8a28276-2103-36ca-9bae-36f5d18213bd",
                                "text": "Der Nebelwind verschlingt die heißen Zähren, Die stumme Nacht, das Schreien meiner Schmerzen, Das wesenlose Schweigen meine Klagen."
                            }
                        ],
