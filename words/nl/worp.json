                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "geboorte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De leeuwin had een <w>worp</w> van drie welpjes.",
                            "target_lang_translations": {
                                "en": "The lioness had a <w>litter</w> of three cubs."
                            }
                        },
                        {
                            "text": "Onze hond heeft een gezonde <w>worp</w> van vijf puppy's gekregen.",
                            "target_lang_translations": {
                                "en": "Our dog had a healthy <w>litter</w> of five puppies."
                            }
                        }
                    ],
                    "common_phrases": [
                        "een worp puppy's",
                        "eerste worp"
                    ],
                    "target_lang_definitions": {
                        "en": "a group of young mammals born to the same mother at the same time"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "litter",
                                "target_lang_sense_clarification": "a group of offspring born at once"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "65d3eb45-cf81-3975-80d2-46d8bf41637d",
                    "sense_definition": "het proces of de handeling van het baren bij zoogdieren",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "geboorte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De dierenarts hield toezicht op de <w>worp</w> om complicaties te voorkomen.",
                            "target_lang_translations": {
                                "en": "The veterinarian supervised the <w>birthing</w> to prevent complications."
                            }
                        },
                        {
                            "text": "Tijdens de <w>worp</w> bleef de moederpoes opvallend rustig.",
                            "target_lang_translations": {
