                ],
                "translations": [
                    {
                        "translation_id": "35787012-6736-466f-b056-182f7d101ac8",
                        "source_entry_id": "b54b0440-c2c1-3abb-bae0-b86ec9e7147e",
                        "source_sense_id": "8b256a46-62af-35fa-b0bc-a1dab347f065",
                        "source_sense_description": "Forscherin auf dem Gebiet der Naturwissenschaften",
                        "target_lang_word": "natural scientist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "natural scientist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "21fe5f12-e486-313b-a6b6-e49a90605363",
                                        "entry_id": "d2812d9f-f7c2-325e-9349-6cc26b65f4ba",
                                        "glosses": [
                                            "A scientist dedicated to natural science."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4c0271e-bcb6-4d5b-9fc7-4e5effcaadb0",
                                                "sense_id": "21fe5f12-e486-313b-a6b6-e49a90605363",
                                                "text": "Becoming more aware of the progress that scientists have made on behavioral fronts can reduce the risk that other natural scientists will resort to mystical agential accounts when they exceed the limits of their own disciplinary training."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2d8b29b5-90da-4a28-887a-f77d0985027c",
                        "source_entry_id": "b54b0440-c2c1-3abb-bae0-b86ec9e7147e",
                        "source_sense_id": "8b256a46-62af-35fa-b0bc-a1dab347f065",
                        "source_sense_description": "Forscherin auf dem Gebiet der Naturwissenschaften",
                        "target_lang_word": "naturaliste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "naturaliste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "33be23e5-8912-36e3-b57e-b055c912977a",
                                        "entry_id": "ec20e2e4-0233-32df-bf15-b1b9c283e4e7",
                                        "glosses": [
                                            "Qualifie un romancier partisan du naturalisme, ou une œuvre littéraire répondant aux principes du naturalisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75089294-f4c9-424d-b8e9-9a871f6dfd0d",
                                                "sense_id": "33be23e5-8912-36e3-b57e-b055c912977a",
                                                "text": "Les romanciers naturalistes."
                                            },
                                            {
                                                "example_id": "f1617b30-265f-4ce0-a345-e6baad35b8c9",
                                                "sense_id": "33be23e5-8912-36e3-b57e-b055c912977a",
                                                "text": "Un roman naturaliste."
                                            },
                                            {
                                                "example_id": "895676a6-fa87-4729-8183-8d06c7bbefea",
                                                "sense_id": "33be23e5-8912-36e3-b57e-b055c912977a",
                                                "text": "L'École naturaliste."
                                            },
                                            {
                                                "example_id": "a8d0a494-ece5-4571-b90d-79450e4555c5",
                                                "sense_id": "33be23e5-8912-36e3-b57e-b055c912977a",
                                                "text": "Et c'est le théâtre naturaliste. C'est, pour faire vrai, l'acteur tournant le dos au public. C'est le quartier de viande saignant. C'est la réalité crue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d0056226-ad85-323f-8e90-03b837637036",
                                        "entry_id": "ec20e2e4-0233-32df-bf15-b1b9c283e4e7",
                                        "glosses": [
                                            "Conforme au naturalisme, approche des sciences humaines selon laquelle il existe une réalité objective répondant à un certain nombre de règles, par opposition au constructivisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "edfab6ce-ad5a-4d42-b8b5-9df9de35944f",
                                                "sense_id": "d0056226-ad85-323f-8e90-03b837637036",
                                                "text": "Selon la conception naturaliste (ou positiviste) de la science, il existerait des régularités et des tendances générales dans le comportement humain qui peuvent être décelées grâce à l'expérimentation et à l'observation."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "naturaliste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a487877c-8f7b-3fc3-bb16-3db995ff7cbc",
                                        "entry_id": "4fb46353-1ac0-3077-bcfe-db88b564dcea",
                                        "glosses": [
                                            "Romancier partisan du naturalisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7185ad82-16f1-412d-ab6a-b800137115a7",
                                                "sense_id": "a487877c-8f7b-3fc3-bb16-3db995ff7cbc",
                                                "text": "Élevée par des parents soigneux de ses lectures et n’ayant pas beaucoup d’idées dans la cervelle, mais les ayant saines et bonnes, jamais elle ne connut les Naturalistes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ad2eb27-1901-3635-acd7-f8c96cf1da61",
                                        "entry_id": "4fb46353-1ac0-3077-bcfe-db88b564dcea",
                                        "glosses": [
                                            "Savant qui s’applique à l’histoire naturelle, qui s’attache à l’étude des plantes, des minéraux, des animaux, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "99d398f1-867f-4a70-84c2-425bf0e9acc3",
                                                "sense_id": "4ad2eb27-1901-3635-acd7-f8c96cf1da61",
                                                "text": "Celui qui ne connaît d'un animal que le nom et la place qui lui revient dans un système de nomenclature plus ou moins bien assis, ne mérite pas plus le titre de naturaliste qu'un garçon de bibliothèque n'est digne de l'épithète de savant parce qu'il sait par cœur le titre de ses livres, leur numéro d'ordre et la case où ils sont logés."
                                            },
                                            {
                                                "example_id": "edae7d82-4e34-4bdd-a412-f0e3afacf736",
                                                "sense_id": "4ad2eb27-1901-3635-acd7-f8c96cf1da61",
                                                "text": "Ce sont les pigeons, pour la douceur desquels quelques naturalistes ont escrit qu’eux et les tourtres estoient sans fiel."
                                            },
                                            {
                                                "example_id": "007bbe5f-1ffb-49cd-94f7-c44d2075abf1",
                                                "sense_id": "4ad2eb27-1901-3635-acd7-f8c96cf1da61",
                                                "text": "Un naturaliste allemand, envoyé par une société scientifique de son pays, habitait également Adwa."
                                            },
                                            {
                                                "example_id": "63116f62-545c-43b1-afb4-df217477afbf",
                                                "sense_id": "4ad2eb27-1901-3635-acd7-f8c96cf1da61",
                                                "text": "Autour de cette vasque, sous d'élégantes vitrines fixées par des armatures de cuivre, étaient classés et étiquetés les plus précieux produits de la mer qui eussent jamais été livrés aux regards d'un naturaliste. On conçoit ma joie de professeur."
                                            },
                                            {
                                                "example_id": "013fe35d-0936-49f6-a945-61f6a32f9b4c",
                                                "sense_id": "4ad2eb27-1901-3635-acd7-f8c96cf1da61",
                                                "text": "Très vite incriminés, les naturalistes ont procédé à une enquête visant à reconstituer la progression des loups depuis les Abruzzes jusqu'au Mercantour."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f539ab4-618f-3de4-b6b1-0771d10b6e44",
                                        "entry_id": "4fb46353-1ac0-3077-bcfe-db88b564dcea",
                                        "glosses": [
                                            "Taxidermiste."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
