                        "entry_id": "97b0b1bc-c7d7-3330-b90a-206d9cedc25b",
                        "glosses": [
                            "Musikinstrument, das für die Erzeugung und Erhaltung der Harmonien in Musikstücken zuständig ist"
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "b26c5fa0-b3fa-4393-a14c-215b730a0dc7",
                                "sense_id": "cd517669-4ae2-3539-83a4-94ff943814fe",
                                "text": "„Und der rein elektronischen Musik eine handgemachte Alternative entgegensetzen: Tanzmusik mit Dreck unter den Fingernägeln. »Wir haben absichtlich alle Harmonieinstrumente draußen gelassen«, sagt Dettl. Wenn es um den Tanzboden geht, bleibe kein Platz für Verzierungen und Kleinkunst-Gift.“"
                            }
                        ],
