                "senses": [
                    {
                        "sense_id": "791d4cf4-bbdd-3929-8bef-f19baed84755",
                        "entry_id": "1c9011fb-0040-39b9-9f42-49fe6077400d",
                        "glosses": [
                            "Gesamtheit der Unternehmen, die zum Verbrauch bestimmte Güter herstellen oder Dienstleistungen zur Herstellung von diesen Produkten anbieten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e07373e0-200e-4fa8-8e0c-6b672f270cd5",
                                "sense_id": "791d4cf4-bbdd-3929-8bef-f19baed84755",
                                "text": "„Vor dem Krieg hatte es in der Gegend Leichtindustrie gegeben, die später nicht zurückgekehrt war.“"
                            },
                            {
                                "example_id": "02bbb8e2-478c-4356-8392-a442cb6c8761",
                                "sense_id": "791d4cf4-bbdd-3929-8bef-f19baed84755",
                                "text": "„Einer dieser Bereiche ist der Industriesektor, in dem die Regierung Dubais sich auf zwei Gebiete fokussiert: die Agrar- und die Leichtindustrie.“"
                            },
                            {
                                "example_id": "4161dbeb-4cbe-47a7-b300-76b0cc175949",
                                "sense_id": "791d4cf4-bbdd-3929-8bef-f19baed84755",
                                "text": "„Die Industrie Fujians hat in den letzten Jahren einen Übergang von Schwer- zur Leichtindustrie durchgemacht.“"
                            },
                            {
                                "example_id": "6512c096-99c1-4b0b-9cbb-2bd560bfa8ca",
                                "sense_id": "791d4cf4-bbdd-3929-8bef-f19baed84755",
                                "text": "„Somit gehörte die Textilindustrie wie andere Zweige der so genannten Leichtindustrie zu den ‚großen Verlierer[n]‘ des Strukturwandels der 1950er Jahre.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
