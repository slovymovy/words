                    {
                        "translation_id": "d1b832d1-feb1-4a9f-8313-9ab69db4dfa5",
                        "source_entry_id": "0b815027-4627-3da9-a1a8-76287786a2a2",
                        "source_sense_id": "04f20c85-08b6-34e9-806d-04cf475a5ee0",
                        "source_sense_description": "een volmaakte toestand die niet te bereiken is",
                        "target_lang_word": "утопия",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "утопия",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "af22a59e-eac6-3857-bc4e-b7ec0cc0dedc",
                                        "entry_id": "d97e5967-a6e8-3198-9eb0-5193743a10c5",
                                        "glosses": [
                                            "изображение идеального общественного строя, лишённое научного обоснования"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c05e6f95-4995-48b9-a1a6-13084f0be93c",
                                                "sense_id": "af22a59e-eac6-3857-bc4e-b7ec0cc0dedc",
                                                "text": "Утопии общественной мысли."
                                            },
                                            {
                                                "example_id": "02893cbc-1394-4f17-949b-10d44b0df1db",
                                                "sense_id": "af22a59e-eac6-3857-bc4e-b7ec0cc0dedc",
                                                "text": "Излагать свои утопии."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b286ffac-2866-328c-aa9f-fa4df9f76064",
                                        "entry_id": "d97e5967-a6e8-3198-9eb0-5193743a10c5",
                                        "glosses": [
                                            "произведение, рисующее картины идеального общественного строя в полном отрыве от реальности, от закономерностей в развитии общества"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d315d82-d42c-4dc4-8e90-258b6c78bb79",
                                                "sense_id": "b286ffac-2866-328c-aa9f-fa4df9f76064",
                                                "text": "Писать утопии."
                                            },
                                            {
                                                "example_id": "09da8907-43ed-4990-a0a7-4a95453376c6",
                                                "sense_id": "b286ffac-2866-328c-aa9f-fa4df9f76064",
                                                "text": "Читать утопию."
                                            },
                                            {
                                                "example_id": "0dd5b9c8-bdc5-49aa-8eac-2fdc9b086be4",
                                                "sense_id": "b286ffac-2866-328c-aa9f-fa4df9f76064",
                                                "text": "Излагать в своих утопиях."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0abbf7af-e713-39a0-bd5a-bdaebbeb8aa1",
                                        "entry_id": "d97e5967-a6e8-3198-9eb0-5193743a10c5",
                                        "glosses": [
                                            "жанр художественной литературы, близкий к научной фантастике, описывающий модель идеального, с точки зрения автора, общества"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c47bd34-0871-4e29-bf45-66023cc85eb1",
                                                "sense_id": "0abbf7af-e713-39a0-bd5a-bdaebbeb8aa1",
                                                "text": "Наконец, в эту сатиру проник существенный сюжетный элемент, благодаря сочетанию её с жанром фантастических путешествий в утопические страны (утопия искони тяготела к народно-праздничным формам) и с пародиями на спуски в преисподнюю и подъёмы на небо."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "798b2c4b-9890-31cd-adcf-8514de1be129",
                                        "entry_id": "d97e5967-a6e8-3198-9eb0-5193743a10c5",
                                        "glosses": [
                                            "перен. неосуществимая мечта; вымысел, фантазия"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bcfabd27-3b50-466e-a790-71bafee7d13d",
                                                "sense_id": "798b2c4b-9890-31cd-adcf-8514de1be129",
                                                "text": "Дело в том, что «сюрпризы» на эстраде — вещь неизбежная, оберечься от них — такая же утопия, как оберечься на улице от ветра."
                                            },
                                            {
                                                "example_id": "53dabd9c-980c-480e-ad59-2c308e54d7dd",
                                                "sense_id": "798b2c4b-9890-31cd-adcf-8514de1be129",
                                                "text": "По закону, ваш паспорт должны обменять на новый в течение 10 дней. Так и было ещё полгода — год назад. Но сейчас это уже утопия. Лично мне пришлось ждать три недели, и это не предел."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
