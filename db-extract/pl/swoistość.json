                "senses": [
                    {
                        "sense_id": "8dfe8198-3da5-3c14-86f1-4918a2a0fcdb",
                        "entry_id": "40752856-afca-3748-974c-de24d2ce128a",
                        "glosses": [
                            "zespół cech wyróżniających"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d45dd75-e535-48af-a693-b2f7a6607834",
                                "sense_id": "8dfe8198-3da5-3c14-86f1-4918a2a0fcdb",
                                "text": "Powszechnie wiadomo, że na swoistość jego twórczości wpłynęły lata emigracyjne."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "440b0928-556f-4f3c-8ef5-b855b23d41a8",
                        "source_entry_id": "40752856-afca-3748-974c-de24d2ce128a",
                        "source_sense_id": "8dfe8198-3da5-3c14-86f1-4918a2a0fcdb",
                        "target_lang_word": "particularité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "particularité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "364a71e3-c01d-35a2-af73-d0e596e890d4",
                                        "entry_id": "53a6c37f-6f20-39b8-a24d-b98d07b16b62",
                                        "glosses": [
                                            "Caractère particulier d’un objet, d’une chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "adf66d3d-4077-474d-af2a-a4b413fd2431",
                                                "sense_id": "364a71e3-c01d-35a2-af73-d0e596e890d4",
                                                "text": "Le lorrain, dont la prononciation reproduit souvent la nôtre dans ses particularités les plus caractéristiques, dit aussi ma, pâ, jemâ pour mais, paix, jamais : si v'piâ z = s'il vous plaît."
                                            },
                                            {
                                                "example_id": "2f98a82b-44d5-4cee-8f01-72cf239a0d88",
                                                "sense_id": "364a71e3-c01d-35a2-af73-d0e596e890d4",
                                                "text": "Ainsi parlait Hérodote des Sassanides, soulignant la particularité du zoroastrisme, culte officiel de l’État perse de l'époque : son monothéisme. Bien avant l’avènement du christianisme et sans doute du judaïsme, les zoroastriens plaçaient leur foi en une divinité unique et abstraite, Ahura Mazda (…)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3442f082-c8eb-3f49-8906-ad45b548820c",
                                        "entry_id": "53a6c37f-6f20-39b8-a24d-b98d07b16b62",
                                        "glosses": [
                                            "Circonstance particulière."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b788025-0bdd-4ea6-9edf-1239f52e2dcc",
                                                "sense_id": "3442f082-c8eb-3f49-8906-ad45b548820c",
                                                "text": "Vous venez de le voir, mon jeune ami, reprit le vieillard, il était impossible que vous restassiez plus longtemps parmi nous sans connaître quelques-unes des affreuses particularités de la vie de cette sainte femme."
                                            },
                                            {
                                                "example_id": "af52b49f-6c90-45f4-ba2e-dbb3b5ada54c",
                                                "sense_id": "3442f082-c8eb-3f49-8906-ad45b548820c",
                                                "text": "Particularité essentielle, remarquable, importante, curieuse."
                                            },
                                            {
                                                "example_id": "404e244d-3b60-4266-8c9d-e7b69b814ec7",
                                                "sense_id": "3442f082-c8eb-3f49-8906-ad45b548820c",
                                                "text": "Il m’a conté toutes les particularités de cette affaire."
                                            },
                                            {
                                                "example_id": "f61b0669-3c5d-477b-ae31-07200b1ada33",
                                                "sense_id": "3442f082-c8eb-3f49-8906-ad45b548820c",
                                                "text": "Il a omis dans son récit plusieurs particularités nécessaires."
                                            },
                                            {
                                                "example_id": "f29c1acc-211f-42f7-8c1d-4be56932a554",
                                                "sense_id": "3442f082-c8eb-3f49-8906-ad45b548820c",
                                                "text": "Je ne savais pas cette particularité de sa vie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
