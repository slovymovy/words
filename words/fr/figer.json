    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3c4b6ac5-be56-365e-82d2-331aa3598040",
                    "sense_definition": "Rendre solide ou pâteux un liquide, notamment sous l'action du froid ; se coaguler.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "solidification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'air froid de l'hiver <w>fige</w> rapidement la graisse au fond du plat."
                        },
                        {
                            "text": "La sauce commence à se <w>figer</w> si on ne la sert pas immédiatement."
                        }
                    ],
                    "synonyms": [
                        "coaguler",
                        "solidifier"
                    ],
                    "antonyms": [
                        "défiger"
                    ],
                    "common_phrases": [
                        "se figer",
                        "faire figer"
                    ]
                },
                {
                    "sense_id": "bb3adb34-8acb-36ea-957e-0c9ce6c0b24d",
                    "sense_definition": "Immobiliser ou paralyser quelqu'un sous l'effet d'une vive émotion comme la peur ou la surprise.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "immobilite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le bruit soudain dans le couloir l'a fait se <w>figer</w> sur place."
                        },
                        {
                            "text": "La panique semblait <w>figer</w> tous les témoins de la scène."
                        }
                    ],
                    "synonyms": [
                        "paralyser",
                        "pétrifier"
                    ],
                    "common_phrases": [
                        "se figer sur place"
                    ]
                },
                {
                    "sense_id": "f9428afc-9be3-33f9-882e-71a903e0583d",
                    "sense_definition": "Rendre fixe ou invariable ; bloquer une situation en empêchant toute évolution.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "immobilite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vouloir <w>figer</w> la langue empêcherait toute création de nouveaux mots."
                        },
                        {
                            "text": "Cette décision risque de <w>figer</w> les négociations pendant plusieurs mois."
                        }
                    ],
                    "synonyms": [
                        "bloquer",
                        "cristalliser",
                        "fixer"
                    ],
                    "common_phrases": [
                        "figer la situation"
                    ]
                }
            ]
        }
    ]
