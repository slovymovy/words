                "senses": [
                    {
                        "sense_id": "e799e53d-ef17-377d-80df-bb856adb828e",
                        "entry_id": "892b169e-ca26-3e6c-b267-dbdd82f444f2",
                        "glosses": [
                            "past active perfective participle of почерне́ть (počernétʹ)"
                        ],
                        "tags": [
                            "active",
                            "form-of",
                            "participle",
