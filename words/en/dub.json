{
    "word_family": [
        "dubbing",
        "dubber",
        "redub"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a2f542ed-8612-3257-a211-eb53de26fe78",
                    "sense_definition": "To give a name, title, or nickname to someone or something.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "naming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The media quickly <w>dubbed</w> the new stadium the Glass Palace because of its transparent roof.",
                            "target_lang_translations": {
                                "ru": "СМИ быстро <w>окрестили</w> новый стадион «Стеклянным дворцом» из-за его прозрачной крыши."
                            }
                        },
                        {
                            "text": "He was <w>dubbed</w> the king of pop by his many fans around the world.",
                            "target_lang_translations": {
                                "ru": "Многочисленные фанаты по всему миру <w>прозвали</w> его королем поп-музыки."
                            }
                        }
                    ],
                    "synonyms": [
                        "name",
                        "call",
                        "entitle",
                        "style",
                        "term",
                        "designate"
                    ],
                    "common_phrases": [
                        "dubbed the king",
                        "dubbed a hero",
                        "officially dubbed"
                    ],
                    "target_lang_definitions": {
                        "ru": "Дать имя, название или прозвище кому-либо или чему-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "окрестить",
                                "target_lang_sense_clarification": "дать имя или прозвище"
                            },
                            {
                                "target_lang_word": "прозвать",
                                "target_lang_sense_clarification": "дать кличку или прозвище"
                            },
                            {
                                "target_lang_word": "нарекать",
                                "target_lang_sense_clarification": "торжественно называть"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e7087c64-9034-3b1e-a853-a84ff66cc478",
                    "sense_definition": "To replace the original speech in a film or television program with a translation into another language.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "audio_production",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I prefer watching foreign movies with subtitles rather than seeing a <w>dubbed</w> version.",
                            "target_lang_translations": {
                                "ru": "Я предпочитаю смотреть иностранные фильмы с субтитрами, а не <w>дублированную</w> версию."
                            }
                        },
                        {
                            "text": "They had to <w>dub</w> the film into English for the international audience.",
                            "target_lang_translations": {
                                "ru": "Им пришлось <w>дублировать</w> фильм на английский язык для международной аудитории."
                            }
                        }
                    ],
                    "common_phrases": [
                        "dubbed into English",
                        "dub a movie",
                        "dubbed version"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заменить оригинальную речь в фильме или телепрограмме переводом на другой язык."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дублировать",
                                "target_lang_sense_clarification": "заменять звуковую дорожку переводом"
                            },
                            {
                                "target_lang_word": "озвучивать",
                                "target_lang_sense_clarification": "записывать новую фонограмму"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9ccebcbc-9e67-3985-a4ca-6ef393955427",
                    "sense_definition": "To confer knighthood upon someone by touching their shoulder with a sword.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "naming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The Queen will <w>dub</w> him a knight during the ceremony at the palace tomorrow.",
                            "target_lang_translations": {
                                "ru": "Завтра во время церемонии во дворце королева <w>посвятит</w> его в рыцари."
                            }
                        },
                        {
                            "text": "He knelt before the monarch to be <w>dubbed</w> Sir Thomas.",
                            "target_lang_translations": {
                                "ru": "Он преклонил колени перед монархом, чтобы быть <w>посвященным</w> в сэры Томасы."
                            }
                        }
                    ],
                    "synonyms": [
                        "knight"
                    ],
                    "common_phrases": [
                        "dub a knight",
                        "dubbed sir"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "historical or formal context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Посвящать в рыцари, касаясь плеча мечом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "посвящать в рыцари",
                                "target_lang_sense_clarification": "совершать обряд посвящения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e1a2db88-d1ae-379c-87de-7dfe8bc64006",
                    "sense_definition": "To consider or regard someone or something as having a specific quality.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "naming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The project was <w>dubbed</w> a failure by the critics before it even started.",
                            "target_lang_translations": {
                                "ru": "Критики <w>окрестили</w> проект провальным еще до его начала."
                            }
                        },
                        {
                            "text": "She was <w>dubbed</w> a genius after solving the complex mathematical problem.",
                            "target_lang_translations": {
                                "ru": "Ее <w>провозгласили</w> гением после того, как она решила сложную математическую задачу."
                            }
                        }
                    ],
                    "synonyms": [
                        "deem",
                        "consider",
                        "regard as",
                        "account"
                    ],
                    "common_phrases": [
                        "dubbed a success",
                        "dubbed a failure"
                    ],
                    "target_lang_definitions": {
                        "ru": "Считать или называть кого-либо или что-либо обладающим определенным качеством."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "окрестить",
                                "target_lang_sense_clarification": "назвать каким-либо образом"
                            },
                            {
                                "target_lang_word": "провозгласить",
                                "target_lang_sense_clarification": "объявить кем-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5929619a-ffe9-3e8b-bb74-fed8f66c1c81",
                    "sense_definition": "To make a copy of an audio or video recording.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "audio_production",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Back in the nineties, we used to <w>dub</w> songs from the radio onto cassette tapes.",
                            "target_lang_translations": {
                                "ru": "В девяностые мы <w>перезаписывали</w> песни с радио на кассеты."
                            }
                        },
                        {
                            "text": "He asked his friend to <w>dub</w> a copy of the rare vinyl record for him.",
                            "target_lang_translations": {
                                "ru": "Он попросил друга <w>сделать копию</w> редкой виниловой пластинки для него."
                            }
                        }
                    ],
                    "synonyms": [
                        "copy"
                    ],
                    "common_phrases": [
                        "dub a tape",
                        "dub a copy"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "primarily refers to analog media"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделать копию аудио- или видеозаписи."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "копировать",
                                "target_lang_sense_clarification": "делать дубликат записи"
                            },
                            {
                                "target_lang_word": "перезаписывать",
                                "target_lang_sense_clarification": "переносить запись на другой носитель"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "68fb7c59-f9e2-3c83-a93d-46c6435f9840",
                    "sense_definition": "The process or result of replacing the original voices in a film with those of different actors, often in a different language.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "audio_production",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>dub</w> of the anime was surprisingly well-acted and stayed true to the script.",
                            "target_lang_translations": {
                                "ru": "<w>Дубляж</w> этого аниме был на удивление хорошо озвучен и соответствовал сценарию."
                            }
                        },
                        {
                            "text": "Many fans prefer the original Japanese audio over the English <w>dub</w>.",
                            "target_lang_translations": {
                                "ru": "Многие фанаты предпочитают оригинальный японский звук английской <w>озвучке</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "English dub",
                        "anime dub",
                        "bad dub"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс или результат замены оригинальных голосов в фильме голосами других актеров."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дубляж",
                                "target_lang_sense_clarification": "процесс или результат перевода"
                            },
                            {
                                "target_lang_word": "озвучка",
                                "target_lang_sense_clarification": "разговорное обозначение дубляжа"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "226df1eb-33c5-3777-9082-c1ec90597a85",
                    "sense_definition": "A victory or win, especially in sports or gaming.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "slang_terms",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Our team finally caught a <w>dub</w> after losing five matches in a row.",
                            "target_lang_translations": {
                                "ru": "Наша команда наконец-то <w>победила</w> после пяти поражений подряд."
                            }
                        },
                        {
                            "text": "He was so happy to get the <w>dub</w> in the final round of the tournament.",
                            "target_lang_translations": {
                                "ru": "Он был так счастлив <w>выиграть</w> в финальном раунде турнира."
                            }
                        }
                    ],
                    "synonyms": [
                        "win",
                        "victory"
                    ],
                    "antonyms": [
                        "loss",
                        "defeat"
                    ],
                    "common_phrases": [
                        "catch a dub",
                        "get the dub",
                        "take the dub"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "common in gaming and youth culture"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Победа, особенно в спорте или видеоиграх."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "победа",
                                "target_lang_sense_clarification": "выигрыш"
                            },
                            {
                                "target_lang_word": "вин",
                                "target_lang_sense_clarification": "игровой сленг"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "528c0b00-d62a-3bc3-88ed-2f8813d0b33d",
                    "sense_definition": "A style of music, originally a subgenre of reggae, characterized by the remixing of existing recordings with heavy bass and echo effects.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "music_genres",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The DJ played a heavy <w>dub</w> set that kept the crowd dancing all night.",
                            "target_lang_translations": {
                                "ru": "Диджей отыграл мощный <w>даб</w>-сет, под который толпа танцевала всю ночь."
                            }
                        },
                        {
                            "text": "This track features the deep basslines and reverb typical of classic <w>dub</w>.",
                            "target_lang_translations": {
                                "ru": "В этом треке слышны глубокие басовые линии и реверберация, типичные для классического <w>даба</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "dub music",
                        "dub remix",
                        "reggae dub"
                    ],
                    "target_lang_definitions": {
                        "ru": "Музыкальный стиль, поджанр регги, характеризующийся ремиксами с тяжелым басом и эхо-эффектами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "даб",
                                "target_lang_sense_clarification": "музыкальный жанр"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b88326d1-0418-3309-98b7-de94c3f45559",
                    "sense_definition": "An unskillful or clumsy person.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "people",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He felt like a total <w>dub</w> on the golf course, hitting the ball into the water twice.",
                            "target_lang_translations": {
                                "ru": "На поле для гольфа он чувствовал себя полным <w>неумехой</w>, дважды отправив мяч в воду."
                            }
                        },
                        {
                            "text": "Don't be such a <w>dub</w> and try to focus on the task at hand.",
                            "target_lang_translations": {
                                "ru": "Не будь таким <w>растяпой</w> и постарайся сосредоточиться на задаче."
                            }
                        }
                    ],
                    "synonyms": [
                        "clumsy",
                        "bungler",
                        "amateur"
                    ],
                    "antonyms": [
                        "expert",
                        "pro"
                    ],
                    "common_phrases": [
                        "local dub",
                        "total dub"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "rarely used in modern speech"
                        },
                        {
                            "trait_type": "colloquial",
                            "comment": "informal insult"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Неумелый или неуклюжий человек."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неумеха",
                                "target_lang_sense_clarification": "неловкий человек"
                            },
                            {
                                "target_lang_word": "растяпа",
                                "target_lang_sense_clarification": "неуклюжий человек"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "68235708-c8e8-33d3-933a-c2c7d30e2746",
                    "sense_definition": "A person who comes from Dublin, Ireland.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "demonyms",
                    "name_type": "ethnic_group_name",
                    "examples": [
                        {
                            "text": "You can always tell a <w>Dub</w> by their distinct accent and quick wit.",
                            "target_lang_translations": {
                                "ru": "<w>Дублинца</w> всегда можно узнать по характерному акценту и остроумию."
                            }
                        },
                        {
                            "text": "The stadium was packed with <w>Dubs</w> cheering for their home team.",
                            "target_lang_translations": {
                                "ru": "Стадион был забит <w>дублинцами</w>, болеющими за свою родную команду."
                            }
                        }
                    ],
                    "synonyms": [
                        "Dubliner"
                    ],
                    "common_phrases": [
                        "true Dub",
                        "Dub accent"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "specifically Irish"
                        },
                        {
                            "trait_type": "colloquial",
                            "comment": "informal demonym"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек родом из Дублина, Ирландия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дублинец",
                                "target_lang_sense_clarification": "житель Дублина"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}