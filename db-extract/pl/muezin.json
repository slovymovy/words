                        "entry_id": "e7f11736-f16e-34ad-aada-fbe86003e109",
                        "glosses": [
                            "w islamie: mężczyzna wzywający z minaretu pięć razy dziennie wiernych na modlitwę"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a421ec0-7497-4571-858f-c5ba5f68e7dd",
                                "sense_id": "000967e5-915d-3b5b-b32f-b3d13f711ec5",
                                "text": "Mieszkańcy Stambułu od dawna skarżyli się na fałszujących muezinów wzywających ich na modły do meczetów"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "23c61b4b-1616-4084-8c6c-49efac7fb821",
