{
    "word_family": [
        "determine",
        "determination",
        "determinant",
        "determinism"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "5bbe5104-ffef-3f1a-8df2-828463e80e32",
                    "sense_definition": "Distinct and clearly defined.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "defined",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The project requires a <w>determinate</w> number of participants to proceed.",
                            "target_lang_translations": {
                                "nl": "Het project vereist een <w>bepaald</w> aantal deelnemers om door te gaan."
                            }
                        },
                        {
                            "text": "The contract must specify a <w>determinate</w> delivery date, not just as soon as possible.",
                            "target_lang_translations": {
                                "nl": "Het contract moet een <w>bepaalde</w> leverdatum vermelden, niet alleen zo snel mogelijk."
                            }
                        }
                    ],
                    "synonyms": [
                        "definite",
                        "precise"
                    ],
                    "antonyms": [
                        "indeterminate"
                    ],
                    "target_lang_definitions": {
                        "nl": "Onderscheidend en duidelijk gedefinieerd."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "bepaald",
                                "target_lang_sense_clarification": "Duidelijk vastgesteld of omschreven."
                            },
                            {
                                "target_lang_word": "precies",
                                "target_lang_sense_clarification": "Nauwkeurig en zonder twijfel."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d9899b3e-347e-3d39-9c52-a04ac72e65eb",
                    "sense_definition": "Fixed, set, or unvarying.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "defined",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The schedule follows a <w>determinate</w> pattern throughout the year.",
                            "target_lang_translations": {
                                "nl": "Het schema volgt het hele jaar door een <w>vast</w> patroon."
                            }
                        },
                        {
                            "text": "They acted with a <w>determinate</w> purpose that ensured their success.",
                            "target_lang_translations": {
                                "nl": "Ze handelden met een <w>vastberaden</w> doel dat hun succes verzekerde."
                            }
                        }
                    ],
                    "synonyms": [
                        "fixed",
                        "set"
                    ],
                    "antonyms": [
                        "indeterminate"
                    ],
                    "target_lang_definitions": {
                        "nl": "Vaststaand, onveranderlijk of volgens een vast patroon."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "vast",
                                "target_lang_sense_clarification": "Niet veranderlijk of onveranderlijk."
                            },
                            {
                                "target_lang_word": "bepaald",
                                "target_lang_sense_clarification": "Vastgelegd of vastgesteld."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "28a85952-0d38-3887-8894-2c76f15ce684",
                    "sense_definition": "Resolved or decided upon.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "resolved",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The committee's position on the matter is now <w>determinate</w> and will not be reopened.",
                            "target_lang_translations": {
                                "nl": "Het standpunt van de commissie in deze zaak is nu <w>vastgesteld</w> en wordt niet opnieuw ter discussie gesteld."
                            }
                        },
                        {
                            "text": "They finally agreed on a <w>determinate</w> plan for the renovation.",
                            "target_lang_translations": {
                                "nl": "Ze kwamen eindelijk overeen over een <w>besloten</w> plan voor de renovatie."
                            }
                        }
                    ],
                    "synonyms": [
                        "decided",
                        "resolved"
                    ],
                    "target_lang_definitions": {
                        "nl": "Besloten of vastgelegd na overweging."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "besloten",
                                "target_lang_sense_clarification": "Waarover een besluit is genomen."
                            },
                            {
                                "target_lang_word": "vastgesteld",
                                "target_lang_sense_clarification": "Definitief gekozen of gepland."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8c40d2c5-e0d9-3772-8277-0efe323589ac",
                    "sense_definition": "Showing a strong and resolute purpose.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "resolved",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was <w>determinate</w> to finish the task despite the obstacles.",
                            "target_lang_translations": {
                                "nl": "Hij was <w>vastberaden</w> om de taak te voltooien ondanks de obstakels."
                            }
                        },
                        {
                            "text": "The leader remained <w>determinate</w> in her vision for the company.",
                            "target_lang_translations": {
                                "nl": "De leider bleef <w>vastberaden</w> in haar visie voor het bedrijf."
                            }
                        }
                    ],
                    "synonyms": [
                        "resolute",
                        "determined"
                    ],
                    "target_lang_definitions": {
                        "nl": "Met een sterke en vastberaden wil."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "vastberaden",
                                "target_lang_sense_clarification": "Met een duidelijk doel voor ogen."
                            },
                            {
                                "target_lang_word": "beslist",
                                "target_lang_sense_clarification": "Zeker van de eigen zaak."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7c4cd9ac-4699-3163-aadd-719479752ba1",
                    "sense_definition": "Conclusive or decisive.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "defined",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The evidence provided a <w>determinate</w> answer to the mystery.",
                            "target_lang_translations": {
                                "nl": "Het bewijs gaf een <w>beslissend</w> antwoord op het mysterie."
                            }
                        },
                        {
                            "text": "The judge gave a <w>determinate</w> ruling on the case.",
                            "target_lang_translations": {
                                "nl": "De rechter gaf een <w>definitieve</w> uitspraak in de zaak."
                            }
                        }
                    ],
                    "synonyms": [
                        "conclusive",
                        "decisive"
                    ],
                    "target_lang_definitions": {
                        "nl": "Beslissend of sluitend."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "beslissend",
                                "target_lang_sense_clarification": "Wat de doorslag geeft."
                            },
                            {
                                "target_lang_word": "definitief",
                                "target_lang_sense_clarification": "Wat niet meer verandert."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1da2e2fe-fa16-3c7d-ade1-9d41f50ed308",
                    "sense_definition": "Ending once a specific structure has formed, often used in biology.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "defined",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The plant exhibits <w>determinate</w> growth, stopping after the flower blooms.",
                            "target_lang_translations": {
                                "nl": "De plant vertoont <w>bepaalde</w> groei, die stopt nadat de bloem bloeit."
                            }
                        },
                        {
                            "text": "Some species have a <w>determinate</w> life cycle that ends after reproduction.",
                            "target_lang_translations": {
                                "nl": "Sommige soorten hebben een <w>bepaalde</w> levenscyclus die eindigt na de voortplanting."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Eindigend zodra een specifieke structuur is gevormd (biologie)."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "bepaald",
                                "target_lang_sense_clarification": "Met een vastgelegde groeiwijze."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4240775c-87d1-3d1b-af30-9cf54dc9c250",
                    "sense_definition": "A specific state of a particular attribute.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "defined",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Red and blue are <w>determinates</w> of the color attribute.",
                            "target_lang_translations": {
                                "nl": "Rood en blauw zijn <w>bepalende factoren</w> van het kenmerk kleur."
                            }
                        },
                        {
                            "text": "Each shade represents one of the possible <w>determinates</w>.",
                            "target_lang_translations": {
                                "nl": "Elke tint vertegenwoordigt een van de mogelijke <w>bepalende waarden</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Een specifieke toestand van een bepaald kenmerk."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "bepalende factor",
                                "target_lang_sense_clarification": "Een element dat een toestand definieert."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f307ee0c-ac21-3e99-bc9d-caa1e0980317",
                    "sense_definition": "To bring to an end.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "resolved",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The contract will <w>determinate</w> at the end of the fiscal year.",
                            "target_lang_translations": {
                                "nl": "Het contract zal <w>beëindigen</w> aan het einde van het boekjaar."
                            }
                        },
                        {
                            "text": "Legal proceedings often <w>determinate</w> with a final settlement.",
                            "target_lang_translations": {
                                "nl": "Juridische procedures <w>beëindigen</w> vaak met een definitieve schikking."
                            }
                        }
                    ],
                    "synonyms": [
                        "terminate",
                        "end"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in older or formal legal contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Tot een einde brengen (formeel/juridisch)."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "beëindigen",
                                "target_lang_sense_clarification": "Formeel tot een einde brengen."
                            },
                            {
                                "target_lang_word": "aflopen",
                                "target_lang_sense_clarification": "Ten einde komen."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}