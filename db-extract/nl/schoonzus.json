                                                "sense_id": "ddd349fd-4e47-3fab-8551-67a23bc04eb9",
                                                "text": "Though they are not twins, my sister-in-law resembles my wife in almost every way."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "926323db-5065-328d-a551-355e110391f9",
                                        "entry_id": "11ad6798-7bcf-337f-8cc8-2f2a6f185b0d",
                                        "glosses": [
                                            "A female relative of one's generation, separated by one degree of marriage:",
                                            "The wife of one's sibling."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03303c06-cf44-4fab-99ff-17241b6570e9",
                                                "sense_id": "926323db-5065-328d-a551-355e110391f9",
                                                "text": "My sister-in-law and my brother both met while they were on vacation in Jamaica."
                                            }
                                        ]
                                    },
