                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "0f292569-0b61-4af2-96c6-2557be782ae1",
                        "entry_id": "3aa10c32-a3ad-38fc-adee-6ab365059d37",
                        "tags": [
                            "plural"
                        ],
                        "form": "hosannas"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3dd0f211-4cfc-332a-91b3-9b2f4e680e78",
                        "entry_id": "3aa10c32-a3ad-38fc-adee-6ab365059d37",
                        "glosses": [
                            "A cry of ‘hosanna’."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8ab97e9-b8c9-4548-8023-1d8cded68e42",
                                "sense_id": "3dd0f211-4cfc-332a-91b3-9b2f4e680e78",
                                "text": "When we arrived in New York, we found a day of extreme brilliance. It would be impossible ever to forget the first sight of the groups of slender towers that form the skyline of New York City, chanting hosannas to an autumn sky."
                            },
                            {
                                "example_id": "0e47b1f4-55b7-4771-aad3-1305e5a0e86c",
                                "sense_id": "3dd0f211-4cfc-332a-91b3-9b2f4e680e78",
                                "text": "Imagine God in Heaven surrounded by the choirs of adoring angels singing hosannahs unendingly."
                            },
                            {
                                "example_id": "4f1121e6-8f05-41a4-97ae-1adf91052d5f",
                                "sense_id": "3dd0f211-4cfc-332a-91b3-9b2f4e680e78",
                                "text": "The hall rang with the hosannas of the faithful, while the women knelt at his feet to ask for salvation."
                            },
                            {
                                "example_id": "9732499b-e6ed-46a5-beb6-19946979d812",
                                "sense_id": "3dd0f211-4cfc-332a-91b3-9b2f4e680e78",
                                "text": "I’ve written before about the inevitable, tragic dynamic of this brokeback bromance; Trump needs a mindless cheering section screaming hosannas no matter how often he stumbles toward the nuclear and political precipice."
                            }
                        ]
                    }
                ],
