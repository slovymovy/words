                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3730d6ea-cdf9-4231-ab20-ea83abc1d61b",
                                "sense_id": "1d9f138b-93b6-3cdc-9057-38731b2f528f",
                                "text": "S'ensuit qu'elle va se reshampooiner la chevelure parsemée de grumeaux."
                            },
                            {
                                "example_id": "a45f9fd8-b72a-483f-80c3-49995a438d85",
                                "sense_id": "1d9f138b-93b6-3cdc-9057-38731b2f528f",
                                "text": "je remouille l'autre moitié et je reshampooine."
                            },
                            {
                                "example_id": "9a69b764-9513-4781-b8aa-1d4ca7bf9aff",
                                "sense_id": "1d9f138b-93b6-3cdc-9057-38731b2f528f",
                                "text": "Moi je shampooine, je rince, je reshampooine, je re-rince, je mets une serviette autour de la tête et basta."
                            }
                        ]
                    }
