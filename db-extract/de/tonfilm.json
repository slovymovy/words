                        "source_sense_id": "fc763dc7-172c-39ef-8a04-0c8cae9d897d",
                        "source_sense_description": "Film, bei dem außer dem Bild auch Geräusche, Musik und Sprache wiedergegeben werden",
                        "target_lang_word": "geluidsfilm",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "geluidsfilm",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "a521f69f-7053-31b8-87fa-81dbac4b2e0a",
                                        "entry_id": "263921e2-b18b-31ec-ac8b-4c8bc94e06be",
                                        "glosses": [
                                            "film met geluid dat hoort bij de beelden die men ziet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0df5863-275d-4da1-bebf-04f450f43679",
                                                "sense_id": "a521f69f-7053-31b8-87fa-81dbac4b2e0a",
                                                "text": "The Artist gaat over een acteur die carrière maakt in het tijdperk van de zwijgende film. Zijn loopbaan raakt in het slop als de geluidsfilm zijn intrede doet. De film heeft al veel internationale prijzen in de wacht gesleept."
                                            },
                                            {
                                                "example_id": "d625b6a6-409a-438c-aaa3-1c3d8ff27dbb",
                                                "sense_id": "a521f69f-7053-31b8-87fa-81dbac4b2e0a",
                                                "text": "De redenen waarom de films verloren gingen, zijn divers. Zo werden stomme films vaak vernietigd toen de geluidsfilm werd geïntroduceerd, omdat niemand zich kon voorstellen dat het achterhaalde medium ooit nog interessant zou zijn. Nitraatfilms werden na gebruik vaak gesmolten om het zilver eruit te winnen."
                                            }
                                        ]
                                    }
