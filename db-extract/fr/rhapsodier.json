                "senses": [
                    {
                        "sense_id": "9c77c484-a671-32f0-ab6d-3216e1cc72a8",
                        "entry_id": "2d1cd79d-5495-3f37-a080-2c0c3cfae18a",
                        "glosses": [
                            "Exprimer à la manière d’une rhapsodie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a2fef91-46fb-47c1-94ff-b3dd5a387dbe",
                                "sense_id": "9c77c484-a671-32f0-ab6d-3216e1cc72a8",
                                "text": "Celui-ci rapporte que cet Homéride fut le premier à rhapsodier, à réciter les poèmes d’Homère à Syracuse, aux temps de la 69ᵉ Olympiade, c’est-à-dire dans les dernières années du VIᵉ siècle."
                            },
                            {
                                "example_id": "114aabc6-0a19-4326-a1fe-b450066f007a",
                                "sense_id": "9c77c484-a671-32f0-ab6d-3216e1cc72a8",
                                "text": "Sous nos fenêtres le fleuve, soudain inoffensif, rhapsodiait sans trêve sa mélodie de blues sous la lumière d’or troublante du ciel toscan."
                            }
                        ]
                    }
                ],
