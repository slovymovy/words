                "senses": [
                    {
                        "sense_id": "a54919e1-c77b-3447-afdb-10dd65a6f405",
                        "entry_id": "b31287ad-796e-32a8-8119-80c92475c8a5",
                        "glosses": [
                            "Gott des Feuers"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cbe20fee-46d9-4874-afc5-865b73806fa3",
                                "sense_id": "a54919e1-c77b-3447-afdb-10dd65a6f405",
                                "text": "„In Paris, Berlin, Dresden, Wien und Warschau feierten sie den Sieg Napoleons, als zur gleichen Zeit in Moskau der Feuergott sein Fest begann.“"
                            },
                            {
                                "example_id": "1f0128fe-ae0a-4da1-b1de-3ca653ee21ee",
                                "sense_id": "a54919e1-c77b-3447-afdb-10dd65a6f405",
                                "text": "„In ihren mündlich überlieferten heiligen Schriften, den Veden, ist von dem Feuergott Agni die Rede, der ihnen auf dem Weg nach Osten «vorangeflammt» sei.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
