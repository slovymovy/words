                "senses": [
                    {
                        "sense_id": "ea16093a-95db-3884-9a15-5fef9bdc6a13",
                        "entry_id": "c49990a8-fac2-3bcd-a231-06b8e9eef225",
                        "glosses": [
                            "op elkaar aansluitend; volgend op iets"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61e749c9-0e10-4f88-876f-c6637b88436e",
                                "sense_id": "ea16093a-95db-3884-9a15-5fef9bdc6a13",
                                "text": "Ook het richten van de buizen is hier gebeurd. Dat moet tot op de tiende millimeter nauwkeurig, zodat de opvolgende delen precies op elkaar aansluiten straks.”"
                            },
                            {
                                "example_id": "98c977b2-4ab6-4bf9-9b82-0adc2f3e5705",
                                "sense_id": "ea16093a-95db-3884-9a15-5fef9bdc6a13",
                                "text": "Sue Grafton was wereldwijd bekend door haar alfabetreeks rond de vrouwelijke speurder Kinsey Millhone. Alle titels begonnen met een opvolgende letter van het alfabet. Het eerste boek in 1982 had als titel A is for Alibi, haar laatste boek verscheen in augustus en heette Y is for Yesterday."
                            },
                            {
                                "example_id": "6bf32285-0f25-4ed2-b380-65cb615a4d59",
                                "sense_id": "ea16093a-95db-3884-9a15-5fef9bdc6a13",
                                "text": "Een veelgehoord kritiekpunt van moderne smartphones is dat de innovatie er wel een beetje uit is. Toestellen worden elk jaar iets sneller, net wat dunner en wat uitgebreider, maar vergeleken met een paar jaar terug zijn de stappen tussen elkaar opvolgende modellen minder groot geworden."
                            }
                        ]
                    }
                ],
