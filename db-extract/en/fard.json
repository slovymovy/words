                "entry_id": "decd7b15-33d6-3ead-a45e-574e5c2fe727",
                "word": "fard",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "255e1484-c27e-3617-844b-24a252fda1af",
                        "entry_id": "decd7b15-33d6-3ead-a45e-574e5c2fe727",
                        "glosses": [
                            "Required as a matter of religious duty or obligation."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "ff6ff669-cf1d-4ed8-9f3b-1cad0dbe2ea2",
                                "sense_id": "255e1484-c27e-3617-844b-24a252fda1af",
                                "text": "The second fundamental of Islam is \"to perform the ritual prayer (namâz, salât) [five times a day in accordance with its conditions and fards] when the time for prayer comes.\" It is fard for every Muslim to perform salât five times every day after each time of salât starts and to know that he or she performs it in due time."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "062d80ca-2b5f-3233-96c5-46de2b03976b",
                "word": "fard",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "7710aee3-f3bf-4ef4-86c2-68e115aea239",
                        "entry_id": "062d80ca-2b5f-3233-96c5-46de2b03976b",
                        "tags": [
                            "plural"
                        ],
                        "form": "fards"
