                    "frequency": "Middle",
                    "semantic_group_id": "strafrecht",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der Angeklagte leistete den Einbrechern <w>Beihilfe</w>, indem er ihnen die Haustür aufschloss."
