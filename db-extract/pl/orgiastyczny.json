        "pl-extract.jsonl": [
            {
                "entry_id": "34b41941-12e0-36b7-8978-e4a351ac958b",
                "word": "orgiastyczny",
                "pos": "adj",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "86b0a0d4-dfe7-3e1d-a65f-8029ed0893ae",
                        "entry_id": "34b41941-12e0-36b7-8978-e4a351ac958b",
                        "glosses": [
                            "związany z orgią (grupową zabawą seksualną)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f70ed6fb-5604-453d-af4c-e6a79fef667b",
                                "sense_id": "86b0a0d4-dfe7-3e1d-a65f-8029ed0893ae",
                                "text": "Z mojego doświadczenia terapeutycznego wynika jednak, że seks ludyczny, seks orgiastyczny, to nie jest seks docelowy"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "55118600-8a88-3191-9b07-6ad0dea71cce",
                        "entry_id": "34b41941-12e0-36b7-8978-e4a351ac958b",
                        "glosses": [
                            "związany z orgią (głośną, pijacką, narkotykową zabawą)"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "e1234234-574d-4b4f-b1bf-74f91c5bcd89",
                                "sense_id": "55118600-8a88-3191-9b07-6ad0dea71cce",
                                "text": "Będzie to zwykła, uporczywa praca i zabawa - nie jakaś szaleńcza, orgiastyczna, lecz zwyczajna, wpleciona w rytm zajęć…"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "d52db1a8-8f3a-3f08-bdf3-2478595bf65a",
                        "entry_id": "34b41941-12e0-36b7-8978-e4a351ac958b",
                        "glosses": [
                            "związany z orgią (przesadzoną, rozbuchaną różnorodnością)"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "963b709b-10e9-4bb0-ba73-f5d0c9464713",
                                "sense_id": "d52db1a8-8f3a-3f08-bdf3-2478595bf65a",
                                "text": "Lecz nie ma na tych mapach rąbanisk zadyszanych gwarem owadów, malińców, w które lepiej nie wchodzić, tyle tam pierwotnej bujności, żmijowisk kwiatów podobnych do zwierząt, kwietników, gdzie przyroda daje w skrócie orgiastyczny obraz swych praw, okrucieństw i cudów"
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    },
                    {
                        "sense_id": "1c98d1a1-a520-346a-88ae-cc80fc208b6c",
                        "entry_id": "34b41941-12e0-36b7-8978-e4a351ac958b",
                        "glosses": [
                            "związany z orgią (przesadzonym zachowaniem)"
                        ],
                        "tags": [
                            "metaphoric"
                        ],
                        "examples": [
                            {
                                "example_id": "b8f0ee8a-88be-4382-8ca0-46d450fed32f",
                                "sense_id": "1c98d1a1-a520-346a-88ae-cc80fc208b6c",
                                "text": "Piekielny galop zaskoczył paryżan swoją żywiołowością, jak na tamte czasy był wręcz orgiastyczny"
                            }
                        ],
                        "sense_index_json": "\"1.4\""
                    },
                    {
                        "sense_id": "216e9ecf-f21b-38a7-8b85-fce2093cf78e",
                        "entry_id": "34b41941-12e0-36b7-8978-e4a351ac958b",
                        "glosses": [
                            "związany z orgią (ekstatycznymi obrzędami ku czci bogów, w szczególności Dionizosa)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "becd54f9-faa0-42f3-bc3a-12076be522b0",
                                "sense_id": "216e9ecf-f21b-38a7-8b85-fce2093cf78e",
                                "text": "Wprowadził w Rzymie kult orgiastyczny bożka syryjskiego Elagabala, którego był kapłanem"
                            }
                        ],
                        "sense_index_json": "\"1.5\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3e7a8fac-8b14-41ac-96f2-ed6a89ae6fd9",
                        "source_entry_id": "34b41941-12e0-36b7-8978-e4a351ac958b",
                        "source_sense_id": "86b0a0d4-dfe7-3e1d-a65f-8029ed0893ae",
                        "target_lang_word": "orgiastic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "orgiastic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6bdcf455-347b-38e3-a41a-a29a4b1d3d23",
                                        "entry_id": "693b57ed-e871-3625-8dda-65d06e43ccca",
                                        "glosses": [
                                            "Relating to an orgy; uncontrolled, wild."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b160914-1a08-426b-b7de-1c70f36d912d",
                                                "sense_id": "6bdcf455-347b-38e3-a41a-a29a4b1d3d23",
                                                "text": "1919, Sax Rohmer, Dope\nDancing was in progress, or, rather, one of those orgiastic ceremonies which passed for dancing during this pagan period."
                                            },
                                            {
                                                "example_id": "4e0cc8a7-0733-466d-be5f-6ee96316d201",
                                                "sense_id": "6bdcf455-347b-38e3-a41a-a29a4b1d3d23",
                                                "text": "Gatsby believed in the green light, the orgiastic future that year by year recedes before us. It eluded us then, but that's no matter—tomorrow we will run faster, stretch out our arms farther … And one fine morning—"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "02e6dd4b-afd3-4e00-a8d7-1ca036edadc5",
                        "source_entry_id": "34b41941-12e0-36b7-8978-e4a351ac958b",
                        "source_sense_id": "86b0a0d4-dfe7-3e1d-a65f-8029ed0893ae",
                        "target_lang_word": "orgiastický",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "85b4568e-88e0-43db-9c99-bd33d25909d0",
                        "source_entry_id": "34b41941-12e0-36b7-8978-e4a351ac958b",
                        "source_sense_id": "86b0a0d4-dfe7-3e1d-a65f-8029ed0893ae",
                        "target_lang_word": "orgiastique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "orgiastique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "95a2706c-9db0-3950-b723-effdc87f3edc",
                                        "entry_id": "4215b021-7dfb-3c99-abee-d690f6f8aa19",
                                        "glosses": [
                                            "Relatif aux orgies."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d0c7c933-d1bd-44a7-800c-aff66c0481e0",
                                                "sense_id": "95a2706c-9db0-3950-b723-effdc87f3edc",
                                                "text": "La civilisation du continent blanc a pu croître en sublimant en des formes de moins en moins nocives cette nécessité orgiastique de l’homme et des foules."
                                            },
                                            {
                                                "example_id": "7a468c12-d99f-430a-b6d5-2d77ddd33632",
                                                "sense_id": "95a2706c-9db0-3950-b723-effdc87f3edc",
                                                "text": "La répudiation de toute pratique orgiastique et sanglante semblait donc se combiner avec celle du panthéon ancien comportant des sacrifices animaux, dont les textes ne font pas mystère ; l'action de Zarathuštra se présentait ainsi comme une revendication des éléments de paix et de conversion agraire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c017a141-a644-4974-9b85-134c310d5ccb",
                        "source_entry_id": "34b41941-12e0-36b7-8978-e4a351ac958b",
                        "source_sense_id": "86b0a0d4-dfe7-3e1d-a65f-8029ed0893ae",
                        "target_lang_word": "orgiaque",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "orgiaque",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "080b51dd-1d05-3d34-a124-a0e9996dd476",
                                        "entry_id": "d5ebc93e-96bb-3cf3-91a9-73d76194a24c",
                                        "glosses": [
                                            "Qui a rapport aux orgies ou fêtes de Bacchus."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad0bb663-49fd-4eb0-8fd7-52612667b154",
                                                "sense_id": "080b51dd-1d05-3d34-a124-a0e9996dd476",
                                                "text": "Elle lisait jusqu’au matin des livres extravagants où il y avait des tableaux orgiaques avec des situations sanglantes."
                                            },
                                            {
                                                "example_id": "ae701d76-3ccb-46ff-a465-91ccfbc092fc",
                                                "sense_id": "080b51dd-1d05-3d34-a124-a0e9996dd476",
                                                "text": "À Mendès, Memphis, Élephantis, les Égyptiens rendaient au Phallus un culte orgiaque et, sur le monument, parmi les sculptures, il figurait avec son complémentaire féminin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c3dfa73d-647e-332b-ac77-ea4dbf1ecbe7",
                                        "entry_id": "d5ebc93e-96bb-3cf3-91a9-73d76194a24c",
                                        "glosses": [
                                            "Somptueux, déraisonnable et sans contrôle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2684b48f-59e0-4981-a746-08ef4ffd8d06",
                                                "sense_id": "c3dfa73d-647e-332b-ac77-ea4dbf1ecbe7",
                                                "text": "Tout cela rappelait les notes de frais orgiaques de la FTQ-Construction, avant (et devant) la Commission Charbonneau, au temps de Jocelyn Dupuis (reconnu coupable, en 2014, de fraude et de fabrication de faux)."
                                            }
                                        ]
                                    }
                                ]
                            },
