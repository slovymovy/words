                            {
                                "example_id": "29f32c97-58f9-4908-94ab-ee26aab68019",
                                "sense_id": "f764c8d7-fcb5-3c8b-9b67-8345768f2f98",
                                "text": "Libre à eux de brutaliser, insolencer, blâmer ou vilipender les conducteurs."
                            },
                            {
                                "example_id": "9bd7fad3-34f8-445e-a98f-3326d4f14e22",
                                "sense_id": "f764c8d7-fcb5-3c8b-9b67-8345768f2f98",
                                "text": "Évitez aussi de les insolencer (manquer de respect, insulter) ou de les influencer (fixer dans le but d’impressionner)."
                            },
                            {
                                "example_id": "a1142acd-6196-44bc-94ad-cde59a07ff6a",
                                "sense_id": "f764c8d7-fcb5-3c8b-9b67-8345768f2f98",
                                "text": "Presse de merde capable d’imager les mages et mettre au ban les bannis, de se laver les mains tout en cirant les bottes, d’insolencer le peuple à grands coups de braguette."
                            }
                        ]
