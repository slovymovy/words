                                        "glosses": [
                                            "A person at a newspaper, publisher or similar institution who edits stories and/or decides which ones to publish."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07a4a7ff-86e9-4f68-a277-e9669c07c031",
                                                "sense_id": "9ed172b4-eb18-337a-ad6b-00e38c8f72be",
                                                "text": "John is the city editor at the Daily Times."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a2fc9a7-d526-382b-8a65-4e129d23bbea",
