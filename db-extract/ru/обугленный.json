                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94444e45-2698-47df-a0b9-454e812b0270",
                                                "sense_id": "0868ac0d-5c42-3e17-9201-5d363607705d",
                                                "text": "Wenn man Holz verkohlen will, muss die Rinde vom Stamm entfernt werden."
                                            }
