    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d51a1e77-a1df-38e4-a035-255ff1fd168b",
                    "sense_definition": "bereid gehoor te geven aan regels of bevelen",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "gehoorzaamheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De hond is heel <w>gehoorzaam</w> en luistert altijd naar zijn baas.",
                            "target_lang_translations": {
                                "en": "The dog is very <w>obedient</w> and always listens to his owner.",
                                "de": "Der Hund ist sehr <w>gehorsam</w> und hört immer auf seinen Besitzer."
                            }
                        },
                        {
                            "text": "Dit kind is niet altijd <w>gehoorzaam</w> als het naar bed gestuurd wordt.",
                            "target_lang_translations": {
                                "en": "This child is not always <w>obedient</w> when being sent to bed.",
                                "de": "Dieses Kind ist nicht immer <w>gehorsam</w>, wenn es ins Bett geschickt wird."
                            }
                        }
                    ],
                    "synonyms": [
                        "braaf",
                        "gedwee",
                        "volgzaam"
                    ],
                    "antonyms": [
                        "ongehoorzaam"
                    ],
                    "common_phrases": [
                        "gehoorzaam zijn",
                        "een gehoorzaam kind"
                    ],
                    "target_lang_definitions": {
                        "en": "willing to follow rules or orders",
                        "de": "bereit, Regeln oder Befehle zu befolgen"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "obedient",
                                "target_lang_sense_clarification": "willing to comply with authority"
                            },
                            {
                                "target_lang_word": "dutiful",
                                "target_lang_sense_clarification": "motivated by a sense of duty"
                            },
                            {
                                "target_lang_word": "compliant",
                                "target_lang_sense_clarification": "yielding to others' requests"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "gehorsam",
                                "target_lang_sense_clarification": "bereit, Anweisungen von Vorgesetzten oder Eltern zu befolgen"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6a193c5d-7bfd-3a80-8946-fde0e8b2551a",
                    "sense_definition": "eerste persoon enkelvoud tegenwoordige tijd van <w>gehoorzamen</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "verbuiging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>gehoorzaam</w> mijn ouders omdat ik respect voor hen heb.",
                            "target_lang_translations": {
                                "en": "I <w>obey</w> my parents because I have respect for them.",
                                "de": "Ich <w>gehorche</w> meinen Eltern, weil ich Respekt vor ihnen habe."
                            }
                        },
                        {
                            "text": "Als soldaat <w>gehoorzaam</w> ik de bevelen van mijn kapitein zonder twijfel.",
                            "target_lang_translations": {
                                "en": "As a soldier, I <w>obey</w> my captain's orders without question.",
                                "de": "Als Soldat <w>gehorche</w> ich den Befehlen meines Kapitäns ohne Zweifel."
                            }
                        }
