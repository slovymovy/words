    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "1e84488c-c121-34ed-9a3d-32264aa4ae71",
                    "sense_definition": "Qui parle beaucoup, avec une grande aisance et rapidité.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "discours",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après quelques verres lors de la soirée, il devenait particulièrement <w>volubile</w> avec ses collègues."
                        },
                        {
                            "text": "Elle était tellement <w>volubile</w> que personne n'arrivait à placer un mot pendant la réunion."
                        }
                    ],
                    "synonyms": [
                        "bavard",
                        "loquace"
                    ],
                    "common_phrases": [
                        "homme volubile",
                        "femme volubile"
                    ]
                },
                {
                    "sense_id": "556dcdd2-1b7a-3a77-86f7-43c395991c90",
                    "sense_definition": "Se dit d'une tige ou d'une plante grimpante qui s'enroule en hélice autour d'un support.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "botanique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le liseron des champs est une plante <w>volubile</w> qui grimpe facilement le long des clôtures."
                        },
                        {
                            "text": "Ces lianes <w>volubiles</w> s'enroulent autour des troncs d'arbres pour atteindre la lumière du soleil."
                        }
                    ],
                    "common_phrases": [
                        "plante volubile",
                        "tige volubile"
                    ]
                },
                {
                    "sense_id": "ca4d1456-399c-33b8-80fe-9bf3325eb075",
                    "sense_definition": "Qui est inconstant, changeant ou variable.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "inconstance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Son humeur <w>volubile</w> déconcertait souvent ses amis qui ne savaient jamais à quoi s'attendre."
                        },
                        {
                            "text": "L'auteur déplorait le caractère <w>volubile</w> et versatile des faveurs de la cour royale."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "sens vieilli"
                        }
                    ]
                },
                {
                    "sense_id": "3238fc97-9bfe-3989-b364-8677400bfca3",
                    "sense_definition": "Qui s'écoule ou se déplace avec une grande rapidité et fluidité.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mouvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le marcheur écoutait le murmure <w>volubile</w> de la rivière qui dévalait la pente rocheuse."
                        },
                        {
                            "text": "Un vent <w>volubile</w> agitait les feuilles mortes le long du sentier forestier."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "emploi littéraire rare"
                        }
                    ]
                }
            ]
        }
