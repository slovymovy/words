                            },
                            {
                                "target_lang_word": "dołować",
                                "target_lang_sense_clarification": "potoczne określenie wprawiania w zły nastrój"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "deprimieren",
                                "target_lang_sense_clarification": "jemanden in eine niedergeschlagene Stimmung versetzen"
                            },
                            {
                                "target_lang_word": "niederdrücken",
                                "target_lang_sense_clarification": "jemanden emotional belasten oder bedrücken"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "déprimer",
                                "target_lang_sense_clarification": "Causer un sentiment de tristesse ou de mélancolie."
                            },
                            {
                                "target_lang_word": "attrister",
                                "target_lang_sense_clarification": "Rendre triste."
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "deprimere",
                                "target_lang_sense_clarification": "causare tristezza o abbattimento"
                            },
                            {
                                "target_lang_word": "rattristare",
                                "target_lang_sense_clarification": "rendere triste"
                            }
                        ],
