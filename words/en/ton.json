                            }
                        },
                        {
                            "text": "The old motorcycle struggled to reach the <w>ton</w>.",
                            "target_lang_translations": {
                                "ru": "Старый мотоцикл с трудом разгонялся до <w>ста миль в час</w>.",
                                "zh": "那辆旧摩托车费了好大劲才达到<w>时速一百英里</w>。"
                            }
                        }
