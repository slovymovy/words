                ],
                "senses": [
                    {
                        "sense_id": "c65b7e7a-eb25-38a6-84e7-ea88721f7a03",
                        "entry_id": "e9acfef3-9aa7-3da0-89c0-a7fe32588bb9",
                        "glosses": [
                            "Cambrioler."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "f805bfdf-7ecb-464d-bdcc-52433984f7a4",
                                "sense_id": "c65b7e7a-eb25-38a6-84e7-ea88721f7a03",
                                "text": "Il m’avait pourtant balluchonné, ce mec, je pouvais d’autant moins m’y tromper que la bouteille de framboise qu’il gardait à son chevet en guise de cordial, elle venait tout droit de chez nosziques, Pierrot et moi."
                            }
                        ]
                    },
                    {
                        "sense_id": "f25262ab-7266-3dde-8544-bd895d130f6a",
                        "entry_id": "e9acfef3-9aa7-3da0-89c0-a7fe32588bb9",
                        "glosses": [
                            "Mettre en réserve un objet pour le protéger, en le rendant inutilisable temporairement, jusqu’à ce qu’il soit déballuchonné."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5fb54916-6dff-415a-8710-d0fa0b3d5d6c",
                                "sense_id": "f25262ab-7266-3dde-8544-bd895d130f6a",
                                "text": "Il est possible de lancer une potion sans la déballuchonner, mais on ne peut utiliser une potion balluchonnée."
                            }
                        ]
                    }
                ],
