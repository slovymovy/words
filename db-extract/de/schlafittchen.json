                                "sense_id": "73009f84-076a-31f9-8841-4d1d2e3b0bae",
                                "text": "Er packte den Betrunkenen am Schlafittchen und warf ihn raus.",
                                "translation": "He grabbed the drunk man by his collar / by the scruff of his neck and threw him out.",
                                "english": "He grabbed the drunk man by his collar / by the scruff of his neck and threw him out."
                            }
