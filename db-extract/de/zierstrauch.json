                "senses": [
                    {
                        "sense_id": "d73e4bdd-7c61-318a-b2a0-6a9dd3243308",
                        "entry_id": "ffa6d0b8-2d07-3461-a8d2-a607547d0ae5",
                        "glosses": [
                            "Strauch, der der Verschönerung dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23d48b05-cda7-4019-997e-bb8c9d8c8540",
                                "sense_id": "d73e4bdd-7c61-318a-b2a0-6a9dd3243308",
                                "text": "„Es gibt auch Ziersträucher, die so gezüchtet sind, daß sie keine Früchte mehr bilden.“"
                            },
                            {
                                "example_id": "a1abaa71-4edb-4003-9b3b-c27f11279f7a",
                                "sense_id": "d73e4bdd-7c61-318a-b2a0-6a9dd3243308",
                                "text": "„Ahorn und Platanen wechselten ab, und dazwischen drängten sich allerlei Ziersträucher zusammen, aus denen hervor es buntfarbig blühte: Tulpenbaum und Goldregen und Schneeball und Akazie.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
