        "ru-extract.jsonl": [
            {
                "entry_id": "64d0dbe6-8792-3e99-903a-ac69d08e4bec",
                "word": "дождить",
                "pos": "verb",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "94f30f97-1319-346b-938d-b78f5eb1b0b8",
                        "entry_id": "64d0dbe6-8792-3e99-903a-ac69d08e4bec",
                        "glosses": [
                            "разг. о дожде (начинающемся и прекращающемся или затяжном): идти"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1cd3620-49ad-49ef-b6c7-f2d2aa72b258",
                                "sense_id": "94f30f97-1319-346b-938d-b78f5eb1b0b8",
                                "text": "Над городом, над сизо-бурыми, заволочёнными изморосью лесами неслись с запада низкие, свисающие лохмотьями облака, по десять раз на день начинало дождить, и озеро поднималось над городом свинцовой стеной."
                            },
                            {
                                "example_id": "409f64c4-d137-4d12-bb6f-c7aed4c61fb6",
                                "sense_id": "94f30f97-1319-346b-938d-b78f5eb1b0b8",
                                "text": "Ц. Накамура: смотри-ка, дождь всё не кончается. Ф. Муромацу: да, дождит, неважная погода."
                            },
                            {
                                "example_id": "38d26b22-bb0d-49ea-a9b1-25313f4fbdd9",
                                "sense_id": "94f30f97-1319-346b-938d-b78f5eb1b0b8",
                                "text": "Сокрушается, что в прошлое лунное затмение дождило."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": [
                    {
