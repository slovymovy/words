                "senses": [
                    {
                        "sense_id": "db5e8afb-5bbd-32e1-934c-1ac47945d5aa",
                        "entry_id": "73079c9d-d845-360c-9fd0-ac2ef8fa7015",
                        "glosses": [
                            "Die Herausbildung eines vorderen Pols als Sinnespol (Anhäufung von verschiedenen Sinnesorganen) und Nervenzentrum (Verlagerung des Großteils der Nervenzentren in diesen vorderen Pol) im Laufe der Evolution verschiedener tierischer Taxa. Dieser Sinnes- und Nervenpol wird Kopf genannt."
                        ],
                        "tags": [
                            "Evolutionsbiologie"
                        ],
                        "examples": [
                            {
                                "example_id": "d8fa833e-2326-450f-a603-0d0f9c30530d",
                                "sense_id": "db5e8afb-5bbd-32e1-934c-1ac47945d5aa",
                                "text": "„Bei sehr primitiven Tieren, wie zum Beispiel den Hohltieren, deren Nervensystem nur einfache Nervennetze repräsentieren, liegt keine Cephalisation vor. Doch bereits bei Strudelwürmern (z.B. dem Regenwurm) ist Cephalisation zu beobachten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
