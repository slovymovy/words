                    },
                    {
                        "translation_id": "a38078e6-77e9-44a3-8b4e-cff0d72b1d59",
                        "source_entry_id": "5400d023-3874-3564-9b91-f3b4b0b01a60",
                        "source_sense_id": "31f5400d-eedc-3006-bcbe-4228c58038a0",
                        "source_sense_description": "Mathematik: Brett mit verschiebbaren Steinen, das zum Rechnen verwendet wird",
                        "target_lang_word": "abaque",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abaque",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "142eaa35-4651-3e8d-be10-aafe5378c395",
                                        "entry_id": "91ce34fe-21d7-3801-b5a3-e0e472a692ae",
                                        "glosses": [
                                            "Compteur à boules chinois pour le calcul."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8affe80c-c9a7-4a5d-afc7-b04a9fc75726",
                                                "sense_id": "142eaa35-4651-3e8d-be10-aafe5378c395",
                                                "text": "Les nombres écrits sur le papier reproduisent alors les colonnes de l’abaque."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "20705f91-0582-38e3-a51f-30038d93a19c",
                                        "entry_id": "91ce34fe-21d7-3801-b5a3-e0e472a692ae",
                                        "glosses": [
                                            "Tailloir, partie supérieure d'un chapiteau de colonne sur laquelle porte l’architrave."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9e939b96-3efa-3c73-b1c4-7216dba5e5b2",
                                        "entry_id": "91ce34fe-21d7-3801-b5a3-e0e472a692ae",
                                        "glosses": [
                                            "Tableau couvert de sable fin, sur lequel on traçait des nombres pour enseigner le calcul ou la géométrie."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "31ce085d-b219-3762-ae74-57a4b75a9522",
                                        "entry_id": "91ce34fe-21d7-3801-b5a3-e0e472a692ae",
                                        "glosses": [
                                            "Diagramme ou graphique qui donne, par simple lecture, la solution approchée d’un problème numérique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9466c79b-04e8-46ed-94f3-99e4c284e5bd",
                                                "sense_id": "31ce085d-b219-3762-ae74-57a4b75a9522",
                                                "text": "Par extension on nomma aussi abaques diverses tables de calcul, dont la plus célèbre est celle de Pythagore."
                                            },
                                            {
                                                "example_id": "b0f8c2dc-9356-4b21-a25f-7a8f095cba2d",
                                                "sense_id": "31ce085d-b219-3762-ae74-57a4b75a9522",
                                                "text": "L’abaque figuré ici comprend toutes les valeurs utiles pour n et D ; mais on a limité le graphique aux cotes comprises entre 100 et 200 millimètres pour T et F, valeurs d’ailleurs très usuelles ; […]."
                                            },
                                            {
                                                "example_id": "2128a4aa-291c-41a9-aea4-9c59ec37d7a6",
                                                "sense_id": "31ce085d-b219-3762-ae74-57a4b75a9522",
                                                "text": "On peut déterminer la température résultante en degrés Missenard (°M) à l'aide de l’abaque, figure 6.02.a (Tome I)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "377f5ca7-c4c9-3fd6-b490-39e4117decef",
                                        "entry_id": "91ce34fe-21d7-3801-b5a3-e0e472a692ae",
                                        "glosses": [
                                            "En logique, tableau servant à tirer les conséquences logiques de prémisses données."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "08dee2a7-7154-3b79-a116-7714212ce3fb",
                                        "entry_id": "91ce34fe-21d7-3801-b5a3-e0e472a692ae",
                                        "glosses": [
                                            "Table de jeu divisée en compartiments et se rapprochant de nos damiers, de nos échiquiers."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
