                    },
                    {
                        "form_id": "534e1ea2-a17d-4d8b-ab33-6febb90b8155",
                        "entry_id": "bd11f41e-6c10-3c58-ae5e-6942da264c87",
                        "tags": [
                            "dative",
                            "singular"
                        ],
                        "form": "der Freiwilligkeit"
                    },
                    {
                        "form_id": "31226403-efbc-4648-93f6-97a2a883b7e8",
                        "entry_id": "bd11f41e-6c10-3c58-ae5e-6942da264c87",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Freiwilligkeit"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "30cc6e40-ec58-3577-9809-44d5ac4c118c",
                        "entry_id": "bd11f41e-6c10-3c58-ae5e-6942da264c87",
                        "glosses": [
                            "Eigenschaft einer Person, etwas aus eigenem Antrieb oder aus freiem Willen zu tun, ohne Zwang oder Druck"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf731c12-2209-44fd-b705-dfb96f2439cf",
                                "sense_id": "30cc6e40-ec58-3577-9809-44d5ac4c118c",
                                "text": "[…] „»ich bin für positive Anreize und Freiwilligkeit.«“"
                            },
                            {
                                "example_id": "d7fddf7f-faa3-46b3-8679-46aec163de8b",
                                "sense_id": "30cc6e40-ec58-3577-9809-44d5ac4c118c",
                                "text": "„»Mit Freiwilligkeit allein wird es nach meiner Auffassung nicht funktionieren«, sagte Wüstner.“"
                            },
                            {
                                "example_id": "1ded557a-86e3-4e83-9284-3383149f1a87",
                                "sense_id": "30cc6e40-ec58-3577-9809-44d5ac4c118c",
                                "text": "„Ohne Freiwilligkeit ginge kaum etwas. Ob im Ehrenamt in einem Verein, ob Nachbarschaftshilfe oder Spende: In der Schweiz hilft man sich gegenseitig rege.“"
                            },
                            {
                                "example_id": "132325fc-4579-4dbe-a93b-fd2253c1d2b3",
                                "sense_id": "30cc6e40-ec58-3577-9809-44d5ac4c118c",
                                "text": "„Das Spenden bleibt somit auch in der aktuellen Befragung die am weitesten verbreitete Form von Freiwilligkeit in der Schweiz.“"
                            },
                            {
                                "example_id": "213b3b3f-60cf-415a-98ef-07188d054e24",
                                "sense_id": "30cc6e40-ec58-3577-9809-44d5ac4c118c",
                                "text": "„»Das Prinzip Freiwilligkeit ist gescheitert: Der Nutri-Score muss endlich verpflichtend europaweit eingeführt werden«, forderte Foodwatch-Expertin Luise Molling.“"
                            },
                            {
                                "example_id": "c7b6a1c8-5f99-4c6c-beed-6e623bb18488",
                                "sense_id": "30cc6e40-ec58-3577-9809-44d5ac4c118c",
                                "text": "[Freiwillige Feuerwehr:] „Ist das System der Freiwilligkeit überhaupt noch aufrechtzuerhalten oder müssen andere Lösungen her? An der Basis wird das Thema Dienstpflicht schon länger diskutiert.“"
                            },
                            {
                                "example_id": "881a8638-2f3e-49dc-805e-4d22976ed0bf",
                                "sense_id": "30cc6e40-ec58-3577-9809-44d5ac4c118c",
                                "text": "[Schlichtungsverfahren:] „Allerdings ist kein Unternehmen verpflichtet, an einer Schlichtung teilzunehmen - sie beruht auf Freiwilligkeit.“"
                            },
                            {
                                "example_id": "c8186270-09bd-4ac8-a004-1fdd8a8e54df",
                                "sense_id": "30cc6e40-ec58-3577-9809-44d5ac4c118c",
                                "text": "[Monica Lewinsky:] „Ermutigt durch die MeToo-Bewegung, stellte sie Anfang 2018 in einem Interview die Freiwilligkeit ihrer sexuellen Beziehung mit Clinton infrage:“ […]."
                            },
                            {
                                "example_id": "cca1fa15-4faa-4056-9165-9c1cac9483fe",
                                "sense_id": "30cc6e40-ec58-3577-9809-44d5ac4c118c",
                                "text": "[Deutschland:] „In vielen Ländern Europas und der Welt wird die Fahrtauglichkeit von älteren Menschen geprüft. Hierzulande setzt man auf Freiwilligkeit. Ein Sicherheitsrisiko?“"
                            },
                            {
                                "example_id": "807aa12f-d7fe-4dac-b96c-b89efe41d8cd",
                                "sense_id": "30cc6e40-ec58-3577-9809-44d5ac4c118c",
                                "text": "[Coranapandemie, 2022:] „»Die Beendigung der Anordnung der Isolation nach Coronainfektion durch die Gesundheitsämter zugunsten von Freiwilligkeit wäre falsch und wird nicht kommen«, schrieb Bundesgesundheitsminister Karl Lauterbach am frühen Mittwochmorgen auf Twitter.“"
                            },
                            {
                                "example_id": "aaef296a-e7b3-48b8-a087-d6ea01339900",
                                "sense_id": "30cc6e40-ec58-3577-9809-44d5ac4c118c",
                                "text": "[Coranapandemie, Ende der Maskenpflicht 2022:] „Wegen weiter hohen Corona-Zahlen gibt es unter Beschäftigten in Supermärkten die Sorge vor Ansteckung. [Die] Handelsketten setzen auf Freiwilligkeit.“"
                            },
                            {
                                "example_id": "4e81e040-e54b-4580-b231-397408babebc",
                                "sense_id": "30cc6e40-ec58-3577-9809-44d5ac4c118c",
                                "text": "[Wehrdienst:] „Die Freiwilligkeit ist weitgehend verschwunden, Müdigkeit und Erschöpfung machen sich breit: Die ukrainische Armee sucht Soldaten,“ […]."
                            },
                            {
                                "example_id": "44f97df3-fb73-46eb-814c-0e07f1dd1671",
                                "sense_id": "30cc6e40-ec58-3577-9809-44d5ac4c118c",
                                "text": "[Wehrdienst:] „Reicht Freiwilligkeit aus, um die Personalnot bei der Bundeswehr zu lindern?“"
                            },
                            {
                                "example_id": "c5630311-5c3d-41d2-a784-1179b621566c",
                                "sense_id": "30cc6e40-ec58-3577-9809-44d5ac4c118c",
                                "text": "„Deutlich wird: Mangel ist überall, auch beim Personal: Jeder sechste Dienstposten in der Bundeswehr ist laut Verteidigungsministerium aktuell nicht besetzt. Für Eva Högl, die Wehrbeauftragte des Bundes, geht es daher auch um die Frage, »wie viel Zwang, wie viel Freiwilligkeit nötig ist«.“"
                            },
                            {
                                "example_id": "a17756ed-0041-4d0b-ae95-1c909876201b",
                                "sense_id": "30cc6e40-ec58-3577-9809-44d5ac4c118c",
                                "text": "[Elektroautos als Dienstwagen:] „So gibt beispielsweise der Autobauer BMW auf DW-Anfrage an »Wir sehen im Moment keine Notwendigkeit, in die Wahlfreiheit unserer Führungskräfte einzugreifen«. Das Ergebnis dieser Freiwilligkeit bei der Wahl: Weniger als ein Drittel der Dienstwagen sind voll elektrisch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
