                                "target_senses": [
                                    {
                                        "sense_id": "0fdc0cdc-e89d-32be-86f0-d17c47d6bb4b",
                                        "entry_id": "daa568bd-4ec1-370f-b615-d6b4c46b1dd3",
                                        "glosses": [
                                            "Synonym of desire line."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf7c1f71-988a-4741-936a-25beb0a7ba7c",
                                                "sense_id": "0fdc0cdc-e89d-32be-86f0-d17c47d6bb4b",
                                                "text": "In a fit of misplaced municipal energy, the local council is paving the desire path that countless walkers have beaten diagonally across my local park."
                                            },
                                            {
                                                "example_id": "4e5c9677-f2a8-4dcd-8ce5-0e3612b7fa03",
                                                "sense_id": "0fdc0cdc-e89d-32be-86f0-d17c47d6bb4b",
                                                "text": "After finishing it I took the shortcut path through the wasteland to the supermarket – what they call a desire path – and looked at it afresh, thought about it and felt it differently."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
