                                    },
                                    {
                                        "sense_id": "cd0a22e7-ac3c-343a-9ac0-dc0f75b1296d",
                                        "entry_id": "8ea8b66e-5b4d-356b-8ea0-aabade1d4043",
                                        "glosses": [
                                            "die vom Arbeitgeber dem abhängig Beschäftigten oder Dienstherrn dem Unterstellten gewährte Freizeit in Höhe von einem oder meist mehreren Werktagen",
                                            "im militärischen Bereich"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1b\""
                                    },
                                    {
                                        "sense_id": "8003db44-596c-3b95-95bb-842a79a26845",
                                        "entry_id": "8ea8b66e-5b4d-356b-8ea0-aabade1d4043",
                                        "glosses": [
                                            "eine während des Urlaubs^([1]) unternommene Reise"
                                        ],
                                        "tags": [
                                            "short-form"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7dc70737-5cb0-4781-8bc3-e76c967c35c4",
                                                "sense_id": "8003db44-596c-3b95-95bb-842a79a26845",
                                                "text": "Nächste Woche fahren wir in Urlaub."
                                            },
                                            {
                                                "example_id": "54a13b82-6d54-476d-82dd-a10488e1ab3c",
                                                "sense_id": "8003db44-596c-3b95-95bb-842a79a26845",
                                                "text": "„Die Sommerferien nahen, die Temperaturen steigen, aber viele Menschen in Deutschland können sich nicht einmal eine Woche Urlaub leisten."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
