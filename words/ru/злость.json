                {
                    "sense_id": "e8c83644-d34a-31c0-84bb-15aa965beb16",
                    "sense_definition": "Чувство сильного раздражения, гнева, враждебности по отношению к кому-либо или чему-либо.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "гнев",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он почувствовал сильную <w>злость</w>, когда узнал, что его обманули.",
                            "target_lang_translations": {
                                "en": "He felt strong <w>anger</w> when he found out he had been deceived."
                            }
                        },
                        {
                            "text": "Она едва сдерживала <w>злость</w> и старалась говорить спокойным голосом.",
                            "target_lang_translations": {
                                "en": "She could barely control her <w>rage</w> and tried to speak in a calm voice."
                            }
                        }
                    ],
                    "synonyms": [
                        "злоба",
                        "гнев",
                        "озлобление",
                        "ярость"
                    ],
                    "antonyms": [
                        "добродушие",
                        "благодушие",
                        "радость"
                    ],
                    "common_phrases": [
                        "бессильная злость",
                        "сдерживать злость",
                        "покраснеть от злости"
                    ],
                    "target_lang_definitions": {
                        "en": "A feeling of strong irritation, anger, or hostility towards someone or something."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "anger",
                                "target_lang_sense_clarification": "a strong feeling of displeasure or hostility"
                            },
                            {
                                "target_lang_word": "rage",
                                "target_lang_sense_clarification": "violent, intense, or uncontrolled anger"
                            },
                            {
                                "target_lang_word": "spite",
                                "target_lang_sense_clarification": "malice or ill will with an urge to irritate or hurt"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "75c954ba-caa6-3ad1-9c0a-a1d42ab131d9",
                    "sense_definition": "Переносное значение: сильный азарт, упорство, страстное желание добиться цели в каком-либо деле.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "азарт",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Спортсменам помогла победить настоящая спортивная <w>злость</w>.",
                            "target_lang_translations": {
                                "en": "A true competitive <w>drive</w> helped the athletes win."
                            }
                        },
                        {
                            "text": "В работе нужна хорошая творческая <w>злость</w>, чтобы довести проект до конца.",
                            "target_lang_translations": {
