        "pl-extract.jsonl": [
            {
                "entry_id": "66624699-8ddb-334a-8822-a506b05dc7b1",
                "word": "stanowczo",
                "pos": "adv",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c1594258-ee43-3ba7-86d3-d439d6164004",
                        "entry_id": "66624699-8ddb-334a-8822-a506b05dc7b1",
                        "glosses": [
                            "w sposób stanowczy, zdecydowanie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "266deb49-297c-4130-b0b8-326e6e1aa2a3",
                                "sense_id": "c1594258-ee43-3ba7-86d3-d439d6164004",
                                "text": "Gdy ordynator zobaczył, że zamierza ją zabrać do Krakowa maluchem, zaprotestował stanowczo"
                            },
                            {
                                "example_id": "e846bb04-c4e6-40b7-92e7-d998c99336dd",
                                "sense_id": "c1594258-ee43-3ba7-86d3-d439d6164004",
                                "text": "Zostanie ukarana! - powiedział głośno i stanowczo mężczyzna w mundurze, w wysokiej niebieskiej czapie"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "69535eaf-8875-44d5-ad61-654032413bc7",
                        "source_entry_id": "66624699-8ddb-334a-8822-a506b05dc7b1",
                        "source_sense_id": "c1594258-ee43-3ba7-86d3-d439d6164004",
                        "target_lang_word": "firmly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "firmly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "01838417-3af3-3d3e-ad25-c74b00daaee7",
                                        "entry_id": "3d498b6a-e625-3f28-9a67-b90a04e8ae52",
                                        "glosses": [
                                            "In a firm or definite or strong manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28e91e9d-304a-4fbf-88fe-0acefd77e1cf",
                                                "sense_id": "01838417-3af3-3d3e-ad25-c74b00daaee7",
                                                "text": "She corrected him firmly but gently."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba197f15-40e4-3490-a11b-908b5f1309d8",
                                        "entry_id": "3d498b6a-e625-3f28-9a67-b90a04e8ae52",
                                        "glosses": [
                                            "Securely."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46849664-bfc4-4be4-af8f-602b744cba26",
                                                "sense_id": "ba197f15-40e4-3490-a11b-908b5f1309d8",
                                                "text": "Tie the rope firmly to the post."
                                            },
                                            {
                                                "example_id": "b40f2ecb-4ba9-4b6d-9282-c0a0ae1b9d40",
                                                "sense_id": "ba197f15-40e4-3490-a11b-908b5f1309d8",
                                                "text": "When Timothy and Julia hurried up the staircase to the bedroom floor, where a considerable commotion was taking place, Tim took Barry Leach with him. He had him gripped firmly by the arm, since he felt it was not safe to let him loose, and he had no immediate idea what to do with him."
                                            },
                                            {
                                                "example_id": "9b1f9270-ea84-438c-987f-e614989333a1",
                                                "sense_id": "ba197f15-40e4-3490-a11b-908b5f1309d8",
                                                "text": "Dotcom mania was slow in coming to higher education, but now it has the venerable industry firmly in its grip. Since the launch early last year of Udacity and Coursera, two Silicon Valley start-ups offering free education through MOOCs, massive open online courses, the ivory towers of academia have been shaken to their foundations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f22b492f-6798-37ad-bb54-df9f0890975f",
                                        "entry_id": "3d498b6a-e625-3f28-9a67-b90a04e8ae52",
                                        "glosses": [
                                            "Definitively."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "929ac0a1-6140-4b1c-b26b-a42debd1d9c4",
                                                "sense_id": "f22b492f-6798-37ad-bb54-df9f0890975f",
                                                "text": "This was widely interpreted to mean that slavery was once more firmly illegal in England."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b94ac42a-8cd4-4251-98be-435bb4325adc",
                        "source_entry_id": "66624699-8ddb-334a-8822-a506b05dc7b1",
                        "source_sense_id": "c1594258-ee43-3ba7-86d3-d439d6164004",
                        "target_lang_word": "decidedly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "decidedly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7ea7063f-7ec3-3613-8905-7dee59019a7f",
                                        "entry_id": "4a287309-6347-35e7-9558-8f444f464e92",
                                        "glosses": [
                                            "In a manner which leaves little question; definitely, clearly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7aa9b56a-8824-45e4-8937-379d57c57ddb",
                                                "sense_id": "7ea7063f-7ec3-3613-8905-7dee59019a7f",
                                                "text": "In a decidedly petulant manner she sat with crossed arms and a frown."
                                            },
                                            {
                                                "example_id": "e806cb21-fff5-4345-8290-e64c0e669af1",
                                                "sense_id": "7ea7063f-7ec3-3613-8905-7dee59019a7f",
                                                "text": "\"We progress,\" said he. \"Decidedly we progress.\""
                                            },
                                            {
                                                "example_id": "a4eab9f1-ac74-4cdd-aeed-87fc153e68e1",
                                                "sense_id": "7ea7063f-7ec3-3613-8905-7dee59019a7f",
                                                "text": "'I understand it was the big American man with a decidedly unpleasant face.'"
                                            },
                                            {
                                                "example_id": "c700bb16-0106-432d-9774-cfcf83fa51a1",
                                                "sense_id": "7ea7063f-7ec3-3613-8905-7dee59019a7f",
                                                "text": "The long-closed G.W.R. station alongside has a decidedly derelict-looking frontage, with eight gargoyles or figureheads still clinging to the portico."
                                            },
                                            {
                                                "example_id": "8a6074b5-f522-4cc2-9227-c71e2697b3ce",
                                                "sense_id": "7ea7063f-7ec3-3613-8905-7dee59019a7f",
                                                "text": "In time The Simpsons would, indeed, resort to spoofing such decidedly non-spooktacular fare like E.T and Mr. And Mrs. Smith (both in “Treehouse Of Horror XVIII”) but in 1992 the field was wide-open and the show could cherry-pick the most iconic and beloved fright fare of all time."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "51d3e8cf-901a-3d7f-a44b-eaf4fe159623",
                                        "entry_id": "4a287309-6347-35e7-9558-8f444f464e92",
                                        "glosses": [
                                            "In a decided or final manner; resolutely."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c52442d-9f36-4422-9ad8-40f5eae63e10",
                                                "sense_id": "51d3e8cf-901a-3d7f-a44b-eaf4fe159623",
                                                "text": "‘We can't,’ said Vera decidedly, ‘we haven't any boats and we're cut off by a raging torrent from any human habitation.’"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2c348525-7657-460e-b2f6-b3d7e974f209",
                        "source_entry_id": "66624699-8ddb-334a-8822-a506b05dc7b1",
