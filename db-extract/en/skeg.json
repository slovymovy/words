                                "target_senses": [
                                    {
                                        "sense_id": "625eda52-71cb-3781-8ab9-ec5315d403b9",
                                        "entry_id": "fe8ea0bc-50fb-3096-8769-f241fc20a24f",
                                        "glosses": [
                                            "Extrémité de l’aile d’un oiseau à laquelle tiennent les grandes plumes de l’aile."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e18f40b-a0ed-43dd-b269-f1444a3506cd",
                                                "sense_id": "625eda52-71cb-3781-8ab9-ec5315d403b9",
                                                "text": "Un oiseau qui a l’aileron brisé."
                                            },
                                            {
                                                "example_id": "b744d3e6-cea7-4e7b-bbe6-0f25cfbc15e1",
                                                "sense_id": "625eda52-71cb-3781-8ab9-ec5315d403b9",
                                                "text": "Un ragoût, une fricassée d’ailerons."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "47e66299-c0f3-3b5e-bd71-a05af9848b2e",
                                        "entry_id": "fe8ea0bc-50fb-3096-8769-f241fc20a24f",
                                        "glosses": [
                                            "Extrémité de l’aile d’un avion permettant de contrôler la direction."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c6a7a479-2362-37a7-9e88-0a5d05e1caaf",
                                        "entry_id": "fe8ea0bc-50fb-3096-8769-f241fc20a24f",
                                        "glosses": [
                                            "Nageoires de quelques poissons."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0bad872c-0f86-4625-b45e-0b690570a4a7",
                                                "sense_id": "c6a7a479-2362-37a7-9e88-0a5d05e1caaf",
                                                "text": "Les ailerons d’une carpe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9bffd20d-4735-3c3c-b895-501c84b173bc",
                                        "entry_id": "fe8ea0bc-50fb-3096-8769-f241fc20a24f",
                                        "glosses": [
                                            "Tout ce qui rappelle la forme d’un aileron."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e7c5becb-68e0-4816-aea1-2bf8e035e565",
                                                "sense_id": "9bffd20d-4735-3c3c-b895-501c84b173bc",
                                                "text": "Les ailerons d’un moulin à eau."
                                            },
                                            {
                                                "example_id": "c442b1ea-34a4-4bc9-af85-53febb9bdd3e",
                                                "sense_id": "9bffd20d-4735-3c3c-b895-501c84b173bc",
                                                "text": "Les ailerons d’une fusée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "771ac7b0-8738-3ca1-bc09-1d000281bc9d",
                                        "entry_id": "fe8ea0bc-50fb-3096-8769-f241fc20a24f",
                                        "glosses": [
                                            "Bras d’une personne."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1e89c239-b99f-445c-9d84-e36e733f2f2c",
                                                "sense_id": "771ac7b0-8738-3ca1-bc09-1d000281bc9d",
                                                "text": "J’ai croché le mec par un aileron et je l’ai traîné sur le carrelage jusque là."
                                            },
                                            {
                                                "example_id": "757e4b7d-ed39-4625-b5e4-46becbf424c5",
                                                "sense_id": "771ac7b0-8738-3ca1-bc09-1d000281bc9d",
                                                "text": "Je me lève. Je vais à lui. Je lui cramponne l’aileron."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c1dd3f3f-dccf-3e15-bf57-0689318a70f1",
                                        "entry_id": "fe8ea0bc-50fb-3096-8769-f241fc20a24f",
                                        "glosses": [
                                            "Pièce à la forme de console renversée qui sert à rétablir une harmonie entre deux étages de largeurs inégales et peut éventuellement servir de contrefort pour l’étage supérieur."
                                        ],
                                        "tags": [
                                            "Architecture baroque"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cbb390e4-17f7-3273-be16-26e98249a1b7",
                                        "entry_id": "fe8ea0bc-50fb-3096-8769-f241fc20a24f",
                                        "glosses": [
                                            "Synonyme de alule."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ca46c83-4031-49e2-9f3e-9e180619bf9b",
                                                "sense_id": "cbb390e4-17f7-3273-be16-26e98249a1b7",
                                                "text": "Trois à cinq plumes roides, fort petites, taillées en lame et insérées au pouce, forment ce qu'on nomme aile bâtarde, aile fausse, aileron, alule ou fouet de l'aile."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
