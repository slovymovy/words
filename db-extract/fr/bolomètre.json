                                "target_senses": [
                                    {
                                        "sense_id": "64562c2d-9f7c-31d3-9459-03e76d386426",
                                        "entry_id": "ae293ac5-daac-33ea-9d1f-5cb2c8be7bbc",
                                        "glosses": [
                                            "Apparat zur Messung der elektromagnetischen Strahlung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7000edfb-6417-4459-be8b-9753e56ed68f",
                                                "sense_id": "64562c2d-9f7c-31d3-9459-03e76d386426",
                                                "text": "„Diese Wärme wird mit einem thermoelektrischen Apparat des Amerikaners Langley gemessen, dem Bolometer.“"
                                            },
                                            {
                                                "example_id": "f60f2edc-1ef1-4a42-9079-8bdbb8386b2e",
                                                "sense_id": "64562c2d-9f7c-31d3-9459-03e76d386426",
                                                "text": "„Das Problem: Um die winzigen Temperaturänderungen messbar zu machen, bedarf es einer Abkühlung des Bolometers auf nur 0,3 Grad über dem absoluten Nullpunkt (-273 Grad Celsius).“"
                                            },
                                            {
                                                "example_id": "e00581d6-4a2d-4ab7-a30c-c1741fa0dce2",
                                                "sense_id": "64562c2d-9f7c-31d3-9459-03e76d386426",
                                                "text": "„Auf der anderen Seite wird mittels gekühlter Blenden ein kleiner Raumwinkel ausgeblendet, der dem Bolometer, das die empfangene Strahlungsleistung registriert, nur die Sicht auf das heiße Zentrum freigibt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
