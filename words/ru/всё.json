{
    "word_family": [
        "весь",
        "всегда",
        "всего",
        "вселенная",
        "всецело",
        "всеобщий"
    ],
    "entries": [
        {
            "pos": "pronoun",
            "senses": [
                {
                    "sense_id": "8a95a1f6-d0ed-3d75-9e0c-9c111ba5ea89",
                    "sense_definition": "Обозначает совокупность всех предметов, явлений или обстоятельств; всё существующее.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "totality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я хочу знать <всё> об этом случае.",
                            "target_lang_translations": {
                                "en": "I want to know <everything> about this case.",
                                "zh": "我想知道关于这件事的<w>一切</w>。"
                            }
                        },
                        {
                            "text": "Они купили <всё>, что было в списке.",
                            "target_lang_translations": {
                                "en": "They bought <everything> that was on the list.",
                                "zh": "他们买了清单上的<w>所有</w>东西。"
                            }
                        }
                    ],
                    "antonyms": [
                        "ничего"
                    ],
                    "common_phrases": [
                        "всё или ничего",
                        "вот и всё",
                        "прежде всего",
                        "всё включено"
                    ],
                    "target_lang_definitions": {
                        "en": "Refers to the totality of objects, phenomena, or circumstances; everything that exists.",
                        "zh": "指代所有事物、现象或情况的总和；一切存在的东西。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "everything",
                                "target_lang_sense_clarification": "all things or circumstances"
                            },
                            {
                                "target_lang_word": "all",
                                "target_lang_sense_clarification": "the whole amount or quantity"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "一切",
                                "target_lang_sense_clarification": "指所有事物或情况"
                            },
                            {
                                "target_lang_word": "所有",
                                "target_lang_sense_clarification": "指全部数量或范围"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6fd36524-f3d2-3bbc-8ff1-edc48e952b48",
                    "sense_definition": "Текущая ситуация, положение дел или общее состояние жизни.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "situation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "У меня <всё> хорошо, не волнуйся.",
                            "target_lang_translations": {
                                "en": "<Everything> is fine with me, don't worry.",
                                "zh": "我<w>一切</w>都好，别担心。"
                            }
                        },
                        {
                            "text": "Как у тебя <всё> прошло на работе?",
                            "target_lang_translations": {
                                "en": "How did <things> go at work?",
                                "zh": "你工作上的<w>情况</w>怎么样？"
                            }
                        }
                    ],
                    "synonyms": [
                        "дела",
                        "ситуация"
                    ],
                    "common_phrases": [
                        "как всё прошло",
                        "всё в порядке",
                        "всё хорошо",
                        "всё сложно"
                    ],
                    "target_lang_definitions": {
                        "en": "The current situation, state of affairs, or general condition of life.",
                        "zh": "当前的处境、事态或生活的一般状况。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "everything",
                                "target_lang_sense_clarification": "current situation or life in general"
                            },
                            {
                                "target_lang_word": "things",
                                "target_lang_sense_clarification": "general state of affairs"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "一切",
                                "target_lang_sense_clarification": "指当前的情况或生活状态"
                            },
                            {
                                "target_lang_word": "情况",
                                "target_lang_sense_clarification": "指事态的总体状况"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b1d13566-6ae7-3712-b4e4-43ee2b45cffa",
                    "sense_definition": "Используется после сравнительной степени прилагательных или наречий для образования превосходной степени.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "grammar_superlative",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Больше <всё> я люблю читать книги.",
                            "target_lang_translations": {
                                "en": "I like reading books <most of all>.",
                                "zh": "我<w>最</w>喜欢读书。"
                            }
                        },
                        {
                            "text": "Этот вариант мне нравится меньше <всё>.",
                            "target_lang_translations": {
                                "en": "I like this option <least of all>.",
                                "zh": "我<w>最</w>不喜欢这个方案。"
                            }
                        }
                    ],
                    "synonyms": [
                        "все",
                        "наибо́лее"
                    ],
                    "common_phrases": [
                        "больше всего",
                        "лучше всего",
                        "чаще всего",
                        "меньше всего"
                    ],
                    "target_lang_definitions": {
                        "en": "Used after comparative adjectives or adverbs to express the superlative degree (literally 'more than all').",
                        "zh": "用于形容词或副词比较级之后，构成最高级。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "most of all",
                                "target_lang_sense_clarification": "more than anything else"
                            },
                            {
                                "target_lang_word": "of all",
                                "target_lang_sense_clarification": "among everyone or everything"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "最",
                                "target_lang_sense_clarification": "表示程度最高"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "6ee3221c-3bb4-3b31-861c-3eb15629c986",
                    "sense_definition": "Указывает на то, что действие или состояние продолжается до сих пор, вопреки времени или ожиданиям.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "continuity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы <всё> ещё ждём твоего ответа.",
                            "target_lang_translations": {
                                "en": "We are <still> waiting for your answer.",
                                "zh": "我们<w>还</w>在等你的回复。"
                            }
                        },
                        {
                            "text": "Дождь <всё> идёт и не собирается прекращаться.",
                            "target_lang_translations": {
                                "en": "The rain is <still> falling and isn't going to stop.",
                                "zh": "雨<w>还</w>在下，没有要停的意思。"
                            }
                        }
                    ],
                    "synonyms": [
                        "до сих по́р",
                        "по-прежнему"
                    ],
                    "common_phrases": [
                        "всё ещё",
                        "всё так же",
                        "всё тот же"
                    ],
                    "target_lang_definitions": {
                        "en": "Indicates that an action or state is still continuing, often contrary to expectation.",
                        "zh": "表示动作或状态持续至今，常与预期相反。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "still",
                                "target_lang_sense_clarification": "continuing action or state"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "还",
                                "target_lang_sense_clarification": "表示动作或状态仍在继续"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "78f31fb5-84b5-3d56-be39-1fb46e64e3e2",
                    "sense_definition": "Постоянно, каждый раз, всё время.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "frequency",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Почему ты <всё> молчишь?",
                            "target_lang_translations": {
                                "en": "Why do you <keep> staying silent?",
                                "zh": "你为什么<w>老是</w>沉默不语？"
                            }
                        },
                        {
                            "text": "Он <всё> забывает закрыть дверь.",
                            "target_lang_translations": {
                                "en": "He <always> forgets to close the door.",
                                "zh": "他<w>总是</w>忘记关门。"
                            }
                        }
                    ],
                    "synonyms": [
                        "всегда́",
                        "постоя́нно"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in spoken language to express annoyance or emphasis"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Constantly, every time, or keeping on doing something (often implying annoyance).",
                        "zh": "持续地、每次都、一直做某事（常带有厌烦情绪）。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "keep",
                                "target_lang_sense_clarification": "to continue doing something repeatedly"
                            },
                            {
                                "target_lang_word": "always",
                                "target_lang_sense_clarification": "constantly or frequently"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "总是",
                                "target_lang_sense_clarification": "表示频繁或持续发生"
                            },
                            {
                                "target_lang_word": "老是",
                                "target_lang_sense_clarification": "表示反复发生，常含不满"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9f400e80-b23d-3a99-9a4c-b1eed6bda664",
                    "sense_definition": "Употребляется со сравнительной степенью для указания на нарастание признака.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "intensifier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "С каждым днём становится <всё> холоднее.",
                            "target_lang_translations": {
                                "en": "It is getting <more and more> cold every day.",
                                "zh": "天气一天比一天<w>越来越</w>冷了。"
                            }
                        },
                        {
                            "text": "Он говорил <всё> громче и громче.",
                            "target_lang_translations": {
                                "en": "He spoke <louder and louder>.",
                                "zh": "他说话的声音<w>越来越</w>大。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "всё больше",
                        "всё лучше",
                        "всё хуже",
                        "всё чаще"
                    ],
                    "target_lang_definitions": {
                        "en": "Used with comparatives to indicate an increasing degree or progression.",
                        "zh": "与比较级连用，表示程度的递增。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "more and more",
                                "target_lang_sense_clarification": "increasing degree"
                            },
                            {
                                "target_lang_word": "increasingly",
                                "target_lang_sense_clarification": "growing in degree"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "越来越",
                                "target_lang_sense_clarification": "表示程度随时间增长"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "29082675-6068-378a-8593-c23e358bf1da",
                    "sense_definition": "Употребляется для выделения или ограничения; только, исключительно.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "limitation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Это <всё> твои выдумки, ничего больше.",
                            "target_lang_translations": {
                                "en": "These are <all> your inventions, nothing more.",
                                "zh": "这<w>只是</w>你编出来的，没别的。"
                            }
                        },
                        {
                            "text": "Он <всё> шутит, даже в серьёзных ситуациях.",
                            "target_lang_translations": {
                                "en": "He <just> jokes, even in serious situations.",
                                "zh": "他<w>只是</w>在开玩笑，即使在严肃的场合也是。"
                            }
                        }
                    ],
                    "synonyms": [
                        "то́лько",
                        "лишь",
                        "и́менно"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Used for emphasis or limitation; implies 'only' or 'just'.",
                        "zh": "用于强调或限制；意为“仅仅”、“只是”。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "all",
                                "target_lang_sense_clarification": "nothing but; exclusively"
                            },
                            {
                                "target_lang_word": "just",
                                "target_lang_sense_clarification": "only; simply"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "只是",
                                "target_lang_sense_clarification": "表示仅限于此"
                            },
                            {
                                "target_lang_word": "不过",
                                "target_lang_sense_clarification": "表示仅此而已"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "c1d77c06-b4df-313c-9285-a6513692e514",
                    "sense_definition": "Выражает завершение действия, достаточность чего-либо или решение прекратить что-то.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "completion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ну <всё>, мне пора идти домой.",
                            "target_lang_translations": {
                                "en": "Well, <that's it>, time for me to go home.",
                                "zh": "<w>好了</w>，就这样，我该回家了。"
                            }
                        },
                        {
                            "text": "<Всё>, хватит спорить, давайте работать.",
                            "target_lang_translations": {
                                "en": "<Enough>, stop arguing, let's work.",
                                "zh": "<w>够了</w>，别再争了，开始工作吧。"
                            }
                        }
                    ],
                    "synonyms": [
                        "хва́тит",
                        "дово́льно",
                        "коне́ц",
                        "доста́точно"
                    ],
                    "common_phrases": [
                        "ну всё",
                        "на этом всё",
                        "всё пока"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Expresses the completion of an action, sufficiency, or a decision to stop; 'that's it'.",
                        "zh": "表示动作结束、足够或决定停止；意为“就这样”、“够了”。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "that's it",
                                "target_lang_sense_clarification": "indicating completion or conclusion"
                            },
                            {
                                "target_lang_word": "enough",
                                "target_lang_sense_clarification": "indicating sufficiency or desire to stop"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "好了",
                                "target_lang_sense_clarification": "表示结束或决定停止"
                            },
                            {
                                "target_lang_word": "够了",
                                "target_lang_sense_clarification": "表示程度已足或要求停止"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a77ace83-0154-327d-8cf3-f2c95c059534",
                    "sense_definition": "Означает, что человек закончил делать что-то.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "completion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ты <всё>? Мы можем идти?",
                            "target_lang_translations": {
                                "en": "Are you <done>? Can we go?",
                                "zh": "你<w>完了</w>吗？我们可以走了吗？"
                            }
                        },
                        {
                            "text": "Я <всё>, забирай свою ручку.",
                            "target_lang_translations": {
                                "en": "I'm <done>, take your pen.",
                                "zh": "我<w>完了</w>，拿走你的笔吧。"
                            }
                        }
                    ],
                    "synonyms": [
                        "закончил",
                        "готов"
                    ],
                    "common_phrases": [
                        "я всё",
                        "ты всё"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used predicatively"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Indicates that someone has finished a task or action.",
                        "zh": "表示某人已经完成了某项任务或动作。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "done",
                                "target_lang_sense_clarification": "finished with a task"
                            },
                            {
                                "target_lang_word": "finished",
                                "target_lang_sense_clarification": "completed an action"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "完了",
                                "target_lang_sense_clarification": "表示动作已完成"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f572f130-407c-3eb1-a12f-7953dbeafb5e",
                    "sense_definition": "Указывает на то, что предмет сломался, испортился или перестал работать.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "failure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мой телефон <всё>, нужно покупать новый.",
                            "target_lang_translations": {
                                "en": "My phone is <dead>, I need to buy a new one.",
                                "zh": "我的手机<w>坏了</w>，得买个新的。"
                            }
                        },
                        {
                            "text": "Кажется, мотор <всё>, машина не заводится.",
                            "target_lang_translations": {
                                "en": "It seems the engine is <done for>, the car won't start.",
                                "zh": "看来引擎<w>报废</w>了，车发动不起来。"
                            }
                        }
                    ],
                    "synonyms": [
                        "коне́ц"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        },
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Indicates that something is broken, dead, or finished (slang).",
                        "zh": "指某物损坏、报废或停止工作（俚语）。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "dead",
                                "target_lang_sense_clarification": "stopped working (of a device)"
                            },
                            {
                                "target_lang_word": "done for",
                                "target_lang_sense_clarification": "broken or ruined"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "坏了",
                                "target_lang_sense_clarification": "指设备停止工作"
                            },
                            {
                                "target_lang_word": "报废",
                                "target_lang_sense_clarification": "指彻底损坏无法使用"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "determiner",
            "senses": [
                {
                    "sense_id": "5f0dc767-f4c9-3f1f-ad9b-10b1dd78df0f",
                    "sense_definition": "Форма именительного или винительного падежа единственного числа среднего рода местоимения <w>весь</w>.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "grammar_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы потратили <всё> утро на уборку.",
                            "target_lang_translations": {
                                "en": "We spent <the whole> morning cleaning.",
                                "zh": "我们花了<w>整个</w>上午打扫卫生。"
                            }
                        },
                        {
                            "text": "<Всё> село вышло на праздник.",
                            "target_lang_translations": {
                                "en": "<The whole> village came out for the celebration.",
                                "zh": "<w>整个</w>村子的人都出来庆祝节日了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "всё время",
                        "всё утро"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "neuter singular"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Neuter singular form of 'all' or 'the whole'.",
                        "zh": "“全部”或“整个”的中性单数形式。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "the whole",
                                "target_lang_sense_clarification": "entirety of a specific thing"
                            },
                            {
                                "target_lang_word": "all",
                                "target_lang_sense_clarification": "the entire amount or duration"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "整个",
                                "target_lang_sense_clarification": "指事物的全部"
                            }
                        ]
                    }
                }
            ]
