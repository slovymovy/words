                        "form": "das Sümmchen"
                    },
                    {
                        "form_id": "2efe09fe-7943-4d7d-8750-e0fce6d5c379",
                        "entry_id": "c8bdcf1d-9f6e-33ae-8e59-bcc981642a2a",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Sümmchen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5269ab21-c452-3bf8-8ac6-da5e3c4a9510",
                        "entry_id": "c8bdcf1d-9f6e-33ae-8e59-bcc981642a2a",
                        "glosses": [
                            "ein meist größerer Geldbetrag"
                        ],
                        "tags": [
                            "verhüllend"
                        ],
                        "examples": [
                            {
                                "example_id": "6bde3522-8b5f-45f0-be5c-497b02b1d206",
                                "sense_id": "5269ab21-c452-3bf8-8ac6-da5e3c4a9510",
                                "text": "Bei der Spendensammlung ist dann doch ein ansehnliches Sümmchen zusammengekommen."
                            },
                            {
                                "example_id": "b23a3c0a-e9c7-42d1-8c06-a0ee4aa1a154",
                                "sense_id": "5269ab21-c452-3bf8-8ac6-da5e3c4a9510",
                                "text": "„Das Angebot war verlockend, nicht nur dank eines schönen Sümmchens, das er bekommen würde, sondern auch deshalb, weil er so vor der Neugier der Leute geschützt war.“"
                            },
                            {
                                "example_id": "b70fb754-67b9-48c9-94b3-15365eeac01a",
                                "sense_id": "5269ab21-c452-3bf8-8ac6-da5e3c4a9510",
                                "text": "„Selbst wenn man den Wert der mitgenommenen Bademäntel, Handtücher und Radiowecker abzieht, bleibt immer noch ein hübsches Sümmchen übrig!“"
                            },
                            {
                                "example_id": "d3578161-7768-46b1-b80f-71114608546e",
                                "sense_id": "5269ab21-c452-3bf8-8ac6-da5e3c4a9510",
                                "text": "„Ein hübsches Sümmchen ist das, und ihre Freude darüber mildert ihren Groll auf Jürgen Loose.“"
                            },
                            {
                                "example_id": "814632f4-fcad-4521-86f0-472f2bcdad37",
                                "sense_id": "5269ab21-c452-3bf8-8ac6-da5e3c4a9510",
                                "text": "„Wir sprechen von einem hübschen Sümmchen, wie man es nie und nimmer als Setzer erwirbt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
