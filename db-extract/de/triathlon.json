                    {
                        "translation_id": "6df172d8-c4e3-496b-b375-2f1a9c8ac9e4",
                        "source_entry_id": "79717aca-7fe8-3642-876f-64fd7205c4e8",
                        "source_sense_id": "b01a422a-39b3-3969-9e9f-954fa9af7993",
                        "source_sense_description": "im Sommer: Wettkampf, bei dem an einem Tag die Disziplinen Schwimmen, Radfahren und Laufen zu absolvieren sind",
                        "target_lang_word": "triathlon",
                        "target_lang_code": "fr",
