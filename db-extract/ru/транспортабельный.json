                    {
                        "translation_id": "27b669b3-78ee-4f8f-b601-637e295b3d13",
                        "source_entry_id": "2a74c151-282a-31e5-98d4-5e89db9a4133",
                        "source_sense_id": "68b66036-e811-3160-9db9-fa809be91543",
