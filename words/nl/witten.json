                    "frequency": "Low",
                    "semantic_group_id": "wit_maken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vroeger legde men de was op het gras om de lakens te <w>witten</w> in de zon.",
                            "target_lang_translations": {
                                "en": "In the past, people laid the laundry on the grass to <w>whiten</w> the sheets in the sun."
                            }
                        },
                        {
                            "text": "Met dit speciale middel kun je vergeelde stoffen weer snel <w>witten</w>.",
                            "target_lang_translations": {
