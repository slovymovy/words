                        },
                        {
                            "text": "De passagiers mogen nu <opstappen> voor de trein naar Amsterdam.",
                            "target_lang_translations": {
                                "en": "The passengers may now <w>board</w> the train to Amsterdam.",
                                "ru": "Пассажиры теперь могут <садиться> в поезд до Амстердама.",
                                "pl": "Pasażerowie mogą już <w>wsiadać</w> do pociągu do Amsterdamu.",
                                "de": "Die Fahrgäste dürfen jetzt für den Zug nach Amsterdam <w>einsteigen</w>.",
                                "fr": "Les passagers peuvent maintenant <w>monter à bord</w> du train pour Amsterdam.",
                                "it": "I passeggeri possono ora <w>salire a bordo</w> del treno per Amsterdam.",
                                "cs": "Cestující mohou nyní <w>nastupovat</w> do vlaku do Amsterdamu.",
                                "tr": "Yolcular artık Amsterdam trenine <w>binebilirler</w>.",
                                "es": "Los pasajeros ya pueden <w>embarcar</w> en el tren hacia Ámsterdam."
