            {
                "entry_id": "cd09750f-d43d-3000-986d-22451a7e3bdb",
                "word": "Podunk",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "6377d9c5-a760-318d-97a4-122794608cc0",
                        "entry_id": "cd09750f-d43d-3000-986d-22451a7e3bdb",
                        "glosses": [
                            "A Native American people who spoke an Algonquian Quiripi language and lived primarily in modern-day Hartford County, Connecticut."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "d7f8b285-faaf-37a0-9e4f-838d5bb4517b",
                        "entry_id": "cd09750f-d43d-3000-986d-22451a7e3bdb",
                        "glosses": [
                            "A mythical small town of no importance."
                        ],
                        "tags": [
                            "US"
                        ],
                        "examples": [
                            {
                                "example_id": "78da94f8-ed40-4681-a928-913a97e9f380",
                                "sense_id": "d7f8b285-faaf-37a0-9e4f-838d5bb4517b",
                                "text": "They even know it in Podunk, wherever that may be."
                            },
                            {
                                "example_id": "b26615a7-8288-49b5-85fd-c3b626f5d7a9",
                                "sense_id": "d7f8b285-faaf-37a0-9e4f-838d5bb4517b",
                                "text": "Podunk. A term applied to an imaginary place in burlesque writing or speaking."
                            },
                            {
                                "example_id": "ab79cefe-24a3-4448-812b-af388e9983b5",
                                "sense_id": "d7f8b285-faaf-37a0-9e4f-838d5bb4517b",
                                "text": "Podunk, like Atlantis, has no locus. Sought often, it is unfound and apparently unfindable."
                            },
                            {
                                "example_id": "3621d138-7a6c-4bbe-a9d1-33a96795551f",
                                "sense_id": "d7f8b285-faaf-37a0-9e4f-838d5bb4517b",
                                "text": "This isn't some Podunk charge in some Podunk court. Charged with four counts of perjury and one of obstruction of justice, Bonds, if convicted, could be sentenced to a maximum of 30 years in prison."
                            }
                        ]
                    }
                ],
                "translations": [
