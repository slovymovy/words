        "fr-extract.jsonl": [
            {
                "entry_id": "405880f7-7e71-3cc6-b7f9-5271eded4a0f",
                "word": "nominalisation",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "9e01590d-8b05-4d9d-a2e4-d375b829177a",
                        "entry_id": "405880f7-7e71-3cc6-b7f9-5271eded4a0f",
                        "tags": [
                            "plural"
                        ],
                        "form": "nominalisations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "97cc7689-016e-3122-8586-aaa5b9b7d527",
                        "entry_id": "405880f7-7e71-3cc6-b7f9-5271eded4a0f",
                        "glosses": [
                            "Emploi comme nom, d'un groupe de mots, d'un adjectif, d'un verbe, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73b390f2-cce6-4c00-b149-34bf3d793d6a",
                                "sense_id": "97cc7689-016e-3122-8586-aaa5b9b7d527",
                                "text": "Dans « le pourquoi et le comment », ces deux adverbes ont subi une nominalisation."
                            },
                            {
                                "example_id": "f23792ff-99dd-4341-9bb6-0e8ffde1484a",
                                "sense_id": "97cc7689-016e-3122-8586-aaa5b9b7d527",
                                "text": "Dans « un tiens vaut mieux que deux tu l'auras », « tiens » et « tu l'auras » ont subi une nominalisation."
                            },
                            {
                                "example_id": "113f1a6e-7f09-47c4-9484-1d90d0e72be1",
                                "sense_id": "97cc7689-016e-3122-8586-aaa5b9b7d527",
                                "text": "On préfèrera à la nominalisation, qui correspond à une mode et alourdit considérablement la phrase, l'usage d'une proposition construite autour d'un verbe (comme « X a redressé cette entreprise » plutôt que « le redressement de cette entreprise par X »)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "849c0d89-8ab8-4613-a4a9-a6e27cdbdb59",
                        "source_entry_id": "405880f7-7e71-3cc6-b7f9-5271eded4a0f",
                        "source_sense_id": "97cc7689-016e-3122-8586-aaa5b9b7d527",
                        "target_lang_word": "nominalization",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nominalization",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "250b6d6f-51ae-3cfc-b271-837a2a6a34d0",
                                        "entry_id": "1827ae2d-2b08-3977-9f84-69f297526cb0",
                                        "glosses": [
                                            "A noun derived from an adjective, verb, etc., often (in English) by adding a suffix such as -ity, -tion or -ism."
                                        ],
                                        "tags": [
                                            "British",
                                            "English",
                                            "Oxford",
                                            "US",
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "887c69df-6cef-4001-bb0d-52b40e59496f",
                                                "sense_id": "250b6d6f-51ae-3cfc-b271-837a2a6a34d0",
                                                "text": "Writers who overload their sentences with nominalizations tend to sound pompous and abstract."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "78315492-b34a-3336-9be0-90ec35a0b90f",
                                        "entry_id": "1827ae2d-2b08-3977-9f84-69f297526cb0",
                                        "glosses": [
                                            "The act or process of nominalizing; the use of such a noun."
                                        ],
                                        "tags": [
                                            "British",
                                            "English",
                                            "Oxford",
                                            "US",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6242028c-bffb-4596-849d-7e59df6a63dc",
                                                "sense_id": "78315492-b34a-3336-9be0-90ec35a0b90f",
                                                "text": "The positive use of the feminine noun une rien has been gradually replaced by the nominalization of the pronoun and the adverb that commonly serve as negative auxiliaries, rien, un rien: “The word offers a short version of the evolution of the etymological meaning of chose inverted as néant (c. 1530)” (RT: DHLF)[…]"
                                            },
                                            {
                                                "example_id": "f3bb747c-3d4c-408e-94df-ebd936b49e3c",
                                                "sense_id": "78315492-b34a-3336-9be0-90ec35a0b90f",
                                                "text": "Nominalization and agentless passives have attracted sustained attention in critical linguistics and Critical Discourse Analysis (CDA), where, it is argued, they ‘mystify’, i.e., reduce reader comprehension of, the role of social actors in depictions of events, particularly in news media discourse."
                                            },
                                            {
                                                "example_id": "9ec89458-25f5-4541-b2ae-ae71e8a27674",
                                                "sense_id": "78315492-b34a-3336-9be0-90ec35a0b90f",
                                                "text": "Nominalization is a common feature of a more scientific style of writing and is used as an additional measure for syntactic complexity."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a79bee43-f8be-49bf-a7f1-3d5ee872bbe5",
                        "source_entry_id": "405880f7-7e71-3cc6-b7f9-5271eded4a0f",
