                        "examples": [
                            {
                                "example_id": "94da6f2d-d357-410d-b22d-1c3686bd19f7",
                                "sense_id": "b9363f79-b4d1-30fd-8c6e-961cb007dba7",
                                "text": "Comme nous étions là à rire, à buvocher et à chanter, nous voyons défiler des régiments de demoiselles, des petites et des grandes et des moyennes, avec des sœurs dont les grandes coiffes claquaient en l’air et de longs chapelets qui leur battaient les cuisses avec le bruit d’un sabre de cavalerie, et toutes ces chères sœurs se remuaient et se trémoussaient et allaient de droite à gauche et alignaient les unes et morigénaient les autres, et avançaient celles-ci, et reculaient celles-là, que toutes baissaient les yeux et se laissaient mettre en place comme un troupeau de baudets."
                            },
                            {
                                "example_id": "e391bb7f-c3d0-471d-ad1e-0e2731bfe236",
                                "sense_id": "b9363f79-b4d1-30fd-8c6e-961cb007dba7",
                                "text": "Elle s’est mise alors à buvocher de temps en temps."
                            }
                        ]
