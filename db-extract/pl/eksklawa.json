                "senses": [
                    {
                        "sense_id": "088cb472-230c-3784-957e-03e9b2e38fc8",
                        "entry_id": "b7d72a2b-289e-3caf-bdac-01acc4fe6d12",
                        "glosses": [
                            "część terytorium jednostki administracyjnej położona w oddzieleniu od głównego jego obszaru, lecz na tym samym obszarze lądowym"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da01f5ff-14a8-420c-b786-ced10291d0b8",
                                "sense_id": "088cb472-230c-3784-957e-03e9b2e38fc8",
                                "text": "Westerplatte było polską eksklawą na terenie Wolnego Miasta Gdańska."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fc90459e-cd20-46a0-8a8b-7522b360f506",
                        "source_entry_id": "b7d72a2b-289e-3caf-bdac-01acc4fe6d12",
                        "source_sense_id": "088cb472-230c-3784-957e-03e9b2e38fc8",
                        "target_lang_word": "exclave",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "exclave",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0637e915-3ef7-31d4-b9ed-fe64b59d7546",
                                        "entry_id": "aab0e3d5-8faa-3560-8d12-9aa7f07ed92d",
                                        "glosses": [
                                            "A portion of a country's territory not connected to the main part."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e75eb4e-38b7-4bdf-9b1e-0c9825ff9a27",
                                                "sense_id": "0637e915-3ef7-31d4-b9ed-fe64b59d7546",
                                                "text": "Alaska and Kaliningrad are both examples of exclaves."
                                            },
                                            {
                                                "example_id": "8645bce9-4171-4365-9f53-dc75f4c81d3b",
                                                "sense_id": "0637e915-3ef7-31d4-b9ed-fe64b59d7546",
                                                "text": "While there has never been a macronational bedroom nation, some exclaves have been barely larger."
                                            },
                                            {
                                                "example_id": "12b9dffa-ed4a-40e0-8776-3139214c947c",
                                                "sense_id": "0637e915-3ef7-31d4-b9ed-fe64b59d7546",
                                                "text": "Spain’s Melilla, one of two small exclaves of EU land on the African continent, has long been the strongest distillation of fortress Europe."
                                            },
                                            {
                                                "example_id": "11e30560-4cdc-44fb-8bf6-50a436009506",
                                                "sense_id": "0637e915-3ef7-31d4-b9ed-fe64b59d7546",
                                                "text": "France, but the shape of a giraffe, with a number of its counties belonging to Wales, with an odd little exclave far up North in Norway? That's border gore."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c18795e-8e57-3910-bd55-aa6cdf119c28",
                                        "entry_id": "aab0e3d5-8faa-3560-8d12-9aa7f07ed92d",
                                        "glosses": [
                                            "A detached part of an organ, as of the pancreas, thyroid (accessory thyroids), or other gland."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "exclave",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ad13b67c-3832-396b-9c4e-52770c52a649",
                                        "entry_id": "2b1f8cea-f3c2-3359-9a51-a652c4c4084f",
                                        "glosses": [
                                            "To separate a region in a way that turns it into an exclave."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "60c527bd-c2bc-4a68-bdaf-7e9ca330e0f7",
                        "source_entry_id": "b7d72a2b-289e-3caf-bdac-01acc4fe6d12",
                        "source_sense_id": "088cb472-230c-3784-957e-03e9b2e38fc8",
                        "target_lang_word": "exclave",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "exclave",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fb3e3337-1f5b-3376-9c38-a027628c9a4d",
                                        "entry_id": "0a30fe94-de59-30f0-954e-cab81367b0e4",
                                        "glosses": [
                                            "Partie d’un pays ou d’un territoire non reliée à la partie principale de celui-ci et frontalière d’autres pays ou territoires."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0c713c1-3231-411e-8f04-82b76c91eaf5",
                                                "sense_id": "fb3e3337-1f5b-3376-9c38-a027628c9a4d",
                                                "text": "En 1960, l’enclave ou mieux l’exclave, de Cabinda comptait 58 547 habitants dont 1 922 Blancs."
                                            },
                                            {
                                                "example_id": "a8f705de-6680-4b26-af58-b2ca003c46eb",
                                                "sense_id": "fb3e3337-1f5b-3376-9c38-a027628c9a4d",
                                                "text": "Kaliningrad a souffert de sa situation d'« exclave », où « l’effet de rupture », comme en Corse […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "091a576d-d130-4061-a5a5-cec8d4b8d0f2",
                        "source_entry_id": "b7d72a2b-289e-3caf-bdac-01acc4fe6d12",
                        "source_sense_id": "088cb472-230c-3784-957e-03e9b2e38fc8",
                        "target_lang_word": "exclave",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "a4d000a7-8396-4654-9d98-d34f6fb8be9d",
                        "source_entry_id": "b7d72a2b-289e-3caf-bdac-01acc4fe6d12",
                        "source_sense_id": "088cb472-230c-3784-957e-03e9b2e38fc8",
                        "target_lang_word": "Exklave",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Exklave",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "40047985-06dd-322a-ac45-ae146850e961",
                                        "entry_id": "eec85e6b-2803-3403-9800-875ff87f9fab",
                                        "glosses": [
                                            "von fremdem Gebiet umschlossener Teil des eigenen Gebiets"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5762fa1-8e3b-46cd-bc0f-f457104dbf09",
                                                "sense_id": "40047985-06dd-322a-ac45-ae146850e961",
                                                "text": "„Zusätzlich provozierte die von US-Präsident George Bush forcierte Raketenabwehr mit Abfang- und Kontrollstationen in Polen und Tschechien den Kreml in höchstem Maße. Man drohte im Gegenzug mit einer Raketenbasis in der Exklave Kaliningrad, nur ein paar Kilometer von polnischem und baltischem Territorium entfernt.“"
                                            },
                                            {
                                                "example_id": "a7ba11a3-178a-431e-9bd1-38dda6055c8a",
                                                "sense_id": "40047985-06dd-322a-ac45-ae146850e961",
                                                "text": "„Dem Eichsfeld als vielhundertjähriger Mainzer Exklave wird a priori Altgläubigkeit unterstellt.“"
                                            },
                                            {
                                                "example_id": "5d8093ac-e715-4dbb-b065-a861ab644c99",
                                                "sense_id": "40047985-06dd-322a-ac45-ae146850e961",
                                                "text": "„Heute ist das Kaliningrader Gebiet eine russische Exklave inmitten der Europäischen Union.“"
                                            },
                                            {
                                                "example_id": "4b04e15b-bfdd-4a32-9477-79c0d6287a9c",
                                                "sense_id": "40047985-06dd-322a-ac45-ae146850e961",
                                                "text": "„Doch Ostpreußen war eben auch ein geschichtsträchtiger Teil Deutschlands – und dessen Degradierung zu einer Exklave weckte damals Empörung und auch Mitgefühl im Land.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9c060321-714c-4e36-b272-337a2a1cc717",
                        "source_entry_id": "b7d72a2b-289e-3caf-bdac-01acc4fe6d12",
