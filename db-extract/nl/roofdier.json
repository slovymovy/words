                "translations": [
                    {
                        "translation_id": "467b6787-0f77-43f3-b6a1-b92b2f2c5f9d",
                        "source_entry_id": "1b1a0769-67ff-3c1d-a22a-fabffcdd93d8",
                        "source_sense_id": "62583611-9b9c-37ad-9d41-a71f49bc7ac6",
                        "source_sense_description": "dier dat zijn prooi bejaagt en doodt",
                        "target_lang_word": "Raubtier",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Raubtier",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c4a048f1-4487-3482-9315-122760d5a9f3",
                                        "entry_id": "e057b16c-1643-3f9d-981f-72aa5479f301",
                                        "glosses": [
                                            "Mitglied einer Ordnung der Säugetiere (Carnivora), welche sich im Allgemeinen räuberisch oder als Aasfresser von anderen Tieren ernährt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9278dd8-e9e7-4b59-a2a9-08541bbb2a5d",
                                                "sense_id": "c4a048f1-4487-3482-9315-122760d5a9f3",
                                                "text": "Obwohl der Panda zu den Raubtieren gehört, ist er ein Pflanzenfresser."
                                            },
                                            {
                                                "example_id": "11c3ce73-af74-459d-9d89-f1efbf94ad4b",
                                                "sense_id": "c4a048f1-4487-3482-9315-122760d5a9f3",
                                                "text": "„Nach dem Bad lief er hin und her wie ein Raubtier zwischen Gittern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f40b2037-0fa8-3de3-9cbe-04d6d135065a",
                                        "entry_id": "e057b16c-1643-3f9d-981f-72aa5479f301",
                                        "glosses": [
                                            "ein Tier, das andere Tiere fängt und frisst"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62fdaf61-dc01-49db-bc1c-38c6d5c9254e",
                                                "sense_id": "f40b2037-0fa8-3de3-9cbe-04d6d135065a",
                                                "text": "Er lief wie ein gefangenes Raubtier im Zimmer auf und ab, während er eine Zigarette nach der nächsten rauchte."
                                            },
                                            {
                                                "example_id": "07dac437-e023-48ee-9245-b19ca2fdba64",
                                                "sense_id": "f40b2037-0fa8-3de3-9cbe-04d6d135065a",
                                                "text": "Dann mal auf zur Fütterung der Raubtiere, kommen Sie Herr Direktor? Die Belegschaft wartet in der Aula auf uns."
                                            },
                                            {
                                                "example_id": "d59e145b-a66d-440a-bf72-3a2013082afe",
                                                "sense_id": "f40b2037-0fa8-3de3-9cbe-04d6d135065a",
                                                "text": "Manche Ratten sind reine Raubtiere."
                                            },
                                            {
                                                "example_id": "30b5ccce-7f8f-42b5-b875-843db6ad5487",
                                                "sense_id": "f40b2037-0fa8-3de3-9cbe-04d6d135065a",
                                                "text": "In der Wüste kann man freilebende Raubtiere beobachten, aber doch nicht im Safaripark!"
                                            },
                                            {
                                                "example_id": "68139cbb-2fc5-43fe-979d-99a65ddea3cd",
                                                "sense_id": "f40b2037-0fa8-3de3-9cbe-04d6d135065a",
                                                "text": "Die Schafe wurden ganz offensichtlich von einem Raubtier getötet."
                                            },
                                            {
                                                "example_id": "14ba76af-6be2-4174-8127-dd1421397978",
                                                "sense_id": "f40b2037-0fa8-3de3-9cbe-04d6d135065a",
                                                "text": "„Mit der Beobachtung der Raubtiere haben wir unseren Rundgang beendet.“"
                                            },
                                            {
                                                "example_id": "2300a737-9058-4c83-ab0d-597ddf849ac6",
                                                "sense_id": "f40b2037-0fa8-3de3-9cbe-04d6d135065a",
                                                "text": "„Wahrscheinlich haben Raubtiere irgendwo Niederwild geschlagen.“"
                                            },
                                            {
                                                "example_id": "7d39a58c-475f-4398-a84c-298f40831f27",
                                                "sense_id": "f40b2037-0fa8-3de3-9cbe-04d6d135065a",
                                                "text": "„Die Siedler wußten jetzt wenigstens, mit welchen Raubtieren sie in Zukunft zu rechnen hatten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "801dd1b0-5f8e-43cc-8efa-e20872db9802",
                        "source_entry_id": "1b1a0769-67ff-3c1d-a22a-fabffcdd93d8",
                        "source_sense_id": "62583611-9b9c-37ad-9d41-a71f49bc7ac6",
                        "source_sense_description": "dier dat zijn prooi bejaagt en doodt",
                        "target_lang_word": "beast of prey",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "beast of prey",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b355791f-3cb6-3a67-bb8b-789e9da0cdcf",
                                        "entry_id": "5291a8b1-e81d-35f4-8fc4-fe1cc65e06ef",
                                        "glosses": [
                                            "A carnivorous animal that hunts for its food, especially one that preys on vertebrates."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dc322692-ad1e-3e1e-b239-c21629e932a5",
                                        "entry_id": "5291a8b1-e81d-35f4-8fc4-fe1cc65e06ef",
                                        "glosses": [
                                            "A predatory person, savagely cruel and ruthless in their treatment of others."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0852c6f2-1b49-49be-aaf8-255f080e890f",
                                                "sense_id": "dc322692-ad1e-3e1e-b239-c21629e932a5",
                                                "text": "Much controversy has surrounded Nietzsche’s writings on the “higher” and “lower” types of man. Is he to be taken as glorifying the cruel tyrant, the “beast of prey”, or did he have some less repulsive ideal? The answer seems to be neither an unqualified yes nor an unqualified no."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d1662c21-f937-4fe4-869b-0ee5e212d974",
                        "source_entry_id": "1b1a0769-67ff-3c1d-a22a-fabffcdd93d8",
                        "source_sense_id": "62583611-9b9c-37ad-9d41-a71f49bc7ac6",
                        "source_sense_description": "dier dat zijn prooi bejaagt en doodt",
                        "target_lang_word": "predator",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "predator",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ffc5a83d-49f2-325a-9502-53b3db8b8cfd",
                                        "entry_id": "09014bf5-9efa-383d-96c1-43956d3f2917",
                                        "glosses": [
                                            "Any animal or other organism that hunts and kills other non-plant organisms (their prey), primarily for food."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25718967-dec4-417b-9ad6-91fae49dd803",
                                                "sense_id": "ffc5a83d-49f2-325a-9502-53b3db8b8cfd",
                                                "text": "Hives should be positioned, oriented and protected to avoid predators and ensure survival in the meliponary. A study (pers. obs.) of predators shows that the main culprits in a Malaysian meliponary are frogs and lizards."
                                            },
                                            {
                                                "example_id": "7febb5de-f022-4dab-b43b-ea0564e530e1",
                                                "sense_id": "ffc5a83d-49f2-325a-9502-53b3db8b8cfd",
                                                "text": "So if you're the only thing worth eating in the middle of the ocean, the predator that grabs you will probably have gotten there by a Levy walk."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3169c32-3708-3e1a-91b6-955a24b42852",
                                        "entry_id": "09014bf5-9efa-383d-96c1-43956d3f2917",
                                        "glosses": [
                                            "Someone who attacks and plunders for gain."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "11e1e861-d543-3e80-b434-ef88eacefbdc",
                                        "entry_id": "09014bf5-9efa-383d-96c1-43956d3f2917",
                                        "glosses": [
                                            "A sexual predator."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "edf57d05-1a88-422c-88e0-a6fa4a7ff3c3",
                        "source_entry_id": "1b1a0769-67ff-3c1d-a22a-fabffcdd93d8",
                        "source_sense_id": "62583611-9b9c-37ad-9d41-a71f49bc7ac6",
                        "source_sense_description": "dier dat zijn prooi bejaagt en doodt",
                        "target_lang_word": "carnassier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "carnassier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "46d95981-8170-3a85-8595-c62cf2bc6e26",
                                        "entry_id": "3a45d946-9e07-3f36-8a83-532a83e09fc0",
                                        "glosses": [
                                            "Qui se nourrit de chair crue et qui en est fort avide."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aedcf07e-0ce7-4ea9-b6de-00dca90df3ed",
                                                "sense_id": "46d95981-8170-3a85-8595-c62cf2bc6e26",
                                                "text": "Les corbeaux passent, passent sans cesse, passent, en files interminables et noires, se hâtant vers on ne sait quelles carnassières ripailles, et le vent apporte le tintement triste des clochettes pendues au cou des vaches qui paissent, égaillées, l’herbe avare de la lande…"
                                            },
                                            {
                                                "example_id": "30b8b14b-d0a5-40e3-a352-d0510458e0ee",
                                                "sense_id": "46d95981-8170-3a85-8595-c62cf2bc6e26",
                                                "text": "Comme il s’en revenait du champ le 13 septembre 1759, Joseph Nevoret est éventré et mangé par un loup carnassier à Viriat (Ain) : on était « environ le soleil couchant »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e53d8c24-aa34-35f4-a3f2-6a1e055ea068",
                                        "entry_id": "3a45d946-9e07-3f36-8a83-532a83e09fc0",
                                        "glosses": [
                                            "Bestial, grossier, violent, brutal."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ef785a72-6350-4394-857a-89eca40b2900",
                                                "sense_id": "e53d8c24-aa34-35f4-a3f2-6a1e055ea068",
                                                "text": "Dites donc, domestique !… il me semble que vous pourriez m’annoncer… d’une façon… moins carnassière."
                                            },
                                            {
                                                "example_id": "fffa05f1-8d28-40db-b89a-4fe24d0ca40e",
                                                "sense_id": "e53d8c24-aa34-35f4-a3f2-6a1e055ea068",
                                                "text": "Et brusquement, Alain a ri. Un rire carnassier, immense, presque dément."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "carnassier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b347a447-aff8-3783-affe-beb822b5b3ac",
                                        "entry_id": "cee96edc-7844-3f14-b8cb-fd3aa2ce4ce4",
                                        "glosses": [
                                            "Animal qui se repaît de chair."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ab21579-2e3d-4102-9813-73aece103d2f",
                                                "sense_id": "b347a447-aff8-3783-affe-beb822b5b3ac",
                                                "text": "Au contraire, les ours devaient être assez nombreux […]. Sabine et Mac Nap avaient souvent relevé des traces fraîchement laissées par ces carnassiers."
                                            },
                                            {
                                                "example_id": "76782632-d98f-4dba-8e8d-ce4ac832046c",
                                                "sense_id": "b347a447-aff8-3783-affe-beb822b5b3ac",
                                                "text": "On a inventé des pièges de formes variées dont on se sert pour prendre les rongeurs et les petits carnassiers en les amorçant à l'aide d'appâts appropriés au goût de chaque espèce."
                                            },
                                            {
                                                "example_id": "98c54b18-6900-43f1-af82-0aef7d536191",
                                                "sense_id": "b347a447-aff8-3783-affe-beb822b5b3ac",
                                                "text": "On l’accusait de dîmer les grivières d’autrui, en simulant un rapt de carnassier."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
