                        "glosses": [
                            "aus unabsehbaren Gründen; unnötig"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48594d34-a367-42cc-8fa2-b997d3c95484",
                                "sense_id": "026490c1-a97f-30cf-a95a-df1d59ea13c7",
                                "text": "„Das Jahresgespräch stützt sich unzweckmäßigerweise auf die Vorkommnisse und Ereignisse der letzten 1 bis 2 Monate.“"
                            },
                            {
                                "example_id": "06dc86c3-4535-4414-ac90-0b9302d2110c",
                                "sense_id": "026490c1-a97f-30cf-a95a-df1d59ea13c7",
                                "text": "„Das Kriterium der besonderen Bedeutung bleibt nicht nur vage und damit umgehbar, es knüpft auch unzweckmäßigerweise an die Lage des einbezogenen Unternehmens statt an die des Konzerns an.“"
                            },
                            {
                                "example_id": "c8573e63-7a66-4868-b1cb-377e6fbe4325",
                                "sense_id": "026490c1-a97f-30cf-a95a-df1d59ea13c7",
                                "text": "„Dadurch kann die Temperatur der Kleidung, die im früheren preußischen Heer unzweckmäßigerweise dunkle Farben hatte, leicht auf 45°, ja 50% erhöht werden.“"
                            },
                            {
                                "example_id": "84b66326-719b-4a6a-9ee1-d8573be2c965",
                                "sense_id": "026490c1-a97f-30cf-a95a-df1d59ea13c7",
                                "text": "„Auch habe er unzweckmäßigerweise nicht alsbald nach Abtragung der Wurzelspitzen die Ausräumung des toten Zahnmarkes und dessen Ersatz durch Füllmasse vorgenommen.“"
                            },
                            {
                                "example_id": "d8c02cf2-cca0-4011-a132-77807eb39b84",
                                "sense_id": "026490c1-a97f-30cf-a95a-df1d59ea13c7",
                                "text": "„Die Häuser in der alten Stadt sind unzweckmäßigerweise meist durch Glasfenster geschlossen, nahe aneinander in die Höhe gebaut und mit kupfernen Dächern verjehen.“"
                            }
                        ],
