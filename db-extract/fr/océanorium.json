                "senses": [
                    {
                        "sense_id": "4525c47c-6557-3baa-b031-a4f5dd89eca2",
                        "entry_id": "2ec41618-ac62-35aa-9b0d-f06480060dc6",
                        "glosses": [
                            "Réservoir d’eau de mer naturelle ou reconstituée, de très grande taille, dans lequel on garde des organismes marins."
                        ],
                        "tags": [
                            "Aquariologie"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "37bef3ee-da92-3ab6-8c8f-cb2ee925393c",
                        "entry_id": "2ec41618-ac62-35aa-9b0d-f06480060dc6",
                        "glosses": [
                            "Établissement océanographique, bâtiment ou espace dans lequel une collection d’organismes marins est exposée dans des réservoirs simulant l’océan, spécialement un habitat pélagique."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "114bce6e-3d50-3870-b742-635a3fb12f5a",
                        "entry_id": "2ec41618-ac62-35aa-9b0d-f06480060dc6",
                        "glosses": [
                            "Type de parc spécialisé dans la présentation et l’élevage de mammifères marins."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "386500e5-90d6-4b80-81cb-91cc9e638a6c",
                                "sense_id": "114bce6e-3d50-3870-b742-635a3fb12f5a",
                                "text": "Plus d'un siècle et demi après, l'Américain McBride, conservateur d'un Océanorium de Floride, s'aperçoit que le Tursiops évite aisément les filets à mailles fines, et dans des conditions où la vue semble improbable."
                            },
                            {
                                "example_id": "52f51f5f-f0b6-4207-8dd5-c4cfa86eff22",
                                "sense_id": "114bce6e-3d50-3870-b742-635a3fb12f5a",
                                "text": "C’est à Antibes que se situe le plus grand océanorium d’Europe calqué sur le modèle américain de Miami ou de San Diego."
                            }
                        ]
                    }
                ],
