                "forms": [],
                "senses": [
                    {
                        "sense_id": "26319db8-1200-356e-a3e3-cfb47c20d67b",
                        "entry_id": "c35bedbe-5466-32fd-aa85-6627376a5dca",
                        "glosses": [
                            "русская фамилия"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "42e344d1-3c14-46f3-bba0-130bfa33eed2",
                                "sense_id": "26319db8-1200-356e-a3e3-cfb47c20d67b",
                                "text": "Паша Самарин, кроме всего, был талантливым художником и по моим просьбам рисовал замечательные дружеские шаржи для стенгазеты."
                            },
                            {
                                "example_id": "d22e30a1-4f1d-47dc-9d5b-f1e020d5a14f",
                                "sense_id": "26319db8-1200-356e-a3e3-cfb47c20d67b",
                                "text": "Есть некто Самарин, молодой и богатый аристократ, человек весьма образованный и с замечательными способностями."
                            }
                        ]
                    }
                ],
