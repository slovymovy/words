                "senses": [
                    {
                        "sense_id": "9580ac69-6330-3872-a4e8-757c0850b352",
                        "entry_id": "a28ca1a1-81f5-38f6-9454-0dee663c4e59",
                        "glosses": [
                            "Refroidir par watercooling."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "cb321196-1634-462f-8d24-c43c346b38d9",
                                "sense_id": "9580ac69-6330-3872-a4e8-757c0850b352",
                                "text": "Sinon soit dit en passant, il est bien plus pertinent (mais plus \"délicat\" ) de watercooler un GPU qu’un CPU… un gros GPU gamer chauffe bien plus"
                            },
                            {
                                "example_id": "2adc1428-d54c-4ffc-9761-eecb61ba5628",
                                "sense_id": "9580ac69-6330-3872-a4e8-757c0850b352",
                                "text": "Le projet initial, datant de l’an dernier, était de watercooler ma 1080ti dans mon boitier ITX H200i, le tout pour un prix abordable : je m’étais fixé 100€ pour prouver aux réticents que l’on peut faire ça moins chère qu’un AIO."
                            },
                            {
                                "example_id": "51134120-1374-4c49-bc20-2f4763355d0a",
                                "sense_id": "9580ac69-6330-3872-a4e8-757c0850b352",
                                "text": "Le kit est équipé d’entretoise au format ATX, permettant ainsi d’installer la console watercoolée dans un boitier micro ATX minimum."
                            }
                        ]
                    }
                ],
