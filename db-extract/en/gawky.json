                    {
                        "translation_id": "0e2eaed3-6e6d-449b-9af9-c1bb9c2ea4fe",
                        "source_entry_id": "5aa737cf-b1d1-3f9a-b8d0-061db4d89a5d",
                        "source_sense_description": "awkward, ungainly",
                        "target_lang_word": "maladroit",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "maladroit",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3bc573c9-bd1a-35f3-bff1-2309ae09884e",
                                        "entry_id": "3a158ca7-bab4-3ce1-a241-528844c12566",
                                        "glosses": [
                                            "Qui manque d’adresse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5bc8a0ae-d518-46d9-9d7b-53f2183f7652",
                                                "sense_id": "3bc573c9-bd1a-35f3-bff1-2309ae09884e",
                                                "text": "C’est un ouvrier fort maladroit."
                                            },
                                            {
                                                "example_id": "376682ca-b37e-47ba-9c85-f93fd82899a9",
                                                "sense_id": "3bc573c9-bd1a-35f3-bff1-2309ae09884e",
                                                "text": "Il est maladroit dans tout ce qu’il fait."
                                            },
                                            {
                                                "example_id": "fafe1f3c-6e16-4d45-b5c3-526001625b59",
                                                "sense_id": "3bc573c9-bd1a-35f3-bff1-2309ae09884e",
                                                "text": "Avoir la main maladroite. Substantivement,"
                                            },
                                            {
                                                "example_id": "a8d7386f-2557-46d8-b7d4-1abdec8f6896",
                                                "sense_id": "3bc573c9-bd1a-35f3-bff1-2309ae09884e",
                                                "text": "C’est un grand maladroit."
                                            },
                                            {
                                                "example_id": "1486df39-bf97-4465-acdd-b1b29003839d",
                                                "sense_id": "3bc573c9-bd1a-35f3-bff1-2309ae09884e",
                                                "text": "Vous êtes une maladroite."
                                            },
                                            {
                                                "example_id": "c8b4689b-f0b4-4c98-bc77-6a77bb48f4bf",
                                                "sense_id": "3bc573c9-bd1a-35f3-bff1-2309ae09884e",
                                                "text": "Il faut être bien maladroit pour avoir échoué dans une entreprise si facile."
                                            },
                                            {
                                                "example_id": "7e5e230e-1ce1-47b6-9f52-ded249bf04fe",
                                                "sense_id": "3bc573c9-bd1a-35f3-bff1-2309ae09884e",
                                                "text": "C’est un homme maladroit en affaires."
                                            },
                                            {
                                                "example_id": "7d46efad-097b-4caa-861d-98951a037414",
                                                "sense_id": "3bc573c9-bd1a-35f3-bff1-2309ae09884e",
                                                "text": "Cette démarche est très maladroite."
                                            },
                                            {
                                                "example_id": "fbe8e9a9-2117-4b09-ac13-5045fa679811",
                                                "sense_id": "3bc573c9-bd1a-35f3-bff1-2309ae09884e",
                                                "text": "Cela n’est pas si maladroit."
                                            },
                                            {
                                                "example_id": "c14e66f2-0cbf-4ffa-a14e-5beb22535f6a",
                                                "sense_id": "3bc573c9-bd1a-35f3-bff1-2309ae09884e",
                                                "text": "Yoran, un peu perdu dans ses réflexions, mésestima la distance qui séparait sa main de la gourde d’eau et la renversa d’un geste maladroit."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "maladroit",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5b58ec17-025a-3fef-a96c-9c9ecf3d0c0c",
                                        "entry_id": "d1a40c79-b823-3270-b96a-b8c38f888911",
                                        "glosses": [
                                            "Personne qui manque d’adresse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e003af81-9924-4412-be2d-fbe0ede134f8",
                                                "sense_id": "5b58ec17-025a-3fef-a96c-9c9ecf3d0c0c",
                                                "text": "Le duc de Coigny, premier écuyer, les informe des usages et leur recommande instamment « de ne pas couper la chasse du Roi », crime de lèse-majesté qui peut ruiner une carrière et vous laisser pour la vie la réputation d’un maladroit."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8bceebf4-b86a-4172-ad70-1ece8f511847",
                        "source_entry_id": "5aa737cf-b1d1-3f9a-b8d0-061db4d89a5d",
                        "source_sense_description": "awkward, ungainly",
                        "target_lang_word": "godiche",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "godiche",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8f4147ba-3402-397b-a1ba-b2734fe6a86c",
                                        "entry_id": "23553203-4123-34e5-86c8-335724400ef6",
                                        "glosses": [
                                            "Benêt, maladroit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77ac662b-67fe-41f1-ab7b-1c7c8d324b8d",
                                                "sense_id": "8f4147ba-3402-397b-a1ba-b2734fe6a86c",
                                                "text": "Quant au maître de poste, il espérait bien voir le cheval revenir tout seul. Le voyant arriver monté, il examina de près l’uniforme de Lucien ; rien n’indiquait une chute. « Allons, celui-ci est moins godiche que les autres », se dit Bouchard."
                                            },
                                            {
                                                "example_id": "55d14f52-cff2-4bcf-8bfa-98840435f999",
                                                "sense_id": "8f4147ba-3402-397b-a1ba-b2734fe6a86c",
                                                "text": "Mon cher, ça ne vaut rien d’avoir l’air godiche devant sa femme, le premier soir."
                                            },
                                            {
                                                "example_id": "7b59fa84-66ce-4acf-9bf5-b2b065f50785",
                                                "sense_id": "8f4147ba-3402-397b-a1ba-b2734fe6a86c",
                                                "text": "Dans le massacre des Innocents, les bourreaux dans leurs cottes de mailles ont l’air de bêtes velues avec des têtes de mouton ; et il faut voir l’air godiche des mères, le pêle-mêle et l’entassement de tous ces corps, l’enchevêtrement de l’ignorance et de la fantaisie, les trois chevaux des rois Mages superposés et collés les uns dans les autres, les expressions de grenouilles ahuries."
                                            },
                                            {
                                                "example_id": "f1889701-e17d-4ded-b272-d5cba16daa6c",
                                                "sense_id": "8f4147ba-3402-397b-a1ba-b2734fe6a86c",
                                                "text": "Enfin, il était godiche. Il ne parlait pas — on m’entend.— Il ouvrait la bouche malencontreusement, pour livrer à ses contemporains des réflexions marquées au coin de la naïveté, …."
                                            },
                                            {
                                                "example_id": "0f51184e-2c88-4153-96b9-3a7df5c40ff9",
                                                "sense_id": "8f4147ba-3402-397b-a1ba-b2734fe6a86c",
                                                "text": "Nous sommes trop souvent patauds en français, malhabiles, godiches, déboussolés."
                                            },
                                            {
                                                "example_id": "71d68b85-443d-48c6-b1b2-c2c16afdabda",
                                                "sense_id": "8f4147ba-3402-397b-a1ba-b2734fe6a86c",
                                                "text": "C’est là qu’on mesure soudain l’étendue du désastre… Oui, même si l’on avait très envie d’être coiffé plus court, chaque fois on avait oublié combien la coupe fraîche donne un air godiche."
                                            },
                                            {
                                                "example_id": "2ea3994b-b3bc-4957-93e8-f47e0cd7107c",
                                                "sense_id": "8f4147ba-3402-397b-a1ba-b2734fe6a86c",
                                                "text": "En passant à la hâte devant le Sincère, je bute sur ses pieds et je me rattrape à la main de Caleb. Mon pantalon est trop long, et j’ai toujours été un peu godiche."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "godiche",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "db182b68-c06f-36d8-86d9-4608293da87c",
                                        "entry_id": "b7360bdf-98ed-3f7f-8fbe-3e7c53b402ae",
                                        "glosses": [
                                            "Celui ou celle qui est d’une gaucherie ridicule."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7254ef6a-4bc8-443d-b6d8-cbdd8f269a6e",
                                                "sense_id": "db182b68-c06f-36d8-86d9-4608293da87c",
                                                "text": "Cette godiche a fait des erreurs."
                                            },
                                            {
                                                "example_id": "4cabe2cc-e276-4f05-8ae6-b436d17c68a7",
                                                "sense_id": "db182b68-c06f-36d8-86d9-4608293da87c",
                                                "text": "Dans un coin, des jeunes gens qu’elle avait éconduits, ricanaient : dame ! si ce godiche ne tenait pas à ce qu’elle en eût, elle avait raison de le garder, car on en connaissait d’autres qui, malgré son argent, auraient bien sûr attendu qu’il lui en poussât, pour voir à l’épouser."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
