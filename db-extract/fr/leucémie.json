                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "bb3debe6-c755-4607-8054-60ab57bd9042",
                        "entry_id": "d3312869-84d9-3bfe-bdd8-079f3cda90bd",
                        "tags": [
                            "plural"
                        ],
                        "form": "leucémies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "cd6c494f-28cc-3afe-9811-a0cc5027b0b6",
                        "entry_id": "d3312869-84d9-3bfe-bdd8-079f3cda90bd",
                        "glosses": [
                            "Cancer des cellules de la moelle osseuse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53351500-a682-4492-a9a3-e5d0006ae102",
                                "sense_id": "cd6c494f-28cc-3afe-9811-a0cc5027b0b6",
                                "text": "Ces diagnostics de leucémie font passer l’équipe médicale par des moments particulièrement difficiles."
                            },
                            {
                                "example_id": "cce1a25d-10fd-497e-b3e7-38672a6c5c9d",
                                "sense_id": "cd6c494f-28cc-3afe-9811-a0cc5027b0b6",
                                "text": "Le don de sang permet de soigner de nombreuses maladies et de nombreux cancers tels que leucémies, lymphomes, myélomes…"
                            },
                            {
                                "example_id": "6aa2ae51-531f-4786-97bd-f4a3aa258971",
                                "sense_id": "cd6c494f-28cc-3afe-9811-a0cc5027b0b6",
                                "text": "Eux qui ont cru au progrès de la science et à ses mots (produits « phytosanitaires », « glyphosate »), découvrent dans leur chambre d’hôpital l’autre nom du projet productiviste : leucémie, tumeur cérébrale, cancer du sang, mélanome, blastes, troubles cognitifs, moelle osseuse détruite…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4d9a3fa5-5d43-4344-83cb-0506a185c71b",
                        "source_entry_id": "d3312869-84d9-3bfe-bdd8-079f3cda90bd",
                        "source_sense_id": "cd6c494f-28cc-3afe-9811-a0cc5027b0b6",
                        "target_lang_word": "Leukämie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Leukämie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e30f5fc3-d904-3d38-8ee4-6e5f2d9aee56",
                                        "entry_id": "d93060fc-b586-321c-9c75-4598cb60bf1a",
                                        "glosses": [
                                            "eine Erkrankung des blutbildenden Systems"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fbabdb93-32d4-4ce9-a2c1-6954f16e4839",
                                                "sense_id": "e30f5fc3-d904-3d38-8ee4-6e5f2d9aee56",
                                                "text": "Petra leidet an Leukämie."
                                            },
                                            {
                                                "example_id": "20c5e2d4-995f-42ff-86ac-ed0d1b0826a9",
                                                "sense_id": "e30f5fc3-d904-3d38-8ee4-6e5f2d9aee56",
                                                "text": "„Der Bezirksleiter betonte immer, es gebe keinen Anlass zur Sorge, und verstarb bald an Leukämie.“"
                                            },
                                            {
                                                "example_id": "c69bd6e4-d1b4-4a51-b26f-b9e613fcefec",
                                                "sense_id": "e30f5fc3-d904-3d38-8ee4-6e5f2d9aee56",
                                                "text": "„Rainer Maria Rilke starb 1926 im Alter von 51 Jahren an Leukämie.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "370aa9dc-efd4-4ed8-9f1f-b54130b8648f",
                        "source_entry_id": "d3312869-84d9-3bfe-bdd8-079f3cda90bd",
                        "source_sense_id": "cd6c494f-28cc-3afe-9811-a0cc5027b0b6",
                        "target_lang_word": "leukemia",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "leukemia",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eda8edde-1a64-31ef-befd-b50de8cf4b42",
                                        "entry_id": "87f998d0-c97f-3cb1-82fe-855b26b1294b",
                                        "glosses": [
                                            "Any of a class of types of cancer affecting the blood cells, especially the white blood cells (usually with massive leukocytosis), and the blood cell–forming (hematopoietic) tissues."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c5030419-0b13-4f1d-8dc1-b0d0068262ea",
                                                "sense_id": "eda8edde-1a64-31ef-befd-b50de8cf4b42",
                                                "text": "The subjects suffered from lymphoblastic and myeloid leukemias."
                                            },
                                            {
                                                "example_id": "40c2a22f-7358-424d-a0b7-c9af8052cd66",
                                                "sense_id": "eda8edde-1a64-31ef-befd-b50de8cf4b42",
                                                "text": "In an era when political leaders promise deliverance from decline through America’s purported preeminence in scientific research, the news that science is in deep trouble in the United States has been as unwelcome as a diagnosis of leukemia following the loss of health insurance."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "02d27e37-979d-4f39-b119-881cdda01178",
                        "source_entry_id": "d3312869-84d9-3bfe-bdd8-079f3cda90bd",
                        "source_sense_id": "cd6c494f-28cc-3afe-9811-a0cc5027b0b6",
