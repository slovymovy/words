                    {
                        "translation_id": "69c43688-866c-4a47-aca4-45d02060976a",
                        "source_entry_id": "dad2d677-22c2-3118-80b0-13eef4b813e2",
                        "source_sense_id": "11004b80-4eff-301a-8e76-c95ce4db8584",
                        "source_sense_description": "Militär: Vorrichtung zum Starten von Raketenwaffen",
                        "target_lang_word": "lance-roquettes",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lance-roquettes",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4a653b59-413c-3f2d-9a53-27bebacddc85",
                                        "entry_id": "b4975499-9bb9-335f-a4ce-834fc89cae8d",
                                        "glosses": [
                                            "Variante, dans l’orthographe traditionnelle, de lance-roquette."
                                        ],
                                        "tags": [
                                            "orthographe rectifiée de 1990"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "70fa5c80-5026-4e3f-b6e1-0ff26ec497a2",
                                                "sense_id": "4a653b59-413c-3f2d-9a53-27bebacddc85",
                                                "text": "Le commandant fit alors appel à la division et réclama un lance-roquettes à infra-rouges."
                                            },
                                            {
                                                "example_id": "7c2d6181-e72e-4e62-bedb-3c518ae44971",
                                                "sense_id": "4a653b59-413c-3f2d-9a53-27bebacddc85",
                                                "text": "Mais la guerre mondiale qui se déroulait alors sanctionnait sans appel les jugements erronés, si bien que le lance-roquettes, introduit en 1945, fut très vite estimé à sa juste valeur : il dopait le moral des fantassins qu’on avait vu fuir à l’approche des blindés"
                                            },
                                            {
                                                "example_id": "e9bcb651-cb3d-4b4b-bd35-c7957587ceda",
                                                "sense_id": "4a653b59-413c-3f2d-9a53-27bebacddc85",
                                                "text": "Cette aide, d’un montant de 400 millions de dollars, comprend quatre systèmes de lance-roquettes multiple Himars et des munitions, qui ont déjà permis aux forces ukrainiennes d’attaquer des cibles avec des missiles tirés hors de portée de l’artillerie russe, a précisé un haut responsable du Pentagone."
                                            }
                                        ]
                                    }
                                ]
                            },
