                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "199f0511-ee1e-4d8f-8402-9b94423e6632",
                        "entry_id": "3252dfdb-fc1f-303c-ae59-1f8e030003ca",
                        "tags": [
                            "plural"
                        ],
                        "form": "carpools"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c059d090-f097-30a0-9a29-6ca91ac3c6c5",
                        "entry_id": "3252dfdb-fc1f-303c-ae59-1f8e030003ca",
                        "glosses": [
                            "An arrangement whereby several people travel together in the same car in order to save costs, reduce pollution etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ce69d9f-c878-4d79-9be1-3fa8149257d9",
                                "sense_id": "c059d090-f097-30a0-9a29-6ca91ac3c6c5",
                                "text": "The neighbors decided on a carpool to get their kids to school, so that they wouldn't each have to drive every day."
                            }
                        ]
                    },
                    {
                        "sense_id": "768f9244-1f4b-3241-bfa5-b3f2322456c7",
                        "entry_id": "3252dfdb-fc1f-303c-ae59-1f8e030003ca",
                        "glosses": [
                            "The group of people who participate in such a pool."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a3d3cc6f-7ed3-401a-b30a-5b5b938a9cd5",
                        "source_entry_id": "3252dfdb-fc1f-303c-ae59-1f8e030003ca",
                        "source_sense_description": "arrangement",
                        "target_lang_word": "spolujízda",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spolujízda",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "62b02c1a-bd25-3c37-ab69-931489a6651c",
                                        "entry_id": "a9c7def3-831b-31a2-bc6a-5a8a5e51c60e",
                                        "glosses": [
                                            "společná cesta více osob automobilem s přispěním na náklady na jízdu"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a74b558-eea6-47f7-af71-b9c46aa355c1",
                                                "sense_id": "62b02c1a-bd25-3c37-ab69-931489a6651c",
                                                "text": "Řidiči cestu podniknou tak jako tak, mohou však prostřednictvím spolujízdy snížit svoje náklady nabráním dalšího člověka, který se na jejich proplacení bude podílet."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "06fa7a4f-4867-4192-99a1-b57531b6c132",
                        "source_entry_id": "3252dfdb-fc1f-303c-ae59-1f8e030003ca",
                        "source_sense_description": "arrangement",
                        "target_lang_word": "covoiturage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "covoiturage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d42d577e-6a78-3593-9504-58c6ead0421c",
                                        "entry_id": "3020be47-2179-376f-a8dc-dd6d706ed7f0",
                                        "glosses": [
                                            "Utilisation en commun d’une voiture particulière."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd4c3ab8-2b83-42d9-99da-ffab286adf32",
                                                "sense_id": "d42d577e-6a78-3593-9504-58c6ead0421c",
                                                "text": "Le covoiturage permet de partager un trajet régulier domicile-travail, généralement de courte distance, entre personnes dont le domicile est proche."
                                            },
                                            {
                                                "example_id": "81b6c861-ceb6-49c9-8df3-1270ca5ba551",
                                                "sense_id": "d42d577e-6a78-3593-9504-58c6ead0421c",
                                                "text": "L’exploitation de cette seconde vague d’enquêtes permettra de tirer des enseignements plus robustes sur ce qui freine ou motive le covoiturage domicile-travail ainsi que sur sa pratique, et de mobiliser les services de l’État en faveur de cette solution de mobilité afin de réduire l’autosolisme encore largement dominant aujourd’hui."
                                            },
                                            {
                                                "example_id": "86dd4bae-ae58-47f9-ac2c-2c05fc56e3da",
                                                "sense_id": "d42d577e-6a78-3593-9504-58c6ead0421c",
                                                "text": "De plus, l’exécutif veut encourager le covoiturage, notamment pour un « bonus », au montant non annoncé, pour tout nouveau covoitureur inscrit sur une plateforme, à partir du 1ᵉʳ janvier 2023."
                                            },
                                            {
                                                "example_id": "42593bd1-92a3-4712-9edc-a22aba87d12c",
                                                "sense_id": "d42d577e-6a78-3593-9504-58c6ead0421c",
                                                "text": "La voie de gauche, elle, sera totalement réservée au covoiturage."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
