                                "sense_id": "f457360f-a5f9-3c49-9084-020a26e22d31",
                                "text": "Du bist das Himmelbett für Tauben / Und ständig auf Koks / Hast im Schrebergarten deine Laube"
                            },
                            {
                                "example_id": "75f46760-2805-4a45-ab53-857f6200d014",
                                "sense_id": "f457360f-a5f9-3c49-9084-020a26e22d31",
                                "text": "Drüben auf dem Hügel möchte ich warten / Im nassen Gras in unserem Schrebergarten"
                            },
                            {
                                "example_id": "aa6d6ca4-7129-4233-821b-9425b08e34ba",
                                "sense_id": "f457360f-a5f9-3c49-9084-020a26e22d31",
                                "text": "Andere wollen Süßholz raspeln mit nix auf dem Kasten / Außer Schrebergärten mit deutscher Fahne am Masten [sic]"
                            }
                        ]
