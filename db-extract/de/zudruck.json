                "senses": [
                    {
                        "sense_id": "95ebdd8b-dd05-3c56-9ce1-b01964f4014b",
                        "entry_id": "6f9dc947-269c-3191-b62b-dadcec91e2c5",
                        "glosses": [
                            "auf einem Briefumschlag, einer Postkarte oder einem Briefmarkenbogen auf der linken Seite aufgedruckte Zusatzinformation"
                        ],
                        "tags": [
                            "Postwesen",
                            "Philatelie"
                        ],
                        "examples": [
                            {
                                "example_id": "d17b3228-8532-4da3-8244-2fb47fdc4bcc",
                                "sense_id": "95ebdd8b-dd05-3c56-9ce1-b01964f4014b",
                                "text": "„Der Zudruck ist ebenso interessant wie amüsant.“"
                            },
                            {
                                "example_id": "32674b6b-e3e0-4b5f-9be4-833c4e4b5102",
                                "sense_id": "95ebdd8b-dd05-3c56-9ce1-b01964f4014b",
                                "text": "„In manchen Ländern und zu manchen Zeiten konnte dieser Zudruck bereits in der Wertzeichendruckerei bestellt werden; dies ändert aber nichts daran, dass es sich hierbei nicht um spezielle Ausgaben handelt.“"
                            },
                            {
                                "example_id": "6ca3d727-1cd9-46be-bc51-7d41c91bb697",
                                "sense_id": "95ebdd8b-dd05-3c56-9ce1-b01964f4014b",
                                "text": "„Der soeben (Februar 2010) neu erschienene Titel des Berliner Ganzsacher-Sammler-Vereines von 1901. e.V. katalogisiert die Zudruckganzsachen der Ausgaben von Berlin (West). Der Band versteht sich als erstes \"Manuskript\", da den Autoren naturgemäß nicht alle verausgabten bzw. gedruckten Zudrucke vorliegen und auf die weitere Mitarbeit der Sammler angewiesen sind - daher wird sicherlich in den nächsten Jahren eine überarbeitete und erweiterte Auflage erscheinen.“"
                            },
                            {
                                "example_id": "f4c5ad55-36d5-47a1-836a-4cd484174937",
                                "sense_id": "95ebdd8b-dd05-3c56-9ce1-b01964f4014b",
                                "text": "„Der ursprüngliche Wert des Bogens musste für die interne Abrechnung 'korrigiert' werden. Dies geschah mittels eines Zudruckes, der den neuen Bogenwert angibt: Der \"korrigierte Bogenwertzudruck\", manchmal auch \"korrigierter Bogenwertzähler\" genannt!“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
