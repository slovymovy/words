        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fa0178ea-df0d-3528-82af-4f19ce2ba6fa",
                    "sense_definition": "To prefer or choose someone or something because you like them better.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "verb_prefer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "These seaside resorts are mostly <w>favoured</w> by families looking for a quiet holiday.",
                            "target_lang_translations": {
                                "ru": "Эти морские курорты в основном <w>предпочитают</w> семьи, ищущие спокойного отдыха.",
                                "zh": "这些海滨度假村主要受到想过安静假期的家庭<w>偏爱</w>。"
                            }
                        },
                        {
                            "text": "He generally <w>favours</w> dark chocolate over milk chocolate for dessert.",
                            "target_lang_translations": {
                                "ru": "На десерт он обычно <w>предпочитает</w> темный шоколад молочному.",
                                "zh": "在甜点上，他通常更<w>偏爱</w>黑巧克力而不是牛奶巧克力。"
                            }
                        }
                    ],
                    "synonyms": [
                        "prefer",
                        "choose",
                        "lean toward",
                        "opt for"
                    ],
                    "antonyms": [
                        "reject",
                        "dislike"
                    ],
                    "common_phrases": [
                        "favour one over another",
                        "highly favoured"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "British spelling"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Предоставлять несправедливое преимущество кому-либо или чему-либо.",
                        "zh": "指因为更喜欢而选择某人或某物，或给予某人或某物不公平的优待。",
                        "nl": "Iemand of iets de voorkeur geven, of iemand op een oneerlijke manier bevoordelen.",
                        "pl": "Preferowanie kogoś lub czegoś, lub zapewnianie komuś niesprawiedliwej przewagi.",
                        "de": "Jemanden oder etwas bevorzugen, weil man es lieber mag, oder jemandem einen unfairen Vorteil verschaffen.",
                        "fr": "Préférer ou choisir quelqu'un ou quelque chose par goût, ou accorder un avantage injuste à quelqu'un ou quelque chose.",
                        "it": "Preferire o scegliere qualcuno o qualcosa, oppure dare un vantaggio ingiusto a qualcuno o qualcosa.",
                        "cs": "Dávat někomu nebo něčemu přednost, nebo někoho neoprávněně zvýhodňovat.",
                        "tr": "Birini veya bir şeyi daha çok sevdiği için tercih etmek ya da birine haksız bir avantaj sağlamak.",
                        "es": "Dar una ventaja injusta a alguien o algo."
                    },
