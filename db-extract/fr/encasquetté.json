                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6513771-fdb5-4fca-85d4-0289878e00c8",
                                "sense_id": "6de8d4cc-c16a-31e2-be13-1a946b62cfd7",
                                "text": "Belle leçon de politesse, A ce dadais encasquetté, Au crâne couleur de fesses, Cacheur de poils en rareté."
                            },
                            {
                                "example_id": "6b1da503-41b6-4414-a3c8-ffb94ee701e7",
                                "sense_id": "6de8d4cc-c16a-31e2-be13-1a946b62cfd7",
                                "text": "Seul bémol de notre visite l’attitude un peu rude et malpolie d’un grand énergumène encasquetté, qui semblait faire partie des employés, et qui nous a rabroué pour laisser notre place à une personne qui ne pouvait vraisemblablement pas se tenir debout et que nous n’avions pas vu arriver..."
                            }
                        ]
                    }
