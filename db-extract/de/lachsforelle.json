                "senses": [
                    {
                        "sense_id": "59625e7e-510a-3b6e-b98e-4d6bd9302460",
                        "entry_id": "40a05d5f-8666-3e49-bf65-5d2f4c01c128",
                        "glosses": [
                            "Forelle mit lachsfarbenem Fleisch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d64759c7-54f2-41d9-abf6-3c8bbd561391",
                                "sense_id": "59625e7e-510a-3b6e-b98e-4d6bd9302460",
                                "text": "„Als eine Lachsforelle aufgetragen wurde, lächelte er ein wenig, erklärte in ciceronianischem Latein, es wäre wohl hoffärtig, sie nicht zu essen, weil sie nur ein Fisch sei, und schmückte seinen Sophismus recht hübsch aus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
