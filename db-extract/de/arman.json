                                "target_senses": [
                                    {
                                        "sense_id": "42b27d31-feac-359e-985a-627ec2b8058c",
                                        "entry_id": "b15c5a49-886a-3b70-a894-13af32e2961d",
                                        "glosses": [
                                            "Nom de famille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b699ff62-94e6-437b-9add-f2305718d219",
                                                "sense_id": "42b27d31-feac-359e-985a-627ec2b8058c",
                                                "text": "L’architecte choisi pour construire cette première gare à Saint-Cloud est Alfred Armand (1805-1888), ancien élève de l'école des beaux-arts, disciple des architectes Jean-Louis Provost et Achille Leclère."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Armand",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2b124c6b-98c6-34bf-ae49-8e686ed7a7a1",
                                        "entry_id": "296b774e-4891-37fd-8151-45ad19eebde1",
                                        "glosses": [
                                            "Prénom masculin français."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ed233b5-0362-4d70-bcca-d838f65a95a1",
                                                "sense_id": "2b124c6b-98c6-34bf-ae49-8e686ed7a7a1",
                                                "text": "Je suis si favorisée dans mon métier de nourrice que je sèvrerai notre Armand en décembre."
                                            },
                                            {
                                                "example_id": "a992f0de-9106-46c9-a6d5-96193264b9e5",
                                                "sense_id": "2b124c6b-98c6-34bf-ae49-8e686ed7a7a1",
                                                "text": "Tu es indépendant, je suis libre, nous sommes jeunes, au nom du Ciel, Armand, ne me rejette pas dans la vie que j’étais forcée de mener autrefois. »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
