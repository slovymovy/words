                        "entry_id": "40b93d9d-c26c-367f-a0e0-cb1739eb1458",
                        "glosses": [
                            "Zustand und/oder Eigenschaft, in einem bestimmten Zusammenhang richtig zu sein, für einen bestimmten Fall genau passend zu sein, einer bestimmten Situation angemessen zu sein; Angemessenheit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fce68696-54e1-4c28-bba2-5caa8a438b1d",
                                "sense_id": "b07dc242-3e97-38b8-b4c2-c16374ef4ba9",
                                "text": "„Das Urteil über die Angebrachtheit spezifischer institutioneller Festlegungen hängt daher weitgehend von deren konkreter historischer Bewährung ab.“"
                            },
                            {
                                "example_id": "98d61c08-957b-43c2-a78f-301bc2ca6abc",
                                "sense_id": "b07dc242-3e97-38b8-b4c2-c16374ef4ba9",
                                "text": "„Die Angebrachtheit dieser Forderung kann und soll hier lediglich an einigen Beispielen illustriert werden.“"
                            },
                            {
                                "example_id": "2d7f3b1d-47c3-41be-a4b2-9e919ef17f94",
                                "sense_id": "b07dc242-3e97-38b8-b4c2-c16374ef4ba9",
                                "text": "„Der obligatorische Charakter der Moral darf nicht mit der Angebrachtheit kooperativen Verhaltens verwechselt werden.“"
                            },
                            {
                                "example_id": "728fff62-ea6c-488d-b526-2b38df4a09d3",
                                "sense_id": "b07dc242-3e97-38b8-b4c2-c16374ef4ba9",
                                "text": "„Die Angebrachtheit des Verhaltens kann dabei idealerweise soweit gehen, dass der Expatriate Vorbildfunktion im Entsendungsland erfüllt.“"
                            }
                        ],
