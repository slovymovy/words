                                                "sense_id": "c25ef28f-0e8e-36e0-9160-bb5a0befe0bb",
                                                "text": "He has a high chess rating."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ecbae473-883a-3147-b611-56ee0d7d483f",
                                        "entry_id": "a9451cb9-b153-3103-b799-55dc7f4adc49",
                                        "glosses": [
                                            "A quantitative measure of the audience of a television program."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7defb149-4247-4c61-9542-215d13c3c1bf",
                                                "sense_id": "ecbae473-883a-3147-b611-56ee0d7d483f",
                                                "text": "A rating, at best, is an indication of how many people saw what you gave them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "512578c8-b0f1-3e35-a4b8-93ab785448d7",
                                        "entry_id": "a9451cb9-b153-3103-b799-55dc7f4adc49",
                                        "glosses": [
                                            "A seaman in a warship."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80b73dca-d7f5-4e0c-8f02-59cc43f67a84",
                                                "sense_id": "512578c8-b0f1-3e35-a4b8-93ab785448d7",
                                                "text": "Some 400 Russian ratings are living in the western French port, awaiting delivery of their controversial new command-and-control ship, the Vladivostok."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94ca7e70-d7e5-311e-9c48-f635699a7c1a",
