                    "frequency": "Low",
                    "semantic_group_id": "readiness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The city improved its disaster <w>preparedness</w> by installing new warning sirens.",
                            "target_lang_translations": {
                                "de": "Die Stadt verbesserte ihre Katastrophen<w>vorsorge</w> durch die Installation neuer Warnsirenen."
                            }
                        },
                        {
                            "text": "Effective emergency <w>preparedness</w> can save many lives during a flood.",
                            "target_lang_translations": {
