                ],
                "senses": [
                    {
                        "sense_id": "6c0e5f6d-1cb8-3bd1-8704-390390e1bea1",
                        "entry_id": "2385fe5f-bf01-31e8-a033-87c3e432769e",
                        "glosses": [
                            "die Geschwindigkeit, mit der ein Material unter Krafteinwirkung deformiert wird"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "64296b8a-0c67-43dd-8a08-154eae742a80",
                                "sense_id": "6c0e5f6d-1cb8-3bd1-8704-390390e1bea1",
                                "text": "Die Deformationsgeschwindigkeit ist in der Betrachtung der rheologischen Eigenschaften von entscheidender Bedeutung."
                            },
                            {
                                "example_id": "9aaf407d-d2c9-439d-848a-9c66562eea84",
                                "sense_id": "6c0e5f6d-1cb8-3bd1-8704-390390e1bea1",
                                "text": "„Viskose Fluide übertragen jedoch Verzerrungsänderungen (Deformationsgeschwindigkeiten), d.h. sie zeigen ein geschwindigkeitsabhängiges (viskoses) Materialverhalten.“"
                            },
                            {
                                "example_id": "76980518-cb22-49d4-8567-b6858424fadc",
                                "sense_id": "6c0e5f6d-1cb8-3bd1-8704-390390e1bea1",
                                "text": "„Die Berechnung der Kristallisation basiert auf Gleichungen aus der Thermodynamik der irreversible Prozesse; hierbei werden Deformationsgeschwindigkeit und Temperatur berücksichtigt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
