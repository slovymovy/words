                    }
                ],
                "translations": [
                    {
                        "translation_id": "f8a00f70-f0b1-41df-b4e8-b16d3df20cf1",
                        "source_entry_id": "50784e62-f951-3128-b861-d5597adaf413",
                        "source_sense_id": "c2b22f13-a4bd-389a-854b-653592a013d3",
                        "target_lang_word": "céder",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "céder",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "51666c39-7a80-337d-9cc6-22e4f388e19f",
                                        "entry_id": "330b51a1-665f-36bc-bbec-7fb1a116a207",
                                        "glosses": [
                                            "Laisser, abandonner une chose à quelqu’un."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cff751a5-7010-42a5-be65-7ee0ae7f77c2",
                                                "sense_id": "51666c39-7a80-337d-9cc6-22e4f388e19f",
                                                "text": "Il a cédé sa place dans le bus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "50914c3b-2350-39a1-833b-198344278a46",
                                        "entry_id": "330b51a1-665f-36bc-bbec-7fb1a116a207",
                                        "glosses": [
                                            "Transférer la propriété d'une chose, à une autre personne, lui en donner la propriété."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77202635-a600-4be5-9bcd-0550a7a2c227",
                                                "sense_id": "50914c3b-2350-39a1-833b-198344278a46",
                                                "text": "Après la guerre, le traité de Versailles avait alors contraint l’Allemagne à céder ses colonies aux nations vainqueurs."
                                            },
                                            {
                                                "example_id": "984f35af-731b-42df-b438-89621e2dd95a",
                                                "sense_id": "50914c3b-2350-39a1-833b-198344278a46",
                                                "text": "Il a cédé son magasin, son fonds, son étude. Céder un bail. Il cède sa voiture à bon prix."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce388f47-5e8c-33b0-800a-96f08d3e0cae",
                                        "entry_id": "330b51a1-665f-36bc-bbec-7fb1a116a207",
                                        "glosses": [
                                            "Ne pouvoir résister ou ne plus résister à l’action de telle ou telle force, en parlant des choses matérielles."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1e9d579a-6b0c-4773-81f8-b2a546369512",
                                                "sense_id": "ce388f47-5e8c-33b0-800a-96f08d3e0cae",
                                                "text": "[…] je me dispose à le réparer lorsqu'un coup de vent arrive si furieux et si sec que l'étai de foc et la bastaque bâbord, cèdent en même temps."
                                            },
                                            {
                                                "example_id": "0850896c-ac93-4716-80f4-ca7417b21fd6",
                                                "sense_id": "ce388f47-5e8c-33b0-800a-96f08d3e0cae",
                                                "text": "Dans le choc très brutal de l’amerrissage, un croisillonnage céda et l'extrémité de l’aile gauche baignait dans l'écume."
                                            },
                                            {
                                                "example_id": "7e34ff56-a99a-45cb-92bf-116a6c8b4cfa",
                                                "sense_id": "ce388f47-5e8c-33b0-800a-96f08d3e0cae",
                                                "text": "Puis il remarqua que le coin de la moquette rebiquait légèrement. Il s’agenouilla, tira et la moquette céda facilement."
                                            },
                                            {
                                                "example_id": "97debe78-5933-4022-8886-0e83d6b9dc87",
                                                "sense_id": "ce388f47-5e8c-33b0-800a-96f08d3e0cae",
                                                "text": "La porte de la rue céda. Trois matelots entrèrent en saluant."
                                            },
                                            {
                                                "example_id": "86155496-1a95-452d-9131-78ed70a1863d",
                                                "sense_id": "ce388f47-5e8c-33b0-800a-96f08d3e0cae",
                                                "text": "L’aile gauche de l’armée commençait à céder."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5418b12f-72f5-3052-838b-ab743f4a8678",
                                        "entry_id": "330b51a1-665f-36bc-bbec-7fb1a116a207",
                                        "glosses": [
                                            "Se soumettre, ne plus résister, accepter, tant au sens physique qu’au sens moral."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6055769d-7071-4397-ad81-e30f881ac686",
                                                "sense_id": "5418b12f-72f5-3052-838b-ab743f4a8678",
                                                "text": "Les moines et les prêtres surprirent le pauvre homme, le jetèrent en prison, et le firent conduire à Vienne en Dauphiné, où résidait l’archevêque. Rénier préféra être brûlé vif, plutôt que de rien céder."
                                            },
                                            {
                                                "example_id": "e3d69179-96ae-4438-9c05-ea3d34d69d7d",
                                                "sense_id": "5418b12f-72f5-3052-838b-ab743f4a8678",
                                                "text": "— Reviens, reviens, criaient les camarades ; reviens vite ! Lebrac, aux trois quarts enlisé, céda à leurs appels et voulut tourner bride."
                                            },
                                            {
                                                "example_id": "3e11584b-eddb-4904-b57d-6bfbe96a1783",
                                                "sense_id": "5418b12f-72f5-3052-838b-ab743f4a8678",
                                                "text": "Les jeunes filles croiraient qu’elles ont cédé tout entières en vous disant bonjour quand bonsoir leur passe par la tête."
                                            },
                                            {
                                                "example_id": "e00fd5d4-6d02-4d6f-96be-29e81c162ad7",
                                                "sense_id": "5418b12f-72f5-3052-838b-ab743f4a8678",
                                                "text": "Couché tout de suite après l'avoir quittée, je dus cette nuit-là céder presque aussitôt au sommeil."
                                            },
                                            {
                                                "example_id": "70841727-df13-46de-bf7b-9f1c4c7a3696",
                                                "sense_id": "5418b12f-72f5-3052-838b-ab743f4a8678",
                                                "text": "David, lui, dormirait, cette nuit, dans son lit étroit mais confortable et par là même céderait si peu que ce fût à la sensualité."
                                            },
                                            {
                                                "example_id": "6c95682a-c8ab-48b5-84da-a916fbc3048f",
                                                "sense_id": "5418b12f-72f5-3052-838b-ab743f4a8678",
                                                "text": "Un soir, attendant l'heure du dîner, Claire et Marcelle, cédant je suppose à une prière générale, jouèrent quelques morceaux ensemble, la pianiste accompagnant sa sœur violoniste."
                                            },
                                            {
                                                "example_id": "9c760db3-0d9d-4b63-9b00-6304965d08f1",
                                                "sense_id": "5418b12f-72f5-3052-838b-ab743f4a8678",
                                                "text": "Pour supporter cette anxiété, nous inventons des mythologies personnelles ou collectives. Plutôt que de céder à la panique, nous construisons des mondes. C’est le moment. Il ne durera peut-être pas."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
