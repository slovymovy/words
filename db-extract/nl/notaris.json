                "senses": [
                    {
                        "sense_id": "bf36762d-7fe9-3d25-9765-364b8a2f1421",
                        "entry_id": "88f6808e-d028-3fdc-8393-9d569ffd7465",
                        "glosses": [
                            "jurist die bevoegd is om authentieke akten op te maken, te bewaren en uit te geven"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "fe82e178-6d75-4b28-ad16-a42320756283",
                                "sense_id": "bf36762d-7fe9-3d25-9765-364b8a2f1421",
                                "text": "Gesprekken tussen Struis en de gemeente Deventer hebben de afgelopen weken niets opgeleverd. Volgens Struis’ advocaat Rob Dommerholt schendt de gemeente eerdere afspraken met Struis, die bij een notaris zijn vastgelegd."
                            },
                            {
                                "example_id": "e5eb43b7-acea-4834-ac9f-358d3657d8a0",
                                "sense_id": "bf36762d-7fe9-3d25-9765-364b8a2f1421",
                                "text": "Joods vastgoed met hulp notarissen onteigend"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3953031c-16e0-48ef-b189-3055a0c0ff67",
                        "source_entry_id": "88f6808e-d028-3fdc-8393-9d569ffd7465",
                        "source_sense_id": "bf36762d-7fe9-3d25-9765-364b8a2f1421",
                        "source_sense_description": "jurist die bevoegd is om authentieke akten op te maken",
                        "target_lang_word": "Notar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Notar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2aa1d7ff-4bad-38f9-acca-6a93ec5bdde5",
                                        "entry_id": "fd1b688e-d70e-32fe-ae18-57bfd5f510a5",
                                        "glosses": [
                                            "unparteiischer Jurist, der Rechtsgeschäfte beurkundet und Unterschriften beglaubigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f318fabe-cb40-43b1-9a29-d4f6302c9c6a",
                                                "sense_id": "2aa1d7ff-4bad-38f9-acca-6a93ec5bdde5",
                                                "text": "Den Kaufvertrag für das Haus unterschreibt der Käufer beim Notar."
                                            },
                                            {
                                                "example_id": "ac66e5f9-214e-4471-b65c-50f200c7e5be",
                                                "sense_id": "2aa1d7ff-4bad-38f9-acca-6a93ec5bdde5",
                                                "text": "Tante Erna hat ihr Testament beim Notar hinterlegt."
                                            },
                                            {
                                                "example_id": "64c3c12a-d1ef-4cfe-9bed-dcf66bf29189",
                                                "sense_id": "2aa1d7ff-4bad-38f9-acca-6a93ec5bdde5",
                                                "text": "„Das Guinness Buch der Rekorde wird den von einem Notar beglaubigten Weltrekordversuch aus Bremerhaven nun prüfen.“"
                                            },
                                            {
                                                "example_id": "9d8ebb7f-3400-4796-92dd-0275657be1ef",
                                                "sense_id": "2aa1d7ff-4bad-38f9-acca-6a93ec5bdde5",
                                                "text": "„Ein reicher Notar aus Nantes kaufte alles auf und vermietete das Café wieder an meine Großmutter.“"
                                            },
                                            {
                                                "example_id": "6640babb-43ec-42ee-81dd-9c3cdea0f04a",
                                                "sense_id": "2aa1d7ff-4bad-38f9-acca-6a93ec5bdde5",
                                                "text": "„Zum mindesten mußte man einen Notar zu Rate ziehen.“"
                                            },
                                            {
                                                "example_id": "d7c8ffe0-ee21-4c42-adcd-d2360807c9a5",
                                                "sense_id": "2aa1d7ff-4bad-38f9-acca-6a93ec5bdde5",
                                                "text": "„Bei den Notaren und Grundbuchämtern Ostpreußens herrschte Hochbetrieb.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c5e14cd5-d145-4bce-9e0e-2bca51b59f41",
                        "source_entry_id": "88f6808e-d028-3fdc-8393-9d569ffd7465",
                        "source_sense_id": "bf36762d-7fe9-3d25-9765-364b8a2f1421",
                        "source_sense_description": "jurist die bevoegd is om authentieke akten op te maken",
                        "target_lang_word": "notary",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "notary",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "48cac314-135a-34b2-8d61-e92ce417edf9",
                                        "entry_id": "398a9b29-f0a0-3326-921f-78575c66ebe2",
                                        "glosses": [
                                            "A lawyer of noncontentious private civil law who drafts, takes, and records legal instruments for private parties, and provides legal advice, but does not appear in court on his or her clients' behalf."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0c8714e-b641-42bb-925e-91acc22b95a4",
                                                "sense_id": "48cac314-135a-34b2-8d61-e92ce417edf9",
                                                "text": "Originally an official of the medieval European ecclesiastical courts, the notary developed into a noncontentious secular legal professional in France. In England, partly because the canon and secular laws were not on speaking terms, \"the notarial system never took deep root.\" For one thing, an important aspect of the notary’s duties, his authority to \"authenticate\" documents, was of little use to the English. The whole notion of a state-sanctioned authenticator of private acts was entirely foreign to English common law; whereas in France we see notaries \"making\" and \"passing\" contracts, the common law left that to the parties."
                                            },
                                            {
                                                "example_id": "7763f74f-6dc0-4948-a230-6816bf038612",
                                                "sense_id": "48cac314-135a-34b2-8d61-e92ce417edf9",
                                                "text": "Unlike the United States, where a notary public is often a clerk you find working in a bank or real estate office, a Mexican notary has a higher ranking than an ordinary attorney who is not a notary. (In Mexico all notaries are attorneys, but not all attorneys are notaries.)"
                                            },
                                            {
                                                "example_id": "7d12fd4e-8d24-413c-8279-ec71127cfc31",
                                                "sense_id": "48cac314-135a-34b2-8d61-e92ce417edf9",
                                                "text": "Although advocates sometimes get involved in drafting instruments, notaries continue to do most of this work in civil law nations."
                                            },
                                            {
                                                "example_id": "53cf9148-8784-4268-9f04-312f5822c946",
                                                "sense_id": "48cac314-135a-34b2-8d61-e92ce417edf9",
                                                "text": "It is not known whether any Puebla residents did go to the capital to bid for properties in their state because in such cases the purchases would have been formalized before a notary in Mexico City, [...]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d489dd0f-b345-325e-8c74-f575a8970624",
                                        "entry_id": "398a9b29-f0a0-3326-921f-78575c66ebe2",
                                        "glosses": [
                                            "A public notary, a legal practitioner who prepares, attests to, and certifies documents, witnesses affidavits, and administers oaths."
                                        ],
                                        "tags": [
                                            "common"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0610bed2-5309-3563-9329-d632bcc9c9f0",
                                        "entry_id": "398a9b29-f0a0-3326-921f-78575c66ebe2",
                                        "glosses": [
                                            "A notary public, a public officer who serves as an impartial witness to the signing of important documents, but who is not authorised to practise law."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e0ec654-5ad8-48ef-8b3d-8e8caa19793c",
                                                "sense_id": "0610bed2-5309-3563-9329-d632bcc9c9f0",
                                                "text": "The giving of legal advice by notaries and others who are not admitted to practice law is, in its opinion, dangerous to the welfare of the community, because such persons have not demonstrated their capacity [...]"
                                            },
                                            {
                                                "example_id": "c477c752-fa4d-4a0e-8e88-bebb8930be20",
                                                "sense_id": "0610bed2-5309-3563-9329-d632bcc9c9f0",
                                                "text": "Although signed by a notary in New York, it lacked a physical description or documentation. It could have been issued to anyone, or resold to anyone willing to change his name."
                                            },
                                            {
                                                "example_id": "ee66008a-ef28-409b-b19f-1b01a14042ef",
                                                "sense_id": "0610bed2-5309-3563-9329-d632bcc9c9f0",
                                                "text": "\"In 1961, there was a case Torcaso v. Watkins, in which a public notary in Maryland refused to take the oath, “so help me God,” and the court said he wasn't required to acknowledge God [although] the Maryland law said you were.\""
                                            },
                                            {
                                                "example_id": "f51f67ed-eb01-44d9-bfb0-853b1c3b83d8",
                                                "sense_id": "0610bed2-5309-3563-9329-d632bcc9c9f0",
                                                "text": "This was completely unofficial, of course, since a notary in Vermont can only swear in people who plan to be working in Vermont, and they might as well have stayed in bed, but for a public relations ploy you couldn't beat it, […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6633b979-af60-4053-b353-b5cd464aeb18",
                        "source_entry_id": "88f6808e-d028-3fdc-8393-9d569ffd7465",
                        "source_sense_id": "bf36762d-7fe9-3d25-9765-364b8a2f1421",
                        "source_sense_description": "jurist die bevoegd is om authentieke akten op te maken",
                        "target_lang_word": "notaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "notaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d8b062f6-409b-32e4-88c8-23a0710ba91d",
                                        "entry_id": "7ee3feec-d557-3c73-ad88-c2809034ea23",
                                        "glosses": [
                                            "Officier ministériel qui reçoit ou rédige les contrats, les obligations, les transactions et les autres actes volontaires et leur confère l’authenticité."
                                        ],
                                        "tags": [
                                            "Droit civil"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5affa547-7374-40d8-aafe-27e546079ac6",
                                                "sense_id": "d8b062f6-409b-32e4-88c8-23a0710ba91d",
                                                "text": "Le notaire certifiant que les testatrices ont voulu faire une disposition en sa faveur, il n’y a de prouvé que sa faute ; et sa responsabilité en est la conséquence. Si les testatrices devaient savoir qu’elles étaient ses créancières, devait-il ignorer qu’il était leur débiteur ?"
                                            },
                                            {
                                                "example_id": "ac56a686-4148-4d26-b0df-162441edb837",
                                                "sense_id": "d8b062f6-409b-32e4-88c8-23a0710ba91d",
                                                "text": "Ce notaire n’était pas le petit notaire de Sterne, mais un gros et gras notaire de Paris, un de ces hommes estimables qui font une sottise avec mesure, mettent lourdement le pied sur une plaie inconnue, et demandent pourquoi l'on se plaint."
                                            },
                                            {
                                                "example_id": "19a468c3-8520-4b71-b00b-77fccb94342b",
                                                "sense_id": "d8b062f6-409b-32e4-88c8-23a0710ba91d",
                                                "text": "Pour 20 Minutes, Thierry Delesalle, président de la commission Conjoncture immobilière des notaires du Grand Paris, et Michel Platero, président de la Fnaim du Grand Paris, tentent d’éclairer un peu la situation de l’immobilier dans la capitale."
                                            },
                                            {
                                                "example_id": "752342e6-b19d-412e-9dee-052808645927",
                                                "sense_id": "d8b062f6-409b-32e4-88c8-23a0710ba91d",
                                                "text": "Lui, le père Henrouille, il avait été petit clerc chez un notaire au boulevard Sébastopol pendant cinquante ans. Aussi, en connaissait-il des histoires de dilapidations de fortunes !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "02af33cb-9e5a-3614-8444-f486c0d09233",
                                        "entry_id": "7ee3feec-d557-3c73-ad88-c2809034ea23",
                                        "glosses": [
                                            "Épouse d’un notaire."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "72008111-7cf3-497e-82e4-8d1c428b725c",
                                                "sense_id": "02af33cb-9e5a-3614-8444-f486c0d09233",
                                                "text": "Elles enrageront bien davantage, quand elles vous entendront dire : adieu, monsieur le commissaire ; adieu, ma cousine, la notaire, la procureuse ; messieurs les bourgeois, doucereux robins, mauvais plaisants du quartier ; adieu le Marais, l'île Saint-Louis, maisons où l'on va, de porte en porte, s'ennuyer ou faire un quadrille."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
