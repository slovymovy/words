                ],
                "senses": [
                    {
                        "sense_id": "0e58df47-9bdf-3da6-847c-d4f3134bd2c6",
                        "entry_id": "4f26663b-360a-34a9-b9ff-3067e43ffa2f",
                        "glosses": [
                            "Cellui qui est témoin oculaire d’un événement, d’une action, de quoi que ce soit."
                        ],
                        "tags": [
                            "Variations diaéthiques"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "f538eff0-fd44-37df-b977-0ee5ca0c297a",
                        "entry_id": "4f26663b-360a-34a9-b9ff-3067e43ffa2f",
                        "glosses": [
                            "Cellui qui assiste à un spectacle, à une représentation théâtrale, à un évènement sportif, à quelque exercice, à quelque grande cérémonie ou réjouissance publique."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d0a804bb-3eb4-4259-8874-16844ce1674f",
                        "source_entry_id": "4f26663b-360a-34a9-b9ff-3067e43ffa2f",
                        "source_sense_id": "0e58df47-9bdf-3da6-847c-d4f3134bd2c6",
                        "source_sense_description": "Qui est témoin oculaire (sens général)",
                        "target_lang_word": "spectator",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spectator",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0f730e29-3f0f-3406-86bc-07dc39652b40",
                                        "entry_id": "e5cfde1e-618c-3cd1-af5c-7248bd8a941a",
                                        "glosses": [
                                            "One who watches an event; especially, an event held outdoors."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f280f02-d3c9-42b8-84bd-1b8e20d45fe6",
                                                "sense_id": "0f730e29-3f0f-3406-86bc-07dc39652b40",
                                                "text": "The cheering spectators watched the fireworks."
                                            },
                                            {
                                                "example_id": "5afc0e61-20f3-4c3c-a38e-738a23592965",
                                                "sense_id": "0f730e29-3f0f-3406-86bc-07dc39652b40",
                                                "text": "Bart spies an opportunity to make a quick buck so he channels his inner carny and posits his sinking house as a natural wonder of the world and its inhabitants as freaks, barking to dazzled spectators, “Behold the horrors of the Slanty Shanty! See the twisted creatures that dwell within! Meet Cue-Ball, the man with no hair!”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8068c67a-9cfd-38d8-aa8d-f521a4239ee7",
                                        "entry_id": "e5cfde1e-618c-3cd1-af5c-7248bd8a941a",
                                        "glosses": [
                                            "One who observes, sees, or views something; an observer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52d82f65-6963-4698-bd82-9187a40da04f",
                                                "sense_id": "8068c67a-9cfd-38d8-aa8d-f521a4239ee7",
                                                "text": "The ſpring diſplaying her elegant taſte, the proud walk of the gold-feathered pheaſant, the light tread of the ſmall-hoofed hind, and the dancing of the ſtar-trained peacock, infuſed joy into the ſoul of the ſpectator of the aſtoniſhing works of the Creator."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "427bf1fd-2759-4f26-a48a-194bce6ba06b",
                        "source_entry_id": "4f26663b-360a-34a9-b9ff-3067e43ffa2f",
                        "source_sense_id": "0e58df47-9bdf-3da6-847c-d4f3134bd2c6",
                        "source_sense_description": "Qui est témoin oculaire (sens général)",
                        "target_lang_word": "viewer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "viewer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b024bc9d-9156-388e-b2a7-914492b041b4",
                                        "entry_id": "a09b5aba-4dab-33e4-8f11-3b5c041410a2",
                                        "glosses": [
                                            "Someone who views a spectacle; an onlooker or spectator."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "385a8322-b99c-49a6-9af6-8d7bda1c01e1",
                                                "sense_id": "b024bc9d-9156-388e-b2a7-914492b041b4",
                                                "text": "This sensation of an object becoming alive is a characteristic that, I believe, seizes all viewers of a van Gogh. The Bible goes beyond being a simple still-life object to become a living thing, an expression of strength, an existence that emanates from itself, beyond the painting surface to participate in our very lives."
                                            },
                                            {
                                                "example_id": "a218811e-597f-4721-a8da-6f46585ade64",
                                                "sense_id": "b024bc9d-9156-388e-b2a7-914492b041b4",
                                                "text": "It’s clear why enterprising people make the videos, but what compels so many viewers to watch an amateur video of some stranger they don’t know opening a box? What would compel a viewer to subscribe to the all-coffee channel and binge-watch a guy unpacking coffee makers?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e53b867d-288b-302b-9e78-bb3ab761946f",
                                        "entry_id": "a09b5aba-4dab-33e4-8f11-3b5c041410a2",
                                        "glosses": [
                                            "Someone who watches television."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c4d36650-7ecc-371c-9d54-8a4f768ae9db",
                                        "entry_id": "a09b5aba-4dab-33e4-8f11-3b5c041410a2",
                                        "glosses": [
                                            "Any optical device used to view photographic slides."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ee936be1-c245-320a-961e-fb3599c83a34",
                                        "entry_id": "a09b5aba-4dab-33e4-8f11-3b5c041410a2",
                                        "glosses": [
                                            "A program that displays the contents of a file."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "aa3778d0-8ed2-31f6-997e-ff4cc3979832",
                                        "entry_id": "a09b5aba-4dab-33e4-8f11-3b5c041410a2",
                                        "glosses": [
                                            "An appointed inspector or examiner"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "570fe3fb-3836-3bd7-b210-c855259c1de2",
                                        "entry_id": "a09b5aba-4dab-33e4-8f11-3b5c041410a2",
                                        "glosses": [
                                            "An appointed inspector or examiner:",
                                            "The manager of a colliery, who directs its workings and ventilation."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "76ebeecd-4fb6-4f65-b39f-04891c9dcf9d",
                        "source_entry_id": "4f26663b-360a-34a9-b9ff-3067e43ffa2f",
                        "source_sense_id": "0e58df47-9bdf-3da6-847c-d4f3134bd2c6",
                        "source_sense_description": "Qui est témoin oculaire (sens général)",
                        "target_lang_word": "bystander",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bystander",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5be8d1f7-a510-35a6-930f-b217ffdc0629",
                                        "entry_id": "910b5bdf-b91d-3262-9d11-e03267682f37",
                                        "glosses": [
                                            "A person who, although present at some event, does not take part in it; an observer, witness, or spectator."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40961ee1-6333-4bd4-abce-b7999c9e4c28",
                                                "sense_id": "5be8d1f7-a510-35a6-930f-b217ffdc0629",
                                                "text": "If he wins, he will be at liberty, perhaps, to give vent to a laugh, or to pass a remark on the circumstance to a bystander, or to stake again, or to double his stake; but, even this he must do solely out of curiosity, and for the pleasure of watching the play of chances and of calculations, and not because of any vulgar desire to win."
                                            },
                                            {
                                                "example_id": "216f44e9-6760-40a9-9742-49d02c17a2fe",
                                                "sense_id": "5be8d1f7-a510-35a6-930f-b217ffdc0629",
                                                "text": "Conservative influencer Nick Sortor is handcuffed Thursday night by a police officer outside an ICE facility in Portland, Oregon, a bystander video shows; the video does not show events leading up to the arrest."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2ec0cc0a-7383-4224-9ab6-3676d385e6c4",
                        "source_entry_id": "4f26663b-360a-34a9-b9ff-3067e43ffa2f",
                        "source_sense_id": "0e58df47-9bdf-3da6-847c-d4f3134bd2c6",
                        "source_sense_description": "Qui est témoin oculaire (sens général)",
                        "target_lang_word": "onlooker",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "onlooker",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eee8cb74-e4e3-3ba3-92c3-a2e70d8f23f7",
                                        "entry_id": "c467616c-7b61-32cd-8da6-7d4a258a313b",
                                        "glosses": [
                                            "A spectator; someone looks on or watches, without becoming involved or participating."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d641ad28-474d-44bd-a50c-f4c18285e8ad",
                                                "sense_id": "eee8cb74-e4e3-3ba3-92c3-a2e70d8f23f7",
                                                "text": "I wasn’t involved in the fight; I was only an onlooker."
                                            },
                                            {
                                                "example_id": "e366a5ae-69d3-426e-93ff-51acaa5196e0",
                                                "sense_id": "eee8cb74-e4e3-3ba3-92c3-a2e70d8f23f7",
                                                "text": "When the right-away was given, Driver Gibson would give a sonorous blast on Cardean's deep-toned hooter, and amid a flurry of swirling steam the train would move majestically out, with nearly half the city of Carlisle—or so it would appear—as onlookers on the platform."
                                            },
                                            {
                                                "example_id": "75a66cc0-3ee5-4b94-af99-b161fc96b076",
                                                "sense_id": "eee8cb74-e4e3-3ba3-92c3-a2e70d8f23f7",
                                                "text": "As a result, while the train was being shunted at Bombay, the buffers became locked, producing a situation most intriguing for the onlookers, but exasperating for the exalted passengers and the unhappy railway authorities."
                                            },
                                            {
                                                "example_id": "2c382c57-be74-4bb2-b66e-57af6757c974",
                                                "sense_id": "eee8cb74-e4e3-3ba3-92c3-a2e70d8f23f7",
                                                "text": "Please allow me to adjust my pants\nSo that I may dance the good time dance\nAnd put the onlookers and innocent bystanders into a trance"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
