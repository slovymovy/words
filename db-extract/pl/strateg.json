                    },
                    {
                        "translation_id": "8c6d7ced-a0e8-4842-a38d-bc82a957ae0e",
                        "source_entry_id": "9446d534-3636-3b1c-a438-3371f86c9de0",
                        "source_sense_id": "b6e70c10-39f8-3493-ba9f-de7c0d9f2ce9",
