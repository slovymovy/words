                                    {
                                        "sense_id": "4ce0902b-d386-34f7-95ae-d70fc95ab3df",
                                        "entry_id": "04418173-44f0-3fbe-a771-c869c0c1f08f",
                                        "glosses": [
                                            "The act of vibrating or the condition of being vibrated."
