                "senses": [
                    {
                        "sense_id": "f006513e-1dc5-3d17-9f86-07399d38e5de",
                        "entry_id": "d0199cd6-145f-34da-8c58-0345b7dba6a0",
                        "glosses": [
                            "излучать блеск; блестя, появляться время от времени"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2da57756-9057-4ed0-a222-1b1d576ea31c",
                                "sense_id": "f006513e-1dc5-3d17-9f86-07399d38e5de",
                                "text": "Красным огнём взблескивали лезвия шашек, и после каждого удара на поле падала маленькая серая фигурка, как падает трава под косою в сенокос…"
                            },
                            {
                                "example_id": "ea54398a-9a13-4503-a03a-4035eb80f74e",
                                "sense_id": "f006513e-1dc5-3d17-9f86-07399d38e5de",
                                "text": "В туче взблескивали молнии, сжатые поля озарялись на миг бледным светом и опять становились серыми, слабо погромыхивал запоздалый гром…"
                            }
                        ]
                    }
