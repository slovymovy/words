                            {
                                "target_lang_word": "passion",
                                "target_lang_sense_clarification": "strong emotion"
                            },
                            {
                                "target_lang_word": "heat",
                                "target_lang_sense_clarification": "intensity of feeling"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Eifer",
                                "target_lang_sense_clarification": "großer Enthusiasmus"
                            },
                            {
                                "target_lang_word": "Leidenschaft",
                                "target_lang_sense_clarification": "starkes emotionales Engagement"
                            }
