                "senses": [
                    {
                        "sense_id": "42820e05-b868-3160-91d2-30d8274d7373",
                        "entry_id": "18b4c18d-b40b-392b-b1f4-71cf1a798581",
                        "glosses": [
                            "Entraînement d'un sportif ou d'une équipe sportive."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "7d1c9973-ea21-3706-afab-aa07200788a8",
                        "entry_id": "18b4c18d-b40b-392b-b1f4-71cf1a798581",
                        "glosses": [
                            "Gestion des entrées et des sorties des joueurs d'une équipe pendant un match."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "75ebde93-33f6-45e3-8f79-9baf94e4d067",
                                "sense_id": "7d1c9973-ea21-3706-afab-aa07200788a8",
                                "text": "« Guy Novès repensait aussi à son coaching : \"Peut-être que les joueurs qui sont entrés en jeu ne sont pas rentrés suffisamment motivés pour finir le travail fait par leurs copains en première partie.\" »"
                            }
                        ]
                    },
                    {
                        "sense_id": "400d3a8d-3695-37e1-bae6-7c78f5d836a9",
                        "entry_id": "18b4c18d-b40b-392b-b1f4-71cf1a798581",
                        "glosses": [
                            "Mentorat, tutorat, accompagnement ou entraînement personnel (activité de conseil professionnel ou personnel) ; guidance (psychologique)."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "92691349-f7ce-48f9-8790-46b8a8421165",
                                "sense_id": "400d3a8d-3695-37e1-bae6-7c78f5d836a9",
                                "text": "Nous avons tout d'abord proposé des séances de coaching ayurvédiques, qui permettent de déterminer quels types de pratiques seront les plus adaptées aux besoins du patient."
                            },
                            {
                                "example_id": "489274cb-a050-43cb-83c0-5e200dafa738",
                                "sense_id": "400d3a8d-3695-37e1-bae6-7c78f5d836a9",
                                "text": "On recommencera tout à zéro, dans un monde enfin débarrassé de la finance, des religions, de Monsanto, d'Aréva, d'Universal, de Mac Donald, des sept frangines pétrolières, du coaching pour tout et portnawak, de la téléréalité, des exodes aoûtiens et du curling discipline olympique !"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4cf58d83-c93f-4c52-a4ef-d178f92d59c4",
                        "source_entry_id": "18b4c18d-b40b-392b-b1f4-71cf1a798581",
                        "target_lang_word": "Coaching",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
