                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ec36f5b1-b6d1-3312-bdef-e0872ed98049",
                                        "entry_id": "e5a9a27c-8f8a-3778-bf0b-9cdc1d9d7a1c",
                                        "glosses": [
                                            "pflanzliches Keimgut mit künstlichen Reizen (Temperatur, Licht) so behandeln, dass es keimfähig wird oder zu keimen beginnt"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "47ee0357-6fc2-426c-b7e6-4efb9ef7568c",
                                                "sense_id": "ec36f5b1-b6d1-3312-bdef-e0872ed98049",
                                                "text": "Die bianuellen Pflanzen kann man nicht bereits im Samen- oder Keimlingszustand vernalisieren."
                                            },
                                            {
                                                "example_id": "10b47aaf-0e6b-4f77-bdec-2fd825fd1494",
                                                "sense_id": "ec36f5b1-b6d1-3312-bdef-e0872ed98049",
                                                "text": "Unser Wintergetreide kommt wesentlich schneller zum Blühen, wenn die jungen Pflanzen vernalisiert werden; aber auch ohne Vernalisation tritt schließlich die Blütenbildung ein, nur in unserem Klima zu spät."
                                            },
                                            {
                                                "example_id": "5d26d14d-15b1-49ca-a92d-a8ea8bee6fcc",
                                                "sense_id": "ec36f5b1-b6d1-3312-bdef-e0872ed98049",
                                                "text": "Beim Winter-Roggen muss der Embryo vernalisiert werden, der schon 5 Tage nach der Befruchtung der Eizelle auf Kältebehandlung anspricht."
                                            },
                                            {
                                                "example_id": "56af4b6b-2fa1-4198-867a-32f43a783c8d",
                                                "sense_id": "ec36f5b1-b6d1-3312-bdef-e0872ed98049",
                                                "text": "Im Frühling oder Sommer neu gebildete Ausläufer dieser Pflanze sind daher zunächst nicht blühfähig und werden erst im nachfolgenden Winter vernalisiert."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
