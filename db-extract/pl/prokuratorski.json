                                        "entry_id": "f2386668-7eba-3a86-b900-9fa1202a35ce",
                                        "glosses": [
                                            "связанный, соотносящийся по значению с существительным прокурор"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13da985b-537d-4962-9daa-3a38b0cde60b",
                                                "sense_id": "56abcb2b-6829-3860-bb7f-b18738508c0c",
                                                "text": "Мы обязательно будем осуществлять прокурорский надзор и в судах, и на стадии исполнения судебных решений."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "610f55f7-90c9-327a-a8b1-2e7364791da3",
                                        "entry_id": "f2386668-7eba-3a86-b900-9fa1202a35ce",
                                        "glosses": [
                                            "перен. строгий, серьёзный, требовательный"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38a4a778-fa52-410b-902d-c6429bfc49f1",
                                                "sense_id": "610f55f7-90c9-327a-a8b1-2e7364791da3",
                                                "text": "Опять этот прокурорский тон, подразумевающий океан не затронутых тем."
                                            }
                                        ]
                                    }
                                ]
