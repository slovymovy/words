                                    {
                                        "sense_id": "05cb2986-3a27-3311-b642-04075f3bc8a6",
                                        "entry_id": "518a2362-a402-3e1c-8bd1-c14b29e10c2b",
                                        "glosses": [
                                            "A unit of measurement of angle equal to ¹⁄₃₆₀ of a circle's circumference."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "840fb9ce-63d8-4257-88d6-93c346dee8a5",
                                                "sense_id": "05cb2986-3a27-3311-b642-04075f3bc8a6",
                                                "text": "A right angle is a ninety-degree angle."
                                            },
                                            {
                                                "example_id": "ad7df00e-5085-4307-86ab-2ceae7d796bd",
                                                "sense_id": "05cb2986-3a27-3311-b642-04075f3bc8a6",
                                                "text": "Most humans have a field of vision of almost 180 degrees."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "168ccebe-8e0a-3596-9c60-e79b739c600a",
                                        "entry_id": "518a2362-a402-3e1c-8bd1-c14b29e10c2b",
                                        "glosses": [
                                            "A unit of measurement of temperature on any of several scales, such as Celsius or Fahrenheit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8523e9f-6288-432a-80d7-a268d184baad",
                                                "sense_id": "168ccebe-8e0a-3596-9c60-e79b739c600a",
                                                "text": "212 degrees Fahrenheit is equal to 100 degrees Celsius."
                                            },
                                            {
                                                "example_id": "f34ad090-7036-46e2-a57f-1c6be1c11ff5",
                                                "sense_id": "168ccebe-8e0a-3596-9c60-e79b739c600a",
                                                "text": "Water boils at 100 degrees Celsius."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec66d5e8-2142-3c1f-9f87-fe0fcf474881",
                                        "entry_id": "518a2362-a402-3e1c-8bd1-c14b29e10c2b",
                                        "glosses": [
                                            "The sum of the exponents of a term; the order of a polynomial."
