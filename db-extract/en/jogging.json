                        "examples": [
                            {
                                "example_id": "876427cb-98ef-4b7a-8dc2-bf27543935ee",
                                "sense_id": "cb704281-ecfb-30cb-9123-3b1caf1018fb",
                                "text": "His jogging of my memory helped me recall what happened that day."
                            }
                        ]
                    },
                    {
                        "sense_id": "08e95f34-8d53-3d03-9f0d-2fd972b72838",
                        "entry_id": "bc21a05e-bfb4-3d68-8ef9-019f9a5594b9",
                        "glosses": [
                            "The practice of running at a relatively slow pace for exercise."
                        ],
