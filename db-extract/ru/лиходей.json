                                        "glosses": [
                                            "ktoś czyniący zło, popełniający przestępstwa, człowiek zbrodniczy"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6f194d3-f3a7-445f-bfbc-d5ec0de2a017",
                                                "sense_id": "645e0dbc-e29a-3a2a-9b9f-11701064a0dd",
                                                "text": "Razem z Nim ukrzyżowali dwóch złoczyńców, jednego po prawej, drugiego po lewej Jego stronie"
                                            }
