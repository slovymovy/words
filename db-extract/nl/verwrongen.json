                        ],
                        "examples": [
                            {
                                "example_id": "4d797ee8-3fb4-4c5c-bbec-22610e3c6be7",
                                "sense_id": "029d136e-ae0c-306b-a9c3-c5eed2a99cb5",
                                "text": "Poetin heeft het vliegtuig gekaapt, en alle inzittenden zijn overgeleverd aan wat hem wordt ingegeven door zijn verwrongen wereldbeeld."
                            },
                            {
                                "example_id": "17fbd8fe-946a-44b1-bec6-04bf398366fd",
                                "sense_id": "029d136e-ae0c-306b-a9c3-c5eed2a99cb5",
                                "text": "Het moge duidelijk zijn dat de EU niet mee mag gaan in de verwrongen logica waarin slachtoffers het aan zichzelf te wijten hebben en daders worden neergezet als slachtoffers. Niet alleen de toekomst van Oekraïne staat hier op het spel, maar ook die van het internationale recht en de meest basale morele principes."
                            }
                        ]
