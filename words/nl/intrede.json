                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "advent",
                                "target_lang_sense_clarification": "arrival of an important period, season, or invention"
                            },
                            {
                                "target_lang_word": "onset",
                                "target_lang_sense_clarification": "start or beginning of a season or condition"
                            },
                            {
                                "target_lang_word": "beginning",
                                "target_lang_sense_clarification": "commencement of a period or state"
                            },
                            {
                                "target_lang_word": "commencement",
                                "target_lang_sense_clarification": "formal start or beginning"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6bf2058b-4a8d-35e9-a6b6-f4e433ced3e9",
                    "sense_definition": "Het officieel aanvaarden van een ambt of functie, met name door een predikant of bestuurder.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "ambtsaanvaarding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De nieuwe dominee hield tijdens zijn officiële <w>intrede</w> een inspirerende toespraak voor de hele gemeente.",
                            "target_lang_translations": {
                                "en": "The new pastor gave an inspiring address to the whole congregation during his official <w>induction</w>."
                            }
                        },
                        {
                            "text": "Tijdens haar <w>intrede</w> in het ambt beloofde de burgemeester zich in te zetten voor alle inwoners.",
                            "target_lang_translations": {
                                "en": "During her <w>inauguration</w> into office, the mayor promised to commit herself to all residents."
                            }
                        }
                    ],
                    "common_phrases": [
                        "zijn intrede doen"
                    ],
                    "target_lang_definitions": {
                        "en": "The official assumption or taking up of an office or position, especially by a minister, pastor, or official."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "inauguration",
                                "target_lang_sense_clarification": "formal ceremony of taking office"
                            },
                            {
                                "target_lang_word": "investiture",
                                "target_lang_sense_clarification": "formal installation in office"
                            },
                            {
                                "target_lang_word": "accession",
                                "target_lang_sense_clarification": "taking up an official post or dignity"
                            },
                            {
                                "target_lang_word": "induction",
                                "target_lang_sense_clarification": "formal entry into office or ministry"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "88c2652e-e279-3b9a-817e-2f26f43004f0",
                    "sense_definition": "Een feestelijke of ceremoniële binnenkomst van een hoogwaardigheidsbekleder in een stad.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "begin_of_binnenkomst",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De feestelijke <w>intrede</w> van de pas gekroonde koning trok duizenden toeschouwers naar het centrum.",
                            "target_lang_translations": {
                                "en": "The festive <w>state entry</w> of the newly crowned king drew thousands of spectators to the city centre."
                            }
                        },
                        {
                            "text": "De historische <w>intrede</w> van de vorst werd herdacht met een groots straatfeest.",
                            "target_lang_translations": {
                                "en": "The monarch's historic <w>royal entry</w> was commemorated with a grand street party."
                            }
                        }
                    ],
                    "common_phrases": [
