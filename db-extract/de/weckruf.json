                "senses": [
                    {
                        "sense_id": "9ccfd656-8598-394c-bd8c-a2a7c57155d2",
                        "entry_id": "e6bca250-e2c6-326e-b5bd-9f1b85420bd8",
                        "glosses": [
                            "Ruf, der dazu dient, jemanden (häufig Soldaten) aufzuwecken; auch: ein Telefonanruf zum selben Zweck"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78d77a81-cc45-4610-bc62-dd0e3dd91f83",
                                "sense_id": "9ccfd656-8598-394c-bd8c-a2a7c57155d2",
                                "text": "Mit seinem Weckruf hat der Spieß die ganze Kompanie hochgeschreckt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "26c54853-e0ab-37f2-a507-1bb29f72fc43",
                        "entry_id": "e6bca250-e2c6-326e-b5bd-9f1b85420bd8",
                        "glosses": [
                            "eine Mahnung, die jemanden/eine Gemeinschaft aufrütteln soll, etwas zu tun/zu verändern"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "94754459-0582-4c98-9a75-9eff2b7cd47e",
                                "sense_id": "26c54853-e0ab-37f2-a507-1bb29f72fc43",
                                "text": "Nach der neuen Wahlschlappe für die CDU dringt die Schwesterpartei CSU auf eine rasche Kurskorrektur in der Flüchtlingspolitik. Man dürfe diesen \"Weckruf\" nicht überhören, schallt es aus Bayern."
                            },
                            {
                                "example_id": "cc5a3d93-957a-4e75-b268-f0589cbc22c1",
                                "sense_id": "26c54853-e0ab-37f2-a507-1bb29f72fc43",
                                "text": "Der Brexit sei ein Weckruf gewesen. Europa müsse umsteuern und die Nöte der Bürger ernst nehmen, bevor es zu spät sei."
                            },
                            {
                                "example_id": "ba3dca1e-3215-40cb-946f-1a17321f47e7",
                                "sense_id": "26c54853-e0ab-37f2-a507-1bb29f72fc43",
                                "text": "Nach der 2:0-Führung ließen die Bayern es etwas ruhiger angehen. Erst ein Lattenschuß der Konkurrenz wurde zum Weckruf, der Levandowski schnell das 3:0 machen ließ."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f0458875-0856-46a6-af8b-501b6b18e1e5",
                        "source_entry_id": "e6bca250-e2c6-326e-b5bd-9f1b85420bd8",
                        "source_sense_id": "9ccfd656-8598-394c-bd8c-a2a7c57155d2",
                        "source_sense_description": "Ruf, der dazu dient, jemanden (häufig Soldaten) aufzuwecken; auch: ein Telefonanruf zum selben Zweck",
                        "target_lang_word": "alarm call",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "11a608e8-3442-4cf7-9b8f-89cf4bc45bb9",
                        "source_entry_id": "e6bca250-e2c6-326e-b5bd-9f1b85420bd8",
                        "source_sense_id": "9ccfd656-8598-394c-bd8c-a2a7c57155d2",
                        "source_sense_description": "Ruf, der dazu dient, jemanden (häufig Soldaten) aufzuwecken; auch: ein Telefonanruf zum selben Zweck",
                        "target_lang_word": "wake-up call",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wake-up call",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c7cfb423-48c1-3365-a2a6-ffce8b5df02e",
                                        "entry_id": "20479ad3-a45a-3c59-b56e-e365223f415c",
                                        "glosses": [
                                            "A telephone call to awaken someone at a certain time, especially one requested by the person while staying at a hotel."
                                        ],
                                        "tags": [
                                            "literally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e37aaa85-14dd-4809-a73e-bcc0f9fab6db",
                                                "sense_id": "c7cfb423-48c1-3365-a2a6-ffce8b5df02e",
                                                "text": "She requested a five a.m. wake-up call from the front desk."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d70e3bc-4959-3e02-845c-f3b1eedb4b36",
                                        "entry_id": "20479ad3-a45a-3c59-b56e-e365223f415c",
                                        "glosses": [
                                            "An alert, reminder, or call to action caused by a dramatic event."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "480bdc17-5fd9-435f-b433-dddb5351945e",
                                                "sense_id": "1d70e3bc-4959-3e02-845c-f3b1eedb4b36",
                                                "text": "The recent deaths should serve as a wake-up call to others at risk."
                                            },
                                            {
                                                "example_id": "23eadb21-67c9-4723-a6f4-d60c5062134a",
                                                "sense_id": "1d70e3bc-4959-3e02-845c-f3b1eedb4b36",
                                                "text": "Youth violence represents an insistent, angry wake-up call to every parent, every teacher, every religious leader, every student."
                                            },
                                            {
                                                "example_id": "f9554b4e-d780-4d68-96f3-97b4232b4367",
                                                "sense_id": "1d70e3bc-4959-3e02-845c-f3b1eedb4b36",
                                                "text": "\"I will never forget the seven people who lost their lives and those who were injured, which was a real wake-up call to those of us involved in public transport and operating tram networks around the world. […].\""
                                            },
                                            {
                                                "example_id": "02036297-8b23-44ad-88c9-9d5be586c548",
                                                "sense_id": "1d70e3bc-4959-3e02-845c-f3b1eedb4b36",
                                                "text": "Instead, we must find an unworthy substitute for the defeat of a foe in that small grin we quickly suppress when we learn that a beheadphoned texter got hit by a car—no, not seriously injured, just bruised up enough to give him a wake-up call."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b63e10fe-2cbb-4b2f-be7d-1a278bda8d50",
                        "source_entry_id": "e6bca250-e2c6-326e-b5bd-9f1b85420bd8",
                        "source_sense_id": "26c54853-e0ab-37f2-a507-1bb29f72fc43",
                        "source_sense_description": "übertragen: eine Mahnung, die jemanden/eine Gemeinschaft aufrütteln soll, etwas zu tun/zu verändern",
                        "target_lang_word": "clarion call",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "clarion call",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4f122453-b97b-3b2c-b526-2d873e245771",
                                        "entry_id": "234f75b5-0ddd-3a90-ad92-77908d41b987",
                                        "glosses": [
                                            "Appeal, urgent call to action."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c13f2f90-af50-4365-8a7a-b0cc58ef2cfb",
                                                "sense_id": "4f122453-b97b-3b2c-b526-2d873e245771",
                                                "text": "Our clarion call is \"Equal Rights for all: Special Privileges to None\"."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
