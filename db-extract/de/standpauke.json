                "senses": [
                    {
                        "sense_id": "6993ff57-8820-3206-8ad7-d421e5a40be9",
                        "entry_id": "ed8d1c9d-4942-3b5f-a0bd-7a5b72a05e5d",
                        "glosses": [
                            "Rede, mit der jemand heftig gerügt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ae56b7b-db28-400d-9ed6-0552821daa11",
                                "sense_id": "6993ff57-8820-3206-8ad7-d421e5a40be9",
                                "text": "„Sie beendeten ihre Standpauke mit der Drohung, dass sie mich schon noch bestrafen würden.“"
                            },
                            {
                                "example_id": "23428b8a-9c64-426d-b2b6-938bfe03849b",
                                "sense_id": "6993ff57-8820-3206-8ad7-d421e5a40be9",
                                "text": "„Die Standpauken kamen völlig unerwartet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "428ca706-4591-4cf3-b6c3-15cde7e91a31",
                        "source_entry_id": "ed8d1c9d-4942-3b5f-a0bd-7a5b72a05e5d",
                        "source_sense_id": "6993ff57-8820-3206-8ad7-d421e5a40be9",
                        "source_sense_description": "Rede, mit der jemand heftig gerügt wird",
                        "target_lang_word": "harangue",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "harangue",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2db8b242-3139-3fbd-9765-a522c789e91a",
                                        "entry_id": "a7ee8ccf-8453-368b-b73f-337e0a18d6f7",
                                        "glosses": [
                                            "An impassioned, disputatious public speech."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9d623135-91af-321d-893b-d7971fb2a294",
                                        "entry_id": "a7ee8ccf-8453-368b-b73f-337e0a18d6f7",
                                        "glosses": [
                                            "A tirade, harsh scolding or rant, whether spoken or written."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09f9747e-8b80-41d8-afc6-798b5c78bcb5",
                                                "sense_id": "9d623135-91af-321d-893b-d7971fb2a294",
                                                "text": "She gave her son a harangue about the dangers of playing in the street."
                                            },
                                            {
                                                "example_id": "05c2d65a-4a56-4d27-ad38-b51e1441a2b6",
                                                "sense_id": "9d623135-91af-321d-893b-d7971fb2a294",
                                                "text": "The priest took thirty minutes to deliver his harangue on timeliness, making the entire service run late."
                                            },
                                            {
                                                "example_id": "96f8ebd2-df18-440a-97dc-82ed296dea77",
                                                "sense_id": "9d623135-91af-321d-893b-d7971fb2a294",
                                                "text": "The king addresses his people, and the heaviest impost is levied with acclamations—the general harangues his troops, and thousands rush upon the smoking cannon and the gleaming bayonets—the lover whispers his mistress, and she forgets even herself for his sake."
                                            },
                                            {
                                                "example_id": "59628961-6b11-49bb-95fc-0dfe6ebcf1d6",
                                                "sense_id": "9d623135-91af-321d-893b-d7971fb2a294",
                                                "text": "But he continued his harangue without waiting for a reply."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "harangue",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2d05a93e-0f1c-3b5c-acb6-cda8dbc96885",
                                        "entry_id": "aef5aeb1-bac3-3f47-a8fc-fb45b263d602",
                                        "glosses": [
                                            "To give a forceful and lengthy lecture or criticism to someone."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "775e4aa5-eba2-48f9-ab62-c6dbe7a47f47",
                                                "sense_id": "2d05a93e-0f1c-3b5c-acb6-cda8dbc96885",
                                                "text": "The angry motorist leapt from his car to harangue the other driver."
                                            },
                                            {
                                                "example_id": "60b171c8-c806-40ab-aeb8-52a0d76ec22a",
                                                "sense_id": "2d05a93e-0f1c-3b5c-acb6-cda8dbc96885",
                                                "text": "He has vamp'd an old speech, and the court to their sorrow, / Shall hear him harangue against Prior to morrow."
                                            },
                                            {
                                                "example_id": "3558b921-d21c-4684-af73-4650e22a5862",
                                                "sense_id": "2d05a93e-0f1c-3b5c-acb6-cda8dbc96885",
                                                "text": "This picture of her consequence had some effect, for no one loved better to lead than Maria;—and with far more good humour she answered, \"I am much obliged to you, Edmund;—you mean very well, I am sure—but I still think you see things too strongly; and I really cannot undertake to harangue all the rest upon a subject of this kind.—There would be the greatest indecorum I think.\""
                                            },
                                            {
                                                "example_id": "3f34d768-3132-416d-9597-0cc8c0e06ef4",
                                                "sense_id": "2d05a93e-0f1c-3b5c-acb6-cda8dbc96885",
                                                "text": "It's a tradition that when you harangue the multitudes, you stand on a soapbox."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7291bc3b-acca-4ee0-a49d-76708ae6bd5e",
                        "source_entry_id": "ed8d1c9d-4942-3b5f-a0bd-7a5b72a05e5d",
