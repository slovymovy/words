            "pos": "noun",
            "senses": [
                {
                    "sense_id": "99e159f3-383f-33ac-970b-df7cc1b88fa1",
                    "sense_definition": "de pijnlijke, rode uitslag van de huid na te veel blootstelling aan de zon",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "huidconditie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Als je je niet insmeert heb je dadelijk last van <w>zonnebrand</w>.",
                            "target_lang_translations": {
                                "en": "If you don't apply lotion, you'll soon suffer from <w>sunburn</w>."
                            }
                        },
                        {
                            "text": "Zijn schouders doen pijn door de ernstige <w>zonnebrand</w> na een dag op het strand.",
                            "target_lang_translations": {
                                "en": "His shoulders hurt because of the severe <w>sunburn</w> after a day at the beach."
                            }
                        }
                    ],
                    "common_phrases": [
                        "last van zonnebrand",
                        "ernstige zonnebrand"
                    ],
                    "target_lang_definitions": {
                        "en": "the painful, red skin rash caused by overexposure to the sun"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sunburn",
                                "target_lang_sense_clarification": "the condition of having burnt skin"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7444b95e-73ad-36a6-b186-973a33456886",
                    "sense_definition": "een middel dat de huid beschermt tegen de schadelijke straling van de zon",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "bescherming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vergeet niet om je goed in te smeren met <w>zonnebrand</w>.",
                            "target_lang_translations": {
                                "en": "Don't forget to apply <w>sunscreen</w> properly."
                            }
                        },
                        {
                            "text": "Welke factor <w>zonnebrand</w> gebruik jij meestal voor je gezicht?",
                            "target_lang_translations": {
                                "en": "What factor <w>sunscreen</w> do you usually use for your face?"
                            }
                        }
                    ],
                    "synonyms": [
                        "zonnebrandcrème"
                    ],
                    "common_phrases": [
                        "insmeren met zonnebrand",
                        "factor zonnebrand"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "vaak gebruikt als verkorting van zonnebrandcrème"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "a product that protects the skin against harmful radiation from the sun"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sunscreen",
                                "target_lang_sense_clarification": "protective lotion or cream"
                            },
                            {
                                "target_lang_word": "sunblock",
                                "target_lang_sense_clarification": "high-protection lotion"
                            },
                            {
                                "target_lang_word": "suntan lotion",
                                "target_lang_sense_clarification": "lotion for sun protection and tanning"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c714997f-b298-322d-800c-83d87f2702a4",
                    "sense_definition": "de intense hitte of de brandende kracht van de zon",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "natuurverschijnsel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De felle <w>zonnebrand</w> maakte het werken op het land onmogelijk.",
                            "target_lang_translations": {
                                "en": "The fierce <w>burning sun</w> made working on the land impossible."
                            }
                        },
                        {
                            "text": "Zij zochten beschutting in de schaduw tegen de hete <w>zonnebrand</w>.",
                            "target_lang_translations": {
                                "en": "They sought shelter in the shade against the hot <w>scorching sun</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "felle zonnebrand",
                        "hete zonnebrand"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "minder gebruikelijk in het dagelijks taalgebruik"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "the intense heat or the burning power of the sun"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "burning sun",
                                "target_lang_sense_clarification": "intense heat from the sun"
                            },
                            {
                                "target_lang_word": "scorching sun",
                                "target_lang_sense_clarification": "very hot sun"
                            }
                        ]
                    }
                }
            ]
        }
    ]
