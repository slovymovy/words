                "entry_id": "4e5777bd-d01f-307c-a398-0d823db3765c",
                "word": "refan",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "1c32c1f0-81cb-4c4a-a71f-64fb627aede9",
                        "entry_id": "4e5777bd-d01f-307c-a398-0d823db3765c",
                        "tags": [
