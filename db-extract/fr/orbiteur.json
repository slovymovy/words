                        "entry_id": "244f58de-b437-3d82-9fb3-4467b6d266b6",
                        "glosses": [
                            "Engin spatial ou élément d’un engin spatial qui reste en orbite autour d’un astre pour assurer des missions spécifiques d’une durée déterminée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28167c78-22a6-446e-93df-a21130575e93",
                                "sense_id": "2c698ec7-7ee5-317f-a1a4-43d49eb8bb47",
                                "text": "Il prévoit de faire décoller un engin orbiteur et une sonde en 2031 pour une arrivée en 2044."
                            },
                            {
                                "example_id": "96e108a6-79d3-46dd-baef-365028f81a45",
                                "sense_id": "2c698ec7-7ee5-317f-a1a4-43d49eb8bb47",
                                "text": "Il faut savoir que le flux de données détaillées en temps quasi réel repose sur un nouveau type de communication de relais ajouté l'année dernière à l’orbiteur Mars Reconnaissance."
                            }
                        ]
                    }
                ],
