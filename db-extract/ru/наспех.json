                                        "sense_id": "072b841d-071a-3e09-9087-f336803d44c4",
                                        "entry_id": "90e36fc4-95bf-3507-8b99-38c2ec5eb9a6",
                                        "glosses": [
                                            "zu schnell und ohne Sorgfalt, genaue Überlegung oder große Vorbereitung; in großer Eile"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "98d81aa9-661b-466d-baf3-099305489e29",
                                                "sense_id": "072b841d-071a-3e09-9087-f336803d44c4",
                                                "text": "Der Dieb nahm hastig ein paar herumliegende Wertsachen und floh als er die Sirenen der Polizei hörte."
                                            },
                                            {
                                                "example_id": "87b494fc-ca4c-4f9c-b3c2-12b404eb60a4",
                                                "sense_id": "072b841d-071a-3e09-9087-f336803d44c4",
                                                "text": "Hastig steckt der Mann eine Dokumentenmappe in seine Aktentasche."
                                            },
                                            {
                                                "example_id": "b0e8d2ad-e3c1-45d5-85fb-36e1aeb83493",
                                                "sense_id": "072b841d-071a-3e09-9087-f336803d44c4",
                                                "text": "Tatsächlich ist die Teilnahme des Syrers an einem hastig einberufenen Mini-Gipfel der libanesischen Regierung mit dem saudischen König eine kleine Sensation."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
