                ],
                "senses": [
                    {
                        "sense_id": "36f2f6fc-c600-3d6c-9243-012fcec23e5a",
                        "entry_id": "d62ce6c8-6282-36bc-a414-c827fa387fb5",
                        "glosses": [
                            "Matériau composite artificiel qui présente des propriétés électromagnétiques qu’on ne retrouve pas dans un matériau naturel."
                        ],
                        "tags": [
                            "physical"
                        ],
                        "examples": [
                            {
                                "example_id": "63fb4124-e7fd-4b16-8e4f-58059486b87b",
                                "sense_id": "36f2f6fc-c600-3d6c-9243-012fcec23e5a",
                                "text": "Pour créer un tel métamatériau pour le son, il faut d’abord ajuster les contreparties acoustiques à la permittivité et à la perméabilité dans les ondes lumineuses."
                            },
                            {
                                "example_id": "4d6bedc2-a8d1-4fa2-bf10-a71fe46f05a0",
                                "sense_id": "36f2f6fc-c600-3d6c-9243-012fcec23e5a",
                                "text": "Des décennies de progrès technologiques ont été nécessaires pour parvenir à fabriquer ces métamatériaux."
                            },
                            {
                                "example_id": "5894da73-bc66-4766-ba52-861653457df7",
                                "sense_id": "36f2f6fc-c600-3d6c-9243-012fcec23e5a",
                                "text": "Faire disparaître un objet à nos yeux, mais aussi faire échapper un édifice aux séismes et aux tsunamis : les travaux sur les métamatériaux se multiplient."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2c82c6e8-40b1-4c5b-92d3-0d3bce5827dd",
                        "source_entry_id": "d62ce6c8-6282-36bc-a414-c827fa387fb5",
