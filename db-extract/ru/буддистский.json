                                                "sense_id": "57f485c2-5de1-3095-a13c-d492bd74fc3e",
                                                "text": "Die buddhistischen Mönche in Tibet tragen rote Gewänder."
                                            },
                                            {
                                                "example_id": "936eda44-cab7-4cc3-828d-383e3be86c32",
                                                "sense_id": "57f485c2-5de1-3095-a13c-d492bd74fc3e",
                                                "text": "„Die Erhebung Csomas in ein buddhistisches Pantheon hat ihren Ursprung in dem Wunder der sechzehn Monate in der Zelle in Zangla.“"
                                            }
                                        ],
