                    {
                        "sense_id": "90aab07b-4496-3e84-b9ec-ca919fbcc1f7",
                        "entry_id": "9586690d-9aed-3c0a-8629-53b8881c8136",
                        "glosses": [
                            "To behave in a nonconformist manner; to reject conformity."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c08f4f5a-1c63-476f-8978-145977d0ada8",
                                "sense_id": "90aab07b-4496-3e84-b9ec-ca919fbcc1f7",
                                "text": "Maybe you've tried your whole Christian life to \"unconform\" yourself and transform yourself."
                            },
                            {
                                "example_id": "2ec86a95-8233-43e2-8a1e-7dbfc842b192",
                                "sense_id": "90aab07b-4496-3e84-b9ec-ca919fbcc1f7",
                                "text": "Being too young to be able to unconform I now present the reader their chance to learn from Hunchy."
                            },
                            {
                                "example_id": "23c6a705-ac3a-42e0-ab67-999016c7e0d1",
                                "sense_id": "90aab07b-4496-3e84-b9ec-ca919fbcc1f7",
                                "text": "It's time to unconform; to dispense with the same–same 'pastel and marble' way of doing things."
                            }
                        ]
                    }
