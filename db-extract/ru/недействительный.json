                                "target_senses": [
                                    {
                                        "sense_id": "b0cc8548-e684-3acc-87d1-e34a2168c93a",
                                        "entry_id": "e3a6fe2a-761d-3435-85b5-762a214d09cf",
                                        "glosses": [
                                            "Not valid; not true, correct, acceptable or appropriate."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c415a7aa-1682-47a8-a3a4-344804fe082d",
                                                "sense_id": "b0cc8548-e684-3acc-87d1-e34a2168c93a",
                                                "text": "Your argument is invalid because it uses circular reasoning."
                                            },
                                            {
                                                "example_id": "f99d29bc-f2d7-400a-a953-009c8cf4bbe0",
                                                "sense_id": "b0cc8548-e684-3acc-87d1-e34a2168c93a",
                                                "text": "This invalid contract cannot be legally enforced."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "invalid",
                                "target_lang_code": "en",
                                "target_senses": [
