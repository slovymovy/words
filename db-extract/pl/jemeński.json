                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Yemeni",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "924d5508-3c16-3dbb-815e-ee38f86595c2",
                                        "entry_id": "51e7df40-d08f-3e52-8977-92705f776ad7",
                                        "glosses": [
                                            "Of, from or relating to Yemen, or the Yemeni people."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2493236f-27b6-4516-871d-d371286814cb",
                                                "sense_id": "924d5508-3c16-3dbb-815e-ee38f86595c2",
                                                "text": "“It’s getting a little bit stressful,” Nasser said. A Yemeni cafe requires Yemeni coffee. And Nasser, who plans to open many more Yemeni cafes, needs a lot more beans."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Yemeni",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0f2e7ff8-fccc-3a29-9b9c-497aad660e2b",
                                        "entry_id": "e1851b29-4fb9-3a8e-acc3-ccaa3dc8544e",
                                        "glosses": [
                                            "A native or inhabitant of Yemen or of Yemeni descent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32157748-b746-43fa-b7f5-ae47ea5a486c",
                                                "sense_id": "0f2e7ff8-fccc-3a29-9b9c-497aad660e2b",
                                                "text": "Fellow Yemenis make up a small percentage of the new owners."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "84638670-ad67-4cf2-a601-fcd374ec341b",
                        "source_entry_id": "35613c49-48d3-3f8d-87d8-944cc03f3918",
                        "source_sense_id": "0bb9e36f-d5f0-3f46-ba04-45e98ffa60e2",
                        "target_lang_word": "jemenský",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
