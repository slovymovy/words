                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f21654a-c09a-43fc-acd2-71965af8fed3",
                                                "sense_id": "cde11ff1-6780-3000-ab78-c6a355ec1d90",
                                                "text": "Door het gebruik van vormen, kleuren en bewegingen kan men muziek visueel voorstellen."
                                            },
                                            {
                                                "example_id": "e5529c50-7a51-4ca4-baeb-61e998a84b12",
                                                "sense_id": "cde11ff1-6780-3000-ab78-c6a355ec1d90",
                                                "text": "Als art director in de reclame was ik altijd al visueel ingesteld, degene die verhalen vertelt op een beeldende manier, door middel van illustraties, fotografie of film."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a1ccd56b-43a7-47df-83ca-e7d074b47b19",
                        "source_entry_id": "73314fc8-54db-3679-8a68-ec27d3e6ffcd",
                        "source_sense_description": "related to or affecting the vision",
                        "target_lang_word": "visuel",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
