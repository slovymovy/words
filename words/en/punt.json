{
    "word_family": [
        "punter",
        "punting"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0364b044-4ba1-3623-8397-63b0ce0c3e7e",
                    "sense_definition": "to kick a ball dropped from the hands before it hits the ground, typically to move it far down the field",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "sports-kicking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The goalkeeper decided to <w>punt</w> the ball deep into the opponent's half.",
                            "target_lang_translations": {
                                "ru": "Вратарь решил <w>выбить мяч с рук</w> далеко на половину поля противника.",
                                "zh": "守门员决定将球<w>踢</w>向对方半场的深处。"
                            }
                        },
                        {
                            "text": "He managed to <w>punt</w> the ball over the defenders to clear the danger.",
                            "target_lang_translations": {
                                "ru": "Ему удалось <w>перебросить мяч</w> через защитников, чтобы ликвидировать угрозу.",
                                "zh": "他成功地将球<w>踢</w>过防守队员，化解了险情。"
                            }
                        }
                    ],
                    "synonyms": [
                        "dropkick",
                        "kick"
                    ],
                    "common_phrases": [
                        "punt the ball"
                    ],
                    "target_lang_definitions": {
                        "ru": "выбить мяч с рук до того, как он коснется земли, обычно для продвижения его далеко по полю",
                        "zh": "在球落地前将其从手中踢出，通常是为了将球踢向场地远端"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выбивать мяч с рук",
                                "target_lang_sense_clarification": "в спорте"
                            },
                            {
                                "target_lang_word": "пантить",
                                "target_lang_sense_clarification": "профессиональный сленг"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "踢球",
                                "target_lang_sense_clarification": "指橄榄球或足球中的踢球动作"
                            },
                            {
                                "target_lang_word": "弃踢",
                                "target_lang_sense_clarification": "美式橄榄球术语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1453c1e5-9bb8-3f08-b6ca-d62de4bc3051",
                    "sense_definition": "to gamble, bet on a horse, or take a chance on something",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "gambling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many people like to <w>punt</w> on the Grand National every year.",
                            "target_lang_translations": {
                                "ru": "Многие любят каждый год <w>делать ставки</w> на скачки Grand National.",
                                "zh": "许多人每年都喜欢在英国国家大赛上<w>下注</w>。"
                            }
                        },
                        {
                            "text": "He spent the afternoon <w>punting</w> at the local betting shop.",
                            "target_lang_translations": {
                                "ru": "Он провел вторую половину дня, <w>играя на тотализаторе</w> в местной букмекерской конторе.",
                                "zh": "他整个下午都在当地的投注站<w>下注</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "bet",
                        "wager",
                        "gamble"
                    ],
                    "common_phrases": [
                        "punt on a horse"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Common in British and Australian English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "играть в азартные игры, делать ставки на лошадей или идти на риск в чем-либо",
                        "zh": "进行赌博、下注或在某事上冒险尝试"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ставить",
                                "target_lang_sense_clarification": "делать ставку"
                            },
                            {
                                "target_lang_word": "рисковать",
                                "target_lang_sense_clarification": "идти на риск"
                            },
                            {
                                "target_lang_word": "играть на тотализаторе",
                                "target_lang_sense_clarification": "о скачках"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "下注",
                                "target_lang_sense_clarification": "指在比赛或博彩中投注"
                            },
                            {
                                "target_lang_word": "冒险",
                                "target_lang_sense_clarification": "指尝试不确定的事情"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bb15cf78-38e3-379b-9105-3b12c482ecf2",
                    "sense_definition": "to propel a long, flat-bottomed boat using a pole pushed against the riverbed",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "boating",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We spent a relaxing afternoon <w>punting</w> on the river in Cambridge.",
                            "target_lang_translations": {
                                "ru": "Мы провели спокойный день, <w>катаясь на плоскодонке</w> по реке в Кембридже.",
                                "zh": "我们在剑桥的河上度过了一个轻松的下午，体验了<w>撑船</w>。"
                            }
                        },
                        {
                            "text": "It takes some practice to <w>punt</w> a boat in a straight line.",
                            "target_lang_translations": {
                                "ru": "Нужна практика, чтобы <w>вести лодку шестом</w> по прямой линии.",
                                "zh": "要让船走直线，<w>撑船</w>是需要练习的。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "go punting"
                    ],
                    "target_lang_definitions": {
                        "ru": "управлять длинной плоскодонной лодкой, отталкиваясь шестом от дна реки",
                        "zh": "使用撑杆抵住河床来推动平底船前进"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кататься на плоскодонке",
                                "target_lang_sense_clarification": "используя шест"
                            },
                            {
                                "target_lang_word": "отталкиваться шестом",
                                "target_lang_sense_clarification": "способ передвижения на лодке"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "撑船",
                                "target_lang_sense_clarification": "指用杆子推动平底船"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4946ee9e-2a70-3149-8c9a-3178f1dc22fc",
                    "sense_definition": "to delay or avoid dealing with a difficult issue or question",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "avoidance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politician decided to <w>punt</w> on the controversial question during the interview.",
                            "target_lang_translations": {
                                "ru": "Политик решил <w>уклониться</w> от спорного вопроса во время интервью.",
                                "zh": "那位政客决定在采访中对那个有争议的问题进行<w>推诿</w>。"
                            }
                        },
                        {
                            "text": "Instead of making a decision, the committee chose to <w>punt</w> the issue to next month.",
                            "target_lang_translations": {
                                "ru": "Вместо того чтобы принять решение, комитет предпочел <w>отложить</w> этот вопрос до следующего месяца.",
                                "zh": "委员会没有做出决定，而是选择将该问题<w>搁置</w>到下个月。"
                            }
                        }
                    ],
                    "synonyms": [
                        "equivocate",
                        "stall",
                        "postpone"
                    ],
                    "common_phrases": [
                        "punt on the issue"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used in political or business contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "откладывать или избегать решения сложного вопроса или проблемы",
                        "zh": "推迟或避免处理棘手的问题或质疑"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "откладывать",
                                "target_lang_sense_clarification": "решение вопроса"
                            },
                            {
                                "target_lang_word": "уклоняться",
                                "target_lang_sense_clarification": "от ответа или решения"
                            },
                            {
                                "target_lang_word": "пасовать",
                                "target_lang_sense_clarification": "перекладывать ответственность"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "推诿",
                                "target_lang_sense_clarification": "指回避责任或问题"
                            },
                            {
                                "target_lang_word": "搁置",
                                "target_lang_sense_clarification": "指暂时不处理问题"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a1be80b9-4ac7-3f37-84ac-f0fb178021c1",
                    "sense_definition": "to forcibly remove or eject someone from a place or online group",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "ejection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The moderator had to <w>punt</w> the user from the chat for breaking the rules.",
                            "target_lang_translations": {
                                "ru": "Модератору пришлось <w>кикнуть</w> пользователя из чата за нарушение правил.",
                                "zh": "由于违反规则，版主不得不将该用户从聊天室<w>踢出</w>。"
                            }
                        },
                        {
                            "text": "If you keep causing trouble, the bouncer will <w>punt</w> you out of the club.",
                            "target_lang_translations": {
                                "ru": "Если ты продолжишь хулиганить, вышибала <w>выставит</w> тебя из клуба.",
                                "zh": "如果你继续惹麻烦，保安会把你从俱乐部<w>赶走</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "eject",
                        "kick out",
                        "banish"
                    ],
                    "common_phrases": [
                        "punt from the channel"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Often used in digital or informal contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "принудительно удалять или выгонять кого-либо из места или онлайн-группы",
                        "zh": "强行将某人从某地或在线群组中驱逐出去"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вышвыривать",
                                "target_lang_sense_clarification": "грубо выгонять"
                            },
                            {
                                "target_lang_word": "кикать",
                                "target_lang_sense_clarification": "удалять из чата"
                            },
                            {
                                "target_lang_word": "выставлять",
                                "target_lang_sense_clarification": "за дверь"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "踢出",
                                "target_lang_sense_clarification": "指从群组或聊天室移除"
                            },
                            {
                                "target_lang_word": "驱逐",
                                "target_lang_sense_clarification": "指强行赶走"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "70e32ed6-8cbb-3f46-b2c5-7a1660d4918a",
                    "sense_definition": "a kick in which the ball is dropped and kicked before it touches the ground",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "sports-kicking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The player's long <w>punt</w> sent the ball all the way to the other end of the field.",
                            "target_lang_translations": {
                                "ru": "Дальний <w>удар с рук</w> игрока отправил мяч на другой конец поля.",
                                "zh": "球员那记长距离的<w>弃踢</w>将球送到了球场的另一端。"
                            }
                        },
                        {
                            "text": "He practiced his <w>punt</w> every morning to improve his distance.",
                            "target_lang_translations": {
                                "ru": "Он каждое утро тренировал свой <w>удар</w>, чтобы увеличить дальность полета мяча.",
                                "zh": "他每天早上都练习<w>弃踢</w>以提高踢球距离。"
                            }
                        }
                    ],
                    "common_phrases": [
