                                        "entry_id": "a8ea0458-3dfd-3cd1-866a-0a63c26454e8",
                                        "glosses": [
                                            "En montagne, niveau d’altitude où l’évolution de l’homme est soumise à des contraintes fortes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eee7344a-5829-48e9-a2c2-57c70978a5a4",
                                                "sense_id": "2ed6ce56-0a82-3039-a0a4-906be73c718d",
                                                "text": "Le lecteur de Jack London et de James Oliver Curwood se retrouve dans son élément : la haute montagne vaut bien le pôle."
                                            },
                                            {
                                                "example_id": "0ba4f4f7-5544-4cfd-a173-af5a512169a8",
                                                "sense_id": "2ed6ce56-0a82-3039-a0a4-906be73c718d",
                                                "text": "Dans la haute montagne, où la grande propriété n’existe pas, les propriétés moyennes sont généralement louées à des fermiers; les petits domaines sont toujours exploités par leurs propriétaires."
                                            }
                                        ]
                                    }
                                ]
