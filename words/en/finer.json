                    "semantic_group_id": "names",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Finer</w> is the new teacher at our local high school.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Файнер</w> — новый учитель в нашей местной средней школе."
                            }
