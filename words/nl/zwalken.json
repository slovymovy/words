    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9ab76819-9849-36ae-a920-ccd6cc79d715",
                    "sense_definition": "Doelloos en ongecontroleerd zich voortbewegen, vaak wankelend of dwalend.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "voortbewegen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De dronken man bleef maar over de straat <w>zwalken</w> zonder te weten waar hij heen ging.",
                            "target_lang_translations": {
                                "en": "The drunk man just kept <w>staggering</w> across the street without knowing where he was going."
                            }
                        },
                        {
                            "text": "Na het feestje zagen we hem doelloos door de straten <w>zwalken</w>.",
                            "target_lang_translations": {
                                "en": "After the party, we saw him <w>wandering</w> aimlessly through the streets."
                            }
                        }
                    ],
                    "synonyms": [
                        "dwalen",
                        "zwerven",
                        "wankelen",
                        "struikelen"
                    ],
                    "antonyms": [
                        "koersen"
                    ],
                    "common_phrases": [
                        "over straat zwalken",
                        "doelloos zwalken"
                    ],
                    "target_lang_definitions": {
                        "en": "To move around aimlessly and without control, often staggering, wandering, or drifting."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to wander",
                                "target_lang_sense_clarification": "aimlessly"
                            },
                            {
                                "target_lang_word": "to stagger",
                                "target_lang_sense_clarification": "unsteadily"
                            },
                            {
                                "target_lang_word": "to drift",
                                "target_lang_sense_clarification": "without direction"
                            },
                            {
                                "target_lang_word": "to roam",
                                "target_lang_sense_clarification": "about"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "753e7359-4c08-39c5-86fd-76ef5ba35a5f",
                    "sense_definition": "Op zee ronddolen of dobberen, overgeleverd aan de golven en de wind.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "voortbewegen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De schipbreukelingen moesten dagenlang in een klein bootje op zee <w>zwalken</w>.",
                            "target_lang_translations": {
                                "en": "The shipwrecked survivors had to <w>drift</w> in a small boat at sea for days."
                            }
                        },
                        {
                            "text": "Het stuurloze schip bleef wekenlang op de oceaan <w>zwalken</w>.",
                            "target_lang_translations": {
                                "en": "The rudderless ship kept <w>drifting</w> on the ocean for weeks."
                            }
                        }
                    ],
                    "synonyms": [
                        "dobberen",
                        "ronddolen",
                        "drijven"
                    ],
                    "antonyms": [
                        "varen",
                        "koersen"
                    ],
                    "common_phrases": [
                        "op zee zwalken"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Voornamelijk in maritieme of literaire context gebruikt."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To drift or wander at sea, at the mercy of the waves and the wind."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to drift",
                                "target_lang_sense_clarification": "at sea"
                            },
                            {
                                "target_lang_word": "to toss about",
                                "target_lang_sense_clarification": "on the waves"
                            },
                            {
                                "target_lang_word": "to wander",
                                "target_lang_sense_clarification": "on the ocean"
                            }
                        ]
                    }
                }
            ]
