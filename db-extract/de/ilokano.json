                "senses": [
                    {
                        "sense_id": "baf15f3d-13d0-32ea-b364-9ff1e0bdcbfe",
                        "entry_id": "77cb0236-6241-3440-97d4-0fc8fdbac06a",
                        "glosses": [
                            "die Sprache der gleichnamigen philippinischen Ethnie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd77d15b-59bd-4e48-93bd-c3f444a7dd63",
                                "sense_id": "baf15f3d-13d0-32ea-b364-9ff1e0bdcbfe",
                                "text": "„Wenn man die Sprachen der Gebirgsstämme ausser Acht lässt, sind die bedeutendsten Nachbarsprachen des Ilokano das Ibanag im Osten und Pangasinan und das Pampanga im Süden.“"
                            },
                            {
                                "example_id": "6552f50a-8095-4453-8af9-d5f445c90d4b",
                                "sense_id": "baf15f3d-13d0-32ea-b364-9ff1e0bdcbfe",
                                "text": "„[…] wobei wir uns seit einiger Zeit weitgehend auf eine einzelne 'Vergleichssprache' konzentrieren, die austronesische Sprache Ilokano, die uns aufgrund ihrer typologischen Merkmale für unser Forschungsinteressen besonders vielversprechend erschien.“"
                            },
                            {
                                "example_id": "b3668ccd-2996-4e53-b543-73cc3f52088b",
                                "sense_id": "baf15f3d-13d0-32ea-b364-9ff1e0bdcbfe",
                                "text": "„Im Ilokano trägt ‚kalag‘ die zweite Bedeutung von \"compulsion\" (Zwangshandlung, zwanghafter Antrieb)[.]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
