                    {
                        "sense_id": "ada683e5-a0ff-3085-a60c-22e63d92cf51",
                        "entry_id": "8036c8ca-74c4-3f36-9004-5af0f037c2a5",
                        "glosses": [
                            "A male given name from Ancient Greek."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b6840e2-55b7-48c7-b456-5590168d858b",
                                "sense_id": "ada683e5-a0ff-3085-a60c-22e63d92cf51",
                                "text": "That iolly shepheard, which there piped, was / Poore Colin Clout (who knowes not Colin Clout?)"
                            },
                            {
                                "example_id": "afbe2316-3271-44a3-8989-0b67073669b2",
                                "sense_id": "ada683e5-a0ff-3085-a60c-22e63d92cf51",
                                "text": "\"My parents,\" Powell wrote, \"were British subjects, and they named me Colin (KAH-lin). Being British, they knew very well how the name was supposed to be pronounced. But when I was a young boy, there was a famous American World War II hero whose name became very popular in the streets of New York City. He was Capt. Colin P. Kelly Jr. He was called KOH-lin. My friends in the streets of the South Bronx, who heard Captain Kelly's name pronounced in the radio and by their parents and other adults, began to refer to me by the same pronunciation."
                            },
                            {
                                "example_id": "b7e9ec72-0209-4fc1-9318-f09d2aa32bc1",
                                "sense_id": "ada683e5-a0ff-3085-a60c-22e63d92cf51",
                                "text": "“After reaching 40, many people experience noticeable changes in their hair due to a combination of aging, hormonal shifts and lifestyle factors,” says Colin Ford, professional hairstylist and director of education at Sachajuan."
                            }
                        ]
                    },
