                                    {
                                        "sense_id": "319ff822-7413-33dc-956d-ee00d64bf638",
                                        "entry_id": "10d7ab86-3d34-31b3-8376-c5376c131dd8",
                                        "glosses": [
                                            "Wood intended to be burned, typically for heat."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a98aa925-f36f-4a74-ba44-8f776b083d9e",
                                                "sense_id": "319ff822-7413-33dc-956d-ee00d64bf638",
                                                "text": "After many days of hard work, we finally had enough firewood for the winter."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5e27d6b3-4c83-48ab-b37c-511c90f35352",
