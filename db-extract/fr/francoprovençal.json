                    {
                        "sense_id": "87f619c8-819d-3a30-8f3d-75922d366031",
                        "entry_id": "f38f3281-31c5-359a-bdf6-adc5799a1a92",
                        "glosses": [
                            "Relatif à la région linguistique définie par les dialectes du franco-provençal."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11e970f7-5435-4492-93f1-fdadc5158db1",
                                "sense_id": "87f619c8-819d-3a30-8f3d-75922d366031",
                                "text": "Le parler de Saint-Thurin, un parler francoprovençal forézien."
                            },
                            {
                                "example_id": "679344d9-c601-4ee3-8488-a53a6ef3a6f8",
                                "sense_id": "87f619c8-819d-3a30-8f3d-75922d366031",
                                "text": "On ne peut pas parler non plus d’une « identité francoprovençale unie ». Il faut dire qu’en France cette langue n’est presque plus parlée du fait de la politique linguistique très restrictive appliquée sur le territoire, […]."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "56c29f49-1159-309f-8f8b-899197eadb9a",
                "word": "francoprovençal",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "1b8a7d5d-9d16-360d-895b-305c7dbf8979",
                        "entry_id": "56c29f49-1159-309f-8f8b-899197eadb9a",
                        "glosses": [
                            "Variante orthographique de franco-provençal."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "3087ddde-2ace-45bc-bcb4-078aad08a80c",
                                "sense_id": "1b8a7d5d-9d16-360d-895b-305c7dbf8979",
                                "text": "La limite entre le francoprovençal et l’occitan est établie d’après la palatalisation ou non du A latin après consonne de type palatale."
                            },
                            {
                                "example_id": "d5e89c22-28b9-4577-82eb-a0b1a3b60d4e",
                                "sense_id": "1b8a7d5d-9d16-360d-895b-305c7dbf8979",
                                "text": "Le francoprovençal est d’abord atypique de par son domaine linguistique, que se partagent actuellement trois pays indépendants (la Suisse, l’Italie et la France), ensuite de par son manque de tradition littéraire et culturelle propre et de par son fort morcellement intérieur en une multitude de patois."
                            }
                        ]
                    }
