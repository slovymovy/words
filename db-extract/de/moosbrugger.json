                ],
                "senses": [
                    {
                        "sense_id": "cb25e9f3-413d-38dc-bec6-baa3ad761d25",
                        "entry_id": "a5d40f7f-d544-3d06-b286-2b4875df887b",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8dc49f5b-38b0-43d8-8561-aac9a432665f",
                                "sense_id": "cb25e9f3-413d-38dc-bec6-baa3ad761d25",
                                "text": "Frau Moosbrugger ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "861d8c78-7f26-4b09-8e39-8f8f6bc1ef98",
                                "sense_id": "cb25e9f3-413d-38dc-bec6-baa3ad761d25",
                                "text": "Herr Moosbrugger wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "89d5a5da-2c8b-4c97-bb38-d53c116755b9",
                                "sense_id": "cb25e9f3-413d-38dc-bec6-baa3ad761d25",
                                "text": "Die Moosbruggers fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "4259d52d-033d-457e-835d-8cf522c38482",
                                "sense_id": "cb25e9f3-413d-38dc-bec6-baa3ad761d25",
                                "text": "Der Moosbrugger trägt nie die Schals, die die Moosbrugger ihm strickt."
                            },
                            {
                                "example_id": "c1027c84-c6e4-4493-9e70-a5c5d46fa494",
                                "sense_id": "cb25e9f3-413d-38dc-bec6-baa3ad761d25",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Moosbrugger kommt, geht der Herr Moosbrugger.“"
                            },
                            {
                                "example_id": "4b9656a8-73e9-496c-965b-c454ec1310d4",
                                "sense_id": "cb25e9f3-413d-38dc-bec6-baa3ad761d25",
                                "text": "Moosbrugger kommt und geht."
                            },
                            {
                                "example_id": "bb365de3-5d3d-4884-9b66-fdf7dc0fed40",
                                "sense_id": "cb25e9f3-413d-38dc-bec6-baa3ad761d25",
                                "text": "Moosbruggers kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
