                "senses": [
                    {
                        "sense_id": "178f8650-3b9f-3836-80f0-f09d544d971e",
                        "entry_id": "beffc546-8553-3180-acfd-98fd304d23a5",
                        "glosses": [
                            "A period of seven consecutive days and nights; a week."
                        ],
                        "tags": [
                            "archaic",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "c0f15986-e4bc-492b-9bf0-3d21abb7f27a",
                                "sense_id": "178f8650-3b9f-3836-80f0-f09d544d971e",
                                "text": "The Holy Houſel ought to be kept vvith great Diligence and not be permitted to be ſtale, but another be alvvays hallovved anevv for Sick Men in about a Seven-night, or Fortnight, ſo as that it may not be muſty at leaſt."
                            },
                            {
                                "example_id": "4cad3880-e0d0-495c-ae08-d9827958d954",
                                "sense_id": "178f8650-3b9f-3836-80f0-f09d544d971e",
                                "text": "[T]he bold Iago. / VVhoſe footing here anticipates our thoughts / A ſennights ſpeede."
                            },
                            {
                                "example_id": "0372f9b8-5f95-4baa-a31f-875be492b0de",
                                "sense_id": "178f8650-3b9f-3836-80f0-f09d544d971e",
                                "text": "VVearie Seu'nights, nine times nine, / Shall he dvvindle, peake, and pine: […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "664a0949-20a2-3dee-be98-69fe47ac1107",
                        "entry_id": "beffc546-8553-3180-acfd-98fd304d23a5",
                        "glosses": [
                            "Preceded by a specified day such as Sunday, today, or yesterday: a week from the specified day."
                        ],
                        "tags": [
                            "archaic",
                            "attributive",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "1e27dd74-2f6a-4b32-857e-4558748d9079",
                                "sense_id": "664a0949-20a2-3dee-be98-69fe47ac1107",
                                "text": "VVhat doctrine is vvritten for us in the eighth chapter of the firſt book of Kings, I did partly ſhevv unto you, moſt honourable audience, this day ſeven-night, of that good man, father Samuel, that good Judge, hovv good a man he vvas, vvhat helpers and coadjutors he took unto him, to have his office vvell diſcharged."
                            }
                        ]
                    },
                    {
                        "sense_id": "afbbed87-e220-38b4-8e13-345b28cbf3ae",
                        "entry_id": "beffc546-8553-3180-acfd-98fd304d23a5",
                        "glosses": [
                            "Preceded by a specified day and come: a week after the specified day."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "0d4dd75a-84e6-4bfb-8c87-e7cf1749b131",
                                "sense_id": "afbbed87-e220-38b4-8e13-345b28cbf3ae",
                                "text": "And Mrs. Jevvkes tells me, every one names Thurſday come Sev'nnight for our Nuptials."
                            }
                        ]
                    },
                    {
                        "sense_id": "966b01bd-0638-3004-9999-1793dcb4a023",
                        "entry_id": "beffc546-8553-3180-acfd-98fd304d23a5",
                        "glosses": [
                            "Preceded by a specified day and gone or was: a week before the specified day."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": []
                    }
